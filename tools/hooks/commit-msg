#!/bin/sh
# commit-msg hook: 拦截 AI 工具自动追加的 Claude 系 Co-Authored-By 署名行。
# 背景：提交正文里的 `Co-Authored-By: Claude <noreply@anthropic.com>` 会被 GitHub
# 按邮箱解析到 Anthropic 的 claude 账号（github.com/claude），并计入仓库
# Contributors 名单（2026-10-26 实测混入）。本钩子在提交期直接拦截。
if grep -qiE '^Co-Authored-By:.*<noreply@anthropic\.com>' "$1"; then
  echo "commit-msg: 检测到 Claude 系 Co-Authored-By 署名（noreply@anthropic.com），已拦截。" >&2
  echo "  该 trailer 会被 GitHub 解析为 co-author 'claude' 并计入贡献者名单。" >&2
  echo "  若确需保留请用 --no-verify 跳过本次检查。" >&2
  exit 1
fi
exit 0
