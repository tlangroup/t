{
  "_comment": "S2 pilot 节点字段 schema（仅试点子集）。cstgen.mjs 依此生成 base.tc 的 GEN:node-structs 区：typed RecX 结构 + SoA tbl_X 数组 + 双写登记函数 cst_register_X。运行时可变全局（tbl_X / g_node_nref）刻意落在主程序模块 base.tc，规避 std.rc.cst 库模块跳过 t__ginit 导致可变全局静默清零（§4.14.7）。",
  "pilot": ["binary", "ident", "int", "block", "call"],
  "nodes": {
    "binary": {
      "rec": "RecBinary",
      "nk": "NK_BINARY",
      "params": [["op", "string"], ["lhs", "i64"], ["rhs", "i64"]],
      "doc": "op=sa, lhs=na, rhs=nb"
    },
    "ident": {
      "rec": "RecIdent",
      "nk": "NK_IDENT",
      "params": [["name", "string"]],
      "doc": "name=sa"
    },
    "int": {
      "rec": "RecInt",
      "nk": "NK_INT",
      "params": [["text", "string"], ["radix", "i64"]],
      "doc": "text=sa, radix=ia"
    },
    "block": {
      "rec": "RecBlock",
      "nk": "NK_BLOCK",
      "params": [["stmts", "i64"]],
      "doc": "stmts=la（kids 列表头）"
    },
    "call": {
      "rec": "RecCall",
      "nk": "NK_CALL",
      "params": [["callee", "i64"], ["args", "i64"]],
      "doc": "callee=na, args=la"
    }
  }
}
