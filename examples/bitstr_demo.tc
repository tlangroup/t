// 位串 `++` 合并 + `for (x in c)` 字节遍历 —— C 后端端到端演示（设计见 docs/syntax/drafts/bitstring.md §15 / §15.6）
// 注：本示例未配 .expected.txt，不参与 gate 双后端对拍；待 LLVM 后端补齐位串发射后补配。
//
// 语义预期：
//   a = <<1:1, 0:1, 1:1>>           3 bits → 1 byte (0b00000101 = 5)
//   b = <<1:1, 1:1, 0:1>>           3 bits → 1 byte (0b00000110 = 6)
//   c = a ++ b                      6 bits → 1 byte (0b00010110 = 22)
//   for (x in c) 逐字节打印 x；字节数 = ceil(6/8) = 1
fn main() i64 @main {
    var a: bitstr = <<1:1, 0:1, 1:1>>;
    var b: bitstr = <<1:1, 1:1, 0:1>>;
    var c: bitstr = a ++ b;
    var n: i64 = 0;
    for (x in c) {
        println("byte=" + int_to_str(x));
        n = n + 1;
    }
    // 顺带验证 for_each 的枚举：返回字节计数
    return n;
}
