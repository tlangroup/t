// fid 读路径（反序列化，`>` 操作符，Option B：裸 T + fid_eof 探针）
//
//   f > Type  —— 从 f 读一个 Type 值，结果类型为裸 Type（EOF 不 panic、不报错）
//   fid_eof(f) —— 是否已到结尾（读前/读后探测；单纯 EOF 不写 fid_error）
//   fid_error(f) —— 取最近一次 I/O 错误原因（EOF 不算错误）
//
// 这里用 :rawbin（二进制）格式做干净往返：标量按小端定宽、string 带 u64 长度前缀。
// :text / :json 读亦支持（见 docs/reference.md §3.9.1）；聚合类型（struct/array/…）读属 v2。

pr fn(label: string, v: i64) -> void {
    var b: StringBuilder = sb_new();
    sb_append_str(b, label);
    sb_append_i64(b, v);
    println(sb_to_str(b));
}

py fn(label: string, ok: bool) -> void {
    var b: StringBuilder = sb_new();
    sb_append_str(b, label);
    if (ok) { sb_append_str(b, "true"); } else { sb_append_str(b, "false"); }
    println(sb_to_str(b));
}

yn fn(label: string, ok: bool) -> void {
    var b: StringBuilder = sb_new();
    sb_append_str(b, label);
    if (ok) { sb_append_str(b, "yes"); } else { sb_append_str(b, "no"); }
    println(sb_to_str(b));
}

@main
main fn() -> i64 {
    // ── 1. 用 :rawbin 写一批值 ─────────────────────────────────
    var w: fid = fopen("out/_fid_read_demo.bin", :write_binary);
    var n: i64 = 42;
    var s8: i8 = -7;
    var u: u8 = 200;
    var pi: f64 = 3.5;
    var t: bool = true;
    w < n < s8 < u < pi < t < :done < "hello";
    fclose(w);

    // ── 2. 用 :rawbin 读回来（裸 T，EOF 由 fid_eof 探测）─────────
    var r: fid = fopen("out/_fid_read_demo.bin", :read_binary);
    var a: i64 = r > i64;
    var b: i8 = r > i8;
    var c: u8 = r > u8;
    var d: f64 = r > f64;
    var e: bool = r > bool;
    var at: atom = r > atom;
    var str: string = r > string;
    pr("a = ", a);
    pr("b = ", (b as i64));
    pr("c = ", (c as i64));
    println(format_float(".1f", d));
    py("e = ", e);
    println(atom_str(at));
    println(str);

    // ── 3. EOF 探测：读完所有值后流已到尾 ─────────────────────
    yn("eof? ", fid_eof(r) != 0);
    fclose(r);

    return 0;
}
