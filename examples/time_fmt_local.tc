// 时间格式化（M56）本地时区 + 时钟演示
//
// now() 返回当前毫秒 Unix epoch；format_time_local 按本机本地时区解释。
// 因输出依赖「运行时刻」与「本机时区」，本文件不配 .expected.txt（run_examples 会跳过），
// 仅作可运行的用法演示。需要确定输出的比对示例见 time_fmt_demo.tc。

@main
fn main() i64 {
    var t: i64 = now();
    println(format_time("%Y-%m-%d %H:%M:%S", t));        // UTC
    println(format_time_local("%Y-%m-%d %H:%M:%S", t)); // 本机本地时区
    return 0;
}
