// struct-modifiers · extend overload struct 跨文件扩展 · 文件 B（Task #6 搬运自
// docs/design/struct-modifiers/EXAMPLES_extend_b.tc）
//
// 配对：examples/struct_extend_a.tc —— 必须与 A 在同一编译单元合并才合法：
//   tc run examples/struct_extend_a.tc examples/cross/struct_extend_b.tc
// 单独编译本文件应报 T-OVL-E980（无 overload 组可扩展，同 f_struct_extend_no_group.tc）。

// extend overload struct：向 A 中声明的 overload 组 Entity 追加成员。
// 合并后 Entity 形态：id, pos, _, tag + describe(self)
extend overload struct Entity {
    tag: u32;
    fn describe(self: Entity) string {
        return "entity#" + int_to_str(self.id as i64)
             + " tag="   + int_to_str(self.tag as i64);
    }
}

// 合并后，A 的 main 之外的使用方同样可用 extend 出来的字段/方法。
fn use_extended() string {
    var e: Entity = Entity { id: 7, pos: 3 };
    e.tag = 99;                  // 来自 extend 的字段（排在字段链尾部）
    return e.describe();         // 来自 extend 的方法
}
