// 元组 / 结构字面量模式匹配（KI-002 修复回归）
// 覆盖：命名结构字面量模式、具名元组(合成结构)字面量模式、多臂 + 兜底 `_`、
//       部分字段模式（仅匹配部分字段，其余隐式任意）。
struct Pt { x: i64; y: i64; }
struct IntPair { i64, i64 }

fn classify_pt(p: Pt) i64 {
    return match (p) {
        Pt{ x: 0, y: 0 } => 1
        Pt{ x: 0 } => 2
        Pt{ y: 0 } => 3
        _ => 0
    };
}

fn classify_pair(p: IntPair) i64 {
    return match (p) {
        IntPair{ ._0 = 0, ._1 = 0 } => 10
        IntPair{ ._0 = 0 } => 20
        IntPair{ ._1 = 0 } => 30
        _ => 0
    };
}

@main fn main() i32 {
    println(int_to_str(classify_pt(Pt{ x: 0, y: 0 })));
    println(int_to_str(classify_pt(Pt{ x: 0, y: 5 })));
    println(int_to_str(classify_pt(Pt{ x: 7, y: 0 })));
    println(int_to_str(classify_pt(Pt{ x: 1, y: 2 })));
    println(int_to_str(classify_pair(IntPair{ ._0 = 0, ._1 = 0 })));
    println(int_to_str(classify_pair(IntPair{ ._0 = 0, ._1 = 9 })));
    println(int_to_str(classify_pair(IntPair{ ._0 = 8, ._1 = 0 })));
    println(int_to_str(classify_pair(IntPair{ ._0 = 3, ._1 = 4 })));
    return 0;
}
