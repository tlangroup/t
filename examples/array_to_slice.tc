// 定长数组 → 切片 零拷贝视图（#7 回归用例）
// 预期输出: 60
fn sum(s: []i64) i64 {
    var total: i64 = 0;
    for (x in s) {
        total = total + x;
    }
    return total;
}

@main
fn main() i64 {
    var arr: [_]i64 = [10, 20, 30];
    var s: []i64 = arr;          // [N]T → []T 转型（array→slice cast）
    println(int_to_str(sum(s)));
    return 0;
}
