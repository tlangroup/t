// Agent 一等公民（编译器宪法支柱）：actor 底层 + 用户态编排。
//
// 一个 `X agent { ... }` 声明在脱糖阶段展开为三个顶层符号，
// 命名严格遵守函数 = snake_case 规范：
//   CounterState         —— 状态 struct（字段 = state 列表，PascalCase 类型名）
//   counter_spawn(init)  —— 构造器：一参一字段，返回 CounterState
//   counter_step(s, msg) —— 步进器：接收 (状态, 消息)，返回新状态
//
// 本例用 i64 消息驱动计数器；spawn(0) 把初始 count 设为 0，
// 两次 step 分别 +5、+3，最终 count = 8。

Counter agent {
    state count: i64;
    step fn(s: CounterState, msg: i64) CounterState {
        s.count = s.count + msg;
        return s;
    }
}

fn pr(label: string, v: i64) void {
    var b: StringBuilder = sb_new();
    sb_append_str(b, label);
    sb_append_i64(b, v);
    println(sb_to_str(b));
}

@main
fn main() i64 {
    var c: CounterState = counter_spawn(0);
    c = counter_step(c, 5);
    c = counter_step(c, 3);
    pr("count = ", c.count);
    return 0;
}
