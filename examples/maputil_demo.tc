// examples/maputil_demo.tc —— std.maputil 用法演示（双后端语义验证）
// 运行: tc run --example maputil_demo
// 依赖: lib/std/maputil.tc（源码内联导入）
@import("std.maputil");

fn main_fn() i32 @main {
    var m: map[string]i64 = ["alice": 1, "bob": 2, "carol": 3];
    // 键（插入序）
    var ks: []string = maputil.keys(string, i64, m);
    println(i2s(slice_len(ks)));                       // 3
    var i: u64 = 0;
    while (i < slice_len(ks)) { println(ks[i]); i = i + 1; }   // alice / bob / carol
    // 值（插入序，与键一一对应）
    var vs: []i64 = maputil.values(string, i64, m);
    println(i2s(slice_len(vs)));                       // 3
    var j: u64 = 0;
    while (j < slice_len(vs)) { println(i2s(vs[j])); j = j + 1; }  // 1 / 2 / 3
    // 原地清空
    maputil.clear(string, i64, m);
    println(i2s(map_len(m)));                          // 0
    return 0;
}
