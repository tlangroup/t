// P4：Never 底类型 + 跳转原语归 Never。
// ① 值位置 if 的某一臂为 @panic（归 Never），经 widen_only_lub 跳过 → 整体类型由其余臂决定。
// ② 值循环体恒交付（仅含 break <值> / @panic）→ 可省略 else 子句（T-SEM-E280 不再触发）。
@main
fn main() i64 {
    // 值 if：else 臂 @panic 归 Never ⇒ lub(Never, i64) = i64
    var v: i64 = if (true) { 1; } else { @panic("unreachable"); };
    // 值循环：体仅 break 7（恒交付）→ 省略 else 合法
    var r: i64 = while (true) {
        break 7;
    };
    println(int_to_str(v));
    println(int_to_str(r));
    return 0;
}
