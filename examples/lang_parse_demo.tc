// 示例：外部工具（format / lint / tdagen）通过 std.lang.parse_file 拿到通用 AST，
// 无需依赖编译器内部节点表 —— 本工程与 thyme 共用同一套前端。
const lang = @import("std.lang");

@main fn main() i64 {
    var src: string =
        "#pb struct Object {\n" +
        "  angle: f64 @ 1 @thyme_range(0, 180);\n" +
        "  id: u64 @ 3 @thyme_id;\n" +
        "  name: ?string @ 5;\n" +
        "}\n" +
        "\n" +
        "#pb enum Color : i32 {\n" +
        "  RED = 0 @thyme_deprecated;\n" +
        "  GREEN = 1;\n" +
        "  BLUE = 7;\n" +
        "}\n" +
        "\n" +
        "struct Point { x: i64; y: i64; }\n" +
        "\n" +
        "fn add(a: i64, b: i64) i64 {\n" +
        "  var s: string = \"hi\";\n" +
        "  if (a > b) { return a; } else { return b; }\n" +
        "  while (a < 10) { a = a + 1; }\n" +
        "  for (var k: i64 = 0; k < 3; k = k + 1) { println(k); }\n" +
        "  match (a) { 1 => 10, 2 => 20, _ => 0 };\n" +
        "  return a + b;\n" +
        "}\n" +
        "\n" +
        "const PI: f64 = 3.14;\n" +
        "\n" +
        "@deprecated\n" +
        "fn legacy() void {\n" +
        "  var s: string = \"hi\";\n" +
        "}\n";

    var f: lang.File = lang.parse_file(src);
    println(lang.dump_file(f));
    return 0;
}
