// ADT 演示（abstract / open variant）：尾部 `_` 标记开放和类型
// match 豁免穷尽性强制：调用方只知部分 case，其余落 `_` 兜底臂。
// 运行时未知 tag 走 `_`（确定性，不读垃圾值，满足 L-09 零 UB）。
variant Status { Ok(i64); Err(i64); _ }

fn describe(s: Status) i64 {
    return match (s) {
        Ok(v) => v
        Err(v) => 0 - v
        _ => -999
    };
}

@main
fn main() i64 {
    println(int_to_str(describe(Status_from_Ok(7))));
    println(int_to_str(describe(Status_from_Err(3))));
    return 0;
}
