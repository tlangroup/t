// A1a 验证：f"{v!j}" 对聚合值（结构/切片/数组/映射）与泛型值做 JSON 编码。
struct Point {
    x: i64;
    y: i64;
}

struct Shape {
    name: string;
    origin: Point;
    tags: []string;
    score: f64;
    ok: bool;
}

// 泛型值：meta T: type 在编译期单态化为具体类型，f"{v!j}" 按具体类型生成编码。
fn jdump(meta T: type, v: T) string {
    return f"{v!j}";
}

fn main() i64 @main {
    var p: Point = Point{ x: 3, y: -7 };
    print(f"{p!j}\n");

    var s: Shape = Shape{
        name: "box",
        origin: Point{ x: 1, y: 2 },
        score: 1.5,
        ok: true,
    };
    var __e_tags: []string = [];
    s.tags = __e_tags;
    append(s.tags, "a");
    append(s.tags, "bb");
    append(s.tags, "d");
    print(f"{s!j}\n");

    var xs: []i64 = [10, 20, 30];
    print(f"{xs!j}\n");

    var pts: []Point = [];
    append(pts, Point{ x: 1, y: 1 });
    append(pts, Point{ x: 2, y: 2 });
    print(f"{pts!j}\n");

    var m: map[string]i64 = ["k1": 100, "k2": 200];
    print(f"{m!j}\n");

    // 泛型值路径
    print(jdump(Point, p) + "\n");
    print(jdump(Shape, s) + "\n");

    // 标量 / 字符串仍走原路径
    var hv: string = "hi";
    print(f"{42!j} {true!j} {1.25!j} {hv!j}\n");

    // 非 !j 的聚合应报错（编译期）
    // print(format("{0}", s));
    return 0;
}
