// 示例：thyme tdagen / lint 通过 std.lang.parse_schema 拿到结构化 Schema，
// 无需依赖编译器内部 AST —— 同一套前端代码，本工程与 thyme 共用。
const lang = @import("std.lang");

@main fn main() i64 {
    var src: string =
        "#pb struct Object {\n" +
        "  angle: f64 @ 1 @thyme_range(0, 180);\n" +
        "  id: u64 @ 3 @thyme_id;\n" +
        "}\n" +
        "#pb enum Color : i32 {\n" +
        "  RED = 0 @thyme_deprecated;\n" +
        "  GREEN = 1;\n" +
        "  BLUE = 7;\n" +
        "}\n";

    var s: lang.Schema = lang.parse_schema(src);

    println("=== structs (" + i2s(slice_len(s.structs) as i64) + ") ===");
    var i: i64 = 0;
    while (i < slice_len(s.structs) as i64) {
        var st = s.structs[i];
        println("struct " + st.name + "  is_pb=" + i2s(st.is_pb as i64));
        var j: i64 = 0;
        while (j < slice_len(st.fields) as i64) {
            var f = st.fields[j];
            println("  field " + f.name + " : " + f.type_name + "  tag=" + i2s(f.tag) + "  anns=" + i2s(slice_len(f.annotations) as i64));
            var a: i64 = 0;
            while (a < slice_len(f.annotations) as i64) {
                println("    @" + f.annotations[a].name);
                a = a + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }

    println("=== enums (" + i2s(slice_len(s.enums) as i64) + ") ===");
    i = 0;
    while (i < slice_len(s.enums) as i64) {
        var e = s.enums[i];
        println("enum " + e.name + " : " + e.underlying + "  is_pb=" + i2s(e.is_pb as i64));
        var j: i64 = 0;
        while (j < slice_len(e.members) as i64) {
            println("  " + e.members[j].name + " = " + i2s(e.members[j].value));
            j = j + 1;
        }
        i = i + 1;
    }
    return 0;
}
