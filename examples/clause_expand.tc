// clause_expand.tc — 一等子句：match 臂位置接住子句组并展开（N10）+ 重排定形（N11）
// 设计：docs/compiler/first-class-clause.md §5.4
//
// ⚠ 本用例的核心探针是 **N11 重排**：`C_WILD`（无守卫通配）被**写在组的最前面**。
//   若不重排，它是不可反驳臂 ⇒ 恒命中 ⇒ pick(0)/pick(1) 都会返回 -1，输出变成
//   `-1 -1 -1`（与 KI-002「恒命中首臂」同族症状）。
//   重排后它落到末位充当 else ⇒ 前列 case 各自命中，输出 `10 11 -1`。
//
// 另验证：未标注的 `const C0 = @clause(...)` 与标注写法行为一致（符号类型回填）。

const C0 = @clause(.pattern, 0, 10);
const C1 = @clause(.pattern, 1, 11);
const C_WILD = @clause(.pattern, _, 0 - 1);

// 通配写在最前 —— 期望被重排到末位
const G = [C_WILD, C0, C1];

fn pick(x: i64) i64 {
    return match (x) { G };
}

// 带守卫的子句 + 通配兜底：守卫为假时落到 else
const H = [
    @clause(.pattern, n, when n > 100, 99),
    @clause(.pattern, _, 0 - 2),
];

fn clamp(x: i64) i64 {
    return match (x) { H };
}

@main
fn main() i64 {
    println(int_to_str(pick(0)));    // 10
    println(int_to_str(pick(1)));    // 11
    println(int_to_str(pick(7)));    // -1  （else）
    println(int_to_str(clamp(500))); // 99  （守卫为真）
    println(int_to_str(clamp(5)));   // -2  （守卫为假 → else）
    return 0;
}
