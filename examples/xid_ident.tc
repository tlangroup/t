// Unicode 标识符（XID_Start / XID_Continue）验证
// 变量名/函数名可用中文、希腊字母、带数字/下划线等。
// 不依赖 println（C 后端此前未实现数值打印），改用退出码验证计算结果。

主函数 fn() i64 {
    var 名字: i64 = 10;
    var π: i64 = 20;
    var 计数_2: i64 = 名字 + π;
    var 结果: i64 = 计数_2 * 2;
    return 结果;        // 期望 (10+20)*2 = 60
}

main_fn fn() i32 @main {
    var r: i64 = 主函数();
    return r as i32;
}