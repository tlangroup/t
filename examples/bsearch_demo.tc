// examples/bsearch_demo.tc —— std.sort.binary_search 用法演示（双后端语义验证）
// 运行: tc run --example bsearch_demo
// 依赖: lib/std/sort.tc（源码内联导入）
@import("std.sort");

fn greater_i64(a: i64, b: i64) bool { return a > b; }

fn main_fn() i32 @main {
    // i64 升序二分：命中 / 边界命中 / 未命中 / 下界外
    var xs: []i64;
    append(xs, 1); append(xs, 2); append(xs, 5); append(xs, 5); append(xs, 9);
    sort.sort_slice(i64, xs, sort.less_i64);
    println(i2s(sort.binary_search(i64, xs, 5, sort.less_i64)));   // 2（首个 5）
    println(i2s(sort.binary_search(i64, xs, 9, sort.less_i64)));   // 4（上界）
    println(i2s(sort.binary_search(i64, xs, 7, sort.less_i64)));   // -1（中间空缺）
    println(i2s(sort.binary_search(i64, xs, 0, sort.less_i64)));   // -1（下界外）

    // 字符串字典序二分
    var names: []string;
    append(names, "apple"); append(names, "banana"); append(names, "cherry");
    sort.sort_slice(string, names, sort.less_string);
    println(i2s(sort.binary_search(string, names, "banana", sort.less_string))); // 1
    println(i2s(sort.binary_search(string, names, "durian", sort.less_string))); // -1（不存在）

    // 边界：空切片 / 单元素
    var empty: []i64;
    println(i2s(sort.binary_search(i64, empty, 1, sort.less_i64)));  // -1
    var one: []i64;
    append(one, 42);
    println(i2s(sort.binary_search(i64, one, 42, sort.less_i64)));  // 0
    println(i2s(sort.binary_search(i64, one, 7, sort.less_i64)));    // -1
    return 0;
}
