// 字面量全量演示（reference.md §2.4）
// 双后端（LLVM / C）逐字节一致，输出见 literal_demo.expected.txt

main_fn fn() i32 @main {
    // ── 整数：分隔符与进制 ──────────────────────────────────
    var million: i64 = 1_000_000;
    var hex: i64 = 0xDEAD_BEEF;
    var oct: i64 = 0o755;
    var bin: i64 = 0b1010_1010;
    println(format("dec={} hex={} oct={} bin={}", million, hex, oct, bin));

    // ── 位宽后缀：类型由后缀定死 ────────────────────────────
    // 无后缀时整数字面量按量级推最小无符号类型，`-255` 会先成 u8 再取负 → 1；
    // 写成 `-255i32` 则显式落在 i32 上。
    var u8max: u8 = 255u8;
    var i8min: i8 = -128i8;
    var neg: i32 = -255i32;
    var big: i64 = 9_223_372_036_854_775_807i64;
    println(format("u8max={} i8min={} neg={} big={}", u8max, i8min, neg, big));

    // ── 浮点：指数、后缀、IEEE-754 特殊值 ───────────────────
    var giga: f64 = 1e9;
    var milli: f64 = 1.5e-3;
    var single: f32 = 1.5f32;
    var pinf: f64 = inf;
    var ninf: f64 = -inf;
    var q: f64 = nan;
    println(format("giga={} milli={} single={}", giga, milli, single));
    println(format("pinf={} ninf={} nan_ne_self={}", pinf, ninf, q != q));

    // ── 字节字符：'x' 求值为 u8 ─────────────────────────────
    var a: u8 = 'A';
    var tab: u8 = '\t';
    var del: u8 = '\x7F';
    println(format("A={} tab={} del={}", a, tab, del));

    // ── 字符串：转义、原始串、长串 ──────────────────────────
    println("esc: [\t] [\x41] [\u{4e2d}] [\\] [\"]");
    println(r"raw: C:\no\escape\n\here");
    println("""long: 第一行
long: 第二行""");
    println(r"""rawlong: \n 保持两个字符
rawlong: 第二行""");
    return 0;
}
