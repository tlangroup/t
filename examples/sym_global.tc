// 全局 Sym 变量演示（M40）：验证全局作用域的 Sym32/Sym16 声明 + 运行期自动 intern。
// 全局 var 的字符串初始化器含 intern 调用，会被搬进 t__ginit（C）/ t.__ginit（LLVM）。
var gNpc: Sym32("NPCName") = "Alice";
var gItem: Sym16("ItemId") = "Sword";

@main
main fn() i64 {
    // 全局 Sym 与局部 Sym 同池比较（按 id，O(1)）
    var localNpc: Sym32("NPCName") = "Alice";
    if (gNpc == localNpc) {
        println("global-dedup");
    }
    println(sym_str(gNpc));   // Alice
    println(sym_str(gItem));  // Sword
    sym_release("NPCName");
    sym_release_all();
    return 0;
}
