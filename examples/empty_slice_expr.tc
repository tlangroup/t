// empty_slice_expr.tc —— 空切片字面量 `[]` 作**表达式**（非局部初始化器）
// （gap-scan P0-4：LLVM 曾发射 `ptr 0` → clang 拒绝）
//
// 三种期望类型为 `[]T` 的表达式上下文：
//   ① 调用实参（切片形参）：`take([])`
//   ② 赋值 RHS：`b = []`
//   ③ 经函数往返：`echo([])` 返回后再取长度
// 注：`var s: []i64 = []` 的局部初始化器形态由 slice_literal_arg.tc 覆盖，本例补其余三种。

fn take(s: []i64) i64 { return slice_len(s) as i64; }
fn echo(s: []i64) []i64 { return s; }

@main
fn main() i64 {
    println(int_to_str(take([])));                    // 0
    var b: []i64 = [];
    b = [];
    println(int_to_str(slice_len(b) as i64));         // 0
    var c: []i64 = echo([]);
    println(int_to_str(slice_len(c) as i64));         // 0
    return 0;
}
