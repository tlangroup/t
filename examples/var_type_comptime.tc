// S3 (阶段1 Q1)：持有 type 值的局部变量（var x: type = ...）→ 编译期绑定，代码期擦除。
// 运行期作用域声明 var t: type，comptime 块内引用 t 做编译期分支；程序本身无运行期输出，
// 仅用于双后端构建/运行对拍（smoke），验证 S3 的「运行期 var x: type + 编译期解析 + 擦除」通路。
@main fn main() i32 {
    var t: type = i64;
    comptime {
        if (t == i64) {
            @compile_log("t is i64");
        }
        if (t != u32) {
            @compile_log("t is not u32");
        }
    }
    return 0;
}
