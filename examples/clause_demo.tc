// clause_demo.tc — 验证函数子句模式匹配（L-15 / docs/syntax/drafts/match.md §7）
// 函数子句是 match 的**纯语法糖**：多条同名 FuncDecl 在 AST lowering 阶段被
// 强制脱糖为单一 FuncDecl，其体即 `return match (__p0) { ... };`。
// 覆盖：① 字面量模式子句 ② 裸绑定 + `when` 守卫 ③ `_` 通配兜底
//       ④ 多参子句（非首位模式折叠进守卫、同名绑定直接作形参）
//       ⑤ 字符串子句 ⑥ 子句与普通函数混用 ⑦ 子句递归
// 预期输出见 examples/clause_demo.expected.txt。

@main
main fn() i64 {
    test_scalar();
    test_multi();
    test_string();
    test_recur();
    return 0;
}

// ── ① 字面量 + ② 绑定守卫 + ③ 通配 ──────────────────────────
classify fn(0) string { return "zero"; }
classify fn(n when n > 0) string { return "positive"; }
classify fn(_) string { return "negative"; }

test_scalar fn() void {
    println(classify(0));
    println(classify(7));
    println(classify(0 - 3));
}

// ── ④ 多参子句：首位走 match，其余位折叠进守卫；同名绑定 k 直接作形参 ──
pick fn(1, k: i64) i64 { return k * 10; }
pick fn(2, k) i64 { return k * 100; }
pick fn(m, k) i64 { return m + k; }

test_multi fn() void {
    println(int_to_str(pick(1, 2)));
    println(int_to_str(pick(2, 2)));
    println(int_to_str(pick(9, 2)));
}

// ── ⑤ 字符串子句 + ⑥ 与普通函数混用 ─────────────────────────
greet fn("zh") string { return "nihao"; }
greet fn("en") string { return "hello"; }
greet fn(_) string { return "?"; }

shout fn(s: string) string {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, s);
    sb_append_str(sb, "!");
    return sb_to_str(sb);
}

test_string fn() void {
    println(shout(greet("zh")));
    println(shout(greet("en")));
    println(shout(greet("fr")));
}

// ── ⑦ 子句递归 ───────────────────────────────────────────────
fib fn(0) i64 { return 0; }
fib fn(1) i64 { return 1; }
fib fn(n when n > 1) i64 { return fib(n - 1) + fib(n - 2); }
fib fn(_) i64 { return 0 - 1; }

test_recur fn() void {
    println(int_to_str(fib(0)));
    println(int_to_str(fib(1)));
    println(int_to_str(fib(10)));
    println(int_to_str(fib(0 - 5)));
}
