// examples/cli_demo.tc —— std.cli 用法演示（双后端语义验证）
// 运行: tc run --example cli_demo
// 依赖: lib/std/cli.tc（源码内联导入）
// 直接用构造好的 []string 模拟 argv（确定性，双后端一致）。
@import("std.cli");

fn b2s(b: bool) string {
    if (b) { return "true"; }
    return "false";
}

fn main_fn() i32 @main {
    var argv: []string;
    append(argv, "prog");
    append(argv, "--verbose");
    append(argv, "--count=42");
    append(argv, "-m=release");
    append(argv, "--");
    append(argv, "file1.txt");
    append(argv, "file2.txt");

    var fl: map[string]string;
    var pos: []string = cli.parse_args(argv, fl);

    println(b2s(cli.has_flag(fl, "verbose")));     // true
    println(cli.get_flag(fl, "count"));             // 42
    println(cli.get_flag(fl, "m"));                 // release
    println(i2s(cli.get_flag_int(fl, "count", 0))); // 42
    println(cli.get_flag_str(fl, "nope", "def"));   // def
    println(i2s(slice_len(pos)));                   // 3（prog, file1.txt, file2.txt）
    var i: u64 = 0;
    while (i < slice_len(pos)) { println(pos[i]); i = i + 1; }   // prog / file1.txt / file2.txt
    return 0;
}
