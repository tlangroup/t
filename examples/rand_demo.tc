// examples/rand_demo.tc —— std.rand 用法演示（双后端语义验证）
// 运行: tc run --example rand_demo
// 依赖: lib/std/rand.tc（源码内联导入）
// 注意：确定性 LCG，seed=42 时输出固定，双后端必须逐字节一致。
@import("std.rand");

fn main_fn() i32 @main {
    rand.srand(42);
    // 固定序列 [0, 2^31)
    println(i2s(rand.rand_i64()));
    println(i2s(rand.rand_i64()));
    println(i2s(rand.rand_i64()));
    println(i2s(rand.rand_i64()));
    // 范围 [1, 7)
    println(i2s(rand.rand_range(1, 7)));
    println(i2s(rand.rand_range(1, 7)));
    println(i2s(rand.rand_range(1, 7)));
    // 浮点 [0,1)：乘 1000 取整打印（整数部分 0..999，确定）
    var f: f64 = rand.rand_float();
    println(i2s((f * 1000.0) as i64));
    var f2: f64 = rand.rand_float();
    println(i2s((f2 * 1000.0) as i64));
    return 0;
}
