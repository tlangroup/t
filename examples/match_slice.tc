// 双后端运行时语义验证：切片模式（S6）。
// 形如 [a, b] / [] / [first, .., last] / [a, ..] / [.., last] / [..]，
// 以及字面量元素 [1, 2] / [1, .., 3] / ["a", "b"]，在 []i64 与 []string 上
// 双后端逐字节一致（run_examples 交叉验证）。
// 切片无有限穷尽集，每个 match 必须以 `_` / `[..]` / `[]`+精确臂组合收尾，否则穷尽性报错。
//
// 详见 docs/syntax/drafts/match_extensions.md（S6 状态=已实现）与 match.md §6.1。

fn head2(s: []i64) i64 {
    return match (s) {
        [a, b] => a * 10 + b
        _ => -1
    };
}

fn front_back(s: []i64) i64 {
    return match (s) {
        [first, .., last] => first + last
        _ => -1
    };
}

fn take_first(s: []i64) i64 {
    return match (s) {
        [a, ..] => a
        _ => -1
    };
}

fn take_last(s: []i64) i64 {
    return match (s) {
        [.., last] => last
        _ => -1
    };
}

fn classify_len(s: []i64) string {
    return match (s) {
        [] => "zero"
        [x] => "one"
        [x, y] => "two"
        [..] => "many"
    };
}

fn first_last_str(s: []string) string {
    return match (s) {
        [first, .., last] => first + "/" + last
        [only] => only
        [] => "empty"
        _ => "many"
    };
}

fn lit_pair(s: []i64) string {
    return match (s) {
        [1, 2] => "one-two"
        [1, .., 3] => "one-3"
        _ => "other"
    };
}

fn lit_str(s: []string) string {
    return match (s) {
        ["a", "b"] => "ab"
        _ => "x"
    };
}

@main
fn main() i32 {
    var ok: bool = true;
    // 精确长度 [a, b]
    if (head2([2, 3]) != 23) { ok = false; }
    if (head2([1, 2]) != 12) { ok = false; }
    if (head2([9]) != -1) { ok = false; }
    // 中段 rest：[first, .., last]
    if (front_back([2, 3]) != 5) { ok = false; }
    if (front_back([1, 2, 3]) != 4) { ok = false; }
    if (front_back([4, 5, 6, 7]) != 11) { ok = false; }
    // 前缀 rest：[a, ..]
    if (take_first([5, 6, 7]) != 5) { ok = false; }
    if (take_first([9]) != 9) { ok = false; }
    if (take_first([]) != -1) { ok = false; }
    // 后缀 rest：[.., last]
    if (take_last([5, 6, 7]) != 7) { ok = false; }
    if (take_last([9]) != 9) { ok = false; }
    if (take_last([]) != -1) { ok = false; }
    // 长度分级：[]. [x], [x, y], [..]
    if (classify_len([]) != "zero") { ok = false; }
    if (classify_len([5]) != "one") { ok = false; }
    if (classify_len([5, 6]) != "two") { ok = false; }
    if (classify_len([5, 6, 7]) != "many") { ok = false; }
    // 字符串切片：[first, .., last] / [only] / []
    if (first_last_str(["x", "y"]) != "x/y") { ok = false; }
    if (first_last_str(["x", "y", "z"]) != "x/z") { ok = false; }
    if (first_last_str(["solo"]) != "solo") { ok = false; }
    if (first_last_str([]) != "empty") { ok = false; }
    if (first_last_str(["a", "b", "c", "d"]) != "a/d") { ok = false; }
    // 字面量元素：[1, 2] / [1, .., 3]
    if (lit_pair([1, 2]) != "one-two") { ok = false; }
    if (lit_pair([1, 9]) != "other") { ok = false; }
    if (lit_pair([1, 4, 3]) != "one-3") { ok = false; }
    if (lit_pair([7, 8]) != "other") { ok = false; }
    // 字符串字面量元素：["a", "b"]
    if (lit_str(["a", "b"]) != "ab") { ok = false; }
    if (lit_str(["a", "c"]) != "x") { ok = false; }
    if (ok == false) {
        println("FAIL");
        return 1;
    }
    println("match_slice ok");
    return 0;
}
