// O-7：`T → ?T` 隐式提升（对齐 Zig Z3）。
//
// Zig 没有 `some()` —— 靠「T 可隐式装进 ?T」把构造函数整个消灭：
//   const a: ?i64 = 5;          // 无需仪式
// t 的宪法条款 L-02 原本禁止该方向的自动转换；本次按裁定放开，
// 前提是 O-6 已把 ?T 换成按值布局 `{ i64 __tag, E __val }` ——
// 此时提升只是「写一个 tag 字节」，而非一次隐式堆分配。
//
// 反向（?T → T）**仍然永不隐式**：取值必须写下来（.? / orelse / unwrap）。

fn take(v: ?i64) i64 {
    if (is_some(v)) { return v.?; }
    return -1;
}

fn give(ok: bool) ?i64 {
    if (ok) { return 7; }        // 返回位同样隐式提升
    return null;                 // none 仍然显式
}

@main
fn main() i64 {
    var a: ?i64 = 5;             // 整数字面量直接装进 ?i64
    println(f"a.?={a.?}");

    var n: i64 = 9;
    var b: ?i64 = n;             // 变量直接装进 ?i64
    println(f"b.?={b.?}");

    var c: ?i64 = null;          // none 仍然显式（不会被提升）
    println(f"c.is_none={is_none(c)}");

    println(f"take(3)={take(3)}");       // 实参位隐式提升
    println(f"take(n)={take(n)}");
    println(f"give(true).?={give(true).?}");
    println(f"give(false).is_none={is_none(give(false))}");

    println(f"orelse={c orelse 42}");
    println(f"orelse_some={a orelse 42}");

    // 反向不隐式：`var d: i64 = a;` 仍是编译错误（expected i64 but got ?i64）
    return 0;
}
