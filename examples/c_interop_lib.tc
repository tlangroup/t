// C 互操作导出库（无入口，供外部 C 链接调用）
// 由 `tc.exe emit-ll` 产出 .ll 后，与 C 驱动 examples/c_interop_driver.c 一并链接即可跨语言调用。
// 语法：`pub` 在前、`@c_export` 在后（与 `pub @import(...)` 同序）。
pub @c_export fn add(a: i64, b: i64) i64 {
    return a + b;
}

pub @c_export fn fib(n: i64) i64 {
    if (n < 2) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}
