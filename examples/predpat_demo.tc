// 谓词模式（fault 批次 B2）：`.{ .f <op> v }` 形态的具名字段关系匹配。
//
// ⚠ 本用例刻意包含**「应当不命中」的分叉**：KI-002（struct 字面量模式在 match 中）
// 当年漏测的根源正是用例只覆盖了「应该匹配」的场景，而那种场景恰好侥幸正确。
// ⇒ 每条谓词臂都配一个「不满足该谓词」的输入，验证它**真的没有**被命中。
//
// 关系运算符集合：`<` `>` `<=` `>=` `==` `!=`；其余（如 `+`）在 sema 期报 T-MAT-E745。

struct User {
    age:   i64;
    score: i64;
}

// ── 单谓词：两条谓词臂 + 一条通配 ────────────────────────────────
fn judge(u: User) i64 {
    return match (u) {
        .{ .age < 0 }   => 0 - 1,
        .{ .age > 120 } => 1,
        _ => 0,
    };
}

// ── 多合取项（AND 语义）：两条件**同时**成立才命中 ────────────────
fn risky(u: User) i64 {
    return match (u) {
        .{ .age > 10, .score < 60 } => 9,
        _ => 0,
    };
}

// ── 等值 / 不等值 ────────────────────────────────────────────────
fn exact(u: User) i64 {
    return match (u) {
        .{ .score == 100 } => 7,
        .{ .score != 0 }   => 5,
        _ => 0,
    };
}

// ── 谓词与字面量混合：`.name = ""` 仍是等值，`.age < 0` 是谓词 ────
fn mixed(u: User) i64 {
    return match (u) {
        .{ .age == 0, .score == 0 } => 3,
        .{ .age <= 18 }               => 2,
        _ => 1,
    };
}

@main fn main() i32 {
    // 命中分叉
    println(int_to_str(judge(User{ age: 0 - 5, score: 0 })));   // -1
    println(int_to_str(judge(User{ age: 200, score: 0 })));      //  1
    // ⚠ 不命中分叉：正常年龄必须落到 `_`
    println(int_to_str(judge(User{ age: 30, score: 0 })));      //  0

    // 合取：两条同时满足
    println(int_to_str(risky(User{ age: 20, score: 50 })));   //  9
    // ⚠ 不命中分叉：只满足 age>10
    println(int_to_str(risky(User{ age: 20, score: 90 }))); //  0
    // ⚠ 不命中分叉：只满足 score<60
    println(int_to_str(risky(User{ age: 5, score: 50 }))); //  0

    // 等值优先于不等值
    println(int_to_str(exact(User{ age: 1, score: 100 }))); //  7
    println(int_to_str(exact(User{ age: 1, score: 42 }))); //  5
    // ⚠ 不命中分叉：score==0 ⇒ 两条谓词臂都不该命中
    println(int_to_str(exact(User{ age: 1, score: 0 }))); //  0

    // 等值合取优先，其次 <= 谓词
    println(int_to_str(mixed(User{ age: 0, score: 0 }))); //  3
    println(int_to_str(mixed(User{ age: 18, score: 7 }))); //  2
    // ⚠ 不命中分叉：age>18 ⇒ 只落 `_`
    println(int_to_str(mixed(User{ age: 19, score: 7 }))); //  1

    return 0;
}
