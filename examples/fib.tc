// 斐波那契数列：递归 vs 迭代
// 运行: tc1 run --example fib

fib_rec fn(n: i64) i64 {
    if (n < 2) {
        return n;
    }
    return fib_rec(n - 1) + fib_rec(n - 2);
}

fib_iter fn(n: i64) i64 {
    var a: i64 = 0;
    var b: i64 = 1;
    var i: i64 = 0;
    while (i < n) {
        var t: i64 = a + b;
        a = b;
        b = t;
        i = i + 1;
    }
    return a;
}

main_fn fn() i32 @main {
    var sb: StringBuilder = sb_new();
    var i: i64 = 0;
    while (i <= 20) {
        sb_append_str(sb, "fib(");
        sb_append_i64(sb, i);
        sb_append_str(sb, ") = ");
        sb_append_i64(sb, fib_iter(i));
        sb_append_char(sb, 10);
        i = i + 5;
    }
    print(sb_to_str(sb));

    if (fib_rec(20) == fib_iter(20)) {
        println("recursive == iterative: OK");
        return 0;
    }
    println("MISMATCH!");
    return 1;
}
