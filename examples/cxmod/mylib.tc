// 模块化 C 互操作导出（@module(pub) 库 → 函数名重整为 mylib__madd）
// 验证 cx_fwd 路径：t 侧真名为 mylib__madd，C 侧按 clean 名 `madd` 链接（转发器桥接）。
// 由 `tc.exe emit-ll` 产出 .ll 后，与 cxmod_driver.c 一并链接即可跨语言调用。
@module(pub)
pub @c_export fn madd(a: i64, b: i64) i64 {
    return a + b;
}

pub @c_export fn mfib(n: i64) i64 {
    if (n < 2) {
        return n;
    }
    return mfib(n - 1) + mfib(n - 2);
}
