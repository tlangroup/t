// P3 验证：循环 else 完成子句 + 循环作表达式取值（双后端零改动，脱糖为 block_expr）。
// 覆盖：while/for/for_each 三种循环 × break v × else，以及语句位置值循环。
// 注意：值循环的 else 是值块 `{ ... }`（与值 if 一致），必须以表达式结尾。
@main
fn main() i64 {
    var ok: i64 = 0;

    // 1. while + break v + else：首个平方 > 50 的数（=8，因 7*7=49、8*8=64）
    var i: i64 = 0;
    var r1: i64 = while (i < 10) {
        if (i * i > 50) { break i; }
        i = i + 1;
    } else { -1; };
    if (r1 == 8) { ok = ok + 1; }

    // 2. for（C 式）+ break v + else
    var r2: i64 = for (var j: i64 = 0; j < 10; j = j + 1) {
        if (j == 5) { break j * 2; }
    } else { -1; };
    if (r2 == 10) { ok = ok + 1; }

    // 3. for_each + break v + else：切片里首个偶数值
    var arr: []i64 = [1, 3, 4, 7];
    var r3: i64 = for (v in arr) {
        if (v % 2 == 0) { break v; }
    } else { -1; };
    if (r3 == 4) { ok = ok + 1; }

    // 4. 循环正常完成（不 break）→ 走 else 值
    var k: i64 = 0;
    var r4: i64 = while (k < 3) {
        if (k > 100) { break k; }
        k = k + 1;
    } else { 99; };
    if (r4 == 99) { ok = ok + 1; }

    // 5. 嵌套值循环：内循环 break v（带 else），外循环 break v（带 else）
    var r5: i64 = for (var a: i64 = 0; a < 3; a = a + 1) {
        var found: i64 = for (var b: i64 = 0; b < 3; b = b + 1) {
            if (a + b == 3) { break b; }
        } else { -1; };
        if (found >= 0) { break a * 10 + found; }
    } else { -1; };
    if (r5 == 12) { ok = ok + 1; }

    // 6. 语句位置的值循环（值被丢弃，仍应编译通过并正确运行）
    var z: i64 = 0;
    while (z < 1) {
        break 7;
    } else { -1; }

    println("ok=" + int_to_str(ok));
    if (ok == 5) { return 0; }
    return 1;
}
