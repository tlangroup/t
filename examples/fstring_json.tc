// f-string !j 聚合 JSON 编码 + 泛型单态化路径验证（A1a）
// 覆盖：struct / slice / 定长数组 的 !j JSON，以及泛型函数体内 !j 的单态化脱糖。
struct Point {
    x: i64;
    y: i64;
}

fn show(comptime T: type, v: T) string {
    return f"{v!j}";
}

@main
fn main() i64 {
    var p: Point = Point{ x: 3, y: 4 };
    println(f"struct: {p!j}");

    var s: []i64 = [1, 2, 3];
    println(f"slice: {s!j}");

    var a: [3]i64 = [10, 20, 30];
    println(f"array: {a!j}");

    var m: map[string]i64 = ["retries": 3, "timeout": 100];
    println(f"map: {m!j}");

    println(f"generic-struct: {show(Point, p)}");
    println(f"generic-int: {show(i64, 7)}");
    return 0;
}
