struct Point { x: i64; y: i64; }

fn main() i64 @main {
  // !j 聚合 JSON 编码：结构体
  var p: Point = Point{ x: 3, y: -7 };
  print(f"{p!j}\n");
  // !j 聚合 JSON 编码：切片
  var s: []i64 = [1, 2, 3];
  print(f"{s!j}\n");
  // !j 聚合 JSON 编码：映射
  var m: map[string]i64 = ["a": 1, "b": 2];
  print(f"{m!j}\n");
  return 0;
}
