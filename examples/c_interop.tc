// C 互操作导出示例（入口模块：clean name == 函数名，平铺入口直接标 extern "C"）
// 验证：emit-ll 应含 `define ccc i64 @add(i64 %p.a, i64 %p.b)`；emit-c 应含 `extern "C" i64 add(i64 a, i64 b)`
// 语法：可见性 `pub` 在前、注解 `@c_export` 在后（与 `pub @import(...)` 同序）。
pub @c_export fn add(a: i64, b: i64) i64 {
    return a + b;
}

pub @c_export fn fib(n: i64) i64 {
    if (n < 2) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

@main
fn main() i64 {
    println(int_to_str(add(2, 3)));
    println(int_to_str(fib(10)));
    return 0;
}
