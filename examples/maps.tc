// maps.tc — map[K]V 运行时行为示例（M29）
// 覆盖 map_new / map_set / map_get / map_has / map_len / map_del 与 m[k] 读索引，
// 三种键值组合：string→i64、i64→i64、i64→string。
// 期望输出见文件末尾注释；conformance 只做静态检查，运行时语义由本例守护。

b2i fn(b: bool) -> i64 {
    if (b) {
        return 1;
    }
    return 0;
}

emit fn(sb: StringBuilder, k: string, v: i64) -> void {
    sb_append_str(sb, k);
    sb_append_str(sb, "=");
    sb_append_str(sb, int_to_str(v));
    sb_append_char(sb, 10);
}

@main
main fn() -> i64 {
    var sb: StringBuilder = sb_new();

    // ── string key / i64 val ──
    var m: map[string]i64;
    m = map_new(m);
    var ka: string = "alice";
    var kb: string = "bob";
    var kc: string = "carol";
    var kz: string = "zed";
    var va: i64 = 1;
    var vb: i64 = 2;
    var vc: i64 = 3;
    map_set(m, ka, va);
    map_set(m, kb, vb);
    map_set(m, kc, vc);
    emit(sb, "len", map_len(m));
    emit(sb, "has_alice", b2i(map_has(m, ka)));
    emit(sb, "has_zed", b2i(map_has(m, kz)));
    emit(sb, "get_alice", map_get(m, ka));
    emit(sb, "get_carol", map_get(m, kc));
    emit(sb, "idx_bob", m[kb]);

    // 覆盖更新不增长
    var vx: i64 = 10;
    map_set(m, ka, vx);
    emit(sb, "upd_alice", map_get(m, ka));
    emit(sb, "len_after_upd", map_len(m));

    // 删除
    emit(sb, "del_bob", b2i(map_del(m, kb)));
    emit(sb, "len_after_del", map_len(m));
    emit(sb, "has_bob", b2i(map_has(m, kb)));
    emit(sb, "get_bob", map_get(m, kb));          // 未命中 → 零值
    emit(sb, "del_bob_again", b2i(map_del(m, kb)));

    // ── int key / i64 val ──
    var p: map[i64]i64;
    p = map_new(p);
    var p7: i64 = 7;
    var p8: i64 = 8;
    var v70: i64 = 70;
    var v80: i64 = 80;
    map_set(p, p7, v70);
    map_set(p, p8, v80);
    emit(sb, "int_len", map_len(p));
    emit(sb, "int_get7", map_get(p, p7));
    emit(sb, "int_idx8", p[p8]);
    var p9: i64 = 9;
    emit(sb, "int_miss", map_get(p, p9));

    // ── int key / string val ──
    var q: map[i64]string;
    q = map_new(q);
    var qk: i64 = 3;
    var qv: string = "hello";
    map_set(q, qk, qv);
    var got: string = map_get(q, qk);
    emit(sb, "strval_len", str_len(got) as i64);
    sb_append_str(sb, "strval=");
    sb_append_str(sb, got);
    sb_append_char(sb, 10);

    print(sb_to_str(sb));
    return 0;
}

// 期望输出见 examples/maps.expected.txt（19 行，已人工逐条核对）。
