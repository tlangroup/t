// 数组字面量作调用实参 —— 双后端运行时守卫。
//
// 验证 fn f(a: [N]T) 形参为定长数组时，`f([a,b,c,d])` 字面量实参在 LLVM / C
// 后端都能正确构造 scratch 数组并「按值」传入。
// 修复前：LLVM 退化为 `load [N x T], ptr 0` → clang 报
//   "integer constant must have integer type"；C 退化为 `f({...})` 非复合字面量。
//
// ⚠ conformance 只跑「诊断检查」不碰代码生成，本例只能经 run_examples 的
//   「LLVM + C」双后端实跑比对才能守住发射正确性。

fn sum4(a: [4]i64) i64 {
    return a[0] + a[1] + a[2] + a[3];
}

fn dot3(v: [3]f64) f64 {
    return v[0] + v[1] + v[2];
}

@main
fn main() i64 {
    // ① 整型数组字面量实参（期望 100）
    println(int_to_str(sum4([10, 20, 30, 40])));
    // ② 元素为表达式（非常量），期望 5+10+8+1 = 24
    var k: i64 = 5;
    println(int_to_str(sum4([k, k * 2, k + 3, 1])));
    // ③ f64 数组字面量实参（浮点求和 1.5+2.5+4.0 = 8.0），整数化输出避免打印误差
    var d: f64 = dot3([1.5, 2.5, 4.0]);
    println(int_to_str(d as i64));
    return 0;
}
