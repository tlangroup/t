// R2/R1 兜底臂重排回归：裸绑定兜底子句（无守卫/无模式）即便写在最前，也必须排到
// match 臂末尾，否则会遮蔽后续守卫子句（见 overload_cross_a.tc 的 classify 跨文件组）。
// 双后端一致（纯 i64 比较，无 struct 字面量模式）。
// 预期输出见 overload_catchall.expected.txt。

overload fn classify(n: i64) string {
    return "default";
}
overload fn classify(n: i64 when n > 100) string {
    return "big";
}
overload fn classify(n: i64 when n < 0) string {
    return "negative";
}

@main
fn main() i32 {
    println(classify(5));
    println(classify(200));
    println(classify(-1));
    return 0;
}
