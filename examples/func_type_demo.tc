// 函数类型（FuncType）演示：`fn(ArgTypes) -> Ret` 作为值类型
// v1 范围：只有顶层具名函数可以绑定到函数类型变量（函数指针语义，无闭包）。

add fn(a: i64, b: i64) -> i64 {
    return a + b;
}

sub fn(a: i64, b: i64) -> i64 {
    return a - b;
}

mul fn(a: i64, b: i64) -> i64 {
    return a * b;
}

shout fn(s: string) -> string {
    var b: StringBuilder = sb_new();
    sb_append_str(b, "<");
    sb_append_str(b, s);
    sb_append_str(b, ">");
    return sb_to_str(b);
}

// 函数类型作为参数：高阶函数
apply2 fn(f: fn(i64, i64) -> i64, a: i64, b: i64) -> i64 {
    return f(a, b);
}

// 函数类型作为返回值
pick fn(name: string) -> fn(i64, i64) -> i64 {
    if (name == "add") {
        return add;
    }
    if (name == "sub") {
        return sub;
    }
    return mul;
}

// 全局函数类型变量
var g_op: fn(i64, i64) -> i64 = add;

@main
main fn() -> i64 {
    // 1. 局部变量绑定 + 间接调用
    var f: fn(i64, i64) -> i64 = add;
    var r1: i64 = f(3, 4);
    var b1: StringBuilder = sb_new();
    sb_append_str(b1, "f(3,4) = ");
    sb_append_i64(b1, r1);
    println(sb_to_str(b1));

    // 2. 重新绑定
    f = sub;
    var b2: StringBuilder = sb_new();
    sb_append_str(b2, "f(10,4) = ");
    sb_append_i64(b2, f(10, 4));
    println(sb_to_str(b2));

    // 3. 作为参数传递
    var b3: StringBuilder = sb_new();
    sb_append_str(b3, "apply2(mul,6,7) = ");
    sb_append_i64(b3, apply2(mul, 6, 7));
    println(sb_to_str(b3));

    // 4. 作为返回值
    var g: fn(i64, i64) -> i64 = pick("sub");
    var b4: StringBuilder = sb_new();
    sb_append_str(b4, "pick(\"sub\")(9,2) = ");
    sb_append_i64(b4, g(9, 2));
    println(sb_to_str(b4));

    // 5. 全局函数类型变量
    var b5: StringBuilder = sb_new();
    sb_append_str(b5, "g_op(20,22) = ");
    sb_append_i64(b5, g_op(20, 22));
    println(sb_to_str(b5));

    // 6. 字符串签名
    var h: fn(string) -> string = shout;
    println(h("hello"));

    return 0;
}
