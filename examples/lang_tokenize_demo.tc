// 示例：外部工具（format / lint / thyme tdagen）通过 std.lang 共享同一套词法/AST。
// 这里用一段 .tproto 风格的 schema 源文本演示 tokenize 能力。
const lang = @import("std.lang");

@main fn main() i64 {
    var src: string =
        "#pb struct Object {\n" +
        "  angle: f64 @ 1 @thyme_range(0, 180);\n" +
        "  id: u64 @ 3 @thyme_id;\n" +
        "}\n" +
        "enum Color : i32 { RED = 0; GREEN = 1; BLUE = 7; }\n";
    var toks: []lang.Token = lang.tokenize(src);
    println("token_count=" + i2s(slice_len(toks) as i64));
    var i: i64 = 0;
    while (i < slice_len(toks) as i64) {
        println(i2s(i) + ": " + toks[i].kind + "  '" + toks[i].src + "'");
        i = i + 1;
    }
    return 0;
}
