// 任意位宽整数：字面量 / 格式化 / 运算（u2..u65535, i2..i65535）
// 双后端（LLVM / C）逐字节一致，输出见 awi_demo.expected.txt
//
// 覆盖：
//   * 宽无符号十进制字面量（原始符号扩展 bug 的回归点：u128 = 2^64-1）
//   * 宽无符号十六 / 二 / 八进制字面量（任意位宽，全精度发射）
//   * 宽有符号字面量
//   * 窄任意位宽（u7 / i7 / u9）的三种进制
//   * 宽类型运算不丢高位

fn main() i32 @main {
    // ── 宽无符号：十进制（关键回归点）────────────────────────
    var a: u128 = 18446744073709551615;          // 2^64 - 1
    println(format("a={}", a));
    // ── 宽无符号：十六进制 ───────────────────────────────────
    var b: u128 = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF;  // 2^128 - 1
    println(format("b={}", b));
    // ── 宽无符号：二进制 ─────────────────────────────────────
    var c: u128 = 0b11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111;  // 2^128 - 1
    println(format("c={}", c));
    // ── 宽无符号：八进制 ─────────────────────────────────────
    var d: u128 = 0o3777777777777777777777777777777777777777777;  // 2^128 - 1
    println(format("d={}", d));
    // ── 宽有符号 ─────────────────────────────────────────────
    var e: i128 = -1;
    println(format("e={}", e));
    // ── 窄任意位宽（u7 / i7）─────────────────────────────────
    var f: u7 = 100;
    var g: i7 = -50;
    println(format("f={} g={}", f, g));
    // ── 窄任意位宽：三种非十进制进制 ─────────────────────────
    var bin7: u7 = 0b1010011;                    // 83
    var oct9: u9 = 0o777;                        // 511
    var hex9: u9 = 0xFF;                         // 255
    println(format("bin7={} oct9={} hex9={}", bin7, oct9, hex9));
    // ── 宽类型运算不丢高位 ───────────────────────────────────
    var h: u128 = a + 1;                         // 2^64
    println(format("h={}", h));
    return 0;
}
