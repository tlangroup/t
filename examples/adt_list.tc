// ADT 演示（flat variant + 通配兜底）：扁平"列表"和类型
// 单载荷 case / 单元 case 与 `_` 通配臂混用，验证多构造器解构。
variant List { Nil; One(i64); Many(i64); }

fn sum(l: List) i64 {
    return match (l) {
        .Nil => 0
        .One(x) => x
        .Many(x) => x + 100
        _ => -1
    };
}

@main
fn main() i64 {
    println(int_to_str(sum(List { .Nil })));
    println(int_to_str(sum(List { .One(42) })));
    println(int_to_str(sum(List { .Many(9) })));
    return 0;
}
