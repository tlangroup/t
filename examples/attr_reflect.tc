// R-020：用户级注解的编译期反射读取。
// @type_attributes(T) 返回类型声明上的注解表 []Attribute；
// @field_attributes(T, "field") 返回指定字段上的注解表 []Attribute。
// 每个 Attribute = { name: string, args: []AttrArg }，
// AttrArg.kind: 0=string, 1=number, 2=bool, 3=ident, 4=list。

@deprecated("use NewConfig instead")   // 类型级注解（deprecated 支持 struct 目标）
@doc("application configuration")       // 类型级注解（doc 支持 struct 目标）
struct Config {
    name: string;
    retries: i64 @deprecated("no longer used");   // 字段级注解（置于类型之后；R-021：deprecated 已扩展到 field 目标）
    timeout: i64;
}

@main fn main() i64 {
    // 类型级注解反射
    var ta: []Attribute = @type_attributes(Config);
    println(int_to_str(slice_len(ta)));            // 期望 2
    var i = 0;
    while (i < slice_len(ta)) {
        println(ta[i].name);
        var j = 0;
        while (j < slice_len(ta[i].args)) {
            println("  " + ta[i].args[j].value);
            j = j + 1;
        }
        i = i + 1;
    }
    // 字段级注解反射
    var fa: []Attribute = @field_attributes(Config, "retries");
    println(int_to_str(slice_len(fa)));            // 期望 1
    return 0;
}
