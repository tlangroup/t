// O-5 载荷捕获（对标 Zig 0.17 的 `if (x) |v|` / `while (x) |v|`）。
//
// 覆盖的边界：
//   ①  `if (x) |v| { … }` 命中 / 未命中（else 分支）
//   ②  捕获变量在**捕获块内**可见，离开即不可见（不泄漏到外层）
//   ③  **聚合载荷** ?Point 的捕获（payload 是 16B 结构体，按值拷）
//   ④  `while (x) |v| { … }` —— 条件**每轮重新求值**，收到 null 才停
//   ⑤  捕获块内仍可用 break / continue（脱糖后 break 落在循环体内）
//   ⑥  **值位**捕获：`var y = if (x) |v| { E1 } else { E2 };`
//
// 脱糖形态（后端零改动，复用 is_some / is_none / unwrap 内建）：
//   if    (x) |v| { B }        ⇒ { var __optc_N = x; if (is_some(__optc_N)) { var v = unwrap(__optc_N); B } [else E] }
//   while (x) |v| { B }        ⇒ while (true) { var __optc_N = x; if (is_none(__optc_N)) { break; } var v = unwrap(__optc_N); B }

var counter: i64 = 0;

struct Point { x: i64; y: i64; }

fn first() ?i64 {
    var k: i64 = 9;
    return some(k);
}

fn none_opt() ?i64 {
    return null;
}

fn maybe_point(v: i64) ?Point {
    var p: Point;
    p.x = v;
    p.y = v * 2;
    if (v > 0) { return some(p); }
    return null;
}

// 每调用一次前进一格，越界后返回 null —— 供 while 捕获验证「条件每轮重求值」。
fn next() ?i64 {
    counter = counter + 1;
    if (counter > 3) { return null; }
    return some(counter);
}

@main
fn main() i64 {
    // ① if 捕获：命中
    var s: i64 = 0;
    if (first()) |v| {
        s = s + v;
    } else {
        s = s - 1;
    }
    println(f"if_some={s}");

    // ① if 捕获：未命中 ⇒ 走 else
    var t: i64 = 0;
    if (none_opt()) |v| {
        t = t + v;
    } else {
        t = t - 1;
    }
    println(f"if_none={t}");

    // ② 捕获变量 v 只在捕获块内
    if (first()) |v| {
        println(f"captured={v}");
    }

    // ③ 聚合载荷捕获
    var acc: i64 = 0;
    if (maybe_point(5)) |p| {
        acc = p.x + p.y;
    } else {
        acc = -1;
    }
    println(f"agg_capture={acc}");
    if (maybe_point(0)) |p| {
        acc = p.x;
    } else {
        acc = -1;
    }
    println(f"agg_capture_none={acc}");

    // ④ while 捕获：1+2+3 = 6；条件每轮重求值故 counter 逐格前进
    var sum: i64 = 0;
    while (next()) |v| {
        sum = sum + v;
    }
    println(f"while_sum={sum}");

    // ⑤ 捕获块内 break：只累加前两格（1+2）
    counter = 0;
    var sum2: i64 = 0;
    while (next()) |v| {
        if (v >= 3) { break; }
        sum2 = sum2 + v;
    }
    println(f"while_break={sum2}");

    // ⑤ 捕获块内 continue：跳过偶数格（1+3）
    counter = 0;
    var sum3: i64 = 0;
    while (next()) |v| {
        if (v == 2) { continue; }
        sum3 = sum3 + v;
    }
    println(f"while_continue={sum3}");

    // ⑥ 值位捕获：整条 if 是表达式，捕获变量 v 只在 true 臂可见
    // ⚠ 值块分支体须写成 `{ e; }`（值块要求以**表达式语句**结尾，见 P1 值块约定）
    var y: i64 = if (first()) |v| { v * 2; } else { 0; };
    println(f"value_some={y}");
    var z: i64 = if (none_opt()) |v| { v; } else { -7; };
    println(f"value_none={z}");
    return 0;
}
