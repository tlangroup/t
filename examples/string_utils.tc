// examples/string_utils.tc —— std.strings 用法演示（双后端语义验证）
// 运行: tc run --example string_utils
// 依赖: lib/std/strings.tc（源码内联导入，无需预编译 .tlib）
@import("std.strings");

fn b2s(b: bool) string {
    if (b) { return "true"; }
    return "false";
}

fn main_fn() i32 @main {
    // 修剪
    println(strings.trim("  Hello, World!  "));   // Hello, World!
    println(strings.ltrim("  abc"));               // abc
    println(strings.rtrim("abc  \n"));             // abc

    // 大小写（仅 ASCII）
    println(strings.to_upper("abcXYZ"));           // ABCXYZ
    println(strings.to_lower("ABCxyz"));           // abcxyz

    // 前缀 / 后缀 / 包含
    println(b2s(strings.starts_with("hello", "he"))); // true
    println(b2s(strings.ends_with("hello", "lo")));   // true
    println(b2s(strings.contains("hello", "ell")));   // true

    // 子串定位与计数
    println(i2s(strings.index_of("hello world", "world"))); // 6
    println(i2s(strings.index_of("hello", "z")));          // -1
    println(i2s(strings.count("a-b-c-d", "-")));           // 3

    // 替换 / 重复 / 填充
    println(strings.replace("a-b-c", "-", "+"));    // a+b+c
    println(strings.repeat("ab", 3));               // ababab
    println(strings.pad_start("42", 5, "0"));       // 00042
    println(strings.pad_end("42", 5, "*"));         // 42***

    // 切分 / 拼接
    var parts: []string = strings.split("a,b,c", ",");
    println(i2s(slice_len(parts)));                 // 3
    var i: u64 = 0;
    while (i < slice_len(parts)) {
        println(parts[i]);                          // a / b / c
        i = i + 1;
    }
    println(strings.join(parts, "-"));              // a-b-c
    return 0;
}
