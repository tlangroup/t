// 定长数组区间索引（[N]T 先降级成零拷贝切片视图再 slice_sub）
// 预期输出: 90 / 90 / 30
fn sum(s: []i64) i64 {
    var total: i64 = 0;
    for (x in s) {
        total = total + x;
    }
    return total;
}

@main
fn main() i64 {
    var arr: [5]i64 = [10, 20, 30, 40, 50];
    var mid: []i64 = arr[1..4];   // 20 30 40
    println(int_to_str(sum(mid)));
    var tail: []i64 = arr[3..];   // 40 50
    println(int_to_str(sum(tail)));
    var head: []i64 = arr[..2];   // 10 20
    println(int_to_str(sum(head)));
    return 0;
}
