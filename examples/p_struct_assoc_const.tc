// M5 / P3a：结构体关联常量双后端（C + LLVM）运行时验证。
// struct 体内 `const Name = ...` 重命名为 `<struct>_Name` 全局符号；
// 类型级 `Point.ORIGIN_X` 与值级 `p.MAX_DIM` 经 sema member 解析改写 ident 发射。
struct Point {
    x: i64;
    y: i64;
    const ORIGIN_X = 0;
    const ORIGIN_Y = 100;
    const MAX_DIM = 999;
}
@main
fn main() i64 {
    println(int_to_str(Point.ORIGIN_X));
    println(int_to_str(Point.ORIGIN_Y));
    var p: Point;
    println(int_to_str(p.MAX_DIM));
    return 0;
}
