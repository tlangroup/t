// 回归守卫（2026-10-26）：`x in lo..hi` 降解出的两个边界比较必须用**布尔合取**。
// 旧实现用 mk_binary("&&", ...)，而 `"&&"` 在 opmap 无映射 ⇒ tir_op_from_str 落
// OTHER=57 ⇒ 后端降级成 `add i1`；i1 回绕使 `true && true` 得 false（1+1=0），
// 于是区间判定整体反转（`3 in 1..5` 为假、`3 in 10..20` 为真）。
// 该路径此前无任何守卫：conformance 的 pass 用例只跑 `tc check` 不运行程序，
// examples 里也没有 `in` + 区间字面量的用例 —— 故本例走 golden 输出比对（双后端）。

@main fn main() i32 {
    var x: i64 = 3;
    var ok: i64 = 1;
    // 半开区间 1..5 = 1,2,3,4
    if ((x in 1..5) == false) { ok = 0; }
    if ((x in 10..20) == true) { ok = 0; }
    // 边界：下边界含、上边界不含（半开）
    if ((1 in 1..5) == false) { ok = 0; }
    if ((5 in 1..5) == true) { ok = 0; }
    // 闭合区间 1..=4 含 4
    if ((4 in 1..=4) == false) { ok = 0; }
    if (ok == 1) { println("RANGE_IN_OK"); } else { println("RANGE_IN_BAD"); }
    return 0;
}
