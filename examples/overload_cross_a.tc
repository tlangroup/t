// R2 跨文件 overload（值/守卫模式派发，验证跨文件 extend 合并）：
//   tc run examples/overload_cross_a.tc examples/cross/overload_cross_b.tc
// 期望输出：default / big / negative
// 注：overload_cross_b.tc 是 extend 片段（依赖本文件的 classify 组），单独编译会报
// T-OVL-E980；故置于 examples/cross/ 子目录，避免被 ir_snapshot / run_examples 的
// 单文件扫描误当作独立目标（跨文件用例需以多文件 CLI 参数一起编译）。

// 声明 overload 组（形参级 when 守卫）
overload fn classify(n: i64) string {
    return "default";
}

overload fn classify(n: i64 when n > 100) string {
    return "big";
}

@main
fn main() i32 {
    println(classify(5));
    println(classify(200));
    println(classify(-1));    // 来自 overload_cross_b.tc 的 extend 子句
    return 0;
}
