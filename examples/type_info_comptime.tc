// 阶段1 S5（阶段2衔接）：@type_info(T) 在 comptime 返回 **TypeInfo variant 值**，
// 其 .Struct.field_types 为 []type（编译期合成的 type 值数组，元素是真实 type 值）。
// 验证：field_types[0] == i64 成立；inline for 可对每个字段类型做编译期分发。
struct Point {
    x: i64;
    y: i64;
}

@main fn main() i32 {
    comptime {
        // 1) 直接取字段类型数组并按下标比较（每个元素都是真实 type 值）
        if (@type_info(Point).Struct.field_types[0] == i64) {
            @compile_log("field0 is i64");
        }
        if (@type_info(Point).Struct.field_types[1] == i64) {
            @compile_log("field1 is i64");
        }
        // 2) inline for 对每个字段类型做编译期分发（F 绑定为 type 值）
        inline for (@type_info(Point).Struct.field_types) |F| {
            if (F == i64) { @compile_log("got i64 field"); }
        }
    }
    return 0;
}
