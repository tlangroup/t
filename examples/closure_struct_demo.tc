// closure_struct_demo.tc —— 闭包的进阶形态（M48）
//
// 覆盖三条在「裸标识符调用」之外的路径：
//   1. 真·嵌套闭包：内层字面量捕获外层字面量的形参，逐层返回函数值；
//   2. 函数值存进结构体字段，再从字段位置直接发起调用（callee 不是 ident）；
//   3. 捕获聚合值（结构体）——按值拷贝整个结构体进环境。
//
// 语义要点：捕获一律**按值**，环境在建立闭包的那一刻定格。

Holder struct {
    op: fn(i64) -> i64;
    tag: i64;
}

pr fn(label: string, v: i64) -> void {
    var b: StringBuilder = sb_new();
    sb_append_str(b, label);
    sb_append_i64(b, v);
    println(sb_to_str(b));
}

// 三层柯里化：a 被两层字面量穿透捕获，b 被最内层捕获。
make2 fn(a: i64) -> fn(i64) -> fn(i64) -> i64 {
    return fn (b: i64) -> fn(i64) -> i64 {
        return fn (c: i64) -> i64 { return a * 100 + b * 10 + c; };
    };
}

@main
main fn() -> i64 {
    var f1: fn(i64) -> fn(i64) -> i64 = make2(1);
    var f2: fn(i64) -> i64 = f1(2);
    pr("make2(1)(2)(3) = ", f2(3));

    // 闭包存进结构体字段，调用点的 callee 是 member 表达式
    var k: i64 = 5;
    var h: Holder = Holder{ op: fn (x: i64) -> i64 { return x * k; }, tag: 9 };
    pr("h.op(4) = ", h.op(4));
    pr("h.tag = ", h.tag);

    // 捕获结构体值：整个 Holder 拷进环境
    var h2: Holder = h;
    var get_tag: fn() -> i64 = fn () -> i64 { return h2.tag; };
    pr("get_tag() = ", get_tag());

    // 立即调用刚从字段取出的函数值
    var g: fn(i64) -> i64 = h.op;
    pr("g(6) = ", g(6));
    return 0;
}
