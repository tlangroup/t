// ADT 演示（多载荷 + 递归 variant）
// 多载荷 case `Rect(i64, i64)` 位置式绑定；递归 case `Cons(i64, *IList)` 指针自引用。
// 编译器：t @ 自举；后端：C + LLVM 双后端语义一致
Shape variant { Circle(i64); Rect(i64, i64); Tri(i64, i64, i64); Empty; }

fn area(s: Shape) i64 {
    return match (s) {
        Circle(r) => 3 * r * r
        Rect(w, h) => w * h
        Tri(a, b, c) => a + b + c
        Empty => 0
    };
}

// 递归 variant：载荷以指针形态自引用（值形态自引用报 T_VARIANT_RECURSIVE_VALUE）
IList variant { Nil; Cons(i64, *IList); }

fn head_of(l: IList) i64 {
    return match (l) {
        Nil => -1
        Cons(h, t) => h
    };
}

// 混合载荷类型：i64 + bool
Rec variant { None; Pair(i64, bool); }

fn pick(r: Rec) i64 {
    return match (r) {
        None => 0
        Pair(n, ok) => n
    };
}

@main
fn main() i64 {
    println(int_to_str(area(Shape_from_Circle(5))));
    println(int_to_str(area(Shape_from_Rect(3, 4))));
    println(int_to_str(area(Shape_from_Tri(1, 2, 3))));
    println(int_to_str(area(Shape_from_Empty())));
    println(int_to_str(head_of(IList_from_Nil())));
    println(int_to_str(pick(Rec_from_Pair(42, true))));
    println(int_to_str(pick(Rec_from_None())));
    return 0;
}
