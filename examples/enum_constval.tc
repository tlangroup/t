// 常数枚举（enum）示例：成员均为具名编译期常量，支持显式赋值。
//
// 支持的赋值形式：
//   1. 字面量            Red = 1
//   2. 编译期算术        C = 20 + 30
//   3. const 引用        Y = K * 3
//   4. comptime fn 调用  P2 = sq(4)
//   5. 枚举成员间引用     B = Arith.A + 5（含前向引用、跨枚举、引用自动编号成员）
//
// 每个成员在编译期被求值并折为整型字面量，C / LLVM 双后端发射一致的常量。

const K: i64 = 7;

comptime fn sq(n: i64) i64 { return n * n; }

enum Color : u8 {
    Red = 1,
    Green = 2,
    Blue = 3,
}

enum Arith {
    A = 10,
    B = Arith.A + 5,        // 同枚举成员引用
    C = 20 + 30,            // 编译期算术
}

enum Ref {
    X = K,                  // const 引用
    Y = K * 3,
}

enum Pow {
    P1 = sq(1),             // 编译期函数赋值
    P2 = sq(4),
    P3 = sq(9),
    P4,                     // 自动续推 = 82
}

enum Fwd {
    X = Fwd.Y * 2,          // 前向引用（成员可后定义）
    Y = 3,
}

enum Other { Base = 100 }

enum Cross {
    P = Other.Base + 7,     // 跨枚举引用
    Q = Arith.B + 1,
}

@main
fn main() i32 {
    println("Color.Red  = " + int_to_str(Color.Red as i64));
    println("Color.Green= " + int_to_str(Color.Green as i64));
    println("Color.Blue = " + int_to_str(Color.Blue as i64));
    println("Arith.A    = " + int_to_str(Arith.A as i64));
    println("Arith.B    = " + int_to_str(Arith.B as i64));
    println("Arith.C    = " + int_to_str(Arith.C as i64));
    println("Ref.X      = " + int_to_str(Ref.X as i64));
    println("Ref.Y      = " + int_to_str(Ref.Y as i64));
    println("Pow.P1     = " + int_to_str(Pow.P1 as i64));
    println("Pow.P2     = " + int_to_str(Pow.P2 as i64));
    println("Pow.P3     = " + int_to_str(Pow.P3 as i64));
    println("Pow.P4     = " + int_to_str(Pow.P4 as i64));
    println("Fwd.X      = " + int_to_str(Fwd.X as i64));
    println("Fwd.Y      = " + int_to_str(Fwd.Y as i64));
    println("Cross.P    = " + int_to_str(Cross.P as i64));
    println("Cross.Q    = " + int_to_str(Cross.Q as i64));
    return 0;
}
