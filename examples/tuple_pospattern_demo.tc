// 元组位置式模式解构绑定（#4 §8.2）：`.{a, b}` / `Name{a, b}` / `Pt{1, b}` / `Pt{a, _}`。
struct Pt { x: i64; y: i64; }

// 匿名元组位置式：`.{a, b}` 按列表下标绑定到 `_0`/`_1`。
fn f_anon(t: .{i64, i64}) i64 {
    return match (t) {
        .{a, b} => a + b,
        _ => 0 - 1,
    };
}

// 具名结构位置式：`Pt{a, b}` 按列表下标绑定到 `x`/`y`。
fn f_named(p: Pt) i64 {
    return match (p) {
        Pt{a, b} => a + b,
        _ => 0 - 1,
    };
}

// 混合：字面量位置 + 绑定位置 + 通配位置。
fn f_mixed(p: Pt) i64 {
    return match (p) {
        Pt{1, b} => b,        // 第 0 字段 == 1 才命中，第 1 字段绑定到 b
        Pt{a, _} => a,        // 第 0 字段绑定到 a，第 1 字段通配
        _ => 0 - 1,
    };
}

@main fn main() i32 {
    println(int_to_str(f_anon(.{10i64, 20i64})));
    println(int_to_str(f_named(Pt{ x: 1, y: 2 })));
    println(int_to_str(f_mixed(Pt{ x: 1, y: 5 })));
    println(int_to_str(f_mixed(Pt{ x: 7, y: 9 })));
    return 0;
}
