// 切片字面量作表达式 —— 双后端运行时守卫。
// 覆盖三种期望类型为 `[]T` 的上下文：
//   ① 赋值 RHS：`var s: []i64 = [1,2,3]` 之外的 `s = [a,b,c]`（本例用 s = first3() 之外的直赋见 conformance）
//   ② return：`return [10, 20, 30]`
//   ③ 调用实参（切片形参）：`sum_slice([4, 5, 6])`
// 修复前：emit_lle 对 array_lit 落到 `UNSUPPORTED expr` → `load %TSlice, ptr 0`（clang 报
//   "use of undeclared identifier" / 运行时崩）；C 后端退化为 `{}` 复合字面量 → 与 TSlice 结构不符。
// 修复后双后端均构造 heap 切片并正确传值。

fn first3() []i64 {
    return [10, 20, 30];
}

fn sum_slice(a: []i64) i64 {
    var t: i64 = 0;
    var i: i64 = 0;
    while (i < (slice_len(a) as i64)) {
        t = t + a[i];
        i = i + 1;
    }
    return t;
}

@main
fn main() i64 {
    // ① 赋值 RHS 切片字面量（vs var-init，路径不同）
    var s: []i64 = [];
    s = [1, 2, 3];
    println(int_to_str(slice_len(s) as i64));   // 3
    println(int_to_str(s[1]));                  // 2
    // ② return 位置切片字面量
    var r: []i64 = first3();
    println(int_to_str(sum_slice(r)));          // 60
    // ③ 切片形参实参：字面量直接作调用实参
    println(int_to_str(sum_slice([4, 5, 6])));  // 15
    return 0;
}
