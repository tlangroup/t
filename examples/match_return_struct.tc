// match_return_struct.tc — match 表达式返回结构体（C 后端修复点）
//
// 此前 C 后端把 match 结果临时量（_tmrN）声明成 `void*` 并试图把结构体赋给它，
// 编译失败；现双后端均正确声明临时量类型为结构体本身。
// 期望输出见 examples/match_return_struct.expected.txt。
struct Pt { x: i64; y: i64; }
fn flip(p: Pt) Pt {
    return match (p) {
        _ => Pt{ x: p.y, y: p.x }
    };
}
@main fn main() i64 {
    var a: Pt = Pt{ x: 1, y: 2 };
    var b: Pt = flip(a);
    println(int_to_str(b.x));
    println(int_to_str(b.y));
    return 0;
}
