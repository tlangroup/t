// 二维硬件 SIMD 瓦片（@Tile）实跑守卫。
//
// 与 vector_demo 同构：只有本例经 run_examples 的「LLVM + C」双后端实跑比对才能
// 守住 @Tile 是否正确 emit 出逐元素循环（C 扁平 T* 缓冲 / LLVM `[rows x [cols x T]]`
// 嵌套数组 + GEP 索引），以及归约 / 编译期内省 / 嵌套数组字面量升格。
//
// 覆盖：@tsplat 构造 + 逐元素算术 + 归约(@treduce_sum/mul/min/max) +
// 编译期内省(@tile_rows/@tile_cols/@tile_flavor) + 嵌套数组字面量升格 + simulate flavor。
//
// ⚠ 不打印机器相关值：跨机器期望输出必须恒定。

@main
fn main() i64 {
    // ① @tsplat 构造 + 编译期内省 + 归约
    var a: @Tile(2, 3, i32, hardware) = @tsplat(7i32, 2, 3);   // 2x3 全 7
    println(int_to_str(@tile_rows(a) as i64));                 // 2
    println(int_to_str(@tile_cols(a) as i64));                 // 3
    println(int_to_str(@tile_flavor(a) as i64));               // 0 (hardware)
    println(int_to_str(@treduce_sum(a) as i64));               // 42
    println(int_to_str(@treduce_max(a) as i64));               // 7
    println(int_to_str(@treduce_min(a) as i64));               // 7

    // ② 逐元素算术：@tsplat + @tsplat
    var b: @Tile(2, 3, i32, hardware) = @tsplat(1i32, 2, 3);
    var c: @Tile(2, 3, i32, hardware) = a + b;                 // 全 8
    println(int_to_str(@treduce_sum(c) as i64));               // 48
    println(int_to_str(@treduce_mul(c) as i64));               // 8^6 = 262144

    // ③ 嵌套数组字面量升格为瓦片
    var d: @Tile(2, 3, i32, hardware) = [[1, 2, 3], [4, 5, 6]];
    println(int_to_str(@treduce_sum(d) as i64));               // 21
    println(int_to_str(@treduce_max(d) as i64));               // 6

    // ④ simulate flavor（经嵌套字面量构造，保留声明的 flavor 码）
    var e: @Tile(2, 2, i32, simulate) = [[1, 2], [3, 4]];
    println(int_to_str(@tile_flavor(e) as i64));               // 1 (simulate)
    println(int_to_str(@treduce_sum(e) as i64));               // 10

    return 0;
}
