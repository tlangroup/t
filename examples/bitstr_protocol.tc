// bitstr 通讯报文解包往返：构造 <<ver:3, typ:5, len:16, payload/bitstr>> 并 match 解构。
// 验证位串模式匹配（§6）：定长段按位偏移提取为 i64，/bitstr 尾段绑定为子 bitstr。
// 预期输出（双后端应一致）：
//   5 2 8 222 173 190 239 4
// （ver=5 typ=2 len=8；payload=4 字节 0xDE/0xAD/0xBE/0xEF；for-in 字节遍历 n=4）
@main
fn main() i64 {
    return match (<<5:3, 2:5, 8:16, 0xDE:8, 0xAD:8, 0xBE:8, 0xEF:8>>) {
        <<ver:3, typ:5, len:16, payload/bitstr>> => {
            println(int_to_str(ver));
            println(int_to_str(typ));
            println(int_to_str(len));
            var n: i64 = 0;
            for (x in payload) {
                println(int_to_str(x));
                n = n + 1;
            }
            println(int_to_str(n));
            0;
        }
        _ => {
            1;
        }
    };
}
