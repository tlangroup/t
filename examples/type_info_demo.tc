// M36（阶段5 改写）：type_info(T) 运行时反射改用 match 解构 TypeInfo variant + FieldInfo 字段投影，
// 替代已删除的 v1 遗留 ti_*/fi_* 访问函数（见 docs/compiler/typeinfo-design.md §4.5 / 阶段5）。
// C 后端与 LLVM 后端输出逐字节一致。

struct Point {
    x: i64;
    y: i64;
    label: string;
}

@main
fn main() i64 {
    var ti: TypeInfo = type_info(Point);
    var m: *TypeMeta = match (ti) { .Struct(mt) => mt, _ => null };
    println(m.name);                            // ti_name -> "Point"
    println(int_to_str(m.size));                // ti_size -> 32
    println(int_to_str(7));                     // ti_kind(Struct) -> 7
    var n: i64 = m.field_count;                 // ti_field_count -> 3
    println(int_to_str(n));
    var i: i64 = 0;
    while (i < n) {
        var f: FieldInfo = m.fields[i];
        println(f.name);
        println(int_to_str(f.offset));
        println(f.type_name);
        println(int_to_str(f.type_size));
        println(int_to_str(f.is_ptr as i64));
        i = i + 1;
    }
    return 0;
}
