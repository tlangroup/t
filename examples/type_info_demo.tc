// M36: type_info(T) accessor 内建演示（struct-only，方案B）
// type_info(Point) 返回 TypeInfo（TTypeInfo*），经 10 个 accessor 读取编译期自省信息。
// 语言要求显式类型标注，故用 var ti: TypeInfo / var fi: FieldInfo。
// 预期：C 后端与 LLVM 后端输出逐字节一致。

Point struct {
    x: i64;
    y: i64;
    label: string;
}

@main
fn main() i64 {
    var ti: TypeInfo = type_info(Point);
    println(ti_name(ti));
    println(int_to_str(ti_size(ti)));
    println(int_to_str(ti_kind(ti)));
    println(int_to_str(ti_field_count(ti)));
    var n: i64 = ti_field_count(ti);
    var i: i64 = 0;
    while (i < n) {
        var fi: FieldInfo = ti_field(ti, i);
        println(fi_name(fi));
        println(int_to_str(fi_offset(fi)));
        println(fi_type_name(fi));
        println(int_to_str(fi_type_size(fi)));
        println(int_to_str(fi_is_ptr(fi) as i64));
        i = i + 1;
    }
    return 0;
}
