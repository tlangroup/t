// 时间格式化（M56）：now() 时钟 + format_time / format_time_local
//
// now() i64    当前微秒 Unix epoch
// format_time(spec, t) string 按 UTC 解释 t（微秒 epoch）
// format_time_local(spec, t) string 按本机本地时区解释 t
//
// spec 采用 Python strftime 的 `%` 风格子集（与数值格式化的 {:>10} 刻意分两套）：
//   最小集  %Y %y %m %d %H %M %S %f %%
//   扩展集  %a %A %b %B %p %I %j %w %U %W %z %Z
// 未知字段码在编译期（字面量）报 T_TIME_BAD_SPEC；非常量 spec 运行期宽容原样保留。
//
// 本示例仅用固定 epoch + UTC，输出完全确定，便于 run_examples 比对。
// 本地时区与 now() 的演示见 time_fmt_local.tc。

@main
main fn() i64 {
    // 2025-08-03 20:51:30.123000 UTC（微秒 epoch，星期日）
    var t: i64 = 1754254290123000;
    println(format_time("%Y-%m-%d %H:%M:%S", t));       // 2025-08-03 20:51:30
    println(format_time("%a %A, %b %B %d", t));         // Sun Sunday, Aug August 03
    println(format_time("%I:%M:%S %p", t));             // 08:51:30 PM
    println(format_time("%w day=%j wkU=%U wkW=%W", t)); // 0 day=215 wkU=31 wkW=30
    println(format_time("%z %Z", t));                   // +0000 UTC
    println(format_time("%H:%M:%S.%f", t));             // 20:51:30.123000
    // 未知字段码：以变量传入，编译期不扫描，运行期宽容——已知码展开、未知码原样保留
    // %Q 未知->保留，%X 已在 M57 实现为 locale 码(HH:MM:SS) 展开
    var spec: string = "%Q%X";
    println(format_time(spec, t));                      // %Q20:51:30
    return 0;
}
