// 固定时区格式化 + locale 字段码（M57）
// 时间值固定为 1754254290123456 微秒 epoch = 2025-08-03T20:51:30.123456Z，
// 与 Python datetime(...).strftime / timezone(timedelta(...)) 逐字节对拍。
@main main fn() -> i64 {
    var t: i64 = 1754254290123456;

    // locale 字段码：固定 C/POSIX 英语区表示，不随系统 locale 漂移
    println(format_time("%c", t));
    println(format_time("%x %X", t));

    // 固定偏移（分钟，东为正）：%z 输出 ±HHMM，%Z 输出 UTC±HH:MM
    println(format_time_tz("%Y-%m-%d %H:%M:%S%z", t, 480));
    println(format_time_tz("%Y-%m-%d %H:%M:%S%z", t, -330));
    println(format_time_tz("%Y-%m-%d %H:%M:%S %Z", t, 0));
    println(format_time_tz("%c (%Z)", t, 330));
    println(format_time_tz("%A %B %d %j %U %W %w", t, 480));
    return 0;
}
