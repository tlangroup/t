// map 索引写 m[k] = v（≡ map_set）：string/int 键、覆盖、计算右值、嵌套 map
// 注：本语言 print 仅接受 string，标量用 int_to_str 转换（与 examples/map_advanced.tc 一致）
@main
main :: func() -> i64 {
    var m: map[string]i64;
    m["alice"] = 10;
    m["bob"] = 20;
    m["alice"] = 15;                 // 覆盖
    print(int_to_str(m["alice"]));   // 15
    print(int_to_str(m["bob"]));     // 20

    var mi: map[i64]string;
    mi[1] = "one";
    mi[2] = "two";
    print(mi[1]);                    // one
    print(mi[2]);                    // two

    m["sum"] = m["alice"] + m["bob"]; // 读 + 写
    print(int_to_str(m["sum"]));     // 35

    var deep: map[string]map[string]i64;
    deep["a"] = ["x": 1, "y": 2];
    deep["a"]["x"] = 100;           // 嵌套索引写
    print(int_to_str(deep["a"]["x"])); // 100

    var total: i64 = 0;
    for (k, v in m) {
        total = total + v;
    }
    print(int_to_str(total));        // 15 + 20 + 35 = 70
    return 0;
}
