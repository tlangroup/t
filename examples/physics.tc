// physics.tc —— 模型库：运动 / 碰撞 / 旋转（外置功能，import 进来）
//
// 对应 docs/agent_first.md §11 / §12：具体领域功能外置为模块，
// 主程序只管词法/语法/语义，不内嵌物理逻辑。
// NPC 的 agent 声明保持“瘦”（见 agent_npc_mind.tc），物理 Component + System 全部来自本模块。
//
// 坐标采用整数网格（i64），保证双后端（LLVM + C）输出逐字节一致，
// 避免浮点格式化在两后端间的差异。

// ── Component（纯数据，无方法，契合 ECS 数据导向）──
export struct Position {
    x: i64;
    y: i64;
    z: i64;
}

export struct Velocity {
    dx: i64;
    dy: i64;
    dz: i64;
}

export struct Rotation {
    yaw: i64;     // 偏航角（度）
    pitch: i64;   // 俯仰角（度）
}

export struct BoundingBox {
    w: i64;
    h: i64;
    d: i64;
}

// ── 构造器（避免使用处写长结构体字面量）──
export fn pos_zero() Position {
    var p: Position = Position{ x: 0, y: 0, z: 0 };
    return p;
}

export fn vel_zero() Velocity {
    var v: Velocity = Velocity{ dx: 0, dy: 0, dz: 0 };
    return v;
}

export fn rot_zero() Rotation {
    var r: Rotation = Rotation{ yaw: 0, pitch: 0 };
    return r;
}

export fn box_make(w: i64, h: i64, d: i64) BoundingBox {
    var b: BoundingBox = BoundingBox{ w: w, h: h, d: d };
    return b;
}

// ── System（自由 fn，遍历 Component 读写；非确定性只活在调用方边界）──

// MovementSystem：按速度积分位置（dt 以“步”为单位，取 1）。
export fn movement_system(p: Position, v: Velocity, dt: i64) Position {
    var r: Position = Position{ x: 0, y: 0, z: 0 };
    r.x = p.x + v.dx * dt;
    r.y = p.y + v.dy * dt;
    r.z = 0;          // 本演示无 z 运动，保持网格平面
    r.z = p.z + v.dz * dt;
    return r;
}

// RotationSystem：偏航角每帧转动 delta 度（模 360，保持 [0,360)）。
export fn rotation_system(r: Rotation, delta: i64) Rotation {
    var out: Rotation = Rotation{ yaw: 0, pitch: 0 };
    out.yaw = r.yaw + delta;
    if (out.yaw >= 360) { out.yaw = out.yaw - 360; }
    out.pitch = r.pitch;
    return out;
}

// CollisionSystem：检测实体盒是否越过墙体（墙位于 wall_x）。
export fn collision_system(p: Position, b: BoundingBox, wall_x: i64) bool {
    if (p.x + b.w > wall_x) { return true; }
    return false;
}
