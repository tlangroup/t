// 验证 cat2..cat6 字符串拼接内建（双后端）。
// 注意：cat 实参须为 string；拼接非字符串先 int_to_str。
@main
main :: func() -> i64 {
    var s: string = cat2("Hello, ", "World!");
    print(s);
    print(cat3("a", "b", "c"));
    print(cat4("x", int_to_str(1), int_to_str(2), "y"));
    print(cat5("n=", int_to_str(10), " ", int_to_str(20), " ok"));
    print(cat6("v", int_to_str(1), int_to_str(2), int_to_str(3), int_to_str(4), "!"));
    // 嵌套拼接（cat 的实参本身也是 cat 调用）
    var full: string = cat2(cat2("A", "B"), cat2("C", "D"));
    print(full);
    // 作为函数返回值 / 赋值右值 / 调用实参
    var msg: string = cat2("sum=", int_to_str(7 + 8));
    print(msg);
    return 0;
}
