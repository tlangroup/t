// examples/std_demo.tc —— std 库（mem + math）用法演示
// 运行: tc run --example std_demo
// 依赖: lib/std/mem.tc、lib/std/math.tc（须先 `node tools/build_std.mjs` 预编译为 .tlib）
@import("std.math");
@import("std.mem");

fn main_fn() i32 @main {
    // —— math：泛型有序比较 + 整数/浮点工具 ——
    println(i2s(math.max(i64, 3, 7)));        // 7
    println(i2s(math.gcd(12, 18)));           // 6
    println(i2s(math.floor_f(-1.5) as i64));  // -2
    println(i2s(math.sqrt_f(2.0) as i64));    // 1（≈1.414）

    // —— mem：切片工具 ——
    var xs: []i64;
    append(xs, 3); append(xs, 1); append(xs, 2);
    mem.reverse(i64, xs);
    println(i2s(xs[0]));   // 2
    println(i2s(xs[1]));   // 1
    println(i2s(xs[2]));   // 3
    return 0;
}
