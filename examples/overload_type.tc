// overload_type.tc — Route 3：类别格类型分派（静态分派）
//
// 类型组（全部子句纯裸绑定、首参带显式类型）在调用点按首实参「静态类型」选最具体子句：
//   具体类型精确匹配（overload fn tag(x: i64)）→ 优先级最高
//   类别子句 integralkind / scalarkind / anykind → 按类别格兜底，按需单态化
// 类别格：anykind ⊃ scalarkind ⊃ {integralkind, floatkind} ⊃ 具体类型(i64/f64/...)
// ⚠ t 的整数字面量按最小无符号宽度推断（5 → u8），故裸字面量 5 命中 integralkind
//   而非 i64；要把裸字面量派到 i64，须显式标注类型（见下 var n: i64）。
// 预期输出见 overload_type.expected.txt。

@main
fn main() i64 {
    var n: i64 = 5;
    println(tag(n));          // n: i64     → 具体子句精确匹配 "i64"
    println(tag(3.0));        // 3.0: f64   → 具体子句精确匹配 "f64"
    println(tag(true));       // true: bool → 具体子句精确匹配 "bool"
    println(tag(5));          // 5: u8      → integralkind 兜底 "integral"
    println(tag("hi"));       // "hi": string → scalarkind 兜底 "scalar"
    return 0;
}

overload fn tag(x: i64) string { return "i64"; }
overload fn tag(x: f64) string { return "f64"; }
overload fn tag(x: bool) string { return "bool"; }
overload fn tag(x: integralkind) string { return "integral"; }
overload fn tag(x: scalarkind) string { return "scalar"; }
