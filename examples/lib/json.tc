// examples/lib/json.tc —— 库演示（`import(json)`）
//
// 放在「入口目录/lib」下，由外部库搜索路径自动定位，无需相对路径。
// 与 examples/lib/csv.tc 刻意定义同名的 encode / version / quote，
// 用来验证命名空间隔离：重整后分别是 json__encode 与 csv__encode，互不相撞。

// 库版本标识（导出）
export version fn() string {
    return "json/0.1";
}

// 编码一个键值对为 JSON 对象片段：{"k":v}
export encode fn(k: string, v: i64) string {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "{");
    sb_append_str(sb, quote(k));
    sb_append_str(sb, ":");
    sb_append_str(sb, int_to_str(v));
    sb_append_str(sb, "}");
    return sb_to_str(sb);
}

// 模块内私有：加双引号（未 export，跨模块不可见；模块内自调用会重整成 json__quote）
quote fn(s: string) string {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "\"");
    sb_append_str(sb, s);
    sb_append_str(sb, "\"");
    return sb_to_str(sb);
}
