// list.tc —— 基于切片（[]i64）的可变列表 List（库层，纯数据 + 方法脱糖）
//
// 演示「结构体方法」语法糖：在 struct 体内写
//     push fn(self: Self, v: i64) Self { ... }
// 等价于顶层自由函数
//     list_push fn(self: List, v: i64) List { ... }
// （函数名 = snake(struct名) + "_" + 方法名；类型 `Self` 改写为所属 struct 名）。
// 调用仍走自由函数：list.list_push(l, v) / list.list_len(l) ...（本文件无调用语法糖）。
//
// t 无泛型，元素类型定死 i64；换其他元素类型只需把下面所有 `i64` / `[]i64` 替换。
// 风格对齐 colony.tc：无 receiver 调用语法，方法即顶层自由函数。

export List struct {
    items: []i64;

    // 构造空列表（无 self 形参的「静态方法」，同样脱糖为 list_new）
    new fn() Self {
        var l: Self;
        return l;
    }

    // 尾部追加
    push fn(self: Self, v: i64) Self {
        append(self.items, v);
        return self;
    }

    // 长度
    len fn(self: Self) i64 {
        return slice_len(self.items);
    }

    // 判空
    is_empty fn(self: Self) bool {
        return slice_len(self.items) == 0;
    }

    // 读第 i 个
    get fn(self: Self, i: i64) i64 {
        return self.items[i];
    }

    // 写第 i 个
    set fn(self: Self, i: i64, v: i64) Self {
        self.items[i] = v;
        return self;
    }

    // 尾部弹出（空列表无操作）
    pop fn(self: Self) Self {
        if (slice_len(self.items) > 0) {
            var out: []i64;
            var i: i64 = 0;
            for (i = 0; i < slice_len(self.items) - 1; i = i + 1) {
                append(out, self.items[i]);
            }
            self.items = out;
        }
        return self;
    }

    // 在 at 处插入 v（at >= 长度则追加到末尾）
    insert fn(self: Self, at: i64, v: i64) Self {
        var out: []i64;
        var i: i64 = 0;
        var n: i64 = slice_len(self.items);
        for (i = 0; i < n; i = i + 1) {
            if (i == at) { append(out, v); }
            append(out, self.items[i]);
        }
        if (at >= n) { append(out, v); }
        self.items = out;
        return self;
    }

    // 删除第 at 个（越界则无操作）
    remove fn(self: Self, at: i64) Self {
        var out: []i64;
        var i: i64 = 0;
        var n: i64 = slice_len(self.items);
        for (i = 0; i < n; i = i + 1) {
            if (i != at) { append(out, self.items[i]); }
        }
        self.items = out;
        return self;
    }

    // 清空
    clear fn(self: Self) Self {
        var empty: []i64;
        self.items = empty;
        return self;
    }

    // 是否包含 v
    contains fn(self: Self, v: i64) bool {
        var i: i64 = 0;
        var n: i64 = slice_len(self.items);
        for (i = 0; i < n; i = i + 1) {
            if (self.items[i] == v) { return true; }
        }
        return false;
    }
}
