// colony.tc —— Spawner / Colony Agent 调度体（库层，收敛决策 A：不进编译器语法）
//
// 对应 docs/agent_first.md §6 / §12：Spawner·Colony Agent 元类（管理/生成子 agent、
// 小队调度、刷怪波次）。按收敛决策 A，这部分是**运行时/库层关注点**，t 不加任何
// 新语法：本库复用现有 `X agent` 脱糖产物（XState / x_spawn / x_step）+ slice + 函数指针，
// 以**纯数据调度体**实现「spawn 生成 / 按 id 寻址 / tick 调度 / 邮箱延迟」。
//
// 泛型无关范式（t 已有 `comptime T: any` 单态化，见 reference §3.6.2）：Colony 仍沿用
// agentkit 的「状态 string 指纹 + fn(string, Msg) string 回调」范式——这是刻意的**运行期
// 动态分发**选择（跨类型复用且无需为每类重新单态化），而非语言能力缺失。用户把具体
// XState 序列化成 string 指纹、把 x_step 包成 wrapper 传入 colony_new。
//
// ⚠ 实现约束（编译器当前限制，已规避）：
//   · map 值仅支持纯标量（含 string/slice 的 struct、map-of-slice 均触发内部 panic）
//     → 不用 map 存 agent 状态，改用「并行 slice」按 id 下标对齐。
//   · LLVM 后端对「slice of slice」([][]Msg) 发射非法 IR → 邮箱不用 [][]Msg，
//     改用**扁平 inbox**：所有排队消息进单一 []Msg，并行 []i64 inbox_to 记目标 id。
//
// 复用示例见 examples/colony_demo.tc（Worker 小队 + Counter 跨类型复用同一调度体）。

// ── 通用消息信封（与 agentkit.Msg 同形：atom 路由 + 可选整数/字符串参数）──
@module(pub)

pub struct Msg {
    kind: atom;
    arg_i: i64;
    arg_s: string;
}

pub fn mk_msg(kind: atom, arg_i: i64, arg_s: string) Msg {
    return Msg{ kind: kind, arg_i: arg_i, arg_s: arg_s };
}

// ── Colony：调度体本身 ──
// 并行 slice 存储，按 id 下标对齐：states[id] / alives[id]。
// id 顺序分配（0,1,2,…）；kill 仅置 alives[id]=false，下标留空槽，保证 id 稳定可寻址。
// 延迟邮箱用扁平 inbox：inbox[i] 是消息，inbox_to[i] 是其目标 agent id。
pub struct Colony {
    n: i64;                           // 已分配 agent 数（= 下一个 id）
    states: []string;                // states[id] = 具体 XState 的 string 指纹
    alives: []bool;                   // alives[id] = 是否存活
    inbox: []Msg;                     // 扁平消息队列（所有 agent 的待处理消息）
    inbox_to: []i64;                  // inbox_to[i] = inbox[i] 的目标 agent id
    step_fn: fn(string, Msg) string; // 具体 agent 的 step 包成指纹回调
}

// 新建空 colony：step_fn = 具体 agent 的 wrapper（string 指纹版 step）
pub fn colony_new(step_fn: fn(string, Msg) string) Colony {
    var c: Colony;
    c.step_fn = step_fn;
    c.n = 0;
    return c;
}

// 生成（spawn）一个子 agent，初始状态指纹 init_state；返回更新后的 colony。
// 新 id = 当前 n，分配后自增。配套取 id：colony_last_id(c)。
pub fn colony_spawn(c: Colony, init_state: string) Colony {
    var id: i64 = c.n;
    append(c.states, init_state);
    append(c.alives, true);
    c.n = c.n + 1;
    return c;
}

// 最近一次 spawn 的 id（col = colony_spawn(...); id = colony_last_id(col)）
pub fn colony_last_id(c: Colony) i64 {
    return c.n - 1;
}

// 按 id 寻址，往该 agent 的延迟邮箱追加一条消息（入扁平 inbox）
pub fn colony_send(c: Colony, id: i64, m: Msg) Colony {
    append(c.inbox, m);
    append(c.inbox_to, id);
    return c;
}

// 广播：给所有存活 agent 各追加一条消息（小队命令）
pub fn colony_broadcast(c: Colony, m: Msg) Colony {
    var i: i64 = 0;
    for (i = 0; i < c.n; i = i + 1) {
        if (c.alives[i]) {
            append(c.inbox, m);
            append(c.inbox_to, i);
        }
    }
    return c;
}

// 立即单步：不进邮箱，直接对 id 指定的 agent 跑一次 step（msg 即消息）
pub fn colony_step(c: Colony, id: i64, m: Msg) Colony {
    var ns: string = c.step_fn(c.states[id], m);
    c.states[id] = ns;
    return c;
}

// 调度一帧（tick）：每个存活 agent 从 inbox 弹出「一条」消息并 step（FIFO、每 agent 每帧一条）。
// 这正是 Spawner/Colony 的「调度」语义——消息先排队、tick 统一驱动。
// 用 did[] 保证每 agent 每帧至多处理一条；未处理消息留待下帧。
pub fn colony_tick(c: Colony) Colony {
    var removed: []bool;
    var did: []bool;
    var k: i64 = 0;
    for (k = 0; k < slice_len(c.inbox); k = k + 1) { append(removed, false); }
    for (k = 0; k < c.n; k = k + 1) { append(did, false); }
    var i: i64 = 0;
    for (i = 0; i < slice_len(c.inbox); i = i + 1) {
        var tid: i64 = c.inbox_to[i];
        if (c.alives[tid] and did[tid] == false and removed[i] == false) {
            var m: Msg = c.inbox[i];
            var ns: string = c.step_fn(c.states[tid], m);
            c.states[tid] = ns;
            removed[i] = true;
            did[tid] = true;
        }
    }
    // 重建 inbox / inbox_to，剔除本帧已处理者
    var ni: []Msg;
    var nt: []i64;
    var j: i64 = 0;
    for (j = 0; j < slice_len(c.inbox); j = j + 1) {
        if (removed[j] == false) {
            append(ni, c.inbox[j]);
            append(nt, c.inbox_to[j]);
        }
    }
    c.inbox = ni;
    c.inbox_to = nt;
    return c;
}

// 读某 agent 的当前状态指纹
pub fn colony_get(c: Colony, id: i64) string {
    return c.states[id];
}

// 存活 agent 数
pub fn colony_count(c: Colony) i64 {
    var n: i64 = 0;
    var i: i64 = 0;
    for (i = 0; i < c.n; i = i + 1) {
        if (c.alives[i]) { n = n + 1; }
    }
    return n;
}

// 退役（标记死亡；调度时跳过，但下标/id 保留以便稳定寻址）
pub fn colony_kill(c: Colony, id: i64) Colony {
    c.alives[id] = false;
    return c;
}
