// examples/lib/csv.tc —— 库演示（`import(csv)`）
//
// 与 examples/lib/json.tc 定义完全同名的 version / encode / quote。
// 若无命名空间隔离，两库同时 import 会在链接期符号相撞；
// 重整后各自成为 csv__* 与 json__*，共存无碍。

export fn version() string {
    return "csv/0.1";
}

// 编码一个键值对为 CSV 行：k,v
export fn encode(k: string, v: i64) string {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, quote(k));
    sb_append_str(sb, ",");
    sb_append_str(sb, int_to_str(v));
    return sb_to_str(sb);
}

// 模块内私有：CSV 不加引号，原样返回（同名但语义不同，正好检验隔离）
fn quote(s: string) string {
    return s;
}
