// R-026 验证：@enum_members(T) 在编译期返回枚举成员名/值表 []EnumMember，
// 并可在运行期物化消费（R-026「编译+运行期」）。thyme 004/005 的「读 enum 成员名/值表」反射能力。
enum Color : u8 {
    RED = 0
    GREEN = 2
    BLUE = 7
}

@main fn main() i64 {
    var ms: []EnumMember = @enum_members(Color);
    var n = slice_len(ms);
    println(int_to_str(n));
    var i = 0;
    while (i < n) {
        println(ms[i].name + " = " + int_to_str(ms[i].value));
        i = i + 1;
    }
    return 0;
}
