// open-variant（阶段三）· 文件 A（run_examples / ir_snapshot 目标，自包含）
//
// 同文件 overload variant 开放组 + extend variant 追加构造器：验证合并后 case 全集 =
// 组 ∪ extend，tag 按合并顺序连续重编号（D2），构造 / 穷尽 match / 值正确，双后端一致。
//
// 配对演示（跨文件同编译单元合并，手动）：
//   tc run examples/open_variant_a.tc examples/cross/open_variant_b.tc
// （open_variant_b.tc 是 extend 片段，单独编译会报 T-OVL-E980，故置于 examples/cross/）

// overload variant：标记 Event 为「开放可扩展组」。
overload variant Event {
    Key(i64);
    Click(i64, i64);
}

// 同文件 extend：追加构造器（合并期拼到 case 链尾部，tag 重编号到末尾）。
extend variant Event {
    Wheel(i64);
}

fn code(e: Event) i64 {
    return match (e) {
        .Key(k) => k
        .Click(x, y) => x + y
        .Wheel(d) => d
    };
}

@main
fn main() i32 {
    var e: Event = Event { .Wheel(42) };
    println("event code=" + int_to_str(code(e) as i64));
    if (code(e) != 42) {
        return 1;
    }
    return 0;
}
