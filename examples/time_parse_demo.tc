// 时间解析（M57）：parse_time / parse_time_local / time_invalid
// 失败不抛异常也不返回 0（0 是合法时刻 1970-01-01），而是返回 time_invalid()
// 这个不可能被合法时刻取到的哨兵，调用方必须显式判定。
@main main fn() i64 {
    var a: i64 = parse_time("%Y-%m-%d %H:%M:%S", "2025-08-03 20:51:30");
    println(int_to_str(a));
    println(format_time("%Y-%m-%dT%H:%M:%SZ", a));

    // 串内 %z 偏移优先：+0800 的墙上时间回落到 UTC
    var b: i64 = parse_time("%d/%b/%Y:%H:%M:%S %z", "03/Aug/2025:20:51:30 +0800");
    println(int_to_str(b));

    // 微秒 + Z 后缀
    var c2: i64 = parse_time("%Y-%m-%dT%H:%M:%S.%f%z", "2025-08-03T20:51:30.123456Z");
    println(int_to_str(c2));

    // locale 字段码同样可解析
    var d2: i64 = parse_time("%c", "Sun Aug  3 20:51:30 2025");
    println(int_to_str(d2));

    // 12 小时制 + AM/PM
    var e2: i64 = parse_time("%Y-%m-%d %I:%M %p", "2025-08-03 08:51 PM");
    println(format_time("%H:%M", e2));

    // 失败：月份越界
    var bad: i64 = parse_time("%Y-%m-%d", "2025-13-01");
    if (bad == time_invalid()) { println("invalid: month"); } else { println("BUG"); }

    // 失败：尾部有未消耗的残留输入（不做静默截断）
    var bad2: i64 = parse_time("%Y-%m-%d", "2025-08-03junk");
    if (bad2 == time_invalid()) { println("invalid: trailing"); } else { println("BUG"); }

    // 往返：format → parse 应还原同一微秒值
    var rt: i64 = parse_time("%Y-%m-%dT%H:%M:%S.%f",
        format_time("%Y-%m-%dT%H:%M:%S.%f", 1754254290123456));
    println(int_to_str(rt));
    return 0;
}
