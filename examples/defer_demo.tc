// defer_demo.tc — 验证 defer 延迟语句（L-15 采用，DeferStmt）
// 覆盖：① 多个 defer 按 LIFO（后登记先执行）② 引用语义（捕获退出时状态）
//       ③ 显式 return 前触发 ④ 无显式 return 的函数尾触发（void 函数）
// 预期输出见 examples/defer_demo.expected.txt。

@main
main fn() -> i64 {
    test_lifo();
    test_ref();
    test_void();
    return 0;
}

// 多个 defer：登记顺序 1,2,3 → 执行顺序 3,2,1（LIFO）
test_lifo fn() -> i64 {
    defer { println("1"); }
    defer { println("2"); }
    defer { println("3"); }
    return 0;
}

// 引用语义：延迟块捕获的是退出时的变量状态，非定义时快照
test_ref fn() -> i64 {
    var x: i64 = 10;
    defer { println(int_to_str(x)); }
    x = 20;
    return 0;
}

// 无显式 return：走函数尾延迟栈收尾
test_void fn() -> void {
    defer { println("v"); }
}
