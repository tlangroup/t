// clause_fn.tc — 函数化（N13）+ 不可反驳重排（N11 判据修正）+ 展开（N10）
// 设计：docs/compiler/first-class-clause.md §5.4（展开/重排）§5.5（函数化）
//
// ⚠ 本例的核心探针是 **N11 判据修正**：不可反驳的不只是 `_`，**裸绑定** 同样恒命中。
//   `HB = @clause(.pattern, n, 0)` 被写在 HP 的**首位**：
//     · 若判据只认 `_`（旧行为）⇒ HB 留在首位恒命中 ⇒ pick_bind(5) 也返回 0；
//     · 判据认「标识符」（新行为）⇒ HB 被重排到末位 ⇒ pick_bind(5) 返回 50。
//   期望输出 `... 50 0` 即证明修正生效（旧行为会得到 `... 0 0`）。
//
// 另验证 N13 函数化：`fn pick(x: i64) i64 = <子句组>;` —— `= <expr>` 在函数体位
// 此前是解析错误，属空位利用。展开后子句组被完全擦除 ⇒ pick 仍是**运行期**函数。

// ① 通配写在首位 —— 期望被重排到末位充当 else
const G0 = @clause(.pattern, _, 0 - 1);
const G1 = @clause(.pattern, 0, 10);
const G2 = @clause(.pattern, 1, 11);
const GP = [G0, G1, G2];

fn pick(x: i64) i64 = GP;

// ② 裸绑定写在首位 —— 同样应被重排到末位
const HB = @clause(.pattern, n, 0);
const H1 = @clause(.pattern, 5, 50);
const HP = [HB, H1];

fn pick_bind(x: i64) i64 = HP;

@main
fn main() i64 {
    println(int_to_str(pick(0)));       // 10
    println(int_to_str(pick(1)));       // 11
    println(int_to_str(pick(7)));       // -1  （else）
    println(int_to_str(pick_bind(5)));  // 50  （裸绑定已让位）
    println(int_to_str(pick_bind(9)));  // 0   （落到绑定臂）
    return 0;
}
