// struct-modifiers · overload struct / extend overload struct（Task #6 搬运自
// docs/design/struct-modifiers/EXAMPLES_extend_a.tc / _b.tc）
//
// 说明：设计审查件为「跨文件同编译单元」形式（见 examples/cross/struct_extend_a.tc /
// struct_extend_b.tc）。run_examples 只收集 examples/ 顶层的单文件示例，
// 故此处给出等价的单文件版本，以便把 T6 纳入双后端 golden 比对。
//
//   overload struct  Entity → 标记为开放可扩展组，尾部 `_` 为扩展锚点（不占空间）
//   extend overload struct Entity → 追加字段/方法，排在锚点之后
//   单独 extend（无 overload 组）→ 报 T-OVL-E980（见 f_struct_extend_no_group.tc）

struct Vec3 {
    x: f64;
    y: f64;
    z: f64;
}

overload struct Entity {
    id:  u64;
    pos: Vec3;
    _;                    // 扩展锚点（实例化时无需填充）
}

extend overload struct Entity {
    tag: u32;
    fn describe(self: Entity) string {
        return "entity#" + int_to_str(self.id as i64)
             + " tag="   + int_to_str(self.tag as i64);
    }
}

@main fn main() i32 {
    var bad: i64 = 0;

    var e: Entity;
    e.id = 7;
    e.pos = Vec3 { x: 1.0, y: 2.0, z: 3.0 };
    e.tag = 99;                       // 来自 extend 的追加字段

    if ((e.id as i64) != 7) { bad = bad + 1; }
    if (e.pos.x != 1.0 || e.pos.y != 2.0 || e.pos.z != 3.0) { bad = bad + 1; }
    if ((e.tag as i64) != 99) { bad = bad + 1; }

    println(e.describe());            // 来自 extend 的追加方法
    if (e.describe() != "entity#7 tag=99") { bad = bad + 1; }

    return bad;
}
