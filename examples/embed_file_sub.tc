// @embed_file 相对路径解析：相对「调用源文件所在目录」(examples/)，
// 可跨入子目录。验证路径基准是源文件目录而非进程 cwd。
@main
fn main() i64 {
    var bin: string = @embed_file("sub/embed_data.bin");
    var blen: i64 = str_len(bin) as i64;
    println(int_to_str(blen));                 // 期望 6
    var i: i64 = 0;
    while (i < blen) {
        println(int_to_str(str_at(bin, i)));  // 期望 170 187 204 0 221 238
        i = i + 1;
    }
    return 0;
}
