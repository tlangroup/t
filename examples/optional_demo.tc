// ?T 可选类型演示
//
// 表示模型：?T ↔ 可空指针（none = 空指针，some(x) = arena 拷贝后返回其指针）。
//   ?T          可选类型（Zig 式前缀写法；后缀 `T?` 已于 2026-10-29 移除）
//   ?           none 字面量（规范形是关键字 `null`，裸 `?` 为兼容别名）
//   some(x)     构造「有值」
//   unwrap(x)   取值（none 时 panic）；写作后缀 `x.?` 等价，见 examples/option_zig.tc
//   is_some(x) / is_none(x)   空值探测

struct Point { x: i64; y: i64; }

fn make_opt(x: i64) ?i64 {
    if (x > 0) {
        return some(x);
    }
    return ?;
}

// 元素类型也可以是聚合（struct）：聚合在 LLVM 后端按 ptr 表示，
// 取值时直接返回 checked 指针，不再 load。
fn point_sum(op: ?Point) i64 {
    if (is_some(op)) {
        var p: Point = unwrap(op);
        return p.x + p.y;
    }
    return 0;
}

@main
fn main() i64 {
    var seed: i64 = 42;
    var a: ?i64 = some(seed);
    if (is_some(a)) {
        println(f"{unwrap(a)}");
    }

    var b: ?i64 = ?;
    if (is_none(b)) {
        println("b is none");
    }

    var c: ?i64 = make_opt(7);
    println(f"{unwrap(c)}");

    var d: ?i64 = make_opt(-1);
    if (is_none(d)) {
        println("d is none");
    }

    var pt: Point;
    pt.x = 10;
    pt.y = 5;
    var op: ?Point = some(pt);
    println(f"{point_sum(op)}");
    return 0;
}
