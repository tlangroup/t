// f-string 字面量（M-fstr）：`f"..."` / `f"""..."""`。
// 转换字段语义：!s str / !r repr / !a ascii / !j json / !p pbtxt / !c csv。
// 六种均可作用于任意值类型：字符串走格式专属转义，标量即裸值。
@main main fn() i64 {
    var name: string = "world";
    var n: i64 = 42;
    var pi: f64 = 3.14159;
    var u: u32 = 4095;
    var on: bool = true;
    var zh: string = "中文";
    var q: string = "a\"b";
    var comma: string = "x,y";

    println(f"hello {name}!");
    println(f"len={str_len(name)} expr={n * 2 + 1}");
    println(f"|{name:>10}|{n:05}|{pi:.3f}|");
    println(f"{name!s} {name!r} {name!a} {name!j} {name!p} {name!c}");
    println(f"{zh!r} {zh!a}");
    println(f"int: {n!j} {n!p} {n!c} {u!p}");
    println(f"quote  j:{q!j}  p:{q!p}  c:{q!c}");
    println(f"comma  j:{comma!j}  p:{comma!p}  c:{comma!c}");
    println(f"conv+spec |{name!r:>12}|");
    println(f"braces {{{name}}} ok");
    println(f"not = {!on}");
    println(f"nested = {f"inner {n}"}");
    println(f"no interpolation at all");
    println(f"""long form {name} with "quotes" inside""");
    return 0;
}
