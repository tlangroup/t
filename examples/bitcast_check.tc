// R-013 @bitCast 双后端真位重解释验证。
// 关键：float<->int 跨界必须用真位重解释（memcpy/bitcast），不能是 C 算术强转。
// 每个用例：构造已知位模式 → bitCast 到目标 → 再 bitCast 回 u32 打印，验证位模式原样保留。
@main
fn main() i64 {
    // 1.0f32 的位模式 = 0x3F800000
    var a: f32 = @bitCast(f32, 0x3F800000u32);
    var a_back: u32 = @bitCast(u32, a);
    println(int_to_str(a_back as i64));          // 1065353216

    // quiet NaN 位模式 = 0x7FC00000
    var qnan: f32 = @bitCast(f32, 0x7FC00000u32);
    var qnan_back: u32 = @bitCast(u32, qnan);
    println(int_to_str(qnan_back as i64));        // 2139095040

    // +Inf 位模式 = 0x7F800000
    var pinf: f32 = @bitCast(f32, 0x7F800000u32);
    var pinf_back: u32 = @bitCast(u32, pinf);
    println(int_to_str(pinf_back as i64));        // 2139095040

    // -0.0 位模式 = 0x80000000
    var nz: f32 = @bitCast(f32, 0x80000000u32);
    var nz_back: u32 = @bitCast(u32, nz);
    println(int_to_str(nz_back as i64));         // 2147483648

    // i32 <-> u32 同尺寸（C 强转也是位保留，纯 sanity）
    var neg: i32 = @bitCast(i32, 0xFFFFFFFFu32);  // -1
    println(int_to_str(neg as i64));              // -1
    var neg_back: u32 = @bitCast(u32, neg);
    println(int_to_str(neg_back as i64));        // 4294967295

    // 二次跨界：f64 <-> u64（双精度 1.0 = 0x3FF0000000000000）
    var d: f64 = @bitCast(f64, 0x3FF0000000000000u64);
    var d_back: u64 = @bitCast(u64, d);
    println(int_to_str(d_back as i64));          // 4607182418800017408

    return 0;
}
