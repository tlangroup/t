// P5：void 移除、unit 作其过渡别名；unit 既是类型也是值（() 空元组字面量）。
// ① unit 作类型：局部变量声明（C 后端 `void x;` 非法 → 编译器降级丢弃，不发射）。
// ② unit 作函数返回类型与返回值 ()；unit 作函数形参类型。
@main
fn main() i64 {
    var u: unit = ();          // unit 类型局部变量（降级丢弃）
    noop();                    // 调用 unit 返回类型函数（值被丢弃）
    var w: unit = make_unit(); // unit 值作返回值再赋给 unit 变量
    var r: i64 = demo();       // 证明 unit 与 i64 是独立类型
    println(int_to_str(r));
    return 0;
}

fn noop() unit {
    ();
}

fn make_unit() unit {
    return ();
}

fn demo() i64 {
    var _x: unit = ();
    return 42;
}
