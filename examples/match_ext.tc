// 双后端运行时语义验证：match 扩展 S1(或模式) / S2(范围) / S3(@ 绑定) / S4(不可达告警)。
// 覆盖 docs/syntax/drafts/match.md §6.1 待办中已实装的能力；运行输出须双后端逐字节一致
// （run_examples 交叉验证）。详见 docs/syntax/drafts/match_extensions.md（S1–S4 状态=已实现）。
//
// 其中 S3 的 `返回 string` 形态直接命中本次修复的 __mres 结果槽宽度问题
// （运行期 scrutinee 的 match 无法从 sema 反推结果类型，曾退化为 i64 槽 → 链接期
// `defined with type 'i64' but expected '%TStr'`），本例即该路径的双后端门禁覆盖。

fn or_class(x: i64) string {
    return match (x) {
        1 | 2 | 3 => "small"
        4 | 5 => "mid"
        _ => "other"
    };
}

fn range_class(x: i64) string {
    return match (x) {
        1..=3 => "a"
        4..=6 => "b"
        _ => "w"
    };
}

// @ 绑定标量范围（S3 核心：返回 string 触发 __mres 槽宽修复）
fn as_single(x: i64) string {
    return match (x) {
        v @ 1..=3 => "a=" + int_to_str(v)
        _ => "w"
    };
}

fn as_two(x: i64) string {
    return match (x) {
        v @ 1..=3 => "a=" + int_to_str(v)
        v @ 5..=7 => "b=" + int_to_str(v)
        _ => "w"
    };
}

variant Shape { Circle(i64); Rect(i64); Empty; }

fn area(s: Shape) i64 {
    return match (s) {
        Circle(r) => 3 * r * r
        Rect(a) => 4 * a
        Empty => 0
    };
}

// 构造器 as-模式：c 绑整体 variant、r 解构载荷（S3 variant 形态）
fn with_as(s: Shape) string {
    return match (s) {
        c @ Circle(r) => "circle area=" + int_to_str(area(c)) + " r=" + int_to_str(r)
        _ => "other"
    };
}

@main
fn main() i32 {
    var ok: bool = true;
    if (or_class(1) != "small") { ok = false; }
    if (or_class(5) != "mid") { ok = false; }
    if (or_class(9) != "other") { ok = false; }
    if (range_class(2) != "a") { ok = false; }
    if (range_class(5) != "b") { ok = false; }
    if (as_single(2) != "a=2") { ok = false; }
    if (as_two(2) != "a=2") { ok = false; }
    if (as_two(6) != "b=6") { ok = false; }
    if (with_as(Shape { .Circle(5) }) != "circle area=75 r=5") { ok = false; }
    if (with_as(Shape { .Rect(2) }) != "other") { ok = false; }
    if (ok == false) { println("FAIL"); return 1; }
    println("match_ext ok");
    return 0;
}
