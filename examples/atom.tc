// Atom 类型（Erlang 式原子）演示
// 语法： :name   —— 编译期 intern 为稳定 i64，按整数身份比较/匹配，零运行时开销。
// 类型： atom（64 位标量，LLVM=i64 / C=int64_t）
// 注：match 的 arm body 是单表达式（与现有 match 语法一致）。
// 注：本 demo 用 if/match 展示相等性，因为编译器的 i64(bool) 强转是既有未修复 bug（与 atom 无关）。

// 返回 atom 的函数
status fn(code: i64) atom {
    if (code == 0) { return :ok; }
    if (code == 1) { return :error; }
    return :unknown;
}

// 用 StringBuilder 打印 i64（print 只接受 string）
pr fn(label: string, v: i64) void {
    var b: StringBuilder = sb_new();
    sb_append_str(b, label);
    sb_append_i64(b, v);
    println(sb_to_str(b));
}

// 用 match 把 atom 转成可读字符串（arm body 为单表达式）
name_of fn(a: atom) string {
    return match (a) {
        :ok     => "ok"
        :error  => "error"
        :ready  => "ready"
        _       => "other"
    };
}

@main
main fn() i64 {
    // 1. 字面量与类型标注（atom 即 i64，可直接打印其稳定 id）
    var s: atom = :ok;
    pr("s id          = ", s as i64);   // 稳定整数 id（atom 是不透明标量，取整数 id 须显式转换）
    println(name_of(s));                // ok

    // 2. 相等性（按整数身份）—— 用分支展示，避开 i64(bool) 既有 bug
    if (:ok == :ok)        { println(":ok == :ok     => true"); }  else { println(":ok == :ok     => false"); }
    if (:ok == :error)     { println(":ok == :error  => true"); }  else { println(":ok == :error  => false"); }
    var a2: atom = :ready;
    var a3: atom = :ready;
    if (a2 == a3)          { println("var==var(同值) => true"); }  else { println("var==var(同值) => false"); }

    // 3. 函数返回 atom + match
    println(name_of(status(0)));        // ok
    println(name_of(status(1)));        // error
    println(name_of(status(7)));        // other

    // 4. match 在变量上做模式分发（单表达式 body）
    var r: atom = :ready;
    var msg: string = match (r) {
        :ok     => "ok branch"
        :ready  => "got ready"
        _       => "fallthrough"
    };
    println(msg);                       // got ready

    // 5. 全局符号：atom_str(a) 从进程级原子名表还原名字（无需手写 match）
    //    名表由编译器发射为全局 t_atom_table[]，整个程序共享，id 全局唯一。
    println(atom_str(:ok));             // ok
    println(atom_str(:error));          // error
    println(atom_str(s));               // ok（变量同样可还原）
    println(atom_str(status(7)));       // unknown（函数返回值）
    var self_ref: atom = :ready;
    println(atom_str(self_ref));        // ready

    // 名表遍历：id 是 1-based 稠密整数，可直接当索引/数组下标用
    var k: i64 = 1;
    while (k <= 5) {
        var line: StringBuilder = sb_new();
        sb_append_str(line, "  atom #");
        sb_append_i64(line, k);
        sb_append_str(line, " = ");
        sb_append_str(line, atom_str(k as atom));
        println(sb_to_str(line));
        k = k + 1;
    }

    return 0;
}
