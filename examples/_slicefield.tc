// 切片元素的字段赋值守卫（LLVM 后端自举致命 bug 的最小复现）
// 现象：`s[i].field = v` 在 LLVM 后端写入无效（写后读回仍是旧值），C 后端正常。
// 编译器自身因此无法标记 `nodes[d].bc = true`（pub 可见性），导致 check 大工程时
// 每个跨模块引用都报 T-MOD-E558（src/tc.tc 上达 17956 条）。
struct P {
    x: i64;
    y: i64;
}

@main
fn main() i64 {
    var s: []P = [];
    var p: P;
    p.x = 1;
    p.y = 2;
    append(s, p);
    s[0].x = 42;
    var got: i64 = s[0].x;
    println(int_to_str(got));
    if (got == 42) { return 0; }
    return 1;
}
