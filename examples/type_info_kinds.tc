// 阶段1 S5+ 补全：@type_info(T) 对任意 kind 在编译期返回可用的 TypeInfo variant。
// 断言均基于数值字段（kind / size / field_count），避免字符串比较不确定性。
struct Point { x: i64; y: i64; }
enum Color { Red; Green; Blue; }
union Shape { p: Point; c: Color; }

@main fn main() i32 {
    comptime {
        // 标量
        if (@type_info(i64).Int.kind == 0) { @compile_log("Int kind 0"); }
        if (@type_info(i64).Int.size == 8) { @compile_log("Int size 8"); }
        if (@type_info(f64).Float.kind == 1) { @compile_log("Float kind 1"); }
        if (@type_info(f64).Float.size == 8) { @compile_log("Float size 8"); }
        if (@type_info(bool).Bool.kind == 2) { @compile_log("Bool kind 2"); }
        if (@type_info(bool).Bool.size == 1) { @compile_log("Bool size 1"); }
        // 合成类型（parse_type 支持的语法）
        if (@type_info(*i64).Ptr.kind == 3) { @compile_log("Ptr kind 3"); }
        if (@type_info(*i64).Ptr.size == 8) { @compile_log("Ptr size 8"); }
        if (@type_info([]i64).Slice.kind == 4) { @compile_log("Slice kind 4"); }
        if (@type_info([]i64).Slice.size == 32) { @compile_log("Slice size 32"); }
        if (@type_info([3]i64).Array.kind == 5) { @compile_log("Array kind 5"); }
        // 具名复合类型
        if (@type_info(Point).Struct.kind == 7) { @compile_log("Struct kind 7"); }
        if (@type_info(Point).Struct.field_count == 2) { @compile_log("Struct fc 2"); }
        if (@type_info(Point).Struct.field_types[0] == i64) { @compile_log("Struct f0 i64"); }
        if (@type_info(Point).Struct.size > 0) { @compile_log("Struct size >0"); }
        if (@type_info(Color).Enum.kind == 8) { @compile_log("Enum kind 8"); }
        if (@type_info(Shape).Union.kind == 10) { @compile_log("Union kind 10"); }
    }
    return 0;
}
