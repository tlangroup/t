// 括号类型 `( Type )` —— R3（docs/design/set-ops/DESIGN.md §13.8）
// 括号只改写类型运算符的结合边界，**不包层、不产生新 kind** ⇒ 对 sema / codegen 透明：
// 去掉括号后本例必须产出逐字相同的 stdout（这是本 golden 的判据）。
// 单独列出是因为 `as T` 位的 `g_type_and` 为假，那里写不出合取类型，
// `x as (A && B)` 这条退路只能靠括号提供（此处用不含合取的最小形态验证管道通行）。

fn add1(a: i64) i64 {
    return a + 1;
}

@main
fn main() i64 {
    var x: (i64) = 7;
    println(int_to_str(add1(x)));
    println(int_to_str(add1(x as (i64))));

    var s: [2](i64) = [41, 42];
    println(int_to_str(s[1]));

    var o: (i64)? = some(x);
    println(int_to_str(unwrap(o)));

    return 0;
}
