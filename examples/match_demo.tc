// match_demo.tc — 验证 match 表达式（L-15 / docs/syntax/drafts/match.md）
// 覆盖：① 整数字面量模式 + `_` 通配 ② 裸标识符绑定 ③ `when` 守卫（含绑定引用）
//       ④ 字符串模式 ⑤ 首个匹配优先（不可反驳 arm 之后不可达）
//       ⑥ match 作为 return 值 / 赋值右值 / 实参 ⑦ 绑定名遮蔽外层同名局部
// 预期输出见 examples/match_demo.expected.txt。

@main
main fn() i64 {
    test_scalar();
    test_guard();
    test_string();
    test_shadow();
    test_nested();
    return 0;
}

// 整数字面量 + 通配兜底
classify fn(x: i64) string {
    var r: string = match (x) {
        0 => "zero"
        1 => "one"
        2 => "two"
        _ => "many"
    };
    return r;
}

test_scalar fn() void {
    println(classify(0));
    println(classify(1));
    println(classify(2));
    println(classify(7));
}

// 绑定 + when 守卫：守卫内引用绑定名；首个匹配优先
sign_of fn(x: i64) string {
    return match (x) {
        0 => "zero"
        n when n > 0 => "positive"
        _ => "negative"
    };
}

// 绑定值可参与运算
double_or_zero fn(x: i64) i64 {
    return match (x) {
        n when n > 0 => n * 2
        _ => 0
    };
}

test_guard fn() void {
    println(sign_of(0));
    println(sign_of(5));
    println(sign_of(0 - 5));
    println(int_to_str(double_or_zero(21)));
    println(int_to_str(double_or_zero(0 - 3)));
}

// 字符串模式（走 t_str_eq / tll_str_eq）
lang_of fn(code: string) string {
    return match (code) {
        "zh" => "Chinese"
        "en" => "English"
        _ => "Unknown"
    };
}

test_string fn() void {
    println(lang_of("zh"));
    println(lang_of("en"));
    println(lang_of("fr"));
}

// 绑定名与外层局部同名：arm 内绑定遮蔽外层，match 结束后外层不受影响
test_shadow fn() void {
    var n: i64 = 100;
    var s: string = match (7) {
        n when n > 5 => "gt5"
        _ => "le5"
    };
    println(s);
    println(int_to_str(n));
}

// match 作为实参 + 嵌套 match
grade fn(x: i64) string {
    return match (x) {
        n when n > 90 => "A"
        n when n > 80 => "B"
        _ => match (x) {
            m when m > 60 => "C"
            _ => "F"
        }
    };
}

test_nested fn() void {
    println(grade(95));
    println(grade(85));
    println(grade(70));
    println(grade(30));
}
