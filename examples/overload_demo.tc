// overload_demo.tc — Route 1：单文件值/结构模式 overload
//
// overload 声明组复用既有函数子句脱糖（desugar_func_clauses）→ 单一函数 + match 臂。
// 本例仅用值/标量/字符串/when 守卫模式（双后端安全）；struct 字面量模式 overload
// 受 KI-002 影响（仅 C 后端），见 tests/known-issues/KI-002_overload_struct_pat.tc。
//
// 覆盖：① 标量+when 守卫 overload 组  ② 字符串模式 overload 组
//       ③ 同文件 extend overload 向已有组追加具体臂（通配臂自动排末，使其生效）
// 预期输出见 overload_demo.expected.txt。

@main
fn main() i64 {
    test_scalar();
    test_string();
    test_extend();
    return 0;
}

// ── ① 标量 + when 守卫 overload 组 ──────────────────────────────
overload fn describe(0) string { return "zero"; }
overload fn describe(1) string { return "one"; }
overload fn describe(n when n > 1) string { return "many"; }
overload fn describe(_) string { return "negative"; }

fn test_scalar() void {
    println(describe(0));
    println(describe(1));
    println(describe(5));
    println(describe(0 - 7));
}

// ── ② 字符串模式 overload 组 ────────────────────────────────────
overload fn greet("zh") string { return "你好"; }
overload fn greet("en") string { return "hello"; }
overload fn greet(_) string { return "?"; }

fn test_string() void {
    println(greet("zh"));
    println(greet("en"));
    println(greet("fr"));
}

// ── ③ 同文件 extend overload：向已有组追加具体臂 ─────────────────
overload fn tag(0) string { return "none"; }
overload fn tag(_) string { return "other"; }
extend overload fn tag(42) string { return "answer"; }

fn test_extend() void {
    println(tag(0));
    println(tag(42));
    println(tag(7));
}
