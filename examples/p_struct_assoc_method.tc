// P3b 示例：struct 关联函数（类型级 T.fn()）与值级方法（v.fn()）成员调用脱糖。
struct Point {
    x: i64;
    y: i64;
    fn origin() Point {
        return Point{ .x = 0, .y = 0 };
    }
    fn get_x(self: Point) i64 {
        return self.x;
    }
    fn add(self: Point, o: Point) Point {
        return Point{ .x = self.x + o.x, .y = self.y + o.y };
    }
}
@main fn main() i32 {
    var o: Point = Point.origin();
    println(i2s(o.x));
    println(i2s(o.y));
    var p: Point = Point{ .x = 3, .y = 4 };
    println(i2s(p.get_x()));
    var q: Point = p.add(Point{ .x = 10, .y = 20 });
    println(i2s(q.x));
    println(i2s(q.y));
    return 0;
}
