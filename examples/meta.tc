// examples/meta.tc —— 元编程关键字 `comptime` 的可运行用例（Phase A+B，reference §3.6.3）
//
// 已落地（本文件全部内容均可编译并在双后端运行）：
//   ① comptime T: type   编译期类型参数 —— 调用点以类型名作首实参触发单态化
//   ② comptime { }       编译期块 —— 编译期执行，不产生任何运行期代码
//   ③ comptime <expr>    编译期表达式前缀 —— 就地折叠为字面量
//   ④ comptime const/var/fn  编译期声明
//
// `comptime` 是统一的编译期关键字（编译期求值 / 泛型类型参数 / 编译期声明）；
// `type` 与 `any` 互为别名（同为「类型之类型」占位）。`meta` 现为保留关键字 KwMeta（当前无语义、留作他用，禁止用户用作标识符）。
//
// ⚠ `comptime { }` 里**不能**调用 `print` —— print 系列是**运行期函数**
//   （2026-10-11 裁定），编译期上下文里出现它 → `T-MTA-E617 未定义的编译期函数`。
//   编译期输出改用元函数 `@compile_log(...)`（写 stderr；stdout 是 JSON/IR 的机器可读通道），
//   告警用 `@compile_warning(...)`，硬错误用 `@compile_error(...)`。
//   编译期计算要影响运行期，须经 comptime var + `comptime <expr>` 折叠回来（见下方 c）。
//
// 完整目标形态（@compile_error / @type_equal / @zeroed / Sym 等 Phase C–D 内建）
// 见 docs/compiler/meta_target.tc 与 docs/compiler/meta_design.md。

// ── ① 编译期类型参数：调用点单态化，零运行时开销 ──────────────
fn id(comptime T: type, x: T) T { return x; }

fn max2(comptime T: type, a: T, b: T) T {
    if (a > b) { return a; }
    return b;
}

// 弃用过渡：以下两行历史上演示四种别名组合等价；现已统一为 `comptime T: type`。
fn pick(comptime T: type, x: T) T { return x; }
fn hold(comptime T: type, x: T) T { return x; }

// ── ④ 编译期顶层声明 ─────────────────────────────────────────
comptime const KLIMIT: i64 = 100;
comptime var ACC: i64 = 0;

comptime fn addk(a: i64, b: i64) i64 { return a + b; }

// 编译期递归：整棵调用树在编译期展开，运行期只剩一个字面量
comptime fn fact(n: i64) i64 {
    if (n <= 1) { return 1; }
    return n * fact(n - 1);
}

fn main() i64 @main {
    // ── ② 编译期块：编译期执行，运行期零代码 ────────────────
    comptime {
        @compile_log("meta-block\n");    // 编译期日志 → stderr（不定长元函数）
        var k: i64 = 1;
        while (k <= 4) {                // 1+4+9+16 = 30
            ACC = ACC + k * k;
            k = k + 1;
        }
    }

    // ── ③ 编译期表达式前缀：折叠为字面量 ────────────────────
    var a: i64 = comptime 4 + 2;
    var b: i64 = comptime addk(10, 5);
    var c: i64 = comptime ACC;              // 30 ← ② 的编译期累加结果
    var d: i64 = comptime fact(10);         // 3628800，编译期递归求值
    var w: i64 = comptime str_len("meta");  // 4，编译期纯函数

    // ── ① 泛型调用：各自单态化为 id__i64 / id__string / max2__i64 ──
    auto n = id(i64, 42);
    auto s = id(string, "hi");
    auto m = max2(i64, 7, 99);
    auto p = pick(i64, 33);
    auto h = hold(bool, true);

    print(int_to_str(a)); print("\n");
    print(int_to_str(b)); print("\n");
    print(int_to_str(c)); print("\n");
    print(int_to_str(d)); print("\n");
    print(int_to_str(w)); print("\n");
    print(int_to_str(n)); print("\n");
    print(int_to_str(m)); print("\n");
    print(int_to_str(p)); print("\n");
    print(int_to_str(KLIMIT)); print("\n");
    print(s); print("\n");

    // 运行期自校验
    if (a == 6 and b == 15 and c == 30 and d == 3628800 and w == 4
        and n == 42 and m == 99 and p == 33 and h and KLIMIT == 100 and s == "hi") {
        return 0;
    }
    return 1;
}
