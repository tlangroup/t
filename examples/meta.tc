// examples/meta.tc —— 元编程关键字 `meta` 的可运行用例（Phase A+B，reference §3.6.3）
//
// 已落地（本文件全部内容均可编译并在双后端运行）：
//   ① meta T: type   编译期类型参数 —— 调用点以类型名作首实参触发单态化
//   ② meta { }       编译期块 —— 编译期执行，不产生任何运行期代码
//   ③ meta <expr>    编译期表达式前缀 —— 就地折叠为字面量
//   ④ meta const/var/fn  编译期声明
//
// `meta` 与 `comptime`、`type` 与 `any` 在历史版本中互为别名、四种组合等价；
// `comptime` / `any` 现已**弃用**（使用会发 W_COMPTIME_ALIAS 告警），`meta` / `type` 为唯一推荐拼写。
//
// ⚠ Phase B（CTFE 求值器）改变了一处可观察行为：`meta { }` 里的 `print`
//   现在在**编译期**执行、写 **stderr**（stdout 是 JSON/IR 的机器可读通道），
//   不再出现在程序运行输出里。这是 `meta {}` 的正确语义，而非回归。
//   编译期计算要影响运行期，须经 meta var + `meta <expr>` 折叠回来（见下方 c）。
//
// 完整目标形态（@compile_error / @type_equal / @zeroed / Sym 等 Phase C–D 内建）
// 见 docs/meta_target.tc 与 docs/meta_design.md。

// ── ① 编译期类型参数：调用点单态化，零运行时开销 ──────────────
id fn(meta T: type, x: T) T { return x; }

max2 fn(meta T: type, a: T, b: T) T {
    if (a > b) { return a; }
    return b;
}

// 弃用过渡：以下两行历史上演示四种别名组合等价；现已统一为 `meta T: type`。
pick fn(meta T: type, x: T) T { return x; }
hold fn(meta T: type, x: T) T { return x; }

// ── ④ 编译期顶层声明 ─────────────────────────────────────────
meta const KLIMIT: i64 = 100;
meta var ACC: i64 = 0;

meta addk fn(a: i64, b: i64) i64 { return a + b; }

// 编译期递归：整棵调用树在编译期展开，运行期只剩一个字面量
meta fact fn(n: i64) i64 {
    if (n <= 1) { return 1; }
    return n * fact(n - 1);
}

main fn() i64 @main {
    // ── ② 编译期块：编译期执行，运行期零代码 ────────────────
    meta {
        print("meta-block\n");          // 编译期日志 → stderr
        var k: i64 = 1;
        while (k <= 4) {                // 1+4+9+16 = 30
            ACC = ACC + k * k;
            k = k + 1;
        }
    }

    // ── ③ 编译期表达式前缀：折叠为字面量 ────────────────────
    var a: i64 = meta 4 + 2;
    var b: i64 = meta addk(10, 5);
    var c: i64 = meta ACC;              // 30 ← ② 的编译期累加结果
    var d: i64 = meta fact(10);         // 3628800，编译期递归求值
    var w: i64 = meta str_len("meta");  // 4，编译期纯函数

    // ── ① 泛型调用：各自单态化为 id__i64 / id__string / max2__i64 ──
    auto n = id(i64, 42);
    auto s = id(string, "hi");
    auto m = max2(i64, 7, 99);
    auto p = pick(i64, 33);
    auto h = hold(bool, true);

    print(int_to_str(a)); print("\n");
    print(int_to_str(b)); print("\n");
    print(int_to_str(c)); print("\n");
    print(int_to_str(d)); print("\n");
    print(int_to_str(w)); print("\n");
    print(int_to_str(n)); print("\n");
    print(int_to_str(m)); print("\n");
    print(int_to_str(p)); print("\n");
    print(int_to_str(KLIMIT)); print("\n");
    print(s); print("\n");

    // 运行期自校验
    if (a == 6 && b == 15 && c == 30 && d == 3628800 && w == 4
        && n == 42 && m == 99 && p == 33 && h && KLIMIT == 100 && s == "hi") {
        return 0;
    }
    return 1;
}
