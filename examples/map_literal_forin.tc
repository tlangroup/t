// map_literal_forin.tc — map 字面量 [k: v] 与 for-in 迭代的最小演示
//
// 语法要点：
//   * map 字面量用 **方括号** [键: 值]，不是花括号 {键: 值}。
//   * for-in 迭代支持两种形式：
//       for (k   in m) { ... }   // 仅键
//       for (k, v in m) { ... }  // 键 + 值，按插入序
//   键/值类型由 map 类型推导，支持 string / i64 键与任意值类型。
//
// 期望输出见 examples/map_literal_forin.expected.txt（C == LLVM 逐字节一致）。
// 注：字符串拼接统一走 StringBuilder（sb_new / sb_append_str / sb_to_str），cat 内建已移除。

sum_vals fn(m: map[string]i64) i64 {
    var t: i64 = 0;
    for (k, v in m) {
        t = t + v;
    }
    return t;
}

@main
main fn() i64 {
    // ① map 字面量（字符串键）+ 键值同迭代
    var ms: map[string]i64 = ["alice": 10, "bob": 20, "carol": 30];
    var s: i64 = 0;
    for (k, v in ms) {
        s = s + v;
    }
    print(int_to_str(s));
    print("\n");

    // ② 键单独迭代（key-only 形式），按插入序
    for (k in ms) {
        print(k);
        print("\n");
    }

    // ③ map 字面量（整型键）+ 整型键值迭代
    var mi: map[i64]i64 = [1: 100, 2: 200, 3: 300];
    var it: i64 = 0;
    for (ik, iv in mi) {
        it = it + iv;
    }
    print(int_to_str(it));
    print("\n");

    // ④ map 字面量直接作函数实参
    print(int_to_str(sum_vals(["x": 1, "y": 2, "z": 3])));
    print("\n");
    return 0;
}
