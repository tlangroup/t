// v2 @type_info 反射示例（运行时反射 API 全貌演示）
//
// 说明：t 的 TypeInfo / FieldInfo 为 t-native variant / struct，`type_info(T)` 在编译期
// 折成 TypeInfo 值（双后端经 @__ti_<T> 合成常量）。当前反射访问经由编译器内建访问函数
// （ti_*/fi_*，定义在 src/base.tc，属 v1 遗留 API）。
//
// v2 目标用法是 `match (ti) { Struct(m) => … m.field_count … }` 直接字段投影
// （见 docs/compiler/typeinfo-design.md §4），待 TypeInfo 在用户代码里成为可 match 的
// variant 后即可改写为投影式（本示例打印逻辑与 v2 投影式等价）。

struct Point {
    x: i64 @ 1;
    y: i64 @ 2 = 42;
    z: i64 @ 3;
    label: string @ 4;
}

@main
fn main() i64 {
    var ti: TypeInfo = type_info(Point);
    println(ti_name(ti));                       // Point
    println(int_to_str(ti_kind(ti)));          // 7 (Struct)
    println(int_to_str(ti_field_count(ti)));    // 4
    var n: i64 = ti_field_count(ti);
    var i: i64 = 0;
    var s: i64 = 0;
    while (i < n) {
        var fi: FieldInfo = ti_field(ti, i);
        println(fi_name(fi));
        println(int_to_str(fi_offset(fi)));
        println(fi_type_name(fi));
        println(int_to_str(fi_is_ptr(fi) as i64));
        println(int_to_str(fi_tag(fi)));
        s = s + fi_tag(fi);
        i = i + 1;
    }
    return s;  // 1 + 2 + 3 + 0 = 6 (label 全自动 → tag 0)
}
