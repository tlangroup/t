// @embed_file 编译期文件嵌入：将源文件所在目录下的文件字节，内联为常数 string。
// 关键点：二进制安全 —— 文件含中间 NUL 与高字节时，长度计入 NUL、字节无损。
@main
fn main() i64 {
    var bin: string = @embed_file("embed_data.bin");
    var blen: i64 = str_len(bin) as i64;
    println(int_to_str(blen));                 // 期望 7（NUL 计入长度）
    var i: i64 = 0;
    while (i < blen) {
        println(int_to_str(str_at(bin, i)));  // 期望 65 66 0 67 68 1 2
        i = i + 1;
    }
    var txt: string = @embed_file("embed_text.txt");
    println(txt);                              // 期望 hello embedded file
    return 0;
}
