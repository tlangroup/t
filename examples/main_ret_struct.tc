// `@main` 返回用户结构体：入口的返回值即进程退出码，聚合无法当退出码
// ⇒ 与 LLVM 后端一致**丢弃**（退出码 0）。
// 修复前：C 后端（tmir-c）clang 报
//   `error: incompatible pointer to integer conversion returning
//    'unsigned char *' from a function with result type 'int'`
// （`int t_main()` 的体里发 `return (t3)`），LLVM 侧则一直是 ret i32 0。
struct P {
    x: i64;
    y: i64;
}
fn mk(a: i64) P {
    return P{ .x = a, .y = a + 1i64 };
}
fn main_fn() P @main {
    var p: P = mk(7i64);
    println(i2s(p.x));
    println(i2s(p.y));
    return p;
}
