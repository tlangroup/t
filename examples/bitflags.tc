// flag 位域示例：紧凑权限位打包
// 运行: tc1 run --example bitflags

Perm :: flag[u16] {
    readable:  1;
    writable:  1;
    level:     4;
    owner_id:  8;
}

describe :: func(p: Perm) -> void {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "perm { r=");
    sb_append_u64(sb, flag_get(p, Perm.readable) as u64);
    sb_append_str(sb, " w=");
    sb_append_u64(sb, flag_get(p, Perm.writable) as u64);
    sb_append_str(sb, " level=");
    sb_append_u64(sb, flag_get(p, Perm.level) as u64);
    sb_append_str(sb, " owner=");
    sb_append_u64(sb, flag_get(p, Perm.owner_id) as u64);
    sb_append_str(sb, " }\n");
    print(sb_to_str(sb));
}

main_fn :: func() -> i32 @main {
    var p: Perm = 0;
    flag_set(p, Perm.readable, 1);
    flag_set(p, Perm.level, 7);
    flag_set(p, Perm.owner_id, 42);
    describe(p);

    flag_set(p, Perm.writable, 1);
    flag_set(p, Perm.level, 15);
    describe(p);

    if (flag_get(p, Perm.owner_id) == 42 && flag_get(p, Perm.level) == 15) {
        println("bitflags OK");
        return 0;
    }
    println("bitflags WRONG");
    return 1;
}
