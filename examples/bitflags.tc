// packed struct 位域示例：紧凑权限位打包
// 运行: tc1 run --example bitflags
//
// P7 起 `flag` 关键字已移除，改用 `packed struct`（位域顺序打包）。
// 字段类型里的数字后缀即位宽：`readable: u1` = 1 位，`level: u4` = 4 位。

packed struct Perm {
    readable: u1;
    writable: u1;
    level:    u4;
    owner_id: u8;
}

fn describe(p: Perm) void {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "perm { r=");
    sb_append_u64(sb, p.readable as u64);
    sb_append_str(sb, " w=");
    sb_append_u64(sb, p.writable as u64);
    sb_append_str(sb, " level=");
    sb_append_u64(sb, p.level as u64);
    sb_append_str(sb, " owner=");
    sb_append_u64(sb, p.owner_id as u64);
    sb_append_str(sb, " }\n");
    print(sb_to_str(sb));
}

fn main_fn() i32 @main {
    var p: Perm = Perm{ readable: 0, writable: 0, level: 0, owner_id: 0 };
    p.readable = 1;
    p.level = 7;
    p.owner_id = 42;
    describe(p);

    p.writable = 1;
    p.level = 15;
    describe(p);

    // P8：flag_set / flag_get 内建可直接作用于 packed struct 的「底层宿主整型」
    // （单掩码编码，mask = 位段掩码，语义与上面的具名字段读写完全一致）。
    // 这是 flag 关键字移除后保留下来的动态位域能力（宿主 u16，见 Perm 布局）。
    var q: Perm = Perm{ readable: 0, writable: 0, level: 0, owner_id: 0 };
    flag_set(q, 60, 5);      // level 位段（bits2..5，掩码 0b111100 = 60）= 5
    flag_set(q, 16320, 7);   // owner_id 位段（bits6..13，掩码 255<<6 = 16320）= 7
    var lv: u32 = flag_get(q, 60);
    var ow: u32 = flag_get(q, 16320);
    println("dyn level=" + int_to_str((lv as i64)) + " owner=" + int_to_str((ow as i64)));
    describe(q);

    if (p.owner_id == 42 and p.level == 15 and lv == 5 and ow == 7) {
        println("bitflags OK");
        return 0;
    }
    println("bitflags WRONG");
    return 1;
}
