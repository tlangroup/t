// 方法式 str.format（M57）：`"tmpl".format(a, b)` 与 `format("tmpl", a, b)` 完全同义，
// 编译期脱糖到同一个提升函数 __fmt_N，运行期没有模板引擎。
@main main fn() i64 {
    println("{0} + {1} = {2}".format(2, 3, 5));
    println("{} {} {}".format("a", "b", "c"));
    println("[{0:>8.3f}]".format(3.14159));
    println("{0:,}".format(1234567));
    println("{0:#x} {0:#b} {0:o}".format(255));
    println("{{literal}} {0}".format(1));
    println("{0} / {0} / {0}".format(9));

    // 嵌套在调用实参里（M55 遗漏、M57 修复：以前会漏到发射期变成 UNSUPPORTED）
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "nested:{0}".format(42));
    sb_append_str(sb, format("|{0}", true));
    println(sb_to_str(sb));

    // 与时间内建组合
    println("到期 {0}".format(format_time("%Y-%m-%d", 1754254290123456)));
    return 0;
}
