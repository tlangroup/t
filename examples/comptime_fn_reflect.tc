// 阶段1 S8 验证：comptime fn 体内纳入 g_in_comptime，使 @type_info / 裸类型名即 type 值可用。
comptime fn reflect_i64_size() i64 {
    // 在 comptime fn 体内，@type_info 应编译期折叠（依赖 g_in_comptime > 0）
    return @type_info(i64).Int.size;
}

@main fn main() i32 {
    comptime {
        if (reflect_i64_size() == 8) { @compile_log("S8: comptime fn reflects i64 size 8"); }
        // 裸类型名在 comptime fn 体内即 type 值（is_type_name 路由依赖 g_in_comptime）
        if (i64 == i64) { @compile_log("S8: bare i64 is type value inside comptime fn"); }
    }
    return 0;
}
