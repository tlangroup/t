// examples/math_stdlib_demo.tc —— std.math 浮点数学封装（底层内建，双后端语义验证）
// 运行: tc run --example math_stdlib_demo
// 依赖: lib/std/math.tc（薄封装编译器底层数学内建 @sin/@sinf/...）
// 各值乘以 1000 取整打印，规避浮点字符串格式化差异（双后端算术一致，故逐字节可比）。
@import("std.math");

fn main_fn() i32 @main {
    // —— f64（与底层 @sin/@cos/... 同名）——
    // 取整 / 绝对值
    println(i2s((math.fabs(-3.5) * 1000.0) as i64));
    println(i2s((math.floor(2.7) * 1000.0) as i64));
    println(i2s((math.ceil(2.1) * 1000.0) as i64));
    println(i2s((math.round(2.5) * 1000.0) as i64));
    println(i2s((math.trunc(-2.9) * 1000.0) as i64));
    // 算术
    println(i2s((math.sqrt(2.0) * 1000.0) as i64));
    println(i2s((math.cbrt(8.0) * 1000.0) as i64));
    println(i2s((math.pow(2.0, 10.0) * 1000.0) as i64));
    println(i2s((math.pow_i(2.0, 10) * 1000.0) as i64));
    println(i2s((math.hypot(3.0, 4.0) * 1000.0) as i64));
    println(i2s((math.fmod(5.3, 2.0) * 1000.0) as i64));
    println(i2s((math.copysign_f(2.0, -1.0) * 1000.0) as i64));
    println(i2s((math.fmin_f(1.0, 2.0) * 1000.0) as i64));
    println(i2s((math.fmax_f(1.0, 2.0) * 1000.0) as i64));
    // 指数 / 对数
    println(i2s((math.exp(1.0) * 1000.0) as i64));
    println(i2s((math.exp2(3.0) * 1000.0) as i64));
    println(i2s((math.expm1(1.0) * 1000.0) as i64));
    println(i2s((math.log(2.718281828459045) * 1000.0) as i64));
    println(i2s((math.log2(8.0) * 1000.0) as i64));
    println(i2s((math.log10(100.0) * 1000.0) as i64));
    println(i2s((math.log1p(1.0) * 1000.0) as i64));
    // 三角 / 反三角
    println(i2s((math.sin(1.5707963267948966) * 1000.0) as i64));
    println(i2s((math.cos(0.0) * 1000.0) as i64));
    println(i2s((math.tan(0.7853981633974483) * 1000.0) as i64));
    println(i2s((math.asin(1.0) * 1000.0) as i64));
    println(i2s((math.acos(-1.0) * 1000.0) as i64));
    println(i2s((math.atan(1.0) * 1000.0) as i64));
    println(i2s((math.atan2(1.0, 1.0) * 1000.0) as i64));
    // 双曲
    println(i2s((math.sinh(1.0) * 1000.0) as i64));
    println(i2s((math.cosh(0.0) * 1000.0) as i64));
    println(i2s((math.tanh(1.0) * 1000.0) as i64));

    // —— f32（与底层 @sinf/@cosf/... 同名）——
    // f32 结果先 `as f64` 再参与 f64 运算（t 不允许 f32 与 f64 隐式混合）。
    println(i2s(((math.fabsf(-3.5f32) as f64) * 1000.0) as i64));
    println(i2s(((math.sqrtf(2.0f32) as f64) * 1000.0) as i64));
    println(i2s(((math.cbrtf(8.0f32) as f64) * 1000.0) as i64));
    println(i2s(((math.powf(2.0f32, 10.0f32) as f64) * 1000.0) as i64));
    println(i2s(((math.hypotf(3.0f32, 4.0f32) as f64) * 1000.0) as i64));
    println(i2s(((math.sinf(1.5707963f32) as f64) * 1000.0) as i64));
    println(i2s(((math.cosf(0.0f32) as f64) * 1000.0) as i64));
    println(i2s(((math.expf(1.0f32) as f64) * 1000.0) as i64));
    println(i2s(((math.logf(2.7182817f32) as f64) * 1000.0) as i64));
    return 0;
}
