// examples/math_stdlib_demo.tc —— std.math 浮点数学封装（底层内建，双后端语义验证）
// 运行: tc run --example math_stdlib_demo
// 依赖: lib/std/math.tc（薄封装编译器底层数学内建 sin/cos/exp/log/...）
// 各值乘以 1000 取整打印，规避浮点字符串格式化差异（双后端算术一致，故逐字节可比）。
@import("std.math");

fn main_fn() i32 @main {
    // 取整 / 绝对值
    println(i2s((math.fabs_f(-3.5) * 1000.0) as i64));
    println(i2s((math.floor_f(2.7) * 1000.0) as i64));
    println(i2s((math.ceil_f(2.1) * 1000.0) as i64));
    println(i2s((math.round_f(2.5) * 1000.0) as i64));
    println(i2s((math.trunc_f(-2.9) * 1000.0) as i64));
    // 算术
    println(i2s((math.sqrt_f(2.0) * 1000.0) as i64));
    println(i2s((math.cbrt_f(8.0) * 1000.0) as i64));
    println(i2s((math.pow_f(2.0, 10.0) * 1000.0) as i64));
    println(i2s((math.pow_i(2.0, 10) * 1000.0) as i64));
    println(i2s((math.hypot_f(3.0, 4.0) * 1000.0) as i64));
    println(i2s((math.fmod_f(5.3, 2.0) * 1000.0) as i64));
    println(i2s((math.copysign_f(2.0, -1.0) * 1000.0) as i64));
    println(i2s((math.fmin_f(1.0, 2.0) * 1000.0) as i64));
    println(i2s((math.fmax_f(1.0, 2.0) * 1000.0) as i64));
    // 指数 / 对数
    println(i2s((math.exp_f(1.0) * 1000.0) as i64));
    println(i2s((math.exp2_f(3.0) * 1000.0) as i64));
    println(i2s((math.expm1_f(1.0) * 1000.0) as i64));
    println(i2s((math.log_f(2.718281828459045) * 1000.0) as i64));
    println(i2s((math.log2_f(8.0) * 1000.0) as i64));
    println(i2s((math.log10_f(100.0) * 1000.0) as i64));
    println(i2s((math.log1p_f(1.0) * 1000.0) as i64));
    // 三角 / 反三角
    println(i2s((math.sin_f(1.5707963267948966) * 1000.0) as i64));
    println(i2s((math.cos_f(0.0) * 1000.0) as i64));
    println(i2s((math.tan_f(0.7853981633974483) * 1000.0) as i64));
    println(i2s((math.asin_f(1.0) * 1000.0) as i64));
    println(i2s((math.acos_f(-1.0) * 1000.0) as i64));
    println(i2s((math.atan_f(1.0) * 1000.0) as i64));
    println(i2s((math.atan2_f(1.0, 1.0) * 1000.0) as i64));
    // 双曲
    println(i2s((math.sinh_f(1.0) * 1000.0) as i64));
    println(i2s((math.cosh_f(0.0) * 1000.0) as i64));
    println(i2s((math.tanh_f(1.0) * 1000.0) as i64));
    return 0;
}
