// O-6 opt.tagged 验证：?T 是按值布局 `{ i64 __tag, E __val }`，构造零 arena 分配。
//
// 覆盖的边界：
//   ①  标量元素 ?i64 的 some / unwrap / .? / is_some / is_none
//   ②  none 的三种来源：字面量 `null`、函数返回、?T 之间的拷贝
//   ③  **聚合元素** ?Point（payload 是 16B 结构体，须整块拷贝而非拷指针）
//   ④  函数返回 ?T、?T 作形参
//   ⑤  orelse / .? 在新的按值布局下仍成立

struct Point { x: i64; y: i64; }

fn make(v: i64) ?i64 {
    if (v > 0) { return some(v); }
    return null;
}

fn point_sum(p: ?Point) i64 {
    if (is_some(p)) {
        var q: Point = unwrap(p);
        return q.x + q.y;
    }
    return -1;
}

@main
fn main() i64 {
    // ① 标量元素
    // ⚠ `some(<整数字面量>)` 会按量级推成 ?u8（既有推断债，见 DESIGN.md §5），故先入具类型变量。
    var seven: i64 = 7;
    var a: ?i64 = some(seven);
    println(f"a.?={a.?}");
    println(f"a.is_some={is_some(a)}");
    println(f"a.is_none={is_none(a)}");

    // ② none 的三种来源
    var b: ?i64 = null;
    println(f"b.is_some={is_some(b)}");
    var c: ?i64 = b;
    println(f"c.is_none={is_none(c)}");
    println(f"make(5).?={make(5).?}");
    println(f"make(0).is_none={is_none(make(0))}");

    // ③ 聚合元素
    var pt: Point;
    pt.x = 3;
    pt.y = 4;
    var op: ?Point = some(pt);
    println(f"chained={op.?.x + op.?.y}");
    var pp: Point = op.?;
    println(f"two-step={pp.x + pp.y}");
    println(f"point_sum={point_sum(op)}");

    var np: ?Point = null;
    println(f"point_sum_none={point_sum(np)}");

    // ⑤ orelse
    var d: ?i64 = null;
    println(f"orelse={d orelse 42}");
    println(f"orelse_some={a orelse 42}");
    return 0;
}
