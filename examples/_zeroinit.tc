// 局部变量零初始化守卫：
// t 语义应保证 `var x: i64;` 初值为 0。若 LLVM 后端只发 `alloca i64` 而不
// store 0，则 x 为栈上垃圾；C 后端若发 `i64 x = 0;` 则为 0。
// 两后端返回值不一致 => LLVM 后端缺零初始化（自举期 sema 计数器因此读出脏值）。
@main
fn main() i64 {
    var x: i64;
    var y: [8]i64;
    var i: i64 = 0;
    var s: i64 = 0;
    while (i < 8) {
        s = s + y[i];
        i = i + 1;
    }
    if (x == 0) {
        if (s == 0) { return 0; }
        return 2;   // y[] 未清零
    }
    return 1;       // x 未清零
}
