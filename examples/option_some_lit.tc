// O-2（代码侧）验证：
//   ①  `some(<整数字面量>)` 不再按量级推成 ?u8 —— `var a: ?i64 = some(7);` 直接成立
//       （修法：`some` 是无 Func 签名的内建，走不到形参类型注入，故推断实参**之前**
//        按期望类型的元素类型给无位宽后缀的字面量补 sb）
//   ②  `null` 只能流进 `?T` / `*T`；落进 i64 这类定型目标是**编译错误**
//       （守卫加在 Unknown 放行之前；`null` 的静态类型保持顶层 Unknown 不变）
//   ③  既有合法通路不受影响：`var p: *i64 = null;`、`return null;`（?T 函数）

fn take(v: ?i64) i64 {
    if (is_none(v)) { return -1; }
    return unwrap(v);
}

fn produce() ?i64 {
    return null;
}

@main
fn main() i64 {
    // ① 直接 some(字面量)：目标元素类型驱动字面量位宽
    var a: ?i64 = some(7);
    println(f"a={unwrap(a)}");
    var b: ?i64 = some(7 + 8);
    println(f"b={unwrap(b)}");
    // 形参位同样注入：`take(some(3))` 的实参按 ?i64 的元素类型推断
    println(f"take={take(some(3))}");

    // ③ ?T 之间、函数返回 null 仍照旧
    var c: ?i64 = produce();
    println(f"c_is_none={is_none(c)}");
    var p: *i64 = null;
    println(f"p_is_null={p == null}");
    return 0;
}
