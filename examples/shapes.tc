// struct + variant 组合示例：形状面积计算
// 运行: tc1 run --example shapes

struct Rect {
    w: f64;
    h: f64;
}

variant Shape {
    Circle(f64);
    Box(Rect);
    Empty;
}

fn area(s: Shape) f64 {
    if (Shape_is_Circle(s)) {
        var r: f64 = Shape_as_Circle(s);
        return 3.14159265 * r * r;
    }
    if (Shape_is_Box(s)) {
        var b: Rect = Shape_as_Box(s);
        return b.w * b.h;
    }
    return 0.0;
}

fn main_fn() i32 @main {
    var shapes: []Shape;
    append(shapes, Shape { .Circle(1.0) });
    append(shapes, Shape { .Box(Rect { w: 3.0, h: 4.0 }) });
    append(shapes, Shape { .Empty });

    var total: f64 = 0.0;
    for (s in shapes) {
        total = total + area(s);
    }

    // total = pi + 12 ≈ 15.14159265
    if (total > 15.14 && total < 15.15) {
        println("total area OK (~15.1416)");
        return 0;
    }
    println("total area WRONG");
    return 1;
}
