// set-ops §13.8 R2 回归守卫：`as T` 之后的 `&` 必须是**值级集合交**，不能被类型位吃掉。
//
// 值级格族只有 `&` / `|`（§13.3；T-SET-E101：只对 bitstr / 位域成立，布尔逻辑请用 and/or），
// 所以这个歧义在今天依然存在，只是外形从布尔 `and` 换成了位域的集合交：
//
//   x as Perm & y     必须读作  (x as Perm) & y       ← 正确（集合交）
//   x as Perm & y     不得读作  x as (Perm & y)       ← 错误：y 是值不是类型
//
// 后者是 2026-10-18 真实发生过的形态（`expr as T && cond` 中的 cond 被当 concept 名解析）。
// 第二个同类位置是 `fid > T`（M52 反序列化读路径）。
// 确需在 `as` 后写合取类型时，请显式加括号 `x as (Perm & Mode)`。

packed struct Perm {
    readable: u1;
    writable: u1;
    level:    u4;
    owner_id: u8;
}

fn show(tag: string, p: Perm) void {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, tag);
    sb_append_str(sb, " r="); sb_append_u64(sb, p.readable as u64);
    sb_append_str(sb, " w="); sb_append_u64(sb, p.writable as u64);
    sb_append_str(sb, " lv="); sb_append_u64(sb, p.level as u64);
    sb_append_str(sb, " own="); sb_append_u64(sb, p.owner_id as u64);
    println(sb_to_str(sb));
}

@main
fn main() i64 {
    var a: Perm = Perm{ .readable = 1, .writable = 1, .level = 5, .owner_id = 9 };
    var b: Perm = Perm{ .readable = 1, .writable = 0, .level = 2, .owner_id = 9 };

    // 关键行：`as Perm` 之后的 `&` 必须交回表达式层，读成 (a as Perm) & b。
    var c: Perm = a as Perm & b;
    show("and", c);

    var d: Perm = a as Perm | b;
    show("or", d);

    return 0;
}
