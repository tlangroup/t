// 解构绑定（destructuring binding）：struct / 具名元组字面量模式中的 ident 字段
// 不是比较条件，而是把该字段绑定到局部变量，供臂体使用。
// 覆盖：全字面（KI-002 路径）、字面+绑定混合、全绑定（纯绑定臂 = 任意该结构值）、多臂 + `_` 兜底。
// 设计文档：docs/syntax/drafts/tuple.md §8.2 / §14.2。

struct Pt { x: i64; y: i64; }
struct Pair { a: i64; b: i64; }

// 命中点：① Pt{x:0,y:0} 全字面；② Pt{x:a,y:0} 绑 x 比 y；③ Pt{x:0,y:b} 比 x 绑 y；
//        ④ Pt{x:a,y:b} 全绑定（纯绑定臂，匹配任意 Pt）；`_ => 0` 兜底满足穷尽性。
fn f_origin(p: Pt) i64 {
    return match (p) {
        Pt{ x: 0, y: 0 } => 1,
        Pt{ x: a, y: 0 } => a,
        Pt{ x: 0, y: b } => b,
        Pt{ x: a, y: b } => a + b,
        _ => 0,
    };
}

// 具名元组（带命名字段的结构）解构绑定。
fn f_pair(p: Pair) i64 {
    return match (p) {
        Pair{ a: 0, b: 0 } => 100,
        Pair{ a: m, b: n } => m + n,
        _ => 0,
    };
}

@main fn main() i32 {
    var p1: Pt = Pt{ x: 0, y: 0 };
    var p2: Pt = Pt{ x: 7, y: 0 };
    var p3: Pt = Pt{ x: 0, y: 9 };
    var p4: Pt = Pt{ x: 3, y: 4 };
    println(int_to_str(f_origin(p1)));
    println(int_to_str(f_origin(p2)));
    println(int_to_str(f_origin(p3)));
    println(int_to_str(f_origin(p4)));

    var q1: Pair = Pair{ a: 0, b: 0 };
    var q2: Pair = Pair{ a: 30, b: 40 };
    println(int_to_str(f_pair(q1)));
    println(int_to_str(f_pair(q2)));
    return 0;
}
