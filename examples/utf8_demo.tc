// examples/utf8_demo.tc —— std.utf8 用法演示（双后端语义验证）
// 运行: tc run --example utf8_demo
// 依赖: lib/std/utf8.tc（源码内联导入）
@import("std.utf8");

fn main_fn() i32 @main {
    // 1) ASCII：字节数 == 码点数
    println(i2s(utf8.rune_count("hello")));                 // 5
    // 2) 中文：2 码点 / 6 字节
    println(i2s(utf8.rune_count("你好")));                  // 2
    // 3) 混合 ASCII + 中文：H i 你 G o = 5 码点 / 7 字节
    var s: string = "Hi你Go";
    println(i2s(utf8.rune_count(s)));                       // 5
    // 4) 解码为码点序列（逐码点十进制）
    var cps: []i64 = utf8.utf8_decode(s);
    println(i2s(cps[0]));                                   // 72    (H)
    println(i2s(cps[1]));                                   // 105   (i)
    println(i2s(cps[2]));                                   // 20320 (你 = U+4F60)
    println(i2s(cps[3]));                                   // 71    (G)
    println(i2s(cps[4]));                                   // 111   (o)
    // 5) 重新编码回字符串（round-trip，须与原文逐字节一致）
    var back: string = utf8.utf8_encode(cps);
    println(back);                                          // Hi你Go
    // 6) 4 字节码点（😀 = U+1F600 = 128512）仅经 encode 构造，验证 4 字节路径
    var emo: []i64;
    append(emo, 128512);
    var e: string = utf8.utf8_encode(emo);
    println(i2s(utf8.rune_count(e)));                       // 1
    var ed: []i64 = utf8.utf8_decode(e);
    println(i2s(ed[0]));                                    // 128512
    println(e);                                             // 😀
    return 0;
}
