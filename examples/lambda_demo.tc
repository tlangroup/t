// 匿名函数字面量（FuncType v2a）
// 表达式位置的 `fn (params) -> Ret { ... }` 是函数字面量：编译期被提升为顶层
// 合成函数，其值即该函数的指针，可存变量 / 传参 / 作返回值 / 存全局。
// 本例只演示**不捕获**外层局部的字面量（零开销路径：值就是函数地址）。
// 引用外层局部会触发按值捕获，见 examples/closure_demo.tc。

// 函数类型作为参数：高阶函数
apply2 fn(f: fn(i64, i64) -> i64, a: i64, b: i64) -> i64 {
    return f(a, b);
}

// 返回函数字面量：返回值类型就是函数类型
make_doubler fn() -> fn(i64) -> i64 {
    return fn (x: i64) -> i64 { return x * 2; };
}

// 全局函数类型变量也能直接绑定字面量
var g_join: fn(i64, i64) -> i64 = fn (a: i64, b: i64) -> i64 { return a * 100 + b; };

@main
main fn() -> i64 {
    // 1. 局部绑定（显式类型标注）
    var add: fn(i64, i64) -> i64 = fn (a: i64, b: i64) -> i64 { return a + b; };
    var b1: StringBuilder = sb_new();
    sb_append_str(b1, "add(3,4) = ");
    sb_append_i64(b1, add(3, 4));
    println(sb_to_str(b1));

    // 2. 重新绑定为另一个字面量
    add = fn (a: i64, b: i64) -> i64 { return a - b; };
    var b2: StringBuilder = sb_new();
    sb_append_str(b2, "rebound(10,4) = ");
    sb_append_i64(b2, add(10, 4));
    println(sb_to_str(b2));

    // 3. 字面量直接作实参
    var b3: StringBuilder = sb_new();
    sb_append_str(b3, "apply2(mul,6,7) = ");
    sb_append_i64(b3, apply2(fn (a: i64, b: i64) -> i64 { return a * b; }, 6, 7));
    println(sb_to_str(b3));

    // 4. 字面量作返回值
    var dbl: fn(i64) -> i64 = make_doubler();
    var b4: StringBuilder = sb_new();
    sb_append_str(b4, "make_doubler()(21) = ");
    sb_append_i64(b4, dbl(21));
    println(sb_to_str(b4));

    // 5. 全局函数类型变量
    var b5: StringBuilder = sb_new();
    sb_append_str(b5, "g_join(3,14) = ");
    sb_append_i64(b5, g_join(3, 14));
    println(sb_to_str(b5));

    // 6. 字面量体内可自由调用内建与顶层函数
    var shout: fn(string) -> string = fn (s: string) -> string {
        var sb: StringBuilder = sb_new();
        sb_append_str(sb, "<");
        sb_append_str(sb, s);
        sb_append_str(sb, ">");
        return sb_to_str(sb);
    };
    println(shout("hello"));

    return 0;
}
