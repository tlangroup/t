// #pb 修饰关键词验证：protobuf message 结构体 + @N tag id 经 type_info 暴露。
// 两种等价写法 `#pb struct` 与 `@pb struct` 都应被编译器接受，且字段 `@N` 作为线格式字段号
// （wire field number）经 FieldInfo.tag 暴露给 thyme 反射消费。
//
// 注：本例字段统一用 i64，以与 pb3 标量语义（varint/64 位）对齐，同时规避一个
// 既存的 LLVM 反射 bug（struct 含 f64 字段时 type_info 的 %FieldInfo 常量发射在 LLVM 后端
// 报 "expected type"；C 后端正常，且 i64 字段双后端均正常）。该 bug 与 #pb 无关，单独立项跟踪。

#pb struct Point {
    x: i64 @ 1;
    y: i64 @ 2 = 42;
    z: i64 @ 3;
}

@pb struct Vec3 {
    a: i64 @ 1;
    b: i64 @ 2;
    c: i64 @ 3;
}

@main
fn main() i64 {
    // ---- #pb 形式 ----
    var tp: TypeInfo = type_info(Point);
    var mp: *TypeMeta = match (tp) { .Struct(mt) => mt, _ => null };
    println(int_to_str(mp.field_count));      // 3
    var i: i64 = 0;
    while (i < mp.field_count) {
        var f: FieldInfo = mp.fields[i];
        println(int_to_str(f.tag));            // 1, 2, 3
        i = i + 1;
    }
    // ---- @pb 形式（与 #pb 同义）----
    var tv: TypeInfo = type_info(Vec3);
    var mv: *TypeMeta = match (tv) { .Struct(mt) => mt, _ => null };
    println(int_to_str(mv.field_count));       // 3
    i = 0;
    while (i < mv.field_count) {
        var f: FieldInfo = mv.fields[i];
        println(int_to_str(f.tag));            // 1, 2, 3
        i = i + 1;
    }
    return 0;
}
