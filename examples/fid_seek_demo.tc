// fseek / ftell：定位与随机访问演示
//
//   fseek fn(f: fid, off: i64) -> bool  —— 绝对定位到 off（自文件头起算）
//   ftell fn(f: fid) -> i64             —— 返回当前偏移
//
// 两者都**不 panic**（L-09 零 UB）：无效句柄 / 已关闭 / 负偏移 / 不可定位的流，
// 一律返回失败值（false / -1）并把原因写进句柄，供 fid_error 显式取。
// 这与 fopen 失败返 -1、靠 fid_is_open 探测是同一套「显式错误」风格（L-02）。

pr fn(label: string, v: i64) -> void {
    var b: StringBuilder = sb_new();
    sb_append_str(b, label);
    sb_append_i64(b, v);
    println(sb_to_str(b));
}

yn fn(label: string, ok: bool) -> void {
    var b: StringBuilder = sb_new();
    sb_append_str(b, label);
    if (ok) { sb_append_str(b, "yes"); } else { sb_append_str(b, "no"); }
    println(sb_to_str(b));
}

@main
main fn() -> i64 {
    // ── 1. 写入过程中的偏移推进 ─────────────────────────────────
    println("-- 1. tell while writing --");
    var f: fid = fopen("out/_fid_seek_demo.txt", :write);
    pr("start offset  = ", ftell(f));
    f < "abcdef";
    pr("after 6 bytes = ", ftell(f));

    // ── 2. 回退覆盖写：定位到 0 再写一个字节 ────────────────────
    println("-- 2. seek back and overwrite --");
    yn("seek(0) ok?     ", fseek(f, 0));
    pr("offset now    = ", ftell(f));
    f < "Z";
    pr("after write   = ", ftell(f));
    fclose(f);
    print(file_read_all("out/_fid_seek_demo.txt"));
    println("");

    // ── 3. 失败路径都不 panic ───────────────────────────────────
    println("-- 3. failure paths --");
    // 已关闭句柄
    yn("closed seek?    ", fseek(f, 0));
    pr("closed tell   = ", ftell(f));
    yn("closed reason?  ", (str_len(fid_error(f)) as i64) > 0);

    // 负偏移
    var g: fid = fopen("out/_fid_seek_demo2.txt", :write);
    yn("neg seek?       ", fseek(g, 0 - 1));
    yn("neg reason?     ", (str_len(fid_error(g)) as i64) > 0);
    fclose(g);

    return 0;
}
