// 回归：全局 var 的初始化式必须在 t.__ginit 中落盘（LLVM 路径）。
//
// 事故回放：tir.tc 的 tir_emit_ginit 标量分支只覆盖了 int / float / array_lit / Sym-字符串，
// 漏了 bool 与（非 Sym）string → 这类全局只剩 `@g = global ... zeroinitializer`，
// 运行期恒为 false / 空串。编译器自身正好有 `pub var g_comptime_full: bool = true;`：
// LLVM 自托管下被读成 false → comptime_fold_pass 开头直接 return → 全量编译期折叠整段失效
// （`return -1;` 发成 `const 1` + `neg` 而非 `const -1`）→ 两代 emit-ll 对不上、无自举不动点。
pub var gv: i64 = 42;
pub var gs: string = "hello";
pub var gb: bool = true;
pub var gn: i64 = -7;

@main
fn main() i64 {
    var ok: i64 = 0;
    if (gv == 42) { ok = ok + 1; }
    if (gs == "hello") { ok = ok + 1; }
    if (gb) { ok = ok + 1; }
    if (gn == -7) { ok = ok + 1; }
    println("gv=" + int_to_str(gv) + " gs=" + gs + " gn=" + int_to_str(gn) + " ok=" + int_to_str(ok));
    if (ok == 4) { return 0; }
    return 1;
}
