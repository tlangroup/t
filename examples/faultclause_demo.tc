// faultclause_demo.tc — 故障子句 `@clause(.fault, ...)` / `@clause(.repair, ...)`
// （fault 批次 B3 / docs/syntax/drafts/fault.md 附录 B）
//
// 本批的语义是「编译期登记」：clause 只活在编译期（F-1），**不进 IR、不参与运行期**。
// ⇒ 运行期判据是**零副作用**：声明了故障/修复子句的程序照常运行，输出与普通程序一致。
//
// 覆盖：① `.fault` 谓词（关系 `<` / 等值 `=` / 多字段合取）
//       ② `.repair` 修法名（`.名` 前导点形态）
//       ③ `++` 合并成组（B4 的 `Err(...)` 即此形态）
//       ④ 与既有 `.pattern` 共存时互不影响（`.pattern` 照旧展开为 match 臂）
//
// ⚠ 组声明（`fault E over T { ... }`）与槽位索引属 B1，本例不覆盖 ——
//   故 `UserErr.AgeNegative` 这类全名在此**不解析**（clause 子树一概不求值）。
//
// 预期输出见 examples/faultclause_demo.expected.txt。

struct User {
    age:  i64;
    name: string;
}

// ① 故障子句：谓词 + 全名
const F_AGE  = @clause(.fault, .{ .age < 0 }, UserErr.AgeNegative);
const F_NAME = @clause(.fault, .{ .name = "" }, UserErr.NameEmpty);
const F_BOTH = @clause(.fault, .{ .age > 120, .name = "" }, UserErr.Unreal);

// ② 修复子句：修法名 + 闭包
const R_DEFAULT = @clause(.repair, .use_default, fn () i64 { return 18; });
const R_CLAMP   = @clause(.repair, .clamp, fn () i64 { return 0; });

// ③ `++` 合并：故障子句 + 修复子句同组
const ERR_AGE = F_AGE ++ R_DEFAULT ++ R_CLAMP;

// ④ 与既有 `.pattern` 共存：故障子句不影响 `.pattern` 的臂展开
const C0 = @clause(.pattern, 0, 10);
const C1 = @clause(.pattern, 1, 11);
const P  = C0 ++ C1 ++ @clause(.pattern, _, 0 - 1);

fn pick(x: i64) i64 {
    return match (x) { P };
}

@main
fn main() i32 {
    println(int_to_str(pick(0)));
    println(int_to_str(pick(1)));
    println(int_to_str(pick(9)));
    println(int_to_str(3));
    return 0;
}
