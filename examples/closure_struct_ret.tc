// 返回结构体的闭包（tmir-c 曾**整份编译失败** —— fault B4 的前置缺口 G-1）
//
// 现象：闭包函数 `__lam_N` 在 C 后端按 sret 约定发射
//         static void __lam_N(unsigned char* __sret, ...)
//       但 env 适配 thunk 里却直接写 `return __lam_N(...)`
//         ⇒ clang: too few arguments to function call, '__sret' was not specified
// 修复：thunk 自己分配聚合缓冲 → 以 __sret 首参转发 → 把指针交还调用点
//       （统一 TClosure ABI 是 code(env, args…) → 聚合缓冲指针）
struct Pt {
    x: i64;
    y: i64;
}

@main
fn main() i64 {
    // ① 不捕获的闭包（无 env 首参）
    var f = fn () Pt {
        return Pt { .x = 11, .y = 22 };
    };
    var p: Pt = f();
    println(int_to_str(p.x));
    println(int_to_str(p.y));

    // ② 捕获外层变量的闭包（有 env 首参 ⇒ __sret 与 __env 都在前面）
    var k: i64 = 5;
    var g = fn () Pt {
        return Pt { .x = k, .y = k * 2 };
    };
    var q: Pt = g();
    println(int_to_str(q.x));
    println(int_to_str(q.y));
    return 0;
}
