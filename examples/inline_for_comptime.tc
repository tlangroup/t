// 阶段1 S4（Q1）：comptime `inline for` —— 编译期展开数组，完全不产生运行期循环。
// iterable 必须是编译期已知数组（值数组或类型数组）；对每个元素克隆体块、把元素绑定到
// 给定名字、可选地把下标绑定到第二个名字，在编译期执行体。
@main fn main() i32 {
    // 1) 值数组：编译期把每个元素 log 出来（展开发生在编译期，运行期无循环）
    comptime {
        inline for ([1, 2, 3]) |e, i| {
            @compile_log("elem=", e, " idx=", i);
        }
    }
    // 2) 类型数组：编译期对每个类型做判别（这是 Q1 落地 TypeInfo 的核心用途）
    comptime {
        inline for ([i64, u32, bool]) |T| {
            if (T == i64) { @compile_log("got i64"); }
            if (T == u32) { @compile_log("got u32"); }
            if (T == bool) { @compile_log("got bool"); }
        }
    }
    return 0;
}
