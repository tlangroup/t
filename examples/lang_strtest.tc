const lang = @import("std.lang");
@main fn main() i64 {
    var s2: string = str_slice("x_pb_y", 2, 4);
    println("str_eq(s2,pb)=" + i2s(str_eq(s2, "pb") as i64));
    println("s2==pb=" + i2s(str_eq(s2, "pb") as i64));
    var toks: []lang.Token = lang.tokenize("#pb struct X { }");
    var i: i64 = 0;
    while (i < slice_len(toks) as i64) {
        println(i2s(i) + ": kind=" + toks[i].kind + " src='" + toks[i].src + "'");
        i = i + 1;
    }
    return 0;
}
