// R-018 聚焦示例：comptime fn 求值结果经 comptime const 落到运行期常量。
//
// 隔离验证 R-018（不依赖 pb / 反射）：编译期算出的数，运行期以常量形态可用。
// R-018 落地前，comptime const 承载 comptime fn 结果时运行期读为 0（能算但落不下去），
// 本例是该缺口的见证。双后端输出一致，见 .expected.txt。

comptime fn square(n: i64) i64 {
    return n * n;
}

comptime fn sum_to(n: i64) i64 {
    var acc: i64 = 0;
    var i: i64 = 1;
    while (i <= n) {
        acc = acc + i;
        i = i + 1;
    }
    return acc;
}

// R-018：comptime fn 无运行期函数体，结果须经 comptime const 承载才能落运行期。
comptime const SQ12: i64 = square(12);   // 144
comptime const SUM10: i64 = sum_to(10); // 55

@main
fn main() i64 {
    println("sq12=" + int_to_str(SQ12));
    println("sum10=" + int_to_str(SUM10));
    return 0;
}
