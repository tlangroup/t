// map_iter.tc — map 字面量与 for-in 迭代（M30）
// 覆盖：`var m: map[K]V = [k: v, ...]` 字面量初始化、无初始化声明即空表、
// for-in 按插入序迭代键、迭代中 m[k] 取值、删除后迭代、空表迭代零次。
// 期望输出见 examples/map_iter.expected.txt。

b2i fn(b: bool) i64 {
    if (b) {
        return 1;
    }
    return 0;
}

emit fn(sb: StringBuilder, k: string, v: i64) void {
    sb_append_str(sb, k);
    sb_append_str(sb, "=");
    sb_append_str(sb, int_to_str(v));
    sb_append_char(sb, 10);
}

@main
main fn() i64 {
    var sb: StringBuilder = sb_new();

    // ── 字面量初始化（string 键）──
    var m: map[string]i64 = ["alice": 1, "bob": 2, "carol": 3];
    emit(sb, "lit_len", map_len(m));
    emit(sb, "lit_get_bob", map_get(m, "bob"));

    // for-in 迭代键，按插入序；迭代体内用 m[k] 取值
    for (k in m) {
        sb_append_str(sb, "iter ");
        sb_append_str(sb, k);
        sb_append_str(sb, "=");
        sb_append_str(sb, int_to_str(m[k]));
        sb_append_char(sb, 10);
    }

    // 删除中间一项后重新迭代：插入序保持，bob 不再出现
    var kb: string = "bob";
    map_del(m, kb);
    var seen: i64 = 0;
    for (k2 in m) {
        seen = seen + 1;
        sb_append_str(sb, "after_del ");
        sb_append_str(sb, k2);
        sb_append_char(sb, 10);
    }
    emit(sb, "after_del_count", seen);

    // 新插入的键追加到迭代序末尾
    var kd: string = "dave";
    var vd: i64 = 4;
    map_set(m, kd, vd);
    for (k3 in m) {
        sb_append_str(sb, "readd ");
        sb_append_str(sb, k3);
        sb_append_char(sb, 10);
    }

    // ── 字面量初始化（i64 键）──
    var p: map[i64]i64 = [10: 100, 20: 200, 30: 300];
    emit(sb, "int_lit_len", map_len(p));
    var ksum: i64 = 0;
    var vsum: i64 = 0;
    for (pk in p) {
        ksum = ksum + pk;
        vsum = vsum + p[pk];
    }
    emit(sb, "int_key_sum", ksum);
    emit(sb, "int_val_sum", vsum);

    // ── 无初始化声明即空表，可直接 set ──
    var e: map[string]i64;
    emit(sb, "empty_len", map_len(e));
    var ek: string = "x";
    var ev: i64 = 42;
    map_set(e, ek, ev);
    emit(sb, "empty_after_set", map_len(e));
    emit(sb, "empty_get_x", map_get(e, ek));

    // 空表迭代零次
    var z: map[i64]i64;
    var zc: i64 = 0;
    for (zk in z) {
        zc = zc + 1;
    }
    emit(sb, "empty_iter_count", zc);

    // ── 字面量：i64 键 / string 值 ──
    var q: map[i64]string = [1: "one", 2: "two"];
    for (qk in q) {
        sb_append_str(sb, "q ");
        sb_append_str(sb, int_to_str(qk));
        sb_append_str(sb, ":");
        sb_append_str(sb, q[qk]);
        sb_append_char(sb, 10);
    }

    // ── 窄整型键：键在运行时统一按 i64 存储，i32/u8 也能正确命中 ──
    var w: map[i32]i64;
    var wk: i32 = 7;
    var wv: i64 = 700;
    map_set(w, wk, wv);
    map_set(w, 8, 800);                  // 键与值都可以直接写字面量
    emit(sb, "i32_len", map_len(w));
    emit(sb, "i32_get7", map_get(w, wk));
    emit(sb, "i32_get8", map_get(w, 8));
    var wsum: i64 = 0;
    for (wkk in w) {
        wsum = wsum + (wkk as i64);
    }
    emit(sb, "i32_key_sum", wsum);

    // ── 键/值写字面量（string 键）──
    var s2: map[string]i64;
    map_set(s2, "k1", 11);
    map_set(s2, "k2", 22);
    emit(sb, "lit_arg_get", map_get(s2, "k1"));
    emit(sb, "lit_arg_idx", s2["k2"]);
    emit(sb, "lit_arg_has", b2i(map_has(s2, "nope")));
    emit(sb, "lit_arg_del", b2i(map_del(s2, "k1")));
    emit(sb, "lit_arg_len", map_len(s2));

    print(sb_to_str(sb));
    return 0;
}
