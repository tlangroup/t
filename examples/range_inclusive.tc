// 闭合区间 `..=` 的运行期语义守卫。
//
// 背景（2026-10-26 修复）：`..=` 的「上界 +1」由 sema 的 rng_excl_hi 合成 `hi + 1`，
// 而 comptime_fold_pass 跑在 run_check **之后**，会折叠 sema 期合成的节点；合成出的
// `1` 未经 infer ⇒ 折叠时右操作数被当 0，`8 + 1` 折成 8。表现为**端点全是字面量时
// `..=` 退化为 `..`**（少一个元素），而端点含变量时反而正确 —— conformance 只做
// `tc check` 不运行程序，故该 bug 长期零覆盖。
//
// 本例锁定：字面量与变量端点、索引 / 物化 / for / in 四条降解路径的闭合语义一致。
@main fn main() i32 {
    var msg: string = "hello world";
    var lo: i64 = 6;
    var hi: i64 = 8;

    // 索引：字面量闭合 [6..=8] → "wor" = 3
    println(int_to_str((str_len(msg[6..=8]) as i64)));
    // 索引：变量闭合 [lo..=hi] → 3
    println(int_to_str((str_len(msg[lo..=hi]) as i64)));
    // 索引：半开对照 [6..9] → 3
    println(int_to_str((str_len(msg[6..9]) as i64)));

    var xs: []i64 = [];
    var i: i64 = 0;
    while (i < 6) { append(xs, i); i = i + 1; }
    // 切片：闭合 [2..=4] → 3 个元素
    println(int_to_str((slice_len(xs[2..=4]) as i64)));

    // 物化：闭合 1..=4 → 4 个元素
    var ys: []i64 = 1..=4;
    println(int_to_str((slice_len(ys) as i64)));

    // for：闭合 0..=3 → 4 次
    var n: i64 = 0;
    for (k in 0..=3) { n = n + 1; }
    println(int_to_str(n));

    // in：闭合 5 in 5..=5 → 1
    var c: i64 = 0;
    if (5 in 5..=5) { c = 1; }
    println(int_to_str(c));
    return 0;
}
