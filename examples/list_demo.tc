// list_demo.tc —— 演示 examples/lib/list.tc 的切片列表 List
import(list);

main fn() i32 @main {
    var l: list.List = list.list_new();
    l = list.list_push(l, 10);
    l = list.list_push(l, 20);
    l = list.list_push(l, 30);
    println("len = {0}".format(list.list_len(l)));
    println("get(1) = {0}".format(list.list_get(l, 1)));

    l = list.list_insert(l, 1, 15);
    println("after insert len = {0}".format(list.list_len(l)));
    println("get(1) = {0}".format(list.list_get(l, 1)));

    l = list.list_remove(l, 0);
    println("after remove len = {0}".format(list.list_len(l)));

    l = list.list_pop(l);
    println("after pop len = {0}".format(list.list_len(l)));

    println("contains 20 = {0}".format(list.list_contains(l, 20)));
    println("contains 99 = {0}".format(list.list_contains(l, 99)));
    println("is_empty = {0}".format(list.list_is_empty(l)));

    l = list.list_clear(l);
    println("after clear is_empty = {0}".format(list.list_is_empty(l)));
    return 0;
}
