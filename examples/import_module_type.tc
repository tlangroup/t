// (A) 验证：@import("M") 返回一等模块类型（Zig 忠实版）。
//  - comptime 经 @type_info 反射，match .Module(m) 取出 TypeMeta（m.name = 模块别名）
//  - 成员访问 base.foo 仍走 <key>__<field> 改写（运行期回归）
// 说明：模块类型是纯编译期类型（无运行期对象），反射须在 comptime 上下文进行，
//       与 Zig 的 @import 模型一致；运行期 type_info(模块类型) 不适用。
const base = @import("src.base");

@main fn main() i32 {
    comptime {
        match (@type_info(base)) {
            .Module(m) => { @compile_log("MODULE name=" + m.name); }
            _ => { @compile_log("MODULE not a module"); }
        };
    }
    var n: u64 = base.cst_nref_of(7);
    println("member access ok");
    return 0;
}
