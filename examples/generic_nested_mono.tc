// generic_nested_mono.tc —— 泛型函数**体内**的嵌套泛型调用必须递归单态化
// （gap-scan P0-2：链接期 `undefined @t.xxx` 的根因形态；std 此前靠内联规避）
//
// 覆盖三种嵌套形态：
//   ① 三层链式：g1<T> → g2<T> → g3<T>（每层都在上一层实例体内展开）
//   ② 容器类型参数：outer_len<[]T> 体内调 lenof<[]T>
//   ③ 体内调**固定**实例：use_fixed<T> 体内同时调 fixed<i64>（与 T 无关）与 fixed<T>
// 失败形态：实例体生成后体内的泛型调用点未再走单态化 ⇒ 链接期 undefined symbol。

fn g3(comptime T: type, x: T) T { return x; }
fn g2(comptime T: type, x: T) T { return g3(T, x); }
fn g1(comptime T: type, x: T) T { return g2(T, x); }

fn lenof(comptime T: type, s: []T) i64 { return slice_len(s) as i64; }
fn outer_len(comptime T: type, s: []T) i64 { return lenof(T, s); }

fn fixed(comptime T: type, x: T) i64 { return 7; }
fn use_fixed(comptime T: type, x: T) i64 { return fixed(i64, 1i64) + fixed(T, x); }

@main
fn main() i64 {
    println(int_to_str(g1(i64, 42)));          // 42
    var arr: [3]i64 = [1, 2, 3];
    var sl: []i64 = arr[0..3];
    println(int_to_str(outer_len(i64, sl)));   // 3
    println(int_to_str(use_fixed(i64, 5)));    // 7 + 7 = 14
    return 0;
}
