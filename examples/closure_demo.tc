// 闭包按值捕获（FuncType v2 Stage B）
// 匿名函数字面量若引用了外层作用域的局部/参数，编译期会：
//   ① 合成一个环境结构 `__env_N`，把被捕获的变量**按值**拷进去；
//   ② 把字面量提升为顶层函数，并前置一个 env 首参；
//   ③ 原表达式位置改为「堆分配环境 + TClosure，返回其指针」。
// 因为是按值捕获，闭包创建之后外层变量再改变，不会影响闭包里看到的值。
// 不引用外层局部的字面量仍走无捕获路径（零开销，直接取函数地址）。

fn pr(label: string, v: i64) void {
    var b: StringBuilder = sb_new();
    sb_append_str(b, label);
    sb_append_i64(b, v);
    println(sb_to_str(b));
}

// 闭包工厂：捕获形参 base
fn make_adder(base: i64) fn(i64) i64 {
    return fn (x: i64) i64 { return x + base; };
}

// 高阶函数：接收闭包
fn apply1(f: fn(i64) i64, v: i64) i64 {
    return f(v);
}

@main
fn main() i64 {
    // 1. 捕获形参：同一个字面量产生互不干扰的两个闭包
    var add10: fn(i64) i64 = make_adder(10);
    var add100: fn(i64) i64 = make_adder(100);
    pr("add10(5) = ", add10(5));
    pr("add100(5) = ", add100(5));

    // 2. 捕获多个外层局部
    var a: i64 = 3;
    var b: i64 = 4;
    var sum3: fn(i64) i64 = fn (x: i64) i64 { return x + a + b; };
    pr("sum3(1) = ", sum3(1));

    // 3. 按值语义：捕获后外层改动不回灌到闭包
    a = 99;
    pr("sum3(1) after a=99 = ", sum3(1));

    // 4. 无捕获字面量仍走原路径
    var dbl: fn(i64) i64 = fn (x: i64) i64 { return x * 2; };
    pr("dbl(21) = ", dbl(21));

    // 5. 闭包作为高阶函数实参
    pr("apply1(add10, 7) = ", apply1(add10, 7));
    pr("apply1(sum3, 7) = ", apply1(sum3, 7));

    // 6. 捕获 string
    var who: string = "world";
    var greet: fn() string = fn () string { return who; };
    var gb: StringBuilder = sb_new();
    sb_append_str(gb, "hello, ");
    sb_append_str(gb, greet());
    println(sb_to_str(gb));

    // 7. 循环里逐轮建闭包，各自捕获当轮的值
    var i: i64 = 0;
    var last: fn(i64) i64 = dbl;
    while (i < 3) {
        var step: i64 = i * 10;
        var f: fn(i64) i64 = fn (x: i64) i64 { return x + step; };
        pr("loop f(1) = ", f(1));
        last = f;
        i = i + 1;
    }
    pr("last(1) = ", last(1));

    // 8. 嵌套：外层闭包捕获形参，内层闭包再捕获外层闭包的形参
    var mk: fn(i64) fn(i64) i64 = make_adder;
    var add7: fn(i64) i64 = mk(7);
    pr("add7(1) = ", add7(1));
    return 0;
}
