// struct-modifiers · overload struct 跨文件扩展 · 文件 A（Task #6 搬运自
// docs/design/struct-modifiers/EXAMPLES_extend_a.tc）
//
// 配对编译（跨文件同编译单元合并）：
//   tc run examples/struct_extend_a.tc examples/cross/struct_extend_b.tc
// 期望输出：
//   entity base id=1
//   entity#7 tag=99
//
// 注：struct_extend_b.tc 是 extend 片段（依赖本文件的 Entity 组），单独编译会报
// T-OVL-E980；故置于 examples/cross/ 子目录，避免被 ir_snapshot / run_examples 的
// 单文件扫描误当作独立目标（与 examples/cross/overload_cross_b.tc 同例）。

// overload struct：标记 Entity 为「开放可扩展组」。
//   extend 追加的字段/方法排在字段链尾部（合并期 list_last + list_link）。
//   注：早期此处写尾部 `_;` 作「扩展锚点」，该写法从不生效（不生成任何 AST 节点），
//      已于 2026-10-18 拆除；开放性完全由 `overload` 关键字表达。
overload struct Entity {
    id:  u64;
    pos: i64;
}

fn spawn() Entity {
    return Entity { id: 1, pos: 2 };
}

@main
fn main() i32 {
    var e: Entity = spawn();
    println("entity base id=" + int_to_str(e.id as i64));
    return 0;
}
