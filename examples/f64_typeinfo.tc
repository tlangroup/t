// 回归测试：f64 字段结构体的 type_info 反射在 LLVM 后端必须可用。
// 修复前：LLVM 发射的 @__ti_<T>_f 常量里 size 字段写成 `getelementptr ([1 x f64], ...)`
// （f64 非合法 LLVM 类型名，应为 double）→ clang "expected type"，整个程序链接失败。
// C 后端一直正常。本测试确保双后端对该结构体的反射输出逐字节一致。
struct Vec3 {
    x: f64 @ 1;
    y: f64 @ 2;
    z: f64 @ 3;
}

@main
fn main() i64 {
    var tp: TypeInfo = type_info(Vec3);
    var mp: *TypeMeta = match (tp) { .Struct(mt) => mt, _ => null };
    println(int_to_str(mp.field_count));
    var i: i64 = 0;
    while (i < mp.field_count) {
        println(int_to_str(mp.fields[i].tag));
        i = i + 1;
    }
    return 0;
}
