// hello.tc —— 模块源码（模块名为 hello）
//
// 用 `export` 标记的符号跨模块可见；未标记的（如 helper）为模块内私有，
// 但由于当前采用 whole-program 内联策略，私有符号在链接期仍共享同一命名空间，
// 真正的私有隔离留待后续 mangling 里程碑。

// 导出的加法：内部调用同模块的私有 helper
pub fn add(a: i64, b: i64) i64 {
    return a + b + helper();
}

// 导出的问候：用 StringBuilder 拼出 "hello, <name>"
pub fn greet(name: string) string {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "hello, ");
    sb_append_str(sb, name);
    return sb_to_str(sb);
}

// 模块内私有辅助函数（未 export）
fn helper() i64 {
    return 1;
}
