// main.tc —— 程序入口（模块名为隐式的入口模块）
//
// 通过 `import hello` 引入同目录下的 hello.tc，并以命名空间形式
// `hello.add` / `hello.greet` 访问其导出符号。

import hello;

main fn() -> i32 @main {
    println("hello from main");
    var sum: i64 = hello.add(2, 3);
    println(i2s(sum));
    var msg: string = hello.greet("world");
    println(msg);
    return 0;
}
