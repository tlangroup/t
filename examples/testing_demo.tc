// examples/testing_demo.tc —— std.testing 测试框架用法演示
//
// 运行：tc test examples/testing_demo.tc
//   （语言内置 test 声明 + 运行器，断言来自 std.testing 模块）
//
// 也可脱离 tc test 当普通自检程序跑：tc run examples/testing_demo.tc

@import("std.testing");

"整数运算" test {
    testing.assert_eq_i(1 + 1, 2, "1+1 = 2");
    testing.assert_true(2 < 3, "2 < 3");
    testing.assert_false(2 > 3, "2 > 3 为假");
    testing.assert_ne(i64, 3, 4, "3 != 4");
}

"字符串" test {
    testing.assert_eq_s("hello", "hello", "字符串相等");
    testing.assert_true(str_len("abc") == 3, "长度应等于 3");
}

"可选类型" test {
    var none_val: ?i64 = ?;
    testing.assert_nil(i64, none_val, "空可选");
    var some_val: ?i64 = some(42 as i64);
    testing.assert_not_nil(i64, some_val, "非空可选");
    testing.assert_eq_i(unwrap(some_val), 42, "解包应得 42");
}

"浮点近似" test {
    testing.assert_approx_eq(3.14159, 3.1416, 1e-3, "π 近似");
    testing.assert_approx_eq_f32(1.0f32, 1.001f32, 0.01f32, "f32 近似");
}

"软断言汇总" test {
    // 软断言记录失败但不退出；末尾统一转交 tc test 的 FAILED 判定
    testing.reset();
    testing.expect_eq_i(10, 10, "相等");
    testing.expect_true(1 < 2, "真");
    if (testing.failed()) { return false; }
    return true;
}
