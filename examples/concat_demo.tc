// `++` 集合合并符推广验证（§15.6）：String 与 Slice 合并，与数值 `+` 解耦。
// 已补 `concat_demo.expected.txt`，纳入 gate 双后端（C + LLVM）对拍。

@main
fn main() i64 {
    // ── String ++ String ──
    var s1: string = "Hello, ";
    var s2: string = "World!";
    var s3: string = s1 ++ s2;
    println(s3);

    // ── Slice<i64> ++ Slice<i64> ──
    var a: []i64 = [1, 2, 3];
    var b: []i64 = [4, 5];
    var c: []i64 = a ++ b;
    var i: i64 = 0;
    while (i < 5) {
        println(int_to_str(c[i]));
        i = i + 1;
    }

    // ── Array [3]i64 ++ [2]i64 ⇒ [5]i64（定长合并，长度相加）──
    var p: [3]i64 = [10, 20, 30];
    var q: [2]i64 = [40, 50];
    var r: [5]i64 = p ++ q;
    var j: i64 = 0;
    while (j < 5) {
        println(int_to_str(r[j]));
        j = j + 1;
    }

    // ── 类型不匹配应被前端拒绝（Slice<i64> ++ Slice<string>）── 仅用于手测，下面不触发。
    return 0;
}
