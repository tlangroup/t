// P1（everything-is-value）：值位置的 `if` —— 脱糖为 `match (c) { true => T, false => E }`
// 编译器：t  @ 自举；后端：C + LLVM 双后端语义一致
// 覆盖点：① 值 if 作 return 值；② 值 if 赋给 var；③ 值 if 嵌套在算术表达式内；
//         ④ 分支只含单一表达式（Block 取值尚属 P1 Stage 1 后续）。

fn pick(c: bool) i32 {
    return if (c) { 1; } else { 2; };
}

fn sign(n: i64) i64 {
    return if (n > 0) { 1; } else { 0 - 1; };
}

@main
fn main() i64 {
    var a: i32 = if (true) { 7; } else { 9; };
    var b: i32 = if (false) { 7; } else { 9; };
    println(int_to_str(pick(true)));
    println(int_to_str(pick(false)));
    println(int_to_str(a as i64));
    println(int_to_str(b as i64));
    println(int_to_str(sign(5)));
    println(int_to_str(sign(0 - 3)));
    // 值 if 嵌在算术表达式内（值位置而非 return 位置）
    println(int_to_str((if (true) { 10; } else { 20; }) as i64 + 5));
    return 0;
}
