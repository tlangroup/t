// P1（everything-is-value）：值 `if` + 值块 + `else if` 链
// 编译器：t  @ 自举；后端：C + LLVM 双后端语义一致
//
// 脱糖形态（§2.9 姿势 A，后端零改动）：
//   值 if        `if (c) { T; } else { E; }`  →  `match (c) { true => T, false => E }`
//   else if 链    else 分支递归为又一个值 if  →  嵌套 match
//   值块          `{ e; }`                    →  `e`（解析期直接脱糖）
//
// 覆盖点：① 值 if 作 return 值；② 赋给 var；③ 嵌在算术表达式内；
//         ④ bool **表达式** scrutinee（`n > 0`，锁 i1 宽度对齐修复）；
//         ⑤ `else if` 链（三路 + 兜底）；⑥ 值块 `{ e; }` 作 var 初值；⑦ 值块作 match 臂。
// 限制：值块当前只支持单一表达式（多语句值块须后端结果槽，待后续 Stage）。

fn pick(c: bool) i32 {
    return if (c) { 1; } else { 2; };
}

fn sign(n: i64) i64 {
    return if (n > 0) { 1; } else { 0 - 1; };
}

fn grade(n: i64) i32 {
    return if (n >= 90) { 5; } else if (n >= 80) { 4; } else if (n >= 70) { 3; } else { 1; };
}

fn blkval() i32 {
    var x: i32 = { 7; };
    return x;
}

fn marms(c: bool) i32 {
    return match (c) {
        true => { 11; },
        false => { 22; },
    };
}

@main
fn main() i64 {
    var a: i32 = if (true) { 7; } else { 9; };
    var b: i32 = if (false) { 7; } else { 9; };
    println(int_to_str(pick(true)));
    println(int_to_str(pick(false)));
    println(int_to_str(a as i64));
    println(int_to_str(b as i64));
    println(int_to_str(sign(5)));
    println(int_to_str(sign(0 - 3)));
    // 值 if 嵌在算术表达式内（值位置而非 return 位置）
    println(int_to_str((if (true) { 10; } else { 20; }) as i64 + 5));
    // else if 链
    println(int_to_str(grade(95)));
    println(int_to_str(grade(85)));
    println(int_to_str(grade(75)));
    println(int_to_str(grade(10)));
    // 值块
    println(int_to_str(blkval() as i64));
    // 值块作 match 臂
    println(int_to_str(marms(true)));
    println(int_to_str(marms(false)));
    return 0;
}
