// colony_demo.tc —— Spawner / Colony Agent 调度体（库层）演示
//
// 复用 examples/lib/colony.tc（colony 库，import(colony)），展示收敛决策 A 下「不进编译器语法」
// 也能实现的 Spawner·Colony 元类能力：
//   ① spawn 生成子 agent（顺序分配 id，状态以 string 指纹存于 Colony 内部 slice）
//   ② 按 id 寻址（colony_send / colony_get）
//   ③ tick 调度（延迟邮箱排队，colony_tick 每帧驱动每个存活 agent）
//   ④ 同一 Colony 调度体跨 agent 类型复用（Worker 小队 + Counter）
//
// 泛型无关范式（t 已有 `comptime T: any` 单态化，此处仍用运行期动态分发范式）：
// 具体 XState 序列化为 string 指纹，x_step 包成 fn(string, colony.Msg) string 回调传入 colony_new。

import(colony);

// ───────────────────────── Worker（小队单位）─────────────────────────
Worker agent {
    state load: i64;     // 已完成工作单元数
    state busy: i64;     // 0=空闲 1=忙碌
    step fn(s: WorkerState, msg: atom) WorkerState {
        if (msg == :assign) { s.busy = 1;          return s; }
        if (msg == :done)   { s.load = s.load + 1; s.busy = 0; return s; }
        return s;
    }
}

// 定宽零填充指纹（12 位/字段，避免解析歧义）；worker_from_finger 用 str_at 手算。
fn pad12(v: i64) string {
    var s: string = int_to_str(v);
    var L: i64 = str_len(s);
    var b: StringBuilder = sb_new();
    var pad: i64 = 12 - L;
    var i: i64 = 0;
    for (i = 0; i < pad; i = i + 1) { sb_append_char(b, 48); }
    sb_append_str(b, s);
    return sb_to_str(b);
}
fn worker_to_finger(s: WorkerState) string {
    var b: StringBuilder = sb_new();
    sb_append_str(b, pad12(s.load));
    sb_append_str(b, pad12(s.busy));
    return sb_to_str(b);
}
fn parse_field(s: string, off: i64) i64 {
    var n: i64 = 0;
    var i: i64 = 0;
    for (i = 0; i < 12; i = i + 1) {
        var c: i64 = str_at(s, off + i);
        n = n * 10 + (c - 48);
    }
    return n;
}
fn worker_from_finger(s: string) WorkerState {
    var load: i64 = parse_field(s, 0);
    var busy: i64 = parse_field(s, 12);
    return worker_spawn(load, busy);
}
// 具体 agent 的 step 包成 Colony 通用回调（string 指纹版）
fn worker_step_wrap(s_str: string, m: colony.Msg) string {
    var s: WorkerState = worker_from_finger(s_str);
    s = worker_step(s, m.kind);
    return worker_to_finger(s);
}

// ───────────────────────── Counter（证明跨类型复用）─────────────────────────
Counter agent {
    state count: i64;
    step fn(s: CounterState, msg: i64) CounterState {
        s.count = s.count + msg;
        return s;
    }
}
fn counter_to_finger(s: CounterState) string { return int_to_str(s.count); }
fn parse_i64(s: string) i64 {
    var n: i64 = 0;
    var i: i64 = 0;
    var L: i64 = str_len(s);
    for (i = 0; i < L; i = i + 1) {
        var c: i64 = str_at(s, i);
        if (c >= 48 && c <= 57) { n = n * 10 + (c - 48); }
    }
    return n;
}
fn counter_from_finger(s: string) CounterState { return counter_spawn(parse_i64(s)); }
fn counter_step_wrap(s_str: string, m: colony.Msg) string {
    var s: CounterState = counter_from_finger(s_str);
    s = counter_step(s, m.arg_i);
    return counter_to_finger(s);
}

// ───────────────────────── 展示辅助 ─────────────────────────
fn pline(label: string, v: i64) void {
    var b: StringBuilder = sb_new();
    sb_append_str(b, label);
    sb_append_i64(b, v);
    println(sb_to_str(b));
}
fn show_worker(col: colony.Colony, id: i64) void {
    var s: string = colony.colony_get(col, id);
    var load: i64 = parse_field(s, 0);
    var busy: i64 = parse_field(s, 12);
    var b: StringBuilder = sb_new();
    sb_append_str(b, "  worker ");
    sb_append_i64(b, id);
    sb_append_str(b, " load=");
    sb_append_i64(b, load);
    sb_append_str(b, " busy=");
    sb_append_i64(b, busy);
    println(sb_to_str(b));
}

@main
fn main() i64 {
    println("=== Colony: spawn / 寻址 / 调度 (Worker squad) ===");
    var col: colony.Colony = colony.colony_new(worker_step_wrap);
    col = colony.colony_spawn(col, worker_to_finger(worker_spawn(0, 0)));   // id 0
    col = colony.colony_spawn(col, worker_to_finger(worker_spawn(0, 0)));   // id 1
    col = colony.colony_spawn(col, worker_to_finger(worker_spawn(0, 0)));   // id 2
    // 按 id 寻址：worker0 收 :assign+:done；worker1 收 :assign；worker2 空闲
    col = colony.colony_send(col, 0, colony.mk_msg(:assign, 0, ""));
    col = colony.colony_send(col, 0, colony.mk_msg(:done, 0, ""));
    col = colony.colony_send(col, 1, colony.mk_msg(:assign, 0, ""));
    pline("  alive(before tick) = ", colony.colony_count(col));

    col = colony.colony_tick(col);   // 每 agent 各处理一条排队消息
    show_worker(col, 0);
    show_worker(col, 1);
    show_worker(col, 2);

    col = colony.colony_tick(col);   // worker0 处理剩余 :done；worker1 无新消息
    show_worker(col, 0);
    show_worker(col, 1);

    println("");
    println("=== Colony 复用：Counter（不同类型 agent 同一调度体）===");
    var cc: colony.Colony = colony.colony_new(counter_step_wrap);
    cc = colony.colony_spawn(cc, counter_to_finger(counter_spawn(0)));      // id 0
    cc = colony.colony_send(cc, 0, colony.mk_msg(:none, 5, ""));
    cc = colony.colony_send(cc, 0, colony.mk_msg(:none, 3, ""));
    cc = colony.colony_tick(cc);
    cc = colony.colony_tick(cc);
    pline("  counter after +5,+3 = ", parse_i64(colony.colony_get(cc, 0)));
    return 0;
}
