variant Shape { Circle(i64); Rect(i64, i64); Empty; }
fn area(s: Shape) i64 {
    return match (s) {
        .Empty => 0
        .Circle(r) => r
        .Rect(w, h) => w + h
    };
}
fn main() i32 @main {
    var a: Shape = .Empty;
    var b: Shape = .Circle(7);
    var c: Shape = .Rect(2, 3);
    println(int_to_str(area(a)));
    println(int_to_str(area(b)));
    println(int_to_str(area(c)));
    return 0;
}
