// format_* 内建：Python 格式规范微型语言（子集）
//
// spec 兼容三种写法： ">10" / ":>10" / "{:>10}"（解析时自动剥除 {} 与 : 外壳）。
// 语法： [[fill]align][sign][#][0][width][grouping][.precision][type]
//   align   '<' '>' '=' '^'          sign '+' '-' ' '
//   '#' 替代形式   '0' 零填充(=fill '0' align '=')
//   grouping ',' (十进制千分位) / '_' (b/o/x 每4位、d 每3位)
//   type b c d e E f F g G n o s x X %
// 浮点走运行时 snprintf（非生成代码），双后端逐字节一致。
//
// 注意：bool 沿用 t 的小写字面量（true/false），与 Python 的 True/False 不同。

@main
fn main() i64 {
    // ── 整数：对齐 / 填充 / 符号 / 进制 / # / 0 填充 / 群组 / 精度 ──
    println(format_int(":>10", 42));       // 右对齐（带 {} 外壳）
    println(format_int("<10", -7));        // 左对齐
    println(format_int("+10", 42));         // 强制 + 号
    println(format_int("*^10", 42));        // 填充 '*' + 居中
    println(format_int("=+10", -7));        // '=' 对齐：符号留左
    println(format_int("#08x", 255));       // 替代形式 + 零填充
    println(format_int("b", 11));           // 二进制
    println(format_int("o", 64));           // 八进制
    println(format_int(",d", 1234567));     // 千分位
    println(format_int("_x", 0xABCDEF));    // 下划线分组（每4位）
    println(format_int("05d", -42));        // 零填充带符号
    println(format_int(".4d", 7));          // 精度前导零

    // ── 无符号 ──
    println(format_uint("x", 255));         // 十六进制
    println(format_uint("#016b", 5));       // 替代形式 + 宽度 + 精度

    // ── 浮点 ──
    println(format_float(".2f", 3.14159));  // 定点
    println(format_float(">10.2f", 3.14159));// 右对齐 + 定点
    println(format_float("+.2f", 3.14159)); // 强制 + 号
    println(format_float("e", 1234.0));     // 科学计数
    println(format_float(".2%", 0.5));      // 百分比
    println(format_float(",.2f", 1234.5));  // 千分位 + 定点
    println(format_float("g", 1234567.0));  // 通用格式

    // ── 字符串 ──
    println(format_str("<10", "hi"));       // 左对齐
    println(format_str(">10.2", "hello"));  // 右对齐 + 截断
    println(format_str("^11", "x"));         // 居中

    // ── 布尔（t 小写）──
    println(format_bool(">5", 1));          // 右对齐
    println(format_bool("", 0));            // 默认
    println(format_bool("d", 1));           // 数值简写 → 1

    // ── 字符（传整数码点）──
    println(format_char("<5", 65));         // 'A' 左对齐
    println(format_char(">3", 35));          // '#' 右对齐

    // ── StringBuilder 直写变体 ──
    var sb: StringBuilder = sb_new();
    sb_append_fmt_int(sb, ",d", 9876543);
    sb_append_str(sb, "|");
    sb_append_fmt_float(sb, ".3f", 2.5);
    sb_append_str(sb, "|");
    sb_append_fmt_str(sb, ">5", "ok");
    println(sb_to_str(sb));

    return 0;
}
