// planner_demo.tc —— 规划体（Planning）的无语法表达（决策 A §8 第5条 / §11.5）
//
// 核心论点：Planning 行（Scout / Operator / Strategist / Adjutant）不需要 goal/plan 语法。
//   规划 Core = 一个纯自由 fn  planner(State) atom（算出“下一步消息”），
//   把结果喂同一个纯 step。Agent 原语只给 reflex Core（state + step）；
//   规划是库层模式，不同 flavor 只是「同一 step 原语 + 不同边界驱动 planner fn」。
//
// 本例：一个网格机器人 Robot（agent）。step 是纯反射——执行单条命令（移动/充电/侦察/请示）。
//   四个 planner 自由 fn 各有不同「边界驱动」哲学，但都喂同一个 robot_step：
//     operator_planner  —— 纯执行：贪心朝目标走，不侦察、不充电
//     scout_planner     —— 规划式感知：先侦察(:scan)一次再走（区别于 Sensor 反应式感知）
//     strategist_planner—— 资源规划：能量不足先充电(:recharge)
//     adjutant_planner  —— 人类为指挥官：开工前先请示(:ask)
//   run_with_planner 是通用循环：s = robot_step(s, planner(s))，planner 是唯一变量。
//   双后端逐字节一致（纯确定性，无 LLM/IO 边界）—— 故带 .expected.txt 进双后端门禁。

// ──────────────── Robot agent（瘦决策核 + 反射 step） ────────────────
// step 只做一件事：执行一条命令，更新状态。它不知道「为什么」发这条命令——
// 「为什么」完全由外部 planner 决定（边界驱动在 planner 里，不在 step 里）。
Robot agent {
    state x: i64;
    state y: i64;
    state energy: i64;
    state tx: i64;            // target x
    state ty: i64;            // target y
    state moves: i64;         // 已移动步数
    state scans: i64;         // 已侦察次数
    state recharges: i64;     // 已充电次数
    state asks: i64;          // 已请示人类次数
    state last_cmd: atom;     // 最近执行的命令（消息即 atom）
    step fn(s: RobotState, cmd: atom) RobotState {
        // 移动需耗能：能量为 0 时移动空转（不变位置、不扣能量），逼出「规划 vs 无规划」差异
        if (cmd == :north) {
            if (s.energy > 0) { s.y = s.y + 1; s.energy = s.energy - 1; s.moves = s.moves + 1; }
        } else if (cmd == :south) {
            if (s.energy > 0) { s.y = s.y - 1; s.energy = s.energy - 1; s.moves = s.moves + 1; }
        } else if (cmd == :east) {
            if (s.energy > 0) { s.x = s.x + 1; s.energy = s.energy - 1; s.moves = s.moves + 1; }
        } else if (cmd == :west) {
            if (s.energy > 0) { s.x = s.x - 1; s.energy = s.energy - 1; s.moves = s.moves + 1; }
        } else if (cmd == :recharge) {
            s.energy = s.energy + 5; s.recharges = s.recharges + 1;
        } else if (cmd == :scan) {
            s.scans = s.scans + 1;
        } else if (cmd == :ask) {
            s.asks = s.asks + 1;
        }
        // :idle → 什么都不做；其余命令均不改变状态
        s.last_cmd = cmd;
        return s;
    }
}

// 朝目标走一步的「反射策略」——被多个 planner 复用（同一原语，避免重复）
move_toward fn(s: RobotState) atom {
    if (s.x < s.tx) { return :east; }
    if (s.x > s.tx) { return :west; }
    if (s.y < s.ty) { return :north; }
    if (s.y > s.ty) { return :south; }
    return :idle;
}

// ──────────────── 四个 planner 自由 fn（不同边界驱动） ────────────────
// 每个都是 fn(RobotState) atom：看状态，算「下一步消息」，喂 step。无 goal/plan 语法。

// Operator（操作体）：纯执行，直接朝目标走，不侦察、不充电、不请示
operator_planner fn(s: RobotState) atom {
    return move_toward(s);
}

// Scout（侦察体）：规划式感知——先侦察一次再行动（区别于 Sensor 反应式感知）
scout_planner fn(s: RobotState) atom {
    if (s.scans == 0) { return :scan; }   // 开工前先侦察（规划式，不是反应式）
    return move_toward(s);
}

// Strategist（策略体）：资源规划——能量告急先充电，否则朝目标走
strategist_planner fn(s: RobotState) atom {
    if (s.energy <= 2) { return :recharge; }
    return move_toward(s);
}

// Adjutant（副官体）：人类为指挥官——开工前先请示一次（人类下达意图）
adjutant_planner fn(s: RobotState) atom {
    if (s.asks == 0) { return :ask; }     // 第一帧先请示指挥官
    return move_toward(s);
}

// ──────────────── 通用驱动器：planner 是唯一变量 ────────────────
// 关键：step 原语从不变，换成不同 planner 即换「边界驱动」。
// 这正是 §11.5 的落点：规划 = 同一原语(step) + 不同边界驱动(planner fn)。
run_with_planner fn(p: fn(RobotState) atom, init: RobotState, steps: i64) RobotState {
    var s: RobotState = init;
    var i: i64 = 0;
    for (i = 0; i < steps; i = i + 1) {
        s = robot_step(s, p(s));
    }
    return s;
}

// 初始机器人：起点(0,0)，目标(6,0)，能量=4（不足以往返，逼出各 planner 的差异）
make_robot fn() RobotState {
    return robot_spawn(0, 0, 4, 6, 0, 0, 0, 0, 0, :idle);
}

show_robot fn(tag: string, s: RobotState) void {
    var b: StringBuilder = sb_new();
    sb_append_str(b, tag);
    sb_append_str(b, " x=");  sb_append_i64(b, s.x);
    sb_append_str(b, " y=");  sb_append_i64(b, s.y);
    sb_append_str(b, " e=");  sb_append_i64(b, s.energy);
    sb_append_str(b, " mv="); sb_append_i64(b, s.moves);
    sb_append_str(b, " sc="); sb_append_i64(b, s.scans);
    sb_append_str(b, " rc="); sb_append_i64(b, s.recharges);
    sb_append_str(b, " ak="); sb_append_i64(b, s.asks);
    println(sb_to_str(b));
}

@main
main fn() i64 {
    println("=== planner_demo: 规划体 = 同一 step 原语 + 不同边界驱动 ===");
    var init: RobotState;
    var s: RobotState;

    // 同一反射 step，仅换 planner —— 轨迹/资源消耗即不同
    init = make_robot();
    s = run_with_planner(operator_planner, init, 12);
    show_robot("operator ->", s);

    init = make_robot();
    s = run_with_planner(scout_planner, init, 12);
    show_robot("scout    ->", s);

    init = make_robot();
    s = run_with_planner(strategist_planner, init, 12);
    show_robot("strategist->", s);

    init = make_robot();
    s = run_with_planner(adjutant_planner, init, 12);
    show_robot("adjutant ->", s);

    println("lesson: step 原语不变；差异只来自 planner 边界驱动（侦察/充电/请示/纯执行）");
    return 0;
}
