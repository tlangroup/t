// R-028 / R-027 回归探针
//
// R-028 · enum 内存布局遵循声明的底层整型：
//   enum E : u8  -> 1 字节
//   enum E : u32 -> 4 字节
//   @type_info(E).Enum.size 编译期 / 运行期一致；C / LLVM 双后端一致。
//
// R-027 · struct 含 enum 字段可正常编译（不再 forward reference / undefined type），
//   字段读取按枚举底层宽正确还原。
//
// 验收：双后端（LLVM / tmir-c）stdout 逐字节一致，且等于 enum_size.expected.txt。

enum Color : u8  { RED = 0; GREEN = 1; BLUE = 7; }
enum Big   : u32 { X = 1; Y = 2; Z = 4000000000; }
struct S2 { c: Color; b: Big; n: i32; }

comptime const CT_COLOR: i64 = @type_info(Color).Enum.size;
comptime const CT_BIG:   i64 = @type_info(Big).Enum.size;

@main
fn main() i64 {
    // ── R-028：size 编译期 / 运行期一致 ──
    println("ct_color=" + int_to_str(CT_COLOR));
    println("ct_big="   + int_to_str(CT_BIG));
    var ti: TypeInfo = type_info(Color);
    match (ti) {
        .Enum(m) => { println("rt_color=" + int_to_str(m.size)); }
        _ => {}
    };
    var ti2: TypeInfo = type_info(Big);
    match (ti2) {
        .Enum(m) => { println("rt_big=" + int_to_str(m.size)); }
        _ => {}
    };
    // ── R-027：struct 含 enum 字段可读写 ──
    var s: S2;
    s.c = Color.RED; s.b = Big.Y; s.n = 99;
    println("s.c=" + int_to_str(s.c as i32));   // 0  (RED)
    println("s.b=" + int_to_str(s.b as i64));   // 2  (Y，u32 底层宽)
    println("s.n=" + int_to_str(s.n));          // 99
    return 0;
}
