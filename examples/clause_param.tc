// clause_param.tc — 子句组作为**形参**（N14/N15）+ N16 三组探针中的前两组
// 设计：docs/compiler/first-class-clause.md §5.5 / §5.6
//
// 探针 ①：同一 G 对不同 scrutinee 各自正确
//   —— 证明 G 是**一等值**（一次构造、多处消费），而非「每个 case 是独立函数」。
// 探针 ②：不同 group 实参得到不同结果
//   —— 证明 group 是**参数**，而非在编译期被固化。
//
// `fn fmt_with(x: i64, G: [2]clause) i64` 含 clause 形参 ⇒ 自动升为编译期函数（Q8 自动置位），
// 调用点按实参单态化：不同 group ⇒ 不同实例。

fn fmt_with(x: i64, G: [2]clause) i64 {
    return match (x) { G };
}

const GA = [@clause(.pattern, 0, 10), @clause(.pattern, _, 0 - 1)];
const GB = [@clause(.pattern, 0, 0 - 5), @clause(.pattern, _, 99)];

@main
fn main() i64 {
    println(int_to_str(fmt_with(0, GA)));   // 10   （探针①：GA 的第一条命中）
    println(int_to_str(fmt_with(7, GA)));   // -1   （探针①：同一 GA，换 scrutinee 走 else）
    println(int_to_str(fmt_with(0, GB)));   // -5   （探针②：换 group ⇒ 结果不同）
    println(int_to_str(fmt_with(7, GB)));   // 99   （探针②：换 group ⇒ else 也不同）
    return 0;
}
