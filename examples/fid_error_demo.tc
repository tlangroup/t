// fid_error：句柄错误查询演示
//
// fid_error fn(f: fid) string —— 走系统函数（仿 fid_is_open），语义：
//   · 返回该句柄**最近一次**错误原因；从未出错返回空串。
//   · 成功路径不清空，故可在若干次写之后统一探测。
//   · 对打开失败的哨兵句柄（-1）返回最近一次 fopen 的失败原因。
//   · 对越界 / 已关闭句柄返回空串，**不 panic**（L-09 零 UB）。
// 错误串内容来自宿主 strerror，随平台/语言环境而变，故本示例只比对「是否非空」，
// 不比对具体文字。

// 打印「标签 + 是否非空」，保证输出与平台错误文案无关
fn yn(label: string, ok: bool) void {
    var b: StringBuilder = sb_new();
    sb_append_str(b, label);
    if (ok) { sb_append_str(b, "yes"); } else { sb_append_str(b, "no"); }
    println(sb_to_str(b));
}

fn nonempty(s: string) bool {
    return (str_len(s) as i64) > 0;
}

@main
fn main() i64 {
    // ── 1. 标准流从未出错 ⇒ 空串 ────────────────────────────────
    println("-- 1. clean handle --");
    yn("stdout has error?   ", nonempty(fid_error(stdout)));
    yn("stderr has error?   ", nonempty(fid_error(stderr)));

    // ── 2. 打开失败：句柄为 -1，仍可查原因 ──────────────────────
    println("-- 2. open failure --");
    var bad: fid = fopen("out/_no_such_dir_/x.txt", :read);
    yn("bad is open?        ", fid_is_open(bad));
    yn("bad has reason?     ", nonempty(fid_error(bad)));

    // ── 3. 正常写入：无错误 ⇒ 空串 ──────────────────────────────
    println("-- 3. healthy write --");
    var f: fid = fopen("out/_fid_error_demo.txt", :write);
    if (fid_is_open(f)) {
        f < "n=" < 7 < "\n";
        fflush(f);
        yn("after write error?  ", nonempty(fid_error(f)));
        fclose(f);
        // 关闭后依然可查（fid_error 不要求句柄仍打开）
        yn("after close error?  ", nonempty(fid_error(f)));
        yn("after close open?   ", fid_is_open(f));
    } else {
        println("open failed");
    }

    // ── 4. 读回内容确认写入确实成功 ─────────────────────────────
    println("-- 4. content --");
    print(file_read_all("out/_fid_error_demo.txt"));

    return 0;
}
