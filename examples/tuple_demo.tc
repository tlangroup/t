// 元组（tuple）+ struct `.x=` 字面量 综合演示
struct Pt {
    x: i64;
    y: i64;
}

// 具名元组（位置字段 struct）：字段自动命名 `_0`/`_1`，用逗号分隔
struct Pair { i64, string }

fn main() i32 @main {
    // 1) 具名 struct 的 `.x =` 字面量形式（与旧 `:` 形式并存）
    var a: Pt = Pt{ .x = 3, .y = 4 };
    println(f"a.x={a.x} a.y={a.y}");

    // 2) 匿名元组字面量（元素类型推断；裸整数字面量按量级默认 u8，故需显式 1i64 让 t.0 为 i64）
    var t = .{1i64, "hi", true};
    println(f"t.0={t.0} t.1={t.1} t.2={t.2}");

    // 3) 匿名元组类型标注
    var u: .{i64, string} = .{7i64, "yo"};
    println(f"u.0={u.0} u.1={u.1}");

    // 4) 具名元组 struct 的位置字段字面量（`._N =` 形式）
    var p: Pair = Pair{ ._0 = 9, ._1 = "z" };
    println(f"p._0={p._0} p._1={p._1}");

    // 5) 元组作参数与返回值（`.{i64,string}` 匿名元组与具名 `Pair` 是不同类型，不混用）
    var s = add_tup(.{1i64, "hi"}, u);
    println(f"s.0={s.0} s.1={s.1}");

    var ok: i64 = a.x + a.y + t.0 + u.0 + p._0 + s.0;
    return (ok as i32);
}

fn add_tup(a: .{i64, string}, b: .{i64, string}) .{i64, string} {
    return .{a.0 + b.0, a.1 + b.1};
}
