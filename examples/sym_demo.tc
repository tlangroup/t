// Sym 类型运行时演示（设计定稿，需 Sym 实现后编译运行）
// 覆盖：多池独立、池内字符串去重、按 id 相等、按池整池释放、释放后重置复用、Symbols 全局释放
// 声明语法采用本语言方言：var <name>: Sym32("tag") = <string>;
// 赋字符串即自动 intern，变量仅持有 u32 id；真实字符串住在以 tag 命名的外部池。
@main
fn main() i64 {
    var npc: Sym32("NPCName") = "Alice";
    var enemy: Sym32("EnemyName") = "Goblin";

    println(sym_str(npc));       // Alice
    println(sym_str(enemy));     // Goblin

    // 同池去重：相同字符串共享同一 id（比较按 id，O(1)）
    var npc2: Sym32("NPCName") = "Alice";
    if (npc == npc2) {
        println("npc-dedup");     // 应打印
    }

    // 整池释放 NPCName（region 结束）；EnemyName 池仍存活
    sym_release("NPCName");

    println(sym_str(enemy));     // Goblin

    // 释放后重新 intern：池已重置，可再次正常使用
    var npc3: Sym32("NPCName") = "Alice";
    println(sym_str(npc3));      // Alice

    // ── Sym64：64 位 id 池（位宽可选，跨池/跨位宽即不同类型）──
    var big: Sym64("BigTag") = "Zaphod";
    var big2: Sym64("BigTag") = "Trillian";
    println(sym_str(big));       // Zaphod
    println(sym_str(big2));      // Trillian

    // Sym64 池内去重
    var big3: Sym64("BigTag") = "Zaphod";
    if (big == big3) {
        println("big-dedup");     // 应打印
    }

    // 跨位宽不可比较/互赋：Sym64 与 Sym32 即使同 tag 也属不同类型（编译期即区分 id 位宽）
    // （此处仅演示 Sym64 独立运行；跨位宽赋值会被类型系统拒绝，不在此运行期体现）

    // 单独释放 Sym64 池，验证 64 位池生命周期独立
    sym_release("BigTag");
    var big4: Sym64("BigTag") = "Zaphod";
    println(sym_str(big4));      // Zaphod（池已重置，重新 intern）

    // ── Sym16：16 位 id 池（验证位宽分派与 u16 存储路径）──
    var small: Sym16("TinyTag") = "Pebble";
    println(sym_str(small));      // Pebble
    var small2: Sym16("TinyTag") = "Pebble";
    if (small == small2) {
        println("small-dedup");    // 应打印
    }
    sym_release("TinyTag");

    // 全局释放：经 Symbols 注册表遍历所有剩余池
    sym_release_all();
    return 0;
}
