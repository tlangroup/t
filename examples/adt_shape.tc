// ADT 演示（concrete variant）：几何图形 + match 构造器解构
// 编译器：t  @ 自举；后端：C + LLVM 双后端语义一致
Shape variant { Circle(i64); Rect(i64); Empty; }

area fn(s: Shape) i64 {
    return match (s) {
        Circle(r) => 3 * r * r
        Rect(a) => 4 * a
        Empty => 0
    };
}

@main
main fn() i64 {
    var c: Shape = Shape_from_Circle(5);
    var r: Shape = Shape_from_Rect(7);
    var e: Shape = Shape_from_Empty();
    println(int_to_str(area(c)));
    println(int_to_str(area(r)));
    println(int_to_str(area(e)));
    return 0;
}
