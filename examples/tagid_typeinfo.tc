// tagID 经运行时 type_info 暴露：fi_tag() 内建函数（双后端一致）
// 与 fi_name/fi_offset 等同属函数式 API（FieldInfo 为不透明句柄，不用 .tag 成员语法）
// 显式 @N 与全自动两种模式都覆盖。

Point struct {
    x: i64 @ 1;
    y: i64 @ 2 = 42;
    z: i64 @ 3;
}

// 全自动模式：tagID 按声明序隐式 1,2,3 分配
Auto struct {
    a: i64;
    b: i64;
    c: i64;
}

@main
fn main() i64 {
    var tp: TypeInfo = type_info(Point);
    var ta: TypeInfo = type_info(Auto);
    var s: i64 = 0;
    var i: i64 = 0;
    // 显式 @N → 1,2,3
    while (i < ti_field_count(tp)) {
        var f: FieldInfo = ti_field(tp, i);
        println(int_to_str(fi_tag(f)));
        s = s + fi_tag(f);
        i = i + 1;
    }
    // 全自动 → 1,2,3
    i = 0;
    while (i < ti_field_count(ta)) {
        var af: FieldInfo = ti_field(ta, i);
        println(int_to_str(fi_tag(af)));
        s = s + fi_tag(af);
        i = i + 1;
    }
    return s;  // 1+2+3 + 1+2+3 = 12
}
