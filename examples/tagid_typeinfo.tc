// tagID 经运行时 type_info 暴露（阶段5 改写）：FieldInfo.tag 字段投影替代已删除的 fi_tag() 内建。
// 显式 @N 与全自动两种模式都覆盖。

struct Point {
    x: i64 @ 1;
    y: i64 @ 2 = 42;
    z: i64 @ 3;
}

// 全自动模式：tagID 按声明序隐式 1,2,3 分配
struct Auto {
    a: i64;
    b: i64;
    c: i64;
}

@main
fn main() i64 {
    var tp: TypeInfo = type_info(Point);
    var ta: TypeInfo = type_info(Auto);
    var s: i64 = 0;
    var i: i64 = 0;
    var mp: *TypeMeta = match (tp) { .Struct(mt) => mt, _ => null };
    var n: i64 = mp.field_count;
    while (i < n) {
        var f: FieldInfo = mp.fields[i];
        println(int_to_str(f.tag));
        s = s + f.tag;
        i = i + 1;
    }
    i = 0;
    var ma: *TypeMeta = match (ta) { .Struct(mt) => mt, _ => null };
    n = ma.field_count;
    while (i < n) {
        var af: FieldInfo = ma.fields[i];
        println(int_to_str(af.tag));
        s = s + af.tag;
        i = i + 1;
    }
    return s;  // 1+2+3 + 1+2+3 = 12
}
