// 验证 println 内建（双后端，print + 换行）。
// 预期输出（含换行）：
// hello
// count=3
// no-newlinedone
@main
main fn() i64 {
    var s: string = "hello";
    println(s);
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "count=");
    sb_append_str(sb, int_to_str(3));
    println(sb_to_str(sb));
    print("no-newline");
    println("done");
    return 0;
}
