// 回归：元组字面量出现在「前面已有局部变量」的语句位置。
// 曾因 `.{...}` 的省略类型名标记落在 lb 槽（kids 链表头槽）被通用遍历
// 当链表展开 → 撞进函数语句链成环 → 编译器栈溢出（退出码 127）。
// 该缺陷与 kids 池布局相关，故必须用「先有局部、再有元组」的最小形态固化。
@main
fn main() i32 {
    var n: i64 = 5;
    var t = .{1i64, "a", true};
    var u: .{i64, string} = .{2i64, "b"};
    var total: i64 = n + t._0 + u._0;
    println(f"n={n} t.0={t._0} t.1={t._1} t.2={t._2} u.0={u._0} u.1={u._1} total={total}");
    return 0;
}
