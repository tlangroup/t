// examples/math_extra_demo.tc —— std.math 对数/反三角补充（双后端语义验证）
// 运行: tc run --example math_extra_demo
// 依赖: lib/std/math.tc（源码内联导入）
// 浮点结果乘以 1e5 取整打印，规避浮点字符串格式化差异（双后端算术一致，故仍逐字节可比）。
@import("std.math");

fn main_fn() i32 @main {
    println(i2s((math.log(2.718281828459045) * 100000.0) as i64));   // ln e ≈ 100000
    println(i2s((math.log10(100.0) * 100000.0) as i64));            // log10 100 ≈ 200000
    println(i2s((math.log10(1000.0) * 100000.0) as i64));          // log10 1000 ≈ 300000
    println(i2s((math.log2(8.0) * 100000.0) as i64));              // log2 8 ≈ 300000
    println(i2s((math.hypot(3.0, 4.0) * 100000.0) as i64));        // 3-4-5 三角 ≈ 500000
    println(i2s((math.atan2(1.0, 1.0) * 100000.0) as i64));        // π/4 ≈ 78540
    println(i2s((math.atan2(0.0, 1.0) * 100000.0) as i64));        // 0
    println(i2s((math.atan2(1.0, 0.0) * 100000.0) as i64));        // π/2 ≈ 157080
    return 0;
}
