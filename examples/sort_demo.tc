// examples/sort_demo.tc —— std.sort 用法演示（双后端语义验证）
// 运行: tc run --example sort_demo
// 依赖: lib/std/sort.tc（源码内联导入）
@import("std.sort");

fn greater_i64(a: i64, b: i64) bool { return a > b; }

fn main_fn() i32 @main {
    // i64 升序
    var xs: []i64;
    append(xs, 5); append(xs, 2); append(xs, 9); append(xs, 1); append(xs, 5);
    sort.sort_slice(i64, xs, sort.less_i64);
    var i: u64 = 0;
    while (i < slice_len(xs)) { println(i2s(xs[i])); i = i + 1; }

    // 字符串字典序
    var names: []string;
    append(names, "banana"); append(names, "apple"); append(names, "cherry");
    sort.sort_slice(string, names, sort.less_string);
    i = 0;
    while (i < slice_len(names)) { println(names[i]); i = i + 1; }

    // 降序（自定义比较器）
    var ys: []i64;
    append(ys, 3); append(ys, 1); append(ys, 4); append(ys, 1); append(ys, 5);
    sort.sort_slice(i64, ys, greater_i64);
    i = 0;
    while (i < slice_len(ys)) { println(i2s(ys[i])); i = i + 1; }

    // 边界：空切片 / 单元素（均不动）
    var empty: []i64;
    sort.sort_slice(i64, empty, sort.less_i64);
    println(i2s(slice_len(empty)));

    var one: []i64;
    append(one, 42);
    sort.sort_slice(i64, one, sort.less_i64);
    println(i2s(one[0]));
    return 0;
}
