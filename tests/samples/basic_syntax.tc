// ═══════════════════════════════════════════════════════════════
// t Language Basic Syntax Test
// 覆盖基础语法：常量、标量类型、struct/enum/flag/union、
// 函数、控制流、运算符、注解、@test 测试
// ═══════════════════════════════════════════════════════════════

// ── 1. 常量声明 ──────────────────────────────────────────────
const VERSION: u32 = 1;
const MAX_ITEMS: u16 = 100;
const HEX_VALUE: u32 = 0xFF00;
const BIN_VALUE: u8 = 0b1010;
const PI_TIMES_100: i32 = 314;

// ── 2. 枚举：显式底层类型 + 显式值 ────────────────────────────
Color enum : u8 {
    Red = 0,
    Green = 1,
    Blue = 2,
    White = 255,
}

// ── 3. 位域 Flag：命名槽位 + 位宽 ─────────────────────────────
StatusFlags flag[u16] {
    active:    1 @doc("是否激活");
    visible:   1 @doc("是否可见");
    locked:    1 @doc("是否锁定");
    level:     4 @doc("等级 0~15");
    category:  8 @doc("分类 0~255");
}

// ── 4. 结构体：字段 + 派生注解 ────────────────────────────────
Point struct @derive(Clone, Eq, DebugPrint) {
    x: i32;
    y: i32;
}

Rect struct @derive(Clone) {
    origin: Point;
    width: u32;
    height: u32;
    flags: StatusFlags;
}

// ── 5. 联合体 ────────────────────────────────────────────────
Value union {
    as_int: i64;
    as_uint: u64;
    as_float: f64;
}

// ── 6. 函数：参数、返回值、局部变量、控制流 ────────────────────
add fn(a: i32, b: i32) i32 {
    return a + b;
}

clamp fn(v: i32, lo: i32, hi: i32) i32 {
    if (v < lo) {
        return lo;
    }
    if (v > hi) {
        return hi;
    }
    return v;
}

// while 循环
sum_to fn(n: i32) i32 {
    var total: i32 = 0;
    var i: i32 = 1;
    while (i <= n) {
        total = total + i;
        i = i + 1;
    }
    return total;
}

// for 循环
factorial fn(n: i32) i32 {
    var result: i32 = 1;
    for (var i: i32 = 2; i <= n; i = i + 1) {
        result = result * i;
    }
    return result;
}

// 位运算
bit_tricks fn(x: u32) u32 {
    var v: u32 = x;
    v = v | 0x01;      // 置位
    v = v & 0xFF;      // 掩码
    v = v ^ 0x10;      // 翻转
    v = v << 2;        // 左移
    v = v >> 1;        // 右移
    return v;
}

// ── 7. 程序入口 ──────────────────────────────────────────────
main fn() i32 @main {
    var p: Point = Point { x: 3, y: 4 };
    var r: Rect = Rect {
        origin: p,
        width: 10,
        height: 20,
        flags: 0,
    };

    flag_set(r.flags, StatusFlags.active, 1);
    flag_set(r.flags, StatusFlags.level, 7);

    var s: i32 = add(r.origin.x, r.origin.y);
    if (s != 7) {
        return 1;
    }
    return 0;
}

// ── 8. 测试用例 ──────────────────────────────────────────────
test_add fn() bool @test {
    return add(2, 3) == 5;
}

test_clamp fn() bool @test {
    if (clamp(15, 0, 10) != 10) { return false; }
    if (clamp(-5, 0, 10) != 0)  { return false; }
    return clamp(5, 0, 10) == 5;
}

test_sum_to fn() bool @test @test_group("loops") {
    return sum_to(10) == 55;
}

test_factorial fn() bool @test @test_group("loops") {
    return factorial(5) == 120;
}

test_flag_rw fn() bool @test @test_group("flags") {
    var f: StatusFlags = 0;
    flag_set(f, StatusFlags.level, 9);
    flag_set(f, StatusFlags.category, 42);
    var lv: u32 = flag_get(f, StatusFlags.level);
    var cat: u32 = flag_get(f, StatusFlags.category);
    return lv == 9 && cat == 42;
}

test_single_bit fn() bool @test @test_group("flags") {
    var f: StatusFlags = 0;
    f = f | StatusFlags.visible;
    return (f & StatusFlags.visible) != 0;
}

test_bit_tricks fn() bool @test {
    var out: u32 = bit_tricks(0x0F);
    return out > 0;
}

test_skip_example fn() bool @test @test_skip {
    return false;
}
