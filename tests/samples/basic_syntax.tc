// ═══════════════════════════════════════════════════════════════
// t Language Basic Syntax Test
// DIFFTEST-XFAIL(tc0): lex, check, emit-c — tc0 冻结实现不识别新测试语法 "名字" test {} / expect / suite
// 覆盖基础语法：常量、标量类型、struct/enum/flag/union、
// 函数、控制流、运算符、注解、`"名字" test {}` 测试声明
// ═══════════════════════════════════════════════════════════════

// ── 1. 常量声明 ──────────────────────────────────────────────
const VERSION: u32 = 1;
const MAX_ITEMS: u16 = 100;
const HEX_VALUE: u32 = 0xFF00;
const BIN_VALUE: u8 = 0b1010;
const PI_TIMES_100: i32 = 314;

// ── 2. 枚举：显式底层类型 + 显式值 ────────────────────────────
enum Color : u8 {
    Red = 0,
    Green = 1,
    Blue = 2,
    White = 255,
}

// ── 3. 位域 Flag：命名槽位 + 位宽 ─────────────────────────────
flag StatusFlags[u16] {
    active:    1 @doc("是否激活");
    visible:   1 @doc("是否可见");
    locked:    1 @doc("是否锁定");
    level:     4 @doc("等级 0~15");
    category:  8 @doc("分类 0~255");
}

// ── 4. 结构体：字段 + 派生注解 ────────────────────────────────
struct Point @derive(Clone, Eq, DebugPrint) {
    x: i32;
    y: i32;
}

struct Rect @derive(Clone) {
    origin: Point;
    width: u32;
    height: u32;
    flags: StatusFlags;
}

// ── 5. 联合体 ────────────────────────────────────────────────
union Value {
    as_int: i64;
    as_uint: u64;
    as_float: f64;
}

// ── 6. 函数：参数、返回值、局部变量、控制流 ────────────────────
fn add(a: i32, b: i32) i32 {
    return a + b;
}

fn clamp(v: i32, lo: i32, hi: i32) i32 {
    if (v < lo) {
        return lo;
    }
    if (v > hi) {
        return hi;
    }
    return v;
}

// while 循环
fn sum_to(n: i32) i32 {
    var total: i32 = 0;
    var i: i32 = 1;
    while (i <= n) {
        total = total + i;
        i = i + 1;
    }
    return total;
}

// for 循环
fn factorial(n: i32) i32 {
    var result: i32 = 1;
    for (var i: i32 = 2; i <= n; i = i + 1) {
        result = result * i;
    }
    return result;
}

// 位运算
fn bit_tricks(x: u32) u32 {
    var v: u32 = x;
    v = v | 0x01;      // 置位
    v = v & 0xFF;      // 掩码
    v = v ^ 0x10;      // 翻转
    v = v << 2;        // 左移
    v = v >> 1;        // 右移
    return v;
}

// ── 7. 程序入口 ──────────────────────────────────────────────
fn main() i32 @main {
    var p: Point = Point { x: 3, y: 4 };
    var r: Rect = Rect {
        origin: p,
        width: 10,
        height: 20,
        flags: 0,
    };

    flag_set(r.flags, StatusFlags.active, 1);
    flag_set(r.flags, StatusFlags.level, 7);

    var s: i32 = add(r.origin.x, r.origin.y);
    if (s != 7) {
        return 1;
    }
    return 0;
}

// ── 8. 测试用例 ──────────────────────────────────────────────
"add 应返回两数之和" test {
    expect(add(2, 3) == 5);
}

"clamp 应把值夹在闭区间内" test {
    expect(clamp(15, 0, 10) == 10);
    expect(clamp(-5, 0, 10) == 0);
    expect(clamp(5, 0, 10) == 5);
}

"loops" suite {
    "sum_to 应累加到 n" test {
        expect(sum_to(10) == 55);
    }

    "factorial 应算阶乘" test {
        expect(factorial(5) == 120);
    }
}

"flags" suite {
    "位域读写应往返一致" test {
        var f: StatusFlags = 0;
        flag_set(f, StatusFlags.level, 9);
        flag_set(f, StatusFlags.category, 42);
        var lv: u32 = flag_get(f, StatusFlags.level);
        var cat: u32 = flag_get(f, StatusFlags.category);
        expect(lv == 9);
        expect(cat == 42);
    }

    "单比特位应可置位" test {
        var f: StatusFlags = 0;
        f = f | StatusFlags.visible;
        expect((f & StatusFlags.visible) != 0);
    }
}

"bit_tricks 应返回非零" test {
    var out: u32 = bit_tricks(0x0F);
    expect(out > 0);
}

"待补：跳过示例" test @skip {
    expect(false);
}
