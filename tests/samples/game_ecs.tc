// ═══════════════════════════════════════════════════════════════
// t Language Example: Game Engine ECS Data Definitions
// Demonstrates all major language features per spec
// ═══════════════════════════════════════════════════════════════

import "ecs_core.tc" as ecs;

// ── Compile-time constants (spec 1.1: UPPER_SNAKE_CASE) ─────────

const MAX_RENDER_LAYER: u32 = 16;
const MAX_ENTITIES: u32 = 10000;
const DEFAULT_HP: f32 = 100.0;

// ── Struct with @derive (spec 3.1, 4.3) ─────────────────────────

PlayerComponent struct @derive(Clone, BinarySerde, Eq, DebugPrint) {
    hp: f32 @doc("角色生命值") @export;
    unique_id: u64 @binary_offset(8);
    position_x: f32 @doc("X坐标");
    position_y: f32 @doc("Y坐标");
    is_alive: bool @doc("是否存活");
}

// ── Struct with #soa layout (spec 3.1) ──────────────────────────

TransformComponent #soa struct @derive(Clone, BinarySerde) {
    x: f32 @doc("X坐标");
    y: f32 @doc("Y坐标");
    rotation: f32 @doc("旋转角度");
    scale: f32 @doc("缩放");
}

// ── Enum (spec 3.2) ─────────────────────────────────────────────

EntityCategory enum : u8 @derive(ToString, FromString) {
    Player = 0,
    NPC = 1,
    Enemy = 2,
    Projectile = 3,
    Trigger = 4,
}

// ── Flag / Bitfield (spec 6.2) ──────────────────────────────────

GameStateMask flag[u32] @derive(ToString, FromString, BinarySerde, Eq) {
    move_mode:        2 @doc("移动模式 0~3") @export;
    ai_level:         3 @doc("AI等级 0~7") @export;
    behavior_type:    2 @doc("行为类型 0~3") @export;
    enable_collision: 1 @doc("碰撞开关") @export;
    is_visible:       1 @doc("可见性开关");
    is_frozen:        1 @doc("冻结状态");
}

// ── Flag with @offset (spec 6.3) ────────────────────────────────

CustomProtocolFlag flag[u16] {
    cmd_code: 2 @offset(5) @doc("命令码");
    param_id: 3 @doc("参数ID");
}

// ── Flag Set for large bitfields (spec 6.5) ─────────────────────

LargeEntityTag flag_set @derive(ToString, BinarySerde) {
    faction_id: 4;
    job_type:   5;
    is_boss:    1;
    element:    3;
    rarity:     4;
}

// ── Union (spec 3.3) ────────────────────────────────────────────

PacketData union @derive(BinarySerde) {
    header: u32;
    payload: []u8;
    checksum: u16;
}

// ── Bitpack struct for binary protocol (spec 4.6) ───────────────

ProtocolHeader struct @bitpack(u16) {
    cmd_type: 4;
    length:   6;
    flags:    4;
    reserved: 2;
}

// ── Functions (spec 1.3) ────────────────────────────────────────

app_entry fn() -> i32 @main {
    var state: GameStateMask = 0;
    flag_set(state, GameStateMask.move_mode, 2);
    flag_set(state, GameStateMask.ai_level, 5);
    var ai_val: u32 = flag_get(state, GameStateMask.ai_level);
    return 0;
}

// ── Function with @must_use (spec 4.7) ──────────────────────────

safe_file_read fn(path: string) -> i32 @must_use @unsafe {
    return 0;
}

// ── Function with @inline (spec 4.7) ────────────────────────────

fast_distance fn(x1: f32, y1: f32, x2: f32, y2: f32) -> f32 @inline {
    var dx: f32 = x2 - x1;
    var dy: f32 = y2 - y1;
    return dx * dx + dy * dy;
}

// ── Function with @cfg conditional compilation (spec 4.4) ───────

debug_print_log fn(msg: string) -> void @cfg(debug) {
    // Only compiled in debug mode
}

release_optimize fn() -> void @cfg(release) {
    // Only compiled in release mode
}

// ── Comptime function (spec 5.1) ────────────────────────────────

comptime calc_max_hp fn(base: u32, multiplier: u32) -> u32 @const_fn {
    return base * multiplier;
}

// ── Deprecated function (spec 4.5) ──────────────────────────────

old_calc_api fn() -> u32 @deprecated("请使用 new_calc_api()") {
    return 0;
}

new_calc_api fn() -> u32 {
    return 42;
}

// ── Test cases (spec 4.2) ───────────────────────────────────────

test_flag_basic fn() -> bool @test @test_group("bitfield") {
    var state: GameStateMask = 0;
    flag_set(state, GameStateMask.move_mode, 3);
    var val: u32 = flag_get(state, GameStateMask.move_mode);
    return val == 3;
}

test_flag_overflow fn() -> bool @test @expect_fail @test_group("bitfield") {
    var state: GameStateMask = 0;
    flag_set(state, GameStateMask.move_mode, 4); // 2bit max=3, expect overflow
    return true;
}

test_flag_single_bit fn() -> bool @test @test_group("bitfield") {
    var state: GameStateMask = 0;
    state = state | GameStateMask.enable_collision;
    if ((state & GameStateMask.enable_collision) != 0) {
        return true;
    }
    return false;
}

test_struct_clone fn() -> bool @test @test_group("struct") {
    var player: PlayerComponent = PlayerComponent {
        hp: 100.0,
        unique_id: 42,
        position_x: 10.5,
        position_y: 20.0,
        is_alive: true,
    };
    var cloned: PlayerComponent = player.clone();
    return cloned.hp == 100.0 && cloned.unique_id == 42;
}

test_enum_values fn() -> bool @test @test_group("enum") {
    return EntityCategory.Player == 0 && EntityCategory.Enemy == 2;
}

test_skipped fn() -> bool @test @test_skip @test_group("wip") {
    return false;
}

// ── Global variables (spec 1.1) ─────────────────────────────────

var global_frame_count: u32 = 0;
var global_delta_time: f32 = 0.016;

// ── Type alias ──────────────────────────────────────────────────

EntityId u64;
ComponentMask u32;
