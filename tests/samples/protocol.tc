// ═══════════════════════════════════════════════════════════════
// t Language Minimal Example: Protocol Parser
// Demonstrates core features in a compact file
// ═══════════════════════════════════════════════════════════════

const PACKET_MAGIC: u32 = 0xDEADBEEF;
const MAX_PACKET_SIZE: u16 = 4096;

// Flag for packet flags
PacketFlags flag[u8] {
    compressed: 1 @doc("数据已压缩");
    encrypted:  1 @doc("数据已加密");
    priority:   2 @doc("优先级 0~3");
    channel:    4 @doc("通道号 0~15");
}

// Struct for packet header
PacketHeader struct @derive(Clone, BinarySerde, DebugPrint) {
    magic: u32 @binary_offset(0);
    size: u16 @binary_offset(4);
    flags: PacketFlags @binary_offset(6);
    checksum: u16 @binary_offset(8) @binary_skip;
}

// Enum for packet type
PacketType enum : u8 {
    Handshake = 0,
    Data = 1,
    Ack = 2,
    Error = 3,
    Close = 4,
}

// Entry point
main fn() -> i32 @main {
    var header: PacketHeader = PacketHeader {
        magic: PACKET_MAGIC,
        size: 256,
        flags: 0,
        checksum: 0,
    };

    // Set flag values using flag_set (spec 6.4.2)
    flag_set(header.flags, PacketFlags.priority, 2);
    flag_set(header.flags, PacketFlags.channel, 7);

    // Check single-bit flags (spec 6.4.1: explicit != 0)
    if ((header.flags & PacketFlags.compressed) != 0) {
        return 1;
    }

    return 0;
}

// Test cases
test_packet_flags fn() -> bool @test {
    var flags: PacketFlags = 0;
    flag_set(flags, PacketFlags.priority, 3);
    var pri: u32 = flag_get(flags, PacketFlags.priority);
    return pri == 3;
}

test_single_bit fn() -> bool @test {
    var flags: PacketFlags = 0;
    flags = flags | PacketFlags.encrypted;
    if ((flags & PacketFlags.encrypted) != 0) {
        return true;
    }
    return false;
}
