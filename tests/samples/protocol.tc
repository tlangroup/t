// ═══════════════════════════════════════════════════════════════
// t Language Minimal Example: Protocol Parser
// DIFFTEST-XFAIL(tc0): lex, check, emit-c — tc0 冻结实现不识别新测试语法 "名字" test {} / expect / suite
// Demonstrates core features in a compact file
// ═══════════════════════════════════════════════════════════════

const PACKET_MAGIC: u32 = 0xDEADBEEF;
const MAX_PACKET_SIZE: u16 = 4096;

// Flag for packet flags
packed struct PacketFlags {
    compressed: u1 @doc("数据已压缩");
    encrypted:  u1 @doc("数据已加密");
    priority:   u2 @doc("优先级 0~3");
    channel:    u4 @doc("通道号 0~15");
}

// Struct for packet header
struct PacketHeader @derive(Clone, BinarySerde) {
    magic: u32 @binary_offset(0);
    size: u16 @binary_offset(4);
    flags: PacketFlags @binary_offset(6);
    checksum: u16 @binary_offset(8) @binary_skip;
}

// Enum for packet type
enum PacketType : u8 {
    Handshake = 0,
    Data = 1,
    Ack = 2,
    Error = 3,
    Close = 4,
}

// Entry point
fn main() i32 @main {
    var header: PacketHeader = PacketHeader {
        magic: PACKET_MAGIC,
        size: 256,
        flags: PacketFlags{ compressed: 0, encrypted: 0, priority: 0, channel: 0 },
        checksum: 0,
    };

    // Set flag values using packed struct field access (spec 6.4.2)
    header.flags.priority = 2;
    header.flags.channel = 7;

    // Check single-bit flags (spec 6.4.1: explicit != 0)
    if (header.flags.compressed != 0) {
        return 1;
    }

    return 0;
}

// Test cases
test "优先级位域应往返一致" {
    var flags: PacketFlags = PacketFlags{ compressed: 0, encrypted: 0, priority: 0, channel: 0 };
    flags.priority = 3;
    var pri: u32 = flags.priority as u32;
    expect(pri == 3);
}

test "encrypted 单比特位应可置位" {
    var flags: PacketFlags = PacketFlags{ compressed: 0, encrypted: 0, priority: 0, channel: 0 };
    flags.encrypted = 1;
    expect(flags.encrypted != 0);
}
