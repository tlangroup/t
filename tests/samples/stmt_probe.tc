// stmt_probe: 覆盖 statement 顶层分发的全部分支形态
// if/for/while/return/break/continue/defer/block/var/const/表达式语句

count_evens fn(n: i64) i64 {
    var c: i64 = 0;
    var i: i64 = 0;
    while (i < n) {
        i = i + 1;
        if (i % 2 != 0) {
            continue;
        }
        if (i > 100) {
            break;
        }
        c = c + 1;
    }
    return c;
}

classify fn(x: i64) i64 {
    var r: i64 = 0;
    if (x == 1) {
        r = 10;
    } else if (x == 2) {
        r = 20;
    } else {
        r = 99;
    }
    return r;
}

sum_for fn(n: i64) i64 {
    var s: i64 = 0;
    for (var i: i64 = 0; i < n; i = i + 1) {
        s = s + i;
    }
    return s;
}

main fn() i64 {
    const BASE: i64 = 5;
    var total: i64 = 0;
    defer {
        total = 0;
    }
    {
        var inner: i64 = count_evens(10);
        total = total + inner;
    }
    total = total + classify(1) + classify(2) + classify(7);
    total = total + sum_for(BASE);
    if (total == 5 + 10 + 20 + 99 + 10) {
        println("STMT_OK");
    } else {
        println("STMT_BAD");
    }
    return 0;
}
