// postfix 后缀折叠探针：.成员 / [下标] / (调用) / as 转型 及链式组合
P :: struct {
    x: i64;
    y: i64;
}

Q :: struct {
    p: P;
    vs: []i64;
}

get_p :: func(a: i64, b: i64) -> P {
    var r: P = P{ x: a, y: b };
    return r;
}

sum3 :: func(a: i64, b: i64, c: i64) -> i64 {
    return a + b + c;
}

main :: func() -> i64 {
    var p: P = get_p(3, 4);
    var m: i64 = p.x + p.y;                    // member
    var xs: []i64;
    append(xs, 10);
    append(xs, 20);
    append(xs, 30);
    var i: i64 = xs[1] + xs[2];                // index
    var q: Q = Q{ p: p, vs: xs };
    var chain: i64 = q.p.x + q.vs[0];          // member.member / member[index]
    var c1: i64 = sum3(xs[0], p.y, q.vs[2]);   // call with postfix args
    var gp: i64 = get_p(1, 2).x;               // call().member
    var w: i32 = m as i32;                     // cast
    var w2: i64 = (w as i64) + (xs[1] as i64); // cast in expr
    var total: i64 = m + i + chain + c1 + gp + w2;
    if (total == 142) {
        println("POSTFIX_OK");
    } else {
        println("POSTFIX_BAD");
    }
    return 0;
}
