// DIFFTEST-XFAIL(tc0): lex, check — tc0 冻结实现不识别新方言语法（fn name() 定义、struct 字面量等）
// primary_probe — 表达式基底（fold=prim 生成的 parse_primary）覆盖样本
// 覆盖：十进制/十六进制/二进制整数、浮点、字符串、true/false、括号、标识符、struct 字面量前瞻、数组字面量、嵌套组合

struct P {
    x: i64;
    y: i64;
}

fn pick(b: bool, a: i64, c: i64) i64 {
    if (b) {
        return a;
    }
    return c;
}

fn main() i64 {
    var d: i64 = 42;
    var h: i64 = 0x2A;
    var bn: i64 = 0b101010;
    var f: f64 = 3.5;
    var s: string = "prim";
    var t1: bool = true;
    var t2: bool = false;
    var pr: i64 = (d + h) * (bn - 40);
    var p: P = P { x: 7, y: 8 };
    var xs: []i64;
    append(xs, 100);
    append(xs, 200);
    var lit: [3]u8 = [1, 2, 3];
    var litsum: i64 = (lit[0] as i64) + (lit[2] as i64);
    var combo: i64 = pick(t1, xs[0], xs[1]) + p.x + pick(t2, 1, p.y) + pr;
    if (combo == 283 && litsum == 4 && d == h && h == bn && f > 3.0 && s == "prim") {
        println("PRIMARY_OK");
    } else {
        println("PRIMARY_FAIL");
    }
    return 0;
}
