// S1 标量：混合算术/比较/循环/调用
fn clamp(v: i32, lo: i32, hi: i32) i32 {
    if (v < lo) { return lo; }
    if (v > hi) { return hi; }
    return v;
}
fn main() i64 @main {
    var s: i32 = 0;
    var i: i32 = 0;
    while (i < 10) {
        var t: i32 = i * 3 - 4;
        s = s + clamp(t, 0, 12);
        i = i + 1;
    }
    return s as i64;
}
