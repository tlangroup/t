// 回归复现：LLVM 后端「全局 []string 置空后 append」静默错编（自举二代 OOM 的根因）
// 现象：C 后端打印 "R"，LLVM 后端 g[0] 读到垃圾（len 字段错乱，打印出内存残片）。
// 影响：编译器自身 ll_parse_func 里 `g_pf_params = []` + append(g_pf_params, ...) 命中此路径，
//       故「任何带形参的函数」在 LLVM 后端自举产物上必崩 → g2 编译 src/tc.tc 时 arena OOM。
// 复现：
//   tc compile tests/repro/append_reset_global_slice.tc --emit-c --output <dir>  → clang → 打印 R
//   tc build    tests/repro/append_reset_global_slice.tc --output <dir>          → 打印垃圾
pub var g: []string = ["z"];

fn main() i64 @main {
    g = [];
    append(g, "R");
    println(g[0]);
    return 0;
}
