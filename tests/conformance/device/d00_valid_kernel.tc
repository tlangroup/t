// EXPECT: pass
// 合法 kernel：设备安全子集允许 thread_id / shared_alloc / barrier / atomic_add
// （docs/compiler/device-design.md §8）
kernel fn valid_vec_add(a: dev_ptr[f32], b: dev_ptr[f32], c: dev_ptr[f32], n: i32) void {
    var tid = thread_id(0);
    var sh: shared[f32] = shared_alloc(256);
    sh[tid] = a[tid];
    barrier();
    var s = a[tid] + b[tid];
    atomic_add(&c[tid], s);
}
