// EXPECT: pass
// §set-ops step1：布尔逻辑运算符同时支持两种拼写——
//   `&&` 与 `and` 同为逻辑与；`||` 与 `or` 同为逻辑或。四者在值表达式位完全同义。
// 本用例在运行期逐一验证四种拼写语义一致。
@main fn main() i32 {
    var t: bool = true;
    var f: bool = false;
    // 仅用 and / or
    if (t and t) { } else { return 1; }
    if (t and f) { return 2; }
    if (t or f) { } else { return 3; }
    if (f or f) { return 4; }
    // 仅用 && / ||
    if (t && t) { } else { return 5; }
    if (t && f) { return 6; }
    if (t || f) { } else { return 7; }
    if (f || f) { return 8; }
    // 混合拼写：逻辑等价性
    if ((t and f) || (t && t)) { } else { return 9; }
    if ((f || t) && (t and t)) { } else { return 10; }
    // 嵌套等价：((a && b) or c) 与 ((a and b) or c)
    if ((t && f) || t) { } else { return 11; }
    if ((t and f) || t) { } else { return 12; }
    return 0;
}
