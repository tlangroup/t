// EXPECT: pass
// §set-ops step2：`&&` / `||` 已**不再**是布尔运算符 —— 它们让位给集合交 / 并
// （bool 上使用的报错见 f_setops_bool_intersect.tc / f_setops_bool_union.tc），
// 布尔逻辑只剩关键字拼写 `and` / `or`。
// 本用例在运行期验证布尔逻辑的真值表与组合语义仍然正确。
@main fn main() i32 {
    var t: bool = true;
    var f: bool = false;
    if (t and t) { } else { return 1; }
    if (t and f) { return 2; }
    if (t or f) { } else { return 3; }
    if (f or f) { return 4; }
    // 组合：`and` 优先于 `or`（与 `&&` / `||` 时代的优先级一致）
    if ((t and f) or (t and t)) { } else { return 5; }
    if ((f or t) and (t or f)) { } else { return 6; }
    if ((t and f) or t) { } else { return 7; }
    return 0;
}
