// M57：方法式 str.format 与函数式 format 同义，且可嵌套在调用实参里。
@main
fn main() i64 {
    var a: string = "{0}+{1}".format(1, 2);
    var b: string = "{} {}".format("x", true);
    var c2: string = "[{0:>8.3f}]".format(3.5);
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "n={0}".format(7));
    return 0;
}
