// EXPECT: pass
// bool &&/|| 编译期折叠：choose(true && false) 须在编译期折成 choose(false) → 0。
// 若 && 不折，实参非编译期常量，meta fn 无法在编译期解释 → 编译失败。
meta fn choose(meta c: bool) i64 {
    if (c) { return 1; }
    return 0;
}

fn main() i32 @main {
    var a: i64 = choose(true && false);   // false → 0
    var b: i64 = choose(false || true);   // true  → 1
    if (a == 0 && b == 1) {
        return 0;
    }
    return 1;
}
