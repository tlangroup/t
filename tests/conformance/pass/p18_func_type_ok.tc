// EXPECT: pass
// 函数类型（FuncType）合法用法：`fn(ArgTypes) Ret` 作为一等值类型。
// v1 语义 = 函数指针：只有顶层具名函数可以绑定，不捕获环境（无闭包）。

add fn(a: i64, b: i64) i64 { return a + b; }
sub fn(a: i64, b: i64) i64 { return a - b; }
tag fn(s: string) string { return s; }

// ① 作为参数类型（高阶函数）
apply2 fn(f: fn(i64, i64) i64, a: i64, b: i64) i64 {
    return f(a, b);
}

// ② 作为返回类型
choose fn(want_add: bool) fn(i64, i64) i64 {
    if (want_add) {
        return add;
    }
    return sub;
}

// ③ 作为结构体字段类型
Ops struct {
    op: fn(i64, i64) i64;
}

// ④ 作为全局变量类型
var g_op: fn(i64, i64) i64 = add;

@main
main fn() i64 {
    // ⑤ 局部绑定 + 重新绑定 + 间接调用
    var f: fn(i64, i64) i64 = add;
    var r: i64 = f(1, 2);
    f = sub;
    r = r + f(5, 3);
    r = r + apply2(add, 4, 4);
    var g: fn(i64, i64) i64 = choose(false);
    r = r + g(9, 1);
    r = r + g_op(2, 2);
    // ⑥ 非 i64 签名
    var h: fn(string) string = tag;
    println(h("ok"));
    return r - r;
}
