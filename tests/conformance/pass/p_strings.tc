// EXPECT: pass
// P2：std.strings 字符串工具（语义层接受）。
// 运行期正确性由 examples/string_utils.tc 在双后端守卫；此处仅确认语义检查通过。
@import("std.strings");

fn use_strings() string {
    var s: string = strings.trim("  hi  ");
    s = strings.to_upper(s);
    var parts: []string = strings.split("a,b,c", ",");
    return strings.join(parts, "-") + strings.repeat(s, 2);
}

fn use_search() bool {
    return strings.starts_with("hello", "he")
        && strings.ends_with("hello", "lo")
        && strings.contains("hello", "ell")
        && strings.index_of("hello world", "world") == 6
        && strings.count("a-b-c", "-") == 2;
}

fn use_pad() string {
    return strings.pad_start("42", 5, "0") + strings.pad_end("42", 5, "*") + strings.replace("a-b", "-", "+");
}
