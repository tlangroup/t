// EXPECT: pass
// M5 / P2：union 字面量类型身份修复。
// 修复前 `var u: U = U{ .a = 1 }` 报 T-SEM-E202（expected U but got U）——
// 根因是 union 字面量（与 struct 字面量共享 struct_lit 节点）被推断为
// ti_named("Struct", "U")，与期望的 ti_named("Union", "U") 同名但 kind 不同。
// 修复后类型身份按声明种类返回（UnionDecl → Union TI），字面量正常通过类型检查。
// 注：C 后端 union 字面量生成合法 `(U){.a = 1}`；LLVM 后端 union 表示目前为占位桩
// （tir.tc:1477，影响所有 union 用法），属独立后端 epic，不在本节点范围。
union U { a: i64; b: f64; }
union R { as_i: i64; as_u: u64; as_f: f64; }

fn main() i32 @main {
    var u: U = U{ .a = 1 };
    var v: U = U{ .b = 2.5 };
    var r: R = R{ .as_u = 7 };
    if (u.a == 1 && v.b > 2.0 && r.as_u == 7) { return 0; }
    return 1;
}
