// EXPECT: pass
// 常数枚举成员间引用：同枚举显式引用、前向引用、跨枚举引用、引用自动编号成员。
comptime fn sq(n: i64) i64 { return n * n; }

enum Arith { A = 10, B = Arith.A + 5, C = 20 + 30 }

enum Fwd { X = Fwd.Y * 2, Y = 3 }

enum Other { Base = 100 }

enum Cross { P = Other.Base + 7, Q = Arith.B + 1, R = sq(2) }

enum AutoRef { A0, A1 = AutoRef.A0 + 10, A2 }

@main
fn main() i32 {
    var s: i64 = Arith.A as i64 + Arith.B as i64 + Arith.C as i64;
    var f: i64 = Fwd.X as i64 + Fwd.Y as i64;
    var c: i64 = Cross.P as i64 + Cross.Q as i64 + Cross.R as i64;
    var a: i64 = AutoRef.A0 as i64 + AutoRef.A1 as i64 + AutoRef.A2 as i64;
    return 0;
}
