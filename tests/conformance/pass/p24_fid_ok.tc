// EXPECT: pass
// fid：文件描述符句柄（64 位标量）。stdin/stdout/stderr 为内建常量（0/1/2）。
// `<` 在左操作数为 fid 时是序列化操作符，返回目标 fid，故可左结合链式书写。

// fid 可作参数与返回值
pick fn(use_err: bool) fid {
    if (use_err) { return stderr; }
    return stdout;
}

// 链式写出：`f < a < b` == `(f < a) < b`，每步返回目标 fid
dump fn(f: fid, name: string, v: i64) fid {
    return f < name < "=" < v < "\n";
}

main fn() i64 {
    // 内建常量
    var o: fid = stdout;
    var e: fid = stderr;
    var i: fid = stdin;

    // 序列化各标量与 string
    o < "hello\n";
    o < 42;
    o < 3.5;
    o < true;
    o < :ok;

    // 链式 + 表达式做左操作数
    dump(o, "n", 7);
    pick(false) < "via call\n";

    // 打开 / 关闭 / 状态查询
    var f: fid = fopen("out.txt", :write);
    if (fid_is_open(f)) {
        f < "line\n";
        fflush(f);
        fclose(f);
    }

    // 二进制打开 + 后缀挂靠注册
    fmt_register(:binary, "bin", :rawbin);
    var g: fid = fopen("blob.bin", :write_binary);
    g < 1 < 2.0 < "s";
    fclose(g);

    // fid_format 返回 atom
    var fm: atom = fid_format(o);
    var fs: string = atom_str(fm);

    // fid 判等（无序，但可判身份）
    var same: bool = o == stdout;
    var diff: bool = o != stderr;

    // fid 是 64 位标量，可转 i64
    var h: i64 = o as i64;
    return 0;
}
