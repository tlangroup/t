// EXPECT: pass
// 解构绑定（destructuring binding）：struct 字面量模式中的 ident 字段须被 sema 接受
// （绑定为臂内局部），而非误判为未定义标识符（T-SEM-E001）。运行时双后端正确性见
// examples/tuple_destructure_demo.tc。
struct Pt { x: i64; y: i64; }

fn f(p: Pt) i64 {
    return match (p) {
        Pt{ x: 0, y: 0 } => 1,
        Pt{ x: a, y: 0 } => a,
        Pt{ x: 0, y: b } => b,
        Pt{ x: a, y: b } => a + b,
        _ => 0,
    };
}
