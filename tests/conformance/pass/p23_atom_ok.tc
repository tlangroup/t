// EXPECT: pass
// atom：Erlang 式全局原子。字面量 :name 编译期 intern 为进程内唯一的 1-based i64，
// 名字表由编译器发射为全局 t_atom_table[]，atom_str(a) 从中还原名字。

// 具名返回 atom
kind fn(n: i64) atom {
    if (n == 0) { return :ok; }
    if (n == 1) { return :error; }
    return :unknown;
}

// atom 作参数、参与整数身份比较
same fn(a: atom, b: atom) bool {
    return a == b;
}

// match 对 atom 做模式分发（arm body 为单表达式）
label fn(a: atom) string {
    return match (a) {
        :ok     => "ok"
        :error  => "error"
        _       => "other"
    };
}

main fn() i64 {
    var a: atom = :ok;
    var b: atom = :ok;
    var c: atom = :error;

    // 同名字面量 intern 到同一 id
    var eq: bool = same(a, b);
    var ne: bool = same(a, c);

    // 全局名表还原
    var n1: string = atom_str(a);
    var n2: string = atom_str(kind(1));
    var n3: string = atom_str(:brand_new);

    var l: string = label(c);

    // atom 是 64 位标量，可当整数 id 使用
    var id: i64 = a as i64;
    return 0;
}
