// EXPECT: pass
// match 穷尽性覆盖分析（A1 裁定）：scrutinee 为 enum 且每个成员都被一条
// 无守卫的 `E.Case` 臂覆盖时，视为穷尽，`_` 通配臂变为可选。
// 同时验证：带 `_` 兜底、带绑定臂兜底两种旧写法仍然合法。

Color enum : u8 {
    Red,
    Green,
    Blue,
}

// 全成员覆盖，无 `_` —— A1 之后应通过
name_of fn(c: Color) string {
    return match (c) {
        Color.Red => "red"
        Color.Green => "green"
        Color.Blue => "blue"
    };
}

// 部分覆盖 + `_` 通配兜底 —— 一直合法
short_of fn(c: Color) string {
    return match (c) {
        Color.Red => "r"
        _ => "?"
    };
}

// 部分覆盖 + 无守卫绑定臂兜底 —— 一直合法
rank_of fn(c: Color) i64 {
    return match (c) {
        Color.Red => 1
        other => 9
    };
}

// 全覆盖 + 额外的带守卫臂：守卫臂不参与覆盖计算，但不影响已全覆盖的结论
pick fn(c: Color, hi: bool) i64 {
    return match (c) {
        Color.Red when hi => 100
        Color.Red => 1
        Color.Green => 2
        Color.Blue => 3
    };
}

@main
main fn() i64 {
    println(name_of(Color.Green));
    println(short_of(Color.Blue));
    println(int_to_str(rank_of(Color.Red)));
    println(int_to_str(pick(Color.Red, true)));
    return 0;
}
