// EXPECT: pass
// M5 / P1 反向守卫：**合法**成员名不得被 T-SEM-E216 误报。
// 三类类型（enum / flag / variant）的合法成员访问 + 构造，必须仍然零诊断。
enum Dir : u8 {
    North = 0,
    East = 1,
}

flag Bits[u16] {
    on: 1;
    kind: 4;
}

variant Shape {
    Circle(f64);
    Empty;
}

fn main() i32 @main {
    var d: Dir = Dir.East;
    var f: Bits = 0;
    flag_set(f, Bits.kind, 9);
    var k: u32 = flag_get(f, Bits.kind);
    var s: Shape = Shape.Circle(1.0);
    var e: Shape = Shape.Empty;
    var lit: Shape = Shape { .Circle(1.0) };
    var lit2: Shape = Shape { .Empty };
    if (d == Dir.East && k == 9) { return 0; }
    return 1;
}
