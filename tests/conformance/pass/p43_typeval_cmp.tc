// EXPECT: pass
// P4 类型即值（值半部）：@type_val("X") 产出编译期类型值，可在 CTFE 下比较。
// 证明：@type_val("i64") == @type_val("i64") 折为 true；与 "u32" 比较折为 false。
// 该特性与 Module/import 单态化零耦合，是后续独立泛型驱动器的底座。

comptime fn same_t() bool { return @type_val("i64") == @type_val("i64"); }
comptime fn diff_t() bool { return @type_val("i64") == @type_val("u32"); }

@main fn main() i32 {
    if (same_t() == false) { return 1; }
    if (diff_t() == true)  { return 2; }
    return 0;
}
