// tests/conformance/pass/p_math_stdlib.tc
// 验证 std.math 浮点封装（薄封装底层编译期内建）可被类型检查 + 编译。
// 不依赖具体数值精度，仅断言关键不变量，确保 API 形态稳定。
// 覆盖 f64（sin/cos/...）与 f32（sinf/cosf/...）两套。
// EXPECT: pass
@import("std.math");

fn main_fn() i32 @main {
    // —— f64 ——
    if (math.fabs(-3.5) != 3.5) { return 1; }
    if (math.floor(2.7) != 2.0) { return 2; }
    if (math.ceil(2.1) != 3.0) { return 3; }
    if (math.trunc(-2.9) != -2.0) { return 4; }
    if (math.sqrt(4.0) != 2.0) { return 5; }
    if (math.cbrt(8.0) != 2.0) { return 6; }
    if (math.pow(2.0, 10.0) < 1023.0 or math.pow(2.0, 10.0) > 1025.0) { return 7; }
    if (math.hypot(3.0, 4.0) != 5.0) { return 8; }
    if (math.fmin_f(1.0, 2.0) != 1.0) { return 9; }
    if (math.fmax_f(1.0, 2.0) != 2.0) { return 10; }
    if (math.exp(0.0) != 1.0) { return 11; }
    if (math.log(2.718281828459045) < 0.999 or math.log(2.718281828459045) > 1.001) { return 12; }
    if (math.log2(8.0) < 2.999 or math.log2(8.0) > 3.001) { return 13; }
    if (math.log10(100.0) < 1.999 or math.log10(100.0) > 2.001) { return 14; }
    if (math.log1p(0.0) != 0.0) { return 15; }
    if (math.expm1(0.0) != 0.0) { return 16; }
    if (math.sin(0.0) != 0.0) { return 17; }
    if (math.cos(0.0) != 1.0) { return 18; }
    if (math.tan(0.0) != 0.0) { return 19; }
    if (math.asin(0.0) != 0.0) { return 20; }
    if (math.acos(1.0) != 0.0) { return 21; }
    if (math.atan(0.0) != 0.0) { return 22; }
    if (math.atan2(0.0, 1.0) != 0.0) { return 23; }
    if (math.sinh(0.0) != 0.0) { return 24; }
    if (math.cosh(0.0) != 1.0) { return 25; }
    if (math.tanh(0.0) != 0.0) { return 26; }

    // —— f32（名加 f 后缀，与底层 @sinf/@cosf/... 对应；注意用 f32 字面量 1.0f32）——
    if (math.fabsf(-3.5f32) != 3.5f32) { return 27; }
    if (math.sqrtf(4.0f32) != 2.0f32) { return 28; }
    if (math.cbrtf(8.0f32) != 2.0f32) { return 29; }
    if (math.powf(2.0f32, 10.0f32) < 1023.0f32 or math.powf(2.0f32, 10.0f32) > 1025.0f32) { return 30; }
    if (math.hypotf(3.0f32, 4.0f32) != 5.0f32) { return 31; }
    if (math.sinf(0.0f32) != 0.0f32) { return 32; }
    if (math.cosf(0.0f32) != 1.0f32) { return 33; }
    if (math.tanf(0.0f32) != 0.0f32) { return 34; }
    if (math.asinf(0.0f32) != 0.0f32) { return 35; }
    if (math.acosf(1.0f32) != 0.0f32) { return 36; }
    if (math.atanf(0.0f32) != 0.0f32) { return 37; }
    if (math.atan2f(0.0f32, 1.0f32) != 0.0f32) { return 38; }
    if (math.sinhf(0.0f32) != 0.0f32) { return 39; }
    if (math.coshf(0.0f32) != 1.0f32) { return 40; }
    if (math.tanhf(0.0f32) != 0.0f32) { return 41; }
    if (math.expf(0.0f32) != 1.0f32) { return 42; }
    if (math.logf(1.0f32) != 0.0f32) { return 43; }
    if (math.log2f(8.0f32) < 2.999f32 or math.log2f(8.0f32) > 3.001f32) { return 44; }
    if (math.log10f(100.0f32) < 1.999f32 or math.log10f(100.0f32) > 2.001f32) { return 45; }

    // 整数工具仍可用（ilog2 为重命名后的整数以 2 为底对数）
    if (math.ilog2(8 as u64) != 3) { return 46; }
    if (math.gcd(12, 18) != 6) { return 47; }
    return 0;
}
