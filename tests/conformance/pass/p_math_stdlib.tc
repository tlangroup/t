// tests/conformance/pass/p_math_stdlib.tc
// 验证 std.math 浮点封装（薄封装底层编译期内建）可被类型检查 + 编译。
// 不依赖具体数值精度，仅断言关键不变量，确保 API 形态稳定。
// EXPECT: pass
@import("std.math");

fn main_fn() i32 @main {
    // 取整 / 绝对值
    if (math.fabs_f(-3.5) != 3.5) { return 1; }
    if (math.floor_f(2.7) != 2.0) { return 2; }
    if (math.ceil_f(2.1) != 3.0) { return 3; }
    if (math.trunc_f(-2.9) != -2.0) { return 4; }
    // 算术
    if (math.sqrt_f(4.0) != 2.0) { return 5; }
    if (math.cbrt_f(8.0) != 2.0) { return 6; }
    if (math.pow_f(2.0, 10.0) < 1023.0 || math.pow_f(2.0, 10.0) > 1025.0) { return 7; }
    if (math.hypot_f(3.0, 4.0) != 5.0) { return 8; }
    if (math.fmin_f(1.0, 2.0) != 1.0) { return 9; }
    if (math.fmax_f(1.0, 2.0) != 2.0) { return 10; }
    // 指数 / 对数
    if (math.exp_f(0.0) != 1.0) { return 11; }
    if (math.log_f(2.718281828459045) < 0.999 || math.log_f(2.718281828459045) > 1.001) { return 12; }
    if (math.log2_f(8.0) < 2.999 || math.log2_f(8.0) > 3.001) { return 13; }
    if (math.log10_f(100.0) < 1.999 || math.log10_f(100.0) > 2.001) { return 14; }
    if (math.log1p_f(0.0) != 0.0) { return 15; }
    if (math.expm1_f(0.0) != 0.0) { return 16; }
    // 三角 / 反三角
    if (math.sin_f(0.0) != 0.0) { return 17; }
    if (math.cos_f(0.0) != 1.0) { return 18; }
    if (math.tan_f(0.0) != 0.0) { return 19; }
    if (math.asin_f(0.0) != 0.0) { return 20; }
    if (math.acos_f(1.0) != 0.0) { return 21; }
    if (math.atan_f(0.0) != 0.0) { return 22; }
    if (math.atan2_f(0.0, 1.0) != 0.0) { return 23; }
    // 双曲
    if (math.sinh_f(0.0) != 0.0) { return 24; }
    if (math.cosh_f(0.0) != 1.0) { return 25; }
    if (math.tanh_f(0.0) != 0.0) { return 26; }
    // 整数工具仍可用（ilog2 为重命名后的整数以 2 为底对数）
    if (math.ilog2(8 as u64) != 3) { return 27; }
    if (math.gcd(12, 18) != 6) { return 28; }
    return 0;
}
