// P4: @field (comptime field access by name) and @call (comptime call by value).
// EXPECT: pass
//
// @field 作用于编译期结构体值（struct_lit，字段挂在 FV 链上），按名取字段值；
// @call 就地造 call 节点复用既有编译期调用路径。
//
// 已知后端差异（均已实测确认，非静默失败）：
//   · @field 取「结构体字面量」时 LLVM 与 C 两后端都正确折叠；
//     取 comptime fn 内的**局部 var** 时 C 后端路径不折叠（LLVM 折叠正常），
//     故本测试统一用字面量形式。
//   · @call 当前 LLVM 后端正确，C 后端不折叠（会下发 /* unsupported expr */ 并链接失败）。
//     conformance 走 LLVM 后端，故本用例在门禁内仍为有效覆盖；
//     C 后端的编译期调用折叠待后续专项跟进。
//
// ⚠ @field_parent_ptr 暂无实现：它本质是指针运算（container_of —— 由成员地址反推
//   容器地址），地址不是编译期可知量，必须新增两个后端的运行期发射。此处不伪实现。

struct Pt { x: i32; y: i32; }

comptime fn add2(a: i32, b: i32) i32 {
    return a + b;
}

comptime fn p43_checks() bool {
    // @field: 按名取字段值（字面量形式 —— 两后端都能折叠）
    if (@field(Pt { x: 10, y: 20 }, "x") != 10) { return false; }
    if (@field(Pt { x: 10, y: 20 }, "y") != 20) { return false; }
    // @call: 按值调用编译期函数
    if (@call(add2, 3, 4) != 7) { return false; }
    return true;
}

@main
fn main() i32 {
    if (comptime p43_checks() == false) { return 1; }
    return 0;
}
