// EXPECT: pass
// int_to_str(v: i64) string：整数转十进制文本内建，C 后端映射 t_int_to_str，
// LLVM 后端经 tll_int_to_str 指针桥返回 %TStr（不再发射 UNSUPPORTED）。

@main
fn main() i64 {
    var x: i64 = 42;
    var s: string = int_to_str(x);
    var neg: string = int_to_str(0 - 7);
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, s);
    sb_append_str(sb, neg);
    sb_append_str(sb, int_to_str(slice_len(args()) as i64));
    return str_len(sb_to_str(sb)) as i64;
}
