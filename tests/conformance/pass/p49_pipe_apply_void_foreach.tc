// EXPECT: pass
// 新语义（用户需求「加简写 + 让 |> 逐元素」）：`|>` 作为整体/逐元素应用算子，
// 当右侧为一元函数且返回 void 时，逐元素应用被合法降级为 for-each 副作用遍历
// （等价于 `for (x in xs) { show(x); }`）。`|->`（map，逐元素变换）仍禁止 void 返回。
fn show(v: i32) void { print(f"{v} "); }
fn main() i32 @main {
    var xs: []i32 = [1, 2, 3];
    // 命名 void 函数 + `|>`：降级为 for-each
    xs |> show;
    // 区间 + 闭包简写 `|v: T| expr`：`|>` 逐元素遍历
    (1..4) |> |v: i64| print(f"{v} ");
    print("\n");
    return 0;
}
