// EXPECT: pass
// P2：std.sort 泛型排序 + 比较器回调（语义层接受）。
// 运行期正确性由 examples/sort_demo.tc 在双后端守卫；此处仅确认语义检查通过。
@import("std.sort");

fn greater_i64(a: i64, b: i64) bool { return a > b; }

fn use_sort() []i64 {
    var xs: []i64;
    append(xs, 5); append(xs, 2); append(xs, 9);
    sort.sort_slice(i64, xs, sort.less_i64);
    return xs;
}

fn use_string_sort() []string {
    var names: []string;
    append(names, "banana"); append(names, "apple");
    sort.sort_slice(string, names, sort.less_string);
    return names;
}
