// EXPECT: pass
// spec §4: enum 显式底层类型 + 显式值 + 成员访问比较
Dir :: enum : u8 {
    North = 0,
    East = 1,
    South = 2,
    West = 3,
}

is_east :: func(d: Dir) -> bool {
    return d == Dir.East;
}

main :: func() -> i32 @main {
    var d: Dir = Dir.East;
    if (is_east(d)) {
        return 0;
    }
    return 1;
}
