// EXPECT: pass
// 原 f99（T-RNG-E873）反向用例：`[N]T` 区间索引曾因 Array→Slice 构造降解缺失被显式拒绝。
// 现在 cast lowering（t_slice_from_raw / @tll_slice_from_raw）已落地，
// `a[lo..hi]` 会先降级成零拷贝切片视图再走 slice_sub，故转为正向用例。
fn main() i32 @main {
    var a: [5]i64 = [1, 2, 3, 4, 5];
    var s: []i64 = a[1..3];
    var t: []i64 = a[2..];
    var u: []i64 = a[..4];
    return 0;
}
