// EXPECT: pass
// A1a：!j 聚合 JSON 编码 + 泛型单态化脱糖（语义层接受）。
// 运行期发射正确性由 examples/fstring_json.tc 在双后端守卫；此处仅确认语义检查通过。
struct Point {
    x: i64;
    y: i64;
}

// 泛型函数体内 !j：脱糖延迟到实例（类型已具体）再发生，编译期单态化泛型值。
fn show(comptime T: type, v: T) string {
    return f"{v!j}";
}

fn use_json() string {
    var p: Point = Point{ x: 1, y: 2 };
    var s: []i64 = [1, 2, 3];
    var a: [3]i64 = [4, 5, 6];
    return f"{p!j}|{s!j}|{a!j}";
}

fn use_generic() string {
    var p: Point = Point{ x: 7, y: 8 };
    return show(Point, p);
}
