// EXPECT: pass
// P2：std.sort.binary_search 二分查找（语义层接受）。
// 运行期正确性由 examples/bsearch_demo.tc 在双后端守卫；此处仅确认语义检查通过。
@import("std.sort");

fn use_bsearch() i64 {
    var xs: []i64;
    append(xs, 3); append(xs, 1); append(xs, 2); append(xs, 5);
    sort.sort_slice(i64, xs, sort.less_i64);
    return sort.binary_search(i64, xs, 2, sort.less_i64);
}

fn use_string_bsearch() i64 {
    var names: []string;
    append(names, "apple"); append(names, "banana");
    sort.sort_slice(string, names, sort.less_string);
    return sort.binary_search(string, names, "apple", sort.less_string);
}
