// EXPECT: pass
// 匿名函数字面量（FuncType v2a）：表达式位置的 `fn (params) -> Ret { ... }`
// 被提升为顶层合成函数，其值即函数指针，可存变量 / 传参 / 作返回值 / 存全局 / 存字段。
// 不捕获外层局部变量——字面量体内只能用自己的形参、全局符号与内建。

var g_scale: i64 = 3;

// 全局函数类型变量直接绑定字面量
var g_op: fn(i64, i64) -> i64 = fn (a: i64, b: i64) -> i64 { return a + b; };

Holder struct {
    op: fn(i64) -> i64;
}

// 函数类型作参数
apply1 fn(f: fn(i64) -> i64, x: i64) -> i64 {
    return f(x);
}

// 函数类型作返回值：直接返回字面量
make_scaler fn() -> fn(i64) -> i64 {
    return fn (x: i64) -> i64 { return x * g_scale; };
}

use_it fn() -> i64 {
    // 局部绑定 + 间接调用
    var inc: fn(i64) -> i64 = fn (x: i64) -> i64 { return x + 1; };
    var a: i64 = inc(1);

    // 重绑定为另一个字面量（同签名）
    inc = fn (x: i64) -> i64 { return x + 2; };
    var b: i64 = inc(1);

    // 字面量直接作实参
    var c: i64 = apply1(fn (x: i64) -> i64 { return 0 - x; }, 5);

    // 字面量作返回值
    var s: fn(i64) -> i64 = make_scaler();
    var d: i64 = s(4);

    // 存进结构体字段
    var h: Holder;
    h.op = fn (x: i64) -> i64 { return x * x; };
    var e: i64 = h.op(3);

    // 全局函数类型变量
    var f: i64 = g_op(1, 2);

    return a + b + c + d + e + f;
}
