// EXPECT: pass
// 枚举成员编译期求值：Dir.East 须在编译期折成整值 1，否则 comptime fn 无法在编译期
// 解释其函数体（EXPECT: pass 即证明折叠生效）。枚举类型本身暂不作为 comptime 值参数
// （仅整数族 / bool / string），故在 comptime fn 内做枚举成员之间的编译期比较。
enum Dir : u8 {
    North = 0,
    East = 1,
    South = 2,
    West = 3,
}

comptime fn east_known() bool {
    return Dir.East == Dir.East;   // 1 == 1 → true
}

comptime fn west_known() bool {
    return Dir.West == Dir.East;   // 3 == 1 → false
}

fn main() i32 @main {
    var a: bool = east_known();
    var b: bool = west_known();
    if (a == true and b == false) {
        return 0;
    }
    return 1;
}
