// EXPECT: pass
// 常数枚举：成员显式赋值支持字面量、编译期算术、const 引用与 comptime fn 调用。
// 每个成员都是编译期常量，双后端发射一致的整型值。
comptime fn sq(n: i64) i64 { return n * n; }

const K: i64 = 7;

enum Color : u8 {
    Red = 1,
    Green = 2,
    Blue = 3,
}

enum Arith {
    A = 10,
    C = 20 + 30,
}

enum Ref {
    X = K,
    Y = K * 3,
}

enum Pow {
    P1 = sq(1),
    P2 = sq(4),
    P3 = sq(9),
    P4,
}

@main
fn main() i32 {
    var _r: i64 = Color.Red as i64 + Color.Green as i64 + Color.Blue as i64;
    var _a: i64 = Arith.A as i64 + Arith.C as i64;
    var _x: i64 = Ref.X as i64 + Ref.Y as i64;
    var _p: i64 = Pow.P1 as i64 + Pow.P2 as i64 + Pow.P3 as i64 + Pow.P4 as i64;
    return 0;
}
