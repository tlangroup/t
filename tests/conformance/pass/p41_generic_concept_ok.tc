// EXPECT: pass
// #4b 泛型函数语法：无约束 T 推断 + 概念约束 T:HasName + 结构化满足检查。
concept HasName {
    fn name(self) string;
    age: i64;
}

struct Person {
    name: string;
    age: i64;
    fn name(self: Person) string {
        return self.name;
    }
}

fn id(T, x: T) T {
    return x;
}

fn greet(T:HasName, x: T) string {
    return x.name;
}

fn show_age(T:HasName, x: T) i64 {
    return x.age;
}

@main fn main() i32 {
    var p: Person = Person{ .name = "alice", .age = 30 };
    var a: i64 = id(42);
    var g: string = greet(p);
    var ag: i64 = show_age(p);
    if (a != 42) { return 1; }
    if (g != "alice") { return 2; }
    if (ag != 30) { return 3; }
    return 0;
}
