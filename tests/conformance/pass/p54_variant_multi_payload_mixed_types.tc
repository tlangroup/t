// EXPECT: pass
// 多载荷混合类型：载荷类型不必同构，按声明序逐字段绑定；单元 case 仍写裸名。
variant Rec {
    None;
    Pair(i64, bool);
    Trip(i64, bool, i64);
}

fn score(r: Rec) i64 {
    return match (r) {
        .None => 0
        .Pair(n, ok) => n
        .Trip(a, ok, b) => a + b
    };
}

@main
fn main() i64 {
    var p: Rec = Rec { .Pair(7, true) };
    return score(p) - 7;
}
