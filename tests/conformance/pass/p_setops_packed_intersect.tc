// EXPECT: pass
// §set-ops §13.3：位域（packed struct）的 `&` = 集合交（宿主整型 AND）。
// 两侧必须是**同一个**位域类型（名义类型，位宽由布局定死）。
// 本例只做类型检查（conformance pass 用例不运行程序）；运行期语义由
// examples/setops_packed.tc 的 golden 覆盖。
packed struct Perm {
    readable: u1;
    writable: u1;
    level:    u4;
    owner_id: u8;
}
@main fn main() i32 {
    var a: Perm = Perm{ readable: 1, writable: 0, level: 7, owner_id: 42 };
    var b: Perm = Perm{ readable: 1, writable: 1, level: 3, owner_id: 42 };
    var c: Perm = a & b;
    var d: Perm = (a & b) & a;
    return 0;
}
