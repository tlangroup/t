// EXPECT: pass
// 定位内建：
//   fseek fn(f: fid, off: i64) bool  —— 成功 true；负偏移 / 不可定位 / 已关闭返 false
//   ftell fn(f: fid) i64             —— 当前偏移；不可定位返 -1
// 二者均**不 panic**，失败原因经 fid_error 显式取（L-02 / L-09）。

fn at(f: fid) i64 {
    return ftell(f);
}

fn main() i64 {
    var f: fid = fopen("out.txt", :write);
    if (fid_is_open(f)) {
        f < "abcdef";
        var p0: i64 = ftell(f);

        // 回到开头，覆盖写
        var ok: bool = fseek(f, 0);
        if (ok) {
            f < "Z";
        }

        // 偏移可以是任意整型表达式
        var ok2: bool = fseek(f, p0 - 1);
        var ok3: bool = fseek(f, 2 + 3);

        var p1: i64 = at(f);
        fclose(f);

        // 已关闭句柄：返回失败值而非 panic
        var ok4: bool = fseek(f, 0);
        var p2: i64 = ftell(f);
        var why: string = fid_error(f);
    }

    // 标准流不可定位：同样只是返回 false / -1
    var so: bool = fseek(stdout, 0);
    var sp: i64 = ftell(stdin);
    return 0;
}
