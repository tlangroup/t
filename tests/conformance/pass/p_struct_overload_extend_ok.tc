// EXPECT: pass
// struct-modifiers Task #3：overload struct + extend overload struct（同文件合并）
// 验证：extend 字段并入 overload 组、方法可在 extend 中声明、_ 锚点为纯语法标记。
overload struct Entity {
    id: u64;
    pos: i64;
    _;            // 扩展锚点（纯语法标记，不占空间）
}

extend overload struct Entity {
    tag: u32;
    fn describe(self: Entity) string {
        return "e";
    }
}

fn use_entity(e: Entity) i32 {
    if (e.id != 1) { return 1; }
    if (e.pos != 2) { return 2; }
    if (e.tag != 3) { return 3; }   // extend 追加字段已并入
    if (e.describe() != "e") { return 4; }
    return 0;
}

@main fn main() i32 {
    var e: Entity;
    e.id = 1;
    e.pos = 2;
    e.tag = 3;
    return use_entity(e);
}
