// EXPECT: pass
// M-M：struct 体内方法声明语法糖。
//   Box struct { v: i64;  bump fn(self: Self, d: i64) Self {...} }
// 脱糖为顶层自由函数 `box_bump fn(self: Box, d: i64) Box {...}`
// （函数名 = snake(struct名) + "_" + 方法名；类型 `Self` 全部改写为宿主 struct 名）。
// 字段与方法可任意交错书写；无 self 形参的「静态方法」同样脱糖为自由函数。
struct Box {
    v: i64;

    fn make(v0: i64) Self {
        var b: Self;
        b.v = v0;
        return b;
    }

    fn bump(self: Self, d: i64) Self {
        self.v = self.v + d;
        return self;
    }

    tag: string;

    fn get(self: Self) i64 {
        return self.v;
    }

    fn label(self: Self, t: string) Box {
        self.tag = t;
        return self;
    }
}

@main
fn main() i64 {
    var b: Box = box_make(1);
    b = box_bump(b, 41);
    b = box_label(b, "answer");
    if (box_get(b) != 42) { return 1; }
    return 0;
}
