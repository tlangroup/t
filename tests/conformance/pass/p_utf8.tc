// EXPECT: pass
// P2：std.utf8 UTF-8 ↔ 码点转换（语义层接受）。
// 运行期正确性由 examples/utf8_demo.tc 在双后端守卫；此处仅确认语义检查通过。
@import("std.utf8");

fn use_utf8() i64 {
    var s: string = "Hi你Go";
    var cps: []i64 = utf8.utf8_decode(s);
    var back: string = utf8.utf8_encode(cps);
    return utf8.rune_count(back);
}

fn use_utf8_4byte() i64 {
    var emo: []i64;
    append(emo, 128512);
    var e: string = utf8.utf8_encode(emo);
    var ed: []i64 = utf8.utf8_decode(e);
    return ed[0];
}
