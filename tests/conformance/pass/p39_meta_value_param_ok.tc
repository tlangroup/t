// EXPECT: pass
// M-meta Phase C：值参数单态化的全部合法形态。
// comptime 形参按声明类型分流：`type`/`any` 是类型参数，其余（整数族 / bool /
// string）是值参数 —— 实参在调用点 CTFE 求值成字面量后代入实例。

// ① 整数值参数进类型位：`[N]i64` 的长度要求 int 字面量节点
fn sum_sq(meta N: i64) i64 {
    var b: [N]i64;
    var i: i64 = 0;
    while (i < N) { b[i] = i * i; i = i + 1; }
    var s: i64 = 0;
    var j: i64 = 0;
    while (j < N) { s = s + b[j]; j = j + 1; }
    return s;
}

// ② 字符串值参数 + 整数值参数
fn repeat(meta s: string, meta n: i64) string {
    var sb: StringBuilder = sb_new();
    var i: i64 = 0;
    while (i < n) { sb_append_str(sb, s); i = i + 1; }
    return sb_to_str(sb);
}

// ③ bool 值参数：替换后分支在编译期已定
fn pick(meta B: bool, a: i64, b: i64) i64 {
    if (B) { return a; }
    return b;
}

// ④ 实例体内的 `meta` 表达式：值代入后编译期折叠
fn tagged(meta N: i64, x: i64) i64 {
    var base: i64 = meta N * 100;
    return base + x;
}

// ⑤ 类型参数与值参数混用
fn fill(meta T: type, meta N: i64, v: T) T {
    var acc: T = v;
    var i: i64 = 1;
    while (i < N) { acc = acc + v; i = i + 1; }
    return acc;
}

// ⑥ 实例体内的类型位替换：`var z: T;` 无初值，类型只能来自替换
fn zero(meta T: type) T {
    var z: T;
    return z;
}

// ⑦ 值参数可由 meta const / meta fn 算出（不必是字面量）
meta const BASE: i64 = 2;
meta fn twice(v: i64) i64 { return v * 2; }

fn main() i32 {
    var s1: i64 = sum_sq(5);              // 0+1+4+9+16 = 30
    var r1: string = repeat("hi", 3);
    var r2: string = repeat("hi", 3);     // 同键复用实例（不得重复生成 / 重入）
    var r3: string = repeat("ab-c", 2);   // 非标识符字符净化 + 哈希区分
    var p1: i64 = pick(true, 11, 22);
    var p2: i64 = pick(false, 11, 22);
    var t1: i64 = tagged(7, 5);           // 700 + 5
    var f1: i64 = fill(i64, 4, 6);        // 24
    var f2: u8 = fill(u8, 3, 2);          // 6
    var zf: f64 = zero(f64);
    var zu: u8 = zero(u8);
    var c1: i64 = sum_sq(twice(BASE) + 1);   // sum_sq(5) → 复用同一实例
    var n1: i64 = tagged(-3, 0);             // 负数键 → tagged__n3
    if (s1 == 30 && r1 == "hihihi" && r2 == "hihihi" && r3 == "ab-cab-c"
        && p1 == 11 && p2 == 22 && t1 == 705 && f1 == 24 && f2 == 6
        && zf < 1.0 && zu == 0 && c1 == 30 && n1 == -300) { return 0; }
    return 1;
}
