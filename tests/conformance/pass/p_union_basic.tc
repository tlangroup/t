// EXPECT: pass
// 向 C 兼容的联合体（untagged union）：所有成员共享同一段存储、大小为最大成员、
// 对齐取最大成员对齐；字段读写均在 offset 0（覆盖语义：最后写入的成员有效）。
// 覆盖：标量成员读写 / 含 struct 成员 / 联合体嵌套进 struct / 跨后端 ABI 一致。
struct Pt { x: i64; y: i64; }

union Num { i: i64, f: f64, p: Pt }

// 联合体作为函数参数与返回值（值语义，C 兼容布局）
fn swap(u: Num) Num {
    var r: Num = u;
    return r;
}

struct Box { tag: i64; payload: Num; }

@main
fn main() i32 {
    // 1) 标量成员读写：i 与 f 共享存储，各自写完即可读回
    var a: Num;
    a.i = 100;
    if (a.i != 100) { return 1; }
    a.f = 2.5;
    if (a.f != 2.5) { return 2; }

    // 2) 含 struct 成员的联合体
    var b: Num;
    b.p.x = 9;
    b.p.y = 8;
    if (b.p.x + b.p.y != 17) { return 3; }

    // 3) 联合体嵌套进 struct：验证 union 字段布局不破坏外层 struct
    var bx: Box;
    bx.tag = 7;
    bx.payload.i = 42;
    if (bx.tag != 7) { return 4; }
    if (bx.payload.i != 42) { return 5; }

    // 4) 跨函数值传递（C 兼容 ABI）
    var c: Num;
    c.i = 123;
    var d: Num = swap(c);
    if (d.i != 123) { return 6; }

    return 0;
}
