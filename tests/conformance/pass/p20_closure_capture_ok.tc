// EXPECT: pass
// 闭包按值捕获（FuncType v2 Stage B）：捕获形参、捕获多个外层局部、
// 捕获后返回闭包、闭包作为高阶函数实参，均应通过检查。

make_adder fn(base: i64) fn(i64) i64 {
    return fn (x: i64) i64 { return x + base; };
}

apply1 fn(f: fn(i64) i64, v: i64) i64 {
    return f(v);
}

mix fn(a: i64, b: string) i64 {
    var c: i64 = a * 2;
    var f: fn(i64) i64 = fn (x: i64) i64 {
        return x + a + c + (str_len(b) as i64);
    };
    return f(1);
}

use_all fn() i64 {
    var add10: fn(i64) i64 = make_adder(10);
    var t: i64 = apply1(add10, 5);
    // 无捕获字面量仍走原路径
    var dbl: fn(i64) i64 = fn (x: i64) i64 { return x * 2; };
    t = t + dbl(3) + mix(4, "ab");
    return t;
}
