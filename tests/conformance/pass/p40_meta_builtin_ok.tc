// EXPECT: pass
// M-comptime Phase D：编译期内建 `@xxx`。
// 类型查询（@type_name / @type_size / @type_equal）在 CTFE 之前就折成
// string / int / bool 字面量 —— 两个后端看到的只有普通字面量，零新支持。

struct Point { x: i32; y: i32; }
MyInt i64;
enum Color : u8 { Red; Green; }
// P1 反射测试用：含对齐敏感字段的结构体（C-ABI 默认布局）
struct Mixed { a: i8; b: i32; c: i64; }
// 默认布局（无修饰，内部标签 "auto"，非关键字）：声明序 = 内存序，标准 C 布局，24B（b@0/i@8/c@16）。
struct AutoMixed { b: u8; i: i64; c: u8; }
// extern 显式 C-API 严格 C 规范：声明序 = 内存序，标准 C 布局，24B，i@8。
extern struct ExtMixed { b: u8; i: i64; c: u8; }

// ── P2b：类型构造元函数（comptime 合成新类型，type-as-value，对齐 Zig）──
//    每个都返回「类型值节点」，可像真实类型一样喂给 @size_of / @offset_of /
//    @has_field / @type_name（这些查询在 CTFE 期解析 synthetic 类型名）。
//    注意：const 名须 UPPER_SNAKE_CASE（W402 命名约定）。
const I32_T = @int("signed", 32);
const U8_T = @int("unsigned", 8);
const PTR_T = @pointer(i32);
const TUP_T = @tuple([i32, bool, string]);
const DYP_T = @struct("auto", "none", ["x", "y"], [i32, i32]);
const COL_T = @enum(i32, ["red", "green", "blue"]);
const FN_T = @fn(i32, [i32, i32], "ccc", "none");

// ① 类型查询用在运行期位置：折叠后就是常量
fn p40_names() bool {
    if (@type_name(i64) != "i64") { return false; }
    if (@type_name(Point) != "Point") { return false; }
    if (@type_name(MyInt) != "i64") { return false; }   // typealias 展开到底层
    if (@type_name([4]i32) != "[4]i32") { return false; }
    return true;
}

fn p40_sizes() bool {
    if (@type_size(i64) != 8) { return false; }
    if (@type_size(u8) != 1) { return false; }
    if (@type_size(Color) != 1) { return false; }
    if (@type_size(Point) != 8) { return false; }
    if (@type_size(string) != 16) { return false; }     // TStr { ptr, len }
    if (@type_size([]i32) != 32) { return false; }      // TSlice
    return true;
}

fn p40_equal() bool {
    if (@type_equal(i64, i64) == false) { return false; }
    if (@type_equal(i64, u64)) { return false; }
    if (@type_equal(MyInt, i64) == false) { return false; }
    if (@type_equal([4]i32, [4]i32) == false) { return false; }
    if (@type_equal([4]i32, [5]i32)) { return false; }
    if (@type_equal(*i32, *i64)) { return false; }
    return true;
}

// ①-b 对齐 Zig 的 @sizeOf / @alignOf / @bitSizeOf（P0 只读内省）。
// @size_of 与既有 @type_size 同义；@align_of / @bit_size_of 为新增。
// 三者均在 CTFE 之前折成 int 字面量，两个后端零改动、零 IR 漂移。
fn p40_align_bit() bool {
    // @size_of 与 @type_size 同义
    if (@size_of(i64) != 8) { return false; }
    if (@size_of(u8) != 1) { return false; }
    if (@size_of(Point) != 8) { return false; }
    if (@size_of(string) != 16) { return false; }     // TStr { ptr, len }
    if (@size_of([]i32) != 32) { return false; }      // TSlice
    // @align_of（C ABI 对齐）
    if (@align_of(i64) != 8) { return false; }
    if (@align_of(u8) != 1) { return false; }
    if (@align_of(Point) != 4) { return false; }      // Point { x:i32; y:i32 } 对齐 = 4
    if (@align_of(string) != 8) { return false; }     // TStr { ptr, len } 对齐 = 8
    if (@align_of(*i32) != 8) { return false; }       // 指针对齐 = 8
    // @bit_size_of
    if (@bit_size_of(i64) != 64) { return false; }
    if (@bit_size_of(u8) != 8) { return false; }
    if (@bit_size_of(bool) != 1) { return false; }    // Zig: @bitSizeOf(bool) == 1
    if (@bit_size_of(Point) != 64) { return false; }  // 8 字节 * 8
    return true;
}

// ② `comptime T: type` 形参 + @type_equal 分支：docs/compiler/meta_design.md §6 的 get_width 模式。
//    未取分支里的 @compile_error 被 mb_prune_if 剪掉，不误报。

// ⑥ 默认布局（无修饰，内部标签 "auto"）/ extern 显式 C-ABI。
//    二者均声明序 = 内存序、标准 C 布局；运行时字段访问回读两后端一致（C 按名 / LLVM 按位置，同源 node_lb）。
fn p40_layout() bool {
    // 默认布局：声明序 = 内存序（无重排）
    if (@size_of(AutoMixed) != 24) { return false; }
    if (@offset_of(AutoMixed, "b") != 0) { return false; }
    if (@offset_of(AutoMixed, "i") != 8) { return false; }
    if (@offset_of(AutoMixed, "c") != 16) { return false; }
    // extern 显式 C-ABI：声明序 = 内存序
    if (@size_of(ExtMixed) != 24) { return false; }
    if (@offset_of(ExtMixed, "i") != 8) { return false; }
    // 运行时字段访问：赋值后回读，验证两后端内存布局一致（C 按名 / LLVM 按位置，同源 node_lb）
    var m: AutoMixed;
    m.i = 123456789012345;
    m.b = 170;
    m.c = 187;
    if (m.i != 123456789012345) { return false; }
    if (m.b != 170) { return false; }
    if (m.c != 187) { return false; }
    return true;
}

// ⑤ P1 反射：@has_field / @offset_of / @has_decl。
//    均在 CTFE 之前折成 bool / int 字面量，两个后端零改动、零 IR 漂移。
//    @offset_of 严格复用 mb_struct_size 的 C-ABI 布局算法（与运行时内存布局、@size_of 自洽）。
fn p40_reflect() bool {
    if (@has_field(Point, "x") != true) { return false; }
    if (@has_field(Point, "y") != true) { return false; }
    if (@has_field(Point, "z") != false) { return false; }       // 不存在的字段
    if (@offset_of(Point, "x") != 0) { return false; }           // i32 @0
    if (@offset_of(Point, "y") != 4) { return false; }           // i32 对齐4 ⇒ @4
    // 对齐敏感的混合布局（字段偏移向上取整到字段对齐）
    if (@offset_of(Mixed, "a") != 0) { return false; }           // i8  @0
    if (@offset_of(Mixed, "b") != 4) { return false; }           // i32 对齐4 ⇒ @4
    if (@offset_of(Mixed, "c") != 8) { return false; }           // i64 对齐8 ⇒ @8
    if (@offset_of(Mixed, "c") != (@size_of(Mixed) - 8)) { return false; }  // 末字段紧邻尾部
    // @has_decl：本编译单元顶层声明存在性
    if (@has_decl("Point") != true) { return false; }
    if (@has_decl("Color") != true) { return false; }
    if (@has_decl("main") != true) { return false; }
    if (@has_decl("no_such_decl_xyz") != false) { return false; }
    return true;
}

// P2b：类型构造元函数在 CTFE 期合成类型值，并能被类型查询元函数解析。
// 注意：synthetic 类型存在 const 里（type-as-value），@size_of 等查询须走 CTFE
// 解析路径（与 Zig 一致：comptime 才解析 const 绑定的类型值），故用 comptime fn。
comptime fn p40_p2b() bool {
    // @int → 标量
    if (@type_name(I32_T) != "i32") { return false; }
    if (@size_of(I32_T) != 4) { return false; }
    if (@type_name(U8_T) != "u8") { return false; }
    if (@size_of(U8_T) != 1) { return false; }
    // @pointer → 指针宽度（8）
    if (@size_of(PTR_T) != 8) { return false; }
    // @struct（auto 重排对两个 i32 字段无影响）
    if (@size_of(DYP_T) != 8) { return false; }
    if (@has_field(DYP_T, "x") != true) { return false; }
    if (@has_field(DYP_T, "y") != true) { return false; }
    if (@offset_of(DYP_T, "x") != 0) { return false; }
    if (@offset_of(DYP_T, "y") != 4) { return false; }
    // @enum（i32 backing）
    if (@size_of(COL_T) != 4) { return false; }
    // @tuple：合成类型值可解析、尺寸 > 0
    if (@size_of(TUP_T) <= 0) { return false; }
    // @fn：函数类型无字节尺寸（Zig: @sizeOf(fn) 非法），仅验证其可解析为类型值
    if (@type_name(FN_T) == "") { return false; }
    return true;
}

// P1：@offset_of 在 comptime 类型形参上的 CTFE 路径
comptime fn off_of(comptime T: type) i64 {
    return @offset_of(T, "y");
}


comptime fn get_width(comptime T: type) u32 {
    if (@type_equal(T, u32)) { return 32; }
    else if (@type_equal(T, u64)) { return 64; }
    else { @compile_error("unsupported type"); }
    return 0;
}

comptime fn twice_size(comptime T: type) i64 {
    return @type_size(T) * 2;
}

// P0：@size_of / @bit_size_of 在 comptime fn 类型形参上的 CTFE 路径
comptime fn twice_sizeof(comptime T: type) i64 {
    return @size_of(T) * 2;
}
comptime fn bits_of(comptime T: type) i64 {
    return @bit_size_of(T);
}

// ③ @zeroed + 编译期数组读写 + @str_from_bytes / sym_intern
comptime fn p40_repeat(comptime s: string, comptime n: u32) Sym {
    var buf: [64]u8 = @zeroed([64]u8);
    var pos: u32 = 0;
    var i: u32 = 0;
    while (i < n) {
        var j: u32 = 0;
        var slen: u32 = str_len(s) as u32;
        while (j < slen) {
            buf[pos] = s[j];
            pos = pos + 1;
            j = j + 1;
        }
        i = i + 1;
    }
    return sym_intern(buf, pos);
}

comptime fn p40_bytes(comptime n: i64) string {
    var b: [8]u8 = @zeroed([8]u8);
    b[0] = 116;
    b[1] = 45;
    b[2] = 108;
    return @str_from_bytes(b, n);
}

// ④ 数组是值类型：CTFE 绑定处必须拷贝，不能别名
comptime fn p40_alias(comptime unused: i64) i64 {
    var a: [3]u8 = @zeroed([3]u8);
    a[0] = 7;
    var b: [3]u8 = a;
    b[0] = 9;
    return (a[0] as i64) * 100 + (b[0] as i64);
}

@main
fn main() i32 {
    if (p40_names() == false) { return 1; }
    if (p40_sizes() == false) { return 2; }
    if (p40_equal() == false) { return 3; }
    if (p40_align_bit() == false) { return 11; }
    if (p40_reflect() == false) { return 14; }
    if (p40_layout() == false) { return 16; }
    if (comptime p40_p2b() == false) { return 17; }
    if (comptime off_of(Point) != 4) { return 15; }

    const W32: u32 = comptime get_width(u32);
    const W64: u32 = comptime get_width(u64);
    if (W32 != 32) { return 4; }
    if (W64 != 64) { return 5; }
    if (comptime twice_size(Point) != 16) { return 6; }
    if (comptime twice_sizeof(Point) != 16) { return 12; }
    if (comptime bits_of(u64) != 64) { return 13; }

    var sym: Sym = comptime p40_repeat("hi", 3);
    if (sym_str(sym) != "hihihi") { return 7; }
    if (comptime p40_bytes(3) != "t-l") { return 8; }
    if (comptime p40_alias(0) != 709) { return 9; }

    // @zeroed 也能用在运行期位置（折成普通数组字面量）
    var z: [4]i32 = @zeroed([4]i32);
    if (z[0] + z[3] != 0) { return 10; }

    // comptime 块：编译期数组读写，不产生运行期代码
    comptime {
        var t2: [4]u8 = @zeroed([4]u8);
        t2[0] = 65;
        var probe: string = @str_from_bytes(t2, 1);
        if (probe != "A") { @compile_log("p40: str_from_bytes 编译期自检失败"); }
    }
    return 0;
}
