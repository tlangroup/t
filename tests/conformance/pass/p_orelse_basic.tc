// EXPECT: pass
// O-4 `orelse`（对齐 Zig 0.17）。
// parser 层脱糖为 { var __ol_N = a; match (is_some(__ol_N)) { true => unwrap(__ol_N), false => b } }
// ⇒ 左操作数只求值一次、右操作数短路。
// 优先级：塔中最松的二元级（`assign → orelse → pipe → … → range → or`），故比较运算仍绑得比它紧。

fn pick(i: i64) ?i64 {
    if (i > 0) { return some(i); }
    return ?;
}

@main
fn main() i64 {
    var seed: i64 = 7;
    var x: ?i64 = some(seed);
    var y: ?i64 = ?;
    var a: i64 = x orelse 0;                  // 有值 ⇒ 取其值
    var b: i64 = y orelse 0;                  // none  ⇒ 取兜底
    // 链式（右结合）：a orelse (b orelse c)
    var c: i64 = pick(-1) orelse pick(-2) orelse 99;
    // Z10 正面：右侧是带括号的比较表达式时合法 —— Zig 里正是这种 `?bool orelse bool` 的形态。
    var seen: bool = true;
    var ob: ?bool = some(seen);
    var d: bool = ob orelse (a == b);
    var e: i64 = y orelse (1 + 1);
    if (d) { return -1; }
    return a + b + c + e;
}
