// EXPECT: pass
// 递归 variant：载荷以**指针形态**自引用 `*Self` 合法（前向引用按名字解析），
// C 后端为其补前向 typedef，LLVM 后端载荷即 ptr。
variant IList {
    Nil;
    Cons(i64, *IList);
}

fn head_of(l: IList) i64 {
    return match (l) {
        Nil => 0
        Cons(h, t) => h
    };
}

@main
fn main() i64 {
    var e: IList = IList { .Nil };
    return head_of(e);
}
