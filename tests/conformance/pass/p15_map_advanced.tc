// EXPECT: pass
// map 进阶（M31）：map 作函数参数/返回值、map 字面量作表达式（实参/返回值/赋值右值）、
// 嵌套 map[K]map[K2]V、for (k, v in m) 键值同迭代、
// map 字面量出现在非局部位置（全局 var 初始化器 / 结构体字面量字段）。

Config :: struct {
    name: string;
    opts: map[string]i64;
}

count_keys :: func(m: map[string]i64) -> i64 {
    return map_len(m);
}

sum_vals :: func(m: map[string]i64) -> i64 {
    var total: i64 = 0;
    for (k, v in m) {
        total = total + v;
    }
    return total;
}

make_defaults :: func() -> map[string]i64 {
    return ["w": 1, "h": 2];
}

with_extra :: func(m: map[string]i64) -> map[string]i64 {
    map_set(m, "extra", 9);
    return m;
}

var g_limits: map[string]i64 = ["max": 100, "min": 1];

@main
main :: func() -> i64 {
    var total: i64 = 0;

    // 全局 var 的 map 字面量初始化器
    total = total + g_limits["max"] + g_limits["min"];

    // 字面量作实参 / 作返回值 / 作赋值右值
    total = total + count_keys(["a": 1, "b": 2, "c": 3]);
    total = total + sum_vals(["a": 10, "b": 20]);
    var d: map[string]i64 = make_defaults();
    total = total + d["w"] + d["h"];
    var d2: map[string]i64 = with_extra(d);
    total = total + d2["extra"];

    var m: map[string]i64;
    m = ["p": 7, "q": 8];
    for (k, v in m) {
        total = total + (str_len(k) as i64) + v;
    }

    // 整型键 / 字符串值的键值迭代
    var im: map[i64]i64 = [10: 100, 20: 200];
    for (ik, iv in im) {
        total = total + ik + iv;
    }
    var nm: map[string]string = ["x": "hello"];
    for (nk, nv in nm) {
        total = total + (str_len(nv) as i64);
    }

    // 嵌套 map
    var deep: map[string]map[string]i64 = ["a": ["x": 10], "b": ["z": 30]];
    total = total + deep["a"]["x"] + deep["b"]["z"] + map_len(deep);
    map_set(deep["a"], "w", 40);
    total = total + deep["a"]["w"];
    var inner: map[string]i64 = ["p": 1];
    map_set(deep, "c", inner);
    total = total + deep["c"]["p"];
    for (dk, dv in deep) {
        total = total + map_len(dv);
    }

    // 结构体字面量字段为 map 字面量
    var c: Config = Config{ name: "app", opts: ["retries": 3] };
    total = total + c.opts["retries"] + (str_len(c.name) as i64);
    for (ck, cv in c.opts) {
        total = total + cv;
    }

    return total;
}
