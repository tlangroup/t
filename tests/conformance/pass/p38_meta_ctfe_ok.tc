// EXPECT: pass
// M-meta Phase B：CTFE 求值器。`meta <expr>` 在检查前折叠为字面量，
// `meta { }` 在编译期执行且不产生运行期代码。
// 本用例覆盖求值器的全部语句/表达式形态，check 须零错误。

meta const BASE: i64 = 10;
meta var ACC: i64 = 0;

// 递归
meta fib fn(n: i64) i64 {
    if (n < 2) { return n; }
    return fib(n - 1) + fib(n - 2);
}

// 循环 + 局部变量 + break/continue
meta sum_odd fn(n: i64) i64 {
    var s: i64 = 0;
    var i: i64 = 0;
    while (true) {
        i = i + 1;
        if (i > n) { break; }
        if (i - (i / 2) * 2 == 0) { continue; }
        s = s + i;
    }
    return s;
}

// 字符串：仅相等比较（CTFE 不做字符串运算）
meta is_ecs fn(s: string) bool { return s == "ecs"; }

main fn() i32 {
    // 算术 / 位运算 / 比较 / 短路
    var a: i64 = meta 100 * 20 + 7;
    var b: i64 = meta BASE * BASE - 1;
    var c: i64 = meta (1 << 10) | 3;
    var d: i64 = meta 255 ^ 15;
    var e: bool = meta (BASE > 3) && (fib(10) == 55);
    var f: bool = meta (BASE < 0) || is_ecs("ecs");

    // 递归 / 循环
    var g: i64 = meta fib(15);
    var h: i64 = meta sum_odd(10);

    // 显式转型窄化（不做隐式转换，宪法第 3 条）
    var i2: i64 = meta (300 as u8) as i64;

    // 编译期内建：纯函数
    var j: i64 = meta str_len("entity");
    var k: string = meta int_to_str(42);

    // 编译期块：执行后运行期零代码；结果经 meta var 折叠回运行期
    meta {
        print("p38\n");
        var t: i64 = 1;
        while (t <= 4) {
            ACC = ACC + t * t;
            t = t + 1;
        }
    }
    var l: i64 = meta ACC;

    if (a == 2007 && b == 99 && c == 1027 && d == 240 && e && f
        && g == 610 && h == 25 && i2 == 44 && j == 6 && k == "42" && l == 30) {
        return 0;
    }
    return 1;
}
