// EXPECT: pass
// spec §2: 标量类型、常量声明（十进制/十六进制/二进制字面量）、位运算
const MAX_U16: u16 = 65535;
const HEX: u32 = 0xDEAD;
const BIN: u8 = 0b1111;

fn mix(a: u32) u32 {
    var v: u32 = a;
    v = (v << 3) | HEX;
    v = v & 0xFFFF;
    v = v ^ 0b1010;
    return v >> 1;
}

fn main() i32 @main {
    var r: u32 = mix(7);
    if (r == 0) {
        return 1;
    }
    return 0;
}
