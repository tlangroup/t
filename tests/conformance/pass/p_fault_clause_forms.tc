// EXPECT: pass
// 故障子句的两个变体（fault 批次 B3 / docs/syntax/drafts/fault.md 附录 B）：
//   `@clause(.fault, <谓词>, <全名>)`   —— 谓词 → 全名，编译期登记
//   `@clause(.repair, <.修法名>, <闭包>)` —— 修法名 → 闭包，编译期登记
//
// 本批只保证「语法与形态可构造 + 不进运行期」；组声明与槽位索引属 B1，
// 故全名 `UserErr.AgeNegative` 在此**不解析**（clause 子树一概不求值）。

struct User {
    age:  i64;
    name: string;
}

// 谓词三种形态：关系约束 / 等值约束 / 多字段合取
const F_AGE  = @clause(.fault, .{ .age < 0 }, UserErr.AgeNegative);
const F_NAME = @clause(.fault, .{ .name = "" }, UserErr.NameEmpty);
const F_BOTH = @clause(.fault, .{ .age > 120, .name = "" }, UserErr.Unreal);

// 修法名必须是 `.名` 形态，第三段是闭包
const R_DEFAULT = @clause(.repair, .use_default, fn () i64 { return 18; });
const R_CLAMP   = @clause(.repair, .clamp, fn () i64 { return 0; });

// `++` 合并：故障子句与修复子句同组（B4 的 `Err(...)` 即此形态）
const ERR_AGE = F_AGE ++ R_DEFAULT ++ R_CLAMP;

@main
fn main() i32 {
    return 0;
}
