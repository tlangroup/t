// EXPECT: pass
// 编译期诊断 / 日志内建：`@compile_log` / `@compile_warning` / `@compile_error`。
//
// 定位：`print` 系列已被裁定为**运行期函数**（不再登记为编译期内建），编译期
// 上下文里的输出一律改用这三个元函数。
//   - `@compile_log(args...)`     → 编译期写 stderr（不定长，1..∞ 个标量实参）
//   - `@compile_warning(args...)` → 编译期发 T-MTA-W621 告警诊断（不定长）
//   - `@compile_error(msg)`       → 编译期硬错误，终止编译（单实参，noreturn）
// 前两者是 D3「不定长元函数」的首个真实消费方：末位吸收余参，逐个求值后拼成一条消息。
//
// 上下文约束：三者都是**纯编译期**内建，只能活在 `comptime { }` 块里
// （`@compile_error` 额外允许出现在 `comptime fn` 体的**未取分支**中 ——
//  mb_prune_if 会剪除，故不误报；见 p40 ②）。

// ① 编译期块里的日志 / 告警
fn p64_log() bool {
    comptime {
        @compile_log("p64: compile_log ok\n");
        var k: i64 = 610;
        @compile_log("p64: k = ", k, "\n");        // 不定长 + 非字符串实参
        @compile_log("p64: flag = ", true, "\n");  // bool 实参
        @compile_warning("p64: 这是一条预期的编译期告警");
    }
    return true;
}

// ② `@compile_warning` 的不定长拼接：多实参合成一条消息
fn p64_warn() bool {
    comptime {
        var n: i64 = 2;
        @compile_warning("p64: n = ", n, "（拼接自 3 个实参）");
    }
    return true;
}

// ③ `@compile_error` 落在未取分支：mb_prune_if 剪除，不误报（同 p40 ②）
comptime fn p64_width(comptime T: type) u32 {
    if (@type_equal(T, u32)) { return 32; }
    else if (@type_equal(T, u64)) { return 64; }
    else { @compile_error("p64: 不支持的类型"); }
    return 0;
}

@main
fn main() i32 {
    if (p64_log() == false) { return 1; }
    if (p64_warn() == false) { return 2; }

    const W32: u32 = comptime p64_width(u32);
    const W64: u32 = comptime p64_width(u64);
    if (W32 != 32) { return 3; }
    if (W64 != 64) { return 4; }
    return 0;
}
