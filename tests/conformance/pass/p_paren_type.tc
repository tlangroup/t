// EXPECT: pass
// R3（docs/design/set-ops/DESIGN.md §13.8）：括号类型 `( Type )`，只改结合边界、不包层节点。
// 覆盖位置：局部变量类型位、`as T` 位（该位 g_type_and 为假，括号是唯一可达的分组形状）、
// 数组元素位、可选类型底位、指针底位、形参位、返回类型位、map kv 位、struct 字段位。
fn add1(a: i64) i64 {
    return a + 1;
}

struct Holder {
    v: (i64);
    p: *(i64);
}

fn take(h: Holder, n: (i64)) (i64) {
    return add1(n) + h.v;
}

fn main() i32 @main {
    var x: (i64) = 7;
    var y: i64 = x as (i64);
    var s: [2](i64) = [41, 42];
    var o: (i64)? = some(y);
    var m: map[(i64)](i64) = [1: 100, 2: 200];
    var z: *(i64) = &x;
    var r: i64 = take(Holder { v: 1, p: &x }, y);
    if (r == 0) {
        return 1;
    }
    return 0;
}
