// EXPECT: pass
// spec §3: if/while/for 控制流（强制括号 + 大括号）
gauss fn(n: i32) i32 {
    var total: i32 = 0;
    var i: i32 = 1;
    while (i <= n) {
        total = total + i;
        i = i + 1;
    }
    return total;
}

fact fn(n: i32) i32 {
    var r: i32 = 1;
    for (var i: i32 = 2; i <= n; i = i + 1) {
        r = r * i;
    }
    return r;
}

main fn() i32 @main {
    if (gauss(10) != 55) {
        return 1;
    }
    if (fact(5) != 120) {
        return 2;
    }
    return 0;
}
