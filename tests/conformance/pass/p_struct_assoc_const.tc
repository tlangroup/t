// EXPECT: pass
// M5 / P3a：结构体关联常量 `const Name = ...`。
// struct 体内关联常量重命名为 `<struct>_Name` 全局符号，与方法 `point_origin` 同构；
// 类型级 `Point.ORIGIN_X` 与值级 `p.ORIGIN_Y` 经 sema member 解析改写 ident 发射。
// 修复前 struct 体内 `const` 不被解析器接受。
struct Point {
    x: i64;
    y: i64;
    const ORIGIN_X = 0;
    const ORIGIN_Y = 100;
}
fn main() i32 @main {
    var ax: i64 = Point.ORIGIN_X;
    var p: Point;
    var ay: i64 = p.ORIGIN_Y;
    if (ax == 0 && ay == 100) { return 0; }
    return 1;
}
