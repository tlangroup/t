// EXPECT: pass
// Task #5 `#id` 修饰词注册表（struct-modifiers 设计 §2.2，覆盖 T11 / T13）：
//   * `#modifier serde` 显式注册自定义修饰词（注册途径之一）；
//   * 已注册 id 可应用：`struct #serde Config`；
//   * 内建预注册 `soa`/`aos`（容器布局轴，D8 保留）：
//     后置写法 `struct #soa Bucket` 与设计 T13 的前置写法 `#soa struct Bucket2` 均可。
// 编译器只登记「被修饰」，不解释其语义（语义由用户扩展函数消费）。
#modifier serde

struct #serde Config {
    host: string;
}

struct #soa Bucket {
    a: i32;
}

#soa struct Bucket2 {
    b: i32;
}

struct #aos Bucket3 {
    c: i32;
}

@main fn main() i32 {
    var c: Config = Config{ .host = "localhost" };
    if (c.host != "localhost") { return 1; }
    return 0;
}
