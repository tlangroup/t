// EXPECT: pass
// M57：parse_time / parse_time_local / time_invalid 的合法用法。
@main
main fn() i64 {
    var a: i64 = parse_time("%Y-%m-%d %H:%M:%S", "2025-08-03 20:51:30");
    var b: i64 = parse_time("%d/%b/%Y:%H:%M:%S %z", "03/Aug/2025:20:51:30 +0800");
    var c2: i64 = parse_time("%c", "Sun Aug  3 20:51:30 2025");
    var d2: i64 = parse_time("%x %X", "08/03/25 20:51:30");
    var e2: i64 = parse_time_local("%Y-%m-%dT%H:%M:%S.%f", "2025-08-03T20:51:30.123456");
    if (a == time_invalid()) { return 1; }
    return 0;
}
