// P2b-3: @variant constructs a synthetic sum type at comptime.
// EXPECT: pass
//
// Verification strategy: the synthetic variant must have *identical layout
// semantics* to the equivalent native `variant` declaration (same cases), and
// be introspectable at comptime via @type_name / @size_of.
//
// Runtime construction + match on synthetic variants is deferred: it needs the
// type-value-const-as-runtime-annotation codegen feature that spans the whole
// P2b synthetic-type family (const D = @struct(...); var d: D hits it too).

variant RealShape {
    Circle(f64)
    Rect(f64, f64)
}

const Shape = @variant(i32, ["Circle", "Rect"], [f64, [f64, f64]]);

comptime fn p41_checks() bool {
    // synthetic variant has a resolvable type name
    if (@type_name(Shape) == "") { return false; }
    // layout must match the equivalent native variant exactly
    if (@size_of(Shape) != @size_of(RealShape)) { return false; }
    // and be non-trivial (tag + payload actually contribute)
    if (@size_of(Shape) <= 4) { return false; }
    return true;
}

@main
fn main() i32 {
    if (comptime p41_checks() == false) { return 1; }
    return 0;
}
