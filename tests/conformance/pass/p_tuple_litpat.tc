// EXPECT: pass
// KI-002 修复回归：struct / 具名元组字面量模式在 match 中须被类型检查接受。
// 运行期双后端对拍见 examples/tuple_match_demo.tc（run_examples 覆盖）。
struct Pt { x: i64; y: i64; }
struct IntPair { i64, i64 }

fn f(p: Pt) i64 {
    return match (p) {
        Pt{ x: 0, y: 0 } => 1
        Pt{ x: 0 } => 2
        Pt{ y: 0 } => 3
        _ => 0
    };
}

fn g(p: IntPair) i64 {
    return match (p) {
        IntPair{ ._0 = 0, ._1 = 0 } => 10
        IntPair{ ._0 = 0 } => 20
        _ => 0
    };
}

@main fn main() i32 { return 0; }
