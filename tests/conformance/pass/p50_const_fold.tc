// EXPECT: pass
// 弥漫式 comptime 折叠 —— 模块级 const 传播（P1 缺口补齐）。
// 验证：模块级 const（GlobalConstDecl，g_const_decl_ids 登记）作为编译期已知常量，
//   • 参与算术/布尔表达式被原地折成字面量（N*2+3 → 23，C>3 条件折成常量 bool）；
//   • const 字符串被折叠进拼接；
//   • const 条件 if 被折叠为常量条件（br i1 true/false），由后端 DCE 消除死分支。
// 仅放行 const（let 为运行期动态常量，不当编译期已知）。零后端风险：纯 AST 改写。
// 落点：src/comptime_fold.tc comptime_ident_is_const + comptime_has_runtime_ref 放行；
//       src/sema.tc meta_eval ident 分支取 GlobalConstDecl.nb 编译期值。
const N: i64 = 10;
const FLAG: bool = true;
const MSG: string = "hi";
const C: i64 = 5;

fn main() i64 @main {
    var x: i64 = N * 2 + 3;          // 编译期折成 23
    var y: bool = FLAG and (C > 3);   // 折成 true
    print(int_to_str(x));
    print("\n");
    print(MSG);
    print("\n");
    if (C > 3) { print("c-gt-3"); print("\n"); }
    if (FLAG) { print("flag-on"); print("\n"); }
    return 0;
}
