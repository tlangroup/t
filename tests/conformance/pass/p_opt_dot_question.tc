// EXPECT: pass
// O-3 `.?` 断言取出（对齐 Zig 0.17 的 `x orelse unreachable`）。
// parser 层脱糖为既有内建 `unwrap(x)`：sema 按名字识别四个可选内建（sema.tc:8761），
// 且 `t_opt_unwrap` 在 none 时打 JSON 错误并 exit(1)（runtime/t_runtime.c:246），
// 故本设施无需新增节点类型，HIR/TIR/双后端均零改动。

struct Point { x: i64; y: i64; }

fn pick(i: i64) ?i64 {
    if (i > 0) { return some(i); }
    return ?;
}

@main
fn main() i64 {
    var seed: i64 = 5;
    var a: ?i64 = some(seed);
    var v: i64 = a.?;                 // 5
    // `.?` 的结果仍可继续缀接（后缀循环接着跑）
    var pt: Point;
    pt.x = 3;
    pt.y = 4;
    var op: ?Point = some(pt);
    var sum: i64 = op.?.x + op.?.y;   // 7
    // 用作实参也成立
    var w: i64 = pick(9).?;
    return v + sum + w;
}
