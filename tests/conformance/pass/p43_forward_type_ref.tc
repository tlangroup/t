// EXPECT: pass
// 类型前向引用：register_decl 对 FuncDecl 会**急切解析**形参/返回类型，
// 若按声明序一趟注册，则「函数写在类型之前」必然误报 T_UNKNOWN_TYPE。
// import 更是必然踩中——模块声明被追加在 decl_list 末尾，入口文件的
// `f fn(m: mod.T)` 永远先于模块的 StructDecl 被注册（曾导致 4 个 agent/colony 示例双后端全挂）。
// 注册因此分三趟：纯类型声明 → typealias → 函数/全局。

// ① 形参类型在后面才声明
fn consume(m: Msg) i64 {
    return m.kind;
}

// ② 返回类型在后面才声明
fn make(k: i64) Msg {
    return Msg{ kind: k };
}

// ③ 经由 typealias 间接引用后声明的 struct
fn take_alias(b: Box) i64 {
    return b.n;
}

Msg struct {
    kind: i64;
}

Box Holder;

Holder struct {
    n: i64;
}

// ④ 全局变量的类型也在后面声明
var g_slot: Later;

Later struct {
    v: i64;
}

@main
fn main() i64 {
    var m: Msg = make(7);
    var h: Holder;
    h.n = 5;
    g_slot.v = 3;
    println(format("{} {} {}", consume(m), take_alias(h), g_slot.v));
    return 0;
}
