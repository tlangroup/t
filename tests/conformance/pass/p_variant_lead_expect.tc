// EXPECT: pass
// M5 回归：同名 case 跨两个 variant，前导点构造器须按上下文（g_lead_expect）正确消歧，
// 而非全局首个匹配。B 先于 A 声明，无修复时 `.X` 在 `A { .X }` 中会被误脱糖成 B_from_X。
variant B { X(i32); }
variant A { X(i32); }

fn main() i32 {
    var a: A = A { .X(1) };
    var b: B = B { .X(2) };
    if (A_is_X(a) and B_is_X(b)) {
        return A_as_X(a) + B_as_X(b);  // 1 + 2 = 3
    }
    return 99;
}
