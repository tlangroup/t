// EXPECT: pass
// 积类型统一 epic：packed struct 位域槽位（1bit + 多 bit）字段读写
// 旧 `flag Bits[u16] { on: 1; kind: 4; extra: 8; }` 的逐位同构形式。
packed struct Bits {
    on:    u1;
    kind:  u4;
    extra: u8;
}

fn main() i32 @main {
    var f: Bits = Bits{ on: 0, kind: 0, extra: 0 };
    f.on = 1;
    f.kind = 9;
    f.extra = 200;
    var k: u32 = f.kind as u32;
    var e: u32 = f.extra as u32;
    if (k == 9 && e == 200) {
        return 0;
    }
    return 1;
}
