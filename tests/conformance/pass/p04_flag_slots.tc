// EXPECT: pass
// spec §4: flag 位域槽位（1bit + 多 bit）、flag_set/flag_get 内置
Bits flag[u16] {
    on:    1;
    kind:  4;
    extra: 8;
}

main fn() -> i32 @main {
    var f: Bits = 0;
    flag_set(f, Bits.on, 1);
    flag_set(f, Bits.kind, 9);
    flag_set(f, Bits.extra, 200);
    var k: u32 = flag_get(f, Bits.kind);
    var e: u32 = flag_get(f, Bits.extra);
    if (k == 9 && e == 200) {
        return 0;
    }
    return 1;
}
