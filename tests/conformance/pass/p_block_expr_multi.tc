// P1 Stage 1b：**多语句值块** `{ s1; ...; sn; e; }` —— 块值 = 尾随表达式的值，
// 块内 var 处在新作用域（不外泄）。编译期可判定的部分（类型推断 + 作用域）。
// EXPECT: pass

fn calc(n: i64) i64 {
    return {
        var t: i64 = n * 2;
        t + 1;
    };
}

// 块值类型 = 尾随表达式类型：尾随 `v * 3` 是 i64 ⇒ 块值 i64，可赋给 i64 var。
fn blkvar() i64 {
    var y: i64 = { var a: i64 = 5; a * 3; };
    return y;
}

// 块内 var 与外层同名：内层遮蔽，外层不受影响（作用域隔离）。
fn shadow() i64 {
    var v: i64 = 100;
    var r: i64 = {
        var v: i64 = 5;
        v * 3;
    };
    return v + r;
}

// 多语句值块作 match 臂 / 值 if 分支（后端的类型推断路径：_tmrN 槽宽不得退化 void*）
fn arms(c: bool) i32 {
    return match (c) {
        true => { var x: i32 = 3; x * 4; },
        false => { var y: i32 = 5; y * 6; },
    };
}

fn vif(n: i64) i32 {
    return if (n > 0) { var p: i32 = 1; p + 10; } else { var q: i32 = 2; q + 20; };
}

fn main() i32 @main {
    if (calc(10) == 21 && blkvar() == 15 && shadow() == 115) {
        if (arms(true) == 12 && arms(false) == 30 && vif(1) == 11 && vif(0 - 1) == 22) {
            return 0;
        }
    }
    return 1;
}
