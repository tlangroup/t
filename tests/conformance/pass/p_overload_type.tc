// EXPECT: pass
// R3 类型组分派：具体类型精确匹配（优先级最高）+ 类别子句兜底（scalarkind 单态化）。
// ⚠ 整数字面量按最小无符号宽度推断（1 → u8），裸字面量 1 会命中 scalarkind 而非 i64，
//    故用显式类型标注的变量触发 i64/f64 精确匹配。
overload fn classify(x: i64) string { return "int"; }
overload fn classify(x: f64) string { return "float"; }
overload fn classify(x: scalarkind) string { return "scalar"; }

fn main() i32 @main {
    var a: i64 = 1;
    var b: f64 = 2.0;
    if (classify(a) != "int") { return 1; }
    if (classify(b) != "float") { return 2; }
    if (classify("s") != "scalar") { return 3; }
    return 0;
}
