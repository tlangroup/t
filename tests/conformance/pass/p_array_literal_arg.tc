// EXPECT: pass
// 数组字面量作调用实参：语义层接受 `fn f(a: [N]T)` + `f([a,b,c,d])`，
// 定长数组按值 ABI 与字面量元素类型推导（默认 i64 / 显式 f64）均通过类型检查。
// （运行时发射正确性由 examples/array_literal_arg.tc 双后端实跑守卫。）

fn sum4(a: [4]i64) i64 {
    return a[0] + a[1] + a[2] + a[3];
}

fn dot3(v: [3]f64) f64 {
    return v[0] + v[1] + v[2];
}

@main
fn main() i64 {
    var s: i64 = sum4([10, 20, 30, 40]);
    var d: f64 = dot3([1.5, 2.5, 4.0]);
    if (s != 100) { return 1; }
    if (d != 8.0) { return 2; }
    return 0;
}
