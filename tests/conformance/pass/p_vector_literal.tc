// EXPECT: pass
// `[a,b,c,d]` 字面量构造硬件向量：在「期望类型是 @Vector(N,T)」的每个语法位置
//   var 初始化 / 赋值 / return / 函数调用实参 —— 都能把数组字面量升格为向量构造，
//   而不是退化成固定长度数组 `[N]T`。
//   C 后端   → `(T __attribute__((vector_size(N*sizeof(T))))){a,b,c,d}`
//   LLVM 后端 → 逐 lane store 进 `<N x T>` scratch，按「向量值即 ptr」约定交付。
fn mk() @Vector(4, i32) {
    return [7, 8, 9, 10];
}

fn take(v: @Vector(4, i32)) i32 {
    return @reduce_add(v);
}

// 模块级全局：走 __ginit 运行期初始化（LLVM 侧全局槽为 zeroinitializer）
var gv: @Vector(4, i32) = [1, 2, 3, 4];
const CG: @Vector(4, i32) = [5, 6, 7, 8];

@main
fn main() i64 {
    // 1) var 初始化位置
    var v: @Vector(4, i32) = [1, 2, 3, 4];
    if (@vlen(v) != 4) { return 1; }
    if (v[0] != 1) { return 2; }
    if (v[3] != 4) { return 3; }
    if (@reduce_add(v) != 10) { return 4; }

    // 2) 赋值位置（RHS 是全新的向量字面量，不是同类型变量拷贝）
    var w: @Vector(4, i32) = @splat(0i32, 4);
    w = [10, 20, 30, 40];
    if (w[0] != 10) { return 5; }
    if (w[3] != 40) { return 6; }
    if (@reduce_add(w) != 100) { return 7; }

    // 3) return 位置（函数返回类型是 @Vector）
    var r: @Vector(4, i32) = mk();
    if (@reduce_add(r) != 34) { return 8; }
    if (r[2] != 9) { return 9; }

    // 4) 实参位置（形参类型是 @Vector）
    if (take([2, 4, 6, 8]) != 20) { return 10; }

    // 5) 二元运算右侧：`g_vec_expect` 是全局、递归中不清除，外层 var 声明的期望
    //    会一路透传进 `+` 的右操作数，故 `v + [1,1,1,1]` 也能升格。
    var s: @Vector(4, i32) = v + [1, 1, 1, 1];   // {2,3,4,5}
    if (@reduce_add(s) != 14) { return 11; }

    // 6) f64 lane
    var f: @Vector(2, f64) = [1.5, 2.5];
    if (@reduce_add(f) as i64 != 4) { return 12; }
    if (@vlen(f) != 2) { return 13; }

    // 7) 元素是非常量表达式（构造发生在运行期，逐 lane 求值后 store）
    var k: i32 = 5;
    var m: @Vector(4, i32) = [k, k + 1, k * 2, k - 5];   // {5,6,10,0}
    if (m[1] != 6) { return 14; }
    if (@reduce_add(m) != 21) { return 15; }

    // 8) i64 宽 lane（裸整数字面量按量级猜类型，必须显式写 7i64）
    var h: @Vector(2, i64) = [7i64, 8i64];
    if (@reduce_add(h) != 15) { return 16; }

    // 9) 模块级全局 var / const
    if (@reduce_add(gv) != 10) { return 17; }
    if (gv[2] != 3) { return 18; }
    if (@reduce_add(CG) != 26) { return 19; }

    return 0;
}
