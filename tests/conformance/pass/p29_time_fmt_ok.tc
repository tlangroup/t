// EXPECT: pass
// now() / format_time / format_time_local 的基本用法与类型均合法。
// 注：now() 返回值运行期非确定，但此处仅做 check（不参与运行），故不影响 pass。

@main
main fn() -> i64 {
    var t: i64 = 1754254290123000;       // 固定 epoch（微秒），便于类型检查
    var s: string = format_time("%Y-%m-%d %H:%M:%S", t);
    var l: string = format_time_local("%Y-%m-%d %H:%M:%S", t);
    var n: i64 = now();                   // 时钟内建
    // 用 now() 的结果作为 epoch 喂给 format_time（类型合法，运行期非确定）
    var _: string = format_time("%f", n);
    println(s);
    println(l);
    return 0;
}
