// EXPECT: pass
// 验证 std 库可作为外部库以链接模式导入并类型检查（mem + math）
import(std.math);
import(std.mem);

test_fn fn() i64 {
    var a: []i64;
    append(a, 1); append(a, 2); append(a, 3);
    var b: []i64;
    append(b, 0); append(b, 0); append(b, 0);
    mem.copy(i64, b, a);
    if (mem.equal(i64, a, b) != true) { return 1; }
    if (math.max(i64, 3, 7) != 7) { return 2; }
    if (math.gcd(12, 18) != 6) { return 3; }
    if (math.floor_f(-1.5) != -2.0) { return 4; }
    return 0;
}
