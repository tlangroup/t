// EXPECT: pass
// 函数子句合法用法（L-15 / match.md §7）：多条同名 FuncDecl 在 AST lowering
// 阶段被强制脱糖为单一 FuncDecl，其体即 `return match (__p0) { ... };`。
// 覆盖：字面量模式 / 裸绑定 + when 守卫 / `_` 通配兜底 / 多参（非首位折叠进守卫）/
//       字符串字面量模式 / 单子句带模式（组内仅一条也会脱糖）。
@main
fn main() i64 {
    var a: string = classify(0);
    var b: i64 = pick(1, 2);
    var c: string = greet("zh");
    var d: i64 = only_zero(0);
    return 0;
}

fn classify(0) string { return "zero"; }
fn classify(n when n > 0) string { return "positive"; }
fn classify(_) string { return "negative"; }

fn pick(1, k: i64) i64 { return k * 10; }
fn pick(2, k) i64 { return k * 100; }
fn pick(m, k) i64 { return m + k; }

fn greet("zh") string { return "nihao"; }
fn greet(_) string { return "?"; }

// 组内仅一条子句、但含模式形参：同样走脱糖通道
fn only_zero(n: i64 when n > 0) i64 { return n; }
fn only_zero(_: i64) i64 { return 0; }
