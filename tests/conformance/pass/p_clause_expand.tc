// EXPECT: pass
// 子句组展开（N10）+ 重排定形（N11）—— docs/compiler/first-class-clause.md §5.4
//
// 覆盖：
//   · 臂位置直接给 `[N]clause` 值（不含 `=>` 的裸表达式，今天是解析错误 ⇒ 空位利用）
//   · 未标注的 `const C0 = @clause(...)` 与标注写法一致（符号类型回填）
//   · 无守卫通配 clause 被**重排到末位**充当 else
//   · 带守卫 clause + 通配兜底（守卫为假时落到 else）
//
// ⚠ 运行期行为由 examples/clause_expand.tc 对拍锁定（期望 `10 11 -1 99 -2`）；
//   本用例只锁「能过检查」。

const C0 = @clause(.pattern, 0, 10);
const C1 = @clause(.pattern, 1, 11);
const C_WILD = @clause(.pattern, _, 0 - 1);

// 通配写在最前 —— 期望被重排到末位
const G = [C_WILD, C0, C1];

fn pick(x: i64) i64 {
    return match (x) { G };
}

// 带守卫 + 通配兜底
const H = [
    @clause(.pattern, n, when n > 100, 99),
    @clause(.pattern, _, 0 - 2),
];

fn clamp(x: i64) i64 {
    return match (x) { H };
}

@main
fn main() i64 {
    return pick(0) + pick(1) + clamp(500);
}
