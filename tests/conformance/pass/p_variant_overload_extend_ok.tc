// EXPECT: pass
// open-variant（阶段三）：同文件 overload variant 组 + extend variant 追加单载荷构造器
// 验证：extend 的 case 并入开放组、tag 按合并后顺序重编号（D2）、可构造、可参与穷尽 match、值正确。
overload variant Event {
    Key(i64);
    Click(i64, i64);
}

extend variant Event {
    Wheel(i64);
}

fn code(e: Event) i64 {
    return match (e) {
        .Key(k) => k
        .Click(x, y) => x + y
        .Wheel(d) => d
    };
}

@main
fn main() i64 {
    var e: Event = Event { .Wheel(7) };
    return code(e) - 7;
}
