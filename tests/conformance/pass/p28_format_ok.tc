// EXPECT: pass
// format_* / sb_append_fmt_*：Python 格式规范迷你语言子集。
// 因 t 无变参、无 Any，故按被格式化值的类型拆成定元数内建：
//   format_int(spec, i64) / format_uint(spec, u64) / format_float(spec, f64)
//   format_str(spec, string) / format_bool(spec, bool) / format_char(spec, i64) -> string
//   sb_append_fmt_*(sb, spec, v) -> void（StringBuilder 直写变体，免中间串）
// spec 三种外壳等价：">10" / ":>10" / "{:>10}"。

@main
main fn() -> i64 {
    // 返回 string 的形态
    var a: string = format_int(">10", 42);
    var b: string = format_int("#08x", 255);
    var c: string = format_uint("_b", 5 as u64);
    var d: string = format_float(",.2f", 1234.5);
    var e: string = format_str("^11.3", "hello");
    var f: string = format_bool(">5", true);
    var g: string = format_char("<5", 65);

    // spec 外壳三写法等价
    var h1: string = format_int(">6", 7);
    var h2: string = format_int(":>6", 7);
    var h3: string = format_int("{:>6}", 7);

    // StringBuilder 直写变体（返回 void）
    var sb: StringBuilder = sb_new();
    sb_append_fmt_int(sb, ",d", 9876543);
    sb_append_fmt_uint(sb, "#x", 255 as u64);
    sb_append_fmt_float(sb, ".3f", 2.5);
    sb_append_fmt_str(sb, ">5", "ok");
    sb_append_fmt_bool(sb, "", false);
    sb_append_fmt_char(sb, "", 35);
    sb_append_str(sb, a);
    sb_append_str(sb, b);
    sb_append_str(sb, c);
    sb_append_str(sb, d);
    sb_append_str(sb, e);
    sb_append_str(sb, f);
    sb_append_str(sb, g);
    sb_append_str(sb, h1);
    sb_append_str(sb, h2);
    sb_append_str(sb, h3);

    return str_len(sb_to_str(sb)) as i64;
}
