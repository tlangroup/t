// EXPECT: pass
// T? 可选类型（可空指针模型：none = 空指针，some(x) = arena 拷贝后返回其指针）。
// 覆盖：?T 后缀类型 / ? none 字面量 / some / unwrap / is_some / is_none。
struct Point { x: i64; y: i64; }

fn make_opt(x: i64) ?i64 {
    if (x > 0) {
        return some(x);
    }
    return ?;
}

// 元素类型也可以是聚合（struct）。
fn point_sum(op: ?Point) i64 {
    if (is_some(op)) {
        var p: Point = unwrap(op);
        return p.x + p.y;
    }
    return 0;
}

@main
fn main() i64 {
    var seed: i64 = 42;
    var a: ?i64 = some(seed);
    var b: ?i64 = ?;
    var c: ?i64 = make_opt(7);
    var d: ?i64 = make_opt(-1);

    var total: i64 = 0;
    if (is_some(a)) { total = total + unwrap(a); }
    if (is_none(b)) { total = total + 1; }
    if (is_some(c)) { total = total + unwrap(c); }
    if (is_none(d)) { total = total + 1; }

    var pt: Point;
    pt.x = 10;
    pt.y = 5;
    var op: ?Point = some(pt);
    total = total + point_sum(op);
    return total;
}
