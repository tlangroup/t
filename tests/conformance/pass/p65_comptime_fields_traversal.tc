// EXPECT: pass
// R-019：编译期可遍历 @type_info(T).Struct.fields[]，按 .name 命中返回索引（哨兵 -1 表示缺失）。
// 仅静态 check（conformance 不跑运行期）：验证「CTFE 内 fields[] 有实体、可索引」已成立，
// 不再报 T-MTA-E002（field 越界）。运行期对照见 examples/comptime_ctfe_typeinfo.tc。

#pb struct Point {
    x: i64 @ 1;
    y: i64 @ 2;
    z: i64 @ 3;
}

comptime fn ct_find_field(name: string) i64 {
    var n: i64 = @type_info(Point).Struct.field_count;
    var i: i64 = 0;
    while (i < n) {
        if (@type_info(Point).Struct.fields[i].name == name) { return i; }
        i = i + 1;
    }
    return -1;
}

comptime const IDX_Z: i64 = ct_find_field("z");
comptime const IDX_MISSING: i64 = ct_find_field("nope");

@main
fn main() i64 { return 0; }
