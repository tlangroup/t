// EXPECT: pass
// bool 穷尽性：true + false 即 bool 值域全集，两臂齐备即穷尽，无需 `_` 兜底。
// 修复前：穷尽性只认 enum/variant 的 member 模式（match_covers_case 判 kind=="member"），
// bool 被当成「无 member 模式的普通标量」⇒ 对已穷尽的 bool match 假阴性报 T-MAT-E742。
// 修法：新增 match_covers_bool（判 kind=="bool" + ba）+ bool_all_cases_covered，
// 接入 sema 穷尽性判定链（与 enum_all_cases_covered 并列）。
// 该形态同时是值 `if` 的脱糖目标形态，故本用例也是 P1 的前置护栏。
fn pick(c: bool) i32 {
    return match (c) {
        true => 1,
        false => 2,
    };
}
fn main() i32 @main {
    // 同时防「穷尽性通过但运行期分派恒命中首臂」（enum 分派曾出过同类缺陷）：
    // 两分支取值必须不同，否则本用例恒真、失去判别力。
    if (pick(true) == 1 && pick(false) == 2) {
        return 0;
    }
    return 1;
}
