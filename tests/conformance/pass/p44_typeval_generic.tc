// EXPECT: pass
// P4 类型即值驱动泛型单态化（cval_type 返回值 → 实例化键）
// 验证：① @type_val 直传为类型实参；② comptime fn 返回裸类型名；③ comptime fn 按分支返回类型；
//       ④ 结构体类型经 comptime fn 返回；⑤ 类型值流入函数体类型位（var o: T）。
struct Point { x: i64; y: i64; }

fn id(comptime T: type, x: T) T { return x; }

fn echo(comptime T: type, v: T) T { var o: T; o = v; return o; }

comptime fn scalar_of(comptime B: bool) type {
    if (B) { return i64; }
    else { return f64; }
}

comptime fn type_of_pt(comptime B: bool) type {
    if (B) { return Point; }
    else { return i64; }
}

fn main() i64 @main {
    auto a = id(@type_val("i64"), 42);
    auto b = id(scalar_of(true), 7);
    auto c = id(scalar_of(false), 1.5);
    auto e = echo(Point, Point { x: 3, y: 4 });
    var p: Point = id(type_of_pt(true), Point { x: 5, y: 6 });
    if (a == 42 && b == 7 && c > 1.0 && e.x == 3 && e.y == 4
        && p.x == 5 && p.y == 6) { return 0; }
    return 1;
}
