// EXPECT: pass
// 多载荷 variant case：位置式载荷（声明序即绑定序），构造器形参为各载荷类型，
// match 构造器模式按声明序逐字段绑定。
Shape variant {
    Circle(i64);
    Rect(i64, i64);
    Tri(i64, i64, i64);
    Empty;
}

fn area(s: Shape) i64 {
    return match (s) {
        Circle(r) => 3 * r * r
        Rect(w, h) => w * h
        Tri(a, b, c) => a + b + c
        Empty => 0
    };
}

@main
fn main() i64 {
    var r: Shape = Shape_from_Rect(3, 4);
    return area(r) - 12;
}
