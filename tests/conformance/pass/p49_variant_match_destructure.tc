// EXPECT: pass
// variant 构造器模式解构（L-15）：单载荷 case 的载荷绑定到匹配臂内的名字，
// 多 case 全覆盖时视为穷尽，`_` 通配臂可选。
Shape variant {
    Circle(f64);
    Rect(f64);
    Empty;
}

area fn(s: Shape) f64 {
    return match (s) {
        Circle(r) => 3.14159 * r * r
        Rect(a) => a
        Empty => 0.0
    };
}

@main
main fn() i64 {
    return 0;
}
