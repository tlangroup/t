// EXPECT: pass
// spec §6/§9: @test / @test_group / @test_skip 注解
double_it :: func(x: i32) -> i32 {
    return x * 2;
}

test_double :: func() -> bool @test {
    return double_it(21) == 42;
}

test_grouped :: func() -> bool @test @test_group("math") {
    return double_it(0) == 0;
}

test_skipped :: func() -> bool @test @test_skip {
    return false;
}

main :: func() -> i32 @main {
    return 0;
}
