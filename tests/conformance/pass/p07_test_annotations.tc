// EXPECT: warning T_ANNOTATION_UNKNOWN
// 旧测试注解的**弃用过渡**回归：@test / @test_group / @test_skip 仍可解析，
// 但一律发弃用告警（warning，不阻断），引导迁移到 `"名字" test {}` 声明。
// 新语法的正向用例见 p07b_test_decl.tc。
double_it fn(x: i32) i32 {
    return x * 2;
}

test_double fn() bool @test {
    return double_it(21) == 42;
}

test_grouped fn() bool @test @test_group("math") {
    return double_it(0) == 0;
}

test_skipped fn() bool @test @test_skip {
    return false;
}

main fn() i32 @main {
    return 0;
}
