// EXPECT: pass
// 数组字面量类型推导：整型元素按「默认 int」提升为 i64（[1,2,3] 不再是 [3]u8），
// 定长数组 [N]T 与切片 []T 之间元素可转型即可互赋，空字面量 [] 元素类型未知、
// 可赋给任意 []T / [N]T。

@main
main :: func() -> i64 {
    // 切片字面量：运行期 slice_new + 逐元素 append
    var a: []i64 = [1, 2, 3];
    // 定长数组仍走 C 花括号初始化器；元素隐式收窄到 u8
    var lit: [3]u8 = [1, 2, 3];
    // 元素为任意表达式
    var m: []i64 = [10 * 2, 5 + 6];
    // 空字面量可赋给任意元素类型
    var e: []string = [];
    var f: []i64 = [];
    // 宽整型元素不被收窄
    var big: []i64 = [4000000000, 1];
    var n: i64 = slice_len(a) as i64;
    n = n + (lit[0] as i64) + m[1] + (slice_len(e) as i64) + (slice_len(f) as i64) + big[1];
    return n;
}
