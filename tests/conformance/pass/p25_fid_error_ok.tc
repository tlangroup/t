// EXPECT: pass
// fid_error fn(f: fid) -> string：查询句柄最近一次错误原因，无错误返回空串。
// 走系统函数（仿 fid_is_open），对越界 / 已关闭 / 打开失败的句柄一律不 panic。

report fn(f: fid) -> string {
    return fid_error(f);
}

main fn() -> i64 {
    // 标准流：从未出错 ⇒ 空串
    var e0: string = fid_error(stdout);

    // 打开失败的句柄（-1）也可查：返回最近一次 fopen 的失败原因
    var bad: fid = fopen("no_such_dir_/x.txt", :read);
    if (!fid_is_open(bad)) {
        var why: string = fid_error(bad);
        var n: i64 = str_len(why) as i64;
    }

    // 正常句柄：写、刷新、关闭后仍可查（关闭不影响 fid_error）
    var f: fid = fopen("out.txt", :write);
    if (fid_is_open(f)) {
        f < "line\n";
        fflush(f);
        var e1: string = fid_error(f);
        fclose(f);
        var e2: string = fid_error(f);
    }

    // fid 表达式做实参：函数返回值、条件表达式均可
    var e3: string = fid_error(stderr);
    var e4: string = report(stdin);
    return 0;
}
