// EXPECT: pass
// spec §2.3 Variant：带标签聚合（tagged union）
// 验证：声明 / 构造器 Name_from_Case / 判别器 Name_is_Case / 取载荷 Name_as_Case
// 均以自由函数形式经类型检查器可见，且单元 case（无载荷）与载荷 case 并存。

Shape variant {
    Circle(f64);
    Rect(f64);
    Empty;
}

describe fn(s: Shape) -> i32 {
    if (Shape_is_Circle(s)) {
        var r: f64 = Shape_as_Circle(s);
        return 1;
    }
    if (Shape_is_Rect(s)) {
        var w: f64 = Shape_as_Rect(s);
        return 2;
    }
    return 0;
}

main fn() -> i32 {
    var c: Shape = Shape_from_Circle(2.0);
    var d: Shape = Shape_from_Rect(3.0);
    var e: Shape = Shape_from_Empty();
    if (Shape_is_Circle(c)) {
        if (Shape_is_Rect(d)) {
            if (Shape_is_Empty(e)) {
                return 0;
            }
            return 1;
        }
        return 1;
    }
    return 1;
}
