// EXPECT: pass
// C2 模式消歧裁定：模式位置的裸标识符按 PascalCase 约定区分语义 ——
// 首字母大写 = CaseName（按值分发），小写 = 绑定名（匹配一切）。
// 同时验证裸 CaseName 与限定写法 `Enum.Case` 等价，且都参与 A1 穷尽性覆盖分析。

enum Color : u8 {
    Red,
    Green,
    Blue,
}

// 裸 CaseName 全覆盖，无 `_` —— C2 改写为 member 模式后被 A1 判定为穷尽
fn bare(c: Color) string {
    return match (c) {
        Red => "R"
        Green => "G"
        Blue => "B"
    };
}

// 限定写法，与上面等价
fn qualified(c: Color) string {
    return match (c) {
        Color.Red => "R"
        Color.Green => "G"
        Color.Blue => "B"
    };
}

// 大小写混用：裸 CaseName 分发 + 小写绑定兜底
fn mixed(c: Color) string {
    return match (c) {
        Red => "is-red"
        other => "not-red"
    };
}

@main
fn main() i64 {
    println(bare(Color.Green));
    println(qualified(Color.Blue));
    println(mixed(Color.Red));
    println(mixed(Color.Blue));
    return 0;
}
