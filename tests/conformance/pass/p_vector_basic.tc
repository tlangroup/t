// EXPECT: pass
// `@Vector(comptime len, BaseT)` 硬件 SIMD 向量：映射到 CPU 向量寄存器
//   C 后端   → `T __attribute__((vector_size(len * sizeof(T))))`
//   LLVM 后端 → `<len x T>`
// 覆盖：构造（@splat）/ lane 读写 / 逐元素算术 / 归约 / 编译期内省 / 运行期特性探测。
@main
fn main() i64 {
    // 1) @splat：把标量广播到全部 lane
    var a: @Vector(4, i32) = @splat(5i32, 4);
    if (a[0] != 5) { return 1; }
    if (a[3] != 5) { return 2; }

    // 2) lane 写入：向量是可下标的左值
    a[0] = 1i32;
    a[1] = 2i32;
    a[2] = 3i32;
    a[3] = 4i32;
    if (a[0] != 1) { return 3; }
    if (a[2] != 3) { return 4; }

    // 3) 逐元素算术：单条向量指令（不是 4 次标量运算）
    var b: @Vector(4, i32) = @splat(10i32, 4);
    var s: @Vector(4, i32) = a + b;      // {11,12,13,14}
    if (s[0] != 11) { return 5; }
    if (s[3] != 14) { return 6; }

    var d: @Vector(4, i32) = b - a;      // {9,8,7,6}
    if (d[0] != 9) { return 7; }
    if (d[3] != 6) { return 8; }

    var m: @Vector(4, i32) = a * b;      // {10,20,30,40}
    if (m[1] != 20) { return 9; }
    if (m[3] != 40) { return 10; }

    // 4) 位运算同样逐元素
    var x: @Vector(4, i32) = @splat(12i32, 4);   // 0b1100
    var y: @Vector(4, i32) = @splat(10i32, 4);   // 0b1010
    var ab: @Vector(4, i32) = x & y;             // 0b1000 = 8
    if (ab[0] != 8) { return 11; }
    var ob: @Vector(4, i32) = x | y;             // 0b1110 = 14
    if (ob[2] != 14) { return 12; }
    var xb: @Vector(4, i32) = x ^ y;             // 0b0110 = 6
    if (xb[3] != 6) { return 13; }

    // 5) 横向归约：整个向量塌缩成一个标量
    if (@reduce_add(s) != 50) { return 14; }     // 11+12+13+14
    if (@reduce_max(s) != 14) { return 15; }
    if (@reduce_min(s) != 11) { return 16; }

    // 6) 编译期内省
    if (@vlen(s) != 4) { return 17; }            // 这个向量的 lane 数
    if (@simd_lanes(i32) < 1) { return 18; }     // 本机寄存器能放几个 i32（>=1 恒真）
    if (@simd_lanes(i8) < @simd_lanes(i64)) { return 19; }  // 窄 lane 装得更多

    // 7) 运行期特性探测（第三层：CPU 不支持时的分派依据）。
    //    x86-64 基线必然有 sse2；avx/avx512f 因机器而异，只要求返回值合法。
    if (@cpu_has("sse2") == false) { return 20; }
    var has_avx: bool = @cpu_has("avx");
    if (has_avx) {
        if (@cpu_has("sse") == false) { return 21; }   // 有 AVX 必然有 SSE
    }
    // 未知特性名一律返回 false，不得崩溃
    if (@cpu_has("no_such_isa_feature")) { return 22; }

    // 8) f32 lane：浮点向量
    var f: @Vector(4, f32) = @splat(1.5f32, 4);
    if (f[0] != 1.5f32) { return 23; }
    var g: @Vector(4, f32) = f + f;
    if (g[2] != 3.0f32) { return 24; }

    // 9) i64 lane：宽 lane（2 个刚好占满 16 字节）
    //    ⚠ 必须写 `7i64`：裸字面量按量级猜类型（`7` → u8，见 reference.md §2.4），
    //      @splat 的 lane 类型直接取第一实参的类型，不会被声明类型反推。
    var h: @Vector(2, i64) = @splat(7i64, 2);
    if (@reduce_add(h) != 14) { return 25; }
    if (@vlen(h) != 2) { return 26; }

    // 10) 无符号 lane：@splat 的裸字面量路径（u8 是裸 `7` 的自然类型）
    var u: @Vector(8, u8) = @splat(7, 8);
    if (@reduce_add(u) != 56) { return 27; }
    if (@vlen(u) != 8) { return 28; }

    return 0;
}
