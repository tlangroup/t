// EXPECT: pass
// open-variant（阶段三）：extend 追加「多载荷」构造器（Wheel(i64, i64)），验证多载荷 case 合并后
// 仍按声明序逐字段绑定、tag 重编号正确。
overload variant Event {
    Key(i64);
}

extend variant Event {
    Wheel(i64, i64);
}

fn code(e: Event) i64 {
    return match (e) {
        .Key(k) => k
        .Wheel(d, b) => d + b
    };
}

@main
fn main() i64 {
    var e: Event = Event { .Wheel(5, 7) };
    return code(e) - 12;
}
