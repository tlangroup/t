// EXPECT: pass
// map 字面量与 for-in 迭代（M30）：`var m: map[K]V = [k: v, ...]` 初始化、
// 无初始化声明即空表、for-in 迭代键（绑定变量类型 = K）、迭代中 m[k] 取值。
// 键/值可直接写字面量；窄整型键（i32）在运行时统一按 i64 存储。

@main
main fn() -> i64 {
    // 字面量初始化：整型键/值按默认 int 提升为 i64（同数组字面量规则）
    var m: map[string]i64 = ["alice": 1, "bob": 2];
    var total: i64 = 0;
    for (k in m) {
        total = total + m[k];
    }

    // 无初始化声明即空表，可直接 set；键/值允许字面量
    var e: map[string]i64;
    map_set(e, "x", 42);
    total = total + map_get(e, "x") + map_len(e);

    // i64 键字面量
    var p: map[i64]i64 = [10: 100, 20: 200];
    for (pk in p) {
        total = total + pk + p[pk];
    }

    // i64 键 / string 值
    var q: map[i64]string = [1: "one"];
    for (qk in q) {
        total = total + qk + (str_len(q[qk]) as i64);
    }

    // 窄整型键
    var w: map[i32]i64;
    map_set(w, 7, 700);
    for (wk in w) {
        total = total + (wk as i64);
    }
    total = total + map_get(w, 7);

    return total;
}
