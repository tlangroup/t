// EXPECT: pass
// overload Route 1：单文件值/标量/字符串/when 守卫 overload 组 + 同文件 extend overload。
// 复用既有函数子句脱糖；双后端一致（无 struct 字面量模式）。
struct Point { x: i64; y: i64; }

overload fn classify(0) string { return "zero"; }
overload fn classify(n when n > 0) string { return "pos"; }
overload fn classify(_) string { return "neg"; }

overload fn label("a") string { return "A"; }
overload fn label(_) string { return "?"; }

overload fn kind(v: i64) string { return "i64"; }

overload fn pick(0) i64 { return 100; }
overload fn pick(_) i64 { return 200; }
extend overload fn pick(9) i64 { return 999; }

@main
fn main() i64 {
    if (classify(0) != "zero") { return 1; }
    if (classify(3) != "pos") { return 2; }
    if (classify(0 - 1) != "neg") { return 3; }
    if (label("a") != "A") { return 4; }
    if (label("z") != "?") { return 5; }
    if (kind(7) != "i64") { return 6; }
    if (pick(0) != 100) { return 7; }
    if (pick(9) != 999) { return 8; }
    if (pick(4) != 200) { return 9; }
    return 0;
}
