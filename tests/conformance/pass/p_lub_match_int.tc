// EXPECT: pass
// P2（everything-is-value 补齐）：match 分支整型 widen-only lub。
// i8 + i16 + i32 -> i32，对称、与书写顺序无关。
fn pick(x: i32) i32 {
    return match (x) {
        1 => 10 as i8,
        2 => 20 as i16,
        _ => 30 as i32,
    };
}
fn main() i32 @main {
    if (pick(1) == 10 and pick(2) == 20 and pick(7) == 30) {
        return 0;
    }
    return 1;
}
