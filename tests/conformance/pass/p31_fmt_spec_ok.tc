// EXPECT: pass
// 各种合法的格式化 spec 字面量（编译期文法校验应全部通过）。
// 覆盖：外壳 {:>10} / 前导 : / 裸 >10、fill+align、sign、#、0、width、grouping、precision、各类 type。
@main
main fn() i64 {
    var a: string = format_int(":>10", 42);
    var b: string = format_int("<10", -7);
    var c: string = format_int("*^10", 42);
    var d: string = format_int("=+10", -7);
    var e: string = format_int("#08x", 255);
    var f: string = format_int("b", 11);
    var g: string = format_int(",d", 1234567);
    var h: string = format_int("_x", 0xABCDEF);
    var i2: string = format_int("05d", -42);
    var j2: string = format_int(".4d", 7);
    var k: string = format_uint("x", 255 as u64);
    var l: string = format_uint("#016b", 5 as u64);
    var m: string = format_float(".2f", 3.14159);
    var n: string = format_float(">10.2f", 3.14159);
    var o: string = format_float("+.2f", 3.14159);
    var p: string = format_float("e", 1234.0);
    var q: string = format_float(".2%", 0.5);
    var r: string = format_float("g", 1234567.0);
    var s: string = format_str("<10", "hi");
    var t2: string = format_bool("!", true);
    var u: string = format_char("c", 65);
    return 0;
}
