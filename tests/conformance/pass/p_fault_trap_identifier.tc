// EXPECT: pass
// 回归（fault v2 选项 A：paren-aware 前瞻）：用户可定义名为 `trap` 的函数，
// 在表达式位其调用 / 引用不应被「trap 关键词」抢走。
//   · `trap(5)`   —— 紧跟 `(` ⇒ 跨过平衡括号组后若不是 `{` 即判为调用（标识符读法）
//   · `var f = trap;` —— 紧跟终结符 `;` ⇒ 标识符读法（裸引用）
// 关键词 `trap <e> { … }` 形态由 p_fault_trap.tc 覆盖，本例只证明标识符读法没被误吞。

fn trap(x: i64) i64 {
    return x + 1;
}

fn main() i64 {
    var a: i64 = trap(5);          // 调用用户函数
    var f: fn(i64) i64 = trap;     // 裸引用函数（标识符读法）
    var b: i64 = f(10);
    return a + b;                  // 6 + 11 = 17
}
