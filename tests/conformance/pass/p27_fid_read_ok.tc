// EXPECT: pass
// 读路径（`>` 反序列化）类型检查：裸 T 结果、各标量宽度与 string/atom 均受支持。
@main
main fn() -> i64 {
    var w: fid = fopen("out/_p27.bin", :write_binary);
    w < 1 < 2 < 3.0 < true < :ok < "x";
    fclose(w);
    var r: fid = fopen("out/_p27.bin", :read_binary);
    var a: i64 = r > i64;
    var b: i8 = r > i8;
    var c: u8 = r > u8;
    var d: f64 = r > f64;
    var e: bool = r > bool;
    var at: atom = r > atom;
    var s: string = r > string;
    println(s);
    fclose(r);
    return 0;
}
