// EXPECT: pass
// bytes：{ptr, len} 16B 二进制视图，与 string 同布局、类型独立（kind=Bytes）；
// BytesBuilder：可增长字节缓冲，对应 string 的 StringBuilder（复用 TSb*）。
// 内建全部复用 t_str_*/t_sb_* 运行时（含 LLVM @tll_* shim），零新增运行时代码。

fn main() i32 @main {
    // —— 用 BytesBuilder 构造字节序列 "hi!" ——
    var bb: BytesBuilder = bsb_new();
    bsb_append_u8(bb, 104u8);   // 'h'
    bsb_append_u8(bb, 105u8);   // 'i'
    bsb_append_u8(bb, 33u8);    // '!'
    var b: bytes = bsb_to_bytes(bb);

    // bytes_len
    if (bytes_len(b) != 3u64) { return 1; }

    // bytes_at（下标索引，返回 u8）
    if (bytes_at(b, 0) != 104u8) { return 2; }
    if (bytes_at(b, 1) != 105u8) { return 3; }
    if (bytes_at(b, 2) != 33u8) { return 4; }

    // bytes 子切片 b[0..2] = "hi"
    var b2: bytes = bytes_slice(b, 0, 2);
    if (bytes_len(b2) != 2u64) { return 5; }
    if (bytes_at(b2, 0) != 104u8) { return 6; }
    if (bytes_at(b2, 1) != 105u8) { return 7; }

    // 索引运算符 [i] 走 bytes_at（与 string[str_at] 同构）
    if (b[0] != 104u8) { return 8; }
    if (b[2] != 33u8) { return 9; }

    // 再构造："hi" + '?' = "hi?"
    var bb2: BytesBuilder = bsb_new();
    bsb_append_bytes(bb2, b2);
    bsb_append_u8(bb2, 63u8);   // '?'
    var b3: bytes = bsb_to_bytes(bb2);
    if (bytes_len(b3) != 3u64) { return 10; }
    if (bytes_at(b3, 0) != 104u8) { return 11; }
    if (bytes_at(b3, 1) != 105u8) { return 12; }
    if (bytes_at(b3, 2) != 63u8) { return 13; }

    return 0;
}
