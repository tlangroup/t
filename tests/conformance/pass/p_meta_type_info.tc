// EXPECT: pass
// M1/D1 + @type_info 元函数：
// ① `comptime plain(3)` 强制编译期执行普通双栖函数（v3 模型，无需 comptime fn 声明标记）；
// ② `@type_info(Point)` 是编译期内建元函数，解析期脱糖为 typeinfo 节点，复用既有
//    type_info(T) 后端合成 @__ti_Point 常量，运行期经 ti_* accessor 取反射信息。
// Point{x:i64,y:i64} => 2 字段 / 16 字节。
fn plain(x: i64) i64 { return x + x; }

struct Point {
    x: i64;
    y: i64;
}

fn main() i32 @main {
    var a: i64 = comptime plain(3);
    var ti: TypeInfo = @type_info(Point);
    var nfields: i64 = ti_field_count(ti);
    var nbytes: i64 = ti_size(ti);
    if (a == 6 && nfields == 2 && nbytes == 16) { return 0; }
    return 1;
}
