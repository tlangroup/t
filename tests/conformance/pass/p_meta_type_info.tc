// EXPECT: pass
// M1/D1 + @type_info 元函数（阶段5 改写）：
// ① `comptime plain(3)` 强制编译期执行普通双栖函数（v3 模型，无需 comptime fn 声明标记）；
// ② `@type_info(Point)` 是编译期内建元函数，解析期脱糖为 typeinfo 节点，复用既有
//    type_info(T) 后端合成 @__ti_Point 常量，运行期经 match 解构 + FieldInfo 字段投影取反射信息
//    （替代已删除的 v1 遗留 ti_field_count/ti_size 访问函数，见设计文档 §4.5）。
// Point{x:i64,y:i64} => 2 字段 / 16 字节。
fn plain(x: i64) i64 { return x + x; }

struct Point {
    x: i64;
    y: i64;
}

fn main() i32 @main {
    var a: i64 = comptime plain(3);
    var ti: TypeInfo = @type_info(Point);
    var m: *TypeMeta = match (ti) { .Struct(mt) => mt, _ => null };
    var nfields: i64 = m.field_count;
    var nbytes: i64 = m.size;
    if (a == 6 and nfields == 2 and nbytes == 16) { return 0; }
    return 1;
}
