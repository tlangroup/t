// EXPECT: pass
// 积类型统一 epic P2：位域字段语法 —— `packed struct` 的字段类型写作 `uN`，
// 数字后缀 N 即位宽（`readable: u1` = 1 位，`level: u4` = 4 位）。
// 本阶段只要求 u1..u65535 作为合法字段类型被接受；真正的按位打包在 P4。
//
// 下限不对称：`u1` 合法（位域基本单元），`i1` 非法
// （C23 signed _BitInt 需 ≥ 2 位，见 base.tc awi_min_bits 与 fail/f89）。

packed struct Perm {
    readable: u1;
    level: u4;
    tag: u12;
}

// 非 packed 的普通 struct 上，窄 uN 仍是合法普通窄整型（不强约束为位域）。
struct Narrow {
    n: u4;
}

fn main() i32 @main {
    var p: Perm = Perm{ readable: 1, level: 5, tag: 300 };
    var q: Narrow = Narrow{ n: 3 };
    var one: u1 = 1;
    if ((p.readable as i64) == 1 and (p.level as i64) == 5
        and (p.tag as i64) == 300 and (q.n as i64) == 3
        and (one as i64) == 1) {
        return 0;
    }
    return 1;
}
