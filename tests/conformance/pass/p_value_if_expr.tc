// P1（everything-is-value）：值位置的 `if` —— 解析期脱糖为 `match (c) { true => T, false => E }`
// 分支体须为单一表达式（Block 取值属 P1 Stage 1 后续）。
// EXPECT: pass

fn pick(c: bool) i32 {
    return if (c) { 1; } else { 2; };
}

fn clamp(n: i64) i64 {
    // 值 if 出现在 var 初值（非 return）位置
    var v: i64 = if (n > 0) { n; } else { 0; };
    return v;
}

fn main() i32 @main {
    if (pick(true) == 1 && clamp(5) == 5 && clamp(0 - 5) == 0) {
        return 0;
    }
    return 1;
}
