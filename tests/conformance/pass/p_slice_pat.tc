// EXPECT: pass
// S6 切片模式（草稿 match.md §6.1 / match_extensions.md §3）：
// 精确长度 [a, b]、收尾用 `_` 满足穷尽性（切片无有限穷尽集）；
// 多臂切片模式（含 [..] 全通配收尾）验证 parse_postfix 防贪婪修复。
fn head2(s: []i64) i64 {
    return match (s) {
        [a, b] => a * 10 + b
        _ => -1
    };
}
fn classify(s: []i64) string {
    return match (s) {
        [] => "zero"
        [x] => "one"
        [x, y] => "two"
        [..] => "many"
    };
}
@main
fn main() i64 { return 0; }
