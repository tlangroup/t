// EXPECT: pass
// Sym 合法用法：var 声明、字符串赋值(自动 intern)、sym_str 取串、
// 同类型 Sym 按 id 相等/不等、sym_release("tag") 按池释放、sym_release_all() 全局释放。
@main
main fn() i64 {
    var a: Sym32("NPCName") = "Alice";
    var b: Sym32("NPCName") = "Bob";
    var s: string = sym_str(a);
    if (a == b) { }
    if (a != b) { }
    sym_release("NPCName");
    sym_release_all();
    return 0;
}
