// EXPECT: pass
// 弥漫式 comptime 折叠之后 —— if 常量分支剪枝（独立 pass，AST 层消除死分支）。
// 验证：if 条件为编译期已知 bool 时，存活分支被保留、死分支被直接丢弃：
//   • 字面量 true/false 条件；
//   • const 算术条件（C>3 已被折叠为字面量 bool）；
//   • const bool 标识符（只读 meta_eval 取值，不改写 AST）；
//   • else-if 链（fixpoint 循环逐层剪枝，最终只留命中分支）。
// 落点：src/comptime_fold.tc comptime_if_prune_pass（复用 mb_prune_if 安全改写形态：
//       替换父 kids 槽为 mk_block(存活分支)，绝原地改 if kind、绝中途 meta_eval）。
const C: i64 = 5;
const FLAG: bool = true;
const K: i64 = 2;

fn main() i64 @main {
    var x: i64 = 0;
    if (C > 3) { x = 10; } else { x = 20; }     // 折 true → 留 then
    if (FLAG) { x = x + 1; } else { x = x + 100; } // const bool → 留 then
    if (false) { x = 999; }                       // 字面量 false → 剪 then
    if (true) { x = x + 1; }                      // 字面量 true → 剪 else
    // else-if 链：K=2 → K>10 假 / K>5 假 / K>1 真，fixpoint 逐层剪到命中分支
    if (K > 10) { x = x + 1000; }
    else if (K > 5) { x = x + 1000; }
    else if (K > 1) { x = x + 7; }
    else { x = x + 1000; }
    print(int_to_str(x));   // 期望 12 + 7 = 19
    print("\n");
    return 0;
}
