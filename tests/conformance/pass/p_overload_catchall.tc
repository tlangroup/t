// EXPECT: pass
// R2/R1 兜底臂重排：裸绑定兜底子句（无守卫/无模式）即便写在最前，也必须排到 match 臂
// 末尾，否则会遮蔽后续守卫子句（回归 overload_cross_a.tc 的 classify 跨文件组）。
// 单文件形态即可在双后端复现该回归。
overload fn classify(n: i64) string { return "default"; }
overload fn classify(n: i64 when n > 100) string { return "big"; }
overload fn classify(n: i64 when n < 0) string { return "negative"; }

@main
fn main() i64 {
    if (classify(5) != "default") { return 1; }
    if (classify(200) != "big") { return 2; }
    if (classify(-1) != "negative") { return 3; }
    return 0;
}
