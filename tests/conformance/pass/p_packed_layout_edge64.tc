// EXPECT: pass
// 积类型统一 P4：packed struct 位布局 · 正向——恰好压满 64 位边界。
// 1 + 4 + 12 + 47 = 64，命中上限但不越过，应通过（边界值必须是合法的那一侧）。
// 同时覆盖 bool 字段（位集合里的布尔就是单比特）。

packed struct Edge64 {
    enabled: bool;
    level: u4;
    tag: u12;
    rest: u47;
}

fn main() i32 @main {
    var e: Edge64 = Edge64{ enabled: true, level: 5, tag: 300, rest: 0 };
    if ((e.level as i64) == 5 && (e.tag as i64) == 300) {
        return 0;
    }
    return 1;
}
