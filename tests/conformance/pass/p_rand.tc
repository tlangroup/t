// EXPECT: pass
// P2：std.rand 确定性伪随机数（语义层接受）。
// 运行期正确性由 examples/rand_demo.tc 在双后端守卫；此处仅确认语义检查通过。
@import("std.rand");

fn use_rand() i64 {
    rand.srand(42);
    var a: i64 = rand.rand_i64();
    var b: i64 = rand.rand_range(1, 7);
    var c: f64 = rand.rand_float();
    return a + b + (c as i64);
}
