// EXPECT: pass
// 回归（2026-10-18）：`as <类型>` 之后的 `&&` / `||` 是**值级**逻辑运算，不是类型位的
// concept 多约束连词 `T: A && B`。此前 parse_type 在任意类型位都吃 `&&`，于是
// `x as i64 && y[i] > 0` 被解析成类型 `i64 && y` 并在 `[` 处报 T_PARSE_SYNTAX——
// 编译器自身旧版源码大量使用该写法，直接让自举种子编不动旧版本（nightly 自举步失败）。
// 本例锁定：转换后的 `&&` / `||` 一律回到值级布尔运算，右侧索引/调用照常解析。

fn at(a: []i64, i: i64) i64 { return a[i]; }

@main fn main() i32 {
    var xs: []i64 = [10, 20, 30];
    var n: i64 = 3;
    var i: i64 = 1;
    // `as` + `&&` + 索引
    if (i < (slice_len(xs) as i64) && xs[i] >= 20) {
    } else {
        return 1;
    }
    // `as` + `&&` + 调用
    if (i < (n as i64) && at(xs, i) != 20) { return 2; }
    // `as` + `||`
    if (i > (n as i64) || xs[i] == 20) {
    } else {
        return 3;
    }
    // 混合拼写：关键字 `and` 与符号 `&&` 在 `as` 之后同义
    if (i < (n as i64) and xs[i] == 20) {
    } else {
        return 4;
    }
    // `as` + `&&` + 括号内的 `||`
    if (i < (n as i64) && (n > 2 || i == 9)) {
    } else {
        return 5;
    }
    return 0;
}
