// EXPECT: pass
// 回归（2026-10-18）：`as <类型>` 之后的逻辑运算是**值级**的，不是类型位的
// concept 多约束连词 `T: A && B`。此前 parse_type 在任意类型位都吃 `&&`，于是
// `x as i64 && y[i] > 0` 被解析成类型 `i64 && y` 并在 `[` 处报 T_PARSE_SYNTAX——
// 编译器自身旧版源码大量使用该写法，直接让自举种子编不动旧版本（nightly 自举步失败）。
// 本例锁定：转换后的逻辑运算一律回到值级布尔，右侧索引/调用照常解析。
// §set-ops step2 迁移（2026-10-26）：布尔拼写统一为 `and` / `or`（`&&` / `||` 归集合代数），
// 且值级合取必须用 `and` —— `"&&"` 在 opmap 无映射会降级成 `add i1`。

fn at(a: []i64, i: i64) i64 { return a[i]; }

@main fn main() i32 {
    var xs: []i64 = [10, 20, 30];
    var n: i64 = 3;
    var i: i64 = 1;
    // `as` + `and` + 索引
    if (i < (slice_len(xs) as i64) and xs[i] >= 20) {
    } else {
        return 1;
    }
    // `as` + `and` + 调用
    if (i < (n as i64) and at(xs, i) != 20) { return 2; }
    // `as` + `or`
    if (i > (n as i64) or xs[i] == 20) {
    } else {
        return 3;
    }
    // 混合拼写：关键字 `and`（统一布尔拼写）
    if (i < (n as i64) and xs[i] == 20) {
    } else {
        return 4;
    }
    // `as` + `and` + 括号内的 `or`
    if (i < (n as i64) and (n > 2 or i == 9)) {
    } else {
        return 5;
    }
    return 0;
}
