@main
fn main() i64 {
    var t: i64 = 1754254290123456;
    var a: string = format_time("%c", t);
    var b: string = format_time("%x %X", t);
    var c2: string = format_time_tz("%Y-%m-%d %H:%M:%S %z %Z", t, 480);
    var d2: string = format_time_tz("%c (%Z)", t, -330);
