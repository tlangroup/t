// EXPECT: pass
// P2：std.cli 命令行参数解析（语义层接受）。
// 运行期正确性由 examples/cli_demo.tc 在双后端守卫；此处仅确认语义检查通过。
@import("std.cli");

fn use_cli() i64 {
    var argv: []string;
    append(argv, "--n=5");
    append(argv, "pos1");
    var fl: map[string]string;
    var pos: []string = cli.parse_args(argv, fl);
    return cli.get_flag_int(fl, "n", 0) + (slice_len(pos) as i64);
}
