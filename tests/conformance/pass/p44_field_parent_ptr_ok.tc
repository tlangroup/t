// P4b：@field_parent_ptr(Parent, child_ptr, "field") —— 运行期 container_of。
// 对齐 Zig 的 @fieldParentPtr：由成员指针反推容器指针（编译期已知字段偏移，运行期做指针运算）。
// 实现：sema 把 mbuiltin 节点原地脱糖为 cast(*Parent, (u8*)child_ptr - @offset_of(Parent, field))，
//       其中 (u8*)child_ptr 是 provenance 保持的字节指针位重解释，减偏移走「指针±整数」GEP
//       （按元素宽度缩放，u8 ⇒ 字节偏移），与 C/LLVM 指针算术语义一致；不依赖 cast(ptr,i64)。
// 验证：运行期正确性由 build+run 单独核验（本例 offset=8 与 offset=0 两种情形），conformance 仅 check。
// EXPECT: pass
struct Point {
    x: i64;
    y: i64;
}

@main fn main() i32 {
    var p: Point;
    p.x = 10;
    p.y = 20;
    var fp: *i64 = &p.y;
    var base: *Point = @field_parent_ptr(Point, fp, "y");
    var recovered: Point = *base;
    if (recovered.x != 10) { return 1; }
    if (recovered.y != 20) { return 2; }
    var fx: *i64 = &p.x;
    var base2: *Point = @field_parent_ptr(Point, fx, "x");
    var recovered2: Point = *base2;
    if (recovered2.x != 10) { return 3; }
    if (recovered2.y != 20) { return 4; }
    return 0;
}
