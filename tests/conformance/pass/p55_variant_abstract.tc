// EXPECT: pass
// 抽象 variant（`_` 末位标记）：match 不要求穷尽 —— 只覆盖部分 case 且无 `_` 兜底臂，
// 编译应通过（封闭 variant 同样写法会报 T_MATCH_NONEXHAUSTIVE）。
Status variant {
    Ok;
    Fail;
    _
}
fn f(c: Status) i64 {
    return match (c) {
        Ok => 1
        Fail => 0
    };
}
@main
fn main() i64 {
    return f(Status_from_Ok());
}
