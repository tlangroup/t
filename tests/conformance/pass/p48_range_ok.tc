// EXPECT: pass
// 区间字面量全量（reference.md §3.16，2026-08-11）。
// 四种形态 `a..b` / `a..=b` / `a..` / `..` 在四类上下文里各自降解：
//   for 迭代 → 计数循环；索引 → str_slice/slice_sub；match 臂 → 比较链；
//   `x in r` → 比较合取；其余值位置 → 物化成 []i64。
// 区间不是运行期值：两个后端永远看不到裸 `range` 节点。

classify fn(x: i64) string {
    return match (x) {
        0 => "zero",
        1..5 => "small",       // 半开：1,2,3,4
        5..=9 => "mid",        // 闭合：5..9
        10.. => "big",         // 开放右端
        _ => "neg",
    };
}

sum_iter fn() i64 {
    var acc: i64 = 0;
    for (i in 0..5) { acc = acc + i; }       // 10
    for (i in 1..=4) { acc = acc + i; }      // +10
    return acc;
}

// 上界先落临时量：右端只求值一次，循环体改写上界变量不影响轮数
hi_evaluated_once fn() i64 {
    var n: i64 = 4;
    var cnt: i64 = 0;
    for (i in 0..n) { cnt = cnt + 1; n = 100; }
    return cnt;
}

// 开放右端 = 无终止条件，靠 break 收口
open_upper fn() i64 {
    var acc: i64 = 0;
    for (i in 3..) {
        if (i > 6) { break; }
        acc = acc + i;
    }
    return acc;
}

str_ranges fn() i64 {
    var msg: string = "hello world";
    var n: i64 = 0;
    n = n + (str_len(msg[0..5]) as i64);      // "hello" = 5
    n = n + (str_len(msg[6..]) as i64);       // "world" = 5
    n = n + (str_len(msg[..5]) as i64);       // "hello" = 5
    n = n + (str_len(msg[..]) as i64);        // 全串   = 11
    n = n + (str_len(msg[6..=8]) as i64);     // "wor"  = 3
    return n;
}

slice_ranges fn() i64 {
    var xs: []i64 = [];
    for (i in 0..6) { append(xs, i * 10); }
    var sub: []i64 = xs[2..5];
    var tail: []i64 = xs[4..];
    var whole: []i64 = xs[..];
    return (slice_len(sub) as i64) + (slice_len(tail) as i64) + (slice_len(whole) as i64);
}

in_tests fn() bool {
    var k: i64 = 7;
    if ((k in 5..10) == false) { return false; }
    if ((k in 0..=7) == false) { return false; }
    if (k in 8..) { return false; }
    return true;
}

// 值位置：两端俱全的区间物化成 []i64
materialized fn() i64 {
    var xs: []i64 = 2..6;
    var acc: i64 = 0;
    for (v in xs) { acc = acc + v; }
    return acc;
}

main fn() i32 @main {
    var ok: bool = true;
    if (sum_iter() != 20) { ok = false; }
    if (hi_evaluated_once() != 4) { ok = false; }
    if (open_upper() != 18) { ok = false; }
    if (str_ranges() != 29) { ok = false; }
    if (slice_ranges() != 11) { ok = false; }
    if (in_tests() == false) { ok = false; }
    if (materialized() != 14) { ok = false; }
    if (classify(3) != "small") { ok = false; }
    if (classify(9) != "mid") { ok = false; }
    if (classify(42) != "big") { ok = false; }
    if (ok == false) { return 1; }
    return 0;
}
