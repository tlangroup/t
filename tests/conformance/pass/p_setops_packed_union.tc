// EXPECT: pass
// §set-ops step2b：位域（packed struct）的 `||` = 集合并（宿主整型 OR）。
// 本例只做类型检查；运行期语义由 examples/setops_packed.tc 的 golden 覆盖。
packed struct Perm {
    readable: u1;
    writable: u1;
    level:    u4;
    owner_id: u8;
}
@main fn main() i32 {
    var a: Perm = Perm{ readable: 1, writable: 0, level: 7, owner_id: 42 };
    var b: Perm = Perm{ readable: 1, writable: 1, level: 3, owner_id: 42 };
    var c: Perm = a || b;   // 并：`||`
    var d: Perm = a | b;    // 并：`|`（位域上同义）
    var e: Perm = (a || b) || a;
    return 0;
}
