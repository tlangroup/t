// EXPECT: pass
// 引用与解引用（reference.md）：
//   &x  取址，操作数须为可寻址左值（变量/字段/下标）；
//   *r  解引用读取；*r = v 经可变引用写入；
//   读写性由绑定关键字决定——let/const 只读、var 可变；
//   同块内重定义同名绑定使旧绑定失效（shadowing），后端唯一化命名避免碰撞。
@main
main fn() i64 {
    var a: i32 = 1;
    let r1 = &a;        // 只读引用
    var r2 = &a;        // 可变引用
    var x: i32 = *r1;   // 经只读引用读
    *r2 = 10;           // 经可变引用写（写入 a）
    var b: i32 = 2;
    let r1 = &b;        // 重定义 r1，旧 r1 已失效
    println(i2s(*r1));  // 期望 2
    println(i2s(*r2));  // 期望 10
    println(i2s(a));    // 期望 10
    return 0;
}
