// P3: @as (coercion) and @bit_cast (bit reinterpretation), evaluated at comptime.
// EXPECT: pass
//
// 两者都在 CTFE 折叠成字面量，故两个后端看到的都只是普通常量。
// 运行期使用暂不支持：会以「下发非法 IR → clang 链接失败」响亮失败（非静默错编）；
// 后续拟在 sema 里把 @as 脱糖成既有 cast 节点以支持运行期。

comptime fn p42_checks() bool {
    // @as: widening preserves value
    if (@as(i64, 42) != 42) { return false; }
    // @as: narrowing wraps (300 -> u8 = 44)
    if (@as(u8, 300) != 44) { return false; }
    // @as: signedness reinterpretation (255 -> i8 = -1)
    if (@as(i8, 255) != -1) { return false; }
    // @as: int -> float
    if (@as(f64, 3) != 3.0) { return false; }
    // @as: float -> int (truncates toward zero)
    if (@as(i32, 3.75) != 3) { return false; }
    // @as: bool -> int
    if (@as(i32, true) != 1) { return false; }
    // @bit_cast: same-width reinterpretation (255 -> i8 = -1)
    if (@bit_cast(i8, 255) != -1) { return false; }
    // @bit_cast: truncation (0x1234 -> u8 = 0x34 = 52)
    if (@bit_cast(u8, 4660) != 52) { return false; }
    return true;
}

@main
fn main() i32 {
    if (comptime p42_checks() == false) { return 1; }
    return 0;
}
