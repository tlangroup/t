// EXPECT: pass
// 切片字面量作表达式：语义层接受 s=[a,b,c]（赋值 RHS）/ return [..] / f([..])（切片形参）。
// （运行时发射正确性由 examples/slice_literal_arg.tc 双后端实跑守卫。）

fn first3() []i64 { return [10, 20, 30]; }

fn sum_slice(a: []i64) i64 {
    var t: i64 = 0;
    var i: i64 = 0;
    while (i < (slice_len(a) as i64)) {
        t = t + a[i];
        i = i + 1;
    }
    return t;
}

@main
fn main() i64 {
    var s: []i64 = [];
    s = [1, 2, 3];
    var r: []i64 = first3();
    if (slice_len(s) != 3) { return 1; }
    if (sum_slice(r) != 60) { return 2; }
    if (sum_slice([4, 5, 6]) != 15) { return 3; }
    return 0;
}
