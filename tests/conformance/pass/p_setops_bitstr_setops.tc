// EXPECT: pass
// §set-ops §13.3：格族统一为 `&` / `|`；bitstr 上它们是**集合交 / 并**（内建实现）。
// 本例只做类型检查（conformance pass 用例不运行程序）；运行期语义由
// examples/setops_bitstr.tc 的 golden 覆盖。
@main fn main() i32 {
    var a: bitstr = <<1:1, 0:1, 1:1>>;
    var b: bitstr = <<1:1, 1:1, 0:1>>;
    var c: bitstr = a & b;
    var d: bitstr = a | b;
    var e: bitstr = (a & b) | a;
    return 0;
}
