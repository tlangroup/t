// EXPECT: pass
// §set-ops step2：`&&` / `||` 对 bitstr 是**集合交 / 并**（内建实现）。
// 本例只做类型检查（conformance pass 用例不运行程序）；运行期语义由
// examples/setops_bitstr.tc 的 golden 覆盖。
@main fn main() i32 {
    var a: bitstr = <<1:1, 0:1, 1:1>>;
    var b: bitstr = <<1:1, 1:1, 0:1>>;
    var c: bitstr = a && b;
    var d: bitstr = a || b;
    var e: bitstr = a & b;
    var f: bitstr = a | b;
    return 0;
}
