// EXPECT: pass
// 一等子句字面量 `@clause(...)`（docs/compiler/first-class-clause.md §1.1 / §5.1 / §5.2）
//
// 覆盖：
//   · 三段（无守卫）            `@clause(.pattern, n, n * 2)`
//   · 五段（`when` 引出守卫）    `@clause(.pattern, n, when n > 0, n * 2)`
//   · 通配句型                  `@clause(.pattern, _, "other")`
//   · `[N]clause` 数组字面量    与 `++` 顺序合并（复用既有 Array 分支的 [N+M] 规则）
//
// ⚠ 关键回归探针 ① —— 参数位一律**不求值**：
//   body 里的 `n` 是 pattern 绑定出来的名字，构造时尚无任何绑定。若 `@clause`
//   按普通求值语义处理参数，这里会报「未定义标识符」（T-SEM-E201）。
//   本用例能 pass，即证明 pattern / guard / body 三个位置确实是 AST 位置。
//
// ⚠ 关键回归探针 ② —— `clause` 是**独立的一等类型种类**，不是未解析的 "Named"：
//   早先用 ti_named("Named","clause") 时，`fn f() i64 { return A; }` 会 0 error
//   静默放行（等同 Unknown）。改为 ti_mk("Clause") 后该错编已由下方 E_STMT 断言拦住
//   （见 fail/f_clause_escape.tc）。
//
// ⚠ 显式标注是**必需**的：未标注的全局 const 不回填符号类型，这是 t 既有的通用
//   行为（`const A = [1,2]; const B: i64 = A;` 同样静默放行），非本特性引入。

const C_PLAIN: clause = @clause(.pattern, n,            n * 2);
const C_GUARD: clause = @clause(.pattern, n, when n > 0, n * 2);
const C_WILD:  clause = @clause(.pattern, _,            "other");

const G1: [3]clause = [C_PLAIN, C_GUARD, C_WILD];
const G2: [4]clause = G1 ++ [C_WILD];

@main
fn main() i64 {
    return 0;
}
