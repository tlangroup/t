// EXPECT: pass
// 位置式模式解构绑定（#4）：`.{a,b}` 匿名元组 + `Name{a,b}` 具名结构，`tc check` 必须接受。
struct Pt { x: i64; y: i64; }

fn f(p: Pt) i64 {
    return match (p) {
        Pt{a, b} => a + b,
        _ => 0 - 1,
    };
}

fn g(t: .{i64, i64}) i64 {
    return match (t) {
        .{a, b} => a + b,
        _ => 0 - 1,
    };
}

fn h(t: .{i64, i64}) i64 {
    return match (t) {
        .{1, b} => b,
        .{a, _} => a,
        _ => 0 - 1,
    };
}
