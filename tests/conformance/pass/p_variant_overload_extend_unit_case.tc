// EXPECT: pass
// open-variant（阶段三）：extend 追加「单元（无载荷）」构造器（Nop），验证单元 case 合并后
// match 模式不带 `()`、tag 重编号正确。
overload variant Op {
    Add(i64, i64);
}

extend variant Op {
    Nop;
}

fn run(o: Op) i64 {
    return match (o) {
        .Add(a, b) => a + b
        .Nop => 0
    };
}

@main
fn main() i64 {
    var o: Op = Op { .Nop };
    return run(o);
}
