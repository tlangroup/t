// EXPECT: pass
// f-string 字面量（M-fstr）：`f"..."` / `f"""..."""`。
// 解析期就地脱糖为 `format(模板, 实参...)`，随后复用 M55 的 __fmt_N 提升，
// 因此插值表达式只求值一次，且与 `format()` 共享同一套模板文法与诊断码。
//   插值    : `{Expr}`         → 手动索引占位 `{N}`
//   转换字段: `{Expr!conv}`    → conv ∈ s|r|a|j|c|p（六种均可作用于任意值类型）
//   格式规范: `{Expr:spec}`    → 与 format() 的 spec 完全一致
//   转义花括: `{{` / `}}`      → 字面量 `{` / `}`
// 新语义：!j=json !p=pbtxt !c=csv（均为「把值序列化成该格式」；标量即裸值，字符串做格式专属转义）

fn fstr_basic() string {
    var name: string = "world";
    var n: i64 = 42;
    var pi: f64 = 3.14159;
    var u: u32 = 4095;
    var on: bool = true;
    var csvs: string = "a,b";
    var qs: string = "a\"b";

    // 纯文本（零插值）：退化为普通字符串字面量，不生成 __fmt_N
    var plain: string = f"no interpolation here";

    // 基本插值 + 表达式插值（含函数调用、算术）
    var s1: string = f"hello {name}, len={str_len(name)}, n2={n * 2 + 1}";

    // 格式规范：对齐/补零/精度
    var s2: string = f"|{name:>10}|{n:05}|{pi:.2}|";

    // 六种转换作用于同一字符串：!s/!c 裸值，!r/!a/!j/!p 加引号
    var s3: string = f"{name!s}|{name!r}|{name!a}|{name!j}|{name!p}|{name!c}";

    // csv：含逗号才加引号，内部 " 翻倍；pbtxt/json：引号转义
    var s3b: string = f"{csvs!c}|{csvs!j}|{qs!c}|{qs!j}|{qs!p}";

    // 转换字段 + 格式规范（先转文本形态，再套 spec）
    var s4: string = f"|{name!r:>12}|";

    // 转义花括号
    var s5: string = f"braces {{{name}}} ok";

    // 长式 f-string：内部可直接写 `"`
    var s6: string = f"""long {name} with "quotes" inside""";

    // 嵌套 f-string
    var s7: string = f"outer {f"inner {n}"}";

    // 前缀取反不会被误判成转换字段
    var s8: string = f"{!on}";

    // 标量上的 !p / !c：序列化即裸值（与 json 等价），不再取十六进制/码点
    var s9: string = f"{n!p}|{n!c}|{u!p}";

    var all: string = sb_cat2(s3, s3b);
    all = sb_cat2(all, s4);
    all = sb_cat2(all, s5);
    all = sb_cat2(all, s6);
    all = sb_cat2(all, s7);
    all = sb_cat2(all, s8);
    all = sb_cat2(all, s9);
    return sb_cat2(plain, sb_cat2(s1, sb_cat2(s2, all)));
}
