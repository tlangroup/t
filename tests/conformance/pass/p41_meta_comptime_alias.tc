// EXPECT: warning W_COMPTIME_ALIAS
// Phase E 弃用告警验证：`comptime` 是 `meta` 的弃用别名，使用会发 W_COMPTIME_ALIAS 告警，
// 但仍按 `meta` 语义**正常编译运行**（告警不阻断，保留一个发布周期作过渡）。
// 本用例故意使用 comptime 的四种形式，验证向后兼容：
//   ① 函数前缀      `comptime dup fn(...)`
//   ② 类型参数别名  `comptime T: any`
//   ③ 编译期表达式  `comptime <expr>`（作为 meta const 初值）
//   ④ 编译期块语句  `comptime { }`

// ① 函数前缀 + ② 类型参数别名 `comptime T: any`
comptime dup fn(comptime T: any, x: T) T { return x; }

// ③ 编译期表达式前缀（作为 meta const 初值）
meta const K: i64 = comptime 10 + 5;

main fn() i64 @main {
    auto a = dup(i64, 7);
    auto b = dup(string, "hi");
    // ④ 编译期块语句
    comptime {
        var n: i64 = 1;
    }
    if (a == 7 && b == "hi" && K == 15) { return 0; }
    return 1;
}
