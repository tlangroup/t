// EXPECT: pass
// 具名故障组声明 + 错误联合类型 `fault(E)!T`（fault 批次 B1）
//
// ⚠ 本批尚无 `Ok(...)` / `Err(...)`（B4）⇒ 这里不声明「返回 fault(E)!T 的函数」，
//   只覆盖「组声明 + 类型可引用 + 合成结构可声明变量并读写字段」。
//   带签名的用例随 B4 一起补（见 docs/design/fault/TESTS.md）。
struct User {
    age: i64;
    name: string;
}

fault UserErr over User {
    .{ .age < 0 }   -> UserErr.AgeNegative repairs { .use_default, .clamp };
    .{ .name = "" } -> UserErr.NameEmpty    repairs { .anon };
}

struct Frame {
    magic: i64;
    len: i64;
}

// 组内也可以完全没有 repair（N = 0 ⇒ 布局只剩 tag + val）
fault FrameErr over Frame {
    .{ .magic != 0 } -> FrameErr.NotOurs;
}

fn main_fn() i32 @main {
    var v : fault(UserErr)!User;
    var f : fault(FrameErr)!Frame;
    var t : i64 = v.tag + f.tag;
    var a : i64 = v.val.age + f.val.magic;
    return 0;
}
