// EXPECT: pass
// 字面量全量（reference.md §2.4，2026-08-10）。
// 覆盖：`_` 分隔符 / `0x` `0o` `0b` 进制 / `1e9` 整数指数 / 位宽后缀 uN iN fN /
//       `'A'` 字节字符 / `\xHH` `\u{...}` 转义 / `r"..."` 原始串 /
//       `"""..."""` 长串 / `inf` `nan` IEEE-754 特殊值。

fn lit_ints() i64 {
    // 下划线是纯视觉分隔符，词法阶段剥除
    var a: i64 = 1_000_000;
    var h: i64 = 0xDEAD_BEEF;
    var o: i64 = 0o755;
    var b: i64 = 0b1010_1010;
    return a + h + o + b;
}

fn lit_suffixes() i64 {
    // 带后缀时类型由后缀定死，不再按量级猜最小无符号类型
    var u1: u8 = 255u8;
    var u2: u16 = 65535u16;
    var u3: u32 = 4294967295u32;
    var s1: i8 = -128i8;          // iN 下界 -2^(N-1) 仅在紧邻负号时放行
    var s2: i16 = -32768i16;
    var s3: i32 = -255i32;        // 无后缀时 -255 会被推成 u8 再取负
    var s4: i64 = 1_000i64;
    return (u1 as i64) + (u2 as i64) + (u3 as i64)
        + (s1 as i64) + (s2 as i64) + (s3 as i64) + s4;
}

fn lit_floats() f64 {
    var e1: f64 = 1e9;            // 整数指数 → 浮点，词法归一化为 1.0e9
    var e2: f64 = 1.5e-3;
    var e3: f64 = 2E+8;
    var f1: f32 = 1.5f32;         // f32 后缀脱糖为 `as f32`
    var f2: f64 = 0.25f64;        // f64 后缀是恒等
    var pinf: f64 = inf;
    var ninf: f64 = -inf;
    var qnan: f64 = nan;
    var bad: bool = qnan != qnan; // IEEE-754：NaN 与自身不相等
    if (bad and pinf > 0.0 and ninf < 0.0) {
        return e1 + e2 + e3 + (f1 as f64) + f2;
    }
    return 0.0;
}

fn lit_bytes() u8 {
    var upper: u8 = 'A';
    var nl: u8 = '\n';
    var zero: u8 = '\0';
    var quote: u8 = '\'';
    var back: u8 = '\\';
    var hexb: u8 = '\x7F';
    return upper + nl + zero + quote + back + hexb;
}

fn lit_strings() string {
    var esc: string = "tab:\t nul:\0 quote:\" back:\\ hex:\x41 uni:\u{4e2d}";
    var raw: string = r"C:\no\escape\here";
    var rawq: string = r"a\q\wb";                // 原始串内未知转义不是错误
    var multi: string = """第一行
第二行""";
    var rawlong: string = r"""行1\n仍是两个字符
行2""";
    return sb_cat4(esc, raw, sb_cat2(rawq, multi), rawlong);
}

fn main() i32 @main {
    if (lit_ints() > 0 and lit_suffixes() != 0 and lit_floats() > 0.0
        and lit_bytes() > 0 and str_len(lit_strings()) > 0) {
        return 0;
    }
    return 0;
}
