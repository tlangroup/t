// EXPECT: pass
// P2（everything-is-value 补齐）：整型与浮点 lub（i16 + f32 -> f32）。
// 浮点须能精确表示整型（i16 范围 ⊂ f32 精确整数区间 ±2^24）。
fn pick(x: i32) f32 {
    return match (x) {
        0 => 1 as i16,
        1 => 2.0 as f32,
        _ => 3.0 as f32,
    };
}
fn main() i32 @main {
    if (pick(0) == 1.0 && pick(1) == 2.0) {
        return 0;
    }
    return 1;
}
