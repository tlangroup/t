// EXPECT: pass
// 谓词模式（fault 批次 B2 / 节点 N1–N6）：`.{ .f <op> v }` 形态的具名字段关系匹配。
//
// 四个形态的消歧（见 fault.md §4 末）：
//   `.{a, b}`      → 位置式（首元素非 Dot）
//   `V{ .Case }`   → 变体构造（Dot+Ident 后是终结符）
//   `.{ .a = 1 }`  → 具名字段等值
//   `.{ .a < 1 }`  → 谓词（B2 新增，Dot+Ident 后是运算符）
//
// ⚠ 运行期「命中 / 不命中」两个分叉的验证在 examples/predpat_demo.tc + golden：
//   conformance 只跑 `tc check`、从不运行程序，故此处只能验证静态可编译。

struct User {
    age:   i64;
    score: i64;
}

// 单谓词（匿名结构模式：类型名由 scrutinee 反查）
fn judge(u: User) i64 {
    return match (u) {
        .{ .age < 0 }   => 0 - 1,
        .{ .age > 120 } => 1,
        _ => 0,
    };
}

// 多合取项：AND 语义
fn risky(u: User) i64 {
    return match (u) {
        .{ .age > 10, .score < 60 } => 9,
        _ => 0,
    };
}

// 等值 / 不等值
fn exact(u: User) i64 {
    return match (u) {
        .{ .score == 100 } => 7,
        .{ .score != 0 }   => 5,
        _ => 0,
    };
}

// 具名结构模式 + 谓词（显式写出类型名）
fn named_pred(u: User) i64 {
    return match (u) {
        User{ .age >= 18, .score >= 60 } => 1,
        _ => 0,
    };
}

@main fn main() i32 {
    println(int_to_str(judge(User{ age: 0 - 5, score: 0 })));
    println(int_to_str(risky(User{ age: 20, score: 50 })));
    println(int_to_str(exact(User{ age: 1, score: 100 })));
    println(int_to_str(named_pred(User{ age: 18, score: 60 })));
    return 0;
}
