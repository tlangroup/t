// EXPECT: pass
// P2：std.maputil map 工具（语义层接受）。
// 运行期正确性由 examples/maputil_demo.tc 在双后端守卫；此处仅确认语义检查通过。
@import("std.maputil");

fn use_maputil() i64 {
    var m: map[string]i64 = ["a": 1, "b": 2];
    var ks: []string = maputil.keys(string, i64, m);
    var vs: []i64 = maputil.values(string, i64, m);
    maputil.clear(string, i64, m);
    return (slice_len(ks) as i64) + (slice_len(vs) as i64) + map_len(m);
}
