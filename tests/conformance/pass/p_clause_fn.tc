// EXPECT: pass
// 函数化（N13）：`fn f(x: T) R = <子句组>;` —— `= <expr>` 在函数体位此前是解析错误，
// 属空位利用。体脱糖为 `return match (x) { G };`，复用与臂位展开完全相同的通路。
// 另验证：裸绑定子句同样不可反驳（N11 判据修正），写在首位也会被重排到末位。

const G0 = @clause(.pattern, _, 0 - 1);
const G1 = @clause(.pattern, 0, 10);
const G2 = @clause(.pattern, 1, 11);
const GP = [G0, G1, G2];

fn pick(x: i64) i64 = GP;

const HB = @clause(.pattern, n, 0);
const H1 = @clause(.pattern, 5, 50);
const HP = [HB, H1];

fn pick_bind(x: i64) i64 = HP;

@main
fn main() i64 {
    return pick(0) + pick(1) + pick_bind(5);
}
