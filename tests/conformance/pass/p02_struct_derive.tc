// EXPECT: pass
// spec §5/§6: struct 字段、嵌套 struct、@derive 派生 (Clone/Eq/DebugPrint)
Vec2 struct @derive(Clone, Eq, DebugPrint) {
    x: i32;
    y: i32;
}

Line struct @derive(Clone) {
    a: Vec2;
    b: Vec2;
}

main fn() -> i32 @main {
    var p: Vec2 = Vec2 { x: 1, y: 2 };
    var q: Vec2 = Vec2 { x: 3, y: 4 };
    var l: Line = Line { a: p, b: q };
    return l.b.x - 3;
}
