// EXPECT: pass
// spec §5/§6: @derive 8 trait 真正生成方法并在运行时被调用验证
// （Clone/Eq/Hash/ToString/FromString/DebugPrint/BinarySerde；Copy 为值语义标记）
struct Point @derive(Clone, Copy, Eq, Hash, ToString, FromString, DebugPrint, BinarySerde) {
    x: i64;
    y: i64;
    active: bool;
    name: string;
}

fn main() i32 @main {
    var p: Point = Point { x: 10, y: 20, active: true, name: "hello" };
    var c: Point = p.clone();
    var fails: i64 = 0;
    if (c.x != p.x) { fails = fails + 1; }
    if (c.y != p.y) { fails = fails + 1; }
    if (c.active != p.active) { fails = fails + 1; }
    if (c.name != p.name) { fails = fails + 1; }
    if (p.eq(c) == false) { fails = fails + 1; }
    var h: u64 = p.hash();
    if (h <= 0) { fails = fails + 1; }
    var s: string = p.to_string();
    var d: string = p.debug_print();
    if (s == "" || d == "") { fails = fails + 1; }
    var back: Point = Point.from_string(s);
    if (back.x != p.x) { fails = fails + 1; }
    if (back.y != p.y) { fails = fails + 1; }
    if (back.active != p.active) { fails = fails + 1; }
    if (back.name != p.name) { fails = fails + 1; }
    var buf: []u8 = p.serialize();
    var un: Point = Point.deserialize(buf);
    if (un.x != p.x) { fails = fails + 1; }
    if (un.y != p.y) { fails = fails + 1; }
    if (un.active != p.active) { fails = fails + 1; }
    if (un.name != "") { fails = fails + 1; }
    return fails as i32;
}
