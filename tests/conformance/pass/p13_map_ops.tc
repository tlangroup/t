// EXPECT: pass
// map[K]V 内建操作（M29）：map_new/map_set/map_get/map_has/map_len/map_del，
// 以及 m[k] 读索引（等价 map_get）。map_get 的返回类型由首个实参的 V 反查。
// 本例用局部变量作键/值；M30 起也允许直接写字面量（见 p14_map_iter.tc）。

@main
main :: func() -> i64 {
    // ── string key / i64 val ──
    var m: map[string]i64;
    m = map_new(m);
    var ka: string = "alice";
    var kb: string = "bob";
    var va: i64 = 1;
    var vb: i64 = 2;
    map_set(m, ka, va);
    map_set(m, kb, vb);
    var n1: i64 = map_len(m);
    var h1: bool = map_has(m, ka);
    var g1: i64 = map_get(m, ka);
    var x1: i64 = m[kb];          // 读索引等价 map_get
    var d1: bool = map_del(m, kb);

    // ── int key / i64 val ──
    var p: map[i64]i64;
    p = map_new(p);
    var pk: i64 = 7;
    var pv: i64 = 70;
    map_set(p, pk, pv);
    var g2: i64 = map_get(p, pk);
    var x2: i64 = p[pk];

    // ── int key / string val：map_get 应回推出 string ──
    var q: map[i64]string;
    q = map_new(q);
    var qk: i64 = 3;
    var qv: string = "hello";
    map_set(q, qk, qv);
    var g3: string = map_get(q, qk);
    var l3: i64 = str_len(g3) as i64;

    if (h1 && d1) {
        return n1 + g1 + x1 + g2 + x2 + l3;
    }
    return 0;
}
