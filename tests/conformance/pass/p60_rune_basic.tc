// EXPECT: pass
// rune：Unicode 码点类型（内部 i32）。多字节字符字面量 '中' 为合法 rune 字面量；
// 单字节 'A' 仍为 u8 字节字面量。rune 纳入整数族，算术 / 比较 / i32 互转全免费。

main fn() i32 @main {
    // 多字节字符字面量 → rune（码点 U+4E2D = 20013）
    var zh: rune = '中';
    var zh_i: i32 = zh;
    if (zh_i != 20013) { return 1; }

    // rune 算术（码点 + 1 → 20014）
    var zh2: rune = zh + 1;
    if (zh2 != 20014) { return 2; }

    // 单字节字符字面量仍为 u8（字节值）
    var a: u8 = 'A';
    if (a != 65) { return 3; }

    // ASCII 字符可作 rune（码点 = 字节值）
    var ar: rune = 'A';
    if (ar != 65) { return 4; }

    // rune 与 i32 互转
    var n: i32 = 97;
    var nr: rune = n;
    if (nr != 97) { return 5; }

    // rune 比较：'中'(20013) > 'A'(65)
    if (zh <= ar) { return 6; }
    return 0;
}
