// EXPECT: pass
// 测试声明现代化（docs/reference.md §3.14）：关键字领头式 `test "名字" {}` / `suite "名字" {}`，
// 断言内建 expect(EXPR[, "说明"])，修饰注解 @skip / @only / @should_fail / @tag(...)。
// 本用例只跑 check：验证解析、脱糖与注解校验全绿，无任何 error / warning。
fn double_it(x: i32) i32 {
    return x * 2;
}

test "double_it 应把入参翻倍" {
    expect(double_it(21) == 42);
}

test "expect 支持附加说明" {
    expect(double_it(0) == 0, "零的两倍仍是零");
}

test "待补：未实现用例" @skip {
    expect(false);
}

test "越界写入应失败" @should_fail {
    expect(1 == 2);
}

test "慢用例" @tag(slow) {
    expect(double_it(1) == 2);
}

suite "math" {
    test "加法应可结合" {
        expect((1 + 2) + 3 == 1 + (2 + 3));
    }

    suite "嵌套分组" {
        test "乘法应可交换" {
            expect(6 * 7 == 7 * 6);
        }
    }
}
