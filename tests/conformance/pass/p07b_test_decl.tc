// EXPECT: pass
// 测试声明现代化（docs/reference.md §3.9）：并置式 `"名字" test {}` / `"名字" suite {}`，
// 断言内建 expect(EXPR[, "说明"])，修饰注解 @skip / @only / @should_fail / @tag(...)。
// 本用例只跑 check：验证解析、脱糖与注解校验全绿，无任何 error / warning。
double_it fn(x: i32) i32 {
    return x * 2;
}

"double_it 应把入参翻倍" test {
    expect(double_it(21) == 42);
}

"expect 支持附加说明" test {
    expect(double_it(0) == 0, "零的两倍仍是零");
}

"待补：未实现用例" test @skip {
    expect(false);
}

"越界写入应失败" test @should_fail {
    expect(1 == 2);
}

"慢用例" test @tag(slow) {
    expect(double_it(1) == 2);
}

"math" suite {
    "加法应可结合" test {
        expect((1 + 2) + 3 == 1 + (2 + 3));
    }

    "嵌套分组" suite {
        "乘法应可交换" test {
            expect(6 * 7 == 7 * 6);
        }
    }
}
