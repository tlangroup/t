// EXPECT: pass
// M-comptime Phase A：元编程关键字 `comptime` 的四类表面均须通过 check。
//   ① comptime T: type    编译期类型参数（comptime T: any 已弃用，见 reference §3.6.3）
//   ② comptime { }        编译期块
//   ③ comptime <expr>     编译期表达式前缀
//   ④ comptime const/fn   顶层声明前缀
// `type` 是「类型之类型」占位关键字，与 `any` 同语义，单态化时整体移除。

fn id(comptime T: type, x: T) T { return x; }

// 历史四种别名组合现已统一为 `comptime T: type`（`comptime` / `any` 已弃用）。
fn a1(comptime T: type, x: T) T { return x; }
fn a2(comptime T: type, x: T) T { return x; }
fn a3(comptime T: type, x: T) T { return x; }

comptime const KLIM: i32 = 7;
comptime fn twice(x: i32) i32 { return x + x; }

fn main() i32 {
    comptime {
        var inner: i32 = 1;
    }
    var a: i32 = comptime 4 + 2;
    var b: i32 = comptime twice(3);
    auto n = id(i32, 42);
    auto s = a1(string, "hi");
    auto t = a2(i32, 1);
    auto u = a3(bool, true);
    if (a == 6 and b == 6 and n == 42 and KLIM == 7 and s == "hi" and t == 1 and u) {
        return 0;
    }
    return 1;
}
