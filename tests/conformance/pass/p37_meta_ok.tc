// EXPECT: pass
// M-meta Phase A：元编程关键字 `meta` 的四类表面均须通过 check。
//   ① meta T: type    编译期类型参数（comptime T: any 已弃用，见 reference §3.6.3）
//   ② meta { }        编译期块
//   ③ meta <expr>     编译期表达式前缀
//   ④ meta const/fn   顶层声明前缀
// `type` 是「类型之类型」占位关键字，与 `any` 同语义，单态化时整体移除。

fn id(meta T: type, x: T) T { return x; }

// 历史四种别名组合现已统一为 `meta T: type`（`comptime` / `any` 已弃用）。
fn a1(meta T: type, x: T) T { return x; }
fn a2(meta T: type, x: T) T { return x; }
fn a3(meta T: type, x: T) T { return x; }

meta const KLIM: i32 = 7;
meta fn twice(x: i32) i32 { return x + x; }

fn main() i32 {
    meta {
        var inner: i32 = 1;
    }
    var a: i32 = meta 4 + 2;
    var b: i32 = meta twice(3);
    auto n = id(i32, 42);
    auto s = a1(string, "hi");
    auto t = a2(i32, 1);
    auto u = a3(bool, true);
    if (a == 6 && b == 6 && n == 42 && KLIM == 7 && s == "hi" && t == 1 && u) {
        return 0;
    }
    return 1;
}
