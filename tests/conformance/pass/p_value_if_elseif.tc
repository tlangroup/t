// P1 Stage 1a：值块 `{ e; }` 与值 `if` 的 `else if` 链（解析期脱糖，编译期可判定）
// EXPECT: pass

fn grade(n: i64) i32 {
    return if (n >= 90) { 5; } else if (n >= 80) { 4; } else if (n >= 70) { 3; } else { 1; };
}

fn blkval() i32 {
    var x: i32 = { 7; };
    return x;
}

fn marms(c: bool) i32 {
    return match (c) {
        true => { 11; },
        false => { 22; },
    };
}

fn main() i32 @main {
    if (grade(95) == 5 and grade(85) == 4 and grade(75) == 3 and grade(10) == 1) {
        if (blkval() == 7 and marms(true) == 11 and marms(false) == 22) {
            return 0;
        }
    }
    return 1;
}
