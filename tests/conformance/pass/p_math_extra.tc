// EXPECT: pass
// std.math 对数/反三角补充：log_f / log10_f / log2_f / atan_f / atan2_f / hypot_f
// 纯 t 实现，依赖内建算术，零编译器改动。
@import("std.math");

fn main_fn() i32 @main {
    // 自然对数
    var le: f64 = math.log_f(2.718281828459045);
    // 常用底
    var l10: f64 = math.log10_f(100.0);
    var l10k: f64 = math.log10_f(1000.0);
    var l2: f64 = math.log2_f(8.0);
    // 反三角（四象限）
    var a_pi4: f64 = math.atan2_f(1.0, 1.0);
    var a_zero: f64 = math.atan2_f(0.0, 1.0);
    var a_pi2: f64 = math.atan2_f(1.0, 0.0);
    // 欧氏距离
    var h: f64 = math.hypot_f(3.0, 4.0);

    if (le < 0.999 || le > 1.001) { return 1; }
    if (l10 < 1.999 || l10 > 2.001) { return 2; }
    if (l10k < 2.999 || l10k > 3.001) { return 3; }
    if (l2 < 2.999 || l2 > 3.001) { return 4; }
    if (a_pi4 < 0.780 || a_pi4 > 0.791) { return 5; }
    if (a_zero != 0.0) { return 6; }
    if (a_pi2 < 1.570 || a_pi2 > 1.571) { return 7; }
    if (h < 4.999 || h > 5.001) { return 8; }
    return 0;
}
