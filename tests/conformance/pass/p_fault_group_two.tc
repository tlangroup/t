// EXPECT: pass
// ⭐⭐ B1 既有缺口的**回归用例**：`g_fmem_slot`（组内槽位号）曾被当成 `g_frep_*`
// 的**表下标** ⇒ 同文件出现第二个组时，第二组拿组内槽位 0 去查 repair 表，
// 查到的是第一组的修法名 ⇒ 第二组的所有修法报 T-MAT-E757「不属于该成员」。
// （g1 与 B5a 编译器均可复现；修法是「查表用 frep 表下标、返回用组内槽位号」。）

struct User {
    age: i64;
    name: string;
}

fault UserErr over User {
    .{ .age < 0 }   -> UserErr.AgeNegative repairs { .use_default, .clamp };
    .{ .name = "" } -> UserErr.NameEmpty    repairs { .anon };
}

fault RangeErr over User {
    .{ .age > 200 } -> RangeErr.TooOld repairs { .clamp };
}

fn validate(u : User) fault(UserErr)!User {
    if (u.age < 0) {
        return Err(
            @clause(.fault, .{ .age < 0 }, UserErr.AgeNegative)
         ++ @clause(.repair, .clamp, fn () User { return User{ .age = 0i64, .name = u.name }; })
        );
    }
    return Ok(u);
}

fn raise_range(u : User) fault(RangeErr)!User {
    if (u.age > 200) {
        return Err(
            @clause(.fault, .{ .age > 200 }, RangeErr.TooOld)
         ++ @clause(.repair, .clamp, fn () User { return User{ .age = 200i64, .name = u.name }; })
        );
    }
    return Ok(u);
}

fn main_fn() i32 @main {
    var a : User = trap validate(User{ .age = -5i64, .name = "bob" }) {
        .{ .age < 0 }   => resume(.clamp);
        .{ .name = "" } => resume(.anon);
    };
    var b : User = trap raise_range(User{ .age = 300i64, .name = "bob" }) {
        .{ .age > 200 } => resume(.clamp);
    };
    println(i2s(a.age));
    println(i2s(b.age));
    return 0;
}
