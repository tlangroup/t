// EXPECT: pass
// §set-ops 岔路 B：concept 多约束 `T: A & B`——类型参数 T 须同时满足 A 与 B。
// 连词用 `&`（§13.3 格族：类型位 meet 与值位集合交同形）；编译器把它拆成约束列表，
// 实例化处逐个 concept 做结构化满足检查。
concept HasName {
    fn name(self) string;
}

concept HasAge {
    age: i64;
}

concept Alive {
    fn is_alive(self) bool;
}

struct Person {
    name: string;
    age: i64;
    fn name(self: Person) string {
        return self.name;
    }
}

struct Citizen {
    name: string;
    age: i64;
    fn name(self: Citizen) string {
        return self.name;
    }
    fn is_alive(self: Citizen) bool {
        return true;
    }
}

// 双约束：x 须同时拥有 name() 方法与 age 字段。
fn describe(T: HasName & HasAge, x: T) string {
    return x.name;
}

fn get_age(T: HasName & HasAge, x: T) i64 {
    return x.age;
}

// 三约束连词（验证左结合 binary 的递归拆解）。
fn triple(T: HasName & HasAge & Alive, x: T) string {
    if (x.is_alive()) {
        return "ok";
    }
    return "no";
}

@main fn main() i32 {
    var p: Person = Person{ .name = "alice", .age = 30 };
    var n: string = describe(p);
    var a: i64 = get_age(p);
    if (n != "alice") { return 1; }
    if (a != 30) { return 2; }
    var c: Citizen = Citizen{ .name = "bob", .age = 40 };
    var s: string = triple(c);
    if (s != "ok") { return 3; }
    return 0;
}
