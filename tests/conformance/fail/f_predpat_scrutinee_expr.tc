// EXPECT: error T-MAT-E746
// §8 A-16：谓词模式的 scrutinee **只允许变量**。
//
// 理由：谓词 `.<op>` 会被逐字段脱糖为 `member(scr, f) <op> v`，scr 每字段出现一次
//   ⇒ N 条谓词 = scrutinee 求值 N 次。scrutinee 是变量时是纯读取（无害）；
//     是任意表达式（此处是 `validate(...)` 调用）时副作用会翻倍。
// ⇒ 用**硬约束**堵死这条路，而不是用「sema 合成临时绑定」的魔法去修好它。

struct User {
    age:   i64;
    score: i64;
}

fn validate(u: User) User {
    return u;
}

fn f() i64 {
    // ❌ scrutinee 是函数调用，不是变量
    return match (validate(User{ age: 1, score: 1 })) {
        .{ .age < 0 } => 1,
        _ => 0,
    };
}

@main fn main() i32 {
    println(int_to_str(f()));
    return 0;
}
