// EXPECT: error T-CLO-E001
// N16 探针 ③：含 clause 形参的函数**自动升为编译期函数**（Q8 自动置位），
// 它没有运行期函数体 ⇒ 把它当运行期函数值传出去应被拒绝（既有 T-CLO-E001）。
// 这是「自动置位」的直接可观测证据：无需为 clause 新增任何拒绝逻辑，
// 复用既有 comptime fn 的逃逸判据即可。

fn fmt_with(x: i64, G: [2]clause) i64 {
    return match (x) { G };
}

@main
fn main() i64 {
    var g: fn(i64) i64 = comptime fmt_with;   // 逃逸编译期函数自身 —— 非法
    return g(5);
}
