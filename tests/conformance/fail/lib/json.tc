// EXPECT: pass
// 本文件不是独立用例，而是 f55/f56 的被导入库（`import(json)` 就近命中
// tests/conformance/fail/lib/json.tc）。它自身也必须是合法 t 程序，故标 pass。
export fn version() string {
    return "json/0.1";
}

// 未 export：模块私有，跨模块访问应报 T_MODULE_PRIVATE（见 f55）
fn quote(s: string) string {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "\"");
    sb_append_str(sb, s);
    sb_append_str(sb, "\"");
    return sb_to_str(sb);
}
