// EXPECT: error T_FMT_BAD_CONVERSION
// 转换字段只能是 !s|!r|!a|!j|!c|!p。`!z` 不是合法转换字母，必须编译期报错。
// 注：`!c`/`!p` 现已对任意值类型合法——它们是 csv / pbtxt 序列化，不再是整数专用。
// f-string 里写 `!z` 会在解析期直接报错（无 T_ 码）；这里用手写 format() 模板
// 触发语义层诊断码 T_FMT_BAD_CONVERSION（desugar_format_call 的 conv 合法性检查）。

fn bad_conv() string {
    var s: string = "x";
    return format("{0!z}", s);
}
