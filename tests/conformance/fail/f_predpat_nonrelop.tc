// EXPECT: error T-MAT-E745
// 谓词模式只接受关系运算符（`<` `>` `<=` `>=` `==` `!=`）。
//
// ⚠ 这是「收口」纪律的实例：`.{ .a + 1 }` 里 `+` 确实是运算符，若不专门判定，
//   它会悄悄落回位置式模式路径 ⇒ 用户拿到「莫名其妙的类型错」而非「不支持的运算符」。
//   ⇒ parse 期用**排除法**（pat_is_pat_end）识别「这是个运算符」，
//     sema 期再校验「是不是合法谓词 op」，给出明确文案。
struct User {
    age:   i64;
    score: i64;
}

fn f(u: User) i64 {
    return match (u) {
        .{ .age + 1 } => 1,
        _ => 0,
    };
}

@main fn main() i32 {
    println(int_to_str(f(User{ age: 1, score: 1 })));
    return 0;
}
