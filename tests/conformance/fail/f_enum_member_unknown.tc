// EXPECT: error T-SEM-E015
// M5 / P1: enum 成员名不存在必须报错。
// 此前 `Color.Red` 与 `Color.NotExist` 走同一路径、返回同一类型且零诊断，
// 后端把它当结构体字段访问发射（对 enum 发 GEP → invalid getelementptr），
// 报错形态与真实病因（成员名拼错）毫无关联。
enum Dir : u8 {
    North = 0,
    East = 1,
}

fn main() i32 @main {
    var d: Dir = Dir.NotExist;
    if (d == Dir.East) { return 0; }
    return 1;
}
