// EXPECT: error T_PIPE_BAD_CONTEXT
// reference.md §3.15.6：管道只允许出现在四类位置（声明初始化 / 赋值右侧 /
// return / 表达式语句）。条件位无提升点，且提升会改变求值时机，故禁用。
fn is_pos(v: i32) bool {
    return v > 0;
}

fn main() i32 @main {
    var xs: []i32 = [];
    append(xs, 1);
    if (slice_len(xs |>? is_pos) > 0) {
        return 1;
    }
    return 0;
}
