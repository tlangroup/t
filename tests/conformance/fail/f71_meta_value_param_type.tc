// EXPECT: error T_META_VALUE_PARAM_TYPE
// M-meta Phase C：值参数的类型目前限整数族 / bool / string。浮点未开放 ——
// 宪法第 7 条要求编译期求值逐字节可复现，浮点结合序尚未定案（见
// docs/meta_design.md §10）。诊断落在形参类型这一层，而不是等求值器报
// T_META_NOT_CONST，否则会把排查方向引向实参。
scale fn(meta F: f64, x: i64) i64 { return x; }

main fn() i32 {
    var a: i64 = scale(1.5, 2);
    if (a == 2) { return 0; }
    return 1;
}
