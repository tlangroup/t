// EXPECT: error T_MATCH_NONEXHAUSTIVE
// open-variant（阶段三）：extend 追加的构造器仍须被 match 穷尽覆盖（§3.4 立场：开放 ≠ 免穷尽）。
// 漏列 Wheel ⇒ T_MATCH_NONEXHAUSTIVE（与抽象变体 `_` 形成分工：`overload` 管能不能追加、
// `_` 管要不要列全）。
overload variant Event {
    Key(i64);
    Click(i64, i64);
}

extend variant Event {
    Wheel(i64);
}

fn code(e: Event) i64 {
    return match (e) {
        .Key(k) => k
        .Click(x, y) => x + y
    };
}

@main
fn main() i64 {
    return 0;
}
