// EXPECT: error T_PIPE_RHS_NOT_FUNC
// reference.md §3.15.2 R1：管道右操作数的静态类型必须是一元 FuncType。
// `xs |-> 42` 的右侧是整数字面量 —— 语法合法（右操作数级别为 OrExpr），
// 语义非法，故报错在检查期而非解析期，得以给出精确诊断。
main fn() i32 @main {
    var xs: []i32 = [];
    append(xs, 1);
    var ys: []i32 = xs |-> 42;
    return slice_len(ys) as i32;
}
