// EXPECT: error T-MAT-E023
// A-33 的前提：被捕表达式的静态类型必须是 `fault(<组>)!<T>`（即 B1 合成的 `__fault_<E>` 载体）。
// 捕一个普通 `i64` 没有 tag / val / rK 可言 ⇒ 无从谈「按 tag 分派」。
//
// ⚠ 判据用的是 scrutinee 的**静态类型**（`infer_expr` 的结果），不要求它真是 `Err(...)` 产物。

struct User {
    age: i64;
    name: string;
}

fault UserErr over User {
    .{ .age < 0 }   -> UserErr.AgeNegative repairs { .use_default, .clamp };
    .{ .name = "" } -> UserErr.NameEmpty    repairs { .anon };
}

fn validate(u : User) fault(UserErr)!User {
    if (u.age < 0) {
        return Err(
            @clause(.fault, .{ .age < 0 }, UserErr.AgeNegative)
         ++ @clause(.repair, .use_default, fn () User { return u; })
         ++ @clause(.repair, .clamp, fn () User { return u; })
        );
    }
    if (u.name == "") {
        return Err(
            @clause(.fault, .{ .name = "" }, UserErr.NameEmpty)
         ++ @clause(.repair, .anon, fn () User { return u; })
        );
    }
    return Ok(u);
}

fn c(u : User) User {
    var v : User = trap 1i64 {
        .{ .age < 0 } => resume(.clamp),
        .{ .name = "" } => resume(.anon)
    };
    return v;
}

fn main_fn() i32 @main {
    return 0;
}
