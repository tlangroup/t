// EXPECT: error T-CON-E101
// struct-modifiers T9：concept 满足 = 结构化 —— Bad 缺 name 方法与 age 字段，
// 传入受 HasName 约束的泛型 greet 应在实例化处报错。
concept HasName {
    fn name(self) string;
    age: i64;
}

struct Bad {
    x: i64;
}

fn greet(T:HasName, x: T) string {
    return "hi " + x.name();
}

fn call_it() string {
    var b: Bad = Bad { x: 1 };
    return greet(b);
}
