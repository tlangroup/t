// EXPECT: error T_PIPE_VOID_MAP
// reference.md §3.15：管道是**变换**管线，不是副作用遍历。`|->`（map，逐元素变换）
// 的映射函数返回 void 会产出无意义的 `[]void`，降解成 `var __pv0: void = f(x);`
// → LLVM `alloca void` 是非法 IR。副作用遍历请用 `for (x in xs) { ... }` 或新语义的
// `xs |> show`（`|>` 整体/逐元素应用，逐元素 void 已合法降级为 for-each）。
fn show(v: i32) void { print(f"{v}"); }
fn main() i32 @main {
    var xs: []i32 = [1, 2, 3];
    xs |-> show;
    return 0;
}
