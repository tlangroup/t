// EXPECT: error T_PIPE_ARG_TYPE
// reference.md §3.15.2 R2：流入值 / 元素类型须能 can_cast 到形参 0 类型
// （与 check_call_args 同一判据）。string 元素无法流入 fn(Point) 形参。
Point struct {
    x: i32;
    y: i32;
}

fn x_of(p: Point) i32 {
    return p.x;
}

fn main() i32 @main {
    var xs: []string = [];
    append(xs, "a");
    var ys: []i32 = xs |-> x_of;
    return slice_len(ys) as i32;
}
