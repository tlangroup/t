// EXPECT: error T_PIPE_NOT_SEQUENCE
// reference.md §3.15.2 规则 4 承诺 `[N]T` 可作元素级管道左操作数，但实现未跟上：
// `[N]T` 在双后端都是裸元素指针（长度只活在静态类型里），而降解出的 foreach
// 按 TSlice 读 `t_slice_len/t_slice_at` → 段错误。在 Array→Slice 构造 lowering
// 落地前显式拒绝，不把崩溃留到运行期（宪法 L-02 显式行为）。
dbl fn(v: i32) i32 { return v * 2; }
main fn() i32 @main {
    var xs: [5]i32 = [1, 2, 3, 4, 5];
    var ys: []i32 = xs |-> dbl;
    return 0;
}
