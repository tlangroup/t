// EXPECT: error T_META_RUNTIME_CTX
// M-meta Phase D：`@str_from_bytes` 的实参是编译期缓冲区，只能在纯编译期上下文
// 求值。不带 meta 形参的 `meta fn` 同时可运行期调用，故其体内不许出现。
meta bad fn() string {
    var b: [4]u8 = @zeroed([4]u8);
    return @str_from_bytes(b, 1);
}
@main
main fn() i32 {
    if (bad() == "") { return 1; }
    return 0;
}
