// EXPECT: error T-SET-E104
// §set-ops：两侧位域但类型不同时，`^` 与 `&&` / `||` 同口径报 E104 ——
// 位域是名义类型、位宽由布局定死，跨位域类型没有良定义的位对应关系；
// 这比「`^` 暂不支持」更根本，故不复用 E105。
packed struct Perm {
    readable: u1;
    writable: u1;
}
packed struct Mode {
    a: u1;
    b: u1;
}
@main fn main() i32 {
    var p: Perm = Perm{ readable: 1, writable: 0 };
    var q: Mode = Mode{ a: 1, b: 1 };
    var c: Perm = p ^ q;
    return 0;
}
