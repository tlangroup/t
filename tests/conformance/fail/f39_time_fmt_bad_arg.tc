// EXPECT: error T_TIME_SPEC_TYPE, T_TIME_ARG_TYPE
// 实参类型校验：
//   format_time(42, t)        —— 第 1 个实参必须是整数/字符串…此处为整型非字符串 → T_TIME_SPEC_TYPE
//   format_time("%Y", true)   —— 第 2 个实参必须是整型 epoch，传 bool → T_TIME_ARG_TYPE

@main
main fn() -> i64 {
    var t: i64 = 1754254290123;
    var a: string = format_time(42, t);
    var b: string = format_time("%Y", true);
    return 0;
}
