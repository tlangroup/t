// EXPECT: error T-SET-E104
// §set-ops step2b：位域是名义类型且位宽由布局定死，跨位域类型的交 / 并没有
// 良定义的位对应关系（谁的第 3 位对应谁的哪一位？）→ 结构化报错。
packed struct Perm {
    readable: u1;
    writable: u1;
}
packed struct Mode {
    a: u1;
    b: u1;
}
@main fn main() i32 {
    var p: Perm = Perm{ readable: 1, writable: 0 };
    var m: Mode = Mode{ a: 1, b: 1 };
    var c: Perm = p && m;
    return 0;
}
