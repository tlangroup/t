// EXPECT: error T-SEM-E216
// M5 / P1 收尾：变体**字面量**构造 `Shape { .Case }` 的 case 名此前从不校验
// （variant_lit 节点在类型推断前就被脱糖成 `<V>_from_<Case>` 调用，case 名静默落 Unknown）。
// 覆盖两种写法：带载荷 `Shape { .NotExist(1.0) }` 与无载荷 `Shape { .Bogus }`。
variant Shape {
    Circle(f64);
    Empty;
}

fn main() i32 {
    var s: Shape = Shape { .NotExist(1.0) };
    var t: Shape = Shape { .Bogus };
    return 0;
}
