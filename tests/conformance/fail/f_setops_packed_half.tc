// EXPECT: error T-SET-E101
// §set-ops step2b：只有一侧是位域时，`&` 此前静默放行并产出非法 IR；
// 现与 `&&` 一样收口为结构化报错 `T-SET-E101`。
packed struct Perm {
    readable: u1;
    writable: u1;
}
@main fn main() i32 {
    var p: Perm = Perm{ readable: 1, writable: 0 };
    var m: i64 = 3;
    var c: Perm = p & m;
    return 0;
}
