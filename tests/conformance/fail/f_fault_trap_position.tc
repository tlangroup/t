// EXPECT: error T-MAT-E022
// A-34：`trap` 只开 `return trap <e> {…};` 与 `var x : T = trap <e> {…};` 两个位置。
// 出现在任意表达式位（这里是 `+` 的右操作数）一律拒绝。
// 理由：脱糖要**插入语句**（var + if 链），表达式位没有可插入的语句序列。

struct User {
    age: i64;
    name: string;
}

fault UserErr over User {
    .{ .age < 0 }   -> UserErr.AgeNegative repairs { .use_default, .clamp };
    .{ .name = "" } -> UserErr.NameEmpty    repairs { .anon };
}

fn validate(u : User) fault(UserErr)!User {
    if (u.age < 0) {
        return Err(
            @clause(.fault, .{ .age < 0 }, UserErr.AgeNegative)
         ++ @clause(.repair, .use_default, fn () User { return u; })
         ++ @clause(.repair, .clamp, fn () User { return u; })
        );
    }
    if (u.name == "") {
        return Err(
            @clause(.fault, .{ .name = "" }, UserErr.NameEmpty)
         ++ @clause(.repair, .anon, fn () User { return u; })
        );
    }
    return Ok(u);
}

fn c(u : User) User {
    var z : i64 = 1i64 + trap validate(u) {
        .{ .age < 0 } => resume(.clamp),
        .{ .name = "" } => resume(.anon)
    };
    return User{ .age = z, .name = u.name };
}

fn main_fn() i32 @main {
    return 0;
}
