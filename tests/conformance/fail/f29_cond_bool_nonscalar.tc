// EXPECT: error T_STMT_IMPLICIT_BOOL
// 条件位置只接受 bool，非标量类型（string / slice）同样禁止隐式布尔判定。
// 回归守卫：旧判据 `kind == "Scalar" && name != "bool"` 只拦标量，
// 这两行曾零诊断通过（2026-08-02 实测）。
@main
main fn() i64 {
    var s: string = "hello";
    var a: []i64 = [];
    if (s) {
        return 1;
    }
    while (a) {
        return 2;
    }
    return 0;
}
