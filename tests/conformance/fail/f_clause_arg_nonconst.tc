// EXPECT: pass
// N15：clause 形参的实参须是能在编译期求值的子句组常量。
//
// 本例的实参是内联的 `GA ++ [C]` —— 组**合并**（N7）现已被 meta 求值器在实参位
// 折成一个组值，不再报错。演变记录：`T-CLA-E006` 当初是为「求值器不折数组 Concat」
// 的临时限制而发；该限制取消后本用例随之合法（编译 + 运行均正确：match(0) 命中
// `GA` 首个 `@clause(.pattern,0,10)` 臂返回 10，进程退出码 10）。
// 仍演示「具名常量当实参」的等价写法（examples/clause_param.tc）：
//     const GALL: [3]clause = GA ++ [C];
//     fmt_with(0, GALL)

fn fmt_with(x: i64, G: [3]clause) i64 {
    return match (x) { G };
}

const GA = [@clause(.pattern, 0, 10), @clause(.pattern, _, 0 - 1)];

@main
fn main() i64 {
    return fmt_with(0, GA ++ [@clause(.pattern, 5, 55)]);
}
