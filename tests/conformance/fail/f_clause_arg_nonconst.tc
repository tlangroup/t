// EXPECT: error T-CLA-E726
// N15：clause 形参的实参必须是**能在编译期求值**的子句组常量。
//
// 本例的实参是内联的 `GA ++ [C]` —— 组**合并**本身是支持的（N7），但在**实参位**
// 需要 meta 求值器先把它折成一个组值，而求值器不折数组 Concat ⇒ 报 T-CLA-E726。
// 替代写法（已验证可用）：先把合并结果存成一个具名 const，再把该常量当实参传：
//     const GALL: [3]clause = GA ++ [C];
//     fmt_with(0, GALL)
// 见 examples/clause_param.tc（具名常量当实参，两个不同 group 各得一个实例）。

fn fmt_with(x: i64, G: [3]clause) i64 {
    return match (x) { G };
}

const GA = [@clause(.pattern, 0, 10), @clause(.pattern, _, 0 - 1)];

@main
fn main() i64 {
    return fmt_with(0, GA ++ [@clause(.pattern, 5, 55)]);
}
