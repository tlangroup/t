// EXPECT: error T_MATCH_NONEXHAUSTIVE
// A1 覆盖分析的负面用例：enum 成员未被全部覆盖，且无 `_` 通配臂 / 无绑定臂时，
// 必须报 T_MATCH_NONEXHAUSTIVE，且诊断消息指名缺失的成员。
// 另验证：带守卫的臂不计入覆盖（守卫可能为假）。

Color enum : u8 {
    Red,
    Green,
    Blue,
}

// 缺 Green、Blue
name_of fn(c: Color) string {
    return match (c) {
        Color.Red => "red"
    };
}

// Green 只有带守卫的臂，不算覆盖
guarded_only fn(c: Color, hi: bool) i64 {
    return match (c) {
        Color.Red => 1
        Color.Green when hi => 2
        Color.Blue => 3
    };
}
