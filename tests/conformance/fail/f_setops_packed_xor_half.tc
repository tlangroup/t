// EXPECT: error T-SET-E105
// §set-ops：`^` 单侧位域的静默错编缺口（与 `&` / `|` 的 E101/E102 同款）。
// 实测修复前：0 error，但 LLVM 校验期报
//   `%main.llt30 = xor %Perm %main.llt28, %main.llt29` —— 'i64' but expected '%Perm'。
packed struct Perm {
    readable: u1;
    writable: u1;
}
@main fn main() i32 {
    var a: Perm = Perm{ readable: 1, writable: 0 };
    var m: i64 = 3;
    var c: Perm = a ^ m;
    return 0;
}
