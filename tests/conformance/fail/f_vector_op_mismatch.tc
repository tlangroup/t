// EXPECT: error T-VEC-E004
// 向量逐元素运算要求两侧 lane 数与 lane 类型完全一致：向量之间没有隐式提升。
// 4 lane + 8 lane 无法逐元素配对 → T-VEC-E004。
@main
fn main() i64 {
    var a: @Vector(4, i32) = @splat(1i32, 4);
    var b: @Vector(8, i32) = @splat(2i32, 8);
    var c: @Vector(8, i32) = a + b;
    return @reduce_add(c) as i64;
}
