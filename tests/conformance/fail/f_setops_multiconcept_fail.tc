// EXPECT: error T-CON-E101
// §set-ops 岔路 B：多约束 `T: A & B` 要求 T 同时满足 A 与 B。
// OnlyName 只满足 HasName，不满足 HasAge（缺 age 字段）→ 实例化处报 T-CON-E101。
concept HasName {
    fn name(self) string;
}

concept HasAge {
    age: i64;
}

struct OnlyName {
    name: string;
    fn name(self: OnlyName) string {
        return self.name;
    }
}

fn describe(T: HasName & HasAge, x: T) string {
    return x.name;
}

@main fn main() i32 {
    var o: OnlyName = OnlyName{ .name = "bob" };
    var n: string = describe(o);   // OnlyName 缺 age 字段 → 不满足 HasAge → 报错
    if (n != "bob") { return 1; }
    return 0;
}
