// EXPECT: error T-LEX-E005
// reference.md §2.4：位宽后缀合法集 = u8/u16/u32/u64 i8/i16/i32/i64 f32/f64（窄固定）
//   + u1..u65535（无符号任意位宽）/ i2..i65535（有符号任意位宽）。
// ⚠ 下限不对称：`1u1` 现在**合法**（位域基本单元，见 base.tc awi_min_bits）；
//   有符号 `1i1` 仍非法 —— C23 的 signed _BitInt 要求 ≥ 2 位（1 位只剩符号位、无值位），
//   clang 报 `signed _BitInt must have a bit size of at least 2`，故 `i1` 不开放。
fn main() i32 @main {
    var a: i64 = 1i1;
    return 0;
}
