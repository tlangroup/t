// EXPECT: error T-MAT-E000
// C2 模式消歧裁定的负面用例：模式位置的裸标识符首字母大写即视为 CaseName，
// 若它不是 scrutinee 所属 enum 的成员（例如拼错），必须报错，
// 而不是静默退化为「匹配一切的绑定」——后者会让其余臂全部不可达且毫无提示。

enum Color : u8 {
    Red,
    Green,
}

fn typo(c: Color) string {
    return match (c) {
        Red => "r"
        Grene => "g"
        _ => "?"
    };
}
