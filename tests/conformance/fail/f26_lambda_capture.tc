// EXPECT: error T_CLOSURE_CAPTURE
// 按值捕获（Stage B）只认「有显式类型标注」的外层绑定：环境结构的字段类型必须
// 在脱糖期就能定下来。for-in 的迭代变量没有类型标注，捕获它必须报错，
// 而不是静默按未知类型编出错误代码。

use_it fn(m: map[string]i64) i64 {
    var total: i64 = 0;
    for (k in m) {
        var f: fn(i64) i64 = fn (x: i64) i64 { return x + str_len(k) as i64; };
        total = total + f(1);
    }
    return total;
}
