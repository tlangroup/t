// EXPECT: error T_META_COMPILE_ERROR
// M-meta Phase D：docs/meta_design.md §6 的 get_width 模式，传入不支持的类型
// 时由 CTFE 执行到 else 分支触发。取到的分支才算数，未取分支不误报（见 p40）。
meta get_width fn(meta T: type) u32 {
    if (@type_equal(T, u32)) { return 32; }
    else if (@type_equal(T, u64)) { return 64; }
    else { @compile_error("get_width: 不支持的类型"); }
    return 0;
}
@main
main fn() i32 {
    const W: u32 = meta get_width(i8);
    if (W == 0) { return 1; }
    return 0;
}
