// EXPECT: error T-CLA-E007
// 故障/修复子句不接受 `when` 守卫：它们是**编译期登记**（谓词 → 全名 / 修法名 → 闭包），
// 没有「匹配失败则继续找下一条」的语义，守卫对它们毫无意义。
// 守卫只属于 `.pattern`（那是 match 臂，会真的参与分派）。

struct User {
    age: i64;
}

const F_AGE = @clause(.fault, .{ .age < 0 }, when true, UserErr.AgeNegative);

@main
fn main() i32 {
    return 0;
}
