// EXPECT: error T_PIPE_NO_MATCH
// reference.md §3.15.3：`|>` 对可迭代左操作数做类型定向二选一 ——
// ① 整体应用（形参接受整个序列）② 逐元素映射（形参接受元素）。
// 两路皆不通时报 T_PIPE_NO_MATCH（而非笼统的类型不匹配）。
Point struct {
    x: i32;
    y: i32;
}

x_of fn(p: Point) i32 {
    return p.x;
}

main fn() i32 @main {
    var xs: []i32 = [];
    append(xs, 1);
    var n: i32 = xs |> x_of;
    return n;
}
