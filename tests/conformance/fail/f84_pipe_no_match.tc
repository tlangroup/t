// EXPECT: error T-PIP-E006
// reference.md §3.15.3：`|>` 对可迭代左操作数做类型定向二选一 ——
// ① 整体应用（形参接受整个序列）② 逐元素映射（形参接受元素）。
// 两路皆不通时报 T-PIP-E006（而非笼统的类型不匹配）。
struct Point {
    x: i32;
    y: i32;
}

fn x_of(p: Point) i32 {
    return p.x;
}

fn main() i32 @main {
    var xs: []i32 = [];
    append(xs, 1);
    var n: i32 = xs |> x_of;
    return n;
}
