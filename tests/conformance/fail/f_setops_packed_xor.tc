// EXPECT: error T-SET-E105
// §set-ops step2b：位域的 `^` 不支持（对称差 `^^` 属后续批次）。
// 此前会静默放行并在后端产出非法 IR `xor %Perm`。
packed struct Perm {
    readable: u1;
    writable: u1;
}
@main fn main() i32 {
    var a: Perm = Perm{ readable: 1, writable: 0 };
    var b: Perm = Perm{ readable: 1, writable: 1 };
    var c: Perm = a ^ b;
    return 0;
}
