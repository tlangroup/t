// EXPECT: error T-CLA-E010
// 故障/修复子句**不是 match 臂**：它们没有 pattern/guard/body 的臂语义，
// 只是编译期登记。若允许拼接进臂链，`@clause(.fault, .{...}, 全名)`
// 会被当成「模式 = 谓词、体 = 全名」的臂 ⇒ 静默错编（且不会有任何类型错）。
//
// ⚠ 判据是 clause 的**类别成员**（sa != "pattern"），不是节点种类：
//   两类都是 kind=="clause"，靠 sa 区分。

const F_AGE = @clause(.fault, .{ .age < 0 }, UserErr.AgeNegative);

fn pick(x: i64) i64 {
    return match (x) { F_AGE };
}

@main
fn main() i32 {
    println(int_to_str(pick(0)));
    return 0;
}
