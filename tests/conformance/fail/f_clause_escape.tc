// EXPECT: error T-CLA-E724, T-SEM-E202
// clause 是**编译期一等值**（设计 §4）：它没有运行期表示，因此
//   · 不得占用运行期存储（局部 var / 全局 var）→ T-CLA-E724
//   · 与 i64 等运行期类型不可互转           → T-SEM-E202
//
// ⚠ 本用例的历史使命：早先 `clause` 被注册为未解析的 "Named" 类型，语义等同
//   Unknown，于是 `return C;` 会 **0 error 静默放行** —— 一个 clause 值被当成
//   i64 返回出去，属于本项目最忌讳的「静默错编」（与 KI-002 同族）。
//   改为独立 TI 种类（ti_mk("Clause")）后，既有 T-SEM-E202 分支自然拦下；
//   T-CLA-E724 则是本特性新增的「运行期存储」专项护栏。

const C: clause = @clause(.pattern, 0, 1);

// ① 局部 var：clause 不得占运行期槽位
fn local_escape() i64 {
    var v: clause = C;
    return 0;
}

// ② 全局 var：同上
var GV: clause = C;

// ③ 类型错位：clause 与 i64 不可互转
fn leak() i64 {
    return C;
}

@main
fn main() i64 {
    return local_escape() + leak();
}
