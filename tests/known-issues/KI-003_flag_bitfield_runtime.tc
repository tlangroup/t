// KI-003 · packed struct 位域（P7 起取代 flag）
// 本目录不被 conformance/difftest 自动扫描，仅作为已知缺陷复现/修复回归用例手动运行。
//
// 历史：原用例用 `flag Perm[u16]{...}` + flag_get/flag_set，因 runtime 缺 t_flag_get/t_flag_set
// 符号而链接失败（flag 位域是「能过类型检查、不能链接」的半成品特性）。
// P7 移除 flag 关键字后改用 `packed struct`，位域读写由字段访问承担，无外部 runtime 符号
// 依赖，双后端均能链接并运行。
//
// 期望输出：r=1 w=0 level=5 owner=7

packed struct Perm {
    readable:   u1;
    writable:   u1;
    level:      u4;
    owner_id:   u8;
}

fn main() i32 @main {
    var p: Perm = Perm{ readable: 0, writable: 0, level: 0, owner_id: 0 };
    p.readable = 1;
    p.level = 5;
    p.owner_id = 7;

    print("r=");
    print(int_to_str(p.readable as i64));
    print(" w=");
    print(int_to_str(p.writable as i64));
    print(" level=");
    print(int_to_str(p.level as i64));
    print(" owner=");
    println(int_to_str(p.owner_id as i64));
    return 0;
}
