// KI-002_overload_struct_pat.tc · overload 结构字面量模式（Pt{ .x=0, .y=0 }）在 match 中的 LLVM 代码生成缺陷
//
// 本目录不被 conformance/difftest 自动扫描，仅作为已知缺陷复现/修复回归用例手动运行。
// overload 声明组复用既有函数子句脱糖（desugar_func_clauses），其结构字面量模式
// 同样走 match 的 struct 模式判别，故受 KI-002 影响：LLVM 后端运行期错编（首臂恒命中），
// 仅 C 后端（tc compile --emit-c + clang）正确。
//
// 期望（C 后端）：
//   o
//   x
//   y
//   unknown
// 实际（LLVM 轨 tc run）：前 3 行恒为 "o"（首臂恒命中），与 KI-002 同构。

struct Point { x: i64; y: i64; }

overload fn foo(Point{.x=0, .y=0}) string { return "o"; }
overload fn foo(Point{.x=1, .y=0}) string { return "x"; }
overload fn foo(Point{.x=0, .y=1}) string { return "y"; }
overload fn foo(_: Point) string { return "unknown"; }

@main
fn main() i64 {
    println(foo(Point{.x=0, .y=0}));
    println(foo(Point{.x=1, .y=0}));
    println(foo(Point{.x=0, .y=1}));
    println(foo(Point{.x=2, .y=2}));
    return 0;
}
