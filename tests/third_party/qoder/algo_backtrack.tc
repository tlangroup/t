// Third-party algorithm correctness test — backtracking
// Covers: N-Queens, subset count, permutation count
@import("std.testing");

fn nq_is_safe(cols: []i64, r: i64, c: i64) bool {
    var i: i64 = 0;
    while (i < r) {
        if (cols[i] == c) { return false; }
        var d: i64 = r - i;
        var cd: i64 = cols[i] - c;
        if (cd < 0) { cd = -cd; }
        if (cd == d) { return false; }
        i = i + 1;
    }
    return true;
}

fn nq_solve(cols: []i64, row: i64, n: i64) i64 {
    if (row == n) { return 1; }
    var count: i64 = 0;
    var c: i64 = 0;
    while (c < n) {
        if (nq_is_safe(cols, row, c)) {
            slice_set(cols, row, c);
            count = count + nq_solve(cols, row + 1, n);
        }
        c = c + 1;
    }
    return count;
}

fn n_queens(n: i64) i64 {
    var cols: []i64;
    var i: i64 = 0;
    while (i < n) {
        append(cols, 0);
        i = i + 1;
    }
    return nq_solve(cols, 0, n);
}

fn count_subsets(used: []bool, idx: i64, n: i64) i64 {
    if (idx == n) { return 1; }
    var without: i64 = count_subsets(used, idx + 1, n);
    slice_set(used, idx, true);
    var with: i64 = count_subsets(used, idx + 1, n);
    slice_set(used, idx, false);
    return with + without;
}

fn subset_count(n: i64) i64 {
    var used: []bool;
    var i: i64 = 0;
    while (i < n) {
        append(used, false);
        i = i + 1;
    }
    return count_subsets(used, 0, n);
}

fn count_perms(used: []bool, depth: i64, n: i64) i64 {
    if (depth == n) { return 1; }
    var count: i64 = 0;
    var i: i64 = 0;
    while (i < n) {
        if (used[i] == false) {
            slice_set(used, i, true);
            count = count + count_perms(used, depth + 1, n);
            slice_set(used, i, false);
        }
        i = i + 1;
    }
    return count;
}

fn permutation_count(n: i64) i64 {
    var used: []bool;
    var i: i64 = 0;
    while (i < n) {
        append(used, false);
        i = i + 1;
    }
    return count_perms(used, 0, n);
}

@main
fn main() i32 {
    testing.assert_eq_i(1, n_queens(1), "nqueens(1)");
    testing.assert_eq_i(0, n_queens(2), "nqueens(2)");
    testing.assert_eq_i(0, n_queens(3), "nqueens(3)");
    testing.assert_eq_i(2, n_queens(4), "nqueens(4)");
    testing.assert_eq_i(10, n_queens(5), "nqueens(5)");
    testing.assert_eq_i(4, n_queens(6), "nqueens(6)");
    testing.assert_eq_i(40, n_queens(7), "nqueens(7)");
    testing.assert_eq_i(92, n_queens(8), "nqueens(8)");

    testing.assert_eq_i(1, subset_count(0), "subsets(0)");
    testing.assert_eq_i(2, subset_count(1), "subsets(1)");
    testing.assert_eq_i(4, subset_count(2), "subsets(2)");
    testing.assert_eq_i(8, subset_count(3), "subsets(3)");
    testing.assert_eq_i(16, subset_count(4), "subsets(4)");
    testing.assert_eq_i(1024, subset_count(10), "subsets(10)");

    testing.assert_eq_i(1, permutation_count(0), "perms(0)");
    testing.assert_eq_i(1, permutation_count(1), "perms(1)");
    testing.assert_eq_i(2, permutation_count(2), "perms(2)");
    testing.assert_eq_i(6, permutation_count(3), "perms(3)");
    testing.assert_eq_i(24, permutation_count(4), "perms(4)");
    testing.assert_eq_i(120, permutation_count(5), "perms(5)");
    testing.assert_eq_i(720, permutation_count(6), "perms(6)");

    return 0;
}
