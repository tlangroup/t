// Third-party algorithm correctness test — sorting algorithms
// Covers: bubble, selection, insertion, quick sort, merge sort
@import("std.testing");
@import("std.mem");

fn bubble_sort(xs: []i64) void {
    var n: i64 = slice_len(xs) as i64;
    var i: i64 = 0;
    while (i < n) {
        var j: i64 = 0;
        while (j < n - 1 - i) {
            if (xs[j] > xs[j + 1]) {
                mem.swap_in(i64, xs, j, j + 1);
            }
            j = j + 1;
        }
        i = i + 1;
    }
}

fn selection_sort(xs: []i64) void {
    var n: i64 = slice_len(xs) as i64;
    var i: i64 = 0;
    while (i < n - 1) {
        var min_idx: i64 = i;
        var j: i64 = i + 1;
        while (j < n) {
            if (xs[j] < xs[min_idx]) { min_idx = j; }
            j = j + 1;
        }
        if (min_idx != i) {
            mem.swap_in(i64, xs, i, min_idx);
        }
        i = i + 1;
    }
}

fn insertion_sort(xs: []i64) void {
    var n: i64 = slice_len(xs) as i64;
    var i: i64 = 1;
    while (i < n) {
        var key: i64 = xs[i];
        var j: i64 = i - 1;
        while (j >= 0 && xs[j] > key) {
            slice_set(xs, j + 1, xs[j]);
            j = j - 1;
        }
        slice_set(xs, j + 1, key);
        i = i + 1;
    }
}

fn qs_partition(xs: []i64, lo: i64, hi: i64) i64 {
    var pivot: i64 = xs[hi];
    var i: i64 = lo - 1;
    var j: i64 = lo;
    while (j < hi) {
        if (xs[j] <= pivot) {
            i = i + 1;
            if (i != j) { mem.swap_in(i64, xs, i, j); }
        }
        j = j + 1;
    }
    if (i + 1 != hi) { mem.swap_in(i64, xs, i + 1, hi); }
    return i + 1;
}

fn quick_sort_range(xs: []i64, lo: i64, hi: i64) void {
    if (lo < hi) {
        var p: i64 = qs_partition(xs, lo, hi);
        quick_sort_range(xs, lo, p - 1);
        quick_sort_range(xs, p + 1, hi);
    }
}

fn quick_sort(xs: []i64) void {
    var n: i64 = slice_len(xs) as i64;
    if (n > 1) { quick_sort_range(xs, 0, n - 1); }
}

fn merge_range(xs: []i64, lo: i64, mid: i64, hi: i64) void {
    var tmp: []i64;
    var i: i64 = lo;
    while (i <= hi) {
        append(tmp, xs[i]);
        i = i + 1;
    }
    var left: i64 = 0;
    var right: i64 = mid - lo + 1;
    var end_l: i64 = mid - lo;
    var end_r: i64 = hi - lo;
    var k: i64 = lo;
    while (left <= end_l && right <= end_r) {
        if (tmp[left] <= tmp[right]) {
            slice_set(xs, k, tmp[left]);
            left = left + 1;
        } else {
            slice_set(xs, k, tmp[right]);
            right = right + 1;
        }
        k = k + 1;
    }
    while (left <= end_l) {
        slice_set(xs, k, tmp[left]);
        left = left + 1;
        k = k + 1;
    }
    while (right <= end_r) {
        slice_set(xs, k, tmp[right]);
        right = right + 1;
        k = k + 1;
    }
}

fn merge_sort_range(xs: []i64, lo: i64, hi: i64) void {
    if (lo < hi) {
        var mid: i64 = (lo + hi) / 2;
        merge_sort_range(xs, lo, mid);
        merge_sort_range(xs, mid + 1, hi);
        merge_range(xs, lo, mid, hi);
    }
}

fn merge_sort(xs: []i64) void {
    var n: i64 = slice_len(xs) as i64;
    if (n > 1) { merge_sort_range(xs, 0, n - 1); }
}

fn make_test_data() []i64 {
    var xs: []i64;
    append(xs, 5); append(xs, 3); append(xs, 1); append(xs, 4); append(xs, 2);
    return xs;
}

fn expect_sorted(xs: []i64, label: string) void {
    testing.assert_eq_i(5, slice_len(xs) as i64, label);
    testing.assert_eq_i(1, xs[0], label);
    testing.assert_eq_i(2, xs[1], label);
    testing.assert_eq_i(3, xs[2], label);
    testing.assert_eq_i(4, xs[3], label);
    testing.assert_eq_i(5, xs[4], label);
}

@main
fn main() i32 {
    var d1: []i64 = make_test_data();
    bubble_sort(d1);
    expect_sorted(d1, "bubble");

    var d2: []i64 = make_test_data();
    selection_sort(d2);
    expect_sorted(d2, "selection");

    var d3: []i64 = make_test_data();
    insertion_sort(d3);
    expect_sorted(d3, "insertion");

    var d4: []i64 = make_test_data();
    quick_sort(d4);
    expect_sorted(d4, "quick");

    var d5: []i64 = make_test_data();
    merge_sort(d5);
    expect_sorted(d5, "merge");

    var sorted: []i64 = [1, 2, 3, 4, 5];
    var d6: []i64 = [1, 2, 3, 4, 5];
    quick_sort(d6);
    testing.assert_true(mem.equal(i64, d6, sorted), "quick already sorted");

    var d7: []i64 = [5, 4, 3, 2, 1];
    merge_sort(d7);
    testing.assert_true(mem.equal(i64, d7, sorted), "merge reverse sorted");

    var d8: []i64 = [3, 1, 4, 1, 5, 9, 2, 6];
    insertion_sort(d8);
    var expected2: []i64 = [1, 1, 2, 3, 4, 5, 6, 9];
    testing.assert_true(mem.equal(i64, d8, expected2), "insertion duplicates");

    var d9: []i64 = [3, 1, 4, 1, 5, 9, 2, 6];
    quick_sort(d9);
    testing.assert_true(mem.equal(i64, d9, expected2), "quick duplicates");

    var single: []i64 = [42];
    bubble_sort(single);
    testing.assert_eq_i(42, single[0], "bubble single");

    return 0;
}
