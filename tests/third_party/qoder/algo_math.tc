// Third-party algorithm correctness test — math
// Covers: recursion, iteration, GCD/LCM, factorial, bit ops, matrix multiply
@import("std.testing");

fn fib_recursive(n: i64) i64 {
    if (n <= 0) { return 0; }
    if (n == 1) { return 1; }
    return fib_recursive(n - 1) + fib_recursive(n - 2);
}

fn fib_iterative(n: i64) i64 {
    if (n <= 0) { return 0; }
    if (n == 1) { return 1; }
    var a: i64 = 0;
    var b: i64 = 1;
    var i: i64 = 2;
    while (i <= n) {
        var t: i64 = a + b;
        a = b;
        b = t;
        i = i + 1;
    }
    return b;
}

fn gcd(a: i64, b: i64) i64 {
    if (b == 0) { return a; }
    return gcd(b, a % b);
}

fn lcm(a: i64, b: i64) i64 {
    if (a == 0 or b == 0) { return 0; }
    var g: i64 = gcd(a, b);
    var result: i64 = a / g * b;
    if (result < 0) { result = -result; }
    return result;
}

fn factorial(n: i64) i64 {
    var result: i64 = 1;
    var i: i64 = 2;
    while (i <= n) {
        result = result * i;
        i = i + 1;
    }
    return result;
}

fn is_power_of_two(n: i64) bool {
    if (n <= 0) { return false; }
    return (n & (n - 1)) == 0;
}

fn mat_mul_2x2(a: []i64, b: []i64, c: []i64) void {
    var i: i64 = 0;
    while (i < 2) {
        var j: i64 = 0;
        while (j < 2) {
            var sum: i64 = 0;
            var k: i64 = 0;
            while (k < 2) {
                sum = sum + a[i * 2 + k] * b[k * 2 + j];
                k = k + 1;
            }
            c[i * 2 + j] = sum;
            j = j + 1;
        }
        i = i + 1;
    }
}

@main
fn main() i32 {
    testing.assert_eq_i(0, fib_recursive(0), "fib_rec(0)");
    testing.assert_eq_i(1, fib_recursive(1), "fib_rec(1)");
    testing.assert_eq_i(55, fib_recursive(10), "fib_rec(10)");
    testing.assert_eq_i(6765, fib_recursive(20), "fib_rec(20)");

    testing.assert_eq_i(0, fib_iterative(0), "fib_iter(0)");
    testing.assert_eq_i(1, fib_iterative(1), "fib_iter(1)");
    testing.assert_eq_i(55, fib_iterative(10), "fib_iter(10)");
    testing.assert_eq_i(6765, fib_iterative(20), "fib_iter(20)");

    testing.assert_eq_i(6, gcd(12, 18), "gcd(12,18)");
    testing.assert_eq_i(1, gcd(17, 13), "gcd(17,13)");
    testing.assert_eq_i(5, gcd(0, 5), "gcd(0,5)");
    testing.assert_eq_i(7, gcd(7, 0), "gcd(7,0)");

    testing.assert_eq_i(36, lcm(12, 18), "lcm(12,18)");
    testing.assert_eq_i(221, lcm(13, 17), "lcm(13,17)");
    testing.assert_eq_i(0, lcm(0, 5), "lcm(0,5)");

    testing.assert_eq_i(1, factorial(0), "fact(0)");
    testing.assert_eq_i(1, factorial(1), "fact(1)");
    testing.assert_eq_i(120, factorial(5), "fact(5)");
    testing.assert_eq_i(3628800, factorial(10), "fact(10)");

    testing.assert_true(is_power_of_two(1), "pow2(1)");
    testing.assert_true(is_power_of_two(2), "pow2(2)");
    testing.assert_true(is_power_of_two(1024), "pow2(1024)");
    testing.assert_false(is_power_of_two(0), "pow2(0)");
    testing.assert_false(is_power_of_two(3), "pow2(3)");
    testing.assert_false(is_power_of_two(1000), "pow2(1000)");

    var a: []i64 = [1, 2, 3, 4];
    var b: []i64 = [5, 6, 7, 8];
    var c: []i64 = [0, 0, 0, 0];
    mat_mul_2x2(a, b, c);
    testing.assert_eq_i(19, c[0], "mat[0][0]");
    testing.assert_eq_i(22, c[1], "mat[0][1]");
    testing.assert_eq_i(43, c[2], "mat[1][0]");
    testing.assert_eq_i(50, c[3], "mat[1][1]");

    var id_in: []i64 = [1, 0, 0, 1];
    var id_out: []i64 = [0, 0, 0, 0];
    mat_mul_2x2(a, id_in, id_out);
    testing.assert_eq_i(1, id_out[0], "identity[0]");
    testing.assert_eq_i(2, id_out[1], "identity[1]");
    testing.assert_eq_i(3, id_out[2], "identity[2]");
    testing.assert_eq_i(4, id_out[3], "identity[3]");

    return 0;
}
