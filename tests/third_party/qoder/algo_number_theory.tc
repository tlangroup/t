// Third-party algorithm correctness test — number theory
// Covers: primality, sieve, factorization, Collatz, digit sum
@import("std.testing");

fn is_prime(n: i64) bool {
    if (n < 2) { return false; }
    if (n < 4) { return true; }
    if (n % 2 == 0 || n % 3 == 0) { return false; }
    var d: i64 = 5;
    while (d * d <= n) {
        if (n % d == 0 || n % (d + 2) == 0) { return false; }
        d = d + 6;
    }
    return true;
}

fn sieve(limit: i64) []i64 {
    var is_p: []bool;
    var i: i64 = 0;
    while (i <= limit) {
        append(is_p, true);
        i = i + 1;
    }
    if (limit >= 0) { slice_set(is_p, 0, false); }
    if (limit >= 1) { slice_set(is_p, 1, false); }
    var d: i64 = 2;
    while (d * d <= limit) {
        if (is_p[d]) {
            var m: i64 = d * d;
            while (m <= limit) {
                slice_set(is_p, m, false);
                m = m + d;
            }
        }
        d = d + 1;
    }
    var result: []i64;
    var j: i64 = 2;
    while (j <= limit) {
        if (is_p[j]) { append(result, j); }
        j = j + 1;
    }
    return result;
}

fn prime_factors(n: i64) []i64 {
    var result: []i64;
    if (n < 2) { return result; }
    var d: i64 = 2;
    var v: i64 = n;
    while (v > 1) {
        while (v % d == 0) {
            append(result, d);
            v = v / d;
        }
        d = d + 1;
    }
    return result;
}

fn collatz_steps(n: i64) i64 {
    var steps: i64 = 0;
    var v: i64 = n;
    while (v != 1) {
        if (v % 2 == 0) {
            v = v / 2;
        } else {
            v = 3 * v + 1;
        }
        steps = steps + 1;
    }
    return steps;
}

fn digit_sum(n: i64) i64 {
    var sum: i64 = 0;
    var v: i64 = n;
    if (v < 0) { v = -v; }
    while (v > 0) {
        sum = sum + (v % 10);
        v = v / 10;
    }
    return sum;
}

@main
fn main() i32 {
    testing.assert_false(is_prime(0), "prime(0)");
    testing.assert_false(is_prime(1), "prime(1)");
    testing.assert_true(is_prime(2), "prime(2)");
    testing.assert_true(is_prime(3), "prime(3)");
    testing.assert_false(is_prime(4), "prime(4)");
    testing.assert_true(is_prime(17), "prime(17)");
    testing.assert_true(is_prime(97), "prime(97)");
    testing.assert_false(is_prime(100), "prime(100)");
    testing.assert_true(is_prime(7919), "prime(7919)");

    var p10: []i64 = sieve(10);
    testing.assert_eq_i(4, slice_len(p10) as i64, "sieve(10) count");
    testing.assert_eq_i(2, p10[0], "sieve(10)[0]");
    testing.assert_eq_i(3, p10[1], "sieve(10)[1]");
    testing.assert_eq_i(5, p10[2], "sieve(10)[2]");
    testing.assert_eq_i(7, p10[3], "sieve(10)[3]");

    var p30: []i64 = sieve(30);
    testing.assert_eq_i(10, slice_len(p30) as i64, "sieve(30) count");
    testing.assert_eq_i(29, p30[9], "sieve(30)[9]");

    var f1: []i64 = prime_factors(12);
    testing.assert_eq_i(3, slice_len(f1) as i64, "factors(12) count");
    testing.assert_eq_i(2, f1[0], "factors(12)[0]");
    testing.assert_eq_i(2, f1[1], "factors(12)[1]");
    testing.assert_eq_i(3, f1[2], "factors(12)[2]");

    var f2: []i64 = prime_factors(360);
    testing.assert_eq_i(6, slice_len(f2) as i64, "factors(360) count");
    testing.assert_eq_i(2, f2[0], "factors(360)[0]");
    testing.assert_eq_i(2, f2[1], "factors(360)[1]");
    testing.assert_eq_i(2, f2[2], "factors(360)[2]");
    testing.assert_eq_i(3, f2[3], "factors(360)[3]");
    testing.assert_eq_i(3, f2[4], "factors(360)[4]");
    testing.assert_eq_i(5, f2[5], "factors(360)[5]");

    testing.assert_eq_i(0, collatz_steps(1), "collatz(1)");
    testing.assert_eq_i(1, collatz_steps(2), "collatz(2)");
    testing.assert_eq_i(8, collatz_steps(6), "collatz(6)");
    testing.assert_eq_i(111, collatz_steps(27), "collatz(27)");

    testing.assert_eq_i(0, digit_sum(0), "digit_sum(0)");
    testing.assert_eq_i(15, digit_sum(12345), "digit_sum(12345)");
    testing.assert_eq_i(1, digit_sum(10000), "digit_sum(10000)");
    testing.assert_eq_i(45, digit_sum(123456789), "digit_sum(123456789)");

    return 0;
}
