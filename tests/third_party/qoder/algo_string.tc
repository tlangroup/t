// Third-party algorithm correctness test — string algorithms
// Covers: palindrome, reverse, vowel count, word count, caesar cipher
@import("std.testing");

fn is_palindrome(s: string) bool {
    var n: i64 = str_len(s) as i64;
    if (n <= 1) { return true; }
    var lo: i64 = 0;
    var hi: i64 = n - 1;
    while (lo < hi) {
        if (str_at(s, lo) != str_at(s, hi)) { return false; }
        lo = lo + 1;
        hi = hi - 1;
    }
    return true;
}

fn reverse_string(s: string) string {
    var sb: StringBuilder = sb_new();
    var i: i64 = (str_len(s) as i64) - 1;
    while (i >= 0) {
        sb_append_char(sb, str_at(s, i) as i64);
        i = i - 1;
    }
    return sb_to_str(sb);
}

fn count_vowels(s: string) i64 {
    var count: i64 = 0;
    var n: i64 = str_len(s) as i64;
    var i: i64 = 0;
    while (i < n) {
        var c: u8 = str_at(s, i);
        if (c == 'a' or c == 'e' or c == 'i' or c == 'o' or c == 'u' or
            c == 'A' or c == 'E' or c == 'I' or c == 'O' or c == 'U') {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

fn word_count(s: string) i64 {
    var count: i64 = 0;
    var in_word: bool = false;
    var n: i64 = str_len(s) as i64;
    var i: i64 = 0;
    while (i < n) {
        var c: u8 = str_at(s, i);
        if (c == ' ' or c == '\t' or c == '\n') {
            in_word = false;
        } else {
            if (in_word == false) {
                count = count + 1;
                in_word = true;
            }
        }
        i = i + 1;
    }
    return count;
}

fn caesar_cipher(s: string, shift: i64) string {
    var sb: StringBuilder = sb_new();
    var n: i64 = str_len(s) as i64;
    var i: i64 = 0;
    while (i < n) {
        var c: u8 = str_at(s, i);
        if (c >= 'A' and c <= 'Z') {
            var val: i64 = ((c as i64) - 65 + shift) % 26;
            if (val < 0) { val = val + 26; }
            sb_append_char(sb, val + 65);
        } else if (c >= 'a' and c <= 'z') {
            var val: i64 = ((c as i64) - 97 + shift) % 26;
            if (val < 0) { val = val + 26; }
            sb_append_char(sb, val + 97);
        } else {
            sb_append_char(sb, c as i64);
        }
        i = i + 1;
    }
    return sb_to_str(sb);
}

@main
fn main() i32 {
    testing.assert_true(is_palindrome(""), "palindrome empty");
    testing.assert_true(is_palindrome("a"), "palindrome single");
    testing.assert_true(is_palindrome("aba"), "palindrome aba");
    testing.assert_true(is_palindrome("abba"), "palindrome abba");
    testing.assert_false(is_palindrome("ab"), "palindrome ab");
    testing.assert_false(is_palindrome("hello"), "palindrome hello");
    testing.assert_true(is_palindrome("racecar"), "palindrome racecar");

    testing.assert_eq_s("", reverse_string(""), "reverse empty");
    testing.assert_eq_s("a", reverse_string("a"), "reverse a");
    testing.assert_eq_s("dcba", reverse_string("abcd"), "reverse abcd");
    testing.assert_eq_s("olleh", reverse_string("hello"), "reverse hello");

    testing.assert_eq_i(0, count_vowels(""), "vowels empty");
    testing.assert_eq_i(0, count_vowels("rhythm"), "vowels rhythm");
    testing.assert_eq_i(2, count_vowels("hello"), "vowels hello");
    testing.assert_eq_i(5, count_vowels("AEIOU"), "vowels AEIOU");
    testing.assert_eq_i(0, count_vowels("bcdfg"), "vowels bcdfg");

    testing.assert_eq_i(0, word_count(""), "words empty");
    testing.assert_eq_i(1, word_count("hello"), "words single");
    testing.assert_eq_i(2, word_count("hello world"), "words two");
    testing.assert_eq_i(4, word_count("  hello   world  foo  bar "), "words padded");
    testing.assert_eq_i(3, word_count("a b c"), "words three");

    testing.assert_eq_s("def", caesar_cipher("abc", 3), "caesar abc+3");
    testing.assert_eq_s("xyz", caesar_cipher("abc", 23), "caesar abc+23");
    testing.assert_eq_s("ABC", caesar_cipher("XYZ", 3), "caesar XYZ+3");
    testing.assert_eq_s("Hello, World!", caesar_cipher("Hello, World!", 0), "caesar shift 0");
    testing.assert_eq_s("abc", caesar_cipher("xyz", 3), "caesar wrap");

    return 0;
}
