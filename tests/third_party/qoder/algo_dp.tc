// Third-party algorithm correctness test — dynamic programming
// Covers: 0/1 knapsack, LCS, coin change, climb stairs
@import("std.testing");

fn knapsack(weights: []i64, values: []i64, cap: i64) i64 {
    var n: i64 = slice_len(weights) as i64;
    var dp: [][]i64;
    var i: i64 = 0;
    while (i <= n) {
        var row: []i64;
        var j: i64 = 0;
        while (j <= cap) {
            append(row, 0);
            j = j + 1;
        }
        append(dp, row);
        i = i + 1;
    }
    i = 1;
    while (i <= n) {
        var w: i64 = weights[i - 1];
        var v: i64 = values[i - 1];
        var j: i64 = 0;
        while (j <= cap) {
            dp[i][j] = dp[i - 1][j];
            if (j >= w) {
                var take: i64 = dp[i - 1][j - w] + v;
                if (take > dp[i][j]) { dp[i][j] = take; }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return dp[n][cap];
}

fn lcs_length(a: string, b: string) i64 {
    var m: i64 = str_len(a) as i64;
    var n: i64 = str_len(b) as i64;
    var dp: [][]i64;
    var i: i64 = 0;
    while (i <= m) {
        var row: []i64;
        var j: i64 = 0;
        while (j <= n) {
            append(row, 0);
            j = j + 1;
        }
        append(dp, row);
        i = i + 1;
    }
    i = 1;
    while (i <= m) {
        var j: i64 = 1;
        while (j <= n) {
            if (str_at(a, i - 1) == str_at(b, j - 1)) {
                dp[i][j] = dp[i - 1][j - 1] + 1;
            } else {
                var left: i64 = dp[i][j - 1];
                var up: i64 = dp[i - 1][j];
                if (left > up) { dp[i][j] = left; } else { dp[i][j] = up; }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return dp[m][n];
}

fn coin_change(coins: []i64, amount: i64) i64 {
    var INF: i64 = 1000000;
    var dp: []i64;
    var i: i64 = 0;
    while (i <= amount) {
        append(dp, INF);
        i = i + 1;
    }
    slice_set(dp, 0, 0);
    i = 1;
    while (i <= amount) {
        var c: i64 = 0;
        var nc: i64 = slice_len(coins) as i64;
        while (c < nc) {
            if (coins[c] <= i) {
                var prev: i64 = dp[i - coins[c]];
                if (prev < INF) {
                    var take: i64 = prev + 1;
                    if (take < dp[i]) { slice_set(dp, i, take); }
                }
            }
            c = c + 1;
        }
        i = i + 1;
    }
    if (dp[amount] >= INF) { return -1; }
    return dp[amount];
}

fn climb_stairs(n: i64) i64 {
    if (n <= 1) { return 1; }
    var a: i64 = 1;
    var b: i64 = 1;
    var i: i64 = 2;
    while (i <= n) {
        var t: i64 = a + b;
        a = b;
        b = t;
        i = i + 1;
    }
    return b;
}

@main
fn main() i32 {
    var w: []i64 = [2, 3, 4, 5];
    var v: []i64 = [3, 4, 5, 6];
    testing.assert_eq_i(7, knapsack(w, v, 5), "knapsack basic");
    testing.assert_eq_i(9, knapsack(w, v, 7), "knapsack cap7");
    testing.assert_eq_i(0, knapsack(w, v, 0), "knapsack cap0");
    testing.assert_eq_i(18, knapsack(w, v, 14), "knapsack all");

    var w2: []i64 = [1, 2, 3];
    var v2: []i64 = [6, 10, 12];
    testing.assert_eq_i(22, knapsack(w2, v2, 5), "knapsack classic");

    testing.assert_eq_i(0, lcs_length("", ""), "lcs empty");
    testing.assert_eq_i(0, lcs_length("abc", ""), "lcs one empty");
    testing.assert_eq_i(3, lcs_length("abc", "abc"), "lcs identical");
    testing.assert_eq_i(3, lcs_length("abcde", "ace"), "lcs ace");
    testing.assert_eq_i(4, lcs_length("AGGTAB", "GXTXAYB"), "lcs classic");
    testing.assert_eq_i(0, lcs_length("abc", "xyz"), "lcs disjoint");

    var coins1: []i64 = [1, 5, 10, 25];
    testing.assert_eq_i(2, coin_change(coins1, 30), "coins 30");
    testing.assert_eq_i(1, coin_change(coins1, 1), "coins 1");
    testing.assert_eq_i(1, coin_change(coins1, 5), "coins 5");
    testing.assert_eq_i(0, coin_change(coins1, 0), "coins 0");

    var coins2: []i64 = [2];
    testing.assert_eq_i(-1, coin_change(coins2, 3), "coins impossible");
    testing.assert_eq_i(3, coin_change(coins2, 6), "coins even");

    var coins3: []i64 = [1, 2, 5];
    testing.assert_eq_i(3, coin_change(coins3, 11), "coins 11");

    testing.assert_eq_i(1, climb_stairs(0), "climb 0");
    testing.assert_eq_i(1, climb_stairs(1), "climb 1");
    testing.assert_eq_i(2, climb_stairs(2), "climb 2");
    testing.assert_eq_i(3, climb_stairs(3), "climb 3");
    testing.assert_eq_i(8, climb_stairs(5), "climb 5");
    testing.assert_eq_i(89, climb_stairs(10), "climb 10");

    return 0;
}
