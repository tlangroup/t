// tests/hir_eval/basic.tc — Stage A' 验证：HIR 指令流编译期求值（供 `tc comptime-eval`）
// 覆盖：int 算术/位运算/比较、bool 逻辑、一元 -/~/!、字符串拼接比较、
//       struct 构造与字段读、数组字面量与下标、编译期递归函数、while 循环、
//       for_each 迭代、函数调用、类型转换。
// 本文件不含 main（仅供 comptime-eval，不编译为可执行）。

comptime const A = 2 + 3 * 4;          // 14
comptime const B = (10 - 2) / 4;      // 2
comptime const C = 7 % 3;             // 1
comptime const D = 1 << 4;            // 16
comptime const E = 255 & 15;          // 15
comptime const F = 5 & 3;             // 1
comptime const G = !false;            // true
comptime const H = true and false;     // false
comptime const I = -7;                // -7
comptime const J = ~0;                // -1
comptime const K = 3 == 3;            // true
comptime const S = "ab" + "cd";       // "abcd"
comptime const STR_EQ = "x" == "x";   // true

struct Point { px: i32; py: i32; }
comptime const P = Point{ px: 3, py: 4 };   // {px=3, py=4}
comptime const PX = P.px;                  // 3

comptime const ARR = [1, 2, 3, 4];         // [1, 2, 3, 4]
comptime const ARR0 = ARR[0];              // 1
comptime const ARRSUM = ARR[0] + ARR[1] + ARR[2] + ARR[3];  // 10

comptime fn fact(n: i64) i64 {
    if (n <= 1) { return 1; }
    return n * fact(n - 1);
}
comptime const F6 = fact(6);          // 720
comptime const F10 = fact(10);        // 3628800

comptime fn fib(n: i64) i64 {
    if (n < 2) { return n; }
    return fib(n - 1) + fib(n - 2);
}
comptime const FIB7 = fib(7);          // 13

comptime fn sum_to(n: i64) i64 {
    var s: i64 = 0;
    var i: i64 = 1;
    while (i <= n) {
        s = s + i;
        i = i + 1;
    }
    return s;
}
comptime const SUM5 = sum_to(5);       // 15

comptime fn sum_arr(a: []i64) i64 {
    var s: i64 = 0;
    for (x in a) { s = s + x; }
    return s;
}
comptime const ARRSUM2 = sum_arr([2, 3, 5]);   // 10

comptime fn ct_max(a: i64, b: i64) i64 {
    if (a > b) { return a; }
    return b;
}
comptime const MX = ct_max(7, 12);     // 12

comptime const CAST1 = 3 as f64;       // 3.0
comptime const CAST2 = 3.7 as i64;     // 3
