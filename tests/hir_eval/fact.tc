// tests/hir_eval/fact.tc — 交叉验证：HIR 解释器 vs 真实后端
// `tc comptime-eval --name F12 fact.tc` 应输出 "F12 = 479001600"，
// 与 `tc run fact.tc`（真实 LLVM/C 后端运行时计算 fact(12)）的 stdout 一致。
// 若两者相等 ⇒ HIR 指令流解释器语义与语言运行期语义对齐。
//
// 注：main 走「运行时递归」路径（后端可正确处理），而非读 comptime const F12
// —— 当前后端对「函数调用式 comptime const」的折叠尚未实现（会发 0），属后端
// 独立盲区，与 HIR 解释器无关；F12 仅用于驱动解释器的编译期函数调用求值。

fn fact(n: i64) i64 {
    if (n <= 1) { return 1; }
    return n * fact(n - 1);
}
comptime const F12 = fact(12);

fn main() i64 @main {
    print(int_to_str(fact(12)));
    print("\n");
    return 0;
}
