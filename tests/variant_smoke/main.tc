// Variant 运行时冒烟测试（不被 conformance/difftest 自动扫描，仅手动构建运行）
// 验证：构造 / 判别 / 取载荷 的 C 代码可编译且行为正确。

Shape variant {
    Circle(f64);
    Rect(f64);
    Empty;
}

main fn() i32 {
    var c: Shape = Shape_from_Circle(3.0);
    var e: Shape = Shape_from_Empty();
    var d: Shape = Shape_from_Rect(4.0);

    if (Shape_is_Circle(c)) {
        print("CIRCLE\n");
    }
    if (Shape_is_Empty(e)) {
        print("EMPTY\n");
    }
    if (Shape_is_Rect(d)) {
        print("RECT\n");
    }

    var r: f64 = Shape_as_Circle(c);
    if (r == 3.0) {
        print("ROUNDTRIP_OK\n");
    } else {
        print("ROUNDTRIP_FAIL\n");
    }

    // 单元 case 不应有 as_ 访问器；这里仅确认可构造与判别
    if (Shape_is_Empty(e)) {
        print("UNIT_OK\n");
    }
    return 0;
}
