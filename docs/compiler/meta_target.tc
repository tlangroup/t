// examples/comptime.tc —— t 语言 `comptime` 元编程设计用例（对应 docs/compiler/meta_design.md）
//
// ⚠ 本文件是「comptime 功能」的设计用例，使用了尚未落地的 `comptime` 关键字与内建
//   （`@compile_log` / `@compile_error` / `@type_equal` / `@type_size` /
//     `@zeroed` / `sym_intern` / `Sym` 一级类型等）。
//    在 comptime 功能实现前，本文件无法通过 tc 编译；它仅用于对齐设计与语法。
//
// 语法严格遵循 t 既有文法：
//   - 并置声明（Name fn / Name struct）
//   - 语句强制 `;`；if/while/for 强制括号 + 大括号
//   - 类型转换唯一 `as`；数组 `[N]T`；数组字面量 `[e,...]`
//   - 类型自省走 type_info(T) + ti_*/fi_* 函数式 API（无 .field 成员糖）
//   - 符号用一级类型 `Sym`（设计新增）；`Sym32("tag")` 仍可用作具象符号

// 1. 编译期常量（顶层 comptime const，CTFE 初始化）
comptime const PI: f64 = 3.1415926;

// 2. 编译期函数（可编译期也可运行时调用）
comptime add fn(a: u32, b: u32) u32 {
    return a + b;
}

// 3. 编译期类型参数（泛型核心，调用点以类型作首实参触发单态化）
max fn(comptime T: type, a: T, b: T) T {
    if (a > b) { return a; }
    return b;
}

// 4.1 类型反射（顶层 comptime 函数）
comptime print_type fn(comptime T: type) void {
    @compile_log("type name: ", @type_name(T), "  size: ", @type_size(T));
}

// 4.2 结构体定义 + 字段反射遍历
Point struct {
    x: f32;
    y: f32;
}

// 7.1 编译期条件分支（用 @type_equal + 普通 if，无特殊 comptime if）
comptime get_width fn(comptime T: type) u32 {
    if (@type_equal(T, u32)) { return 32; }
    else if (@type_equal(T, u64)) { return 64; }
    else { @compile_error("unsupported type"); }
    return 0;   // 不可达兜底，满足显式返回
}

// 9. 编译期字符串构造（comptime 值参数 + 符号返回）
comptime repeat fn(comptime s: string, comptime n: u32) Sym {
    var buf: [1024]u8 = @zeroed([1024]u8);
    var pos: u32 = 0;
    var i: u32 = 0;
    while (i < n) {
        var j: u32 = 0;
        var slen: u32 = str_len(s) as u32;
        while (j < slen) {
            buf[pos] = s[j];
            pos = pos + 1;
            j = j + 1;
        }
        i = i + 1;
    }
    return sym_intern(buf, pos);
}

// 8. 编译期类型检查辅助函数（顶层 comptime fn）
comptime check_type fn(comptime T: type) void {
    if (@type_equal(T, f128)) {
        @compile_error("f128 not supported");
    }
}

main fn() i64 @main {
    // 1. comptime 子表达式求值
    var x: u32 = comptime 100 * 20;

    // 2. 调用 comptime 函数（编译期执行）
    auto val = comptime add(7, 8);

    // 3. 泛型调用（类型作首实参）
    auto m1 = max(u32, 10, 20);
    auto m2 = max(f32, 2.1 as f32, 1.9 as f32);

    // 4.1 打印类型信息（编译期）
    comptime print_type(u64);

    // 4.2 编译期遍历结构体字段
    comptime {
        var info: TypeInfo = type_info(Point);
        var i: i64 = 0;
        while (i < ti_field_count(info)) {
            var f: FieldInfo = ti_field(info, i);
            @compile_log("field name: ", fi_name(f));
            i = i + 1;
        }
    }

    // 5. comptime 代码块（编译期求值，无运行时代码）
    comptime {
        var k: u32 = 0;
        k = k + 5;
        @compile_log("meta k = ", k);
    }

    // 6. comptime 编译期可变变量，生成静态查表
    comptime {
        var table: [10]u8 = @zeroed([10]u8);
        var idx: u32 = 0;
        while (idx < 10) {
            table[idx] = (idx * 2) as u8;
            idx = idx + 1;
        }
    }

    // 7.1 获取类型位宽
    auto w = comptime get_width(u32);

    // 7.2 comptime while 累加示例
    comptime {
        var sum: i64 = 0;
        var n: i64 = 1;
        while (n <= 10) {
            sum = sum + n;
            n = n + 1;
        }
        @compile_log("sum 1..10 = ", sum);
    }

    // 8. 编译期类型检查
    comptime check_type(f32);
    // comptime check_type(f128); // 启用此行触发编译错误

    // 9. 编译期字符串生成
    auto str = comptime repeat("hi", 3);

    // 10. comptime 表达式用于数组长度
    const arr: [comptime 4 + 2]u8 = [1, 2, 3, 4, 5, 6];

    // 运行期自校验
    if (x == 2000 && val == 15 && m1 == 20 && m2 > (1.9 as f32) && w == 32) {
        return 0;
    }
    return 1;
}

// 11. 非法示例（仅注释参考，不要启用）：
//     comptime 上下文禁止访问运行时变量
//     comptime {
//         var runtime_val: u32 = 99;
//         var tmp = runtime_val; // 错误：T_META_READ_RUNTIME
//     }
