{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "t 编译器管线架构",
    "locale": "zh-CN",
    "output": "compiler_pipeline.html",
    "quality_profile": "showcase",
    "animation": "trace",
    "viewBox": [1080, 860],
    "views": [
      { "id": "frontend", "label": "前端管线", "focus": ["tote", "src_file", "std_lib", "ext_lib", "lexer", "parser", "sema"], "note": "tote 驱动编译入口，源码与库经词法、语法、语义三阶段得到类型化 IR。" },
      { "id": "backend", "label": "双后端与链接", "focus": ["sema", "cbe", "llbe", "linker"], "note": "类型化 IR 分别由 C 与 LLVM 后端发射，再经 clang 链接运行时产出可执行程序。" },
      { "id": "orchestration", "label": "构建编排", "focus": ["tote", "src_file", "linker"], "note": "tote 读取 tote.toml 构建入口 src/tc.tc，并串联 gate L0–L2 验证（见下方『构建编排』卡）。" }
    ]
  },
  "stages": [
    { "label": "编排 Orchestration" },
    { "label": "输入 Input" },
    { "label": "前端 Frontend" },
    { "label": "语义分析 Semantic" },
    { "label": "代码生成与链接 Codegen & Link" }
  ],
  "nodes": [
    { "id": "tote", "type": "external", "label": "tote 构建编排", "sublabel": "tote.toml / tote.exe", "stage": 0, "row": 0, "tag": "包管理 + 构建驱动" },
    { "id": "std_lib", "type": "database", "label": "标准库 .tlib", "sublabel": "lib/std", "stage": 1, "row": 0, "tag": "预编译归档" },
    { "id": "src_file", "type": "external", "label": "源文件 .tc", "sublabel": "app.tc", "stage": 1, "row": 1, "tag": ".tc 入口" },
    { "id": "ext_lib", "type": "database", "label": "外部库 .tlib", "sublabel": "链接模式归档", "stage": 1, "row": 2, "tag": "import 解析" },
    { "id": "lexer", "type": "backend", "label": "词法分析 Lexer", "sublabel": "lex.tc", "stage": 2, "row": 0, "tag": "tokenize" },
    { "id": "parser", "type": "backend", "label": "语法分析 Parser", "sublabel": "parse.tc", "stage": 2, "row": 1, "tag": "parse_unit" },
    { "id": "sema", "type": "backend", "label": "语义分析 Sema", "sublabel": "sema.tc", "stage": 3, "row": 0, "tag": "run_check + CTFE" },
    { "id": "cbe", "type": "backend", "label": "C 后端", "sublabel": "codegen_c.tc", "stage": 4, "row": 0, "tag": "compile → .c/.h" },
    { "id": "llbe", "type": "backend", "label": "LLVM 后端", "sublabel": "codegen_ll.tc", "stage": 4, "row": 2, "tag": "emit-ll → .ll" },
    { "id": "linker", "type": "external", "label": "链接器 clang", "sublabel": "链接 t_runtime → .exe", "stage": 4, "row": 1, "tag": "build / run" }
  ],
  "flows": [
    { "id": "f_tote_src", "from": "tote", "to": "src_file", "label": "build entry", "classification": "src/tc.tc", "variant": "emphasis", "route": "auto" },
    { "id": "f_in", "from": "src_file", "to": "lexer", "label": "源码字符流", "classification": "utf-8", "variant": "emphasis", "route": "auto" },
    { "id": "f_lex", "from": "lexer", "to": "parser", "label": "token 流", "classification": "词法单元", "variant": "emphasis", "route": "straight", "labelAt": [535, 215] },
    { "id": "f_parse", "from": "parser", "to": "sema", "label": "AST", "classification": "含前端 lowering", "variant": "emphasis", "route": "auto" },
    { "id": "f_std", "from": "std_lib", "to": "sema", "label": "库接口", "classification": ".tlib", "variant": "default", "route": "top-channel" },
    { "id": "f_ext", "from": "ext_lib", "to": "sema", "label": "归档符号", "classification": ".a 重命名", "variant": "default", "route": "bottom-channel" },
    { "id": "f_c", "from": "sema", "to": "cbe", "label": "类型化 IR", "classification": "TypeInfo/TD", "variant": "emphasis", "route": "straight", "labelDy": -18 },
    { "id": "f_ll", "from": "sema", "to": "llbe", "label": "类型化 IR", "classification": "TypeInfo/TD", "variant": "emphasis", "route": "auto", "labelDy": 18 },
    { "id": "f_cbe", "from": "cbe", "to": "linker", "label": ".c / .h", "classification": "C11 源", "variant": "default", "route": "vertical-channel" },
    { "id": "f_llbe", "from": "llbe", "to": "linker", "label": ".ll", "classification": "LLVM IR", "variant": "default", "route": "vertical-channel" }
  ],
  "cards": [
    { "dot": "violet", "title": "构建编排 (tote)", "items": ["tote.toml 声明入口 src/tc.tc 与依赖", "tote build 驱动 tc 编译入口 → out/<mode>/tc.exe", "tote 串联 gate L0–L2（conformance + examples 双后端对拍）"] },
    { "dot": "amber", "title": "双后端对等", "items": ["C 与 LLVM 后端从同一份类型化 IR 发射", "门禁 cself 步骤要求两者发射的 IR 逐字节一致", "任一后端均可独立产出可执行程序"] },
    { "dot": "emerald", "title": "自举不动点", "items": ["编译器自托管（src/tc.tc 由 tc 自身编译）", "gate L2 的 boot4 验证 g2==g3==g4 IR 逐字节相同", "三件套：boot4 + cself + 跨代/跨后端对拍全绿"] },
    { "dot": "rose", "title": "运行时与库", "items": ["runtime/t_runtime.c 提供 arena / TStr / TSb / TSlice / TMap", "std 库预编译为 .tlib（归档 + 接口块）", "链接模式外部库以重命名 .a 归档交付链接器"] }
  ]
}
