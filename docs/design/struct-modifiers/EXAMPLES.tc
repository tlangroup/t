// ============================================================
// struct-modifiers 设计审查示例（aspirational / 待实现）
// ------------------------------------------------------------
// 用途：供 owner 审查「我对 struct 修饰词体系的理解」是否对齐需求。
// 状态：当前 t 编译器尚未实现 concept / overload struct /
//       extend overload struct / extern 关键字 / #id 注册表，
//       因此本文件**暂不可被现有编译器接受**。
// 实现完成后将搬入 examples/ 并补 .expected.txt 接入 run_examples。
//
// 每段都标注了「理解假设」，凡与你的真实意图不符处，请直接指出。
// ============================================================


// ────────────────────────────────────────────────────────────
// 1) 布局维度（LayoutMod）：用户可见关键字仅 packed / extern；不写 = 默认布局
// ────────────────────────────────────────────────────────────

// 1.1 默认布局（不写任何布局修饰）：内部标签 "auto"（非关键字）。
//     【理解假设·已修订】auto / default 均不是用户可见关键字；不写修饰即默认布局；
//                      编译器可对其内部做布局优化（如重排），但不暴露关键字；
//                      用户可见布局关键字仅 packed / extern。
struct Vec3 {            // 默认布局（不写修饰，内部标签 auto）
    x: f64;
    y: f64;
    z: f64;
}

// 1.3 packed：位域顺序打包 + 占位字段 `_:uN`（现有能力，积类型统一 epic 落地）。
//     【理解假设·已修订】占位走统一字段语法：占位字段 `_:uN`（如 `_:u2`）= 保留 N 位占位，
//                      即「名字写成 _ 的普通字段」，区别于具名字段 `name: uN`；不再使用 `_:N` 裸数字语法。
//                      仅整型、落在宿主整型、读写走位段。
packed struct Perm {
    readable: u1;
    _:u2;                // 占位字段（名字 _ + 类型 u2）保留 2 位（统一字段语法 name:Type）
    writable: u1;
    level:    u4;
    owner_id: u8;
}

// 1.4 extern：C-API 严格 C 规范（标准 C 布局，capi / C FFI 兼容）。**仍有字段体**，可实例化。
//     【理解假设】遵循标准 C struct 布局（声明序=内存序、标准 C 对齐/填充、C 兼容）；
//                由旧 #extern 注解升级为关键字，语义由"冗余标注"升级为"强制 C 规范"。
//     【理解假设·已修订】extern 专用于 C 兼容，不支持 overload/extend（与 overload 互斥）。
extern struct CStat {
    dev:  i32;
    ino:  u64;
    size: i64;
}

// 布局互斥：【理解假设】packed 与 extern 不能同时出现，parser 早期报错。
// 下面这行**应编译报错**（仅为说明互斥，不放入可运行示例）：
//   packed extern struct Bad { a: u8; b: u8; }


// ────────────────────────────────────────────────────────────
// 2) 约束维度（concept，原 duck）：约束类型，不可实例化
// ────────────────────────────────────────────────────────────
// 【理解假设 · 重点审查】
//   (a) concept 是「编译期约束」，不是运行时接口值 —— 没有 vtable、没有动态派发；
//       仅用于泛型边界（类型参数前置 `T:HasName`、其后值参数/返回用 `T`）处的静态"形状校验"（方法签名 + 字段形状）。
//   (b) 满足方式 = 结构化（structural）：具体类型只要拥有匹配的方法与字段即满足，
//       无需显式 impl/declare 声明"我实现了 C"。
//   (c) 字段约束要求"同名同类型字段存在"；方法约束要求"同名同签名方法存在（接收者 self）"。
//   (d) concept 本身不可实例化（不能构造一个 concept 值）；只能作为边界/约束使用。
//   (e) @derive 与 trait 已废弃：concept 是面向未来的约束机制，设计上不与之并列/复用。

concept HasName {
    fn name(self) string;     // 方法约束（仅签名，无函数体）
    age: i64;                 // 字段约束（仅声明，无初值）
}

// 具体类型通过"形状"满足 HasName（结构化，无需声明）。
// 【理解假设】方法名匹配即可，字段不必与概念同名（此处用 name_val + name() 方法满足）。
struct Person {
    name_val: string;
    age:      i64;
    fn name(self) string { return self.name_val; }
}

struct Robot {
    serial: string;
    age:    i64;
    fn name(self) string { return self.serial; }
}

// 用作泛型边界：T 必须满足 HasName（编译期静态校验）。
// 【理解假设·已修订】泛型边界改用「类型参数前置为参数 + concept 约束」语法：
//      fn greet(T:HasName, x: T) —— T 是类型参数、受 HasName 约束；其后值参数 x: T 引用之。
fn greet(T:HasName, x: T) string {
    return "hi " + x.name() + " age=" + int_to_str(x.age);
}

// 下面这行**应编译报错**（U 无 HasName 约束 → greet 内访问 x.name()/x.age() 失败）：
//   fn bad(U, x: U) string { _ = greet(x); }


// ────────────────────────────────────────────────────────────
// 3) 自定义修饰词（#id）：第三方扩展，语义由用户扩展函数处理
// ────────────────────────────────────────────────────────────
// 【理解假设 · 重点审查】
//   (a) #<id> 是"应用一个自定义修饰词"的语法；id 须先注册（内建预注册 /
//       #modifier <id> 声明 / tote 插件），未知 id 编译报错。
//   (b) 编译器本身不解释 #serde 的语义，仅登记"该 struct 被 serde 修饰"，
//       真正语义由用户扩展函数（插件/钩子）消费。
//   (c) 旧 #soa / #aos 保留（属容器布局轴，与成员布局正交）。

#serde                       // 【理解假设】serde 已注册
struct Config {
    host: string;
    port: u16;
}

// 下面这行**应编译报错**（frobnicate 未注册）：
//   #frobnicate struct Ghost { a: u8; }


// ────────────────────────────────────────────────────────────
// 4) 入口（验证 layout / concept 的可运行部分；overload/extend 见配对文件）
// ────────────────────────────────────────────────────────────
fn main_fn() i32 @main {
    // 1) layout 可运行验证
    var v: Vec3  = Vec3  { x: 1.0, y: 2.0, z: 3.0 };
    var c: CStat = CStat { dev: 1, ino: 2, size: 3 };
    println("vec3  ok=" + int_to_str((v.x == 1.0) as i64));
    println("cstat ok=" + int_to_str(((c.dev == 1) && (c.ino == 2) && (c.size == 3)) as i64));

    // 2) concept 可运行验证：Person / Robot 结构化满足 HasName
    var p: Person = Person { name_val: "alice", age: 30 };
    var r: Robot  = Robot  { serial: "R2", age: 2 };
    println(greet(p));
    println(greet(r));

    // 3) #serde 修饰的 struct 照常可用
    var cfg: Config = Config { host: "localhost", port: 8080 };
    println("cfg port=" + int_to_str(cfg.port as i64));

    return 0;
}
