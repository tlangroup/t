// ============================================================
// struct-modifiers 设计审查示例（aspirational / 待实现）—— 跨文件扩展 · 文件 A
// ------------------------------------------------------------
// 配对：EXAMPLES_extend_b.tc
// 编译：二者须在同一编译单元合并编译（模拟：tc build EXAMPLES_extend_a.tc EXAMPLES_extend_b.tc）；
//       单独编译 _b（找不到 overload 组）应报 T-OVL-E980（复用 extend overload fn 既有机判据）。
//
// 用途：供 owner 审查「我对 overload struct / extend overload struct 的理解」是否对齐需求。
// ============================================================

// 仅本审查件内可见的最小 Vec3（真实场景下跨文件同单元共享作用域）。
struct Vec3 {
    x: f64;
    y: f64;
    z: f64;
}

// overload struct：标记 Entity 为「开放可扩展组」。
// 【理解假设】
//   (a) 编译器在字段链尾部合成/保留扩展锚点 `_`；
//   (b) extend overload 追加的字段/方法排在 `_` 之后；
//   (c) 用户可显式写出 `_;` 占位（如本例），也可由编译器自动保证其存在。
overload struct Entity {
    id:  u64;
    pos: Vec3;
    _;               // 尾部扩展锚点（仅为扩展预留，实例化时无需填充）
}

// 同单元内的普通使用方：实例化时无需（也不可）显式填充 `_` 锚点。
fn spawn() Entity {
    return Entity { id: 1, pos: Vec3 { x: 0.0, y: 0.0, z: 0.0 } };
}

// 入口（与 _b 合并后，Entity 还会拥有 tag 字段 + describe 方法）。
fn main_fn() i32 @main {
    var e: Entity = spawn();
    println("entity base id=" + int_to_str(e.id as i64));
    return 0;
}
