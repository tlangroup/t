// ============================================================
// struct-modifiers 设计审查示例（aspirational / 待实现）—— 跨文件扩展 · 文件 A
// ------------------------------------------------------------
// 配对：EXAMPLES_extend_b.tc
// 编译：二者须在同一编译单元合并编译（模拟：tc build EXAMPLES_extend_a.tc EXAMPLES_extend_b.tc）；
//       单独编译 _b（找不到 overload 组）应报 T-OVL-E980（复用 extend fn 既有机判据）。
//
// 用途：供 owner 审查「我对 overload struct / extend struct 的理解」是否对齐需求。
// ============================================================

// 仅本审查件内可见的最小 Vec3（真实场景下跨文件同单元共享作用域）。
struct Vec3 {
    x: f64;
    y: f64;
    z: f64;
}

// overload struct：标记 Entity 为「开放可扩展组」。
// 【机制（2026-10-18 更正）】
//   开放性由 `overload` 关键字独占表达 —— 没有任何「锚点」参与。
//   extend 追加的字段/方法由合并期接到**字段链尾部**保证。
//   ⚠ 旧版本此处写 `_;` 作「扩展锚点」，该写法从不生效（parse 期吞掉、
//     不生成任何 AST 节点），已于 2026-10-18 拆除，写了就是语法错误。
overload struct Entity {
    id:  u64;
    pos: Vec3;
}

// 同单元内的普通使用方：按 base 字段实例化即可（extend 的字段在本单元可见、可选填）。
fn spawn() Entity {
    return Entity { id: 1, pos: Vec3 { x: 0.0, y: 0.0, z: 0.0 } };
}

// 入口（与 _b 合并后，Entity 还会拥有 tag 字段 + describe 方法）。
fn main_fn() i32 @main {
    var e: Entity = spawn();
    println("entity base id=" + int_to_str(e.id as i64));
    return 0;
}
