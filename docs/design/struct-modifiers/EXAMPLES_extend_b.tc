// ============================================================
// struct-modifiers 设计审查示例（aspirational / 待实现）—— 跨文件扩展 · 文件 B
// ------------------------------------------------------------
// 配对：EXAMPLES_extend_a.tc
// 编译：必须与 _a 同编译单元合并才合法；单独编译本文件应报 T-OVL-E980。
//
// 用途：演示「向 overload struct 跨模块追加字段 + 方法」。
// ============================================================

// extend overload struct：向 _a 中声明的 overload 组 Entity 追加成员。
// 【理解假设】
//   (a) 语法复用函数侧的 `extend overload` 桥（见 src/parse.tc 的 extend→overload 桥）；
//   (b) 追加的字段（tag）与方法（describe）排在 `_` 锚点之后；
//   (c) 跨模块扩展同样产出 tote extend 边（契合 tote「extend-time 派生变体」不变式）。
extend overload struct Entity {
    tag: u32;
    fn describe(self) string {
        return "entity#" + int_to_str(self.id as i64)
             + " tag="   + int_to_str(self.tag as i64);
    }
}

// 合并后 Entity 形态：id, pos, _, tag, + describe(self)
// 使用方可在同单元任意文件调用扩展出来的字段/方法：
fn use_extended() string {
    var e: Entity = Entity { id: 7, pos: Vec3 { x: 1.0, y: 2.0, z: 3.0 } };
    e.tag = 99;                  // 来自 extend 的字段（排在 `_` 之后）
    return e.describe();         // 来自 extend 的方法
}
