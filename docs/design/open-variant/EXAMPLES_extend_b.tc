// 开放变体 · 跨文件扩展 · 文件 B（extend 片段；单独编译应报 T-OVL-E980）
//
// 配对：docs/design/open-variant/EXAMPLES_extend_a.tc
// 落点（阶段三）：examples/cross/open_variant_b.tc
// 单独编译本文件 ⇒ 找不到 overload 组 ⇒ T-OVL-E980（与 f_struct_extend_no_group.tc 同口径）。

// 向 A 中声明的开放组 Node 追加一个构造器。
// 合并后 Node 全集：Int(i64) | Add(*Node,*Node) | Wheel(i64)
extend variant Node {
    Wheel(i64);
}

fn use_extended() i64 {
    var w: Node = Node { .Wheel(-2) };
    println("new case: Wheel(" + int_to_str(Node_as_Wheel(w)) + ")");
    return 0;
}
