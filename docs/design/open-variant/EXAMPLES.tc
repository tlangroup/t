// 开放变体（open variant）· 设计阶段示意代码
//
// ⚠ 本文件仅供设计评审判断「是否达成目的」——语法尚未实现，不可编译。
//   阶段三落地后，本文件的语义会被搬入 examples/ 与 tests/conformance/。
//   设计文档：docs/design/open-variant/DESIGN.md
//
// 期望输出（实现后运行）：
//   key=65
//   click 3,4
//   wheel=-1
//   resize 800 true
//   drawn

// ── ① 库侧：声明为「开放组」 ───────────────────────────────
// overload = 允许后续 extend 追加构造器；此处**不需要** struct 那样的 `_` 锚点
// （variant 的 `_` 另有语义：抽象/非穷尽）。
overload variant Event {
    Key(i64);
    Click(i64, i64);
}

// ── ② 使用方 A：追加一个单元载荷构造器 ─────────────────────
extend variant Event {
    Wheel(i64);
}

// ── ③ 使用方 B：可以有多处 extend，各自追加 ────────────────
extend variant Event {
    Resize(i64, bool);      // 多载荷 case 同样支持
}

// ── ④ 合并后 Event 的 case 全集 ────────────────────────────
//   Key(i64) | Click(i64,i64) | Wheel(i64) | Resize(i64,bool)
//   tag 按合并后的最终顺序连续编号为 0..3（决策 D2）
//
// match 仍要求穷尽（决策 D5）：漏列 Wheel / Resize 依然报 T-MAT-E742。
// 小工具：bool → 文本（仓库暂无内建 bool_to_str）
fn flag(b: bool) string {
    if (b) { return "true"; }
    return "false";
}

fn describe(e: Event) string {
    return match (e) {
        .Key(k)         => "key=" + int_to_str(k)
        .Click(x, y)    => "click " + int_to_str(x) + "," + int_to_str(y)
        .Wheel(d)       => "wheel=" + int_to_str(d)
        .Resize(w, keep) => "resize " + int_to_str(w) + " " + flag(keep)
    };
}

@main
fn main() i64 {
    println(describe(Event { .Key(65) }));
    println(describe(Event { .Click(3, 4) }));
    println(describe(Event { .Wheel(-1) }));
    println(describe(Event { .Resize(800, true) }));

    // 合并后的 case 也可通过合成 helper 直接使用（现状机制自动延伸到新 case）
    var w: Event = Event_from_Wheel(7);
    if (Event_is_Wheel(w)) { println("drawn"); }
    return 0;
}
