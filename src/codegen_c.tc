            if (td_is_func(lftd)) {
                return tdf_ret[lftd];
            }
            var rt: i64 = tm_get(sb_cat2(cn, "()"));
            if (rt >= 0) {
                return rt;
            }
            var gftd: i64 = tm_get(mb_sub(cn));
            if (td_is_func(gftd)) {
                return tdf_ret[gftd];
            }
            return td_mk("unknown");
        }
        // callee 是任意表达式（结构体字段 / 数组元素 / 调用结果…）：按其静态类型取返回类型
        var xftd: i64 = expr_type_desc(n.na);
        if (td_is_func(xftd)) {
            return tdf_ret[xftd];
        }
        return td_mk("unknown");
    }
    if (n.kind == "binary") {
        var op: string = n.sa;
        if (op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=" || op == "&&" || op == "||") {
            return td_named_mk("scalar", "bool");
        }
        return expr_type_desc(n.na);
    }
    if (n.kind == "member") {
        // `Enum.Member` / `Flag.slot`：对象是类型名而非值，类型即底层整型
        var mo0: Node = nodes[n.na];
        if (mo0.kind == "ident") {
            var mdi0: i64 = mb_type_decl(mo0.sa);
            if (mdi0 >= 0) {
                var mdn0: Node = nodes[mdi0];
                if (mdn0.kind == "EnumDecl" || mdn0.kind == "FlagDecl") {
                    return td_named_mk("scalar", mdn0.sb);
                }
            }
        }
        var od2: i64 = expr_type_desc(n.na);
        var ot2: TD = tds[od2];
        if (ot2.cat == "named" && ot2.name != "") {
            var fd: i64 = sf_get(ot2.name, n.sa);
            if (fd >= 0) {
                return fd;
            }
        }
        return td_mk("unknown");
    }
    return td_mk("unknown");
}

// ── collectLocalTypes（复刻 emitter.ts collectLocalTypes）──────

collect_local_types fn(head: i64) void {
    if (head < -1) {
        return;
    }
    var c: i64 = head;
    while (c >= 0) {
        var k: Child = kids[c];
        var n: Node = nodes[k.val];
        if (n.kind == "var_decl") {
            if (n.na >= 0) {
                fs_set(em_cur_fn, n.sa, resolve_type_desc(n.na));
            }
        }
        // 闭包体首重建的捕获变量（M48）：与普通局部同权，须登记类型
        if (n.kind == "closure_capture") {
            if (n.na >= 0) {
                fs_set(em_cur_fn, n.sa, resolve_type_desc(n.na));
            }
        }
        if (n.kind == "if") {
            collect_local_types(n.la);
            if (n.lb > -2) {
                collect_local_types(n.lb);
            }
        }
        if (n.kind == "while" || n.kind == "block") {
            collect_local_types(n.la);
        }
        if (n.kind == "for") {
            if (n.na >= 0) {
                var ini: Node = nodes[n.na];
                if (ini.kind == "var_decl") {
                    if (ini.na >= 0) {
                        fs_set(em_cur_fn, ini.sa, resolve_type_desc(ini.na));
                    }
                }
            }
            collect_local_types(n.la);
        }
        if (n.kind == "for_each") {
            var it: i64 = expr_type_desc(n.na);
            var itd: TD = tds[it];
            if (itd.cat == "slice" && itd.elem >= 0) {
                fs_set(em_cur_fn, n.sa, itd.elem);
            }
            if (itd.cat == "map" && itd.key >= 0) {
                fs_set(em_cur_fn, n.sa, itd.key);
                if (str_len(n.sb) > 0 && itd.val >= 0) {
                    fs_set(em_cur_fn, n.sb, itd.val);
                }
            }
            collect_local_types(n.la);
        }
        c = k.next;
    }
}

// ── buildTypeMap（复刻 emitter.ts buildTypeMap）────────────────

// 具名函数的「函数类型」TD。用于「函数作为值」的类型推断：
//   var f = add;                  // 无类型标注
//   var g = fn(a: i64) i64 {}  // 提升后同样是裸函数名
// 没有它，expr_type_desc 会对函数名返回 unknown，导致 var_decl 发射出错误的 C 类型。
funcdecl_td fn(rt_node: i64, params_head: i64) i64 {
    var rtd: i64 = resolve_type_desc(rt_node);
    var buf: []i64;
    var c: i64 = params_head;
    while (c >= 0) {
        var k: Child = kids[c];
        var p: Node = nodes[k.val];
        append(buf, resolve_type_desc(p.na));
        c = k.next;
    }
    // 先收局部表再整段搬入扁平池：嵌套函数类型解析会递归 append，
    // 直接边解析边 append 会打断本层参数区的连续性。
    var ps: i64 = slice_len(tdf_params) as i64;
    var pc: i64 = slice_len(buf) as i64;
    var i: i64 = 0;
    while (i < pc) {
        append(tdf_params, buf[i]);
        i = i + 1;
    }
    return td_func(rtd, ps, pc);
}

build_type_map fn() void {
    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = decl_list[i];
        var dn: Node = nodes[d];
        if (dn.kind == "StructDecl") {
            var fc: i64 = dn.lb;
            while (fc >= 0) {
                var fk: Child = kids[fc];
                var f: Node = nodes[fk.val];
                if (f.na >= 0) {
                    sf_set(dn.sa, f.sa, resolve_type_desc(f.na));
                }
                fc = fk.next;
            }
        }
        if (dn.kind == "GlobalVarDecl" || dn.kind == "GlobalConstDecl") {
            if (dn.na >= 0) {
                tm_set(dn.sa, resolve_type_desc(dn.na));
            }
        }
        if (dn.kind == "FuncDecl") {
            if (dn.na >= 0) {
                tm_set(sb_cat2(dn.sa, "()"), resolve_type_desc(dn.na));
            }
            // 裸函数名 → 函数类型（函数作为值）。局部变量优先级更高，不会被遮蔽。
            tm_set(dn.sa, funcdecl_td(dn.na, dn.lb));
            em_cur_fn = dn.sa;
            em_in_fn = true;
            var pc: i64 = dn.lb;
            while (pc >= 0) {
                var pk: Child = kids[pc];
                var p: Node = nodes[pk.val];
                if (p.na >= 0) {
                    fs_set(dn.sa, p.sa, resolve_type_desc(p.na));
                }
                pc = pk.next;
            }
            if (dn.lc > -2) {
                collect_local_types(dn.lc);
            }
            em_in_fn = false;
            em_cur_fn = "";
        }
        i = i + 1;
    }
}

// ── C 字符串转义（复刻 emitter.ts escapeCString）───────────────

esc_c fn(s: string) string {
    var sb: StringBuilder = sb_new();
    var i: u64 = 0;
    var n: u64 = str_len(s);
    while (i < n) {
        var c: u8 = s[i];
        if (c == 92) {
            sb_append_str(sb, "\\\\");
        } else {
        if (c == 34) {
            sb_append_str(sb, "\\\"");
        } else {
        if (c == 10) {
            sb_append_str(sb, "\\n");
        } else {
        if (c == 13) {
            sb_append_str(sb, "\\r");
        } else {
        if (c == 9) {
            sb_append_str(sb, "\\t");
        } else {
        if (c == 0) {
            sb_append_str(sb, "\\0");
        } else {
            sb_append_char(sb, c);
        }}}}}}
        i = i + 1;
    }
    return sb_to_str(sb);
}

// ── 缩进 ───────────────────────────────────────────────────────

mk_pad fn(indent: i64) string {
    var sb: StringBuilder = sb_new();
    var i: i64 = 0;
    while (i < indent) {
        sb_append_str(sb, "    ");
        i = i + 1;
    }
    return sb_to_str(sb);
}

// ── emitExpr（复刻 emitter.ts emitExpr）────────────────────────


// map 键取地址（C 后端）：整型键统一提升为 int64_t 存储——runtime 按 int64_t 读键，
// 直接对 i32/u8 变量取址会让高位字节变成垃圾（M30 前的静默失配）。用 C99 复合字面量，
// 顺带允许键写成字面量或表达式。string 键是 TStr 聚合，仍取原表达式地址。
c_map_keyp fn(mn: i64, kn: i64) string {
    var ktd9: i64 = -1;
    var mtd9: i64 = expr_type_desc(mn);
    if (mtd9 >= 0) {
        var mt9: TD = tds[mtd9];
        ktd9 = mt9.key;
    }
    if (ktd9 >= 0 && tds[ktd9].cat != "scalar") {
        return sb_cat2("&", emit_expr(kn));
    }
    return sb_cat3("&(int64_t){(int64_t)(", emit_expr(kn), ")}");
}

// map 值取地址（C 后端）：标量值按声明的 V 落进复合字面量（宽度对齐 val_size，
// 且允许值写成字面量）；聚合值取原表达式地址。
c_map_valp fn(mn: i64, vn: i64) string {
    var vtd8: i64 = -1;
    var mtd8: i64 = expr_type_desc(mn);
    if (mtd8 >= 0) {
        var mt8: TD = tds[mtd8];
        vtd8 = mt8.val;
    }
    if (vtd8 < 0 || tds[vtd8].cat != "scalar") {
        return sb_cat2("&", emit_expr(vn));
    }
    var vc8: string = desc_to_c(vtd8);
    return sb_cat6("&(", vc8, "){(", vc8, ")(", sb_cat2(emit_expr(vn), ")}"));
}

c_map_get fn(mn: i64, kn: i64) string {
    var mtd: i64 = expr_type_desc(mn);
    var mt: TD = tds[mtd];
    var valc: string = desc_to_c(mt.val);
    var mstr: string = emit_expr(mn);
    var kstr: string = c_map_keyp(mn, kn);
    return sb_cat6("(*(", valc, "*)t_map_val_ptr(", mstr, ", ", sb_cat2(kstr, "))"));
}

// map 索引写时求 LHS 的 TMap* 基指针：
// 单层 m[k] → m（变量本身即 TMap*）；嵌套 deep[a][x] → deep[a] 求内层 TMap* 值。
// 用于 t_map_put 的第一个实参。
c_map_lhs_ptr fn(nd: i64) string {
    var n1: Node = nodes[nd];
    if (n1.kind == "index") {
        var btd: i64 = expr_type_desc(nd);
        if (btd >= 0 && tds[btd].cat == "map") {
            // 嵌套：base 是 m[k] 本身也是 map，求内层 TMap* 值（t_map_val_ptr 返回槽指针，解引用得 TMap*）
            var base: string = emit_expr(n1.na);
            var key: string = c_map_keyp(nd, n1.nb);
            return sb_cat6("(*(TMap**)", "t_map_val_ptr(", base, ", ", key, "))");
        }
    }
    return emit_expr(nd);
}

// map 字面量作为表达式（调用实参 / 返回值 / 嵌套值 / 赋值右值）时，
// 建临时 TMap* 变量并逐项 put，返回该变量名。pad 为缩进（表达式场景通常为 ""）。
var g_map_lit_cnt: i64 = 0;
var g_match_cnt: i64 = 0;      // match 表达式序号（结果/被匹配值临时量命名）
var g_clos_cnt: i64 = 0;       // 闭包构造序号（环境/闭包临时量命名，M48）
var g_stmt_pad: string = "";   // 当前语句缩进（map 字面量作表达式时对齐用）
var g_defer: [1024]i64;         // defer 延迟栈（节点索引），函数级、LIFO 于 return/函数尾运行
var g_defer_n: i64 = 0;         // g_defer 栈顶计数



c_emit_map_lit fn(en: i64, mname: string, pad: string, keytd: i64, valtd: i64) void {
    var mlkk: i64 = 0;
    if (tds[keytd].cat != "string") { mlkk = 1; }
    var mlkc: string = desc_to_c(keytd);
    var mlvc: string = desc_to_c(valtd);
    spush(sb_cat5(pad, "TMap* ", mname, " = t_map_new(t_arena_current(), ", sb_cat3(i2s(mlkk), ", (int64_t)sizeof(", sb_cat2(mlvc, "));"))));
    var mlkx: string = "";
    if (tds[keytd].cat == "scalar") {
        mlkc = "int64_t";
        mlkx = "(int64_t)";
    }
    var mlvx: string = "";
    if (tds[valtd].cat == "scalar") {
        mlvx = sb_cat3("(", mlvc, ")");
    }
    var mlnode: Node = nodes[en];
    var mlc: i64 = mlnode.la;
    var mlix: i64 = 0;
    while (mlc >= 0) {
        var mlck: Child = kids[mlc];
        var mlen: Node = nodes[mlck.val];
        var mlkn: string = sb_cat4("_ml_", mname, "k", i2s(mlix));
        var mlvn: string = sb_cat4("_ml_", mname, "v", i2s(mlix));
        spush(sb_cat6(pad, mlkc, " ", mlkn, sb_cat3(" = ", mlkx, emit_expr(mlen.na)), ";"));
        spush(sb_cat6(pad, mlvc, " ", mlvn, sb_cat3(" = ", mlvx, emit_expr(mlen.nb)), ";"));
        spush(sb_cat6(pad, "t_map_put(", mname, ", &", mlkn, sb_cat3(", &", mlvn, ");")));
        mlix = mlix + 1;
        mlc = mlck.next;
    }
}

// ── match 脱糖（L-15 / match.md §2「函数子句为 match 语法糖」同一机制）──
// 由 arm 链表递归合成 if/else 语句链，交给既有 emit_stmt / emit_llstmt 发射：
//   arm 体      → `<rname> = <body>;`（expr 语句包 assign 节点）
//   等值模式    → `<sname> == <pat>`
//   when 守卫   → 与等值模式 `&&` 合取；仅有守卫时即为条件本身
//   不可反驳 arm（`_` / 裸绑定且无守卫）→ 作为 else 体，其后 arm 不可达
// 返回语句链表头；-2 表示无（对应 mk_if 的「无 else」约定）。
match_chain_from fn(c: i64, rname: string, sname: string) i64 {
    if (c < 0) {
        return -2;
    }
    var mc_k: Child = kids[c];
    var mc_an: Node = nodes[mc_k.val];
    var mc_asg: i64 = mk_expr(mk_assign("=", mk_ident(rname, -1), mc_an.nc, -1), -1);
    var mc_body: i64 = list_push(-1, -1, mc_asg);
    var mc_cond: i64 = -1;
    if (mc_an.na >= 0) {
        // 范围模式 `1..5` / `1..=5` / `'a'..='z'`：等值比较换成区间成员测试。
        // 被匹配值此刻已绑在临时量 sname 上，重复引用零代价、零副作用。
        if (nodes[mc_an.na].kind == "range") {
            mc_cond = mk_range_test(mk_ident(sname, -1), mk_ident(sname, -1), mc_an.na);
        } else {
            mc_cond = mk_binary("==", mk_ident(sname, -1), mc_an.na, -1);
        }
    }
    if (mc_an.nb >= 0) {
        if (mc_cond < 0) {
            mc_cond = mc_an.nb;
        } else {
            mc_cond = mk_binary("&&", mc_cond, mc_an.nb, -1);
        }
    }
    if (mc_cond < 0) {
        return mc_body;
    }
    var mc_rest: i64 = match_chain_from(mc_k.next, rname, sname);
    var mc_if: i64 = mk_if(mc_cond, mc_body, mc_rest, -1);
    return list_push(-1, -1, mc_if);
}

// 把该 match 所有 arm 的绑定名压入替换栈，返回压入个数（供 mb_drop 配对弹出）
match_bind_push fn(e: i64, no: i64) i64 {
    var mb_n2: i64 = 0;
    var mb_c: i64 = nodes[e].la;
    while (mb_c >= 0) {
        var mb_k: Child = kids[mb_c];
        var mb_an: Node = nodes[mb_k.val];
        if (str_len(mb_an.sa) > 0) {
            mb_push(mb_k.val, no);
            mb_n2 = mb_n2 + 1;
        }
        mb_c = mb_k.next;
    }
    return mb_n2;
}

// 首个 arm 的体表达式（match 结果类型以其为准）
match_first_body fn(e: i64) i64 {
    var mf_c: i64 = nodes[e].la;
    if (mf_c < 0) {
        return -1;
    }
    var mf_k: Child = kids[mf_c];
    return nodes[mf_k.val].nc;
}

// 切片元素的 C 类型名。append / slice_set 的元素宽度必须取自**切片**，
// 不能用 `sizeof(<实参表达式>)`：`append(xs, -1)` 的 sizeof 是 sizeof(int)==4，
// 对 []i64 只会写入半个元素（静默错编）。
c_elem_ctype fn(slice_expr: i64) string {
    if (slice_expr >= 0) {
        var ce_d: i64 = expr_type_desc(slice_expr);
        if (ce_d >= 0) {
            var ce_t: TD = tds[ce_d];
            if (ce_t.elem >= 0) {
                return desc_to_c(ce_t.elem);
            }
        }
    }
    return "int64_t";
}

// ── fid 打开方式 / 格式的编译期编码（M51，双后端共用）─────────
// mode / kind / fmt 形参已由 check_atom_arg 保证是白名单内的 atom 字面量，
// 故发射期直接降为小整数码，运行时不必反查 atom 名表（也就不依赖名表内容）。
fid_code_of fn(sel: string, v: string) i64 {
    if (sel == "mode") {
        if (v == "read") { return 0; }
        if (v == "write") { return 1; }
        if (v == "append") { return 2; }
        if (v == "read_binary") { return 3; }
        if (v == "write_binary") { return 4; }
        return 5;
    }
    if (sel == "kind") {
        if (v == "text") { return 0; }
        return 1;
    }
    if (v == "text") { return 0; }
    if (v == "json") { return 1; }
    if (v == "rawbin") { return 2; }
    return 3;
}

fid_arg_code fn(a: i64, sel: string) string {
    if (a < 0) {
        return "0";
    }
    var fan: Node = nodes[a];
    return i2s(fid_code_of(sel, fan.sa));
}

// fid_format 返回 atom：运行时只知道格式码，atom id 作为**实参**传下去，
// 无需全局预注册、不扰动既有 id 分配。
// 入表动作在检查期由 fid_intern_fmt_atoms 完成（LLVM 的 @t_atom_table 先于函数体发射）；
// 这里的 atom_intern 是幂等查表，只负责取回已分配的 id。
fid_fmt_atom_args fn() string {
    var a0: string = i2s(atom_intern("text"));
    var a1: string = i2s(atom_intern("json"));
    var a2: string = i2s(atom_intern("rawbin"));
    var a3: string = i2s(atom_intern("protobuf"));
    return sb_cat6(a0, ", ", a1, ", ", a2, sb_cat2(", ", a3));
}

// 同上，LLVM 调用点形态（每个实参都要带类型前缀）
ll_fmt_atom_args fn() string {
    var b0: string = i2s(atom_intern("text"));
    var b1: string = i2s(atom_intern("json"));
    var b2: string = i2s(atom_intern("rawbin"));
    var b3: string = i2s(atom_intern("protobuf"));
    return sb_cat6(b0, ", i64 ", b1, ", i64 ", b2, sb_cat3(", i64 ", b3, ")"));
}

// ── 序列化值分派（M51，双后端共用判定）───────────────────────
// 返回选择子："str" | "atom" | "bool" | "f" | "i"。位宽/符号另由 ll_bits/ll_signed 取，
// 因为 rawbin 格式要按静态位宽写定长小端字节 —— 判定必须编译期完成。
ser_sel fn(td: i64) string {
    if (td < 0) {
        return "i";
    }
    var t: TD = tds[td];
    if (t.cat == "string") {
        return "str";
    }
    var sn: string = td_sname(td);
    if (sn == "atom") {
        return "atom";
    }
    if (sn == "bool") {
        return "bool";
    }
    if (sn == "f16" || sn == "f32" || sn == "f64") {
        return "f";
    }
    return "i";
}

// ── 反序列化（读路径，M52 读路径，Option B）：`fid > Type` 的右操作数是「类型」──
// 把右操作数（类型表达式节点）解析为 TD，并判定读路径是否支持该类型。





emit_expr fn(e: i64) string {
    if (e < 0) {
        return "";
    }
    var n: Node = nodes[e];

    if (n.kind == "int") {
        if (n.ia == 16) {
            return n.sa;
        }
        if (n.ia == 2) {
            // value.replace(/^0b/i, "") 再加 0b 前缀
            var v: string = n.sa;
            var body: string = v;
            if (str_len(v) >= 2) {
                if (v[0] == 48 && (v[1] == 98 || v[1] == 66)) {
                    body = str_slice(v, 2, str_len(v));
                }
            }
            return sb_cat2("0b", body);
        }
        if (n.ia == 8) {
            // t 写作 0o755，C 的八进制前缀是单个 0
            var ov: string = n.sa;
            var obody: string = ov;
            if (str_len(ov) >= 2) {
                if (ov[0] == 48 && (ov[1] == 111 || ov[1] == 79)) {
                    obody = str_slice(ov, 2, str_len(ov));
                }
            }
            return sb_cat2("0", obody);
        }
        return n.sa;
    }
    if (n.kind == "atom") {
        if (n.ia <= 0) { n.ia = atom_intern(n.sa); slice_set(nodes, e, n); }
        return i2s(n.ia);
    }
    // 内建 fid 常量（M51）：编译期常量 0/1/2，无运行时查找
    if (n.kind == "fidconst") {
        return i2s(n.ia);
    }
    // 序列化操作符（M51）：t_ser_* 一律**返回目标 fid**，故链式 `f < a < b`
    // 直接落成嵌套调用 t_ser_x(t_ser_y(f, a), b)，无需临时量。
    if (n.kind == "serialize") {
        var sfid: string = emit_expr(n.na);
        var sval: string = emit_expr(n.nb);
        var std2: i64 = expr_type_desc(n.nb);
        var ssel: string = ser_sel(std2);
        if (ssel == "str") { return sb_cat5("t_ser_str(", sfid, ", ", sval, ")"); }
        if (ssel == "atom") { return sb_cat5("t_ser_atom(", sfid, ", ", sval, ")"); }
        if (ssel == "bool") { return sb_cat5("t_ser_bool(", sfid, ", ", sval, ")"); }
        var sbits: string = i2s(ll_bits(td_sname(std2)));
        if (ssel == "f") {
            return sb_cat6("t_ser_f64(", sfid, ", ", sval, ", ", sb_cat2(sbits, ")"));
        }
        var ssgn: string = "0";
        if (ll_signed(td_sname(std2))) { ssgn = "1"; }
        return sb_cat6("t_ser_int(", sfid, ", ", sval, ", ", sb_cat4(sbits, ", ", ssgn, ")"));
    }
    // 反序列化（M52 读路径）：t_deser_* 返回裸 T 值；EOF/错误返默认值，调用方用 fid_eof 探测
    if (n.kind == "deserialize") {
        var dfid: string = emit_expr(n.na);
        var dtd: i64 = deser_type_of(n.nb);
        var dsel: string = ser_sel(dtd);
        if (dsel == "str") { return sb_cat3("t_deser_str(", dfid, ")"); }
        if (dsel == "atom") { return sb_cat3("t_deser_atom(", dfid, ")"); }
        if (dsel == "bool") { return sb_cat3("t_deser_bool(", dfid, ")"); }
        var dbits: string = i2s(get_bw(td_sname(dtd)));
        if (dsel == "f") {
            return sb_cat5("t_deser_f64(", dfid, ", ", dbits, ")");
        }
        var dsgn: string = "0";
        if (ll_signed(td_sname(dtd))) { dsgn = "1"; }
        return sb_cat6("t_deser_int(", dfid, ", ", dbits, ", ", sb_cat2(dsgn, ")"));
    }
    if (n.kind == "float") {
        // IEEE-754 特殊值：走编译器内建而非 <math.h> 的 INFINITY / NAN。
        // 引入 math.h 会把 `yn` / `y0` / `j1` / `gamma` 等 libc 名字灌进
        // 每个翻译单元，与用户函数撞名（examples/fid_error_demo.tc 的 `yn`
        // 就是实例）。内建无需头文件，clang / gcc 均支持，且 C 后端本就只
        // 面向 clang。
        if (n.sa == "inf") { return "__builtin_inf()"; }
        if (n.sa == "nan") { return "__builtin_nan(\"\")"; }
        return n.sa;
    }
    if (n.kind == "string") {
        return sb_cat3("TSTR_LIT(\"", esc_c(n.sa), "\")");
    }
    if (n.kind == "typeinfo") {
        return emit_type_info_c(n.sa);
    }
    if (n.kind == "bool") {
        if (n.ba) {
            return "true";
        }
        return "false";
    }
    if (n.kind == "null") {
        return "NULL";
    }
    if (n.kind == "ident") {
        var idn: string = mb_sub(n.sa);
        // 顶层具名函数出现在**值位置** → 取其闭包全局的地址（FuncType v2 / M47）。
        // 直接调用的 callee 不经此分支（call 分支直接读 cal.sa），故凡是走到这里
        // 且解析到 FuncDecl 的标识符，必然是「函数作为值」。局部/参数同名时局部优先。
        if (em_in_fn == false || fs_get(em_cur_fn, idn) < 0) {
            if (clos_decl_of(idn) >= 0) {
                clos_mark(idn);
                return sb_cat3("(&__tclos_", idn, ")");
            }
        }
        return idn;
    }
    // 闭包构造（M48）：堆分配环境 → 按值拷入捕获量 → 堆分配 TClosure → 返回其指针。
    // 借 map 字面量同款「前置语句 + 临时量」机制，故可出现在任意表达式位置。
    if (n.kind == "closure_make") {
        g_clos_cnt = g_clos_cnt + 1;
        var cm_pad: string = g_stmt_pad;
        var cm_e: string = sb_cat2("_tcloe", i2s(g_clos_cnt));
        var cm_c: string = sb_cat2("_tclo", i2s(g_clos_cnt));
        var cm_ep: string = sb_cat2(n.sb, "*");
        spush(sb_cat6(cm_pad, cm_ep, " ", cm_e, sb_cat4(" = (", cm_ep, ")t_alloc(sizeof(", n.sb), "));"));
        var cm_ch: i64 = n.la;
        while (cm_ch >= 0) {
            var cm_k: Child = kids[cm_ch];
            var cm_f: Node = nodes[cm_k.val];
            var cm_v: string = emit_expr(cm_k.val);
            spush(sb_cat6(cm_pad, cm_e, "->", cm_f.sa, " = ", sb_cat2(cm_v, ";")));
            cm_ch = cm_k.next;
        }
        spush(sb_cat6(cm_pad, "TClosure* ", cm_c, " = (TClosure*)t_alloc(sizeof(TClosure));", "", ""));
        spush(sb_cat6(cm_pad, cm_c, "->fn = (void*)", n.sa, ";", ""));
        spush(sb_cat6(cm_pad, cm_c, "->env = (void*)", cm_e, ";", ""));
        fs_set(em_cur_fn, cm_c, expr_type_desc(e));
        g_stmt_pad = cm_pad;
        return cm_c;
    }
    if (n.kind == "map_lit") {
        g_map_lit_cnt = g_map_lit_cnt + 1;
        var mname: string = sb_cat2("_tmlit", i2s(g_map_lit_cnt));
        var mti: i64 = infer_expr(e);
        var mt: TI = tis[mti];
        var keytd: i64 = ti_to_td(mt.key);
        var valtd: i64 = ti_to_td(mt.val);
        c_emit_map_lit(e, mname, g_stmt_pad, keytd, valtd);
        return mname;
    }
    // match 表达式（L-15）：提升为「结果临时量 + if/else 链」，返回临时量名
    if (n.kind == "match") {
        g_match_cnt = g_match_cnt + 1;
        var mq_no: i64 = g_match_cnt;
        var mq_pad: string = g_stmt_pad;
        var mq_rn: string = sb_cat2("_tmr", i2s(mq_no));
        var mq_sn: string = sb_cat2("_tms", i2s(mq_no));
        var mq_std: i64 = expr_type_desc(n.na);
        fs_set(em_cur_fn, mq_sn, mq_std);
        var mq_sv: string = emit_expr(n.na);
        var mq_pushed: i64 = match_bind_push(e, mq_no);
        var mq_rtd: i64 = expr_type_desc(match_first_body(e));
        fs_set(em_cur_fn, mq_rn, mq_rtd);
        spush(sb_cat4(mq_pad, desc_to_c(mq_rtd), " ", sb_cat2(mq_rn, ";")));
        spush(sb_cat6(mq_pad, desc_to_c(mq_std), " ", mq_sn, " = ", sb_cat2(mq_sv, ";")));
        var mq_ind: i64 = (str_len(mq_pad) as i64) / 4;
        var mq_s: i64 = match_chain_from(n.la, mq_rn, mq_sn);
        while (mq_s >= 0) {
            var mq_sk: Child = kids[mq_s];
            emit_stmt(mq_sk.val, mq_ind);
            mq_s = mq_sk.next;
        }
        mb_drop(mq_pushed);
        g_stmt_pad = mq_pad;
        return mq_rn;
    }
    if (n.kind == "binary") {
        var op: string = n.sa;
        if (op == "==" || op == "!=") {
            var lt: i64 = expr_type_desc(n.na);
            var rt: i64 = expr_type_desc(n.nb);
            var ltc: TD = tds[lt];
            var rtc: TD = tds[rt];
            if (ltc.cat == "string" || rtc.cat == "string") {
                var cmp: string = sb_cat5("t_str_eq(", emit_expr(n.na), ", ", emit_expr(n.nb), ")");
                if (op == "==") {
                    return cmp;
                }
                return sb_cat3("(!", cmp, ")");
            }
        }
        return sb_cat6("(", emit_expr(n.na), " ", op, " ", sb_cat2(emit_expr(n.nb), ")"));
    }
    if (n.kind == "unary") {
        return sb_cat4("(", n.sa, emit_expr(n.na), ")");
    }
    if (n.kind == "assign") {
        // m[k] = v : map 索引写须走 t_map_put（find-or-insert），不能对读值再存回
        if (n.sa == "=") {
            var lnode: Node = nodes[n.na];
            if (lnode.kind == "index") {
                var lotd: i64 = expr_type_desc(lnode.na);
                if (lotd >= 0 && tds[lotd].cat == "map") {
                    var mptr: string = c_map_lhs_ptr(lnode.na);
                    return sb_cat6("t_map_put(", mptr, ", ", c_map_keyp(lnode.na, lnode.nb), ", ", sb_cat2(c_map_valp(lnode.na, n.nb), ")"));
                }
            }
            // Sym = string : 自动 intern（LHS 存 id）；Sym = Sym（同池）走普通 id 拷贝
            var lhtd: i64 = expr_type_desc(n.na);
            if (lhtd >= 0 && tds[lhtd].cat == "sym") {
                var rhtd: i64 = expr_type_desc(n.nb);
                if (rhtd >= 0 && tds[rhtd].cat == "string") {
                    var stg: TD = tds[lhtd];
                    var tagl: string = sb_cat3("TSTR_LIT(\"", esc_c(stg.name), "\")");
                    var intr: string = sb_cat6("t_sym_intern(", tagl, ", ", emit_expr(n.nb), ", ", sb_cat2(i2s(stg.alen), ")"));
                    return sb_cat5("(", emit_expr(n.na), " = ", intr, ")");
                }
            }
        }
        return sb_cat6("(", emit_expr(n.na), " ", n.sa, " ", sb_cat2(emit_expr(n.nb), ")"));
    }
    if (n.kind == "call") {
        var cal: Node = nodes[n.na];
        if (cal.kind == "ident") {
            var cn: string = cal.sa;
            // 收集参数
            var av: []string;
            var c: i64 = n.la;
            while (c >= 0) {
                var k: Child = kids[c];
                var one_arg: string = emit_expr(k.val);
                append(av, one_arg);
                c = k.next;
            }
            var argc: i64 = slice_len(av) as i64;
            if (cn == "str_len") { return sb_cat3("t_str_len(", av[0], ")"); }
            if (cn == "str_at") { return sb_cat5("t_str_byte_at(", av[0], ", ", av[1], ")"); }
            if (cn == "slice_len") { return sb_cat3("t_slice_len(", av[0], ")"); }
            if (cn == "append") {
                // 实参可能是非左值（字面量 / 运算结果），`&(-1)` 不是合法 C。
                // 用**数组**复合字面量 `(ElemT[1]){ 值 }` materialize 出可取址的临时量：
                // 数组初始化列表填的是元素 0，故标量 / 结构体 / TStr 一律正确
                // （标量复合字面量 `(Node){ n }` 会误初始化第一个成员，不能用）；
                // 数组自动退化为指针，无需再取址。顺带把 sizeof 锚到元素类型。
                var ap_ct: string = c_elem_ctype(call_arg_node(e, 0));
                return sb_cat6("t_slice_append_sized(&", av[0],
                    sb_cat3(", (", ap_ct, "[1]){ "), av[1],
                    sb_cat3(" }, (int64_t)sizeof(", ap_ct, "))"), "");
            }
            if (cn == "slice_set") {
                var ss_ct: string = c_elem_ctype(call_arg_node(e, 0));
                return sb_cat6("t_slice_set(", av[0], ", ", av[1],
                    sb_cat3(", (", ss_ct, "[1]){ "), sb_cat2(av[2], " })"));
            }
            if (cn == "file_read_all") { return sb_cat3("t_file_read_all(t_cstr(", av[0], "))"); }
            if (cn == "file_exists") { return sb_cat3("t_file_exists(t_cstr(", av[0], "))"); }
            if (cn == "path_resolve") { return sb_cat3("t_path_resolve(t_cstr(", av[0], "))"); }
            if (cn == "getenv") { return sb_cat3("t_getenv(t_cstr(", av[0], "))"); }
            if (cn == "file_write_all") {
                return sb_cat6("t_file_write_all(t_cstr(", av[0], "), ", av[1], ")", "");
            }
            if (cn == "args") { return "t_args()"; }
            if (cn == "read_line") { return "t_read_line()"; }
            if (cn == "stdin_eof") { return "t_stdin_eof()"; }
            if (cn == "ti_name" || cn == "ti_size" || cn == "ti_kind" || cn == "ti_field_count" || cn == "ti_field" || cn == "fi_name" || cn == "fi_offset" || cn == "fi_type_name" || cn == "fi_type_size" || cn == "fi_is_ptr" || cn == "fi_tag") {
                return c_emit_accessor_call(cn, av);
            }
            if (cn == "exit") { return sb_cat3("t_exit(", av[0], ")"); }
            if (cn == "sys_run") { return sb_cat3("sys_run(", av[0], ")"); }
            if (cn == "print") { return sb_cat3("t_print(", av[0], ")"); }
            if (cn == "eprint") { return sb_cat3("t_eprint(", av[0], ")"); }
            if (cn == "println") { return sb_cat3("t_println(", av[0], ")"); }
            if (cn == "str_slice") {
                return sb_cat6("t_str_slice(", av[0], ", ", av[1], ", ", sb_cat2(av[2], ")"));
            }
            // 子切片：O(1) 视图（共享 ptr、cap 收成 len，故对子切片 append 会另行扩容拷贝）
            if (cn == "slice_sub") {
                return sb_cat6("t_slice_sub(", av[0], ", (int64_t)(", av[1], "), (int64_t)(",
                    sb_cat2(av[2], "))"));
            }
            if (cn == "sb_new") { return "t_sb_new(t_arena_current())"; }
            if (cn == "sb_append_str") { return sb_cat5("t_sb_append_str(", av[0], ", ", av[1], ")"); }
            if (cn == "sb_append_char") { return sb_cat5("t_sb_append_char(", av[0], ", ", av[1], ")"); }
            if (cn == "sb_append_u64") { return sb_cat5("t_sb_append_u64(", av[0], ", ", av[1], ")"); }
            if (cn == "sb_append_i64") { return sb_cat5("t_sb_append_i64(", av[0], ", ", av[1], ")"); }
            if (cn == "sb_to_str") { return sb_cat3("t_sb_to_str(", av[0], ")"); }
            if (cn == "int_to_str" || cn == "i2s") { return sb_cat3("t_int_to_str(", av[0], ")"); }
            // 格式化（Python 格式规范迷你语言子集）
            if (cn == "format_int") { return sb_cat5("t_format_int(", av[0], ", ", av[1], ")"); }
            if (cn == "format_uint") { return sb_cat5("t_format_uint(", av[0], ", (uint64_t)(", av[1], "))"); }
            if (cn == "format_float") { return sb_cat5("t_format_float(", av[0], ", ", av[1], ")"); }
            if (cn == "format_str") { return sb_cat5("t_format_str(", av[0], ", ", av[1], ")"); }
            if (cn == "format_bool") { return sb_cat5("t_format_bool(", av[0], ", ", av[1], ")"); }
            if (cn == "format_char") { return sb_cat5("t_format_char(", av[0], ", (uint8_t)(", av[1], "))"); }
            // 时间格式化（M56）/ 解析与固定时区（M57）
            if (cn == "format_time") { return sb_cat5("t_format_time(", av[0], ", ", av[1], ", 0)"); }
            if (cn == "format_time_local") { return sb_cat5("t_format_time(", av[0], ", ", av[1], ", 1)"); }
            if (cn == "format_time_tz") { return sb_cat6("t_format_time_tz(", av[0], ", ", av[1], ", (int64_t)(", sb_cat2(av[2], "))")); }
            if (cn == "parse_time") { return sb_cat5("t_parse_time(", av[0], ", ", av[1], ", 0)"); }
            if (cn == "parse_time_local") { return sb_cat5("t_parse_time(", av[0], ", ", av[1], ", 1)"); }
            if (cn == "time_invalid") { return "INT64_MIN"; }
            if (cn == "now") { return "t_now()"; }
            if (cn == "sb_append_fmt_int") { return sb_cat6("t_sb_append_fmt_int(", av[0], ", ", av[1], ", ", sb_cat2(av[2], ")")); }
            if (cn == "sb_append_fmt_uint") { return sb_cat6("t_sb_append_fmt_uint(", av[0], ", ", av[1], ", (uint64_t)(", sb_cat2(av[2], "))")); }
            if (cn == "sb_append_fmt_float") { return sb_cat6("t_sb_append_fmt_float(", av[0], ", ", av[1], ", ", sb_cat2(av[2], ")")); }
            if (cn == "sb_append_fmt_str") { return sb_cat6("t_sb_append_fmt_str(", av[0], ", ", av[1], ", ", sb_cat2(av[2], ")")); }
            if (cn == "sb_append_fmt_bool") { return sb_cat6("t_sb_append_fmt_bool(", av[0], ", ", av[1], ", ", sb_cat2(av[2], ")")); }
            if (cn == "sb_append_fmt_char") { return sb_cat6("t_sb_append_fmt_char(", av[0], ", ", av[1], ", (uint8_t)(", sb_cat2(av[2], "))")); }
            if (cn == "sb_append_fmt_str_conv") { return sb_cat6("t_sb_append_fmt_str_conv(", av[0], ", ", av[1], ", ", sb_cat4(av[2], ", ", av[3], ")")); }
            if (cn == "sb_append_fmt_int_conv") { return sb_cat6("t_sb_append_fmt_int_conv(", av[0], ", ", av[1], ", ", sb_cat4(av[2], ", ", av[3], ")")); }
            if (cn == "sb_append_fmt_uint_conv") { return sb_cat6("t_sb_append_fmt_uint_conv(", av[0], ", ", av[1], ", (uint64_t)(", sb_cat4(av[2], "), ", av[3], ")")); }
            if (cn == "sb_clear") { return sb_cat3("t_sb_clear(", av[0], ")"); }
            if (cn == "map_new") {
                var mnw0: i64 = -1;
                if (n.la >= 0) { mnw0 = kids[n.la].val; }
                var mnwtd: i64 = expr_type_desc(mnw0);
                var mnwt: TD = tds[mnwtd];
                var mnwkk: i64 = 0;
                if (tds[mnwt.key].cat != "string") { mnwkk = 1; }
                var mnwvs: string = sb_cat3("sizeof(", desc_to_c(mnwt.val), ")");
                return sb_cat5("t_map_new(t_arena_current(), ", i2s(mnwkk), ", (int64_t)", mnwvs, ")");
            }
            if (cn == "map_set") {
                var ms0: i64 = call_arg_node(e, 0);
                var ms1: i64 = call_arg_node(e, 1);
                var ms2: i64 = call_arg_node(e, 2);
                return sb_cat6("t_map_put(", av[0], ", ", c_map_keyp(ms0, ms1), ", ", sb_cat2(c_map_valp(ms0, ms2), ")"));
            }
            if (cn == "map_has") {
                var mh0: i64 = call_arg_node(e, 0);
                return sb_cat4("t_map_has(", av[0], sb_cat2(", ", c_map_keyp(mh0, call_arg_node(e, 1))), ")");
            }
            if (cn == "map_len") { return sb_cat3("t_map_len(", av[0], ")"); }
            if (cn == "map_del") {
                var md0: i64 = call_arg_node(e, 0);
                return sb_cat4("t_map_del(", av[0], sb_cat2(", ", c_map_keyp(md0, call_arg_node(e, 1))), ")");
            }
            if (cn == "map_get") {
                return c_map_get(call_arg_node(e, 0), call_arg_node(e, 1));
            }
            if (cn == "sym_str") {
                var ssarg: i64 = call_arg_node(e, 0);
                var sstd: i64 = expr_type_desc(ssarg);
                var sstag: string = "";
                if (sstd >= 0 && tds[sstd].cat == "sym") { sstag = tds[sstd].name; }
                var sstaglit: string = sb_cat3("TSTR_LIT(\"", esc_c(sstag), "\")");
                return sb_cat5("t_sym_str(", sstaglit, ", ", av[0], ")");
            }
            if (cn == "sym_release") { return sb_cat3("t_sym_release(", av[0], ")"); }
            if (cn == "sym_release_all") { return "t_sym_release_all()"; }
            if (cn == "atom_str") { return sb_cat3("t_atom_str(", av[0], ")"); }
            // 文件描述符内建（M51）
            if (cn == "fopen") {
                return sb_cat5("t_fopen(t_cstr(", av[0], "), ",
                    fid_arg_code(call_arg_node(e, 1), "mode"), ")");
            }
            if (cn == "fclose") { return sb_cat3("t_fclose(", av[0], ")"); }
            if (cn == "fflush") { return sb_cat3("t_fflush(", av[0], ")"); }
            if (cn == "fid_is_open") { return sb_cat3("t_fid_is_open(", av[0], ")"); }
            if (cn == "fid_eof") { return sb_cat3("t_fid_eof(", av[0], ")"); }
            if (cn == "fid_error") { return sb_cat3("t_fid_error(", av[0], ")"); }
            if (cn == "fseek") { return sb_cat5("t_fseek(", av[0], ", ", av[1], ")"); }
            if (cn == "ftell") { return sb_cat3("t_ftell(", av[0], ")"); }
            if (cn == "fid_format") {
                return sb_cat5("t_fid_format(", av[0], ", ",
                    fid_fmt_atom_args(), ")");
            }
            if (cn == "fmt_register") {
                return sb_cat6("t_fmt_register(", fid_arg_code(call_arg_node(e, 0), "kind"),
                    ", t_cstr(", av[1], "), ",
                    sb_cat2(fid_arg_code(call_arg_node(e, 2), "fmt"), ")"));
            }
            // 间接调用：被调者是函数类型的变量/参数/全局，其值是 TClosure*，须解包成
            // `((Ret(*)(void*,A...))(f->fn))(f->env, args)`。顶层具名函数的直接调用
            // 不会命中（clos_callee_td 见到 "name()" 条目即返回 -1）。
            var ictd: i64 = clos_callee_td(cn);
            if (td_is_func(ictd)) {
                var icv: string = mb_sub(cn);
                var icb: StringBuilder = sb_new();
                sb_append_str(icb, "((");
                sb_append_str(icb, td_func_c_fnptr(ictd));
                sb_append_str(icb, ")((");
                sb_append_str(icb, icv);
                sb_append_str(icb, ")->fn))((");
                sb_append_str(icb, icv);
                sb_append_str(icb, ")->env");
                var ici: i64 = 0;
                while (ici < argc) {
                    sb_append_str(icb, ", ");
                    sb_append_str(icb, av[ici]);
                    ici = ici + 1;
                }
                sb_append_str(icb, ")");
                return sb_to_str(icb);
            }
            // 普通调用
            var sb: StringBuilder = sb_new();
            sb_append_str(sb, cn);
            sb_append_char(sb, 40);
            var i: i64 = 0;
            while (i < argc) {
                if (i > 0) {
                    sb_append_str(sb, ", ");
                }
                sb_append_str(sb, av[i]);
                i = i + 1;
            }
            sb_append_char(sb, 41);
            return sb_to_str(sb);
        }
        // callee 非 ident（结构体字段 / 数组元素 / 调用结果…）。若其静态类型是函数类型，
        // 说明拿到的是 TClosure*，须与 ident 路径同样解包。callee 表达式**只能求值一次**
        // （可能是带副作用的调用），故借 clang 语句表达式落到临时量再解包。
        var xctd: i64 = expr_type_desc(n.na);
        if (td_is_func(xctd)) {
            var xcb: StringBuilder = sb_new();
            sb_append_str(xcb, "({ TClosure* __ic = ");
            sb_append_str(xcb, emit_expr(n.na));
            sb_append_str(xcb, "; ((");
            sb_append_str(xcb, td_func_c_fnptr(xctd));
            sb_append_str(xcb, ")(__ic->fn))(__ic->env");
            var xc: i64 = n.la;
            while (xc >= 0) {
                var xk: Child = kids[xc];
                sb_append_str(xcb, ", ");
                sb_append_str(xcb, emit_expr(xk.val));
                xc = xk.next;
            }
            sb_append_str(xcb, "); })");
            return sb_to_str(xcb);
        }
        var sb2: StringBuilder = sb_new();
        sb_append_str(sb2, emit_expr(n.na));
        sb_append_char(sb2, 40);
        var c2: i64 = n.la;
        var first: bool = true;
        while (c2 >= 0) {
            var k2: Child = kids[c2];
            if (!first) {
                sb_append_str(sb2, ", ");
            }
            sb_append_str(sb2, emit_expr(k2.val));
            first = false;
            c2 = k2.next;
        }
        sb_append_char(sb2, 41);
        return sb_to_str(sb2);
    }
    if (n.kind == "member") {
        // 类型级常量：`Color.Green` → 头文件里的 `Color_Green`；
        // `PF.encrypted` → `PF_encrypted`（1bit，值即掩码）/ `PF_x_MASK`（≥2bit）。
        // 此前一律发射 `Color.Green`，是非法 C —— 静默错编。
        var mo1: Node = nodes[n.na];
        if (mo1.kind == "ident") {
            var mdi1: i64 = mb_type_decl(mo1.sa);
            if (mdi1 >= 0) {
                var mdn1: Node = nodes[mdi1];
                if (mdn1.kind == "EnumDecl") {
                    return sb_cat3(mo1.sa, "_", n.sa);
                }
                if (mdn1.kind == "FlagDecl") {
                    if (c_flag_slot_len(mdi1, n.sa) == 1) {
                        return sb_cat3(mo1.sa, "_", n.sa);
                    }
                    return sb_cat4(mo1.sa, "_", n.sa, "_MASK");
                }
            }
        }
        return sb_cat3(emit_expr(n.na), ".", n.sa);
    }
    if (n.kind == "index") {
        var od: i64 = expr_type_desc(n.na);
        var ot: TD = tds[od];
        var obj: string = emit_expr(n.na);
        var idx: string = emit_expr(n.nb);
        if (ot.cat == "string") {
            return sb_cat5("t_str_byte_at(", obj, ", ", idx, ")");
        }
        if (ot.cat == "slice") {
            var ec: string = c_ptr_to(ot.elem);
            return sb_cat6("(*(", ec, ")t_slice_at(", obj, ", ", sb_cat2(idx, "))"));
        }
        if (ot.cat == "map") {
            return c_map_get(n.na, n.nb);
        }
        return sb_cat6("(", obj, "[", idx, "]", ")");
    }
    if (n.kind == "array_lit") {
        var sb3: StringBuilder = sb_new();
        sb_append_char(sb3, 123);
        var c3: i64 = n.la;
        var first3: bool = true;
        while (c3 >= 0) {
            var k3: Child = kids[c3];
            if (!first3) {
                sb_append_str(sb3, ", ");
            }
            sb_append_str(sb3, emit_expr(k3.val));
            first3 = false;
            c3 = k3.next;
        }
        sb_append_char(sb3, 125);
        return sb_to_str(sb3);
    }
    if (n.kind == "struct_lit") {
        var sb4: StringBuilder = sb_new();
        sb_append_char(sb4, 40);
        sb_append_str(sb4, n.sa);
        sb_append_str(sb4, "){");
        var c4: i64 = n.la;
        var first4: bool = true;
        while (c4 >= 0) {
            var k4: Child = kids[c4];
            var fv: Node = nodes[k4.val];
            if (!first4) {
                sb_append_str(sb4, ", ");
            }
            sb_append_char(sb4, 46);
            sb_append_str(sb4, fv.sa);
            sb_append_str(sb4, " = ");
            sb_append_str(sb4, emit_expr(fv.na));
            first4 = false;
            c4 = k4.next;
        }
        sb_append_char(sb4, 125);
        return sb_to_str(sb4);
    }
    if (n.kind == "cast") {
        return sb_cat6("((", emit_ctype(n.nb), ")", emit_expr(n.na), ")", "");
    }
    if (n.kind == "paren") {
        return sb_cat3("(", emit_expr(n.na), ")");
    }
    // meta/comptime 表达式：Phase A 尚无 CTFE，透明降级为内层表达式的运行期求值
    // （Phase B 落地 CTFE 后此处改为直接发射折叠得到的常量）。
    if (n.kind == "comptime") {
        return emit_expr(n.na);
    }
    return "/* unsupported expr */";
}

// 判定表达式节点是否为数组字面量（切片字面量构造用）
is_array_lit fn(e: i64) bool {
    if (e < 0) {
        return false;
    }
    var an: Node = nodes[e];
    return an.kind == "array_lit";
}

is_map_lit fn(e: i64) bool {
    if (e < 0) {
        return false;
    }
    var mln: Node = nodes[e];
    return mln.kind == "map_lit";
}

// ── emitStmt（复刻 emitter.ts emitStmt；输出到 slines）─────────

emit_stmt fn(sid: i64, indent: i64) void {
    var pad: string = mk_pad(indent);
    g_stmt_pad = pad;    // 供 emit_expr 的 map 字面量分支对齐缩进
    var n: Node = nodes[sid];

    // defer：登记到延迟栈，待 return / 函数尾按 LIFO 运行（见 emit_func_decl 收尾）
    if (n.kind == "defer") {
        if (g_defer_n < 1024) {
            g_defer[g_defer_n] = sid;
            g_defer_n = g_defer_n + 1;
        }
        return;
    }
    // comptime_block：无 CTFE，退化为运行期内联块（避免被静默丢弃）
    if (n.kind == "comptime_block") {
        spush(sb_cat2(pad, "{"));
        var cb: i64 = n.la;
        while (cb >= 0) {
            var ckb: Child = kids[cb];
            emit_stmt(ckb.val, indent + 1);
            cb = ckb.next;
        }
        spush(sb_cat2(pad, "}"));
        return;
    }

    if (n.kind == "expr") {
        spush(sb_cat3(pad, emit_expr(n.na), ";"));
        return;
    }
    // 闭包体首重建捕获变量（M48）：从 env 结构按值拷回同名局部
    if (n.kind == "closure_capture") {
        if (n.na >= 0) {
            var cctd: i64 = resolve_type_desc(n.na);
            spush(sb_cat6(pad, desc_to_c(cctd), " ", n.sa,
                sb_cat4(" = ((", n.sb, "*)__env)->", n.sa), ";"));
        }
        return;
    }
    if (n.kind == "var_decl") {
        if (n.na >= 0) {
            var td: i64 = resolve_type_desc(n.na);
            var t: TD = tds[td];
            if (t.cat == "slice" && n.nb < 0) {
                spush(sb_cat6(pad, "TSlice ", n.sa, " = t_slice_new(sizeof(", desc_to_c(t.elem), "));"));
                return;
            }
            // 切片字面量：`var xs: []T = [a, b, c];` 运行期逐元素构造
            if (t.cat == "slice" && n.nb >= 0 && is_array_lit(n.nb)) {
                var lt: Node = nodes[n.nb];
                var ecs: string = desc_to_c(t.elem);
                spush(sb_cat6(pad, "TSlice ", n.sa, " = t_slice_new(sizeof(", ecs, "));"));
                var cc: i64 = lt.la;
                var ei: i64 = 0;
                while (cc >= 0) {
                    var ck: Child = kids[cc];
                    var tn: string = sb_cat4("_sl_", n.sa, "_", i2s(ei));
                    var ev: string = emit_expr(ck.val);
                    spush(sb_cat6(pad, ecs, " ", tn, sb_cat4(" = (", ecs, ")", ev), ";"));
                    spush(sb_cat6(pad, "t_slice_append(&", n.sa, ", &", tn, ");"));
                    ei = ei + 1;
                    cc = ck.next;
                }
                return;
            }
            // map：`var m: map[K]V;` 建空表；`= [k: v, ...]` 建表后逐项插入；
            // 从变量/表达式赋值（含 map 字面量表达式）则交给下面的通用分支。
            if (t.cat == "map") {
                if (n.nb < 0 || is_map_lit(n.nb)) {
                    if (n.nb < 0) {
                        var mlkk: i64 = 0;
                        if (tds[t.key].cat != "string") { mlkk = 1; }
                        var mlvc: string = desc_to_c(t.val);
                        spush(sb_cat5(pad, "TMap* ", n.sa, " = t_map_new(t_arena_current(), ", sb_cat3(i2s(mlkk), ", (int64_t)sizeof(", sb_cat2(mlvc, "));"))));
                    } else {
                        c_emit_map_lit(n.nb, n.sa, pad, t.key, t.val);
                    }
                    return;
                }
            }
            // Sym：字段仅存 u32/u16 id。无初始化 → 0；`= "str"` → 自动 intern。
            if (t.cat == "sym") {
                var symcty: string = desc_to_c(td);   // "uint32_t" / "uint16_t"
                if (n.nb < 0) {
                    spush(sb_cat5(pad, symcty, " ", n.sa, " = 0;"));
                } else {
                    var symtagl: string = sb_cat3("TSTR_LIT(\"", esc_c(t.name), "\")");
                    var symintr: string = sb_cat6("t_sym_intern(", symtagl, ", ", emit_expr(n.nb), ", ", sb_cat2(i2s(t.alen), ")"));
                    var symhead: string = sb_cat5(pad, symcty, " ", n.sa, " = ");
                    spush(sb_cat2(symhead, sb_cat2(symintr, ";")));
                }
                return;
            }
            // 函数类型：C 侧是闭包指针 TClosure*
            if (t.cat == "func") {
                var fdecl: string = c_decl_of(td, n.sa);
                if (n.nb < 0) {
                    spush(sb_cat3(pad, fdecl, " = NULL;"));
                } else {
                    spush(sb_cat5(pad, fdecl, " = ", emit_expr(n.nb), ";"));
                }
                return;
            }
            if (t.cat == "string" && n.nb < 0) {
                spush(sb_cat4(pad, "TStr ", n.sa, " = {0};"));
                return;
            }
            if (t.cat == "named" && n.nb < 0) {
                var cty: string = desc_to_c(td);
                if (ends_with_star(cty)) {
                    spush(sb_cat6(pad, cty, " ", n.sa, " = NULL;", ""));
                } else {
                    spush(sb_cat6(pad, cty, " ", n.sa, " = {0};", ""));
                }
                return;
            }
            // 定长数组局部：C 后端把 [N]T 表示为 T*，指针本身不带存储。须先声明定长
            // 缓冲再让指针指向它，否则 `var a: [8]i64;` 之后 a[0]=x 会写野指针。
            if (t.cat == "array" && t.alen > 0) {
                var aecy: string = desc_to_c(t.elem);
                var abuf: string = sb_cat2(n.sa, "_abuf");
                var adim: string = sb_cat3("[", i2s(t.alen), "]");
                if (n.nb < 0) {
                    spush(sb_cat5(pad, aecy, " ", abuf, sb_cat2(adim, ";")));
                } else {
                    spush(sb_cat6(pad, aecy, " ", abuf, adim, sb_cat3(" = ", emit_expr(n.nb), ";")));
                }
                spush(sb_cat6(pad, aecy, "* ", n.sa, " = ", sb_cat2(abuf, ";")));
                return;
            }
        }
        var ty: string = "auto";
        if (n.na >= 0) {
            ty = emit_ctype(n.na);
        }
        var init: string = "";
        if (n.nb >= 0) {
            init = sb_cat2(" = ", emit_expr(n.nb));
        }
        spush(sb_cat6(pad, ty, " ", n.sa, init, ";"));
        return;
    }
    if (n.kind == "for_each") {
        var itd: i64 = expr_type_desc(n.na);
        var it: TD = tds[itd];
        // map 的 for-in：按插入序迭代键
        if (it.cat == "map") {
            var mfkc: string = desc_to_c(it.key);
            var mfat: string = "t_map_key_int_at";
            if (tds[it.key].cat == "string") { mfat = "t_map_key_str_at"; }
            var mfit: string = emit_expr(n.na);
            spush(sb_cat4(pad, "for (int64_t _fe_i = 0; _fe_i < t_map_count(", mfit, "); _fe_i = _fe_i + 1) {"));
            spush(sb_cat6(sb_cat2(pad, "    "), mfkc, " ", n.sa, sb_cat6(" = ", mfat, "(", mfit, ", _fe_i);", ""), ""));
            // 双变量形式 `for (k, v in m)`：v 由插入序下标直接取值
            if (str_len(n.sb) > 0) {
                var mfvc: string = desc_to_c(it.val);
                spush(sb_cat6(sb_cat2(pad, "    "), mfvc, " ", n.sb, sb_cat5(" = *((", mfvc, "*)t_map_val_at(", mfit, ", _fe_i));"), ""));
            }
            var mfb: i64 = n.la;
            while (mfb >= 0) {
                var mfbk: Child = kids[mfb];
                emit_stmt(mfbk.val, indent + 2);
                mfb = mfbk.next;
            }
            spush(sb_cat2(pad, "}"));
            return;
        }
        var fe_elem_td: i64 = -1;
        if (it.cat == "slice" && it.elem >= 0) {
            fe_elem_td = it.elem;
        }
        var iter: string = emit_expr(n.na);
        spush(sb_cat6(pad, "for (int64_t _fe_i = 0; _fe_i < t_slice_len(", iter, "); _fe_i = _fe_i + 1) {", "", ""));
        spush(sb_cat6(sb_cat2(pad, "    "), c_decl_of(fe_elem_td, n.sa), " = *((", c_ptr_to(fe_elem_td), sb_cat4(")t_slice_at(", iter, ", _fe_i));", ""), ""));
        var b: i64 = n.la;
        while (b >= 0) {
            var bk: Child = kids[b];
            emit_stmt(bk.val, indent + 2);
            b = bk.next;
        }
        spush(sb_cat2(pad, "}"));
        return;
    }
    if (n.kind == "if") {
        spush(sb_cat4(pad, "if (", emit_expr(n.na), ") {"));
        var tb: i64 = n.la;
        while (tb >= 0) {
            var tk: Child = kids[tb];
            emit_stmt(tk.val, indent + 1);
            tb = tk.next;
        }
        if (n.lb > -2) {
            spush(sb_cat2(pad, "} else {"));
            var eb: i64 = n.lb;
            while (eb >= 0) {
                var ek: Child = kids[eb];
                emit_stmt(ek.val, indent + 1);
                eb = ek.next;
            }
        }
        spush(sb_cat2(pad, "}"));
        return;
    }
    if (n.kind == "while") {
        spush(sb_cat4(pad, "while (", emit_expr(n.na), ") {"));
        var wb: i64 = n.la;
        while (wb >= 0) {
            var wk: Child = kids[wb];
            emit_stmt(wk.val, indent + 1);
            wb = wk.next;
        }
        spush(sb_cat2(pad, "}"));
        return;
    }
    if (n.kind == "for") {
        spush(sb_cat2(pad, "for ("));
        if (n.na >= 0) {
            var ini: Node = nodes[n.na];
            if (ini.kind == "var_decl") {
                var ity: string = "int";
                if (ini.na >= 0) {
                    ity = emit_ctype(ini.na);
                }
                var iin: string = "";
                if (ini.nb >= 0) {
                    iin = sb_cat2(" = ", emit_expr(ini.nb));
                }
                sappend_last(sb_cat4(ity, " ", ini.sa, iin));
            }
            if (ini.kind == "expr") {
                sappend_last(emit_expr(ini.na));
            }
        }
        var cnd: string = "";
        if (n.nb >= 0) {
            cnd = emit_expr(n.nb);
        }
        var upd: string = "";
        if (n.nc >= 0) {
            upd = emit_expr(n.nc);
        }
        sappend_last(sb_cat6("; ", cnd, "; ", upd, ") {", ""));
        var fb: i64 = n.la;
        while (fb >= 0) {
            var fk: Child = kids[fb];
            emit_stmt(fk.val, indent + 1);
            fb = fk.next;
        }
        spush(sb_cat2(pad, "}"));
        return;
    }
    if (n.kind == "return") {
        // 运行延迟语句（defer）LIFO：后登记的先执行
        var di: i64 = g_defer_n - 1;
        while (di >= 0) {
            var dnode: Node = nodes[g_defer[di]];
            var dpad: string = mk_pad(indent);
            spush(sb_cat2(dpad, "{"));
            var dbb: i64 = dnode.la;
            while (dbb >= 0) {
                var dbk: Child = kids[dbb];
                emit_stmt(dbk.val, indent + 1);
                dbb = dbk.next;
            }
            spush(sb_cat2(dpad, "}"));
            di = di - 1;
        }
        g_defer_n = 0;
        if (n.na >= 0) {
            spush(sb_cat4(pad, "return ", emit_expr(n.na), ";"));
        } else {
            spush(sb_cat2(pad, "return;"));
        }
        return;
    }
    if (n.kind == "break") {
        spush(sb_cat2(pad, "break;"));
        return;
    }
    if (n.kind == "continue") {
        spush(sb_cat2(pad, "continue;"));
        return;
    }
    if (n.kind == "assignment") {
        // 注：普通 a = b 语句实际是 "assign" 表达式节点（见 emit_expr），"assignment"
        // 节点在此保留为兜底；map 索引写已在 emit_expr 的 "assign" 分支处理。
        spush(sb_cat6(pad, emit_expr(n.na), " ", n.sa, " ", sb_cat2(emit_expr(n.nb), ";")));
        return;
    }
    if (n.kind == "block") {
        spush(sb_cat2(pad, "{"));
        var bb: i64 = n.la;
        while (bb >= 0) {
            var bk2: Child = kids[bb];
            emit_stmt(bk2.val, indent + 1);
            bb = bk2.next;
        }
        spush(sb_cat2(pad, "}"));
        return;
    }
    // 其余未识别节点：不输出（fallthrough）
}

// ═══════════════════════════════════════════════════════════════
// E3: emit_decl / derive / flag 布局 / emit 编排 / 驱动 main
// ═══════════════════════════════════════════════════════════════

// ── JS parseInt 复刻（enum autoValue 用；radix 16 允许 0x 前缀，
//    radix 2 遇 'b' 停在 "0" → 0，复刻 tc0 quirk）────────────────


// ── JS (1 << bw) - 1 复刻（int32 回绕；flag slot maxValue）─────

js_max_val fn(bw: i64) i64 {
    var sh: i64 = bw % 32;
    if (sh < 0) {
        sh = sh + 32;
    }
    var v: i64 = 1 << sh;
    if (sh == 31) {
        v = 0 - 2147483648;
    }
    return v - 1;
}

// ── Flag 槽布局池（复刻 bitfield.ts resolve 的布局部分，无诊断；
//    growing pool + base 偏移，同 fr_names 模式）──────────────────

var fl_names: []string;
var fl_starts: []i64;
var fl_lens: []i64;
var fl_ends: []i64;

fr_layout fn(d: i64) i64 {
    var base: i64 = slice_len(fl_names) as i64;
    var n: Node = nodes[d];
    var auto_off: i64 = 0;
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var sl: Node = nodes[k.val];
        var start: i64 = auto_off;
        if (sl.bb) {
            start = sl.ib;
        }
        var end: i64 = start + sl.ia;
        append(fl_names, sl.sa);
        append(fl_starts, start);
        append(fl_lens, sl.ia);
        append(fl_ends, end);
        auto_off = end;
        c = k.next;
    }
    return base;
}

// FlagDecl 节点 d 上槽位 slot 的比特宽度（-1 = 无此槽）。
// emit_expr 用它区分 `PF_x`（1bit，宏值即掩码）与 `PF_x_MASK`（≥2bit）。
c_flag_slot_len fn(d: i64, slot: string) i64 {
    var dn: Node = nodes[d];
    var c: i64 = dn.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var sl: Node = nodes[k.val];
        if (sl.sa == slot) {
            return sl.ia;
        }
        c = k.next;
    }
    return -1;
}

// ── derive traits / fields 收集（growing pool + base 偏移）─────

var dt_traits: []string;

collect_traits fn(d: i64) i64 {
    var base: i64 = slice_len(dt_traits) as i64;
    var n: Node = nodes[d];
    var ai: i64 = ann_find(n.la, "derive");
    if (ai < 0) {
        return base;
    }
    var an: Node = nodes[ai];
    var c: i64 = an.la;
    while (c >= 0) {
        var k: Child = kids[c];
        var arg: Node = nodes[k.val];
        if (arg.kind == "ident") {
            append(dt_traits, arg.sa);
        }
        if (arg.kind == "list") {
            var c2: i64 = arg.la;
            while (c2 >= 0) {
                var k2: Child = kids[c2];
                var v: Node = nodes[k2.val];
                if (v.kind == "ident") {
                    append(dt_traits, v.sa);
                }
                c2 = k2.next;
            }
        }
        c = k.next;
    }
    return base;
}

var df_names: []string;
var df_anns: []i64;

collect_fields fn(d: i64) i64 {
    var base: i64 = slice_len(df_names) as i64;
    var n: Node = nodes[d];
    if (n.kind == "VariantDecl") {
        return base;
    }
    if (n.kind == "StructDecl") {
        var c: i64 = n.lb;
        while (c >= 0) {
            var k: Child = kids[c];
            var f: Node = nodes[k.val];
            if (f.ia < 0) {
                append(df_names, f.sa);
                append(df_anns, f.la);
            }
            c = k.next;
        }
        return base;
    }
    if (n.kind == "EnumDecl" || n.kind == "UnionDecl") {
        var c2: i64 = n.lb;
        while (c2 >= 0) {
            var k2: Child = kids[c2];
            var f2: Node = nodes[k2.val];
            append(df_names, f2.sa);
            append(df_anns, f2.la);
            c2 = k2.next;
        }
    }
    return base;
}

// ── derive 代码生成（复刻 derive.ts；含 [object Object] 与
//    t 语法方法体等 tc0 bug，逐字节一致要求）───────────────────

gen_trait fn(trait: string, name: string, fb: i64, fe: i64) string {
    var sb: StringBuilder = sb_new();

    if (trait == "ToString") {
        sb_append_str(sb, "// @derive(ToString) — auto-generated\nto_string fn(self: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ") -> string {\n    return \"");
        sb_append_str(sb, name);
        sb_append_str(sb, " { ");
        var i: i64 = fb;
        while (i < fe) {
            if (i > fb) {
                sb_append_str(sb, ", ");
            }
            sb_append_str(sb, df_names[i]);
            sb_append_str(sb, "=$");
            sb_append_str(sb, df_names[i]);
            i = i + 1;
        }
        sb_append_str(sb, " }\";\n}");
        return sb_to_str(sb);
    }

    if (trait == "FromString") {
        sb_append_str(sb, "// @derive(FromString) — auto-generated\nfrom_string fn(s: string) -> ");
        sb_append_str(sb, name);
        sb_append_str(sb, " {\n    var result: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ";\n    // parse fields: ");
        var i2: i64 = fb;
        while (i2 < fe) {
            if (i2 > fb) {
                sb_append_str(sb, ", ");
            }
            sb_append_str(sb, df_names[i2]);
            i2 = i2 + 1;
        }
        sb_append_str(sb, "\n    return result;\n}");
        return sb_to_str(sb);
    }

    if (trait == "Clone") {
        sb_append_str(sb, "// @derive(Clone) — auto-generated\nclone fn(self: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ") -> ");
        sb_append_str(sb, name);
        sb_append_str(sb, " {\n    return ");
        sb_append_str(sb, name);
        sb_append_str(sb, " { ");
        var i3: i64 = fb;
        while (i3 < fe) {
            if (i3 > fb) {
                sb_append_str(sb, ", ");
            }
            sb_append_str(sb, df_names[i3]);
            sb_append_str(sb, ": self.");
            sb_append_str(sb, df_names[i3]);
            i3 = i3 + 1;
        }
        sb_append_str(sb, " };\n}");
        return sb_to_str(sb);
    }

    if (trait == "Copy") {
        sb_append_str(sb, "// @derive(Copy) — auto-generated\n// ");
        sb_append_str(sb, name);
        sb_append_str(sb, " is marked as Copy (bitwise copy on assignment)");
        return sb_to_str(sb);
    }

    if (trait == "DebugPrint") {
        sb_append_str(sb, "// @derive(DebugPrint) — auto-generated\ndebug_print fn(self: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ") -> string {\n    return \"");
        sb_append_str(sb, name);
        sb_append_str(sb, "(");
        var i4: i64 = fb;
        while (i4 < fe) {
            if (i4 > fb) {
                sb_append_str(sb, ", ");
            }
            sb_append_str(sb, df_names[i4]);
            sb_append_str(sb, ": {self.");
            sb_append_str(sb, df_names[i4]);
            sb_append_str(sb, "}");
            i4 = i4 + 1;
        }
        sb_append_str(sb, ")\";\n}");
        return sb_to_str(sb);
    }

    if (trait == "BinarySerde") {
        sb_append_str(sb, "// @derive(BinarySerde) — auto-generated\nserialize fn(self: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ") -> []u8 {\n");
        // serializeLines: filter 掉 @binary_skip，索引按过滤后数组计
        var cnt: i64 = 0;
        var i5: i64 = fb;
        while (i5 < fe) {
            if (ann_find(df_anns[i5], "binary_skip") < 0) {
                if (cnt > 0) {
                    sb_append_str(sb, "\n");
                }
                sb_append_str(sb, "    // offset ");
                var oa: i64 = ann_find(df_anns[i5], "binary_offset");
                var has_off: bool = false;
                if (oa >= 0) {
                    if (ann_first_arg(oa) >= 0) {
                        has_off = true;
                    }
                }
                if (has_off) {
                    // tc0 bug: 模板串里插入 arg 对象 → "[object Object]"
                    sb_append_str(sb, "[object Object]");
                } else {
                    sb_append_i64(sb, cnt * 4);
                }
                sb_append_str(sb, ": write self.");
                sb_append_str(sb, df_names[i5]);
                cnt = cnt + 1;
            }
            i5 = i5 + 1;
        }
        sb_append_str(sb, "\n    return buffer;\n}\n\ndeserialize fn(data: []u8) -> ");
        sb_append_str(sb, name);
        sb_append_str(sb, " {\n    var result: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ";\n    // read fields from data at specified offsets\n    return result;\n}");
        return sb_to_str(sb);
    }

    if (trait == "Eq" || trait == "PartialEq") {
        sb_append_str(sb, "// @derive(Eq) — auto-generated\neq fn(self: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ", other: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ") -> bool {\n    return ");
        if (fb == fe) {
            sb_append_str(sb, "true");
        } else {
            var i6: i64 = fb;
            while (i6 < fe) {
                if (i6 > fb) {
                    sb_append_str(sb, " && ");
                }
                sb_append_str(sb, "self.");
                sb_append_str(sb, df_names[i6]);
                sb_append_str(sb, " == other.");
                sb_append_str(sb, df_names[i6]);
                i6 = i6 + 1;
            }
        }
        sb_append_str(sb, ";\n}");
        return sb_to_str(sb);
    }

    if (trait == "Hash") {
        sb_append_str(sb, "// @derive(Hash) — auto-generated\nhash fn(self: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ") -> u64 {\n    var hash: u64 = 0;\n");
        var i7: i64 = fb;
        while (i7 < fe) {
            if (i7 > fb) {
                sb_append_str(sb, "\n");
            }
            sb_append_str(sb, "    hash = hash_combine(hash, hash_of(self.");
            sb_append_str(sb, df_names[i7]);
            sb_append_str(sb, "));");
            i7 = i7 + 1;
        }
        sb_append_str(sb, "\n    return hash;\n}");
        return sb_to_str(sb);
    }

    return "";
}

process_derive fn(d: i64) void {
    var n: Node = nodes[d];
    var tb: i64 = collect_traits(d);
    var te: i64 = slice_len(dt_traits) as i64;
    if (tb == te) {
        return;
    }
    var fb: i64 = collect_fields(d);
    var fe: i64 = slice_len(df_names) as i64;
    var i: i64 = tb;
    while (i < te) {
        var code: string = gen_trait(dt_traits[i], n.sa, fb, fe);
        if (code != "") {
            spush(code);
            spush("");
        }
        i = i + 1;
    }
}

// ── emitAttributes（复刻 emitter.ts emitAttributes）────────────

emit_attributes fn(head: i64) string {
    var sb: StringBuilder = sb_new();
    var cnt: i64 = 0;
    var c: i64 = head;
    while (c >= 0) {
        var k: Child = kids[c];
        var a: Node = nodes[k.val];
        var s: string = "";
        var has: bool = false;
        if (a.sa == "inline") {
            s = "__attribute__((always_inline))";
            has = true;
        }
        if (a.sa == "no_inline") {
            s = "__attribute__((noinline))";
            has = true;
        }
        if (a.sa == "deprecated") {
            s = "__attribute__((deprecated))";
            var arg: i64 = ann_first_arg(k.val);
            if (arg >= 0) {
                var an: Node = nodes[arg];
                if (an.kind == "string") {
                    s = sb_cat3("__attribute__((deprecated(\"", an.sa, "\")))");
                }
            }
            has = true;
        }
        if (a.sa == "must_use") {
            s = "__attribute__((warn_unused_result))";
            has = true;
        }
        if (a.sa == "export_symbol") {
            var arg2: i64 = ann_first_arg(k.val);
            if (arg2 >= 0) {
                var an2: Node = nodes[arg2];
                if (an2.kind == "string") {
                    s = "__attribute__((visibility(\"default\")))";
                    has = true;
                }
            }
        }
        if (has) {
            if (cnt > 0) {
                sb_append_str(sb, " ");
            }
            sb_append_str(sb, s);
            cnt = cnt + 1;
        }
        c = k.next;
    }
    return sb_to_str(sb);
}

// ── 各声明 emitter（复刻 emitter.ts emitDecl 系列）─────────────

emit_struct_decl fn(d: i64) void {
    var n: Node = nodes[d];
    var attrs: string = emit_attributes(n.la);

    if (n.ba && n.has_sc) {
        hpush(sb_cat3("// @bitpack(", n.sc, ") struct"));
        if (attrs != "") {
            hpush(attrs);
        }
        hpush(sb_cat3("typedef struct ", n.sa, " {"));
        var c: i64 = n.lb;
        while (c >= 0) {
            var k: Child = kids[c];
            var f: Node = nodes[k.val];
            var fsb: StringBuilder = sb_new();
            sb_append_str(fsb, "    ");
            sb_append_str(fsb, scalar_to_c(n.sc));
            sb_append_str(fsb, " ");
            sb_append_str(fsb, f.sa);
            sb_append_str(fsb, " : ");
            sb_append_i64(fsb, f.ia);
            sb_append_str(fsb, ";");
            hpush(sb_to_str(fsb));
            c = k.next;
        }
        hpush(sb_cat3("} ", n.sa, ";"));
    } else {
        var layout_attr: string = "";
        if (n.sb == "soa") {
            layout_attr = " // #soa layout";
        }
        if (attrs != "") {
            hpush(attrs);
        }
        hpush(sb_cat4("typedef struct ", n.sa, " {", layout_attr));
        var c2: i64 = n.lb;
        while (c2 >= 0) {
            var k2: Child = kids[c2];
            var f2: Node = nodes[k2.val];
            if (f2.ia < 0) {
                var fattrs: string = emit_attributes(f2.la);
                if (fattrs != "") {
                    hpush(sb_cat2("    ", fattrs));
                }
                hpush(sb_cat3("    ", c_decl_of_node(f2.na, f2.sa), ";"));
            }
            c2 = k2.next;
        }
        hpush(sb_cat3("} ", n.sa, ";"));
    }

    process_derive(d);
}

emit_enum_decl fn(d: i64) void {
    var n: Node = nodes[d];
    hpush(sb_cat6("typedef ", scalar_to_c(n.sb), " ", n.sa, ";", ""));
    hpush("");
    var auto_val: i64 = 0;
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var v: Node = nodes[k.val];
        if (v.na >= 0) {
            hpush(sb_cat6("#define ", n.sa, "_", v.sa, " ", emit_expr(v.na)));
            var vn: Node = nodes[v.na];
            if (vn.kind == "int") {
                auto_val = js_parse_int(vn.sa, vn.ia) + 1;
            }
        } else {
            hpush(sb_cat6("#define ", n.sa, "_", v.sa, " ", i2s(auto_val)));
            auto_val = auto_val + 1;
        }
        c = k.next;
    }
}

emit_flag_decl fn(d: i64) void {
    var n: Node = nodes[d];
    hpush(sb_cat4("// flag[", n.sb, "] ", n.sa));
    hpush(sb_cat6("typedef ", scalar_to_c(n.sb), " ", n.sa, ";", ""));
    hpush("");

    var base: i64 = fr_layout(d);
    var total: i64 = slice_len(fl_names) as i64;
    var i: i64 = base;
    while (i < total) {
        if (fl_lens[i] == 1) {
            var ssb: StringBuilder = sb_new();
            sb_append_str(ssb, "#define ");
            sb_append_str(ssb, n.sa);
            sb_append_str(ssb, "_");
            sb_append_str(ssb, fl_names[i]);
            sb_append_str(ssb, " (1u << ");
            sb_append_i64(ssb, fl_starts[i]);
            sb_append_str(ssb, ")");
            hpush(sb_to_str(ssb));
        } else {
            var csb: StringBuilder = sb_new();
            sb_append_str(csb, "// ");
            sb_append_str(csb, fl_names[i]);
            sb_append_str(csb, ": bits ");
            sb_append_i64(csb, fl_starts[i]);
            sb_append_str(csb, "-");
            sb_append_i64(csb, fl_ends[i] - 1);
            sb_append_str(csb, " (");
            sb_append_i64(csb, fl_lens[i]);
            sb_append_str(csb, " bits, max=");
            sb_append_i64(csb, js_max_val(fl_lens[i]));
            sb_append_str(csb, ")");
            hpush(sb_to_str(csb));
            var hsb: StringBuilder = sb_new();
            sb_append_str(hsb, "#define ");
            sb_append_str(hsb, n.sa);
            sb_append_str(hsb, "_");
            sb_append_str(hsb, fl_names[i]);
            sb_append_str(hsb, "_SHIFT ");
            sb_append_i64(hsb, fl_starts[i]);
            hpush(sb_to_str(hsb));
            var msb: StringBuilder = sb_new();
            sb_append_str(msb, "#define ");
            sb_append_str(msb, n.sa);
            sb_append_str(msb, "_");
            sb_append_str(msb, fl_names[i]);
            sb_append_str(msb, "_MASK (((1u << ");
            sb_append_i64(msb, fl_lens[i]);
            sb_append_str(msb, ") - 1) << ");
            sb_append_i64(msb, fl_starts[i]);
            sb_append_str(msb, ")");
            hpush(sb_to_str(msb));
        }
        i = i + 1;
    }
}

emit_flag_set_decl fn(d: i64) void {
    var n: Node = nodes[d];
    hpush(sb_cat3("// flag_set ", n.sa, " (dynamic length bitfield)"));
    hpush(sb_cat3("typedef struct ", n.sa, " {"));
    hpush("    uint8_t* data;");
    hpush("    size_t bit_count;");
    hpush("    size_t byte_count;");
    hpush(sb_cat3("} ", n.sa, ";"));
    hpush("");

    var base: i64 = fr_layout(d);
    var total: i64 = slice_len(fl_names) as i64;
    var i: i64 = base;
    while (i < total) {
        var csb: StringBuilder = sb_new();
        sb_append_str(csb, "// ");
        sb_append_str(csb, fl_names[i]);
        sb_append_str(csb, ": bits ");
        sb_append_i64(csb, fl_starts[i]);
        sb_append_str(csb, "-");
        sb_append_i64(csb, fl_ends[i] - 1);
        sb_append_str(csb, " (");
        sb_append_i64(csb, fl_lens[i]);
        sb_append_str(csb, " bits)");
        hpush(sb_to_str(csb));
        var hsb: StringBuilder = sb_new();
        sb_append_str(hsb, "#define ");
        sb_append_str(hsb, n.sa);
        sb_append_str(hsb, "_");
        sb_append_str(hsb, fl_names[i]);
        sb_append_str(hsb, "_SHIFT ");
        sb_append_i64(hsb, fl_starts[i]);
        hpush(sb_to_str(hsb));
        var msb: StringBuilder = sb_new();
        sb_append_str(msb, "#define ");
        sb_append_str(msb, n.sa);
        sb_append_str(msb, "_");
        sb_append_str(msb, fl_names[i]);
        sb_append_str(msb, "_MASK (((1u << ");
        sb_append_i64(msb, fl_lens[i]);
        sb_append_str(msb, ") - 1) << ");
        sb_append_i64(msb, fl_starts[i]);
        sb_append_str(msb, ")");
        hpush(sb_to_str(msb));
        i = i + 1;
    }
}

emit_union_decl fn(d: i64) void {
    var n: Node = nodes[d];
    hpush(sb_cat3("typedef union ", n.sa, " {"));
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var m: Node = nodes[k.val];
        hpush(sb_cat6("    ", emit_ctype(m.na), " ", m.sa, ";", ""));
        c = k.next;
    }
    hpush(sb_cat3("} ", n.sa, ";"));
}

// Variant：tagged union。发射 struct { uint32_t _tag; union { 载荷 _uN; } _u; } 及各 case 的
// static inline 构造器/判别器/取载荷（直接落头文件，函数体用 StringBuilder 拼 tag 整数）。
emit_variant_decl fn(d: i64) void {
    var n: Node = nodes[d];
    var hsb: StringBuilder = sb_new();
    sb_append_str(hsb, "// variant ");
    sb_append_str(hsb, n.sa);
    hpush(sb_to_str(hsb));
    hpush(sb_cat3("typedef struct ", n.sa, " {"));
    hpush("    uint32_t _tag;");
    hpush("    union {");
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var vc: Node = nodes[k.val];
        if (vc.na >= 0) {
            var us: StringBuilder = sb_new();
            sb_append_str(us, "        ");
            sb_append_str(us, emit_ctype(vc.na));
            sb_append_str(us, " _u");
            sb_append_i64(us, vc.ia);
            sb_append_str(us, ";");
            hpush(sb_to_str(us));
        }
        c = k.next;
    }
    hpush("    } _u;");
    hpush(sb_cat3("} ", n.sa, ";"));
    hpush("");

    c = n.lb;
    while (c >= 0) {
        var k2: Child = kids[c];
        var vc2: Node = nodes[k2.val];
        var cname: string = vc2.sa;
        // 构造器
        var fsb: StringBuilder = sb_new();
        sb_append_str(fsb, "static inline ");
        sb_append_str(fsb, n.sa);
        sb_append_str(fsb, " ");
        sb_append_str(fsb, n.sa);
        sb_append_str(fsb, "_from_");
        sb_append_str(fsb, cname);
        if (vc2.na >= 0) {
            sb_append_str(fsb, "(");
            sb_append_str(fsb, emit_ctype(vc2.na));
            sb_append_str(fsb, " v) {");
        } else {
            sb_append_str(fsb, "(void) {");
        }
        hpush(sb_to_str(fsb));
        hpush(sb_cat3("    ", n.sa, " _s;"));
        var tsb: StringBuilder = sb_new();
        sb_append_str(tsb, "    _s._tag = ");
        sb_append_i64(tsb, vc2.ia);
        sb_append_str(tsb, ";");
        hpush(sb_to_str(tsb));
        if (vc2.na >= 0) {
            var asb: StringBuilder = sb_new();
            sb_append_str(asb, "    _s._u._u");
            sb_append_i64(asb, vc2.ia);
            sb_append_str(asb, " = v;");
            hpush(sb_to_str(asb));
        }
        hpush("    return _s;");
        hpush("}");
        // 判别器
        var isb: StringBuilder = sb_new();
        sb_append_str(isb, "static inline bool ");
        sb_append_str(isb, n.sa);
        sb_append_str(isb, "_is_");
        sb_append_str(isb, cname);
        sb_append_str(isb, "(");
        sb_append_str(isb, n.sa);
        sb_append_str(isb, " self) {");
        hpush(sb_to_str(isb));
        var isb2: StringBuilder = sb_new();
        sb_append_str(isb2, "    return self._tag == ");
        sb_append_i64(isb2, vc2.ia);
        sb_append_str(isb2, ";");
        hpush(sb_to_str(isb2));
        hpush("}");
        // 取载荷
        if (vc2.na >= 0) {
            var asb2: StringBuilder = sb_new();
            sb_append_str(asb2, "static inline ");
            sb_append_str(asb2, emit_ctype(vc2.na));
            sb_append_str(asb2, " ");
            sb_append_str(asb2, n.sa);
            sb_append_str(asb2, "_as_");
            sb_append_str(asb2, cname);
            sb_append_str(asb2, "(");
            sb_append_str(asb2, n.sa);
            sb_append_str(asb2, " self) {");
            hpush(sb_to_str(asb2));
            var asb3: StringBuilder = sb_new();
            sb_append_str(asb3, "    return self._u._u");
            sb_append_i64(asb3, vc2.ia);
            sb_append_str(asb3, ";");
            hpush(sb_to_str(asb3));
            hpush("}");
        }
        c = k2.next;
    }
    hpush("");
}

emit_func_decl fn(d: i64) void {
    var n: Node = nodes[d];
    var emit_name: string = n.sa;
    if (ann_find(n.la, "main") >= 0) {
        emit_name = sb_cat2("t_entry_", n.sa);
        em_main_fn = emit_name;
        em_has_main = true;
    }
    var attrs: string = emit_attributes(n.la);

    var psb: StringBuilder = sb_new();
    var cnt: i64 = 0;
    // 带捕获的合成闭包函数（M48）：env 指针为首参，与 TClosure ABI 一致
    if (str_len(n.sb) > 0) {
        sb_append_str(psb, "void* __env");
        cnt = 1;
    }
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var p: Node = nodes[k.val];
        if (cnt > 0) {
            sb_append_str(psb, ", ");
        }
        sb_append_str(psb, c_decl_of_node(p.na, p.sa));
        cnt = cnt + 1;
        c = k.next;
    }
    var param_str: string = "void";
    if (cnt > 0) {
        param_str = sb_to_str(psb);
    }
    // 返回函数指针的函数必须写成 `Ret (*name(params))(Args)`——把 `name(params)`
    // 整体当作声明子塞进函数指针声明里，不能拼成 `Ret (*)(Args) name(params)`。
    var sig: string = c_decl_of_node(n.na, sb_cat4(emit_name, "(", param_str, ")"));

    if (n.ba) {
        if (attrs != "") {
            hpush(attrs);
        }
        hpush(sb_cat2(sig, ";"));
        return;
    }

    if (attrs != "") {
        hpush(attrs);
    }
    hpush(sb_cat2(sig, ";"));

    em_cur_fn = n.sa;
    em_in_fn = true;
    g_defer_n = 0;   // 每个函数独立延迟栈
    spush(sb_cat2(sig, " {"));
    if (n.lc > -2) {
        var b: i64 = n.lc;
        while (b >= 0) {
            var bk: Child = kids[b];
            emit_stmt(bk.val, 1);
            b = bk.next;
        }
    }
    // 函数正常结束（无显式 return）：运行剩余 defer（LIFO）
    {
        var di: i64 = g_defer_n - 1;
        while (di >= 0) {
            var dnode: Node = nodes[g_defer[di]];
            spush("    {");
            var dbb: i64 = dnode.la;
            while (dbb >= 0) {
                var dbk: Child = kids[dbb];
                emit_stmt(dbk.val, 2);
                dbb = dbk.next;
            }
            spush("    }");
            di = di - 1;
        }
        g_defer_n = 0;
    }
    spush("}");
    em_in_fn = false;
    em_cur_fn = "";
    spush("");
}

emit_global_var fn(d: i64) void {
    var n: Node = nodes[d];
    hpush(sb_cat3("extern ", c_decl_of_node(n.na, n.sa), ";"));
    // Sym 全局变量：字段仅存 u32/u16 id。无初始化 → 零值；`= "str"` →
    // 运行期 intern（函数调用），须搬进 t__ginit（C 文件作用域不允许调用）。
    var gtd0: i64 = resolve_type_desc(n.na);
    var gt0: TD = tds[gtd0];
    if (gt0.cat == "sym") {
        var symcty: string = emit_ctype(n.na);
        if (n.nb < 0) {
            spush(sb_cat5(symcty, " ", n.sa, ";", ""));
            return;
        }
        var symtagl: string = sb_cat3("TSTR_LIT(\"", esc_c(gt0.name), "\")");
        var symintr: string = sb_cat6("t_sym_intern(", symtagl, ", ", emit_expr(n.nb), ", ", sb_cat2(i2s(gt0.alen), ")"));
        spush(sb_cat5(symcty, " ", n.sa, ";", ""));
        append(glines, sb_cat4("    ", n.sa, " = ", sb_cat2(symintr, ";")));
        return;
    }
    // 定长数组全局：C 后端把 [N]T 表示为 T*，但指针本身没有存储 → 须分配定长缓冲并让
    // 变量指向它，否则 g_fc_d[0] = x 之类会写 NULL 地址（LLVM 后端用 [N x T]，无此问题）。
    if (gt0.cat == "array" && gt0.alen > 0) {
        var gaecy: string = desc_to_c(gt0.elem);
        var gabuf: string = sb_cat2(n.sa, "_abuf");
        var gadim: string = sb_cat3("[", i2s(gt0.alen), "]");
        if (n.nb < 0) {
            spush(sb_cat4(gaecy, " ", gabuf, sb_cat2(gadim, ";")));
        } else {
            spush(sb_cat5(gaecy, " ", gabuf, gadim, sb_cat3(" = ", emit_expr(n.nb), ";")));
        }
        spush(sb_cat5(gaecy, "* ", n.sa, " = ", sb_cat2(gabuf, ";")));
        return;
    }
    if (n.nb < 0) {
        spush(sb_cat2(c_decl_of_node(n.na, n.sa), ";"));
        return;
    }
    // 先在重定向模式下发射初始化器：若它产生了辅助语句（如 map 字面量的
    // t_map_new/t_map_put），说明不是 C 的编译期常量，须搬进 t__ginit。
    var gbase: i64 = slice_len(glines) as i64;
    g_spush_to_ginit = true;
    g_stmt_pad = "    ";
    var gv: string = emit_expr(n.nb);
    g_spush_to_ginit = false;
    g_stmt_pad = "";
    if ((slice_len(glines) as i64) > gbase) {
        spush(sb_cat2(c_decl_of_node(n.na, n.sa), ";"));
        append(glines, sb_cat4("    ", n.sa, " = ", sb_cat2(gv, ";")));
        return;
    }
    spush(sb_cat4(c_decl_of_node(n.na, n.sa), " = ", gv, ";"));
}

emit_global_const fn(d: i64) void {
    var n: Node = nodes[d];
    hpush(sb_cat6("#define ", n.sa, " (", emit_expr(n.nb), ")", ""));
}

emit_decl fn(d: i64) void {
    var n: Node = nodes[d];
    if (n.kind == "StructDecl") {
        emit_struct_decl(d);
        return;
    }
    if (n.kind == "EnumDecl") {
        emit_enum_decl(d);
        return;
    }
    if (n.kind == "FlagDecl") {
        emit_flag_decl(d);
        return;
    }
    if (n.kind == "FlagSetDecl") {
        emit_flag_set_decl(d);
        return;
    }
    if (n.kind == "UnionDecl") {
        emit_union_decl(d);
        return;
    }
    if (n.kind == "VariantDecl") {
        emit_variant_decl(d);
        return;
    }
    if (n.kind == "FuncDecl") {
        if (func_is_generic(d)) { return; }
        emit_func_decl(d);
        return;
    }
    if (n.kind == "GlobalVarDecl") {
        emit_global_var(d);
        return;
    }
    if (n.kind == "GlobalConstDecl") {
        emit_global_const(d);
        return;
    }
    if (n.kind == "ImportDecl") {
        hpush(sb_cat3("#include \"", n.sb, "\""));
        return;
    }
    if (n.kind == "ImportModDecl") {
        // 模块导入（M-Module）：单文件 tc 不解析模块，发射期不产生任何 C 输出；
        // 模块解析与头文件内联由 tote 构建层完成。
        return;
    }
    if (n.kind == "TypeAliasDecl") {
        hpush(sb_cat6("typedef ", emit_ctype(n.na), " ", n.sa, ";", ""));
        return;
    }
}

// ── Flag 操作宏（复刻 emitFlagMacros）──────────────────────────

emit_flag_macros fn() void {
    hpush("");
    hpush("// ── Flag operations (spec 6.4) ──");
    hpush("// 1-bit: use | & ^ operators, check with (mask & FLAG) != 0");
    hpush("// multi-bit: use flag_set_val/flag_get_val macros");
    hpush("");
    hpush("#define flag_set_val(flags, shift, mask, val) do { (flags) = ((flags) & ~(mask)) | (((val) << (shift)) & (mask)); } while(0)");
    hpush("#define flag_get_val(flags, shift, mask) (((flags) & (mask)) >> (shift))");
    hpush("");
}

// ── emit 编排（复刻 CEmitter.emit）─────────────────────────────

// ── 函数值闭包的 C 侧落地（FuncType v2 / M47）───────────────────
// 顶层具名函数的 C 定义是 `Ret g(Args)`，没有 env 首参；而函数**值**的统一
// 调用约定是 `Ret (*)(void* env, Args)`。直接强转会让 env 挤掉首个真实参数，
// 故为每个被取值的函数生成一层 static trampoline 吃掉 env 再转发：
//
//   static Ret __tramp_g(void* __env, A0 __a0, A1 __a1) {
//       (void)__env; return g(__a0, __a1);
//   }
//   static TClosure __tclos_g = { (void*)__tramp_g, NULL };
//
// 输出进头文件尾部：此时全部函数原型已在其上方，且生成的 .c 首行即 #include
// 该头文件，故所有函数体引用 `(&__tclos_g)` 时它已定义。
emit_c_closures fn() void {
    var cn: i64 = slice_len(clos_names) as i64;
    if (cn == 0) {
        return;
    }
    hpush("");
    hpush("// ── 函数值闭包（FuncType v2）：trampoline + 静态闭包记录 ──");
    var i: i64 = 0;
    while (i < cn) {
        var nm: string = clos_names[i];
        var d: i64 = clos_decl_of(nm);
        if (d >= 0) {
            var dn: Node = nodes[d];
            var callee: string = nm;
            if (ann_find(dn.la, "main") >= 0) {
                callee = sb_cat2("t_entry_", nm);
            }
            var rty: string = emit_ctype(dn.na);
            var psb: StringBuilder = sb_new();
            var asb: StringBuilder = sb_new();
            sb_append_str(psb, "void* __env");
            var c: i64 = dn.lb;
            var pi: i64 = 0;
            while (c >= 0) {
                var k: Child = kids[c];
                var p: Node = nodes[k.val];
                var pn: string = sb_cat2("__a", i2s(pi));
                sb_append_str(psb, ", ");
                sb_append_str(psb, c_decl_of_node(p.na, pn));
                if (pi > 0) {
                    sb_append_str(asb, ", ");
                }
                sb_append_str(asb, pn);
                pi = pi + 1;
                c = k.next;
            }
            hpush(sb_cat6("static ", rty, " __tramp_", nm, "(", sb_cat2(sb_to_str(psb), ") {")));
            hpush("    (void)__env;");
            if (rty == "void") {
                hpush(sb_cat5("    ", callee, "(", sb_to_str(asb), ");"));
            } else {
                hpush(sb_cat5("    return ", callee, "(", sb_to_str(asb), ");"));
            }
            hpush("}");
            hpush(sb_cat6("static TClosure __tclos_", nm, " = { (void*)__tramp_", nm, ", NULL };", ""));
        }
        i = i + 1;
    }
}

// 全局 atom 名表（C 后端）：索引 0 为占位空串，其后按 g_atom_names 顺序；
// 因 atom_intern 返回 1-based id，故 t_atom_table[id] 直接命中（index 0 不用）。
// 运行时 t_atom_str(id) 经 extern 引用此表。无 atom 时也发射最小表以满足链接。
emit_c_atom_table fn() void {
    var cnt: i64 = g_atom_cnt;
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "TStr t_atom_table[] = { TSTR_LIT(\"\")");
    var i: i64 = 0;
    while (i < cnt) {
        sb_append_str(sb, ", TSTR_LIT(\"");
        sb_append_str(sb, esc_c(g_atom_names[i]));
        sb_append_str(sb, "\")");
        i = i + 1;
    }
    sb_append_str(sb, " };");
    spush(sb_to_str(sb));
    var sb2: StringBuilder = sb_new();
    sb_append_str(sb2, "int64_t t_atom_count = ");
    sb_append_i64(sb2, cnt + 1);
    sb_append_str(sb2, ";");
    spush(sb_to_str(sb2));
}

emit_unit fn(mod: string) void {
    var guard: string = sb_cat3("TC_", to_upper(mod), "_H");
    hpush(sb_cat2("#ifndef ", guard));
    hpush(sb_cat2("#define ", guard));
    hpush("");
    hpush("#include <stdint.h>");
    hpush("#include <stdbool.h>");
    hpush("#include <stddef.h>");
    hpush("#include \"t_runtime.h\"");
    hpush("");
    // type_info(T) 常量结构（M36）：TTypeInfo/TFieldInfo 由 t_runtime.h 提供，
    // 此处不再重复 typedef（否则与 t_runtime.h 重定义冲突）。

    spush(sb_cat3("#include \"", mod, ".h\""));
    spush("#include <stdio.h>");
    spush("#include <stdlib.h>");
    spush("#include <string.h>");
    spush("#include \"t_runtime.h\"");
    spush("");

    build_type_map();

    // 先按字段依赖拓扑排序，发射所有 struct/union/variant 族类型的完整定义。
    // 这保证被值内嵌的类型（如 entry 的 NpcState 内嵌 physics 的 Velocity）在引用
    // 之前已完整定义，消解跨模块 / 前向引用导致的 C 编译错误。
    emit_struct_families_ordered();

    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = decl_list[i];
        var k: string = nodes[d].kind;
        // 已在上方按拓扑序发射，主循环跳过，避免重复定义。
        if (k == "StructDecl" || k == "UnionDecl" || k == "VariantDecl") {
            if (str_in_slice(g_emitted_structs, nodes[d].sa)) {
                i = i + 1;
                continue;
            }
        }
        emit_decl(decl_list[i]);
        i = i + 1;
    }

    emit_c_atom_table();

    // type_info(T) 编译期常量（引用 StructDecl，须在类型定义后输出）
    var tln: i64 = slice_len(ti_lines) as i64;
    if (tln > 0) {
        spush("");
        var ti: i64 = 0;
        while (ti < tln) {
            spush(ti_lines[ti]);
            ti = ti + 1;
        }
    }

    // 全局 var 的运行期初始化器（非编译期常量）汇总为 t__ginit，在 main 开头调用
    var gn: i64 = slice_len(glines) as i64;
    if (gn > 0) {
        spush("");
        spush("static void t__ginit(void) {");
        var gi: i64 = 0;
        while (gi < gn) {
            spush(glines[gi]);
            gi = gi + 1;
        }
        spush("}");
    }

    if (em_has_main) {
        spush("");
        spush("int main(int argc, char** argv) {");
        spush("    t_runtime_init(argc, argv);");
        spush("    t_runtime_set_arena(t_arena_new());");
        if (gn > 0) {
            spush("    t__ginit();");
        }
        spush(sb_cat3("    int32_t _exit_code = ", em_main_fn, "();"));
        spush("    t_runtime_done();");
        spush("    return (int)_exit_code;");
        spush("}");
        spush("");
    }

    emit_flag_macros();

    // 函数值闭包须在全部函数原型之后落地（trampoline 要调用它们）
    emit_c_closures();

    hpush("");
    hpush(sb_cat2("#endif // ", guard));
}

// ── 输出行拼接（join("\n")，无末尾换行）────────────────────────

h_join fn() string {
    var sb: StringBuilder = sb_new();
    var n: i64 = slice_len(hlines) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (i > 0) {
            sb_append_str(sb, "\n");
        }
        sb_append_str(sb, hlines[i]);
        i = i + 1;
    }
    return sb_to_str(sb);
}

s_join fn() string {
    var sb: StringBuilder = sb_new();
    var n: i64 = slice_len(slines) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (i > 0) {
            sb_append_str(sb, "\n");
        }
        sb_append_str(sb, slines[i]);
        i = i + 1;
    }
    return sb_to_str(sb);
}



c_emit_accessor_call fn(cn: string, av: []string) string {
    var r: string = sb_cat2("t_", cn);
    r = sb_cat2(r, "(");
    var i: i64 = 0;
    var n: i64 = slice_len(av) as i64;
    while (i < n) {
        if (i > 0) { r = sb_cat2(r, ", "); }
        r = sb_cat2(r, av[i]);
        i = i + 1;
    }
    return sb_cat2(r, ")");
}


emit_type_info_c fn(tname: string) string {
    var gref: string = sb_cat2("&__ti_", tname);
    var di: i64 = 0;
    var dn2: i64 = slice_len(ti_done) as i64;
    while (di < dn2) {
        if (ti_done[di] == tname) { return gref; }
        di = di + 1;
    }
    var d: i64 = ti_struct_decl(tname);
    if (d < 0) {
        diag_new("T-CDE-E910", "error", sb_cat2("type_info: '", sb_cat2(tname, "' 不是 struct 类型（当前仅支持 struct）")), "", 1, 1, 1, 10);
        return "0";
    }
    append(ti_done, tname);
    // C 后端：type_info 常量定义在 t_entry_main 之后（emit 期才合成），
    // 但 C 的 static 先用后定义在同 TU 非法；故在 .h 内放前向声明。
    // （Point 等 struct 已落在 .h，故 .c 顶部 include 后即可见。）
    hpush(sb_cat3("static TTypeInfo __ti_", tname, ";"));
    hpush(sb_cat3("static TFieldInfo __ti_", tname, "_f[];"));
    var decl: Node = nodes[d];

    var fsb: StringBuilder = sb_new();
    sb_append_str(fsb, "static TFieldInfo __ti_");
    sb_append_str(fsb, tname);
    sb_append_str(fsb, "_f[] = { ");
    var n: i64 = 0;
    var c: i64 = decl.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var f: Node = nodes[k.val];
        if (f.ia < 0) {
            if (n > 0) { sb_append_str(fsb, ", "); }
            var ftd: i64 = resolve_type_desc(f.na);
            var cty: string = emit_ctype(f.na);
            var isp: i64 = 0;
            if (is_ref_type(ftd)) { isp = 1; }
            sb_append_str(fsb, sb_cat3("{ TSTR_LIT(\"", esc_c(f.sa), "\"), "));
            sb_append_str(fsb, sb_cat5("offsetof(", tname, ", ", f.sa, "), "));
            sb_append_str(fsb, sb_cat3("TSTR_LIT(\"", esc_c(td_readable(ftd)), "\"), "));
            sb_append_str(fsb, sb_cat3("sizeof(", cty, "), "));
            sb_append_i64(fsb, isp);
            sb_append_str(fsb, ", ");
            sb_append_i64(fsb, f.ib);   // 字段 tagID（@N 显式 / 全自动自动分配）
            sb_append_str(fsb, " }");
            n = n + 1;
        }
        c = k.next;
    }
    sb_append_str(fsb, " };");

    var tsb: StringBuilder = sb_new();
    sb_append_str(tsb, "static TTypeInfo __ti_");
    sb_append_str(tsb, tname);
    sb_append_str(tsb, sb_cat3(" = { TSTR_LIT(\"", esc_c(tname), "\"), "));
    sb_append_str(tsb, sb_cat3("sizeof(", tname, "), 0, "));
    sb_append_i64(tsb, n);
    sb_append_str(tsb, sb_cat3(", { __ti_", tname, "_f, "));
    sb_append_i64(tsb, n);
    sb_append_str(tsb, ", ");
    sb_append_i64(tsb, n);
    sb_append_str(tsb, ", (int64_t)sizeof(TFieldInfo) } };");
    // 字段数组必须先于 TTypeInfo 输出（后者引用前者）
    append(ti_lines, sb_to_str(fsb));
    append(ti_lines, sb_to_str(tsb));
    return gref;
}












// 按名查 StructDecl 节点下标。emit 期只能依赖 decl_list —— checker 的
// global_scope/syms 在发射阶段已不保证有效，用 sym_lookup 会取到野下标。
ti_struct_decl fn(tname: string) i64 {
    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = decl_list[i];
        var dn: Node = nodes[d];
        if (dn.kind == "StructDecl" && dn.sa == tname) { return d; }
        i = i + 1;
    }
    return -1;
}


