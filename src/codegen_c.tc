            if (cn == "fi_name") { return td_mk("string"); }
            if (cn == "fi_type_name") { return td_mk("string"); }
            if (cn == "ti_size") { return td_named_mk("scalar", "i64"); }
            if (cn == "ti_kind") { return td_named_mk("scalar", "i64"); }
            if (cn == "ti_field_count") { return td_named_mk("scalar", "i64"); }
            if (cn == "fi_offset") { return td_named_mk("scalar", "i64"); }
            if (cn == "fi_tag") { return td_named_mk("scalar", "i64"); }
            if (cn == "fi_type_size") { return td_named_mk("scalar", "i64"); }
            if (cn == "ti_field") { return td_named_mk("fieldinfo", "FieldInfo"); }
            if (cn == "fi_is_ptr") { return td_named_mk("scalar", "bool"); }
