        }
        // callee 非 ident（结构体字段 / 数组元素 / 调用结果…）。若其静态类型是函数类型，
        // 说明拿到的是 TClosure*，须与 ident 路径同样解包。callee 表达式**只能求值一次**
        // （可能是带副作用的调用），故借 clang 语句表达式落到临时量再解包。
        var xctd: i64 = expr_type_desc(n.na);
        if (td_is_func(xctd)) {
            var xcb: StringBuilder = sb_new();
            sb_append_str(xcb, "({ TClosure* __ic = ");
            sb_append_str(xcb, emit_expr(n.na));
            sb_append_str(xcb, "; ((");
            sb_append_str(xcb, td_func_c_fnptr(xctd));
            sb_append_str(xcb, ")(__ic->fn))(__ic->env");
            var xc: i64 = n.la;
            var xai: i64 = 0;
            while (xc >= 0) {
                var xk: Child = base.kids[xc];
                var xptd: i64 = -1;
                if (xctd >= 0 && xai < sema.tdf_pcount[xctd]) { xptd = sema.tdf_params[sema.tdf_pstart[xctd] + xai]; }
                c_arg_expect_td = xptd;
                sb_append_str(xcb, ", ");
                sb_append_str(xcb, c_emit_call_arg(xk.val));
                c_arg_expect_td = -1;
                xai = xai + 1;
                xc = xk.next;
            }
            sb_append_str(xcb, "); })");
            return sb_to_str(xcb);
        }
        var sb2: StringBuilder = sb_new();
        sb_append_str(sb2, emit_expr(n.na));
        sb_append_char(sb2, 40);
        var c2ftd: i64 = expr_type_desc(n.na);
        if (c2ftd >= 0 && sema.tds[c2ftd].cat != "func") { c2ftd = -1; }
        var c2: i64 = n.la;
        var first: bool = true;
        var c2ai: i64 = 0;
        while (c2 >= 0) {
            var k2: Child = base.kids[c2];
            if (!first) {
                sb_append_str(sb2, ", ");
            }
            var c2ptd: i64 = -1;
            if (c2ftd >= 0 && c2ai < sema.tdf_pcount[c2ftd]) { c2ptd = sema.tdf_params[sema.tdf_pstart[c2ftd] + c2ai]; }
            c_arg_expect_td = c2ptd;
            sb_append_str(sb2, c_emit_call_arg(k2.val));
            c_arg_expect_td = -1;
            first = false;
            c2ai = c2ai + 1;
            c2 = k2.next;
        }
        sb_append_char(sb2, 41);
        return sb_to_str(sb2);
    }
    if (n.kind == "member") {
        // 类型级常量：`Color.Green` → 头文件里的 `Color_Green`；
        // `PF.encrypted` → `PF_encrypted`（1bit，值即掩码）/ `PF_x_MASK`（≥2bit）。
        // 此前一律发射 `Color.Green`，是非法 C —— 静默错编。
        var mo1: Node = base.nodes[n.na];
        if (mo1.kind == "ident") {
            var mdi1: i64 = sema.mb_type_decl(mo1.sa);
            if (mdi1 >= 0) {
                var mdn1: Node = base.nodes[mdi1];
                if (mdn1.kind == "EnumDecl") {
                    return base.sb_cat3(mo1.sa, "_", n.sa);
                }
                if (mdn1.kind == "FlagDecl") {
                    if (c_flag_slot_len(mdi1, n.sa) == 1) {
                        return base.sb_cat3(mo1.sa, "_", n.sa);
                    }
                    return base.sb_cat4(mo1.sa, "_", n.sa, "_MASK");
                }
            }
        }
        return base.sb_cat3(emit_expr(n.na), ".", n.sa);
    }
    if (n.kind == "index") {
        var od: i64 = expr_type_desc(n.na);
        var ot: TD = sema.tds[od];
        var obj: string = emit_expr(n.na);
        var idx: string = emit_expr(n.nb);
        if (ot.cat == "string" || ot.cat == "bytes") {
            return base.sb_cat5("t_str_byte_at(", obj, ", ", idx, ")");
        }
        if (ot.cat == "slice") {
            var ec: string = c_ptr_to(ot.elem);
            return base.sb_cat6("(*(", ec, ")t_slice_at(", obj, ", ", base.sb_cat2(idx, "))"));
        }
        if (ot.cat == "map") {
            return c_map_get(n.na, n.nb);
        }
        return base.sb_cat6("(", obj, "[", idx, "]", ")");
    }
    if (n.kind == "array_lit") {
        // 向量字面量构造：`[a,b,c,d]` 被 sema 标记为向量 TD（n.ib>=0 且 cat==vector）
        // → 发射 C 向量复合字面量 `(VTY){a,b,c,d}`（VTY 含 vector_size 属性）。
        // ⚠ 标记走 ib 而非 ia：array_lit 的 ia 在 sema 之后会被抹回 -1。
        if (n.ib >= 0 && sema.tds[n.ib].cat == "vector") {
            var vty: string = desc_to_c(n.ib);
            var sbv: StringBuilder = sb_new();
            sb_append_char(sbv, 40);
            sb_append_str(sbv, vty);
            sb_append_str(sbv, "){");
            var cv: i64 = n.la;
            var firstv: bool = true;
            while (cv >= 0) {
                var ck: Child = base.kids[cv];
                if (firstv == false) { sb_append_str(sbv, ", "); }
                var evs: string = emit_expr(ck.val);
                sb_append_str(sbv, evs);
                firstv = false;
                cv = ck.next;
            }
            sb_append_char(sbv, 125);
            return sb_to_str(sbv);
        }
        // 空切片字面量作表达式（`g = []`）：目标是 slice 类型时返回零长空切片
        // `t_slice_new(sizeof(elem))`，与 C 局部初始化（ll_emit_var_init 同款）一致。
        // ⚠ 修 P0-4：此前空 `[]` 被发射成 `{}` 复合字面量 → 与 TSlice{ptr,len} 结构不符。
        // 非空前切片字面量作表达式属既有未覆盖路径（非本任务范围）。
        var cetd: i64 = expr_type_desc(e);
        if (cetd >= 0 && sema.tds[cetd].cat == "slice" && n.la < 0) {
            return base.sb_cat4("t_slice_new(sizeof(", desc_to_c(sema.tds[cetd].elem), "))", "");
        }
        var sb3: StringBuilder = sb_new();
        sb_append_char(sb3, 123);
        var c3: i64 = n.la;
        var first3: bool = true;
        while (c3 >= 0) {
            var k3: Child = base.kids[c3];
            if (!first3) {
                sb_append_str(sb3, ", ");
            }
            sb_append_str(sb3, emit_expr(k3.val));
            first3 = false;
            c3 = k3.next;
        }
        sb_append_char(sb3, 125);
        return sb_to_str(sb3);
    }
    if (n.kind == "struct_lit") {
        var sb4: StringBuilder = sb_new();
        sb_append_char(sb4, 40);
        sb_append_str(sb4, n.sa);
        sb_append_str(sb4, "){");
        var c4: i64 = n.la;
        var first4: bool = true;
        while (c4 >= 0) {
            var k4: Child = base.kids[c4];
            var fv: Node = base.nodes[k4.val];
            if (!first4) {
                sb_append_str(sb4, ", ");
            }
            sb_append_char(sb4, 46);
            sb_append_str(sb4, fv.sa);
            sb_append_str(sb4, " = ");
            sb_append_str(sb4, emit_expr(fv.na));
            first4 = false;
            c4 = k4.next;
        }
        sb_append_char(sb4, 125);
        return sb_to_str(sb4);
    }
    if (n.kind == "cast") {
        var ftd: i64 = expr_type_desc(n.na);
        var ttd: i64 = sema.resolve_type_desc(n.nb);
        // 数组字面量直接转型成切片（`return [..]` / `f([..])` 的 `as []T` 包装）：
        // 源是 array_lit，按期望 slice TD 构造 heap 切片（GNU 语句表达式），而非退化为 `{}` 复合字面量。
        if (base.nodes[n.na].kind == "array_lit" && ttd >= 0 && sema.tds[ttd].cat == "slice") {
            return c_slice_lit_expr(n.na, ttd);
        }
        if (ftd >= 0 && ttd >= 0 && sema.tds[ftd].cat == "array" && sema.tds[ttd].cat == "slice") {
            var elemc: string = desc_to_c(sema.tds[ftd].elem);
            var nlen: i64 = sema.tds[ftd].alen;
            return base.sb_cat5("t_slice_from_raw(", emit_expr(n.na), ", ", base.i2s(nlen),
                base.sb_cat3(", sizeof(", elemc, "))"));
        }
        return base.sb_cat6("((", emit_ctype(n.nb), ")", emit_expr(n.na), ")", "");
    }
    if (n.kind == "paren") {
        return base.sb_cat3("(", emit_expr(n.na), ")");
    }
    // comptime 表达式：Phase A 尚无 CTFE，透明降级为内层表达式的运行期求值
    // （Phase B 落地 CTFE 后此处改为直接发射折叠得到的常量）。
    if (n.kind == "comptime") {
        return emit_expr(n.na);
    }
    return "/* unsupported expr */";
}

// 判定表达式节点是否为数组字面量（切片字面量构造用）
pub fn is_array_lit(e: i64) bool {
    if (e < 0) {
        return false;
    }
    var an: Node = base.nodes[e];
    return an.kind == "array_lit";
}

// 调用实参处的数组字面量：`sum4([10,20,30,40])`（`sum4` 形参为 `[4]i64`）。C 不允许裸
// `{...}` 作表达式（仅能用于初始化器），须包成复合字面量 `(T[N]){...}`。元素类型取首元素
// 的 expr_type_desc，长度取 kids 计数，与 sema.infer_expr 的 array_lit 分支一致。
// ⚠ 向量字面量（n.ib>=0，emit_expr 已发 `(VTY){...}`）不在此处二次包裹；空切片（`[]`，
// emit_expr 已发 `t_slice_new(...)`）因 k0<0 返回 "" 而跳过——两者都不动。
pub fn c_array_lit_value_ty(e: i64) string {
    var n: Node = base.nodes[e];
    var k0: i64 = n.la;
    if (k0 < 0) {
        return "";
    }
    var etd: i64 = expr_type_desc(base.kids[k0].val);
    var ct: string = "int64_t";
    if (etd >= 0) {
        ct = desc_to_c(etd);
    }
    var cnt: i64 = 0;
    var c: i64 = n.la;
    while (c >= 0) {
        cnt = cnt + 1;
        c = base.kids[c].next;
    }
    return base.sb_cat4(ct, "[", base.i2s(cnt), "]");
}

// 切片字面量作表达式（`s = [1,2,3]` / `return [1,2,3]` / `f([1,2,3])`，期望类型为 `[]T`）。
// 用 GNU 语句表达式构造 heap 切片（t_slice_new + 逐元素 t_slice_append），返回 TSlice 值。
// ⚠ 不能用 t_slice_from_raw：它零拷贝只借用指针，而复合字面量是块作用域，离开即失效 → UAF。
pub var g_sl_id: i64 = 0;
pub var c_arg_expect_td: i64 = -1;   // 当前调用实参期望的类型（callee 签名注入，供字面量切片识别）
pub fn c_slice_lit_expr(e: i64, std: i64) string {
    var n: Node = base.nodes[e];
    var etd: i64 = sema.tds[std].elem;
    var et: string = "int64_t";
    if (etd >= 0) { et = desc_to_c(etd); }
    g_sl_id = g_sl_id + 1;
    var id: string = base.i2s(g_sl_id);
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "({ TSlice _sl");
    sb_append_str(sb, id);
    sb_append_str(sb, " = t_slice_new(sizeof(");
    sb_append_str(sb, et);
    sb_append_str(sb, "));");
    var c: i64 = n.la;
    var idx: i64 = 0;
    while (c >= 0) {
        var ck: Child = base.kids[c];
        var ev: string = emit_expr(ck.val);
        sb_append_str(sb, " ");
        sb_append_str(sb, et);
        sb_append_str(sb, " _e");
        sb_append_str(sb, id);
        sb_append_str(sb, "_");
        sb_append_str(sb, base.i2s(idx));
        sb_append_str(sb, " = (");
        sb_append_str(sb, et);
        sb_append_str(sb, ")");
        sb_append_str(sb, ev);
        sb_append_str(sb, ";");
        sb_append_str(sb, " t_slice_append(&_sl");
        sb_append_str(sb, id);
        sb_append_str(sb, ", &_e");
        sb_append_str(sb, id);
        sb_append_str(sb, "_");
        sb_append_str(sb, base.i2s(idx));
        sb_append_str(sb, ");");
        idx = idx + 1;
        c = ck.next;
    }
    sb_append_str(sb, " _sl");
    sb_append_str(sb, id);
    sb_append_str(sb, "; })");
    return sb_to_str(sb);
}

pub fn c_emit_call_arg(aen: i64) string {
    // 先按期望类型判断：若期望为切片且实参是数组字面量，直接构造 heap 切片
    // （必须在 emit_expr 之前判定，否则字面量会先退化为 `{}` 复合字面量）。
    // saved 保存调用方注入的期望类型，供嵌套调用（实参内再出现函数调用）正确还原。
    var saved: i64 = c_arg_expect_td;
    var s: string = "";
    if (base.nodes[aen].kind == "array_lit" && c_arg_expect_td >= 0 && sema.tds[c_arg_expect_td].cat == "slice") {
        s = c_slice_lit_expr(aen, c_arg_expect_td);
    } else {
        s = emit_expr(aen);
        if (base.nodes[aen].kind == "array_lit" && base.nodes[aen].ib < 0) {
            var aty: string = c_array_lit_value_ty(aen);
            if (aty != "") {
                s = base.sb_cat4("(", aty, ")", s);
            }
        }
    }
    c_arg_expect_td = saved;
    return s;
}

pub fn is_map_lit(e: i64) bool {
    if (e < 0) {
        return false;
    }
    var mln: Node = base.nodes[e];
    return mln.kind == "map_lit";
}

// ── emitStmt（复刻 emitter.ts emitStmt；输出到 slines）─────────

pub fn emit_stmt(sid: i64, indent: i64) void {
    var pad: string = mk_pad(indent);
    g_stmt_pad = pad;    // 供 emit_expr 的 map 字面量分支对齐缩进
    var n: Node = base.nodes[sid];

    // defer：登记到延迟栈，待 return / 函数尾按 LIFO 运行（见 emit_func_decl 收尾）
    if (n.kind == "defer") {
        if (g_defer_n < 1024) {
            g_defer[g_defer_n] = sid;
            g_defer_n = g_defer_n + 1;
        }
        return;
    }
    // comptime_block：无 CTFE，退化为运行期内联块（避免被静默丢弃）
    if (n.kind == "comptime_block") {
        spush(base.sb_cat2(pad, "{"));
        var cb: i64 = n.la;
        while (cb >= 0) {
            var ckb: Child = base.kids[cb];
            emit_stmt(ckb.val, indent + 1);
            cb = ckb.next;
        }
        spush(base.sb_cat2(pad, "}"));
        return;
    }

    if (n.kind == "expr") {
        spush(base.sb_cat3(pad, emit_expr(n.na), ";"));
        return;
    }
    // 闭包体首重建捕获变量（M48）：从 env 结构按值拷回同名局部
    if (n.kind == "closure_capture") {
        if (n.na >= 0) {
            var cctd: i64 = sema.resolve_type_desc(n.na);
            spush(base.sb_cat6(pad, desc_to_c(cctd), " ", n.sa,
                base.sb_cat4(" = ((", n.sb, "*)__env)->", n.sa), ";"));
        }
        return;
    }
    if (n.kind == "var_decl") {
        // 同函数内重名局部变量（shadowing）：与 LLVM 后端同机制。
        // conpat 载荷绑定（match 构造器解构出的 x）身处各臂独立代码块，不做唯一化重整。
        if (em_in_fn) {
            var cname: string = n.sa;
            var lkey: string = base.sb_cat3(em_cur_fn, "::", n.sa);
            if (base.g_conpat_bind_has(sid) == false && base.g_seen_has(lkey)) {
                cname = base.sb_cat3(n.sa, "__", base.i2s(sid));
                append(base.g_local_decls, sid);
            }
            append(base.g_seen, lkey);
            n.sa = cname;
        }
        if (n.na >= 0) {
            var td: i64 = sema.resolve_type_desc(n.na);
            var t: TD = sema.tds[td];
            if (t.cat == "slice" && n.nb < 0) {
                spush(base.sb_cat6(pad, "TSlice ", n.sa, " = t_slice_new(sizeof(", desc_to_c(t.elem), "));"));
                return;
            }
            // 切片字面量：`var xs: []T = [a, b, c];` 运行期逐元素构造
            if (t.cat == "slice" && n.nb >= 0 && is_array_lit(n.nb)) {
                var lt: Node = base.nodes[n.nb];
                var ecs: string = desc_to_c(t.elem);
                spush(base.sb_cat6(pad, "TSlice ", n.sa, " = t_slice_new(sizeof(", ecs, "));"));
                var cc: i64 = lt.la;
                var ei: i64 = 0;
                while (cc >= 0) {
                    var ck: Child = base.kids[cc];
                    var tn: string = base.sb_cat4("_sl_", n.sa, "_", base.i2s(ei));
                    var ev: string = emit_expr(ck.val);
                    spush(base.sb_cat6(pad, ecs, " ", tn, base.sb_cat4(" = (", ecs, ")", ev), ";"));
                    spush(base.sb_cat6(pad, "t_slice_append(&", n.sa, ", &", tn, ");"));
                    ei = ei + 1;
                    cc = ck.next;
                }
                return;
            }
            // map：`var m: map[K]V;` 建空表；`= [k: v, ...]` 建表后逐项插入；
            // 从变量/表达式赋值（含 map 字面量表达式）则交给下面的通用分支。
            if (t.cat == "map") {
                if (n.nb < 0 || is_map_lit(n.nb)) {
                    if (n.nb < 0) {
                        var mlkk: i64 = 0;
                        if (sema.tds[t.key].cat != "string") { mlkk = 1; }
                        var mlvc: string = desc_to_c(t.val);
                        spush(base.sb_cat5(pad, "TMap* ", n.sa, " = t_map_new(t_arena_current(), ", base.sb_cat3(base.i2s(mlkk), ", (int64_t)sizeof(", base.sb_cat2(mlvc, "));"))));
                    } else {
                        c_emit_map_lit(n.nb, n.sa, pad, t.key, t.val);
                    }
                    return;
                }
            }
            // Sym：字段仅存 u32/u16 id。无初始化 → 0；`= "str"` → 自动 intern。
            if (t.cat == "sym") {
                var symcty: string = desc_to_c(td);   // "uint32_t" / "uint16_t"
                if (n.nb < 0) {
                    spush(base.sb_cat5(pad, symcty, " ", n.sa, " = 0;"));
                } else {
                    var symtagl: string = base.sb_cat3("TSTR_LIT(\"", esc_c(t.name), "\")");
                    var symintr: string = base.sb_cat6("t_sym_intern(", symtagl, ", ", emit_expr(n.nb), ", ", base.sb_cat2(base.i2s(t.alen), ")"));
                    var symhead: string = base.sb_cat5(pad, symcty, " ", n.sa, " = ");
                    spush(base.sb_cat2(symhead, base.sb_cat2(symintr, ";")));
                }
                return;
            }
            // 函数类型：C 侧是闭包指针 TClosure*
            if (t.cat == "func") {
                var fdecl: string = c_decl_of(td, n.sa);
                if (n.nb < 0) {
                    spush(base.sb_cat3(pad, fdecl, " = NULL;"));
                } else {
                    spush(base.sb_cat5(pad, fdecl, " = ", emit_expr(n.nb), ";"));
                }
                return;
            }
            if (t.cat == "string" && n.nb < 0) {
                spush(base.sb_cat4(pad, "TStr ", n.sa, " = {0};"));
                return;
            }
            if (t.cat == "named" && n.nb < 0) {
                var cty: string = desc_to_c(td);
                if (ends_with_star(cty)) {
                    spush(base.sb_cat6(pad, cty, " ", n.sa, " = NULL;", ""));
                } else {
                    spush(base.sb_cat6(pad, cty, " ", n.sa, " = {0};", ""));
                }
                return;
            }
            // 定长数组局部：C 后端把 [N]T 表示为 T*，指针本身不带存储。须先声明定长
            // 缓冲再让指针指向它，否则 `var a: [8]i64;` 之后 a[0]=x 会写野指针。
            if (t.cat == "array" && t.alen > 0) {
                var aecy: string = desc_to_c(t.elem);
                var abuf: string = base.sb_cat2(n.sa, "_abuf");
                var adim: string = base.sb_cat3("[", base.i2s(t.alen), "]");
                if (n.nb < 0) {
                    spush(base.sb_cat5(pad, aecy, " ", abuf, base.sb_cat2(adim, ";")));
                } else {
                    spush(base.sb_cat6(pad, aecy, " ", abuf, adim, base.sb_cat3(" = ", emit_expr(n.nb), ";")));
                }
                spush(base.sb_cat6(pad, aecy, "* ", n.sa, " = ", base.sb_cat2(abuf, ";")));
                return;
            }
            // 定长数组 → 切片零拷贝视图：var s: []T = arr;（sema 不为变量初始化包 cast 节点，
            // 故此处单独拦截 array→slice，避免退化成 `TSlice s = arr;` 的类型不兼容报错）
            if (t.cat == "slice" && n.nb >= 0) {
                var itd2: i64 = expr_type_desc(n.nb);
                if (itd2 >= 0 && sema.tds[itd2].cat == "array") {
                    var ecs2: string = desc_to_c(t.elem);
                    var nlen2: i64 = sema.tds[itd2].alen;
                    var scls: StringBuilder = sb_new();
                    sb_append_str(scls, pad);
                    sb_append_str(scls, "TSlice ");
                    sb_append_str(scls, n.sa);
                    sb_append_str(scls, " = t_slice_from_raw(");
                    sb_append_str(scls, emit_expr(n.nb));
                    sb_append_str(scls, ", ");
                    sb_append_str(scls, base.i2s(nlen2));
                    sb_append_str(scls, ", sizeof(");
                    sb_append_str(scls, ecs2);
                    sb_append_str(scls, "));");
                    spush(sb_to_str(scls));
                    return;
                }
            }
        }
        var ty: string = "auto";
        if (n.na >= 0) {
            ty = emit_ctype(n.na);
        }
        var init: string = "";
        if (n.nb >= 0) {
            init = base.sb_cat2(" = ", emit_expr(n.nb));
        }
        spush(base.sb_cat6(pad, ty, " ", n.sa, init, ";"));
        return;
    }
    if (n.kind == "for_each") {
        var itd: i64 = expr_type_desc(n.na);
        var it: TD = sema.tds[itd];
        // map 的 for-in：按插入序迭代键
        if (it.cat == "map") {
            var mfkc: string = desc_to_c(it.key);
            var mfat: string = "t_map_key_int_at";
            if (sema.tds[it.key].cat == "string") { mfat = "t_map_key_str_at"; }
            var mfit: string = emit_expr(n.na);
            spush(base.sb_cat4(pad, "for (int64_t _fe_i = 0; _fe_i < t_map_count(", mfit, "); _fe_i = _fe_i + 1) {"));
            spush(base.sb_cat6(base.sb_cat2(pad, "    "), mfkc, " ", n.sa, base.sb_cat6(" = ", mfat, "(", mfit, ", _fe_i);", ""), ""));
            // 双变量形式 `for (k, v in m)`：v 由插入序下标直接取值
            if (str_len(n.sb) > 0) {
                var mfvc: string = desc_to_c(it.val);
                spush(base.sb_cat6(base.sb_cat2(pad, "    "), mfvc, " ", n.sb, base.sb_cat5(" = *((", mfvc, "*)t_map_val_at(", mfit, ", _fe_i));"), ""));
            }
            var mfb: i64 = n.la;
            while (mfb >= 0) {
                var mfbk: Child = base.kids[mfb];
                emit_stmt(mfbk.val, indent + 2);
                mfb = mfbk.next;
            }
            spush(base.sb_cat2(pad, "}"));
            return;
        }
        var fe_elem_td: i64 = -1;
        if (it.cat == "slice" && it.elem >= 0) {
            fe_elem_td = it.elem;
        }
        var iter: string = emit_expr(n.na);
        spush(base.sb_cat6(pad, "for (int64_t _fe_i = 0; _fe_i < t_slice_len(", iter, "); _fe_i = _fe_i + 1) {", "", ""));
        spush(base.sb_cat6(base.sb_cat2(pad, "    "), c_decl_of(fe_elem_td, n.sa), " = *((", c_ptr_to(fe_elem_td), base.sb_cat4(")t_slice_at(", iter, ", _fe_i));", ""), ""));
        var b: i64 = n.la;
        while (b >= 0) {
            var bk: Child = base.kids[b];
            emit_stmt(bk.val, indent + 2);
            b = bk.next;
        }
        spush(base.sb_cat2(pad, "}"));
        return;
    }
    if (n.kind == "if") {
        spush(base.sb_cat4(pad, "if (", emit_expr(n.na), ") {"));
        var tb: i64 = n.la;
        while (tb >= 0) {
            var tk: Child = base.kids[tb];
            emit_stmt(tk.val, indent + 1);
            tb = tk.next;
        }
        if (n.lb > -2) {
            spush(base.sb_cat2(pad, "} else {"));
            var eb: i64 = n.lb;
            while (eb >= 0) {
                var ek: Child = base.kids[eb];
                emit_stmt(ek.val, indent + 1);
                eb = ek.next;
            }
        }
        spush(base.sb_cat2(pad, "}"));
        return;
    }
    if (n.kind == "while") {
        spush(base.sb_cat4(pad, "while (", emit_expr(n.na), ") {"));
        var wb: i64 = n.la;
        while (wb >= 0) {
            var wk: Child = base.kids[wb];
            emit_stmt(wk.val, indent + 1);
            wb = wk.next;
        }
        spush(base.sb_cat2(pad, "}"));
        return;
    }
    if (n.kind == "for") {
        spush(base.sb_cat2(pad, "for ("));
        if (n.na >= 0) {
            var ini: Node = base.nodes[n.na];
            if (ini.kind == "var_decl") {
                var ity: string = "int";
                if (ini.na >= 0) {
                    ity = emit_ctype(ini.na);
                }
                var iin: string = "";
                if (ini.nb >= 0) {
                    iin = base.sb_cat2(" = ", emit_expr(ini.nb));
                }
                sappend_last(base.sb_cat4(ity, " ", ini.sa, iin));
            }
            if (ini.kind == "expr") {
                sappend_last(emit_expr(ini.na));
            }
        }
        var cnd: string = "";
        if (n.nb >= 0) {
            cnd = emit_expr(n.nb);
        }
        var upd: string = "";
        if (n.nc >= 0) {
            upd = emit_expr(n.nc);
        }
        sappend_last(base.sb_cat6("; ", cnd, "; ", upd, ") {", ""));
        var fb: i64 = n.la;
        while (fb >= 0) {
            var fk: Child = base.kids[fb];
            emit_stmt(fk.val, indent + 1);
            fb = fk.next;
        }
        spush(base.sb_cat2(pad, "}"));
        return;
    }
    if (n.kind == "return") {
        // 运行延迟语句（defer）LIFO：后登记的先执行
        var di: i64 = g_defer_n - 1;
        while (di >= 0) {
            var dnode: Node = base.nodes[g_defer[di]];
            var dpad: string = mk_pad(indent);
            spush(base.sb_cat2(dpad, "{"));
            var dbb: i64 = dnode.la;
            while (dbb >= 0) {
                var dbk: Child = base.kids[dbb];
                emit_stmt(dbk.val, indent + 1);
                dbb = dbk.next;
            }
            spush(base.sb_cat2(dpad, "}"));
            di = di - 1;
        }
        g_defer_n = 0;
        if (n.na >= 0) {
            if (em_cur_ret >= 0 && sema.tds[em_cur_ret].cat == "slice" && base.nodes[n.na].kind == "array_lit") {
                spush(base.sb_cat4(pad, "return ", c_slice_lit_expr(n.na, em_cur_ret), ";"));
            } else {
                spush(base.sb_cat4(pad, "return ", emit_expr(n.na), ";"));
            }
        } else {
            spush(base.sb_cat2(pad, "return;"));
        }
        return;
    }
    if (n.kind == "break") {
        spush(base.sb_cat2(pad, "break;"));
        return;
    }
    if (n.kind == "continue") {
        spush(base.sb_cat2(pad, "continue;"));
        return;
    }
    if (n.kind == "assignment") {
        // 注：普通 a = b 语句实际是 "assign" 表达式节点（见 emit_expr），"assignment"
        // 节点在此保留为兜底；map 索引写已在 emit_expr 的 "assign" 分支处理。
        spush(base.sb_cat6(pad, emit_expr(n.na), " ", n.sa, " ", base.sb_cat2(emit_expr(n.nb), ";")));
        return;
    }
    if (n.kind == "block") {
        spush(base.sb_cat2(pad, "{"));
        var bb: i64 = n.la;
        while (bb >= 0) {
            var bk2: Child = base.kids[bb];
            emit_stmt(bk2.val, indent + 1);
            bb = bk2.next;
        }
        spush(base.sb_cat2(pad, "}"));
        return;
    }
    // 其余未识别节点：不输出（fallthrough）
}

// ═══════════════════════════════════════════════════════════════
// E3: emit_decl / derive / flag 布局 / emit 编排 / 驱动 main
// ═══════════════════════════════════════════════════════════════

// ── JS parseInt 复刻（enum autoValue 用；radix 16 允许 0x 前缀，
//    radix 2 遇 'b' 停在 "0" → 0，复刻 tc0 quirk）────────────────


// ── JS (1 << bw) - 1 复刻（int32 回绕；flag slot maxValue）─────

pub fn js_max_val(bw: i64) i64 {
    var sh: i64 = bw % 32;
    if (sh < 0) {
        sh = sh + 32;
    }
    var v: i64 = 1 << sh;
    if (sh == 31) {
        v = 0 - 2147483648;
    }
    return v - 1;
}

// ── Flag 槽布局池（复刻 bitfield.ts resolve 的布局部分，无诊断；
//    growing pool + base 偏移，同 fr_names 模式）──────────────────

pub var fl_names: []string;
pub var fl_starts: []i64;
pub var fl_lens: []i64;
pub var fl_ends: []i64;

pub fn fr_layout(d: i64) i64 {
    var base: i64 = slice_len(fl_names) as i64;
    var n: Node = base.nodes[d];
    var auto_off: i64 = 0;
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = base.kids[c];
        var sl: Node = base.nodes[k.val];
        var start: i64 = auto_off;
        if (sl.bb) {
            start = sl.ib;
        }
        var end: i64 = start + sl.ia;
        append(fl_names, sl.sa);
        append(fl_starts, start);
        append(fl_lens, sl.ia);
        append(fl_ends, end);
        auto_off = end;
        c = k.next;
    }
    return base;
}

// FlagDecl 节点 d 上槽位 slot 的比特宽度（-1 = 无此槽）。
// emit_expr 用它区分 `PF_x`（1bit，宏值即掩码）与 `PF_x_MASK`（≥2bit）。
pub fn c_flag_slot_len(d: i64, slot: string) i64 {
    var dn: Node = base.nodes[d];
    var c: i64 = dn.lb;
    while (c >= 0) {
        var k: Child = base.kids[c];
        var sl: Node = base.nodes[k.val];
        if (sl.sa == slot) {
            return sl.ia;
        }
        c = k.next;
    }
    return -1;
}

// ── derive traits / fields 收集（growing pool + base 偏移）─────

pub var dt_traits: []string;

pub fn collect_traits(d: i64) i64 {
    var base: i64 = slice_len(dt_traits) as i64;
    var n: Node = base.nodes[d];
    var ai: i64 = parse.ann_find(n.la, "derive");
    if (ai < 0) {
        return base;
    }
    var an: Node = base.nodes[ai];
    var c: i64 = an.la;
    while (c >= 0) {
        var k: Child = base.kids[c];
        var arg: Node = base.nodes[k.val];
        if (arg.kind == "ident") {
            append(dt_traits, arg.sa);
        }
        if (arg.kind == "list") {
            var c2: i64 = arg.la;
            while (c2 >= 0) {
                var k2: Child = base.kids[c2];
                var v: Node = base.nodes[k2.val];
                if (v.kind == "ident") {
                    append(dt_traits, v.sa);
                }
                c2 = k2.next;
            }
        }
        c = k.next;
    }
    return base;
}

pub var df_names: []string;
pub var df_anns: []i64;

pub fn collect_fields(d: i64) i64 {
    var base: i64 = slice_len(df_names) as i64;
    var n: Node = base.nodes[d];
    if (n.kind == "VariantDecl") {
        return base;
    }
    if (n.kind == "StructDecl") {
        var c: i64 = n.lb;
        while (c >= 0) {
            var k: Child = base.kids[c];
            var f: Node = base.nodes[k.val];
            if (f.ia < 0) {
                append(df_names, f.sa);
                append(df_anns, f.la);
            }
            c = k.next;
        }
        return base;
    }
    if (n.kind == "EnumDecl" || n.kind == "UnionDecl") {
        var c2: i64 = n.lb;
        while (c2 >= 0) {
            var k2: Child = base.kids[c2];
            var f2: Node = base.nodes[k2.val];
            append(df_names, f2.sa);
            append(df_anns, f2.la);
            c2 = k2.next;
        }
    }
    return base;
}

// ── derive 代码生成（复刻 derive.ts；含 [object Object] 与
//    t 语法方法体等 tc0 bug，逐字节一致要求）───────────────────

pub fn gen_trait(trait: string, name: string, fb: i64, fe: i64) string {
    var sb: StringBuilder = sb_new();

    if (trait == "ToString") {
        sb_append_str(sb, "// @derive(ToString) — auto-generated\nto_string fn(self: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ") -> string {\n    return \"");
        sb_append_str(sb, name);
        sb_append_str(sb, " { ");
        var i: i64 = fb;
        while (i < fe) {
            if (i > fb) {
                sb_append_str(sb, ", ");
            }
            sb_append_str(sb, df_names[i]);
            sb_append_str(sb, "=$");
            sb_append_str(sb, df_names[i]);
            i = i + 1;
        }
        sb_append_str(sb, " }\";\n}");
        return sb_to_str(sb);
    }

    if (trait == "FromString") {
        sb_append_str(sb, "// @derive(FromString) — auto-generated\nfrom_string fn(s: string) -> ");
        sb_append_str(sb, name);
        sb_append_str(sb, " {\n    var result: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ";\n    // parse fields: ");
        var i2: i64 = fb;
        while (i2 < fe) {
            if (i2 > fb) {
                sb_append_str(sb, ", ");
            }
            sb_append_str(sb, df_names[i2]);
            i2 = i2 + 1;
        }
        sb_append_str(sb, "\n    return result;\n}");
        return sb_to_str(sb);
    }

    if (trait == "Clone") {
        sb_append_str(sb, "// @derive(Clone) — auto-generated\nclone fn(self: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ") -> ");
        sb_append_str(sb, name);
        sb_append_str(sb, " {\n    return ");
        sb_append_str(sb, name);
        sb_append_str(sb, " { ");
        var i3: i64 = fb;
        while (i3 < fe) {
            if (i3 > fb) {
                sb_append_str(sb, ", ");
            }
            sb_append_str(sb, df_names[i3]);
            sb_append_str(sb, ": self.");
            sb_append_str(sb, df_names[i3]);
            i3 = i3 + 1;
        }
        sb_append_str(sb, " };\n}");
        return sb_to_str(sb);
    }

    if (trait == "Copy") {
        sb_append_str(sb, "// @derive(Copy) — auto-generated\n// ");
        sb_append_str(sb, name);
        sb_append_str(sb, " is marked as Copy (bitwise copy on assignment)");
        return sb_to_str(sb);
    }

    if (trait == "DebugPrint") {
        sb_append_str(sb, "// @derive(DebugPrint) — auto-generated\ndebug_print fn(self: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ") -> string {\n    return \"");
        sb_append_str(sb, name);
        sb_append_str(sb, "(");
        var i4: i64 = fb;
        while (i4 < fe) {
            if (i4 > fb) {
                sb_append_str(sb, ", ");
            }
            sb_append_str(sb, df_names[i4]);
            sb_append_str(sb, ": {self.");
            sb_append_str(sb, df_names[i4]);
            sb_append_str(sb, "}");
            i4 = i4 + 1;
        }
        sb_append_str(sb, ")\";\n}");
        return sb_to_str(sb);
    }

    if (trait == "BinarySerde") {
        sb_append_str(sb, "// @derive(BinarySerde) — auto-generated\nserialize fn(self: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ") -> []u8 {\n");
        // serializeLines: filter 掉 @binary_skip，索引按过滤后数组计
        var cnt: i64 = 0;
        var i5: i64 = fb;
        while (i5 < fe) {
            if (parse.ann_find(df_anns[i5], "binary_skip") < 0) {
                if (cnt > 0) {
                    sb_append_str(sb, "\n");
                }
                sb_append_str(sb, "    // offset ");
                var oa: i64 = parse.ann_find(df_anns[i5], "binary_offset");
                var has_off: bool = false;
                if (oa >= 0) {
                    if (parse.ann_first_arg(oa) >= 0) {
                        has_off = true;
                    }
                }
                if (has_off) {
                    // tc0 bug: 模板串里插入 arg 对象 → "[object Object]"
                    sb_append_str(sb, "[object Object]");
                } else {
                    sb_append_i64(sb, cnt * 4);
                }
                sb_append_str(sb, ": write self.");
                sb_append_str(sb, df_names[i5]);
                cnt = cnt + 1;
            }
            i5 = i5 + 1;
        }
        sb_append_str(sb, "\n    return buffer;\n}\n\ndeserialize fn(data: []u8) -> ");
        sb_append_str(sb, name);
        sb_append_str(sb, " {\n    var result: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ";\n    // read fields from data at specified offsets\n    return result;\n}");
        return sb_to_str(sb);
    }

    if (trait == "Eq" || trait == "PartialEq") {
        sb_append_str(sb, "// @derive(Eq) — auto-generated\neq fn(self: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ", other: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ") -> bool {\n    return ");
        if (fb == fe) {
            sb_append_str(sb, "true");
        } else {
            var i6: i64 = fb;
            while (i6 < fe) {
                if (i6 > fb) {
                    sb_append_str(sb, " && ");
                }
                sb_append_str(sb, "self.");
                sb_append_str(sb, df_names[i6]);
                sb_append_str(sb, " == other.");
                sb_append_str(sb, df_names[i6]);
                i6 = i6 + 1;
            }
        }
        sb_append_str(sb, ";\n}");
        return sb_to_str(sb);
    }

    if (trait == "Hash") {
        sb_append_str(sb, "// @derive(Hash) — auto-generated\nhash fn(self: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ") -> u64 {\n    var hash: u64 = 0;\n");
        var i7: i64 = fb;
        while (i7 < fe) {
            if (i7 > fb) {
                sb_append_str(sb, "\n");
            }
            sb_append_str(sb, "    hash = hash_combine(hash, hash_of(self.");
            sb_append_str(sb, df_names[i7]);
            sb_append_str(sb, "));");
            i7 = i7 + 1;
        }
        sb_append_str(sb, "\n    return hash;\n}");
        return sb_to_str(sb);
    }

    return "";
}

pub fn process_derive(d: i64) void {
    var n: Node = base.nodes[d];
    var tb: i64 = collect_traits(d);
    var te: i64 = slice_len(dt_traits) as i64;
    if (tb == te) {
        return;
    }
    var fb: i64 = collect_fields(d);
    var fe: i64 = slice_len(df_names) as i64;
    var i: i64 = tb;
    while (i < te) {
        var code: string = gen_trait(dt_traits[i], n.sa, fb, fe);
        if (code != "") {
            spush(code);
            spush("");
        }
        i = i + 1;
    }
}

// ── emitAttributes（复刻 emitter.ts emitAttributes）────────────

pub fn emit_attributes(head: i64) string {
    var sb: StringBuilder = sb_new();
    var cnt: i64 = 0;
    var c: i64 = head;
    while (c >= 0) {
        var k: Child = base.kids[c];
        var a: Node = base.nodes[k.val];
        var s: string = "";
        var has: bool = false;
        if (a.sa == "inline") {
            s = "__attribute__((always_inline))";
            has = true;
        }
        if (a.sa == "no_inline") {
            s = "__attribute__((noinline))";
            has = true;
        }
        if (a.sa == "deprecated") {
            s = "__attribute__((deprecated))";
            var arg: i64 = parse.ann_first_arg(k.val);
            if (arg >= 0) {
                var an: Node = base.nodes[arg];
                if (an.kind == "string") {
                    s = base.sb_cat3("__attribute__((deprecated(\"", an.sa, "\")))");
                }
            }
            has = true;
        }
        if (a.sa == "must_use") {
            s = "__attribute__((warn_unused_result))";
            has = true;
        }
        if (a.sa == "export_symbol") {
            var arg2: i64 = parse.ann_first_arg(k.val);
            if (arg2 >= 0) {
                var an2: Node = base.nodes[arg2];
                if (an2.kind == "string") {
                    s = "__attribute__((visibility(\"default\")))";
                    has = true;
                }
            }
        }
        if (has) {
            if (cnt > 0) {
                sb_append_str(sb, " ");
            }
            sb_append_str(sb, s);
            cnt = cnt + 1;
        }
        c = k.next;
    }
    return sb_to_str(sb);
}

// ── 各声明 emitter（复刻 emitter.ts emitDecl 系列）─────────────

pub fn emit_struct_decl(d: i64) void {
    var n: Node = base.nodes[d];
    var attrs: string = emit_attributes(n.la);

    if (n.ba && n.has_sc) {
        hpush(base.sb_cat3("// @bitpack(", n.sc, ") struct"));
        if (attrs != "") {
            hpush(attrs);
        }
        hpush(base.sb_cat3("typedef struct ", n.sa, " {"));
        var c: i64 = n.lb;
        while (c >= 0) {
            var k: Child = base.kids[c];
            var f: Node = base.nodes[k.val];
            var fsb: StringBuilder = sb_new();
            sb_append_str(fsb, "    ");
            sb_append_str(fsb, scalar_to_c(n.sc));
            sb_append_str(fsb, " ");
            sb_append_str(fsb, f.sa);
            sb_append_str(fsb, " : ");
            sb_append_i64(fsb, f.ia);
            sb_append_str(fsb, ";");
            hpush(sb_to_str(fsb));
            c = k.next;
        }
        hpush(base.sb_cat3("} ", n.sa, ";"));
    } else {
        var layout_attr: string = "";
        if (n.sb == "soa") {
            layout_attr = " // #soa layout";
        }
        if (attrs != "") {
            hpush(attrs);
        }
        hpush(base.sb_cat4("typedef struct ", n.sa, " {", layout_attr));
        var c2: i64 = n.lb;
        while (c2 >= 0) {
            var k2: Child = base.kids[c2];
            var f2: Node = base.nodes[k2.val];
            if (f2.ia < 0) {
                var fattrs: string = emit_attributes(f2.la);
                if (fattrs != "") {
                    hpush(base.sb_cat2("    ", fattrs));
                }
                hpush(base.sb_cat3("    ", c_decl_of_node(f2.na, f2.sa), ";"));
            }
            c2 = k2.next;
        }
        hpush(base.sb_cat3("} ", n.sa, ";"));
    }

    process_derive(d);
}

pub fn emit_enum_decl(d: i64) void {
    var n: Node = base.nodes[d];
    hpush(base.sb_cat6("typedef ", scalar_to_c(n.sb), " ", n.sa, ";", ""));
    hpush("");
    var auto_val: i64 = 0;
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = base.kids[c];
        var v: Node = base.nodes[k.val];
        if (v.na >= 0) {
            hpush(base.sb_cat6("#define ", n.sa, "_", v.sa, " ", emit_expr(v.na)));
            var vn: Node = base.nodes[v.na];
            if (vn.kind == "int") {
                auto_val = sema.js_parse_int(vn.sa, vn.ia) + 1;
            }
        } else {
            hpush(base.sb_cat6("#define ", n.sa, "_", v.sa, " ", base.i2s(auto_val)));
            auto_val = auto_val + 1;
        }
        c = k.next;
    }
}

pub fn emit_flag_decl(d: i64) void {
    var n: Node = base.nodes[d];
    hpush(base.sb_cat4("// flag[", n.sb, "] ", n.sa));
    hpush(base.sb_cat6("typedef ", scalar_to_c(n.sb), " ", n.sa, ";", ""));
    hpush("");

    var base: i64 = fr_layout(d);
    var total: i64 = slice_len(fl_names) as i64;
    var i: i64 = base;
    while (i < total) {
        if (fl_lens[i] == 1) {
            var ssb: StringBuilder = sb_new();
            sb_append_str(ssb, "#define ");
            sb_append_str(ssb, n.sa);
            sb_append_str(ssb, "_");
            sb_append_str(ssb, fl_names[i]);
            sb_append_str(ssb, " (1u << ");
            sb_append_i64(ssb, fl_starts[i]);
            sb_append_str(ssb, ")");
            hpush(sb_to_str(ssb));
        } else {
            var csb: StringBuilder = sb_new();
            sb_append_str(csb, "// ");
            sb_append_str(csb, fl_names[i]);
            sb_append_str(csb, ": bits ");
            sb_append_i64(csb, fl_starts[i]);
            sb_append_str(csb, "-");
            sb_append_i64(csb, fl_ends[i] - 1);
            sb_append_str(csb, " (");
            sb_append_i64(csb, fl_lens[i]);
            sb_append_str(csb, " bits, max=");
            sb_append_i64(csb, js_max_val(fl_lens[i]));
            sb_append_str(csb, ")");
            hpush(sb_to_str(csb));
            var hsb: StringBuilder = sb_new();
            sb_append_str(hsb, "#define ");
            sb_append_str(hsb, n.sa);
            sb_append_str(hsb, "_");
            sb_append_str(hsb, fl_names[i]);
            sb_append_str(hsb, "_SHIFT ");
            sb_append_i64(hsb, fl_starts[i]);
            hpush(sb_to_str(hsb));
            var msb: StringBuilder = sb_new();
            sb_append_str(msb, "#define ");
            sb_append_str(msb, n.sa);
            sb_append_str(msb, "_");
            sb_append_str(msb, fl_names[i]);
            sb_append_str(msb, "_MASK (((1u << ");
            sb_append_i64(msb, fl_lens[i]);
            sb_append_str(msb, ") - 1) << ");
            sb_append_i64(msb, fl_starts[i]);
            sb_append_str(msb, ")");
            hpush(sb_to_str(msb));
        }
        i = i + 1;
    }
}

pub fn emit_flag_set_decl(d: i64) void {
    var n: Node = base.nodes[d];
    hpush(base.sb_cat3("// flag_set ", n.sa, " (dynamic length bitfield)"));
    hpush(base.sb_cat3("typedef struct ", n.sa, " {"));
    hpush("    uint8_t* data;");
    hpush("    size_t bit_count;");
    hpush("    size_t byte_count;");
    hpush(base.sb_cat3("} ", n.sa, ";"));
    hpush("");

    var base: i64 = fr_layout(d);
    var total: i64 = slice_len(fl_names) as i64;
    var i: i64 = base;
    while (i < total) {
        var csb: StringBuilder = sb_new();
        sb_append_str(csb, "// ");
        sb_append_str(csb, fl_names[i]);
        sb_append_str(csb, ": bits ");
        sb_append_i64(csb, fl_starts[i]);
        sb_append_str(csb, "-");
        sb_append_i64(csb, fl_ends[i] - 1);
        sb_append_str(csb, " (");
        sb_append_i64(csb, fl_lens[i]);
        sb_append_str(csb, " bits)");
        hpush(sb_to_str(csb));
        var hsb: StringBuilder = sb_new();
        sb_append_str(hsb, "#define ");
        sb_append_str(hsb, n.sa);
        sb_append_str(hsb, "_");
        sb_append_str(hsb, fl_names[i]);
        sb_append_str(hsb, "_SHIFT ");
        sb_append_i64(hsb, fl_starts[i]);
        hpush(sb_to_str(hsb));
        var msb: StringBuilder = sb_new();
        sb_append_str(msb, "#define ");
        sb_append_str(msb, n.sa);
        sb_append_str(msb, "_");
        sb_append_str(msb, fl_names[i]);
        sb_append_str(msb, "_MASK (((1u << ");
        sb_append_i64(msb, fl_lens[i]);
        sb_append_str(msb, ") - 1) << ");
        sb_append_i64(msb, fl_starts[i]);
        sb_append_str(msb, ")");
        hpush(sb_to_str(msb));
        i = i + 1;
    }
}

pub fn emit_union_decl(d: i64) void {
    var n: Node = base.nodes[d];
    hpush(base.sb_cat3("typedef union ", n.sa, " {"));
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = base.kids[c];
        var m: Node = base.nodes[k.val];
        hpush(base.sb_cat6("    ", emit_ctype(m.na), " ", m.sa, ";", ""));
        c = k.next;
    }
    hpush(base.sb_cat3("} ", n.sa, ";"));
}

// 载荷类型（含指针/切片/数组/可选的目标）里是否出现 variant 自身名 —— 用于判断
// 是否需要前向 typedef（`IList* _f1;` 写在 `typedef struct IList {...} IList;` 内部时，
// typedef 名尚未可见，必须先前向声明）。
pub fn c_type_mentions_name(tn: i64, vname: string) bool {
    if (tn < 0) {
        return false;
    }
    var t: Node = base.nodes[tn];
    if (t.kind == "named") {
        return t.sa == vname;
    }
    if (t.kind == "pointer" || t.kind == "slice" || t.kind == "array" || t.kind == "optional"
        || t.kind == "vector") {
        return c_type_mentions_name(t.na, vname);
    }
    return false;
}

pub fn c_variant_is_recursive(d: i64) bool {
    var n: Node = base.nodes[d];
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = base.kids[c];
        var vc: Node = base.nodes[k.val];
        if (vc.lb >= 0) {
            var mp: i64 = vc.lb;
            while (mp >= 0) {
                if (c_type_mentions_name(base.kids[mp].val, n.sa)) {
                    return true;
                }
                mp = base.kids[mp].next;
            }
        } else if (c_type_mentions_name(vc.na, n.sa)) {
            return true;
        }
        c = k.next;
    }
    return false;
}

// Variant：tagged union。发射 struct { uint32_t _tag; union { 载荷 _uN; } _u; } 及各 case 的
// static inline 构造器/判别器/取载荷（直接落头文件，函数体用 StringBuilder 拼 tag 整数）。
pub fn emit_variant_decl(d: i64) void {
    var n: Node = base.nodes[d];
    var hsb: StringBuilder = sb_new();
    sb_append_str(hsb, "// variant ");
    sb_append_str(hsb, n.sa);
    hpush(sb_to_str(hsb));
    // 递归 variant：先前向 typedef，使载荷里的 `<N>*` 可用。
    // 仅递归时发射 —— 非递归 variant 的头文件字节保持不变。
    if (c_variant_is_recursive(d)) {
        hpush(base.sb_cat3("typedef struct ", n.sa, base.sb_cat3(" ", n.sa, ";")));
    }
    hpush(base.sb_cat3("typedef struct ", n.sa, " {"));
    hpush("    uint32_t _tag;");
    hpush("    union {");
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = base.kids[c];
        var vc: Node = base.nodes[k.val];
        if (vc.na >= 0) {
            var us: StringBuilder = sb_new();
            sb_append_str(us, "        ");
            if (vc.lb >= 0) {
                // 多载荷：匿名 struct { T0 _f0; T1 _f1; ... }
                sb_append_str(us, "struct {");
                var t: i64 = vc.lb;
                var fi: i64 = 0;
                while (t >= 0) {
                    sb_append_str(us, " ");
                    sb_append_str(us, emit_ctype(base.kids[t].val));
                    sb_append_str(us, " _f");
                    sb_append_i64(us, fi);
                    sb_append_str(us, ";");
                    t = base.kids[t].next;
                    fi = fi + 1;
                }
                sb_append_str(us, " }");
            } else {
                sb_append_str(us, emit_ctype(vc.na));
            }
            sb_append_str(us, " _u");
            sb_append_i64(us, vc.ia);
            sb_append_str(us, ";");
            hpush(sb_to_str(us));
        }
        c = k.next;
    }
    hpush("    } _u;");
    hpush(base.sb_cat3("} ", n.sa, ";"));
    hpush("");

    c = n.lb;
    while (c >= 0) {
        var k2: Child = base.kids[c];
        var vc2: Node = base.nodes[k2.val];
        var cname: string = vc2.sa;
        // 构造器
        var fsb: StringBuilder = sb_new();
        sb_append_str(fsb, "static inline ");
        sb_append_str(fsb, n.sa);
        sb_append_str(fsb, " ");
        sb_append_str(fsb, n.sa);
        sb_append_str(fsb, "_from_");
        sb_append_str(fsb, cname);
        if (vc2.lb >= 0) {
            // 多载荷：(T0 v0, T1 v1, ...)
            sb_append_str(fsb, "(");
            var t: i64 = vc2.lb;
            var fi: i64 = 0;
            while (t >= 0) {
                if (fi > 0) {
                    sb_append_str(fsb, ", ");
                }
                sb_append_str(fsb, emit_ctype(base.kids[t].val));
                sb_append_str(fsb, " v");
                sb_append_i64(fsb, fi);
                t = base.kids[t].next;
                fi = fi + 1;
            }
            sb_append_str(fsb, ") {");
        } else if (vc2.na >= 0) {
            sb_append_str(fsb, "(");
            sb_append_str(fsb, emit_ctype(vc2.na));
            sb_append_str(fsb, " v) {");
        } else {
            sb_append_str(fsb, "(void) {");
        }
        hpush(sb_to_str(fsb));
        hpush(base.sb_cat3("    ", n.sa, " _s;"));
        var tsb: StringBuilder = sb_new();
        sb_append_str(tsb, "    _s._tag = ");
        sb_append_i64(tsb, vc2.ia);
        sb_append_str(tsb, ";");
        hpush(sb_to_str(tsb));
        if (vc2.lb >= 0) {
            // 多载荷：逐字段赋值 `_s._u._uN._fK = vK;`
            // （C 的 brace-init 只能用于初始化，不能用于赋值；匿名 struct 也无法写复合字面量）
            var t2: i64 = vc2.lb;
            var fi2: i64 = 0;
            while (t2 >= 0) {
                var asb: StringBuilder = sb_new();
                sb_append_str(asb, "    _s._u._u");
                sb_append_i64(asb, vc2.ia);
                sb_append_str(asb, "._f");
                sb_append_i64(asb, fi2);
                sb_append_str(asb, " = v");
                sb_append_i64(asb, fi2);
                sb_append_str(asb, ";");
                hpush(sb_to_str(asb));
                t2 = base.kids[t2].next;
                fi2 = fi2 + 1;
            }
        } else if (vc2.na >= 0) {
            var asb: StringBuilder = sb_new();
            sb_append_str(asb, "    _s._u._u");
            sb_append_i64(asb, vc2.ia);
            sb_append_str(asb, " = v;");
            hpush(sb_to_str(asb));
        }
        hpush("    return _s;");
        hpush("}");
        // 判别器
        var isb: StringBuilder = sb_new();
        sb_append_str(isb, "static inline bool ");
        sb_append_str(isb, n.sa);
        sb_append_str(isb, "_is_");
        sb_append_str(isb, cname);
        sb_append_str(isb, "(");
        sb_append_str(isb, n.sa);
        sb_append_str(isb, " self) {");
        hpush(sb_to_str(isb));
        var isb2: StringBuilder = sb_new();
        sb_append_str(isb2, "    return self._tag == ");
        sb_append_i64(isb2, vc2.ia);
        sb_append_str(isb2, ";");
        hpush(sb_to_str(isb2));
        hpush("}");
        // 取载荷：多载荷逐字段访问器 _as_C_f0 / _f1 / ...；单载荷 _as_C
        if (vc2.lb >= 0) {
            var t: i64 = vc2.lb;
            var fi: i64 = 0;
            while (t >= 0) {
                var asb2: StringBuilder = sb_new();
                sb_append_str(asb2, "static inline ");
                sb_append_str(asb2, emit_ctype(base.kids[t].val));
                sb_append_str(asb2, " ");
                sb_append_str(asb2, n.sa);
                sb_append_str(asb2, "_as_");
                sb_append_str(asb2, cname);
                sb_append_str(asb2, "_f");
                sb_append_i64(asb2, fi);
                sb_append_str(asb2, "(");
                sb_append_str(asb2, n.sa);
                sb_append_str(asb2, " self) {");
                hpush(sb_to_str(asb2));
                var asb3: StringBuilder = sb_new();
                sb_append_str(asb3, "    return self._u._u");
                sb_append_i64(asb3, vc2.ia);
                sb_append_str(asb3, "._f");
                sb_append_i64(asb3, fi);
                sb_append_str(asb3, ";");
                hpush(sb_to_str(asb3));
                hpush("}");
                t = base.kids[t].next;
                fi = fi + 1;
            }
        } else if (vc2.na >= 0) {
            var asb2: StringBuilder = sb_new();
            sb_append_str(asb2, "static inline ");
            sb_append_str(asb2, emit_ctype(vc2.na));
            sb_append_str(asb2, " ");
            sb_append_str(asb2, n.sa);
            sb_append_str(asb2, "_as_");
            sb_append_str(asb2, cname);
            sb_append_str(asb2, "(");
            sb_append_str(asb2, n.sa);
            sb_append_str(asb2, " self) {");
            hpush(sb_to_str(asb2));
            var asb3: StringBuilder = sb_new();
            sb_append_str(asb3, "    return self._u._u");
            sb_append_i64(asb3, vc2.ia);
            sb_append_str(asb3, ";");
            hpush(sb_to_str(asb3));
            hpush("}");
        }
        c = k2.next;
    }
    hpush("");
}

pub fn emit_func_decl(d: i64) void {
    var n: Node = base.nodes[d];
    var emit_name: string = n.sa;
    if (parse.ann_find(n.la, "main") >= 0) {
        emit_name = base.sb_cat2("t_entry_", n.sa);
        em_main_fn = emit_name;
        em_has_main = true;
    }
    var attrs: string = emit_attributes(n.la);

    // C 互操作导出：计算 C ABI 平铺入口名（clean name，无 env 首参）
    var cx_name: string = "";
    var cx_self: bool = false;
    var cx_fwd: bool = false;
    if (n.be && n.ba == false && parse.ann_find(n.la, "main") < 0) {
        cx_name = n.se;
        if (cx_name != "" && cx_name == emit_name) {
            cx_self = true;       // 入口模块：函数名已是 clean name，仅补 extern "C"
        } else if (cx_name != "") {
            cx_fwd = true;        // 跨模块：clean name ≠ 函数名，发转发器
        }
    }

    var psb: StringBuilder = sb_new();
    var cnt: i64 = 0;
    // 带捕获的合成闭包函数（M48）：env 指针为首参，与 TClosure ABI 一致
    if (str_len(n.sb) > 0) {
        sb_append_str(psb, "void* __env");
        cnt = 1;
    }
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = base.kids[c];
        var p: Node = base.nodes[k.val];
        if (cnt > 0) {
            sb_append_str(psb, ", ");
        }
        sb_append_str(psb, c_decl_of_node(p.na, p.sa));
        cnt = cnt + 1;
        c = k.next;
    }
    var param_str: string = "void";
    if (cnt > 0) {
        param_str = sb_to_str(psb);
    }
    // 返回函数指针的函数必须写成 `Ret (*name(params))(Args)`——把 `name(params)`
    // 整体当作声明子塞进函数指针声明里，不能拼成 `Ret (*)(Args) name(params)`。
    var sig: string = c_decl_of_node(n.na, base.sb_cat4(emit_name, "(", param_str, ")"));

    if (n.ba) {
        if (attrs != "") {
            hpush(attrs);
        }
        hpush(base.sb_cat2(sig, ";"));
        return;
    }

    if (attrs != "") {
        hpush(attrs);
    }
    hpush(base.sb_cat2(sig, ";"));

    em_cur_fn = n.sa;
    em_in_fn = true;
    em_cur_ret = sema.resolve_type_desc(n.na);
    g_defer_n = 0;   // 每个函数独立延迟栈
    spush(base.sb_cat2(sig, " {"));
    if (n.lc > -2) {
        var b: i64 = n.lc;
        while (b >= 0) {
            var bk: Child = base.kids[b];
            emit_stmt(bk.val, 1);
            b = bk.next;
        }
    }
    // 函数正常结束（无显式 return）：运行剩余 defer（LIFO）
    {
        var di: i64 = g_defer_n - 1;
        while (di >= 0) {
            var dnode: Node = base.nodes[g_defer[di]];
            spush("    {");
            var dbb: i64 = dnode.la;
            while (dbb >= 0) {
                var dbk: Child = base.kids[dbb];
                emit_stmt(dbk.val, 2);
                dbb = dbk.next;
            }
            spush("    }");
            di = di - 1;
        }
        g_defer_n = 0;
    }
    spush("}");
    em_in_fn = false;
    em_cur_fn = "";
    em_cur_ret = -1;
    spush("");

    // C 互操作导出：发 `extern "C"` 平铺转发器（clean name → 真函数名）
    if (cx_fwd) {
        var ret_ty: string = emit_ctype(n.na);
        var asb: StringBuilder = sb_new();
        var ac: i64 = 0;
        var pc: i64 = n.lb;
        while (pc >= 0) {
            var pk: Child = base.kids[pc];
            var pp: Node = base.nodes[pk.val];
            if (ac > 0) { sb_append_str(asb, ", "); }
            sb_append_str(asb, pp.sa);
            ac = ac + 1;
            pc = pk.next;
        }
        var arg_str: string = "";
        if (ac > 0) { arg_str = sb_to_str(asb); }
        var fsb: StringBuilder = sb_new();
        sb_append_str(fsb, ret_ty);
        sb_append_str(fsb, " ");
        sb_append_str(fsb, cx_name);
        sb_append_str(fsb, "(");
        sb_append_str(fsb, param_str);
        sb_append_str(fsb, ") {");
        spush(sb_to_str(fsb));
        if (ret_ty == "void") {
            spush(base.sb_cat5("    ", emit_name, "(", arg_str, ");"));
        } else {
            spush(base.sb_cat5("    return ", emit_name, "(", arg_str, ");"));
        }
        spush("}");
        spush("");
    }
}

pub fn emit_global_var(d: i64) void {
    var n: Node = base.nodes[d];
    hpush(base.sb_cat3("extern ", c_decl_of_node(n.na, n.sa), ";"));
    // Sym 全局变量：字段仅存 u32/u16 id。无初始化 → 零值；`= "str"` →
    // 运行期 intern（函数调用），须搬进 t__ginit（C 文件作用域不允许调用）。
    var gtd0: i64 = sema.resolve_type_desc(n.na);
    var gt0: TD = sema.tds[gtd0];
    if (gt0.cat == "sym") {
        var symcty: string = emit_ctype(n.na);
        if (n.nb < 0) {
            spush(base.sb_cat5(symcty, " ", n.sa, ";", ""));
            return;
        }
        var symtagl: string = base.sb_cat3("TSTR_LIT(\"", esc_c(gt0.name), "\")");
        var symintr: string = base.sb_cat6("t_sym_intern(", symtagl, ", ", emit_expr(n.nb), ", ", base.sb_cat2(base.i2s(gt0.alen), ")"));
        spush(base.sb_cat5(symcty, " ", n.sa, ";", ""));
        append(glines, base.sb_cat4("    ", n.sa, " = ", base.sb_cat2(symintr, ";")));
        return;
    }
    // 定长数组全局：C 后端把 [N]T 表示为 T*，但指针本身没有存储 → 须分配定长缓冲并让
    // 变量指向它，否则 g_fc_d[0] = x 之类会写 NULL 地址（LLVM 后端用 [N x T]，无此问题）。
    if (gt0.cat == "array" && gt0.alen > 0) {
        var gaecy: string = desc_to_c(gt0.elem);
        var gabuf: string = base.sb_cat2(n.sa, "_abuf");
        var gadim: string = base.sb_cat3("[", base.i2s(gt0.alen), "]");
        if (n.nb < 0) {
            spush(base.sb_cat4(gaecy, " ", gabuf, base.sb_cat2(gadim, ";")));
        } else {
            spush(base.sb_cat5(gaecy, " ", gabuf, gadim, base.sb_cat3(" = ", emit_expr(n.nb), ";")));
        }
        spush(base.sb_cat5(gaecy, "* ", n.sa, " = ", base.sb_cat2(gabuf, ";")));
        return;
    }
    if (n.nb < 0) {
        spush(base.sb_cat2(c_decl_of_node(n.na, n.sa), ";"));
        return;
    }
    // 先在重定向模式下发射初始化器：若它产生了辅助语句（如 map 字面量的
    // t_map_new/t_map_put），说明不是 C 的编译期常量，须搬进 t__ginit。
    var gbase: i64 = slice_len(glines) as i64;
    g_spush_to_ginit = true;
    g_stmt_pad = "    ";
    var gv: string = emit_expr(n.nb);
    g_spush_to_ginit = false;
    g_stmt_pad = "";
    if ((slice_len(glines) as i64) > gbase) {
        spush(base.sb_cat2(c_decl_of_node(n.na, n.sa), ";"));
        append(glines, base.sb_cat4("    ", n.sa, " = ", base.sb_cat2(gv, ";")));
        return;
    }
    spush(base.sb_cat4(c_decl_of_node(n.na, n.sa), " = ", gv, ";"));
}

pub fn emit_global_const(d: i64) void {
    var n: Node = base.nodes[d];
    hpush(base.sb_cat6("#define ", n.sa, " (", emit_expr(n.nb), ")", ""));
}

pub fn emit_decl(d: i64) void {
    var n: Node = base.nodes[d];
    if (n.kind == "StructDecl") {
        emit_struct_decl(d);
        return;
    }
    if (n.kind == "EnumDecl") {
        emit_enum_decl(d);
        return;
    }
    if (n.kind == "FlagDecl") {
        emit_flag_decl(d);
        return;
    }
    if (n.kind == "FlagSetDecl") {
        emit_flag_set_decl(d);
        return;
    }
    if (n.kind == "UnionDecl") {
        emit_union_decl(d);
        return;
    }
    if (n.kind == "VariantDecl") {
        emit_variant_decl(d);
        return;
    }
    if (n.kind == "FuncDecl") {
        if (sema.func_is_generic(d)) { return; }
        emit_func_decl(d);
        return;
    }
    if (n.kind == "GlobalVarDecl") {
        emit_global_var(d);
        return;
    }
    if (n.kind == "GlobalConstDecl") {
        emit_global_const(d);
        return;
    }
    if (n.kind == "ImportDecl") {
        hpush(base.sb_cat3("#include \"", n.sb, "\""));
        return;
    }
    if (n.kind == "ImportModDecl") {
        // 模块导入（M-Module）：单文件 tc 不解析模块，发射期不产生任何 C 输出；
        // 模块解析与头文件内联由 tote 构建层完成。
        return;
    }
    if (n.kind == "TypeAliasDecl") {
        hpush(base.sb_cat6("typedef ", emit_ctype(n.na), " ", n.sa, ";", ""));
        return;
    }
}

// ── Flag 操作宏（复刻 emitFlagMacros）──────────────────────────

pub fn emit_flag_macros() void {
    hpush("");
    hpush("// ── Flag operations (spec 6.4) ──");
    hpush("// 1-bit: use | & ^ operators, check with (mask & FLAG) != 0");
    hpush("// multi-bit: use flag_set_val/flag_get_val macros");
    hpush("");
    hpush("#define flag_set_val(flags, shift, mask, val) do { (flags) = ((flags) & ~(mask)) | (((val) << (shift)) & (mask)); } while(0)");
    hpush("#define flag_get_val(flags, shift, mask) (((flags) & (mask)) >> (shift))");
    hpush("");
}

// ── emit 编排（复刻 CEmitter.emit）─────────────────────────────

// ── 函数值闭包的 C 侧落地（FuncType v2 / M47）───────────────────
// 顶层具名函数的 C 定义是 `Ret g(Args)`，没有 env 首参；而函数**值**的统一
// 调用约定是 `Ret (*)(void* env, Args)`。直接强转会让 env 挤掉首个真实参数，
// 故为每个被取值的函数生成一层 static trampoline 吃掉 env 再转发：
//
//   static Ret __tramp_g(void* __env, A0 __a0, A1 __a1) {
//       (void)__env; return g(__a0, __a1);
//   }
//   static TClosure __tclos_g = { (void*)__tramp_g, NULL };
//
// 输出进头文件尾部：此时全部函数原型已在其上方，且生成的 .c 首行即 #include
// 该头文件，故所有函数体引用 `(&__tclos_g)` 时它已定义。
pub fn emit_c_closures() void {
    var cn: i64 = slice_len(clos_names) as i64;
    if (cn == 0) {
        return;
    }
    hpush("");
    hpush("// ── 函数值闭包（FuncType v2）：trampoline + 静态闭包记录 ──");
    var i: i64 = 0;
    while (i < cn) {
        var nm: string = clos_names[i];
        var d: i64 = clos_decl_of(nm);
        if (d >= 0) {
            var dn: Node = base.nodes[d];
            var callee: string = nm;
            if (parse.ann_find(dn.la, "main") >= 0) {
                callee = base.sb_cat2("t_entry_", nm);
            }
            var rty: string = emit_ctype(dn.na);
            var psb: StringBuilder = sb_new();
            var asb: StringBuilder = sb_new();
            sb_append_str(psb, "void* __env");
            var c: i64 = dn.lb;
            var pi: i64 = 0;
            while (c >= 0) {
                var k: Child = base.kids[c];
                var p: Node = base.nodes[k.val];
                var pn: string = base.sb_cat2("__a", base.i2s(pi));
                sb_append_str(psb, ", ");
                sb_append_str(psb, c_decl_of_node(p.na, pn));
                if (pi > 0) {
                    sb_append_str(asb, ", ");
                }
                sb_append_str(asb, pn);
                pi = pi + 1;
                c = k.next;
            }
            hpush(base.sb_cat6("static ", rty, " __tramp_", nm, "(", base.sb_cat2(sb_to_str(psb), ") {")));
            hpush("    (void)__env;");
            if (rty == "void") {
                hpush(base.sb_cat5("    ", callee, "(", sb_to_str(asb), ");"));
            } else {
                hpush(base.sb_cat5("    return ", callee, "(", sb_to_str(asb), ");"));
            }
            hpush("}");
            hpush(base.sb_cat6("static TClosure __tclos_", nm, " = { (void*)__tramp_", nm, ", NULL };", ""));
        }
        i = i + 1;
    }
}

// 全局 atom 名表（C 后端）：索引 0 为占位空串，其后按 g_atom_names 顺序；
// 因 atom_intern 返回 1-based id，故 t_atom_table[id] 直接命中（index 0 不用）。
// 运行时 t_atom_str(id) 经 extern 引用此表。无 atom 时也发射最小表以满足链接。
pub fn emit_c_atom_table() void {
    var cnt: i64 = sema.g_atom_cnt;
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "TStr t_atom_table[] = { TSTR_LIT(\"\")");
    var i: i64 = 0;
    while (i < cnt) {
        sb_append_str(sb, ", TSTR_LIT(\"");
        sb_append_str(sb, esc_c(sema.g_atom_names[i]));
        sb_append_str(sb, "\")");
        i = i + 1;
    }
    sb_append_str(sb, " };");
    spush(sb_to_str(sb));
    var sb2: StringBuilder = sb_new();
    sb_append_str(sb2, "int64_t t_atom_count = ");
    sb_append_i64(sb2, cnt + 1);
    sb_append_str(sb2, ";");
    spush(sb_to_str(sb2));
}

pub fn emit_unit(mod: string) void {
    var guard: string = base.sb_cat3("TC_", to_upper(mod), "_H");
    hpush(base.sb_cat2("#ifndef ", guard));
    hpush(base.sb_cat2("#define ", guard));
    hpush("");
    hpush("#include <stdint.h>");
    hpush("#include <stdbool.h>");
    hpush("#include <stddef.h>");
    hpush("#include \"t_runtime.h\"");
    hpush("");
    // type_info(T) 常量结构（M36）：TTypeInfo/TFieldInfo 由 t_runtime.h 提供，
    // 此处不再重复 typedef（否则与 t_runtime.h 重定义冲突）。

    spush(base.sb_cat3("#include \"", mod, ".h\""));
    spush("#include <stdio.h>");
    spush("#include <stdlib.h>");
    spush("#include <string.h>");
    spush("#include \"t_runtime.h\"");
    spush("");

    build_type_map();

    // 先按字段依赖拓扑排序，发射所有 struct/union/variant 族类型的完整定义。
    // 这保证被值内嵌的类型（如 entry 的 NpcState 内嵌 physics 的 Velocity）在引用
    // 之前已完整定义，消解跨模块 / 前向引用导致的 C 编译错误。
    emit_struct_families_ordered();

    var n: i64 = slice_len(lex.decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = lex.decl_list[i];
        var k: string = base.nodes[d].kind;
        // 已在上方按拓扑序发射，主循环跳过，避免重复定义。
        if (k == "StructDecl" || k == "UnionDecl" || k == "VariantDecl") {
            if (str_in_slice(g_emitted_structs, base.nodes[d].sa)) {
                i = i + 1;
                continue;
            }
        }
        emit_decl(lex.decl_list[i]);
        i = i + 1;
    }

    emit_c_atom_table();

    // type_info(T) 编译期常量（引用 StructDecl，须在类型定义后输出）
    var tln: i64 = slice_len(ti_lines) as i64;
    if (tln > 0) {
        spush("");
        var ti: i64 = 0;
        while (ti < tln) {
            spush(ti_lines[ti]);
            ti = ti + 1;
        }
    }

    // 全局 var 的运行期初始化器（非编译期常量）汇总为 t__ginit，在 main 开头调用
    var gn: i64 = slice_len(glines) as i64;
    if (gn > 0) {
        spush("");
        spush("static void t__ginit(void) {");
        var gi: i64 = 0;
        while (gi < gn) {
            spush(glines[gi]);
            gi = gi + 1;
        }
        spush("}");
    }

    if (em_has_main) {
        spush("");
        spush("int main(int argc, char** argv) {");
        spush("    t_runtime_init(argc, argv);");
        spush("    t_runtime_set_arena(t_arena_new());");
        if (gn > 0) {
            spush("    t__ginit();");
        }
        spush(base.sb_cat3("    int32_t _exit_code = ", em_main_fn, "();"));
        spush("    t_runtime_done();");
        spush("    return (int)_exit_code;");
        spush("}");
        spush("");
    }

    emit_flag_macros();

    // 函数值闭包须在全部函数原型之后落地（trampoline 要调用它们）
    emit_c_closures();

    hpush("");
    hpush(base.sb_cat2("#endif // ", guard));
}

// ── 输出行拼接（join("\n")，无末尾换行）────────────────────────

pub fn h_join() string {
    var sb: StringBuilder = sb_new();
    var n: i64 = slice_len(hlines) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (i > 0) {
            sb_append_str(sb, "\n");
        }
        sb_append_str(sb, hlines[i]);
        i = i + 1;
    }
    return sb_to_str(sb);
}

pub fn s_join() string {
    var sb: StringBuilder = sb_new();
    var n: i64 = slice_len(slines) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (i > 0) {
            sb_append_str(sb, "\n");
        }
        sb_append_str(sb, slines[i]);
        i = i + 1;
    }
    return sb_to_str(sb);
}



pub fn c_emit_accessor_call(cn: string, av: []string) string {
    var r: string = base.sb_cat2("t_", cn);
    r = base.sb_cat2(r, "(");
    var i: i64 = 0;
    var n: i64 = slice_len(av) as i64;
    while (i < n) {
        if (i > 0) { r = base.sb_cat2(r, ", "); }
        r = base.sb_cat2(r, av[i]);
        i = i + 1;
    }
    return base.sb_cat2(r, ")");
}


pub fn emit_type_info_c(tname: string) string {
    var gref: string = base.sb_cat2("&__ti_", tname);
    var di: i64 = 0;
    var dn2: i64 = slice_len(ti_done) as i64;
    while (di < dn2) {
        if (ti_done[di] == tname) { return gref; }
        di = di + 1;
    }
    var d: i64 = ti_struct_decl(tname);
    if (d < 0) {
        base.diag_new("T-CDE-E910", "error", base.sb_cat2("type_info: '", base.sb_cat2(tname, "' 不是 struct 类型（当前仅支持 struct）")), "", 1, 1, 1, 10);
        return "0";
    }
    append(ti_done, tname);
    // C 后端：type_info 常量定义在 t_entry_main 之后（emit 期才合成），
    // 但 C 的 static 先用后定义在同 TU 非法；故在 .h 内放前向声明。
    // （Point 等 struct 已落在 .h，故 .c 顶部 include 后即可见。）
    hpush(base.sb_cat3("static TTypeInfo __ti_", tname, ";"));
    hpush(base.sb_cat3("static TFieldInfo __ti_", tname, "_f[];"));
    var decl: Node = base.nodes[d];

    var fsb: StringBuilder = sb_new();
    sb_append_str(fsb, "static TFieldInfo __ti_");
    sb_append_str(fsb, tname);
    sb_append_str(fsb, "_f[] = { ");
    var n: i64 = 0;
    var c: i64 = decl.lb;
    while (c >= 0) {
        var k: Child = base.kids[c];
        var f: Node = base.nodes[k.val];
        if (f.ia < 0) {
            if (n > 0) { sb_append_str(fsb, ", "); }
            var ftd: i64 = sema.resolve_type_desc(f.na);
            var cty: string = emit_ctype(f.na);
            var isp: i64 = 0;
            if (is_ref_type(ftd)) { isp = 1; }
            sb_append_str(fsb, base.sb_cat3("{ TSTR_LIT(\"", esc_c(f.sa), "\"), "));
            sb_append_str(fsb, base.sb_cat5("offsetof(", tname, ", ", f.sa, "), "));
            sb_append_str(fsb, base.sb_cat3("TSTR_LIT(\"", esc_c(sema.td_readable(ftd)), "\"), "));
            sb_append_str(fsb, base.sb_cat3("sizeof(", cty, "), "));
            sb_append_i64(fsb, isp);
            sb_append_str(fsb, ", ");
            sb_append_i64(fsb, f.ib);   // 字段 tagID（@N 显式 / 全自动自动分配）
            sb_append_str(fsb, " }");
            n = n + 1;
        }
        c = k.next;
    }
    sb_append_str(fsb, " };");

    var tsb: StringBuilder = sb_new();
    sb_append_str(tsb, "static TTypeInfo __ti_");
    sb_append_str(tsb, tname);
    sb_append_str(tsb, base.sb_cat3(" = { TSTR_LIT(\"", esc_c(tname), "\"), "));
    sb_append_str(tsb, base.sb_cat3("sizeof(", tname, "), 0, "));
    sb_append_i64(tsb, n);
    sb_append_str(tsb, base.sb_cat3(", { __ti_", tname, "_f, "));
    sb_append_i64(tsb, n);
    sb_append_str(tsb, ", ");
    sb_append_i64(tsb, n);
    sb_append_str(tsb, ", (int64_t)sizeof(TFieldInfo) } };");
    // 字段数组必须先于 TTypeInfo 输出（后者引用前者）
    append(ti_lines, sb_to_str(fsb));
    append(ti_lines, sb_to_str(tsb));
    return gref;
}












// 按名查 StructDecl 节点下标。emit 期只能依赖 decl_list —— checker 的
// global_scope/syms 在发射阶段已不保证有效，用 sym_lookup 会取到野下标。
pub fn ti_struct_decl(tname: string) i64 {
    var n: i64 = slice_len(lex.decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = lex.decl_list[i];
        var dn: Node = base.nodes[d];
        if (dn.kind == "StructDecl" && dn.sa == tname) { return d; }
        i = i + 1;
    }
    return -1;
}


