// ══════════════════════════════════════════════════════════════════
// src/codegen_c.tc — 编译步骤 4a：C 后端
//
// 内容：M8 C Emitter —— 发射 .c/.h 源码，以及 emit 编排。
// 依赖：base, lex, parse, sema。
// ══════════════════════════════════════════════════════════════════

@import("src.base" :: *);
@import("src.lex" :: *);
@import("src.parse" :: *);
@import("src.sema" :: *);

// ═══════════════════════════════════════════════════════════════
// M8: C Emitter（复刻 tc0/codegen/emitter.ts）
// ═══════════════════════════════════════════════════════════════

// ── 输出行池 ───────────────────────────────────────────────────

pub var hlines: []string;   // headerLines
pub var slines: []string;   // sourceLines
pub var glines: []string;   // 全局初始化函数体（t__ginit）
// 重定向开关：为 true 时 spush 写入 glines（全局 var 初始化器需运行期构建，
// 如 map 字面量在 C 中不是编译期常量，必须搬进 t__ginit）。
pub var g_spush_to_ginit: bool = false;
// type_info(T) 编译期常量合成（M36）：去重表 + 模块级常量定义缓冲
pub var ti_lines: []string;
pub var ti_done: []string;

pub fn hpush(s: string) void {
    append(hlines, s);
}

pub fn spush(s: string) void {
    if (g_spush_to_ginit) {
        append(glines, s);
        return;
    }
    append(slines, s);
}

// 向最后一行追加文本（ForStmt 拼接用）
pub fn sappend_last(s: string) void {
    var n: i64 = slice_len(slines) as i64;
    var last: string = slines[n - 1];
    var joined: string = base.sb_cat2(last, s);
    slice_set(slines, n - 1, joined);
}

// ── 小工具 ─────────────────────────────────────────────────────

pub fn to_upper(s: string) string {
    var sb: StringBuilder = sb_new();
    var i: u64 = 0;
    var n: u64 = str_len(s);
    while (i < n) {
        var c: u8 = s[i];
        if (c >= 97 && c <= 122) {
            sb_append_char(sb, c - 32);
        } else {
            sb_append_char(sb, c);
        }
        i = i + 1;
    }
    return sb_to_str(sb);
}

pub fn ends_with_star(s: string) bool {
    var n: u64 = str_len(s);
    if (n == 0) {
        return false;
    }
    return s[n - 1] == 42;
}

// ── TypeDesc 池（复刻 TypeDesc interface）──────────────────────
// cat: "string" | "slice" | "map" | "named" | "scalar" | "unknown" | "void"

// TypeDesc 池（TD 结构、tds、tdf_*）已迁移至 src/sema.tc —— 由语义分析产出，本模块经 import 读取。


// 字段是否引用类型（指针/聚合，is_ptr=1）；标量/void 为 false
pub fn is_ref_type(td: i64) bool {
    if (td < 0) { return false; }
    var t: TD = sema.tds[td];
    if (t.cat == "scalar" || t.cat == "void" || t.cat == "unknown") { return false; }
    return true;
}



// ── 闭包表示（FuncType v2 / M47）───────────────────────────────
// 函数类型的**值**在两个后端都是「指向 TClosure { void* fn; void* env; } 的指针」：
//   C 后端    → TClosure*
//   LLVM 后端 → ptr（沿用 v1 的不透明指针，避开 Win64 聚合 ABI）
// 底层被调函数统一按 `Ret (*)(void* env, Args...)` 调用，env 为首参。
// 顶层具名函数（含提升后的 lambda）自身没有 env 首参，故「函数作为值」时经
// 一层 static trampoline 吃掉 env 再转发；捕获型闭包（Stage B2）则直接把提升
// 函数的 env 首参接上堆分配的环境记录。
//
// 调用点强转类型：`Ret (*)(void*, A0, A1)`（无名声明子）
pub fn td_func_c_fnptr(td: i64) string {
    var b: StringBuilder = sb_new();
    sb_append_str(b, desc_to_c(sema.tdf_ret[td]));
    sb_append_str(b, " (*)(void*");
    var i: i64 = 0;
    while (i < sema.tdf_pcount[td]) {
        sb_append_str(b, ", ");
        sb_append_str(b, desc_to_c(sema.tdf_params[sema.tdf_pstart[td] + i]));
        i = i + 1;
    }
    sb_append_str(b, ")");
    return sb_to_str(b);
}

// 该 TD 是否为函数类型
pub fn td_is_func(td: i64) bool {
    if (td < 0) { return false; }
    return sema.tds[td].cat == "func";
}

// 「被当作值使用」的顶层函数名，发射期惰性去重收集；全部函数体发射完毕后
// 统一生成 trampoline 与闭包全局（C 追加到头文件尾，LLVM 追加到模块尾）。
// 只有真正取值的函数才生成，避免为全库上千个函数产出无用代码。
pub var clos_names: []string;

pub fn clos_mark(name: string) void {
    var n: i64 = slice_len(clos_names) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (clos_names[i] == name) { return; }
        i = i + 1;
    }
    append(clos_names, name);
}

// 按名字回查顶层 FuncDecl 节点。只在生成 trampoline 时调用，规模 = 被取值的
// 函数个数（通常个位数），线性扫描无性能问题。
pub fn clos_decl_of(name: string) i64 {
    var n: i64 = slice_len(lex.decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = lex.decl_list[i];
        var dn: Node = base.nodes[d];
        if (dn.kind == "FuncDecl") {
            if (dn.sa == name) {
                return d;
            }
        }
        i = i + 1;
    }
    return -1;
}

// 间接调用点所需的函数类型 TD：局部变量优先，其次全局变量；顶层具名函数
// （tm 里有 "name()" 条目）不算间接调用。
pub fn clos_callee_td(cn: string) i64 {
    var td: i64 = -1;
    if (em_in_fn) {
        td = fs_get(em_cur_fn, mb_sub(cn));
    }
    if (td_is_func(td)) {
        return td;
    }
    if (sema.tm_get(base.sb_cat2(cn, "()")) >= 0) {
        return -1;
    }
    var g: i64 = sema.tm_get(mb_sub(cn));
    if (td_is_func(g)) {
        return g;
    }
    return -1;
}

// 「类型 + 名字」的 C 声明。函数类型已统一为 TClosure*（普通指针），
// 不再需要把名字嵌进函数指针声明子。
pub fn c_decl_of(td: i64, name: string) string {
    return base.sb_cat3(desc_to_c(td), " ", name);
}

// 指向该类型的 C 指针类型名
pub fn c_ptr_to(td: i64) string {
    return base.sb_cat2(desc_to_c(td), "*");
}

// 同上，但输入是类型节点（发射期大多数位置持有的是节点索引）
pub fn c_decl_of_node(tn: i64, name: string) string {
    return base.sb_cat3(emit_ctype(tn), " ", name);
}



// ── typeMap / fnScopes / structFields（扁平池，last-match-wins）─


pub var fs_fns: []string;     // 函数级 scope：函数名 + 变量名 → td
pub var fs_vars: []string;
pub var fs_tds: []i64;

pub var sf_structs: []string; // struct 字段：struct 名 + 字段名 → td
pub var sf_fields: []string;
pub var sf_tds: []i64;

pub var em_cur_fn: string;    // 当前作用域函数名（"" = 无）
pub var em_cur_ret: i64 = -1;  // 当前函数返回类型 TD（供 return 字面量切片识别）
pub var em_in_fn: bool;

pub var em_main_fn: string;   // @main 函数的 mangle 名
pub var em_has_main: bool;

// C 后端：按字段依赖拓扑排序后，已先发射的 struct 族类型名集合（供主循环跳过）。
// 原因：C 要求 struct 在被值内嵌（作为字段）之前已完整定义；而导入模块的 struct
// （如 physics 的 Position/Velocity）被追加在 entry 之后，按 decl_list 顺序发射会因
// 类型未完成而报错。拓扑排序保证「被依赖者先定义」。指针/切片字段不强制顺序。
pub var g_emitted_structs: []string;

// 判断字符串是否已在切片中（用于 g_emitted_structs 查重）。
pub fn str_in_slice(sl: []string, v: string) bool {
    var n: i64 = slice_len(sl) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (sl[i] == v) { return true; }
        i = i + 1;
    }
    return false;
}

// 按字段依赖拓扑排序，先发射所有 struct/union/variant 族类型的完整定义。
// 工作表算法：反复发射「依赖均已满足」的类型，直到无进展；残留（环等异常）原序补发。
pub fn emit_struct_families_ordered() void {
    var _empty: []string;
    g_emitted_structs = _empty;
    var sdecls: []i64;
    var snames: []string;
    var n: i64 = slice_len(lex.decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = lex.decl_list[i];
        var k: string = base.nodes[d].kind;
        if (k == "StructDecl" || k == "UnionDecl" || k == "VariantDecl") {
            append(sdecls, d);
            append(snames, base.nodes[d].sa);
        }
        i = i + 1;
    }
    var m: i64 = slice_len(sdecls) as i64;
    if (m == 0) { return; }
    var done: []bool;
    var di: i64 = 0;
    while (di < m) { append(done, false); di = di + 1; }

    var progressed: bool = true;
    var guard: i64 = 0;
    while (progressed) {
        progressed = false;
        var j: i64 = 0;
        while (j < m) {
            if (done[j]) { j = j + 1; continue; }
            var d: i64 = sdecls[j];
            var ok: bool = true;
            var depbuf: []string;
            var c: i64 = base.nodes[d].lb;
            while (c >= 0) {
                var f: Node = base.nodes[base.kids[c].val];
                if (f.na >= 0) {
                    var tn: i64 = f.na;
                    var tk: string = base.nodes[tn].kind;
                    if (tk == "named") {
                        append(depbuf, base.nodes[tn].sa);
                    } else if (tk == "array") {
                        var en: i64 = base.nodes[tn].na;
                        if (en >= 0 && base.nodes[en].kind == "named") {
                            append(depbuf, base.nodes[en].sa);
                        }
                    }
                }
                c = base.kids[c].next;
            }
            var dl: i64 = slice_len(depbuf) as i64;
            var kk: i64 = 0;
            while (kk < dl) {
                var dep: string = depbuf[kk];
                var is_sd: bool = false;
                var sd_idx: i64 = -1;
                var si: i64 = 0;
                while (si < m) {
                    if (snames[si] == dep) { is_sd = true; sd_idx = si; }
                    si = si + 1;
                }
                if (is_sd && done[sd_idx] == false) { ok = false; }
                kk = kk + 1;
            }
            if (ok) {
                var kk2: string = base.nodes[d].kind;
                if (kk2 == "StructDecl") { emit_struct_decl(d); }
                else if (kk2 == "UnionDecl") { emit_union_decl(d); }
                else if (kk2 == "VariantDecl") { emit_variant_decl(d); }
                append(g_emitted_structs, snames[j]);
                done[j] = true;
                progressed = true;
            }
            j = j + 1;
        }
        guard = guard + 1;
        if (guard > m + 2) { progressed = false; }
    }
    var j2: i64 = 0;
    while (j2 < m) {
        if (done[j2] == false) {
            var d: i64 = sdecls[j2];
            var kk2: string = base.nodes[d].kind;
            if (kk2 == "StructDecl") { emit_struct_decl(d); }
            else if (kk2 == "UnionDecl") { emit_union_decl(d); }
            else if (kk2 == "VariantDecl") { emit_variant_decl(d); }
            append(g_emitted_structs, snames[j2]);
            done[j2] = true;
        }
        j2 = j2 + 1;
    }
}

pub fn tm_set(name: string, td: i64) void {
    append(sema.tm_names, name);
    append(sema.tm_tds, td);
}


pub fn fs_set(fn_name: string, var_name: string, td: i64) void {
    append(fs_fns, fn_name);
    append(fs_vars, var_name);
    append(fs_tds, td);
}

pub fn fs_get(fn_name: string, var_name: string) i64 {
    var n: i64 = slice_len(fs_fns) as i64;
    var i: i64 = n - 1;
    while (i >= 0) {
        if (fs_fns[i] == fn_name && fs_vars[i] == var_name) {
            return fs_tds[i];
        }
        i = i - 1;
    }
    return -1;
}

pub fn sf_set(st: string, fname: string, td: i64) void {
    append(sf_structs, st);
    append(sf_fields, fname);
    append(sf_tds, td);
}

pub fn sf_get(st: string, fname: string) i64 {
    var n: i64 = slice_len(sf_structs) as i64;
    var i: i64 = n - 1;
    while (i >= 0) {
        if (sf_structs[i] == st && sf_fields[i] == fname) {
            return sf_tds[i];
        }
        i = i - 1;
    }
    return -1;
}

// ── scalarToC（复刻 emitter.ts scalarToC + emitType scalar map）─

// >>> GEN:scalar_ctype (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
pub fn scalar_to_c(name: string) string {
    if (name == "u8") { return "uint8_t"; }
    if (name == "u16") { return "uint16_t"; }
    if (name == "u32") { return "uint32_t"; }
    if (name == "u64") { return "uint64_t"; }
    if (name == "i8") { return "int8_t"; }
    if (name == "i16") { return "int16_t"; }
    if (name == "i32") { return "int32_t"; }
    if (name == "i64") { return "int64_t"; }
    if (name == "rune") { return "int32_t"; }
    if (name == "bytes") { return "TStr"; }
    if (name == "BytesBuilder") { return "TSb*"; }
    if (name == "f16") { return "_Float16"; }
    if (name == "f32") { return "float"; }
    if (name == "f64") { return "double"; }
    if (name == "bool") { return "bool"; }
    if (name == "void") { return "void"; }
    if (name == "atom") { return "int64_t"; }
    if (name == "fid") { return "int64_t"; }
    return name;
}
// <<< GEN:scalar_ctype <<<

// ── emitType（复刻 emitter.ts emitType；tn = 类型节点索引）─────

pub fn emit_ctype(tn: i64) string {
    if (tn < 0) {
        return "void";
    }
    var n: Node = base.nodes[tn];
    if (n.kind == "scalar") {
        if (n.sa == "string") { return "TStr"; }
        if (n.sa == "StringBuilder") { return "TSb*"; }
        if (n.sa == "bytes") { return "TStr"; }
        if (n.sa == "BytesBuilder") { return "TSb*"; }
        if (n.sa == "atom") { return "int64_t"; }
        return scalar_to_c(n.sa);
    }
    if (n.kind == "named") {
        // type_info 自省类型：C 后端一律按指针（与 LLVM 后端的 ptr 一致），
        // 因为运行时 t_ti_*/t_fi_* 接收 TTypeInfo*/TFieldInfo*。
        if (n.sa == "TypeInfo") { return "TTypeInfo*"; }
        if (n.sa == "FieldInfo") { return "TFieldInfo*"; }
        return n.sa;
    }
    if (n.kind == "array") {
        return base.sb_cat2(emit_ctype(n.na), "*");
    }
    if (n.kind == "slice") {
        return "TSlice";
    }
    if (n.kind == "map") {
        return "TMap*";
    }
    if (n.kind == "sym") {
        if (n.ia == 16) { return "uint16_t"; }
        return "uint32_t";
    }
    if (n.kind == "pointer") {
        return base.sb_cat2(emit_ctype(n.na), "*");
    }
    if (n.kind == "optional") {
        return base.sb_cat2(emit_ctype(n.na), "*");
    }
    if (n.kind == "flag") {
        return n.sa;
    }
    if (n.kind == "flag_set") {
        return "void*";
    }
    if (n.kind == "variant") {
        return "void*";
    }
    if (n.kind == "func_type") {
        return "TClosure*";
    }
    // 硬件 SIMD 向量 `@Vector(len, T)`：映射为 GCC/Clang 的 vector_size 属性类型，
    // 直接对应 CPU 向量寄存器（SSE/AVX/AVX-512）。lane 数取自 ia（sema resolve 期已折叠）。
    if (n.kind == "vector") {
        var lane: string = emit_ctype(n.na);
        var vlen: i64 = n.ia;
        if (vlen < 1) { vlen = sema.vec_fold_len(tn); }
        if (vlen < 1) { vlen = 1; }
        var bytes: i64 = vlen * c_scalar_sizeof(lane);
        return base.sb_cat5(lane, " __attribute__((vector_size(", base.i2s(bytes), ")))", "");
    }
    return "void";
}

// 标量 C 类型名的字节宽度（向量 vector_size 计算用）。未知类型按 4 字节兜底。
pub fn c_scalar_sizeof(name: string) i64 {
    if (name == "int8_t" || name == "uint8_t" || name == "bool") { return 1; }
    if (name == "int16_t" || name == "uint16_t") { return 2; }
    if (name == "int32_t" || name == "uint32_t" || name == "float") { return 4; }
    if (name == "int64_t" || name == "uint64_t" || name == "double") { return 8; }
    return 4;
}

// 由向量类型节点（na=lane 类型, ia=lane 数）取 lane 数（ia 优先，否则折叠）。
pub fn c_vec_len(tn: i64) i64 {
    var v: i64 = base.nodes[tn].ia;
    if (v < 1) { v = sema.vec_fold_len(tn); }
    if (v < 1) { v = 1; }
    return v;
}

// ── resolveTypeDesc（复刻 emitter.ts resolveTypeDesc）──────────


// ── tiToTd：TI → TD 转换（map 字面量作为表达式时需从推断类型取元素 TD）──
pub fn ti_to_td(ti: i64) i64 {
    if (ti < 0) {
        return sema.td_mk("unknown");
    }
    var t: TI = sema.tis[ti];
    if (t.kind == "Scalar") { return sema.td_named_mk("scalar", t.name); }
    if (t.kind == "String") { return sema.td_mk("string"); }
    if (t.kind == "StringBuilder") { return sema.td_named_mk("named", "TSb*"); }
    if (t.kind == "Bytes") { return sema.td_mk("bytes"); }
    if (t.kind == "Void") { return sema.td_mk("void"); }
    if (t.kind == "Slice") { return sema.td_elem_mk("slice", ti_to_td(t.elem)); }
    if (t.kind == "Array") {
        var r: i64 = sema.td_elem_mk("array", ti_to_td(t.elem));
        var at: TD = sema.tds[r];
        at.alen = t.alen;
        slice_set(sema.tds, r, at);
        return r;
    }
    if (t.kind == "Map") {
        var r: i64 = sema.td_mk("map");
        var mt: TD = sema.tds[r];
        mt.key = ti_to_td(t.key);
        mt.val = ti_to_td(t.val);
        slice_set(sema.tds, r, mt);
        return r;
    }
    if (t.kind == "Sym") {
        var rs: i64 = sema.td_named_mk("sym", t.name);
        var st: TD = sema.tds[rs];
        st.alen = t.bw;
        slice_set(sema.tds, rs, st);
        return rs;
    }
    if (t.kind == "Named") { return sema.td_named_mk("named", t.name); }
    if (t.kind == "Pointer") { return sema.td_elem_mk("pointer", ti_to_td(t.elem)); }
    if (t.kind == "Func") {
        var fret: i64 = ti_to_td(sema.tif_ret[ti]);
        var fbuf: []i64;
        var fj: i64 = 0;
        while (fj < sema.tif_pcount[ti]) {
            append(fbuf, ti_to_td(sema.tif_params[sema.tif_pstart[ti] + fj]));
            fj = fj + 1;
        }
        var fpstart: i64 = slice_len(sema.tdf_params) as i64;
        var fpc: i64 = slice_len(fbuf) as i64;
        var fj2: i64 = 0;
        while (fj2 < fpc) {
            append(sema.tdf_params, fbuf[fj2]);
            fj2 = fj2 + 1;
        }
        return sema.td_func(fret, fpstart, fpc);
    }
    return sema.td_mk("unknown");
}


// ── descToC（复刻 emitter.ts descToC）──────────────────────────

pub fn desc_to_c(td: i64) string {
    if (td < 0) {
        return "void*";
    }
    var t: TD = sema.tds[td];
    if (t.cat == "string") { return "TStr"; }
    if (t.cat == "bytes") { return "TStr"; }
    if (t.cat == "typeinfo") { return "TTypeInfo*"; }
    if (t.cat == "fieldinfo") { return "TFieldInfo*"; }
    if (t.cat == "slice") { return "TSlice"; }
    if (t.cat == "array") { return c_ptr_to(t.elem); }
    if (t.cat == "map") { return "TMap*"; }
    if (t.cat == "pointer") { return c_ptr_to(t.elem); }
    // 可选类型 ?T 与引用同构：可空的元素指针（none = NULL）。
    if (t.cat == "optional") { return c_ptr_to(t.elem); }
    if (t.cat == "sym") {
        if (t.alen == 16) { return "uint16_t"; }
        return "uint32_t";
    }
    if (t.cat == "scalar") {
        if (t.name == "") {
            return scalar_to_c("i64");
        }
        return scalar_to_c(t.name);
    }
    if (t.cat == "named") {
        if (t.name == "") {
            return "void*";
        }
        return t.name;
    }
    if (t.cat == "void") { return "void"; }
    if (t.cat == "func") { return "TClosure*"; }
    // 硬件 SIMD 向量：与 emit_ctype 同构，但输入是 TD（elem + alen）。
    if (t.cat == "vector") {
        var lane: string = desc_to_c(t.elem);
        var vlen: i64 = t.alen;
        if (vlen < 1) { vlen = 1; }
        var bytes: i64 = vlen * c_scalar_sizeof(lane);
        return base.sb_cat5(lane, " __attribute__((vector_size(", base.i2s(bytes), ")))", "");
    }
    return "void*";
}

// ── match arm 绑定替换栈（L-15 脱糖）──────────────────────────
// match 的 arm 绑定名只是「被匹配值临时量」的别名，发射期把标识符引用直接替换为
// `_tms<no>`，即可避免在 C / LLVM 两端生成重复声明或遮蔽外层同名局部。
// 用节点索引 + 序号存储，避免全局定长 string 数组（LLVM 后端全局聚合限制）。
pub var g_mb_arm: [64]i64;
pub var g_mb_no: [64]i64;
pub var g_mb_n: i64 = 0;

pub fn mb_push(arm: i64, no: i64) void {
    if (g_mb_n < 64) {
        g_mb_arm[g_mb_n] = arm;
        g_mb_no[g_mb_n] = no;
        g_mb_n = g_mb_n + 1;
    }
}

pub fn mb_drop(k: i64) void {
    var i: i64 = 0;
    while (i < k) {
        if (g_mb_n > 0) {
            g_mb_n = g_mb_n - 1;
        }
        i = i + 1;
    }
}

pub fn mb_sub(name: string) string {
    if (g_mb_n == 0) {
        return name;
    }
    var i: i64 = g_mb_n - 1;
    while (i >= 0) {
        var an: Node = base.nodes[g_mb_arm[i]];
        if (an.sa == name) {
            return base.sb_cat2("_tms", base.i2s(g_mb_no[i]));
        }
        i = i - 1;
    }
    return name;
}

// ── exprTypeDesc（复刻 emitter.ts exprTypeDesc）────────────────

pub fn expr_type_desc(e: i64) i64 {
    if (e < 0) {
        return sema.td_mk("unknown");
    }
    var n: Node = base.nodes[e];
// >>> GEN:td_expr1 (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
    if (n.kind == "string") { return sema.td_mk("string"); }
    if (n.kind == "int") { return sema.td_named_mk("scalar", "i64"); }
    if (n.kind == "float") { return sema.td_named_mk("scalar", "f64"); }
    if (n.kind == "bool") { return sema.td_named_mk("scalar", "bool"); }
// <<< GEN:td_expr1 <<<
    // 编译期内建 @sin / @sinf 等（运行时未折叠的情形）：数学内建返回 f64，f 后缀返回 f32
    if (n.kind == "mbuiltin" && sema.math_mbuiltin(n.sa)) {
        if (str_slice(n.sa, str_len(n.sa) - 1, str_len(n.sa)) == "f") { return sema.td_named_mk("scalar", "f32"); }
        return sema.td_named_mk("scalar", "f64");
    }
    // 硬件 SIMD 向量内建的类型推导：
    if (n.kind == "mbuiltin") {
        if (n.sa == "splat") {
            // @splat(scalar, len) -> @Vector(len, typeof(scalar))
            // 首选 sema 回填的 lane 类型名 / lane 数（见 sema.infer_expr 的 splat 分支）：
            // 生成区的字面量规则一律给 i64，拿不到 `0i32` 的位宽后缀。
            if (str_len(n.sb) > 0 && n.ia > 0) {
                var avt: i64 = sema.td_elem_mk("vector", sema.td_named_mk("scalar", n.sb));
                var avd: TD = sema.tds[avt];
                avd.alen = n.ia;
                slice_set(sema.tds, avt, avd);
                return avt;
            }
            var c0: i64 = n.la;
            if (c0 >= 0) {
                var sTD: i64 = expr_type_desc(base.kids[c0].val);
                // 第二实参（len）须是编译期整数
                var len: i64 = -1;
                var lenNode: i64 = -1;
                var c1: i64 = base.kids[c0].next;
                if (c1 >= 0) { lenNode = base.kids[c1].val; }
                if (lenNode >= 0) {
                    var mlen: i64 = sema.meta_eval(lenNode);
                    if (mlen >= 0) {
                        var mvn: Node = base.nodes[mlen];
                        if (mvn.kind == "int" || mvn.kind == "bool") { len = sema.mv_get_int(mlen); }
                    }
                }
                if (len < 1) { len = 1; }
                var vt: i64 = sema.td_elem_mk("vector", sTD);
                var vtd: TD = sema.tds[vt];
                vtd.alen = len;
                slice_set(sema.tds, vt, vtd);
                return vt;
            }
            return sema.td_mk("unknown");
        }
        if (n.sa == "reduce_add" || n.sa == "reduce_max" || n.sa == "reduce_min") {
            var c: i64 = n.la;
            if (c >= 0) {
                var vTD: i64 = expr_type_desc(base.kids[c].val);
                if (vTD >= 0 && sema.tds[vTD].cat == "vector") { return sema.tds[vTD].elem; }
            }
            return sema.td_mk("unknown");
        }
        if (n.sa == "vlen" || n.sa == "simd_lanes") { return sema.td_named_mk("scalar", "i64"); }
        if (n.sa == "cpu_has") { return sema.td_named_mk("scalar", "bool"); }
    }
    if (n.kind == "atom") { return sema.td_named_mk("scalar", "atom"); }
    if (n.kind == "fidconst") { return sema.td_named_mk("scalar", "fid"); }
    if (n.kind == "serialize") { return sema.td_named_mk("scalar", "fid"); }
    if (n.kind == "deserialize") { return sema.deser_type_of(n.nb); }
    if (n.kind == "typeinfo") {
        return sema.td_named_mk("typeinfo", n.sa);
    }
    // 结构体字面量：类型名在 n.sa（与 LLVM 后端 ll_etd 的 struct_lit 分支对齐）。
    // 缺这一支会让 match 首臂体为结构体字面量时 mq_rtd 退化为 unknown，
    // 进而把 match 结果临时量 _tmrN 声明成 void*（见 examples/match_return_struct.tc）。
    if (n.kind == "struct_lit") {
        return sema.td_named_mk("named", n.sa);
    }
    // 闭包构造点（M48）：值类型 = 合成函数的函数类型（build_type_map 已按裸名登记）
    if (n.kind == "closure_make") {
        var cmtd: i64 = sema.tm_get(n.sa);
        if (cmtd >= 0) {
            return cmtd;
        }
        return sema.td_mk("unknown");
    }
    if (n.kind == "ident") {
        var etd_idn: string = mb_sub(n.sa);
        if (em_in_fn) {
            var f: i64 = fs_get(em_cur_fn, etd_idn);
            if (f >= 0) {
                return f;
            }
        }
        var g: i64 = sema.tm_get(etd_idn);
        if (g >= 0) {
            return g;
        }
        return sema.td_mk("unknown");
    }
// >>> GEN:td_expr2 (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
    if (n.kind == "paren") {
        return expr_type_desc(n.na);
    }
    if (n.kind == "cast") {
        return sema.resolve_type_desc(n.nb);
    }
// <<< GEN:td_expr2 <<<
    // comptime 表达式：类型即内层表达式的类型（Phase A 透明降级）
    if (n.kind == "comptime") {
        return expr_type_desc(n.na);
    }
    if (n.kind == "index") {
        var od: i64 = expr_type_desc(n.na);
        var ot: TD = sema.tds[od];
        if (ot.cat == "string" || ot.cat == "bytes") {
            return sema.td_named_mk("scalar", "u8");
        }
        if (ot.cat == "slice" || ot.cat == "array") {
            if (ot.elem >= 0) {
                return ot.elem;
            }
            return sema.td_mk("unknown");
        }
        if (ot.cat == "map") {
            if (ot.val >= 0) {
                return ot.val;
            }
            return sema.td_mk("unknown");
        }
        // 硬件 SIMD 向量：`v[i]` 取第 i 个 lane，类型 = lane 类型。
        if (ot.cat == "vector") {
            if (ot.elem >= 0) {
                return ot.elem;
            }
            return sema.td_mk("unknown");
        }
        return sema.td_mk("unknown");
    }
    if (n.kind == "call") {
        var cal: Node = base.nodes[n.na];
        if (cal.kind == "ident") {
            var cn: string = cal.sa;
// >>> GEN:td_calls (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
            if (cn == "file_read_all") { return sema.td_mk("string"); }
            if (cn == "path_resolve") { return sema.td_mk("string"); }
            if (cn == "getenv") { return sema.td_mk("string"); }
            if (cn == "str_len") { return sema.td_named_mk("scalar", "u64"); }
            if (cn == "slice_len") { return sema.td_named_mk("scalar", "u64"); }
            if (cn == "str_at") { return sema.td_named_mk("scalar", "u8"); }
            if (cn == "args") {
                return sema.td_elem_mk("slice", sema.td_mk("string"));
            }
            if (cn == "read_line") { return sema.td_mk("string"); }
            if (cn == "stdin_eof") { return sema.td_named_mk("scalar", "bool"); }
            if (cn == "file_write_all") { return sema.td_named_mk("scalar", "bool"); }
            if (cn == "file_exists") { return sema.td_named_mk("scalar", "bool"); }
            if (cn == "str_slice") { return sema.td_mk("string"); }
            if (cn == "bytes_len") { return sema.td_named_mk("scalar", "u64"); }
            if (cn == "bytes_at") { return sema.td_named_mk("scalar", "u8"); }
            if (cn == "bytes_slice") { return sema.td_mk("bytes"); }
            if (cn == "bsb_new") { return sema.td_named_mk("named", "TSb*"); }
            if (cn == "bsb_append_u8" || cn == "bsb_append_bytes") { return sema.td_mk("void"); }
            if (cn == "bsb_to_bytes") { return sema.td_mk("bytes"); }
            if (cn == "sb_to_str") { return sema.td_mk("string"); }
            if (cn == "int_to_str" || cn == "i2s") { return sema.td_mk("string"); }
            if (cn == "sb_new") { return sema.td_named_mk("named", "TSb*"); }
            if (cn == "map_has") { return sema.td_named_mk("scalar", "bool"); }
            if (cn == "map_del") { return sema.td_named_mk("scalar", "bool"); }
            if (cn == "map_len") { return sema.td_named_mk("scalar", "i64"); }
            if (cn == "map_set") { return sema.td_mk("void"); }
            if (cn == "map_new") { return sema.td_mk("map"); }
            if (cn == "ti_name") { return sema.td_mk("string"); }
            if (cn == "fi_name") { return sema.td_mk("string"); }
            if (cn == "fi_type_name") { return sema.td_mk("string"); }
            if (cn == "ti_size") { return sema.td_named_mk("scalar", "i64"); }
            if (cn == "ti_kind") { return sema.td_named_mk("scalar", "i64"); }
            if (cn == "ti_field_count") { return sema.td_named_mk("scalar", "i64"); }
            if (cn == "fi_offset") { return sema.td_named_mk("scalar", "i64"); }
            if (cn == "fi_tag") { return sema.td_named_mk("scalar", "i64"); }
            if (cn == "fi_type_size") { return sema.td_named_mk("scalar", "i64"); }
            if (cn == "ti_field") { return sema.td_named_mk("fieldinfo", "FieldInfo"); }
            if (cn == "fi_is_ptr") { return sema.td_named_mk("scalar", "bool"); }
            if (cn == "sym_str") { return sema.td_mk("string"); }
            if (cn == "sym_release") { return sema.td_mk("void"); }
            if (cn == "sym_release_all") { return sema.td_mk("void"); }
            if (cn == "atom_str") { return sema.td_mk("string"); }
            if (cn == "fopen") { return sema.td_named_mk("scalar", "fid"); }
            if (cn == "fclose" || cn == "fflush" || cn == "fmt_register") { return sema.td_mk("void"); }
            if (cn == "fid_is_open") { return sema.td_named_mk("scalar", "bool"); }
            if (cn == "fid_eof") { return sema.td_named_mk("scalar", "bool"); }
            if (cn == "fid_format") { return sema.td_named_mk("scalar", "atom"); }
            if (cn == "fid_error") { return sema.td_mk("string"); }
            if (cn == "fseek") { return sema.td_named_mk("scalar", "bool"); }
            if (cn == "ftell") { return sema.td_named_mk("scalar", "i64"); }
            // 时间格式化（M56）/ 解析与固定时区（M57）
            if (cn == "now" || cn == "time_invalid" || cn == "parse_time" || cn == "parse_time_local") { return sema.td_named_mk("scalar", "i64"); }
            if (cn == "format_time" || cn == "format_time_local" || cn == "format_time_tz") { return sema.td_mk("string"); }
            // 格式化（Python 格式规范迷你语言子集）
            if (cn == "format_int" || cn == "format_uint" || cn == "format_float" || cn == "format_str" || cn == "format_bool" || cn == "format_char") { return sema.td_mk("string"); }
            if (cn == "sb_append_fmt_int" || cn == "sb_append_fmt_uint" || cn == "sb_append_fmt_float" || cn == "sb_append_fmt_str" || cn == "sb_append_fmt_bool" || cn == "sb_append_fmt_char") { return sema.td_mk("void"); }
            if (cn == "sb_append_fmt_str_conv" || cn == "sb_append_fmt_int_conv" || cn == "sb_append_fmt_uint_conv") { return sema.td_mk("void"); }
            // 数学内建 @sin / sin 等（call 形式）：浮点返回 f64，f 后缀变体返回 f32；谓词返回 i32
            if (math_is_mbuiltin_c(cn)) {
                if (math_is_predicate_c(cn)) { return sema.td_named_mk("scalar", "i32"); }
                if (math_is_f32_variant_c(cn)) { return sema.td_named_mk("scalar", "f32"); }
                return sema.td_named_mk("scalar", "f64");
            }
// <<< GEN:td_calls <<<
            // slice_sub(s, lo, hi) 的子切片与源切片同型：类型由首实参转发。
            // 依赖实参、不是常量返回，故写在 GEN 区外（生成器只会写单行常量规则）。
            if (cn == "slice_sub") {
                if (n.la < 0) { return sema.td_elem_mk("slice", sema.td_mk("unknown")); }
                return expr_type_desc(base.kids[n.la].val);
            }
            // map_get(m, k) 的返回类型 = 映射的 V（从首个实参的 map 类型反查）
            if (cn == "map_get" && n.la >= 0) {
                var mn: i64 = base.kids[n.la].val;
                var mtd: i64 = expr_type_desc(mn);
                if (mtd >= 0) {
                    var mt: TD = sema.tds[mtd];
                    if (mt.cat == "map" && mt.val >= 0) {
                        return mt.val;
                    }
                }
                return sema.td_mk("unknown");
            }
            // 间接调用：被调者是函数类型的局部变量时，取其签名返回类型（局部遮蔽同名全局函数）
            var lftd: i64 = -1;
            if (em_in_fn) {
                lftd = fs_get(em_cur_fn, mb_sub(cn));
            }
            if (td_is_func(lftd)) {
                return sema.tdf_ret[lftd];
            }
            var rt: i64 = sema.tm_get(base.sb_cat2(cn, "()"));
            if (rt >= 0) {
                return rt;
            }
            var gftd: i64 = sema.tm_get(mb_sub(cn));
            if (td_is_func(gftd)) {
                return sema.tdf_ret[gftd];
            }
            return sema.td_mk("unknown");
        }
        // callee 是任意表达式（结构体字段 / 数组元素 / 调用结果…）：按其静态类型取返回类型
        var xftd: i64 = expr_type_desc(n.na);
        if (td_is_func(xftd)) {
            return sema.tdf_ret[xftd];
        }
        return sema.td_mk("unknown");
    }
    if (n.kind == "binary") {
        var op: string = n.sa;
        if (op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=" || op == "&&" || op == "||") {
            return sema.td_named_mk("scalar", "bool");
        }
        return expr_type_desc(n.na);
    }
    // 取址 `&x`：结果类型为 pointer(pointee)。
    if (n.kind == "amp") {
        return sema.td_elem_mk("pointer", expr_type_desc(n.na));
    }
    // 解引用 `*r`：结果类型 = 指针所指元素类型。
    if (n.kind == "deref") {
        var ptd: i64 = expr_type_desc(n.na);
        if (ptd >= 0) {
            var pt: TD = sema.tds[ptd];
            if (pt.cat == "pointer" && pt.elem >= 0) {
                return pt.elem;
            }
        }
        return sema.td_mk("unknown");
    }
    // 前缀一元：`!x` 为 bool；`-x` / `~x` 保持操作数类型。
    // 缺这一支会让 `-1` 之类退化成 unknown，进而把 match 结果临时量声明成 void*（C）/ i8（LLVM）。
    if (n.kind == "unary") {
        if (n.sa == "!") {
            return sema.td_named_mk("scalar", "bool");
        }
        return expr_type_desc(n.na);
    }
    if (n.kind == "member") {
        // `Enum.Member` / `Flag.slot`：对象是类型名而非值，类型即底层整型
        var mo0: Node = base.nodes[n.na];
        if (mo0.kind == "ident") {
            var mdi0: i64 = sema.mb_type_decl(mo0.sa);
            if (mdi0 >= 0) {
                var mdn0: Node = base.nodes[mdi0];
                if (mdn0.kind == "EnumDecl" || mdn0.kind == "FlagDecl") {
                    return sema.td_named_mk("scalar", mdn0.sb);
                }
            }
        }
        var od2: i64 = expr_type_desc(n.na);
        var ot2: TD = sema.tds[od2];
        if (ot2.cat == "named" && ot2.name != "") {
            var fd: i64 = sf_get(ot2.name, n.sa);
            if (fd >= 0) {
                return fd;
            }
        }
        return sema.td_mk("unknown");
    }
    return sema.td_mk("unknown");
}

// ── collectLocalTypes（复刻 emitter.ts collectLocalTypes）──────

pub fn collect_local_types(head: i64) void {
    if (head < -1) {
        return;
    }
    var c: i64 = head;
    while (c >= 0) {
        var k: Child = base.kids[c];
        var n: Node = base.nodes[k.val];
        if (n.kind == "var_decl") {
            if (n.na >= 0) {
                fs_set(em_cur_fn, n.sa, sema.resolve_type_desc(n.na));
            }
        }
        // 闭包体首重建的捕获变量（M48）：与普通局部同权，须登记类型
        if (n.kind == "closure_capture") {
            if (n.na >= 0) {
                fs_set(em_cur_fn, n.sa, sema.resolve_type_desc(n.na));
            }
        }
        if (n.kind == "if") {
            collect_local_types(n.la);
            if (n.lb > -2) {
                collect_local_types(n.lb);
            }
        }
        if (n.kind == "while" || n.kind == "block") {
            collect_local_types(n.la);
        }
        if (n.kind == "for") {
            if (n.na >= 0) {
                var ini: Node = base.nodes[n.na];
                if (ini.kind == "var_decl") {
                    if (ini.na >= 0) {
                        fs_set(em_cur_fn, ini.sa, sema.resolve_type_desc(ini.na));
                    }
                }
            }
            collect_local_types(n.la);
        }
        if (n.kind == "for_each") {
            var it: i64 = expr_type_desc(n.na);
            var itd: TD = sema.tds[it];
            if (itd.cat == "slice" && itd.elem >= 0) {
                fs_set(em_cur_fn, n.sa, itd.elem);
            }
            if (itd.cat == "map" && itd.key >= 0) {
                fs_set(em_cur_fn, n.sa, itd.key);
                if (str_len(n.sb) > 0 && itd.val >= 0) {
                    fs_set(em_cur_fn, n.sb, itd.val);
                }
            }
            collect_local_types(n.la);
        }
        c = k.next;
    }
}

// ── buildTypeMap（复刻 emitter.ts buildTypeMap）────────────────

// 具名函数的「函数类型」TD。用于「函数作为值」的类型推断：
//   var f = add;                  // 无类型标注
//   var g = fn(a: i64) i64 {}  // 提升后同样是裸函数名
// 没有它，expr_type_desc 会对函数名返回 unknown，导致 var_decl 发射出错误的 C 类型。
pub fn funcdecl_td(rt_node: i64, params_head: i64) i64 {
    var rtd: i64 = sema.resolve_type_desc(rt_node);
    var buf: []i64;
    var c: i64 = params_head;
    while (c >= 0) {
        var k: Child = base.kids[c];
        var p: Node = base.nodes[k.val];
        append(buf, sema.resolve_type_desc(p.na));
        c = k.next;
    }
    // 先收局部表再整段搬入扁平池：嵌套函数类型解析会递归 append，
    // 直接边解析边 append 会打断本层参数区的连续性。
    var ps: i64 = slice_len(sema.tdf_params) as i64;
    var pc: i64 = slice_len(buf) as i64;
    var i: i64 = 0;
    while (i < pc) {
        append(sema.tdf_params, buf[i]);
        i = i + 1;
    }
    return sema.td_func(rtd, ps, pc);
}

pub fn build_type_map() void {
    var n: i64 = slice_len(lex.decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = lex.decl_list[i];
        var dn: Node = base.nodes[d];
        if (dn.kind == "StructDecl") {
            var fc: i64 = dn.lb;
            while (fc >= 0) {
                var fk: Child = base.kids[fc];
                var f: Node = base.nodes[fk.val];
                if (f.na >= 0) {
                    sf_set(dn.sa, f.sa, sema.resolve_type_desc(f.na));
                }
                fc = fk.next;
            }
        }
        if (dn.kind == "GlobalVarDecl" || dn.kind == "GlobalConstDecl") {
            if (dn.na >= 0) {
                tm_set(dn.sa, sema.resolve_type_desc(dn.na));
            }
        }
        if (dn.kind == "FuncDecl") {
            if (dn.na >= 0) {
                tm_set(base.sb_cat2(dn.sa, "()"), sema.resolve_type_desc(dn.na));
            }
            // 裸函数名 → 函数类型（函数作为值）。局部变量优先级更高，不会被遮蔽。
            tm_set(dn.sa, funcdecl_td(dn.na, dn.lb));
            em_cur_fn = dn.sa;
            em_in_fn = true;
            var pc: i64 = dn.lb;
            while (pc >= 0) {
                var pk: Child = base.kids[pc];
                var p: Node = base.nodes[pk.val];
                if (p.na >= 0) {
                    fs_set(dn.sa, p.sa, sema.resolve_type_desc(p.na));
                }
                pc = pk.next;
            }
            if (dn.lc > -2) {
                collect_local_types(dn.lc);
            }
            em_in_fn = false;
            em_cur_fn = "";
        }
        i = i + 1;
    }
}

// ── C 字符串转义（复刻 emitter.ts escapeCString）───────────────

pub fn esc_c(s: string) string {
    var sb: StringBuilder = sb_new();
    var i: u64 = 0;
    var n: u64 = str_len(s);
    while (i < n) {
        var c: u8 = s[i];
        if (c == 92) {
            sb_append_str(sb, "\\\\");
        } else {
        if (c == 34) {
            sb_append_str(sb, "\\\"");
        } else {
        if (c == 10) {
            sb_append_str(sb, "\\n");
        } else {
        if (c == 13) {
            sb_append_str(sb, "\\r");
        } else {
        if (c == 9) {
            sb_append_str(sb, "\\t");
        } else {
        if (c == 0) {
            sb_append_str(sb, "\\0");
        } else {
            sb_append_char(sb, c);
        }}}}}}
        i = i + 1;
    }
    return sb_to_str(sb);
}

// ── 缩进 ───────────────────────────────────────────────────────

pub fn mk_pad(indent: i64) string {
    var sb: StringBuilder = sb_new();
    var i: i64 = 0;
    while (i < indent) {
        sb_append_str(sb, "    ");
        i = i + 1;
    }
    return sb_to_str(sb);
}

// ── emitExpr（复刻 emitter.ts emitExpr）────────────────────────


// map 键取地址（C 后端）：整型键统一提升为 int64_t 存储——runtime 按 int64_t 读键，
// 直接对 i32/u8 变量取址会让高位字节变成垃圾（M30 前的静默失配）。用 C99 复合字面量，
// 顺带允许键写成字面量或表达式。string 键是 TStr 聚合，仍取原表达式地址。
pub fn c_map_keyp(mn: i64, kn: i64) string {
    var ktd9: i64 = -1;
    var mtd9: i64 = expr_type_desc(mn);
    if (mtd9 >= 0) {
        var mt9: TD = sema.tds[mtd9];
        ktd9 = mt9.key;
    }
    if (ktd9 >= 0 && sema.tds[ktd9].cat != "scalar") {
        return base.sb_cat2("&", emit_expr(kn));
    }
    return base.sb_cat3("&(int64_t){(int64_t)(", emit_expr(kn), ")}");
}

// map 值取地址（C 后端）：标量值按声明的 V 落进复合字面量（宽度对齐 val_size，
// 且允许值写成字面量）；聚合值取原表达式地址。
pub fn c_map_valp(mn: i64, vn: i64) string {
    var vtd8: i64 = -1;
    var mtd8: i64 = expr_type_desc(mn);
    if (mtd8 >= 0) {
        var mt8: TD = sema.tds[mtd8];
        vtd8 = mt8.val;
    }
    if (vtd8 < 0 || sema.tds[vtd8].cat != "scalar") {
        return base.sb_cat2("&", emit_expr(vn));
    }
    var vc8: string = desc_to_c(vtd8);
    return base.sb_cat6("&(", vc8, "){(", vc8, ")(", base.sb_cat2(emit_expr(vn), ")}"));
}

pub fn c_map_get(mn: i64, kn: i64) string {
    var mtd: i64 = expr_type_desc(mn);
    var mt: TD = sema.tds[mtd];
    var valc: string = desc_to_c(mt.val);
    var mstr: string = emit_expr(mn);
    var kstr: string = c_map_keyp(mn, kn);
    return base.sb_cat6("(*(", valc, "*)t_map_val_ptr(", mstr, ", ", base.sb_cat2(kstr, "))"));
}

// map 索引写时求 LHS 的 TMap* 基指针：
// 单层 m[k] → m（变量本身即 TMap*）；嵌套 deep[a][x] → deep[a] 求内层 TMap* 值。
// 用于 t_map_put 的第一个实参。
pub fn c_map_lhs_ptr(nd: i64) string {
    var n1: Node = base.nodes[nd];
    if (n1.kind == "index") {
        var btd: i64 = expr_type_desc(nd);
        if (btd >= 0 && sema.tds[btd].cat == "map") {
            // 嵌套：base 是 m[k] 本身也是 map，求内层 TMap* 值（t_map_val_ptr 返回槽指针，解引用得 TMap*）
            var base: string = emit_expr(n1.na);
            var key: string = c_map_keyp(nd, n1.nb);
            return base.sb_cat6("(*(TMap**)", "t_map_val_ptr(", base, ", ", key, "))");
        }
    }
    return emit_expr(nd);
}

// map 字面量作为表达式（调用实参 / 返回值 / 嵌套值 / 赋值右值）时，
// 建临时 TMap* 变量并逐项 put，返回该变量名。pad 为缩进（表达式场景通常为 ""）。
pub var g_map_lit_cnt: i64 = 0;
pub var g_match_cnt: i64 = 0;      // match 表达式序号（结果/被匹配值临时量命名）
pub var g_clos_cnt: i64 = 0;       // 闭包构造序号（环境/闭包临时量命名，M48）
pub var g_stmt_pad: string = "";   // 当前语句缩进（map 字面量作表达式时对齐用）
pub var g_defer: [1024]i64;         // defer 延迟栈（节点索引），函数级、LIFO 于 return/函数尾运行
pub var g_defer_n: i64 = 0;         // g_defer 栈顶计数



pub fn c_emit_map_lit(en: i64, mname: string, pad: string, keytd: i64, valtd: i64) void {
    var mlkk: i64 = 0;
    if (sema.tds[keytd].cat != "string") { mlkk = 1; }
    var mlkc: string = desc_to_c(keytd);
    var mlvc: string = desc_to_c(valtd);
    spush(base.sb_cat5(pad, "TMap* ", mname, " = t_map_new(t_arena_current(), ", base.sb_cat3(base.i2s(mlkk), ", (int64_t)sizeof(", base.sb_cat2(mlvc, "));"))));
    var mlkx: string = "";
    if (sema.tds[keytd].cat == "scalar") {
        mlkc = "int64_t";
        mlkx = "(int64_t)";
    }
    var mlvx: string = "";
    if (sema.tds[valtd].cat == "scalar") {
        mlvx = base.sb_cat3("(", mlvc, ")");
    }
    var mlnode: Node = base.nodes[en];
    var mlc: i64 = mlnode.la;
    var mlix: i64 = 0;
    while (mlc >= 0) {
        var mlck: Child = base.kids[mlc];
        var mlen: Node = base.nodes[mlck.val];
        var mlkn: string = base.sb_cat4("_ml_", mname, "k", base.i2s(mlix));
        var mlvn: string = base.sb_cat4("_ml_", mname, "v", base.i2s(mlix));
        spush(base.sb_cat6(pad, mlkc, " ", mlkn, base.sb_cat3(" = ", mlkx, emit_expr(mlen.na)), ";"));
        spush(base.sb_cat6(pad, mlvc, " ", mlvn, base.sb_cat3(" = ", mlvx, emit_expr(mlen.nb)), ";"));
        spush(base.sb_cat6(pad, "t_map_put(", mname, ", &", mlkn, base.sb_cat3(", &", mlvn, ");")));
        mlix = mlix + 1;
        mlc = mlck.next;
    }
}

// ── match 脱糖（L-15 / match.md §2「函数子句为 match 语法糖」同一机制）──
// 由 arm 链表递归合成 if/else 语句链，交给既有 emit_stmt / emit_llstmt 发射：
//   arm 体      → `<rname> = <body>;`（expr 语句包 assign 节点）
//   等值模式    → `<sname> == <pat>`
//   when 守卫   → 与等值模式 `&&` 合取；仅有守卫时即为条件本身
//   不可反驳 arm（`_` / 裸绑定且无守卫）→ 作为 else 体，其后 arm 不可达
// 返回语句链表头；-2 表示无（对应 mk_if 的「无 else」约定）。
// conpat 载荷绑定的发射期类型登记。
// collect_local_types 只遍历语句链，看不到 match_chain_from 在发射期现场合成的
// `var <bind>: T = <V>_as_<C>(sname);`；而 match 结果临时量 _tmrN 的类型
// (mq_rtd) 必须在脱糖之前由首臂体推断出来。若首臂体引用了载荷绑定，
// 类型表里查不到该名字就会退化成 unknown → `void*`（L-09：绝不静默错编）。
// 故在 match 发射入口先把本 match 全部 conpat 载荷绑定登记进函数作用域类型表。
// 无 conpat 臂时此函数零副作用，既有程序的发射逐字节不变。
// 单个 conpat 的载荷绑定登记；嵌套构造器模式递归下钻（`W(L(x))` 的 `x` 同样须登记）
pub fn conpat_binds_register_one(p: i64) void {
    var mr_p: Node = base.nodes[p];
    if (mr_p.kind != "conpat" || mr_p.na < 0 || mr_p.la < 0) {
        return;
    }
    var mr_bk: i64 = mr_p.la;
    while (mr_bk >= 0) {
        var mr_bn: Node = base.nodes[base.kids[mr_bk].val];
        if (mr_bn.kind == "ident" && mr_bn.sa != "_") {
            fs_set(em_cur_fn, mr_bn.sa, sema.resolve_type_desc(mr_bn.na));
        }
        if (mr_bn.kind == "conpat") {
            conpat_binds_register_one(base.kids[mr_bk].val);
        }
        mr_bk = base.kids[mr_bk].next;
    }
}

pub fn match_conpat_binds_register(e: i64) void {
    var mr_c: i64 = base.nodes[e].la;
    while (mr_c >= 0) {
        var mr_k: Child = base.kids[mr_c];
        var mr_an: Node = base.nodes[mr_k.val];
        if (mr_an.na >= 0) {
            conpat_binds_register_one(mr_an.na);
        }
        mr_c = mr_k.next;
    }
}

// ── conpat 脱糖累加器（match_chain_from 的 conpat 分支专用）─────
// t 无多返回值，故用全局累加：cp_acc_cond 收集判别条件（AND 链），
// cp_acc_pre 收集载荷绑定 var_decl（kids 链表，按声明序 append）。
// 访问器 `<V>_as_<C>[_fk]` 是 static inline 纯函数，subject 表达式节点被
// is/as 复用多次是安全的（无副作用、无重复求值语义差异）。
pub var cp_acc_cond: i64;
pub var cp_acc_pre: i64;
pub var cp_acc_pre_tail: i64;

pub fn cp_acc_and(c: i64) void {
    if (cp_acc_cond < 0) {
        cp_acc_cond = c;
        return;
    }
    cp_acc_cond = base.mk_binary("&&", cp_acc_cond, c, -1);
}

pub fn cp_acc_emit(s: i64) void {
    cp_acc_pre_tail = base.list_push(cp_acc_pre, cp_acc_pre_tail, s);
    if (cp_acc_pre < 0) {
        cp_acc_pre = cp_acc_pre_tail;
    }
}

// 构造器模式脱糖（递归）：subj 是承载被匹配值的**表达式节点**。
//   `<V>_is_<C>(subj)` 进条件；每个子模式按位取 `<V>_as_<C>[_fk](subj)`：
//   ident       → 前置 `var name: T = acc;`
//   conpat      → 以 acc 为新 subject 递归（嵌套解构）
//   字面量/其他 → 追加等值条件 `acc == lit`
pub fn conpat_walk(p: i64, subj: i64) void {
    var cp: Node = base.nodes[p];
    var cp_v: string = cp.sc;        // variant 类型名
    var cp_c: string = cp.sa;        // case 名
    var cp_args: i64 = base.list_push(-1, -1, subj);
    cp_acc_and(base.mk_call(base.mk_ident(base.sb_cat3(cp_v, "_is_", cp_c), -1), cp_args, -1));
    if (cp.na < 0 || cp.la < 0) {
        return;                       // unit case：无载荷
    }
    var bi: i64 = 0;
    var cpk: i64 = cp.la;
    while (cpk >= 0) {
        var cpi: i64 = base.kids[cpk].val;
        var cpn: Node = base.nodes[cpi];
        // 多载荷（cp.ib >= 2，conpat_check 已保证个数与声明一致）逐字段访问器
        // `_as_<C>_f<k>`；单载荷沿用 `_as_<C>`，保证既有 variant 发射字节不变。
        var cp_accn: string;
        if (cp.ib >= 2) {
            cp_accn = base.sb_cat4(cp_v, "_as_", cp_c, base.sb_cat2("_f", base.i2s(bi)));
        } else {
            cp_accn = base.sb_cat3(cp_v, "_as_", cp_c);
        }
        var cp_ext: i64 = base.mk_call(base.mk_ident(cp_accn, -1), cp_args, -1);
        if (cpn.kind == "ident") {
            if (cpn.sa != "_") {
                var cp_vd: i64 = base.mk_var_decl(cpn.sa, false, cpn.na, cp_ext, -1);
                append(base.g_conpat_binds, cp_vd);
                cp_acc_emit(cp_vd);
            }
        } else {
            if (cpn.kind == "conpat") {
                conpat_walk(cpi, cp_ext);
            } else {
                cp_acc_and(base.mk_binary("==", cp_ext, cpi, -1));
            }
        }
        cpk = base.kids[cpk].next;
        bi = bi + 1;
    }
}

pub fn match_chain_from(c: i64, rname: string, sname: string) i64 {
    if (c < 0) {
        return -2;
    }
    var mc_k: Child = base.kids[c];
    var mc_an: Node = base.nodes[mc_k.val];
    var mc_asg: i64 = base.mk_expr(base.mk_assign("=", base.mk_ident(rname, -1), mc_an.nc, -1), -1);
    var mc_body: i64 = base.list_push(-1, -1, mc_asg);
    var mc_cond: i64 = -1;
    if (mc_an.na >= 0 && base.nodes[mc_an.na].kind == "conpat") {
        // ADT 构造器解构（L-15）：条件 = `<V>_is_<C>(sname)`，body 前置载荷绑定。
        // 双后端共用此脱糖：<V>_is_<C> / <V>_as_<C> 已由 emit_variant_decl 发成 static inline。
        // 嵌套模式 `W(L(x))` 由 conpat_walk 递归：内层判别并入同一 AND 条件链，
        // 内层绑定的访问路径是 accessor 调用链 `Inner_as_L(Outer_as_W(s))`。
        cp_acc_cond = -1;
        cp_acc_pre = -1;
        cp_acc_pre_tail = -1;
        conpat_walk(mc_an.na, base.mk_ident(sname, -1));
        mc_cond = cp_acc_cond;
        // 前置绑定按声明序插到 body 链表头之前
        // （mc_body / cp_acc_pre 都是 kids 链表下标，绝不可混用 nodes 节点下标）
        if (cp_acc_pre >= 0) {
            var pre_tk: Child = base.kids[cp_acc_pre_tail];
            pre_tk.next = mc_body;
            slice_set(base.kids, cp_acc_pre_tail, pre_tk);
            mc_body = cp_acc_pre;
        }
    } else if (mc_an.na >= 0) {
        // 范围模式 `1..5` / `1..=5` / `'a'..='z'`：等值比较换成区间成员测试。
        // 被匹配值此刻已绑在临时量 sname 上，重复引用零代价、零副作用。
        if (base.nodes[mc_an.na].kind == "range") {
            mc_cond = base.mk_range_test(base.mk_ident(sname, -1), base.mk_ident(sname, -1), mc_an.na);
        } else {
            mc_cond = base.mk_binary("==", base.mk_ident(sname, -1), mc_an.na, -1);
        }
    }
    if (mc_an.nb >= 0) {
        if (mc_cond < 0) {
            mc_cond = mc_an.nb;
        } else {
            mc_cond = base.mk_binary("&&", mc_cond, mc_an.nb, -1);
        }
    }
    if (mc_cond < 0) {
        return mc_body;
    }
    var mc_rest: i64 = match_chain_from(mc_k.next, rname, sname);
    var mc_if: i64 = base.mk_if(mc_cond, mc_body, mc_rest, -1);
    return base.list_push(-1, -1, mc_if);
}

// 把该 match 所有 arm 的绑定名压入替换栈，返回压入个数（供 mb_drop 配对弹出）
pub fn match_bind_push(e: i64, no: i64) i64 {
    var mb_n2: i64 = 0;
    var mb_c: i64 = base.nodes[e].la;
    while (mb_c >= 0) {
        var mb_k: Child = base.kids[mb_c];
        var mb_an: Node = base.nodes[mb_k.val];
        if (str_len(mb_an.sa) > 0) {
            mb_push(mb_k.val, no);
            mb_n2 = mb_n2 + 1;
        }
        mb_c = mb_k.next;
    }
    return mb_n2;
}

// 首个 arm 的体表达式（match 结果类型以其为准）
pub fn match_first_body(e: i64) i64 {
    var mf_c: i64 = base.nodes[e].la;
    if (mf_c < 0) {
        return -1;
    }
    var mf_k: Child = base.kids[mf_c];
    return base.nodes[mf_k.val].nc;
}

// 切片元素的 C 类型名。append / slice_set 的元素宽度必须取自**切片**，
// 不能用 `sizeof(<实参表达式>)`：`append(xs, -1)` 的 sizeof 是 sizeof(int)==4，
// 对 []i64 只会写入半个元素（静默错编）。
pub fn c_elem_ctype(slice_expr: i64) string {
    if (slice_expr >= 0) {
        var ce_d: i64 = expr_type_desc(slice_expr);
        if (ce_d >= 0) {
            var ce_t: TD = sema.tds[ce_d];
            if (ce_t.elem >= 0) {
                return desc_to_c(ce_t.elem);
            }
        }
    }
    return "int64_t";
}

// ── fid 打开方式 / 格式的编译期编码（M51，双后端共用）─────────
// mode / kind / fmt 形参已由 check_atom_arg 保证是白名单内的 atom 字面量，
// 故发射期直接降为小整数码，运行时不必反查 atom 名表（也就不依赖名表内容）。
pub fn fid_code_of(sel: string, v: string) i64 {
    if (sel == "mode") {
        if (v == "read") { return 0; }
        if (v == "write") { return 1; }
        if (v == "append") { return 2; }
        if (v == "read_binary") { return 3; }
        if (v == "write_binary") { return 4; }
        return 5;
    }
    if (sel == "kind") {
        if (v == "text") { return 0; }
        return 1;
    }
    if (v == "text") { return 0; }
    if (v == "json") { return 1; }
    if (v == "rawbin") { return 2; }
    return 3;
}

pub fn fid_arg_code(a: i64, sel: string) string {
    if (a < 0) {
        return "0";
    }
    var fan: Node = base.nodes[a];
    return base.i2s(fid_code_of(sel, fan.sa));
}

// fid_format 返回 atom：运行时只知道格式码，atom id 作为**实参**传下去，
// 无需全局预注册、不扰动既有 id 分配。
// 入表动作在检查期由 fid_intern_fmt_atoms 完成（LLVM 的 @t_atom_table 先于函数体发射）；
// 这里的 atom_intern 是幂等查表，只负责取回已分配的 id。
pub fn fid_fmt_atom_args() string {
    var a0: string = base.i2s(sema.atom_intern("text"));
    var a1: string = base.i2s(sema.atom_intern("json"));
    var a2: string = base.i2s(sema.atom_intern("rawbin"));
    var a3: string = base.i2s(sema.atom_intern("protobuf"));
    return base.sb_cat6(a0, ", ", a1, ", ", a2, base.sb_cat2(", ", a3));
}

// 同上，LLVM 调用点形态（每个实参都要带类型前缀）
pub fn ll_fmt_atom_args() string {
    var b0: string = base.i2s(sema.atom_intern("text"));
    var b1: string = base.i2s(sema.atom_intern("json"));
    var b2: string = base.i2s(sema.atom_intern("rawbin"));
    var b3: string = base.i2s(sema.atom_intern("protobuf"));
    return base.sb_cat6(b0, ", i64 ", b1, ", i64 ", b2, base.sb_cat3(", i64 ", b3, ")"));
}

// ── 序列化值分派（M51，双后端共用判定）───────────────────────
// 返回选择子："str" | "atom" | "bool" | "f" | "i"。位宽/符号另由 ll_bits/ll_signed 取，
// 因为 rawbin 格式要按静态位宽写定长小端字节 —— 判定必须编译期完成。
pub fn ser_sel(td: i64) string {
    if (td < 0) {
        return "i";
    }
    var t: TD = sema.tds[td];
    if (t.cat == "string") {
        return "str";
    }
    var sn: string = sema.td_sname(td);
    if (sn == "atom") {
        return "atom";
    }
    if (sn == "bool") {
        return "bool";
    }
    if (sn == "f16" || sn == "f32" || sn == "f64") {
        return "f";
    }
    return "i";
}

// ── 反序列化（读路径，M52 读路径，Option B）：`fid > Type` 的右操作数是「类型」──
// 把右操作数（类型表达式节点）解析为 TD，并判定读路径是否支持该类型。





// 数学内建表达式发射（C 后端）：命中则返回 "t_math_<cn>(casted_args)"，否则 ""。
// cn 同时覆盖 @sin（mbuitin）与 sin（call）两种来源；每个实参显式 cast 到 double/float，
// 避免 <math.h> 未包含时原型缺失 / 隐式声明告警；t_math_* 包装位于 t_runtime.h。
pub fn math_is_mbuiltin_c(cn: string) bool {
    // 拆分为多个较短的 || 链，避免单一超长二元表达式触发编译器递归解析栈溢出。
    if (cn == "sin" || cn == "sinf" || cn == "cos" || cn == "cosf" || cn == "tan" || cn == "tanf"
        || cn == "atan" || cn == "atanf" || cn == "atan2" || cn == "atan2f" || cn == "acos" || cn == "acosf"
        || cn == "asin" || cn == "asinf" || cn == "exp" || cn == "expf" || cn == "log" || cn == "logf"
        || cn == "log10" || cn == "log10f" || cn == "pow" || cn == "powf" || cn == "sinh" || cn == "sinhf") {
        return true;
    }
    if (cn == "cosh" || cn == "coshf" || cn == "tanh" || cn == "tanhf" || cn == "sqrt" || cn == "sqrtf"
        || cn == "fmod" || cn == "fmodf" || cn == "fabs" || cn == "fabsf" || cn == "floor" || cn == "floorf"
        || cn == "ceil" || cn == "ceilf" || cn == "trunc" || cn == "truncf" || cn == "round" || cn == "roundf"
        || cn == "exp2" || cn == "exp2f" || cn == "log2" || cn == "log2f") {
        return true;
    }
    if (cn == "log1p" || cn == "log1pf" || cn == "expm1" || cn == "expm1f" || cn == "hypot" || cn == "hypotf"
        || cn == "cbrt" || cn == "cbrtf"
        || cn == "copysign" || cn == "copysignf" || cn == "nextafter" || cn == "nextafterf"
        || cn == "remainder" || cn == "remainderf" || cn == "fmin" || cn == "fminf"
        || cn == "fmax" || cn == "fmaxf" || cn == "fdim" || cn == "fdimf") {
        return true;
    }
    if (cn == "fma" || cn == "fmaf"
        || cn == "signbit" || cn == "isnan" || cn == "isinf" || cn == "isfinite" || cn == "isnormal") {
        return true;
    }
    return false;
}
// 谓词类数学内建：返回整型（i32，0 / 非 0），而非浮点。一元，无 f 后缀变体。
pub fn math_is_predicate_c(cn: string) bool {
    if (cn == "signbit" || cn == "isnan" || cn == "isinf" || cn == "isfinite" || cn == "isnormal") {
        return true;
    }
    return false;
}

// f32 变体判定：见 codegen_ll.tc 同名注释（isinf 以 'f' 结尾但非 f32 变体，须按基名判断）。
pub fn math_is_f32_variant_c(cn: string) bool {
    if (str_slice(cn, str_len(cn) - 1, str_len(cn)) != "f") { return false; }
    var base: string = str_slice(cn, 0, str_len(cn) - 1);
    return math_is_mbuiltin_c(base);
}
pub fn emit_math_call(cn: string, av: []string) string {
    if (math_is_mbuiltin_c(cn) == false) { return ""; }
    var mty: string = "double";
    if (math_is_f32_variant_c(cn)) { mty = "float"; }
    var cargs: string = "";
    var ci: i64 = 0;
    while (ci < slice_len(av) as i64) {
        if (ci > 0) { cargs = base.sb_cat2(cargs, ", "); }
        cargs = base.sb_cat2(cargs, base.sb_cat4("(", mty, ")", av[ci]));
        ci = ci + 1;
    }
    return base.sb_cat3(base.sb_cat3("t_math_", cn, "("), cargs, ")");
}

pub fn emit_expr(e: i64) string {
    if (e < 0) {
        return "";
    }
    var n: Node = base.nodes[e];

    if (n.kind == "int") {
        if (n.ia == 16) {
            return n.sa;
        }
        if (n.ia == 2) {
            // value.replace(/^0b/i, "") 再加 0b 前缀
            var v: string = n.sa;
            var body: string = v;
            if (str_len(v) >= 2) {
                if (v[0] == 48 && (v[1] == 98 || v[1] == 66)) {
                    body = str_slice(v, 2, str_len(v));
                }
            }
            return base.sb_cat2("0b", body);
        }
        if (n.ia == 8) {
            // t 写作 0o755，C 的八进制前缀是单个 0
            var ov: string = n.sa;
            var obody: string = ov;
            if (str_len(ov) >= 2) {
                if (ov[0] == 48 && (ov[1] == 111 || ov[1] == 79)) {
                    obody = str_slice(ov, 2, str_len(ov));
                }
            }
            return base.sb_cat2("0", obody);
        }
        return n.sa;
    }
    if (n.kind == "atom") {
        if (n.ia <= 0) { n.ia = sema.atom_intern(n.sa); slice_set(base.nodes, e, n); }
        return base.i2s(n.ia);
    }
    // 内建 fid 常量（M51）：编译期常量 0/1/2，无运行时查找
    if (n.kind == "fidconst") {
        return base.i2s(n.ia);
    }
    // 序列化操作符（M51）：t_ser_* 一律**返回目标 fid**，故链式 `f < a < b`
    // 直接落成嵌套调用 t_ser_x(t_ser_y(f, a), b)，无需临时量。
    if (n.kind == "serialize") {
        var sfid: string = emit_expr(n.na);
        var sval: string = emit_expr(n.nb);
        var std2: i64 = expr_type_desc(n.nb);
        var ssel: string = ser_sel(std2);
        if (ssel == "str") { return base.sb_cat5("t_ser_str(", sfid, ", ", sval, ")"); }
        if (ssel == "atom") { return base.sb_cat5("t_ser_atom(", sfid, ", ", sval, ")"); }
        if (ssel == "bool") { return base.sb_cat5("t_ser_bool(", sfid, ", ", sval, ")"); }
        var sbits: string = base.i2s(base.ll_bits(sema.td_sname(std2)));
        if (ssel == "f") {
            return base.sb_cat6("t_ser_f64(", sfid, ", ", sval, ", ", base.sb_cat2(sbits, ")"));
        }
        var ssgn: string = "0";
        if (base.ll_signed(sema.td_sname(std2))) { ssgn = "1"; }
        return base.sb_cat6("t_ser_int(", sfid, ", ", sval, ", ", base.sb_cat4(sbits, ", ", ssgn, ")"));
    }
    // 反序列化（M52 读路径）：t_deser_* 返回裸 T 值；EOF/错误返默认值，调用方用 fid_eof 探测
    if (n.kind == "deserialize") {
        var dfid: string = emit_expr(n.na);
        var dtd: i64 = sema.deser_type_of(n.nb);
        var dsel: string = ser_sel(dtd);
        if (dsel == "str") { return base.sb_cat3("t_deser_str(", dfid, ")"); }
        if (dsel == "atom") { return base.sb_cat3("t_deser_atom(", dfid, ")"); }
        if (dsel == "bool") { return base.sb_cat3("t_deser_bool(", dfid, ")"); }
        var dbits: string = base.i2s(sema.get_bw(sema.td_sname(dtd)));
        if (dsel == "f") {
            return base.sb_cat5("t_deser_f64(", dfid, ", ", dbits, ")");
        }
        var dsgn: string = "0";
        if (base.ll_signed(sema.td_sname(dtd))) { dsgn = "1"; }
        return base.sb_cat6("t_deser_int(", dfid, ", ", dbits, ", ", base.sb_cat2(dsgn, ")"));
    }
    if (n.kind == "float") {
        // IEEE-754 特殊值：走编译器内建而非 <math.h> 的 INFINITY / NAN。
        // 引入 math.h 会把 `yn` / `y0` / `j1` / `gamma` 等 libc 名字灌进
        // 每个翻译单元，与用户函数撞名（examples/fid_error_demo.tc 的 `yn`
        // 就是实例）。内建无需头文件，clang / gcc 均支持，且 C 后端本就只
        // 面向 clang。
        if (n.sa == "inf") { return "__builtin_inf()"; }
        if (n.sa == "-inf") { return "(-__builtin_inf())"; }
        if (n.sa == "nan") { return "__builtin_nan(\"\")"; }
        if (n.sa == "-nan") { return "(-__builtin_nan(\"\"))"; }
        return n.sa;
    }
    if (n.kind == "string") {
        return base.sb_cat3("TSTR_LIT(\"", esc_c(n.sa), "\")");
    }
    if (n.kind == "typeinfo") {
        return emit_type_info_c(n.sa);
    }
    if (n.kind == "bool") {
        if (n.ba) {
            return "true";
        }
        return "false";
    }
    if (n.kind == "null") {
        return "NULL";
    }
    if (n.kind == "opt_none") {
        return "NULL";
    }
    if (n.kind == "ident") {
        var idn: string = mb_sub(n.sa);
        // 同函数内重名局部（shadowing）：反查该标识符解析到的声明节点，发射唯一化后的名字。
        if (em_in_fn) {
            var vdcl: i64 = base.idecl_get(e);
            if (vdcl >= 0 && base.g_local_has(vdcl)) {
                return base.sb_cat3(n.sa, "__", base.i2s(vdcl));
            }
        }
        // 顶层具名函数出现在**值位置** → 取其闭包全局的地址（FuncType v2 / M47）。
        // 直接调用的 callee 不经此分支（call 分支直接读 cal.sa），故凡是走到这里
        // 且解析到 FuncDecl 的标识符，必然是「函数作为值」。局部/参数同名时局部优先。
        if (em_in_fn == false || fs_get(em_cur_fn, idn) < 0) {
            if (clos_decl_of(idn) >= 0) {
                clos_mark(idn);
                return base.sb_cat3("(&__tclos_", idn, ")");
            }
        }
        return idn;
    }
    // 编译期闭包逃逸的捕获子节点（P5）：透明透传其已物化值（sa 由 closure_make emit 读作 env 字段名）。
    if (n.kind == "closure_capval") { return emit_expr(n.na); }
    // 闭包构造（M48）：堆分配环境 → 按值拷入捕获量 → 堆分配 TClosure → 返回其指针。
    // 借 map 字面量同款「前置语句 + 临时量」机制，故可出现在任意表达式位置。
    if (n.kind == "closure_make") {
        g_clos_cnt = g_clos_cnt + 1;
        var cm_pad: string = g_stmt_pad;
        var cm_e: string = base.sb_cat2("_tcloe", base.i2s(g_clos_cnt));
        var cm_c: string = base.sb_cat2("_tclo", base.i2s(g_clos_cnt));
        var cm_ep: string = base.sb_cat2(n.sb, "*");
        spush(base.sb_cat6(cm_pad, cm_ep, " ", cm_e, base.sb_cat4(" = (", cm_ep, ")t_alloc(sizeof(", n.sb), "));"));
        var cm_ch: i64 = n.la;
        while (cm_ch >= 0) {
            var cm_k: Child = base.kids[cm_ch];
            var cm_f: Node = base.nodes[cm_k.val];
            var cm_v: string = emit_expr(cm_k.val);
            spush(base.sb_cat6(cm_pad, cm_e, "->", cm_f.sa, " = ", base.sb_cat2(cm_v, ";")));
            cm_ch = cm_k.next;
        }
        spush(base.sb_cat6(cm_pad, "TClosure* ", cm_c, " = (TClosure*)t_alloc(sizeof(TClosure));", "", ""));
        spush(base.sb_cat6(cm_pad, cm_c, "->fn = (void*)", n.sa, ";", ""));
        spush(base.sb_cat6(cm_pad, cm_c, "->env = (void*)", cm_e, ";", ""));
        fs_set(em_cur_fn, cm_c, expr_type_desc(e));
        g_stmt_pad = cm_pad;
        return cm_c;
    }
    if (n.kind == "map_lit") {
        g_map_lit_cnt = g_map_lit_cnt + 1;
        var mname: string = base.sb_cat2("_tmlit", base.i2s(g_map_lit_cnt));
        var mti: i64 = sema.infer_expr(e);
        var mt: TI = sema.tis[mti];
        var keytd: i64 = ti_to_td(mt.key);
        var valtd: i64 = ti_to_td(mt.val);
        c_emit_map_lit(e, mname, g_stmt_pad, keytd, valtd);
        return mname;
    }
    // match 表达式（L-15）：提升为「结果临时量 + if/else 链」，返回临时量名
    if (n.kind == "match") {
        g_match_cnt = g_match_cnt + 1;
        var mq_no: i64 = g_match_cnt;
        var mq_pad: string = g_stmt_pad;
        var mq_rn: string = base.sb_cat2("_tmr", base.i2s(mq_no));
        var mq_sn: string = base.sb_cat2("_tms", base.i2s(mq_no));
        var mq_std: i64 = expr_type_desc(n.na);
        fs_set(em_cur_fn, mq_sn, mq_std);
        var mq_sv: string = emit_expr(n.na);
        var mq_pushed: i64 = match_bind_push(e, mq_no);
        // ADT conpat 臂：先登记载荷绑定类型，否则首臂体引用绑定时 mq_rtd 会退化为 unknown
        match_conpat_binds_register(e);
        var mq_rtd: i64 = expr_type_desc(match_first_body(e));
        fs_set(em_cur_fn, mq_rn, mq_rtd);
        spush(base.sb_cat4(mq_pad, desc_to_c(mq_rtd), " ", base.sb_cat2(mq_rn, ";")));
        spush(base.sb_cat6(mq_pad, desc_to_c(mq_std), " ", mq_sn, " = ", base.sb_cat2(mq_sv, ";")));
        var mq_ind: i64 = (str_len(mq_pad) as i64) / 4;
        var mq_s: i64 = match_chain_from(n.la, mq_rn, mq_sn);
        while (mq_s >= 0) {
            var mq_sk: Child = base.kids[mq_s];
            emit_stmt(mq_sk.val, mq_ind);
            mq_s = mq_sk.next;
        }
        mb_drop(mq_pushed);
        g_stmt_pad = mq_pad;
        return mq_rn;
    }
    if (n.kind == "binary") {
        var op: string = n.sa;
        if (op == "==" || op == "!=") {
            var lt: i64 = expr_type_desc(n.na);
            var rt: i64 = expr_type_desc(n.nb);
            var ltc: TD = sema.tds[lt];
            var rtc: TD = sema.tds[rt];
            if (ltc.cat == "string" || rtc.cat == "string") {
                var cmp: string = base.sb_cat5("t_str_eq(", emit_expr(n.na), ", ", emit_expr(n.nb), ")");
                if (op == "==") {
                    return cmp;
                }
                return base.sb_cat3("(!", cmp, ")");
            }
        }
        if (op == "+") {
            var lt: i64 = expr_type_desc(n.na);
            var rt: i64 = expr_type_desc(n.nb);
            if (lt >= 0 && rt >= 0 && sema.tds[lt].cat == "string" && sema.tds[rt].cat == "string") {
                return base.sb_cat5("t_str_concat(", emit_expr(n.na), ", ", emit_expr(n.nb), ")");
            }
        }
        // 硬件 SIMD 向量逐元素算术：向量 op 向量 / 向量 op 标量（标量广播）直接透传给
        // GCC/Clang 的向量扩展，单条指令映射到 CPU 向量寄存器。仅算术运算符支持。
        if (op == "+" || op == "-" || op == "*" || op == "/") {
            var lt2: i64 = expr_type_desc(n.na);
            var rt2: i64 = expr_type_desc(n.nb);
            var lvc: bool = (lt2 >= 0 && sema.tds[lt2].cat == "vector");
            var rvc: bool = (rt2 >= 0 && sema.tds[rt2].cat == "vector");
            if (lvc || rvc) {
                return base.sb_cat6("(", emit_expr(n.na), " ", op, " ", base.sb_cat2(emit_expr(n.nb), ")"));
            }
        }
        return base.sb_cat6("(", emit_expr(n.na), " ", op, " ", base.sb_cat2(emit_expr(n.nb), ")"));
    }
    if (n.kind == "unary") {
        return base.sb_cat4("(", n.sa, emit_expr(n.na), ")");
    }
    // 取址 `&x` → C 的 `&(x)`（操作数须为可寻址左值，sema 已校验）。
    if (n.kind == "amp") {
        return base.sb_cat3("&(", emit_expr(n.na), ")");
    }
    // 解引用 `*r` → C 的 `*(r)`。赋值 `*r = v` 走下方 assign 通用分支自动得 `(*(r) = v)`。
    if (n.kind == "deref") {
        return base.sb_cat3("*(", emit_expr(n.na), ")");
    }
    if (n.kind == "assign") {
        // m[k] = v : map 索引写须走 t_map_put（find-or-insert），不能对读值再存回
        if (n.sa == "=") {
            var lnode: Node = base.nodes[n.na];
            if (lnode.kind == "index") {
                var lotd: i64 = expr_type_desc(lnode.na);
                if (lotd >= 0 && sema.tds[lotd].cat == "map") {
                    var mptr: string = c_map_lhs_ptr(lnode.na);
                    return base.sb_cat6("t_map_put(", mptr, ", ", c_map_keyp(lnode.na, lnode.nb), ", ", base.sb_cat2(c_map_valp(lnode.na, n.nb), ")"));
                }
            }
            // Sym = string : 自动 intern（LHS 存 id）；Sym = Sym（同池）走普通 id 拷贝
            var lhtd: i64 = expr_type_desc(n.na);
            if (lhtd >= 0 && sema.tds[lhtd].cat == "sym") {
                var rhtd: i64 = expr_type_desc(n.nb);
                if (rhtd >= 0 && sema.tds[rhtd].cat == "string") {
                    var stg: TD = sema.tds[lhtd];
                    var tagl: string = base.sb_cat3("TSTR_LIT(\"", esc_c(stg.name), "\")");
                    var intr: string = base.sb_cat6("t_sym_intern(", tagl, ", ", emit_expr(n.nb), ", ", base.sb_cat2(base.i2s(stg.alen), ")"));
                    return base.sb_cat5("(", emit_expr(n.na), " = ", intr, ")");
                }
            }
        }
        // 空切片字面量作赋值 RHS（`g = []`）：直接发射 t_slice_new（修 P0-4）。
        // ⚠ 空 `[]` 节点自身无 slice 类型（sema 未在赋值位置标注），走 emit_expr 会退化成
        // `{}` 复合字面量 → 与 TSlice{ptr,len} 结构不符。此处用 LHS 的 slice 类型兜底。
        if (n.sa == "=") {
            var rnb: Node = base.nodes[n.nb];
            var lhtd2: i64 = expr_type_desc(n.na);
            if (rnb.kind == "array_lit" && lhtd2 >= 0 && sema.tds[lhtd2].cat == "slice") {
                if (rnb.la < 0) {
                    return base.sb_cat6("(", emit_expr(n.na), " = t_slice_new(sizeof(",
                        desc_to_c(sema.tds[lhtd2].elem), "))", ")");
                }
                return base.sb_cat6("(", emit_expr(n.na), " = ", c_slice_lit_expr(n.nb, lhtd2), ")", "");
            }
            // 向量赋值 `v = {a,b,c,d}`：C 的 vector 类型不能用裸 `{}` 作 RHS，须加 (VTY) 转换。
            if (rnb.kind == "array_lit" && lhtd2 >= 0 && sema.tds[lhtd2].cat == "vector") {
                var vty: string = desc_to_c(lhtd2);
                var sbv: StringBuilder = sb_new();
                sb_append_char(sbv, 40);
                sb_append_str(sbv, emit_expr(n.na));
                sb_append_str(sbv, " = (");
                sb_append_str(sbv, vty);
                sb_append_str(sbv, "){");
                var ccv: i64 = rnb.la;
                var firstv: bool = true;
                while (ccv >= 0) {
                    if (!firstv) { sb_append_str(sbv, ", "); }
                    sb_append_str(sbv, emit_expr(base.kids[ccv].val));
                    firstv = false;
                    ccv = base.kids[ccv].next;
                }
                sb_append_str(sbv, "})");
                return sb_to_str(sbv);
            }
        }
        return base.sb_cat6("(", emit_expr(n.na), " ", n.sa, " ", base.sb_cat2(emit_expr(n.nb), ")"));
    }
    if (n.kind == "mbuiltin") {
        var mav: []string;
        var mc2: i64 = n.la;
        while (mc2 >= 0) {
            var mk: Child = base.kids[mc2];
            append(mav, emit_expr(mk.val));
            mc2 = mk.next;
        }
        var mr: string = emit_math_call(n.sa, mav);
        if (mr != "") { return mr; }
        // ── 硬件 SIMD 向量内建 ──
        if (n.sa == "splat") {
            // @splat(scalar, len) -> (VecType){s,s,...,s}（结果类型由 expr_type_desc 推导）
            var rtd: i64 = expr_type_desc(e);
            var vlen: i64 = 1;
