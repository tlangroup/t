            if (cn == "slice_sub") {
                if (n.la < 0) { return td_elem_mk("slice", td_mk("unknown")); }
                return expr_type_desc(kids[n.la].val);
            }
            // map_get(m, k) 的返回类型 = 映射的 V（从首个实参的 map 类型反查）
            if (cn == "map_get" && n.la >= 0) {
                var mn: i64 = kids[n.la].val;
                var mtd: i64 = expr_type_desc(mn);
                if (mtd >= 0) {
                    var mt: TD = tds[mtd];
                    if (mt.cat == "map" && mt.val >= 0) {
                        return mt.val;
                    }
