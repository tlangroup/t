            sb_append_str(sb, _ecty); sb_append_str(sb, "*)("); sb_append_str(sb, dstn); sb_append_str(sb, "); int64_t _ii;\n");
            sb_append_str(sb, "    for (_ii = 0; _ii < "); sb_append_i64(sb, _total); sb_append_str(sb, "; _ii++) { _tp[_ii] = (");
            sb_append_str(sb, _ecty); sb_append_str(sb, ")("); c_emit_val(sb, ins.args[1]); sb_append_str(sb, "); }\n  }\n");
