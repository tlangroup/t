        if (p0ty == "treduce_sum" or p0ty == "treduce_mul" or p0ty == "treduce_min" or p0ty == "treduce_max") {
            var _ecty: string = c_tystr_c(tir.tir_st_to_str(ins.st));
            if (_ecty == "" or _ecty == "void") { _ecty = "int32_t"; }
            // 聚合类型可能落在 args[1].st 或槽类型表（LLVM 轨备注：真实聚合类型常落在参数槽，inst.st 为空）。
            var _argn: string = c_strip_suf(ins.args[1].name);
            var _tst: string = c_strip_ptr(tir.tir_st_to_str(ins.args[1].st));
            if (c_is_tile_st(_tst) == false) { _tst = c_strip_ptr(c_slot_ty_find(_argn)); }
            var _total: i64 = c_tile_total(_tst);
            sb_append_str(sb, "  { "); sb_append_str(sb, _ecty); sb_append_str(sb, "* _tp = (");
            sb_append_str(sb, _ecty); sb_append_str(sb, "*)("); c_emit_val(sb, ins.args[1]); sb_append_str(sb, "); ");
            sb_append_str(sb, _ecty); sb_append_str(sb, " _acc");
