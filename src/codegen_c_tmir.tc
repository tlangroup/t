            sb_append_str(sb, "  "); sb_append_str(sb, dstn); sb_append_str(sb, " = t_str_concat(");
            c_emit_sval_arg(sb, ins.args[0], "TStr"); sb_append_str(sb, ", ");
            c_emit_sval_arg(sb, ins.args[1], "TStr"); sb_append_str(sb, ");\n");
            return;
        }
        if (cst == "%TSlice") {
            sb_append_str(sb, "  "); sb_append_str(sb, dstn); sb_append_str(sb, " = t_slice_concat(");
            c_emit_sval_arg(sb, ins.args[0], "TSlice"); sb_append_str(sb, ", ");
            c_emit_sval_arg(sb, ins.args[1], "TSlice"); sb_append_str(sb, ");\n");
            return;
        }
        if (cst == "%TBitStr") {
            sb_append_str(sb, "  "); sb_append_str(sb, dstn); sb_append_str(sb, " = t_bitstr_concat(");
            c_emit_sval_arg(sb, ins.args[0], "TBitStr"); sb_append_str(sb, ", ");
            c_emit_sval_arg(sb, ins.args[1], "TBitStr"); sb_append_str(sb, ");\n");
            return;
        }
        if (c_is_arr(cst)) {
            // 定长数组合并：按两侧「字节数」复制（t_array_concat(a, abytes, b, bbytes) → arena 新缓冲）。
            var asz: i64 = c_tstr_size(cst);
            var bsz: i64 = asz;
            var ta: string = c_slot_ty_find(c_strip_suf(ins.args[0].name));
            var tb: string = c_slot_ty_find(c_strip_suf(ins.args[1].name));
            if (c_is_arr(ta)) { asz = c_array_nelems(ta) * c_tstr_size(c_array_elem(ta)); }
            if (c_is_arr(tb)) { bsz = c_array_nelems(tb) * c_tstr_size(c_array_elem(tb)); }
            sb_append_str(sb, "  "); sb_append_str(sb, dstn); sb_append_str(sb, " = (unsigned char*)t_array_concat((void*)(");
            c_emit_val(sb, ins.args[0]); sb_append_str(sb, "), (int64_t)("); sb_append_str(sb, base.i2s(asz));
            sb_append_str(sb, "), (void*)("); c_emit_val(sb, ins.args[1]); sb_append_str(sb, "), (int64_t)(");
            sb_append_str(sb, base.i2s(bsz)); sb_append_str(sb, "));\n");
            return;
        }
        // ptr<void>：Concat 语境下唯一落到 ptr<void> 的是 map[K]V ++ map[K]V。
        sb_append_str(sb, "  "); sb_append_str(sb, dstn); sb_append_str(sb, " = (unsigned char*)t_map_concat((TMap*)(");
        c_emit_val(sb, ins.args[0]); sb_append_str(sb, "), (TMap*)("); c_emit_val(sb, ins.args[1]);
        sb_append_str(sb, "));\n");
        return;
    }
    if (op == tir__TIR_OP_SLICE_AT) {
        // slice_at <dst> <slice> <idx> → dst = t_slice_at(<TSlice 值>, i64) 返回元素地址（void*）。
        // dst 是元素地址 → 预扫描已登记为地址槽，后续 LOAD 会按元素类型 memcpy 出值。
        var satn: string = c_strip_suf(ins.dst.name);
        sb_append_str(sb, "  "); sb_append_str(sb, satn); sb_append_str(sb, " = (unsigned char*)t_slice_at(");
        c_emit_sval_arg(sb, ins.args[0], "TSlice");
        sb_append_str(sb, ", (int64_t)("); c_emit_val(sb, ins.args[1]); sb_append_str(sb, "));\n");
        c_addr_mark(satn, ins.st);
        return;
    }
    if (op == tir__TIR_OP_STR_AT) {
        // str_at <dst> <str> <idx> → 字节值（u8），按标量赋值。
        var srn: string = c_strip_suf(ins.dst.name);
        sb_append_str(sb, "  "); sb_append_str(sb, srn); sb_append_str(sb, " = (uint8_t)t_str_byte_at(");
        c_emit_sval_arg(sb, ins.args[0], "TStr");
        sb_append_str(sb, ", (int64_t)("); c_emit_val(sb, ins.args[1]); sb_append_str(sb, "));\n");
        return;
    }
    if (op == tir__TIR_OP_CONST_PTR_NULL) {
        var cpn: string = c_strip_suf(ins.dst.name);
        sb_append_str(sb, "  "); sb_append_str(sb, cpn); sb_append_str(sb, " = (unsigned char*)0;\n");
        return;
    }
    if (op == tir__TIR_OP_NEG) {
        var dstn: string = c_strip_suf(ins.dst.name);
        sb_append_str(sb, "  "); sb_append_str(sb, dstn); sb_append_str(sb, " = -(");
        c_emit_val(sb, ins.args[0]); sb_append_str(sb, ");\n");
        return;
    }
    if (op == tir__TIR_OP_NOT or op == tir__TIR_OP_LNOT) {
        // 对齐 LLVM 后端：t 的 `!`（逻辑非）在 TIR 中既可能以 TIR_OP_NOT 也可能以 TIR_OP_LNOT 出现，
        // LLVM 后端对两者统一发射 icmp eq x,0（逻辑非）。C 后端此前对 NOT 发射按位取反 `~`，
        // 导致布尔值 1→-2（非零→true）算反（如 f-string `{!on}`、布尔取反）。统一为逻辑非。
        var dstn: string = c_strip_suf(ins.dst.name);
        sb_append_str(sb, "  "); sb_append_str(sb, dstn); sb_append_str(sb, " = ((");
        c_emit_val(sb, ins.args[0]); sb_append_str(sb, ") == 0 ? 1 : 0);\n");
        return;
    }
    if (op == tir__TIR_OP_ZEXT or op == tir__TIR_OP_SEXT or op == tir__TIR_OP_TRUNC) {
        var dstn: string = c_strip_suf(ins.dst.name);
        var dstst: i64 = c_slot_st(dstn, g_cf);
        var srcst: i64 = c_arg_st(ins, 0);
        var db: i64 = c_st_bits(dstst);
        var sb2: i64 = c_st_bits(srcst);
        sb_append_str(sb, "  "); sb_append_str(sb, dstn); sb_append_str(sb, " = (");
        if (db > sb2) {
            if (op == tir__TIR_OP_ZEXT) {
                sb_append_str(sb, c_int_cast(dstst, false)); sb_append_str(sb, ")("); sb_append_str(sb, c_int_cast(srcst, false)); sb_append_str(sb, ")(");
            } else {
                sb_append_str(sb, c_int_cast(dstst, true)); sb_append_str(sb, ")(");
            }
        } else if (db < sb2) {
            sb_append_str(sb, c_int_cast(dstst, true)); sb_append_str(sb, ")(");
        } else {
            sb_append_str(sb, tmir.tmir_st_c(dstst)); sb_append_str(sb, ")(");
        }
        c_emit_val(sb, ins.args[0]); sb_append_str(sb, ");\n");
        return;
    }
    if (op == tir__TIR_OP_FPTOSI or op == tir__TIR_OP_FPTOUI or op == tir__TIR_OP_SITOFP or op == tir__TIR_OP_UITOFP or op == tir__TIR_OP_FPEXT or op == tir__TIR_OP_FPTRUNC) {
        var dstn: string = c_strip_suf(ins.dst.name);
        // ⚠ 源/目的 C 类型相同时（如 math 内建 @sqrt 经 TIR 落入 i64 中间槽再 SITOFP 回 f64，
        //   而 C 后端已把中间槽标为 f64）：直接 plain 赋值，跳过 (double)(int64_t)(x) 这类
        //   值转换强转（会把 double 截成 int64 → 数学函数结果全 0/整数）。语义上同类型转换恒等。
        //   用 c_slot_c_ty（尊重预扫描手工标记）比较，否则已标 f64 的中间槽仍被 c_slot_st 算成 i64。
        if (c_slot_c_ty(dstn) == c_slot_c_ty(c_strip_suf(ins.args[0].name))) {
            sb_append_str(sb, "  "); sb_append_str(sb, dstn); sb_append_str(sb, " = ");
            c_emit_val(sb, ins.args[0]); sb_append_str(sb, ";\n");
            return;
        }
        var dt: string = tmir.tmir_st_c(c_slot_st(dstn, g_cf));
        var st2: string = "";
        if (op == tir__TIR_OP_FPTOSI or op == tir__TIR_OP_SITOFP) { st2 = c_int_cast(c_arg_st(ins, 0), true); }
        else if (op == tir__TIR_OP_FPTOUI or op == tir__TIR_OP_UITOFP) { st2 = c_int_cast(c_arg_st(ins, 0), false); }
        else { st2 = tmir.tmir_st_c(c_arg_st(ins, 0)); }
        sb_append_str(sb, "  "); sb_append_str(sb, dstn); sb_append_str(sb, " = ("); sb_append_str(sb, dt); sb_append_str(sb, ")("); sb_append_str(sb, st2); sb_append_str(sb, ")(");
        c_emit_val(sb, ins.args[0]); sb_append_str(sb, ");\n");
        return;
    }
    // 比较
    if (c_is_cmp_op(op)) {
        var dstn: string = c_strip_suf(ins.dst.name);
        // 字符串 ==/!=：TStr 是结构体值，按整数强转比较非法 → 走运行库 t_str_eq。
        if ((op == tir__TIR_OP_EQ or op == tir__TIR_OP_NE)
            and (c_is_tstr_st(c_arg_st(ins, 0)) or c_is_tstr_st(c_arg_st(ins, 1)))) {
            c_emit_str_eq(sb, dstn, op == tir__TIR_OP_NE, ins.args[0], ins.args[1]);
            return;
        }
        var is_signed: bool = (op == tir__TIR_OP_EQ or op == tir__TIR_OP_NE or op == tir__TIR_OP_SLT or op == tir__TIR_OP_SGT or op == tir__TIR_OP_SLE or op == tir__TIR_OP_SGE);
        var mnem: string = "";
        if (op == tir__TIR_OP_EQ) { mnem = "=="; } else if (op == tir__TIR_OP_NE) { mnem = "!="; }
        else if (op == tir__TIR_OP_SLT or op == tir__TIR_OP_ULT) { mnem = "<"; }
        else if (op == tir__TIR_OP_SGT or op == tir__TIR_OP_UGT) { mnem = ">"; }
        else if (op == tir__TIR_OP_SLE or op == tir__TIR_OP_ULE) { mnem = "<="; }
        else { mnem = ">="; }
        // ⚠ 浮点比较：操作数若是 f32/f64，必须按浮点类型比较（q != q 对 NaN 应为真），
        // 否则 c_int_cast 把浮点强转 int64 → 同比特位比较恒等 → NaN≠NaN 误判为假（literal_demo.nan_ne_self）。
        var a0st: i64 = c_arg_st(ins, 0);
        var a1st: i64 = c_arg_st(ins, 1);
        var at: string = c_int_cast(a0st, is_signed);
        var bt: string = c_int_cast(a1st, is_signed);
        if (a0st == tir__ST_F32 or a0st == tir__ST_F64) { at = tmir.tmir_st_c(a0st); }
        if (a1st == tir__ST_F32 or a1st == tir__ST_F64) { bt = tmir.tmir_st_c(a1st); }
        sb_append_str(sb, "  "); sb_append_str(sb, dstn); sb_append_str(sb, " = (");
        sb_append_str(sb, at); sb_append_str(sb, ")(");
        c_emit_val(sb, ins.args[0]); sb_append_str(sb, ") "); sb_append_str(sb, mnem); sb_append_str(sb, " (");
        sb_append_str(sb, bt); sb_append_str(sb, ")(");
        c_emit_val(sb, ins.args[1]);         sb_append_str(sb, ");\n");
        return;
    }
    // 字符串拼接：TIR 层 ADD(%TStr) 降级为 t_str_concat
    if (op == tir__TIR_OP_ADD and c_is_tstr_st(ins.st)) {
        var dstn: string = c_strip_suf(ins.dst.name);
        sb_append_str(sb, "  "); sb_append_str(sb, dstn); sb_append_str(sb, " = t_str_concat(");
        c_emit_val(sb, ins.args[0]); sb_append_str(sb, ", "); c_emit_val(sb, ins.args[1]); sb_append_str(sb, ");\n");
        return;
    }
    // 瓦片逐元素二元（arr<arr<elem x cols> x rows>）：与 LLVM 嵌套 GEP 循环逐位对齐，
    // 字节缓冲模型下把瓦片当行主序扁平 elem_cty* 缓冲，逐元素 apply op。
    // ⚠ 实测 tile `a + b` 的 inst.st 常为 ptr 或空串，真实聚合类型落在 inst.args[0].st。
    var _tst: string = "";
    if (c_is_tile_st(tir.tir_st_to_str(ins.st))) { _tst = tir.tir_st_to_str(ins.st); }
    if (_tst == "" and c_is_tile_st(tir.tir_st_to_str(ins.args[0].st))) { _tst = tir.tir_st_to_str(ins.args[0].st); }
    if (_tst != "") {
        // 仅数值逐元素 op 走瓦片分支（ADD/SUB/MUL）；位运算/比较/移位不在此列。
        if (op == tir__TIR_OP_ADD or op == tir__TIR_OP_SUB or op == tir__TIR_OP_MUL) {
            var _ecty: string = c_tile_elem_cty(_tst);
            var _total: i64 = c_tile_total(_tst);
            var _mn: string = c_binop_mnem(op);
            sb_append_str(sb, "  { "); sb_append_str(sb, _ecty); sb_append_str(sb, "* _lp = (");
            sb_append_str(sb, _ecty); sb_append_str(sb, "*)("); c_emit_val(sb, ins.args[0]); sb_append_str(sb, "); ");
            sb_append_str(sb, _ecty); sb_append_str(sb, "* _rp = ("); sb_append_str(sb, _ecty); sb_append_str(sb, "*)("); c_emit_val(sb, ins.args[1]); sb_append_str(sb, "); ");
            sb_append_str(sb, _ecty); sb_append_str(sb, "* _dp = ("); sb_append_str(sb, _ecty); sb_append_str(sb, "*)("); sb_append_str(sb, c_strip_suf(ins.dst.name)); sb_append_str(sb, "); int64_t _ii;\n");
            sb_append_str(sb, "    for (_ii = 0; _ii < "); sb_append_i64(sb, _total); sb_append_str(sb, "; _ii++) { _dp[_ii] = _lp[_ii] ");
            sb_append_str(sb, _mn); sb_append_str(sb, " _rp[_ii]; }\n  }\n");
            return;
        }
    }
    // 向量逐元素二元（vec<elem x N>）：与 LLVM <N x ELEM> 逐 lane 对齐，字节缓冲模型下把向量当
    // 扁平 elem_cty* 缓冲，逐元素 apply op（仅数值 ADD/SUB/MUL；位运算/比较/移位不在此列）。
    // ⚠ 与瓦片同：inst.st 常为 ptr 或空串，真实向量类型落在 inst.args[0].st。
    var _vst: string = "";
    if (c_is_vec_st(tir.tir_st_to_str(ins.st))) { _vst = tir.tir_st_to_str(ins.st); }
    if (_vst == "" and c_is_vec_st(tir.tir_st_to_str(ins.args[0].st))) { _vst = tir.tir_st_to_str(ins.args[0].st); }
    if (_vst != "") {
        if (op == tir__TIR_OP_ADD or op == tir__TIR_OP_SUB or op == tir__TIR_OP_MUL) {
            var _ecty: string = c_vec_elem_cty(_vst);
            var _total: i64 = c_vec_nelems(_vst);
            var _mn: string = c_binop_mnem(op);
            sb_append_str(sb, "  { "); sb_append_str(sb, _ecty); sb_append_str(sb, "* _lp = (");
            sb_append_str(sb, _ecty); sb_append_str(sb, "*)("); c_emit_val(sb, ins.args[0]); sb_append_str(sb, "); ");
            sb_append_str(sb, _ecty); sb_append_str(sb, "* _rp = ("); sb_append_str(sb, _ecty); sb_append_str(sb, "*)("); c_emit_val(sb, ins.args[1]); sb_append_str(sb, "); ");
            sb_append_str(sb, _ecty); sb_append_str(sb, "* _dp = ("); sb_append_str(sb, _ecty); sb_append_str(sb, "*)("); sb_append_str(sb, c_strip_suf(ins.dst.name)); sb_append_str(sb, "); int64_t _ii;\n");
            sb_append_str(sb, "    for (_ii = 0; _ii < "); sb_append_i64(sb, _total); sb_append_str(sb, "; _ii++) { _dp[_ii] = _lp[_ii] ");
            sb_append_str(sb, _mn); sb_append_str(sb, " _rp[_ii]; }\n  }\n");
            return;
        }
    }
    // 任意位宽整数（AWI，N>64）二元加/减：dst/arg 均为 little-endian 字节缓冲，经运行库 t_big_add/t_big_sub 计算，
    // 与 LLVM 原生 i<N>/u<N> 算术逐字对齐。第二操作数可能是同宽缓冲（AWI）或窄标量（≤64 位，如 `a + 1`），
    // 后者经 t_big_from_i64 提升为全宽缓冲（按标量自身符号零/符号扩展）。仅 ADD/SUB 走本分支（MUL 等暂不覆盖，按需扩展）。
    var _awist: string = tir.tir_st_to_str(ins.st);
    if (c_is_awi_st(_awist) == false and c_is_awi_st(tir.tir_st_to_str(ins.args[0].st))) { _awist = tir.tir_st_to_str(ins.args[0].st); }
    if (c_is_awi_st(_awist) and (op == tir__TIR_OP_ADD or op == tir__TIR_OP_SUB)) {
        var _nb: i64 = c_awi_size(_awist);
        var _dstn: string = c_strip_suf(ins.dst.name);
        var _a0st: string = tir.tir_st_to_str(ins.args[0].st);
        var _a1st: string = tir.tir_st_to_str(ins.args[1].st);
        var _a0expr: string = c_strip_suf(ins.args[0].name);
        var _a1expr: string = c_strip_suf(ins.args[1].name);
        var _need_block: bool = false;
        // 操作数 0：AWI 缓冲直接用槽名；窄标量（≤64 位）经 t_big_from_i64 提升进临时缓冲。
        if (c_is_awi_st(_a0st) == false) {
            var _t0: string = base.sb_cat2("_awib", base.i2s(g_c_tmpc)); g_c_tmpc = g_c_tmpc + 1;
            var _s0: string = "0"; if (c_starts(_a0st, "i")) { _s0 = "1"; }
            sb_append_str(sb, "  { unsigned char* "); sb_append_str(sb, _t0);
            sb_append_str(sb, " = (unsigned char*)t_alloc((size_t)("); sb_append_i64(sb, _nb); sb_append_str(sb, ")); t_big_from_i64((void*)(");
            sb_append_str(sb, _t0); sb_append_str(sb, "), (int64_t)("); sb_append_str(sb, _a0expr);
            sb_append_str(sb, "), (int)("); sb_append_i64(sb, _nb); sb_append_str(sb, "), "); sb_append_str(sb, _s0);
            sb_append_str(sb, "); ");
            _a0expr = _t0; _need_block = true;
        } else if (_need_block == false) { sb_append_str(sb, "  { "); _need_block = true; }
        // 操作数 1：同上。
        if (c_is_awi_st(_a1st) == false) {
            var _t1: string = base.sb_cat2("_awib", base.i2s(g_c_tmpc)); g_c_tmpc = g_c_tmpc + 1;
            var _s1: string = "0"; if (c_starts(_a1st, "i")) { _s1 = "1"; }
            sb_append_str(sb, "unsigned char* "); sb_append_str(sb, _t1);
            sb_append_str(sb, " = (unsigned char*)t_alloc((size_t)("); sb_append_i64(sb, _nb); sb_append_str(sb, ")); t_big_from_i64((void*)(");
            sb_append_str(sb, _t1); sb_append_str(sb, "), (int64_t)("); sb_append_str(sb, _a1expr);
            sb_append_str(sb, "), (int)("); sb_append_i64(sb, _nb); sb_append_str(sb, "), "); sb_append_str(sb, _s1);
            sb_append_str(sb, "); ");
            _a1expr = _t1;
        }
        var _fn: string = "add"; if (op == tir__TIR_OP_SUB) { _fn = "sub"; }
        sb_append_str(sb, "t_big_"); sb_append_str(sb, _fn);
        sb_append_str(sb, "((unsigned char*)("); sb_append_str(sb, _dstn);
        sb_append_str(sb, "), (unsigned char*)("); sb_append_str(sb, _a0expr);
        sb_append_str(sb, "), (void*)("); sb_append_str(sb, _a1expr);
        sb_append_str(sb, "), (int)("); sb_append_i64(sb, _nb); sb_append_str(sb, ")); }\n");
        return;
    }
    // 浮点 / 整数 二元
    var mnem: string = c_binop_mnem(op);
    if (mnem == "") { sb_append_str(sb, "  /* unsupported op "); sb_append_str(sb, base.i2s(op)); sb_append_str(sb, " */\n"); return; }
    var dstn: string = c_strip_suf(ins.dst.name);
    var isfloat: bool = (c_val_st(ins) == tir__ST_F32 or c_val_st(ins) == tir__ST_F64);
    // ⚠ 浮点判据须补「操作数 C 类型」：TIR 里 f64 除法/取余复用 SDIV/UDIV 操作码，
    //   仅凭 ins.st 会在中间槽未标浮点时漏判 → 落到下面 SDIV 分支被 (int64_t) 强转后
    //   做整数除法，结果恒 0（rand_demo 的 (r as f64)/2147483648.0 → 0）。
    if (c_is_fp_cty(c_operand_c_ty(ins.args[0])) or c_is_fp_cty(c_operand_c_ty(ins.args[1]))) { isfloat = true; }
    // 字符串 ==/!=：TStr 是结构体值，按整数比较会非法强转 → 走运行库 t_str_eq。
    if ((op == tir__TIR_OP_EQ or op == tir__TIR_OP_NE)
        and (c_c_ty_is_struct(c_operand_c_ty(ins.args[0])) or c_c_ty_is_struct(c_operand_c_ty(ins.args[1])))) {
        c_emit_str_eq(sb, dstn, op == tir__TIR_OP_NE, ins.args[0], ins.args[1]);
        return;
    }
    sb_append_str(sb, "  "); sb_append_str(sb, dstn); sb_append_str(sb, " = ");
    if (c_c_ty_is_struct(tmir.tmir_st_c(c_slot_st(dstn, g_cf))) == false) {
        sb_append_str(sb, "("); sb_append_str(sb, tmir.tmir_st_c(c_slot_st(dstn, g_cf))); sb_append_str(sb, ")(");
    } else { sb_append_str(sb, "("); }
    // ⚠ 浮点路径必须排在 SHL / UDIV / SDIV 之前：TIR 里 f64 除法复用 SDIV 操作码，
    //   若先落 SDIV 分支，两个操作数会被 (int64_t) 强转后做**整数除法** → 结果恒 0
    //   （rand_demo：rand_float 的 (r as f64)/2147483648.0 打印成 0）。
    if (isfloat) {
        if (mnem == "%") {
            sb_append_str(sb, "fmod("); c_emit_val(sb, ins.args[0]); sb_append_str(sb, ", "); c_emit_val(sb, ins.args[1]); sb_append_str(sb, "));\n");
            return;
        }
        c_emit_val(sb, ins.args[0]); sb_append_str(sb, " "); sb_append_str(sb, mnem); sb_append_str(sb, " "); c_emit_val(sb, ins.args[1]); sb_append_str(sb, ");\n");
        return;
    }
    if (op == tir__TIR_OP_SHL) {
        c_emit_val(sb, ins.args[0]); sb_append_str(sb, " "); sb_append_str(sb, mnem); sb_append_str(sb, " "); c_emit_val(sb, ins.args[1]); sb_append_str(sb, ");\n");
        return;
    }
    if (op == tir__TIR_OP_LSHR or op == tir__TIR_OP_ASHR) {
        var cast: string = "";
        if (op == tir__TIR_OP_LSHR) { cast = c_int_cast(c_arg_st(ins, 0), false); } else { cast = c_int_cast(c_arg_st(ins, 0), true); }
        sb_append_str(sb, "("); sb_append_str(sb, cast); sb_append_str(sb, ")("); c_emit_val(sb, ins.args[0]); sb_append_str(sb, ") "); sb_append_str(sb, mnem); sb_append_str(sb, " "); c_emit_val(sb, ins.args[1]); sb_append_str(sb, ");\n");
        return;
    }
    if (op == tir__TIR_OP_UDIV or op == tir__TIR_OP_UREM) {
        sb_append_str(sb, "("); sb_append_str(sb, c_int_cast(c_arg_st(ins, 0), false)); sb_append_str(sb, ")("); c_emit_val(sb, ins.args[0]); sb_append_str(sb, ") "); sb_append_str(sb, mnem); sb_append_str(sb, " "); sb_append_str(sb, "("); sb_append_str(sb, c_int_cast(c_arg_st(ins, 1), false)); sb_append_str(sb, ")("); c_emit_val(sb, ins.args[1]); sb_append_str(sb, "));\n");
        return;
    }
    if (op == tir__TIR_OP_SDIV or op == tir__TIR_OP_SREM) {
        sb_append_str(sb, "("); sb_append_str(sb, c_int_cast(c_arg_st(ins, 0), true)); sb_append_str(sb, ")("); c_emit_val(sb, ins.args[0]); sb_append_str(sb, ") "); sb_append_str(sb, mnem); sb_append_str(sb, " "); sb_append_str(sb, "("); sb_append_str(sb, c_int_cast(c_arg_st(ins, 1), true)); sb_append_str(sb, ")("); c_emit_val(sb, ins.args[1]); sb_append_str(sb, "));\n");
        return;
    }
    // 默认整数算术（ADD/SUB/MUL/AND/OR/XOR）
    c_emit_val(sb, ins.args[0]); sb_append_str(sb, " "); sb_append_str(sb, mnem); sb_append_str(sb, " "); c_emit_val(sb, ins.args[1]); sb_append_str(sb, ");\n");
}

// load/store 查地址槽元素类型
pub fn c_addr_st_of(n: string) i64 {
    var i: i64 = 0;
    while (i < slice_len(g_c_addr_name) as i64) { if (g_c_addr_name[i] == n) { return g_c_addr_st[i]; } i = i + 1; }
    return tir__ST_NONE;
}

pub fn c_binop_mnem(op: i64) string {
    if (op == tir__TIR_OP_ADD) { return "+"; }
    if (op == tir__TIR_OP_SUB) { return "-"; }
    if (op == tir__TIR_OP_MUL) { return "*"; }
    if (op == tir__TIR_OP_AND) { return "&"; }
    if (op == tir__TIR_OP_OR) { return "|"; }
    if (op == tir__TIR_OP_XOR) { return "^"; }
    if (op == tir__TIR_OP_SHL) { return "<<"; }
    if (op == tir__TIR_OP_LSHR or op == tir__TIR_OP_ASHR) { return ">>"; }
    if (op == tir__TIR_OP_SDIV or op == tir__TIR_OP_UDIV) { return "/"; }
    if (op == tir__TIR_OP_SREM or op == tir__TIR_OP_UREM) { return "%"; }
    if (op == tir__TIR_OP_EQ) { return "=="; }
    if (op == tir__TIR_OP_NE) { return "!="; }
    if (op == tir__TIR_OP_SLT or op == tir__TIR_OP_ULT) { return "<"; }
    if (op == tir__TIR_OP_SGT or op == tir__TIR_OP_UGT) { return ">"; }
    if (op == tir__TIR_OP_SLE or op == tir__TIR_OP_ULE) { return "<="; }
    if (op == tir__TIR_OP_SGE or op == tir__TIR_OP_UGE) { return ">="; }
    return "";
}
