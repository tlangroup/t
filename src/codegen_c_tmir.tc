        //   行主序扁平写（线性偏移 = ri*cols+ci，与 LLVM 嵌套数组布局一致），每元素 = scalar。
        if (p0ty == "tsplat") {
            var _tst: string = c_strip_ptr(tir.tir_st_to_str(ins.st));
            var _ecty: string = c_tile_elem_cty(_tst);
