                if (c_is_runtime_struct_st(fty) and c_is_runtime_struct_st(_srcc)) { _srctake = "&"; }
                sb_append_str(sb, "  memcpy((void*)("); sb_append_str(sb, dstn); sb_append_str(sb, " + ");
                sb_append_str(sb, base.i2s(fo)); sb_append_str(sb, "), (void*)(");
                sb_append_str(sb, _srctake); c_emit_val(sb, ins.args[ai]); sb_append_str(sb, "), (size_t)(");
                sb_append_str(sb, base.i2s(fsz)); sb_append_str(sb, "));\n");
            } else {
