// ══════════════════════════════════════════════════════════════════
// src/codegen_c_tmir.tc — tmir → C（.c 文本）便携后端
//
// 职责：消费 TMIRModule，发出可移植 C 源码（仅依赖 stdint/string/stdio），
// 无需 LLVM。与 codegen_wasm.tc / codegen_riscv.tc 同构（均消费 TMIRModule），
// 但 C 后端利用 C 的 goto+label 直接翻译 CFG——无需 WASM 那样的结构化控制流重建，
// 实现大幅简化且对任意可归约/不可归约 CFG 都正确。
//
// 聚合内存模型（struct/数组）：本地字节缓冲 `unsigned char <slot>_buf[SIZE]`，
//   地址槽为 `unsigned char*`，GEP 做字节偏移，load/store 走 memcpy（规避严格别名 UB）。
//   与 WASM 的线性内存思路一致，仅把「模块级 g_mem」换成「每聚合独立缓冲」。
//
// 覆盖：S1 标量（i32/i64/f64/bool、算术/比较/位/移位/load/store/call/ret/br/br_cond）
//   + S2 聚合（struct/union/数组/字符串/全局内存）。M2 判据「tmir→C 便携后端 + S2 聚合」。
// ══════════════════════════════════════════════════════════════════

const base = @import("src.base");
const tir = @import("src.tir");
const tmir = @import("src.tmir");
const sema = @import("src.sema");
const lex = @import("src.lex");

// ── 名字归一化 ───────────────────────────────────────────────
// 剥类型后缀（tir_os 附加的 `.s<ST码>`）+ 前导 sigil（$ slot / @ global）；
// 与 wasm w_strip_suf 同逻辑，但 C 标识符不允许 `$`/`@`，故一并剥除。
pub fn c_strip_suf(n: string) string {
    var L: i64 = str_len(n) as i64;
    if (L > 0 and (n[0] == 36 or n[0] == 64)) { n = str_slice(n, 1, L); L = L - 1; }
    var i: i64 = L - 1;
    while (i >= 1) {
        if (n[i] == 115 and n[i - 1] == 46) {
            var suf: string = str_slice(n, i + 1, L);
            var okd: bool = str_len(suf) > 0;
            var j: i64 = 0;
            while (j < str_len(suf) as i64) { if (suf[j] < 48 or suf[j] > 57) { okd = false; } j = j + 1; }
            if (okd) { return str_slice(n, 0, i - 1); }
        }
        i = i - 1;
    }
    return n;
}

// 函数名：剥 '@' 前缀与类型后缀；把 '.' 重整为 '_'（C 标识符不允许 '.'，如 t.__ginit → t__ginit）。
pub fn c_fn_name(n: string) string {
    var s: string = c_strip_suf(n);
    if (str_len(s) as i64 > 0 and s[0] == 64) { s = str_slice(s, 1, str_len(s) as i64); }
    var out: string = "";
    var i: i64 = 0;
    while (i < str_len(s) as i64) {
        if (s[i] == 46) { out = base.sb_cat2(out, "_"); }   // '.'
        else { out = base.sb_cat2(out, str_slice(s, i, i + 1)); }
        i = i + 1;
    }
    return out;
}

// 块标签：剥 '@' 后加 "L" 前缀（"@entry" → "Lentry"，"@L0" → "LL0"，"@Lwhile.h0" → "LLwhile_h0"）。
// 注意：tmir 块名可含 '.'（子块如 .h0/.b1/.e2），C 标识符不允许 '.'，须重整为 '_'。
pub fn c_block_label(nm: string) string {
    // ⚠ 块名只剥前缀 '@'，并将 '.' 转 '_'；**严禁**调用 c_strip_suf：
    // c_strip_suf 会把 TIR 的 switch 出口块命名 `Lfe.s6`（'.s'+数字）整段剥掉，
    // 导致 Lfe.s6/Lfe.s10/Lfe.s14/Lfe.s2 全部塌缩成裸 `LLfe` → 同函数内 label 重定义。
    var s: string = nm;
    if (str_len(s) as i64 > 0 and s[0] == 64) { s = str_slice(s, 1, str_len(s) as i64); }
    var out: string = "";
    var i: i64 = 0;
    while (i < str_len(s) as i64) {
        if (s[i] == 46) { out = base.sb_cat2(out, "_"); }
        else { out = base.sb_cat2(out, str_slice(s, i, i + 1)); }
        i = i + 1;
    }
    return base.sb_cat2("L", out);
}

// ── 类型 / 布局辅助（后端无关，与 wasm 同逻辑，c_ 前缀避免跨文件符号冲突）──
pub fn c_starts(s: string, pre: string) bool {
    if (str_len(s) as i64 < str_len(pre) as i64) { return false; }
    var i: i64 = 0;
    while (i < str_len(pre) as i64) { if (s[i] != pre[i]) { return false; } i = i + 1; }
    return true;
}
// 内建名集合（权威来源：tir_to_ll.tc ll_emit_builtin 的 cn== 分发 + 数学内建 + codegen_c.tc 的 t_ 映射）。
// 这些名字在 TMIR 模块里可能带体（prelude 定义），但字节缓冲 C 模型下必须路由到 C 运行库 t_<name>
// （而非发射 prelude 体），否则聚合 ABI 错乱。故 c_call_cname 优先判定内建。
pub var g_c_builtins: string =
    " append atom_str atom_count bitstr_append_val bitstr_concat bitstr_extract bitstr_new bitstr_sub "
    + " bsb_append_bytes bsb_append_u8 bsb_new bsb_to_bytes "
    + " deser_atom deser_bool deser_f64 deser_int deser_str eprint fclose fid_eof fid_error fid_format fid_is_open "
    + " file_exists file_read_all file_write_all fmt_register fopen format_bool format_char format_float format_int "
    + " format_str format_time format_time_local format_time_tz format_uint fseek ftell getenv i2s int_to_str "
    + " is_none is_some isfinite isinf isnan isnormal "
    + " map_concat map_concat_into map_count map_del map_get map_has map_key_int_at map_key_str_at map_len "
    + " map_new map_put map_set map_val_at map_val_ptr "
    + " now parse_time parse_time_local path_resolve print println read_line reduce_add reduce_and reduce_max "
    + " reduce_min reduce_mul reduce_or sb_append_char sb_append_cstr sb_append_fmt_big sb_append_fmt_bool sb_append_fmt_char "
    + " sb_clear "
    + " sb_append_fmt_float sb_append_fmt_int sb_append_fmt_int_conv sb_append_fmt_str sb_append_fmt_str_conv "
    + " sb_append_fmt_uint sb_append_fmt_uint_conv sb_append_i64 sb_append_str sb_append_u64 sb_free sb_new sb_to_str "
    + " ser_atom ser_bool ser_f64 ser_int ser_str signbit slice_append slice_append_sized slice_at slice_concat slice_from_raw slice_len slice_new slice_ptr slice_set slice_sub some splat str_at str_byte_at str_concat str_eq str_from_c str_len str_slice sym_intern sym_intern64 "
    + " sym_release sym_release_all sym_str sys_run time_invalid tll_deser_str tll_map_put to_string treduce_max "
    + " treduce_min treduce_mul treduce_sum tsplat unwrap vlen args stdin_eof exit "
    + " arena_use_default arena_use_parse arena_use_front arena_use_back arena_use_func "
    + " arena_reset_parse arena_reset_front arena_reset_back arena_reset_func "
    // 数学内建（math_mbuiltin）：用户码以裸名调用，运行库导出 t_math_<name>。
    + " acos acosf asin asinf atan atanf cbrt cbrtf ceil ceilf cos cosf cosh coshf exp expf fabs fabsf floor floorf "
    + " fmod fmodf hypot hypotf log logf pow powf round roundf sin sinf sinh sinhf sqrt sqrtf tan tanf tanh tanhf "
    + " trunc truncf ";
// 运行库 t_* 中「返回 void」的内建（字节缓冲 C 模型下必须跳过 dst= 赋值）。
pub var g_c_void_builtins: string =
    " arena_free_all assert assert_eq_b assert_eq_f64 assert_eq_i64 assert_eq_s assert_eq_u64 "
    + " bitstr_append_bitstr bitstr_append_val eprint exit fclose fflush fmt_register free "
    + " map_concat_into map_put map_set panic panic_bounds print println runtime_done runtime_init "
    + " runtime_set_arena sb_append_char sb_append_cstr sb_append_fmt_big sb_append_fmt_bool "
    + " sb_append_fmt_char sb_append_fmt_float sb_append_fmt_int sb_append_fmt_int_conv "
    + " sb_append_fmt_str sb_append_fmt_str_conv sb_append_fmt_uint sb_append_fmt_uint_conv "
    + " sb_append_i64 sb_append_str sb_append_u64 sb_clear sb_free slice_append slice_append_sized "
    + " slice_set sym_release sym_release_all "
    + " arena_use_default arena_use_parse arena_use_front arena_use_back arena_use_func "
    + " arena_reset_parse arena_reset_front arena_reset_back arena_reset_func ";
// 数学内建：用户裸名调用，运行库导出 t_math_<name>。
pub var g_c_math_builtins: string =
    " acos acosf asin asinf atan atanf atan2 atan2f cbrt cbrtf ceil ceilf cos cosf cosh coshf exp expf exp2 exp2f expm1 expm1f "
    + " fabs fabsf fdim fdimf fma fmaf fmax fmaxf fmin fminf floor floorf fmod fmodf hypot hypotf log logf log1p log1pf log2 log2f "
    + " nextafter nextafterf pow powf remainder remainderf round roundf signbit sin sinf sinh sinhf sqrt sqrtf tan tanf tanh tanhf "
    + " trunc truncf copysign copysignf isnan isinf isfinite isnormal log10 log10f ";
pub fn c_in_set(name: string, set: string) bool {
    var L: i64 = str_len(set) as i64;
    var nl: i64 = str_len(name) as i64;
    if (nl <= 0) { return false; }
    var i: i64 = 0;
    while (i < L) {
        if (set[i] == 32) {
            var j: i64 = i + 1;
            var k: i64 = 0;
            var mt: bool = true;
            while (k < nl) {
                if (j + k >= L or set[j + k] != name[k]) { mt = false; break; }
                k = k + 1;
            }
            if (mt) {
                var after: i64 = j + nl;
                if (after >= L or set[after] == 32) { return true; }
            }
        }
        i = i + 1;
    }
    return false;
}
pub fn c_is_builtin(name: string) bool {
    return c_in_set(name, g_c_builtins);
}
pub fn c_is_void_builtin(name: string) bool {
    return c_in_set(name, g_c_void_builtins);
}
pub fn c_is_math_builtin(name: string) bool {
    return c_in_set(name, g_c_math_builtins);
}
// 运行库内建中「TIR 的 call 目的 st 被错记为标量、但 C 运行库按值返回真实聚合」者 → 真实返回类型。
// 用于补正 dst 槽类型（否则 int64_t←TSlice 编译失败 / 类型错配）。LLVM 轨靠 ll_emit_builtin 特例分发
// （tir_to_ll.tc:2036）绕过同一错记，此处对应补正，避免改动前端影响自举不动点。
pub fn c_builtin_agg_ret(cb: string) string {
    if (cb == "slice_sub") { return "%TSlice"; }
    if (cb == "slice_new") { return "%TSlice"; }
    return "";
}
// 聚合返回类型（命名结构 / 变体 / 数组）→ t 编译为 sret（void 返回 + 出参指针）；
// 此类调用必须跳过 dst= 并把 dst 作为首实参（出参指针）传入。标量返回类型不命中。
// ⚠ 运行库结构体（TStr/TSlice/TClosure/TBitStr）按值返回（RAX:RDX），不走 sret。
pub fn c_is_sret_type(st: string) bool {
    if (str_len(st) as i64 == 0) { return false; }
    // 内部类型名带 '%' 前缀：先剥前缀再判运行库结构体（TStr/TSlice/TClosure/TBitStr）。
    // 这些按值返回（RAX:RDX），不走 sret；此前直接 c_c_ty_is_struct(st) 对 "%TStr" 失配 → 误判 sret。
    var t2: string = st;
    if (c_starts(t2, "%")) { t2 = str_slice(t2, 1, str_len(t2) as i64); }
    if (t2 == "TStr" or t2 == "TSlice" or t2 == "TClosure" or t2 == "TBitStr") { return false; }
    // 用户聚合（命名 struct / variant，'%' 前缀）与数组（'[' 前缀）→ sret（void + 出参指针）。
    if (c_starts(st, "%") or st[0] == 91) { return true; }
    return false;
}
// 运行库结构体（TStr/TSlice/TClosure/TBitStr）：按值返回（RAX:RDX），非 sret。
// 与 c_is_sret_type 互补——后者对它们返回 false；此处用于「返回站点」识别需要把字节缓冲重解释为结构体。
pub fn c_is_runtime_struct_st(st: string) bool {
    var t2: string = st;
    if (c_starts(t2, "%")) { t2 = str_slice(t2, 1, str_len(t2) as i64); }
    if (t2 == "TStr" or t2 == "TSlice" or t2 == "TClosure" or t2 == "TBitStr") { return true; }
    return false;
}
pub fn c_align_up(off: i64, a: i64) i64 {
    if (a <= 1) { return off; }
    var m: i64 = a - 1;
    var r: i64 = off + m;
    r = r - (r % a);
    return r;
}
pub fn c_tstr_align(ts: string) i64 {
    var rta: i64 = c_runtime_agg_align_n(c_rt_name(ts));
    if (rta >= 0) { return rta; }
    if (ts == "i8" or ts == "u8") { return 1; }
    if (ts == "i16" or ts == "u16") { return 2; }
    if (ts == "i32" or ts == "u32") { return 4; }
    if (ts == "i64" or ts == "u64") { return 8; }
    if (ts == "f32") { return 4; }
    if (ts == "f64") { return 8; }
    if (ts == "ptr" or ts == "ptr<void>" or c_starts(ts, "ptr<")) { return 8; }
    if (c_starts(ts, "%")) { return c_struct_align(ts); }
    if (c_starts(ts, "[")) { return c_tstr_align(c_array_elem(ts)); }
    return 8;
}
// 标量类型串（非聚合）：ADDR_OF 标量时直接取变量地址 &slot，不另建字节缓冲；
// 若错建 <slot>_buf，「写缓冲 / 读标量」会双轨分离 → 语义错位（map 传值类程序的经典崩点）。
pub fn c_is_scalar_tstr(ts: string) bool {
    if (ts == "i8" or ts == "u8" or ts == "i16" or ts == "u16" or ts == "i32" or ts == "u32") { return true; }
    if (ts == "i64" or ts == "u64" or ts == "f32" or ts == "f64" or ts == "bool" or ts == "void") { return true; }
    if (ts == "ptr" or ts == "ptr<void>") { return true; }
    if (c_starts(ts, "ptr<")) { return true; }
    return false;
}

// 运行库聚合名归一化：TIR 用 "%TStr" / "%TSlice" / "%TClosure" / "%TBitStr"（带 %），
// 而字节缓冲尺寸/对齐特判只认无 % 的 "TStr"/...。两处都需命中 → 统一剥 % 后比对。
// ⚠ 漏剥 → c_tstr_size("%TStr") 落到 c_struct_size("%TStr") 返回 0 → []TStr 切片 elem_size=0、
// 含 TStr 字段的用户 struct 字段尺寸 0 → slice_at/memcpy 读错位内存 → TStr.ptr 变垃圾整数（如 0x7）、
// .len 变天文数字 → t_sb_append_str 申请 ~1TB → t_arena_alloc 误判 OOM（tc_self miscompile 根因）。
pub fn c_rt_name(ts: string) string {
    if (c_starts(ts, "%")) { return str_slice(ts, 1, str_len(ts) as i64); }
    return ts;
}
pub fn c_runtime_agg_size_n(nm: string) i64 {
    if (nm == "TStr") { return 16; }
    if (nm == "TSlice") { return 32; }
    if (nm == "TClosure") { return 16; }
    if (nm == "TBitStr") { return 24; }
    return -1;
}
pub fn c_runtime_agg_align_n(nm: string) i64 {
    if (nm == "TStr" or nm == "TSlice" or nm == "TClosure" or nm == "TBitStr") { return 8; }
    return -1;
}
pub fn c_tstr_size(ts: string) i64 {
    // ⚠ 运行库聚合（"%TStr"/"TStr"…）必须优先命中，且剥 % 后比对：否则 c_struct_size("%TStr") 返回 0
    // → []TStr 切片 elem_size=0、含 string 字段的 struct 布局错位（tc_self miscompile 根因）。
    var rtsz: i64 = c_runtime_agg_size_n(c_rt_name(ts));
    if (rtsz >= 0) { return rtsz; }
    if (ts == "i8" or ts == "u8") { return 1; }
    if (ts == "i16" or ts == "u16") { return 2; }
    if (ts == "i32" or ts == "u32") { return 4; }
    if (ts == "i64" or ts == "u64") { return 8; }
    if (ts == "f32") { return 4; }
    if (ts == "f64") { return 8; }
    if (ts == "ptr" or ts == "ptr<void>" or c_starts(ts, "ptr<")) { return 8; }
    if (c_starts(ts, "%")) { return c_struct_size(ts); }
    if (c_starts(ts, "[")) { return c_array_nelems(ts) * c_tstr_size(c_array_elem(ts)); }
    if (c_is_arr(ts)) { return c_array_nelems(ts) * c_tstr_size(c_array_elem(ts)); }
    if (c_is_vec(ts)) { return c_vec_nelems(ts) * c_tstr_size(c_vec_elem(ts)); }
    if (c_is_awi_st(ts)) { return c_awi_size(ts); }
    return 8;
}
// ⚠ 类型名 → 体索引查表（O(1) 替代 c_find_type_body 的 O(types) 线性扫描）：
// c_struct_size/c_struct_align/c_tstr_size 等每处理一个聚合槽/操作数都会调用 c_find_type_body，
// 对含数千类型的超大模块（如编译器自身）累计成 O(insts×types) 的扫描+临时串分配，拖垮 bump arena。
// ⚠ 字典值须用 i64（存索引+1），绝不用 map[string]string：LLVM 后端对「字符串值字典」的 map_get
// 会产出损坏切片指针 → 原生段错误（已实测 mstest 复现）。故查到索引后直接取 g_c_mod.types[idx].body。
pub var g_c_type_body: map[string]i64;
pub var g_c_type_body_built: bool = false;
// 类型尺寸/对齐/字段偏移结果按名缓存（i64，value+1 哨兵：0=未缓存，合法值恒≥1）。
// ⚠ 仅用 i64 字典：LLVM 后端无法在 map 中安全存取 string/[]string 值（会产生损坏指针导致段错误），
// 已实测 map[string]string / map[string][]string 在 tir 后端 segfault，故全部走 i64 索引/哨兵。
// 缓存后 c_struct_size/c_struct_align/c_gep_offset/c_ti_field_offset 整编译仅按「类型数/类型×字段」算一次，
// 消除每操作数高频递归重算（O(insts×types) 重复计算 + O(F²) 字段循环）对 bump arena 的放大（原 OOM 根因）。
pub var g_c_ssz: map[string]i64;
pub var g_c_sal: map[string]i64;
pub var g_c_off_cache: map[string]i64;
pub var g_c_used_buf: map[string]i64;   // 字节缓冲伴生名占用集合（避免 <name>_buf 与真实全局/其它缓冲撞名）
pub fn c_build_type_index() void {
    g_c_type_body = map_new(g_c_type_body);
    var nt: i64 = slice_len(g_c_mod.types) as i64;
    var i: i64 = 0;
    while (i < nt) {
        map_set(g_c_type_body, g_c_mod.types[i].name, i + 1);
        i = i + 1;
    }
    g_c_type_body_built = true;
}
pub fn c_find_type_body(name: string) string {
    // ⚠ 反射内建聚合（%TypeMeta/%FieldInfo/%TypeInfo）由 sema 合成注入，不进 module.types，
    // 故此处硬编码其布局（字段顺序须与 sema.ensure_reflection_builtins 严格一致，勿单边改）。
    // 缺此 → c_struct_size/c_gep_full_offset 退化成「字段下标×8」的错误偏移
    // （name@0 读 8B、size@8 而非 @16 …），type_info 全簇读出乱值。
    if (name == "%TypeMeta") { return "f0: %TStr, f1: i64, f2: i64, f3: i64, f4: %TSlice, f5: %TSlice"; }
    if (name == "%FieldInfo") { return "f0: %TStr, f1: i64, f2: %TStr, f3: i64, f4: i8, f5: i64"; }
    if (name == "%TypeInfo") { return "f0: i64, f1: ptr<%TypeMeta>"; }
    if (g_c_type_body_built == false) { c_build_type_index(); }
    var idx: i64 = map_get(g_c_type_body, name);
    if (idx > 0) { return g_c_mod.types[idx - 1].body; }
    return "";
}
// 类型尺寸/对齐结果按名缓存：c_struct_size/c_struct_align 被 c_tstr_size/c_gep_offset/c_ti_field_offset
// 等每操作数高频调用，且内部递归（c_tstr_size→c_struct_size），对超大模块累计成 O(insts×types) 重复计算；
// 缓存后整编译仅按「类型数」计算一次（size+1 / align+1 哨兵：0 表示未缓存，合法值恒 ≥1）。
pub fn c_struct_align(name: string) i64 {
    var rta: i64 = c_runtime_agg_align_n(c_rt_name(name));
    if (rta >= 0) { return rta; }
    var ca: i64 = map_get(g_c_sal, name);
    if (ca > 0) { return ca - 1; }
    var body: string = c_find_type_body(name);
    var maxa: i64 = 1;
    if (body != "") {
        var i: i64 = 0;
        while (true) {
            var ft: string = c_field_type_at(body, i);
            if (ft == "") { break; }
            var a: i64 = c_tstr_align(ft);
            if (a > maxa) { maxa = a; }
            i = i + 1;
        }
    }
    map_set(g_c_sal, name, maxa + 1);
    return maxa;
}
pub fn c_struct_size(name: string) i64 {
    // ⚠ 运行库聚合（"%TStr"…）优先命中固定尺寸，剥 % 后比对：否则落到 c_find_type_body 返回 "" → 0，
    // 使含 string 字段的 struct 布局错位、[]TStr 切片 elem_size=0（tc_self miscompile 根因）。
    var rtsz: i64 = c_runtime_agg_size_n(c_rt_name(name));
    if (rtsz >= 0) { return rtsz; }
    // 数组（LLVM 风格 "[N x E]" 或 arr<E x N>）按元素数 × 元素宽计算，否则按值类型查体失败返回 0。
    if (c_starts(name, "[") or c_is_arr(name)) { return c_array_nelems(name) * c_tstr_size(c_array_elem(name)); }
    if (c_is_vec(name)) { return c_vec_nelems(name) * c_tstr_size(c_vec_elem(name)); }
    var cs: i64 = map_get(g_c_ssz, name);
    if (cs > 0) { return cs - 1; }
    var body: string = c_find_type_body(name);
    var off: i64 = 0;
    if (body != "") {
        var i: i64 = 0;
        while (true) {
            var ft: string = c_field_type_at(body, i);
            if (ft == "") { break; }
            off = c_align_up(off, c_tstr_align(ft));
            off = off + c_tstr_size(ft);
            i = i + 1;
        }
        off = c_align_up(off, c_struct_align(name));
    }
    map_set(g_c_ssz, name, off + 1);
    return off;
}
// 槽类型名（"%Foo" / "ptr<%Foo>" / "[N x E]"）→ 聚合缓冲字节尺寸（非聚合返回 0）。
// 用于聚合缓冲间赋值 memcpy 的尺寸，使 `a = t0` 复制缓冲内容而非 8 字节指针。
pub fn c_agg_size_of_tyname(tn: string) i64 {
    if (tn == "") { return 0; }
    var t2: string = tn;
    if (c_starts(t2, "ptr<")) { t2 = c_strip_ptr(t2); }
    if (c_is_awi_st(t2)) { return c_awi_size(t2); }   // AWI(N>64) 是 little-endian 字节缓冲聚合，尺寸=字节宽
    if (c_starts(t2, "%")) { return c_struct_size(t2); }
    // ⚠ 数组槽（arr<E x N>，如 slice/array literal 缓冲）必须按元素数×元素宽定尺寸，
    // 否则退化为 0 → 回退 c_tstr_size 默认 8 → 缓冲过小、越界写 UB。tir_st_to_str 对数组吐 arr<E x N> 而非 ptr<[...]>。
    if (c_starts(t2, "[") or c_is_arr(t2)) { return c_array_nelems(t2) * c_tstr_size(c_array_elem(t2)); }
    if (c_is_vec(t2)) { return c_vec_nelems(t2) * c_tstr_size(c_vec_elem(t2)); }
    return 0;
}
// ⚠ 字段拆分按 body 串：本函数仅做一次拆分（不再按 body 缓存切片值字典——LLVM 后端无法在 map 中
// 正确存取 []string 切片值，会产生损坏切片指针导致原生段错误）。O(insts×F²) 的放大已由
// c_struct_size/c_struct_align/c_gep_offset 的「按类型名缓存 i64 结果」消除（每类型仅算一次）。
pub fn c_field_split(body: string) []string {
    return c_split_comma(body);
}
pub fn c_field_type_at(body: string, idx: i64) string {
    var flds: []string = c_field_split(body);
    if (idx < 0 or idx >= slice_len(flds) as i64) { return ""; }
    var f: string = flds[idx];
    var ci: i64 = c_find_col(f, ":");
    if (ci < 0) { return c_strip_ws(f); }
    return c_strip_ws(str_slice(f, ci + 1, str_len(f) as i64));
}
pub fn c_split_comma(s: string) []string {
    var r: []string = [];
    var cur: string = "";
    var depth: i64 = 0;
    var i: i64 = 0;
    while (i < str_len(s) as i64) {
        var c: i64 = s[i];
        if (c == 60) { depth = depth + 1; }
        else if (c == 62) { depth = depth - 1; }
        if (c == 44 and depth == 0) { append(r, cur); cur = ""; }
        else { cur = base.sb_cat2(cur, str_slice(s, i, i + 1)); }
        i = i + 1;
    }
    append(r, cur);
    return r;
}
pub fn c_find_col(s: string, needle: string) i64 {
    var L: i64 = str_len(s) as i64;
    var nL: i64 = str_len(needle) as i64;
    var i: i64 = 0;
    while (i + nL <= L) {
        var j: i64 = 0; var ok: bool = true;
        while (j < nL) { if (s[i + j] != needle[j]) { ok = false; break; } j = j + 1; }
        if (ok) { return i; }
        i = i + 1;
    }
    return -1;
}
pub fn c_strip_ws(s: string) string {
    var L: i64 = str_len(s) as i64;
    var a: i64 = 0;
    while (a < L and (s[a] == 32 or s[a] == 9)) { a = a + 1; }
    var b: i64 = L;
    while (b > a and (s[b - 1] == 32 or s[b - 1] == 9)) { b = b - 1; }
    return str_slice(s, a, b);
}
pub fn c_is_arr(ts: string) bool { return c_starts(ts, "arr<"); }
// 向量（vec<ELEM x N>）：定长数组的语义等价物，按「元素数 × 元素宽」的字节缓冲建模
// （与 LLVM 后端的 <N x ELEM> 聚合逐字对齐；tmir-c 字节缓冲模型下即 unsigned char buf[N*sizeof(ELEM)]）。
pub fn c_is_vec(ts: string) bool { return c_starts(ts, "vec<"); }
// 瓦片（arr<arr<elem x cols> x rows>，可能带 ptr<> 前缀）：2D 定长数组，逐元素语义。
// 与 LLVM 后端 tir_to_ll 的瓦片分支逐位对齐（瓦片 = 嵌套定长数组，行主序）。
pub fn c_is_tile_st(st: string) bool {
    var s: string = st;
    if (c_starts(s, "ptr<")) { s = c_strip_ptr(s); }
    return c_starts(s, "arr<arr<");
}
// 向量（vec<ELEM x N>，可能带 ptr<> 前缀）：定长 SIMD 向量，与瓦片同属「字节缓冲聚合」，
// 但 1D（对应 LLVM <N x ELEM>）。c_is_vec_st 剥离 ptr<> 后判 vec< 前缀。
pub fn c_is_vec_st(st: string) bool {
    var s: string = st;
    if (c_starts(s, "ptr<")) { s = c_strip_ptr(s); }
    return c_is_vec(s);
}
// 从向量类型串解析元素 C 类型（如 "vec<i32 x 4>" -> "int32_t"，"vec<f64 x 2>" -> "double"）。
pub fn c_vec_elem_cty(vst: string) string {
    var s: string = vst;
    if (c_starts(s, "ptr<")) { s = c_strip_ptr(s); }
    var e: string = c_vec_elem(s);
    if (e == "") { e = "i32"; }
    return c_tystr_c(e);
}
// 从操作数解析其向量类型串（剥 ptr<>）：依次查 ins.st → 槽类型表 → 全局符号表（@ 全局），
// 覆盖「全局向量被 reduce/vlen 引用时槽表查不到」的情形（vector_demo 的 g_scale）。
pub fn c_vec_type_from_operand(op: TirOperand) string {
    var nm: string = c_strip_suf(op.name);
    var vst: string = c_strip_ptr(tir.tir_st_to_str(op.st));
    if (c_is_vec(vst) == false) { vst = c_strip_ptr(c_slot_ty_find(nm)); }
    if (c_is_vec(vst) == false and str_len(op.name) as i64 > 0 and op.name[0] == 64) {
        vst = c_strip_ptr(tir.tir_st_to_str(c_global_st(nm)));
    }
    return vst;
}
// ── 任意位宽整数（AWI）：i<N>/u<N>，N>64 ──────────────────────────
// 字节缓冲模型下与 LLVM 原生 i<N> 逐字对齐：值存为 little-endian unsigned char* 缓冲，
// 格式化经 t_sb_append_fmt_big、算术经 t_big_* 运行库原语。N≤64（含 u7/i7/u9 等窄任意位宽）
// 保持标量 int64_t/uint64_t，走既有标量格式化/算术路径，无需缓冲。
// ⚠ 判定用 base.awi_bits(st) > 64：标准 i64/u64 等 awi_bits 返回 ≤64，天然排除；
//   仅「真·任意位宽」（如 i128/u128/i200…）落入本分支。
pub fn c_is_awi_st(st: string) bool {
    var s: string = st;
    if (c_starts(s, "ptr<")) { s = c_strip_ptr(s); }
    if (c_starts(s, "i") or c_starts(s, "u")) {
        var ab: i64 = base.awi_bits(s);
        if (ab > 64) { return true; }
    }
    return false;
}
// AWI 字节宽（含 ptr<> 包装）；非 AWI 回落 8（不应命中）。
pub fn c_awi_size(st: string) i64 {
    var s: string = st;
    if (c_starts(s, "ptr<")) { s = c_strip_ptr(s); }
    var ab: i64 = base.awi_bits(s);
    if (ab <= 0) { return 8; }
    return (ab + 7) / 8;
}
// AWI 是否为有符号（i<N> 有符号，u<N> 无符号）。
pub fn c_awi_signed(st: string) bool {
    var s: string = st;
    if (c_starts(s, "ptr<")) { s = c_strip_ptr(s); }
    if (str_len(s) as i64 > 0 and s[0] == 105) { return true; }   // 'i'
    return false;
}
// AWI 字面量（十进制 / 十六 / 二 / 八进制，可带前导 '-'）→ little-endian 字节数组初始器串
// （如 "{255,0,0,...}"，长度 = c_awi_size(st)）。有符号负值按全宽二补码。供 CONST 发射填充缓冲。
pub fn c_awi_lit_bytes(lit: string, st: string) string {
    var nbytes: i64 = c_awi_size(st);
    var neg: bool = false;
    var s: string = lit;
    if (str_len(s) as i64 > 0 and s[0] == 45) { neg = true; s = str_slice(s, 1, str_len(s)); }   // '-'
    var radix: i64 = 10;
    if (str_len(s) as i64 >= 2 and s[0] == 48) {   // '0'
        if (s[1] == 120 or s[1] == 88) { radix = 16; s = str_slice(s, 2, str_len(s)); }  // x / X
        else if (s[1] == 98 or s[1] == 66) { radix = 2; s = str_slice(s, 2, str_len(s)); }  // b / B
        else if (s[1] == 111 or s[1] == 79) { radix = 8; s = str_slice(s, 2, str_len(s)); }  // o / O
    }
    var bytes: []i64 = [];
    var bi: i64 = 0;
    while (bi < nbytes) { append(bytes, 0); bi = bi + 1; }
    var n: i64 = str_len(s);
    var i: i64 = 0;
    while (i < n) {
        var c: i64 = s[i];
        var d: i64;
        if (c >= 48 and c <= 57) { d = c - 48; }
        else if (c >= 65 and c <= 70) { d = c - 55; }
        else if (c >= 97 and c <= 102) { d = c - 87; }
        else { d = 0; }
        var carry: i64 = d;
        var j: i64 = 0;
        while (j < nbytes) {
            var v: i64 = bytes[j] * radix + carry;
            bytes[j] = v & 0xFF;
            carry = v >> 8;
            j = j + 1;
        }
        i = i + 1;
    }
    if (neg) {
        var k: i64 = 0;
        while (k < nbytes) { bytes[k] = bytes[k] ^ 0xFF; k = k + 1; }
        var carry2: i64 = 1;
        var jj: i64 = 0;
        while (jj < nbytes and carry2 != 0) {
            var v2: i64 = bytes[jj] + carry2;
            bytes[jj] = v2 & 0xFF;
            carry2 = v2 >> 8;
            jj = jj + 1;
        }
    }
    var out: string = "{";
    var q: i64 = 0;
    while (q < nbytes) {
        if (q > 0) { out = base.sb_cat2(out, ","); }
        out = base.sb_cat2(out, base.i2s(bytes[q]));
        q = q + 1;
    }
    out = base.sb_cat2(out, "}");
    return out;
}
// 把「任意位宽整数（AWI，N>64）槽」登记为字节缓冲聚合基：预扫描阶段据此在 t_main 头部
// 为其 t_alloc 一块 nbytes 缓冲（unsigned char*），避免 CONST/ADD/SUB 等临时槽被声明成
// (unsigned char*)0 后 memcpy 自 NULL → 段错误（awi_demo 的 t0/t3…/t25 等中间槽）。
// 仅 N>64 落入；N≤64 保持标量，不在此登记。
pub fn c_awi_ensure_base(sn: string, st: string) void {
    var stc: string = c_strip_ptr(st);
    if (c_is_awi_st(stc) and c_is_agg_base(sn) == false) {
        append(g_c_agg_base_name, sn);
        var asz: i64 = c_awi_size(stc);
        if (asz <= 0) { asz = 8; }
        append(g_c_agg_base_size, asz);
    }
}
// 从瓦片类型串解析元素 C 类型（如 "arr<arr<i32 x 3> x 2>" -> "int32_t"）。
// 布局固定为 arr<arr<ELEM x COLS> x ROWS>，ELEM 位于 "arr<arr<" 前缀（8 字符）之后、内层 " x " 之前。
pub fn c_tile_elem_cty(tst: string) string {
    var s: string = tst;
    if (c_starts(s, "ptr<")) { s = c_strip_ptr(s); }
    var last: i64 = -1; var i: i64 = 0; var L: i64 = str_len(s);
    while (i + 3 <= L) { if (s[i] == 32 and s[i + 1] == 120 and s[i + 2] == 32) { last = i; } i = i + 1; }
    if (last < 0) { return "int32_t"; }
    var before: string = str_slice(s, 0, last);   // "arr<arr<ELEM x COLS>"
    var last2: i64 = -1; var j: i64 = 0; var L2: i64 = str_len(before);
    while (j + 3 <= L2) { if (before[j] == 32 and before[j + 1] == 120 and before[j + 2] == 32) { last2 = j; } j = j + 1; }
    if (last2 < 0) { return "int32_t"; }
    var elem: string = str_slice(before, 8, last2);  // 跳过 "arr<arr<" 前缀取元素类型名
    return tmir.tmir_st_c(tir.tir_st_from_str(elem));
}
// 从瓦片类型串解析 行×列 总数（如 "arr<arr<i32 x 3> x 2>" -> 6）。
pub fn c_tile_total(tst: string) i64 {
    var s: string = tst;
    if (c_starts(s, "ptr<")) { s = c_strip_ptr(s); }
    var last: i64 = -1; var i: i64 = 0; var L: i64 = str_len(s);
    while (i + 3 <= L) { if (s[i] == 32 and s[i + 1] == 120 and s[i + 2] == 32) { last = i; } i = i + 1; }
    if (last < 0) { return 0; }
    var rows: i64 = c_atoi_trim(str_slice(s, last + 3, L));
    var before: string = str_slice(s, 0, last);
    var last2: i64 = -1; var j: i64 = 0; var L2: i64 = str_len(before);
    while (j + 3 <= L2) { if (before[j] == 32 and before[j + 1] == 120 and before[j + 2] == 32) { last2 = j; } j = j + 1; }
    var cols: i64 = 0;
    if (last2 >= 0) { cols = c_atoi_trim(str_slice(before, last2 + 3, L2)); }
    if (rows < 1) { rows = 1; }
    if (cols < 1) { cols = 1; }
    return rows * cols;
}
// 解析整数：跳过前导空白与尾随 '>'（瓦片串可能带尾 '>'），遇非数字停止。
pub fn c_atoi_trim(s: string) i64 {
    var i: i64 = 0; var L: i64 = str_len(s);
    while (i < L and (s[i] == 32 or s[i] == 9 or s[i] == 62)) { i = i + 1; }
    var neg: bool = false;
    if (i < L and s[i] == 45) { neg = true; i = i + 1; }
    var v: i64 = 0;
    while (i < L) { var c: i64 = s[i]; if (c < 48 or c > 57) { break; } v = v * 10 + (c - 48); i = i + 1; }
    if (neg) { v = -v; }
    return v;
}
pub fn c_vec_elem(ts: string) string {
    if (c_starts(ts, "ptr<")) { ts = c_strip_ptr(ts); }   // 剥 ptr<> 包装（全局/指针形态）
    if (c_is_vec(ts) == false) { return "i32"; }   // 防御：非向量（含空串）回落默认元素类型
    var s: i64 = 4;
    var e: i64 = str_len(ts) as i64 - 1;
    var body: string = str_slice(ts, s, e);
    var xi: i64 = c_find_x(body);
    if (xi < 0) { return "i32"; }
    return str_slice(body, 0, xi);
}
pub fn c_vec_nelems(ts: string) i64 {
    if (c_starts(ts, "ptr<")) { ts = c_strip_ptr(ts); }   // 剥 ptr<> 包装（全局/指针形态）
    if (c_is_vec(ts) == false) { return 0; }   // 防御：非向量（含空串）回落 0 lane
    var s: i64 = 4;
    var e: i64 = str_len(ts) as i64 - 1;
    var body: string = str_slice(ts, s, e);
    var xi: i64 = c_find_x(body);
    if (xi < 0) { return 0; }
    return tir.tir_atoi(str_slice(body, xi + 3, str_len(body) as i64));
}
pub fn c_find_x(s: string) i64 {
    var L: i64 = str_len(s) as i64;
    var i: i64 = 0;
    while (i + 3 <= L) {
        if (s[i] == 32 and s[i + 1] == 120 and s[i + 2] == 32) { return i; }
        i = i + 1;
    }
    return -1;
}
// 数组类型 "arr<ELEM x N>"（可嵌套，ELEM 自身含 " x "）在 body 内 depth==0 处找 " x " 分隔符，
// 返回其下标；对嵌套瓦片 arr<arr<i32 x 3> x 2> 须取最外层分隔（行数），而非内层（列数），
// 否则 c_array_nelems 误取列数、c_array_elem 取到残缺子串 → 尺寸算 0 → 缓冲回退 8B（tile_demo）。
pub fn c_arr_sep_idx(body: string) i64 {
    var depth: i64 = 0;
    var L: i64 = str_len(body) as i64;
    var i: i64 = 0;
    while (i + 3 <= L) {
        var c: i64 = body[i];
        if (c == 60) { depth = depth + 1; }        // '<'
        else if (c == 62) { depth = depth - 1; }   // '>'
        else if (c == 32 and depth == 0 and body[i + 1] == 120 and body[i + 2] == 32) {
            return i;                              // 找到 depth==0 的 " x "
        }
        i = i + 1;
    }
    return -1;
}
pub fn c_array_elem(ts: string) string {
    if (c_is_arr(ts)) {
        var body: string = str_slice(ts, 4, str_len(ts) as i64 - 1);
        var xi: i64 = c_arr_sep_idx(body);
        if (xi < 0) { return "i32"; }
        return str_slice(body, 0, xi);
    }
    // LLVM 风格 "[N x ELEM]"（变体载荷字节数组等）
    var e: i64 = str_len(ts) as i64 - 1;
    var i: i64 = 1;
    while (i < str_len(ts) as i64 and ts[i] != 93) { i = i + 1; }
    var inner: string = str_slice(ts, 1, i);
    var xi: i64 = c_find_x(inner);
    if (xi < 0) { return "i8"; }
    return str_slice(inner, xi + 3, str_len(inner) as i64);
}
pub fn c_array_nelems(ts: string) i64 {
    if (c_is_arr(ts)) {
        var body: string = str_slice(ts, 4, str_len(ts) as i64 - 1);
        var xi: i64 = c_arr_sep_idx(body);
        if (xi < 0) { return 0; }
        return tir.tir_atoi(str_slice(body, xi + 3, str_len(body) as i64));
    }
    // ⚠ LLVM 风格 "[N x E]"：元素数 N 在最前（纯数字段），须**只取前导数字**，
    // 否则 tir_atoi("16 x i8") 会把 '1''6' 与 E 内的 '8' 一并累加 → 168（应为 16）；
    // → c_struct_size(%Variant) 把载荷字节数组当 168 字节 → 变体缓冲/切片步长膨胀 7× →
    // 元素错位（examples/shapes.tc 面积算错）。tir_atoi 不遇非数字截断，故此处手动限定数字段。
    var j: i64 = 1;
    while (j < str_len(ts) as i64 and ts[j] >= 48 and ts[j] <= 57) { j = j + 1; }
    if (j <= 1) { return 0; }
    return tir.tir_atoi(str_slice(ts, 1, j));
}
pub fn c_gep_offset(ty: string, idx: i64) i64 {
    if (c_starts(ty, "[") or c_is_arr(ty)) { return idx * c_tstr_size(c_array_elem(ty)); }
    if (c_is_vec(ty)) { return idx * c_tstr_size(c_vec_elem(ty)); }
    if (c_starts(ty, "%") == false) { return idx * c_tstr_size(ty); }
    var key: string = base.sb_cat3(ty, "#", base.i2s(idx));
    var cv: i64 = map_get(g_c_off_cache, key);
    if (cv > 0) { return cv - 1; }
    var body: string = c_find_type_body(ty);
    var off: i64 = 0;
    if (body != "") {
        var i: i64 = 0;
        while (i < idx) {
            var ft: string = c_field_type_at(body, i);
            if (ft == "") { break; }
            off = c_align_up(off, c_tstr_align(ft));
            off = off + c_tstr_size(ft);
            i = i + 1;
        }
        if (idx < slice_len(c_field_split(body)) as i64) {
            var fc: string = c_field_type_at(body, idx);
            off = c_align_up(off, c_tstr_align(fc));
        }
    } else { off = idx * 8; }
    map_set(g_c_off_cache, key, off + 1);
    return off;
}

// ── 类型名 → C 类型 / GEP 全路径偏移 ──────────────────────────
pub fn c_is_runtime_agg(tn: string) bool {
    return tn == "%TStr" or tn == "%TSlice" or tn == "%TClosure" or tn == "%TBitStr";
}
// 运行库「指针句柄」类型（TSb / TMap）：在运行库里恒以指针（TSb* / TMap*）访问，全局须按指针赋值，
// 切勿走聚合字节缓冲分支（会向 <name>_buf 写 8B 指针 → memcpy 目标为 struct 值非法，或写入错误偏移）。
// 与 c_is_runtime_agg（TStr/TSlice/TClosure/TBitStr 按值）互补；TSb/TMap 以 '*' 结尾拼写（%TSb* / ptr<%TSb>）。
pub fn c_is_runtime_handle_ptr(tn: string) bool {
    return c_starts(tn, "%TSb") or c_starts(tn, "ptr<%TSb") or c_starts(tn, "%TMap") or c_starts(tn, "ptr<%TMap");
}
// 剥 "ptr<...>" 外层，返回内层类型名（处理嵌套 ">"，如 "ptr<arr<i8 x 24>>"）。
pub fn c_strip_ptr(ty: string) string {
    if (c_starts(ty, "ptr<") == false) { return ty; }
    var L: i64 = str_len(ty) as i64;
    var k: i64 = L - 1;
    while (k >= 0 and ty[k] != 62) { k = k - 1; }
    return str_slice(ty, 4, k);
}
// 枚举类型名集合（模块级缓存）：t 的枚举是标量（LLVM 后端按 i64 处理），C 后端须识别为标量，
// 否则 c_tystr_c 把 %Color 之类按「用户聚合」误映射 unsigned char* → int32↔unsigned char* 错配、
// 枚举值比较错乱（enum_match_dispatch）。数据源自 lex.decl_list 的 EnumDecl（与 LLVM 后端 t_td_is_enum 同权威源）。
pub var g_c_enum_names: []string = [];
pub fn c_collect_enum_names() void {
    g_c_enum_names = [];
    var n: i64 = slice_len(lex.decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = lex.decl_list[i];
        if (base.node_kind((d as u64)) == "EnumDecl") {
            var nm: string = base.node_sa((d as u64));
            var dup: bool = false; var j: i64 = 0;
            while (j < slice_len(g_c_enum_names) as i64) { if (g_c_enum_names[j] == nm) { dup = true; break; } j = j + 1; }
            if (dup == false) { append(g_c_enum_names, nm); }
        }
        i = i + 1;
    }
}
pub fn c_is_enum_ty(ty: string) bool {
    var nm: string = ty;
    if (c_starts(nm, "%")) { nm = str_slice(nm, 1, str_len(nm)); }
    var i: i64 = 0;
    while (i < slice_len(g_c_enum_names) as i64) { if (g_c_enum_names[i] == nm) { return true; } i = i + 1; }
    return false;
}
// 类型名 → C 类型（函数签名 / 局部声明共用，保证前后向声明一致）。
pub fn c_tystr_c(ty: string) string {
    if (ty == "" or ty == "void") { return "void"; }
    // 向量（vec<ELEM x N>）：字节缓冲模型下与瓦片/定长数组同构 —— 一律按 unsigned char* 缓冲指针，
    // 绝不走 int64_t 标量（否则 `scale4(v,k)` 形参/返回值被生成为 int64_t、向量逐元素写入越界踩踏）。
    // 与 LLVM 后端的 <N x ELEM> 聚合逐字对齐；tmir-c 字节缓冲即 N*sizeof(ELEM) 字节。
    if (c_is_vec(ty)) { return "unsigned char*"; }
    // 任意位宽整数（AWI，N>64）：字节缓冲模型下与向量同构 —— 一律按 little-endian unsigned char* 缓冲指针，
    // 绝不走 int64_t 标量（否则 u128 字面量被 (int64_t)(…) 截断/溢出、值透传给 t_sb_append_fmt_big 类型错配）。
    // 与 LLVM 后端的原生 i<N>/u<N> 逐字对齐；tmir-c 缓冲即 ceil(N/8) 小端字节。N≤64 保持标量，不落此分支。
    if (c_is_awi_st(ty)) { return "unsigned char*"; }
    if (c_is_enum_ty(ty)) { return "int64_t"; }   // 枚举是标量（LLVM 后端按 i64 擦除；C 用 int64_t 对齐）
    if (ty == "%TStr") { return "TStr"; }
    if (ty == "%TSlice") { return "TSlice"; }
    if (ty == "%TClosure") { return "TClosure"; }
    if (ty == "%TBitStr") { return "TBitStr"; }
    if (ty == "ptr<%TStr>") { return "TStr*"; }
    if (ty == "ptr<%TSlice>") { return "TSlice*"; }
    if (ty == "ptr<%TClosure>") { return "TClosure*"; }
    if (ty == "ptr<%TBitStr>") { return "TBitStr*"; }
    if (ty == "ptr<%TMap>" or ty == "%TMap") { return "TMap*"; }   // 运行库堆指针：保留具体类型
    if (ty == "ptr<%TMap>" or ty == "%TMap" or ty == "%TMap*") { return "TMap*"; }
    if (ty == "ptr<%TSb>" or ty == "%TSb" or ty == "%TSb*") { return "TSb*"; }
    if (c_starts(ty, "ptr<%")) { return "unsigned char*"; }   // 用户聚合指针 → 字节缓冲
    if (c_starts(ty, "%")) { return "unsigned char*"; }         // 用户聚合 by-value（罕见）
    if (c_starts(ty, "ptr<")) { return "unsigned char*"; }      // 标量指针 → 缓冲指针（支撑 GEP 算术）
    return tmir.tmir_st_c(tir.tir_st_from_str(ty));
}
// 操作数 → 模型 C 类型：全局用全局类型；参数优先用签名类型（最权威）；
// 其余用槽类型表。避免「按使用反推」把指针/聚合参数误判成标量（int32↔unsigned char* 错配）。
pub fn c_operand_c_ty(op: TirOperand) string {
    var nm: string = c_strip_suf(op.name);
    if (str_len(op.name) as i64 > 0 and op.name[0] == 64) { return c_tystr_c(tir.tir_st_to_str(c_global_st(nm))); }
    if (c_is_param(g_cf, nm)) { return c_param_c_ty(g_cf, nm); }
    return c_slot_c_ty(nm);
}
// C 类型是否为「指针」：字节缓冲模型里指针 / 聚合-as-指针统一以 '*' 结尾（unsigned char*/TMap*/TSb*…）。
// C 类型是否为浮点（double / float）：二元运算须据此走浮点路径，不能按整数强转。
pub fn c_is_fp_cty(ty: string) bool {
    if (ty == "double" or ty == "float") { return true; }
    return false;
}
// C 类型是否为「指针」：字节缓冲模型里指针 / 聚合-as-指针统一以 '*' 结尾（unsigned char*/TMap*/TSb*…）。
pub fn c_c_ty_is_ptr(ty: string) bool {
    var L: i64 = str_len(ty) as i64;
    return L >= 1 and ty[L - 1] == 42;   // '*'
}
// GEP/GEP_IDX 结果赋值：地址结果落到目的槽时按目的类型转型（目的槽恒为 unsigned char* 之类的指针类型）。
pub var g_c_gep_wrap: string = "";
// 当前函数是否为 sret（聚合返回）：是则签名改为 void + 首形参 `__sret` 出参指针，
// RET 时把返回值缓冲 memcpy 进 __sret 再 ret void。
pub var g_c_sret: bool = false;
pub var g_c_sret_size: i64 = 0;
pub fn c_emit_gep_dstpre(sb: StringBuilder, dstn: string) void {
    g_c_gep_wrap = "";
    var gdty: string = c_slot_c_ty(dstn);
    if (c_c_ty_is_ptr(gdty)) { g_c_gep_wrap = gdty; }
    sb_append_str(sb, "  "); sb_append_str(sb, dstn); sb_append_str(sb, " = ");
    if (g_c_gep_wrap != "") { sb_append_str(sb, "("); sb_append_str(sb, g_c_gep_wrap); sb_append_str(sb, ")("); }
}
pub fn c_emit_gep_dstpost(sb: StringBuilder, dstn: string) void {
    if (g_c_gep_wrap != "") { sb_append_str(sb, ")"); }
    g_c_gep_wrap = "";
}
// GEP/GEP_IDX 基址表达式：结构体值槽（TSlice/TStr/…）不能直接做指针算术，须取地址后转 unsigned char*。
pub fn c_emit_gep_base(sb: StringBuilder, op: TirOperand) void {
    var bn: string = c_strip_suf(op.name);
    var bty2: string = c_operand_c_ty(op);
    if (c_c_ty_is_struct(bty2)) {
        // 结构体值槽（TSlice/TStr/…）不能直接做指针算术，须取地址后转 unsigned char*。
        sb_append_str(sb, "(unsigned char*)(&"); sb_append_str(sb, bn); sb_append_str(sb, ")");
        return;
    }
    // ⚠ 具名指针槽（TClosure*/TMap*/TSb*…）也不能直接加字节偏移：C 的指针算术按
    //   sizeof(指向类型) 缩放（TClosure* + 8 = +128B），会把 GEP 的字节偏移放大 → 越界写/段错误
    //   （closure_demo 的 env 字段写入即命中）。必须先降级成 unsigned char*。
    if (c_c_ty_is_ptr(bty2) and bty2 != "unsigned char*") {
        sb_append_str(sb, "((unsigned char*)("); sb_append_str(sb, bn); sb_append_str(sb, "))");
        return;
    }
    sb_append_str(sb, bn);
}
// C 类型是否为「结构体值」（非指针、非标量）：此类槽要对成员做字节访问时须取地址（&slot）。
pub fn c_c_ty_is_struct(ty: string) bool {
    if (ty == "TStr" or ty == "TSlice" or ty == "TClosure" or ty == "TBitStr") { return true; }
    return false;
}
// append 元素尺寸表达式：运行库结构体（TStr/TSlice/TClosure/TBitStr）是真实 C struct，
// 元素按值持有完整 16/32/16/24 字节，须用 sizeof(<ctype>) 而非 TIR 传入的 esz。
// 字节缓冲模型里 TIR 对 member 路径的 []string 误算 esz=8（只拷 8 字节 → len 丢 → 空串）；
// 其余元素（字节缓冲聚合 unsigned char* / 标量）沿用 TIR esz（其已正确）。
pub fn c_emit_esz(sb: StringBuilder, szop: TirOperand, ecty: string) void {
    if (c_c_ty_is_struct(ecty)) {
        sb_append_str(sb, "sizeof("); sb_append_str(sb, ecty); sb_append_str(sb, ")");
    } else {
        c_emit_val(sb, szop);
    }
}
// 「指向用户聚合的指针」类型（ptr<%Struct> / ptr<%Perm>…，不含运行库结构体与枚举）。
// 用于 ADDR_OF：用户聚合值槽在字节缓冲模型里本身就是缓冲指针，取址 = 指针值本身；
// 而 ptr<i64> / ptr<void> 之类持有机器指针值的槽，取址必须是 &slot（槽变量的地址）。
pub fn c_is_user_agg_ptr_ty(ty: string) bool {
    if (c_starts(ty, "ptr<%") == false) { return false; }
    var L: i64 = str_len(ty) as i64;
    if (L < 6 or ty[L - 1] != 62) { return false; }          // 62 = '>'
    var inner: string = str_slice(ty, 4, L - 1);
    if (c_is_enum_ty(inner)) { return false; }                // 枚举按 i64 标量传递
    if (inner == "%TStr" or inner == "%TSlice" or inner == "%TClosure" or inner == "%TBitStr" or inner == "%TMap" or inner == "%TSb") { return false; }
    return true;
}
// 字节缓冲模型下二者同为机器值（标量 / 指针 / 结构体），显式转换即「按目的类型重解释」，
// 正是模型本意；同时消除 warning→error 的类型不符（unsigned char*↔TMap*、TSlice↔unsigned char*…）。
pub fn c_emit_assign(sb: StringBuilder, dstn: string, op: TirOperand) void {
    var dty: string = c_slot_c_ty(dstn);
    var sty: string = c_operand_c_ty(op);
    // 函数引用赋给 fn 值槽（var f: fn(i64)i64 = mul;）→ 赋 &static TClosure 常量。
    if (c_is_func_ref(op.name)) {
        var fty: string = dty;
        if (c_c_ty_is_ptr(fty) == false) { fty = "unsigned char*"; }
        sb_append_str(sb, "  "); sb_append_str(sb, dstn); sb_append_str(sb, " = (");
        sb_append_str(sb, fty); sb_append_str(sb, ")(&"); sb_append_str(sb, c_clo_global(op.name));
        sb_append_str(sb, ");\n");
        return;
    }
    // 目的为「结构体值」（TSlice/TStr/TBitStr…）而源为字节指针：C 不允许指针→结构体强转，
    // 字节缓冲模型下的正确写法是把源缓冲映像 memcpy 进目的结构体。
    if (c_c_ty_is_struct(dty) and c_c_ty_is_ptr(sty)) {
        sb_append_str(sb, "  { memcpy((void*)(&"); sb_append_str(sb, dstn); sb_append_str(sb, "), (void*)(");
        c_emit_val(sb, op); sb_append_str(sb, "), sizeof("); sb_append_str(sb, dstn); sb_append_str(sb, ")); }\n");
        return;
    }
    // 反向：源是「结构体值」而目的是标量/指针 —— C 不允许结构体→非结构体强转
    //   （"operand of type 'TBitStr' where arithmetic or pointer type is required"）。
    //   按目的宽度 memcpy 源的低位字节即可（bitstr_protocol 的 `store $_ $bs`：通配绑定 `_`
    //   承接 TBitStr，该值随后被丢弃，只需可编译且不越界）。
    if (c_c_ty_is_struct(sty) and c_c_ty_is_struct(dty) == false and str_len(op.name) as i64 > 0
        and (op.name[0] == 36 or op.name[0] == 64)) {
        sb_append_str(sb, "  { memcpy((void*)(&"); sb_append_str(sb, dstn); sb_append_str(sb, "), (void*)(&");
        sb_append_str(sb, c_strip_suf(op.name)); sb_append_str(sb, "), sizeof("); sb_append_str(sb, dstn);
        sb_append_str(sb, ")); }\n");
        return;
    }
    sb_append_str(sb, "  "); sb_append_str(sb, dstn); sb_append_str(sb, " = ");
    if (dty != sty and dty != "void") {
        sb_append_str(sb, "("); sb_append_str(sb, dty); sb_append_str(sb, ")(");
        c_emit_val(sb, op); sb_append_str(sb, ")");
    } else {
        c_emit_val(sb, op);
    }
    sb_append_str(sb, ";\n");
}
// GEP 全路径偏移：base_ty 为基址类型（"ptr<%Event>"/"%Event"/"arr<...>"），
// idxs 为索引序列（已剥除基址操作数）。指针基的首索引为「解引用」（进入 pointee，不取字段）。
pub fn c_gep_full_offset(base_ty: string, idxs: []i64) i64 {
    var cur: string = base_ty;
    var i: i64 = 0;
    if (c_starts(cur, "ptr<")) {
        var inner: string = c_strip_ptr(cur);
        // ⚠ 数组基（ptr<[N x E]>）：array literal 的 GEP 已是 (base, elem_idx) 2-arg 形式
        //   （前端省略了解引用 0，与 LLVM 后端的 add_deref0 补 0 互逆），若跳过首索引会吞掉
        //   唯一的元素索引 → off 恒为 0（slice/array literal 所有元素写同一偏移，值全错位）。
        //   仅结构体/用户聚合与嵌套指针需跳过首索引（deref 0）。
        if (c_starts(inner, "%") or c_starts(inner, "ptr<")) { cur = inner; i = 1; }
        else { cur = inner; }   // 数组/标量指针基：不跳过，idxs 即元素/字节索引
    }
    var off: i64 = 0;
    while (i < slice_len(idxs) as i64) {
        var idx: i64 = idxs[i];
        if (cur == "") { off = off + idx * 8; }
        else if (c_is_vec(cur)) {
            off = off + idx * c_tstr_size(c_vec_elem(cur));
            cur = c_vec_elem(cur);
        } else if (c_starts(cur, "[") or c_is_arr(cur)) {
            off = off + idx * c_tstr_size(c_array_elem(cur));
            cur = c_array_elem(cur);
        } else if (c_starts(cur, "%")) {
            off = off + c_gep_offset(cur, idx);
            cur = c_field_type_at(c_find_type_body(cur), idx);
        } else { off = off + idx * c_tstr_size(cur); }
        i = i + 1;
    }
    return off;
}
// 解析 GEP 基址操作数类型名。
pub fn c_gep_base_ty(n: string) string {
    if (str_len(n) as i64 > 0 and n[0] == 64) {
        var gn: string = c_strip_suf(n);
        return base.sb_cat3("ptr<", tir.tir_st_to_str(c_global_st(gn)), ">");
    }
    var ty: string = c_param_tyname(g_cf, n);
    if (ty != "") { return ty; }
    ty = c_slot_ty_find(n);
    if (ty != "") { return ty; }
    ty = c_addr_base_find(n);
    if (ty != "") { return base.sb_cat3("ptr<", ty, ">"); }
    return "";
}
pub fn c_is_address(n: string) bool {
    if (c_addr_st_of(n) != tir__ST_NONE) { return true; }
    if (c_is_addr_slot(n)) { return true; }   // 地址槽声明表（bitcast/struct_new 预扫描登记）亦属「按指针解引用」
    if (c_is_agg_base(n)) { return true; }
    if (str_len(n) as i64 > 0 and n[0] == 64 and c_global_is_bytebuf(c_strip_suf(n))) { return true; }
    return false;
}
pub fn c_slot_ty_mark(n: string, ty: string) void {
    var i: i64 = 0;
    while (i < slice_len(g_c_slot_tyname) as i64) { if (g_c_slot_tyname[i] == n) { g_c_slot_tyty[i] = ty; return; } i = i + 1; }
    append(g_c_slot_tyname, n); append(g_c_slot_tyty, ty);
}
pub fn c_slot_ty_find(n: string) string {
    var i: i64 = 0;
    while (i < slice_len(g_c_slot_tyname) as i64) { if (g_c_slot_tyname[i] == n) { return g_c_slot_tyty[i]; } i = i + 1; }
    return "";
}
// map_val_ptr 结果槽判定：其 dst 即「映射值字节指针」，载入（LOAD）宽度须按映射值类型
// （16B→%TStr / 8B→i64 …），否则 TStr 值被按 8B 截断读 → 字符串乱码（map_assign/map_iter/map_advanced）。
pub fn c_is_mapval_slot(n: string) bool {
    var i: i64 = 0;
    while (i < slice_len(g_c_mapval_slot) as i64) { if (g_c_mapval_slot[i] == n) { return true; } i = i + 1; }
    return false;
}
// map 句柄槽 → 值尺寸（字节）；未命中回退 8（i64）。
// ⚠ 经槽别名解析：map_val_ptr 实参常为 bitcast 别名（t43=(void*)(mi)），须沿 g_c_alias_* 链
// 找回真实 map_new 句柄名再查表，否则落空回退 8 → TStr 值被按 8B 截断（map_assign/map_iter/map_advanced）。
pub fn c_map_handle_valsz(hn: string) i64 {
    var cur: string = c_map_resolve_handle(hn);
    var i: i64 = 0;
    while (i < slice_len(g_c_map_vsz_name) as i64) { if (g_c_map_vsz_name[i] == cur) { return g_c_map_vsz_val[i]; } i = i + 1; }
    // 仍落空（句柄未登记 vsz，如嵌套 map / 内联 map_new 表达式）→ 按 8B(i64) 兜底。
    return 8;
}
// 槽 → 真实 map_new 句柄名：沿 def-use 链回溯（BITCAST/STORE 的 dst=cur → 源槽），
// 直到命中 g_c_map_vsz_name 登记的 map_new 句柄。相比单纯依赖 g_c_alias_* 表，
// 此处直接走 g_cf 指令流，彻底免疫「指令顺序 / 别名表遗漏」导致的值尺寸回退 8（TStr 值被截断）。
pub fn c_map_resolve_handle(hn: string) string {
    var seen: []string = [];
    var cur: string = hn;
    while (true) {
        var i: i64 = 0;
        while (i < slice_len(g_c_map_vsz_name) as i64) { if (g_c_map_vsz_name[i] == cur) { return cur; } i = i + 1; }
        // 指令流 def-use 回溯：找定义 cur 的 BITCAST/STORE，取其源槽继续跳。
        var nxt: string = "";
        var k: i64 = 0;
        while (k < slice_len(g_cf.blocks) as i64) {
            var bk: i64 = 0;
            while (bk < slice_len(g_cf.blocks[k].insts) as i64) {
                var ins: TMIRInst = g_cf.blocks[k].insts[bk];
                if ((ins.op == tir__TIR_OP_BITCAST or ins.op == tir__TIR_OP_STORE or ins.op == tir__TIR_OP_LOAD)
                    and c_strip_suf(ins.dst.name) == cur
                    and slice_len(ins.args) as i64 >= 1
                    and str_len(ins.args[0].name) as i64 > 0) {
                    var ssrc: string = c_strip_suf(ins.args[0].name);
                    // 跳过纯数字字面量（不形成别名链）；其余（含无 $ 前缀的 C 变量名）一律视为别名源。
                    var isdig: bool = str_len(ssrc) as i64 > 0;
                    var di: i64 = 0;
                    while (di < str_len(ssrc) as i64) { if (ssrc[di] < 48 or ssrc[di] > 57) { isdig = false; break; } di = di + 1; }
                    if (isdig == false) { nxt = ssrc; }
                }
                bk = bk + 1;
            }
            k = k + 1;
        }
        // 别名表兜底（部分别名可能未走 BITCAST/STORE，如 sret 转发）
        if (nxt == "") {
            var j: i64 = 0;
            while (j < slice_len(g_c_alias_name) as i64) { if (g_c_alias_name[j] == cur) { nxt = g_c_alias_to[j]; break; } j = j + 1; }
        }
        if (nxt == "" or nxt == cur) { return cur; }
        var dup: bool = false; var d: i64 = 0;
        while (d < slice_len(seen) as i64) { if (seen[d] == nxt) { dup = true; break; } d = d + 1; }
        if (dup) { return cur; }
        append(seen, cur); cur = nxt;
    }
    return cur;   // 不可达（while(true) 内必返回）；仅满足「全路径显式 return」静态检查
}
// 值尺寸 → 值类型 ST 文本：16B→%TStr（string 值），其余按尺寸取标量。
// 与运行库 t_map_get 写入字节数一致；tmir-c 据此把出参缓冲声明为正确类型，
// 避免 int64_t→TStr 非法强转（maps.tc 的 strval 用例）。注：f64 值（亦 8B）会按 i64 处理，
// 仅影响 f64 值 map 的 tmir-c 分支（LLVM 轨恒按 %TStr/16B 处理，本分支与之对齐常见情形）。
pub fn c_map_val_st(vsz: i64) string {
    if (vsz == 16) { return "%TStr"; }
    if (vsz == 8) { return "i64"; }
    if (vsz == 4) { return "i32"; }
    if (vsz == 2) { return "i16"; }
    if (vsz == 1) { return "i8"; }
    return "i64";
}
// 预扫描：收集模块内 map 句柄 → 值尺寸（t_map_new(handle, kk, vsz)）写入 g_c_map_vsz_name/val，
// 供 c_emit_func 每函数预扫描据句柄尺寸把 map_get 的 dst 出参缓冲定为值类型（16B→%TStr / 8B→i64 …）。
// ⚠ 注意：map_get dst 的槽类型标记不能在此处做——g_c_slot_tyname 在 c_emit_func 内会被每函数重置（行 1322），
// 模块级标记会被抹除；真正的标记改在 c_emit_func 的 CALL 预扫描分支里完成（见下方）。
// ⚠ vsz 实参常为 CONST 槽（$tZ）而非字面量，须解析其常量值，否则 tir_digits_to_i64 落空→回退 8→
// 字符串值映射（valsz=16）被误判为 8 → map_val_ptr 按 8B 截断读 TStr → 乱码（map_assign/map_iter/…）。
pub fn c_const_literal_of(f: TMIRFunc, slot: string) string {
    var bi: i64 = 0;
    while (bi < slice_len(f.blocks) as i64) {
        var ki: i64 = 0;
        while (ki < slice_len(f.blocks[bi].insts) as i64) {
            var ins: TMIRInst = f.blocks[bi].insts[ki];
            if (ins.op == tir__TIR_OP_CONST and c_strip_suf(ins.dst.name) == slot and slice_len(ins.args) as i64 >= 1) {
                return ins.args[0].name;
            }
            ki = ki + 1;
        }
        bi = bi + 1;
    }
    return "";
}
pub fn c_prescan_map_get_ty(m: TMIRModule) void {
    var fi: i64 = 0;
    while (fi < slice_len(m.funcs) as i64) {
        var f: TMIRFunc = m.funcs[fi];
        if (slice_len(f.blocks) as i64 == 0) { fi = fi + 1; continue; }
        var bi: i64 = 0;
        while (bi < slice_len(f.blocks) as i64) {
            var ki: i64 = 0;
            while (ki < slice_len(f.blocks[bi].insts) as i64) {
                var ins: TMIRInst = f.blocks[bi].insts[ki];
                if (ins.op == tir__TIR_OP_CALL) {
                    var cb: string = c_cbase(c_strip_suf(ins.args[0].name));
                    if (cb == "map_new" and slice_len(ins.args) as i64 >= 3) {
                        var hn: string = c_strip_suf(ins.dst.name);
                        // ⚠ 值尺寸是 t_map_new(arena, kk, vsz) 的【末参】（vsz），不是 args[2]（kk 键类型）。
                        // 此前错取 args[2]→把键类型当尺寸，字符串值映射（valsz=16）恒误判为 8 → 截断。
                        var lasti: i64 = slice_len(ins.args) as i64 - 1;
                        var vsz_arg: string = ins.args[lasti].name;
                        var vsz: i64 = tir.tir_digits_to_i64(vsz_arg);
                        if (vsz <= 0 and str_len(vsz_arg) as i64 > 0 and vsz_arg[0] == 36) {
                            var cv: string = c_const_literal_of(f, c_strip_suf(vsz_arg));
                            vsz = tir.tir_digits_to_i64(cv);
                        }
                        if (vsz <= 0) { vsz = 8; }
                        // 去重登记
                        var j: i64 = 0; var found: bool = false;
                        while (j < slice_len(g_c_map_vsz_name) as i64) { if (g_c_map_vsz_name[j] == hn) { g_c_map_vsz_val[j] = vsz; found = true; break; } j = j + 1; }
                        if (found == false) { append(g_c_map_vsz_name, hn); append(g_c_map_vsz_val, vsz); }
                    }
                }
                ki = ki + 1;
            }
            bi = bi + 1;
        }
        fi = fi + 1;
    }
}

// 参数类型名（从 "f.params" 文本 "$name: <ty>" 解析）。
pub fn c_param_tyname(f: TMIRFunc, n: string) string {
    var np: i64 = slice_len(f.params) as i64;
    var p: i64 = 0;
    while (p < np) {
        var pv: string = f.params[p];
        var col: i64 = c_find_col(pv, ":");
        if (col < 0) { p = p + 1; continue; }
        var pn: string = c_strip_suf(str_slice(pv, 0, col));
        if (pn == n) { return c_strip_ws(str_slice(pv, col + 1, str_len(pv) as i64)); }
        p = p + 1;
    }
    return "";
}
// 参数 → C 类型（声明用）：解析类型名 → c_tystr_c 转换。
pub fn c_param_c_ty(f: TMIRFunc, n: string) string {
    // 被当作聚合基使用的形参 → 字节指针（见 c_agg_param_mark；晚于预扫描，此处才生效）。
    if (c_is_agg_param(f.name, n)) { return "unsigned char*"; }
    var tn: string = c_param_tyname(f, n);
    if (tn != "") { return c_tystr_c(tn); }
    return "long long";   // 回退（参数必有类型名，正常不命中）
}
// slot → C 类型（声明用）：优先用类型名解析，回退到 ST 推断。
pub fn c_slot_c_ty(n: string) string {
    // 模型一致性优先：地址槽 / 聚合基在声明段一律按 unsigned char* 发出，
    // 此处若返回别的类型（如 int64_t），赋值/GEP 目的就不会插转型，与声明冲突。
    if (c_is_address(n) or c_is_agg_base(n)) { return "unsigned char*"; }
    var tn: string = c_slot_ty_find(n);
    if (tn != "") { return c_tystr_c(tn); }
    var st: i64 = c_slot_st(n, g_cf);
    if (st >= tir__ST_NAMED_BASE) { return c_tystr_c(tir.tir_st_to_str(st)); }
    return tmir.tmir_st_c(st);
}
// 函数返回类型（从 mm.funcs 查；内建不在 func 表 → ""）。
// ⚠ 修根因：原写法第三判据 `fnm == c_fn_name(fnm)` 是**自比较**（名字不含 '.'/'@' 时恒真），
//   导致本函数恒返回 funcs[0].ret_st、c_is_user_func 恒为真 → 大量调用被误判成 void/sret
//   （sb_to_str 结果被丢弃、闭包/聚合返回值全 0）。正确判据：函数名重整后与 callee 基名相等。
pub fn c_func_ret_st(callee: string) string {
    var fi: i64 = c_func_lookup_first(callee);
    if (fi >= 0) { return g_c_mod.funcs[fi].ret_st; }
    return "";
}
pub fn c_is_user_func(callee: string) bool {
    // 常见路径：综合查表取首个匹配；若该匹配是内建/声明副本（无体），线性兜底找下一个有体同名。
    var fi: i64 = c_func_lookup_first(callee);
    if (fi >= 0 and slice_len(g_c_mod.funcs[fi].blocks) as i64 > 0) { return true; }
    var nf: i64 = slice_len(g_c_mod.funcs) as i64;
    var i: i64 = 0;
    var cb: string = c_func_base(callee);
    while (i < nf) {
        var fnm: string = g_c_mod.funcs[i].name;
        if (fnm == callee or fnm == cb or c_fn_name(fnm) == cb) {
            if (slice_len(g_c_mod.funcs[i].blocks) as i64 > 0) { return true; }
        }
        i = i + 1;
    }
    return false;
}
// 调用名 → C 函数名基名：剥离 tll_/t_ 前缀与 '@' 全局前缀，得到运行库内建基名（"map_new"/"println"…）。
// 用于内建集合判定与 void 判定（IR 中内建可能以 tll_* 形式出现）。
pub fn c_cbase(name: string) string {
    if (c_starts(name, "tll_")) { return str_slice(name, 4, str_len(name) as i64); }
    if (c_starts(name, "t_")) { return str_slice(name, 2, str_len(name) as i64); }
    if (str_len(name) as i64 > 0 and name[0] == 64) { return c_strip_suf(str_slice(name, 1, str_len(name) as i64)); }
    return c_strip_suf(name);
}

// ── 闭包支持：统一 TClosure ABI（code(env, args…)）──────────────────
// t 的闭包值统一表示为运行库 %TClosure{ void* fn; void* env; }（runtime/t_runtime.h）。
// CALL_IND 恒按 code(env, 实参…) 调用：
//   · 合成闭包（首参名为 __env）→ code 即其本身（env 是真实首参）；
//   · 普通函数（无 env 首参）→ 必须经 <fn>__clo_thunk(void* __env, …) 转发，
//     否则 env 会被当成第一个实参吃掉（LLVM 侧同款适配：tir_to_ll.ll_flush_clo_thunks）。
// ⚠ 判据用「首参名 == __env」而非类型：高阶函数的闭包形参类型同样是 ptr<void>，只有名字能区分。
pub fn c_build_func_index() void {
    g_c_func_idx = map_new(g_c_func_idx);
    g_c_func_lookup = map_new(g_c_func_lookup);
    var nf: i64 = slice_len(g_c_mod.funcs) as i64;
    var i: i64 = 0;
    while (i < nf) {
        var fnm: string = g_c_mod.funcs[i].name;
        // 与旧 c_func_find 的三路匹配严格对齐：raw / c_strip_suf / c_fn_name 三种形态都登记，
        // 保证查表语义与线性扫描完全一致（命中即返回该索引）。存储 i+1，0 表示未命中。
        map_set(g_c_func_idx, fnm, i + 1);
        map_set(g_c_func_idx, c_strip_suf(fnm), i + 1);
        map_set(g_c_func_idx, c_fn_name(fnm), i + 1);
        // 综合查表（覆盖 overload 基名 / c_cbase / 运行库前缀剥离）：每键只登记首次出现（最小索引），
        // 以严格复刻「列表序首个匹配」语义。供 c_func_ret_st / c_is_user_func / c_callee_param_ty 使用。
        // ⚠ map_get 必须落到「显式 i64 局部」再比较：LLVM 后端对 `map_get(..)==0` 内联比较会误把
        // out-param 类型推导成键类型(TStr)而非值类型(i64)，导致 IR 类型冲突（与 c_func_find 写法对齐）。
        var h: i64 = 0;
        h = map_get(g_c_func_lookup, fnm);
        if (h == 0) { map_set(g_c_func_lookup, fnm, i + 1); }
        var ks: string = c_strip_suf(fnm);
        h = map_get(g_c_func_lookup, ks);
        if (h == 0) { map_set(g_c_func_lookup, ks, i + 1); }
        var kf: string = c_fn_name(fnm);
        h = map_get(g_c_func_lookup, kf);
        if (h == 0) { map_set(g_c_func_lookup, kf, i + 1); }
        var kb: string = c_func_base(fnm);
        h = map_get(g_c_func_lookup, kb);
        if (h == 0) { map_set(g_c_func_lookup, kb, i + 1); }
        var kc: string = c_cbase(fnm);
        h = map_get(g_c_func_lookup, kc);
        if (h == 0) { map_set(g_c_func_lookup, kc, i + 1); }
        i = i + 1;
    }
    g_c_func_idx_built = true;
    g_c_func_lookup_built = true;
}
pub fn c_func_find(name: string) i64 {
    if (g_c_func_idx_built == false) { c_build_func_index(); }
    var v: i64 = map_get(g_c_func_idx, name);
    if (v == 0) { return -1; }
    return v - 1;
}
// 综合函数查表（O(1)）：返回首个（列表序最小）签名/基名匹配的函数索引，覆盖
// `fnm==q || fnm==c_func_base(q) || c_fn_name(fnm)==c_func_base(q)` 三种条件取最小索引，
// 严格等价于原 c_func_ret_st / c_is_user_func / c_callee_param_ty 的 O(funcs) 线性扫描首命中。
pub fn c_func_lookup_first(q: string) i64 {
    if (g_c_func_lookup_built == false) { c_build_func_index(); }
    var best: i64 = -1;
    var a: i64 = map_get(g_c_func_lookup, q);
    if (a > 0) { best = a - 1; }
    var cb: string = c_func_base(q);
    var b: i64 = map_get(g_c_func_lookup, cb);
    if (b > 0 and (best < 0 or (b - 1) < best)) { best = b - 1; }
    return best;
}
pub fn c_build_global_index() void {
    g_c_global_idx = map_new(g_c_global_idx);
    var ng: i64 = slice_len(g_c_mod.globals) as i64;
    var i: i64 = 0;
    while (i < ng) {
        map_set(g_c_global_idx, g_c_mod.globals[i].name, i + 1);
        i = i + 1;
    }
    g_c_global_idx_built = true;
}
pub fn c_func_base(name: string) string {
    var b: string = c_strip_suf(name);
    if (str_len(b) as i64 > 0 and b[0] == 64) { b = str_slice(b, 1, str_len(b) as i64); }
    return b;
}
pub fn c_func_has_env(name: string) bool {
    var fi: i64 = c_func_find(name);
    if (fi < 0) { return false; }
    var f: TMIRFunc = g_c_mod.funcs[fi];
    if (slice_len(f.params) as i64 == 0) { return false; }
    var pv: string = f.params[0];
    var col: i64 = c_find_col(pv, ":");
    if (col < 0) { return false; }
    var pn: string = c_strip_suf(str_slice(pv, 0, col));
    if (pn == "__env" or pn == "$__env") { return true; }
    return false;
}
// 操作数是否引用「有体的用户函数」（闭包值来源：@__lam_1 / @make_adder）。
pub fn c_is_func_ref(name: string) bool {
    if (str_len(name) as i64 == 0) { return false; }
    var b: string = c_func_base(name);
    if (str_len(b) as i64 == 0) { return false; }
    if (c_is_builtin(b)) { return false; }
    var fi: i64 = c_func_find(b);
    if (fi < 0) { return false; }
    if (slice_len(g_c_mod.funcs[fi].blocks) as i64 == 0) { return false; }
    return true;
}
pub fn c_thunk_name(fname: string) string { return base.sb_cat2(c_fn_name(fname), "__clo_thunk"); }
// 函数引用 → TClosure.field0（code 指针）的 C 表达式；普通函数登记 thunk 需求并返回 thunk 名。
pub fn c_clo_code(name: string) string {
    var b: string = c_func_base(name);
    if (c_func_has_env(b)) { return c_fn_name(b); }
    var i: i64 = 0;
    while (i < slice_len(g_c_thunk_req) as i64) { if (g_c_thunk_req[i] == b) { return c_thunk_name(b); } i = i + 1; }
    append(g_c_thunk_req, b);
    return c_thunk_name(b);
}
// 函数引用当「闭包值」直接传递（apply2(__lam_4, …)）→ 需要一份 static TClosure 常量全局
// （对齐 LLVM 的 @.tirll_clo_<fn> = global %TClosure { code, null }）。
pub fn c_clo_global(name: string) string {
    var b: string = c_func_base(name);
    var gn: string = base.sb_cat2("__clo_", c_fn_name(b));
    var i: i64 = 0;
    while (i < slice_len(g_c_clo_globals) as i64) { if (g_c_clo_globals[i] == b) { return gn; } i = i + 1; }
    append(g_c_clo_globals, b);
    c_clo_code(b);          // 顺带登记 thunk 需求（普通函数需 env 适配转发）
    return gn;
}
pub fn c_emit_clo_globals(sb: StringBuilder) void {
    var i: i64 = 0;
    while (i < slice_len(g_c_clo_globals) as i64) {
        var b: string = g_c_clo_globals[i];
        sb_append_str(sb, "static TClosure "); sb_append_str(sb, c_clo_global(b));
        sb_append_str(sb, " = { (void*)("); sb_append_str(sb, c_clo_code(b));
        sb_append_str(sb, "), 0 };\n");
        i = i + 1;
    }
    if (slice_len(g_c_clo_globals) as i64 > 0) { sb_append_str(sb, "\n"); }
}
// 预扫描：函数体发射前先收集全部 thunk / 闭包全局需求（二者定义须先于引用它们的函数体）。
// ⚠ 跳过 CALL 的 args[0]（那是被调者本身，不是闭包值），否则会为每个函数白造一份 TClosure。
pub fn c_prescan_thunks(m: TMIRModule) void {
    var nf: i64 = slice_len(m.funcs) as i64;
    var fi: i64 = 0;
    while (fi < nf) {
        var f: TMIRFunc = m.funcs[fi];
        var nb: i64 = slice_len(f.blocks) as i64;
        var bi: i64 = 0;
        while (bi < nb) {
            var ni: i64 = slice_len(f.blocks[bi].insts) as i64;
            var k: i64 = 0;
            while (k < ni) {
                var ins: TMIRInst = f.blocks[bi].insts[k];
                // RET 的「返回值」是 dst 而非 args（return mul; 之类）。
                if (ins.op == tir__TIR_OP_RET and c_is_func_ref(ins.dst.name)) { c_clo_global(ins.dst.name); }
                var na: i64 = slice_len(ins.args) as i64;
                var a: i64 = 0;
                while (a < na) {
                    if (a == 0 and ins.op == tir__TIR_OP_CALL) { a = a + 1; continue; }
                    if (c_is_func_ref(ins.args[a].name)) { c_clo_global(ins.args[a].name); }
                    a = a + 1;
                }
                k = k + 1;
            }
            bi = bi + 1;
        }
        fi = fi + 1;
    }
}
// 发射普通函数的 env 适配 thunk：static R <fn>__clo_thunk(void* __env, <params…>) { [return] <fn>(<args…>); }
pub fn c_emit_thunks(sb: StringBuilder) void {
    var n: i64 = slice_len(g_c_thunk_req) as i64;
    var i: i64 = 0;
    while (i < n) {
        var fname: string = g_c_thunk_req[i];
        var fi: i64 = c_func_find(fname);
        i = i + 1;
        if (fi < 0) { continue; }
        var f: TMIRFunc = g_c_mod.funcs[fi];
        if (f.is_main or f.name == "main" or f.name == "@main") { continue; }
        var ret: string = "void";
        if (f.ret_st != "" and f.ret_st != "void") { ret = c_tystr_c(f.ret_st); }
        var np: i64 = slice_len(f.params) as i64;
        sb_append_str(sb, "static "); sb_append_str(sb, ret); sb_append_str(sb, " ");
        sb_append_str(sb, c_thunk_name(fname)); sb_append_str(sb, "(void* __env");
        var p: i64 = 0;
        while (p < np) {
            var pv: string = f.params[p];
            var col: i64 = c_find_col(pv, ":");
            if (col < 0) { p = p + 1; continue; }
            var pn: string = c_strip_suf(str_slice(pv, 0, col));
            sb_append_str(sb, ", "); sb_append_str(sb, c_param_c_ty(f, pn)); sb_append_str(sb, " ");
            sb_append_str(sb, pn);
            p = p + 1;
        }
        sb_append_str(sb, ") {\n  ");
        if (ret == "void") { sb_append_str(sb, c_fn_name(fname)); }
        else { sb_append_str(sb, "return "); sb_append_str(sb, c_fn_name(fname)); }
        sb_append_str(sb, "(");
        var q: i64 = 0;
        while (q < np) {
            var pv2: string = f.params[q];
            var col2: i64 = c_find_col(pv2, ":");
            if (col2 >= 0) {
                if (q > 0) { sb_append_str(sb, ", "); }
                sb_append_str(sb, c_strip_suf(str_slice(pv2, 0, col2)));
            }
            q = q + 1;
        }
        sb_append_str(sb, ");\n}\n");
    }
    if (slice_len(g_c_thunk_req) as i64 > 0) { sb_append_str(sb, "\n"); }
}
// 调用名 → C 函数名：tll_*→t_*；t_*/llvm.* 直通；内建（prelude 带体但须走 C 运行库）→ t_<name>；
// 用户函数原样（c_fn_name 重整 '.'→'_'）；其余兜底 t_<name>。map_new 的 arena 注入在 CALL handler 单独处理。
// 调用点「首形参具名指针类型」路由。
// 背景：字节缓冲模型把 map/sb 句柄槽统一表示为 unsigned char*，而运行库签名要求 TMap*/TSb*；
// 二者同为机器指针（sizeof 相同），语义上是纯重解释，但 C 不做指针类型隐式转换（只隐式转 void*），
// 于是生成码报 incompatible pointer types → 必须在调用点插入显式转型。
// 只对「确知运行库内建」生效（排除用户同名函数与 *_new 构造器的 arena 形）。
pub fn c_call_arg_ptr(bname: string, aidx: i64) string {
    if (c_is_builtin(bname) == false) { return ""; }
    if (c_starts(bname, "sb_")) {
        if (bname == "sb_new") { return ""; }
        if (aidx == 1) { return "TSb*"; }
        return "";
    }
    if (c_starts(bname, "map_")) {
        if (bname == "map_new") { return ""; }
        // map_concat / map_concat_into：全部指针形参都是 TMap*。
        if (bname == "map_concat" or bname == "map_concat_into") { return "TMap*"; }
        if (aidx == 1) { return "TMap*"; }
        return "";
    }
    return "";
}

// C 运行库里一批函数按 const char* 收「路径 / 后缀 / C 串」，而 TIR 侧实参统一是 TStr
// → 必须显式 t_cstr() 转换，否则 "passing 'TStr' to parameter of incompatible type 'const char *'"
//   （fid_demo / fid_read_demo / fid_seek_demo / fid_error_demo 全簇）。
//   LLVM 侧同款差异由 runtime/t_shim_ll.c 的 tll_fopen 等薄封装吸收，C 轨无薄封装故在此转换。
pub fn c_builtin_cstr_arg(bname: string, aidx: i64) bool {
    if (bname == "fopen") { return aidx == 1; }
    if (bname == "file_read_all" or bname == "file_exists" or bname == "path_resolve" or bname == "getenv") { return aidx == 1; }
    if (bname == "file_write_all") { return aidx == 1; }
    if (bname == "fmt_register") { return aidx == 2; }
    if (bname == "sb_append_cstr") { return aidx == 2; }
    if (bname == "cpu_has_cstr") { return aidx == 1; }
    return false;
}
// 发射调用实参：首实参（aidx==1）且形参确为具名对象指针时插显式转型。
fn c_emit_call_arg(sb: StringBuilder, op: TirOperand, aidx: i64, bname: string, poff: i64) void {
    // TStr → const char*：运行库这批函数要 C 串，走 t_cstr() 显式转换。
    if (c_builtin_cstr_arg(bname, aidx)) {
        sb_append_str(sb, "t_cstr("); c_emit_val(sb, op); sb_append_str(sb, ")");
        return;
    }
    // 函数引用当闭包实参（apply2(__lam_4, …)）：传 &static TClosure 常量，而非裸函数地址。
    if (aidx >= 1 and c_is_func_ref(op.name)) {
        sb_append_str(sb, "(unsigned char*)(&"); sb_append_str(sb, c_clo_global(op.name)); sb_append_str(sb, ")");
        return;
    }
    var pty: string = c_call_arg_ptr(bname, aidx);
    if (pty != "") {
        sb_append_str(sb, "("); sb_append_str(sb, pty); sb_append_str(sb, ")(");
        c_emit_val(sb, op); sb_append_str(sb, ")");
        return;
    }
    var vty: string = "";
    if (aidx == 1) { vty = c_call_arg_val(bname); }
    if (vty == "") { vty = c_call_arg_ty(bname, aidx); }
    // map_* 的 key/value 形参是 const void*：结构体值实参须取址。
    if (vty == "" and aidx >= 2 and c_starts(bname, "map_") and bname != "map_new") { vty = "void*"; }
    // 用户函数：按 callee 签名的形参类型。aidx 需扣除 sret 出参占位，但 TIR 的 sret 判定
    // 与 TIR 层不完全一致，故两个偏移都试，取第一个能给出期望类型的结果。
    if (vty == "") {
        if (poff == 2) {
            vty = c_callee_param_ty(bname, aidx - 2);
            if (vty == "") { vty = c_callee_param_ty(bname, aidx - 1); }
        } else {
            vty = c_callee_param_ty(bname, aidx - 1);
        }
    }
    c_emit_conv_arg(sb, op, vty);
}
// 用户函数第 pos 个形参的期望 C 类型；找不到该函数返回 ""。
// ⚠ 必须与签名生成（c_param_c_ty）严格一致：跳过内建与「无体声明」条目，
//   否则会命中一个类型表示不同的声明副本（如 TStr 形参被记为 ptr<%TStr>），
//   导致调用点把 TStr 实参当 unsigned char* 取址（emit/closure_struct 等崩溃）。
pub fn c_callee_param_ty(bname: string, pos: i64) string {
    if (pos < 0) { return ""; }
    // 常见路径：综合查表取首个 strip_suf==bname 且有体的函数（O(1)）；否则线性兜底。
    var fi: i64 = c_func_lookup_first(bname);
    if (fi >= 0) {
        var ff: TMIRFunc = g_c_mod.funcs[fi];
        if (c_strip_suf(ff.name) == bname and c_is_builtin(c_strip_suf(ff.name)) == false and slice_len(ff.blocks) as i64 > 0) {
            if (pos >= slice_len(ff.params) as i64) { return ""; }
            var pv: string = ff.params[pos];
            var col: i64 = c_find_col(pv, ":");
            if (col < 0) { return ""; }
            var pname: string = c_strip_suf(str_slice(pv, 0, col));
            return c_param_c_ty(ff, pname);
        }
    }
    var i: i64 = 0;
    while (i < slice_len(g_c_mod.funcs) as i64) {
        var ff: TMIRFunc = g_c_mod.funcs[i];
        if (c_is_builtin(c_strip_suf(ff.name))) { i = i + 1; continue; }
        if (slice_len(ff.blocks) as i64 == 0) { i = i + 1; continue; }
        if (c_strip_suf(ff.name) == bname) {
            if (pos >= slice_len(ff.params) as i64) { return ""; }
            var pv: string = ff.params[pos];
            var col: i64 = c_find_col(pv, ":");
            if (col < 0) { return ""; }
            var pname: string = c_strip_suf(str_slice(pv, 0, col));
            return c_param_c_ty(ff, pname);
        }
        i = i + 1;
    }
    return "";
}
pub fn c_ends(s: string, suf: string) bool {
    var ls: i64 = str_len(s) as i64;
    var lf: i64 = str_len(suf) as i64;
    if (lf > ls) { return false; }
    return str_slice(s, ls - lf, ls) == suf;
}
// 运行库「按值收 TStr」的形参归属表（按 (内建基名, 实参序号) 给出期望 C 类型）。
// 背景：字节缓冲模型里 string 槽多为 unsigned char*（如 map 迭代键 mk 由 LOAD 得到），
// 而运行库签名按值收 TStr → 必须在调用点解引用成结构体值（*(TStr*)(void*)(mk)）。
pub fn c_call_arg_ty(bname: string, aidx: i64) string {
    if (c_is_builtin(bname) == false) { return ""; }
    if (bname == "println" or bname == "print" or bname == "eprint" or bname == "panic") {
        if (aidx == 1) { return "TStr"; }
        return "";
    }
    if (bname == "sb_append_str") { if (aidx == 2) { return "TStr"; } return ""; }
    if (bname == "sb_append_fmt_str") { if (aidx == 2 or aidx == 3) { return "TStr"; } return ""; }
    if (c_starts(bname, "sb_append_fmt_")) {
        if (aidx == 2) { return "TStr"; }
        if (c_ends(bname, "_conv") and aidx == 4) { return "TStr"; }
        return "";
    }
    if (bname == "assert") { if (aidx == 2) { return "TStr"; } return ""; }
    if (bname == "format_str") { if (aidx == 1 or aidx == 2) { return "TStr"; } return ""; }
    if (c_starts(bname, "format_")) { if (aidx == 1) { return "TStr"; } return ""; }
    if (bname == "str_slice" or bname == "str_concat") { if (aidx == 1 or aidx == 2) { return "TStr"; } return ""; }
    if (bname == "slice_concat") { if (aidx == 1 or aidx == 2) { return "TSlice"; } return ""; }
    if (bname == "bitstr_concat") { if (aidx == 1 or aidx == 2) { return "TBitStr"; } return ""; }
    return "";
}
// 运行库「按值收结构体」的首形参归属表（只需覆盖具名值类型；void* 形参隐式转换合法，无需登记）。
pub fn c_call_arg_val(bname: string) string {
    if (c_is_builtin(bname) == false) { return ""; }
    if (bname == "slice_at" or bname == "slice_len" or bname == "slice_ptr" or bname == "slice_sub"
        or bname == "slice_set" or bname == "slice_concat") { return "TSlice"; }
    if (bname == "str_len" or bname == "str_eq" or bname == "str_byte_at" or bname == "str_at"
        or bname == "str_concat" or bname == "str_slice") { return "TStr"; }
    if (bname == "bitstr_bitlen" or bname == "bitstr_extract" or bname == "bitstr_sub"
        or bname == "bitstr_concat") { return "TBitStr"; }
    return "";
}

// 实参按「const void* 取地址」发射（map_set / map_get / slice_set 的字节指针形参，以及 c_emit_conv_arg 的
// struct→ptr 分支）。若实参是 rvalue（函数调用结果 / 复合字面量），C 不允许对 rvalue 取地址
// （clang: cannot take the address of an rvalue of type 'TStr'）→ 先提升为本块临时变量再取址。
// 判定：c_emit_val 产出的表达式若含 '('，即为调用/复合字面量（非变量/全局 lvalue）→ rvalue。
// 若实参已是以 '&' 开头的地址（如 TClosure 全局 &g），则直接透传，避免双重取址。
// 提升声明写入 g_c_pre（调用语句的前置缓冲），由调用点发射器在调用语句之前落盘。
pub fn c_emit_voidp_addr(sb: StringBuilder, op: TirOperand) void {
    var _ex: StringBuilder = sb_new();
    c_emit_val(_ex, op);
    var _exs: string = sb_to_str(_ex);
    // 是否「取址表达式本身已带 &」（TIR 直接给出 '&<expr>'）：内层 <expr> 可能是函数调用 / 复合字面量。
    var _has_addr: bool = (str_len(_exs) as i64 >= 1 and _exs[0] == 38);
    var _inner: string = _exs;
    if (_has_addr) { _inner = str_slice(_exs, 1, str_len(_exs)); }
    // rvalue 取址：内层表达式以标识符开头且含 '('（函数调用 / 结构体构造）→ 非 lvalue，C 不允许对其取址
    // （clang: cannot take the address of an rvalue of type 'TStr'）。
    //   须剥掉前导 '&'，把内层调用结果提升到本块临时变量，再取该临时变量的地址。
    //   注：若 _inner 以 '(' 开头则属「类型转换 / 复合字面量」（C 里已是 lvalue，如 &(int64_t){x}），不提升。
    if (str_len(_inner) as i64 >= 1 and _inner[0] != 40 and c_find_col(_inner, "(") >= 0) {
        var _tn: string = base.sb_cat2("_ctmp", base.i2s(g_c_tmpc));
        g_c_tmpc = g_c_tmpc + 1;
        // 临时类型 = 内层调用返回类型：按函数表反查 ret_st → C 类型（聚合按结构体 / 标量按 int64_t）。
        var _rty: string = "";
        var _lp: i64 = c_find_col(_inner, "(");
        if (_lp >= 0) {
            var _fn: string = str_slice(_inner, 0, _lp);
            var _rst: string = c_func_ret_st(_fn);
            if (_rst != "") { _rty = c_tystr_c(_rst); }
        }
        if (_rty == "") { _rty = "TStr"; }   // 反查失败兜底：map 键/值最常见为 TStr
        sb_append_str(g_c_pre, "  "); sb_append_str(g_c_pre, _rty); sb_append_str(g_c_pre, " ");
        sb_append_str(g_c_pre, _tn); sb_append_str(g_c_pre, " = "); sb_append_str(g_c_pre, _inner);
        sb_append_str(g_c_pre, ";\n");
        sb_append_str(sb, "&"); sb_append_str(sb, _tn);
        return;
    }
    if (_has_addr) { sb_append_str(sb, _exs); return; }  // 已是 &地址（含合法复合字面量 &(T){x}）
    // 字节缓冲模型下，操作数 C 类型分两类：
    //  ① 裸字节缓冲指针 "unsigned char*"：它本身就是「值字节所在缓冲的地址」，t_slice_set /
    //     t_map_put 要的就是这个地址 → 直传，不可再取 &（否则取的是「指针变量自身地址」，
    //     会连相邻栈垃圾一起拷 → slice_set 含 string 字段的 struct 元素、tc_self 自举 token 池损坏根因）。
    //     涵盖：聚合基 / 地址槽、map 字面量键值的 (unsigned char*)(&tmp) 缓冲临时量、slice 元素缓冲等。
    //  ② 具名指针值（TMap* / TSb* / TClosure* / int64_t* / ptr<%UserAgg> 等）：槽里存的是值本身
    //     （如 map 值槽存 TMap* 指针、ptr<i64> 槽存机器指针），t_slice_set / t_map_put 须按「值字节」拷贝
    //     → 必须取 & 拿值槽地址（8B 指针本身的字节），否则 map_set(m, k, inner_map) 会把 inner_map 这个
    //     TMap* 当作「值字节源地址」，拷进值槽的是 TMap 结构体头 8B（arena 指针）→ 后续解引用崩溃。
    // ⚠ 旧实现对 ALL 指针类型（c_c_ty_is_ptr）一刀切直传，把 ② 类 map 值槽（TMap*）误判成 ① 类缓冲指针。
    //   正确区分只看「是否为裸字节缓冲 unsigned char*」：它才是唯一应直传的指针类别。
    // 仅「裸字节缓冲 unsigned char*」直传；★map 值槽（C 类型也是 unsigned char*，但槽里存的是 TMap*
    // 这个值本身）须取 & 拿值槽地址，否则 map_set(m, k, inner_map) 会把 inner_map 这个 TMap* 当
    // 「值字节源地址」，拷进值槽的是 TMap 结构体头 8B（arena 指针）→ 后续解引用崩溃。
    // 判定：沿 def-use 链回溯操作数到 t_map_new 句柄（g_c_map_vsz_name 登记者）即视为 map 值；
    // 字节缓冲临时量（字面量键值的 (unsigned char*)(&tmp)）回溯不到 map 句柄 → 仍直传。
    var _is_map_val: bool = false;
    var _onm: string = c_strip_suf(op.name);
    if (str_len(_onm) as i64 > 0) {
        var _h: string = c_map_resolve_handle(_onm);
        var _i: i64 = 0;
        while (_i < slice_len(g_c_map_vsz_name) as i64) { if (g_c_map_vsz_name[_i] == _h) { _is_map_val = true; break; } _i = _i + 1; }
    }
    if (c_operand_c_ty(op) == "unsigned char*" and _is_map_val == false) { sb_append_str(sb, _exs); return; }
    sb_append_str(sb, "&"); sb_append_str(sb, _exs);
}

pub fn c_emit_conv_arg(sb: StringBuilder, op: TirOperand, want: string) void {
    if (want == "") { c_emit_val(sb, op); return; }
    var got: string = c_operand_c_ty(op);
    if (c_c_ty_is_struct(want) and c_c_ty_is_ptr(got)) {
        sb_append_str(sb, "*("); sb_append_str(sb, want); sb_append_str(sb, "*)(void*)(");
        c_emit_val(sb, op); sb_append_str(sb, ")");
        return;
    }
    if (c_c_ty_is_ptr(want) and c_c_ty_is_struct(got)) {
        // struct 值实参须取址传入指针形参；rvalue 取址经 c_emit_voidp_addr 自动提升。
        sb_append_str(sb, "("); sb_append_str(sb, want); sb_append_str(sb, ")(void*)(");
        c_emit_voidp_addr(sb, op); sb_append_str(sb, ")");
        return;
    }
    c_emit_val(sb, op);
}

pub fn c_call_cname(callee: string) string {
    if (c_starts(callee, "tll_")) { return base.sb_cat2("t_", str_slice(callee, 4, str_len(callee) as i64)); }
    if (c_starts(callee, "t_")) { return callee; }
    if (c_starts(callee, "llvm.")) { return callee; }
    if (c_is_math_builtin(callee)) { return base.sb_cat2("t_math_", callee); }
    // 别名：t 源码里的名字与运行库导出名不同一一对应（与 LLVM 后端 ll_runtime_callee 对齐）。
    var cb2: string = c_cbase(callee);
    if (cb2 == "i2s") { return "t_int_to_str"; }
    if (cb2 == "str_at") { return "t_str_byte_at"; }
    if (cb2 == "map_set") { return "t_map_put"; }
    if (cb2 == "sym_intern64") { return "t_sym_intern"; }
    if (cb2 == "unwrap") { return "t_opt_unwrap"; }
    if (cb2 == "sys_run") { return "t_system"; }   // 运行库导出 t_system(TStr)；对齐 LLVM 后端的 tll_system 特例映射（C 轨无 tll_* shim）
    if (c_is_builtin(callee)) { return base.sb_cat2("t_", callee); }
    if (c_is_user_func(callee)) { return c_fn_name(base.sb_cat2("@", callee)); }
    return base.sb_cat2("t_", callee);
}
// C 字符串字面量转义（双引号 / 反斜杠 / 控制字符）。
pub fn c_esc_c(s: string) string {
    var out: string = "";
    var L: i64 = str_len(s) as i64;
    var i: i64 = 0;
    while (i < L) {
        var c: i64 = s[i];
        if (c == 34) { out = base.sb_cat2(out, "\\\""); }
        else if (c == 92) { out = base.sb_cat2(out, "\\\\"); }
        else if (c == 10) { out = base.sb_cat2(out, "\\n"); }
        else if (c == 13) { out = base.sb_cat2(out, "\\r"); }
        else if (c == 9) { out = base.sb_cat2(out, "\\t"); }
        else { out = base.sb_cat2(out, str_slice(s, i, i + 1)); }
        i = i + 1;
    }
    return out;
}
pub fn c_is_tstr_st(st: i64) bool {
    if (st < tir__ST_NAMED_BASE) { return false; }
    return tir.tir_st_to_str(st) == "%TStr";
}

// ── 模块级 CFG / 聚合状态 ────────────────────────────────────
pub var g_c_mod: TMIRModule;
pub var g_cf: TMIRFunc;
pub var g_c_addr_slot_name: []string;   // 地址槽名（unsigned char* 指针声明）
pub var g_c_addr_name: []string;        // 地址槽名（load/store 元素类型表）
pub var g_c_addr_st: []i64;             // 地址槽元素 ST（load/store 宽度）
pub var g_c_addr_base_name: []string;   // 地址槽名
pub var g_c_addr_base_ty: []string;     // 对应聚合基类型（"%Struct"/"arr<...>"）
pub var g_c_agg_base_name: []string;    // 聚合基槽名（本地缓冲拥有者）
pub var g_c_agg_param_name: []string;  // 被当作聚合基使用的形参名（ADDR_OF/GEP 基）→ 声明为 unsigned char*
// map 句柄槽名 → 值尺寸（字节）：来自 t_map_new(handle, kk, vsz) 的 vsz，用于把 map_get 出参
// 缓冲 dst 槽声明为正确类型（16B→%TStr / 8B→i64 …），并据其定 memset 清零尺寸。
pub var g_c_map_vsz_name: []string;
pub var g_c_map_vsz_val: []i64;
pub var g_c_agg_base_size: []i64;       // 缓冲尺寸（字节）
// 结构体值槽（源码 `var l: Self;` 这类聚合局部，非聚合基、非形参）→ 需零初始化后备缓冲。
// 字节缓冲模型下它们是 unsigned char* 槽；若初始化为 (unsigned char*)0，后续
// ret/store 会 memcpy 自 NULL → 段错误（list_demo/vector_demo/concat_demo/colony_* 的 new 类构造函数）。
pub var g_c_ptrbuf_name: []string;
pub var g_c_ptrbuf_size: []i64;
// slice_at 结果槽（元素字节地址）：其后续 LOAD 聚合须「别名」而非再读 8B，
// 见 LOAD 处理器（closure env 字段存指针的情形不能套用同一规则，故单独记录）。
pub var g_c_sliceat_slot: []string;
// ── type_info(T) 反射（TIR_OP_TYPEINFO=62）支撑 ──────────────────
// 与 LLVM 轨同构：合成 __ti_<T>_meta（TypeMeta 全局）+ __ti_<T>_f[]（FieldInfo 数组），
// 构造器把 { i64 tag@0, TypeMeta* meta@8 } 写进 16B variant 数据槽，dst 存其指针。
pub var g_c_ti_done: []string;      // 已合成 __ti_<T> 的类型名（去重）
pub var g_c_ti_typedefs: bool;      // TypeMeta/FieldInfo typedef 是否已发射
pub var g_c_tmpc: i64;                  // load/store 临时变量计数器
pub var g_c_pre: StringBuilder;          // 取址 rvalue 提升前置声明缓冲（函数调用结果等不可取址值须先提升为本块临时变量）
// 类型名 → 声明种类（i64 哨兵：0=无/1=Struct/2=Union/3=Enum），O(1) 替代 c_ti_decl_kind 的
// O(lex.decl_list) 全扫描。⚠ 仅用 i64 字典：map[string]string 在 tir 后端 segfault（已实测）。
// c_ti_arm 被每个 type_info 指令调用（prescan + 函数体发射两处），全编译器反射密集 → 累计成
// O(type_info_ops × decl_list) 的扫描+字符串分配，拖垮 bump arena；一次建表后退化 O(1)。
// 同时存 类型名 → 声明节点 id（g_c_decl_node），供 c_ti_emit_global 直接取字段，避免对 decl_list 的二次全扫描。
pub var g_c_decl_kind: map[string]i64;
pub var g_c_decl_node: map[string]i64;
pub var g_c_decl_kind_built: bool = false;
pub fn c_build_decl_kind() void {
    g_c_decl_kind = map_new(g_c_decl_kind);
    g_c_decl_node = map_new(g_c_decl_node);
    var n: i64 = slice_len(lex.decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = lex.decl_list[i];
        var k: string = base.node_kind((d as u64));
        var kn: i64 = 0;
        if (k == "StructDecl") { kn = 1; }
        else if (k == "UnionDecl") { kn = 2; }
        else if (k == "EnumDecl") { kn = 3; }
        else if (k == "VariantDecl") { kn = 2; }
        else { i = i + 1; continue; }
        var tn: string = base.node_sa((d as u64));
        var de: i64 = map_get(g_c_decl_kind, tn);
        if (de == 0) { map_set(g_c_decl_kind, tn, kn); map_set(g_c_decl_node, tn, d); }
        i = i + 1;
    }
    g_c_decl_kind_built = true;
}
pub fn c_ti_decl_kind(tname: string) string {
    if (g_c_decl_kind_built == false) { c_build_decl_kind(); }
    var kn: i64 = map_get(g_c_decl_kind, tname);
    if (kn == 1) { return "Struct"; }
    if (kn == 2) { return "Union"; }
    if (kn == 3) { return "Enum"; }
    return "";
}
// 每函数 slot → 类型名（"ptr<%Event>"/"%TStr"/"i64"/"arr<i8 x 24>"…），用于 emit 期检索。
pub var g_c_slot_tyname: []string;      // slot 名
pub var g_c_slot_tyty: []string;        // 类型名字符串
pub var g_c_mapval_slot: []string;      // map_val_ptr 调用结果槽名（其 dst 即值字节指针，载入宽度须按映射值类型）
pub var g_c_alias_name: []string;       // 每函数槽别名：bitcast dst → 源槽（map 句柄 t43=(void*)(mi) 之类）
pub var g_c_alias_to: []string;
pub var g_c_thunk_req: []string;        // 需 env 适配 thunk 的普通函数名（无 env 首参，却被当闭包值用）
pub var g_c_clo_globals: []string;      // 需发射 static TClosure 常量全局的函数基名（函数值直接当闭包传）

// ⚠ 函数名 → 索引查表（O(1) 替代 c_func_find 的 O(funcs) 线性扫描）：
// tmir-c 的预处理/发射对「每个操作数」都调用 c_func_find（经 c_is_func_ref / c_func_has_env / CALL handler），
// 若走线性扫描会在每个操作数上对每个函数各分配临时串（c_strip_suf/c_fn_name）→ 对超大模块（如 @import("src.base")）
// 累计 O(insts×funcs) 次分配，而 t_arena 是 bump 分配器永不回收，终致 "arena: out of memory"（16GB 耗尽）。
// 故在 tmir_to_c 入口建一次名→索引表，c_func_find 改为查表（存储 i+1，0 表示未命中）。
pub var g_c_func_idx: map[string]i64;
pub var g_c_func_idx_built: bool = false;
// 综合函数查表（raw/strip_suf/fn_name/func_base/c_cbase 五键合一，首次出现优先）：覆盖 overload 基名匹配。
pub var g_c_func_lookup: map[string]i64;
pub var g_c_func_lookup_built: bool = false;
// 全局名 → 索引查表（O(1) 替代 c_global_st 的 O(globals) 线性扫描）。
pub var g_c_global_idx: map[string]i64;
pub var g_c_global_idx_built: bool = false;

pub fn c_addr_mark(n: string, st: i64) void {
    var i: i64 = 0;
    while (i < slice_len(g_c_addr_name) as i64) { if (g_c_addr_name[i] == n) { g_c_addr_st[i] = st; return; } i = i + 1; }
    append(g_c_addr_name, n); append(g_c_addr_st, st);
}

pub fn c_is_addr_slot(n: string) bool {
    var i: i64 = 0;
    while (i < slice_len(g_c_addr_slot_name) as i64) { if (g_c_addr_slot_name[i] == n) { return true; } i = i + 1; }
    return false;
}
pub fn c_is_agg_base(n: string) bool {
    var i: i64 = 0;
    while (i < slice_len(g_c_agg_base_name) as i64) { if (g_c_agg_base_name[i] == n) { return true; } i = i + 1; }
    return false;
}
pub fn c_is_sliceat(n: string) bool {
    var i: i64 = 0;
    while (i < slice_len(g_c_sliceat_slot) as i64) { if (g_c_sliceat_slot[i] == n) { return true; } i = i + 1; }
    return false;
}
// 结构体值槽后备缓冲尺寸（字节）；未登记返回 0。
pub fn c_ptrbuf_size_of(n: string) i64 {
    var i: i64 = 0;
    while (i < slice_len(g_c_ptrbuf_name) as i64) { if (g_c_ptrbuf_name[i] == n) { return g_c_ptrbuf_size[i]; } i = i + 1; }
    return 0;
}
pub fn c_ptrbuf_mark(n: string, sz: i64) void {
    var i: i64 = 0;
    while (i < slice_len(g_c_ptrbuf_name) as i64) { if (g_c_ptrbuf_name[i] == n) { return; } i = i + 1; }
    append(g_c_ptrbuf_name, n); append(g_c_ptrbuf_size, sz);
}
pub fn c_is_agg_param(pfn: string, n: string) bool {
    var key: string = base.sb_cat3(pfn, "@", n);
    var i: i64 = 0;
    while (i < slice_len(g_c_agg_param_name) as i64) { if (g_c_agg_param_name[i] == key) { return true; } i = i + 1; }
    return false;
}
pub fn c_agg_param_mark(pfn: string, n: string) void {
    if (c_is_agg_param(pfn, n)) { return; }
    append(g_c_agg_param_name, base.sb_cat3(pfn, "@", n));
}
// 运行库结构体形参（TStr/TSlice/TClosure/TBitStr）：按值传递（与运行库 C 结构逐字一致），
// 绝不当字节缓冲聚合基——否则「签名 unsigned char*」与「主调传 struct 值」类型冲突
// （如 sum(TSlice) 被错生成为 sum(unsigned char*)，而主调 TSlice s={0} 是结构值）。
pub fn c_param_is_rtstruct(f: TMIRFunc, n: string) bool {
    var tn: string = c_param_tyname(f, n);
    if (tn == "") { return false; }
    // ⚠ 用 c_is_runtime_struct_st（剥 % 前缀后比对 "TStr"/"TSlice"/…），而非 c_tystr_c+c_c_ty_is_struct：
    // c_param_tyname 返回的类型名通常**不带** % 前缀（如 "TStr"），c_tystr_c 仅识别 "%TStr"
    // → c_c_ty_is_struct(c_tystr_c("TStr")) 回落 int64_t → 误判非运行库结构体 → TStr 形参被错标成
    // 字节缓冲聚合基（unsigned char*），与主调传 struct 值冲突（agentkit_demo 的 `step` 闭包 TStr 形参
    // s：`memcpy((void*)(t175+0),(void*)(s),16)` 编译错 operand of type 'TStr' 的根因）。
    return c_is_runtime_struct_st(tn);
}
// 模块级预扫描：先于「前向声明」确定哪些形参被当作聚合基使用。
// 若只在 c_emit_func 内扫描，前向声明（发射更早）与该形参的最终声明类型会不一致
// → C 报 conflicting types。
pub fn c_prescan_agg_params(m: TMIRModule) void {
    var fi: i64 = 0;
    while (fi < slice_len(m.funcs) as i64) {
        var pf: TMIRFunc = m.funcs[fi];
        var bi: i64 = 0;
        while (bi < slice_len(pf.blocks) as i64) {
            var ki: i64 = 0;
            while (ki < slice_len(pf.blocks[bi].insts) as i64) {
                var pin: TMIRInst = pf.blocks[bi].insts[ki];
                if (pin.op == tir__TIR_OP_GEP or pin.op == tir__TIR_OP_ADDR_OF or pin.op == tir__TIR_OP_GEP_IDX) {
                    if (slice_len(pin.args) as i64 > 0) {
                        var gb: string = c_strip_suf(pin.args[0].name);
                        if (c_is_param(pf, gb) and c_param_is_rtstruct(pf, gb) == false) { c_agg_param_mark(pf.name, gb); }
                    }
                }
                ki = ki + 1;
            }
            bi = bi + 1;
        }
        fi = fi + 1;
    }
}
pub fn c_addr_base_mark(n: string, ty: string) void {
    var i: i64 = 0;
    while (i < slice_len(g_c_addr_base_name) as i64) { if (g_c_addr_base_name[i] == n) { g_c_addr_base_ty[i] = ty; return; } i = i + 1; }
    append(g_c_addr_base_name, n); append(g_c_addr_base_ty, ty);
}
pub fn c_addr_base_find(n: string) string {
    var i: i64 = 0;
    while (i < slice_len(g_c_addr_base_name) as i64) { if (g_c_addr_base_name[i] == n) { return g_c_addr_base_ty[i]; } i = i + 1; }
    return "";
}
pub fn c_global_st(n: string) i64 {
    if (g_c_global_idx_built == false) { c_build_global_index(); }
    var vi: i64 = map_get(g_c_global_idx, n);
    if (vi > 0) { return g_c_mod.globals[vi - 1].td; }
    return tir__ST_I32;
}
pub fn c_global_is_agg(n: string) bool {
    var st: i64 = c_global_st(n);
    return st >= tir__ST_NAMED_BASE;
}
// 字节缓冲全局：用户聚合 / 定长数组（须落在 _buf 字节缓冲里）。
// 运行库聚合（TStr/TSlice/…）按值返回 → 声明为 struct 值（非缓冲），故不命中。
pub fn c_global_is_bytebuf(n: string) bool {
    if (c_global_is_agg(n) == false) { return false; }
    return c_is_runtime_agg(tir.tir_st_to_str(c_global_st(n))) == false;
}

// ── 类型来源（与 wasm 同语义；dst.st 恒为 0，类型取自变量/定义指令）──
pub fn c_is_cmp_op(op: i64) bool {
    if (op == tir__TIR_OP_EQ or op == tir__TIR_OP_NE) { return true; }
    if (op == tir__TIR_OP_SLT or op == tir__TIR_OP_SGT or op == tir__TIR_OP_SLE or op == tir__TIR_OP_SGE) { return true; }
    if (op == tir__TIR_OP_ULT or op == tir__TIR_OP_UGT or op == tir__TIR_OP_ULE or op == tir__TIR_OP_UGE) { return true; }
    return false;
}
pub fn c_val_st(ins: TMIRInst) i64 {
    if (ins.st != tir__ST_NONE) { return ins.st; }
    if (ins.dst.st != tir__ST_NONE) { return ins.dst.st; }
    return tir__ST_I32;
}
pub fn c_res_st(ins: TMIRInst) i64 {
    if (c_is_cmp_op(ins.op)) { return tir__ST_I32; }
    if (ins.op == tir__TIR_OP_NOT or ins.op == tir__TIR_OP_LNOT) { return tir__ST_I32; }
    return c_val_st(ins);
}
pub fn c_arg_st(ins: TMIRInst, i: i64) i64 {
    if (i < 0 or i >= slice_len(ins.args) as i64) { return c_val_st(ins); }
    var a: TirOperand = ins.args[i];
    if (a.st != tir__ST_NONE) { return a.st; }
    if (str_len(a.name) as i64 > 0 and a.name[0] == 36) { return c_slot_st(c_strip_suf(a.name), g_cf); }
    return c_val_st(ins);
}
// 操作数语义 ST（slot 取声明类型，立即数取自带 st）。
pub fn c_operand_st(op: TirOperand) i64 {
    if (str_len(op.name) as i64 > 0 and op.name[0] == 36) { return c_slot_st(c_strip_suf(op.name), g_cf); }
    return op.st;
}
pub fn c_st_bits(st: i64) i64 {
    if (st == tir__ST_I8 or st == tir__ST_U8) { return 8; }
    if (st == tir__ST_I16 or st == tir__ST_U16) { return 16; }
    if (st == tir__ST_I32 or st == tir__ST_U32 or st == tir__ST_F32) { return 32; }
    if (st == tir__ST_I64 or st == tir__ST_U64 or st == tir__ST_F64) { return 64; }
    if (st == tir__ST_PTR or st == tir__ST_PTR_VOID) { return 64; }
    return 64;
}
// 宽窄转换的 C 整数类型（signed=true→有符号）。
pub fn c_int_cast(st: i64, is_signed: bool) string {
    var bits: i64 = c_st_bits(st);
    if (is_signed) { if (bits == 64) { return "int64_t"; } return "int32_t"; }
    if (bits == 64) { return "uint64_t"; }
    return "uint32_t";
}

// 估计某 slot 的语义 ST（扫描被引用处的 arg.st → 定义指令结果类型 → 兜底 i32）。
// 同 wasm w_slot_st。
pub fn c_slot_st(n: string, f: TMIRFunc) i64 {
    var nb: i64 = slice_len(f.blocks) as i64;
    var b: i64 = 0;
    while (b < nb) {
        var ni: i64 = slice_len(f.blocks[b].insts) as i64;
        var k: i64 = 0;
        while (k < ni) {
            var ins: TMIRInst = f.blocks[b].insts[k];
            var na: i64 = slice_len(ins.args) as i64;
            var a: i64 = 0;
            while (a < na) {
                if (c_strip_suf(ins.args[a].name) == n and ins.args[a].st != tir__ST_NONE) { return ins.args[a].st; }
                a = a + 1;
            }
            k = k + 1;
        }
        b = b + 1;
    }
    b = 0;
    while (b < nb) {
        var ni: i64 = slice_len(f.blocks[b].insts) as i64;
        var k: i64 = 0;
        while (k < ni) {
            var ins: TMIRInst = f.blocks[b].insts[k];
            if (ins.op == tir__TIR_OP_SLOT or ins.op == tir__TIR_OP_CONST_STR) { k = k + 1; continue; }
            // ⚠ CONST 仅赋值的槽：其 dst 类型即常量真类型（i64/u32/…），须据此定宽/定符号，
            // 否则兜底 i32 会把 9223372036854775807 错生成为 (int32_t)(…)→-1、0xDEADBEEF 错生为有符号。
            if (ins.op == tir__TIR_OP_CONST) {
                if (c_strip_suf(ins.dst.name) == n) { return c_res_st(ins); }
                k = k + 1; continue;
            }
            if (c_strip_suf(ins.dst.name) == n and ins.st != tir__ST_NONE) { return c_res_st(ins); }
            k = k + 1;
        }
        b = b + 1;
    }
    return tir__ST_I32;
}

// ── 操作数发射（rvalue 表达式）──
pub fn c_emit_val(sb: StringBuilder, op: TirOperand) void {
    if (str_len(op.name) as i64 > 0 and op.name[0] == 64) {   // '@' 全局
        var gnm: string = c_strip_suf(op.name);   // 全局名（剥 '@' 与 .s<N> 后缀，如 @g2count.s4 → g2count）
        // ⚠ 运行库结构体全局（TClosure）：TIR 全局引用即其地址（对齐 LLVM @g 是 ptr<g>）。
        // tmir-c 把 TClosure 全局声明为 struct 值（`static TClosure g = {0};`），故引用必须取 &g_join，
        // 否则把结构体值强转指针（CALL_IND 的 `(TClosure*)(g_join)`）→ 非法、读到垃圾 → 退出码 3。
        if (c_tystr_c(tir.tir_st_to_str(c_global_st(gnm))) == "TClosure") {
            sb_append_str(sb, "&"); sb_append_str(sb, gnm);
        } else {
            sb_append_str(sb, gnm);
        }
        return;
    }
    if (str_len(op.name) as i64 > 0 and op.name[0] == 36) {   // '$' slot
        sb_append_str(sb, c_strip_suf(op.name));
        return;
    }
    // 立即数
    sb_append_str(sb, op.name);
}

// ── 主发射 ─────────────────────────────────────────────────────
// C 字符串字面量转义（双引号 / 反斜杠 / 控制字符）。
// 全局 atom 名表：索引 0 占位空串，其后按 sema.g_atom_names 顺序；t_atom_str(id)/t_deser_atom
// 经 extern 引用此表（运行库 t_runtime.c 声明 extern）。任何链接 t_runtime.lib 的程序都必须提供，
// 否则 t_atom_str/t_deser_atom 引用 t_atom_table/t_atom_count 链接失败。对齐旧轨 emit_c_atom_table。
pub fn c_emit_atom_table(sb: StringBuilder) void {
    var cnt: i64 = sema.g_atom_cnt;
    sb_append_str(sb, "TStr t_atom_table[] = { TSTR_LIT(\"\")");
    var i: i64 = 0;
    while (i < cnt) {
        sb_append_str(sb, ", TSTR_LIT(\"");
        sb_append_str(sb, c_esc_c(sema.g_atom_names[i]));
        sb_append_str(sb, "\")");
        i = i + 1;
    }
    sb_append_str(sb, " };\n");
    sb_append_str(sb, "int64_t t_atom_count = ");
    sb_append_str(sb, base.i2s(cnt + 1));
    sb_append_str(sb, ";\n\n");
}
// ── type_info(T) 反射支撑（TIR_OP_TYPEINFO=62）────────────────────
// 与 LLVM 轨 ll_ti_* 同源（kind 号表 / arm 判定 / 全局布局三者必须逐点一致）。
pub fn c_ti_kind_num(arm: string) i64 {
    if (arm == "Int") { return 0; }
    if (arm == "Float") { return 1; }
    if (arm == "Bool") { return 2; }
    if (arm == "Ptr") { return 3; }
    if (arm == "Slice") { return 4; }
    if (arm == "Array") { return 5; }
    if (arm == "Fn") { return 6; }
    if (arm == "Struct") { return 7; }
    if (arm == "Enum") { return 8; }
    if (arm == "Trait") { return 9; }
    if (arm == "Union") { return 10; }
    if (arm == "Module") { return 11; }
    return 7;
}
pub fn c_ti_arm(tname: string) string {
    if (tname == "") { return "Struct"; }
    if (sema.is_module_type_name(tname)) { return "Module"; }
    var dk: string = c_ti_decl_kind(tname);
    if (dk == "Struct") { return "Struct"; }
    if (dk == "Union") { return "Union"; }
    if (dk == "Enum") { return "Enum"; }
    if (tname == "bool") { return "Bool"; }
    if (tname == "f32" or tname == "f64") { return "Float"; }
    if (sema.is_int_name(tname)) { return "Int"; }
    return "Struct";
}
pub fn c_ti_is_ref(td: i64) bool {
    if (td < 0) { return false; }
    var t: sema.TD = sema.tds[td];
    if (t.cat == "scalar" or t.cat == "void" or t.cat == "unknown") { return false; }
    return true;
}
// 第 idx 个字段的字节偏移（与 c_struct_size 同一套对齐规则）。
pub fn c_ti_field_offset(tname: string, idx: i64) i64 {
    // 复用 c_gep_offset 的 "ty#idx" 偏移缓存（i64 查表），避免每字段 O(idx²) 重算；
    // 对反射 __ti_<T> 合成聚合（成千上万 GEP）累计放大成 O(insts×F²)，缓存后每 (类型,字段) 仅算一次。
    return c_gep_offset(base.sb_cat2("%", tname), idx);
}
pub fn c_ti_emit_typedefs(sb: StringBuilder) void {
    if (g_c_ti_typedefs) { return; }
    g_c_ti_typedefs = true;
    sb_append_str(sb, "typedef struct TypeMeta TypeMeta;\n");
    sb_append_str(sb, "typedef struct FieldInfo FieldInfo;\n");
    sb_append_str(sb, "struct FieldInfo { TStr f0; int64_t f1; TStr f2; int64_t f3; int8_t f4; int64_t f5; };\n");
    sb_append_str(sb, "struct TypeMeta { TStr f0; int64_t f1; int64_t f2; int64_t f3; TSlice f4; TSlice f5; };\n");
}
// 合成 __ti_<T>_f[]（FieldInfo 数组）与 __ti_<T>_meta（TypeMeta 全局）。
pub fn c_ti_emit_global(sb: StringBuilder, tname: string) void {
    var di: i64 = 0;
    while (di < slice_len(g_c_ti_done) as i64) { if (g_c_ti_done[di] == tname) { return; } di = di + 1; }
    append(g_c_ti_done, tname);
    c_ti_emit_typedefs(sb);
    var arm: string = c_ti_arm(tname);
    var kindn: i64 = c_ti_kind_num(arm);
    var fnames: []string;
    var ftds: []i64;
    var ftags: []i64;
    // O(1) 取声明节点（原实现逐条扫 lex.decl_list，全编译器反射类型多 → O(distinct_types × decl_list) 放大）；
    // 无对应声明节点（如内建/合成类型）则字段为空（FieldInfo[] 为空），与旧逻辑一致。
    var dn: i64 = map_get(g_c_decl_node, tname);
    if (dn > 0) {
        var ks: []i64 = base.kids_chain(base.node_lb((dn as u64)));
        var ki: i64 = 0;
        while (ki < slice_len(ks) as i64) {
            var kv: i64 = ks[ki];
            if (base.node_ia((kv as u64)) < 0) {
                append(fnames, base.node_sa((kv as u64)));
                append(ftds, sema.resolve_type_desc(base.node_na((kv as u64))));
                append(ftags, base.node_ib((kv as u64)));
            }
            ki = ki + 1;
        }
    }
    var nf: i64 = slice_len(fnames) as i64;
    if (nf > 0) {
        sb_append_str(sb, "static FieldInfo __ti_"); sb_append_str(sb, tname); sb_append_str(sb, "_f[] = { ");
        var j: i64 = 0;
        while (j < nf) {
            if (j > 0) { sb_append_str(sb, ", "); }
            var isp: i64 = 0;
            if (c_ti_is_ref(ftds[j])) { isp = 1; }
            var fst: string = tir.tir_st_of_td(ftds[j]);
            sb_append_str(sb, "{ TSTR_LIT(\""); sb_append_str(sb, c_esc_c(fnames[j])); sb_append_str(sb, "\"), ");
            sb_append_str(sb, base.i2s(c_ti_field_offset(tname, j))); sb_append_str(sb, ", TSTR_LIT(\"");
            sb_append_str(sb, c_esc_c(sema.td_readable(ftds[j]))); sb_append_str(sb, "\"), ");
            sb_append_str(sb, base.i2s(c_tstr_size(fst))); sb_append_str(sb, ", ");
            sb_append_str(sb, base.i2s(isp)); sb_append_str(sb, ", ");
            sb_append_str(sb, base.i2s(ftags[j])); sb_append_str(sb, " }");
            j = j + 1;
        }
        sb_append_str(sb, " };\n");
    }
    var tsz: i64 = 0;
    if (nf > 0) { tsz = c_struct_size(base.sb_cat2("%", tname)); }
    if (tsz <= 0) { tsz = c_tstr_size(base.sb_cat2("%", tname)); }
    if (tsz <= 0) { tsz = 8; }
    sb_append_str(sb, "static TypeMeta __ti_"); sb_append_str(sb, tname); sb_append_str(sb, "_meta = { TSTR_LIT(\"");
    sb_append_str(sb, c_esc_c(tname)); sb_append_str(sb, "\"), ");
    sb_append_str(sb, base.i2s(tsz)); sb_append_str(sb, ", ");
    sb_append_str(sb, base.i2s(kindn)); sb_append_str(sb, ", ");
    sb_append_str(sb, base.i2s(nf)); sb_append_str(sb, ", { ");
    if (nf > 0) { sb_append_str(sb, "(void*)__ti_"); sb_append_str(sb, tname); sb_append_str(sb, "_f"); }
    else { sb_append_str(sb, "(void*)0"); }
    sb_append_str(sb, ", "); sb_append_str(sb, base.i2s(nf)); sb_append_str(sb, ", ");
    sb_append_str(sb, base.i2s(nf)); sb_append_str(sb, ", (int64_t)sizeof(FieldInfo) }, { (void*)0, 0, 0, (int64_t)sizeof(FieldInfo) } };\n");
}

pub fn tmir_to_c(m: TMIRModule) string {
    g_c_mod = m;
    g_c_func_idx_built = false; c_build_func_index();   // O(1) 名→索引表：消除 c_func_find 的 O(insts×funcs) 分配放大
    g_c_type_body_built = false; c_build_type_index();   // O(1) 名→体查表：消除 c_find_type_body 的 O(insts×types) 扫描放大
    g_c_global_idx_built = false; c_build_global_index();   // O(1) 名→索引表：消除 c_global_st 的 O(insts×globals) 扫描放大
    g_c_ssz = map_new(g_c_ssz); g_c_sal = map_new(g_c_sal); g_c_off_cache = map_new(g_c_off_cache); g_c_used_buf = map_new(g_c_used_buf);   // 重置类型尺寸/对齐/偏移缓存 + 缓冲名占用集
    g_c_decl_kind_built = false; c_build_decl_kind();   // O(1) 名→种类表：消除 c_ti_decl_kind 的 O(decl_list) 全扫描放大
    c_collect_enum_names();   // 枚举名集合（供 c_tystr_c 把枚举识别为标量 i64，避免当聚合指针）
    g_c_agg_param_name = [];
    g_c_thunk_req = [];
    g_c_clo_globals = [];
    g_c_map_vsz_name = [];
    g_c_map_vsz_val = [];
    c_prescan_agg_params(m);   // 必须先跑：前向声明与函数定义要用同一套形参类型
    c_prescan_map_get_ty(m);   // map_get 出参缓冲按值尺寸定类型（须在槽声明前）
    c_prescan_thunks(m);       // 闭包 thunk 需求（thunk 定义须先于引用它的函数体）
    g_c_ti_done = []; g_c_ti_typedefs = false;
    var sb: StringBuilder = sb_new();

    // ⚠ 不引 <math.h>：math.h 会带进 POSIX 的 yn()/j0() 等符号，与示例里的同名局部变量
    //   （fid_* 的 `yn`）冲突 → "conflicting types for 'yn'"。浮点取余只需要 fmod 一个原型。
    sb_append_str(sb, "#include <stdint.h>\n#include <string.h>\n#include <stdio.h>\n#include \"t_runtime.h\"\n");
    sb_append_str(sb, "\ndouble fmod(double, double);   /* 浮点取余（a % b 的 f64/f32 形态）*/\n\n");
    // 全局 atom 名表（运行库 t_atom_str/t_deser_atom 经 extern 引用，必须提供以满足链接）。
    c_emit_atom_table(sb);
    // ⚠ type_info(T) 反射全局（__ti_<T>_meta / __ti_<T>_f）必须**先于函数体**发射：
    // C 不允许先用后定义（static 亦然），而 T 只有扫到 TIR_OP_TYPEINFO 才知道，故预扫一遍。
    {
        var tfi: i64 = 0;
        while (tfi < slice_len(m.funcs) as i64) {
            var tfb: i64 = 0;
            while (tfb < slice_len(m.funcs[tfi].blocks) as i64) {
                var tfk: i64 = 0;
                while (tfk < slice_len(m.funcs[tfi].blocks[tfb].insts) as i64) {
                    var tin: TMIRInst = m.funcs[tfi].blocks[tfb].insts[tfk];
                    if (tin.op == tir__TIR_OP_TYPEINFO and slice_len(tin.args) as i64 >= 1) {
                        c_ti_emit_global(sb, tin.args[0].name);
                    }
                    tfk = tfk + 1;
                }
                tfb = tfb + 1;
            }
            tfi = tfi + 1;
        }
    }
    // 全局
    var ng: i64 = slice_len(m.globals) as i64;
    var gi: i64 = 0;
    while (gi < ng) {
        var g: TMIRGlobal = m.globals[gi];
        var gty: string = tir.tir_st_to_str(g.td);
        if (c_is_runtime_agg(gty)) {
            // 运行库聚合（TStr/TSlice/TClosure/TBitStr）按值返回/传值：全局须声明为真实 struct 值
            // （而非字节缓冲），否则 t_slice_at(g,...) 等按值接收 TSlice 的调用实参类型错配
            // （append_reset_global_slice 编译失败）。
            sb_append_str(sb, "static "); sb_append_str(sb, c_tystr_c(gty)); sb_append_str(sb, " ");
            sb_append_str(sb, g.name); sb_append_str(sb, " = {0};\n");
        } else if (c_is_runtime_handle_ptr(gty)) {
            // TSb / TMap：运行库聚合，全局以指针句柄（TSb* / TMap*）访问（tir_to_ll 的 g_ll、各模块 g_c_pre 等）。
            // 字节缓冲模型若按「字节缓冲」发射会只给 8B（c_struct_size 对运行库句柄类型退化成 8），而 TSb 实为 32B
            // （uint8_t*+int64+int64+TArena*）、TMap 亦为堆结构；(TSb*)/(TMap*) 转型后解引用越界读垃圾 → memcpy SIGSEGV。
            // 故须声明「真实结构值 + 指针」两件套，使转型指向合法结构。与运行库签名严格一致。
            var pty: string = c_tystr_c(gty);                                   // "TSb*" / "TMap*"
            var stname: string = str_slice(pty, 0, str_len(pty) as i64 - 1);    // 剥尾随 '*' → "TSb" / "TMap"
            var buf_name: string = base.sb_cat2(g.name, "_buf");
            while (true) {
                var gidx: i64 = map_get(g_c_global_idx, buf_name);
                var uidx: i64 = map_get(g_c_used_buf, buf_name);
                if (gidx > 0 or uidx > 0) { buf_name = base.sb_cat2(buf_name, "_buf"); }
                else { break; }
            }
            map_set(g_c_used_buf, buf_name, 1);
            sb_append_str(sb, "static "); sb_append_str(sb, stname); sb_append_str(sb, " "); sb_append_str(sb, buf_name); sb_append_str(sb, " = {0};\n");
            sb_append_str(sb, "static "); sb_append_str(sb, pty); sb_append_str(sb, " "); sb_append_str(sb, g.name); sb_append_str(sb, " = &"); sb_append_str(sb, buf_name); sb_append_str(sb, ";\n");
        } else if (g.td >= tir__ST_NAMED_BASE or c_is_arr(gty)) {
            // 用户聚合 / 定长数组全局 → 字节缓冲（聚合数据落在缓冲里）。
            // ⚠ 尺寸必须用 c_struct_size：对 arr<E x N> 与命名聚合都正确；c_tstr_size 对 arr<> 退化成 8 → 缓冲过小、越界写 UB
            // （fixed_array_demo 的 g_hits/ g_buf 全局数组缓冲只有 8B，元素写入越过边界破坏堆）。
            var sz: i64 = c_struct_size(gty);
            if (sz <= 0) { sz = c_tstr_size(gty); }
            if (sz <= 0) { sz = 8; }
            // ⚠ 字节缓冲伴生名 "<name>_buf" 可能与真实全局（如 `g_xxx_buf: string`）的 mangled 名冲突 → 重定义错误。
            //   须在已登记全局名（g_c_global_idx）与已占用缓冲名（g_c_used_buf）之外另取唯一名（递归上抬 _buf 后缀）。
            var buf_name: string = base.sb_cat2(g.name, "_buf");
            while (true) {
                // ⚠ 不能直接写 map_get(...) > 0 内联比较：LLVM 后端会把 map_get 返回类型误推导为键类型 %TStr
                //   （而非 i64），导致 IR 类型冲突。须先赋给显式 i64 局部再比较。
                var gidx: i64 = map_get(g_c_global_idx, buf_name);
                var uidx: i64 = map_get(g_c_used_buf, buf_name);
                if (gidx > 0 or uidx > 0) {
                    buf_name = base.sb_cat2(buf_name, "_buf");
                } else {
                    break;
                }
            }
            map_set(g_c_used_buf, buf_name, 1);
            sb_append_str(sb, "static unsigned char "); sb_append_str(sb, buf_name); sb_append_str(sb, "[");
            sb_append_str(sb, base.i2s(sz)); sb_append_str(sb, "] = {0};\n");
            sb_append_str(sb, "static unsigned char* "); sb_append_str(sb, g.name); sb_append_str(sb, " = ");
            sb_append_str(sb, buf_name); sb_append_str(sb, ";\n");
        } else {
            sb_append_str(sb, "static "); sb_append_str(sb, tmir.tmir_st_c(g.td)); sb_append_str(sb, " ");
            sb_append_str(sb, g.name); sb_append_str(sb, " = 0;\n");
        }
        gi = gi + 1;
    }
    if (ng > 0) { sb_append_str(sb, "\n"); }
    // 前向声明：CFG 跨函数调用顺序任意，C 要求被调用函数先声明（如 main 调 __ginit）。
    {
        var nfd: i64 = slice_len(m.funcs) as i64;
        var fdi: i64 = 0;
        while (fdi < nfd) {
            var ff: TMIRFunc = m.funcs[fdi];
            if (c_is_builtin(c_strip_suf(ff.name))) { fdi = fdi + 1; continue; }   // 内建：运行库提供，不前向声明
            if (slice_len(ff.blocks) as i64 == 0) { fdi = fdi + 1; continue; }
            var fismain: bool = (ff.is_main or ff.name == "main" or ff.name == "@main");
            var ffname: string = c_fn_name(ff.name);
            if (fismain) { ffname = "t_main"; }
        var f_sret: bool = (fismain == false and c_is_sret_type(ff.ret_st));
        var fret: string = "int";
        if (fismain == false) {
            if (ff.ret_st == "void") { fret = "void"; }
            else if (ff.ret_st != "") { fret = c_tystr_c(ff.ret_st); }
        }
        if (f_sret) { fret = "void"; }
            if (fismain) { sb_append_str(sb, fret); } else { sb_append_str(sb, "static "); sb_append_str(sb, fret); }
            sb_append_str(sb, " "); sb_append_str(sb, ffname); sb_append_str(sb, "(");
            if (f_sret) { sb_append_str(sb, "unsigned char* __sret"); }
            var fp: i64 = 0;
            while (fp < slice_len(ff.params) as i64) {
                var fpv: string = ff.params[fp];
                var fcol: i64 = c_find_col(fpv, ":");
                var fpname: string = c_strip_suf(str_slice(fpv, 0, fcol));
                if (f_sret or fp > 0) { sb_append_str(sb, ", "); }
                sb_append_str(sb, c_param_c_ty(ff, fpname)); sb_append_str(sb, " "); sb_append_str(sb, fpname);
                fp = fp + 1;
            }
            sb_append_str(sb, ");\n");
            fdi = fdi + 1;
        }
        sb_append_str(sb, "\n");
        // 闭包 thunk（普通函数 → code(env, args…) 转发）：只调用已前向声明的函数，故可先于函数体发射。
        c_emit_thunks(sb);
        // 闭包值常量全局（函数引用直接当 fn 值传递时的 %TClosure 常量）。
        c_emit_clo_globals(sb);
    }
    // 函数
    var nf: i64 = slice_len(m.funcs) as i64;
    var i: i64 = 0;
    while (i < nf) {
        var f: TMIRFunc = m.funcs[i];
        if (f.is_extern) { i = i + 1; continue; }
        if (c_is_builtin(c_strip_suf(f.name))) { i = i + 1; continue; }   // 内建：运行库提供，不发射体
        if (slice_len(f.blocks) as i64 == 0) { i = i + 1; continue; }
        c_emit_func(sb, f);
        i = i + 1;
    }
    // 入口包装器：C 的 main 注入运行库初始化（arena），再调用用户 t_main，最后释放 arena。
    // 对齐 LLVM 后端 @main 包装器（t_runtime_init / t_arena_new / t_runtime_set_arena / t_runtime_done）。
    // 缺此则 int_to_str/str_concat 等分配运行期崩溃（arena 为 null）。
    {
        var nfe: i64 = slice_len(m.funcs) as i64;
        var fei: i64 = 0;
        var has_main: bool = false;
        while (fei < nfe) {
            var fn2: string = m.funcs[fei].name;
            if (m.funcs[fei].is_main or fn2 == "main" or fn2 == "@main") { has_main = true; }
            fei = fei + 1;
        }
        if (has_main) {
            sb_append_str(sb, "\nint main(int argc, char** argv) {\n");
            sb_append_str(sb, "    t_runtime_init(argc, argv);\n");
            sb_append_str(sb, "    TArena* __a = t_arena_new();\n");
            sb_append_str(sb, "    t_runtime_set_arena(__a);\n");
            sb_append_str(sb, "    int __rc = t_main();\n");
            sb_append_str(sb, "    t_runtime_done();\n");
            sb_append_str(sb, "    return __rc;\n");
            sb_append_str(sb, "}\n");
        }
    }
    return sb_to_str(sb);
}

pub fn c_strlist_has(l: []string, s: string) bool {
    var i: i64 = 0;
    while (i < slice_len(l) as i64) { if (l[i] == s) { return true; } i = i + 1; }
    return false;
}
// map_get 结果槽的「值类型」断言（cli_demo 根因）：
//   TIR 把 map_get 的 dst 一律标成 i64（它只是「值字节缓冲」），字符串值（16B TStr）会被
//   当成 8B 标量：memset 只清 8B、后续 bitcast 成 %TStr 时发成非法的 `(TStr)(int64_t)`。
//   句柄值尺寸（c_map_handle_valsz）只能解析**本函数内** t_map_new 的末参；map 作为形参传入
//   （cli.get_flag_str/get_flag_int 的 `flags`）时解析不到 → 回退 8，故须按「用法」反推：
//     ① dst 被 bitcast 成结构体值类型（%TStr）→ 值必为字符串；
//     ② dst 被传给形参 C 类型为 TStr 的函数（parse_i64(t150)）→ 值必为字符串。
//   命中 → c_slot_ty_mark(槽, "%TStr")：声明变 TStr（16B），map_get 写 16B、bitcast 退化成同类型赋值。
pub fn c_prescan_mapget_tstr(f: TMIRFunc) void {
    var mapget: []string = [];
    var bi: i64 = 0;
    while (bi < slice_len(f.blocks) as i64) {
        var ki: i64 = 0;
        while (ki < slice_len(f.blocks[bi].insts) as i64) {
            var ins: TMIRInst = f.blocks[bi].insts[ki];
            if (ins.op == tir__TIR_OP_CALL and slice_len(ins.args) as i64 >= 1) {
                if (c_cbase(c_strip_suf(ins.args[0].name)) == "map_get") {
                    var dn: string = c_strip_suf(ins.dst.name);
                    if (dn != "") { append(mapget, dn); }
                }
            }
            ki = ki + 1;
        }
        bi = bi + 1;
    }
    if (slice_len(mapget) as i64 == 0) { return; }
    bi = 0;
    while (bi < slice_len(f.blocks) as i64) {
        var ki: i64 = 0;
        while (ki < slice_len(f.blocks[bi].insts) as i64) {
            var ins: TMIRInst = f.blocks[bi].insts[ki];
            if (ins.op == tir__TIR_OP_BITCAST and slice_len(ins.args) as i64 >= 1) {
                var sn: string = c_strip_suf(ins.args[0].name);
                if (c_strlist_has(mapget, sn)) {
                    var tty: string = tir.tir_st_to_str(ins.st);
                    if (c_c_ty_is_struct(c_tystr_c(tty))) { c_slot_ty_mark(sn, tty); }
                }
            }
            if (ins.op == tir__TIR_OP_CALL and slice_len(ins.args) as i64 >= 1) {
                var cb2: string = c_cbase(c_strip_suf(ins.args[0].name));
                var na2: i64 = slice_len(ins.args) as i64;
                var ai: i64 = 1;
                while (ai < na2) {
                    var an: string = c_strip_suf(ins.args[ai].name);
                    if (c_strlist_has(mapget, an)) {
                        var pt: string = c_callee_param_ty(cb2, ai - 1);
                        if (pt == "TStr") { c_slot_ty_mark(an, "%TStr"); }
                    }
                    ai = ai + 1;
                }
            }
            ki = ki + 1;
        }
        bi = bi + 1;
    }
}

pub fn c_emit_func(sb: StringBuilder, f: TMIRFunc) void {
    g_cf = f;
    g_c_addr_slot_name = []; g_c_addr_name = []; g_c_addr_st = []; g_c_addr_base_name = []; g_c_addr_base_ty = [];
    g_c_agg_base_name = []; g_c_agg_base_size = []; g_c_tmpc = 0; g_c_pre = sb_new();
    g_c_ptrbuf_name = []; g_c_ptrbuf_size = []; g_c_sliceat_slot = [];
    g_c_slot_tyname = []; g_c_slot_tyty = []; g_c_mapval_slot = []; g_c_alias_name = []; g_c_alias_to = [];
    // ⚠ 专用别名预收集 Pass：先于 pre-scan 主循环，把所有 BITCAST/STORE 的「槽别名」(dst→src)
    // 一次性登记到 g_c_alias_*，使下游 map_val_ptr/map_get 的 c_map_handle_valsz 查询不依赖指令出现顺序
    // （否则 map_val_ptr(t8,t43,…) 若排在 t43=(void*)(mi) 之前，别名未登记 → 值尺寸回退 8 → TStr 值被截断）。
    {
        var abi: i64 = 0;
        while (abi < slice_len(f.blocks) as i64) {
            var ani: i64 = slice_len(f.blocks[abi].insts) as i64;
            var ak: i64 = 0;
            while (ak < ani) {
                var ains: TMIRInst = f.blocks[abi].insts[ak];
                if (ains.op == tir__TIR_OP_BITCAST) {
                    if (slice_len(ains.args) as i64 >= 1 and str_len(ains.args[0].name) as i64 > 0
                        and ains.args[0].name[0] == 36) {
                        var adn: string = c_strip_suf(ains.dst.name);
                        var asn: string = c_strip_suf(ains.args[0].name);
                        append(g_c_alias_name, adn); append(g_c_alias_to, asn);
                    }
                }
                if (ains.op == tir__TIR_OP_STORE) {
                    if (slice_len(ains.args) as i64 >= 1 and str_len(ains.args[0].name) as i64 > 0
                        and ains.args[0].name[0] == 36) {
                        var adn: string = c_strip_suf(ains.dst.name);
                        var asn: string = c_strip_suf(ains.args[0].name);
                        append(g_c_alias_name, adn); append(g_c_alias_to, asn);
                    }
                }
                if (ains.op == tir__TIR_OP_LOAD) {
                    if (slice_len(ains.args) as i64 >= 1 and str_len(ains.args[0].name) as i64 > 0
                        and ains.args[0].name[0] == 36) {
                        var adn: string = c_strip_suf(ains.dst.name);
                        var asn: string = c_strip_suf(ains.args[0].name);
                        append(g_c_alias_name, adn); append(g_c_alias_to, asn);
                    }
                }
                ak = ak + 1;
            }
            abi = abi + 1;
        }
    }
    // 预扫描：地址槽（gep/addr_of/gep_idx 的 dst）+ 聚合基槽（addr_of 的 args[0]）
    //   + slot 类型名表（GEP/ADDR_OF/BITCAST/STRUCT_NEW/CALL/CONST_STR/ADD 结果类型）。
    {
        // ⚠ 向量形参（vec<ELEM x N>）：即使函数体内未取址（如仅作逐元素二元源），也须声明为
        // unsigned char* 缓冲指针而非 int64_t（否则 scale4 的 v/k 被生成为 int64_t、向量读取越界）。
        // 标为聚合形参后 c_param_c_ty 返 unsigned char*，且入口处按值语义拷入本帧私有缓冲。
        var _npp: i64 = slice_len(f.params) as i64;
        var _pp: i64 = 0;
        while (_pp < _npp) {
            var _pv: string = f.params[_pp];
            var _col: i64 = c_find_col(_pv, ":");
            if (_col >= 0) {
                var _pn: string = c_strip_suf(str_slice(_pv, 0, _col));
                var _ptn: string = c_strip_ws(str_slice(_pv, _col + 1, str_len(_pv) as i64));
                if (c_is_vec(c_strip_ptr(_ptn)) and c_is_agg_param(f.name, _pn) == false) {
                    c_agg_param_mark(f.name, _pn);
                }
            }
            _pp = _pp + 1;
        }
        var pbi: i64 = 0;
        while (pbi < slice_len(f.blocks) as i64) {
            var pni: i64 = slice_len(f.blocks[pbi].insts) as i64;
            var pk: i64 = 0;
            while (pk < pni) {
                var pins: TMIRInst = f.blocks[pbi].insts[pk];
                // tll_deser_str：void + 出参指针末位（LLVM sret 约定），dst 即 TStr 出槽且**没有**
                // 对应 slot 声明 → 类型默认为 void → 声明被跳过 → "use of undeclared identifier"
                // （fid_read_demo）。此处补登记为 %TStr，使其按 16B TStr 声明。
                if (pins.op == tir__TIR_OP_CALL and slice_len(pins.args) as i64 >= 1) {
                    if (c_cbase(c_strip_suf(pins.args[0].name)) == "deser_str" and str_len(pins.dst.name) as i64 > 0) {
                        c_slot_ty_mark(c_strip_suf(pins.dst.name), "%TStr");
                    }
                    // 瓦片/数组结果的内建（如 @tsplat）：字节缓冲模型下结果须拥有缓冲，否则按标量 int64_t
                    // 声明 → 字节写越界踩踏 arena 元数据 → 挂死（tile_demo 的 tsplat 临时槽 t0）。
                    // 仅对「内建」生效（用户函数聚合返回走 sret，dst 是出参指针、不在此列）。
                    if (c_is_builtin(c_strip_suf(pins.args[0].name))) {
                        var cst: string = tir.tir_st_to_str(pins.st);
                        var cst_core: string = c_strip_ptr(cst);
                        var cdn: string = c_strip_suf(pins.dst.name);
                        // 瓦片/数组/向量结果内建（@tsplat/@splat…）：字节缓冲模型下结果须拥有缓冲，
                        // 否则按标量 int64_t 声明 → 字节写越界踩踏 arena 元数据 → 挂死。
                        if ((c_is_arr(cst_core) or c_is_vec(cst_core)) and c_is_agg_base(cdn) == false
                            and c_is_addr_slot(cdn) == false and c_is_param(g_cf, cdn) == false) {
                            c_slot_ty_mark(cdn, cst);
                            append(g_c_agg_base_name, cdn);
                            var asz: i64 = c_agg_size_of_tyname(cst_core);
                            if (asz <= 0) { asz = 8; }
                            append(g_c_agg_base_size, asz);
                        }
                        // 向量内建结果类型补正（TIR 的 call 目的 st 对 @reduce_*/@vlen 常记为标量/空，
                        // 但 C 声明须用真实返回类型，否则结果槽被退化成 int64 → 浮点归约被截断/类型错配）：
                        //   @vlen(v)         → i64（lane 数）
                        //   @reduce_*(v)      → 向量元素类型（i32/f64 …）
                        //   @splat(s,N)       → 向量类型（vec<elem x N>，上面已登记缓冲，此处只补类型名）
                        var _cbn: string = c_cbase(c_strip_suf(pins.args[0].name));
                        if (_cbn == "vlen" and c_is_agg_base(cdn) == false and c_is_param(g_cf, cdn) == false) {
                            c_slot_ty_mark(cdn, "i64");
                        } else if ((_cbn == "reduce_add" or _cbn == "reduce_mul" or _cbn == "reduce_max" or _cbn == "reduce_min") and slice_len(pins.args) as i64 >= 2) {
                            var _vst: string = c_vec_type_from_operand(pins.args[1]);
                            if (c_is_vec(_vst)) { c_slot_ty_mark(cdn, c_vec_elem(_vst)); }
                        }
                    }
                }
                // SLOT 声明：记录 slot 的声明类型名（如 "ptr<%Event>"/"i64"/"%TStr"），
                // 这是类型名的权威来源（TIR 文本携带，TMIR 仅留数值 st）。
                if (pins.op == tir__TIR_OP_SLOT) {
                    var sn: string = c_strip_suf(pins.dst.name);
                    c_slot_ty_mark(sn, tir.tir_st_to_str(pins.st));
                    // 注：ptr<...> 槽**不**在此登记为地址槽 —— 它存的是「指针值」本身
                    // （如 `var ti: TypeInfo` 的 slot 是 ptr<%TypeInfo>），若标地址槽会让
                    // store/load 都按「解引用」处理，把指针值当数据地址读写 → 语义错乱。
                    // 真正需要「按指针解引用」的判定在 LOAD 处理器里按载入结果类型区分。
                    // 定长数组槽（arr<E x N>）：即使未被 addr_of 取址（如直接传给 slice_from_raw /
                    // 作 slice_sub 源），其数据也必须落在字节缓冲里，否则按标量 int64_t 声明 →
                    // slice_from_raw(arr,...) 实参 int64_t↔void* 错配（array_range / array_to_slice 编译失败）。
                    // 仅此处登记覆盖「无 addr_of 的数组槽」；有 addr_of 者已在 ADDR_OF 路径登记（c_is_agg_base 防重）。
                    var stn: string = tir.tir_st_to_str(pins.st);
                    // ⚠ 瓦片（arr<arr<elem x cols> x rows>）与数组槽：即使带 ptr<> 包装（tmir 常以
                    // ptr<arr<arr<...>>> 形态流转）也必须落在字节缓冲，否则按标量 int64_t 声明 →
                    // 字节写越界/缓冲过小、运行期踩踏 arena 元数据 → 挂死（tile_demo 的 tsplat 临时槽 t0）。
                    var stn_core: string = c_strip_ptr(stn);
                    if (c_is_arr(stn_core) and c_is_agg_base(sn) == false) {
                        append(g_c_agg_base_name, sn);
                        var asz: i64 = c_agg_size_of_tyname(stn_core);
                        if (asz <= 0) { asz = 8; }
                        append(g_c_agg_base_size, asz);
                    }
                    // ⚠ 向量槽（vec<ELEM x N>）：与瓦片/数组同属「字节缓冲聚合」，即使未被 addr_of 取址
                    // （如直接作逐元素二元/归约源）也必须落在字节缓冲，否则按标量 int64_t 声明 →
                    // 向量逐元素写入越界踩踏（vector_demo 的 var a/b/c/... 全部向量局部）。
                    // 带 ptr<> 包装（vec 常以 ptr<vec<...>> 形态流转）时剥 ptr<> 再判。
                    if (c_is_vec(stn_core) and c_is_agg_base(sn) == false) {
                        append(g_c_agg_base_name, sn);
                        var asz: i64 = c_agg_size_of_tyname(stn_core);
                        if (asz <= 0) { asz = 8; }
                        append(g_c_agg_base_size, asz);
                    }
                    // ⚠ 任意位宽整数（AWI，N>64）：与向量/数组同属「字节缓冲聚合」，即使未被 addr_of 取址
                    // （如直接作 format 实参 / 逐元素二元源）也必须落在字节缓冲，否则按标量 int64_t 声明 →
                    // 字面量 (int64_t)(0xFFFF…) 溢出、值透传给 t_sb_append_fmt_big 类型错配
                    // （awi_demo 的 var a/b/c/d/e/h 全部 AWI 局部）。N≤64 保持标量，不落此分支。
                    c_awi_ensure_base(sn, stn_core);
                    // ⚠ 用户结构体值槽（%Struct，非数组 / 非标量 / 非运行库 struct TStr/TSlice/…）：
                    // 源码 `var l: Self;` 这类聚合局部在字节缓冲模型下是 unsigned char* 槽，
                    // 若初始化为 (unsigned char*)0，后续 ret/store 会 memcpy 自 NULL → 段错误
                    // （list_demo 的 list_new「var l: Self; return l;」即此；vector/concat/colony 同源）。
                    // 与「聚合基」区分：此处只补零初始化后备缓冲，不改变 STORE 语义（仍走指针别名）。
                    if (c_starts(stn, "%") and c_is_arr(stn) == false and c_is_scalar_tstr(stn) == false
                        and c_is_agg_base(sn) == false and c_is_param(f, sn) == false
                        and c_c_ty_is_struct(c_tystr_c(stn)) == false) {
                        var pbsz: i64 = c_agg_size_of_tyname(stn);
                        if (pbsz <= 0) { pbsz = c_tstr_size(stn); }
                        if (pbsz > 0) { c_ptrbuf_mark(sn, pbsz); }
                    }
                }
                if (pins.op == tir__TIR_OP_SLICE_AT) {
                    // slice_at 结果 = 元素地址（纯指针，无自有缓冲）→ 标地址槽。
                    // 否则后续 addr_of 会把它误登记成「聚合基」并取 <slot>_buf（空缓冲）→ 读到全 0
                    // （typeinfo_proj 的 `m.fields[i].name` 读空串）。
                    var sadn: string = c_strip_suf(pins.dst.name);
                    if (c_is_addr_slot(sadn) == false) { append(g_c_addr_slot_name, sadn); }
                    append(g_c_sliceat_slot, sadn);
                }
                if (pins.op == tir__TIR_OP_GEP or pins.op == tir__TIR_OP_ADDR_OF or pins.op == tir__TIR_OP_GEP_IDX) {
                    var dn: string = c_strip_suf(pins.dst.name);
                    if (c_is_addr_slot(dn) == false) { append(g_c_addr_slot_name, dn); }
                    c_slot_ty_mark(dn, tir.tir_st_to_str(pins.st));
                    // 形参被当作聚合基（取址 / 字节偏移）→ 必须声明为字节指针而非其名义标量类型，
                    // 否则「签名 int64_t a0」与「函数体 &a0 + 偏移」两条路径类型打架。
                    if (slice_len(pins.args) as i64 > 0) {
                        var gb: string = c_strip_suf(pins.args[0].name);
                        if (c_is_param(f, gb) and c_param_is_rtstruct(f, gb) == false) { c_agg_param_mark(f.name, gb); }
                    }
                }
                if (pins.op == tir__TIR_OP_BITCAST) {
                    // ⚠ ptrtoint（指针→i32/i64）位转换：TIR 里 GEP 字节算术的基址常经 bitcast 落到整型槽，
                    // 但字节缓冲 C 模型下指针即 unsigned char*，必须保留指针语义（dst 标地址槽→unsigned char*），
                    // 否则 (int32_t)(void*) 截断指针、gep_idx 偏移放大 → 段错误 / 数据错位
                    // （pipeline_demo 的 slice 元素访问、list/vector/concat 等全部 slice/array 用例）。
                    // 仅当源是「指针类型」且 dst 尚非地址槽时标记。
                    if (slice_len(pins.args) as i64 >= 1) {
                        var bsrc: string = c_operand_c_ty(pins.args[0]);
                        var bdst: string = c_strip_suf(pins.dst.name);
                        if (c_c_ty_is_ptr(bsrc) and c_is_addr_slot(bdst) == false) {
                            append(g_c_addr_slot_name, bdst);
                        }
                    }
                }
                if (pins.op == tir__TIR_OP_ADDR_OF) {
                    var dn2: string = c_strip_suf(pins.dst.name);
                    c_slot_ty_mark(dn2, base.sb_cat3("ptr<", tir.tir_st_to_str(pins.st), ">"));
                    if (str_len(pins.args[0].name) as i64 > 0 and pins.args[0].name[0] == 36) {
                        var bn: string = c_strip_suf(pins.args[0].name);
                        var ast: string = tir.tir_st_to_str(pins.st);
                        // 标量不注册字节缓冲（改用 &slot 取址），仅聚合/数组才拥有缓冲。
                        // ⚠ 运行库结构体（TStr/TSlice/TClosure/TBitStr）即使被取址也按值传递，
                        // 不当字节缓冲——否则 TStr/TSlice 实参被生成为 unsigned char* 与主调结构值冲突。
                        if (c_is_agg_base(bn) == false and c_is_scalar_tstr(ast) == false
                            and c_is_addr_slot(bn) == false   // 已是地址槽（slice_at/GEP/bitcast 结果）→ 无自有缓冲，取址即用其指针值
                            and c_c_ty_is_struct(c_tystr_c(ast)) == false) {
                            append(g_c_agg_base_name, bn);
                            // ⚠ 尺寸必须用 c_agg_size_of_tyname：对数组基 ptr<[N x E]> 得 N*esz（24），
                            // 否则 c_tstr_size 退化为指针宽 8 → 缓冲过小、越界写 UB（slice/array literal）。
                            var asz: i64 = c_agg_size_of_tyname(ast);
                            if (asz <= 0) { asz = c_tstr_size(ast); }
                            append(g_c_agg_base_size, asz);
                        }
                    }
                }
                if (pins.op == tir__TIR_OP_BITCAST) {
                    var dn3: string = c_strip_suf(pins.dst.name);
                    c_slot_ty_mark(dn3, tir.tir_st_to_str(pins.st));
                    // bitcast 结果若是地址（源是地址 / 或结果类型本身是 ptr）→ 标地址槽（unsigned char*）。
                    var mark_addr: bool = false;
                    if (pins.st == tir__ST_PTR or pins.st == tir__ST_PTR_VOID) { mark_addr = true; }
                    if (str_len(pins.args[0].name) as i64 > 0 and pins.args[0].name[0] == 36) {
                        var sn: string = c_strip_suf(pins.args[0].name);
                        if (c_is_address(sn)) { mark_addr = true; }
                    }
                    if (mark_addr and c_is_addr_slot(dn3) == false) { append(g_c_addr_slot_name, dn3); }
                }
                if (pins.op == tir__TIR_OP_STORE) {
                    // STORE 槽别名登记已移至函数开头的专用别名预收集 Pass（先于本主循环，免指令顺序依赖）。
                }
                if (pins.op == tir__TIR_OP_STRUCT_NEW) {
                    var dn4: string = c_strip_suf(pins.dst.name);
                    c_slot_ty_mark(dn4, base.sb_cat3("ptr<", tir.tir_st_to_str(pins.st), ">"));
                    // struct_new 结果 = 缓冲拥有者指针，按地址槽声明（unsigned char*），
                    // 缓冲本体由 STRUCT_NEW handler 内联声明，二者不重复声明。
                    if (c_is_addr_slot(dn4) == false) { append(g_c_addr_slot_name, dn4); }
                }
                if (pins.op == tir__TIR_OP_CONST_STR) {
                    var dn5: string = c_strip_suf(pins.dst.name);
                    c_slot_ty_mark(dn5, "%TStr");
                }
                // 注：LOAD 的 dst 语义不在此登记地址槽 —— 「结果是指针」(load ptr $t7 $t6)
                // 与「结果是结构体值」(load %FieldInfo $t36 $t35) 在字节缓冲模型下 C 声明同
                // 为 unsigned char*，但前者须按 8B 解引用、后者须直接别名，只能按 ins.st 区分
                // （见 LOAD 处理器内的 dcn 分支）。
                if (pins.op == tir__TIR_OP_CONCAT) {
                    // `++` 合并（§15.6）：定长数组 / map 的结果是「字节指针」（t_array_concat /
                    // t_map_concat 返回 arena 新缓冲地址），dst 须按地址槽声明为 unsigned char*，
                    // 否则被声明成 int64_t 与 (unsigned char*) 赋值冲突（concat_demo 编译失败）。
                    var cst6: string = tir.tir_st_to_str(pins.st);
                    if (c_is_arr(cst6) or cst6 == "ptr<void>" or cst6 == "ptr") {
                        var dn7: string = c_strip_suf(pins.dst.name);
                        if (c_is_addr_slot(dn7) == false) { append(g_c_addr_slot_name, dn7); }
                        c_slot_ty_mark(dn7, cst6);
                    }
                }
                if (pins.op == tir__TIR_OP_CALL) {
                    var dn6: string = c_strip_suf(pins.dst.name);
                    if (dn6 != "") {
                        // map_get(dst, handle, key)：dst 出参缓冲类型 = 映射值类型（16B→%TStr / 8B→i64 …），
                        // 必须按值尺寸定（而非 map_get 自身退化的返回 ST，它会退化成标量 i64），否则
                        // int64_t→TStr 非法强转（maps.tc 的 strval 用例）。
                        // ⚠ 此标记须在每函数预扫描内（c_emit_func）完成：tmir_to_c 层 c_prescan_map_get_ty
                        // 的同款标记会被 g_c_slot_tyname 的每函数重置（行 1322）抹除，故不能只靠模块级预扫描。
                        var cb6: string = c_cbase(c_strip_suf(pins.args[0].name));
                        if (cb6 == "map_get" and slice_len(pins.args) as i64 >= 2) {
                            var hn6: string = c_strip_suf(pins.args[1].name);
                            var vsz6: i64 = c_map_handle_valsz(hn6);
                            c_slot_ty_mark(dn6, c_map_val_st(vsz6));
                        } else if (cb6 == "map_val_ptr" and slice_len(pins.args) as i64 >= 2) {
                            // map_val_ptr 返回「值字节指针」，dst 实为该值（解引用后）；
                            // 须把 dst 槽类型标为值类型（而非退化的 ptr<void>），否则声明成
                            // unsigned char* 与解引用赋值 (*(long long*)...) 类型打架。
                            var hn6b: string = c_strip_suf(pins.args[1].name);
                            var vsz6b: i64 = c_map_handle_valsz(hn6b);
                            c_slot_ty_mark(dn6, c_map_val_st(vsz6b));
                            append(g_c_mapval_slot, dn6);   // 记录：其后续 LOAD 解引用须按值类型（TStr/i64…）宽度
                        } else if (cb6 == "map_val_at" and slice_len(pins.args) as i64 >= 2) {
                            // map_val_at(m, i) 返回「值字节指针」（与 map_val_ptr 同语义，按索引取而非按键取），
                            // 须把 dst 槽类型标为值类型并解引用，否则把指针地址当值 → 整数乱码
                            // （map_assign 的 for 循环 total 算错、map_iter 迭代值乱码）。
                            var hn6c: string = c_strip_suf(pins.args[1].name);
                            var vsz6c: i64 = c_map_handle_valsz(hn6c);
                            c_slot_ty_mark(dn6, c_map_val_st(vsz6c));
                            append(g_c_mapval_slot, dn6);
                        } else if (cb6 == "some") {
                            // 可选类型 ?T 在 C 后端按「可空指针」(unsigned char*) 表示（对齐 LLVM 后端 some→arena 拷贝返回指针）。
                            // some(x) 的 dst 须声明为地址槽(unsigned char*)，否则其名义槽类型（值类型 i64…）与
                            // 发射的 (unsigned char*)(t_opt_some(...)) 赋值冲突 → incompatible pointer→int 转换。
                            // 标地址槽后 c_slot_c_ty 直接返 unsigned char*，且 c_add_scalar 跳过它避免重复声明。
                            if (c_is_addr_slot(dn6) == false) { append(g_c_addr_slot_name, dn6); }
                        } else if (c_is_math_builtin(c_strip_suf(pins.args[0].name))) {
                            // 数学内建（@sqrt/@sin/... → 运行库 t_math_sqrt 等）：运行库按 double/float 返回，
                            // 但 TIR call 目的 st 常被错记为标量 i64/i32，导致结果槽被声明成 int64 → double 被截断
                            // （math_stdlib_demo/math_extra_demo 算错：sqrt/sin/… 结果全 0 或整数）。
                            // 此处按内建名（f 后缀→float，否则 double）把结果槽标为 f64/f32（c_tystr_c 映射 double/float）。
                            var mbn: string = c_strip_suf(pins.args[0].name);
                            if (c_ends(mbn, "f")) { c_slot_ty_mark(dn6, "f32"); }
                            else { c_slot_ty_mark(dn6, "f64"); }
                        } else {
                            // sret 调用（用户聚合返回）：dst 实为聚合出参缓冲，须声明为真实缓冲（非 NULL 指针），
                            // 否则被调函数写入空指针 → 段错误。尺寸取被调函数返回类型（聚合）的字节尺寸。
                            var fret6: string = c_func_ret_st(c_strip_suf(pins.args[0].name));
                            if (c_is_sret_type(fret6)) {
                                var sz6: i64 = c_struct_size(fret6);
                                if (sz6 <= 0) { sz6 = c_agg_size_of_tyname(c_slot_ty_find(dn6)); }
                                if (sz6 <= 0) { sz6 = 8; }
                                if (c_is_agg_base(dn6) == false) { append(g_c_agg_base_name, dn6); append(g_c_agg_base_size, sz6); }
                            } else if (pins.st != tir__ST_NONE and tir.tir_st_to_str(pins.st) != "void") {
                                // 普通有返回值调用：dst 类型已由 struct_new/参数确定，禁止用 "void" 覆盖。
                                // ⚠ 运行库部分内建（slice_sub/slice_new）TIR 的 call 目的 st 被错记为标量（i64），
                                // 但 C 运行库按值返回真实聚合（TSlice）；用 c_builtin_agg_ret 取真实返回类型补正
                                // （否则 int64_t←TSlice 编译失败 / 类型错配，array_range 等）。
                                var ret6: string = c_builtin_agg_ret(cb6);
                                if (ret6 == "") { ret6 = tir.tir_st_to_str(pins.st); }
                                c_slot_ty_mark(dn6, ret6);
                            }
                        }
                    }
                }
                // 瓦片逐元素二元（a + b / a - b / a * b）的结果槽：字节缓冲模型下须拥有缓冲，
                // 否则按标量 int64_t 声明 → `_dp=(T*)dst` 写 total 元素越界踩踏 arena/栈元数据 →
                // 运行期死循环挂死（tile_demo 的 `c = a + b`：结果临时槽 t28 写 24B 但只声明 8B）。
                // 真实瓦片类型可能落在 ins.st 或 args[0].st（实测 tile `a+b` 的 ins.st 常为 ptr/空串）。
                if (pins.op == tir__TIR_OP_ADD or pins.op == tir__TIR_OP_SUB or pins.op == tir__TIR_OP_MUL) {
                    var bst: string = tir.tir_st_to_str(pins.st);
                    if (c_is_tile_st(bst) == false and c_is_vec_st(bst) == false) { bst = tir.tir_st_to_str(pins.args[0].st); }
                    if (c_is_tile_st(bst)) {
                        var bn: string = c_strip_suf(pins.dst.name);
                        var bcore: string = c_strip_ptr(bst);
                        if (c_is_agg_base(bn) == false and c_is_addr_slot(bn) == false and c_is_param(g_cf, bn) == false) {
                            append(g_c_agg_base_name, bn);
                            var asz: i64 = c_agg_size_of_tyname(bcore);
                            if (asz <= 0) { asz = 8; }
                            append(g_c_agg_base_size, asz);
                        }
                    } else if (c_is_vec_st(bst)) {
                        // 向量逐元素二元（a + b / a - b / a * b）结果槽：字节缓冲模型下须拥有缓冲，
                        // 否则按标量 int64_t 声明 → 向量写入越界踩踏（vector_demo 的 c = a + [...]/e = a * g_scale）。
                        var bn: string = c_strip_suf(pins.dst.name);
                        var bcore: string = c_strip_ptr(bst);
                        if (c_is_agg_base(bn) == false and c_is_addr_slot(bn) == false and c_is_param(g_cf, bn) == false) {
                            append(g_c_agg_base_name, bn);
                            var asz: i64 = c_agg_size_of_tyname(bcore);
                            if (asz <= 0) { asz = 8; }
                            append(g_c_agg_base_size, asz);
                        }
                    }
                }
                // ⚠ 任意位宽整数（AWI，N>64）二元加/减结果槽：与瓦片/向量同属字节缓冲聚合，
                // 须拥有缓冲（否则按标量 int64_t 声明 → memcpy 自 NULL / 缓冲过小踩踏）。
                // 仅 ADD/SUB 走 AWI 分支（MUL 等暂不覆盖，按需扩展）。
                if (pins.op == tir__TIR_OP_ADD or pins.op == tir__TIR_OP_SUB) {
                    var bn: string = c_strip_suf(pins.dst.name);
                    var bst: string = tir.tir_st_to_str(pins.st);
                    if (c_is_awi_st(bst) == false) { bst = tir.tir_st_to_str(pins.args[0].st); }
                    c_awi_ensure_base(bn, bst);
                }
                // ⚠ 任意位宽整数（AWI，N>64）字面量目的槽：CONST 指令不产生 SLOT，故须在此单独登记
                // 字节缓冲聚合基，否则 t0/t3… 等中间槽被声明成 (unsigned char*)0 → memcpy 自 NULL 段错误。
                // 判定须含「槽使用端类型」c_slot_st(cn)：窄立即数（如 `a+1` 的 `1`）定义端是 i64、使用端是 i128，
                // 仅看定义端会漏判 → 漏登记 → 缓冲缺失（awi_demo 的 t24）。
                if (pins.op == tir__TIR_OP_CONST) {
                    var cn: string = c_strip_suf(pins.dst.name);
                    var cst: string = tir.tir_st_to_str(pins.st);
                    if (c_is_awi_st(cst) == false) { cst = c_slot_ty_find(cn); }
                    if (c_is_awi_st(cst) == false) { cst = tir.tir_st_to_str(c_slot_st(cn, g_cf)); }
                    c_awi_ensure_base(cn, cst);
                }
                if (pins.op == tir__TIR_OP_SLICE_AT or pins.op == tir__TIR_OP_CONST_PTR_NULL) {
                    var dn8: string = c_strip_suf(pins.dst.name);
                    if (c_is_addr_slot(dn8) == false) { append(g_c_addr_slot_name, dn8); }
                    c_slot_ty_mark(dn8, "ptr<void>");
                }
                if (pins.op == tir__TIR_OP_ADD and c_is_tstr_st(pins.st)) {
                    var dn7: string = c_strip_suf(pins.dst.name);
                    c_slot_ty_mark(dn7, "%TStr");
                }
                if (pins.op == tir__TIR_OP_LOAD) {
                    // map_val_ptr 结果被直接解引用（载入映射值）：把 LOAD 目的槽类型定为映射值类型
                    // （16B→%TStr / 8B→i64 …），否则目的被退化成 i64 → TStr 值按 8B 截断读 → 字符串乱码。
                    var lsrc: string = c_strip_suf(pins.args[0].name);
                    if (c_is_mapval_slot(lsrc)) {
                        var vty: string = c_slot_ty_find(lsrc);
                        if (vty != "") { c_slot_ty_mark(c_strip_suf(pins.dst.name), vty); }
                    }
                }
                pk = pk + 1;
            }
            pbi = pbi + 1;
        }
    }
    // map_get 结果槽的「字符串值」断言：必须排在 SLOT 类型登记之后（c_slot_ty_mark 会覆写
    // 同名槽的既有登记），否则被 SLOT 的 i64 声明类型盖掉 → 又退回 8B 标量（cli_demo）。
    c_prescan_mapget_tstr(f);
    var ismain: bool = (f.is_main or f.name == "main" or f.name == "@main");
    var fname: string = c_fn_name(f.name);
    if (ismain) { fname = "t_main"; }
    var retctype: string = "int";
    g_c_sret = false; g_c_sret_size = 0;
    if (ismain == false) {
        if (f.ret_st == "void") { retctype = "void"; }
        else if (f.ret_st != "") { retctype = c_tystr_c(f.ret_st); }
    }
    // sret：用户聚合返回 → void 返回 + 显式 __sret 出参指针（首形参），与 LLVM 后端逐字对齐。
    if (ismain == false and c_is_sret_type(f.ret_st)) {
        g_c_sret = true;
        g_c_sret_size = c_struct_size(f.ret_st);
        retctype = "void";
    }
    if (ismain) { sb_append_str(sb, retctype); } else { sb_append_str(sb, "static "); sb_append_str(sb, retctype); }
    sb_append_str(sb, " "); sb_append_str(sb, fname); sb_append_str(sb, "(");
    // sret 首形参：出参指针（聚合返回值写入此处）
    if (g_c_sret) { sb_append_str(sb, "unsigned char* __sret"); }
    // 参数
    var np: i64 = slice_len(f.params) as i64;
    var p: i64 = 0;
    while (p < np) {
        var pv: string = f.params[p];
        var col: i64 = c_find_col(pv, ":");
        var pname: string = c_strip_suf(str_slice(pv, 0, col));
        if (g_c_sret or p > 0) { sb_append_str(sb, ", "); }
        sb_append_str(sb, c_param_c_ty(f, pname)); sb_append_str(sb, " "); sb_append_str(sb, pname);
        p = p + 1;
    }
    sb_append_str(sb, ") {\n");
    // 结构体值槽的后备缓冲（见 g_c_ptrbuf_* 注释）：零初始化堆缓冲，避免 NULL memcpy 段错误。
    // ⚠ 必须先于「标量局部」发射：标量循环里这些槽被初始化为 (unsigned char*)X_buf，C 要求先声明。
    var npb: i64 = slice_len(g_c_ptrbuf_name) as i64;
    var pb: i64 = 0;
    while (pb < npb) {
        var pn: string = g_c_ptrbuf_name[pb];
        if (c_is_agg_base(pn) == false and c_is_param(g_cf, pn) == false) {
            var psz: i64 = g_c_ptrbuf_size[pb];
            if (psz <= 0) { psz = 8; }
            sb_append_str(sb, "  unsigned char* "); sb_append_str(sb, pn);
            sb_append_str(sb, "_buf = (unsigned char*)t_alloc((size_t)("); sb_append_str(sb, base.i2s(psz)); sb_append_str(sb, "));\n");
            sb_append_str(sb, "  memset((void*)("); sb_append_str(sb, pn); sb_append_str(sb, "_buf), 0, (size_t)("); sb_append_str(sb, base.i2s(psz)); sb_append_str(sb, "));\n");
        }
        pb = pb + 1;
    }
    // 标量局部
    var scalars: []string = c_collect_scalars(f);
    var ns: i64 = slice_len(scalars) as i64;
    var s: i64 = 0;
    while (s < ns) {
        var nm: string = scalars[s];
        var cty: string = c_slot_c_ty(nm);
        if (cty == "void") { s = s + 1; continue; }   // void 调用 dst 不声明变量（C 无 void 变量）
        var cinit: string = "0";
        if (cty == "TStr" or cty == "TSlice" or cty == "TClosure" or cty == "TBitStr") { cinit = "{0}"; }
        // 结构体值槽 → 指向其零初始化后备缓冲（勿置 NULL，否则 ret/store 会 memcpy 自 NULL）。
        if (c_c_ty_is_ptr(cty) and c_ptrbuf_size_of(nm) > 0 and c_is_agg_base(nm) == false) {
            cinit = base.sb_cat3("(unsigned char*)", nm, "_buf");
        }
        sb_append_str(sb, "  "); sb_append_str(sb, cty); sb_append_str(sb, " ");
        sb_append_str(sb, nm); sb_append_str(sb, " = "); sb_append_str(sb, cinit); sb_append_str(sb, ";\n");
        s = s + 1;
    }
    // 聚合基缓冲
    var na: i64 = slice_len(g_c_agg_base_name) as i64;
    var a: i64 = 0;
    while (a < na) {
        if (c_is_param(g_cf, g_c_agg_base_name[a]) == false) {
            // ⚠ 局部聚合基缓冲改为堆分配（t_alloc 持久堆），而非栈数组。原因：字节缓冲模型下
            // slice/string/array 的底层数据存于缓冲，若缓冲在栈上，返回/传递到外层作用域后会悬空
            // （如 first3() 返回的 TSlice.ptr 指向已失效栈帧 → 读垃圾）。堆分配使逃逸数据存活到程序结束。
            var hsz: i64 = g_c_agg_base_size[a];
            if (hsz <= 0) { hsz = 8; }
            sb_append_str(sb, "  unsigned char* "); sb_append_str(sb, g_c_agg_base_name[a]);
            sb_append_str(sb, "_buf = (unsigned char*)t_alloc((size_t)("); sb_append_str(sb, base.i2s(hsz)); sb_append_str(sb, "));\n");
            sb_append_str(sb, "  memset((void*)("); sb_append_str(sb, g_c_agg_base_name[a]); sb_append_str(sb, "_buf), 0, (size_t)("); sb_append_str(sb, base.i2s(hsz)); sb_append_str(sb, "));\n");
            if (c_is_addr_slot(g_c_agg_base_name[a]) == false) {
                sb_append_str(sb, "  unsigned char* "); sb_append_str(sb, g_c_agg_base_name[a]);
                sb_append_str(sb, " = (unsigned char*)"); sb_append_str(sb, g_c_agg_base_name[a]); sb_append_str(sb, "_buf;\n");
            }
        }
        a = a + 1;
    }
    // 地址槽（指针）
    var nas: i64 = slice_len(g_c_addr_slot_name) as i64;
    var x: i64 = 0;
    while (x < nas) {
        if (c_is_param(g_cf, g_c_addr_slot_name[x]) == false) {
            var pbsz2: i64 = c_ptrbuf_size_of(g_c_addr_slot_name[x]);
            if (pbsz2 > 0 and c_is_agg_base(g_c_addr_slot_name[x]) == false) {
                sb_append_str(sb, "  unsigned char* "); sb_append_str(sb, g_c_addr_slot_name[x]);
                sb_append_str(sb, " = (unsigned char*)"); sb_append_str(sb, g_c_addr_slot_name[x]); sb_append_str(sb, "_buf;\n");
            } else {
                sb_append_str(sb, "  unsigned char* "); sb_append_str(sb, g_c_addr_slot_name[x]); sb_append_str(sb, " = (unsigned char*)0;\n");
            }
        }
        x = x + 1;
    }
    // ⚠ 聚合形参的「按值语义」：字节缓冲模型里用户聚合形参是 unsigned char*（指针），被调函数
    //   就地写字段（pmove: p.x = p.x + dx）会把改动**漏回主调**；而 t / LLVM 后端结构体是按值
    //   传递的（LLVM: define void @pmove(ptr sret, %P %p, i64)）。故入口处把聚合形参拷进本帧
    //   私有缓冲、再让形参指针改指副本 —— 恢复按值语义。
    //   用 t_alloc（arena 持久堆）而非栈数组：副本可能被存进堆对象/闭包 env 而逃逸出栈帧。
    //   （colony_demo / colony_wave / agent_* 的 ECS 状态错乱根因：`col = colony_spawn(col, …)`
    //     一类链式调用里前一步的就地改动污染了后一步的输入。）
    var cp: i64 = 0;
    while (cp < np) {
        var pv2: string = f.params[cp];
        var col2: i64 = c_find_col(pv2, ":");
        if (col2 >= 0) {
            var pn2: string = c_strip_suf(str_slice(pv2, 0, col2));
            if (c_is_agg_param(f.name, pn2)) {
                var psz2: i64 = c_struct_size(c_param_tyname(f, pn2));
                if (psz2 > 0) {
                    var pvn: string = base.sb_cat2(pn2, "_pval");
                    sb_append_str(sb, "  { unsigned char* "); sb_append_str(sb, pvn);
                    sb_append_str(sb, " = (unsigned char*)t_alloc((size_t)("); sb_append_str(sb, base.i2s(psz2));
                    sb_append_str(sb, ")); memcpy((void*)("); sb_append_str(sb, pvn);
                    sb_append_str(sb, "), (void*)("); sb_append_str(sb, pn2);
                    sb_append_str(sb, "), (size_t)("); sb_append_str(sb, base.i2s(psz2));
                    sb_append_str(sb, ")); "); sb_append_str(sb, pn2);
                    sb_append_str(sb, " = (unsigned char*)"); sb_append_str(sb, pvn);
                    sb_append_str(sb, "; }\n");
                }
            }
        }
        cp = cp + 1;
    }
    // 入口函数：调用模块级全局初始化（t.__ginit 等）
    if (ismain) {
        var gi2: i64 = 0;
        while (gi2 < slice_len(g_c_mod.funcs) as i64) {
            var fnm: string = g_c_mod.funcs[gi2].name;
            if (c_starts(fnm, "t.__g")) { sb_append_str(sb, "  "); sb_append_str(sb, c_fn_name(fnm)); sb_append_str(sb, "();\n"); }
            gi2 = gi2 + 1;
        }
    }
    // 基本块（CFG → label + goto 直译）
    var nb: i64 = slice_len(f.blocks) as i64;
    var b: i64 = 0;
    while (b < nb) {
        var blk: TMIRBlock = f.blocks[b];
        sb_append_str(sb, "  "); sb_append_str(sb, c_block_label(blk.name)); sb_append_str(sb, ":\n");
        var ni: i64 = slice_len(blk.insts) as i64;
        var k: i64 = 0;
        while (k + 1 < ni) { c_emit_inst(sb, blk.insts[k]); k = k + 1; }
        if (ni > 0) { c_emit_term(sb, blk.insts[ni - 1]); }
        else { sb_append_str(sb, "    ;\n"); }
        b = b + 1;
    }
    sb_append_str(sb, "}\n\n");
}

pub fn c_collect_scalars(f: TMIRFunc) []string {
    var r: []string = [];
    var nb: i64 = slice_len(f.blocks) as i64;
    var b: i64 = 0;
    while (b < nb) {
        var ni: i64 = slice_len(f.blocks[b].insts) as i64;
        var k: i64 = 0;
        while (k < ni) {
            var ins: TMIRInst = f.blocks[b].insts[k];
            if (str_len(ins.dst.name) as i64 > 0 and ins.dst.name[0] == 36) { var dn2: string = c_strip_suf(ins.dst.name); if (c_is_param(f, dn2) == false) { r = c_add_scalar(r, dn2); } }
            var na: i64 = slice_len(ins.args) as i64;
            var a: i64 = 0;
            while (a < na) { if (str_len(ins.args[a].name) as i64 > 0 and ins.args[a].name[0] == 36) { var an2: string = c_strip_suf(ins.args[a].name); if (c_is_param(f, an2) == false) { r = c_add_scalar(r, an2); } } a = a + 1; }
            k = k + 1;
        }
        b = b + 1;
    }
    return r;
}
// 加 slot 到标量列表：跳过地址槽（unsigned char*）与聚合基槽（缓冲拥有者），二者单独声明。
pub fn c_add_scalar(sl: []string, n: string) []string {
    if (c_is_addr_slot(n)) { return sl; }
    if (c_is_agg_base(n)) { return sl; }
    return c_add_slot(sl, n);
}
pub fn c_add_slot(sl: []string, n: string) []string {
    var i: i64 = 0; var nn: i64 = slice_len(sl) as i64;
    while (i < nn) { if (sl[i] == n) { return sl; } i = i + 1; }
    var out: []string = [];
    var j: i64 = 0;
    while (j < nn) { append(out, sl[j]); j = j + 1; }
    append(out, n);
    return out;
}
// 参数名判定：参数在 tmir 中即 slot，已在签名中声明，c_collect_scalars 须跳过以免重复声明。
pub fn c_is_param(f: TMIRFunc, n: string) bool {
    var i: i64 = 0;
    while (i < slice_len(f.params) as i64) {
        var pv: string = f.params[i];
        var col: i64 = c_find_col(pv, ":");
        if (c_strip_suf(str_slice(pv, 0, col)) == n) { return true; }
        i = i + 1;
    }
    return false;
}

// ── 终止指令 ─────────────────────────────────────────────────
pub fn c_emit_term(sb: StringBuilder, term: TMIRInst) void {
    if (term.op == tir__TIR_OP_RET_VOID) { sb_append_str(sb, "  return;\n"); return; }
    if (term.op == tir__TIR_OP_RET) {
        // 返回函数值（fn 类型）→ 返回 &static TClosure 常量（对齐 LLVM 的 @.tirll_clo_<fn>）。
        if (c_is_func_ref(term.dst.name)) {
            sb_append_str(sb, "  return (unsigned char*)(&"); sb_append_str(sb, c_clo_global(term.dst.name));
            sb_append_str(sb, ");\n");
            return;
        }
        // sret：把返回值缓冲 memcpy 进出参指针，ret void（聚合不可按值强转，且与 LLVM sret 逐字对齐）。
        // sret 返回槽在字节缓冲模型里恒为「指向缓冲的指针」（unsigned char*），故直接取槽值（指针）即可；
        // 切勿 & 取槽变量地址（那样会拷入「指针变量自身的地址」而非缓冲）。
        if (g_c_sret) {
            sb_append_str(sb, "  { memcpy((void*)(__sret), (void*)(");
            c_emit_val(sb, term.dst);
            sb_append_str(sb, "), (size_t)("); sb_append_str(sb, base.i2s(g_c_sret_size));
            sb_append_str(sb, ")); }\n");
            sb_append_str(sb, "  return;\n");
            return;
        }
        // 非 sret 返回：运行库结构体（TStr/TSlice/TClosure/TBitStr）按值返回（C 签名即该结构体），
        // 但字节缓冲模型里返回值槽常是「指向缓冲的指针」（unsigned char*）→ 须把缓冲重解释为结构体再返回，
        // 否则报 incompatible result type（slice_literal_arg 等返回 TSlice 的用户函数）。
        // 仅当返回值槽确为指针时才重解释；槽本身已是结构体值（如 TStr 字符串构造结果）则直返。
        if (g_c_sret == false and c_is_runtime_struct_st(g_cf.ret_st)) {
            var rcty: string = c_tystr_c(g_cf.ret_st);
            var vcty: string = c_operand_c_ty(term.dst);
            if (c_c_ty_is_ptr(vcty)) {
                sb_append_str(sb, "  return *("); sb_append_str(sb, rcty); sb_append_str(sb, "*)(");
                c_emit_val(sb, term.dst); sb_append_str(sb, ");\n");
                return;
            }
        }
        sb_append_str(sb, "  return (");
        c_emit_val(sb, term.dst);
        sb_append_str(sb, ");\n");
        return;
    }
    if (term.op == tir__TIR_OP_BR) {
        sb_append_str(sb, "  goto "); sb_append_str(sb, c_block_label(term.args[0].name)); sb_append_str(sb, ";\n");
        return;
    }
    if (term.op == tir__TIR_OP_BR_COND) {
        sb_append_str(sb, "  if (");
        c_emit_val(sb, term.args[0]);
        sb_append_str(sb, ") goto "); sb_append_str(sb, c_block_label(term.args[1].name));
        sb_append_str(sb, "; else goto "); sb_append_str(sb, c_block_label(term.args[2].name)); sb_append_str(sb, ";\n");
        return;
    }
    sb_append_str(sb, "  /* unsupported term */\n");
}

// ── 普通指令 ─────────────────────────────────────────────────
// 结构体值实参：运行库按值收 TStr/TSlice/TBitStr，而模型里该槽可能是指针（unsigned char*/void*）→
// 需解引用还原成结构体值再传参（对齐 LLVM 的 ll_slice_base_addr 语义）。
pub fn c_emit_sval_arg(sb: StringBuilder, op: TirOperand, cty: string) void {
    if (c_c_ty_is_ptr(c_operand_c_ty(op))) {
        sb_append_str(sb, "*("); sb_append_str(sb, cty); sb_append_str(sb, "*)(void*)(");
        c_emit_val(sb, op); sb_append_str(sb, ")");
        return;
    }
    c_emit_val(sb, op);
}
// 字符串相等：TStr 是结构体值，不能按整数比较（也不能强转成整数）。
pub fn c_emit_str_eq(sb: StringBuilder, dstn: string, neg: bool, a: TirOperand, b: TirOperand) void {
    sb_append_str(sb, "  "); sb_append_str(sb, dstn); sb_append_str(sb, " = ");
    if (neg) { sb_append_str(sb, "!"); }
    sb_append_str(sb, "t_str_eq("); c_emit_sval_arg(sb, a, "TStr"); sb_append_str(sb, ", ");
    c_emit_sval_arg(sb, b, "TStr"); sb_append_str(sb, ") ? 1 : 0;\n");
}

pub fn c_emit_inst(sb: StringBuilder, ins: TMIRInst) void {
    if (ins.is_comment) { sb_append_str(sb, "  /* "); sb_append_str(sb, ins.cmt); sb_append_str(sb, " */\n"); return; }
    var op: i64 = ins.op;
    if (op == tir__TIR_OP_SLOT) { return; }
    if (op == tir__TIR_OP_TYPEINFO) {
        // type_info(T)：与 LLVM 轨同构 —— variant 数据在双后端均为「指向 16B 数据的指针」
        //   { i64 tag@0, TypeMeta* meta@8 }。这里把 tag/meta 写进堆分配的 16B 槽，
        //   再把槽指针存入 dst（dst 的 st 是 ptr<void>）。
        //   ⚠ 不可把 dst 直接当 8B 槽用：构造器写 16B 会溢出。
        var tidst: string = c_strip_suf(ins.dst.name);
        var ttname: string = ins.args[0].name;
        var tarm: string = c_ti_arm(ttname);
        var tkind: i64 = c_ti_kind_num(tarm);
        var ttmp: string = base.sb_cat2("_tip", base.i2s(g_c_tmpc));
        g_c_tmpc = g_c_tmpc + 1;
        sb_append_str(sb, "  unsigned char* "); sb_append_str(sb, ttmp);
        sb_append_str(sb, " = (unsigned char*)t_alloc((size_t)(16));\n");
        sb_append_str(sb, "  memset((void*)("); sb_append_str(sb, ttmp); sb_append_str(sb, "), 0, (size_t)(16));\n");
        sb_append_str(sb, "  { int64_t _tiv = "); sb_append_str(sb, base.i2s(tkind));
        sb_append_str(sb, "; memcpy((void*)("); sb_append_str(sb, ttmp); sb_append_str(sb, "), &_tiv, (size_t)(8)); }\n");
        if (tarm != "Bool") {
            sb_append_str(sb, "  { void* _tim = (void*)(&__ti_"); sb_append_str(sb, ttname);
            sb_append_str(sb, "_meta); memcpy((void*)("); sb_append_str(sb, ttmp);
            sb_append_str(sb, " + 8), &_tim, (size_t)(8)); }\n");
        }
        sb_append_str(sb, "  "); sb_append_str(sb, tidst); sb_append_str(sb, " = (void*)(");
        sb_append_str(sb, ttmp); sb_append_str(sb, ");\n");
        return;
    }
    if (op == tir__TIR_OP_ADDR_OF) {
        var dstn: string = c_strip_suf(ins.dst.name);
        var basen: string = c_strip_suf(ins.args[0].name);
        // 基：参数（已是缓冲指针）/global → 直接用基名；局部 slot → <slot>_buf。
        var basebuf: string = "";
        if (c_is_param(g_cf, basen)) {
            // 形参 ADDR_OF：
            //  · 字节缓冲形参（聚合基，本身就是缓冲指针）→ 直接取指针值（不变）；
            //  · 运行库「数据」结构体（TStr/TSlice/TBitStr）按值传递 → 须取 & 得到其字节缓冲地址
            //    （否则 bump(m, k) 这类把 TStr 形参当 map key 用时，t27 = k 漏 & → unsigned char*←TStr 错配）；
            //  · TClosure 在模型中当指针值使用（闭包场景），保持取基名。
            if (c_is_agg_param(g_cf.name, basen)) { basebuf = basen; }
            else {
                var pty: string = c_param_tyname(g_cf, basen);
                if (c_is_runtime_struct_st(pty) and c_tystr_c(pty) != "TClosure") {
                    basebuf = base.sb_cat2("(unsigned char*)(&", basen); basebuf = base.sb_cat2(basebuf, ")");
                } else { basebuf = basen; }
            }
        }
        else if (str_len(ins.args[0].name) as i64 > 0 and ins.args[0].name[0] == 64) {
            // 运行库结构体（TClosure）全局：addr_of 取其地址 &g_join（struct 值全局），并降级成
            // unsigned char* 以匹配模型统一的地址槽类型（避免 TClosure* → unsigned char* 不兼容报错）；
            // 后续 GEP(t77+0/+8) 仍按字节偏移写 code/env 字段。其余全局（用户聚合/数组，声明为
            // `unsigned char* g = g_buf` 缓冲指针）保持 g（缓冲指针）。
            if (c_tystr_c(tir.tir_st_to_str(c_global_st(basen))) == "TClosure") { basebuf = base.sb_cat2("(unsigned char*)(&", basen); basebuf = base.sb_cat2(basebuf, ")"); }
            else { basebuf = basen; }
        }
        else if (c_is_agg_base(basen)) { basebuf = base.sb_cat2(basen, "_buf"); }
        // 纯地址槽（slice_at / GEP / bitcast / struct_new… 结果，持有指针值但无自有缓冲）：
        // 取址 = 该指针本身。若按聚合基取 <slot>_buf 会指到不存在的（或全 0 的）缓冲。
        else if (c_is_addr_slot(basen)) { basebuf = basen; }
        // ⚠ 用户聚合（%Struct / packed 位域 …）取址：模型里聚合值槽即「字节缓冲指针」，
        //   addr_of 的语义地址 = 缓冲指针本身，不能发成 &slot（那是指针变量的地址，后续
        //   gep+load 会读到指针值的低字节 → bitflags/struct_modifiers 的位域全 0）。
        //   ⚠ 判据必须是「目的类型 ptr<%用户聚合>」，不能用「源槽 C 类型是否指针」——
        //   后者过宽，会把 map 里持有机器指针值的槽（ptr<i64> 等）也当聚合缓冲，回归 map_*。
        else if (c_is_user_agg_ptr_ty(tir.tir_st_to_str(ins.st))) { basebuf = basen; }
        else { basebuf = base.sb_cat2("(unsigned char*)(&", basen); basebuf = base.sb_cat2(basebuf, ")"); }
        sb_append_str(sb, "  "); sb_append_str(sb, dstn); sb_append_str(sb, " = "); sb_append_str(sb, basebuf); sb_append_str(sb, ";\n");
        c_addr_base_mark(dstn, tir.tir_st_to_str(ins.st));
        return;
    }
    if (op == tir__TIR_OP_GEP) {
        var dstn: string = c_strip_suf(ins.dst.name);
        var basen: string = c_strip_suf(ins.args[0].name);
        var bty: string = c_gep_base_ty(basen);
        // 全路径索引：args[0]=基址，args[1..]=索引序列。指针基首索引为解引用。
        var nidx: i64 = slice_len(ins.args) as i64 - 1;
        var idxs: []i64 = [];
        var ix: i64 = 0;
        while (ix < nidx) { append(idxs, tir.tir_atoi(ins.args[ix + 1].name)); ix = ix + 1; }
        var off: i64 = c_gep_full_offset(bty, idxs);
        c_emit_gep_dstpre(sb, dstn);
        c_emit_gep_base(sb, ins.args[0]);
        sb_append_str(sb, " + "); sb_append_str(sb, base.i2s(off));
        c_emit_gep_dstpost(sb, dstn); sb_append_str(sb, ";\n");
        c_addr_mark(dstn, ins.st);
        return;
    }
    if (op == tir__TIR_OP_GEP_IDX) {
        var dstn: string = c_strip_suf(ins.dst.name);
        var basen: string = c_strip_suf(ins.args[0].name);
        var bty: string = c_gep_base_ty(basen);
        // 元素尺寸优先从「数组基」的元素类型取（权威，如 arr[i]）；否则（如切片 void* 基 s[i]）
        // 从 gep_idx 结果 st 取元素类型（TIR 的 gep_idx 结果 st 即元素类型，LLVM 轨据此 emit
        // getelementptr inbounds <elem>, ...）。绝不能用 c_array_elem(void*) 默认 i8（步长 1 而非 elem_size，
        // 导致 array_to_slice 读串台、slice/array 元素全错位）。
        var esz: i64 = 0;
        if (c_is_arr(bty)) { esz = c_tstr_size(c_array_elem(bty)); }
        if (esz <= 0) { esz = c_tstr_size(tir.tir_st_to_str(ins.st)); }
        if (esz <= 0) { esz = 8; }
        c_emit_gep_dstpre(sb, dstn);
        c_emit_gep_base(sb, ins.args[0]);
        sb_append_str(sb, " + ("); c_emit_val(sb, ins.args[1]); sb_append_str(sb, " * "); sb_append_str(sb, base.i2s(esz));
        sb_append_str(sb, ")"); c_emit_gep_dstpost(sb, dstn); sb_append_str(sb, ";\n");
        c_addr_mark(dstn, ins.st);
        return;
    }
    if (op == tir__TIR_OP_LOAD) {
        var dstn: string = c_strip_suf(ins.dst.name);
        var srcn: string = c_strip_suf(ins.args[0].name);
        // ⚠ 源是「指针型槽」（slot ptr<%TypeMeta> $m 之类，C 声明 unsigned char*）但不在地址槽表里
        //   ⇒ c_is_address 为假 ⇒ 本会退化成标量赋值 `t10 = m`（别名），随后 &t10 取到空的
        //   t10_buf → type_info 读出空名 / size 0。这类槽存的正是指向 pointee 的指针，
        //   只要「载入结果不是指针」就必须按地址解引用（load %TypeMeta $t10 $m）。
        //   反之若载入结果本身是指针（load ptr<%TypeInfo> $t1 $ti），那是变量拷贝，不解引用。
        var ldst: string = tir.tir_st_to_str(ins.st);
        var ld_is_ptr: bool = (c_starts(ldst, "ptr<") or ldst == "ptr" or ldst == "ptr<void>");
        var src_is_ptrslot: bool = false;
        if (ld_is_ptr == false) {
            var sct: string = c_slot_c_ty(srcn);
            if (c_c_ty_is_ptr(sct) and c_is_agg_base(srcn) == false) { src_is_ptrslot = true; }
        }
        // 全局聚合（地址为 @g 指向 _buf）：载入 = 取全局缓冲指针（聚合以指针传递）。
        if (str_len(ins.args[0].name) as i64 > 0 and ins.args[0].name[0] == 64 and c_global_is_bytebuf(c_strip_suf(ins.args[0].name))) {
            sb_append_str(sb, "  "); sb_append_str(sb, dstn); sb_append_str(sb, " = (unsigned char*)(");
            sb_append_str(sb, c_strip_suf(ins.args[0].name)); sb_append_str(sb, "_buf);\n");
            return;
        }
        // 地址槽（struct/数组字段）→ 按 LOAD 自身类型宽度 memcpy 出缓冲
        if (c_is_address(srcn) or src_is_ptrslot) {
            // ⚠ 源是「嵌套聚合字段地址」（指向 inlined 用户聚合数据，如 Entity 内嵌的 Velocity /
            // intent_dir）：加载 = 取该字段地址（别名，**不**读 8 字节），否则把结构头 8 字节当指针
            // 解引用 → 段错误（world_tick 读 intent_dir 经 physics__movement_system 崩溃）。
            // 仅对「非指针用户聚合」生效；ptr<%X> 指针字段 / 标量字段仍按原逻辑（读 8B / 各宽度）。
            var _srcty: string = tir.tir_st_to_str(c_addr_st_of(srcn));
            var _src_agg: bool = (c_starts(_srcty, "%") and c_is_enum_ty(_srcty) == false and c_starts(_srcty, "ptr<%") == false
                                  and c_is_runtime_struct_st(_srcty) == false);
            if (_src_agg and c_is_agg_base(dstn) == false) {
                sb_append_str(sb, "  "); sb_append_str(sb, dstn); sb_append_str(sb, " = (unsigned char*)(");
                c_emit_val(sb, ins.args[0]); sb_append_str(sb, ");\n");
                // ⚠ 必须把别名结果登记为地址槽（聚合类型），否则下游 STORE 视其为标量 unsigned char*
                //   → `memcpy(&_cst, t108, 8)` 只拷 8B 指针进嵌套字段（如 Entity.velocity）→
                //   字段读到堆地址、运动系统算出垃圾 pos（agent_npc_mind 的 pos=(2199023452584,0,0)）。
                //   标成地址槽后 STORE 走 _dst_agg 分支按聚合尺寸 memcpy（值语义）。
                //   类型取内嵌聚合（剥离 ptr< 前缀，无则原样），保证记录的是 %Agg 而非 ptr<%Agg>。
                c_addr_mark(dstn, tir.tir_st_from_str(c_strip_ptr(_srcty)));
                return;
            }
            if (_src_agg and c_is_agg_base(dstn)) {
                var _asz: i64 = c_struct_size(_srcty);
                if (_asz <= 0) { _asz = c_tstr_size(_srcty); }
                if (_asz <= 0) { _asz = 8; }
                sb_append_str(sb, "  memcpy((void*)("); sb_append_str(sb, dstn); sb_append_str(sb, "), (void*)(");
                c_emit_val(sb, ins.args[0]); sb_append_str(sb, "), (size_t)("); sb_append_str(sb, base.i2s(_asz)); sb_append_str(sb, "));\n");
                return;
            }
            // ⚠ 源是 slice_at 的元素字节地址、目的为「结构体值槽」（st 是 %Foo）：
            //   载入 = 取该元素地址（别名），**不是**从地址再读 8 字节。
            //   若错按 8B memcpy，取到的是 pointee 头 8 字节（FieldInfo 的 TStr.ptr）当元素地址
            //   → type_info 的 `m.fields[i]` 整片乱值。
            //   ⚠ 仅对 slice_at 生效：闭包 env 字段存的是**指针变量**，那里必须按 8B memcpy 取出指针
            //   （closure_struct_demo 的 `h2.tag` / pipeline 的 __pe 即此），不能别名。
            var dcn: string = tir.tir_st_to_str(ins.st);
            if (c_is_sliceat(srcn) and c_starts(dcn, "%")
                and c_c_ty_is_struct(c_tystr_c(dcn)) == false
                and c_is_agg_base(dstn) == false) {
                sb_append_str(sb, "  "); sb_append_str(sb, dstn); sb_append_str(sb, " = (unsigned char*)(");
                sb_append_str(sb, srcn); sb_append_str(sb, ");\n");
                return;
            }
            // 目的也是「拥有缓冲的聚合基」→ 复制缓冲内容（agg_size 字节）；
            // 否则（非拥有指针别名）→ 指针赋值 dst = src（别名语义）。
            if (c_is_address(dstn) and c_is_agg_base(dstn)) {
                var aggsz: i64 = c_agg_size_of_tyname(c_slot_ty_find(srcn));
                if (aggsz <= 0) { aggsz = c_agg_size_of_tyname(c_slot_ty_find(dstn)); }
                if (aggsz <= 0) { aggsz = 8; }
                sb_append_str(sb, "  memcpy((void*)("); sb_append_str(sb, dstn); sb_append_str(sb, "), (void*)(");
                sb_append_str(sb, srcn); sb_append_str(sb, "), (size_t)("); sb_append_str(sb, base.i2s(aggsz)); sb_append_str(sb, "));\n");
                return;
            }
            if (c_is_address(dstn)) {
                sb_append_str(sb, "  "); sb_append_str(sb, dstn); sb_append_str(sb, " = ");
                sb_append_str(sb, srcn); sb_append_str(sb, ";\n");
                return;
            }
            // 标量目的：按目的槽类型（与槽声明一致，避免 int64↔unsigned char* 错配）memcpy 出缓冲。
            var ldt_ty: string = c_slot_c_ty(dstn);
            sb_append_str(sb, "  { "); sb_append_str(sb, ldt_ty); sb_append_str(sb, " _cld"); sb_append_str(sb, base.i2s(g_c_tmpc)); sb_append_str(sb, "; memcpy(&_cld");
            sb_append_str(sb, base.i2s(g_c_tmpc)); sb_append_str(sb, ", (void*)("); sb_append_str(sb, srcn); sb_append_str(sb, "), sizeof(_cld"); sb_append_str(sb, base.i2s(g_c_tmpc)); sb_append_str(sb, ")); ");
            sb_append_str(sb, dstn); sb_append_str(sb, " = _cld"); sb_append_str(sb, base.i2s(g_c_tmpc)); sb_append_str(sb, "; }\n");
            g_c_tmpc = g_c_tmpc + 1;
            return;
        }
        // 标量 slot 间拷贝（类型不一致时自动插入转换）
        c_emit_assign(sb, dstn, ins.args[0]);
        return;
    }
    if (op == tir__TIR_OP_STORE) {
        var dname: string = ins.dst.name;
        if (str_len(dname) as i64 > 0 and dname[0] == 64) {   // 全局
            var gname: string = c_strip_suf(dname);
            var gstty: string = tir.tir_st_to_str(c_global_st(gname));
            // ⚠ 运行库「指针句柄」全局（%TSb* / %TMap*：SB / Map 恒以指针访问）不参与聚合字节缓冲分支，
            //   否则向 <name>_buf 写 8B 指针 → memcpy 目标为 struct 值非法（或写入错误偏移）。按指针标量赋值。
            if (c_global_is_agg(gname) and c_is_runtime_handle_ptr(gstty) == false) {
                if (c_global_is_bytebuf(gname)) {
                    var gsz: i64 = c_struct_size(tir.tir_st_to_str(c_global_st(gname)));
                    if (gsz <= 0) { gsz = c_tstr_size(tir.tir_st_to_str(c_global_st(gname))); }
                    if (gsz <= 0) { gsz = 8; }
                    sb_append_str(sb, "  memcpy((void*)("); sb_append_str(sb, gname); sb_append_str(sb, "_buf), (void*)(");
                    c_emit_val(sb, ins.args[0]); sb_append_str(sb, "), (size_t)("); sb_append_str(sb, base.i2s(gsz)); sb_append_str(sb, "));\n");
                    return;
                }
                // 运行库聚合全局（struct 值）：源是指针（struct_new 缓冲）→ memcpy 入全局存储；
                // 源是值（TSlice 变量）→ 直接赋值。避免 g_buf 不存在 / 类型错配。
                var gsz2: i64 = c_struct_size(tir.tir_st_to_str(c_global_st(gname)));
                if (gsz2 <= 0) { gsz2 = 8; }
                var srcn2: string = c_strip_suf(ins.args[0].name);
                if (c_is_address(srcn2)) {
                    sb_append_str(sb, "  memcpy((void*)(&"); sb_append_str(sb, gname); sb_append_str(sb, "), (void*)(");
                    c_emit_val(sb, ins.args[0]); sb_append_str(sb, "), (size_t)("); sb_append_str(sb, base.i2s(gsz2)); sb_append_str(sb, "));\n");
                } else {
                    sb_append_str(sb, "  "); sb_append_str(sb, gname); sb_append_str(sb, " = (");
                    sb_append_str(sb, c_tystr_c(tir.tir_st_to_str(c_global_st(gname)))); sb_append_str(sb, ")(");
                    c_emit_val(sb, ins.args[0]); sb_append_str(sb, ");\n");
                }
                return;
            }
            // ⚠ 落到此分支的含「指针句柄全局」（%TSb* / %TMap*）：按 c_tystr_c 给的 TSb* / TMap* 指针类型赋值；
            //   其余为标量/标量指针全局，c_tystr_c 对基元回落 tmir_st_c，与声明一致。
            sb_append_str(sb, "  "); sb_append_str(sb, gname); sb_append_str(sb, " = (");
            sb_append_str(sb, c_tystr_c(gstty)); sb_append_str(sb, ")(");
            c_emit_val(sb, ins.args[0]); sb_append_str(sb, ");\n");
            return;
        }
        var dstn: string = c_strip_suf(dname);
        // 闭包构造：把「函数引用」写进 TClosure.field0（8B code 指针）。
        // 无 env 首参的普通函数须经 thunk 转发（c_clo_code），否则 CALL_IND 的 env 会吃掉第一个实参。
        if (c_is_func_ref(ins.args[0].name) and c_is_address(dstn)) {
            sb_append_str(sb, "  { void* _cfp"); sb_append_str(sb, base.i2s(g_c_tmpc));
            sb_append_str(sb, " = (void*)("); sb_append_str(sb, c_clo_code(ins.args[0].name));
            sb_append_str(sb, "); memcpy((void*)("); sb_append_str(sb, dstn);
            sb_append_str(sb, "), &_cfp"); sb_append_str(sb, base.i2s(g_c_tmpc));
            sb_append_str(sb, ", sizeof(_cfp"); sb_append_str(sb, base.i2s(g_c_tmpc));
            sb_append_str(sb, ")); }\n");
            g_c_tmpc = g_c_tmpc + 1;
            return;
        }
        if (c_is_address(dstn)) {
            // 目的若是「拥有缓冲的聚合基」→ 复制源缓冲内容（值语义）；
            // 否则（纯指针别名：返回槽 / 形参 / 显式指针变量，无 _buf）→ 指针赋值（别名语义），
            // 否则对 NULL / 调用方缓冲 memcpy 会崩或污染。
            var srcn: string = c_strip_suf(ins.args[0].name);
            if (c_is_address(srcn) and c_is_agg_base(dstn)) {
                var aggsz: i64 = c_agg_size_of_tyname(c_slot_ty_find(srcn));
                if (aggsz <= 0) { aggsz = c_agg_size_of_tyname(c_slot_ty_find(dstn)); }
                if (aggsz <= 0) { aggsz = 8; }
                sb_append_str(sb, "  memcpy((void*)("); sb_append_str(sb, dstn); sb_append_str(sb, "), (void*)(");
                c_emit_val(sb, ins.args[0]); sb_append_str(sb, "), (size_t)("); sb_append_str(sb, base.i2s(aggsz));
                sb_append_str(sb, "));\n");
                return;
            }
            // 非拥有缓冲目的（或无源缓冲）→ 视情形：
            // 若目的是「GEP 字段地址」且字段类型是聚合（嵌套 struct / 数组 / vector）→
            //   按字段尺寸 memcpy 源缓冲内容进字段地址（值语义），而非别名 dst=src
            //   （只拷 8B 指针 → 嵌套 struct 字段读到堆地址、字段全乱：
            //    agent_npc_mind / agentkit_demo 的 `s.intent_dir = physics.Velocity{...}` 之类）。
            //   枚举字段非聚合（c_is_enum_ty），仍走下方标量/指针别名分支。
            // 否则（标量/指针字段）→ 指针赋值 dst = src（别名）。
            if (c_is_address(srcn)) {
                var _dstf: string = tir.tir_st_to_str(c_addr_st_of(dstn));
                var _dst_inner: string = c_strip_ptr(_dstf);
                var _dst_agg: bool = false;
                // 字段是「用户聚合」（嵌套 struct/数组/vector）或「指向用户聚合的指针」（GEP 入嵌套字段
                // 得到 ptr<%Agg>，pointee 是用户聚合）→ 按聚合尺寸 memcpy，而非别名 8B 指针
                // （agent_npc_mind 的 intent_dir / Position 字段被写崩、读到堆地址的根因）。
                // ⚠ 运行库结构体字段（TStr/TSlice/TClosure/TBitStr，GEP 入字段得 ptr<%TSlice> 等）也须
                //   纳入 _dst_agg：g.xs=[] 源是空切片缓冲地址，若剔除会裸别名 8B 指针 → 不拷 TSlice.len
                //   （hir_reset 的 node_to_hir=[] 残留 → 复用脱糖期缓存 HIR_OP_FN_DECL → T-SEM-E200）。
                if (c_starts(_dstf, "%") and c_is_enum_ty(_dstf) == false) { _dst_agg = true; }
                if (c_starts(_dst_inner, "%") and c_is_enum_ty(_dst_inner) == false and c_starts(_dst_inner, "ptr<") == false) { _dst_agg = true; }
                if (c_starts(_dstf, "[") or c_is_arr(_dstf) or c_is_arr(_dst_inner) or c_is_vec(_dstf)) { _dst_agg = true; }
                if (_dst_agg) {
                    // ⚠ 运行库结构体字段（TStr/TSlice/TClosure/TBitStr，含 GEP 结果 ptr<%TStr>）：其尺寸
                    //   不在 module.types（c_struct_size("%TStr")==0），不能用硬算尺寸 memcpy。统一经
                    //   「该类型临时变量 + sizeof」拷贝，尺寸交给 C 编译器定；并兼容两种源：① 结构值
                    //   （TStr 形参/局部值）→ `TStr _cag = src;`；② unsigned char* 缓冲（被标记成地址槽的
                    //   TStr 局部）→ 先拷进 temp 再落字段。
                    if (c_is_runtime_struct_st(_dstf) or c_is_runtime_struct_st(_dst_inner)) {
                        var _rtname: string = _dstf;
                        if (c_starts(_rtname, "ptr<")) { _rtname = _dst_inner; }
                        if (c_starts(_rtname, "%")) { _rtname = str_slice(_rtname, 1, str_len(_rtname) as i64); }
                        var _srcty: string = c_param_c_ty(g_cf, srcn);
                        // ⚠ 同 STRUCT_NEW：c_param_c_ty 对非形参返回 "long long" 兜底（非空串），须一并判定，
                        // 否则 TStr 局部源（如 `v = t` 中 t 为 TStr 局部）的 _srcty 卡在 "long long" →
                        // 误走「缓冲」分支 `(void*)(src)` 编译错 operand of type 'TStr'。
                        if (_srcty == "" or _srcty == "long long") { _srcty = c_slot_c_ty(srcn); }
                        var _csn_n: i64 = g_c_tmpc;
                        if (c_is_runtime_struct_st(_srcty)) {
                            sb_append_str(sb, "  { "); sb_append_str(sb, _rtname); sb_append_str(sb, " _cag"); sb_append_str(sb, base.i2s(_csn_n));
                            sb_append_str(sb, " = "); c_emit_val(sb, ins.args[0]); sb_append_str(sb, "; memcpy((void*)(");
                            sb_append_str(sb, dstn); sb_append_str(sb, "), &_cag"); sb_append_str(sb, base.i2s(_csn_n));
                            sb_append_str(sb, ", sizeof(_cag"); sb_append_str(sb, base.i2s(_csn_n)); sb_append_str(sb, ")); }\n");
                        } else {
                            sb_append_str(sb, "  { "); sb_append_str(sb, _rtname); sb_append_str(sb, " _cag"); sb_append_str(sb, base.i2s(_csn_n));
                            sb_append_str(sb, "; memcpy(&_cag"); sb_append_str(sb, base.i2s(_csn_n)); sb_append_str(sb, ", (void*)(");
                            c_emit_val(sb, ins.args[0]); sb_append_str(sb, "), sizeof(_cag"); sb_append_str(sb, base.i2s(_csn_n));
                            sb_append_str(sb, ")); memcpy((void*)("); sb_append_str(sb, dstn); sb_append_str(sb, "), &_cag");
                            sb_append_str(sb, base.i2s(_csn_n)); sb_append_str(sb, ", sizeof(_cag"); sb_append_str(sb, base.i2s(_csn_n)); sb_append_str(sb, ")); }\n");
                        }
                        g_c_tmpc = g_c_tmpc + 1;
                        return;
                    }
                    // 用户聚合 / 数组 / vector 字段：源为字节缓冲指针，按字段尺寸 memcpy。
                    // 字段类型可能带 ptr< 前缀（GEP 入嵌套字段）→ 尺寸取 pointee 聚合尺寸。
                    var _asz: i64 = c_struct_size(_dstf);
                    if (_asz <= 0) { _asz = c_struct_size(_dst_inner); }
                    if (_asz <= 0) { _asz = c_tstr_size(_dstf); }
                    if (_asz <= 0) { _asz = c_agg_size_of_tyname(_dst_inner); }
                    if (_asz <= 0) { _asz = c_agg_size_of_tyname(c_slot_ty_find(srcn)); }
                    if (_asz <= 0) { _asz = 8; }
                    sb_append_str(sb, "  memcpy((void*)("); sb_append_str(sb, dstn); sb_append_str(sb, "), (void*)(");
                    c_emit_val(sb, ins.args[0]); sb_append_str(sb, "), (size_t)("); sb_append_str(sb, base.i2s(_asz)); sb_append_str(sb, "));\n");
                    return;
                }
                sb_append_str(sb, "  "); sb_append_str(sb, dstn); sb_append_str(sb, " = ");
                c_emit_val(sb, ins.args[0]); sb_append_str(sb, ";\n");
                return;
            }
            // 目的为「拥有缓冲的聚合基」且源是「指向聚合数据的裸指针」（如 unwrap 聚合可选返回的堆指针）：
            // 须从 pointee 复制 sizeof(agg) 字节进 dst 缓冲（值语义），而非 memcpy 指针本身（8B）→
            // 聚合字段错乱（optional_demo 的 point_sum / ?Point：p.x/p.y 取到指针字节而非 Point 数据）。
            if (c_is_agg_base(dstn)) {
                var aggsz: i64 = c_agg_size_of_tyname(c_slot_ty_find(dstn));
                if (aggsz <= 0) { aggsz = 8; }
                sb_append_str(sb, "  memcpy((void*)("); sb_append_str(sb, dstn);
                sb_append_str(sb, "), (void*)("); c_emit_val(sb, ins.args[0]);
                sb_append_str(sb, "), (size_t)("); sb_append_str(sb, base.i2s(aggsz)); sb_append_str(sb, "));\n");
                return;
            }
            // 闭包 env 字段 / 其他非地址槽目的：若写入的是「用户聚合值」(%Agg，非枚举/非运行库结构体)，
            // 源是字节缓冲指针（如 `h2: Holder` 这类缓冲局部），须按聚合尺寸 memcpy 缓冲内容（值语义），
            // 而非拷 8B 指针 → 闭包捕获聚合时只存了指针、运行期经指针读回遇到堆地址/失效内存得垃圾
            // （closure_struct_demo 的 `get_tag` 捕获 `h2: Holder` 按指针捕获 → get_tag() 返回垃圾的根因）。
            // 类型权威来源：优先槽语义类型 c_slot_ty_find（局部/形参的 %Holder 在此登记），落空再用 ins.st。
            // 注意：运行库结构体（TStr 等）在 C 是值类型、源即 TStr 值（非缓冲指针），仍走下方标量/指针分支。
            var _ststr: string = c_slot_ty_find(c_strip_suf(ins.args[0].name));
            if (_ststr == "") { _ststr = tir.tir_st_to_str(ins.st); }
            if (c_starts(_ststr, "%") and c_is_enum_ty(_ststr) == false and c_is_runtime_struct_st(_ststr) == false) {
                var _asz: i64 = c_struct_size(_ststr);
                if (_asz <= 0) { _asz = c_agg_size_of_tyname(_ststr); }
                if (_asz <= 0) { _asz = 8; }
                sb_append_str(sb, "  memcpy((void*)("); sb_append_str(sb, dstn);
                sb_append_str(sb, "), (void*)("); c_emit_val(sb, ins.args[0]); sb_append_str(sb, "), (size_t)(");
                sb_append_str(sb, base.i2s(_asz)); sb_append_str(sb, "));\n");
                return;
            }
            var srcty: string = c_operand_c_ty(ins.args[0]);
            if (srcty == "" or srcty == "void") { srcty = "int64_t"; }
            // ⚠ 必须先捕获 tmpc 序号：c_emit_val 内部（如 append 调用）可能自增 g_c_tmpc，
            // 若声明与引用都用 g_c_tmpc，引用会取到自增后的值 → _cst{N} 声明却引用 _cst{N+1} 错配。
            var _cst_n: i64 = g_c_tmpc;
            sb_append_str(sb, "  { "); sb_append_str(sb, srcty); sb_append_str(sb, " _cst"); sb_append_str(sb, base.i2s(_cst_n)); sb_append_str(sb, " = ");
            c_emit_val(sb, ins.args[0]); sb_append_str(sb, "; memcpy((void*)("); sb_append_str(sb, dstn); sb_append_str(sb, "), &_cst"); sb_append_str(sb, base.i2s(_cst_n)); sb_append_str(sb, ", sizeof(_cst"); sb_append_str(sb, base.i2s(_cst_n)); sb_append_str(sb, ")); }\n");
            g_c_tmpc = g_c_tmpc + 1;
            return;
        }
        c_emit_assign(sb, dstn, ins.args[0]);
        return;
    }
    if (op == tir__TIR_OP_CONST) {
        var dstn: string = c_strip_suf(ins.dst.name);
        // 浮点字面量 inf/-inf/nan：C 没有裸标识符，改用编译期常量表达式（无需 <math.h>）。
        var cv: string = ins.args[0].name;
        if (cv == "inf") { cv = "(1.0/0.0)"; }
        else if (cv == "-inf") { cv = "(-1.0/0.0)"; }
        else if (cv == "nan") { cv = "(0.0/0.0)"; }
        // 任意位宽整数（AWI，N>64）字面量：值存为 little-endian 字节缓冲，经静态字节数组 memcpy 进 dstn 缓冲，
        // 而非标量强转（后者溢出/截断，且 t_sb_append_fmt_big 要的是字节指针）。覆盖十进制/十六/二/八进制与负字面量。
        // ⚠ 判定须含「槽的使用端类型」c_slot_st(dstn)：LLVM 后端把窄立即数（如 `a+1` 的 `1`，const i64）
        //   在 ADD 处隐式 sext 到结果宽（i128），TIR 里该槽的「使用端 st」是 i128 而「定义端 st」仍是 i64。
        //   仅看定义端会漏判 → 槽被退化成 unsigned char* 空指针、CONST 又按标量强转 → 段错误（awi_demo 的 t24）。
        var _cstst: string = tir.tir_st_to_str(ins.st);
        if (c_is_awi_st(_cstst) == false) { _cstst = c_slot_ty_find(dstn); }
        if (c_is_awi_st(_cstst) == false) { _cstst = tir.tir_st_to_str(c_slot_st(dstn, g_cf)); }
        if (c_is_awi_st(_cstst)) {
            var _est: string = _cstst;
            var _nb: i64 = c_awi_size(_est);
            var _bytes: string = c_awi_lit_bytes(cv, _est);
            var _litn: string = base.sb_cat2("_awilit", base.i2s(g_c_tmpc));
            g_c_tmpc = g_c_tmpc + 1;
            sb_append_str(sb, "  { static const unsigned char "); sb_append_str(sb, _litn);
            sb_append_str(sb, "["); sb_append_i64(sb, _nb); sb_append_str(sb, "] = ");
            sb_append_str(sb, _bytes); sb_append_str(sb, "; memcpy((void*)(");
            sb_append_str(sb, dstn); sb_append_str(sb, "), (void*)("); sb_append_str(sb, _litn);
            sb_append_str(sb, "), (size_t)("); sb_append_i64(sb, _nb); sb_append_str(sb, ")); }\n");
            return;
        }
        // ⚠ 用 c_slot_c_ty（而非 tmir.tmir_st_c(c_slot_st)）：后者对「命名类型（枚举）」走 %→unsigned char*
        // 的聚合分支，会把枚举常量 0 误转成 (unsigned char*)(0) → int64_t←指针 编译失败
        // （enum_match_dispatch）。c_slot_c_ty 已借 c_is_enum_ty 把枚举识别为 int64_t。
        sb_append_str(sb, "  "); sb_append_str(sb, dstn); sb_append_str(sb, " = (");
        sb_append_str(sb, c_slot_c_ty(dstn)); sb_append_str(sb, ")(");
        sb_append_str(sb, cv); sb_append_str(sb, ");\n");
        return;
    }
    if (op == tir__TIR_OP_CONST_STR) {
        var dstn: string = c_strip_suf(ins.dst.name);
        var sidx: i64 = tir.tir_atoi(ins.args[0].name);
        var lit: string = "";
        if (sidx >= 0 and sidx < slice_len(g_c_mod.strings) as i64) { lit = g_c_mod.strings[sidx]; }
        if (c_is_agg_base(dstn)) {
            // 聚合基（字节缓冲）：TStr 结构体按字节拷入缓冲（map key/value 等以 const void* 取缓冲）。
            sb_append_str(sb, "  { TStr _csl"); sb_append_str(sb, base.i2s(g_c_tmpc));
            sb_append_str(sb, " = TSTR_LIT(\""); sb_append_str(sb, c_esc_c(lit)); sb_append_str(sb, "\"); memcpy((void*)(");
            sb_append_str(sb, dstn); sb_append_str(sb, "), &_csl"); sb_append_str(sb, base.i2s(g_c_tmpc));
            sb_append_str(sb, ", sizeof(_csl"); sb_append_str(sb, base.i2s(g_c_tmpc)); sb_append_str(sb, ")); }\n");
            g_c_tmpc = g_c_tmpc + 1;
        } else {
            sb_append_str(sb, "  "); sb_append_str(sb, dstn); sb_append_str(sb, " = TSTR_LIT(\"");
            sb_append_str(sb, c_esc_c(lit)); sb_append_str(sb, "\");\n");
        }
        return;
    }
    if (op == tir__TIR_OP_BITCAST) {
        var dstn: string = c_strip_suf(ins.dst.name);
        // 同类型（结构体值）BITCAST：C 不允许结构体走强制转换（"used type 'TStr' where arithmetic
        // or pointer type is required"）→ 退化成 plain 赋值（cli_demo 的 `bitcast %TStr $t145 $t144`）。
        var bcty: string = c_slot_c_ty(dstn);
        if (c_c_ty_is_struct(bcty) and bcty == c_operand_c_ty(ins.args[0])) {
            sb_append_str(sb, "  "); sb_append_str(sb, dstn); sb_append_str(sb, " = ");
            c_emit_val(sb, ins.args[0]); sb_append_str(sb, ";\n");
            return;
        }
        sb_append_str(sb, "  "); sb_append_str(sb, dstn); sb_append_str(sb, " = (");
        sb_append_str(sb, c_slot_c_ty(dstn)); sb_append_str(sb, ")(");
        c_emit_val(sb, ins.args[0]); sb_append_str(sb, ");\n");
        return;
    }
    if (op == tir__TIR_OP_STRUCT_NEW) {
        var dstn: string = c_strip_suf(ins.dst.name);
        var tyname: string = tir.tir_st_to_str(ins.st);   // "%Event"
        var sz: i64 = c_struct_size(tyname);
        sb_append_str(sb, "  unsigned char "); sb_append_str(sb, dstn); sb_append_str(sb, "_buf[");
        sb_append_str(sb, base.i2s(sz)); sb_append_str(sb, "] = {0};\n");
        sb_append_str(sb, "  "); sb_append_str(sb, dstn); sb_append_str(sb, " = (unsigned char*)(");
        sb_append_str(sb, dstn); sb_append_str(sb, "_buf);\n");
        var na2: i64 = slice_len(ins.args) as i64;
        var ai: i64 = 0;
        while (ai < na2) {
            var fo: i64 = c_gep_offset(tyname, ai);
            var fty: string = c_field_type_at(c_find_type_body(tyname), ai);
            // 数组字面量（类型无 body，如 "arr<f64 x 3>" / "[3 x f64]"）：字段类型取数组元素类型，
            // 否则 fty=="" → tir_st_from_str("")==ST_NONE → tmir_st_c 回落 int64_t，
            // 把 1.5 之类浮点字面量截断成 1（dot3 求和 7 而非 8 的根因）。
            if (fty == "" and (c_starts(tyname, "[") or c_is_arr(tyname))) {
                fty = c_array_elem(tyname);
            } else if (fty == "" and c_is_vec(tyname)) {
                fty = c_vec_elem(tyname);
            }
            // 函数引用字段（闭包成员）：写 8B code 指针（无 env 首参者经 thunk）。
            if (c_is_func_ref(ins.args[ai].name)) {
                sb_append_str(sb, "  { void* _csf"); sb_append_str(sb, base.i2s(g_c_tmpc));
                sb_append_str(sb, " = (void*)("); sb_append_str(sb, c_clo_code(ins.args[ai].name));
                sb_append_str(sb, "); memcpy((void*)("); sb_append_str(sb, dstn); sb_append_str(sb, " + ");
                sb_append_str(sb, base.i2s(fo)); sb_append_str(sb, "), &_csf");
                sb_append_str(sb, base.i2s(g_c_tmpc)); sb_append_str(sb, ", sizeof(_csf");
                sb_append_str(sb, base.i2s(g_c_tmpc)); sb_append_str(sb, ")); }\n");
                g_c_tmpc = g_c_tmpc + 1;
                ai = ai + 1;
                continue;
            }
            if (c_starts(fty, "[") or c_is_arr(fty) or c_is_vec(fty)) {
                var fsz: i64 = c_tstr_size(fty);
                sb_append_str(sb, "  memcpy((void*)("); sb_append_str(sb, dstn); sb_append_str(sb, " + ");
                sb_append_str(sb, base.i2s(fo)); sb_append_str(sb, "), (void*)(");
                c_emit_val(sb, ins.args[ai]); sb_append_str(sb, "), (size_t)("); sb_append_str(sb, base.i2s(fsz)); sb_append_str(sb, "));\n");
            } else if (c_starts(fty, "%") and c_starts(fty, "ptr<%") == false) {
                // ⚠ 嵌套聚合字段（struct 内嵌 struct，如 Entity.pos: Position / NpcState.intent_dir: Velocity）：
                //   源是「指向缓冲的指针」(unsigned char*)，须按聚合尺寸 memcpy 缓冲内容进父结构，
                //   否则误落标量分支 → 只拷 8B 指针 → 内嵌结构体读到指针低字节 + 紧邻垃圾
                //   （agent_npc_mind 的 pos.x / agentkit_demo 的物理 Component 全乱的根因）。
                //   注意：ptr<%Foo> 是「指针字段」（8B），须留在标量分支按指针拷贝，不能进此分支。
                // ⚠ 运行库结构体字段（TStr/TSlice/TClosure/TBitStr，其 %TStr 也在 module.types 里、c_struct_size=16）：
                //   源若是「结构值」（TStr 形参/局部值，C 声明为 TStr 而非指针）→ 须取地址 &src 再 memcpy，
                //   否则 `(void*)(memory)` 把结构体值当指针 → 编译错（agent_npc_mind 的 NpcState.memory/last_line）；
                //   仅当源被模型记为「字节缓冲指针」(unsigned char*，如地址槽局部 TStr) 才直接传指针。
                var fsz: i64 = c_struct_size(fty);
                if (fsz <= 0) { fsz = c_tstr_size(fty); }
                if (fsz <= 0) { fsz = 8; }
                var _srcc: string = c_param_c_ty(g_cf, c_strip_suf(ins.args[ai].name));
                // ⚠ c_param_c_ty 对「非形参」返回 "long long" 兜底（不是空串），故必须把 "long long" 也视为
                // 「非形参 → 改用槽声明类型」：否则 TStr 局部（如 agentkit_demo 的 `s = init` 后在 MsgRec
                // 构造里被填入字段）的 _srcc 卡在 "long long" → c_is_runtime_struct_st 判否 → 漏加 & →
                // `memcpy((void*)(t175+0),(void*)(s),16)` 编译错 operand of type 'TStr' 的根因。
                // 改用 c_slot_c_ty 才能拿到真正的 "TStr" 声明类型（运行时结构体按值传递，须取 &src）。
                if (_srcc == "" or _srcc == "long long") { _srcc = c_slot_c_ty(c_strip_suf(ins.args[ai].name)); }
