    }
    if (op == tir__TIR_OP_CALL) {
        var dstn: string = c_strip_suf(ins.dst.name);
        var callee: string = c_strip_suf(ins.args[0].name);
        var cfname: string = c_call_cname(callee);
        var fret_st: string = c_func_ret_st(callee);
