                sb_append_str(sb, " = _tp[0]; int64_t _ii;\n");
                sb_append_str(sb, "    for (_ii = 1; _ii < "); sb_append_i64(sb, _total); sb_append_str(sb, "; _ii++) {\n");
                sb_append_str(sb, "      "); sb_append_str(sb, _ecty); sb_append_str(sb, " _v = _tp[_ii];\n");
                if (p0ty == "treduce_sum") { sb_append_str(sb, "      _acc = _acc + _v;\n"); }
                else if (p0ty == "treduce_mul") { sb_append_str(sb, "      _acc = _acc * _v;\n"); }
                else if (p0ty == "treduce_min") { sb_append_str(sb, "      if (_v < _acc) _acc = _v;\n"); }
                else { sb_append_str(sb, "      if (_v > _acc) _acc = _v;\n"); }
                sb_append_str(sb, "    }\n");
            } else { sb_append_str(sb, " = 0;\n"); }
