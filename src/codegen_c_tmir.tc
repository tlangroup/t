                var _csn_n: i64 = g_c_tmpc;
                sb_append_str(sb, "  { "); sb_append_str(sb, c_tystr_c(fty)); sb_append_str(sb, " _csn"); sb_append_str(sb, base.i2s(_csn_n));
                sb_append_str(sb, " = "); c_emit_val(sb, ins.args[ai]); sb_append_str(sb, "; memcpy((void*)(");
                sb_append_str(sb, dstn); sb_append_str(sb, " + "); sb_append_str(sb, base.i2s(fo));
                sb_append_str(sb, "), &_csn"); sb_append_str(sb, base.i2s(_csn_n)); sb_append_str(sb, ", sizeof(_csn");
                sb_append_str(sb, base.i2s(_csn_n)); sb_append_str(sb, ")); }\n");
