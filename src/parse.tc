// ══════════════════════════════════════════════════════════════════
// src/parse.tc — 编译步骤 2：语法分析
//
// 内容：递归下降 parser（构建扁平 Node 池）、顶层声明解析、
//       前端 lowering（agent 展开、函数子句脱糖）。
// 依赖：base, lex。
// ══════════════════════════════════════════════════════════════════

const base = @import("src.base");
const lex = @import("src.lex");

// 解析期致命错误：登记结构化诊断（带文件/行列）→ 输出 JSON → 退出。
//
// ⚠ 解析器**没有错误恢复**，任何语法错都必须就地终止；但绝不能再裸 `eprint`
//   到 stderr —— stdout 的 JSON 才是机器可读通道，IDE / REPL / `tc check`
//   的消费方只认它。历史上 36 处 parse error 全走裸 eprint，导致语法错在
//   REPL 里**完全静默**（build.log 空、无人读 build.err），也没有行列信息。
//   打印器 `print_json` 已从 sema.tc 下沉到 base.tc，parse 层现可直接调用。
pub fn parse_fatal_at(code: string, msg: string, ti: i64) void {
    var l: i64 = lex.tk_line(ti) as i64;
    var c: i64 = lex.tk_col(ti) as i64;
    var w: i64 = str_len(lex.tk_v(ti)) as i64;
    if (w < 1) { w = 1; }
    base.diag_new(code, "error", msg, base.g_file, l, c, l, c + w);
    base.emit_diags();
    exit(1);
}

// 定位到「当前 token」的致命语法错误（绝大多数站点用这个）。
pub fn parse_fatal(msg: string) void {
    parse_fatal_at("T-PAR-E101", msg, lex.pos);
}

pub fn expect_tok(t: string) string {
    if (lex.cur_t() == t) {
        var idx: i64 = lex.advance_i();
        return lex.tk_v(idx);
    }
    parse_fatal(base.sb_cat4("语法错误：期待 ", t, "，实际读到 ", lex.cur_v()));
    return "";
}

// parseInt(s, 10) 语义：取前导十进制数字
pub fn parse_int_str(s: string) i64 {
    var r: i64 = 0;
    var i: u64 = 0;
    var n: u64 = str_len(s);
    while (i < n) {
        var c: u8 = s[i];
        if (base.is_digit(c) == false) {
            break;
        }
        r = r * 10 + ((c as i64) - 48);
        i = i + 1;
    }
    return r;
}

// 拼接两条 Child 链，返回新头
pub fn list_concat(a: i64, b: i64) i64 {
    if (a < 0) {
        return b;
    }
    if (b < 0) {
        return a;
    }
    var it: i64 = a;
    while (true) {
        var c: Child = base.kids[it];
        if (c.next < 0) {
            c.next = b;
            slice_set(base.kids, it, c);
            break;
        }
        it = c.next;
    }
    return a;
}

// ── 注解解析 ───────────────────────────────────────────────────

pub fn parse_annotation_args() i64 {
    var head: i64 = -1;
    var tail: i64 = -1;
    while (lex.cur_t() != "RParen" && lex.cur_t() != "Eof") {
        var t: string = lex.cur_t();
        var made: i64 = -1;
        if (t == "String") {
            var idx: i64 = lex.advance_i();
            made = base.mk_string(lex.tk_v(idx), -1);
        } else {
        if (t == "Integer") {
            var idx2: i64 = lex.advance_i();
            made = base.mk_number(lex.tk_v(idx2), -1);
        } else {
        if (t == "Identifier") {
            var ih: i64 = -1;
            var it: i64 = -1;
            var cnt: i64 = 1;
            var idx3: i64 = lex.advance_i();
            var id1: i64 = base.mk_ident(lex.tk_v(idx3), -1);
            it = base.list_push(ih, it, id1);
            ih = it;
            while (lex.cur_t() == "Comma") {
                lex.advance_i();
                var v2: string = expect_tok("Identifier");
                var id2: i64 = base.mk_ident(v2, -1);
                it = base.list_push(ih, it, id2);
                cnt = cnt + 1;
            }
            if (cnt == 1) {
                made = id1;
            } else {
                made = base.mk_list(ih, -1);
            }
        } else {
            parse_fatal("invalid annotation argument");
        }}}
        tail = base.list_push(head, tail, made);
        if (head < 0) {
            head = tail;
        }
        if (lex.cur_t() != "RParen") {
            if (lex.cur_t() == "Comma") {
                lex.advance_i();
            }
        }
    }
    return head;
}

pub fn parse_annotations() i64 {
    var head: i64 = -1;
    var tail: i64 = -1;
    // 注解循环只消费 `@名`/`@Export` 形式；`@ <整数>` 是字段 tagID，
    // 必须由 parse_sfield 单独消费，故此处遇 `@` 后接 Integer 即停（留待 tagID 解析）。
    while (lex.cur_t() == "At" && (lex.peek_t(1) == "Identifier")) {
        lex.advance_i();
        var name: string = "";
        var nti: i64 = lex.pos;
        if (lex.cur_t() == "Identifier") {
            var idx: i64 = lex.advance_i();
            name = lex.tk_v(idx);
            nti = idx;
        } else {
            name = expect_tok("Identifier");
            nti = lex.pos - 1;
        }
        if (base.is_lower_snake(name) == false) {
            base.warn_name("T-NAM-W403", base.sb_cat3("annotation name '", name, "' should be lowercase snake_case"), nti, str_len(name) as i64);
        }
        var args_head: i64 = -1;
        if (lex.cur_t() == "LParen") {
            lex.advance_i();
            args_head = parse_annotation_args();
            expect_tok("RParen");
        }
        var id: i64 = base.mk_A(name, args_head, nti);
        tail = base.list_push(head, tail, id);
        if (head < 0) {
            head = tail;
        }
    }
    return head;
}

// ── 类型解析 ───────────────────────────────────────────────────

// >>> GEN:scalar_pred (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
pub fn is_scalar_name(name: string) bool {
    if (name == "u8" || name == "u16" || name == "u32" || name == "u64") {
        return true;
    }
    if (name == "i8" || name == "i16" || name == "i32" || name == "i64") {
        return true;
    }
    if (name == "f16" || name == "f32" || name == "f64") {
        return true;
    }
    // rune：Unicode 码点，内部 i32 描述（见 docs/reference.md §2.4 rune）。
    // 纳入标量族，算术 / 比较 / i32 互转全免费；与 i32 同名但语义独立。
    if (name == "rune") {
        return true;
    }
    // bytes：二进制视图（{ptr, len}），与 string 同布局、类型独立；
    // BytesBuilder：可增长字节缓冲，对应 string 的 StringBuilder。
    if (name == "bytes" || name == "BytesBuilder") {
        return true;
    }
    // 任意位宽整数 `u<N>`（N ∈ [1, 65535]）/`i<N>`（N ∈ [2, 65535]）：位宽即名字尾数。
    // 下限不对称的原因见 base.tc `awi_min_bits`（signed _BitInt(1) 在 C23 非法）。
    // 只在此处（类型位）生效 —— 标识符位不受影响，故编译器源码里大量存在的
    // `i0..i7` 循环变量名不会被误判成类型（已全量核对：它们从不出现在类型位）。
    if (base.is_awi_name(name)) {
        return true;
    }
    return name == "bool" || name == "atom" || name == "fid";
}
// <<< GEN:scalar_pred <<<

pub fn parse_type_inner() i64 {
    var t: string = lex.cur_t();
    // 硬件 SIMD 向量类型 `@Vector(comptime len, BaseT)`（类型位）。
    // 类型位的 `@` 此前完全空闲（注解只在声明前，编译期内建 `@name(...)` 只在表达式位），
    // 故 `@Vector(` 无歧义。`comptime` 前缀可选，仅作文档性强调——长度必须是编译期常量。
    if (t == "At" && lex.peek_t(1) == "Identifier" && lex.tk_v(lex.pos + 1) == "Vector") {
        var vti: i64 = lex.advance_i();            // '@'
        lex.advance_i();                            // 'Vector'
        expect_tok("LParen");
        if (lex.cur_t() == "KwComptime") { lex.advance_i(); }
        var vln: i64 = parse_expr();
        expect_tok("Comma");
        var vel: i64 = parse_type();
        expect_tok("RParen");
        return base.mk_vector(vel, vln, vti);
    }
    // 二维 SIMD 瓦片类型 `@Tile(comptime rows, comptime cols, BaseT, flavor)`（类型位）。
    // 与 @Vector 同理，`@` 在类型位空闲；`comptime` 前缀仅作文档性强调。
    // flavor 为编译期枚举值：`hardware` / `simulate`（识别规则见 sema.tile_resolve）。
    if (t == "At" && lex.peek_t(1) == "Identifier" && lex.tk_v(lex.pos + 1) == "Tile") {
        var tti: i64 = lex.advance_i();            // '@'
        lex.advance_i();                            // 'Tile'
        expect_tok("LParen");
        if (lex.cur_t() == "KwComptime") { lex.advance_i(); }
        var trows: i64 = parse_expr();
        expect_tok("Comma");
        if (lex.cur_t() == "KwComptime") { lex.advance_i(); }
        var tcols: i64 = parse_expr();
        expect_tok("Comma");
        var tel: i64 = parse_type();
        expect_tok("Comma");
        var tfl: i64 = parse_expr();
        expect_tok("RParen");
        return base.mk_tile(tel, trows, tcols, tfl, tti);
    }
    if (t == "KwFunc") {
        lex.advance_i();
        expect_tok("LParen");
        var fphead: i64 = -1;
        var fptail: i64 = -1;
        if (lex.cur_t() != "RParen") {
            while (true) {
                var fpt: i64 = parse_type();
                fptail = base.list_push(fphead, fptail, fpt);
                if (fphead < 0) { fphead = fptail; }
                if (lex.cur_t() == "Comma") { lex.advance_i(); } else { break; }
            }
        }
        expect_tok("RParen");
        // L-04：`->` 返回类型箭头已移除，返回类型紧跟 `:`，不再被编译器接受

        var frt: i64 = parse_type();
        return base.mk_func_type(frt, fphead, -1);
    }
    if (t == "KwMap") {
        lex.advance_i();
        expect_tok("LBracket");
        var kt: i64 = parse_type();
        expect_tok("RBracket");
        var vt: i64 = parse_type();
        var id: i64 = base.mk_map(kt, vt, -1);
        return id;
    }
    if (t == "LBracket") {
        lex.advance_i();
        if (lex.cur_t() == "RBracket") {
            lex.advance_i();
            var el: i64 = parse_type();
            var id2: i64 = base.mk_slice(el, -1);
            return id2;
        }
        // `[_]T`：长度推断占位（Rust 风格）。`_` 在词法上是 Identifier，此处按 token 特判，
        // 不生成长度表达式节点：nb = -1 表示「待推断」，由 sema 的 lower_array_len_infer
        // 在 register_decl 之前按初始化器回填成具体整数节点。
        if (lex.cur_t() == "Identifier" && lex.tk_v(lex.pos) == "_" && lex.peek_t(1) == "RBracket") {
            lex.advance_i();                    // '_'
            lex.advance_i();                    // ']'
            var elw: i64 = parse_type();
            return base.mk_array(elw, -1, -1);
        }
        var ln: i64 = parse_expr();
        expect_tok("RBracket");
        var el2: i64 = parse_type();
        var id3: i64 = base.mk_array(el2, ln, -1);
        return id3;
    }
    if (t == "Star") {
        lex.advance_i();
        var el3: i64 = parse_type();
        var id4: i64 = base.mk_pointer(el3, -1);
        return id4;
    }
    if (t == "Question") {
        lex.advance_i();
        var el4: i64 = parse_type();
        var id5: i64 = base.mk_optional(el4, -1);
        return id5;
    }
    if (t == "KwVoid") {
        lex.advance_i();
        return base.mk_scalar("void", -1);
    }
    if (t == "KwUnit") {
        lex.advance_i();
        // P5：unit 是 void 的过渡别名（同一底层类型，零后端改动）。void 概念保留作兼容。
        return base.mk_scalar("void", -1);
    }
    if (t == "KwString") {
        lex.advance_i();
        return base.mk_scalar("string", -1);
    }
    if (t == "KwStringBuilder") {
        lex.advance_i();
        return base.mk_scalar("StringBuilder", -1);
    }
    if (t == "KwAny") {
        lex.advance_i();
        // comptime 类型模板参数的占位类型；单态化时整体移除，从不进入发射。
        return base.node_new("any");
    }
    if (t == "KwType") {
        lex.advance_i();
        // meta T: type 的「类型之类型」占位；单态化时整体移除，与 any 同语义。
        return base.node_new("type");
    }
    if (t == "Identifier") {
        var idx: i64 = lex.advance_i();
        var name: string = lex.tk_v(idx);
        // 模块限定类型 `A.T`（A = import 别名）：类型位置上 `X.Y` 只可能是模块限定，
        // 故直接记为 named{ sa = T, sb = A }，由 mangle_modules 解析成 A__T。
        if (lex.cur_t() == "Dot" && lex.peek_t(1) == "Identifier") {
            lex.advance_i();
            var qtn: string = expect_tok("Identifier");
            var idq: i64 = base.mk_named(qtn, idx);
            base.node_set_sb((idq as u64), name);
            return idq;
        }
        if (name == "Sym32" || name == "Sym16" || name == "Sym64") {
            expect_tok("LParen");
            var tagv: string = expect_tok("String");
            expect_tok("RParen");
            var bits: i64 = 32;
            if (name == "Sym16") { bits = 16; }
            if (name == "Sym64") { bits = 64; }
            var idsym: i64 = base.mk_sym(tagv, bits, -1);
            return idsym;
        }
        if (name == "Variant") {
            return base.mk_variant(-1);
        }
        // Device 子系统：具名设备指针类型（docs/compiler/device-design.md §3.1 / §7）。
        // `dev_ptr[T]`(global, as=1) / `shared[T]`(as=3) / `local[T]`(as=5)。
        // 复刻 map/flag 的 `Name[...]` 泛型类型形态：标识符后紧跟 `[` 即吃元素类型。
        if (name == "dev_ptr" || name == "shared" || name == "local") {
            if (lex.cur_t() == "LBracket") {
                lex.advance_i();
                var etn: i64 = parse_type();
                expect_tok("RBracket");
                var aspace: i64 = 1;
                if (name == "shared") { aspace = 3; }
                else if (name == "local") { aspace = 5; }
                return base.mk_dev_ptr(etn, aspace, -1);
            }
        }
        if (is_scalar_name(name)) {
            return base.mk_scalar(name, -1);
        }
        var idn: i64 = base.mk_named(name, -1);
        return idn;
    }
    // 匿名元组类型 `.{T1, T2, ...}`：合成具名 struct（位置字段 `_0`/`_1`/...），
    // 规范名由元素类型推导，保证同构元组类型共享同一 struct 声明。
    if (t == "Dot" && lex.peek_t(1) == "LBrace") {
        lex.advance_i();                          // Dot
        expect_tok("LBrace");
        var elems: []i64 = [];
        while (lex.cur_t() != "RBrace" && lex.cur_t() != "Eof") {
            var et: i64 = parse_type();
            append(elems, et);
            if (lex.cur_t() == "Comma") {
                lex.advance_i();
            } else {
                break;
            }
        }
        expect_tok("RBrace");
        var sname: string = synth_tuple_type_name(elems);
        if (tuple_struct_exists(sname) == false) {
            var fh: i64 = -1;
            var fht: i64 = -1;
            var idx: i64 = 0;
            while (idx < slice_len(elems) as i64) {
                var fid: i64 = base.node_new("F");
                base.node_set_sa((fid as u64), base.sb_cat2("_", base.i2s(idx)));
                base.node_set_na((fid as u64), elems[idx]);
                base.node_set_ib((fid as u64), -1);   // S4 §0.14.7 SoA：取代 `fnn.ib`（下方 slice_set 回写生效）
                base.node_set_la((fid as u64), -1);
                base.node_set_nb((fid as u64), -1);
                fht = base.list_push(fh, fht, fid);
                if (fh < 0) {
                    fh = fht;
                }
                idx = idx + 1;
            }
            var sd: i64 = base.mk_StructDecl(sname, "", "", false, false, -1, fh, -1);
            append(lex.decl_list, sd);
        }
        return base.mk_named(sname, -1);
    }
        parse_fatal("expected type");
        return -1;
    }

// `T?` 后缀可选类型糖（与 `?T` 前缀等价）：先解析基类型，尾部每个 `?` 再包一层 optional。
// `?T` 前缀分支在 parse_type_inner 内已直接产出 optional 节点，不在此重复包装。
pub fn parse_type() i64 {
    var t0: i64 = parse_type_inner();
    while (lex.cur_t() == "Question") {
        lex.advance_i();
        t0 = base.mk_optional(t0, -1);
    }
    return t0;
}

// ── 表达式解析（优先级爬升，逐层照抄 tc0）─────────────────────

pub fn mk_bin(op: string, left: i64, right: i64, ti: i64) u64 {
    var id: i64 = base.mk_binary(op, left, right, ti);
    return id;
}

pub fn parse_expr() i64 {
    return parse_assign_expr();
}

// 管道级（L0，最低二元级，全左结合）—— 包在 parse_or 外层。
// 既有 10 级塔层级与顺序一字不变（L-03「塔只向下扩展、不重排」）。
// 三个算子同级：`|->` 映射 / `|>?` 过滤 / `|>` 多态管道。
pub fn parse_pipe() i64 {
    var left: i64 = parse_in();
    while (lex.cur_t() == "PipeMap" || lex.cur_t() == "PipeFilter" || lex.cur_t() == "PipeApply") {
        var pk: string = lex.cur_t();
        var ti: i64 = lex.advance_i();
        var right: i64 = parse_in();
        if (pk == "PipeMap") {
            left = base.mk_pipe_map(left, right, ti);
        } else if (pk == "PipeFilter") {
            left = base.mk_pipe_filter(left, right, ti);
        } else {
            left = base.mk_pipe_apply(left, right, ti);
        }
    }
    return left;
}

// ── 区间字面量（M-range）───────────────────────────────────────
// 塔层新增两级，夹在管道级（L0）与逻辑或级（L1）之间：
//
//   assign → pipe → in → range → or → … → primary
//
// 放在管道**内侧**是刻意的：`0..10 |> f` 必须读成 `(0..10) |> f`，
// 而不是 `0..(10 |> f)`；放在逻辑或**外侧**则让 `a..b` 的端点可以是任意
// 普通表达式（`0..n*2`、`lo..arr[i]`）而无需加括号。
//
// 端点缺省的判定：`..` 之后若紧跟这些「表达式不可能开始」的 token，
// 就认定右端省略（`a..`、`..`）。`FatArrow` / `KwWhen` 是为 match 臂
// （`5.. => ...`、`1..9 when p => ...`）准备的。
pub fn range_end_omitted() bool {
    var t: string = lex.cur_t();
    if (t == "RBracket" || t == "RParen" || t == "RBrace") { return true; }
    if (t == "Comma" || t == "Semicolon" || t == "Eof") { return true; }
    if (t == "FatArrow" || t == "KwWhen") { return true; }
    if (t == "LBrace") { return true; }   // `for (i in 0..) { }` 的循环体左花括号
    return false;
}

pub fn parse_range() i64 {
    // 前缀形态：`..b` / `..=b` / `..`（左端省略）
    if (lex.cur_t() == "DotDot" || lex.cur_t() == "DotDotEq") {
        var pincl: bool = lex.cur_t() == "DotDotEq";
        var pti: i64 = lex.advance_i();
        var phi: i64 = -1;
        if (range_end_omitted() == false) { phi = parse_or(); }
        if (pincl && phi < 0) {
            parse_fatal_at("T-RNG-E874", "`..=` 是闭合区间，必须给出右端点（想要开放右端请用 `..`）", pti);
        }
        return base.mk_range(-1, phi, pincl, pti);
    }
    var left: i64 = parse_or();
    if (lex.cur_t() == "DotDot" || lex.cur_t() == "DotDotEq") {
        var incl: bool = lex.cur_t() == "DotDotEq";
        var ti: i64 = lex.advance_i();
        var hi: i64 = -1;
        if (range_end_omitted() == false) { hi = parse_or(); }
        if (incl && hi < 0) {
            parse_fatal_at("T-RNG-E874", "`..=` 是闭合区间，必须给出右端点（想要开放右端请用 `..`）", ti);
        }
        return base.mk_range(left, hi, incl, ti);
    }
    return left;
}

// 成员测试级：`x in <range>` → bool。右操作数当前只接受区间字面量，
// 由 sema 就地降解为 `(x >= lo && x <= hi)`，两个后端永远看不到 `in`。
// 与 `for (x in xs)` 零冲突：for 头部在调用 parse_expr **之前**已自行吃掉 `in`。
// 集合合并级 `++`（§15.6）：bitstr/Slice/String/... 合并，与数值 `+` 解耦。
// 夹在 in 级与 range 级之间（塔只向下扩展，不重排）；`++` 优先级低于 `+`/`<<`。
pub fn parse_concat() i64 {
    var left: i64 = parse_range();
    while (lex.cur_t() == "PlusPlus") {
        var ti: i64 = lex.advance_i();
        var right: i64 = parse_range();
        left = base.mk_binary("Concat", left, right, ti);
    }
    return left;
}

pub fn parse_in() i64 {
    var left: i64 = parse_concat();
    while (lex.cur_t() == "KwIn") {
        var ti: i64 = lex.advance_i();
        var right: i64 = parse_range();
        left = base.mk_binary("in", left, right, ti);
    }
    return left;
}

// 位串字面量 / 模式：`<<val:W, val/bitstr, ...>>`。
// pat=false → 表达式位（kind "bitstr"）；pat=true → match 模式位（kind "bitstr_pat"，段内 ident 即绑定）。
// 段：val[:Width][/big|/little] 或 val/bitstr（变长尾段，须为最后一段）。
pub fn parse_bitstr_lit(pat: bool) i64 {
    var ti0: i64 = lex.advance_i();   // 吃掉 ShiftLeft
    var h: i64 = -1;
    var t: i64 = -1;
    if (lex.cur_t() != "ShiftRight") {
        while (true) {
            var val: i64 = parse_primary();
            var width: i64 = -1;
            var endian: string = "";
            var rest: bool = false;
            if (lex.cur_t() == "Colon") {
                lex.advance_i();
                width = parse_primary();
            }
            if (lex.cur_t() == "Slash") {
                lex.advance_i();
                if (lex.cur_t() != "Identifier") {
                    parse_fatal_at("T-BIT-E513", "位串段 `/` 后须为 bitstr/big/little 说明符", lex.pos);
                }
                var spi: i64 = lex.advance_i();
                var sp: string = lex.tk_v(spi);
                if (sp == "bitstr") { rest = true; }
                else if (sp == "big" || sp == "little") { endian = sp; }
                else { parse_fatal_at("T-BIT-E513", base.sb_cat3("未知位串说明符 `", sp, "`"), spi); }
            }
            var seg: i64 = base.mk_bitstr_seg(val, width, endian, rest, -1);
            t = base.list_push(h, t, seg);
            if (h < 0) { h = t; }
            if (lex.cur_t() == "Comma") { lex.advance_i(); continue; }
            break;
        }
    }
    if (lex.cur_t() != "ShiftRight") {
        parse_fatal_at("T-BIT-E514", "位串字面量须以 `>>` 闭合", ti0);
    }
    lex.advance_i();
    if (pat) { return base.mk_bitstr_pat(h, -1); }
    return base.mk_bitstr(h, -1);
}

pub fn parse_assign_expr() i64 {
    var left: i64 = parse_pipe();
    if (lex.cur_t() == "Assign") {
        var ti: i64 = lex.advance_i();
        var right: i64 = parse_assign_expr();
        var id: i64 = base.mk_assign("=", left, right, ti);
        return id;
    }
    return left;
}


// 语义胶水：前缀一元运算符构造（fold=pre 生成代码调用，tc.tc 手写保持于 GEN:parser_rules 区间外）
pub fn mk_un(op: string, operand: i64, ti: i64) u64 {
    var id: i64 = base.mk_unary(op, operand, ti);
    return id;
}

pub fn parse_post_member(e: i64, ti: i64) i64 {
    // 元组索引 `.0`/`.1`/...：Dot 已被调用方消费，当前 token 为整数 → 字段名 `_N`。
    if (lex.cur_t() == "Integer") {
        var dn: string = lex.tk_v(lex.advance_i());
        var id: i64 = base.mk_member(base.sb_cat2("_", dn), e, ti);
        return id;
    }
    var member: string = expect_tok("Identifier");
    var id: i64 = base.mk_member(member, e, ti);
    return id;
}

pub fn parse_post_index(e: i64, ti: i64) i64 {
    var index: i64 = parse_expr();
    expect_tok("RBracket");
    var id: i64 = base.mk_index(e, index, ti);
    return id;
}

// format 出现开关：置位后 infer 才会对调用实参子树做补扫（详见 fmt_scan_subtree 的
// 长注释）。⚠ M55 漏了置位，导致 `sb_append_str(b, format(...))` 这类**嵌套**用法
// 一路漏到发射期变成 `; UNSUPPORTED call format`；M57 在这里补上。
// 置位点选在建 call 节点时，方法式 `"...".format(x)` 与函数式 `format("...", x)` 同时覆盖。
pub var g_has_format: bool;

// match 臂 body 解析期间置位：阻止 body 的 postfix `.` 贪婪吞掉下一个臂的 `.X =>` 模式
//（`.X` 看起来像 `obj.field`）。详见 parse_postfix 的防贪婪判断。
pub var g_in_match_body: bool;
// 模式位标记：parse_struct_lit 据其判定 `.{a,b}` / `Name{a,b}` 是否为位置式模式
// （元素按列表下标绑定到结构第 i 个字段）。仅在 match 模式解析期间为真。
pub var g_in_match_pat: bool;

pub fn parse_post_call(e: i64, ti: i64) i64 {
    if (base.node_sa((e as u64)) == "format" && (base.node_kind((e as u64)) == "ident" || base.node_kind((e as u64)) == "member")) { g_has_format = true; }
    var head: i64 = -1;
    var tail: i64 = -1;
    while (lex.cur_t() != "RParen" && lex.cur_t() != "Eof") {
        var arg: i64 = parse_expr();
        tail = base.list_push(head, tail, arg);
        if (head < 0) {
            head = tail;
        }
        if (lex.cur_t() == "Comma") {
            lex.advance_i();
        } else {
            break;
        }
    }
    expect_tok("RParen");
    var id: i64 = base.mk_call(e, head, ti);
    return id;
}

pub fn parse_post_cast(e: i64, ti: i64) i64 {
    var tt: i64 = parse_type();
    var id: i64 = base.mk_cast(e, tt, ti);
    return id;
}

pub fn starts_with_0x(s: string) bool {
    if (str_len(s) < 2) {
        return false;
    }
    if (s[0] != 48) {
        return false;
    }
    return s[1] == 120 || s[1] == 88;
}

pub fn starts_with_0o(s: string) bool {
    if (str_len(s) < 2) {
        return false;
    }
    if (s[0] != 48) {
        return false;
    }
    return s[1] == 111 || s[1] == 79;
}

pub fn starts_with_0b(s: string) bool {
    if (str_len(s) < 2) {
        return false;
    }
    if (s[0] != 48) {
        return false;
    }
    return s[1] == 98 || s[1] == 66;
}

pub fn looks_like_struct_lit() bool {
    if (lex.peek_t(1) == "RBrace") {
        return true;
    }
    if (lex.peek_t(1) == "Identifier" && lex.peek_t(2) == "Colon") {
        return true;
    }
    // 新增：`.x = ...` 形式的具名字面量字段（`Point{ .x = 10 }`）也视为结构体字面量。
    if (lex.peek_t(1) == "Dot" && lex.peek_t(2) == "Identifier" && lex.peek_t(3) == "Assign") {
        return true;
    }
    // 新增：变体构造字面量 `V { .Case }` / `V { .Case(args) }`（`.Case` 后非 `=`）。
    if (lex.peek_t(1) == "Dot" && lex.peek_t(2) == "Identifier" && lex.peek_t(3) != "Assign") {
        return true;
    }
    return false;
}

// ── 元组（tuple）辅助 ───────────────────────────────────────────
// 元组 = 带位置字段（自动命名 `_0`/`_1`/...）的具名结构体。匿名元组类型 `.{T1,T2}` 与
// 匿名元组字面量 `.{e1,e2}` 都合成一个 StructDecl 并据此命名，保证同构元组共享同一类型。

// 已合成的元组 StructDecl 是否存在（按名字扫描 decl_list，注册期前亦可见）。
pub fn tuple_struct_exists(sname: string) bool {
    var i: i64 = 0;
    while (i < slice_len(lex.decl_list) as i64) {
        if (base.node_kind((lex.decl_list[i] as u64)) == "StructDecl" && base.node_sa((lex.decl_list[i] as u64)) == sname) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// 从「类型节点」列表推导匿名元组类型的规范名（须与 sema 侧 ti_mangle 永远一致）。
pub fn type_node_mangle(tn: i64) string {
    var k: string = base.node_kind((tn as u64));
    if (k == "scalar") {
        return base.node_sa((tn as u64));
    }
    if (k == "named") {
        if (base.node_sb((tn as u64)) != "" && base.node_sb((tn as u64)) != "?") {
            return base.sb_cat3(base.node_sb((tn as u64)), ".", base.node_sa((tn as u64)));
        }
        return base.node_sa((tn as u64));
    }
    if (k == "slice") {
        return base.sb_cat2("Sl_", type_node_mangle(base.node_na((tn as u64))));
    }
    if (k == "pointer") {
        return base.sb_cat2("Pt_", type_node_mangle(base.node_na((tn as u64))));
    }
    if (k == "array") {
        var len: string = "?";
        if (base.node_nb((tn as u64)) >= 0) {
            len = base.i2s(base.node_nb((tn as u64)));
        }
        return base.sb_cat3("Ar_", len, type_node_mangle(base.node_na((tn as u64))));
    }
    if (k == "optional") {
        return base.sb_cat2("Op_", type_node_mangle(base.node_na((tn as u64))));
    }
    if (k == "map") {
        return base.sb_cat4("Map_", type_node_mangle(base.node_na((tn as u64))), "_", type_node_mangle(base.node_nb((tn as u64))));
    }
    return base.sb_cat2(k, "_");
}

pub fn synth_tuple_type_name(elems: []i64) string {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "_Tup_");
    var i: i64 = 0;
    while (i < slice_len(elems) as i64) {
        sb_append_str(sb, type_node_mangle(elems[i]));
        i = i + 1;
    }
    return sb_to_str(sb);
}

pub fn parse_struct_lit(type_name: string, ti: i64) i64 {
    lex.advance_i();
    var head: i64 = -1;
    var tail: i64 = -1;
    // 位置式模式（match 模式位，g_in_match_pat）：`.{a, b}` / `Name{a, b}` —— 元素按列表
    // 下标绑定到结构第 i 个字段；元素为绑定标识符 / 字面量 / `_` 通配（#4 §8.2）。
    // 与具名字段形式（`x:` / `.x =`）互斥：非具名字段形式即视为位置式。
    var positional: bool = false;
    if (g_in_match_pat) {
        var c0: string = lex.cur_t();
        var named_form: bool = (c0 == "Identifier" && lex.peek_t(1) == "Colon") ||
                               (c0 == "Dot" && lex.peek_t(1) == "Identifier" && lex.peek_t(2) == "Assign");
        if (named_form == false) { positional = true; }
    }
    if (positional) {
        while (lex.cur_t() != "RBrace" && lex.cur_t() != "Eof") {
            var val: i64 = -1;
            if (lex.cur_t() == "_") {            // 通配 `_`：占位、不绑定
                lex.advance_i();
                val = base.mk_ident("_", -1);
            } else {
                val = parse_expr();              // 绑定标识符（ident 节点）→ sema 据字段类型绑定；字面量→比对
            }
            var fid: i64 = base.mk_FV("", val, -1);
            tail = base.list_push(head, tail, fid);
            if (head < 0) { head = tail; }
            if (lex.cur_t() == "Comma") { lex.advance_i(); } else { break; }
        }
        expect_tok("RBrace");
        // ⚠ ia 保持默认（非 1）：位置式是模式不是元组构造，sema 据 scrutinee 类型解构，
        // 不可触发 value 路径的「据元素类型合成 struct」逻辑（parse.tc:7618）。
        return base.mk_struct_lit(type_name, head, ti);
    }
    // 前导点（省略类型名）且首个元素不是具名字段（`x:` 或 `.x =`）→ 匿名元组字面量：
    // 元素按位置存入 `_0`/`_1`/...，标记 ia=1，由 sema 据元素类型合成具名 struct。
    var is_tuple: bool = false;
    if (type_name == "" && lex.cur_t() != "RBrace" && lex.cur_t() != "Eof") {
        var ft0: string = lex.cur_t();
        if (ft0 == "Identifier" && lex.peek_t(1) == "Colon") {
            is_tuple = false;
        } else if (ft0 == "Dot" && lex.peek_t(1) == "Identifier" && lex.peek_t(2) == "Assign") {
            is_tuple = false;
        } else {
            is_tuple = true;
        }
    }
    if (is_tuple) {
        var idx: i64 = 0;
        while (lex.cur_t() != "RBrace" && lex.cur_t() != "Eof") {
            var val: i64 = parse_expr();
            var fname: string = base.sb_cat2("_", base.i2s(idx));
            var fid: i64 = base.mk_FV(fname, val, -1);
            tail = base.list_push(head, tail, fid);
            if (head < 0) {
                head = tail;
            }
            idx = idx + 1;
            if (lex.cur_t() == "Comma") {
                lex.advance_i();
            } else {
                break;
            }
        }
        expect_tok("RBrace");
        var id: i64 = base.mk_struct_lit("", head, ti);
        // ⚠ 元组标记只能落在标量槽 ia：la/lb/lc 是 kids 链表头，sema 的 mb_walk /
        //    meta_walk 等通用遍历会对它们做 mb_walk_list 递归展开，存标量 1 会导致
        //    遍历任意 kids 链并无限递归（编译器栈溢出 / 退出码 127）。
        base.node_set_ia((id as u64), 1);   // 元组字面量标记（struct_lit 其他路径 ia 恒为 -1）
        return id;
    }
    // 变体构造字面量 `V { .Case }` / `V { .Case(args) }`：首个字段位出现 `.Case` 且其后
    // 不是 `=`（与具名字段 `.x = v` 区分），即视为变体 case 构造（变体恒单构造子，仅一个）。
    // 脱糖交由 sema（variant_lit → <V>_from_<C>(args) 调用，复用既有 V_from_C 发射路径）。
    if (lex.cur_t() == "Dot" && lex.peek_t(1) == "Identifier" && lex.peek_t(2) != "Assign") {
        return parse_variant_lit(type_name, ti);
    }
    // 具名字段：接受旧式 `x: v` 与新式 `.x = v`（两者并存以保自举不动点）。
    while (lex.cur_t() != "RBrace" && lex.cur_t() != "Eof") {
        var fname: string;
        if (lex.cur_t() == "Dot" && lex.peek_t(1) == "Identifier" && lex.peek_t(2) == "Assign") {
            lex.advance_i();                       // 消费 Dot
            fname = expect_tok("Identifier");
            expect_tok("Assign");
        } else {
            fname = expect_tok("Identifier");
            expect_tok("Colon");
        }
        var val: i64 = parse_expr();
        var fid: i64 = base.mk_FV(fname, val, -1);
        tail = base.list_push(head, tail, fid);
        if (head < 0) {
            head = tail;
        }
        if (lex.cur_t() == "Comma") {
            lex.advance_i();
        } else {
            break;
        }
    }
    expect_tok("RBrace");
    var id: i64 = base.mk_struct_lit(type_name, head, ti);
    return id;
}

// 变体构造字面量 `V { .Case }` / `V { .Case(args) }`：解析出变体类型名（type_name）、case 名
// （sa 存于节点 sb）、可选载荷实参链表（na）。sema 据节点重写为 `<V>_from_<C>(args)` 调用，
// 复用既有变体构造器发射路径（双后端零改动）。变体恒单构造子，故 `}` 后不允许更多字段。
pub fn parse_variant_lit(type_name: string, ti: i64) i64 {
    lex.advance_i();                                    // 吃掉 Dot
    var cti: i64 = lex.advance_i();                     // 吃掉 case 名 Identifier
    var cname: string = lex.tk_v(cti);
    var args: i64 = -1;
    if (lex.cur_t() == "LParen") {
        lex.advance_i();                                // 吃掉 LParen
        var head: i64 = -1;
        var tail: i64 = -1;
        if (lex.cur_t() != "RParen") {
            while (lex.cur_t() != "RParen" && lex.cur_t() != "Eof") {
                var a: i64 = parse_expr();
                tail = base.list_push(head, tail, a);
                if (head < 0) { head = tail; }
                if (lex.cur_t() == "Comma") { lex.advance_i(); } else { break; }
            }
        }
        expect_tok("RParen");
        args = head;
    }
    expect_tok("RBrace");
    var id: i64 = base.node_new("variant_lit");
    base.node_set_sa((id as u64), type_name);   // 变体类型名（如 "List"）
    base.node_set_sb((id as u64), cname);                                      // case 名（如 "Nil" / "One"）
    base.node_set_na((id as u64), args);   // 载荷实参链表头（无参为 -1）
    base.node_at(id, ti);
    return id;
}

pub fn parse_map_lit(ti: i64) i64 {
    var head: i64 = -1;
    var tail: i64 = -1;
    while (lex.cur_t() != "RBracket" && lex.cur_t() != "Eof") {
        var k: i64 = parse_expr();
        expect_tok("Colon");
        var v: i64 = parse_expr();
        var eid: i64 = base.mk_EN(k, v, -1);
        tail = base.list_push(head, tail, eid);
        if (head < 0) {
            head = tail;
        }
        if (lex.cur_t() == "Comma") {
            lex.advance_i();
        } else {
            break;
        }
    }
    expect_tok("RBracket");
    var id: i64 = base.mk_map_lit(head, ti);
    return id;
}

pub fn parse_array_lit(ti: i64) i64 {
    var is_maplit: bool = lex.cur_t() == "Identifier" || lex.cur_t() == "String" || lex.cur_t() == "Integer";
    if (is_maplit && lex.peek_t(1) == "Colon") {
        return parse_map_lit(ti);
    }
    var head: i64 = -1;
    var tail: i64 = -1;
    while (lex.cur_t() != "RBracket" && lex.cur_t() != "Eof") {
        var e: i64 = parse_expr();
        tail = base.list_push(head, tail, e);
        if (head < 0) {
            head = tail;
        }
        if (lex.cur_t() == "Comma") {
            lex.advance_i();
        } else {
            break;
        }
    }
    expect_tok("RBracket");
    var id: i64 = base.mk_array_lit(head, ti);
    return id;
}

// `-` 紧跟整数 token 时由 parse_unary 置位、由 parse_prim_int 读后即清。
// 只为一件事：让 `iN::MIN`（数值主体恰为 2^(N-1)）可写，见 reference.md §2.4。
pub var g_lit_neg: bool = false;

// primary 胶水 helper（fold=prim 骨架已消费分发 token，ti 为其下标）
pub fn parse_prim_int(ti: i64) i64 {
    var neg: bool = g_lit_neg;
    g_lit_neg = false;

    var raw: string = lex.tk_v(ti);
    var sfx: string = base.lit_suffix_of(raw);
    var val: string = base.lit_body_of(raw);
    var radix: i64 = 10;
    if (starts_with_0x(val)) {
        radix = 16;
    } else if (starts_with_0b(val)) {
        radix = 2;
    } else if (starts_with_0o(val)) {
        radix = 8;
    }

    // 取值范围自检。
    // 任意位宽整数：词法器不再以 u64 为硬上界拒绝字面量——无后缀时字面量
    // 将按上下文推断为足够宽的类型；有后缀时仅对「≤64 位窄后缀」做范围校验，
    // 宽后缀（>64 位）无法用 u64 cap 表示，交给 sema/codegen 按目标类型处理。
    // `iN` 的上界 2^(N-1) 仅在紧邻前置 `-` 时可取到（即 iN::MIN）。
    var mag: u64 = base.lit_val_u64(val);
    if (str_len(sfx) > 0) {
        var sw: i64 = base.num_suffix_bits(sfx);
        if (sw >= 2 && sw <= 64) {
            var cap: u64 = base.lit_suffix_max(sfx);
            var over: bool = base.g_lit_overflow || mag > cap;
            if (over == false && base.num_suffix_is_signed(sfx) && mag == cap && neg == false) {
                over = true;
            }
            if (over) {
                diag_lit_range(ti, raw,
                    base.sb_cat3("整数字面量超出 `", sfx, "` 可表示范围"));
            }
        }
        // 宽后缀（sw > 64）或未知后缀：范围由 sema/codegen 按目标类型校验
    }
    // 无后缀：跳过 u64 上界检查（字面量将按上下文推断为足够宽的类型）

    var id: i64 = base.mk_int(val, radix, ti);
    if (str_len(sfx) > 0) {
        base.node_set_sb((id as u64), sfx);
    }
    return id;
}

pub fn diag_lit_range(ti: i64, raw: string, msg: string) void {
    base.diag_new("T-LEX-E006", "error",
        base.sb_cat3(msg, "：", raw),
        base.g_file, lex.tk_line(ti) as i64, lex.tk_col(ti) as i64,
        lex.tk_line(ti) as i64, (lex.tk_col(ti) + str_len(raw)) as i64);
}

// 浮点后缀不走 `Node.sb`，而是脱糖成 `as f32` 显式转换：LLVM 的 `float` 常量
// 要求字面量在 f32 中**精确可表示**（`float 0.1` 会被 IR 解析器拒绝），
// 保留 f64 常量 + `fptrunc` 才是两个后端都成立的写法。f64 后缀是恒等，直接丢弃。
pub fn parse_prim_float(ti: i64) i64 {
    var raw: string = lex.tk_v(ti);
    // IEEE-754 特殊值：文本原样存进 `float` 节点，后端各自翻译
    // （C → INFINITY / NAN；LLVM → 0x7FF0.. / 0x7FF8.. 位模式）。
    if (raw == "inf" || raw == "nan") {
        return base.mk_float(raw, ti);
    }
    var sfx: string = base.lit_suffix_of(raw);
    var id: i64 = base.mk_float(base.lit_body_of(raw), ti);
    if (sfx == "f32") {
        return base.mk_cast(id, base.mk_scalar("f32", ti), ti);
    }
    return id;
}

pub fn parse_prim_str(ti: i64) i64 {
    var id: i64 = base.mk_string(lex.tk_v(ti), ti);
    return id;
}

pub fn parse_prim_true(ti: i64) i64 {
    var id: i64 = base.mk_bool(true, ti);
    return id;
}

pub fn parse_prim_false(ti: i64) i64 {
    var id: i64 = base.mk_bool(false, ti);
    return id;
}

pub fn parse_prim_null(ti: i64) i64 {
    var id: i64 = base.mk_null(ti);
    return id;
}

pub fn parse_prim_ident(ti: i64) i64 {
    var name: string = lex.tk_v(ti);
    if (name == "type_info" && lex.cur_t() == "LParen") {
        lex.advance_i();
        var tn_tok: string = expect_tok("Identifier");
        expect_tok("RParen");
        var id: i64 = base.node_new("typeinfo");
        base.node_set_sa((id as u64), tn_tok);
        return id;
    }
    if (lex.cur_t() == "LBrace" && looks_like_struct_lit()) {
        return parse_struct_lit(name, ti);
    }
    // 模块限定结构体字面量 `A.T{ ... }`：记为 struct_lit{ sa = T, sb = A }，
    // 由 mangle_modules 解析成 A__T。判定条件与 looks_like_struct_lit 对齐（`{}` 或 `{ ident:`）。
    if (lex.cur_t() == "Dot" && lex.peek_t(1) == "Identifier" && lex.peek_t(2) == "LBrace") {
        var ok_lit: bool = false;
        if (lex.peek_t(3) == "RBrace") { ok_lit = true; }
        if (lex.peek_t(3) == "Identifier" && lex.peek_t(4) == "Colon") { ok_lit = true; }
        if (ok_lit) {
            lex.advance_i();
            var qtn: string = expect_tok("Identifier");
            var slid: i64 = parse_struct_lit(qtn, ti);
            base.node_set_sb((slid as u64), name);
            return slid;
        }
    }
    var id: i64 = base.mk_ident(name, ti);
    return id;
}

pub fn parse_prim_paren(ti: i64) i64 {
    // P5：空括号 `()` 是 unit 字面量（值位置的无值占位）。
    if (lex.cur_t() == "RParen") {
        lex.advance_i();
        var u: i64 = base.node_new("unit_lit");
        base.node_at(u, ti);
        return u;
    }
    var inner: i64 = parse_expr();
    expect_tok("RParen");
    var id: i64 = base.mk_paren(inner, ti);
    return id;
}

pub fn parse_prim_array(ti: i64) i64 {
    return parse_array_lit(ti);
}

// ── 语句解析 ───────────────────────────────────────────────────

pub fn parse_block() i64 {
    expect_tok("LBrace");
    var head: i64 = -1;
    var tail: i64 = -1;
    while (lex.cur_t() != "RBrace" && lex.cur_t() != "Eof") {
        var s: i64 = parse_statement();
        if (s >= 0) {
            tail = base.list_push(head, tail, s);
            if (head < 0) {
                head = tail;
            }
        }
    }
    expect_tok("RBrace");
    return head;
}

pub fn parse_local_var(is_const: bool, is_export: bool) i64 {
    var ti: i64 = lex.advance_i();
    var name: string = expect_tok("Identifier");
    var nti: i64 = lex.pos - 1;
    var tn: i64 = -1;
    if (lex.cur_t() == "Colon") {
        lex.advance_i();
        tn = parse_type();
    }
    var init: i64 = -1;
    if (lex.cur_t() == "Assign") {
        lex.advance_i();
        init = parse_expr();
    }
    expect_tok("Semicolon");
    if (is_const) {
        base.validate_const_name(name, nti);
    } else {
        base.validate_var_name(name, nti);
    }
    var id: i64 = base.mk_var_decl(name, is_const, tn, init, ti);
    // 模块系统（M-Module）：pub 只能修饰顶层声明；局部/嵌套变量加 pub → T-MOD-E556
    if (is_export) {
        base.node_set_bc((id as u64), true);   // S4 §0.14.7 SoA：取代 `nodes[id].bc = true`
        fc_err("T-MOD-E556", "pub 只能修饰顶层声明，不能修饰局部/嵌套变量", id);
    }
    return id;
}

// `auto 名字 = 初值;` —— 历史写法，现为 `let`（动态常量）的**弃用别名**。
// 语义完全等同 `let`：immutable（ba=true）+ is_let 标记（bb=true）；
// 类型由初始化器在检查期推断并回填 n.na（三关键字模型）。
pub fn parse_auto_stmt() i64 {
    var ti: i64 = lex.advance_i();
    var name: string = expect_tok("Identifier");
    if (lex.cur_t() == "Colon") {
        parse_fatal("'auto' 推断变量不可标注类型，直接写 `auto 名字 = 初值;` 或改用 `let 名字 = 初值;`");
    }
    if (lex.cur_t() != "Assign") {
        parse_fatal("'auto' 变量必须有初始化器 `auto 名字 = 初值;`");
    }
    lex.advance_i();
    var init: i64 = parse_expr();
    expect_tok("Semicolon");
    var aid: i64 = base.mk_var_decl(name, true, -1, init, ti);  // ba=true：动态常量不可变
    base.node_set_bb((aid as u64), true);   // 标记 is_let（动态常量）；检查期从初始化器推断类型（S4 §0.14.7 SoA 侧表写）
    return aid;
}

pub fn parse_expr_or_assign_stmt() i64 {
    var ti: i64 = lex.pos;
    var e: i64 = parse_expr();
    var t: string = lex.cur_t();
    var is_assign: bool = false;
    if (t == "Assign" || t == "PlusAssign" || t == "MinusAssign" || t == "StarAssign") {
        is_assign = true;
    }
    if (t == "SlashAssign" || t == "PercentAssign" || t == "BitAndAssign" || t == "BitOrAssign") {
        is_assign = true;
    }
    if (t == "BitXorAssign" || t == "ShlAssign" || t == "ShrAssign") {
        is_assign = true;
    }
    if (is_assign) {
        var oi: i64 = lex.advance_i();
        var op: string = lex.tk_v(oi);
        var val: i64 = parse_expr();
        expect_tok("Semicolon");
        var id: i64 = base.mk_assignment(op, e, val, ti);
        return id;
    }
    expect_tok("Semicolon");
    var id2: i64 = base.mk_expr(e, ti);
    return id2;
}

// ── statement 分发胶水（fold=disp 目标；自行消费引导 token，GEN 区外）──

pub fn parse_break_stmt() i64 {
    var tb: i64 = lex.advance_i();
    var val: i64 = -1;
    if (lex.cur_t() != "Semicolon") {
        val = parse_expr();
    }
    expect_tok("Semicolon");
    var idb: i64 = base.mk_break(val, tb);
    return idb;
}

pub fn parse_continue_stmt() i64 {
    var tc: i64 = lex.advance_i();
    expect_tok("Semicolon");
    var idc: i64 = base.mk_continue(tc);
    return idc;
}

pub fn parse_defer_stmt() i64 {
    var td: i64 = lex.advance_i();
    var body: i64 = parse_block();
    var id: i64 = base.mk_defer(body, td);
    return id;
}

pub fn parse_comptime_stmt() i64 {
    var tm: i64 = lex.advance_i();
    if (lex.cur_t() == "LBrace") {
        var body2: i64 = parse_block();
        var id2: i64 = base.mk_comptime_block(body2, tm);
        return id2;
    }
    var e: i64 = parse_expr();
    expect_tok("Semicolon");
    var ce: i64 = base.mk_comptime(e, tm);
    var id3: i64 = base.mk_expr(ce, tm);
    return id3;
}

// 块语句链表的**末条**语句；当且仅当它是 `expr` 语句时返回其节点 id，否则 -1。
// 值块的取值就是这条尾随表达式的值。
fn block_trailing_expr(head: i64) i64 {
    if (head < 0) {
        return -1;
    }
    var last: i64 = -1;
    var ks: []i64 = base.kids_chain(head);
    var ki: i64 = 0;
    while (ki < slice_len(ks) as i64) {
        last = ks[ki];
        ki = ki + 1;
    }
    if (last < 0) { return -1; }
    if (base.node_kind((last as u64)) != "expr") { return -1; }
    return last;
}

// 值块是否只有一个语句（Stage 1a 快路径：可脱糖为该表达式本身，后端零改动）。
fn block_is_single(head: i64) bool {
    if (head < 0) { return false; }
    var k: Child = base.kids[head];
    if (k.next >= 0) { return false; }
    return true;
}

// P1 Stage 1a/1b（everything-is-value）：**值位置的块** `{ s1; ...; sn; e; }`。
//
// 两条路径：
// ① 单表达式块 `{ e; }` —— 解析期直接脱糖为 `e` 本身（Stage 1a）。后端零改动，零风险。
// ② 多语句块 `{ s1; ...; sn; e; }` —— 构造 `block_expr` 节点（Stage 1b）。后端需真实结果槽：
//    LLVM 轨取尾随表达式的临时槽；C 轨用 GNU 语句表达式 `({ ...; e; })`，文本经
//    codegen_c 的捕获式发射缓冲（g_cap / g_cap_on）取得 —— 不可截断全局 slines，
//    那是已记录的 -O2 自编译 UB（笔记第 14 条）。
//
// 硬约束：块必须以**表达式语句**结尾（T 语句一律带 `;`）。无尾随表达式的块取值
// 属 P5（void → unit），当前按 fail-fast 报 T-PAR-E101，绝不静默降级。
pub fn parse_block_expr() i64 {
    var tl: i64 = lex.pos;           // 记块起点行号；`{`/`}` 由 parse_block 自己吞
    var body: i64 = parse_block();
    var last: i64 = block_trailing_expr(body);
    if (last < 0) {
        // P5：无尾随表达式的值块 ⇒ 自动补 `()`（unit 字面量），块类型为 unit。
        // 例如 `{ var x: i64 = 1; }` 自动成为 `{ var x: i64 = 1; (); }`，类型 unit，
        // 值块表达式位置照样合法（对应「无值」语义），不静默降级为错误。
        var u: i64 = base.node_new("unit_lit");
        base.node_at(u, lex.pos);
        var ue: i64 = base.mk_expr(u, -1);
        if (body < 0) {
            body = base.list_push(-1, -1, ue);
        } else {
            var lc: i64 = body;
            while (base.kids[lc].next >= 0) { lc = base.kids[lc].next; }
            base.list_push(body, lc, ue);
        }
        last = block_trailing_expr(body);
    }
    if (last < 0) {
        parse_fatal("值位置的块必须以表达式语句结尾（如 `{ 1; }`）");
    }
    if (block_is_single(body)) {
        return base.node_na((last as u64));  // ① 快路径：脱糖为表达式本身
    }
    return base.mk_block_expr(body, tl);   // ② 多语句值块
}

pub fn parse_block_stmt() i64 {
    var tl: i64 = lex.pos;
    var body3: i64 = parse_block();
    var id4: i64 = base.mk_block(body3, tl);
    return id4;
}

pub fn parse_var_stmt() i64 {
    return parse_local_var(false, false);
}

pub fn parse_const_stmt() i64 {
    var cd: i64 = parse_local_var(true, false);
    base.node_set_const(cd);
    return cd;
}

// `let 名字[: 类型] = 初值;` —— 动态常量（三关键字模型）。
// 运行期绑定一次、此后不可变；局部可省略类型标注由推断确定（与 var/const 同）。
// 复用 parse_local_var(is_const=true) 再置 is_let 标记（bb），避免改动其签名。
pub fn parse_local_let(is_export: bool) i64 {
    var id: i64 = parse_local_var(true, is_export);
    base.node_set_bb((id as u64), true);   // 标记 is_let（动态常量）（S4 §0.14.7 SoA 侧表写）
    return id;
}

pub fn parse_let_stmt() i64 {
    return parse_local_let(false);
}

// parse_statement 已由 GEN:parser_rules 区间生成（fold=disp 守卫式分发）。

// ── 注解查找辅助 ───────────────────────────────────────────────

// 在注解链中查找名为 name 的第一个注解，返回节点下标或 -1
pub fn ann_find(head: i64, name: string) i64 {
    // S4 §4.6 Phase 3：注解链先物化再遍历 —— 短路 return 时机不变
    var ks: []i64 = base.kids_chain(head);
    var ki: i64 = 0;
    while (ki < slice_len(ks) as i64) {
        var av: i64 = ks[ki];
        if (base.node_sa((av as u64)) == name) {
            return av;
        }
        ki = ki + 1;
    }
    return -1;
}

// 注解的第一个参数节点下标，无参数返回 -1
pub fn ann_first_arg(ann_idx: i64) i64 {
    if (base.node_la((ann_idx as u64)) < 0) {
        return -1;
    }
    var c: Child = base.kids[base.node_la((ann_idx as u64))];
    return c.val;
}

// ── 声明解析 ───────────────────────────────────────────────────

// parse_struct_decl / parse_sfield 已由 GEN:parser_rules 区间生成（见下方标记区）。
// 注意语义等价性：手写版按 is_bitpack 状态二分成员形态；生成版用 FIRST 守卫 alt
// （Integer → 位宽成员，其余 → 类型成员），对合法输入等价（类型永不以 Integer 开头）。

pub fn parse_enum_decl(name: string, anns: i64) i64 {
    // 关键字 `enum` 已由调用方消费（name-first 路径的 parse_decl_body dispatch，
    // 或关键字领头桥 `enum Name`）；此处不再 lex.advance_i()。
    var underlying: string = "u32";
    if (lex.cur_t() == "Colon") {
        lex.advance_i();
        var ti: i64 = lex.advance_i();
        underlying = lex.tk_v(ti);
    }
    var post: i64 = parse_annotations();
    var all: i64 = list_concat(anns, post);

    expect_tok("LBrace");
    var vh: i64 = -1;
    var vt: i64 = -1;
    while (lex.cur_t() != "RBrace" && lex.cur_t() != "Eof") {
        if (lex.cur_t() == "At" || lex.cur_t() != "Identifier") {
            lex.advance_i();
            continue;
        }
        var vname: string = expect_tok("Identifier");
        var val: i64 = -1;
        if (lex.cur_t() == "Assign") {
            lex.advance_i();
            val = parse_expr();
        }
        var vanns: i64 = parse_annotations();
        if (lex.cur_t() == "Comma") {
            lex.advance_i();
        }
        var vid: i64 = base.mk_V(vname, val, vanns, -1);
        vt = base.list_push(vh, vt, vid);
        if (vh < 0) {
            vh = vt;
        }
    }
    expect_tok("RBrace");

    var id: i64 = base.mk_EnumDecl(name, underlying, all, vh, -1);
    return id;
}

// ── flag 语义 helper（供 GEN:parser_rules 生成的 parse_flag_decl/parse_slot 调用）──
// 可选捕获缺省值：s 为空（可选组未命中）时返回 d
pub fn str_or(s: string, d: string) string {
    if (s == "") {
        return d;
    }
    return s;
}

// 从槽位注解里提取 @offset(n) 的 n；无则 -1
pub fn flag_offset_of(sanns: i64) i64 {
    var oa: i64 = ann_find(sanns, "offset");
    if (oa >= 0) {
        var arg: i64 = ann_first_arg(oa);
        if (arg >= 0) {
            if (base.node_kind((arg as u64)) == "number") {
                return parse_int_str(base.node_sa((arg as u64)));
            }
        }
    }
    return -1;
}

// 槽位是否带合法 @offset(n)
pub fn flag_has_offset(sanns: i64) bool {
    var oa: i64 = ann_find(sanns, "offset");
    if (oa >= 0) {
        var arg: i64 = ann_first_arg(oa);
        if (arg >= 0) {
            if (base.node_kind((arg as u64)) == "number") {
                return true;
            }
        }
    }
    return false;
}

// ── struct 语义 helper（供 GEN:parser_rules 生成的 parse_struct_decl/parse_sfield 调用）──
// 在两个注解列表（前置 anns / 后置 anns）里查 @bitpack，避免为检测而重复 list_concat
pub fn bp_arg2(a: i64, b: i64) i64 {
    var x: i64 = ann_find(a, "bitpack");
    if (x < 0) {
        x = ann_find(b, "bitpack");
    }
    if (x < 0) {
        return -2;  // 无 @bitpack（-1 留给"有 @bitpack 但无参数"）
    }
    var arg: i64 = ann_first_arg(x);
    return arg;  // >=0 参数节点；-1 无参数
}

// 是否带 @bitpack
pub fn bp_is2(a: i64, b: i64) bool {
    if (ann_find(a, "bitpack") >= 0) {
        return true;
    }
    return ann_find(b, "bitpack") >= 0;
}

// @bitpack(T) 的 T 名；无则 ""
pub fn bp_type2(a: i64, b: i64) string {
    var arg: i64 = bp_arg2(a, b);
    if (arg >= 0) {
        if (base.node_kind((arg as u64)) == "ident") {
            return base.node_sa((arg as u64));
        }
    }
    return "";
}

// 是否带合法 @bitpack(T)
pub fn bp_has_type2(a: i64, b: i64) bool {
    var arg: i64 = bp_arg2(a, b);
    if (arg >= 0) {
        if (base.node_kind((arg as u64)) == "ident") {
            return true;
        }
    }
    return false;
}

// 成员二分形态选型：@Integer 命中（bitpack 位宽成员）→ base.mk_scalar("void", -1)；否则用 @type 结果
pub fn sfield_na(bits: string, tn: i64) i64 {
    if (bits != "") {
        return base.mk_scalar("void", -1);
    }
    return tn;
}

// 位宽成员的 ia；非位宽成员 -1
pub fn sfield_ia(bits: string) i64 {
    if (bits == "") {
        return -1;
    }
    return parse_int_str(bits);
}

// parse_union_decl / parse_umember 已由 GEN:parser_rules 区间生成（见下方标记区）

// Variant：带标签的聚合类型（tagged union）。
//   Name variant {
//       CaseA(T);     // 携带载荷
//       CaseB;        // 单元 case（无载荷）
//   }
// 编译为 struct { uint32_t _tag; union { T _u0; ... } _u; }，并为每个 case 生成
// 自由函数：`Name_from_Case(...)` 构造、`Name_is_Case(self)` 判别、`Name_as_Case(self)` 取载荷。
// parse_variant_decl / parse_case 已由 GEN:parser 区间生成（见下方标记区）

// ParamPattern（L-15 / match.md §1、§7.2）：函数声明与函数子句共用同一
// FuncDecl 产生式，参数位统一泛化为 ParamPattern——
//   Ident ":" Type Guard?   普通参数（与 decl_func.md 的 name:type 等价）
//   Ident Guard?            裸绑定（类型由子句组内其它子句 / 字面量推定）
//   "_" Guard?              通配占位，不绑定变量
//   Literal Guard?          字面量相等模式
// 模式信息落在 P 节点的空闲字段：ba=通配、nb=字面量模式、nc=when 守卫。

// 闭包字面量（M46）：表达式位置的 `fn (params) Ret { body }`。
// 与声明靠「前面有无名字」区分（声明在 parse_declaration 先吃名字）；此处裸 `fn` 即 lambda。
pub fn parse_lambda_expr() i64 {
    var ti0: i64 = lex.advance_i();    // 吃掉 'fn'，返回其 token 下标（诊断锚点）
    expect_tok("LParen");
    var ph: i64 = -1;
    var pt: i64 = -1;
    while (lex.cur_t() != "RParen" && lex.cur_t() != "Eof") {
        var pname: string = expect_tok("Identifier");
        expect_tok("Colon");
        var ptn: i64 = parse_type();
        var pid: i64 = base.mk_P(pname, ptn, -1, -1);
        pt = base.list_push(ph, pt, pid);
        if (ph < 0) { ph = pt; }
        if (lex.cur_t() == "Comma") { lex.advance_i(); } else { break; }
    }
    expect_tok("RParen");
    var rt: i64 = parse_type();
    var body: i64 = -2;
    if (lex.cur_t() == "LBrace") {
        body = parse_block();
    } else {
        parse_fatal("expected '{' after lambda signature");
    }
    // 合成名在解析期就定下来，提升阶段直接复用。
    var lname: string = base.sb_cat2("__lam_", base.i2s(lex.g_lam_counter));
    lex.g_lam_counter = lex.g_lam_counter + 1;
    var id: i64 = base.mk_lambda(lname, rt, -1, ph, body, ti0);
    return id;
}

// `|v: T, w: U| expr` 闭包简写 → 与 fn 闭包等价的节点，只是返回类型留作「待推断」。
// 形如 Rust 的 `|x| x*2` / `|x: i32| x*2`；主体只接受单个表达式（会被包成
// `{ return <expr>; }`）。返回类型在 sema 阶段按主体里的 return 表达式推断
// （见 infer_lambda_ret_from_decl），故调用方无需标注。
pub fn parse_bar_lambda() i64 {
    var ti0: i64 = lex.advance_i();    // 吃掉起始 '|'
    var with_paren: bool = lex.cur_t() == "LParen";
    if (with_paren) { lex.advance_i(); }
    var ph: i64 = -1;
    var pt: i64 = -1;
    while (lex.cur_t() != "BitOr" && lex.cur_t() != "RParen" && lex.cur_t() != "Eof") {
        var pname: string = expect_tok("Identifier");
        var ptn: i64 = -1;
        if (lex.cur_t() == "Colon") {
            lex.advance_i();                // 吃掉 ':'
            ptn = parse_type();
        } else {
            // 省略类型 `|v|` → 参数类型占位为 Infer；检查期若无上下文回填则触发 T-SEM-E214
            ptn = base.mk_infer_ret();
        }
        var pid: i64 = base.mk_P(pname, ptn, -1, -1);
        pt = base.list_push(ph, pt, pid);
        if (ph < 0) { ph = pt; }
        if (lex.cur_t() == "Comma") { lex.advance_i(); } else { break; }
    }
    if (with_paren) { expect_tok("RParen"); }
    if (lex.cur_t() != "BitOr") {
        parse_fatal("expected '|' to close lambda parameters");
    }
    lex.advance_i();                    // 吃掉结束 '|'
    // 主体：单个表达式（停在下一个管道算子，使 `(xs) |> |v| f(v)` 的 `|>` 不被吞掉）
    var body_expr: i64 = parse_in();
    // 包成 `{ return <expr>; }`
    var rstmt: i64 = base.mk_return(body_expr, -1);
    var blk: i64 = -1;
    var blkt: i64 = -1;
    blkt = base.list_push(blk, blkt, rstmt);
    if (blk < 0) { blk = blkt; }
    var lname: string = base.sb_cat2("__lam_", base.i2s(lex.g_lam_counter));
    lex.g_lam_counter = lex.g_lam_counter + 1;
    var rt: i64 = base.mk_infer_ret();
    var id: i64 = base.mk_lambda(lname, rt, -1, ph, blk, ti0);
    return id;
}

// ── 闭包捕获分析（M48 / FuncType v2 Stage B2）──────────────────
// 提升 lambda 之前先算「自由变量 ∩ 外层函数可见变量」= 捕获集：
//   * 绑定名栈 cap_bnd 按词法作用域压/弹（回退长度即出栈）
//   * 自由名 cap_free 去重收集，保持首次出现顺序（决定 env 字段顺序）
// 绑定集宁可**多收**不可少收：多收 → 少捕获 → 后续 T_UNDEFINED_IDENT 响亮报错；
// 少收 → 多捕获 → 环境字段遮蔽同名局部，属静默错编。
pub var cap_bnd: []string;
pub var cap_bnd_n: i64;
pub var cap_free: []string;
pub var cap_free_n: i64;

pub fn cap_push(nm: string) void {
    if (cap_bnd_n < (slice_len(cap_bnd) as i64)) {
        slice_set(cap_bnd, cap_bnd_n, nm);
    } else {
        append(cap_bnd, nm);
    }
    cap_bnd_n = cap_bnd_n + 1;
}

pub fn cap_bound(nm: string) bool {
    var i: i64 = 0;
    while (i < cap_bnd_n) {
        if (cap_bnd[i] == nm) { return true; }
        i = i + 1;
    }
    return false;
}

pub fn cap_free_add(nm: string) void {
    var i: i64 = 0;
    while (i < cap_free_n) {
        if (cap_free[i] == nm) { return; }
        i = i + 1;
    }
    if (cap_free_n < (slice_len(cap_free) as i64)) {
        slice_set(cap_free, cap_free_n, nm);
    } else {
        append(cap_free, nm);
    }
    cap_free_n = cap_free_n + 1;
}

// 语句链里直接引入的绑定名（**不**下钻嵌套 lambda 体：那是独立作用域）
pub fn cap_bind_stmts(head: i64) void {
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
    var ks: []i64 = base.kids_chain(head);
    var ki: i64 = 0;
    while (ki < slice_len(ks) as i64) {
        var kv: i64 = ks[ki];
        if (base.node_kind((kv as u64)) == "var_decl") { cap_push(base.node_sa((kv as u64))); }
        if (base.node_kind((kv as u64)) == "closure_capture") { cap_push(base.node_sa((kv as u64))); }
        if (base.node_kind((kv as u64)) == "for") {
            if (base.node_na((kv as u64)) >= 0) {
                if (base.node_kind((base.node_na((kv as u64)) as u64)) == "var_decl") { cap_push(base.node_sa((base.node_na((kv as u64)) as u64))); }
            }
            cap_bind_stmts(base.node_la((kv as u64)));
        }
        if (base.node_kind((kv as u64)) == "for_each") {
            cap_push(base.node_sa((kv as u64)));
            if (str_len(base.node_sb((kv as u64))) > 0) { cap_push(base.node_sb((kv as u64))); }
            cap_bind_stmts(base.node_la((kv as u64)));
        }
        if (base.node_kind((kv as u64)) == "if") {
            cap_bind_stmts(base.node_la((kv as u64)));
            if (base.node_lb((kv as u64)) > -2) { cap_bind_stmts(base.node_lb((kv as u64))); }
        }
        if (base.node_kind((kv as u64)) == "while" || base.node_kind((kv as u64)) == "block" || base.node_kind((kv as u64)) == "defer") {
            cap_bind_stmts(base.node_la((kv as u64)));
        }
        if (base.node_kind((kv as u64)) == "comptime_block") { cap_bind_stmts(base.node_la((kv as u64))); }
        ki = ki + 1;
    }
}

pub fn cap_scan_list(head: i64) void {
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
    var ks: []i64 = base.kids_chain(head);
    var ki: i64 = 0;
    while (ki < slice_len(ks) as i64) {
        cap_scan(ks[ki]);
        ki = ki + 1;
    }
}

// 通用槽位遍历：Node 的子节点固定落在 na/nb/nc/nd + la/lb/lc，
// 故无需逐 kind 枚举。类型节点里不会出现 ident 节点，顺带遍历无副作用；
// 直接调用的被调名存在 call.na 的 ident 上，会被当自由名收集——这正是
// 「局部变量持有函数值再调用」需要捕获的情形，全局函数名则自然落空。
pub fn cap_scan(e: i64) void {
    if (e < 0) { return; }
    if (base.node_kind((e as u64)) == "ident") {
        if (cap_bound(base.node_sa((e as u64))) == false) { cap_free_add(base.node_sa((e as u64))); }
        return;
    }
    if (base.node_kind((e as u64)) == "lambda") {
        // 嵌套 lambda 自成作用域，但其未绑定的自由名对本层依然自由
        var sv: i64 = cap_bnd_n;
        // S4 §4.6 Phase 3：lambda 形参链先物化再遍历
        var ksp: []i64 = base.kids_chain(base.node_lb((e as u64)));
        var kip: i64 = 0;
        while (kip < slice_len(ksp) as i64) {
            cap_push(base.node_sa((ksp[kip] as u64)));
            kip = kip + 1;
        }
        cap_bind_stmts(base.node_lc((e as u64)));
        cap_scan_list(base.node_lc((e as u64)));
        cap_bnd_n = sv;
        return;
    }
    if (base.node_kind((e as u64)) == "arm") {
        // match 分支绑定名只在该分支的守卫 / 体内可见
        var sv2: i64 = cap_bnd_n;
        if (str_len(base.node_sa((e as u64))) > 0) { cap_push(base.node_sa((e as u64))); }
        cap_scan(base.node_na((e as u64)));
        cap_scan(base.node_nb((e as u64)));
        cap_scan(base.node_nc((e as u64)));
        cap_bnd_n = sv2;
        return;
    }
    cap_scan(base.node_na((e as u64)));
    cap_scan(base.node_nb((e as u64)));
    cap_scan(base.node_nc((e as u64)));
    cap_scan(base.node_nd((e as u64)));   // S4 §0.14.7 SoA：侧表访问器（原 .nd）
    cap_scan_list(base.node_la((e as u64)));
    cap_scan_list(base.node_lb((e as u64)));
    cap_scan_list(base.node_lc((e as u64)));
}

// 外层函数可见变量表：名字 → 类型节点（-1 = 无显式类型，不可捕获）
pub var envm_n: []string;
pub var envm_t: []i64;
pub var envm_c: i64;

pub fn envm_add(nm: string, tn: i64) void {
    var i: i64 = 0;
    while (i < envm_c) {
        if (envm_n[i] == nm) { return; }
        i = i + 1;
    }
    if (envm_c < (slice_len(envm_n) as i64)) {
        slice_set(envm_n, envm_c, nm);
        slice_set(envm_t, envm_c, tn);
    } else {
        append(envm_n, nm);
        append(envm_t, tn);
    }
    envm_c = envm_c + 1;
}

pub fn envm_find(nm: string) i64 {
    var i: i64 = 0;
    while (i < envm_c) {
        if (envm_n[i] == nm) { return i; }
        i = i + 1;
    }
    return -1;
}

pub fn envm_stmts(head: i64) void {
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
    var ks: []i64 = base.kids_chain(head);
    var ki: i64 = 0;
    while (ki < slice_len(ks) as i64) {
        var kv: i64 = ks[ki];
        if (base.node_kind((kv as u64)) == "var_decl") { envm_add(base.node_sa((kv as u64)), base.node_na((kv as u64))); }
        if (base.node_kind((kv as u64)) == "closure_capture") { envm_add(base.node_sa((kv as u64)), base.node_na((kv as u64))); }
        if (base.node_kind((kv as u64)) == "for") {
            if (base.node_na((kv as u64)) >= 0) {
                if (base.node_kind((base.node_na((kv as u64)) as u64)) == "var_decl") { envm_add(base.node_sa((base.node_na((kv as u64)) as u64)), base.node_na((base.node_na((kv as u64)) as u64))); }
            }
            envm_stmts(base.node_la((kv as u64)));
        }
        if (base.node_kind((kv as u64)) == "for_each") {
            envm_add(base.node_sa((kv as u64)), -1);
            if (str_len(base.node_sb((kv as u64))) > 0) { envm_add(base.node_sb((kv as u64)), -1); }
            envm_stmts(base.node_la((kv as u64)));
        }
        if (base.node_kind((kv as u64)) == "if") {
            envm_stmts(base.node_la((kv as u64)));
            if (base.node_lb((kv as u64)) > -2) { envm_stmts(base.node_lb((kv as u64))); }
        }
        if (base.node_kind((kv as u64)) == "while" || base.node_kind((kv as u64)) == "block" || base.node_kind((kv as u64)) == "defer") {
            envm_stmts(base.node_la((kv as u64)));
        }
        if (base.node_kind((kv as u64)) == "comptime_block") { envm_stmts(base.node_la((kv as u64))); }
        ki = ki + 1;
    }
}

// 本层直属 lambda 收集（命中即停，嵌套的留给提升后的合成函数那一轮处理）
pub var lam_hit: []i64;
pub var lam_hit_n: i64;

pub fn lam_hit_add(id: i64) void {
    if (lam_hit_n < (slice_len(lam_hit) as i64)) {
        slice_set(lam_hit, lam_hit_n, id);
    } else {
        append(lam_hit, id);
    }
    lam_hit_n = lam_hit_n + 1;
}

pub fn lam_find_list(head: i64) void {
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
    var ks: []i64 = base.kids_chain(head);
    var ki: i64 = 0;
    while (ki < slice_len(ks) as i64) {
        lam_find(ks[ki]);
        ki = ki + 1;
    }
}

pub fn lam_find(e: i64) void {
    if (e < 0) { return; }
    if (base.node_kind((e as u64)) == "lambda") {
        lam_hit_add(e);
        return;
    }
    lam_find(base.node_na((e as u64)));
    lam_find(base.node_nb((e as u64)));
    lam_find(base.node_nc((e as u64)));
    lam_find(base.node_nd((e as u64)));   // S4 §0.14.7 SoA：侧表访问器（原 .nd）
    lam_find_list(base.node_la((e as u64)));
    lam_find_list(base.node_lb((e as u64)));
    lam_find_list(base.node_lc((e as u64)));
}

pub var g_env_counter: i64;

// 单个 lambda 提升。envm_* 须由调用方按外层作用域填好。
//   无捕获 → 节点就地降级为 ident（完全复用 FuncType v1 的具名函数取值路径）
//   有捕获 → 合成 `__env_N` 结构 + 体首插 closure_capture 语句 + 节点改写为 closure_make
pub fn lift_one_lambda(lid: i64) void {
    if (base.node_kind((lid as u64)) != "lambda") { return; }

    cap_bnd_n = 0;
    cap_free_n = 0;
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
    var ks: []i64 = base.kids_chain(base.node_lb((lid as u64)));
    var ki: i64 = 0;
    while (ki < slice_len(ks) as i64) {
        cap_push(base.node_sa((ks[ki] as u64)));
        ki = ki + 1;
    }
    cap_bind_stmts(base.node_lc((lid as u64)));
    cap_scan_list(base.node_lc((lid as u64)));

    var cn: []string;
    var ct: []i64;
    var fi2: i64 = 0;
    while (fi2 < cap_free_n) {
        var nm: string = cap_free[fi2];
        var ei: i64 = envm_find(nm);
        if (ei >= 0) {
            if (envm_t[ei] < 0) {
                fc_err("T-CLO-E780",
                    base.sb_cat3("无法捕获外层绑定 `", nm,
                        "`：它没有显式类型标注（如 for-each 迭代变量），环境结构无法为其定型。请先赋给带类型标注的局部变量再捕获"), lid);
            } else {
                append(cn, nm);
                append(ct, envm_t[ei]);
            }
        }
        fi2 = fi2 + 1;
    }
    var ncap: i64 = slice_len(cn) as i64;

    var fd: i64 = base.mk_FuncDecl(base.node_sa((lid as u64)), false, false, base.node_na((lid as u64)), -1, base.node_lb((lid as u64)), base.node_lc((lid as u64)), -1);
    base.node_set_sc((fd as u64), "__lambda__");   // S4 §0.14.7 SoA：取代 `fdn.sc`（fdn 两条出口均有 slice_set 回写，写真实生效）
    base.node_set_span_id(fd, base.node_span_id(lid));
    base.node_set_span_id(fd, base.node_span_id(lid));
    base.node_set_span_id(fd, base.node_span_id(lid));

    if (ncap == 0) {
        append(lex.decl_list, fd);
        base.node_set_kind((lid as u64), "ident");   // sa 已是合成函数名
        base.node_set_na((lid as u64), -1);
        base.node_set_la((lid as u64), -1);
        base.node_set_lb((lid as u64), -1);
        base.node_set_lc((lid as u64), -1);   // S4 §0.14.7 SoA：侧表写（原 base.node_lc((ln3.id as u64)) = -1；第十一批）
        return;
    }

    var ename: string = base.sb_cat2("__env_", base.i2s(g_env_counter));
    g_env_counter = g_env_counter + 1;

    var fh: i64 = -1;
    var ft: i64 = -1;
    var ch: i64 = -1;
    var cht: i64 = -1;
    var ah: i64 = -1;
    var at: i64 = -1;
    var ci: i64 = 0;
    while (ci < ncap) {
        var fnode: i64 = base.mk_F(cn[ci], -1, ct[ci], -1, -1);
        base.node_set_span_id(fnode, base.node_span_id(lid));
        base.node_set_span_id(fnode, base.node_span_id(lid));
        base.node_set_span_id(fnode, base.node_span_id(lid));
        ft = base.list_push(fh, ft, fnode);
        if (fh < 0) { fh = ft; }

        var ccn: i64 = base.mk_closure_capture(cn[ci], ct[ci], ci, -1);
        base.node_set_sb((ccn as u64), ename);
        base.node_set_span_id(ccn, base.node_span_id(lid));
        base.node_set_span_id(ccn, base.node_span_id(lid));
        base.node_set_span_id(ccn, base.node_span_id(lid));
        cht = base.list_push(ch, cht, ccn);
        if (ch < 0) { ch = cht; }

        var idn: i64 = base.mk_ident(cn[ci], -1);
        base.node_set_span_id(idn, base.node_span_id(lid));
        base.node_set_span_id(idn, base.node_span_id(lid));
        base.node_set_span_id(idn, base.node_span_id(lid));
        at = base.list_push(ah, at, idn);
        if (ah < 0) { ah = at; }

        ci = ci + 1;
    }

    var sd: i64 = base.mk_StructDecl(ename, "auto", "", false, false, -1, fh, -1);
    base.node_set_span_id(sd, base.node_span_id(lid));
    base.node_set_span_id(sd, base.node_span_id(lid));
    base.node_set_span_id(sd, base.node_span_id(lid));
    append(lex.decl_list, sd);

    base.node_set_sb((fd as u64), ename);                          // 发射期据此前置 env 首参
    base.node_set_lc((fd as u64), list_concat(ch, base.node_lc((lid as u64))));   // 体首重建捕获变量（原 base.node_lc((fdn.id as u64)) = list_concat(ch, base.node_lc((ln.id as u64)))）
    append(lex.decl_list, fd);

    base.node_set_kind((lid as u64), "closure_make");   // sa 仍是合成函数名
    base.node_set_sb((lid as u64), ename);
    base.node_set_na((lid as u64), -1);
    base.node_set_la((lid as u64), ah);   // 捕获实参（外层作用域求值）
    base.node_set_lb((lid as u64), -1);
    base.node_set_lc((lid as u64), -1);   // S4 §0.14.7 SoA：侧表写（原 base.node_lc((ln2.id as u64)) = -1；第十一批）
}

// 匿名函数字面量提升（M46 起；M48 起支持按值捕获）。
// 遍历 decl_list（长度每轮重取：提升会追加合成 decl），对每个函数体先建外层
// 变量表再提升其直属 lambda。嵌套 lambda 由「提升后的合成函数」那一轮自然处理，
// 此时外层的 closure_capture 已在体首，作用域信息完整。
pub fn desugar_lambdas() void {
    var i: i64 = 0;
    while (i < (slice_len(lex.decl_list) as i64)) {
        var d: i64 = lex.decl_list[i];
        if (base.node_kind((d as u64)) == "FuncDecl") {
            if (base.node_lc((d as u64)) > -2) {
                envm_c = 0;
                // S4 §4.6 Phase 3：形参链先物化再遍历
                var ks: []i64 = base.kids_chain(base.node_lb((d as u64)));
                var ki: i64 = 0;
                while (ki < slice_len(ks) as i64) {
                    var pv: i64 = ks[ki];
                    envm_add(base.node_sa((pv as u64)), base.node_na((pv as u64)));
                    ki = ki + 1;
                }
                envm_stmts(base.node_lc((d as u64)));
                lam_hit_n = 0;
                lam_find_list(base.node_lc((d as u64)));
                var li: i64 = 0;
                while (li < lam_hit_n) {
                    lift_one_lambda(lam_hit[li]);
                    li = li + 1;
                }
            }
        }
        // 全局初始化器里的字面量：无外层局部，捕获集必空
        if (base.node_kind((d as u64)) == "GlobalVarDecl" || base.node_kind((d as u64)) == "GlobalConstDecl") {
            if (base.node_nb((d as u64)) >= 0) {
                envm_c = 0;
                lam_hit_n = 0;
                lam_find(base.node_nb((d as u64)));
                var lj: i64 = 0;
                while (lj < lam_hit_n) {
                    lift_one_lambda(lam_hit[lj]);
                    lj = lj + 1;
                }
            }
        }
        i = i + 1;
    }
}

pub fn parse_func_decl(name: string, anns: i64, is_comptime: bool, is_kernel: bool) i64 {
    expect_tok("LParen");
    var ph: i64 = -1;
    var pt: i64 = -1;
    while (lex.cur_t() != "RParen" && lex.cur_t() != "Eof") {
        var pname: string = "";
        var ptn: i64 = -1;
        var pwild: bool = false;
        var plit: i64 = -1;
        var pcomp: bool = false;
        var ppos: i64 = lex.pos;              // 形参名 token 下标（供 C 关键字撞名告警定位）
        if (lex.cur_t() == "KwComptime") {
            // comptime 类型模板参数：`comptime T: type` —— T 在编译期承载「任意类型」，
            // 调用点按实参类型单态化；P.bb = true 标记其为编译期类型参数。
            lex.advance_i();
            pname = expect_tok("Identifier");
            expect_tok("Colon");
            ptn = parse_type();
            pcomp = true;
        } else if (lex.cur_t() == "Identifier" && lex.cur_v() == "_") {
            lex.advance_i();
            pwild = true;
            pname = "_";                  // 保持与既有 `_: T` 形参写法一致
            if (lex.cur_t() == "Colon") {     // `_ : T` —— 通配但显式标注类型
                lex.advance_i();
                ptn = parse_type();
            }
        } else {
            if (lex.cur_t() == "Identifier" && lex.peek_t(1) == "Colon") {
                pname = expect_tok("Identifier");
                expect_tok("Colon");
                ptn = parse_type();
            } else {
                if (lex.cur_t() == "Identifier") {
                    // 结构字面量模式：`Ident { ... }` —— 含前导点形式 `Point{.x=0}` 与
                    // 旧式 `Point{ x: 0 }`；按模式表达式解析（与 match 臂同构），存入 plit(=nb)。
                    // 否则为裸绑定形参名。
                    if (lex.peek_t(1) == "LBrace") {
                        plit = parse_expr();
                    } else {
                        pname = expect_tok("Identifier");
                    }
                } else {
                    plit = parse_expr();
                }
            }
        }
        var pguard: i64 = -1;
        if (lex.cur_t() == "KwWhen") {
            lex.advance_i();
            pguard = parse_expr();
        }
        var panns: i64 = parse_annotations();
        if (pname != "" && pname != "_") { base.validate_c_keyword(pname, ppos); }
        var pid: i64 = base.mk_P(pname, ptn, panns, -1);
        if (pwild || plit >= 0 || pguard >= 0 || pcomp) {
            base.node_set_ba((pid as u64), pwild);   // S4 §0.14.7 SoA：侧表写（原 pn.ba = pwild；第十批）
            base.node_set_nb((pid as u64), plit);
            base.node_set_nc((pid as u64), pguard);   // S4 §0.14.7 SoA：侧表写（原 pn.nc = pguard；第九批）
            if (pcomp) { base.node_set_bb((pid as u64), true); }   // S4 §0.14.7 SoA：侧表写（原 pn.bb）
        }
        pt = base.list_push(ph, pt, pid);
        if (ph < 0) {
            ph = pt;
        }
        if (lex.cur_t() == "Comma") {
            lex.advance_i();
        } else {
            break;
        }
    }
    expect_tok("RParen");
    var rt: i64 = parse_type();
    var post: i64 = parse_annotations();
    var all: i64 = list_concat(anns, post);

    var body: i64 = -2;
    var is_extern: bool = false;
    if (lex.cur_t() == "Semicolon") {
        lex.advance_i();
        is_extern = true;
    } else {
        if (lex.cur_t() == "LBrace") {
            body = parse_block();
        } else {
            parse_fatal("expected '{' or ';' after function signature");
        }
    }

    var id: i64 = base.mk_FuncDecl(name, is_extern, is_comptime, rt, all, ph, body, -1);
    if (is_kernel) {
        // S4 §0.14.7 SoA：bf 外置为侧表后无需「取值→改字段→slice_set 回写」，直接写侧表。
        base.node_set_bf((id as u64), true);   // Device 入口：host 双后端跳过，codegen_dev 处理
    }
    return id;
}

// ═════════════════════════════════════════════════════════════
// 智能体一等公民（Style B / docs/agent_first.md）：
//   Counter agent {
//     state count: i64
//     step fn(s: CounterState, msg: atom) CounterState { ... }
//   }
// 脱糖为（仅编译器前端，后端零改动）：
//   CounterState struct { count: i64 }        // 纯数据
//   Counter_step  fn(...) { ... }             // 自由函数，函数体逐字保留
//   Counter_spawn(count: i64) CounterState // 合成构造器
// 设计铁律：state 是纯数据 struct；step/tools 是顶层自由 fn，绝不挂进 struct。
// 解析期直接合成三个真实声明节点并 append 到 decl_list（struct 在前，
// 保证 register 阶段先见 struct），不引入新的 AST 死节点。
// ═════════════════════════════════════════════════════════════
// ── agent 脱糖辅助 ───────────────────────────────────────────────
// PascalCase → snake_case：agent 生成的普通函数名须遵循「普通函数 = 小蛇形」命名规范
// （原 <Name>_step / <Name>_spawn 以大写开头，被 validate_decl_name 误判为类型并告警 T_NAME_TYPE_CAMEL）。
pub fn pascal_to_snake(s: string) string {
    var sb: StringBuilder = sb_new();
    var i: u64 = 0;
    var n: u64 = str_len(s);
    while (i < n) {
        var c: u8 = s[i];
        if (c >= 65 && c <= 90) {
            if (i > 0) { sb_append_char(sb, 95); }   // '_'
            sb_append_char(sb, c + 32);              // 转小写
        } else {
            sb_append_char(sb, c);
        }
        i = i + 1;
    }
    return sb_to_str(sb);
}

// 深拷贝一个类型节点。脱糖合成 spawn 形参时，必须与源 struct 字段的类型节点分属两份，
// 否则 check 期对同一节点原地改写（类型解析回填）会触发越界切片（index_out_of_bounds panic）。
pub fn clone_type_node(n: i64) i64 {
    if (n < 0) { return -1; }
    var k: string = base.node_kind((n as u64));
    if (k == "named") {
        // 深拷贝须带上模块限定前缀 sb（`A.T` 的 A），否则克隆体丢失命名空间，
        // mangle_modules 认不出来 → 退化成未知类型（agent state 字段曾因此变 i64）。
        var cid: i64 = base.mk_named(base.node_sa((n as u64)), -1);
        if (base.node_sb((n as u64)) != "") {
            base.node_set_sb((cid as u64), base.node_sb((n as u64)));
        }
        return cid;
    }
    if (k == "scalar") { return base.mk_scalar(base.node_sa((n as u64)), -1); }
    if (k == "array") { return base.mk_array(clone_type_node(base.node_na((n as u64))), base.node_nb((n as u64)), -1); }
    if (k == "slice") { return base.mk_slice(clone_type_node(base.node_na((n as u64))), -1); }
    if (k == "optional") { return base.mk_optional(clone_type_node(base.node_na((n as u64))), -1); }
    if (k == "vector") { return base.mk_vector(clone_type_node(base.node_na((n as u64))), base.node_nb((n as u64)), -1); }
    // S4 §0.14.7 SoA：tile 的第四槽（flavor）走侧表读（原 nd.nd）
    if (k == "tile") { return base.mk_tile(clone_type_node(base.node_na((n as u64))), clone_type_node(base.node_nb((n as u64))), clone_type_node(base.node_nc((n as u64))), clone_type_node(base.node_nd((n as u64))), -1); }
    if (k == "pointer") { return base.mk_pointer(clone_type_node(base.node_na((n as u64))), -1); }
    if (k == "map") { return base.mk_map(clone_type_node(base.node_na((n as u64))), clone_type_node(base.node_nb((n as u64))), -1); }
    if (k == "func_type") { return base.mk_func_type(clone_type_node(base.node_na((n as u64))), clone_type_list(base.node_la((n as u64))), -1); }
    if (k == "sym") { return base.mk_sym(base.node_sa((n as u64)), base.node_ia((n as u64)), -1); }
    if (k == "variant") { return base.mk_variant(-1); }
    return n;   // 兜底：未知类型节点原样复用（风险自负）
}

// 深拷贝一个类型节点链表（func_type 的参数类型列表）。
pub fn clone_type_list(l: i64) i64 {
    var head: i64 = -1;
    var tail: i64 = -1;
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
    // ⦁ 循环体只往**新建链**（head/tail，初值 -1）追加，不回写被遍历的 `l` 链 ⇒ 遍历集合恒等
    var ks: []i64 = base.kids_chain(l);
    var ki: i64 = 0;
    while (ki < slice_len(ks) as i64) {
        var v: i64 = clone_type_node(ks[ki]);
        tail = base.list_push(head, tail, v);
        if (head < 0) { head = tail; }
        ki = ki + 1;
    }
    return head;
}

pub fn parse_agent_decl(name: string, anns: i64) i64 {
    lex.advance_i(); // consume KwAgent
    expect_tok("LBrace");
    var field_head: i64 = -1;
    var field_tail: i64 = -1;
    var step_fn: i64 = -1;
    while (lex.cur_t() != "RBrace" && lex.cur_t() != "Eof") {
        if (lex.cur_t() == "Semicolon") { lex.advance_i(); continue; }
        if (lex.cur_t() != "Identifier") {
            parse_fatal(base.sb_cat3("expected 'state' or 'step' clause in agent '", name, "'"));
        }
        var kwi: i64 = lex.advance_i();
        var kw: string = lex.tk_v(kwi);
        if (kw == "state") {
            // 一个或多个 `name: Type[ @tag][ = default];` 字段行
            while (lex.cur_t() == "Identifier" && lex.peek_t(1) == "Colon") {
                var fid: i64 = parse_sfield();
                field_tail = base.list_push(field_head, field_tail, fid);
                if (field_head < 0) { field_head = field_tail; }
            }
        } else if (kw == "step") {
            if (step_fn >= 0) {
                parse_fatal(base.sb_cat3("agent '", name, "' has multiple 'step' clauses"));
            }
            // 当前 token 应为 fn（parse_func_decl 自吞）；函数名走 snake_case 命名规范
            lex.advance_i();
            step_fn = parse_func_decl(base.sb_cat2(pascal_to_snake(name), "_step"), anns, false, false);
        } else {
            parse_fatal(base.sb_cat5("unknown agent clause '", kw, "' in agent '", name, "'"));
        }
    }
    expect_tok("RBrace");
    if (step_fn < 0) {
        parse_fatal(base.sb_cat3("agent '", name, "' is missing a 'step' clause"));
    }
    if (field_head < 0) {
        parse_fatal(base.sb_cat3("agent '", name, "' has no 'state' fields"));
    }

    var state_name: string = base.sb_cat2(name, "State");

    // 1) state struct：复用字段节点（含 @tag / =default），完全继承
    var sdecl: i64 = base.mk_StructDecl(state_name, "auto", "", false, false, anns, field_head, lex.g_agent_anchor);

    // 2) spawn 构造器：一参一字段（按声明顺序），body = return State{ f: f, ... }
    var spawn_name: string = base.sb_cat2(pascal_to_snake(name), "_spawn");
    var ph: i64 = -1;
    var pt: i64 = -1;
    var fv_head: i64 = -1;
    var fv_tail: i64 = -1;
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
    // ⦁ 循环体只往**新建链**（ph/pt、fv_head/fv_tail，初值 -1）追加，不回写 field_head 链
    var ks: []i64 = base.kids_chain(field_head);
    var ki: i64 = 0;
    while (ki < slice_len(ks) as i64) {
        var f: i64 = ks[ki];
        var pname: string = base.node_sa((f as u64));
        // 形参（类型节点深拷贝，避免与 struct 字段共享同一份被 check 期改写而越界）
        var pid: i64 = base.mk_P(pname, clone_type_node(base.node_na((f as u64))), -1, -1);
        pt = base.list_push(ph, pt, pid);
        if (ph < 0) { ph = pt; }
        // struct 字面量字段：field = 同名形参
        var vid: i64 = base.mk_FV(pname, base.mk_ident(pname, -1), -1);
        fv_tail = base.list_push(fv_head, fv_tail, vid);
        if (fv_head < 0) { fv_head = fv_tail; }
        ki = ki + 1;
    }
    var lit: i64 = base.mk_struct_lit(state_name, fv_head, lex.g_agent_anchor);
    var ret: i64 = base.mk_return(lit, lex.g_agent_anchor);
    // 合成体必须是「语句链表头」(kids 链表节点)，而非 "block" AST 节点，
    // 否则 desugar_lambdas 会把 block 节点索引当链表头读 kids[] 越界。
    var sbody: i64 = base.list_push(-1, -1, ret);
    var spawn_td: i64 = base.mk_named(state_name, -1);
    var spawn_fn: i64 = base.mk_FuncDecl(spawn_name, false, false, spawn_td, anns, ph, sbody, lex.g_agent_anchor);

    // 锚点：统一挂到 agent 名字 token
    base.node_at(sdecl, lex.g_agent_anchor);
    base.node_at(step_fn, lex.g_agent_anchor);
    base.node_at(spawn_fn, lex.g_agent_anchor);

    // 顺序：struct → step → spawn
    append(lex.decl_list, sdecl);
    append(lex.decl_list, step_fn);
    append(lex.decl_list, spawn_fn);
    return -1; // 已自行 append
}

pub fn parse_global_var(is_const: bool, is_comptime: bool) i64 {
    lex.advance_i();
    var name: string = expect_tok("Identifier");
    var nti: i64 = lex.pos - 1;
    var tn: i64 = -1;
    if (lex.cur_t() == "Colon") {
        lex.advance_i();
        tn = parse_type();
    }
    var init: i64 = -1;
    if (lex.cur_t() == "Assign") {
        lex.advance_i();
        init = parse_expr();
    }
    expect_tok("Semicolon");
    if (is_const) {
        base.validate_const_name(name, nti);
    } else {
        base.validate_var_name(name, nti);
    }

    if (is_const) {
        if (init < 0) {
            init = base.mk_null(-1);
        }
        var id: i64 = base.mk_GlobalConstDecl(name, is_comptime, tn, init, -1, nti);
        return id;
    }

    if (tn < 0) {
        tn = base.mk_scalar("void", -1);
    }
    var id2: i64 = base.mk_GlobalVarDecl(name, is_comptime, tn, init, -1, nti);
    return id2;
}

// 解析 `::` 之后的导入项列表：`Ident [as Ident]` | `*`，逗号分隔。
// 返回 kids 链表头（-1 = 空）。项内的 `as` 贪婪匹配（先归项别名，模块别名在列表之后）。
pub fn parse_import_items() i64 {
    var head: i64 = -1;
    var tail: i64 = -1;
    var more: bool = true;
    while (more) {
        var it: i64 = -1;
        if (lex.cur_t() == "Star") {
            var sti: i64 = lex.advance_i();
            it = base.mk_ImportItem("*", "*", true, sti);
        } else {
            var oti: i64 = lex.pos;
            var orig: string = expect_tok("Identifier");
            // M3.3：删除 `as` 重命名（`a as c` 不再支持）；orig 即绑定名。
            it = base.mk_ImportItem(orig, orig, false, oti);
        }
        tail = base.list_push(head, tail, it);
        if (head < 0) { head = tail; }
        if (lex.cur_t() == "Comma") { lex.advance_i(); } else { more = false; }
    }
    return head;
}

// 唯一导入语法（docs/reference.md §3.7）：
//   ImportStmt ::= "import" "(" ImportPath ( "::" ImportList )? ( "as" Ident )? ")" ";"
//   ImportPath ::= Ident ( "." Ident )*
// 路径首段为 `src` ⇒ 从本工程源码根导入（剥离该段）；否则一律按库解析：
// 先本工程 lib/、再工程依赖的库。点号即路径分隔符：std.mem => <libdir>/std/mem.tc。
// ⚠ 已删除：旧 `import(X)` 括号形式解析器（见 docs/reference.md §3.13）。
// 模块导入统一改用 `@import("X")` 字符串路径形式（parse_at_import_decl）。
// 旧 ImportStmt ::= "import" "(" Ident ("." Ident)* ( "::" ImportList )? ( "as" Ident )? ")" ";"
// 该形式已废弃，现由字符串路径的 @import 取代，分歧仅在表面（路径由点分标识符改为字符串字面量）。

// ── 文件级指令（文件即模块）──────────────────────────────────────
// `@module(...)` / `@import("...")` 以注解形状出现在顶层，但**后面不跟任何声明**
// （它们本身就是声明）。故在 parse_declaration 入口抢先识别，一次消费一条，
// 其余注解留给下一轮 parse_declaration。
//
// 与旧 `import(Path)` 的差别只在表面：路径由点分标识符改为字符串字面量；
// 内部仍复用同一套解析——首段 `src` ⇒ 工程源码根（剥离该段），否则走库搜索路径。

// ModuleDecl ::= "@module" "(" ModuleAttrList ")"
// ModuleAttr ::= "pub" | "internal"
pub fn parse_module_decl() i64 {
    lex.advance_i();                    // 吃掉 `@`
    var nti: i64 = lex.advance_i();     // 吃掉 `module`
    expect_tok("LParen");
    var attrs: string = "";
    var more: bool = true;
    while (more) {
        var ati: i64 = lex.pos;
        var an: string = "";
        if (lex.cur_v() == "pub") {
            lex.advance_i();
            an = "pub";
        } else {
            if (lex.cur_t() == "Identifier") {
                an = expect_tok("Identifier");
            } else {
                parse_fatal_at("T-PAR-E101", "expected module attribute name", ati);
            }
        }
        if (an != "pub" && an != "internal") {
            parse_fatal_at("T-PAR-E101",
                base.sb_cat3("unknown module attribute '", an, "' (expected `pub` or `internal`)"), ati);
        }
        if (str_len(attrs) == 0) {
            attrs = an;
        } else {
            attrs = base.sb_cat3(attrs, ",", an);
        }
        if (lex.cur_t() == "Comma") {
            lex.advance_i();
        } else {
            more = false;
        }
    }
    expect_tok("RParen");
    // 指令后分号可选（注解形状本不带分号，但允许 `;` 以便与旧语句写法统一）。
    if (lex.cur_t() == "Semicolon") { lex.advance_i(); }
    return base.mk_ModuleDecl(attrs, nti);
}

// @import("src.path.to.module_a") / @import("std.math") [:: * | :: a, b]
// 复用 ImportModDecl 节点：sb=剥离 src 后的模块名, sc=别名, bd=true 走库搜索路径；
// lb=选择性/通配导入项链表（与旧 import 的 `::` 同构）。`pub @import(...)` 由
// parse_declaration 在调用前置 bc=true（模块重导出，见 sema.collect_module_defs）。
pub fn parse_at_import_decl() i64 {
    lex.advance_i();                    // 吃掉 `@`
    lex.advance_i();                    // 吃掉 `import`（KwImport）
    expect_tok("LParen");
    var pti: i64 = lex.pos;
    var mname: string = expect_tok("String");
    // M3.3：删除导入级 `as` 别名（统一用 `const X = @import("src.M")` 的绑定名 X 作别名；
    // 模块身份按完整路径 idn 区分，末段同名模块不再需 as 消歧）。
    var alias: string = "";
    var has_alias: bool = false;
    // 选择性/通配导入项：`:: *` 或 `:: a, b`（与旧 import 的 `::` 同构，存于节点 lb；M3.3 起不再支持 `a as c` 重命名）。
    // ⚠ 顺序：必须在闭合 `)` 之前消费（`@import("x" :: *)` 的 `::` 在括号内）。
    var items: i64 = -1;
    if (lex.cur_t() == "DoubleColon") {
        lex.advance_i();
        items = parse_import_items();
    }
    expect_tok("RParen");
    if (lex.cur_t() == "Semicolon") { lex.advance_i(); }
    var is_lib_path: bool = true;
    var rest: string = mname;
    if (first_segment(mname) == "src") {
        is_lib_path = false;
        rest = drop_first_segment(mname);
    }
    var id: i64 = base.mk_ImportModDecl(rest, alias, has_alias, is_lib_path, -1, pti);
    base.node_set_lb((id as u64), items);
    return id;
}

// parse_type_alias 已由 GEN:parser 区间生成（见下方标记区）

pub fn parse_decl_body(name: string, anns: i64, is_comptime: bool) i64 {
    var layout: string = "auto";   // 默认布局内部标签（非关键字；不写修饰即默认）
    if (lex.cur_t() == "Hash") {
        lex.advance_i();
        var li: i64 = lex.advance_i();
        if (lex.tk_t(li) == "Identifier") {
            var lv: string = lex.tk_v(li);
            if (lv == "soa") {
                layout = "soa";
            } else {
                if (lv == "aos") {
                    layout = "aos";
                }
            }
        }
    }

    // >>> GEN:parser_dispatch (generated by tools/totter.tc from out/ebnf.json dispatches -- DO NOT EDIT) >>>
    var t: string = lex.cur_t();
    // 方言统一（Stage 3）：名先行类型声明 `Name struct` / `Name enum` / `Name union` /
    // `Name flag` / `Name variant` / `Name agent` / `Name flag_set` 已废弃，统一为关键字领头
    // `struct Name` / `enum Name` / ...。转换工具 tools/stage3_convert.mjs 已把整树源码迁到
    // 新文法，此处不再兼容旧式（与 Stage 2 的 `fn name` 收紧一致）。关键字领头桥在
    // parse_declaration 中处理（消费关键字 → 读名字 → 调用对应 parse_*_decl）。
    if (t == "KwStruct") {
        parse_fatal_at("T-PAR-E102", base.sb_cat5("type declarations must use the `struct ", name, "` form; `", name, " struct` is no longer supported"), lex.pos);
    }
    if (t == "KwEnum") {
        parse_fatal_at("T-PAR-E102", base.sb_cat5("type declarations must use the `enum ", name, "` form; `", name, " enum` is no longer supported"), lex.pos);
    }
    if (t == "KwUnion") {
        parse_fatal_at("T-PAR-E102", base.sb_cat5("type declarations must use the `union ", name, "` form; `", name, " union` is no longer supported"), lex.pos);
    }
    if (t == "KwVariant") {
        parse_fatal_at("T-PAR-E102", base.sb_cat5("type declarations must use the `variant ", name, "` form; `", name, " variant` is no longer supported"), lex.pos);
    }
    if (t == "KwAgent") {
        parse_fatal_at("T-PAR-E102", base.sb_cat5("type declarations must use the `agent ", name, "` form; `", name, " agent` is no longer supported"), lex.pos);
    }
    if (t == "KwFunc") {
        // `step fn(...)` 是 agent 子句关键字形式（非普通函数声明），保留旧路径以兼容
        // tests/conformance/fail/f22_clause_body.tc（其 EXPECT: error T_FUNC_CLAUSE_BODY）。
        if (name == "step") {
            lex.advance_i();
            return parse_func_decl(name, anns, is_comptime, false);
        }
        parse_fatal_at("T-PAR-E102", base.sb_cat3("function declarations must use the `fn name(...)` form; `", name, " fn(...)` is no longer supported"), lex.pos);
    }
    return parse_type_alias(name, anns);
// <<< GEN:parser_dispatch <<<
}

// ═══════════════════════════════════════════════════════════════
// 测试声明（关键字领头式 LL(1) / docs/syntax/drafts/decl_test.md）
//
//   test "加法应返回两数之和" {
//       expect(add(2, 3) == 5);
//   }
//
//   suite "math" {
//       test "加法" { ... }
//       suite "取模" { test "负数被除" { ... } }
//   }
//
// 与 `fn name(...)` / `struct Name {}` / `enum Name {}` 同构：关键字领头、
// 名字在后（LL(1) 关键字领头桥，见下方 flag_set 桥）。`test`/`suite` 是**语境
// 标识符**：不进 keywords_tbl，只在声明位、紧跟测试名字符串前被识别，因此对
// 存量标识符零冲突（含 `test` 模块名、`fn test()`；先例：flag_set）。
//
// 脱糖到一个普通的布尔函数，sema 主通路与两个后端零改动：
//
//   __test_0 fn() bool { <body> return true; }
//
// 测试身份记在 FuncDecl 自己的空闲槽上，**不合成 `@test` 注解**：
//   bd = true   → 这是一条测试
//   sb          → 显示名（"加法应返回两数之和"）
//   sc          → suite 路径（"math / 嵌套"，顶层为 ""）
// 之所以不挂 `@test`：① `@test` 在 tc 里零消费者（只被注解表校验），挂上去
// 没有任何收益；② `@test` 现已标记为**弃用注解**，合成节点会误触发告警。
// ═══════════════════════════════════════════════════════════════

pub var g_test_seq: i64 = 0;      // 合成测试函数序号（整个编译单元内唯一）
pub var g_suite_path: string = "";  // 当前 suite 嵌套路径，形如 "math / 取模"

// 复制一条注解链（浅拷贝 A 节点、共享实参链）。
// suite 上的注解要下沉给每个成员，但 list_concat 会**就地改写**链尾，
// 直接共享同一条链会让第一个成员把自己的注解永久嫁接到 suite 链上。
pub fn clone_ann_list(head: i64) i64 {
    var nh: i64 = -1;
    var nt: i64 = -1;
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
    // ⦁ 循环体只往**新建链**（nh/nt，初值 -1）追加，不回写被遍历的 `head` 链
    var ks: []i64 = base.kids_chain(head);
    var ki: i64 = 0;
    while (ki < slice_len(ks) as i64) {
        var a: i64 = ks[ki];
        var cp: i64 = base.mk_A(base.node_sa((a as u64)), base.node_la((a as u64)), -1);
        base.node_set_span_id(cp, base.node_span_id(a));
        base.node_set_span_id(cp, base.node_span_id(a));
        base.node_set_span_id(cp, base.node_span_id(a));
        nt = base.list_push(nh, nt, cp);
        if (nh < 0) {
            nh = nt;
        }
        ki = ki + 1;
    }
    return nh;
}

// `test "名字" { ... }` → 合成 `__test_<n> fn() bool { ... return true; }`
// 关键字领头（LL(1)）：`test`/`suite` 是语境标识符，只在声明位、紧跟测试名
// 字符串前被识别，对 `test` 模块名 / `fn test()` 等存量标识符零冲突（同 flag_set）。
pub fn parse_test_decl(anns: i64, is_export: bool) i64 {
    if (lex.cur_t() != "String") {
        parse_fatal("expected test name string after 'test'");
    }
    var nti: i64 = lex.advance_i();
    var disp: string = lex.tk_v(nti);
    if (str_len(disp) == 0) {
        parse_fatal("test name must not be an empty string");
    }
    // 名字后可跟修饰注解（@skip/@only/@should_fail/@tag），与 `test` 前的
    // 前导注解（anns）等价，二者合并进同一条注解链。
    var post: i64 = parse_annotations();
    var all: i64 = list_concat(anns, post);

    if (lex.cur_t() != "LBrace") {
        parse_fatal("expected '{' after test name / annotations");
    }
    var body: i64 = parse_block();

    // 隐式 `return true;`：测试块以「跑完没炸」为通过，无需显式返回。
    // 显式 `return false;` 或 expect 失败会提前返回，此句即成死代码。
    var rt: i64 = base.mk_return(base.mk_bool(true, nti), nti);
    body = list_concat(body, base.list_push(-1, -1, rt));

    var name: string = base.sb_cat2("__test_", base.i2s(g_test_seq));
    g_test_seq = g_test_seq + 1;

    // 返回类型必须走 mk_scalar（`bool` 是标量名）；用 mk_named 会造出一个
    // 同名但不同种类的类型节点，报出 "expected bool but got bool" 的怪错。
    var fd: i64 = base.mk_FuncDecl(name, false, false, base.mk_scalar("bool", -1), all, -1, body, nti);
    base.node_set_bd((fd as u64), true);   // 是测试（S4 §0.14.7 SoA：原 `fn_n.bd = true`）
    base.node_set_sb((fd as u64), disp);             // 显示名
    base.node_set_sc((fd as u64), g_suite_path);   // S4 §0.14.7 SoA：取代 `fn_n.sc`（下方 slice_set 回写，写真实生效）
    base.node_set_bc((fd as u64), is_export);   // 模块可见性（`pub test "..." {}` 时为真；S4 §0.14.7 SoA 侧表写）
    // 注意：入列由调用方负责（顶层经 parse_unit 的 append；suite 体内由
    // parse_suite_decl 的循环 append），此处**不再**自 append，否则会与
    // parse_unit 重复入列造成同名 FuncDecl 双份 → 子句组合并误报 E811。
    return fd;
}

// `suite "名字" { ... }` → 纯词法分组，自身不产生任何声明。
pub fn parse_suite_decl(anns: i64) i64 {
    if (lex.cur_t() != "String") {
        parse_fatal("expected suite name string after 'suite'");
    }
    var nti: i64 = lex.advance_i();
    var disp: string = lex.tk_v(nti);
    if (str_len(disp) == 0) {
        parse_fatal("suite name must not be an empty string");
    }
    // 名字后可跟修饰注解；前导注解（anns）来自 suite 外的 `@xxx suite "g" {}`，
    // 与名字后注解合并后逐成员下沉。
    var post: i64 = parse_annotations();
    var all: i64 = list_concat(anns, post);

    if (lex.cur_t() != "LBrace") {
        parse_fatal("expected '{' after suite name / annotations");
    }
    lex.advance_i();

    var saved: string = g_suite_path;
    if (str_len(saved) > 0) {
        g_suite_path = base.sb_cat3(saved, " / ", disp);
    } else {
        g_suite_path = disp;
    }

    while (lex.cur_t() != "RBrace" && lex.cur_t() != "Eof") {
        if (lex.cur_t() == "Semicolon") {
            lex.advance_i();
            continue;
        }
        var mann: i64 = parse_annotations();
        // suite 注解逐成员复制下沉（@skip/@tag 因此天然作用于整组）
        mann = list_concat(clone_ann_list(all), mann);
        if (lex.cur_t() == "Identifier" && lex.cur_v() == "test") {
            lex.advance_i();
            var tb: i64 = parse_test_decl(mann, false);
            if (tb >= 0) { append(lex.decl_list, tb); }
        } else if (lex.cur_t() == "Identifier" && lex.cur_v() == "suite") {
            lex.advance_i();
            parse_suite_decl(mann);
        } else {
            parse_fatal("a suite body may only contain `test \"name\" {}` / `suite \"name\" {}` declarations");
        }
    }
    expect_tok("RBrace");
    g_suite_path = saved;
    return -1;
}

// ════════════════════════════════════════════════════════════════════════
// `expect` 语句（测试语法现代化的断言内建）
//
// expect 是语境关键字（不进 keywords_tbl），仅在语句位置、紧跟 `(` 时被识别
// （与 flag_set / test / suite 同一思路，零冲突）。它在 parser 期直接脱糖为
// 普通 if/eprint/format 语句，因此：
//   ① 不需要在 builtin_ret 注册 → 不需要 tc0 镜像，difftest 字节级一致不受影响；
//   ② 不需要新增任何 runtime 符号（eprint 接收 string，format 内建的类型分派
//      在 sema 自动完成）；
//   ③ sema 看到的是普通 if 语句，无需改动。
//
//   expect(EXPR);          →  if (!(EXPR)) { eprint(format("expect failed: {} @ {}:{}", "<EXPR源码>", "<file>", "<line>")); return false; }
//   expect(EXPR, "msg");   →  if (!(EXPR)) { eprint(format("expect failed: {} @ {}:{}  ({})", "<EXPR源码>", "<file>", "<line>", "<msg>")); return false; }
//
// 约定：expect 用于测试函数体（返回 bool）。失败即 `return false`，由 `tc test`
// 运行器收集为「该测试失败」并继续后续测试（不会 exit 终止整个运行）。
// ════════════════════════════════════════════════════════════════════════

// token 类型是否为「词」（标识符 / 字面量 / 括号），用于源码文本重建时的空格决策。
pub fn is_word_tok(t: string) bool {
    if (t == "Identifier") { return true; }
    if (t == "Int" || t == "Float" || t == "String") { return true; }
    if (t == "LParen" || t == "RParen") { return true; }
    if (t == "LBracket" || t == "RBracket") { return true; }
    if (t == "LBrace" || t == "RBrace") { return true; }
    return false;
}

// 从 token 序列重建源码文本（token 无字节偏移，只能从 t/v 反推）。
// 运算符 / 括号紧贴；词与词之间加空格（函数名后接 `(` 视为调用，不加空格）。
pub fn rebuild_tokens(start: i64, end: i64) string {
    var s: string = "";
    var prev_t: string = "";
    var i: i64 = start;
    while (i < end) {
        var ct: string = lex.tk_t(i);
        var cv: string = lex.tk_v(i);
        if (str_len(s) > 0 && is_word_tok(prev_t) && is_word_tok(ct)) {
            if (!(prev_t == "Identifier" && ct == "LParen")) {
                s = base.sb_cat2(s, " ");
            }
        }
        s = base.sb_cat2(s, cv);
        prev_t = ct;
        i = i + 1;
    }
    return s;
}

pub fn parse_expect_stmt() i64 {
    var ti: i64 = lex.pos;            // 'expect' 关键字的 token 索引（取其行号）
    lex.advance_i();                  // 消费 'expect'
    expect_tok("LParen");         // 消费 '('
    var expr_start: i64 = lex.pos;    // 记录 EXPR 起点 token（紧跟 '(' 之后，不含括号）
    var expr: i64 = parse_expr();
    var expr_end: i64 = lex.pos;      // parse_expr 结束处（下一 token 即 ',' 或 ')'）；源码重建只取 EXPR 本身
    var msg: i64 = -1;
    if (lex.cur_t() == "Comma") {
        lex.advance_i();
        if (lex.cur_t() != "String") {
            parse_fatal("expect message must be a string literal");
        }
        msg = base.mk_string(lex.cur_v(), lex.pos);
        lex.advance_i();
    }
    expect_tok("RParen");
    if (lex.cur_t() == "Semicolon") {
        lex.advance_i();              // 消费语句结尾的 ';'
    }

    var src_text: string = rebuild_tokens(expr_start, expr_end);

    // format 参数链：tmpl, src_text, file, line [, msg]（全部为 string，零类型分派风险）
    // 模板两端的缩进与换行是**输出契约**：失败详情走 stderr，而 `tc test` 的判定行
    // （ok/FAILED）走 stdout；两股流交错时若详情不自带换行，会把判定词粘到同一行。
    var tmpl: string;
    if (msg >= 0) {
        tmpl = "  expect failed: {} @ {}:{}  ({})\n";
    } else {
        tmpl = "  expect failed: {} @ {}:{}\n";
    }
    var ah: i64 = -1;
    var at: i64 = -1;
    at = base.list_push(ah, at, base.mk_string(tmpl, -1)); if (ah < 0) { ah = at; }
    at = base.list_push(ah, at, base.mk_string(src_text, -1));
    at = base.list_push(ah, at, base.mk_string(base.g_file, -1));
    at = base.list_push(ah, at, base.mk_string(base.i2s(base.toks[ti].line), -1));
    if (msg >= 0) {
        at = base.list_push(ah, at, msg);
    }
    var fmt_call: i64 = base.mk_call(base.mk_ident("format", -1), ah, ti);
    var eprint_call: i64 = base.mk_call(base.mk_ident("eprint", -1), base.list_push(-1, -1, fmt_call), ti);

    // then 块：eprint(...); return false;
    // ⚠ eprint_call 必须用 mk_expr 包裹成「表达式语句」，否则 emit_stmt 遇到裸 call
    // 节点会直接 fallthrough（见 codegen_c.tc emit_stmt 末尾「其余未识别节点：不输出」）。
    var th: i64 = -1;
    var tt: i64 = -1;
    tt = base.list_push(th, tt, base.mk_expr(eprint_call, ti)); if (th < 0) { th = tt; }
    tt = base.list_push(th, tt, base.mk_return(base.mk_bool(false, ti), ti));

    var cond: i64 = base.mk_unary("!", expr, ti);
    return base.mk_if(cond, th, -1, ti);
}

pub fn parse_declaration() i64 {
    // 可见性/编译期前缀须在 `@` 文件级指令之前消费，使 `pub @import(...)`（模块重导出）
    // 与 `pub @module(...)` 可正确解析；`@` 指令自身仍不接任何前缀语义。
    var is_export: bool = false;
    if (lex.cur_v() == "pub") {
        lex.advance_i();
        is_export = true;
    }
    // `export` 关键字已删除；旧 `export` 同位置修饰（自举过渡）移除，统一用 `pub`（见 §3.13）。
    // comptime 前缀：置于最前，使其可修饰 var/const/fn/struct/...（编译期声明）
    var is_comptime: bool = false;
    if (lex.cur_t() == "KwComptime") {
        lex.advance_i();
        is_comptime = true;
    }
    // Device 入口限定符：`kernel fn name(params) ret { body }`。置于 comptime 之后、
    // `fn` 之前消费。`pub kernel fn` / `kernel fn` 均合法；语义位在 bf 标志（见 base.mk_FuncDecl）。
    var is_kernel: bool = false;
    if (lex.cur_v() == "kernel") {
        lex.advance_i();
        is_kernel = true;
    }

    // 文件级指令优先：@module(...) / @import("...") 后面不跟声明，
    // 在 parse_annotations 之前拦截（注解循环只认 `@标识符`，且 `@import`
    // 的 `import` 是关键字，注解循环本就吞不下它）。一次只处理一条，
    // 其余指令/注解留给下一轮 parse_declaration。
    if (lex.cur_t() == "At") {
        var pt1: string = lex.peek_t(1);
        if (pt1 == "Identifier" || pt1 == "KwImport") {
            var dname: string = lex.tk_v(lex.pos + 1);
            if (dname == "module") {
                return parse_module_decl();
            }
            if (dname == "import") {
                var d: i64 = parse_at_import_decl();
                if (is_export) {
                    base.node_set_bc((d as u64), true);   // S4 §0.14.7 SoA：取代「取值→改 bc→回写整节点」
                }
                return d;
            }
        }
    }
    var anns: i64 = parse_annotations();

    // 模块系统（M-Module）：顶层声明可用 `pub` 修饰，标记对外可见。
    // 旧 `export` 同位置修饰已删除（见 §3.13）；`pub` 与 `export` 曾等价置导出位，现统一仅 `pub`；
    // 真正的可见性判据是「文件 @module(pub) ∧ 声明 pub」，在 sema 侧合取。

    if (lex.cur_t() == "KwVar") {
        var d: i64 = parse_global_var(false, is_comptime);
        if (is_export) { base.node_set_bc((d as u64), true); }   // S4 §0.14.7 SoA
        return d;
    }
    if (lex.cur_t() == "KwConst") {
        var d: i64 = parse_global_var(true, is_comptime);
        base.node_set_const(d);
        if (is_export) { base.node_set_bc((d as u64), true); }   // S4 §0.14.7 SoA
        return d;
    }
    if (lex.cur_t() == "KwLet") {
        // 全局 `let`：动态常量，复用 GlobalConstDecl（语义等同；is_let 区分留待 CTFE Phase B）
        var d: i64 = parse_global_var(true, is_comptime);
        if (is_export) { base.node_set_bc((d as u64), true); }   // S4 §0.14.7 SoA
        return d;
    }
    if (lex.cur_t() == "KwImport") {
        // 旧 `import(X)` 括号形式已删除；统一改用 `@import("X")`（见 docs/reference.md §3.13）
        parse_fatal_at("T-PAR-E102", "`import(X)` was removed; write `@import(\"X\")` instead", lex.pos);
    }

    // ── overload 上下文关键词（Route 1）──
    // `overload fn name(...)` 声明一组同名函数子句；`extend overload fn name(...)`
    // 向本文件内已存在的 overload 组追加子句。二者解析为函数子句（FuncDecl），
    // 以节点 `ia` 槽标记（1=overload 声明 / 2=extend 追加），声明组复用既有
    // `desugar_func_clauses` 按名脱糖为单一函数 + match 臂。跨文件合并见 Route 2。
    if (lex.cur_v() == "overload") {
        lex.advance_i();   // 吃掉 `overload`
        if (lex.cur_t() == "KwStruct") {
            // ── overload struct（开放可扩展组，ia=1）──（struct-modifiers 设计 §2.1/§2.2）
            // 编译器合成尾部 `_` 扩展锚点；`extend overload struct` 追加字段/方法（同编译单元）。
            lex.advance_i();   // 吃掉 `struct`
            if (lex.cur_t() != "Identifier") {
                parse_fatal("expected struct name after 'struct' in overload struct declaration");
            }
            var sni_o: i64 = lex.advance_i();
            var sname_o: string = lex.tk_v(sni_o);
            lex.g_agent_anchor = sni_o;
            lex.g_struct_exported = is_export;
            base.validate_decl_name(sname_o, sni_o);
            var sd_o: i64 = parse_struct_decl(sname_o, anns, "auto");
            if (sd_o >= 0) {
                base.node_set_ia((sd_o as u64), 1);   // 1 = overload 组
                base.node_at(sd_o, sni_o);
                if (is_export) { base.node_set_bc((sd_o as u64), true); }   // S4 §0.14.7 SoA
            }
            return sd_o;
        }
        if (lex.cur_t() != "KwFunc") {
            // 与布局修饰互斥：`overload extern struct` / `overload packed struct` 不允许
            // （D9：extern 不支持 overload；packed 不开放扩展）。
            if (lex.cur_t() == "Identifier" && (lex.cur_v() == "extern" || lex.cur_v() == "packed")) {
                parse_fatal_at("T-PAR-E102",
                    base.sb_cat3("'overload' and layout modifier '", lex.cur_v(),
                        "' are mutually exclusive (overload struct does not support packed/extern layout)"),
                    lex.pos);
            }
            parse_fatal_at("T-PAR-E102", "expected 'fn' or 'struct' after 'overload'", lex.pos);
        }
        lex.advance_i();   // 吃掉 `fn`
        if (lex.cur_t() != "Identifier") {
            parse_fatal("expected function name after 'overload fn'");
        }
        var fni: i64 = lex.advance_i();
        var fname: string = lex.tk_v(fni);
        lex.g_agent_anchor = fni;
        lex.g_struct_exported = is_export;
        base.validate_decl_name(fname, fni);
        var fd: i64 = parse_func_decl(fname, anns, is_comptime, is_kernel);
        if (fd >= 0) {
            base.node_set_ia((fd as u64), 1);
            base.node_at(fd, fni);
            if (is_export) { base.node_set_bc((fd as u64), true); }   // S4 §0.14.7 SoA
            if (ann_find(anns, "c_export") >= 0) {
                base.node_set_be((fd as u64), true);   // S4 §0.14.7 SoA：取代 `base.nodes[fd].be = true`
                base.node_set_se((fd as u64), fname);
            }
        }
        return fd;
    }
    if (lex.cur_v() == "extend") {
        lex.advance_i();   // 吃掉 `extend`
        if (lex.cur_v() != "overload") {
            parse_fatal_at("T-PAR-E102", "expected 'overload' after 'extend'", lex.pos);
        }
        lex.advance_i();   // 吃掉 `overload`
        if (lex.cur_t() == "KwStruct") {
            // ── extend overload struct（跨模块追加字段+方法，ia=2）──（struct-modifiers 设计 §2.1/§2.2）
            // 复用函数 overload 的 extend 边机制（lex.g_extend_name/g_extend_file + emit_deps）。
            lex.advance_i();   // 吃掉 `struct`
            if (lex.cur_t() != "Identifier") {
                parse_fatal("expected struct name after 'struct' in extend overload struct declaration");
            }
            var sni_e: i64 = lex.advance_i();
            var sname_e: string = lex.tk_v(sni_e);
            lex.g_agent_anchor = sni_e;
            lex.g_struct_exported = is_export;
            base.validate_decl_name(sname_e, sni_e);
            var sd_e: i64 = parse_struct_decl(sname_e, anns, "auto");
            if (sd_e >= 0) {
                base.node_set_ia((sd_e as u64), 2);   // 2 = extend 追加
                base.node_at(sd_e, sni_e);
                if (is_export) { base.node_set_bc((sd_e as u64), true); }   // S4 §0.14.7 SoA
                // REQ-EXT-1：登记 extend 意图（组名 + 扩展者单元名），供 emit_deps 输出 extend 边。
                append(lex.g_extend_name, base.node_sa((sd_e as u64)));
                append(lex.g_extend_file, base.base_no_tc(base.node_file((sd_e as u64))));
            }
            return sd_e;
        }
        if (lex.cur_t() != "KwFunc") {
            parse_fatal_at("T-PAR-E102", "expected 'fn' after 'extend overload'", lex.pos);
        }
        lex.advance_i();   // 吃掉 `fn`
        if (lex.cur_t() != "Identifier") {
            parse_fatal("expected function name after 'extend overload fn'");
        }
        var fni: i64 = lex.advance_i();
        var fname: string = lex.tk_v(fni);
        lex.g_agent_anchor = fni;
        lex.g_struct_exported = is_export;
        base.validate_decl_name(fname, fni);
        var fd: i64 = parse_func_decl(fname, anns, is_comptime, is_kernel);
        if (fd >= 0) {
            base.node_set_ia((fd as u64), 2);
            base.node_at(fd, fni);
            if (is_export) { base.node_set_bc((fd as u64), true); }   // S4 §0.14.7 SoA
            if (ann_find(anns, "c_export") >= 0) {
                base.node_set_be((fd as u64), true);   // S4 §0.14.7 SoA：取代 `base.nodes[fd].be = true`
                base.node_set_se((fd as u64), fname);
            }
        }
        return fd;
    }

    // LL(1) 具名函数文法（兼容桥接）：`fn name(params) ret { body }`。
    // 旧 `name fn(...)` 并置式仍保留兼容（下方名字先行路径），二者由首个 token 消歧、不冲突。
    if (lex.cur_t() == "KwFunc") {
        lex.advance_i();   // 吃掉 `fn`
        if (lex.cur_t() != "Identifier") {
            parse_fatal("expected function name after 'fn' in function declaration");
        }
        var fni: i64 = lex.advance_i();
        var fname: string = lex.tk_v(fni);
        lex.g_agent_anchor = fni;
        lex.g_struct_exported = is_export;
        base.validate_decl_name(fname, fni);
        var fd: i64 = parse_func_decl(fname, anns, is_comptime, is_kernel);
        if (fd >= 0) {
            base.node_at(fd, fni);
            if (is_export) { base.node_set_bc((fd as u64), true); }   // S4 §0.14.7 SoA
            if (ann_find(anns, "c_export") >= 0) {
                base.node_set_be((fd as u64), true);   // S4 §0.14.7 SoA：取代 `base.nodes[fd].be = true`
                base.node_set_se((fd as u64), fname);
            }
        }
        return fd;
    }

    // ── LL(1) 关键字领头桥接：`enum Name {...}` / `struct Name {...}`（兼容 df5 文法）──
    // 与上方 `fn Name` 桥同构：消费关键字 → 读名字 → 复用 name-first 实现。
    // 注意：parse_enum_decl/parse_struct_decl 内部已不再自行 lex.advance_i() 关键字，
    // 故此处必须显式消费 `enum`/`struct`。
    if (lex.cur_t() == "KwEnum") {
        lex.advance_i();   // 吃掉 `enum`
        if (lex.cur_t() != "Identifier") {
            parse_fatal("expected enum name after 'enum' in enum declaration");
        }
        var eni: i64 = lex.advance_i();
        var ename: string = lex.tk_v(eni);
        lex.g_agent_anchor = eni;
        lex.g_struct_exported = is_export;
        base.validate_decl_name(ename, eni);
        var ed: i64 = parse_enum_decl(ename, anns);
        if (ed >= 0) {
            base.node_at(ed, eni);
            if (is_export) { base.node_set_bc((ed as u64), true); }   // S4 §0.14.7 SoA
        }
        return ed;
    }
    // ── `packed` 内置结构体修饰关键词（非全局保留关键字）──
    // 语境识别：仅声明头、紧跟 `struct` 前才识别；其余语境 `packed` 仍是普通标识符。
    // 积类型统一 epic P1：用 `packed struct X{...}` 取代 `flag`（位域打包）。layout 走
    // 现有 layout 传参链（parse_struct_decl → mk_StructDecl sb=layout → 下游 node_sb 消费），
    // 该 layout 值 `"packed"` 在 P4/P5 前对 codegen 等同默认布局（零 IR 漂移）。
    if (lex.cur_t() == "Identifier" && lex.cur_v() == "packed") {
        var pkw_i: i64 = lex.pos;   // 指向 `packed` token（用于错误定位）
        lex.advance_i();   // 吃掉 `packed`
        if (lex.cur_t() != "KwStruct") {
            parse_fatal_at("T-PAR-E102", "expected 'struct' after 'packed'", pkw_i);
        }
        lex.advance_i();   // 吃掉 `struct`
        var layout_p: string = "packed";
        if (lex.cur_t() != "Identifier") {
            parse_fatal("expected struct name after 'struct' in struct declaration");
        }
        var sni_p: i64 = lex.advance_i();
        var sname_p: string = lex.tk_v(sni_p);
        lex.g_agent_anchor = sni_p;
        lex.g_struct_exported = is_export;
        base.validate_decl_name(sname_p, sni_p);
        var sd_p: i64 = parse_struct_decl(sname_p, anns, layout_p);
        if (sd_p >= 0) {
            base.node_at(sd_p, sni_p);
            if (is_export) { base.node_set_bc((sd_p as u64), true); }   // S4 §0.14.7 SoA
        }
        return sd_p;
    }

    // ── `extern` 结构体修饰关键词（C-API 严格 C 规范，关键字领头，镜像 packed）──
    // C-API 严格 C 规范：声明序 = 内存序、标准 C 对齐/填充、C 兼容；专用于 capi / C FFI；
    // 不支持 overload/extend（与 OpenMod 互斥，待 overload 落地后由 sema 校验）。
    // `extern` 在词法上仍是普通标识符（非保留关键字，与 `packed` 同构），仅在声明头、紧跟
    // `struct` 前被识别为布局修饰；其余语境（含 `#extern` 注解）仍是普通标识符。peek 守卫
    // 确保只对 `extern struct X` 生效，避免误吞 `extern` 作为普通标识符的用法。
    if (lex.cur_t() == "Identifier" && lex.cur_v() == "extern") {
        var xkw_i: i64 = lex.pos;   // 指向 `extern` token（用于错误定位）
        lex.advance_i();   // 吃掉 `extern`
        if (lex.cur_t() == "KwStruct") {
            lex.advance_i();   // 吃掉 `struct`
            var layout_x: string = "extern";
            if (lex.cur_t() != "Identifier") {
                parse_fatal("expected struct name after 'struct' in extern struct declaration");
            }
            var sni_x: i64 = lex.advance_i();
            var sname_x: string = lex.tk_v(sni_x);
            lex.g_agent_anchor = sni_x;
            lex.g_struct_exported = is_export;
            base.validate_decl_name(sname_x, sni_x);
            var sd_x: i64 = parse_struct_decl(sname_x, anns, layout_x);
            if (sd_x >= 0) {
                base.node_at(sd_x, sni_x);
                if (is_export) { base.node_set_bc((sd_x as u64), true); }   // S4 §0.14.7 SoA
            }
            return sd_x;
        }
        // D9：`extern` 与 `overload` 互斥（extern 专用于 C 兼容、布局须稳定，不支持 overload/extend）。
        if (lex.cur_v() == "overload") {
            parse_fatal_at("T-PAR-E102",
                "'extern' and 'overload' are mutually exclusive (extern does not support overload/extend)",
                xkw_i);
        }
        parse_fatal_at("T-PAR-E102", "expected 'struct' after 'extern'", xkw_i);
    }

    if (lex.cur_t() == "KwStruct") {
        lex.advance_i();   // 吃掉 `struct`
        // layout 注解 #soa/#aos：name-first 文法在 parse_decl_body 检测；
        // 关键字领头文法里它出现在 struct 之后、名字之前，此处等价检测。
        var layout: string = "auto";   // 默认布局内部标签（非关键字；不写修饰即默认）
        if (lex.cur_t() == "Hash") {
            lex.advance_i();
            var li: i64 = lex.advance_i();
            // 布局注解值：`soa`/`aos` 是普通标识符（容器布局轴，与成员布局正交，保留）。
            // `#auto`/`#extern` 已升级为关键字（默认 / extern），此处不再接受；见到即忽略（走默认布局）。
            if (lex.tk_t(li) == "Identifier") {
                var lv: string = lex.tk_v(li);
                if (lv == "soa") { layout = "soa"; }
                else if (lv == "aos") { layout = "aos"; }
            }
        }
        if (lex.cur_t() != "Identifier") {
            parse_fatal("expected struct name after 'struct' in struct declaration");
        }
        var sni: i64 = lex.advance_i();
        var sname: string = lex.tk_v(sni);
        lex.g_agent_anchor = sni;
        lex.g_struct_exported = is_export;
        base.validate_decl_name(sname, sni);
        var sd: i64 = parse_struct_decl(sname, anns, layout);
        if (sd >= 0) {
            base.node_at(sd, sni);
            if (is_export) { base.node_set_bc((sd as u64), true); }   // S4 §0.14.7 SoA
        }
        return sd;
    }

    // ── 关键字领头桥接（续）：union / flag / variant / agent / flag_set ──
    // 与 enum/struct 桥同构：消费关键字 → 取名字 → 复用 name-first 实现。
    // union/flag/variant/agent/flag_set 的 parse_*_decl 内部自行 lex.advance_i() 吞掉关键字，
    // 故此处消费关键字后，名字 token 留给函数体首行 lex.advance_i() 吞掉（名字已作参数传入，不再从 token 读）。
    // 局部变量用 *_b 后缀，避免与后续模块（sema/codegen_*）中的同名函数撞名导致 dag 反向引用误报。
    if (lex.cur_t() == "KwUnion") {
        lex.advance_i();
        if (lex.cur_t() != "Identifier") { parse_fatal("expected union name after 'union' in union declaration"); }
        var uname: string = lex.cur_v();
        var uidx: i64 = lex.pos;
        lex.g_agent_anchor = uidx; lex.g_struct_exported = is_export;
        base.validate_decl_name(uname, uidx);
        var u_b: i64 = parse_union_decl(uname, anns);
        if (u_b >= 0) { base.node_at(u_b, uidx); if (is_export) { base.node_set_bc((u_b as u64), true); } }   // S4 §0.14.7 SoA
        return u_b;
    }
    if (lex.cur_t() == "KwVariant") {
        lex.advance_i();
        if (lex.cur_t() != "Identifier") { parse_fatal("expected variant name after 'variant' in variant declaration"); }
        var vname: string = lex.cur_v();
        var vidx: i64 = lex.pos;
        lex.g_agent_anchor = vidx; lex.g_struct_exported = is_export;
        base.validate_decl_name(vname, vidx);
        var v_b: i64 = parse_variant_decl(vname, anns);
        if (v_b >= 0) { base.node_at(v_b, vidx); if (is_export) { base.node_set_bc((v_b as u64), true); } }   // S4 §0.14.7 SoA
        return v_b;
    }
    if (lex.cur_t() == "KwAgent") {
        lex.advance_i();
        if (lex.cur_t() != "Identifier") { parse_fatal("expected agent name after 'agent' in agent declaration"); }
        var aname: string = lex.cur_v();
        var aidx: i64 = lex.pos;
        lex.g_agent_anchor = aidx; lex.g_struct_exported = is_export;
        base.validate_decl_name(aname, aidx);
        var a_b: i64 = parse_agent_decl(aname, anns);
        if (a_b >= 0) { base.node_at(a_b, aidx); if (is_export) { base.node_set_bc((a_b as u64), true); } }   // S4 §0.14.7 SoA
        return a_b;
    }
    // test/suite 关键字领头（LL(1)）：`test "名字" {}` / `suite "名字" {}`。
    // 与 flag_set 同款语境标识符路线：只有声明位、紧跟测试名字符串前才识别，
    // 对存量标识符（含 `test` 模块名、`fn test()`）零冲突。进入此分支即确定
    // 是测试/suite 声明，后续由下一个 token（String 名）完成 LL(1) 派发。
    if (lex.cur_t() == "Identifier" && lex.cur_v() == "test") {
        lex.advance_i();   // 吃掉 `test`
        return parse_test_decl(anns, is_export);
    }
    if (lex.cur_t() == "Identifier" && lex.cur_v() == "suite") {
        lex.advance_i();   // 吃掉 `suite`
        return parse_suite_decl(anns);
    }

    if (lex.cur_t() != "Identifier") {
        parse_fatal(base.sb_cat2("expected declaration name but found ", lex.cur_v()));
    }
    var ni: i64 = lex.advance_i();
    var name: string = lex.tk_v(ni);
    lex.g_agent_anchor = ni;
    lex.g_struct_exported = is_export;
    base.validate_decl_name(name, ni);

    // 声明形态为 `Name fn(...)` / `Name struct {...}`，绑定符 `::` 已移除。
    // 遇到旧写法给出带名字的迁移指引，而非笼统的语法错误。
    if (lex.cur_t() == "DoubleColon") {
        parse_fatal_at("T-PAR-E102", base.sb_cat5("the '::' binder was removed; write `", name, " fn(...)` / `", name, " struct {...}` instead"), lex.pos);
    }
    // `func` 已更名为 `fn`：否则会落进 type-alias 分支报出无关的 "expected Semicolon"。
    if (lex.cur_t() == "Identifier" && lex.cur_v() == "func") {
        parse_fatal_at("T-PAR-E102", base.sb_cat3("keyword 'func' was renamed to 'fn'; write `", name, " fn(...)` instead"), lex.pos);
    }

    var d: i64 = parse_decl_body(name, anns, is_comptime);
    if (d >= 0) {
        base.node_at(d, ni);
        if (is_export) { base.node_set_bc((d as u64), true); }   // S4 §0.14.7 SoA
    }
    return d;
}

pub fn parse_unit() void {
    while (lex.cur_t() != "Eof") {
        if (lex.cur_t() == "Semicolon") {
            lex.advance_i();
            continue;
        }
        var d: i64 = parse_declaration();
        if (d >= 0) {
            append(lex.decl_list, d);
        }
        // struct 体内方法脱糖出的顶层自由函数：紧跟宿主 struct 之后入列，
        // 保证 register 阶段先见 struct 再见方法。非 struct 声明时为空操作。
        flush_struct_methods();
        flush_struct_consts();
    }
    // 注意：子句合并（desugar_func_clauses）与 lambda 提升（desugar_lambdas）
    // 现在改在 run_check 里、模块内联（resolve_modules）完成之后统一跑一遍，
    // 以便覆盖「入口 + 所有被 import 的模块」合并后的整张 decl_list。
}

// ═══════════════════════════════════════════════════════════════
// 函数子句语法糖脱糖（L-15 / docs/syntax/drafts/match.md §7 用户裁定）
//
// 多条同名 FuncDecl 构成「子句组」。子句**不是重复声明**——它属于词法/语法
// 子层的书写便利，编译期在 AST lowering 阶段被强制展开为**单一** FuncDecl，
// 其体为 `return match (__p0) { ... };`。`match` 因此是唯一语义真源（L-04）。
//
//   classify fn(0) string { "zero" }
//   classify fn(n when n > 0) string { "positive" }
//   classify fn(_) string { "non-positive" }
// ⇓
//   classify fn(__p0: i64) string {
//       return match (__p0) { 0 => "zero"  n when n > 0 => "positive"  _ => "non-positive" };
//   }
//
// 组内首个子句在 decl_list 中被就地替换为合并后的 FuncDecl；其余子句节点
// kind 改写为 "ClauseDead" 且清空注解链，从而对 register / check / 双后端
// 发射的所有 `kind == "FuncDecl"` 分派不可见（不新增死代码路径）。
// ═══════════════════════════════════════════════════════════════

pub var g_fc_d: [64]i64;      // 组内各子句的 FuncDecl 节点
pub var g_fc_i: [64]i64;      // 各子句在 decl_list 中的下标
pub var g_fc_n: i64 = 0;

// ── R3 类型组（类别格分派）全局表 ──────────────────────────────────
// desugar_func_clauses 把类型组脱糖为内部函数 __name__cK + 入口包装 name(ia==3)；
// 本表供 sema 在调用点按实参静态类型选最具体子句（静态分派，不依赖运行期类型标签）。
// 扁平存储：g_ovl_tg_cat / g_ovl_tg_func 按「组0全子句, 组1全子句, ...」顺序拼接。
pub var g_ovl_tg_names: []string;   // 各组入口名（name）
pub var g_ovl_tg_cat: []string;     // 各子句声明类别名（与 func 平行）
pub var g_ovl_tg_func: []string;    // 各子句内部函数名（__name__cK）
pub var g_ovl_tg_n: []i64;          // 各组子句数

pub fn ovl_find_group(name: string) i64 {
    var n: i64 = slice_len(g_ovl_tg_names) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (g_ovl_tg_names[i] == name) { return i; }
        i = i + 1;
    }
    return -1;
}

pub fn ovl_group_base(gi: i64) i64 {
    var b: i64 = 0;
    var i: i64 = 0;
    while (i < gi) { b = b + g_ovl_tg_n[i]; i = i + 1; }
    return b;
}

pub fn ovl_group_count(gi: i64) i64 { return g_ovl_tg_n[gi]; }

pub fn ovl_group_cat_at(gi: i64, ci: i64) string {
    return g_ovl_tg_cat[ovl_group_base(gi) + ci];
}
pub fn ovl_group_func_at(gi: i64, ci: i64) string {
    return g_ovl_tg_func[ovl_group_base(gi) + ci];
}

// 子句首参的声明类别名（解析期字符串，无需 TD）：
//   标量类型节点 → 其名（i64）；具名/类别节点 → 其名（anykind / Point）。
pub fn fc_param_catname(p0: i64) string {
    if (p0 < 0) { return ""; }
    var tn: i64 = base.node_na((p0 as u64));
    if (tn < 0) { return ""; }
    if (base.node_kind((tn as u64)) == "scalar") { return base.node_sa((tn as u64)); }
    if (base.node_kind((tn as u64)) == "named") { return base.node_sa((tn as u64)); }
    if (base.node_kind((tn as u64)) == "void") { return "void"; }
    return base.node_sa((tn as u64));
}

// ── R3 类别格（静态分派）辅助 ──────────────────────────────────
// 类别模板节点 id：Concrete 子句 = -1；类别子句 = 其 FuncDecl 节点 id
// （desugar 期降级为 ClauseDead，调用点按需克隆单态化）。
pub var g_ovl_tg_tmpl: []i64;

pub fn ovl_tmpl_at(gi: i64, ci: i64) i64 {
    return g_ovl_tg_tmpl[ovl_group_base(gi) + ci];
}

pub fn ovl_is_category(c: string) bool {
    if (c == "anykind") { return true; }
    if (c == "scalarkind") { return true; }
    if (c == "integralkind") { return true; }
    if (c == "floatkind") { return true; }
    if (c == "namedkind") { return true; }
    return false;
}

pub fn ovl_is_integral(a: string) bool {
    if (a == "i8" || a == "i16" || a == "i32" || a == "i64") { return true; }
    if (a == "u8" || a == "u16" || a == "u32" || a == "u64") { return true; }
    return false;
}

pub fn ovl_is_float(a: string) bool {
    if (a == "f16" || a == "f32" || a == "f64") { return true; }
    return false;
}

// 子句声明类别 C 对静态实参类型 A 的「具体程度」(specificity)。
//   < 0 表示不覆盖；-1 = 具体类型精确匹配（最具体）；>=0 = 类别匹配，值越小越具体。
// ⚠ 直接展开类别格，不借助「函数返回 []string」的中间表 —— t 当前对「函数返回数组字面量」
//   的切片不做逃逸提升，跨帧读回 p[i] 会得到悬空内存（实测 integralkind 子句恒判 -2）。
pub fn ovl_specificity(a: string, c: string) i64 {
    if (ovl_is_category(c) == false) {
        if (a == c) { return -1; }
        return -2;
    }
    if (c == "anykind") { return 2; }
    if (c == "scalarkind") {
        if (ovl_is_integral(a) || ovl_is_float(a) || a == "string" || a == "bytes" || is_scalar_name(a)) { return 1; }
        return -2;
    }
    if (c == "integralkind") {
        if (ovl_is_integral(a)) { return 0; }
        return -2;
    }
    if (c == "floatkind") {
        if (ovl_is_float(a)) { return 0; }
        return -2;
    }
    if (c == "namedkind") {
        // 具名类型（非标量、非 string/bytes）：struct / enum / flag / variant / typealias 等。
        if (ovl_is_integral(a) == false && ovl_is_float(a) == false
            && a != "string" && a != "bytes" && is_scalar_name(a) == false) {
            return 0;
        }
        return -2;
    }
    return -2;
}

// 子句是否纯裸绑定（无模式、无守卫、所有形参均无模式/守卫）→ 归为类型组分派。
pub fn fc_clause_is_bare(cd: i64) bool {
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
    var ks: []i64 = base.kids_chain(base.node_lb((cd as u64)));
    var ki: i64 = 0;
    while (ki < slice_len(ks) as i64) {
        var pp: i64 = ks[ki];
        if (base.node_nb((pp as u64)) >= 0 || base.node_nc((pp as u64)) >= 0) { return false; }
        ki = ki + 1;
    }
    return true;
}

pub fn fc_group_is_type() bool {
    var i: i64 = 0;
    while (i < g_fc_n) {
        if (fc_clause_is_bare(g_fc_d[i]) == false) { return false; }
        i = i + 1;
    }
    return true;
}

// 子句诊断（脱糖发生在 parse 之后、check 之前，g_file 此时已就绪）
pub fn fc_err(code: string, msg: string, d: i64) void {
    var l: i64 = n_line(d);
    var c: i64 = n_col(d);
    base.diag_new(code, "error", msg, n_file(d), l, c, l, c + 4);
}

// 类型节点的结构指纹（脱糖期尚无 scope，故不走 resolve_ti）
pub fn fc_type_key(t: i64) string {
    if (t < 0) { return "<none>"; }
    return base.sb_cat4(base.node_kind((t as u64)), ":", base.node_sa((t as u64)), base.sb_cat2("/", base.node_sb((t as u64))));
}

// P 节点是否为「模式参数」（即非 `name: type` / `_: type` 普通参数）。
// 注意：带类型标注的 `_ : T` 只是「不使用的普通形参」，不触发脱糖；
// 裸 `_`（无类型）走 na < 0 分支，仍算模式。
pub fn pp_is_pattern(p: i64) bool {
    if (base.node_nb((p as u64)) >= 0) { return true; }
    if (base.node_nc((p as u64)) >= 0) { return true; }
    if (base.node_na((p as u64)) < 0) { return true; }
    return false;
}

pub fn fc_list_nth(h: i64, idx: i64) i64 {
    var n: i64 = 0;
    var c: i64 = h;
    while (c >= 0) {
        var k: Child = base.kids[c];
        if (n == idx) { return k.val; }
        n = n + 1;
        c = k.next;
    }
    return -1;
}

// 子句体须为单一表达式（match arm 体即表达式）。接受 `{ expr }` 与
// `{ return expr; }` 两种写法，取出其表达式；不满足返回 -1。
pub fn fc_body_expr(d: i64) i64 {
    if (base.node_lc((d as u64)) < 0) { return -1; }
    var k: Child = base.kids[base.node_lc((d as u64))];
    if (k.next >= 0) { return -1; }
    if (base.node_kind((k.val as u64)) == "return") { return base.node_na((k.val as u64)); }
    if (base.node_kind((k.val as u64)) == "expr") { return base.node_na((k.val as u64)); }
    return -1;
}

// 由第 idx 个参数位推定类型节点：优先取任一子句的显式 `name: type` 标注，
// 否则由该位首个字面量模式推定；均无则返回 -1（报 T_FUNC_CLAUSE_NO_TYPE）。
pub fn fc_param_type(idx: i64) i64 {
    var i: i64 = 0;
    while (i < g_fc_n) {
        var p: i64 = fc_list_nth(base.node_lb((g_fc_d[i] as u64)), idx);
        if (p >= 0) {
            if (base.node_na((p as u64)) >= 0) { return base.node_na((p as u64)); }
        }
        i = i + 1;
    }
    var j: i64 = 0;
    while (j < g_fc_n) {
        var p2: i64 = fc_list_nth(base.node_lb((g_fc_d[j] as u64)), idx);
        if (p2 >= 0) {
            if (base.node_nb((p2 as u64)) >= 0) {
                if (base.node_kind((base.node_nb((p2 as u64)) as u64)) == "int") { return base.mk_scalar("i64", -1); }
                if (base.node_kind((base.node_nb((p2 as u64)) as u64)) == "float") { return base.mk_scalar("f64", -1); }
                if (base.node_kind((base.node_nb((p2 as u64)) as u64)) == "string") { return base.mk_scalar("string", -1); }
                if (base.node_kind((base.node_nb((p2 as u64)) as u64)) == "bool") { return base.mk_scalar("bool", -1); }
            }
        }
        j = j + 1;
    }
    return -1;
}

// 第 idx(>0) 参数位的形参名：该位若有裸绑定，全部子句须用同一名字
// （形参直接以该名命名，子句体无需改写）；否则用 __pN。
pub fn fc_param_name(idx: i64, gd: i64) string {
    var nm: string = "";
    var i: i64 = 0;
    while (i < g_fc_n) {
        var p: i64 = fc_list_nth(base.node_lb((g_fc_d[i] as u64)), idx);
        if (p >= 0) {
            if (base.node_ba((p as u64)) == false && base.node_nb((p as u64)) < 0 && str_len(base.node_sa((p as u64))) > 0) {
                if (str_len(nm) == 0) {
                    nm = base.node_sa((p as u64));
                } else {
                    if (nm != base.node_sa((p as u64))) {
                        fc_err("T-FUN-E810",
                            base.sb_cat4("function clause group '", base.node_sa((gd as u64)),
                                "': parameter #", base.sb_cat3(base.i2s(idx), " binds different names ('",
                                base.sb_cat4(nm, "' vs '", base.node_sa((p as u64)), "'); only parameter #0 may vary"))),
                            g_fc_d[i]);
                        return nm;
                    }
                }
            }
        }
        i = i + 1;
    }
    if (str_len(nm) == 0) { return base.sb_cat2("__p", base.i2s(idx)); }
    return nm;
}

// 把第 idx(>0) 参数位的模式折叠进 arm 守卫：字面量 → `pname == lit`。
pub fn fc_fold_guard(cond: i64, d: i64, arity: i64, pnames_head: i64) i64 {
    var r: i64 = cond;
    var idx: i64 = 1;
    while (idx < arity) {
        var p: i64 = fc_list_nth(base.node_lb((d as u64)), idx);
        if (p >= 0) {
            var extra: i64 = -1;
            if (base.node_nb((p as u64)) >= 0) {
                extra = base.mk_binary("==", base.mk_ident(base.node_sa((fc_list_nth(pnames_head, idx) as u64)), -1), base.node_nb((p as u64)), -1);
            }
            if (extra >= 0) {
                if (r < 0) { r = extra; } else { r = base.mk_binary("&&", r, extra, -1); }
            }
            if (base.node_nc((p as u64)) >= 0) {
                if (r < 0) { r = base.node_nc((p as u64)); } else { r = base.mk_binary("&&", r, base.node_nc((p as u64)), -1); }
            }
        }
        idx = idx + 1;
    }
    return r;
}

// 把当前 g_fc_* 中的子句组合并为单一 FuncDecl，就地写回 decl_list
pub fn fc_merge() void {
    var gd: i64 = g_fc_d[0];
    var arity: i64 = list_count(base.node_lb((gd as u64)));

    // 组内所有子句先行下线：kind 改写后对 register / check / 双后端发射的
    // 全部 `kind == "FuncDecl"` 分派不可见。无论合并成功与否都执行，确保同一
    // 组只被诊断一次（失败时首位仍指向已下线节点，畸形声明不会流入 check）。
    var z: i64 = 0;
    while (z < g_fc_n) {
        base.node_set_kind((g_fc_d[z] as u64), "ClauseDead");
        base.node_set_la((g_fc_d[z] as u64), -1);
        z = z + 1;
    }

    // 元数一致性
    var i: i64 = 1;
    while (i < g_fc_n) {
        if (list_count(base.node_lb((g_fc_d[i] as u64))) != arity) {
            fc_err("T-FUN-E811",
                base.sb_cat3("function clause group '", base.node_sa((gd as u64)), "': all clauses must have the same arity"),
                g_fc_d[i]);
            return;
        }
        i = i + 1;
    }
    if (arity < 1) {
        fc_err("T-FUN-E811",
            base.sb_cat3("function clause group '", base.node_sa((gd as u64)), "': pattern clauses require at least one parameter"),
            gd);
        return;
    }

    // 形参：名字 + 类型
    var ph: i64 = -1;
    var pt: i64 = -1;
    var idx: i64 = 0;
    while (idx < arity) {
        var ptn: i64 = fc_param_type(idx);
        if (ptn < 0) {
            fc_err("T-FUN-E812",
                base.sb_cat4("function clause group '", base.node_sa((gd as u64)), "': cannot infer type of parameter #",
                    base.sb_cat2(base.i2s(idx), "; annotate it as 'name: Type' in one clause")),
                gd);
            return;
        }
        var pnm: string = "";
        if (idx == 0) {
            pnm = "__p0";
        } else {
            pnm = fc_param_name(idx, gd);
        }
        pt = base.list_push(ph, pt, base.mk_P(pnm, ptn, -1, -1));
        if (ph < 0) { ph = pt; }
        idx = idx + 1;
    }

    // 返回类型一致性（以首子句为准）
    var k: i64 = 1;
    while (k < g_fc_n) {
        if (fc_type_key(base.node_na((g_fc_d[k] as u64))) != fc_type_key(base.node_na((gd as u64)))) {
            fc_err("T-FUN-E813",
                base.sb_cat3("function clause group '", base.node_sa((gd as u64)), "': all clauses must declare the same return type"),
                g_fc_d[k]);
            return;
        }
        k = k + 1;
    }

    // 逐子句 → match arm。两遍扫描：pass 0 具体臂、pass 1 通配（_）臂，
    // 保证「兜底晚于所有具体子句」（§2.4 / §3.3），并使 extend overload 追加的
    // 具体臂能先于通配生效（同文件 extend 在源码上位于通配之后也正确）。
    var ah: i64 = -1;
    var at: i64 = -1;
    var pass: i64 = 0;
    while (pass < 2) {
        var c: i64 = 0;
        while (c < g_fc_n) {
            var cd: i64 = g_fc_d[c];
            var p0: i64 = fc_list_nth(base.node_lb((cd as u64)), 0);
            var is_wild: bool = base.node_ba((p0 as u64));
            // 兜底臂 = 无守卫且无模式（裸绑定 name 与通配 _ 两种写法都算），必须晚于所有
            // 具体/守卫臂，否则会遮蔽后续子句（见 examples/overload_cross_a.tc：classify 的
            // "default" 子句须排在 when 守卫子句之后）。
            var is_catch_all: bool = (base.node_nc((p0 as u64)) < 0 && base.node_nb((p0 as u64)) < 0);
            // pass 0 仅非兜底臂（具体/守卫）；pass 1 仅兜底臂
            if ((pass == 0 && is_catch_all) || (pass == 1 && is_catch_all == false)) { c = c + 1; continue; }
            var be: i64 = fc_body_expr(cd);
            if (be < 0) {
                fc_err("T-FUN-E814",
                    base.sb_cat3("function clause group '", base.node_sa((gd as u64)),
                        "': clause body must be a single expression (it becomes a match arm)"),
                    cd);
                return;
            }
            var a_bind: string = "";
            var a_pat: i64 = base.node_nb((p0 as u64));
            if (is_wild == false && a_pat < 0) { a_bind = base.node_sa((p0 as u64)); }
            var a_guard: i64 = base.node_nc((p0 as u64));
            a_guard = fc_fold_guard(a_guard, cd, arity, ph);
            // arm 承接本子句的锚点：诊断（不可达 / 类型不符）指回原始子句而非合成节点
            var armid: i64 = base.mk_arm(a_bind, is_wild, a_pat, a_guard, be, -1);
            base.node_set_span_id(armid, base.node_span_id(cd));
            base.node_set_span_id(armid, base.node_span_id(cd));
            base.node_set_span_id(armid, base.node_span_id(cd));
            at = base.list_push(ah, at, armid);
            if (ah < 0) { ah = at; }
            c = c + 1;
        }
        pass = pass + 1;
    }

    // 合成 match 承接首子句锚点：T_MATCH_NONEXHAUSTIVE 才能报出文件与行列
    var scr: i64 = base.mk_ident("__p0", -1);
    base.node_set_span_id(scr, base.node_span_id(gd));
    base.node_set_span_id(scr, base.node_span_id(gd));
    base.node_set_span_id(scr, base.node_span_id(gd));
    var mx: i64 = base.mk_match(scr, ah, -1);
    base.node_set_span_id(mx, base.node_span_id(gd));
    base.node_set_span_id(mx, base.node_span_id(gd));
    base.node_set_span_id(mx, base.node_span_id(gd));
    var body: i64 = base.list_push(-1, -1, base.mk_return(mx, -1));
    var merged: i64 = base.mk_FuncDecl(base.node_sa((gd as u64)), false, base.node_bb((gd as u64)), base.node_na((gd as u64)), base.node_la((gd as u64)), ph, body, -1);
    base.node_set_span_id(merged, base.node_span_id(gd));
    base.node_set_span_id(merged, base.node_span_id(gd));
    base.node_set_span_id(merged, base.node_span_id(gd));
    slice_set(lex.decl_list, g_fc_i[0], merged);
}

// 类型组脱糖（R3 类别格静态分派）：每个子句变成独立真实函数 __name__cK，
// 调用点按首实参静态类型选最具体子句改写（见 sema.ovl_dispatch_call）。
//   · 具体类型子句：__name__cK 直接登记为普通 FuncDecl（参数类型即声明类型，ABI 正确）。
//   · 类别子句（anykind / scalarkind / integralkind / floatkind / namedkind）：
//     首参声明类型不是真实类型，无法登记；降级为 ClauseDead 保留节点，调用点按需
//     单态化（克隆 + 把类别名替换为具体类型，见 sema.ovl_instantiate）。
// 另生成一个入口包装 name（调用最具体的具体子句 __name__c<entry>），保证 name 作为
// 符号可解析（被当作一等函数值 / 反射引用时走到此包装）。
pub fn fc_merge_type() void {
    var base_name: string = base.node_sa((g_fc_d[0] as u64));
    var m: i64 = g_fc_n;
    // 1. 各子句声明类别 + 是否类别 + 首参类型是否齐全
    var cats: []string;
    var is_cat: []bool;
    var k: i64 = 0;
    while (k < m) {
        var cd: i64 = g_fc_d[k];
        var p0: i64 = fc_list_nth(base.node_lb((cd as u64)), 0);
        if (p0 < 0) {
            fc_err("T-OVL-E981", base.sb_cat3("type-group '", base_name, "': 首参数缺失"), cd);
            return;
        }
        var cname: string = fc_param_catname(p0);
        if (str_len(cname) == 0) {
            fc_err("T-OVL-E981",
                base.sb_cat3("type-group '", base_name,
                    "': 每个子句首参数须带显式类型标注（如 `v: i64`），以便静态分派"), cd);
            return;
        }
        append(cats, cname);
        append(is_cat, ovl_is_category(cname));
        k = k + 1;
    }
    // 1b. 单条「具体类型」子句 = 本就是普通函数，无需类别格分派：直接还原为普通
    // FuncDecl（原名 + ia==0），不登记 g_ovl_tg、不生成入口包装。这样调用走常规
    // 语义（含字面量 u8→i64 等隐式拓宽），否则静态分派会因实参静态类型（如 7→u8）
    // 与声明类型（i64）不精确匹配而误报 T-OVL-E903（见 p_overload_values.tc 的 kind）。
    // 单条「类别」子句不在此豁免（类别不是真实类型，必须走单态化分派）。
    if (m == 1 && is_cat[0] == false) {
        var cd0: i64 = g_fc_d[0];
        base.node_set_sa((cd0 as u64), base_name);
        base.node_set_ia((cd0 as u64), 0);
        return;
    }
    // 2. 入口 = 首个具体类型子句（静态分派需要具体入口；纯类别组需运行期类型标签，本期未实现）
    var entry: i64 = -1;
    var k2: i64 = 0;
    while (k2 < m) {
        if (is_cat[k2] == false) { entry = k2; }
        k2 = k2 + 1;
    }
    if (entry < 0) {
        fc_err("T-OVL-E982",
            base.sb_cat3("type-group '", base_name,
                "' 至少需要一个具体类型子句（纯类别子句需运行期类型标签，见 overload.md §2.8，本期未实现）"),
            g_fc_d[0]);
        return;
    }
    // 3. 元数一致性
    var arity: i64 = list_count(base.node_lb((g_fc_d[0] as u64)));
    var ka: i64 = 1;
    while (ka < m) {
        if (list_count(base.node_lb((g_fc_d[ka] as u64))) != arity) {
            fc_err("T-FUN-E811",
                base.sb_cat3("type-group '", base_name, "': all clauses must have the same arity"), g_fc_d[ka]);
            return;
        }
        ka = ka + 1;
    }
    // 4. 返回类型一致性
    var kr: i64 = 1;
    while (kr < m) {
        if (fc_type_key(base.node_na((g_fc_d[kr] as u64))) != fc_type_key(base.node_na((g_fc_d[0] as u64)))) {
            fc_err("T-FUN-E813",
                base.sb_cat3("type-group '", base_name, "': all clauses must declare the same return type"), g_fc_d[kr]);
            return;
        }
        kr = kr + 1;
    }
    // 5. 登记组 + 重命名子句 + 类别模板降级
    var gi: i64 = slice_len(g_ovl_tg_names) as i64;
    append(g_ovl_tg_names, base_name);
    append(g_ovl_tg_n, m);
    var k3: i64 = 0;
    while (k3 < m) {
        var cd2: i64 = g_fc_d[k3];
        var newname: string = base.sb_cat3("__", base_name, base.sb_cat2("__c", base.i2s(k3)));
        base.node_set_sa((cd2 as u64), newname);
        base.node_set_ia((cd2 as u64), 0);
        append(g_ovl_tg_func, newname);
        append(g_ovl_tg_cat, cats[k3]);
        if (is_cat[k3]) {
            // 类别子句：保留首参/体供调用点按需单态化；降级为 ClauseDead 使其对
            // register / 双后端发射的所有 `kind == "FuncDecl"` 分派不可见（不新增死代码路径）。
            base.node_set_kind((cd2 as u64), "ClauseDead");
            append(g_ovl_tg_tmpl, cd2);
        } else {
            append(g_ovl_tg_tmpl, -1);
        }
        k3 = k3 + 1;
    }
    // 6. 入口包装 name：调用最具体的具体子句 __name__c<entry>。
    var ed: i64 = g_fc_d[entry];
    var entry_name: string = base.sb_cat3("__", base_name, base.sb_cat2("__c", base.i2s(entry)));
    var wh: i64 = -1;
    var wt: i64 = -1;
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
    // ⦁ 循环体只往**新建链**（wh/wt，初值 -1）追加，不回写 ed 的 lb 链
    var ks1: []i64 = base.kids_chain(base.node_lb((ed as u64)));
    var ki1: i64 = 0;
    while (ki1 < slice_len(ks1) as i64) {
        var pp: i64 = ks1[ki1];
        var np: i64 = base.mk_P(base.node_sa((pp as u64)), base.node_na((pp as u64)), -1, -1);
        wt = base.list_push(wh, wt, np);
        if (wh < 0) { wh = wt; }
        ki1 = ki1 + 1;
    }
    var ah: i64 = -1;
    var at: i64 = -1;
    // S4 §4.6 Phase 3：实参链先物化再遍历（该链由上一循环刚建成，物化点在其后 ⇒ 完整）
    var ks2: []i64 = base.kids_chain(wh);
    var ki2: i64 = 0;
    while (ki2 < slice_len(ks2) as i64) {
        var pp2: i64 = ks2[ki2];
        var argid: i64 = base.mk_ident(base.node_sa((pp2 as u64)), -1);
        at = base.list_push(ah, at, argid);
        if (ah < 0) { ah = at; }
        ki2 = ki2 + 1;
    }
    var callnode: i64 = base.mk_call(base.mk_ident(entry_name, -1), ah, -1);
    var retnode: i64 = base.mk_return(callnode, -1);
    var body: i64 = base.list_push(-1, -1, retnode);
    var wrapper: i64 = base.mk_FuncDecl(base_name, false, false, base.node_na((ed as u64)), -1, wh, body, -1);
    base.node_set_span_id(wrapper, base.node_span_id(ed)); base.node_set_span_id(wrapper, base.node_span_id(ed)); base.node_set_span_id(wrapper, base.node_span_id(ed));
    append(lex.decl_list, wrapper);
}

pub fn desugar_func_clauses() void {
    // overload（Route 1）：`extend overload` 必须引用本文件内已存在的
    // `overload fn` 组（ia==1），否则报 T-OVL-E980。跨文件合并见 Route 2。
    var n: i64 = slice_len(lex.decl_list) as i64;
    var k: i64 = 0;
    while (k < n) {
        var ek: i64 = lex.decl_list[k];
        if (base.node_kind((ek as u64)) == "FuncDecl" && base.node_ia((ek as u64)) == 2) {
            // REQ-EXT-1：登记 extend 意图（组名 + 扩展者单元名）。必须在此处、即子句合并
            // 【之前】登记：随后 fc_merge 会把首个子句节点整体替换（slice_set），ia==2 标记
            // 随即丢失，事后扫 decl_list 找不到（实测踩坑）。
            // 「被扩展者归属」刻意不在此解析：模块加载发生在 desugar_imports（order 4），
            // 晚于本 pass（order 1），此刻对方模块的组尚未进 decl_list（故跨模块 extend 仍报
            // T-OVL-E980）。归属留到 emit_deps（模块已加载完、且其组 decl 的 ia 仍为 1）再解析。
            append(lex.g_extend_name, base.node_sa((ek as u64)));
            append(lex.g_extend_file, base.base_no_tc(base.node_file((ek as u64))));
            var found: bool = false;
            var m: i64 = 0;
            while (m < n) {
                var mk: i64 = lex.decl_list[m];
                if (base.node_kind((mk as u64)) == "FuncDecl" && base.node_ia((mk as u64)) == 1 && base.node_sa((mk as u64)) == base.node_sa((ek as u64))) { found = true; }
                m = m + 1;
            }
            if (found == false) {
                fc_err("T-OVL-E980",
                    base.sb_cat4("extend overload '", base.node_sa((ek as u64)),
                        "' has no matching 'overload fn ", base.sb_cat2(base.node_sa((ek as u64)), "' group in this file")),
                    ek);
            }
        }
        k = k + 1;
    }
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = lex.decl_list[i];
        // 分组守卫：仅「裸子句式」函数（ba==false）参与子句组合并；普通函数
        // （ba==true，如 `fn main() i64 { ... }`）与脱糖产物一律跳过。类型组判定
        // （fc_merge_type）额外要求 ia∈{1,2}（overload / extend overload），否则普通
        // `fn` 裸子句组（即使全裸带类型）会误入 R3 类别格分派（见 T-OVL-E981）。
        if (base.node_kind((d as u64)) == "FuncDecl" && base.node_ba((d as u64)) == false) {
            g_fc_n = 0;
            g_fc_d[0] = d;
            g_fc_i[0] = i;
            g_fc_n = 1;
            var j: i64 = i + 1;
            while (j < n) {
                var d2: i64 = lex.decl_list[j];
                if (base.node_kind((d2 as u64)) == "FuncDecl" && base.node_ba((d2 as u64)) == false && base.node_sa((d2 as u64)) == base.node_sa((d as u64))) {
                    if (g_fc_n < 64) {
                        g_fc_d[g_fc_n] = d2;
                        g_fc_i[g_fc_n] = j;
                        g_fc_n = g_fc_n + 1;
                    }
                }
                j = j + 1;
            }
            // 类型组（全部子句纯裸绑定、首参带显式类型）→ R3 类别格静态分派。
            // 值/结构组（含模式或守卫子句）→ 既有 match 脱糖（fc_merge）。
            // ⚠ 类型组判定要求 ia∈{1,2}：普通 `fn` 裸子句组（ia==0）即使全裸带类型，
            // 仍按值/模式组走 fc_merge，不进入 R3 类别格（避免误把 plain fn 当类型分派）。
            var is_type: bool = fc_group_is_type() && (base.node_ia((d as u64)) == 1 || base.node_ia((d as u64)) == 2);
            if (is_type) {
                fc_merge_type();
            } else {
                // 组内多于一条 → 必为子句组；单条但含模式参数 → 亦按子句组脱糖
                // （便于 match 的穷尽性检查统一兜底，无需第二套诊断）
                var need: bool = g_fc_n > 1;
                if (need == false) {
                    // S4 §4.6 Phase 3：形参链先物化再遍历
                    var ks: []i64 = base.kids_chain(base.node_lb((d as u64)));
                    var ki: i64 = 0;
                    while (ki < slice_len(ks) as i64) {
                        if (pp_is_pattern(ks[ki])) { need = true; }
                        ki = ki + 1;
                    }
                }
                if (need) {
                    fc_merge();
                }
            }
        }
        i = i + 1;
    }
}


// ── f-string 字面量（M-fstr）────────────────────────────────────
//
// 语法：`f"文本{expr!conv:spec}文本"`，多行形态 `f"""..."""`。
//
// 实现策略：**解析期整体重写**为 `format("文本{0!conv:spec}文本", expr)`。
// 不新建 AST 节点种类、不碰 sema/codegen 的表达式分发 —— 复用 M55 已有的
// 模板脱糖（提升成 `__fmt_N` 函数、StringBuilder 顺序拼接）。收益有三：
//   ① 插值实参在调用点求值**一次**（`f"{next()}{'x'}"` 不会重复求值）
//   ② 格式规范 `:spec` / 转换字段 `!conv` 与 `format()` 完全同源，只有一套文法
//   ③ 运行期零模板引擎，与「静态优先」的语言宪法一致
//
// 词法层已把整段 `f"..."` 连同原始转义整体收进一个 FormatString token
// （见 lex.tc：插值内的字符串/嵌套花括号在扫描期被跳过），故这里拿到的是
// **未解码**的原始文本，字面段的转义要在本函数内自行解码。

// 转换字段合法字符：s / r / a / j / c / p
pub fn fstr_is_conv(c: i64) bool {
    return c == 115 || c == 114 || c == 97 || c == 106 || c == 99 || c == 112;
}

// 跳过一段引号字面量；i0 指向首个 `"`。isf=true 表示这是 f-string 的引号体，
// 需要在插值 `{}` 内继续跳过其中嵌套的（f-）字符串。返回闭合引号之后的位置。
// 递归深度 = f-string 嵌套层数，实际写法里最多一两层。
pub fn fstr_skip_quoted(raw: string, i0: u64, e: u64, isf: bool) u64 {
    var i: u64 = i0;
    var isLong: bool = false;
    if (i + 2 < e) {
        if ((raw[i + 1] as i64) == 34 && (raw[i + 2] as i64) == 34) { isLong = true; }
    }
    if (isLong) { i = i + 3; } else { i = i + 1; }
    var depth: i64 = 0;
    while (i < e) {
        var c: i64 = raw[i] as i64;
        if (c == 92) { i = i + 2; continue; }
        if (depth == 0 && c == 34) {
            if (isLong == false) { return i + 1; }
            if (i + 2 < e && (raw[i + 1] as i64) == 34 && (raw[i + 2] as i64) == 34) { return i + 3; }
            i = i + 1;
            continue;
        }
        if (isf) {
            if (c == 123) {
                if (depth == 0 && i + 1 < e && (raw[i + 1] as i64) == 123) { i = i + 2; continue; }
                depth = depth + 1;
                i = i + 1;
                continue;
            }
            if (c == 125) {
                if (depth == 0) {
                    if (i + 1 < e && (raw[i + 1] as i64) == 125) { i = i + 2; continue; }
                    i = i + 1;
                    continue;
                }
                depth = depth - 1;
                i = i + 1;
                continue;
            }
            if (depth > 0 && c == 34) {
                i = fstr_skip_quoted(raw, i, e, false);
                continue;
            }
            if (depth > 0 && c == 102 && i + 1 < e && (raw[i + 1] as i64) == 34) {
                i = fstr_skip_quoted(raw, i + 1, e, true);
                continue;
            }
        }
        i = i + 1;
    }
    return i;
}

// 插值体里的某个 `:` 是不是「格式规范起点」？
// 只有紧邻在**完整表达式收尾**（标识符/数字/`)`/`]`/`}`/`"`）之后才算；
// 否则它是原子字面量 `:name` 的前缀（`f"{c == :red}"`），不能当 spec 分隔符。
pub fn fstr_prev_ends_expr(s: string, k: u64) bool {
    var j: u64 = k;
    while (j > 0) {
        var c: i64 = s[j - 1] as i64;
        if (c == 32 || c == 9) { j = j - 1; continue; }
        if (c == 41 || c == 93 || c == 125 || c == 34 || c == 95) { return true; }
        if (c >= 48 && c <= 57) { return true; }
        if (c >= 65 && c <= 90) { return true; }
        if (c >= 97 && c <= 122) { return true; }
        if (c >= 128) { return true; }
        return false;
    }
    return false;
}

// 把插值里的表达式源码文本就地词法 + 语法分析成一个表达式节点。
// token 追加到全局 toks **尾部**，外层 token 下标不受影响（append-only），
// 解析完恢复 pos。合成 token 的行列统一改写成 f-string 字面量所在位置，
// 否则诊断会指向「第 1 行第 1 列」。
pub fn fstr_parse_expr(text: string, ti: i64) i64 {
    var save_pos: i64 = lex.pos;
    var base: i64 = slice_len(base.toks) as i64;
    lex.tokenize(text);
    var atk: Tok = base.toks[ti];
    var m: i64 = slice_len(base.toks) as i64;
    var z: i64 = base;
    while (z < m) {
        var tz: Tok = base.toks[z];
        tz.line = atk.line;
        tz.col = atk.col;
        slice_set(base.toks, z, tz);
        z = z + 1;
    }
    lex.pos = base;
    if (lex.cur_t() == "Eof") {
        parse_fatal("empty interpolation `{}` in f-string");
    }
    var ex: i64 = parse_expr();
    if (lex.cur_t() != "Eof") {
        parse_fatal(base.sb_cat2("trailing tokens in f-string interpolation: ", lex.cur_v()));
    }
    lex.pos = save_pos;
    return ex;
}

pub fn parse_fstring(ti: i64) i64 {
    var raw: string = lex.tk_v(ti);
    var rn: u64 = str_len(raw);
    var isLong: bool = false;
    if (rn >= 6) {
        if ((raw[1] as i64) == 34 && (raw[2] as i64) == 34 && (raw[3] as i64) == 34) { isLong = true; }
    }
    var s0: u64 = 2;          // 跳过 `f"`
    var e0: u64 = rn - 1;     // 不含闭合 `"`
    if (isLong) { s0 = 4; e0 = rn - 3; }

    var tb: StringBuilder = sb_new();   // 合成的 format 模板
    var a_head: i64 = -1;
    var a_tail: i64 = -1;
    var argi: i64 = 0;
    var i: u64 = s0;

    while (i < e0) {
        var c: i64 = raw[i] as i64;

        // 转义：走与词法**同一份** `esc_decode`（base.tc）。两处各写一份正是
        // 旧实现「f-string 能产出 `\uXXXX`、词法却读不回来」的 round-trip 断裂源。
        // 解出来若是花括号，要在模板层加倍（模板还会再解一次）。
        if (c == 92) {
            var eb: StringBuilder = sb_new();
            var ni: u64 = base.esc_decode(raw, i + 1, eb, lex.tk_line(ti) as i64, lex.tk_col(ti) as i64);
            var es: string = sb_to_str(eb);
            var eL: u64 = str_len(es);
            var ek: u64 = 0;
            while (ek < eL) {
                var ech: i64 = es[ek] as i64;
                sb_append_char(tb, ech);
                if (ech == 123 || ech == 125) { sb_append_char(tb, ech); }
                ek = ek + 1;
            }
            i = ni;
            continue;
        }

        if (c == 125) {                       // `}}` 照抄给模板层解，孤立 `}` 是笔误
            if (i + 1 < e0 && (raw[i + 1] as i64) == 125) {
                sb_append_char(tb, 125);
                sb_append_char(tb, 125);
                i = i + 2;
                continue;
            }
            parse_fatal("unmatched `}` in f-string; write `}}` for a literal right brace");
        }

        if (c != 123) {
            sb_append_char(tb, c);
            i = i + 1;
            continue;
        }

        if (i + 1 < e0 && (raw[i + 1] as i64) == 123) {   // `{{`
            sb_append_char(tb, 123);
            sb_append_char(tb, 123);
            i = i + 2;
            continue;
        }

        // ── 插值单元 ───────────────────────────────────────
        // ① 先找配对的 `}`（跳过嵌套 (){}[] 与其中的字符串）
        i = i + 1;
        var ds: u64 = i;
        var depth: i64 = 0;
        var close: u64 = e0;
        var found: bool = false;
        while (i < e0) {
            var ic: i64 = raw[i] as i64;
            if (ic == 34) { i = fstr_skip_quoted(raw, i, e0, false); continue; }
            if (ic == 102 && i + 1 < e0 && (raw[i + 1] as i64) == 34) {
                i = fstr_skip_quoted(raw, i + 1, e0, true);
                continue;
            }
            if (ic == 40 || ic == 91 || ic == 123) { depth = depth + 1; i = i + 1; continue; }
            if (ic == 41 || ic == 93) { depth = depth - 1; i = i + 1; continue; }
            if (ic == 125) {
                if (depth == 0) { close = i; found = true; break; }
                depth = depth - 1;
                i = i + 1;
                continue;
            }
            i = i + 1;
        }
        if (found == false) {
            parse_fatal("unclosed `{` in f-string interpolation");
        }
        var body: string = str_slice(raw, ds, close);
        i = close + 1;

        // ② 在插值体内定位 spec 分隔冒号（跳过三目 `?:`、原子 `:name`、嵌套层）
        var bl: u64 = str_len(body);
        var d2: i64 = 0;
        var q2: i64 = 0;
        var specPos: i64 = -1;
        var k: u64 = 0;
        while (k < bl) {
            var bc: i64 = body[k] as i64;
            if (bc == 34) { k = fstr_skip_quoted(body, k, bl, false); continue; }
            if (bc == 102 && k + 1 < bl && (body[k + 1] as i64) == 34) {
                k = fstr_skip_quoted(body, k + 1, bl, true);
                continue;
            }
            if (bc == 40 || bc == 91 || bc == 123) { d2 = d2 + 1; k = k + 1; continue; }
            if (bc == 41 || bc == 93 || bc == 125) { d2 = d2 - 1; k = k + 1; continue; }
            if (d2 == 0 && bc == 63) { q2 = q2 + 1; k = k + 1; continue; }
            if (d2 == 0 && bc == 58) {
                if (k + 1 < bl && (body[k + 1] as i64) == 58) { k = k + 2; continue; }
                if (q2 > 0) { q2 = q2 - 1; k = k + 1; continue; }
                if (fstr_prev_ends_expr(body, k)) { specPos = k as i64; break; }
                k = k + 1;
                continue;
            }
            k = k + 1;
        }
        var exprEnd: u64 = bl;
        var spec: string = "";
        if (specPos >= 0) {
            exprEnd = specPos as u64;
            spec = str_slice(body, (specPos as u64) + 1, bl);
        }

        // ③ 转换字段：只可能紧贴在表达式末尾（`{x!r}` / `{x!r:>8}`），
        //    故不会与 `!=`、前缀 `!` 混淆。
        var convc: i64 = 0;
        if (exprEnd >= 2) {
            var cm1: i64 = body[exprEnd - 2] as i64;
            var cm2: i64 = body[exprEnd - 1] as i64;
            // `!` 前必须是一个「已完结的表达式」，否则那是前缀取反（如 `{!ok}`）
            if (cm1 == 33 && fstr_prev_ends_expr(body, exprEnd - 2)) {
                if (fstr_is_conv(cm2) == false) {
                    parse_fatal("f-string 转换字段只能是 `!s`/`!r`/`!a`/`!j`/`!c`/`!p`");
                }
                convc = cm2;
                exprEnd = exprEnd - 2;
            }
        }

        var enode: i64 = fstr_parse_expr(str_slice(body, 0, exprEnd), ti);
        a_tail = base.list_push(a_head, a_tail, enode);
        if (a_head < 0) { a_head = a_tail; }

        // ④ 模板占位：`{N[!conv][:spec]}`（一律手动索引，杜绝自动编号混用）
        sb_append_char(tb, 123);
        sb_append_str(tb, base.i2s(argi));
        if (convc != 0) {
            sb_append_char(tb, 33);
            sb_append_char(tb, convc);
        }
        if (str_len(spec) > 0) {
            sb_append_char(tb, 58);
            sb_append_str(tb, spec);
        }
        sb_append_char(tb, 125);
        argi = argi + 1;
    }

    var tmpl: string = sb_to_str(tb);

    // 无插值：退化为普通字符串字面量（把 `{{`/`}}` 就地还原），不生成 __fmt_N
    if (argi == 0) {
        var lb: StringBuilder = sb_new();
        var tn2: u64 = str_len(tmpl);
        var z2: u64 = 0;
        while (z2 < tn2) {
            var zc: i64 = tmpl[z2] as i64;
            if (zc == 123 || zc == 125) {
                if (z2 + 1 < tn2 && (tmpl[z2 + 1] as i64) == zc) {
                    sb_append_char(lb, zc);
                    z2 = z2 + 2;
                    continue;
                }
            }
            sb_append_char(lb, zc);
            z2 = z2 + 1;
        }
        return base.mk_string(sb_to_str(lb), ti);
    }

    var f_head: i64 = -1;
    var f_tail: i64 = -1;
    f_tail = base.list_push(f_head, f_tail, base.mk_string(tmpl, ti));
    if (f_head < 0) { f_head = f_tail; }
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
    // ⦁ 循环体只往**新建链**（f_head/f_tail）追加，不回写 a_head 链
    var ks: []i64 = base.kids_chain(a_head);
    var ki: i64 = 0;
    while (ki < slice_len(ks) as i64) {
        f_tail = base.list_push(f_head, f_tail, ks[ki]);
        if (f_head < 0) { f_head = f_tail; }
        ki = ki + 1;
    }
    g_has_format = true;
    return base.mk_call(base.mk_ident("format", ti), f_head, ti);
}

// ── ADT：variant 构造器模式（match 模式位）─────────────────────
// `Circle(r)` / `Shape.Circle(r)` / `Node(l, Leaf(x))`。
// ⚠ 手写代码，刻意置于 GEN:parser_rules 区**之外**（见 docs/fstring.md 同类教训）。
// 判据：模式位上「首字母大写 Identifier + `(`」（或限定式 `V.Case(`）。
// 大写是必要条件——否则 `f(x) => ...`（以调用结果做等值匹配）会被误夺。
// 无括号的裸大写名（单元 case `Empty => ...`）仍走既有 arm.sa 通道，
// 由 sema 的 C2 消歧统一改写（enum → member，variant → conpat）。

// 首字母是否大写。parse 在 DAG 上位于 sema 之前，不能引用 sema.starts_upper，故本地实现。
pub fn tok_starts_upper(s: string) bool {
    if (str_len(s) == 0) { return false; }
    var c0: u8 = s[0];
    return c0 >= 65 && c0 <= 90;
}

pub fn pat_is_conpat() bool {
    if (lex.cur_t() != "Identifier") { return false; }
    if (tok_starts_upper(lex.cur_v()) == false) { return false; }
    if (lex.peek_t(1) == "LParen") { return true; }
    if (lex.peek_t(1) == "Dot" && lex.peek_t(2) == "Identifier" && lex.peek_t(3) == "LParen") { return true; }
    return false;
}

// 子模式：嵌套构造器 / `_` 通配 / 裸绑定名 / 字面量
pub fn parse_conpat_sub() i64 {
    if (pat_is_conpat()) { return parse_conpat(); }
    if (lex.cur_t() == "Identifier") {
        var sp_ti: i64 = lex.pos;
        var sp_v: string = lex.cur_v();
        lex.advance_i();
        return base.mk_ident(sp_v, sp_ti);
    }
    return parse_expr();
}

pub fn parse_conpat() i64 {
    var cp_ti: i64 = lex.pos;
    var cp_qual: string = "";
    var cp_name: string = expect_tok("Identifier");
    if (lex.cur_t() == "Dot") {
        lex.advance_i();
        cp_qual = cp_name;
        cp_name = expect_tok("Identifier");
    }
    // A-fix 阶段 0c 后续：裸变体构造器模式（无前导点、无限定）已废弃。
    // 必须写成前导点 `.Case(args)`（如 `.Circle(r)` / `.Struct(m)`）；
    // 限定形式 `Shape.Circle(r)`（cp_qual 非空）仍合法。前导点 `.Case` 由
    // leading_dot_to_conpat 接管，从不进入本分支，故此处只拦裸写。
    if (cp_qual == "" && tok_starts_upper(cp_name)) {
        parse_fatal_at("T-MAT-E751",
            "bare variant pattern `" + cp_name + "` is deprecated; use leading-dot form `." + cp_name + "`",
            cp_ti);
    }
    expect_tok("LParen");
    var cp_head: i64 = -1;
    var cp_tail: i64 = -1;
    var cp_n: i64 = 0;
    while (lex.cur_t() != "RParen" && lex.cur_t() != "Eof") {
        var cp_p: i64 = parse_conpat_sub();
        cp_tail = base.list_push(cp_head, cp_tail, cp_p);
        if (cp_head < 0) { cp_head = cp_tail; }
        cp_n = cp_n + 1;
        if (lex.cur_t() == "Comma") { lex.advance_i(); }
    }
    expect_tok("RParen");
    return base.mk_conpat(cp_name, cp_qual, cp_head, cp_n, cp_ti);
}

// 切片/数组模式（S6）：`[a, b, .., last]` / `[x]` / `[]` / `[..]`。
// children 顺序存放元素模式：`_`(ident sa="_") / 绑定 ident / 字面量 / `rest`(`..`)。
// 至多一个 `..`；`..` 出现时只校验首尾边界（长度任意），否则长度必须 == 元素数。
pub fn parse_slice_pat() i64 {
    var sp_ti: i64 = lex.advance_i();   // 吃掉 [
    var sp_head: i64 = -1;
    var sp_tail: i64 = -1;
    var sp_rest: i64 = -1;
    var sp_count: i64 = 0;
    var sp_first: bool = true;
    while (lex.cur_t() != "RBracket" && lex.cur_t() != "Eof") {
        if (sp_first == false) {
            if (lex.cur_t() == "Comma") { lex.advance_i(); }
            else { parse_fatal_at("T-MAT-E750", "slice pattern: expected ',' or ']' between elements", lex.pos); }
        }
        sp_first = false;
        if (lex.cur_t() == "DotDot") {
            lex.advance_i();
            if (sp_rest >= 0) {
                parse_fatal_at("T-MAT-E750", "slice pattern: at most one '..' is allowed", lex.pos);
            }
            var rp: i64 = base.mk_rest(sp_ti);
            sp_tail = base.list_push(sp_head, sp_tail, rp);
            if (sp_head < 0) { sp_head = sp_tail; }
            sp_rest = sp_count;
            sp_count = sp_count + 1;
        } else if (lex.cur_t() == "_") {
            lex.advance_i();
            var wp: i64 = base.mk_ident("_", sp_ti);
            sp_tail = base.list_push(sp_head, sp_tail, wp);
            if (sp_head < 0) { sp_head = sp_tail; }
            sp_count = sp_count + 1;
        } else {
            var ep: i64 = parse_match_subpat();
            if (ep < 0) {
                parse_fatal_at("T-MAT-E750", "slice pattern: '_' wildcard must not carry a binding", lex.pos);
            }
            sp_tail = base.list_push(sp_head, sp_tail, ep);
            if (sp_head < 0) { sp_head = sp_tail; }
            sp_count = sp_count + 1;
        }
    }
    expect_tok("RBracket");
    if (sp_count == 0) {
        // `[]` 空模式：无元素、无 rest，长度必须 == 0
        sp_rest = -1;
    }
    return base.mk_slice_pat(sp_head, sp_rest, sp_count, sp_ti);
}

// >>> GEN:parser_rules (generated by tools/totter.tc from out/ebnf.json grammar -- DO NOT EDIT) >>>
pub fn parse_for_stmt() i64 {
    var ti: i64 = lex.advance_i();
    expect_tok("LParen");
    var is_kv: bool = lex.cur_t() == "Identifier" && lex.peek_t(1) == "Comma" && lex.peek_t(2) == "Identifier" && lex.peek_t(3) == "KwIn";
    if ((lex.cur_t() == "Identifier" && lex.peek_t(1) == "KwIn") || is_kv) {
        var vi: i64 = lex.advance_i();
        var vname: string = lex.tk_v(vi);
        var vname2: string = "";
        if (is_kv) {
            lex.advance_i();
            var vi2: i64 = lex.advance_i();
            vname2 = lex.tk_v(vi2);
        }
        lex.advance_i();
        var iterable: i64 = parse_expr();
        expect_tok("RParen");
        var body: i64 = parse_block();
        var else_e: i64 = -1;
        if (lex.cur_t() == "KwElse") {
            lex.advance_i();
            // 与 if/while 的 else 同构：存**语句链表头**（kids 池下标），不是表达式节点。
            // 否则 lam_find / hir_list / 各 AST walker 把节点 id 当 kids 池下标 → t_slice_at 越界。
            else_e = parse_block();
        }
        var id: i64 = base.mk_for_each(vname, vname2, iterable, body, else_e, ti);
        return id;
    }
    var init: i64 = -1;
    if (lex.cur_t() != "Semicolon") {
        var exp: bool = false;
        if (lex.cur_t() == "KwVar") {
            init = parse_local_var(false, exp);
        } else {
        if (lex.cur_t() == "KwConst") {
            var cd: i64 = parse_local_var(true, exp);
            init = cd;
            base.node_set_const(cd);
        } else {
        if (lex.cur_t() == "KwLet") {
            init = parse_local_let(exp);
        } else {
            var e: i64 = parse_expr();
            expect_tok("Semicolon");
            init = base.mk_expr(e, -1);
        }}}
    } else {
        lex.advance_i();
    }
    var cond: i64 = -1;
    if (lex.cur_t() != "Semicolon") {
        cond = parse_expr();
    }
    expect_tok("Semicolon");
    var upd: i64 = -1;
    if (lex.cur_t() != "RParen") {
        upd = parse_expr();
    }
    expect_tok("RParen");
    var body2: i64 = parse_block();
    var else_e: i64 = -1;
    if (lex.cur_t() == "KwElse") {
        lex.advance_i();
        // 与 if/while 的 else 同构：存**语句链表头**（kids 池下标），不是表达式节点。
        // 否则 lam_find / hir_list / 各 AST walker 把节点 id 当 kids 池下标 → t_slice_at 越界。
        else_e = parse_block();
    }
    var id2: i64 = base.mk_for(init, cond, upd, body2, else_e, ti);
    return id2;
}

// 阶段1 S4（Q1）：inline for —— 编译期展开循环。
// 语法：`inline for (iterable) |elem| { body }` / `inline for (iterable) |elem, idx| { body }`
// `|` 在词法层是 BitOr，故按 BitOr 期待；iterable 须编译期已知集合（comptime 数组字面量等）。
pub fn parse_inline_for_stmt() i64 {
    var ti: i64 = lex.advance_i();   // 吞掉 `for`（调用方已吞 `inline`）
    expect_tok("LParen");
    var iterable: i64 = parse_expr();
    expect_tok("RParen");
    expect_tok("BitOr");             // '|'
    var elem: string = "";
    if (lex.cur_t() == "Identifier") { var ei: i64 = lex.advance_i(); elem = lex.tk_v(ei); }
    var idx: string = "";
    if (lex.cur_t() == "Comma") {
        lex.advance_i();
        if (lex.cur_t() == "Identifier") { var ii: i64 = lex.advance_i(); idx = lex.tk_v(ii); }
    }
    expect_tok("BitOr");             // '|'
    var body: i64 = parse_block();
    var id: i64 = base.mk_inline_for(elem, idx, iterable, body, ti);
    return id;
}

pub fn parse_if_stmt() i64 {
    var ti: i64 = lex.advance_i();
    expect_tok("LParen");
    var cond: i64 = parse_expr();
    expect_tok("RParen");
    var then_head: i64 = parse_block();
    var else_head: i64 = -2;
    if (lex.cur_t() == "KwElse") {
        lex.advance_i();
        if (lex.cur_t() == "KwIf") {
            var nested: i64 = parse_if_stmt();
            var h: i64 = -1;
            h = base.list_push(h, -1, nested);
            else_head = h;
        } else {
            else_head = parse_block();
        }
    }
    var id: i64 = base.mk_if(cond, then_head, else_head, ti);
    return id;
}

// P1（everything-is-value）：值位置的 `if` 脱糖为 `match (c) { true => THEN, false => ELSE }`。
// 动机：match 已是表达式且自带结果槽（__mres），而 if/Block 仍是 Statement；借道 match
// 可让值 if 落地而**后端零改动** —— 正是设计 §2.9 姿势 A「desugar 在前、分后端在后」。
// 前置：bool 穷尽性修复（true+false 两臂齐备即穷尽），否则会误报 T-MAT-E742。
// 限制：分支体须为**单一表达式**（Block 尚不是表达式，多语句分支待 P1 Stage 1 的 Block 取值）。
// 块语句链表的**末条**语句；当且仅当它是 `expr` 语句时返回其节点 id，否则 -1。

fn block_single_expr(head: i64) i64 {
    if (head < 0) {
        return -1;
    }
    var k: Child = base.kids[head];
    if (k.next >= 0) {
        return -1;
    }
    if (base.node_kind((k.val as u64)) != "expr") {
        return -1;
    }
    return base.node_na((k.val as u64));
}

pub fn parse_value_if() i64 {
    var ti: i64 = lex.advance_i();
    expect_tok("LParen");
    var cond: i64 = parse_expr();
    expect_tok("RParen");
    var then_e: i64 = parse_block_expr();
    var else_e: i64 = -1;
    if (lex.cur_t() == "KwElse") {
        lex.advance_i();
        if (lex.cur_t() == "KwIf") {
            // `else if` 链：else 分支本身又是一个值 if，递归脱糖成嵌套 match。
            // 之所以成立，正因为值块脱糖后分支位是**任意表达式**而非语句块。
            else_e = parse_value_if();
        } else {
            else_e = parse_block_expr();
        }
    }
    if (else_e < 0) {
        parse_fatal("值位置的 `if` 必须有 `else` 分支（无值路径供值属 P3/P5，当前不支持）");
    }
    var t_arm: i64 = base.mk_arm("", false, base.mk_bool(true, ti), -1, then_e, ti);
    var f_arm: i64 = base.mk_arm("", false, base.mk_bool(false, ti), -1, else_e, ti);
    // 注意：mk_match 的 la 是 kids（Child）链表下标，不是节点 id —— 必须走 list_push。
    var head: i64 = -1;
    var tail: i64 = -1;
    tail = base.list_push(head, tail, t_arm);
    if (head < 0) { head = tail; }
    tail = base.list_push(head, tail, f_arm);
    if (head < 0) { head = tail; }
    var m: i64 = base.mk_match(cond, head, ti);
    return m;
}

pub fn parse_return_stmt() i64 {
    var ti: i64 = lex.advance_i();
    var val: i64 = -1;
    if (lex.cur_t() != "Semicolon") {
        val = parse_expr();
    }
    expect_tok("Semicolon");
    var id: i64 = base.mk_return(val, ti);
    return id;
}

pub fn parse_while_stmt() i64 {
    var ti: i64 = lex.advance_i();
    expect_tok("LParen");
    var cond: i64 = parse_expr();
    expect_tok("RParen");
    var body: i64 = parse_block();
    var else_e: i64 = -1;
    if (lex.cur_t() == "KwElse") {
        lex.advance_i();
        // 与 if 的 else 同构：存**语句链表头**（kids 池下标），不是表达式节点。
        // 否则 lam_find / hir_list / 各 AST walker 把节点 id 当 kids 池下标 → t_slice_at 越界。
        else_e = parse_block();
    }
    var id: i64 = base.mk_while(cond, body, else_e, ti);
    return id;
}

pub fn parse_statement() i64 {
    var t: string = lex.cur_t();
    // S1b：上下文关键词（pub / kernel / overload / extend …）在词法层已是 Identifier，
    // 判定一律按**词文本**而非 token 类型（见 std.rc.cst 的 g_kw_tier / kw_lookup）。
    var tv: string = lex.cur_v();
    if (t == "Identifier" && lex.cur_v() == "expect" && lex.peek_t(1) == "LParen") {
        return parse_expect_stmt();
    }
    if (t == "KwIf") {
        return parse_if_stmt();
    }
    if (t == "KwFor") {
        return parse_for_stmt();
    }
    if (t == "KwWhile") {
        return parse_while_stmt();
    }
    if (t == "KwReturn") {
        return parse_return_stmt();
    }
    if (t == "KwBreak") {
        return parse_break_stmt();
    }
    if (t == "KwContinue") {
        return parse_continue_stmt();
    }
    if (t == "KwDefer") {
        return parse_defer_stmt();
    }
    if (t == "KwComptime") {
        return parse_comptime_stmt();
    }
    // 阶段1 S4（Q1）：inline for（编译期展开循环）。`inline for (it) |e| { }` / `|e, i|`。
    // `inline` 非保留字，仅在 `inline` + `for` 连写时进入此分支；单独 `inline` 标识符回落常规解析。
    if (t == "Identifier" && lex.cur_v() == "inline" && lex.peek_t(1) == "KwFor") {
        lex.advance_i();   // 吞掉 `inline`
        return parse_inline_for_stmt();
    }
    if (t == "LBrace") {
        return parse_block_stmt();
    }
    if (t == "KwVar") {
        return parse_var_stmt();
    }
    if (t == "KwConst") {
        return parse_const_stmt();
    }
    if (t == "KwLet") {
        return parse_let_stmt();
    }
    if (t == "KwAuto") {
        return parse_auto_stmt();
    }
    if (tv == "pub") {
        // 局部作用域：pub 只能修饰顶层声明，不能修饰局部 var/let/const（M-Module）。
        // 旧 `export` 关键字已删除，可见性统一用 `pub`；局部 pub 误用报 T-MOD-E556。
        lex.advance_i();   // 吃掉 pub
        var lt2: string = lex.cur_t();
        if (lt2 == "KwVar") {
            return parse_local_var(false, true);
        }
        if (lt2 == "KwConst") {
            var cd2: i64 = parse_local_var(true, true);
            base.node_set_const(cd2);
            return cd2;
        }
        if (lt2 == "KwLet") {
            return parse_local_let(true);
        }
        // pub 后不是 var/let/const：非法局部 pub，报错（吃掉该 token 避免级联）
        parse_fatal_at("T-MOD-E556", "pub 只能修饰顶层声明，不能修饰局部/嵌套声明", lex.pos);
        return -1;
    }
    return parse_expr_or_assign_stmt();
}

// ── match 表达式（L-15 语法规则法 / docs/syntax/drafts/match.md）──
// 模式（v1 子集）：
//   `_`            → 通配，不绑定变量
//   裸 Ident       → 绑定被匹配值到该名字（不可反驳），可带 `when` 守卫
//   其它表达式     → 与被匹配值做 `==` 等值匹配（整数 / 字符串 / bool / Enum 成员）
// arm 之间的分隔符 `,` 可选（词法层不产生 Newline token，故以 `}` 收尾判定）。
// match 模式原子（不含二元 `|`）：通配 / 构造器 / 区间 / 字面量 / 枚举或变体 case 名 / 值引用。
// 用于 S1 或模式：每个 `|` 切分出的备选都用一个原子解析，故 `|` 不会被当成按位或吞掉。
pub fn parse_match_alt_atom() i64 {
    if (lex.cur_t() == "_") {
        lex.advance_i();
        return -1;
    }
    // 位串模式 `<<seg:W, rest/bitstr>>`：模式起始位的 `<<`（左移不在模式文法里）。
    if (lex.cur_t() == "ShiftLeft") {
        return parse_bitstr_lit(true);
    }
    if (lex.cur_t() == "LBracket") {
        return parse_slice_pat();
    }
    if (pat_is_conpat()) {
        return parse_conpat();
    }
    if (lex.cur_t() == "DotDot" || lex.cur_t() == "DotDotEq" ||
        (lex.cur_t() == "Integer" && (lex.peek_t(1) == "DotDot" || lex.peek_t(1) == "DotDotEq"))) {
        return parse_range();
    }
    // 匿名元组位置式模式 `.{a, b}`（#4 §8.2）：模式位识别前导点 + `{`。
    if (lex.cur_t() == "Dot" && lex.peek_t(1) == "LBrace") {
        lex.advance_i();                       // 消费 Dot
        return parse_struct_lit("", -1);       // 自 `{` 起解析（位置式，sa 留空）
    }
    // 具名类型位置式 / 具名字段模式 `Name{ a, b }` / `Name{ x: a }`（#4 §8.2）。
    // 与 conpat（`Name(...)`）区分：`{` 而非 `(`。非 conpat 才走 struct_lit 模式。
    if (lex.cur_t() == "Identifier" && lex.peek_t(1) == "LBrace" && pat_is_conpat() == false) {
        var nm: string = lex.cur_v();
        lex.advance_i();                       // 消费 ident
        return parse_struct_lit(nm, -1);       // 自 `{` 起解析
    }
    // 模式原子停在 `|`/`||`（按位或 / 逻辑或）之下：否则 `1 | 2 | 3` 会被 parse_bitor
    // 整体吞成一个按位或表达式，或模式脱糖的 `|` 切分就失效了。parse_bitxor 在
    // parse_bitor 之下一层，天然在 `|` 处停手。
    return parse_bitxor();
}

// @ 子模式（S3 as-模式）：单模式原子，不允许再嵌套 or。
pub fn parse_match_subpat() i64 {
    var sav: bool = g_in_match_pat;
    g_in_match_pat = true;
    var r: i64 = parse_match_alt_atom();
    g_in_match_pat = sav;
    return r;
}

// match 臂解析（支持 S1 或模式 `|` 与 S3 as-模式 `x @ pat`）。
// 或模式脱糖为多个并列臂（共用守卫与体），返回这一组臂的链表头。
pub fn parse_match_arm() i64 {
    var am_ti: i64 = lex.pos;
    var am_sa: []string;
    var am_pat: []i64;
    var f_sa: string = "";
    var f_pat: i64 = -1;
    if (lex.cur_t() == "Identifier" && lex.peek_t(1) == "At") {
        // S3 as-模式：x @ pat（整体值绑定到 x，并测试 pat）
        f_sa = lex.cur_v();
        lex.advance_i();
        lex.advance_i();
        f_pat = parse_match_subpat();
    } else if (lex.cur_t() == "_") {
        lex.advance_i();
        f_sa = "";
        f_pat = -1;
    } else if (lex.cur_t() == "Identifier" && (lex.peek_t(1) == "FatArrow" || lex.peek_t(1) == "KwWhen")) {
        f_sa = lex.cur_v();
        lex.advance_i();
        f_pat = -1;
    } else {
        f_pat = parse_match_subpat();
        f_sa = "";
    }
    append(am_sa, f_sa);
    append(am_pat, f_pat);
    // S1 或模式：仅当首备选非绑定（f_pat >= 0）时才进入 or 组；
    // 绑定模式（通配 / 裸绑定 / @）本身不可参与或（避免引入歧义绑定）。
    // 分隔符是 `|`（BitOr）；逻辑或 `||`（Or）不是模式分隔符。
    while (f_pat >= 0 && lex.cur_t() == "BitOr") {
        lex.advance_i();
        var a_sa: string = "";
        var a_pat: i64 = -1;
        if (lex.cur_t() == "_") {
            lex.advance_i();
            a_sa = "";
            a_pat = -1;
        } else {
            a_pat = parse_match_subpat();
            a_sa = "";
        }
        append(am_sa, a_sa);
        append(am_pat, a_pat);
    }
    var am_guard: i64 = -1;
    if (lex.cur_t() == "KwWhen") {
        lex.advance_i();
        am_guard = parse_expr();
    }
    expect_tok("FatArrow");
    var am_body_sav: bool = g_in_match_body;
    g_in_match_body = true;
    var am_body: i64 = parse_expr();
    g_in_match_body = am_body_sav;
    if (lex.cur_t() == "Comma") {
        lex.advance_i();
    }
    // 脱糖：每个备选生成一个独立 arm，链接成组，返回组头
    var am_gh: i64 = -1;
    var am_gt: i64 = -1;
    var am_i: i64 = 0;
    while (am_i < (slice_len(am_sa) as i64)) {
        var a_sa2: string = am_sa[am_i];
        var a_pat2: i64 = am_pat[am_i];
        var a_isw: bool = (a_pat2 < 0 && a_sa2 == "");
        var arm: i64 = base.mk_arm(a_sa2, a_isw, a_pat2, am_guard, am_body, am_ti);
        am_gt = base.list_push(am_gh, am_gt, arm);
        if (am_gh < 0) { am_gh = am_gt; }
        am_i = am_i + 1;
    }
    return am_gh;
}

pub fn parse_match_expr() i64 {
    var mx_ti: i64 = lex.advance_i();
    expect_tok("LParen");
    var mx_scrut: i64 = parse_expr();
    expect_tok("RParen");
    expect_tok("LBrace");
    var mx_head: i64 = -1;
    var mx_tail: i64 = -1;
    while (lex.cur_t() != "RBrace" && lex.cur_t() != "Eof") {
        var mx_a: i64 = parse_match_arm();
        if (mx_a >= 0) {
            if (mx_head < 0) {
                mx_head = mx_a;
            } else {
                base.list_link(mx_tail, mx_a);
            }
            mx_tail = base.list_last(mx_a);
        }
    }
    expect_tok("RBrace");
    return base.mk_match(mx_scrut, mx_head, mx_ti);
}

pub fn parse_primary() i64 {
    var t: string = lex.cur_t();
    // M-meta Phase D：编译期内建 `@name(...)`。`@` 在**表达式起始位**此前空闲
    // （注解只在声明前 / 类型后，字段 tagID 是 `@ <int>`），故不与既有文法冲突。
    if (t == "At" && lex.peek_t(1) == "KwImport") {
        return parse_import_expr();
    }
    if (t == "At" && (lex.peek_t(1) == "Identifier" || lex.peek_t(1) == "KwStruct" || lex.peek_t(1) == "KwEnum" || lex.peek_t(1) == "KwFunc" || lex.peek_t(1) == "KwVariant" || lex.peek_t(1) == "KwAs")) {
        return parse_meta_builtin();
    }
    // comptime 表达式前缀：编译期求值（CTFE 在后续阶段落地）；
    // 仅建 AST 节点（comptime），由 emit 阶段降级处理。
    if (t == "KwComptime") {
        var ti_meta: i64 = lex.advance_i();
        var inner: i64 = parse_expr();
        return base.mk_comptime(inner, ti_meta);
    }
    // Erlang 式原子字面量：`:name` → atom 节点（表达式位置的 `:` 此前未使用）
    if (t == "Colon") {
        var ti_Colon: i64 = lex.advance_i();
        if (lex.cur_t() != "Identifier") {
            parse_fatal("expected atom name after ':'");
            exit(1);
        }
        var ti_Name: i64 = lex.advance_i();
        var id: i64 = base.node_new("atom");
        base.node_set_sa((id as u64), lex.tk_v(ti_Name));
        base.node_at(id, ti_Name);
        return id;
    }
    if (t == "KwFunc") {
        return parse_lambda_expr();
    }
    // `|v: T, w: U| expr` 闭包简写（Rust 式）：表达式起始位的裸 `|` 即 lambda 起点；
    // 中缀位的 `|` 仍是按位或 BitOr（由 or 级处理），不会走到这里。
    if (t == "BitOr") {
        return parse_bar_lambda();
    }
    // P1：值位置的 `if` —— 脱糖为 `match (c) { true => THEN, false => ELSE }`（见 parse_value_if）。
    // 语句位置的 `if` 走 parse_statement → parse_if_stmt，不受影响。
    if (t == "KwIf") {
        return parse_value_if();
    }
    // P3：值位置的循环（while/for/for_each）—— 带 `else` 完成子句或体含 `break <值>` 即值循环，
    // 由 sema 的 desugar_value_loop 脱糖为 block_expr（见 infer_expr 钩子）。复用既有
    // parse_while_stmt / parse_for_stmt（已含可选 else 解析）；语句位置走 parse_statement 不受影响。
    if (t == "KwWhile") {
        return parse_while_stmt();
    }
    if (t == "KwFor") {
        return parse_for_stmt();
    }
    // P1 Stage 1：值位置的块 `{ s1; ...; sn; e; }` —— 见 parse_block_expr。
    // 语句位置的块走 parse_statement → parse_block_stmt，不受影响。
    if (t == "LBrace") {
        return parse_block_expr();
    }
    if (t == "KwMatch") {
        return parse_match_expr();
    }
    // Erlang 式位串字面量 `<<seg:W, ...>>`：表达式起始位的 `<<` 此前未使用
    // （左移 `<<` 在更高优先级塔层、必有左操作数，不会走到 primary）。pat=true 用于 match 模式。
    if (t == "ShiftLeft") {
        return parse_bitstr_lit(false);
    }
    if (t == "Integer") {
        var ti_Integer: i64 = lex.advance_i();
        return parse_prim_int(ti_Integer);
    }
    if (t == "Float") {
        var ti_Float: i64 = lex.advance_i();
        return parse_prim_float(ti_Float);
    }
    if (t == "String") {
        var ti_String: i64 = lex.advance_i();
        return parse_prim_str(ti_String);
    }
    if (t == "FormatString") {
        var ti_Fstr: i64 = lex.advance_i();
        return parse_fstring(ti_Fstr);
    }
    if (t == "KwTrue") {
        var ti_KwTrue: i64 = lex.advance_i();
        return parse_prim_true(ti_KwTrue);
    }
    if (t == "KwFalse") {
        var ti_KwFalse: i64 = lex.advance_i();
        return parse_prim_false(ti_KwFalse);
    }
    if (t == "KwNull") {
        var ti_KwNull: i64 = lex.advance_i();
        return parse_prim_null(ti_KwNull);
    }
    // `?` 可选类型 none 字面量（表达式起始位此前空闲；`|>` 管道 `|>?` 已被 lexer
    // 归并为 PipeFilter 三字符记号，不会走到这里）：`var x: ?i64 = ?;` 的 RHS。
    // 类型 = Optional(Unknown)，由赋值/返回的目标类型反推元素类型。
    if (t == "Question") {
        var ti_Q: i64 = lex.advance_i();
        var id: i64 = base.node_new("opt_none");
        base.node_at(id, ti_Q);
        return id;
    }
    // 类型专用关键字（string/StringBuilder/void/map）本不是 Identifier，
    // 但允许它们作为 comptime 类型模板参数的实参出现在调用位置
    // （如 `id(string, "hi")`）。降为 ident 节点，由 instantiate_generic 解析为类型；
    // 若被误当作值使用，check 期会报「未知标识符」，语义正确。
    if (t == "KwString" || t == "KwStringBuilder" || t == "KwVoid" || t == "KwMap" || t == "KwUnit") {
        var ti_Kw: i64 = lex.advance_i();
        return base.mk_ident(lex.tk_v(ti_Kw), ti_Kw);
    }
    if (t == "Identifier") {
        // 内建文件描述符常量（M51）：stdin/stdout/stderr 在**表达式位置**直接降为
        // fidconst 节点（值 0/1/2），与 atom 同为编译期常量、零运行时查找。
        // 声明位置的同名标识符由 sym_define 的保留名检查拦截（T_FID_RESERVED_NAME）。
        var fcv: i64 = lex.fid_const_of(lex.cur_v());
        if (fcv >= 0) {
            var ti_Fid: i64 = lex.advance_i();
            var fid_id: i64 = base.node_new("fidconst");
            base.node_set_sa((fid_id as u64), lex.tk_v(ti_Fid));
            base.node_set_ia((fid_id as u64), fcv);
            base.node_at(fid_id, ti_Fid);
            return fid_id;
        }
        var ti_Identifier: i64 = lex.advance_i();
        return parse_prim_ident(ti_Identifier);
    }
    if (t == "LParen") {
        var ti_LParen: i64 = lex.advance_i();
        return parse_prim_paren(ti_LParen);
    }
    if (t == "LBracket") {
        var ti_LBracket: i64 = lex.advance_i();
        return parse_prim_array(ti_LBracket);
    }
    // 前导点语法（上下文推断，v2）：
    //   `.{ f: v, ... }` —— 省略类型名的具名结构体字面量；类型由上下文（变量注解 / 返回值 /
    //     函数参数 / 赋值左值类型）推断。语义上仍是「已知的具名结构体」，不自动合成新类型。
    //   `.a`            —— 上下文成员引用：结构体字段（方法体隐式 self）/ 枚举·联合体变体
    //     （期望类型为 enum/union 时）/ 模块导出项；不再按全局/局部变量解析。
    if (t == "Dot" && lex.peek_t(1) == "LBrace") {
        lex.advance_i();                          // 消费 Dot
        var id: i64 = parse_struct_lit("", -1);   // 内部消费 LBrace … RBrace
        // ⚠ 标记只能落在标量槽 ib。la/lb/lc 是 kids 链表头：lam_find / cap_scan /
        //   mb_walk 等通用遍历会对它们做 *_list 展开，把标量 1 当链表下标就会遍历到
        //   任意 kids 链（实测撞上函数语句链 → 成环 → 编译器栈溢出 / 退出码 127）。
        base.node_set_ib((id as u64), 1);   // S4 §0.14.7 SoA：取代 `sln.ib = 1`（标记 leading-dot struct literal，下方 slice_set 回写生效）
        return id;
    }
    if (t == "Dot" && lex.peek_t(1) == "Identifier") {
        lex.advance_i();                          // 消费 Dot
        var ti_Name: i64 = lex.advance_i();
        var mname: string = lex.tk_v(ti_Name);
        var id: i64 = base.mk_member(mname, -1, -1); // na=-1：无接收者
        base.node_set_lb((id as u64), 1);   // 标记 leading-dot member
        base.node_at(id, ti_Name);
        return id;
    }
    parse_fatal(base.sb_cat2("unexpected token in expression: ", lex.cur_v()));
    return -1;
}

// 模块值表达式（M-ModuleValue）：`@import("X")` 在**表达式位置**出现，产出一个
// 「模块命名空间值」节点 import_expr（sa = 模块路径，如 "src.base"）。它与顶层
// `@import("X")` 声明互不冲突（声明在 parse_declaration 已被拦截，表达式位不会走到这里）。
// 语义上它不是一个可运算的值，只能作为 `.field` 接收者，经 sema 解析成 `<模块key>__<field>`
// 真实符号（见 sema.infer_expr 的模块值成员访问分支）；故从不进入运行期、不影响 IR。
pub fn parse_import_expr() i64 {
    var ati: i64 = lex.pos;            // `@` 位置（仅记录，未用；node_at 用 import 关键字索引）
    lex.advance_i();                    // 吃掉 `@`
    var iti: i64 = lex.advance_i();    // 吃掉 `import`（KwImport），iti = 其 token 索引
    expect_tok("LParen");
    var mname: string = expect_tok("String");
    // M3.1：表达式位支持 `:: a, b` 选择性导入（与声明式 @import 同构，存于节点 lb；M3.3 起不再支持 `a as c` 重命名）。
    // 允许 `const m = @import("src.m" :: a, b)` —— 只把 a,b 登记为 m 的可见符号。
    // 注意：表达式不消费自身的 `;`（由外层 const/语句解析器负责，见 parse_global_var 的 expect Semicolon）。
    var items: i64 = -1;
    if (lex.cur_t() == "DoubleColon") {
        lex.advance_i();
        items = parse_import_items();
    }
    expect_tok("RParen");
    var id: i64 = base.node_new("import_expr");
    base.node_set_sa((id as u64), mname);
    base.node_set_lb((id as u64), items);   // M3.1：选择性导入项链表；无 `::` 时为 -1（modval_load 退化为通配）
    base.node_at(id, iti);             // 用 import 关键字的 token 索引作源位置（ti<0 会越界 t_slice_at）
    return id;
}

// 判断当前 `.X`（后接可选的 `(...)` 载荷）是否为 match 下一臂的模式（其后紧跟 `=>`）。
// 用于 parse_postfix 防贪婪：避免把下一臂的 `.Circle(r) =>` 当成当前臂 body 的字段访问吞掉。
pub fn dot_is_next_arm_pattern() bool {
    if (lex.cur_t() != "Dot") { return false; }
    if (lex.peek_t(1) != "Identifier") { return false; }
    var k: i64 = 2;
    if (lex.peek_t(k) == "FatArrow") { return true; }
    if (lex.peek_t(k) == "LParen") {
        var depth: i64 = 1;
        k = k + 1;
        while (depth > 0 && k < 80) {
            var tk: string = lex.peek_t(k);
            if (tk == "LParen") { depth = depth + 1; }
            else if (tk == "RParen") { depth = depth - 1; }
            else if (tk == "Eof") { break; }
            k = k + 1;
        }
        if (lex.peek_t(k) == "FatArrow") { return true; }
    }
    return false;
}

// 判断当前 `[...]` 是否为 match 下一臂的切片/数组模式（其后紧跟 `=>` 或 `when` 守卫）。
// 与 dot_is_next_arm_pattern 同构：避免把下一臂的 `[first, .., last] =>` 当成当前臂
// body 的下标访问（postfix `[...]`）吞掉（S6 复现：body 后紧跟切片模式臂时整个 match 失解析）。
pub fn lbracket_is_next_arm_pattern() bool {
    if (lex.cur_t() != "LBracket") { return false; }
    var depth: i64 = 0;
    var k: i64 = 0;
    var limit: i64 = 256;
    while (k < limit) {
        var tk: string = lex.peek_t(k);
        if (tk == "LBracket") { depth = depth + 1; }
        else if (tk == "RBracket") {
            depth = depth - 1;
            if (depth == 0) {
                var nt: string = lex.peek_t(k + 1);
                if (nt == "FatArrow") { return true; }
                if (nt == "KwWhen") { return true; }
                return false;
            }
        } else if (tk == "Eof") {
            return false;
        }
        k = k + 1;
    }
    return false;
}

pub fn parse_postfix() i64 {
    var e: i64 = parse_primary();
    while (lex.cur_t() == "Dot" || lex.cur_t() == "LBracket" || lex.cur_t() == "LParen") {
        var t: string = lex.cur_t();
        // 防贪婪：match 臂 body 结束后，下一个臂以 `.X`（可带 `(...)` 载荷）开头（`.X =>` 是模式，
        // 非 postfix 字段）。此时不要把 `.X` 当成本臂 body 的字段访问吞掉，直接结束 postfix 解析。
        // 同理 `[...]`（切片/数组模式臂）也须在此收手，否则会被贪成当前 body 的下标访问（S6）。
        if (g_in_match_body && ((t == "Dot" && dot_is_next_arm_pattern()) ||
                                 (t == "LBracket" && lbracket_is_next_arm_pattern()))) {
            break;
        }
        var ti: i64 = lex.advance_i();
        if (t == "Dot") { e = parse_post_member(e, ti); }
        if (t == "LBracket") { e = parse_post_index(e, ti); }
        if (t == "LParen") { e = parse_post_call(e, ti); }
    }
    if (lex.cur_t() == "KwAs") {
        var ti2: i64 = lex.advance_i();
        e = parse_post_cast(e, ti2);
    }
    return e;
}

pub fn parse_unary() i64 {
    var t: string = lex.cur_t();
    if (t == "Not" || t == "Minus" || t == "BitNot") {
        var op: string = "!";
        if (t == "Minus") { op = "-"; }
        if (t == "BitNot") { op = "~"; }
        // 只在 `-` **直接**贴着整数 token 时开窗，`-f(...)` / `-(...)` 都不算，
        // 保证 iN::MIN 的放宽不会漏进任意深的表达式里（reference.md §2.4）。
        if (t == "Minus" && lex.peek_t(1) == "Integer") { g_lit_neg = true; }
        var ti: i64 = lex.advance_i();
        var operand: i64 = parse_unary();
        g_lit_neg = false;
        return mk_un(op, operand, ti);
    }
    if (t == "BitAnd") {
        // 前缀 `&x` = 取址（地址-of）。中缀 `a & b` = 按位与由 parse_bitand 处理，
        // 因 parse_unary 优先消解前缀，二者不冲突（C/Rust 同款消歧）。
        var ti: i64 = lex.advance_i();
        var operand: i64 = parse_unary();
        return base.mk_amp(operand, ti);
    }
    if (t == "Star") {
        // 前缀 `*r` = 解引用。中缀 `a * b` = 乘法由 parse_mul 处理（同上前缀优先）。
        var ti: i64 = lex.advance_i();
        var operand: i64 = parse_unary();
        return base.mk_deref(operand, ti);
    }
    return parse_postfix();
}

pub fn parse_mul() i64 {
    var left: i64 = parse_unary();
    while (lex.cur_t() == "Star" || lex.cur_t() == "Slash" || lex.cur_t() == "Percent") {
        var t: string = lex.cur_t();
        var op: string = "*";
        if (t == "Slash") { op = "/"; }
        if (t == "Percent") { op = "%"; }
        var ti: i64 = lex.advance_i();
        var right: i64 = parse_unary();
        left = mk_bin(op, left, right, ti);
    }
    return left;
}

pub fn parse_add() i64 {
    var left: i64 = parse_mul();
    while (lex.cur_t() == "Plus" || lex.cur_t() == "Minus") {
        var t: string = lex.cur_t();
        var op: string = "+";
        if (t == "Minus") { op = "-"; }
        var ti: i64 = lex.advance_i();
        var right: i64 = parse_mul();
        left = mk_bin(op, left, right, ti);
    }
    return left;
}

pub fn parse_shift() i64 {
    var left: i64 = parse_add();
    while (lex.cur_t() == "ShiftLeft" || lex.cur_t() == "ShiftRight") {
        var t: string = lex.cur_t();
        var op: string = "<<";
        if (t == "ShiftRight") { op = ">>"; }
        var ti: i64 = lex.advance_i();
        var right: i64 = parse_add();
        left = mk_bin(op, left, right, ti);
    }
    return left;
}

// 只能出现在**类型位置**、永远不能作表达式起始的 token。
// `string` / `StringBuilder` / `void` / `map` 都是关键字（不是 Identifier），
// parse_primary 见到它们必然报 "unexpected token in expression"，
// 因此在 `>` 之后遇到它们，只可能是反序列化 `fid > Type` 的类型操作数。
pub fn tok_type_only(t: string) bool {
    if (t == "KwString" || t == "KwStringBuilder") { return true; }
    return t == "KwVoid" || t == "KwMap" || t == "KwUnit";
}

pub fn parse_cmp() i64 {
    var left: i64 = parse_shift();
    while (lex.cur_t() == "Lt" || lex.cur_t() == "Gt" || lex.cur_t() == "LtEq" || lex.cur_t() == "GtEq") {
        var t: string = lex.cur_t();
        var op: string = "<";
        if (t == "Gt") { op = ">"; }
        if (t == "LtEq") { op = "<="; }
        if (t == "GtEq") { op = ">="; }
        var ti: i64 = lex.advance_i();
        // 反序列化 `fid > Type`：右操作数是类型而非值（M52 读路径）。这里只做**词法层**
        // 消解 —— 左操作数是不是 fid 由 check 阶段裁定（parse 期没有类型信息）。
        // i64 / bool / atom / f64 / MyStruct 等本就是 Identifier，走普通表达式路径即可，
        // 由 deser_type_of 在 check 期把 ident 节点重解释为类型。
        var right: i64 = -1;
        if (op == ">" && tok_type_only(lex.cur_t())) {
            right = parse_type();
        } else {
            right = parse_shift();
        }
        left = mk_bin(op, left, right, ti);
    }
    return left;
}

pub fn parse_eq() i64 {
    var left: i64 = parse_cmp();
    while (lex.cur_t() == "Eq" || lex.cur_t() == "NotEq") {
        var t: string = lex.cur_t();
        var op: string = "==";
        if (t == "NotEq") { op = "!="; }
        var ti: i64 = lex.advance_i();
        var right: i64 = parse_cmp();
        left = mk_bin(op, left, right, ti);
    }
    return left;
}

pub fn parse_bitand() i64 {
    var left: i64 = parse_eq();
    while (lex.cur_t() == "BitAnd") {
        var t: string = lex.cur_t();
        var op: string = "&";
        var ti: i64 = lex.advance_i();
        var right: i64 = parse_eq();
        left = mk_bin(op, left, right, ti);
    }
    return left;
}

pub fn parse_bitxor() i64 {
    var left: i64 = parse_bitand();
    while (lex.cur_t() == "BitXor") {
        var t: string = lex.cur_t();
        var op: string = "^";
        var ti: i64 = lex.advance_i();
        var right: i64 = parse_bitand();
        left = mk_bin(op, left, right, ti);
    }
    return left;
}

pub fn parse_bitor() i64 {
    var left: i64 = parse_bitxor();
    while (lex.cur_t() == "BitOr") {
        var t: string = lex.cur_t();
        var op: string = "|";
        var ti: i64 = lex.advance_i();
        var right: i64 = parse_bitxor();
        left = mk_bin(op, left, right, ti);
    }
    return left;
}

pub fn parse_and() i64 {
    var left: i64 = parse_bitor();
    while (lex.cur_t() == "And") {
        var t: string = lex.cur_t();
        var op: string = "&&";
        var ti: i64 = lex.advance_i();
        var right: i64 = parse_bitor();
        left = mk_bin(op, left, right, ti);
    }
    return left;
}

pub fn parse_or() i64 {
    var left: i64 = parse_and();
    while (lex.cur_t() == "Or") {
        var t: string = lex.cur_t();
        var op: string = "||";
        var ti: i64 = lex.advance_i();
        var right: i64 = parse_and();
        left = mk_bin(op, left, right, ti);
    }
    return left;
}

pub fn parse_sfield() i64 {
    var r_Ident: string = expect_tok("Identifier");
    expect_tok("Colon");
    var r_Integer: string = "";
    var r_type: i64 = -1;
    if (lex.cur_t() == "Integer") {
    r_Integer = expect_tok("Integer");
    }    else if (true) {
    r_type = parse_type();
    } else {
        parse_fatal("unexpected token in alternative");
    }
    var r_anns: i64 = parse_annotations();
    // ── 字段 tagID：`@ Integer`（与 @注解 以「@ 后是否数字」区分；注解循环已跳过 @<int>）──
    var r_tag: i64 = -1;
    if (lex.cur_t() == "At") {
        lex.advance_i();
        r_tag = parse_int_str(expect_tok("Integer"));
    }
    // ── 字段默认值：`= Expr` ──
    var r_def: i64 = -1;
    if (lex.cur_t() == "Assign") {
        lex.advance_i();
        r_def = parse_expr();
    }
    // 收尾注解（如 `@ 1 @derive(...)` 中 tagID 之后的注解；注解循环已因 @<int> 提前退出）
    var r_anns2: i64 = parse_annotations();
    if (r_anns2 >= 0) {
        r_anns = list_concat(r_anns, r_anns2);
    }
    expect_tok("Semicolon");
    var __id: i64 = base.node_new("F");
    base.node_set_sa((__id as u64), r_Ident);
    base.node_set_na((__id as u64), sfield_na(r_Integer, r_type));
    base.node_set_ia((__id as u64), sfield_ia(r_Integer));
    base.node_set_la((__id as u64), r_anns);
    base.node_set_ib((__id as u64), r_tag);   // S4 §0.14.7 SoA：取代 `__n.ib`（tagID：≥1 显式；-1 = 自动化分配，下方 slice_set 回写生效）
    base.node_set_nb((__id as u64), r_def);   // 默认表达式节点（-1 = 无默认值）
    return __id;
}

// 把函数体/签名中的 `Self`（类型节点 named 与结构体字面量名 struct_lit）改写为所属 struct 名 sn。
// 递归遍历子节点，仅改写 named{sa:"Self"} 与 struct_lit{sa:"Self"}，其余节点仅递归。
pub fn desugar_self_node(nid: i64, sn: string) void {
    if (nid < 0) { return; }
    var k: string = base.node_kind((nid as u64));
    if (k == "named" && base.node_sa((nid as u64)) == "Self") {
        base.node_set_sa((nid as u64), sn);
        return;
    }
    if (k == "struct_lit" && base.node_sa((nid as u64)) == "Self") {
        base.node_set_sa((nid as u64), sn);
    }
    desugar_self_node(base.node_na((nid as u64)), sn);
    desugar_self_node(base.node_nb((nid as u64)), sn);
    desugar_self_node(base.node_nc((nid as u64)), sn);
    desugar_self_node(base.node_nd((nid as u64)), sn);   // S4 §0.14.7 SoA：侧表访问器（原 .nd）
    // S4 §4.6 Phase 3：la/lb/lc 三链各自物化后遍历 —— `desugar_self_node` 只改节点的 sa，
    // 不写 kids 链 ⇒ 遍历集合恒等。
    var ksa: []i64 = base.kids_chain(base.node_la((nid as u64)));
    var kia: i64 = 0;
    while (kia < slice_len(ksa) as i64) { desugar_self_node(ksa[kia], sn); kia = kia + 1; }
    var ksb: []i64 = base.kids_chain(base.node_lb((nid as u64)));
    var kib: i64 = 0;
    while (kib < slice_len(ksb) as i64) { desugar_self_node(ksb[kib], sn); kib = kib + 1; }
    var ksc: []i64 = base.kids_chain(base.node_lc((nid as u64)));
    var kic: i64 = 0;
    while (kic < slice_len(ksc) as i64) { desugar_self_node(ksc[kic], sn); kic = kic + 1; }
}

// 解析 struct 体内的方法声明，脱糖为顶层自由函数：
//   push fn(self: Self, v: i64) List {...}  →  list_push fn(self: List, v: i64) List {...}
// 当前 token 应为 fn（parse_func_decl 自吞）；方法名 mname 已由调用方读出。
pub fn parse_method_decl(structname: string, mname: string, anns: i64) i64 {
    // 注：调用方已消费 `fn` 关键字，当前 token 即为 `(`
    var fd: i64 = parse_func_decl(mname, anns, false, false);
    base.node_set_sa((fd as u64), base.sb_cat3(pascal_to_snake(structname), "_", mname));
    base.node_set_bc((fd as u64), lex.g_struct_exported);   // S4 §0.14.7 SoA：侧表写（原 fdn.bc）
    desugar_self_node(base.node_na((fd as u64)), structname);
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
    var ks1: []i64 = base.kids_chain(base.node_lb((fd as u64)));
    var ki1: i64 = 0;
    while (ki1 < slice_len(ks1) as i64) {
        var pcv: i64 = ks1[ki1];
        desugar_self_node(base.node_na((pcv as u64)), structname);
        ki1 = ki1 + 1;
    }
    // 函数体：FuncDecl.lc 是语句链表头（kids 下标），必须按链表逐条下钻，
    // 不可当作节点 id 直接传（否则读到随机 Child，函数体内的 `Self` 全漏改写）。
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
    var ks2: []i64 = base.kids_chain(base.node_lc((fd as u64)));
    var ki2: i64 = 0;
    while (ki2 < slice_len(ks2) as i64) {
        desugar_self_node(ks2[ki2], structname);
        ki2 = ki2 + 1;
    }
    return fd;
}

// 把当前 struct 累积的方法 FuncDecl 链表追加进 decl_list（保证 struct 在前、方法在后）。
pub fn flush_struct_methods() void {
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
    var ks: []i64 = base.kids_chain(lex.g_method_head);
    var ki: i64 = 0;
    while (ki < slice_len(ks) as i64) {
        append(lex.decl_list, ks[ki]);
        ki = ki + 1;
    }
    lex.g_method_head = -1;
    lex.g_method_tail = -1;
}

// P3a：把结构体内收集到的关联常量 GlobalConstDecl 链表追加进 decl_list（类比 flush_struct_methods），
// 保证 register 阶段先见 struct 再见关联常量。非 struct 声明时为空操作。
pub fn flush_struct_consts() void {
    var ks: []i64 = base.kids_chain(lex.g_const_head);
    var ki: i64 = 0;
    while (ki < slice_len(ks) as i64) {
        append(lex.decl_list, ks[ki]);
        ki = ki + 1;
    }
    lex.g_const_head = -1;
    lex.g_const_tail = -1;
}

pub fn parse_struct_decl(name: string, anns: i64, layout: string) i64 {
    // 关键字 `struct` 已由调用方消费（dispatch 或 `struct Name` 桥）；layout 亦由调用方处理。
    var r_anns: i64 = parse_annotations();
    expect_tok("LBrace");
    var r_sfield: i64 = -1;
    var r_sfield_t: i64 = -1;
    var r_idx: i64 = 0;   // 位置字段元组（struct T { T1, T2 }）的自动字段名计数 `_0`/`_1`/...
    lex.g_method_head = -1;
    lex.g_method_tail = -1;
    lex.g_const_head = -1;   // P3a：重置关联常量收集链（每次进入新 struct 清空）
    lex.g_const_tail = -1;
    while (lex.cur_t() != "RBrace" && lex.cur_t() != "Eof") {
        if (lex.cur_t() == "KwFunc") {
            // 新文法：`fn mname(params) Ret {...}`（关键字领头，LL(1) 友好）
            lex.advance_i();   // 消费 `fn`
            var mname: string = expect_tok("Identifier");
            var mfd: i64 = parse_method_decl(name, mname, r_anns);
            if (mfd >= 0) {
                lex.g_method_tail = base.list_push(lex.g_method_head, lex.g_method_tail, mfd);
                if (lex.g_method_head < 0) { lex.g_method_head = lex.g_method_tail; }
            }
        } else if (lex.cur_t() == "KwConst") {
            // P3a：结构体关联常量 `const Name = ...`（重命名为 `<struct>_Name` 的全局常量，
            // 与方法 `point_origin` 同构：顶层自由符号 + sema member 解析改写 ident 发射）。
            lex.advance_i();   // 消费 `const`
            var cname: string = expect_tok("Identifier");
            var cti: i64 = lex.pos - 1;
            var ctn: i64 = -1;
            if (lex.cur_t() == "Colon") {
                lex.advance_i();
                ctn = parse_type();
            }
            var cinit: i64 = -1;
            if (lex.cur_t() == "Assign") {
                lex.advance_i();
                cinit = parse_expr();
            }
            expect_tok("Semicolon");
            base.validate_const_name(cname, cti);
            var cfull: string = base.sb_cat3(name, "_", cname);
            var cfd: i64 = base.mk_GlobalConstDecl(cfull, false, ctn, cinit, -1, cti);
            lex.g_const_tail = base.list_push(lex.g_const_head, lex.g_const_tail, cfd);
            if (lex.g_const_head < 0) { lex.g_const_head = lex.g_const_tail; }
        } else if (lex.cur_t() == "Identifier" && lex.peek_t(1) == "KwFunc") {
            // 方言统一（Stage 2）：`mname fn(...)` 结构体方法旧文法已废弃，统一为 `fn mname(...)`。
            // 转换器已把整树结构体方法迁到 `fn mname`，此处直接报迁移错误而非误当成字段解析。
            var mname: string = expect_tok("Identifier");
            parse_fatal_at("T-PAR-E102", base.sb_cat6("method `", mname, " fn(...)` removed; use `fn ", mname, "(...)` (struct ", base.sb_cat2(name, ")")), lex.pos);
        } else if (lex.cur_t() == "Identifier" && lex.peek_t(1) == "Colon") {
            // 具名字段：`name: Type;`（沿用既有 parse_sfield）
            var __it: i64 = parse_sfield();
            r_sfield_t = base.list_push(r_sfield, r_sfield_t, __it);
            if (r_sfield < 0) { r_sfield = r_sfield_t; }
        } else if (lex.cur_t() == "Identifier" && lex.cur_v() == "_" && lex.peek_t(1) == "Semicolon") {
            // 扩展锚点 `_`：`overload struct` 的尾部占位标记（struct-modifiers 设计 §2.1），
            // 纯语法、不生成字段；extend overload 追加字段接在其后（合并期处理）。
            lex.advance_i();   // 吃掉 `_`
            if (lex.cur_t() == "Semicolon") { lex.advance_i(); }
        } else {
            // 位置字段元组语法：`struct T { T1, T2, ... }` —— 字段自动命名 `_0`/`_1`/...。
            // 任意「类型起始 token」（标识符类型、类型关键字 string/void/map/unit、
            // `[` 切片/数组、`.` 元组类型、`*` 指针、`?` 可选等）都按位置字段处理，
            // 字段类型节点（na）由 sema 期 resolve_ti 解析为真实类型（与匿名元组类型 `.{T1,T2}` 同源）。
            var ft: i64 = parse_type();
            var fnm: string = base.sb_cat2("_", base.i2s(r_idx));
            r_idx = r_idx + 1;
            var fid: i64 = base.node_new("F");
            base.node_set_sa((fid as u64), fnm);
            base.node_set_na((fid as u64), ft);   // 字段类型节点（sema 期通过 resolve_ti 解析为真实类型）
            base.node_set_ib((fid as u64), -1);   // S4 §0.14.7 SoA：取代 `fnode.ib`（下方 slice_set 回写生效）
            base.node_set_la((fid as u64), -1);
            base.node_set_nb((fid as u64), -1);
            r_sfield_t = base.list_push(r_sfield, r_sfield_t, fid);
            if (r_sfield < 0) { r_sfield = r_sfield_t; }
            if (lex.cur_t() == "Comma") { lex.advance_i(); }
        }
    }
    expect_tok("RBrace");
    var __id: i64 = base.mk_StructDecl(name, layout, bp_type2(anns, r_anns), bp_has_type2(anns, r_anns), bp_is2(anns, r_anns), list_concat(anns, r_anns), r_sfield, -1);
    return __id;
}

pub fn parse_umember() i64 {
    var r_Ident: string = expect_tok("Identifier");
    expect_tok("Colon");
    var r_type: i64 = parse_type();
    var r_anns: i64 = parse_annotations();
    if (lex.cur_t() == "Comma" || lex.cur_t() == "Semicolon") {
    if (lex.cur_t() == "Comma") {
    expect_tok("Comma");
    }    else if (lex.cur_t() == "Semicolon") {
    expect_tok("Semicolon");
    } else {
        parse_fatal("unexpected token in alternative");
    }
    }
    var __id: i64 = base.mk_M(r_Ident, r_type, r_anns, -1);
    return __id;
}

pub fn parse_union_decl(name: string, anns: i64) i64 {
    lex.advance_i();
    var r_anns: i64 = parse_annotations();
    expect_tok("LBrace");
    var r_umember: i64 = -1;
    var r_umember_t: i64 = -1;
    while (lex.cur_t() == "Identifier" && lex.cur_t() != "Eof") {
        var __it: i64 = parse_umember();
        r_umember_t = base.list_push(r_umember, r_umember_t, __it);
        if (r_umember < 0) { r_umember = r_umember_t; }
    }
    expect_tok("RBrace");
    var __id: i64 = base.mk_UnionDecl(name, list_concat(anns, r_anns), r_umember, -1);
    return __id;
}





pub fn parse_case(ci: i64) i64 {
    var r_Ident: string = expect_tok("Identifier");
    var r_type: i64 = -1;
    var r_types: i64 = -1;
    var r_types_t: i64 = -1;
    var r_cnt: i64 = 0;
    if (lex.cur_t() == "LParen") {
    expect_tok("LParen");
    r_type = parse_type();
    r_cnt = 1;
    // ADT 多载荷 case `Rect(f64, f64)`：类型链存 VC.lb、个数存 VC.ib。
    // 单载荷/单元 case 仍**只**用 VC.na（lb=-1），与既有 register_variant_helpers /
    // emit_variant_decl 完全一致 —— 故既有 variant 的发射逐字节不变。
    while (lex.cur_t() == "Comma") {
        expect_tok("Comma");
        var r_tn: i64 = parse_type();
        if (r_cnt == 1) {
            r_types_t = base.list_push(r_types, r_types_t, r_type);
            if (r_types < 0) { r_types = r_types_t; }
        }
        r_types_t = base.list_push(r_types, r_types_t, r_tn);
        if (r_types < 0) { r_types = r_types_t; }
        r_cnt = r_cnt + 1;
    }
    expect_tok("RParen");
    }
    var r_anns: i64 = parse_annotations();
    if (lex.cur_t() == "Comma" || lex.cur_t() == "Semicolon") {
    if (lex.cur_t() == "Comma") {
    expect_tok("Comma");
    }    else if (lex.cur_t() == "Semicolon") {
    expect_tok("Semicolon");
    } else {
        parse_fatal("unexpected token in alternative");
    }
    }
    var __id: i64 = base.mk_VC(r_Ident, ci, r_type, r_anns, -1);
    if (r_cnt >= 2) {
        base.node_set_lb((__id as u64), r_types);
        base.node_set_ib((__id as u64), r_cnt);   // S4 §0.14.7 SoA：取代 `r_vn.ib`（下方 slice_set 回写生效）
    }
    return __id;
}

pub fn parse_variant_decl(name: string, anns: i64) i64 {
    lex.advance_i();
    var r_anns: i64 = parse_annotations();
    expect_tok("LBrace");
    var r_case: i64 = -1;
    var r_case_t: i64 = -1;
    var ci: i64 = 0;
    var r_abs: bool = false;
    while (lex.cur_t() == "Identifier" && lex.cur_t() != "Eof") {
        // ADT 抽象标记：末位 `_` 把该 variant 声明为「抽象 / 非穷尽（open）」。
        // `_` 是**类型级标记**、不是真实 case：不占 tag、不生成构造器（见 adt_variant.md §7.6）。
        if (lex.cur_v() == "_") {
            lex.advance_i();
            r_abs = true;
            if (lex.cur_t() == "Comma") { lex.advance_i(); }
            else if (lex.cur_t() == "Semicolon") { lex.advance_i(); }
            // 只允许出现在末位：其后必须收尾。
            if (lex.cur_t() != "RBrace") {
                parse_fatal_at("T-PAR-E103",
                    "variant 的抽象标记 `_` 只能位于末位（其后不得再有 case）", lex.pos);
            }
        } else {
        var __it: i64 = parse_case(ci);
        r_case_t = base.list_push(r_case, r_case_t, __it);
        if (r_case < 0) { r_case = r_case_t; }
        ci = ci + 1;
        }
    }
    expect_tok("RBrace");
    var __id: i64 = base.mk_VariantDecl(name, list_concat(anns, r_anns), r_case, -1);
    if (r_abs) {
        base.node_set_ba((__id as u64), true);   // S4 §0.14.7 SoA：侧表写（原 r_dn.ba = true；第十批）
    }
    return __id;
}

pub fn parse_type_alias(name: string, anns: i64) i64 {
    var r_type: i64 = parse_type();
    expect_tok("Semicolon");
    var __id: i64 = base.mk_TypeAliasDecl(name, r_type, anns, -1);
    return __id;
}

// <<< GEN:parser_rules <<<



// 取点分路径的首段（无点则为整串）。用于识别 `src.` 源码根标记。
pub fn first_segment(s: string) string {
    var n: u64 = str_len(s);
    var i: u64 = 0;
    while (i < n) {
        if (s[i] == 46) { return str_slice(s, 0, i); }
        i = i + 1;
    }
    return s;
}


// 去掉点分路径的首段（无点则返回 ""）。`src.d.e` => `d.e`。
pub fn drop_first_segment(s: string) string {
    var n: u64 = str_len(s);
    var i: u64 = 0;
    while (i < n) {
        if (s[i] == 46) { return str_slice(s, i + 1, n); }
        i = i + 1;
    }
    return "";
}


pub fn n_file(ni: i64) string {
    if (ni < 0) {
        return "";
    }
    if (base.node_span_id(ni).line == 0) {
        return "";
    }
    return base.node_file(ni);
}


pub fn list_count(head: i64) i64 {
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
    var n: i64 = 0;
    var ks: []i64 = base.kids_chain(head);
    var ki: i64 = 0;
    while (ki < slice_len(ks) as i64) {
        n = n + 1;
        ki = ki + 1;
    }
    return n;
}


pub fn n_col(ni: i64) i64 {
    if (ni < 0) {
        return 1;
    }
    if (base.node_span_id(ni).line == 0) {
        return 1;
    }
    return base.node_span_id(ni).col as i64;
}


pub fn n_line(ni: i64) i64 {
    if (ni < 0) {
        return 1;
    }
    if (base.node_span_id(ni).line == 0) {
        return 1;
    }
    return base.node_span_id(ni).line as i64;
}


pub fn parse_meta_builtin() i64 {
    var ti_at: i64 = lex.advance_i();               // '@'
    // P2b：允许 @struct / @enum / @fn 这些关键字作为内建名（否则关键字 token 被 Identifier 期望拒绝）。
    // token 值即关键字文本（"struct" / "enum" / "fn"），与 mbuiltin 节点的 sa 对齐。
    var nm: string = "";
    if (lex.cur_t() == "Identifier") {
        nm = expect_tok("Identifier");
    } else if (lex.cur_t() == "KwStruct" || lex.cur_t() == "KwEnum" || lex.cur_t() == "KwFunc" || lex.cur_t() == "KwVariant"
            || lex.cur_t() == "KwAs") {
        nm = lex.tk_v(lex.advance_i());
    } else {
        parse_fatal(base.sb_cat2("语法错误：@ 后须接内建名，实际读到 ", lex.cur_v()));
        return -1;
    }
    expect_tok("LParen");
    var head: i64 = -1;
    var tail: i64 = -1;
    var idx: i64 = 0;
    if (lex.cur_t() != "RParen") {
        while (true) {
            var a: i64 = -1;
            if (mb_arg_is_type(nm, idx)) {
                a = parse_type();
            } else {
                a = parse_expr();
            }
            tail = base.list_push(head, tail, a);
            if (head < 0) { head = tail; }
            idx = idx + 1;
            if (lex.cur_t() == "Comma") { lex.advance_i(); } else { break; }
        }
    }
    expect_tok("RParen");
    // @type_info(T)：与既有的 type_info(T) 类型位内建完全同构 —— 直接产出 typeinfo 节点
    // （sa = 类型名），复用后端 @__ti_<T> 合成常量。这样 @type_info 走与 type_info 完全相同的
    // 发射路径（TIR_OP_TYPEINFO → @__ti_<T>），避免走 mbuiltin → t_type_info 运行时调用
    // （TIR 把 mbuiltin 统一降级为普通调用，无 CTFE 折叠，故此处提前脱糖）。形参第 0 位是
    // 类型（见 mb_arg_is_type），parse_type 给出的节点 sa 即类型名（named/scalar）。
    if (nm == "type_info") {
        var a0: i64 = -1;
        if (head >= 0) {
            var ks: []i64 = base.kids_chain(head);
            if (slice_len(ks) > 0) { a0 = ks[0]; }
        }
        var tname: string = "";
        if (a0 >= 0) { tname = base.node_sa((a0 as u64)); }
        var tid: i64 = base.node_new("typeinfo");
        base.node_set_sa((tid as u64), tname);
        // 额外存完整类型节点于 na：comptime 路径（meta_eval 的 typeinfo 分支）据此恢复
        // 合成类型（pointer/slice/array/func/optional）的真实节点，以便按节点 kind 分类 arm；
        // 运行时 TIR_OP_TYPEINFO 仅读 sa（类型名）合成 @__ti_<T>，不读 na，故互不影响。
        if (a0 >= 0) { base.node_set_na((tid as u64), a0); }
        base.node_at(tid, ti_at);
        return tid;
    }
    var id: i64 = base.node_new("mbuiltin");
    base.node_set_sa((id as u64), nm);
    base.node_set_la((id as u64), head);
    base.node_at(id, ti_at);
    return id;
}


// 该形参位收类型还是表达式 —— 解析期就必须定死（`[1024]u8` 不是合法表达式）
pub fn mb_arg_is_type(name: string, idx: i64) bool {
    // 对齐 Zig 的 @sizeOf / @alignOf / @bitSizeOf（P0 只读内省）。
    // @size_of 与既有 @type_size 同义；@align_of / @bit_size_of 为新增。三者第 0 形参均收类型。
    if (name == "type_name" || name == "type_size" || name == "size_of" || name == "align_of" || name == "bit_size_of" || name == "zeroed" || name == "has_field" || name == "offset_of") { return idx == 0; }
    if (name == "type_equal") { return idx < 2; }
    // `@simd_lanes(T)`：第 0 个形参是**类型**（i64 等），不是表达式
    if (name == "simd_lanes") { return idx == 0; }
    // `@type_info(T)`：第 0 个形参是**类型**，不是表达式（与 type_info 类型位内建同构）
    if (name == "type_info") { return idx == 0; }
    // P2b 类型构造元函数：@pointer / @enum / @fn 第 0 形参是类型，其余按表达式解析。
    if (name == "pointer" || name == "enum" || name == "fn") { return idx == 0; }
    // @variant(backing, names, types)：第 0 形参 backing（判别子类型）是类型，names/types 按表达式解析。
    if (name == "variant") { return idx == 0; }
    // P3：@as(T, v) / @bit_cast(T, v) 第 0 形参是目标类型，第 1 形参按表达式解析。
    if (name == "as" || name == "bit_cast") { return idx == 0; }
    // P4b：@field_parent_ptr(Parent, child_ptr, "field") 第 0 形参是容器类型，其余按表达式解析。
    if (name == "field_parent_ptr") { return idx == 0; }
    // @int / @tuple / @struct / @enum_literal：全部实参按表达式解析（类型以类型值传入）。
    return false;
}
