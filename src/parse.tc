// ══════════════════════════════════════════════════════════════════
// src/parse.tc — 编译步骤 2：语法分析
//
// 内容：递归下降 parser（构建扁平 Node 池）、顶层声明解析、
//       前端 lowering（agent 展开、函数子句脱糖）。
// 依赖：base, lex。
// ══════════════════════════════════════════════════════════════════

import(src.base :: *);
import(src.lex :: *);

// 解析期致命错误：登记结构化诊断（带文件/行列）→ 输出 JSON → 退出。
//
// ⚠ 解析器**没有错误恢复**，任何语法错都必须就地终止；但绝不能再裸 `eprint`
//   到 stderr —— stdout 的 JSON 才是机器可读通道，IDE / REPL / `tc check`
//   的消费方只认它。历史上 36 处 parse error 全走裸 eprint，导致语法错在
//   REPL 里**完全静默**（build.log 空、无人读 build.err），也没有行列信息。
//   打印器 `print_json` 已从 sema.tc 下沉到 base.tc，parse 层现可直接调用。
fn parse_fatal_at(code: string, msg: string, ti: i64) void {
    var l: i64 = tk_line(ti) as i64;
    var c: i64 = tk_col(ti) as i64;
    var w: i64 = str_len(tk_v(ti)) as i64;
    if (w < 1) { w = 1; }
    diag_new(code, "error", msg, g_file, l, c, l, c + w);
    emit_diags();
    exit(1);
}

// 定位到「当前 token」的致命语法错误（绝大多数站点用这个）。
fn parse_fatal(msg: string) void {
    parse_fatal_at("T-PAR-E101", msg, pos);
}

fn expect_tok(t: string) string {
    if (cur_t() == t) {
        var idx: i64 = advance_i();
        return tk_v(idx);
    }
    parse_fatal(sb_cat4("语法错误：期待 ", t, "，实际读到 ", cur_v()));
    return "";
}

// parseInt(s, 10) 语义：取前导十进制数字
fn parse_int_str(s: string) i64 {
    var r: i64 = 0;
    var i: u64 = 0;
    var n: u64 = str_len(s);
    while (i < n) {
        var c: u8 = s[i];
        if (is_digit(c) == false) {
            break;
        }
        r = r * 10 + ((c as i64) - 48);
        i = i + 1;
    }
    return r;
}

// 拼接两条 Child 链，返回新头
fn list_concat(a: i64, b: i64) i64 {
    if (a < 0) {
        return b;
    }
    if (b < 0) {
        return a;
    }
    var it: i64 = a;
    while (true) {
        var c: Child = kids[it];
        if (c.next < 0) {
            c.next = b;
            slice_set(kids, it, c);
            break;
        }
        it = c.next;
    }
    return a;
}

// ── 注解解析 ───────────────────────────────────────────────────

fn parse_annotation_args() i64 {
    var head: i64 = -1;
    var tail: i64 = -1;
    while (cur_t() != "RParen" && cur_t() != "Eof") {
        var t: string = cur_t();
        var made: i64 = -1;
        if (t == "String") {
            var idx: i64 = advance_i();
            made = mk_string(tk_v(idx), -1);
        } else {
        if (t == "Integer") {
            var idx2: i64 = advance_i();
            made = mk_number(tk_v(idx2), -1);
        } else {
        if (t == "Identifier") {
            var ih: i64 = -1;
            var it: i64 = -1;
            var cnt: i64 = 1;
            var idx3: i64 = advance_i();
            var id1: i64 = mk_ident(tk_v(idx3), -1);
            it = list_push(ih, it, id1);
            ih = it;
            while (cur_t() == "Comma") {
                advance_i();
                var v2: string = expect_tok("Identifier");
                var id2: i64 = mk_ident(v2, -1);
                it = list_push(ih, it, id2);
                cnt = cnt + 1;
            }
            if (cnt == 1) {
                made = id1;
            } else {
                made = mk_list(ih, -1);
            }
        } else {
            parse_fatal("invalid annotation argument");
        }}}
        tail = list_push(head, tail, made);
        if (head < 0) {
            head = tail;
        }
        if (cur_t() != "RParen") {
            if (cur_t() == "Comma") {
                advance_i();
            }
        }
    }
    return head;
}

fn parse_annotations() i64 {
    var head: i64 = -1;
    var tail: i64 = -1;
    // 注解循环只消费 `@名`/`@Export` 形式；`@ <整数>` 是字段 tagID，
    // 必须由 parse_sfield 单独消费，故此处遇 `@` 后接 Integer 即停（留待 tagID 解析）。
    while (cur_t() == "At" && (peek_t(1) == "Identifier" || peek_t(1) == "KwExport")) {
        advance_i();
        var name: string = "";
        var nti: i64 = pos;
        if (cur_t() == "Identifier" || cur_t() == "KwExport") {
            var idx: i64 = advance_i();
            name = tk_v(idx);
            nti = idx;
        } else {
            name = expect_tok("Identifier");
            nti = pos - 1;
        }
        if (is_lower_snake(name) == false) {
            warn_name("T-NAM-W403", sb_cat3("annotation name '", name, "' should be lowercase snake_case"), nti, str_len(name) as i64);
        }
        var args_head: i64 = -1;
        if (cur_t() == "LParen") {
            advance_i();
            args_head = parse_annotation_args();
            expect_tok("RParen");
        }
        var id: i64 = mk_A(name, args_head, nti);
        tail = list_push(head, tail, id);
        if (head < 0) {
            head = tail;
        }
    }
    return head;
}

// ── 类型解析 ───────────────────────────────────────────────────

// >>> GEN:scalar_pred (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
fn is_scalar_name(name: string) bool {
    if (name == "u8" || name == "u16" || name == "u32" || name == "u64") {
        return true;
    }
    if (name == "i8" || name == "i16" || name == "i32" || name == "i64") {
        return true;
    }
    if (name == "f16" || name == "f32" || name == "f64") {
        return true;
    }
    // rune：Unicode 码点，内部 i32 描述（见 docs/reference.md §2.4 rune）。
    // 纳入标量族，算术 / 比较 / i32 互转全免费；与 i32 同名但语义独立。
    if (name == "rune") {
        return true;
    }
    // bytes：二进制视图（{ptr, len}），与 string 同布局、类型独立；
    // BytesBuilder：可增长字节缓冲，对应 string 的 StringBuilder。
    if (name == "bytes" || name == "BytesBuilder") {
        return true;
    }
    return name == "bool" || name == "atom" || name == "fid";
}
// <<< GEN:scalar_pred <<<

fn parse_type() i64 {
    var t: string = cur_t();
    if (t == "KwFunc") {
        advance_i();
        expect_tok("LParen");
        var fphead: i64 = -1;
        var fptail: i64 = -1;
        if (cur_t() != "RParen") {
            while (true) {
                var fpt: i64 = parse_type();
                fptail = list_push(fphead, fptail, fpt);
                if (fphead < 0) { fphead = fptail; }
                if (cur_t() == "Comma") { advance_i(); } else { break; }
            }
        }
        expect_tok("RParen");
        // L-04：`->` 返回类型箭头已移除，返回类型紧跟 `:`，不再被编译器接受

        var frt: i64 = parse_type();
        return mk_func_type(frt, fphead, -1);
    }
    if (t == "KwMap") {
        advance_i();
        expect_tok("LBracket");
        var kt: i64 = parse_type();
        expect_tok("RBracket");
        var vt: i64 = parse_type();
        var id: i64 = mk_map(kt, vt, -1);
        return id;
    }
    if (t == "LBracket") {
        advance_i();
        if (cur_t() == "RBracket") {
            advance_i();
            var el: i64 = parse_type();
            var id2: i64 = mk_slice(el, -1);
            return id2;
        }
        var ln: i64 = parse_expr();
        expect_tok("RBracket");
        var el2: i64 = parse_type();
        var id3: i64 = mk_array(el2, ln, -1);
        return id3;
    }
    if (t == "Star") {
        advance_i();
        var el3: i64 = parse_type();
        var id4: i64 = mk_pointer(el3, -1);
        return id4;
    }
    if (t == "Question") {
        advance_i();
        var el4: i64 = parse_type();
        var id5: i64 = mk_optional(el4, -1);
        return id5;
    }
    if (t == "KwVoid") {
        advance_i();
        return mk_scalar("void", -1);
    }
    if (t == "KwString") {
        advance_i();
        return mk_scalar("string", -1);
    }
    if (t == "KwStringBuilder") {
        advance_i();
        return mk_scalar("StringBuilder", -1);
    }
    if (t == "KwAny") {
        advance_i();
        // comptime 类型模板参数的占位类型；单态化时整体移除，从不进入发射。
        return node_new("any");
    }
    if (t == "KwType") {
        advance_i();
        // meta T: type 的「类型之类型」占位；单态化时整体移除，与 any 同语义。
        return node_new("type");
    }
    if (t == "Identifier") {
        var idx: i64 = advance_i();
        var name: string = tk_v(idx);
        // 模块限定类型 `A.T`（A = import 别名）：类型位置上 `X.Y` 只可能是模块限定，
        // 故直接记为 named{ sa = T, sb = A }，由 mangle_modules 解析成 A__T。
        if (cur_t() == "Dot" && peek_t(1) == "Identifier") {
            advance_i();
            var qtn: string = expect_tok("Identifier");
            var idq: i64 = mk_named(qtn, idx);
            var nq: Node = nodes[idq];
            nq.sb = name;
            slice_set(nodes, idq, nq);
            return idq;
        }
        if (name == "flag") {
            if (cur_t() == "LBracket") {
                advance_i();
                var ui: i64 = advance_i();
                expect_tok("RBracket");
                var idf: i64 = mk_flag(tk_v(ui), -1);
                return idf;
            }
        }
        if (name == "flag_set") {
            return mk_flag_set(-1);
        }
        if (name == "Sym32" || name == "Sym16") {
            expect_tok("LParen");
            var tagv: string = expect_tok("String");
            expect_tok("RParen");
            var bits: i64 = 32;
            if (name == "Sym16") { bits = 16; }
            var idsym: i64 = mk_sym(tagv, bits, -1);
            return idsym;
        }
        if (name == "Variant") {
            return mk_variant(-1);
        }
        if (is_scalar_name(name)) {
            return mk_scalar(name, -1);
        }
        var idn: i64 = mk_named(name, -1);
        return idn;
    }
    parse_fatal("expected type");
    return -1;
}

// ── 表达式解析（优先级爬升，逐层照抄 tc0）─────────────────────

fn mk_bin(op: string, left: i64, right: i64, ti: i64) i64 {
    var id: i64 = mk_binary(op, left, right, ti);
    return id;
}

fn parse_expr() i64 {
    return parse_assign_expr();
}

// 管道级（L0，最低二元级，全左结合）—— 包在 parse_or 外层。
// 既有 10 级塔层级与顺序一字不变（L-03「塔只向下扩展、不重排」）。
// 三个算子同级：`|->` 映射 / `|>?` 过滤 / `|>` 多态管道。
fn parse_pipe() i64 {
    var left: i64 = parse_in();
    while (cur_t() == "PipeMap" || cur_t() == "PipeFilter" || cur_t() == "PipeApply") {
        var pk: string = cur_t();
        var ti: i64 = advance_i();
        var right: i64 = parse_in();
        if (pk == "PipeMap") {
            left = mk_pipe_map(left, right, ti);
        } else if (pk == "PipeFilter") {
            left = mk_pipe_filter(left, right, ti);
        } else {
            left = mk_pipe_apply(left, right, ti);
        }
    }
    return left;
}

// ── 区间字面量（M-range）───────────────────────────────────────
// 塔层新增两级，夹在管道级（L0）与逻辑或级（L1）之间：
//
//   assign → pipe → in → range → or → … → primary
//
// 放在管道**内侧**是刻意的：`0..10 |> f` 必须读成 `(0..10) |> f`，
// 而不是 `0..(10 |> f)`；放在逻辑或**外侧**则让 `a..b` 的端点可以是任意
// 普通表达式（`0..n*2`、`lo..arr[i]`）而无需加括号。
//
// 端点缺省的判定：`..` 之后若紧跟这些「表达式不可能开始」的 token，
// 就认定右端省略（`a..`、`..`）。`FatArrow` / `KwWhen` 是为 match 臂
// （`5.. => ...`、`1..9 when p => ...`）准备的。
fn range_end_omitted() bool {
    var t: string = cur_t();
    if (t == "RBracket" || t == "RParen" || t == "RBrace") { return true; }
    if (t == "Comma" || t == "Semicolon" || t == "Eof") { return true; }
    if (t == "FatArrow" || t == "KwWhen") { return true; }
    if (t == "LBrace") { return true; }   // `for (i in 0..) { }` 的循环体左花括号
    return false;
}

fn parse_range() i64 {
    // 前缀形态：`..b` / `..=b` / `..`（左端省略）
    if (cur_t() == "DotDot" || cur_t() == "DotDotEq") {
        var pincl: bool = cur_t() == "DotDotEq";
        var pti: i64 = advance_i();
        var phi: i64 = -1;
        if (range_end_omitted() == false) { phi = parse_or(); }
        if (pincl && phi < 0) {
            parse_fatal_at("T-RNG-E874", "`..=` 是闭合区间，必须给出右端点（想要开放右端请用 `..`）", pti);
        }
        return mk_range(-1, phi, pincl, pti);
    }
    var left: i64 = parse_or();
    if (cur_t() == "DotDot" || cur_t() == "DotDotEq") {
        var incl: bool = cur_t() == "DotDotEq";
        var ti: i64 = advance_i();
        var hi: i64 = -1;
        if (range_end_omitted() == false) { hi = parse_or(); }
        if (incl && hi < 0) {
            parse_fatal_at("T-RNG-E874", "`..=` 是闭合区间，必须给出右端点（想要开放右端请用 `..`）", ti);
        }
        return mk_range(left, hi, incl, ti);
    }
    return left;
}

// 成员测试级：`x in <range>` → bool。右操作数当前只接受区间字面量，
// 由 sema 就地降解为 `(x >= lo && x <= hi)`，两个后端永远看不到 `in`。
// 与 `for (x in xs)` 零冲突：for 头部在调用 parse_expr **之前**已自行吃掉 `in`。
fn parse_in() i64 {
    var left: i64 = parse_range();
    while (cur_t() == "KwIn") {
        var ti: i64 = advance_i();
        var right: i64 = parse_range();
        left = mk_binary("in", left, right, ti);
    }
    return left;
}

fn parse_assign_expr() i64 {
    var left: i64 = parse_pipe();
    if (cur_t() == "Assign") {
        var ti: i64 = advance_i();
        var right: i64 = parse_assign_expr();
        var id: i64 = mk_assign("=", left, right, ti);
        return id;
    }
    return left;
}


// 语义胶水：前缀一元运算符构造（fold=pre 生成代码调用，tc.tc 手写保持于 GEN:parser_rules 区间外）
fn mk_un(op: string, operand: i64, ti: i64) i64 {
    var id: i64 = mk_unary(op, operand, ti);
    return id;
}

fn parse_post_member(e: i64, ti: i64) i64 {
    var member: string = expect_tok("Identifier");
    var id: i64 = mk_member(member, e, ti);
    return id;
}

fn parse_post_index(e: i64, ti: i64) i64 {
    var index: i64 = parse_expr();
    expect_tok("RBracket");
    var id: i64 = mk_index(e, index, ti);
    return id;
}

// format 出现开关：置位后 infer 才会对调用实参子树做补扫（详见 fmt_scan_subtree 的
// 长注释）。⚠ M55 漏了置位，导致 `sb_append_str(b, format(...))` 这类**嵌套**用法
// 一路漏到发射期变成 `; UNSUPPORTED call format`；M57 在这里补上。
// 置位点选在建 call 节点时，方法式 `"...".format(x)` 与函数式 `format("...", x)` 同时覆盖。
var g_has_format: bool;

fn parse_post_call(e: i64, ti: i64) i64 {
    var ce: Node = nodes[e];
    if (ce.sa == "format" && (ce.kind == "ident" || ce.kind == "member")) { g_has_format = true; }
    var head: i64 = -1;
    var tail: i64 = -1;
    while (cur_t() != "RParen" && cur_t() != "Eof") {
        var arg: i64 = parse_expr();
        tail = list_push(head, tail, arg);
        if (head < 0) {
            head = tail;
        }
        if (cur_t() == "Comma") {
            advance_i();
        } else {
            break;
        }
    }
    expect_tok("RParen");
    var id: i64 = mk_call(e, head, ti);
    return id;
}

fn parse_post_cast(e: i64, ti: i64) i64 {
    var tt: i64 = parse_type();
    var id: i64 = mk_cast(e, tt, ti);
    return id;
}

fn starts_with_0x(s: string) bool {
    if (str_len(s) < 2) {
        return false;
    }
    if (s[0] != 48) {
        return false;
    }
    return s[1] == 120 || s[1] == 88;
}

fn starts_with_0o(s: string) bool {
    if (str_len(s) < 2) {
        return false;
    }
    if (s[0] != 48) {
        return false;
    }
    return s[1] == 111 || s[1] == 79;
}

fn starts_with_0b(s: string) bool {
    if (str_len(s) < 2) {
        return false;
    }
    if (s[0] != 48) {
        return false;
    }
    return s[1] == 98 || s[1] == 66;
}

fn looks_like_struct_lit() bool {
    if (peek_t(1) == "RBrace") {
        return true;
    }
    if (peek_t(1) == "Identifier" && peek_t(2) == "Colon") {
        return true;
    }
    return false;
}

fn parse_struct_lit(type_name: string, ti: i64) i64 {
    advance_i();
    var head: i64 = -1;
    var tail: i64 = -1;
    while (cur_t() != "RBrace" && cur_t() != "Eof") {
        var fname: string = expect_tok("Identifier");
        expect_tok("Colon");
        var val: i64 = parse_expr();
        var fid: i64 = mk_FV(fname, val, -1);
        tail = list_push(head, tail, fid);
        if (head < 0) {
            head = tail;
        }
        if (cur_t() == "Comma") {
            advance_i();
        } else {
            break;
        }
    }
    expect_tok("RBrace");
    var id: i64 = mk_struct_lit(type_name, head, ti);
    return id;
}

fn parse_map_lit(ti: i64) i64 {
    var head: i64 = -1;
    var tail: i64 = -1;
    while (cur_t() != "RBracket" && cur_t() != "Eof") {
        var k: i64 = parse_expr();
        expect_tok("Colon");
        var v: i64 = parse_expr();
        var eid: i64 = mk_EN(k, v, -1);
        tail = list_push(head, tail, eid);
        if (head < 0) {
            head = tail;
        }
        if (cur_t() == "Comma") {
            advance_i();
        } else {
            break;
        }
    }
    expect_tok("RBracket");
    var id: i64 = mk_map_lit(head, ti);
    return id;
}

fn parse_array_lit(ti: i64) i64 {
    var is_maplit: bool = cur_t() == "Identifier" || cur_t() == "String" || cur_t() == "Integer";
    if (is_maplit && peek_t(1) == "Colon") {
        return parse_map_lit(ti);
    }
    var head: i64 = -1;
    var tail: i64 = -1;
    while (cur_t() != "RBracket" && cur_t() != "Eof") {
        var e: i64 = parse_expr();
        tail = list_push(head, tail, e);
        if (head < 0) {
            head = tail;
        }
        if (cur_t() == "Comma") {
            advance_i();
        } else {
            break;
        }
    }
    expect_tok("RBracket");
    var id: i64 = mk_array_lit(head, ti);
    return id;
}

// `-` 紧跟整数 token 时由 parse_unary 置位、由 parse_prim_int 读后即清。
// 只为一件事：让 `iN::MIN`（数值主体恰为 2^(N-1)）可写，见 reference.md §2.4。
var g_lit_neg: bool = false;

// primary 胶水 helper（fold=prim 骨架已消费分发 token，ti 为其下标）
fn parse_prim_int(ti: i64) i64 {
    var neg: bool = g_lit_neg;
    g_lit_neg = false;

    var raw: string = tk_v(ti);
    var sfx: string = lit_suffix_of(raw);
    var val: string = lit_body_of(raw);
    var radix: i64 = 10;
    if (starts_with_0x(val)) {
        radix = 16;
    } else if (starts_with_0b(val)) {
        radix = 2;
    } else if (starts_with_0o(val)) {
        radix = 8;
    }

    // 取值范围自检。无后缀时上界是 u64；有后缀时由后缀类型决定，
    // `iN` 的上界 2^(N-1) 仅在紧邻前置 `-` 时可取到（即 iN::MIN）。
    var mag: u64 = lit_val_u64(val);
    if (g_lit_overflow) {
        diag_lit_range(ti, raw, "整数字面量超出 u64 可表示范围");
    } else if (str_len(sfx) > 0) {
        var cap: u64 = lit_suffix_max(sfx);
        var over: bool = mag > cap;
        if (over == false && num_suffix_is_signed(sfx) && mag == cap && neg == false) {
            over = true;
        }
        if (over) {
            diag_lit_range(ti, raw,
                sb_cat3("整数字面量超出 `", sfx, "` 可表示范围"));
        }
    }

    var id: i64 = mk_int(val, radix, ti);
    if (str_len(sfx) > 0) {
        var nn: Node = nodes[id];
        nn.sb = sfx;
        slice_set(nodes, id, nn);
    }
    return id;
}

fn diag_lit_range(ti: i64, raw: string, msg: string) void {
    diag_new("T-LEX-E006", "error",
        sb_cat3(msg, "：", raw),
        g_file, tk_line(ti) as i64, tk_col(ti) as i64,
        tk_line(ti) as i64, (tk_col(ti) + str_len(raw)) as i64);
}

// 浮点后缀不走 `Node.sb`，而是脱糖成 `as f32` 显式转换：LLVM 的 `float` 常量
// 要求字面量在 f32 中**精确可表示**（`float 0.1` 会被 IR 解析器拒绝），
// 保留 f64 常量 + `fptrunc` 才是两个后端都成立的写法。f64 后缀是恒等，直接丢弃。
fn parse_prim_float(ti: i64) i64 {
    var raw: string = tk_v(ti);
    // IEEE-754 特殊值：文本原样存进 `float` 节点，后端各自翻译
    // （C → INFINITY / NAN；LLVM → 0x7FF0.. / 0x7FF8.. 位模式）。
    if (raw == "inf" || raw == "nan") {
        return mk_float(raw, ti);
    }
    var sfx: string = lit_suffix_of(raw);
    var id: i64 = mk_float(lit_body_of(raw), ti);
    if (sfx == "f32") {
        return mk_cast(id, mk_scalar("f32", ti), ti);
    }
    return id;
}

fn parse_prim_str(ti: i64) i64 {
    var id: i64 = mk_string(tk_v(ti), ti);
    return id;
}

fn parse_prim_true(ti: i64) i64 {
    var id: i64 = mk_bool(true, ti);
    return id;
}

fn parse_prim_false(ti: i64) i64 {
    var id: i64 = mk_bool(false, ti);
    return id;
}

fn parse_prim_null(ti: i64) i64 {
    var id: i64 = mk_null(ti);
    return id;
}

fn parse_prim_ident(ti: i64) i64 {
    var name: string = tk_v(ti);
    if (name == "type_info" && cur_t() == "LParen") {
        advance_i();
        var tn_tok: string = expect_tok("Identifier");
        expect_tok("RParen");
        var id: i64 = node_new("typeinfo");
        var nn: Node = nodes[id];
        nn.sa = tn_tok;
        slice_set(nodes, id, nn);
        return id;
    }
    if (cur_t() == "LBrace" && looks_like_struct_lit()) {
        return parse_struct_lit(name, ti);
    }
    // 模块限定结构体字面量 `A.T{ ... }`：记为 struct_lit{ sa = T, sb = A }，
    // 由 mangle_modules 解析成 A__T。判定条件与 looks_like_struct_lit 对齐（`{}` 或 `{ ident:`）。
    if (cur_t() == "Dot" && peek_t(1) == "Identifier" && peek_t(2) == "LBrace") {
        var ok_lit: bool = false;
        if (peek_t(3) == "RBrace") { ok_lit = true; }
        if (peek_t(3) == "Identifier" && peek_t(4) == "Colon") { ok_lit = true; }
        if (ok_lit) {
            advance_i();
            var qtn: string = expect_tok("Identifier");
            var slid: i64 = parse_struct_lit(qtn, ti);
            var sln: Node = nodes[slid];
            sln.sb = name;
            slice_set(nodes, slid, sln);
            return slid;
        }
    }
    var id: i64 = mk_ident(name, ti);
    return id;
}

fn parse_prim_paren(ti: i64) i64 {
    var inner: i64 = parse_expr();
    expect_tok("RParen");
    var id: i64 = mk_paren(inner, ti);
    return id;
}

fn parse_prim_array(ti: i64) i64 {
    return parse_array_lit(ti);
}

// ── 语句解析 ───────────────────────────────────────────────────

fn parse_block() i64 {
    expect_tok("LBrace");
    var head: i64 = -1;
    var tail: i64 = -1;
    while (cur_t() != "RBrace" && cur_t() != "Eof") {
        var s: i64 = parse_statement();
        if (s >= 0) {
            tail = list_push(head, tail, s);
            if (head < 0) {
                head = tail;
            }
        }
    }
    expect_tok("RBrace");
    return head;
}

fn parse_local_var(is_const: bool, is_export: bool) i64 {
    var ti: i64 = advance_i();
    var name: string = expect_tok("Identifier");
    var nti: i64 = pos - 1;
    var tn: i64 = -1;
    if (cur_t() == "Colon") {
        advance_i();
        tn = parse_type();
    }
    var init: i64 = -1;
    if (cur_t() == "Assign") {
        advance_i();
        init = parse_expr();
    }
    expect_tok("Semicolon");
    if (is_const) {
        validate_const_name(name, nti);
    } else {
        validate_var_name(name, nti);
    }
    var id: i64 = mk_var_decl(name, is_const, tn, init, ti);
    // 模块系统（M-Module）：export 只能修饰顶层声明；局部/嵌套变量加 export → T_EXPORT_SCOPE
    if (is_export) {
        nodes[id].bc = true;
        fc_err("T-MOD-E556", "export 只能修饰顶层声明，不能修饰局部/嵌套变量", id);
    }
    return id;
}

// `auto 名字 = 初值;` —— 历史写法，现为 `let`（动态常量）的**弃用别名**。
// 语义完全等同 `let`：immutable（ba=true）+ is_let 标记（bb=true）；
// 类型由初始化器在检查期推断并回填 n.na（三关键字模型）。
fn parse_auto_stmt() i64 {
    var ti: i64 = advance_i();
    var name: string = expect_tok("Identifier");
    if (cur_t() == "Colon") {
        parse_fatal("'auto' 推断变量不可标注类型，直接写 `auto 名字 = 初值;` 或改用 `let 名字 = 初值;`");
    }
    if (cur_t() != "Assign") {
        parse_fatal("'auto' 变量必须有初始化器 `auto 名字 = 初值;`");
    }
    advance_i();
    var init: i64 = parse_expr();
    expect_tok("Semicolon");
    var aid: i64 = mk_var_decl(name, true, -1, init, ti);  // ba=true：动态常量不可变
    var ann: Node = nodes[aid];
    ann.bb = true;   // 标记 is_let（动态常量）；检查期从初始化器推断类型
    slice_set(nodes, aid, ann);
    return aid;
}

fn parse_expr_or_assign_stmt() i64 {
    var ti: i64 = pos;
    var e: i64 = parse_expr();
    var t: string = cur_t();
    var is_assign: bool = false;
    if (t == "Assign" || t == "PlusAssign" || t == "MinusAssign" || t == "StarAssign") {
        is_assign = true;
    }
    if (t == "SlashAssign" || t == "PercentAssign" || t == "BitAndAssign" || t == "BitOrAssign") {
        is_assign = true;
    }
    if (t == "BitXorAssign" || t == "ShlAssign" || t == "ShrAssign") {
        is_assign = true;
    }
    if (is_assign) {
        var oi: i64 = advance_i();
        var op: string = tk_v(oi);
        var val: i64 = parse_expr();
        expect_tok("Semicolon");
        var id: i64 = mk_assignment(op, e, val, ti);
        return id;
    }
    expect_tok("Semicolon");
    var id2: i64 = mk_expr(e, ti);
    return id2;
}

// ── statement 分发胶水（fold=disp 目标；自行消费引导 token，GEN 区外）──

fn parse_break_stmt() i64 {
    var tb: i64 = advance_i();
    expect_tok("Semicolon");
    var idb: i64 = mk_break(tb);
    return idb;
}

fn parse_continue_stmt() i64 {
    var tc: i64 = advance_i();
    expect_tok("Semicolon");
    var idc: i64 = mk_continue(tc);
    return idc;
}

fn parse_defer_stmt() i64 {
    var td: i64 = advance_i();
    var body: i64 = parse_block();
    var id: i64 = mk_defer(body, td);
    return id;
}

fn parse_comptime_stmt() i64 {
    var tm: i64 = advance_i();
    if (cur_t() == "LBrace") {
        var body2: i64 = parse_block();
        var id2: i64 = mk_comptime_block(body2, tm);
        return id2;
    }
    var e: i64 = parse_expr();
    expect_tok("Semicolon");
    var ce: i64 = mk_comptime(e, tm);
    var id3: i64 = mk_expr(ce, tm);
    return id3;
}

fn parse_block_stmt() i64 {
    var tl: i64 = pos;
    var body3: i64 = parse_block();
    var id4: i64 = mk_block(body3, tl);
    return id4;
}

fn parse_var_stmt() i64 {
    return parse_local_var(false, false);
}

fn parse_const_stmt() i64 {
    var cd: i64 = parse_local_var(true, false);
    append(g_const_decl_ids, cd);
    return cd;
}

// `let 名字[: 类型] = 初值;` —— 动态常量（三关键字模型）。
// 运行期绑定一次、此后不可变；局部可省略类型标注由推断确定（与 var/const 同）。
// 复用 parse_local_var(is_const=true) 再置 is_let 标记（bb），避免改动其签名。
fn parse_local_let(is_export: bool) i64 {
    var id: i64 = parse_local_var(true, is_export);
    var n: Node = nodes[id];
    n.bb = true;   // 标记 is_let（动态常量）
    slice_set(nodes, id, n);
    return id;
}

fn parse_let_stmt() i64 {
    return parse_local_let(false);
}

// parse_statement 已由 GEN:parser_rules 区间生成（fold=disp 守卫式分发）。

// ── 注解查找辅助 ───────────────────────────────────────────────

// 在注解链中查找名为 name 的第一个注解，返回节点下标或 -1
fn ann_find(head: i64, name: string) i64 {
    var it: i64 = head;
    while (it >= 0) {
        var c: Child = kids[it];
        var an: Node = nodes[c.val];
        if (an.sa == name) {
            return c.val;
        }
        it = c.next;
    }
    return -1;
}

// 注解的第一个参数节点下标，无参数返回 -1
fn ann_first_arg(ann_idx: i64) i64 {
    var an: Node = nodes[ann_idx];
    if (an.la < 0) {
        return -1;
    }
    var c: Child = kids[an.la];
    return c.val;
}

// ── 声明解析 ───────────────────────────────────────────────────

// parse_struct_decl / parse_sfield 已由 GEN:parser_rules 区间生成（见下方标记区）。
// 注意语义等价性：手写版按 is_bitpack 状态二分成员形态；生成版用 FIRST 守卫 alt
// （Integer → 位宽成员，其余 → 类型成员），对合法输入等价（类型永不以 Integer 开头）。

fn parse_enum_decl(name: string, anns: i64) i64 {
    // 关键字 `enum` 已由调用方消费（name-first 路径的 parse_decl_body dispatch，
    // 或关键字领头桥 `enum Name`）；此处不再 advance_i()。
    var underlying: string = "u32";
    if (cur_t() == "Colon") {
        advance_i();
        var ti: i64 = advance_i();
        underlying = tk_v(ti);
    }
    var post: i64 = parse_annotations();
    var all: i64 = list_concat(anns, post);

    expect_tok("LBrace");
    var vh: i64 = -1;
    var vt: i64 = -1;
    while (cur_t() != "RBrace" && cur_t() != "Eof") {
        if (cur_t() == "At" || cur_t() != "Identifier") {
            advance_i();
            continue;
        }
        var vname: string = expect_tok("Identifier");
        var val: i64 = -1;
        if (cur_t() == "Assign") {
            advance_i();
            val = parse_expr();
        }
        var vanns: i64 = parse_annotations();
        if (cur_t() == "Comma") {
            advance_i();
        }
        var vid: i64 = mk_V(vname, val, vanns, -1);
        vt = list_push(vh, vt, vid);
        if (vh < 0) {
            vh = vt;
        }
    }
    expect_tok("RBrace");

    var id: i64 = mk_EnumDecl(name, underlying, all, vh, -1);
    return id;
}

// ── flag 语义 helper（供 GEN:parser_rules 生成的 parse_flag_decl/parse_slot 调用）──
// 可选捕获缺省值：s 为空（可选组未命中）时返回 d
fn str_or(s: string, d: string) string {
    if (s == "") {
        return d;
    }
    return s;
}

// 从槽位注解里提取 @offset(n) 的 n；无则 -1
fn flag_offset_of(sanns: i64) i64 {
    var oa: i64 = ann_find(sanns, "offset");
    if (oa >= 0) {
        var arg: i64 = ann_first_arg(oa);
        if (arg >= 0) {
            var argn: Node = nodes[arg];
            if (argn.kind == "number") {
                return parse_int_str(argn.sa);
            }
        }
    }
    return -1;
}

// 槽位是否带合法 @offset(n)
fn flag_has_offset(sanns: i64) bool {
    var oa: i64 = ann_find(sanns, "offset");
    if (oa >= 0) {
        var arg: i64 = ann_first_arg(oa);
        if (arg >= 0) {
            var argn: Node = nodes[arg];
            if (argn.kind == "number") {
                return true;
            }
        }
    }
    return false;
}

// ── struct 语义 helper（供 GEN:parser_rules 生成的 parse_struct_decl/parse_sfield 调用）──
// 在两个注解列表（前置 anns / 后置 anns）里查 @bitpack，避免为检测而重复 list_concat
fn bp_arg2(a: i64, b: i64) i64 {
    var x: i64 = ann_find(a, "bitpack");
    if (x < 0) {
        x = ann_find(b, "bitpack");
    }
    if (x < 0) {
        return -2;  // 无 @bitpack（-1 留给"有 @bitpack 但无参数"）
    }
    var arg: i64 = ann_first_arg(x);
    return arg;  // >=0 参数节点；-1 无参数
}

// 是否带 @bitpack
fn bp_is2(a: i64, b: i64) bool {
    if (ann_find(a, "bitpack") >= 0) {
        return true;
    }
    return ann_find(b, "bitpack") >= 0;
}

// @bitpack(T) 的 T 名；无则 ""
fn bp_type2(a: i64, b: i64) string {
    var arg: i64 = bp_arg2(a, b);
    if (arg >= 0) {
        var argn: Node = nodes[arg];
        if (argn.kind == "ident") {
            return argn.sa;
        }
    }
    return "";
}

// 是否带合法 @bitpack(T)
fn bp_has_type2(a: i64, b: i64) bool {
    var arg: i64 = bp_arg2(a, b);
    if (arg >= 0) {
        var argn: Node = nodes[arg];
        if (argn.kind == "ident") {
            return true;
        }
    }
    return false;
}

// 成员二分形态选型：@Integer 命中（bitpack 位宽成员）→ mk_scalar("void", -1)；否则用 @type 结果
fn sfield_na(bits: string, tn: i64) i64 {
    if (bits != "") {
        return mk_scalar("void", -1);
    }
    return tn;
}

// 位宽成员的 ia；非位宽成员 -1
fn sfield_ia(bits: string) i64 {
    if (bits == "") {
        return -1;
    }
    return parse_int_str(bits);
}

// parse_union_decl / parse_umember 已由 GEN:parser_rules 区间生成（见下方标记区）

// Variant：带标签的聚合类型（tagged union）。
//   Name variant {
//       CaseA(T);     // 携带载荷
//       CaseB;        // 单元 case（无载荷）
//   }
// 编译为 struct { uint32_t _tag; union { T _u0; ... } _u; }，并为每个 case 生成
// 自由函数：`Name_from_Case(...)` 构造、`Name_is_Case(self)` 判别、`Name_as_Case(self)` 取载荷。
// parse_variant_decl / parse_case 已由 GEN:parser 区间生成（见下方标记区）

// ParamPattern（L-15 / match.md §1、§7.2）：函数声明与函数子句共用同一
// FuncDecl 产生式，参数位统一泛化为 ParamPattern——
//   Ident ":" Type Guard?   普通参数（与 decl_func.md 的 name:type 等价）
//   Ident Guard?            裸绑定（类型由子句组内其它子句 / 字面量推定）
//   "_" Guard?              通配占位，不绑定变量
//   Literal Guard?          字面量相等模式
// 模式信息落在 P 节点的空闲字段：ba=通配、nb=字面量模式、nc=when 守卫。

// 闭包字面量（M46）：表达式位置的 `fn (params) Ret { body }`。
// 与声明靠「前面有无名字」区分（声明在 parse_declaration 先吃名字）；此处裸 `fn` 即 lambda。
fn parse_lambda_expr() i64 {
    var ti0: i64 = advance_i();    // 吃掉 'fn'，返回其 token 下标（诊断锚点）
    expect_tok("LParen");
    var ph: i64 = -1;
    var pt: i64 = -1;
    while (cur_t() != "RParen" && cur_t() != "Eof") {
        var pname: string = expect_tok("Identifier");
        expect_tok("Colon");
        var ptn: i64 = parse_type();
        var pid: i64 = mk_P(pname, ptn, -1, -1);
        pt = list_push(ph, pt, pid);
        if (ph < 0) { ph = pt; }
        if (cur_t() == "Comma") { advance_i(); } else { break; }
    }
    expect_tok("RParen");
    var rt: i64 = parse_type();
    var body: i64 = -2;
    if (cur_t() == "LBrace") {
        body = parse_block();
    } else {
        parse_fatal("expected '{' after lambda signature");
    }
    // 合成名在解析期就定下来，提升阶段直接复用。
    var lname: string = sb_cat2("__lam_", i2s(g_lam_counter));
    g_lam_counter = g_lam_counter + 1;
    var id: i64 = mk_lambda(lname, rt, -1, ph, body, ti0);
    return id;
}

// `|v: T, w: U| expr` 闭包简写 → 与 fn 闭包等价的节点，只是返回类型留作「待推断」。
// 形如 Rust 的 `|x| x*2` / `|x: i32| x*2`；主体只接受单个表达式（会被包成
// `{ return <expr>; }`）。返回类型在 sema 阶段按主体里的 return 表达式推断
// （见 infer_lambda_ret_from_decl），故调用方无需标注。
fn parse_bar_lambda() i64 {
    var ti0: i64 = advance_i();    // 吃掉起始 '|'
    var with_paren: bool = cur_t() == "LParen";
    if (with_paren) { advance_i(); }
    var ph: i64 = -1;
    var pt: i64 = -1;
    while (cur_t() != "BitOr" && cur_t() != "RParen" && cur_t() != "Eof") {
        var pname: string = expect_tok("Identifier");
        var ptn: i64 = -1;
        if (cur_t() == "Colon") {
            advance_i();                // 吃掉 ':'
            ptn = parse_type();
        } else {
            // 省略类型 `|v|` → 参数类型占位为 Infer；检查期若无上下文回填则触发 T-SEM-E214
            ptn = mk_infer_ret();
        }
        var pid: i64 = mk_P(pname, ptn, -1, -1);
        pt = list_push(ph, pt, pid);
        if (ph < 0) { ph = pt; }
        if (cur_t() == "Comma") { advance_i(); } else { break; }
    }
    if (with_paren) { expect_tok("RParen"); }
    if (cur_t() != "BitOr") {
        parse_fatal("expected '|' to close lambda parameters");
    }
    advance_i();                    // 吃掉结束 '|'
    // 主体：单个表达式（停在下一个管道算子，使 `(xs) |> |v| f(v)` 的 `|>` 不被吞掉）
    var body_expr: i64 = parse_in();
    // 包成 `{ return <expr>; }`
    var rstmt: i64 = mk_return(body_expr, -1);
    var blk: i64 = -1;
    var blkt: i64 = -1;
    blkt = list_push(blk, blkt, rstmt);
    if (blk < 0) { blk = blkt; }
    var lname: string = sb_cat2("__lam_", i2s(g_lam_counter));
    g_lam_counter = g_lam_counter + 1;
    var rt: i64 = mk_infer_ret();
    var id: i64 = mk_lambda(lname, rt, -1, ph, blk, ti0);
    return id;
}

// ── 闭包捕获分析（M48 / FuncType v2 Stage B2）──────────────────
// 提升 lambda 之前先算「自由变量 ∩ 外层函数可见变量」= 捕获集：
//   * 绑定名栈 cap_bnd 按词法作用域压/弹（回退长度即出栈）
//   * 自由名 cap_free 去重收集，保持首次出现顺序（决定 env 字段顺序）
// 绑定集宁可**多收**不可少收：多收 → 少捕获 → 后续 T_UNDEFINED_IDENT 响亮报错；
// 少收 → 多捕获 → 环境字段遮蔽同名局部，属静默错编。
var cap_bnd: []string;
var cap_bnd_n: i64;
var cap_free: []string;
var cap_free_n: i64;

fn cap_push(nm: string) void {
    if (cap_bnd_n < (slice_len(cap_bnd) as i64)) {
        slice_set(cap_bnd, cap_bnd_n, nm);
    } else {
        append(cap_bnd, nm);
    }
    cap_bnd_n = cap_bnd_n + 1;
}

fn cap_bound(nm: string) bool {
    var i: i64 = 0;
    while (i < cap_bnd_n) {
        if (cap_bnd[i] == nm) { return true; }
        i = i + 1;
    }
    return false;
}

fn cap_free_add(nm: string) void {
    var i: i64 = 0;
    while (i < cap_free_n) {
        if (cap_free[i] == nm) { return; }
        i = i + 1;
    }
    if (cap_free_n < (slice_len(cap_free) as i64)) {
        slice_set(cap_free, cap_free_n, nm);
    } else {
        append(cap_free, nm);
    }
    cap_free_n = cap_free_n + 1;
}

// 语句链里直接引入的绑定名（**不**下钻嵌套 lambda 体：那是独立作用域）
fn cap_bind_stmts(head: i64) void {
    var c: i64 = head;
    while (c >= 0) {
        var k: Child = kids[c];
        var s: Node = nodes[k.val];
        if (s.kind == "var_decl") { cap_push(s.sa); }
        if (s.kind == "closure_capture") { cap_push(s.sa); }
        if (s.kind == "for") {
            if (s.na >= 0) {
                var fi: Node = nodes[s.na];
                if (fi.kind == "var_decl") { cap_push(fi.sa); }
            }
            cap_bind_stmts(s.la);
        }
        if (s.kind == "for_each") {
            cap_push(s.sa);
            if (str_len(s.sb) > 0) { cap_push(s.sb); }
            cap_bind_stmts(s.la);
        }
        if (s.kind == "if") {
            cap_bind_stmts(s.la);
            if (s.lb > -2) { cap_bind_stmts(s.lb); }
        }
        if (s.kind == "while" || s.kind == "block" || s.kind == "defer") {
            cap_bind_stmts(s.la);
        }
        if (s.kind == "comptime_block") { cap_bind_stmts(s.la); }
        c = k.next;
    }
}

fn cap_scan_list(head: i64) void {
    var c: i64 = head;
    while (c >= 0) {
        var k: Child = kids[c];
        cap_scan(k.val);
        c = k.next;
    }
}

// 通用槽位遍历：Node 的子节点固定落在 na/nb/nc/nd + la/lb/lc，
// 故无需逐 kind 枚举。类型节点里不会出现 ident 节点，顺带遍历无副作用；
// 直接调用的被调名存在 call.na 的 ident 上，会被当自由名收集——这正是
// 「局部变量持有函数值再调用」需要捕获的情形，全局函数名则自然落空。
fn cap_scan(e: i64) void {
    if (e < 0) { return; }
    var n: Node = nodes[e];
    if (n.kind == "ident") {
        if (cap_bound(n.sa) == false) { cap_free_add(n.sa); }
        return;
    }
    if (n.kind == "lambda") {
        // 嵌套 lambda 自成作用域，但其未绑定的自由名对本层依然自由
        var sv: i64 = cap_bnd_n;
        var p: i64 = n.lb;
        while (p >= 0) {
            var pk: Child = kids[p];
            var pn: Node = nodes[pk.val];
            cap_push(pn.sa);
            p = pk.next;
        }
        cap_bind_stmts(n.lc);
        cap_scan_list(n.lc);
        cap_bnd_n = sv;
        return;
    }
    if (n.kind == "arm") {
        // match 分支绑定名只在该分支的守卫 / 体内可见
        var sv2: i64 = cap_bnd_n;
        if (str_len(n.sa) > 0) { cap_push(n.sa); }
        cap_scan(n.na);
        cap_scan(n.nb);
        cap_scan(n.nc);
        cap_bnd_n = sv2;
        return;
    }
    cap_scan(n.na);
    cap_scan(n.nb);
    cap_scan(n.nc);
    cap_scan(n.nd);
    cap_scan_list(n.la);
    cap_scan_list(n.lb);
    cap_scan_list(n.lc);
}

// 外层函数可见变量表：名字 → 类型节点（-1 = 无显式类型，不可捕获）
var envm_n: []string;
var envm_t: []i64;
var envm_c: i64;

fn envm_add(nm: string, tn: i64) void {
    var i: i64 = 0;
    while (i < envm_c) {
        if (envm_n[i] == nm) { return; }
        i = i + 1;
    }
    if (envm_c < (slice_len(envm_n) as i64)) {
        slice_set(envm_n, envm_c, nm);
        slice_set(envm_t, envm_c, tn);
    } else {
        append(envm_n, nm);
        append(envm_t, tn);
    }
    envm_c = envm_c + 1;
}

fn envm_find(nm: string) i64 {
    var i: i64 = 0;
    while (i < envm_c) {
        if (envm_n[i] == nm) { return i; }
        i = i + 1;
    }
    return -1;
}

fn envm_stmts(head: i64) void {
    var c: i64 = head;
    while (c >= 0) {
        var k: Child = kids[c];
        var s: Node = nodes[k.val];
        if (s.kind == "var_decl") { envm_add(s.sa, s.na); }
        if (s.kind == "closure_capture") { envm_add(s.sa, s.na); }
        if (s.kind == "for") {
            if (s.na >= 0) {
                var fi: Node = nodes[s.na];
                if (fi.kind == "var_decl") { envm_add(fi.sa, fi.na); }
            }
            envm_stmts(s.la);
        }
        if (s.kind == "for_each") {
            envm_add(s.sa, -1);
            if (str_len(s.sb) > 0) { envm_add(s.sb, -1); }
            envm_stmts(s.la);
        }
        if (s.kind == "if") {
            envm_stmts(s.la);
            if (s.lb > -2) { envm_stmts(s.lb); }
        }
        if (s.kind == "while" || s.kind == "block" || s.kind == "defer") {
            envm_stmts(s.la);
        }
        if (s.kind == "comptime_block") { envm_stmts(s.la); }
        c = k.next;
    }
}

// 本层直属 lambda 收集（命中即停，嵌套的留给提升后的合成函数那一轮处理）
var lam_hit: []i64;
var lam_hit_n: i64;

fn lam_hit_add(id: i64) void {
    if (lam_hit_n < (slice_len(lam_hit) as i64)) {
        slice_set(lam_hit, lam_hit_n, id);
    } else {
        append(lam_hit, id);
    }
    lam_hit_n = lam_hit_n + 1;
}

fn lam_find_list(head: i64) void {
    var c: i64 = head;
    while (c >= 0) {
        var k: Child = kids[c];
        lam_find(k.val);
        c = k.next;
    }
}

fn lam_find(e: i64) void {
    if (e < 0) { return; }
    var n: Node = nodes[e];
    if (n.kind == "lambda") {
        lam_hit_add(e);
        return;
    }
    lam_find(n.na);
    lam_find(n.nb);
    lam_find(n.nc);
    lam_find(n.nd);
    lam_find_list(n.la);
    lam_find_list(n.lb);
    lam_find_list(n.lc);
}

var g_env_counter: i64;

// 单个 lambda 提升。envm_* 须由调用方按外层作用域填好。
//   无捕获 → 节点就地降级为 ident（完全复用 FuncType v1 的具名函数取值路径）
//   有捕获 → 合成 `__env_N` 结构 + 体首插 closure_capture 语句 + 节点改写为 closure_make
fn lift_one_lambda(lid: i64) void {
    var ln: Node = nodes[lid];
    if (ln.kind != "lambda") { return; }

    cap_bnd_n = 0;
    cap_free_n = 0;
    var p0: i64 = ln.lb;
    while (p0 >= 0) {
        var pk0: Child = kids[p0];
        var pn0: Node = nodes[pk0.val];
        cap_push(pn0.sa);
        p0 = pk0.next;
    }
    cap_bind_stmts(ln.lc);
    cap_scan_list(ln.lc);

    var cn: []string;
    var ct: []i64;
    var fi2: i64 = 0;
    while (fi2 < cap_free_n) {
        var nm: string = cap_free[fi2];
        var ei: i64 = envm_find(nm);
        if (ei >= 0) {
            if (envm_t[ei] < 0) {
                fc_err("T-CLO-E780",
                    sb_cat3("无法捕获外层绑定 `", nm,
                        "`：它没有显式类型标注（如 for-each 迭代变量），环境结构无法为其定型。请先赋给带类型标注的局部变量再捕获"), lid);
            } else {
                append(cn, nm);
                append(ct, envm_t[ei]);
            }
        }
        fi2 = fi2 + 1;
    }
    var ncap: i64 = slice_len(cn) as i64;

    var fd: i64 = mk_FuncDecl(ln.sa, false, false, ln.na, -1, ln.lb, ln.lc, -1);
    var fdn: Node = nodes[fd];
    fdn.sc = "__lambda__";   // 检查期据此把未解析标识符判为「捕获失败」
    fdn.ln = ln.ln;
    fdn.cl = ln.cl;
    fdn.tv = ln.tv;

    if (ncap == 0) {
        slice_set(nodes, fd, fdn);
        append(decl_list, fd);
        var ln3: Node = nodes[lid];
        ln3.kind = "ident";      // sa 已是合成函数名
        ln3.na = -1;
        ln3.la = -1;
        ln3.lb = -1;
        ln3.lc = -1;
        slice_set(nodes, lid, ln3);
        return;
    }

    var ename: string = sb_cat2("__env_", i2s(g_env_counter));
    g_env_counter = g_env_counter + 1;

    var fh: i64 = -1;
    var ft: i64 = -1;
    var ch: i64 = -1;
    var cht: i64 = -1;
    var ah: i64 = -1;
    var at: i64 = -1;
    var ci: i64 = 0;
    while (ci < ncap) {
        var fnode: i64 = mk_F(cn[ci], -1, ct[ci], -1, -1);
        var fnn: Node = nodes[fnode];
        fnn.ln = ln.ln;
        fnn.cl = ln.cl;
        fnn.tv = ln.tv;
        slice_set(nodes, fnode, fnn);
        ft = list_push(fh, ft, fnode);
        if (fh < 0) { fh = ft; }

        var ccn: i64 = mk_closure_capture(cn[ci], ct[ci], ci, -1);
        var ccnn: Node = nodes[ccn];
        ccnn.sb = ename;
        ccnn.ln = ln.ln;
        ccnn.cl = ln.cl;
        ccnn.tv = ln.tv;
        slice_set(nodes, ccn, ccnn);
        cht = list_push(ch, cht, ccn);
        if (ch < 0) { ch = cht; }

        var idn: i64 = mk_ident(cn[ci], -1);
        var idnn: Node = nodes[idn];
        idnn.ln = ln.ln;
        idnn.cl = ln.cl;
        idnn.tv = ln.tv;
        slice_set(nodes, idn, idnn);
        at = list_push(ah, at, idn);
        if (ah < 0) { ah = at; }

        ci = ci + 1;
    }

    var sd: i64 = mk_StructDecl(ename, "default", "", false, false, -1, fh, -1);
    var sdn: Node = nodes[sd];
    sdn.ln = ln.ln;
    sdn.cl = ln.cl;
    sdn.tv = ln.tv;
    slice_set(nodes, sd, sdn);
    append(decl_list, sd);

    fdn.sb = ename;                          // 发射期据此前置 env 首参
    fdn.lc = list_concat(ch, ln.lc);         // 体首重建捕获变量
    slice_set(nodes, fd, fdn);
    append(decl_list, fd);

    var ln2: Node = nodes[lid];
    ln2.kind = "closure_make";               // sa 仍是合成函数名
    ln2.sb = ename;
    ln2.na = -1;
    ln2.la = ah;                             // 捕获实参（外层作用域求值）
    ln2.lb = -1;
    ln2.lc = -1;
    slice_set(nodes, lid, ln2);
}

// 匿名函数字面量提升（M46 起；M48 起支持按值捕获）。
// 遍历 decl_list（长度每轮重取：提升会追加合成 decl），对每个函数体先建外层
// 变量表再提升其直属 lambda。嵌套 lambda 由「提升后的合成函数」那一轮自然处理，
// 此时外层的 closure_capture 已在体首，作用域信息完整。
fn desugar_lambdas() void {
    var i: i64 = 0;
    while (i < (slice_len(decl_list) as i64)) {
        var d: i64 = decl_list[i];
        var dn: Node = nodes[d];
        if (dn.kind == "FuncDecl") {
            if (dn.lc > -2) {
                envm_c = 0;
                var p: i64 = dn.lb;
                while (p >= 0) {
                    var pk: Child = kids[p];
                    var pn: Node = nodes[pk.val];
                    envm_add(pn.sa, pn.na);
                    p = pk.next;
                }
                envm_stmts(dn.lc);
                lam_hit_n = 0;
                lam_find_list(dn.lc);
                var li: i64 = 0;
                while (li < lam_hit_n) {
                    lift_one_lambda(lam_hit[li]);
                    li = li + 1;
                }
            }
        }
        // 全局初始化器里的字面量：无外层局部，捕获集必空
        if (dn.kind == "GlobalVarDecl" || dn.kind == "GlobalConstDecl") {
            if (dn.nb >= 0) {
                envm_c = 0;
                lam_hit_n = 0;
                lam_find(dn.nb);
                var lj: i64 = 0;
                while (lj < lam_hit_n) {
                    lift_one_lambda(lam_hit[lj]);
                    lj = lj + 1;
                }
            }
        }
        i = i + 1;
    }
}

fn parse_func_decl(name: string, anns: i64, is_comptime: bool) i64 {
    expect_tok("LParen");
    var ph: i64 = -1;
    var pt: i64 = -1;
    while (cur_t() != "RParen" && cur_t() != "Eof") {
        var pname: string = "";
        var ptn: i64 = -1;
        var pwild: bool = false;
        var plit: i64 = -1;
        var pcomp: bool = false;
        var ppos: i64 = pos;              // 形参名 token 下标（供 C 关键字撞名告警定位）
        if (cur_t() == "KwComptime") {
            // comptime 类型模板参数：`comptime T: any` —— T 在编译期承载「任意类型」，
            // 调用点按实参类型单态化；P.bb = true 标记其为编译期类型参数。
            warn_comptime_alias();
            advance_i();
            pname = expect_tok("Identifier");
            expect_tok("Colon");
            ptn = parse_type();
            pcomp = true;
        } else if (cur_t() == "Identifier" && cur_v() == "_") {
            advance_i();
            pwild = true;
            pname = "_";                  // 保持与既有 `_: T` 形参写法一致
            if (cur_t() == "Colon") {     // `_ : T` —— 通配但显式标注类型
                advance_i();
                ptn = parse_type();
            }
        } else {
            if (cur_t() == "Identifier" && peek_t(1) == "Colon") {
                pname = expect_tok("Identifier");
                expect_tok("Colon");
                ptn = parse_type();
            } else {
                if (cur_t() == "Identifier") {
                    pname = expect_tok("Identifier");
                } else {
                    plit = parse_expr();
                }
            }
        }
        var pguard: i64 = -1;
        if (cur_t() == "KwWhen") {
            advance_i();
            pguard = parse_expr();
        }
        var panns: i64 = parse_annotations();
        if (pname != "" && pname != "_") { validate_c_keyword(pname, ppos); }
        var pid: i64 = mk_P(pname, ptn, panns, -1);
        if (pwild || plit >= 0 || pguard >= 0 || pcomp) {
            var pn: Node = nodes[pid];
            pn.ba = pwild;
            pn.nb = plit;
            pn.nc = pguard;
            if (pcomp) { pn.bb = true; }
            slice_set(nodes, pid, pn);
        }
        pt = list_push(ph, pt, pid);
        if (ph < 0) {
            ph = pt;
        }
        if (cur_t() == "Comma") {
            advance_i();
        } else {
            break;
        }
    }
    expect_tok("RParen");
    var rt: i64 = parse_type();
    var post: i64 = parse_annotations();
    var all: i64 = list_concat(anns, post);

    var body: i64 = -2;
    var is_extern: bool = false;
    if (cur_t() == "Semicolon") {
        advance_i();
        is_extern = true;
    } else {
        if (cur_t() == "LBrace") {
            body = parse_block();
        } else {
            parse_fatal("expected '{' or ';' after function signature");
        }
    }

    var id: i64 = mk_FuncDecl(name, is_extern, is_comptime, rt, all, ph, body, -1);
    return id;
}

// ═════════════════════════════════════════════════════════════
// 智能体一等公民（Style B / docs/agent_first.md）：
//   Counter agent {
//     state count: i64
//     step fn(s: CounterState, msg: atom) CounterState { ... }
//   }
// 脱糖为（仅编译器前端，后端零改动）：
//   CounterState struct { count: i64 }        // 纯数据
//   Counter_step  fn(...) { ... }             // 自由函数，函数体逐字保留
//   Counter_spawn(count: i64) CounterState // 合成构造器
// 设计铁律：state 是纯数据 struct；step/tools 是顶层自由 fn，绝不挂进 struct。
// 解析期直接合成三个真实声明节点并 append 到 decl_list（struct 在前，
// 保证 register 阶段先见 struct），不引入新的 AST 死节点。
// ═════════════════════════════════════════════════════════════
// ── agent 脱糖辅助 ───────────────────────────────────────────────
// PascalCase → snake_case：agent 生成的普通函数名须遵循「普通函数 = 小蛇形」命名规范
// （原 <Name>_step / <Name>_spawn 以大写开头，被 validate_decl_name 误判为类型并告警 T_NAME_TYPE_CAMEL）。
fn pascal_to_snake(s: string) string {
    var sb: StringBuilder = sb_new();
    var i: u64 = 0;
    var n: u64 = str_len(s);
    while (i < n) {
        var c: u8 = s[i];
        if (c >= 65 && c <= 90) {
            if (i > 0) { sb_append_char(sb, 95); }   // '_'
            sb_append_char(sb, c + 32);              // 转小写
        } else {
            sb_append_char(sb, c);
        }
        i = i + 1;
    }
    return sb_to_str(sb);
}

// 深拷贝一个类型节点。脱糖合成 spawn 形参时，必须与源 struct 字段的类型节点分属两份，
// 否则 check 期对同一节点原地改写（类型解析回填）会触发越界切片（index_out_of_bounds panic）。
fn clone_type_node(n: i64) i64 {
    if (n < 0) { return -1; }
    var nd: Node = nodes[n];
    var k: string = nd.kind;
    if (k == "named") {
        // 深拷贝须带上模块限定前缀 sb（`A.T` 的 A），否则克隆体丢失命名空间，
        // mangle_modules 认不出来 → 退化成未知类型（agent state 字段曾因此变 i64）。
        var cid: i64 = mk_named(nd.sa, -1);
        if (nd.sb != "") {
            var cn: Node = nodes[cid];
            cn.sb = nd.sb;
            slice_set(nodes, cid, cn);
        }
        return cid;
    }
    if (k == "scalar") { return mk_scalar(nd.sa, -1); }
    if (k == "array") { return mk_array(clone_type_node(nd.na), nd.nb, -1); }
    if (k == "slice") { return mk_slice(clone_type_node(nd.na), -1); }
    if (k == "optional") { return mk_optional(clone_type_node(nd.na), -1); }
    if (k == "pointer") { return mk_pointer(clone_type_node(nd.na), -1); }
    if (k == "map") { return mk_map(clone_type_node(nd.na), clone_type_node(nd.nb), -1); }
    if (k == "func_type") { return mk_func_type(clone_type_node(nd.na), clone_type_list(nd.la), -1); }
    if (k == "flag") { return mk_flag(nd.sa, -1); }
    if (k == "flag_set") { return mk_flag_set(-1); }
    if (k == "sym") { return mk_sym(nd.sa, nd.ia, -1); }
    if (k == "variant") { return mk_variant(-1); }
    return n;   // 兜底：未知类型节点原样复用（风险自负）
}

// 深拷贝一个类型节点链表（func_type 的参数类型列表）。
fn clone_type_list(l: i64) i64 {
    var head: i64 = -1;
    var tail: i64 = -1;
    var c: i64 = l;
    while (c >= 0) {
        var v: i64 = clone_type_node(kids[c].val);
        tail = list_push(head, tail, v);
        if (head < 0) { head = tail; }
        c = kids[c].next;
    }
    return head;
}

fn parse_agent_decl(name: string, anns: i64) i64 {
    advance_i(); // consume KwAgent
    expect_tok("LBrace");
    var field_head: i64 = -1;
    var field_tail: i64 = -1;
    var step_fn: i64 = -1;
    while (cur_t() != "RBrace" && cur_t() != "Eof") {
        if (cur_t() == "Semicolon") { advance_i(); continue; }
        if (cur_t() != "Identifier") {
            parse_fatal(sb_cat3("expected 'state' or 'step' clause in agent '", name, "'"));
        }
        var kwi: i64 = advance_i();
        var kw: string = tk_v(kwi);
        if (kw == "state") {
            // 一个或多个 `name: Type[ @tag][ = default];` 字段行
            while (cur_t() == "Identifier" && peek_t(1) == "Colon") {
                var fid: i64 = parse_sfield();
                field_tail = list_push(field_head, field_tail, fid);
                if (field_head < 0) { field_head = field_tail; }
            }
        } else if (kw == "step") {
            if (step_fn >= 0) {
                parse_fatal(sb_cat3("agent '", name, "' has multiple 'step' clauses"));
            }
            // 当前 token 应为 fn（parse_func_decl 自吞）；函数名走 snake_case 命名规范
            advance_i();
            step_fn = parse_func_decl(sb_cat2(pascal_to_snake(name), "_step"), anns, false);
        } else {
            parse_fatal(sb_cat5("unknown agent clause '", kw, "' in agent '", name, "'"));
        }
    }
    expect_tok("RBrace");
    if (step_fn < 0) {
        parse_fatal(sb_cat3("agent '", name, "' is missing a 'step' clause"));
    }
    if (field_head < 0) {
        parse_fatal(sb_cat3("agent '", name, "' has no 'state' fields"));
    }

    var state_name: string = sb_cat2(name, "State");

    // 1) state struct：复用字段节点（含 @tag / =default），完全继承
    var sdecl: i64 = mk_StructDecl(state_name, "default", "", false, false, anns, field_head, g_agent_anchor);

    // 2) spawn 构造器：一参一字段（按声明顺序），body = return State{ f: f, ... }
    var spawn_name: string = sb_cat2(pascal_to_snake(name), "_spawn");
    var ph: i64 = -1;
    var pt: i64 = -1;
    var fv_head: i64 = -1;
    var fv_tail: i64 = -1;
    var c: i64 = field_head;
    while (c >= 0) {
        var f: i64 = kids[c].val;
        var fld: Node = nodes[f];
        var pname: string = fld.sa;
        // 形参（类型节点深拷贝，避免与 struct 字段共享同一份被 check 期改写而越界）
        var pid: i64 = mk_P(pname, clone_type_node(fld.na), -1, -1);
        pt = list_push(ph, pt, pid);
        if (ph < 0) { ph = pt; }
        // struct 字面量字段：field = 同名形参
        var vid: i64 = mk_FV(pname, mk_ident(pname, -1), -1);
        fv_tail = list_push(fv_head, fv_tail, vid);
        if (fv_head < 0) { fv_head = fv_tail; }
        c = kids[c].next;
    }
    var lit: i64 = mk_struct_lit(state_name, fv_head, g_agent_anchor);
    var ret: i64 = mk_return(lit, g_agent_anchor);
    // 合成体必须是「语句链表头」(kids 链表节点)，而非 "block" AST 节点，
    // 否则 desugar_lambdas 会把 block 节点索引当链表头读 kids[] 越界。
    var sbody: i64 = list_push(-1, -1, ret);
    var spawn_td: i64 = mk_named(state_name, -1);
    var spawn_fn: i64 = mk_FuncDecl(spawn_name, false, false, spawn_td, anns, ph, sbody, g_agent_anchor);

    // 锚点：统一挂到 agent 名字 token
    node_at(sdecl, g_agent_anchor);
    node_at(step_fn, g_agent_anchor);
    node_at(spawn_fn, g_agent_anchor);

    // 顺序：struct → step → spawn
    append(decl_list, sdecl);
    append(decl_list, step_fn);
    append(decl_list, spawn_fn);
    return -1; // 已自行 append
}

fn parse_global_var(is_const: bool, is_comptime: bool) i64 {
    advance_i();
    var name: string = expect_tok("Identifier");
    var nti: i64 = pos - 1;
    var tn: i64 = -1;
    if (cur_t() == "Colon") {
        advance_i();
        tn = parse_type();
    }
    var init: i64 = -1;
    if (cur_t() == "Assign") {
        advance_i();
        init = parse_expr();
    }
    expect_tok("Semicolon");
    if (is_const) {
        validate_const_name(name, nti);
    } else {
        validate_var_name(name, nti);
    }

    if (is_const) {
        if (init < 0) {
            init = mk_null(-1);
        }
        var id: i64 = mk_GlobalConstDecl(name, is_comptime, tn, init, -1, nti);
        return id;
    }

    if (tn < 0) {
        tn = mk_scalar("void", -1);
    }
    var id2: i64 = mk_GlobalVarDecl(name, is_comptime, tn, init, -1, nti);
    return id2;
}

// 解析 `::` 之后的导入项列表：`Ident [as Ident]` | `*`，逗号分隔。
// 返回 kids 链表头（-1 = 空）。项内的 `as` 贪婪匹配（先归项别名，模块别名在列表之后）。
fn parse_import_items() i64 {
    var head: i64 = -1;
    var tail: i64 = -1;
    var more: bool = true;
    while (more) {
        var it: i64 = -1;
        if (cur_t() == "Star") {
            var sti: i64 = advance_i();
            it = mk_ImportItem("*", "*", true, sti);
        } else {
            var oti: i64 = pos;
            var orig: string = expect_tok("Identifier");
            var loc: string = orig;
            if (cur_t() == "KwAs") {
                advance_i();
                loc = expect_tok("Identifier");
            }
            it = mk_ImportItem(orig, loc, false, oti);
        }
        tail = list_push(head, tail, it);
        if (head < 0) { head = tail; }
        if (cur_t() == "Comma") { advance_i(); } else { more = false; }
    }
    return head;
}

// 唯一导入语法（docs/reference.md §3.7）：
//   ImportStmt ::= "import" "(" ImportPath ( "::" ImportList )? ( "as" Ident )? ")" ";"
//   ImportPath ::= Ident ( "." Ident )*
// 路径首段为 `src` ⇒ 从本工程源码根导入（剥离该段）；否则一律按库解析：
// 先本工程 lib/、再工程依赖的库。点号即路径分隔符：std.mem => <libdir>/std/mem.tc。
fn parse_import_decl(anns: i64) i64 {
    advance_i();
    if (cur_t() == "LParen") {
        advance_i();
        var pti: i64 = pos;
        var mname: string = expect_tok("Identifier");
        while (cur_t() == "Dot") {
            advance_i();
            mname = sb_cat3(mname, ".", expect_tok("Identifier"));
        }
        var items: i64 = -1;
        if (cur_t() == "DoubleColon") {
            advance_i();
            items = parse_import_items();
        }
        var alias: string = "";
        var has_alias: bool = false;
        if (cur_t() == "KwAs") {
            advance_i();
            alias = expect_tok("Identifier");
            has_alias = true;
        }
        expect_tok("RParen");
        expect_tok("Semicolon");
        // 首段 `src` = 本工程源码根标记；剥离后按源码根解析，其余按库搜索路径解析。
        var is_lib_path: bool = true;
        var rest: string = mname;
        if (first_segment(mname) == "src") {
            is_lib_path = false;
            rest = drop_first_segment(mname);
        }
        var id: i64 = mk_ImportModDecl(rest, alias, has_alias, is_lib_path, anns, pti);
        var idn: Node = nodes[id];
        idn.lb = items;
        slice_set(nodes, id, idn);
        return id;
    }
    // 已移除的旧写法：给出带迁移指引的硬错误（与 `::` 绑定符、`func`→`fn` 的处理一致）。
    if (cur_t() == "At") {
        parse_fatal_at("T-PAR-E102", "`import @x;` was removed; write `import(x);` instead", pos);
    }
    if (cur_t() == "Identifier") {
        parse_fatal_at("T-PAR-E102", "`import x;` was removed; write `import(src.x);` for this project's sources, or `import(x);` for a library", pos);
    }
    // 旧数据导入 `import "path" [as x]`（已由 import_csv/json 函数调用取代，仅保留兼容）
    var path: string = expect_tok("String");
    var pti: i64 = pos - 1;
    var alias: string = "";
    var has_alias: bool = false;
    if (cur_t() == "KwAs") {
        advance_i();
        alias = expect_tok("Identifier");
        has_alias = true;
    }
    expect_tok("Semicolon");

    var id: i64 = mk_ImportDecl(path, alias, false, has_alias, anns, pti);
    return id;
}

// parse_type_alias 已由 GEN:parser 区间生成（见下方标记区）

fn parse_decl_body(name: string, anns: i64, is_comptime: bool) i64 {
    var layout: string = "default";
    if (cur_t() == "Hash") {
        advance_i();
        var li: i64 = advance_i();
        if (tk_t(li) == "Identifier") {
            var lv: string = tk_v(li);
            if (lv == "soa") {
                layout = "soa";
            } else {
                if (lv == "aos") {
                    layout = "aos";
                }
            }
        }
    }

    // >>> GEN:parser_dispatch (generated by tools/totter.tc from out/ebnf.json dispatches -- DO NOT EDIT) >>>
    var t: string = cur_t();
    if (t == "KwStruct") {
        advance_i();   // 消费 `struct` 关键字
        return parse_struct_decl(name, anns, layout);
    }
    if (t == "KwEnum") {
        advance_i();   // 消费 `enum` 关键字（桥接 / 关键字领头文法兼容）
        return parse_enum_decl(name, anns);
    }
    if (t == "KwFlag") {
        return parse_flag_decl(name, anns);
    }
    if (t == "KwUnion") {
        return parse_union_decl(name, anns);
    }
    if (t == "KwVariant") {
        return parse_variant_decl(name, anns);
    }
    if (t == "KwAgent") {
        return parse_agent_decl(name, anns);
    }
    if (t == "KwFunc") {
        // 方言统一（Stage 2）：`name fn(...)` 并置式已废弃，统一为 `fn name(...)`。
        // 转换工具 tools/stage2_convert.mjs 已把整树源码迁到新文法，此处不再兼容旧式。
        // `step fn(...)` 是 agent 子句关键字形式（非普通函数声明），保留旧路径以兼容
        // tests/conformance/fail/f22_clause_body.tc（其 EXPECT: error T_FUNC_CLAUSE_BODY）。
        if (name == "step") {
            advance_i();
            return parse_func_decl(name, anns, is_comptime);
        }
        parse_fatal_at("T-PAR-E102", sb_cat3("function declarations must use the `fn name(...)` form; `", name, " fn(...)` is no longer supported"), pos);
    }
    if (t == "Identifier" && cur_v() == "flag_set") {
        return parse_flag_set_decl(name, anns);
    }
    return parse_type_alias(name, anns);
// <<< GEN:parser_dispatch <<<
}

// ═══════════════════════════════════════════════════════════════
// 测试声明（并置式 / docs/syntax/drafts/decl_test.md）
//
//   "加法应返回两数之和" test {
//       expect(add(2, 3) == 5);
//   }
//
//   "math" suite {
//       "加法" test { ... }
//       "取模" suite { "负数被除" test { ... } }
//   }
//
// 与 `Name struct {}` / `Name fn() Ret {}` 同构：名字在前、种类在后（L-02）。
// 差别只在名字是**字符串字面量**而非标识符，故必须在 parse_declaration 的
// 「声明名必须是 Identifier」硬退出之前拦截。
//
// `test` / `suite` 是**语境关键字**：不进 keywords_tbl，只有紧跟在声明位
// 置的字符串字面量之后才被识别，因此对存量标识符零冲突（先例：flag_set）。
//
// 脱糖到一个普通的布尔函数，sema 主通路与两个后端零改动：
//
//   __test_0 fn() bool { <body> return true; }
//
// 测试身份记在 FuncDecl 自己的空闲槽上，**不合成 `@test` 注解**：
//   bd = true   → 这是一条测试
//   sb          → 显示名（"加法应返回两数之和"）
//   sc          → suite 路径（"math / 嵌套"，顶层为 ""）
// 之所以不挂 `@test`：① `@test` 在 tc 里零消费者（只被注解表校验），挂上去
// 没有任何收益；② `@test` 现已标记为**弃用注解**，合成节点会误触发告警。
// ═══════════════════════════════════════════════════════════════

var g_test_seq: i64 = 0;      // 合成测试函数序号（整个编译单元内唯一）
var g_suite_path: string = "";  // 当前 suite 嵌套路径，形如 "math / 取模"

// 复制一条注解链（浅拷贝 A 节点、共享实参链）。
// suite 上的注解要下沉给每个成员，但 list_concat 会**就地改写**链尾，
// 直接共享同一条链会让第一个成员把自己的注解永久嫁接到 suite 链上。
fn clone_ann_list(head: i64) i64 {
    var nh: i64 = -1;
    var nt: i64 = -1;
    var c: i64 = head;
    while (c >= 0) {
        var a: i64 = kids[c].val;
        var an: Node = nodes[a];
        var cp: i64 = mk_A(an.sa, an.la, -1);
        var cn: Node = nodes[cp];
        cn.ln = an.ln;
        cn.cl = an.cl;
        cn.tv = an.tv;
        slice_set(nodes, cp, cn);
        nt = list_push(nh, nt, cp);
        if (nh < 0) {
            nh = nt;
        }
        c = kids[c].next;
    }
    return nh;
}

// `"名字" test { ... }` → 合成 `__test_<n> fn() bool @test { ... return true; }`
fn parse_test_decl(disp: string, anns: i64, ti: i64) void {
    var post: i64 = parse_annotations();
    var all: i64 = list_concat(anns, post);

    if (cur_t() != "LBrace") {
        parse_fatal("expected '{' after 'test' in test declaration");
    }
    var body: i64 = parse_block();

    // 隐式 `return true;`：测试块以「跑完没炸」为通过，无需显式返回。
    // 显式 `return false;` 或 expect 失败会提前返回，此句即成死代码。
    var rt: i64 = mk_return(mk_bool(true, ti), ti);
    body = list_concat(body, list_push(-1, -1, rt));

    var name: string = sb_cat2("__test_", i2s(g_test_seq));
    g_test_seq = g_test_seq + 1;

    // 返回类型必须走 mk_scalar（`bool` 是标量名）；用 mk_named 会造出一个
    // 同名但不同种类的类型节点，报出 "expected bool but got bool" 的怪错。
    var fd: i64 = mk_FuncDecl(name, false, false, mk_scalar("bool", -1), all, -1, body, ti);
    var fn_n: Node = nodes[fd];
    fn_n.bd = true;             // 是测试
    fn_n.sb = disp;             // 显示名
    fn_n.sc = g_suite_path;     // suite 路径
    slice_set(nodes, fd, fn_n);
    append(decl_list, fd);
}

// `"名字" suite { ... }` → 纯词法分组，自身不产生任何声明。
fn parse_suite_decl(disp: string, anns: i64, ti: i64) void {
    var post: i64 = parse_annotations();
    var all: i64 = list_concat(anns, post);

    if (cur_t() != "LBrace") {
        parse_fatal("expected '{' after 'suite' in suite declaration");
    }
    advance_i();

    var saved: string = g_suite_path;
    if (str_len(saved) > 0) {
        g_suite_path = sb_cat3(saved, " / ", disp);
    } else {
        g_suite_path = disp;
    }

    while (cur_t() != "RBrace" && cur_t() != "Eof") {
        if (cur_t() == "Semicolon") {
            advance_i();
            continue;
        }
        var mann: i64 = parse_annotations();
        // suite 注解逐成员复制下沉（@skip/@tag 因此天然作用于整组）
        mann = list_concat(clone_ann_list(all), mann);
        if (cur_t() != "String") {
            parse_fatal("a suite body may only contain `\"name\" test {}` / `\"name\" suite {}` declarations");
        }
        parse_test_or_suite(mann);
    }
    expect_tok("RBrace");
    g_suite_path = saved;
}

// 声明位置遇到字符串字面量时的入口（调用时 cur_t() == "String"）。
// 自行 append 到 decl_list，故一律返回 -1。
fn parse_test_or_suite(anns: i64) i64 {
    var nti: i64 = advance_i();
    var disp: string = tk_v(nti);
    if (str_len(disp) == 0) {
        parse_fatal("test/suite name must not be an empty string");
    }
    if (cur_t() == "Identifier" && cur_v() == "test") {
        advance_i();
        parse_test_decl(disp, anns, nti);
        return -1;
    }
    if (cur_t() == "Identifier" && cur_v() == "suite") {
        advance_i();
        parse_suite_decl(disp, anns, nti);
        return -1;
    }
    parse_fatal(sb_cat5("expected 'test' or 'suite' after the name string \"", disp, "\", found '", cur_v(), "'"));
    return -1;
}

// ════════════════════════════════════════════════════════════════════════
// `expect` 语句（测试语法现代化的断言内建）
//
// expect 是语境关键字（不进 keywords_tbl），仅在语句位置、紧跟 `(` 时被识别
// （与 flag_set / test / suite 同一思路，零冲突）。它在 parser 期直接脱糖为
// 普通 if/eprint/format 语句，因此：
//   ① 不需要在 builtin_ret 注册 → 不需要 tc0 镜像，difftest 字节级一致不受影响；
//   ② 不需要新增任何 runtime 符号（eprint 接收 string，format 内建的类型分派
//      在 sema 自动完成）；
//   ③ sema 看到的是普通 if 语句，无需改动。
//
//   expect(EXPR);          →  if (!(EXPR)) { eprint(format("expect failed: {} @ {}:{}", "<EXPR源码>", "<file>", "<line>")); return false; }
//   expect(EXPR, "msg");   →  if (!(EXPR)) { eprint(format("expect failed: {} @ {}:{}  ({})", "<EXPR源码>", "<file>", "<line>", "<msg>")); return false; }
//
// 约定：expect 用于测试函数体（返回 bool）。失败即 `return false`，由 `tc test`
// 运行器收集为「该测试失败」并继续后续测试（不会 exit 终止整个运行）。
// ════════════════════════════════════════════════════════════════════════

// token 类型是否为「词」（标识符 / 字面量 / 括号），用于源码文本重建时的空格决策。
fn is_word_tok(t: string) bool {
    if (t == "Identifier") { return true; }
    if (t == "Int" || t == "Float" || t == "String") { return true; }
    if (t == "LParen" || t == "RParen") { return true; }
    if (t == "LBracket" || t == "RBracket") { return true; }
    if (t == "LBrace" || t == "RBrace") { return true; }
    return false;
}

// 从 token 序列重建源码文本（token 无字节偏移，只能从 t/v 反推）。
// 运算符 / 括号紧贴；词与词之间加空格（函数名后接 `(` 视为调用，不加空格）。
fn rebuild_tokens(start: i64, end: i64) string {
    var s: string = "";
    var prev_t: string = "";
    var i: i64 = start;
    while (i < end) {
        var ct: string = tk_t(i);
        var cv: string = tk_v(i);
        if (str_len(s) > 0 && is_word_tok(prev_t) && is_word_tok(ct)) {
            if (!(prev_t == "Identifier" && ct == "LParen")) {
                s = sb_cat2(s, " ");
            }
        }
        s = sb_cat2(s, cv);
        prev_t = ct;
        i = i + 1;
    }
    return s;
}

fn parse_expect_stmt() i64 {
    var ti: i64 = pos;            // 'expect' 关键字的 token 索引（取其行号）
    advance_i();                  // 消费 'expect'
    expect_tok("LParen");         // 消费 '('
    var expr_start: i64 = pos;    // 记录 EXPR 起点 token（紧跟 '(' 之后，不含括号）
    var expr: i64 = parse_expr();
    var expr_end: i64 = pos;      // parse_expr 结束处（下一 token 即 ',' 或 ')'）；源码重建只取 EXPR 本身
    var msg: i64 = -1;
    if (cur_t() == "Comma") {
        advance_i();
        if (cur_t() != "String") {
            parse_fatal("expect message must be a string literal");
        }
        msg = mk_string(cur_v(), pos);
        advance_i();
    }
    expect_tok("RParen");
    if (cur_t() == "Semicolon") {
        advance_i();              // 消费语句结尾的 ';'
    }

    var src_text: string = rebuild_tokens(expr_start, expr_end);

    // format 参数链：tmpl, src_text, file, line [, msg]（全部为 string，零类型分派风险）
    // 模板两端的缩进与换行是**输出契约**：失败详情走 stderr，而 `tc test` 的判定行
    // （ok/FAILED）走 stdout；两股流交错时若详情不自带换行，会把判定词粘到同一行。
    var tmpl: string;
    if (msg >= 0) {
        tmpl = "  expect failed: {} @ {}:{}  ({})\n";
    } else {
        tmpl = "  expect failed: {} @ {}:{}\n";
    }
    var ah: i64 = -1;
    var at: i64 = -1;
    at = list_push(ah, at, mk_string(tmpl, -1)); if (ah < 0) { ah = at; }
    at = list_push(ah, at, mk_string(src_text, -1));
    at = list_push(ah, at, mk_string(g_file, -1));
    at = list_push(ah, at, mk_string(i2s(toks[ti].line), -1));
    if (msg >= 0) {
        at = list_push(ah, at, msg);
    }
    var fmt_call: i64 = mk_call(mk_ident("format", -1), ah, ti);
    var eprint_call: i64 = mk_call(mk_ident("eprint", -1), list_push(-1, -1, fmt_call), ti);

    // then 块：eprint(...); return false;
    // ⚠ eprint_call 必须用 mk_expr 包裹成「表达式语句」，否则 emit_stmt 遇到裸 call
    // 节点会直接 fallthrough（见 codegen_c.tc emit_stmt 末尾「其余未识别节点：不输出」）。
    var th: i64 = -1;
    var tt: i64 = -1;
    tt = list_push(th, tt, mk_expr(eprint_call, ti)); if (th < 0) { th = tt; }
    tt = list_push(th, tt, mk_return(mk_bool(false, ti), ti));

    var cond: i64 = mk_unary("!", expr, ti);
    return mk_if(cond, th, -1, ti);
}

fn parse_declaration() i64 {
    var anns: i64 = parse_annotations();

    // 模块系统（M-Module）：顶层声明可用 `export` 修饰，标记跨模块可见。
    var is_export: bool = false;
    if (cur_t() == "KwExport") {
        advance_i();
        is_export = true;
    }

    // meta/comptime 前缀：置于最前，使其可修饰 var/const/fn/struct/...（Phase A：meta 别名 KwComptime）
    var is_comptime: bool = false;
    if (cur_t() == "KwComptime") {
        warn_comptime_alias();
        advance_i();
        is_comptime = true;
    }

    if (cur_t() == "KwVar") {
        var d: i64 = parse_global_var(false, is_comptime);
        if (is_export) { nodes[d].bc = true; }
        return d;
    }
    if (cur_t() == "KwConst") {
        var d: i64 = parse_global_var(true, is_comptime);
        append(g_const_decl_ids, d);
        if (is_export) { nodes[d].bc = true; }
        return d;
    }
    if (cur_t() == "KwLet") {
        // 全局 `let`：动态常量，复用 GlobalConstDecl（语义等同；is_let 区分留待 CTFE Phase B）
        var d: i64 = parse_global_var(true, is_comptime);
        if (is_export) { nodes[d].bc = true; }
        return d;
    }
    if (cur_t() == "KwImport") {
        if (is_export) {
            // export 不能修饰 import 声明
            var id: i64 = parse_import_decl(anns);
            nodes[id].bc = true;
            return id;
        }
        return parse_import_decl(anns);
    }

    // 测试声明的名字是字符串字面量（`"加法" test {}` / `"math" suite {}`），
    // 必须抢在下面「声明名必须是 Identifier」的硬退出之前拦截。
    if (cur_t() == "String") {
        return parse_test_or_suite(anns);
    }

    // LL(1) 具名函数文法（兼容桥接）：`fn name(params) ret { body }`。
    // 旧 `name fn(...)` 并置式仍保留兼容（下方名字先行路径），二者由首个 token 消歧、不冲突。
    if (cur_t() == "KwFunc") {
        advance_i();   // 吃掉 `fn`
        if (cur_t() != "Identifier") {
            parse_fatal("expected function name after 'fn' in function declaration");
        }
        var fni: i64 = advance_i();
        var fname: string = tk_v(fni);
        g_agent_anchor = fni;
        g_struct_exported = is_export;
        validate_decl_name(fname, fni);
        var fd: i64 = parse_func_decl(fname, anns, is_comptime);
        if (fd >= 0) {
            node_at(fd, fni);
            if (is_export) { nodes[fd].bc = true; }
        }
        return fd;
    }

    // ── LL(1) 关键字领头桥接：`enum Name {...}` / `struct Name {...}`（兼容 df5 文法）──
    // 与上方 `fn Name` 桥同构：消费关键字 → 读名字 → 复用 name-first 实现。
    // 注意：parse_enum_decl/parse_struct_decl 内部已不再自行 advance_i() 关键字，
    // 故此处必须显式消费 `enum`/`struct`。
    if (cur_t() == "KwEnum") {
        advance_i();   // 吃掉 `enum`
        if (cur_t() != "Identifier") {
            parse_fatal("expected enum name after 'enum' in enum declaration");
        }
        var eni: i64 = advance_i();
        var ename: string = tk_v(eni);
        g_agent_anchor = eni;
        g_struct_exported = is_export;
        validate_decl_name(ename, eni);
        var ed: i64 = parse_enum_decl(ename, anns);
        if (ed >= 0) {
            node_at(ed, eni);
            if (is_export) { nodes[ed].bc = true; }
        }
        return ed;
    }
    if (cur_t() == "KwStruct") {
        advance_i();   // 吃掉 `struct`
        // layout 注解 #soa/#aos：name-first 文法在 parse_decl_body 检测；
        // 关键字领头文法里它出现在 struct 之后、名字之前，此处等价检测。
        var layout: string = "default";
        if (cur_t() == "Hash") {
            advance_i();
            var li: i64 = advance_i();
            if (tk_t(li) == "Identifier") {
                var lv: string = tk_v(li);
                if (lv == "soa") { layout = "soa"; }
                else if (lv == "aos") { layout = "aos"; }
            }
        }
        if (cur_t() != "Identifier") {
            parse_fatal("expected struct name after 'struct' in struct declaration");
        }
        var sni: i64 = advance_i();
        var sname: string = tk_v(sni);
        g_agent_anchor = sni;
        g_struct_exported = is_export;
        validate_decl_name(sname, sni);
        var sd: i64 = parse_struct_decl(sname, anns, layout);
        if (sd >= 0) {
            node_at(sd, sni);
            if (is_export) { nodes[sd].bc = true; }
        }
        return sd;
    }

    if (cur_t() != "Identifier") {
        parse_fatal(sb_cat2("expected declaration name but found ", cur_v()));
    }
    var ni: i64 = advance_i();
    var name: string = tk_v(ni);
    g_agent_anchor = ni;
    g_struct_exported = is_export;
    validate_decl_name(name, ni);

    // 声明形态为 `Name fn(...)` / `Name struct {...}`，绑定符 `::` 已移除。
    // 遇到旧写法给出带名字的迁移指引，而非笼统的语法错误。
    if (cur_t() == "DoubleColon") {
        parse_fatal_at("T-PAR-E102", sb_cat5("the '::' binder was removed; write `", name, " fn(...)` / `", name, " struct {...}` instead"), pos);
    }
    // `func` 已更名为 `fn`：否则会落进 type-alias 分支报出无关的 "expected Semicolon"。
    if (cur_t() == "Identifier" && cur_v() == "func") {
        parse_fatal_at("T-PAR-E102", sb_cat3("keyword 'func' was renamed to 'fn'; write `", name, " fn(...)` instead"), pos);
    }

    var d: i64 = parse_decl_body(name, anns, is_comptime);
    if (d >= 0) {
        node_at(d, ni);
        if (is_export) { nodes[d].bc = true; }
    }
    return d;
}

fn parse_unit() void {
    while (cur_t() != "Eof") {
        if (cur_t() == "Semicolon") {
            advance_i();
            continue;
        }
        var d: i64 = parse_declaration();
        if (d >= 0) {
            append(decl_list, d);
        }
        // struct 体内方法脱糖出的顶层自由函数：紧跟宿主 struct 之后入列，
        // 保证 register 阶段先见 struct 再见方法。非 struct 声明时为空操作。
        flush_struct_methods();
    }
    // 注意：子句合并（desugar_func_clauses）与 lambda 提升（desugar_lambdas）
    // 现在改在 run_check 里、模块内联（resolve_modules）完成之后统一跑一遍，
    // 以便覆盖「入口 + 所有被 import 的模块」合并后的整张 decl_list。
}

// ═══════════════════════════════════════════════════════════════
// 函数子句语法糖脱糖（L-15 / docs/syntax/drafts/match.md §7 用户裁定）
//
// 多条同名 FuncDecl 构成「子句组」。子句**不是重复声明**——它属于词法/语法
// 子层的书写便利，编译期在 AST lowering 阶段被强制展开为**单一** FuncDecl，
// 其体为 `return match (__p0) { ... };`。`match` 因此是唯一语义真源（L-04）。
//
//   classify fn(0) string { "zero" }
//   classify fn(n when n > 0) string { "positive" }
//   classify fn(_) string { "non-positive" }
// ⇓
//   classify fn(__p0: i64) string {
//       return match (__p0) { 0 => "zero"  n when n > 0 => "positive"  _ => "non-positive" };
//   }
//
// 组内首个子句在 decl_list 中被就地替换为合并后的 FuncDecl；其余子句节点
// kind 改写为 "ClauseDead" 且清空注解链，从而对 register / check / 双后端
// 发射的所有 `kind == "FuncDecl"` 分派不可见（不新增死代码路径）。
// ═══════════════════════════════════════════════════════════════

var g_fc_d: [64]i64;      // 组内各子句的 FuncDecl 节点
var g_fc_i: [64]i64;      // 各子句在 decl_list 中的下标
var g_fc_n: i64 = 0;

// 子句诊断（脱糖发生在 parse 之后、check 之前，g_file 此时已就绪）
fn fc_err(code: string, msg: string, d: i64) void {
    var l: i64 = n_line(d);
    var c: i64 = n_col(d);
    diag_new(code, "error", msg, n_file(d), l, c, l, c + 4);
}

// 类型节点的结构指纹（脱糖期尚无 scope，故不走 resolve_ti）
fn fc_type_key(t: i64) string {
    if (t < 0) { return "<none>"; }
    var tn: Node = nodes[t];
    return sb_cat4(tn.kind, ":", tn.sa, sb_cat2("/", tn.sb));
}

// P 节点是否为「模式参数」（即非 `name: type` / `_: type` 普通参数）。
// 注意：带类型标注的 `_ : T` 只是「不使用的普通形参」，不触发脱糖；
// 裸 `_`（无类型）走 na < 0 分支，仍算模式。
fn pp_is_pattern(p: i64) bool {
    var pn: Node = nodes[p];
    if (pn.nb >= 0) { return true; }
    if (pn.nc >= 0) { return true; }
    if (pn.na < 0) { return true; }
    return false;
}

fn fc_list_nth(h: i64, idx: i64) i64 {
    var n: i64 = 0;
    var c: i64 = h;
    while (c >= 0) {
        var k: Child = kids[c];
        if (n == idx) { return k.val; }
        n = n + 1;
        c = k.next;
    }
    return -1;
}

// 子句体须为单一表达式（match arm 体即表达式）。接受 `{ expr }` 与
// `{ return expr; }` 两种写法，取出其表达式；不满足返回 -1。
fn fc_body_expr(d: i64) i64 {
    var dn: Node = nodes[d];
    if (dn.lc < 0) { return -1; }
    var k: Child = kids[dn.lc];
    if (k.next >= 0) { return -1; }
    var sn: Node = nodes[k.val];
    if (sn.kind == "return") { return sn.na; }
    if (sn.kind == "expr") { return sn.na; }
    return -1;
}

// 由第 idx 个参数位推定类型节点：优先取任一子句的显式 `name: type` 标注，
// 否则由该位首个字面量模式推定；均无则返回 -1（报 T_FUNC_CLAUSE_NO_TYPE）。
fn fc_param_type(idx: i64) i64 {
    var i: i64 = 0;
    while (i < g_fc_n) {
        var pn: Node = nodes[g_fc_d[i]];
        var p: i64 = fc_list_nth(pn.lb, idx);
        if (p >= 0) {
            var ppn: Node = nodes[p];
            if (ppn.na >= 0) { return ppn.na; }
        }
        i = i + 1;
    }
    var j: i64 = 0;
    while (j < g_fc_n) {
        var pn2: Node = nodes[g_fc_d[j]];
        var p2: i64 = fc_list_nth(pn2.lb, idx);
        if (p2 >= 0) {
            var ppn2: Node = nodes[p2];
            if (ppn2.nb >= 0) {
                var ln: Node = nodes[ppn2.nb];
                if (ln.kind == "int") { return mk_scalar("i64", -1); }
                if (ln.kind == "float") { return mk_scalar("f64", -1); }
                if (ln.kind == "string") { return mk_scalar("string", -1); }
                if (ln.kind == "bool") { return mk_scalar("bool", -1); }
            }
        }
        j = j + 1;
    }
    return -1;
}

// 第 idx(>0) 参数位的形参名：该位若有裸绑定，全部子句须用同一名字
// （形参直接以该名命名，子句体无需改写）；否则用 __pN。
fn fc_param_name(idx: i64, gd: i64) string {
    var nm: string = "";
    var i: i64 = 0;
    while (i < g_fc_n) {
        var pn: Node = nodes[g_fc_d[i]];
        var p: i64 = fc_list_nth(pn.lb, idx);
        if (p >= 0) {
            var ppn: Node = nodes[p];
            if (ppn.ba == false && ppn.nb < 0 && str_len(ppn.sa) > 0) {
                if (str_len(nm) == 0) {
                    nm = ppn.sa;
                } else {
                    if (nm != ppn.sa) {
                        fc_err("T-FUN-E810",
                            sb_cat4("function clause group '", nodes[gd].sa,
                                "': parameter #", sb_cat3(i2s(idx), " binds different names ('",
                                sb_cat4(nm, "' vs '", ppn.sa, "'); only parameter #0 may vary"))),
                            g_fc_d[i]);
                        return nm;
                    }
                }
            }
        }
        i = i + 1;
    }
    if (str_len(nm) == 0) { return sb_cat2("__p", i2s(idx)); }
    return nm;
}

// 把第 idx(>0) 参数位的模式折叠进 arm 守卫：字面量 → `pname == lit`。
fn fc_fold_guard(cond: i64, d: i64, arity: i64, pnames_head: i64) i64 {
    var r: i64 = cond;
    var dn: Node = nodes[d];
    var idx: i64 = 1;
    while (idx < arity) {
        var p: i64 = fc_list_nth(dn.lb, idx);
        if (p >= 0) {
            var ppn: Node = nodes[p];
            var extra: i64 = -1;
            if (ppn.nb >= 0) {
                extra = mk_binary("==", mk_ident(nodes[fc_list_nth(pnames_head, idx)].sa, -1), ppn.nb, -1);
            }
            if (extra >= 0) {
                if (r < 0) { r = extra; } else { r = mk_binary("&&", r, extra, -1); }
            }
            if (ppn.nc >= 0) {
                if (r < 0) { r = ppn.nc; } else { r = mk_binary("&&", r, ppn.nc, -1); }
            }
        }
        idx = idx + 1;
    }
    return r;
}

// 把当前 g_fc_* 中的子句组合并为单一 FuncDecl，就地写回 decl_list
fn fc_merge() void {
    var gd: i64 = g_fc_d[0];
    var g0: Node = nodes[gd];
    var arity: i64 = list_count(g0.lb);

    // 组内所有子句先行下线：kind 改写后对 register / check / 双后端发射的
    // 全部 `kind == "FuncDecl"` 分派不可见。无论合并成功与否都执行，确保同一
    // 组只被诊断一次（失败时首位仍指向已下线节点，畸形声明不会流入 check）。
    var z: i64 = 0;
    while (z < g_fc_n) {
        var dz: Node = nodes[g_fc_d[z]];
        dz.kind = "ClauseDead";
        dz.la = -1;
        slice_set(nodes, g_fc_d[z], dz);
        z = z + 1;
    }

    // 元数一致性
    var i: i64 = 1;
    while (i < g_fc_n) {
        if (list_count(nodes[g_fc_d[i]].lb) != arity) {
            fc_err("T-FUN-E811",
                sb_cat3("function clause group '", g0.sa, "': all clauses must have the same arity"),
                g_fc_d[i]);
            return;
        }
        i = i + 1;
    }
    if (arity < 1) {
        fc_err("T-FUN-E811",
            sb_cat3("function clause group '", g0.sa, "': pattern clauses require at least one parameter"),
            gd);
        return;
    }

    // 形参：名字 + 类型
    var ph: i64 = -1;
    var pt: i64 = -1;
    var idx: i64 = 0;
    while (idx < arity) {
        var ptn: i64 = fc_param_type(idx);
        if (ptn < 0) {
            fc_err("T-FUN-E812",
                sb_cat4("function clause group '", g0.sa, "': cannot infer type of parameter #",
                    sb_cat2(i2s(idx), "; annotate it as 'name: Type' in one clause")),
                gd);
            return;
        }
        var pnm: string = "";
        if (idx == 0) {
            pnm = "__p0";
        } else {
            pnm = fc_param_name(idx, gd);
        }
        pt = list_push(ph, pt, mk_P(pnm, ptn, -1, -1));
        if (ph < 0) { ph = pt; }
        idx = idx + 1;
    }

    // 返回类型一致性（以首子句为准）
    var k: i64 = 1;
    while (k < g_fc_n) {
        if (fc_type_key(nodes[g_fc_d[k]].na) != fc_type_key(g0.na)) {
            fc_err("T-FUN-E813",
                sb_cat3("function clause group '", g0.sa, "': all clauses must declare the same return type"),
                g_fc_d[k]);
            return;
        }
        k = k + 1;
    }

    // 逐子句 → match arm
    var ah: i64 = -1;
    var at: i64 = -1;
    var c: i64 = 0;
    while (c < g_fc_n) {
        var cd: i64 = g_fc_d[c];
        var cn: Node = nodes[cd];
        var be: i64 = fc_body_expr(cd);
        if (be < 0) {
            fc_err("T-FUN-E814",
                sb_cat3("function clause group '", g0.sa,
                    "': clause body must be a single expression (it becomes a match arm)"),
                cd);
            return;
        }
        var p0: i64 = fc_list_nth(cn.lb, 0);
        var p0n: Node = nodes[p0];
        var a_bind: string = "";
        var a_wild: bool = p0n.ba;
        var a_pat: i64 = p0n.nb;
        if (a_wild == false && a_pat < 0) { a_bind = p0n.sa; }
        var a_guard: i64 = p0n.nc;
        a_guard = fc_fold_guard(a_guard, cd, arity, ph);
        // arm 承接本子句的锚点：诊断（不可达 / 类型不符）指回原始子句而非合成节点
        var armid: i64 = mk_arm(a_bind, a_wild, a_pat, a_guard, be, -1);
        var armn: Node = nodes[armid];
        armn.ln = cn.ln;
        armn.cl = cn.cl;
        armn.tv = cn.tv;
        slice_set(nodes, armid, armn);
        at = list_push(ah, at, armid);
        if (ah < 0) { ah = at; }
        c = c + 1;
    }

    // 合成 match 承接首子句锚点：T_MATCH_NONEXHAUSTIVE 才能报出文件与行列
    var scr: i64 = mk_ident("__p0", -1);
    var scrn: Node = nodes[scr];
    scrn.ln = g0.ln;
    scrn.cl = g0.cl;
    scrn.tv = g0.tv;
    slice_set(nodes, scr, scrn);
    var mx: i64 = mk_match(scr, ah, -1);
    var mxn: Node = nodes[mx];
    mxn.ln = g0.ln;
    mxn.cl = g0.cl;
    mxn.tv = g0.tv;
    slice_set(nodes, mx, mxn);
    var body: i64 = list_push(-1, -1, mk_return(mx, -1));
    var merged: i64 = mk_FuncDecl(g0.sa, false, g0.bb, g0.na, g0.la, ph, body, -1);
    var mn: Node = nodes[merged];
    mn.ln = g0.ln;
    mn.cl = g0.cl;
    mn.tv = g0.tv;
    slice_set(nodes, merged, mn);
    slice_set(decl_list, g_fc_i[0], merged);
}

fn desugar_func_clauses() void {
    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = decl_list[i];
        var dn: Node = nodes[d];
        if (dn.kind == "FuncDecl" && dn.ba == false) {
            g_fc_n = 0;
            g_fc_d[0] = d;
            g_fc_i[0] = i;
            g_fc_n = 1;
            var j: i64 = i + 1;
            while (j < n) {
                var d2: i64 = decl_list[j];
                var dn2: Node = nodes[d2];
                if (dn2.kind == "FuncDecl" && dn2.ba == false && dn2.sa == dn.sa) {
                    if (g_fc_n < 64) {
                        g_fc_d[g_fc_n] = d2;
                        g_fc_i[g_fc_n] = j;
                        g_fc_n = g_fc_n + 1;
                    }
                }
                j = j + 1;
            }
            // 组内多于一条 → 必为子句组；单条但含模式参数 → 亦按子句组脱糖
            // （便于 match 的穷尽性检查统一兜底，无需第二套诊断）
            var need: bool = g_fc_n > 1;
            if (need == false) {
                var pc: i64 = dn.lb;
                while (pc >= 0) {
                    var pk: Child = kids[pc];
                    if (pp_is_pattern(pk.val)) { need = true; }
                    pc = pk.next;
                }
            }
            if (need) {
                fc_merge();
            }
        }
        i = i + 1;
    }
}


// ── f-string 字面量（M-fstr）────────────────────────────────────
//
// 语法：`f"文本{expr!conv:spec}文本"`，多行形态 `f"""..."""`。
//
// 实现策略：**解析期整体重写**为 `format("文本{0!conv:spec}文本", expr)`。
// 不新建 AST 节点种类、不碰 sema/codegen 的表达式分发 —— 复用 M55 已有的
// 模板脱糖（提升成 `__fmt_N` 函数、StringBuilder 顺序拼接）。收益有三：
//   ① 插值实参在调用点求值**一次**（`f"{next()}{'x'}"` 不会重复求值）
//   ② 格式规范 `:spec` / 转换字段 `!conv` 与 `format()` 完全同源，只有一套文法
//   ③ 运行期零模板引擎，与「静态优先」的语言宪法一致
//
// 词法层已把整段 `f"..."` 连同原始转义整体收进一个 FormatString token
// （见 lex.tc：插值内的字符串/嵌套花括号在扫描期被跳过），故这里拿到的是
// **未解码**的原始文本，字面段的转义要在本函数内自行解码。

// 转换字段合法字符：s / r / a / j / c / p
fn fstr_is_conv(c: i64) bool {
    return c == 115 || c == 114 || c == 97 || c == 106 || c == 99 || c == 112;
}

// 跳过一段引号字面量；i0 指向首个 `"`。isf=true 表示这是 f-string 的引号体，
// 需要在插值 `{}` 内继续跳过其中嵌套的（f-）字符串。返回闭合引号之后的位置。
// 递归深度 = f-string 嵌套层数，实际写法里最多一两层。
fn fstr_skip_quoted(raw: string, i0: u64, e: u64, isf: bool) u64 {
    var i: u64 = i0;
    var isLong: bool = false;
    if (i + 2 < e) {
        if ((raw[i + 1] as i64) == 34 && (raw[i + 2] as i64) == 34) { isLong = true; }
    }
    if (isLong) { i = i + 3; } else { i = i + 1; }
    var depth: i64 = 0;
    while (i < e) {
        var c: i64 = raw[i] as i64;
        if (c == 92) { i = i + 2; continue; }
        if (depth == 0 && c == 34) {
            if (isLong == false) { return i + 1; }
            if (i + 2 < e && (raw[i + 1] as i64) == 34 && (raw[i + 2] as i64) == 34) { return i + 3; }
            i = i + 1;
            continue;
        }
        if (isf) {
            if (c == 123) {
                if (depth == 0 && i + 1 < e && (raw[i + 1] as i64) == 123) { i = i + 2; continue; }
                depth = depth + 1;
                i = i + 1;
                continue;
            }
            if (c == 125) {
                if (depth == 0) {
                    if (i + 1 < e && (raw[i + 1] as i64) == 125) { i = i + 2; continue; }
                    i = i + 1;
                    continue;
                }
                depth = depth - 1;
                i = i + 1;
                continue;
            }
            if (depth > 0 && c == 34) {
                i = fstr_skip_quoted(raw, i, e, false);
                continue;
            }
            if (depth > 0 && c == 102 && i + 1 < e && (raw[i + 1] as i64) == 34) {
                i = fstr_skip_quoted(raw, i + 1, e, true);
                continue;
            }
        }
        i = i + 1;
    }
    return i;
}

// 插值体里的某个 `:` 是不是「格式规范起点」？
// 只有紧邻在**完整表达式收尾**（标识符/数字/`)`/`]`/`}`/`"`）之后才算；
// 否则它是原子字面量 `:name` 的前缀（`f"{c == :red}"`），不能当 spec 分隔符。
fn fstr_prev_ends_expr(s: string, k: u64) bool {
    var j: u64 = k;
    while (j > 0) {
        var c: i64 = s[j - 1] as i64;
        if (c == 32 || c == 9) { j = j - 1; continue; }
        if (c == 41 || c == 93 || c == 125 || c == 34 || c == 95) { return true; }
        if (c >= 48 && c <= 57) { return true; }
        if (c >= 65 && c <= 90) { return true; }
        if (c >= 97 && c <= 122) { return true; }
        if (c >= 128) { return true; }
        return false;
    }
    return false;
}

// 把插值里的表达式源码文本就地词法 + 语法分析成一个表达式节点。
// token 追加到全局 toks **尾部**，外层 token 下标不受影响（append-only），
// 解析完恢复 pos。合成 token 的行列统一改写成 f-string 字面量所在位置，
// 否则诊断会指向「第 1 行第 1 列」。
fn fstr_parse_expr(text: string, ti: i64) i64 {
    var save_pos: i64 = pos;
    var base: i64 = slice_len(toks) as i64;
    tokenize(text);
    var atk: Tok = toks[ti];
    var m: i64 = slice_len(toks) as i64;
    var z: i64 = base;
    while (z < m) {
        var tz: Tok = toks[z];
        tz.line = atk.line;
        tz.col = atk.col;
        slice_set(toks, z, tz);
        z = z + 1;
    }
    pos = base;
    if (cur_t() == "Eof") {
        parse_fatal("empty interpolation `{}` in f-string");
    }
    var ex: i64 = parse_expr();
    if (cur_t() != "Eof") {
        parse_fatal(sb_cat2("trailing tokens in f-string interpolation: ", cur_v()));
    }
    pos = save_pos;
    return ex;
}

fn parse_fstring(ti: i64) i64 {
    var raw: string = tk_v(ti);
    var rn: u64 = str_len(raw);
    var isLong: bool = false;
    if (rn >= 6) {
        if ((raw[1] as i64) == 34 && (raw[2] as i64) == 34 && (raw[3] as i64) == 34) { isLong = true; }
    }
    var s0: u64 = 2;          // 跳过 `f"`
    var e0: u64 = rn - 1;     // 不含闭合 `"`
    if (isLong) { s0 = 4; e0 = rn - 3; }

    var tb: StringBuilder = sb_new();   // 合成的 format 模板
    var a_head: i64 = -1;
    var a_tail: i64 = -1;
    var argi: i64 = 0;
    var i: u64 = s0;

    while (i < e0) {
        var c: i64 = raw[i] as i64;

        // 转义：走与词法**同一份** `esc_decode`（base.tc）。两处各写一份正是
        // 旧实现「f-string 能产出 `\uXXXX`、词法却读不回来」的 round-trip 断裂源。
        // 解出来若是花括号，要在模板层加倍（模板还会再解一次）。
        if (c == 92) {
            var eb: StringBuilder = sb_new();
            var ni: u64 = esc_decode(raw, i + 1, eb, tk_line(ti) as i64, tk_col(ti) as i64);
            var es: string = sb_to_str(eb);
            var eL: u64 = str_len(es);
            var ek: u64 = 0;
            while (ek < eL) {
                var ech: i64 = es[ek] as i64;
                sb_append_char(tb, ech);
                if (ech == 123 || ech == 125) { sb_append_char(tb, ech); }
                ek = ek + 1;
            }
            i = ni;
            continue;
        }

        if (c == 125) {                       // `}}` 照抄给模板层解，孤立 `}` 是笔误
            if (i + 1 < e0 && (raw[i + 1] as i64) == 125) {
                sb_append_char(tb, 125);
                sb_append_char(tb, 125);
                i = i + 2;
                continue;
            }
            parse_fatal("unmatched `}` in f-string; write `}}` for a literal right brace");
        }

        if (c != 123) {
            sb_append_char(tb, c);
            i = i + 1;
            continue;
        }

        if (i + 1 < e0 && (raw[i + 1] as i64) == 123) {   // `{{`
            sb_append_char(tb, 123);
            sb_append_char(tb, 123);
            i = i + 2;
            continue;
        }

        // ── 插值单元 ───────────────────────────────────────
        // ① 先找配对的 `}`（跳过嵌套 (){}[] 与其中的字符串）
        i = i + 1;
        var ds: u64 = i;
        var depth: i64 = 0;
        var close: u64 = e0;
        var found: bool = false;
        while (i < e0) {
            var ic: i64 = raw[i] as i64;
            if (ic == 34) { i = fstr_skip_quoted(raw, i, e0, false); continue; }
            if (ic == 102 && i + 1 < e0 && (raw[i + 1] as i64) == 34) {
                i = fstr_skip_quoted(raw, i + 1, e0, true);
                continue;
            }
            if (ic == 40 || ic == 91 || ic == 123) { depth = depth + 1; i = i + 1; continue; }
            if (ic == 41 || ic == 93) { depth = depth - 1; i = i + 1; continue; }
            if (ic == 125) {
                if (depth == 0) { close = i; found = true; break; }
                depth = depth - 1;
                i = i + 1;
                continue;
            }
            i = i + 1;
        }
        if (found == false) {
            parse_fatal("unclosed `{` in f-string interpolation");
        }
        var body: string = str_slice(raw, ds, close);
        i = close + 1;

        // ② 在插值体内定位 spec 分隔冒号（跳过三目 `?:`、原子 `:name`、嵌套层）
        var bl: u64 = str_len(body);
        var d2: i64 = 0;
        var q2: i64 = 0;
        var specPos: i64 = -1;
        var k: u64 = 0;
        while (k < bl) {
            var bc: i64 = body[k] as i64;
            if (bc == 34) { k = fstr_skip_quoted(body, k, bl, false); continue; }
            if (bc == 102 && k + 1 < bl && (body[k + 1] as i64) == 34) {
                k = fstr_skip_quoted(body, k + 1, bl, true);
                continue;
            }
            if (bc == 40 || bc == 91 || bc == 123) { d2 = d2 + 1; k = k + 1; continue; }
            if (bc == 41 || bc == 93 || bc == 125) { d2 = d2 - 1; k = k + 1; continue; }
            if (d2 == 0 && bc == 63) { q2 = q2 + 1; k = k + 1; continue; }
            if (d2 == 0 && bc == 58) {
                if (k + 1 < bl && (body[k + 1] as i64) == 58) { k = k + 2; continue; }
                if (q2 > 0) { q2 = q2 - 1; k = k + 1; continue; }
                if (fstr_prev_ends_expr(body, k)) { specPos = k as i64; break; }
                k = k + 1;
                continue;
            }
            k = k + 1;
        }
        var exprEnd: u64 = bl;
        var spec: string = "";
        if (specPos >= 0) {
            exprEnd = specPos as u64;
            spec = str_slice(body, (specPos as u64) + 1, bl);
        }

        // ③ 转换字段：只可能紧贴在表达式末尾（`{x!r}` / `{x!r:>8}`），
        //    故不会与 `!=`、前缀 `!` 混淆。
        var convc: i64 = 0;
        if (exprEnd >= 2) {
            var cm1: i64 = body[exprEnd - 2] as i64;
            var cm2: i64 = body[exprEnd - 1] as i64;
            // `!` 前必须是一个「已完结的表达式」，否则那是前缀取反（如 `{!ok}`）
            if (cm1 == 33 && fstr_prev_ends_expr(body, exprEnd - 2)) {
                if (fstr_is_conv(cm2) == false) {
                    parse_fatal("f-string 转换字段只能是 `!s`/`!r`/`!a`/`!j`/`!c`/`!p`");
                }
                convc = cm2;
                exprEnd = exprEnd - 2;
            }
        }

        var enode: i64 = fstr_parse_expr(str_slice(body, 0, exprEnd), ti);
        a_tail = list_push(a_head, a_tail, enode);
        if (a_head < 0) { a_head = a_tail; }

        // ④ 模板占位：`{N[!conv][:spec]}`（一律手动索引，杜绝自动编号混用）
        sb_append_char(tb, 123);
        sb_append_str(tb, i2s(argi));
        if (convc != 0) {
            sb_append_char(tb, 33);
            sb_append_char(tb, convc);
        }
        if (str_len(spec) > 0) {
            sb_append_char(tb, 58);
            sb_append_str(tb, spec);
        }
        sb_append_char(tb, 125);
        argi = argi + 1;
    }

    var tmpl: string = sb_to_str(tb);

    // 无插值：退化为普通字符串字面量（把 `{{`/`}}` 就地还原），不生成 __fmt_N
    if (argi == 0) {
        var lb: StringBuilder = sb_new();
        var tn2: u64 = str_len(tmpl);
        var z2: u64 = 0;
        while (z2 < tn2) {
            var zc: i64 = tmpl[z2] as i64;
            if (zc == 123 || zc == 125) {
                if (z2 + 1 < tn2 && (tmpl[z2 + 1] as i64) == zc) {
                    sb_append_char(lb, zc);
                    z2 = z2 + 2;
                    continue;
                }
            }
            sb_append_char(lb, zc);
            z2 = z2 + 1;
        }
        return mk_string(sb_to_str(lb), ti);
    }

    var f_head: i64 = -1;
    var f_tail: i64 = -1;
    f_tail = list_push(f_head, f_tail, mk_string(tmpl, ti));
    if (f_head < 0) { f_head = f_tail; }
    var ac: i64 = a_head;
    while (ac >= 0) {
        var ak: Child = kids[ac];
        f_tail = list_push(f_head, f_tail, ak.val);
        if (f_head < 0) { f_head = f_tail; }
        ac = ak.next;
    }
    g_has_format = true;
    return mk_call(mk_ident("format", ti), f_head, ti);
}

// ── ADT：variant 构造器模式（match 模式位）─────────────────────
// `Circle(r)` / `Shape.Circle(r)` / `Node(l, Leaf(x))`。
// ⚠ 手写代码，刻意置于 GEN:parser_rules 区**之外**（见 docs/fstring.md 同类教训）。
// 判据：模式位上「首字母大写 Identifier + `(`」（或限定式 `V.Case(`）。
// 大写是必要条件——否则 `f(x) => ...`（以调用结果做等值匹配）会被误夺。
// 无括号的裸大写名（单元 case `Empty => ...`）仍走既有 arm.sa 通道，
// 由 sema 的 C2 消歧统一改写（enum → member，variant → conpat）。

// 首字母是否大写。parse 在 DAG 上位于 sema 之前，不能引用 sema.starts_upper，故本地实现。
fn tok_starts_upper(s: string) bool {
    if (str_len(s) == 0) { return false; }
    var c0: u8 = s[0];
    return c0 >= 65 && c0 <= 90;
}

fn pat_is_conpat() bool {
    if (cur_t() != "Identifier") { return false; }
    if (tok_starts_upper(cur_v()) == false) { return false; }
    if (peek_t(1) == "LParen") { return true; }
    if (peek_t(1) == "Dot" && peek_t(2) == "Identifier" && peek_t(3) == "LParen") { return true; }
    return false;
}

// 子模式：嵌套构造器 / `_` 通配 / 裸绑定名 / 字面量
fn parse_conpat_sub() i64 {
    if (pat_is_conpat()) { return parse_conpat(); }
    if (cur_t() == "Identifier") {
        var sp_ti: i64 = pos;
        var sp_v: string = cur_v();
        advance_i();
        return mk_ident(sp_v, sp_ti);
    }
    return parse_expr();
}

fn parse_conpat() i64 {
    var cp_ti: i64 = pos;
    var cp_qual: string = "";
    var cp_name: string = expect_tok("Identifier");
    if (cur_t() == "Dot") {
        advance_i();
        cp_qual = cp_name;
        cp_name = expect_tok("Identifier");
    }
    expect_tok("LParen");
    var cp_head: i64 = -1;
    var cp_tail: i64 = -1;
    var cp_n: i64 = 0;
    while (cur_t() != "RParen" && cur_t() != "Eof") {
        var cp_p: i64 = parse_conpat_sub();
        cp_tail = list_push(cp_head, cp_tail, cp_p);
        if (cp_head < 0) { cp_head = cp_tail; }
        cp_n = cp_n + 1;
        if (cur_t() == "Comma") { advance_i(); }
    }
    expect_tok("RParen");
    return mk_conpat(cp_name, cp_qual, cp_head, cp_n, cp_ti);
}

// >>> GEN:parser_rules (generated by tools/totter.tc from out/ebnf.json grammar -- DO NOT EDIT) >>>
fn parse_for_stmt() i64 {
    var ti: i64 = advance_i();
    expect_tok("LParen");
    var is_kv: bool = cur_t() == "Identifier" && peek_t(1) == "Comma" && peek_t(2) == "Identifier" && peek_t(3) == "KwIn";
    if ((cur_t() == "Identifier" && peek_t(1) == "KwIn") || is_kv) {
        var vi: i64 = advance_i();
        var vname: string = tk_v(vi);
        var vname2: string = "";
        if (is_kv) {
            advance_i();
            var vi2: i64 = advance_i();
            vname2 = tk_v(vi2);
        }
        advance_i();
        var iterable: i64 = parse_expr();
        expect_tok("RParen");
        var body: i64 = parse_block();
        var id: i64 = mk_for_each(vname, vname2, iterable, body, ti);
        return id;
    }
    var init: i64 = -1;
    if (cur_t() != "Semicolon") {
        var exp: bool = false;
        if (cur_t() == "KwExport") { advance_i(); exp = true; }
        if (cur_t() == "KwVar") {
            init = parse_local_var(false, exp);
        } else {
        if (cur_t() == "KwConst") {
            var cd: i64 = parse_local_var(true, exp);
            init = cd;
            append(g_const_decl_ids, cd);
        } else {
        if (cur_t() == "KwLet") {
            init = parse_local_let(exp);
        } else {
            var e: i64 = parse_expr();
            expect_tok("Semicolon");
            init = mk_expr(e, -1);
        }}}
    } else {
        advance_i();
    }
    var cond: i64 = -1;
    if (cur_t() != "Semicolon") {
        cond = parse_expr();
    }
    expect_tok("Semicolon");
    var upd: i64 = -1;
    if (cur_t() != "RParen") {
        upd = parse_expr();
    }
    expect_tok("RParen");
    var body2: i64 = parse_block();
    var id2: i64 = mk_for(init, cond, upd, body2, ti);
    return id2;
}

fn parse_if_stmt() i64 {
    var ti: i64 = advance_i();
    expect_tok("LParen");
    var cond: i64 = parse_expr();
    expect_tok("RParen");
    var then_head: i64 = parse_block();
    var else_head: i64 = -2;
    if (cur_t() == "KwElse") {
        advance_i();
        if (cur_t() == "KwIf") {
            var nested: i64 = parse_if_stmt();
            var h: i64 = -1;
            h = list_push(h, -1, nested);
            else_head = h;
        } else {
            else_head = parse_block();
        }
    }
    var id: i64 = mk_if(cond, then_head, else_head, ti);
    return id;
}

fn parse_return_stmt() i64 {
    var ti: i64 = advance_i();
    var val: i64 = -1;
    if (cur_t() != "Semicolon") {
        val = parse_expr();
    }
    expect_tok("Semicolon");
    var id: i64 = mk_return(val, ti);
    return id;
}

fn parse_while_stmt() i64 {
    var ti: i64 = advance_i();
    expect_tok("LParen");
    var cond: i64 = parse_expr();
    expect_tok("RParen");
    var body: i64 = parse_block();
    var id: i64 = mk_while(cond, body, ti);
    return id;
}

fn parse_statement() i64 {
    var t: string = cur_t();
    if (t == "Identifier" && cur_v() == "expect" && peek_t(1) == "LParen") {
        return parse_expect_stmt();
    }
    if (t == "KwIf") {
        return parse_if_stmt();
    }
    if (t == "KwFor") {
        return parse_for_stmt();
    }
    if (t == "KwWhile") {
        return parse_while_stmt();
    }
    if (t == "KwReturn") {
        return parse_return_stmt();
    }
    if (t == "KwBreak") {
        return parse_break_stmt();
    }
    if (t == "KwContinue") {
        return parse_continue_stmt();
    }
    if (t == "KwDefer") {
        return parse_defer_stmt();
    }
    if (t == "KwComptime") {
        warn_comptime_alias();
        return parse_comptime_stmt();
    }
    if (t == "LBrace") {
        return parse_block_stmt();
    }
    if (t == "KwExport") {
        // 模块系统（M-Module）：函数体内 export 只能修饰局部 var/const → T_EXPORT_SCOPE
        advance_i();
        var nt: string = cur_t();
        if (nt == "KwVar") { return parse_local_var(false, true); }
        if (nt == "KwConst") { var cd: i64 = parse_local_var(true, true); append(g_const_decl_ids, cd); return cd; }
        if (nt == "KwLet") { return parse_local_let(true); }
        parse_fatal("export 只能修饰顶层声明或局部 var/const/let");
    }
    if (t == "KwVar") {
        return parse_var_stmt();
    }
    if (t == "KwConst") {
        return parse_const_stmt();
    }
    if (t == "KwLet") {
        return parse_let_stmt();
    }
    if (t == "KwAuto") {
        return parse_auto_stmt();
    }
    return parse_expr_or_assign_stmt();
}

// ── match 表达式（L-15 语法规则法 / docs/syntax/drafts/match.md）──
// 模式（v1 子集）：
//   `_`            → 通配，不绑定变量
//   裸 Ident       → 绑定被匹配值到该名字（不可反驳），可带 `when` 守卫
//   其它表达式     → 与被匹配值做 `==` 等值匹配（整数 / 字符串 / bool / Enum 成员）
// arm 之间的分隔符 `,` 可选（词法层不产生 Newline token，故以 `}` 收尾判定）。
fn parse_match_arm() i64 {
    var am_ti: i64 = pos;
    var am_isw: bool = false;
    var am_bind: string = "";
    var am_pat: i64 = -1;
    if (cur_t() == "Identifier" && cur_v() == "_") {
        advance_i();
        am_isw = true;
    } else {
        var am_nt: string = peek_t(1);
        if (cur_t() == "Identifier" && (am_nt == "FatArrow" || am_nt == "KwWhen")) {
            am_bind = cur_v();
            advance_i();
        } else if (pat_is_conpat()) {
            // ADT：variant 构造器解构模式 `Circle(r)` / `Shape.Rect(w, h)`
            am_pat = parse_conpat();
        } else {
            am_pat = parse_expr();
        }
    }
    var am_guard: i64 = -1;
    if (cur_t() == "KwWhen") {
        advance_i();
        am_guard = parse_expr();
    }
    expect_tok("FatArrow");
    var am_body: i64 = parse_expr();
    if (cur_t() == "Comma") {
        advance_i();
    }
    return mk_arm(am_bind, am_isw, am_pat, am_guard, am_body, am_ti);
}

fn parse_match_expr() i64 {
    var mx_ti: i64 = advance_i();
    expect_tok("LParen");
    var mx_scrut: i64 = parse_expr();
    expect_tok("RParen");
    expect_tok("LBrace");
    var mx_head: i64 = -1;
    var mx_tail: i64 = -1;
    while (cur_t() != "RBrace" && cur_t() != "Eof") {
        var mx_a: i64 = parse_match_arm();
        if (mx_a >= 0) {
            mx_tail = list_push(mx_head, mx_tail, mx_a);
            if (mx_head < 0) {
                mx_head = mx_tail;
            }
        }
    }
    expect_tok("RBrace");
    return mk_match(mx_scrut, mx_head, mx_ti);
}

fn parse_primary() i64 {
    var t: string = cur_t();
    // M-meta Phase D：编译期内建 `@name(...)`。`@` 在**表达式起始位**此前空闲
    // （注解只在声明前 / 类型后，字段 tagID 是 `@ <int>`），故不与既有文法冲突。
    if (t == "At" && peek_t(1) == "Identifier") {
        return parse_meta_builtin();
    }
    // meta / comptime 表达式前缀：编译期求值（CTFE 在后续阶段落地）；
    // Phase A 仅建 AST 节点（comptime），由 emit 阶段降级处理。
    if (t == "KwComptime") {
        warn_comptime_alias();
        var ti_meta: i64 = advance_i();
        var inner: i64 = parse_expr();
        return mk_comptime(inner, ti_meta);
    }
    // Erlang 式原子字面量：`:name` → atom 节点（表达式位置的 `:` 此前未使用）
    if (t == "Colon") {
        var ti_Colon: i64 = advance_i();
        if (cur_t() != "Identifier") {
            parse_fatal("expected atom name after ':'");
            exit(1);
        }
        var ti_Name: i64 = advance_i();
        var id: i64 = node_new("atom");
        var nn: Node = nodes[id];
        nn.sa = tk_v(ti_Name);
        slice_set(nodes, id, nn);
        node_at(id, ti_Name);
        return id;
    }
    if (t == "KwFunc") {
        return parse_lambda_expr();
    }
    // `|v: T, w: U| expr` 闭包简写（Rust 式）：表达式起始位的裸 `|` 即 lambda 起点；
    // 中缀位的 `|` 仍是按位或 BitOr（由 or 级处理），不会走到这里。
    if (t == "BitOr") {
        return parse_bar_lambda();
    }
    if (t == "KwMatch") {
        return parse_match_expr();
    }
    if (t == "Integer") {
        var ti_Integer: i64 = advance_i();
        return parse_prim_int(ti_Integer);
    }
    if (t == "Float") {
        var ti_Float: i64 = advance_i();
        return parse_prim_float(ti_Float);
    }
    if (t == "String") {
        var ti_String: i64 = advance_i();
        return parse_prim_str(ti_String);
    }
    if (t == "FormatString") {
        var ti_Fstr: i64 = advance_i();
        return parse_fstring(ti_Fstr);
    }
    if (t == "KwTrue") {
        var ti_KwTrue: i64 = advance_i();
        return parse_prim_true(ti_KwTrue);
    }
    if (t == "KwFalse") {
        var ti_KwFalse: i64 = advance_i();
        return parse_prim_false(ti_KwFalse);
    }
    if (t == "KwNull") {
        var ti_KwNull: i64 = advance_i();
        return parse_prim_null(ti_KwNull);
    }
    // 类型专用关键字（string/StringBuilder/void/map）本不是 Identifier，
    // 但允许它们作为 comptime 类型模板参数的实参出现在调用位置
    // （如 `id(string, "hi")`）。降为 ident 节点，由 instantiate_generic 解析为类型；
    // 若被误当作值使用，check 期会报「未知标识符」，语义正确。
    if (t == "KwString" || t == "KwStringBuilder" || t == "KwVoid" || t == "KwMap") {
        var ti_Kw: i64 = advance_i();
        return mk_ident(tk_v(ti_Kw), ti_Kw);
    }
    if (t == "Identifier") {
        // 内建文件描述符常量（M51）：stdin/stdout/stderr 在**表达式位置**直接降为
        // fidconst 节点（值 0/1/2），与 atom 同为编译期常量、零运行时查找。
        // 声明位置的同名标识符由 sym_define 的保留名检查拦截（T_FID_RESERVED_NAME）。
        var fcv: i64 = fid_const_of(cur_v());
        if (fcv >= 0) {
            var ti_Fid: i64 = advance_i();
            var fid_id: i64 = node_new("fidconst");
            var fidn: Node = nodes[fid_id];
            fidn.sa = tk_v(ti_Fid);
            fidn.ia = fcv;
            slice_set(nodes, fid_id, fidn);
            node_at(fid_id, ti_Fid);
            return fid_id;
        }
        var ti_Identifier: i64 = advance_i();
        return parse_prim_ident(ti_Identifier);
    }
    if (t == "LParen") {
        var ti_LParen: i64 = advance_i();
        return parse_prim_paren(ti_LParen);
    }
    if (t == "LBracket") {
        var ti_LBracket: i64 = advance_i();
        return parse_prim_array(ti_LBracket);
    }
    parse_fatal(sb_cat2("unexpected token in expression: ", cur_v()));
    return -1;
}

fn parse_postfix() i64 {
    var e: i64 = parse_primary();
    while (cur_t() == "Dot" || cur_t() == "LBracket" || cur_t() == "LParen") {
        var t: string = cur_t();
        var ti: i64 = advance_i();
        if (t == "Dot") { e = parse_post_member(e, ti); }
        if (t == "LBracket") { e = parse_post_index(e, ti); }
        if (t == "LParen") { e = parse_post_call(e, ti); }
    }
    if (cur_t() == "KwAs") {
        var ti2: i64 = advance_i();
        e = parse_post_cast(e, ti2);
    }
    return e;
}

fn parse_unary() i64 {
    var t: string = cur_t();
    if (t == "Not" || t == "Minus" || t == "BitNot") {
        var op: string = "!";
        if (t == "Minus") { op = "-"; }
        if (t == "BitNot") { op = "~"; }
        // 只在 `-` **直接**贴着整数 token 时开窗，`-f(...)` / `-(...)` 都不算，
        // 保证 iN::MIN 的放宽不会漏进任意深的表达式里（reference.md §2.4）。
        if (t == "Minus" && peek_t(1) == "Integer") { g_lit_neg = true; }
        var ti: i64 = advance_i();
        var operand: i64 = parse_unary();
        g_lit_neg = false;
        return mk_un(op, operand, ti);
    }
    if (t == "BitAnd") {
        // 前缀 `&x` = 取址（地址-of）。中缀 `a & b` = 按位与由 parse_bitand 处理，
        // 因 parse_unary 优先消解前缀，二者不冲突（C/Rust 同款消歧）。
        var ti: i64 = advance_i();
        var operand: i64 = parse_unary();
        return mk_amp(operand, ti);
    }
    if (t == "Star") {
        // 前缀 `*r` = 解引用。中缀 `a * b` = 乘法由 parse_mul 处理（同上前缀优先）。
        var ti: i64 = advance_i();
        var operand: i64 = parse_unary();
        return mk_deref(operand, ti);
    }
    return parse_postfix();
}

fn parse_mul() i64 {
    var left: i64 = parse_unary();
    while (cur_t() == "Star" || cur_t() == "Slash" || cur_t() == "Percent") {
        var t: string = cur_t();
        var op: string = "*";
        if (t == "Slash") { op = "/"; }
        if (t == "Percent") { op = "%"; }
        var ti: i64 = advance_i();
        var right: i64 = parse_unary();
        left = mk_bin(op, left, right, ti);
    }
    return left;
}

fn parse_add() i64 {
    var left: i64 = parse_mul();
    while (cur_t() == "Plus" || cur_t() == "Minus") {
        var t: string = cur_t();
        var op: string = "+";
        if (t == "Minus") { op = "-"; }
        var ti: i64 = advance_i();
        var right: i64 = parse_mul();
        left = mk_bin(op, left, right, ti);
    }
    return left;
}

fn parse_shift() i64 {
    var left: i64 = parse_add();
    while (cur_t() == "ShiftLeft" || cur_t() == "ShiftRight") {
        var t: string = cur_t();
        var op: string = "<<";
        if (t == "ShiftRight") { op = ">>"; }
        var ti: i64 = advance_i();
        var right: i64 = parse_add();
        left = mk_bin(op, left, right, ti);
    }
    return left;
}

// 只能出现在**类型位置**、永远不能作表达式起始的 token。
// `string` / `StringBuilder` / `void` / `map` 都是关键字（不是 Identifier），
// parse_primary 见到它们必然报 "unexpected token in expression"，
// 因此在 `>` 之后遇到它们，只可能是反序列化 `fid > Type` 的类型操作数。
fn tok_type_only(t: string) bool {
    if (t == "KwString" || t == "KwStringBuilder") { return true; }
    return t == "KwVoid" || t == "KwMap";
}

fn parse_cmp() i64 {
    var left: i64 = parse_shift();
    while (cur_t() == "Lt" || cur_t() == "Gt" || cur_t() == "LtEq" || cur_t() == "GtEq") {
        var t: string = cur_t();
        var op: string = "<";
        if (t == "Gt") { op = ">"; }
        if (t == "LtEq") { op = "<="; }
        if (t == "GtEq") { op = ">="; }
        var ti: i64 = advance_i();
        // 反序列化 `fid > Type`：右操作数是类型而非值（M52 读路径）。这里只做**词法层**
        // 消解 —— 左操作数是不是 fid 由 check 阶段裁定（parse 期没有类型信息）。
        // i64 / bool / atom / f64 / MyStruct 等本就是 Identifier，走普通表达式路径即可，
        // 由 deser_type_of 在 check 期把 ident 节点重解释为类型。
        var right: i64 = -1;
        if (op == ">" && tok_type_only(cur_t())) {
            right = parse_type();
        } else {
            right = parse_shift();
        }
        left = mk_bin(op, left, right, ti);
    }
    return left;
}

fn parse_eq() i64 {
    var left: i64 = parse_cmp();
    while (cur_t() == "Eq" || cur_t() == "NotEq") {
        var t: string = cur_t();
        var op: string = "==";
        if (t == "NotEq") { op = "!="; }
        var ti: i64 = advance_i();
        var right: i64 = parse_cmp();
        left = mk_bin(op, left, right, ti);
    }
    return left;
}

fn parse_bitand() i64 {
    var left: i64 = parse_eq();
    while (cur_t() == "BitAnd") {
        var t: string = cur_t();
        var op: string = "&";
        var ti: i64 = advance_i();
        var right: i64 = parse_eq();
        left = mk_bin(op, left, right, ti);
    }
    return left;
}

fn parse_bitxor() i64 {
    var left: i64 = parse_bitand();
    while (cur_t() == "BitXor") {
        var t: string = cur_t();
        var op: string = "^";
        var ti: i64 = advance_i();
        var right: i64 = parse_bitand();
        left = mk_bin(op, left, right, ti);
    }
    return left;
}

fn parse_bitor() i64 {
    var left: i64 = parse_bitxor();
    while (cur_t() == "BitOr") {
        var t: string = cur_t();
        var op: string = "|";
        var ti: i64 = advance_i();
        var right: i64 = parse_bitxor();
        left = mk_bin(op, left, right, ti);
    }
    return left;
}

fn parse_and() i64 {
    var left: i64 = parse_bitor();
    while (cur_t() == "And") {
        var t: string = cur_t();
        var op: string = "&&";
        var ti: i64 = advance_i();
        var right: i64 = parse_bitor();
        left = mk_bin(op, left, right, ti);
    }
    return left;
}

fn parse_or() i64 {
    var left: i64 = parse_and();
    while (cur_t() == "Or") {
        var t: string = cur_t();
        var op: string = "||";
        var ti: i64 = advance_i();
        var right: i64 = parse_and();
        left = mk_bin(op, left, right, ti);
    }
    return left;
}

fn parse_sfield() i64 {
    var r_Ident: string = expect_tok("Identifier");
    expect_tok("Colon");
    var r_Integer: string = "";
    var r_type: i64 = -1;
    if (cur_t() == "Integer") {
    r_Integer = expect_tok("Integer");
    }    else if (true) {
    r_type = parse_type();
    } else {
        parse_fatal("unexpected token in alternative");
    }
    var r_anns: i64 = parse_annotations();
    // ── 字段 tagID：`@ Integer`（与 @注解 以「@ 后是否数字」区分；注解循环已跳过 @<int>）──
    var r_tag: i64 = -1;
    if (cur_t() == "At") {
        advance_i();
        r_tag = parse_int_str(expect_tok("Integer"));
    }
    // ── 字段默认值：`= Expr` ──
    var r_def: i64 = -1;
    if (cur_t() == "Assign") {
        advance_i();
        r_def = parse_expr();
    }
    // 收尾注解（如 `@ 1 @derive(...)` 中 tagID 之后的注解；注解循环已因 @<int> 提前退出）
    var r_anns2: i64 = parse_annotations();
    if (r_anns2 >= 0) {
        r_anns = list_concat(r_anns, r_anns2);
    }
    expect_tok("Semicolon");
    var __id: i64 = node_new("F");
    var __n: Node = nodes[__id];
    __n.sa = r_Ident;
    __n.na = sfield_na(r_Integer, r_type);
    __n.ia = sfield_ia(r_Integer);
    __n.la = r_anns;
    __n.ib = r_tag;   // tagID（≥1 显式；-1 = 自动化分配）
    __n.nb = r_def;   // 默认表达式节点（-1 = 无默认值）
    slice_set(nodes, __id, __n);
    return __id;
}

// 把函数体/签名中的 `Self`（类型节点 named 与结构体字面量名 struct_lit）改写为所属 struct 名 sn。
// 递归遍历子节点，仅改写 named{sa:"Self"} 与 struct_lit{sa:"Self"}，其余节点仅递归。
fn desugar_self_node(nid: i64, sn: string) void {
    if (nid < 0) { return; }
    var nd: Node = nodes[nid];
    var k: string = nd.kind;
    if (k == "named" && nd.sa == "Self") {
        nd.sa = sn;
        slice_set(nodes, nid, nd);
        return;
    }
    if (k == "struct_lit" && nd.sa == "Self") {
        nd.sa = sn;
        slice_set(nodes, nid, nd);
    }
    desugar_self_node(nd.na, sn);
    desugar_self_node(nd.nb, sn);
    desugar_self_node(nd.nc, sn);
    desugar_self_node(nd.nd, sn);
    var it: i64 = nd.la;
    while (it >= 0) { var ca: Child = kids[it]; desugar_self_node(ca.val, sn); it = ca.next; }
    it = nd.lb;
    while (it >= 0) { var cb: Child = kids[it]; desugar_self_node(cb.val, sn); it = cb.next; }
    it = nd.lc;
    while (it >= 0) { var cc: Child = kids[it]; desugar_self_node(cc.val, sn); it = cc.next; }
}

// 解析 struct 体内的方法声明，脱糖为顶层自由函数：
//   push fn(self: Self, v: i64) List {...}  →  list_push fn(self: List, v: i64) List {...}
// 当前 token 应为 fn（parse_func_decl 自吞）；方法名 mname 已由调用方读出。
fn parse_method_decl(structname: string, mname: string, anns: i64) i64 {
    // 注：调用方已消费 `fn` 关键字，当前 token 即为 `(`
    var fd: i64 = parse_func_decl(mname, anns, false);
    var fdn: Node = nodes[fd];
    fdn.sa = sb_cat3(pascal_to_snake(structname), "_", mname);
    fdn.bc = g_struct_exported;
    slice_set(nodes, fd, fdn);
    desugar_self_node(nodes[fd].na, structname);
    var pit: i64 = nodes[fd].lb;
    while (pit >= 0) {
        var pc: Child = kids[pit];
        var pnode: Node = nodes[pc.val];
        desugar_self_node(pnode.na, structname);
        slice_set(nodes, pc.val, pnode);
        pit = pc.next;
    }
    // 函数体：FuncDecl.lc 是语句链表头（kids 下标），必须按链表逐条下钻，
    // 不可当作节点 id 直接传（否则读到随机 Child，函数体内的 `Self` 全漏改写）。
    var bit: i64 = nodes[fd].lc;
    while (bit >= 0) {
        var bch: Child = kids[bit];
        desugar_self_node(bch.val, structname);
        bit = bch.next;
    }
    return fd;
}

// 把当前 struct 累积的方法 FuncDecl 链表追加进 decl_list（保证 struct 在前、方法在后）。
fn flush_struct_methods() void {
    var it: i64 = g_method_head;
    while (it >= 0) {
        var c: Child = kids[it];
        append(decl_list, c.val);
        it = c.next;
    }
    g_method_head = -1;
    g_method_tail = -1;
}

fn parse_struct_decl(name: string, anns: i64, layout: string) i64 {
    // 关键字 `struct` 已由调用方消费（dispatch 或 `struct Name` 桥）；layout 亦由调用方处理。
    var r_anns: i64 = parse_annotations();
    expect_tok("LBrace");
    var r_sfield: i64 = -1;
    var r_sfield_t: i64 = -1;
    g_method_head = -1;
    g_method_tail = -1;
    while ((cur_t() == "Identifier" || cur_t() == "KwFunc") && cur_t() != "Eof") {
        if (cur_t() == "KwFunc") {
            // 新文法：`fn mname(params) Ret {...}`（关键字领头，LL(1) 友好）
            advance_i();   // 消费 `fn`
            var mname: string = expect_tok("Identifier");
            var mfd: i64 = parse_method_decl(name, mname, r_anns);
            if (mfd >= 0) {
                g_method_tail = list_push(g_method_head, g_method_tail, mfd);
                if (g_method_head < 0) { g_method_head = g_method_tail; }
            }
        } else if (peek_t(1) == "KwFunc") {
            // 方言统一（Stage 2）：`mname fn(...)` 结构体方法旧文法已废弃，统一为 `fn mname(...)`。
            // 转换器已把整树结构体方法迁到 `fn mname`，此处直接报迁移错误而非误当成字段解析。
            var mname: string = expect_tok("Identifier");
            parse_fatal_at("T-PAR-E102", sb_cat6("method `", mname, " fn(...)` removed; use `fn ", mname, "(...)` (struct ", sb_cat2(name, ")")), pos);
        } else {
            var __it: i64 = parse_sfield();
            r_sfield_t = list_push(r_sfield, r_sfield_t, __it);
            if (r_sfield < 0) { r_sfield = r_sfield_t; }
        }
    }
    expect_tok("RBrace");
    var __id: i64 = mk_StructDecl(name, layout, bp_type2(anns, r_anns), bp_has_type2(anns, r_anns), bp_is2(anns, r_anns), list_concat(anns, r_anns), r_sfield, -1);
    return __id;
}

fn parse_umember() i64 {
    var r_Ident: string = expect_tok("Identifier");
    expect_tok("Colon");
    var r_type: i64 = parse_type();
    var r_anns: i64 = parse_annotations();
    if (cur_t() == "Comma" || cur_t() == "Semicolon") {
    if (cur_t() == "Comma") {
    expect_tok("Comma");
    }    else if (cur_t() == "Semicolon") {
    expect_tok("Semicolon");
    } else {
        parse_fatal("unexpected token in alternative");
    }
    }
    var __id: i64 = mk_M(r_Ident, r_type, r_anns, -1);
    return __id;
}

fn parse_union_decl(name: string, anns: i64) i64 {
    advance_i();
    var r_anns: i64 = parse_annotations();
    expect_tok("LBrace");
    var r_umember: i64 = -1;
    var r_umember_t: i64 = -1;
    while (cur_t() == "Identifier" && cur_t() != "Eof") {
        var __it: i64 = parse_umember();
        r_umember_t = list_push(r_umember, r_umember_t, __it);
        if (r_umember < 0) { r_umember = r_umember_t; }
    }
    expect_tok("RBrace");
    var __id: i64 = mk_UnionDecl(name, list_concat(anns, r_anns), r_umember, -1);
    return __id;
}

fn parse_setmember() i64 {
    var r_Ident: string = expect_tok("Identifier");
    expect_tok("Colon");
    var r_Integer: string = expect_tok("Integer");
    var r_anns: i64 = parse_annotations();
    if (cur_t() == "Comma" || cur_t() == "Semicolon") {
    if (cur_t() == "Comma") {
    expect_tok("Comma");
    }    else if (cur_t() == "Semicolon") {
    expect_tok("Semicolon");
    } else {
        parse_fatal("unexpected token in alternative");
    }
    }
    var __id: i64 = mk_SL(r_Ident, parse_int_str(r_Integer), -1, false, r_anns, -1);
    return __id;
}

fn parse_flag_set_decl(name: string, anns: i64) i64 {
    advance_i();
    var r_anns: i64 = parse_annotations();
    expect_tok("LBrace");
    var r_setmember: i64 = -1;
    var r_setmember_t: i64 = -1;
    while (cur_t() == "Identifier" && cur_t() != "Eof") {
        var __it: i64 = parse_setmember();
        r_setmember_t = list_push(r_setmember, r_setmember_t, __it);
        if (r_setmember < 0) { r_setmember = r_setmember_t; }
    }
    expect_tok("RBrace");
    var __id: i64 = mk_FlagSetDecl(name, list_concat(anns, r_anns), r_setmember, -1);
    return __id;
}

fn parse_slot() i64 {
    var r_Ident: string = expect_tok("Identifier");
    expect_tok("Colon");
    var r_Integer: string = expect_tok("Integer");
    var r_anns: i64 = parse_annotations();
    if (cur_t() == "Comma" || cur_t() == "Semicolon") {
    if (cur_t() == "Comma") {
    expect_tok("Comma");
    }    else if (cur_t() == "Semicolon") {
    expect_tok("Semicolon");
    } else {
        parse_fatal("unexpected token in alternative");
    }
    }
    var __id: i64 = mk_SL(r_Ident, parse_int_str(r_Integer), flag_offset_of(r_anns), flag_has_offset(r_anns), r_anns, -1);
    return __id;
}

fn parse_flag_decl(name: string, anns: i64) i64 {
    advance_i();
    var r_Ident: string = "";
    if (cur_t() == "LBracket") {
    expect_tok("LBracket");
    r_Ident = expect_tok("Identifier");
    expect_tok("RBracket");
    }
    var r_anns: i64 = parse_annotations();
    expect_tok("LBrace");
    var r_slot: i64 = -1;
    var r_slot_t: i64 = -1;
    while (cur_t() == "Identifier" && cur_t() != "Eof") {
        var __it: i64 = parse_slot();
        r_slot_t = list_push(r_slot, r_slot_t, __it);
        if (r_slot < 0) { r_slot = r_slot_t; }
    }
    expect_tok("RBrace");
    var __id: i64 = mk_FlagDecl(name, str_or(r_Ident, "u32"), list_concat(anns, r_anns), r_slot, -1);
    return __id;
}

fn parse_case(ci: i64) i64 {
    var r_Ident: string = expect_tok("Identifier");
    var r_type: i64 = -1;
    var r_types: i64 = -1;
    var r_types_t: i64 = -1;
    var r_cnt: i64 = 0;
    if (cur_t() == "LParen") {
    expect_tok("LParen");
    r_type = parse_type();
    r_cnt = 1;
    // ADT 多载荷 case `Rect(f64, f64)`：类型链存 VC.lb、个数存 VC.ib。
    // 单载荷/单元 case 仍**只**用 VC.na（lb=-1），与既有 register_variant_helpers /
    // emit_variant_decl 完全一致 —— 故既有 variant 的发射逐字节不变。
    while (cur_t() == "Comma") {
        expect_tok("Comma");
        var r_tn: i64 = parse_type();
        if (r_cnt == 1) {
            r_types_t = list_push(r_types, r_types_t, r_type);
            if (r_types < 0) { r_types = r_types_t; }
        }
        r_types_t = list_push(r_types, r_types_t, r_tn);
        if (r_types < 0) { r_types = r_types_t; }
        r_cnt = r_cnt + 1;
    }
    expect_tok("RParen");
    }
    var r_anns: i64 = parse_annotations();
    if (cur_t() == "Comma" || cur_t() == "Semicolon") {
    if (cur_t() == "Comma") {
    expect_tok("Comma");
    }    else if (cur_t() == "Semicolon") {
    expect_tok("Semicolon");
    } else {
        parse_fatal("unexpected token in alternative");
    }
    }
    var __id: i64 = mk_VC(r_Ident, ci, r_type, r_anns, -1);
    if (r_cnt >= 2) {
        var r_vn: Node = nodes[__id];
        r_vn.lb = r_types;
        r_vn.ib = r_cnt;
        slice_set(nodes, __id, r_vn);
    }
    return __id;
}

fn parse_variant_decl(name: string, anns: i64) i64 {
    advance_i();
    var r_anns: i64 = parse_annotations();
    expect_tok("LBrace");
    var r_case: i64 = -1;
    var r_case_t: i64 = -1;
    var ci: i64 = 0;
    var r_abs: bool = false;
    while (cur_t() == "Identifier" && cur_t() != "Eof") {
        // ADT 抽象标记：末位 `_` 把该 variant 声明为「抽象 / 非穷尽（open）」。
        // `_` 是**类型级标记**、不是真实 case：不占 tag、不生成构造器（见 adt_variant.md §7.6）。
        if (cur_v() == "_") {
            advance_i();
            r_abs = true;
            if (cur_t() == "Comma") { advance_i(); }
            else if (cur_t() == "Semicolon") { advance_i(); }
            // 只允许出现在末位：其后必须收尾。
            if (cur_t() != "RBrace") {
                parse_fatal_at("T-PAR-E103",
                    "variant 的抽象标记 `_` 只能位于末位（其后不得再有 case）", pos);
            }
        } else {
        var __it: i64 = parse_case(ci);
        r_case_t = list_push(r_case, r_case_t, __it);
        if (r_case < 0) { r_case = r_case_t; }
        ci = ci + 1;
        }
    }
    expect_tok("RBrace");
    var __id: i64 = mk_VariantDecl(name, list_concat(anns, r_anns), r_case, -1);
    if (r_abs) {
        var r_dn: Node = nodes[__id];
        r_dn.ba = true;
        slice_set(nodes, __id, r_dn);
    }
    return __id;
}

fn parse_type_alias(name: string, anns: i64) i64 {
    var r_type: i64 = parse_type();
    expect_tok("Semicolon");
    var __id: i64 = mk_TypeAliasDecl(name, r_type, anns, -1);
    return __id;
}

// <<< GEN:parser_rules <<<



// 取点分路径的首段（无点则为整串）。用于识别 `src.` 源码根标记。
fn first_segment(s: string) string {
    var n: u64 = str_len(s);
    var i: u64 = 0;
    while (i < n) {
        if (s[i] == 46) { return str_slice(s, 0, i); }
        i = i + 1;
    }
    return s;
}


// 去掉点分路径的首段（无点则返回 ""）。`src.d.e` => `d.e`。
fn drop_first_segment(s: string) string {
    var n: u64 = str_len(s);
    var i: u64 = 0;
    while (i < n) {
        if (s[i] == 46) { return str_slice(s, i + 1, n); }
        i = i + 1;
    }
    return "";
}


fn n_file(ni: i64) string {
    if (ni < 0) {
        return "";
    }
    var n: Node = nodes[ni];
    if (n.ln == 0) {
        return "";
    }
    return g_file;
}


fn list_count(head: i64) i64 {
    var c: i64 = head;
    var n: i64 = 0;
    while (c >= 0) {
        var k: Child = kids[c];
        n = n + 1;
        c = k.next;
    }
    return n;
}


fn n_col(ni: i64) i64 {
    if (ni < 0) {
        return 1;
    }
    var n: Node = nodes[ni];
    if (n.ln == 0) {
        return 1;
    }
    return n.cl as i64;
}


fn n_line(ni: i64) i64 {
    if (ni < 0) {
        return 1;
    }
    var n: Node = nodes[ni];
    if (n.ln == 0) {
        return 1;
    }
    return n.ln as i64;
}


fn parse_meta_builtin() i64 {
    var ti_at: i64 = advance_i();               // '@'
    var nm: string = expect_tok("Identifier");
    expect_tok("LParen");
    var head: i64 = -1;
    var tail: i64 = -1;
    var idx: i64 = 0;
    if (cur_t() != "RParen") {
        while (true) {
            var a: i64 = -1;
            if (mb_arg_is_type(nm, idx)) {
                a = parse_type();
            } else {
                a = parse_expr();
            }
            tail = list_push(head, tail, a);
            if (head < 0) { head = tail; }
            idx = idx + 1;
            if (cur_t() == "Comma") { advance_i(); } else { break; }
        }
    }
    expect_tok("RParen");
    var id: i64 = node_new("mbuiltin");
    var nn: Node = nodes[id];
    nn.sa = nm;
    nn.la = head;
    slice_set(nodes, id, nn);
    node_at(id, ti_at);
    return id;
}


// 该形参位收类型还是表达式 —— 解析期就必须定死（`[1024]u8` 不是合法表达式）
fn mb_arg_is_type(name: string, idx: i64) bool {
    if (name == "type_name" || name == "type_size" || name == "zeroed") { return idx == 0; }
    if (name == "type_equal") { return idx < 2; }
    return false;
}
