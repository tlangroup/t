parse_slot fn() i64 {
    var r_Ident: string = expect_tok("Identifier");
    expect_tok("Colon");
    var r_Integer: string = expect_tok("Integer");
    var r_anns: i64 = parse_annotations();
    if (cur_t() == "Comma" || cur_t() == "Semicolon") {
    if (cur_t() == "Comma") {
    expect_tok("Comma");
    }    else if (cur_t() == "Semicolon") {
    expect_tok("Semicolon");
    } else {
        eprint("parse error: unexpected token in alternative\n"); exit(1);
    }
    }
    var __id: i64 = mk_SL(r_Ident, parse_int_str(r_Integer), flag_offset_of(r_anns), flag_has_offset(r_anns), r_anns, -1);
