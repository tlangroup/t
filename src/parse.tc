}

parse_flag_decl fn(name: string, anns: i64) i64 {
    advance_i();
    var r_Ident: string = "";
    if (cur_t() == "LBracket") {
    expect_tok("LBracket");
    r_Ident = expect_tok("Identifier");
    expect_tok("RBracket");
    }
    var r_anns: i64 = parse_annotations();
    expect_tok("LBrace");
    var r_slot: i64 = -1;
    var r_slot_t: i64 = -1;
    while (cur_t() == "Identifier" && cur_t() != "Eof") {
        var __it: i64 = parse_slot();
        r_slot_t = list_push(r_slot, r_slot_t, __it);
        if (r_slot < 0) { r_slot = r_slot_t; }
    }
    expect_tok("RBrace");
    var __id: i64 = mk_FlagDecl(name, str_or(r_Ident, "u32"), list_concat(anns, r_anns), r_slot, -1);
    return __id;
}

parse_case fn(ci: i64) i64 {
    var r_Ident: string = expect_tok("Identifier");
    var r_type: i64 = -1;
    if (cur_t() == "LParen") {
    expect_tok("LParen");
    r_type = parse_type();
    expect_tok("RParen");
    }
    var r_anns: i64 = parse_annotations();
    if (cur_t() == "Comma" || cur_t() == "Semicolon") {
    if (cur_t() == "Comma") {
    expect_tok("Comma");
    }    else if (cur_t() == "Semicolon") {
    expect_tok("Semicolon");
    } else {
        eprint("parse error: unexpected token in alternative\n"); exit(1);
    }
    }
    var __id: i64 = mk_VC(r_Ident, ci, r_type, r_anns, -1);
    return __id;
}

parse_variant_decl fn(name: string, anns: i64) i64 {
    advance_i();
    var r_anns: i64 = parse_annotations();
    expect_tok("LBrace");
    var r_case: i64 = -1;
    var r_case_t: i64 = -1;
    var ci: i64 = 0;
    while (cur_t() == "Identifier" && cur_t() != "Eof") {
        var __it: i64 = parse_case(ci);
        r_case_t = list_push(r_case, r_case_t, __it);
        if (r_case < 0) { r_case = r_case_t; }
        ci = ci + 1;
    }
    expect_tok("RBrace");
    var __id: i64 = mk_VariantDecl(name, list_concat(anns, r_anns), r_case, -1);
    return __id;
}

parse_type_alias fn(name: string, anns: i64) i64 {
    var r_type: i64 = parse_type();
    expect_tok("Semicolon");
    var __id: i64 = mk_TypeAliasDecl(name, r_type, anns, -1);
    return __id;
}

// <<< GEN:parser_rules <<<



// 取点分路径的首段（无点则为整串）。用于识别 `src.` 源码根标记。
first_segment fn(s: string) string {
    var n: u64 = str_len(s);
    var i: u64 = 0;
    while (i < n) {
        if (s[i] == 46) { return str_slice(s, 0, i); }
        i = i + 1;
    }
    return s;
}


// 去掉点分路径的首段（无点则返回 ""）。`src.d.e` => `d.e`。
drop_first_segment fn(s: string) string {
    var n: u64 = str_len(s);
    var i: u64 = 0;
    while (i < n) {
        if (s[i] == 46) { return str_slice(s, i + 1, n); }
        i = i + 1;
    }
    return "";
}


n_file fn(ni: i64) string {
    if (ni < 0) {
        return "";
    }
    var n: Node = nodes[ni];
    if (n.ln == 0) {
        return "";
    }
    return g_file;
}


list_count fn(head: i64) i64 {
    var c: i64 = head;
    var n: i64 = 0;
    while (c >= 0) {
        var k: Child = kids[c];
        n = n + 1;
        c = k.next;
    }
    return n;
}


n_col fn(ni: i64) i64 {
    if (ni < 0) {
        return 1;
    }
    var n: Node = nodes[ni];
    if (n.ln == 0) {
        return 1;
    }
    return n.cl as i64;
}


n_line fn(ni: i64) i64 {
    if (ni < 0) {
        return 1;
    }
    var n: Node = nodes[ni];
    if (n.ln == 0) {
        return 1;
    }
    return n.ln as i64;
}


parse_meta_builtin fn() i64 {
    var ti_at: i64 = advance_i();               // '@'
    var nm: string = expect_tok("Identifier");
    expect_tok("LParen");
    var head: i64 = -1;
    var tail: i64 = -1;
    var idx: i64 = 0;
    if (cur_t() != "RParen") {
        while (true) {
            var a: i64 = -1;
            if (mb_arg_is_type(nm, idx)) {
                a = parse_type();
            } else {
                a = parse_expr();
            }
            tail = list_push(head, tail, a);
            if (head < 0) { head = tail; }
            idx = idx + 1;
            if (cur_t() == "Comma") { advance_i(); } else { break; }
        }
    }
    expect_tok("RParen");
    var id: i64 = node_new("mbuiltin");
    var nn: Node = nodes[id];
    nn.sa = nm;
    nn.la = head;
    slice_set(nodes, id, nn);
    node_at(id, ti_at);
    return id;
}


// 该形参位收类型还是表达式 —— 解析期就必须定死（`[1024]u8` 不是合法表达式）
mb_arg_is_type fn(name: string, idx: i64) bool {
    if (name == "type_name" || name == "type_size" || name == "zeroed") { return idx == 0; }
    if (name == "type_equal") { return idx < 2; }
    return false;
}
