// ══════════════════════════════════════════════════════════════════
// src/opmap.tc — TIR op 文本 → 整数判别码的小模块
//
// ⚠ 为什么单独成模块：tir_op_from_str 原位于 src/tir.tc（巨型模块），
// 自举种子编译器（旧 LLVM 后端）自举编译该大模块时会静默丢弃 div/rem 这 4 个
// 分支、且 `if (dr != 0) return dr` 的提前返回被丢弃，导致新轨 / % 全部降级为
// add（inst.op 落 TIR_OP_OTHER）。把整个 tir_op_from_str 抽到本小模块后，种子
// 编译器能正确编译（独立探针已验证同逻辑在小模块中返回正确），从而打破自举错编死循环。
//
// 本模块刻意自包含：只 import src.base（用 str_len/str_slice），不引用 tir.tc 的
// TIR_OP_* 常量名，op 码一律用字面量返回（与 tir.tc 顶部 TIR_OP_* 定义对齐），
// 以避免与 tir.tc 形成循环导入，并保证种子对其 100% 正确编译。
//
// 字面量对照（与 tir.tc TIR_OP_* 一致）：
//   ADD=31 SUB=32 MUL=33 SDIV=58 UDIV=59 SREM=60 UREM=61
//   AND=38 OR=39 XOR=40 SHL=41 LSHR=42 ASHR=43
//   SLT=44 SGT=45 SGE=46 SLE=47 ULT=48 UGT=49 ULE=50 UGE=51
//   EQ=52 NE=53 NOT=54 LNOT=55 NEG=56 OTHER=57
//   RET_VOID=2 RET=3 SLOT=4 CONST_STR=5 CONST_PTR_NULL=6 CONST=7
//   BITCAST=8 STORE=9 LOAD=10 ADDR_OF=11 GEP=12 GEP_IDX=13
//   SLICE_AT=14 STR_AT=15 STRUCT_NEW=16 CALL=17 CALL_IND=18
//   BR=19 BR_COND=20 BLOCK=21 TRUNC=22 ZEXT=23 SEXT=24
//   FPEXT=25 FPTRUNC=26 SITOFP=27 UITOFP=28 FPTOSI=29 FPTOUI=30
// ⚠ 改动 TIR_OP_* 值后须同步本文件字面量。
// ══════════════════════════════════════════════════════════════════

const base = @import("src.base");

// 除/取余 op 文本基名 → 整数判别码。tir_op_from_str 在最前优先查本函数。
// 返回字面量 58/59/60/61（与 tir.tc 中 TIR_OP_SDIV/UDIV/SREM/UREM 对齐）。
pub fn tir_op_from_str_divrem(s: string) i64 {
    if (s == "div_s.i64") { return 58; }
    if (s == "div_s") { return 58; }
    if (s == "div_u.i64") { return 59; }
    if (s == "div_u") { return 59; }
    if (s == "rem_s.i64") { return 60; }
    if (s == "rem_s") { return 60; }
    if (s == "rem_u.i64") { return 61; }
    if (s == "rem_u") { return 61; }
    if (s == "sdiv.i64") { return 58; }
    if (s == "sdiv") { return 58; }
    if (s == "udiv.i64") { return 59; }
    if (s == "udiv") { return 59; }
    if (s == "srem.i64") { return 60; }
    if (s == "srem") { return 60; }
    if (s == "urem.i64") { return 61; }
    if (s == "urem") { return 61; }
    return 0;
}

// 文本 op 基名 → 整数判别码（解析期调用；const.<x> 一律归并到 CONST=7，st 已由解析器写入 inst.st）
// ⚠ 本函数整体位于小模块以规避种子对 tir.tc 大模块的错编（见文件头注释）。
pub fn tir_op_from_str(s: string) i64 {
    var dr: i64 = tir_op_from_str_divrem(s);
    if (dr != 0) { return dr; }
    if (s == "ret.void") { return 2; }
    if (s == "ret") { return 3; }
    if (s == "slot") { return 4; }
    if (s == "const.str") { return 5; }
    if (s == "const.ptr.null") { return 6; }
    if (s == "const") { return 7; }
    if (str_len(s) > 6 and str_slice(s, 0, 6) == "const.") { return 7; }
    if (s == "bitcast") { return 8; }
    if (s == "store") { return 9; }
    if (s == "load") { return 10; }
    if (s == "addr_of") { return 11; }
    if (s == "gep") { return 12; }
    if (s == "gep_idx") { return 13; }
    if (s == "slice_at") { return 14; }
    if (s == "str_at") { return 15; }
    if (s == "struct_new") { return 16; }
    if (s == "call") { return 17; }
    if (s == "call_ind") { return 18; }
    if (s == "br") { return 19; }
    if (s == "br_cond") { return 20; }
    if (s == "block") { return 21; }
    if (s == "trunc") { return 22; }
    if (s == "zext") { return 23; }
    if (s == "sext") { return 24; }
    if (s == "fpext") { return 25; }
    if (s == "fptrunc") { return 26; }
    if (s == "sitofp") { return 27; }
    if (s == "uitofp") { return 28; }
    if (s == "fptosi") { return 29; }
    if (s == "fptoui") { return 30; }
    if (s == "add") { return 31; }
    if (s == "sub") { return 32; }
    if (s == "mul") { return 33; }
    if (s == "div_s") { return 58; }
    if (s == "div_u") { return 59; }
    if (s == "rem_s") { return 60; }
    if (s == "rem_u") { return 61; }
    if (s == "and") { return 38; }
    if (s == "or") { return 39; }
    if (s == "xor") { return 40; }
    // ⚠ `&&` / `||` 已于 §set-ops §13.3 从语言中移除（格族统一为 `&` / `|`）。
    //   这两条**刻意保留**：一旦还有遗漏的产出点落到这两个 op 名，映射到 and/or 仍是
    //   正确语义；删掉则会掉进 `OTHER=57` 那条静默降级（§9 Bug A 同款），代价不对称。
    if (s == "&&") { return 38; }
    if (s == "||") { return 39; }
    if (s == "xor") { return 40; }
    if (s == "concat") { return 63; }   // 集合合并 `++`
    if (s == "shl") { return 41; }
    if (s == "lshr") { return 42; }
    if (s == "ashr") { return 43; }
    if (s == "slt") { return 44; }
    if (s == "sgt") { return 45; }
    if (s == "sge") { return 46; }
    if (s == "sle") { return 47; }
    if (s == "ult") { return 48; }
    if (s == "ugt") { return 49; }
    if (s == "ule") { return 50; }
    if (s == "uge") { return 51; }
    if (s == "eq") { return 52; }
    if (s == "ne") { return 53; }
    if (s == "not") { return 54; }
    if (s == "lnot") { return 55; }
    if (s == "neg") { return 56; }
    if (s == "sdiv") { return 58; }
    if (s == "udiv") { return 59; }
    if (s == "srem") { return 60; }
    if (s == "urem") { return 61; }
    // 算术/比较类文本形态带类型后缀 "add.i64" "slt.i64"：剥离首点后的基名再匹配。
    // 必须在 const 族精确匹配之后做（const.str / const.ptr.null / ret.void 含点，已在上文命中）。
    var dot: i64 = -1;
    var di: i64 = 0;
    while (di < str_len(s)) { if (s[di] == 46) { dot = di; break; } di = di + 1; }
    if (dot >= 0) {
        var base: string = str_slice(s, 0, dot);
        if (base == "ret") { return 3; }
        if (base == "slot") { return 4; }
        if (base == "bitcast") { return 8; }
        if (base == "store") { return 9; }
        if (base == "load") { return 10; }
        if (base == "addr_of") { return 11; }
        if (base == "gep") { return 12; }
        if (base == "gep_idx") { return 13; }
        if (base == "slice_at") { return 14; }
        if (base == "str_at") { return 15; }
        if (base == "struct_new") { return 16; }
        if (base == "call") { return 17; }
        if (base == "call_ind") { return 18; }
        if (base == "br") { return 19; }
        if (base == "br_cond") { return 20; }
        if (base == "block") { return 21; }
        if (base == "trunc") { return 22; }
        if (base == "zext") { return 23; }
        if (base == "sext") { return 24; }
        if (base == "fpext") { return 25; }
        if (base == "fptrunc") { return 26; }
        if (base == "sitofp") { return 27; }
        if (base == "uitofp") { return 28; }
        if (base == "fptosi") { return 29; }
        if (base == "fptoui") { return 30; }
        if (base == "add") { return 31; }
        if (base == "sub") { return 32; }
        if (base == "mul") { return 33; }
        if (base == "div_s") { return 58; }
        if (base == "div_u") { return 59; }
        if (base == "rem_s") { return 60; }
        if (base == "rem_u") { return 61; }
        if (base == "and") { return 38; }
        if (base == "or") { return 39; }
        if (base == "xor") { return 40; }
        if (base == "shl") { return 41; }
        if (base == "lshr") { return 42; }
        if (base == "ashr") { return 43; }
        if (base == "slt") { return 44; }
        if (base == "sgt") { return 45; }
        if (base == "sge") { return 46; }
        if (base == "sle") { return 47; }
        if (base == "ult") { return 48; }
        if (base == "ugt") { return 49; }
        if (base == "ule") { return 50; }
        if (base == "uge") { return 51; }
        if (base == "eq") { return 52; }
        if (base == "ne") { return 53; }
        if (base == "not") { return 54; }
        if (base == "lnot") { return 55; }
        if (base == "neg") { return 56; }
        if (base == "sdiv") { return 58; }
        if (base == "udiv") { return 59; }
        if (base == "srem") { return 60; }
        if (base == "urem") { return 61; }
    }
    return 57;
}

// ── 二元运算符文本基名 → 带类型后缀串（如 "div_s.i64"） ───────────────
// ⚠ 与 tir.tc 旧 tir_binop 的两点关键修正：
//   (1) div/rem 必须用 base.sb_cat3(b, ".", st) 拼点 —— 旧实现用 base.sb_cat2("div_s", st)
//       得到 "div_si64"（无点），tir_op_from_str 无法匹配 → 落入 OTHER=57 →
//       新轨 / % 全部降级成 add（emit-tir 见 <other>、emit-tir-ll 见 add i64）。
//   (2) 整组函数迁到本小模块（同 tir_op_from_str），规避种子对 tir.tc 大模块的
//       静默错编（直接改 tir.tc 的 / % 分支在重编译后不生效，证明分支被丢弃），
//       从而打破自举错编死循环。仅依赖 base.sb_cat2/3，无环导入。
pub fn tir_binop(op: string, st: string) string {
    if (op == "+") { return base.sb_cat2("add.", st); }
    if (op == "-") { return base.sb_cat2("sub.", st); }
    if (op == "*") { return base.sb_cat2("mul.", st); }
    if (op == "/") { return base.sb_cat3(tir_divop(st), ".", st); }
    if (op == "%") { return base.sb_cat3(tir_remop(st), ".", st); }
    if (op == "&") { return "and"; }
    if (op == "|") { return "or"; }
    if (op == "^") { return "xor"; }
    // ⚠ 同上：`&&` / `||` 已移除，映射**刻意保留**作防御（漏网产出点宁可落到正确的
    //   and/or，也不要掉进 `unsupported_binop` / `OTHER=57` 的静默降级）。
    if (op == "&&") { return "and"; }
    if (op == "||") { return "or"; }
    if (op == "Concat") { return "concat"; }   // 集合合并 `++`：TIR 轨落 TIR_OP_CONCAT，LLVM 端按 st 分派到 tll_*
    if (op == "<<") { return "shl"; }
    if (op == ">>") { return "ashr"; }
    if (op == "==") { return base.sb_cat2("eq.", st); }
    if (op == "!=") { return base.sb_cat2("ne.", st); }
    if (op == "<") { return base.sb_cat3(tir_cmpop(op, st), ".", st); }
    if (op == "<=") { return base.sb_cat3(tir_cmpop("<=", st), ".", st); }
    if (op == ">") { return base.sb_cat3(tir_cmpop(">", st), ".", st); }
    if (op == ">=") { return base.sb_cat3(tir_cmpop(">=", st), ".", st); }
    return "unsupported_binop";
}

pub fn tir_divop(st: string) string {
    if (str_len(st) > 0 and st[0] == 117) { return "div_u"; }   // 'u' → 无符号除
    return "div_s";                                            // 有符号除
}

pub fn tir_remop(st: string) string {
    if (str_len(st) > 0 and st[0] == 117) { return "rem_u"; }
    return "rem_s";
}

pub fn tir_cmpop(op: string, st: string) string {
    var uns: bool = false;
    if (str_len(st) > 0 and st[0] == 117) { uns = true; }
    if (op == "<") { if (uns) { return "ult"; } return "slt"; }
    if (op == "<=") { if (uns) { return "ule"; } return "sle"; }
    if (op == ">") { if (uns) { return "ugt"; } return "sgt"; }
    if (op == ">=") { if (uns) { return "uge"; } return "sge"; }
    return "slt";
}
