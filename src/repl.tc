// ══════════════════════════════════════════════════════════════════
// src/repl.tc — REPL 模式（无参数裸 tc 进入）
//
// 设计（详见 docs/repl.md）：每次输入复用一个「干净子进程」编译+运行模型——
// 把截至当前的会话声明 decls 与新输入拼成一份完整 .tc，交给自身（`me`）
// 以 `build` 编译、再直接运行产物 exe；这样完全复用成熟的前端/后端/链接
// 链路，且每条输入都是全新进程，不存在全局状态在多次求值间被污染的问题。
// 代价是每条表达式都走一遍 clang 链接（~1-2s），对交互式 REPL 可接受。
//
// 分类策略（无需解析器介入）：
//   ① 先试「声明」形态（decls + 输入 + noop @main）——成功则作为会话声明保留；
//   ② 否则试「值」形态 print(format("{}", 输入))——成功则打印求值结果；
//   ③ 否则试「语句」形态（输入;）——成功则仅执行不打印；
//   ④ 全失败则展示最后一次构建的错误日志。
// 多行输入用花括号/圆括号/方括号配平判定完整性，未配平时继续读取（.. 续行提示）。
// ══════════════════════════════════════════════════════════════════

import(src.base :: *);
import(src.lex :: *);
import(src.parse :: *);
import(src.sema :: *);
import(src.codegen_c :: *);
import(src.codegen_ll :: *);

repl_ltrim fn(s: string) string {
    var n: u64 = str_len(s);
    var i: u64 = 0;
    while (i < n) {
        var c: i64 = str_at(s, i);
        if (c == 32 || c == 9) { i = i + 1; } else { break; }
    }
    return str_slice(s, i, n);
}

repl_rtrim fn(s: string) string {
    var n: u64 = str_len(s);
    while (n > 0) {
        var c: i64 = str_at(s, n - 1);
        if (c == 13 || c == 10) { n = n - 1; } else { break; }
    }
    return str_slice(s, 0, n);
}

repl_starts_with fn(hay: string, needle: string) bool {
    var hn: u64 = str_len(hay);
    var nn: u64 = str_len(needle);
    if (nn > hn) { return false; }
    return str_slice(hay, 0, nn) == needle;
}

repl_balanced fn(s: string) bool {
    var n: u64 = str_len(s);
    var i: u64 = 0;
    var depth: i64 = 0;
    while (i < n) {
        var c: i64 = str_at(s, i);
        if (c == 123) { depth = depth + 1; }
        else if (c == 125) { depth = depth - 1; }
        else if (c == 40) { depth = depth + 1; }
        else if (c == 41) { depth = depth - 1; }
        else if (c == 91) { depth = depth + 1; }
        else if (c == 93) { depth = depth - 1; }
        i = i + 1;
    }
    return depth == 0;
}

repl_contains fn(hay: string, needle: string) bool {
    var hn: u64 = str_len(hay);
    var nn: u64 = str_len(needle);
    if (nn == 0) { return true; }
    if (nn > hn) { return false; }
    var i: u64 = 0;
    while (i + nn <= hn) {
        if (str_slice(hay, i, i + nn) == needle) { return true; }
        i = i + 1;
    }
    return false;
}

// 判定一段完整输入是否为「顶层声明」（需保留到会话），而非普通表达式/语句。
// t 的函数声明是 `Name fn(...) ...` —— fn 关键字在名字之后，不能仅靠首 token 区分，
// 故用「含 ` fn(`」+ 各声明起始关键字联合判定。仅声明会被保留进 decls；
// 普通表达式/语句走求值路径，绝不污染会话（否则会每条输入都被重跑）。
repl_is_decl fn(s: string) bool {
    if (repl_contains(s, " fn(") || repl_contains(s, " fn (")) { return true; }
    if (repl_starts_with(s, "struct ")) { return true; }
    if (repl_starts_with(s, "enum ")) { return true; }
    if (repl_starts_with(s, "flag ")) { return true; }
    if (repl_starts_with(s, "variant ")) { return true; }
    if (repl_starts_with(s, "typealias ")) { return true; }
    if (repl_starts_with(s, "import")) { return true; }
    if (repl_starts_with(s, "var ")) { return true; }
    if (repl_starts_with(s, "const ")) { return true; }
    return false;
}

// 归一化顶层声明：去掉尾随空白，并保证以 `;` 或 `}` 结尾
//（t 的 var/const/typealias 需要 `;`；fn/struct/enum/flag/variant 以 `}` 结尾）。
repl_term fn(s: string) string {
    var t: string = repl_rtrim(s);
    var n: u64 = str_len(t);
    if (n == 0) { return t; }
    var c: i64 = str_at(t, n - 1);
    if (c != 59 && c != 125) { t = sb_cat2(t, ";"); }
    return t;
}

// 把一份会话源码编译为 out/repl/repl_exe.exe；成功返回 true（exe 存在）。
repl_build fn(me: string, rep_dir: string, src: string) bool {
    var sf: string = sb_cat3(rep_dir, "/snippet.tc", "");
    ensure_parent(sf);
    file_write_all(sf, src);
    var exep: string = sb_cat3(rep_dir, "/repl_exe", "");
    var logp: string = sb_cat3(rep_dir, "/build.log", "");
    var csb: StringBuilder = sb_new();
    sb_append_str(csb, "\"");
    sb_append_str(csb, me);
    sb_append_str(csb, "\" build \"");
    sb_append_str(csb, to_bs(sf));
    sb_append_str(csb, "\" --output \"");
    sb_append_str(csb, to_bs(exep));
    sb_append_str(csb, "\" --mode dbg > \"");
    sb_append_str(csb, to_bs(logp));
    sb_append_str(csb, "\" 2> \"");
    sb_append_str(csb, to_bs(sb_cat2(rep_dir, "/build.err")));
    sb_append_str(csb, "\"");
    var rc: i32 = sys_run(sb_to_str(csb));
    return rc == 0 && path_exists(sb_cat2(to_bs(exep), ".exe"));
}

// 成功构建后，把 build.log（仅含 tc 的 warning 行，stderr 已单独重定向到 build.err）
// 回显给用户，使溢出等警告在 REPL 中可见。
repl_surface_warnings fn(rep_dir: string) void {
    var lp: string = sb_cat3(rep_dir, "/build.log", "");
    if (path_exists(lp) == false) { return; }
    var s: string = file_read_all(lp);
    if (str_len(s) > 0) { eprint(s); }
}

// 运行已编译的 out/repl/repl_exe.exe，把 stdout 作为结果打印、stderr 作为运行期错误打印。
repl_run fn(me: string, rep_dir: string) void {
    var exep: string = sb_cat3(rep_dir, "/repl_exe.exe", "");
    var outp: string = sb_cat3(rep_dir, "/out.txt", "");
    var errp: string = sb_cat3(rep_dir, "/err.txt", "");
    var csb: StringBuilder = sb_new();
    sb_append_str(csb, "\"");
    sb_append_str(csb, to_bs(exep));
    sb_append_str(csb, "\" > \"");
    sb_append_str(csb, to_bs(outp));
    sb_append_str(csb, "\" 2> \"");
    sb_append_str(csb, to_bs(errp));
    sb_append_str(csb, "\"");
    sys_run(sb_to_str(csb));
    var outc: string = file_read_all(outp);
    if (str_len(outc) > 0) {
        print(repl_rtrim(outc));
        print("\n");
    }
    var errc: string = file_read_all(errp);
    if (str_len(errc) > 0) { eprint(errc); }
}

run_repl fn(me: string) i32 {
    var rep_dir: string = "out/repl";
    eprint("t REPL — 输入表达式即时求值；:help 查看命令；Ctrl+Z 或 :quit 退出\n");
    var decls: string = "";
    var buf: string = "";
    var quitting: bool = false;
    while (true) {
        if (stdin_eof()) { break; }
        if (buf == "") { eprint("t> "); } else { eprint(".. "); }
        var line: string = read_line();
        if (stdin_eof() && str_len(line) == 0) { break; }
        var lline: string = repl_ltrim(line);
        // 元命令（仅顶层）：以 : 开头
        if (buf == "" && str_len(lline) > 0 && str_slice(lline, 0, 1) == ":") {
            if (lline == ":quit" || lline == ":q") {
                quitting = true;
            } else if (lline == ":help" || lline == ":h") {
                eprint("命令:\n  :help/:h      显示本帮助\n  :quit/:q     退出 REPL\n  :reset       清空已定义的会话声明\n  :dump        打印当前累计的会话声明源码\n  :load <file> 载入 .tc 文件内容到会话\n");
            } else if (lline == ":reset") {
                decls = "";
                eprint("已清空会话声明。\n");
            } else if (lline == ":dump") {
                eprint("--- 当前会话声明 ---\n");
                eprint(decls);
                eprint("\n---------------------\n");
        } else if (repl_starts_with(lline, ":load ")) {
            var fp: string = repl_ltrim(str_slice(lline, 6, str_len(lline)));
            var content: string = file_read_all(fp);
            var probe: string = sb_cat3(content, "\n", "__repl_eval fn() i32 @main { return 0; }\n");
            if (repl_build(me, rep_dir, probe)) {
                decls = sb_cat4(decls, "\n", content, "\n");
                eprint(sb_cat3("已载入 ", fp, "\n"));
            } else {
                eprint(file_read_all(sb_cat3(rep_dir, "/build.log", "")));
            }
        } else {
                eprint(sb_cat3("未知命令: ", lline, "（输入 :help 查看）\n"));
            }
            if (quitting) { break; }
            continue;
        }
        buf = sb_cat2(buf, line);
        buf = sb_cat2(buf, "\n");
        if (repl_balanced(buf) == false) { continue; }
        var src: string = buf;
        buf = "";
        if (str_len(repl_ltrim(src)) == 0) { continue; }
        var tsrc: string = repl_rtrim(src);
        // 顶层声明：验证后保留到会话（仅声明会进 decls，普通语句绝不污染会话）
        if (repl_is_decl(src)) {
            var dform: string = sb_cat4(decls, "\n", repl_term(src), "\n__repl_eval fn() i32 @main { return 0; }\n");
            if (repl_build(me, rep_dir, dform)) {
                decls = sb_cat3(decls, "\n", repl_term(src));
                eprint("ok\n");
                repl_surface_warnings(rep_dir);
            } else {
                eprint(file_read_all(sb_cat3(rep_dir, "/build.log", "")));
            }
            continue;
        }
        // 表达式/语句：先值形态 print(format("{}", ...))，失败再语句形态
        var vform: string = sb_cat4(decls, "\n__repl_eval fn() i32 @main {\n    println(format(\"{}\", ", tsrc, "));\n    return 0;\n}\n");
        if (repl_build(me, rep_dir, vform)) {
            repl_run(me, rep_dir);
            repl_surface_warnings(rep_dir);
            continue;
        }
        var sform: string = sb_cat4(decls, "\n__repl_eval fn() i32 @main {\n    ", tsrc, ";\n    return 0;\n}\n");
        if (repl_build(me, rep_dir, sform)) {
            repl_run(me, rep_dir);
            repl_surface_warnings(rep_dir);
            continue;
        }
        // 全失败：展示最后一次构建错误日志
        eprint(file_read_all(sb_cat3(rep_dir, "/build.log", "")));
    }
    eprint("再见。\n");
    return 0;
}
