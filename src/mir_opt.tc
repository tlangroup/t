// ══════════════════════════════════════════════════════════════════
// src/mir_opt.tc — MIR 中端优化层（compiler-pipeline-route.md §11）
//
// 位置：TIR → MIR 之后、各薄后端（WASM / RISC-V / C）之前。
// 设计：优化层 = 一组作用于 MIRModule 的结构化 pass，不发明第二套操作码
//       （复用 TIR_OP_* / TirOperand / ST_*），所有 pass 均为「语义保持的
//       就地改写」，对后端完全透明。
//
// 首切片（level≥1）只实现无条件安全、可静态判定的 pass：
//   1. 常量折叠       const op const → const（整数算术 + 有符号比较）
//   2. 代数恒等式化简  x+0→x, x*1→x, x-x→0, a==a→1, if(1) 分支化简 …
//   3. 死指令删除 DIE  结果无人引用的纯值指令删除
//   4. 不可达基本块消除 从入口 BFS 删除不可达块（含常量分支后的死分支）
//
// 触发：tc --opt/-O（默认关闭，保护自举不动点；仅 wasm/riscv 轻量后端消费
//       MIR，故优化仅在 --backend mir-wasm|mir-riscv 且 --opt 时生效；LLVM/C
//       路径经各自下游优化器，不在此层）。
// ══════════════════════════════════════════════════════════════════

@import("src.base" :: *);
@import("src.tir" :: *);
@import("src.mir" :: *);

// ── 全局工作缓冲（每函数/每迭代重置）────────────────────────────
var g_sub_k: []string = [];
var g_sub_v: []string = [];
var g_sub_vst: []i64 = [];
var g_def_k: []string = [];
var g_def_v: []string = [];
var g_def_vst: []i64 = [];
var g_rok: bool = false;
var g_rname: string = "";
var g_rst: i64 = 0;
var g_subbed: bool = false;
var g_sact: i64 = 0;   // 0=无 1=就地 CONST 2=替换为其它槽
var g_sval: i64 = 0;
var g_sother: string = "";
var g_sother_st: i64 = 0;
var g_fok: bool = false;
var g_fval: i64 = 0;

// ── 入口 ───────────────────────────────────────────────────────
pub fn mir_opt_run(m: MIRModule, level: i64) void {
    if (level <= 0) { return; }
    var nf: i64 = slice_len(m.funcs) as i64;
    var i: i64 = 0;
    while (i < nf) { mir_opt_func(m.funcs[i], level); i = i + 1; }
}

fn mir_opt_func(f: MIRFunc, level: i64) void {
    g_def_k = []; g_def_v = []; g_def_vst = [];
    g_sub_k = []; g_sub_v = []; g_sub_vst = [];
    var iter: i64 = 0;
    while (iter < 48) {
        mir_build_def(f);
        var used: []string = mir_build_used(f);
        var changed: bool = mir_opt_iter(f, used);
        if (changed == false) { break; }
        iter = iter + 1;
    }
    mir_opt_remove_unreachable(f);
}

// ── 单次迭代：常量折叠 + 代数化简 + DIE + 常量分支化简 ────────────
fn mir_opt_iter(f: MIRFunc, used: []string) bool {
    var changed: bool = false;
    g_sub_k = []; g_sub_v = []; g_sub_vst = [];
    var nb: i64 = slice_len(f.blocks) as i64;
    var b: i64 = 0;
    while (b < nb) {
        var blk: MIRBlock = f.blocks[b];
        var nin: i64 = slice_len(blk.insts) as i64;
        var newi: []MIRInst = [];
        var k: i64 = 0;
        while (k < nin) {
            var ins: MIRInst = blk.insts[k];
            var op: i64 = ins.op;

            // 常量条件分支 → 无条件分支
            if (op == TIR_OP_BR_COND) {
                var cname: string = ins.args[0].name;
                if (mir_def_has(cname)) {
                    var cv: i64 = mir_def_val(cname);
                    var tgt: string = ins.args[1].name;
                    if (cv == 0) { tgt = ins.args[2].name; }
                    ins.op = TIR_OP_BR;
                    ins.args = [];
                    append(ins.args, tir_op_st(tgt, ST_NONE));
                    append(newi, ins);
                    changed = true;
                    k = k + 1;
                    continue;
                }
                ins = mir_apply_subst_args(ins);
                if (g_subbed) { changed = true; }
                append(newi, ins);
                k = k + 1;
                continue;
            }

            // 纯值指令（非 slot 声明）：DIE 或化简
            if (mir_is_pure(op) && op != TIR_OP_SLOT) {
                if (mir_in(used, ins.dst.name) == false) {
                    changed = true;   // 死指令删除
                    k = k + 1;
                    continue;
                }
                mir_try_simplify(ins);
                if (g_sact == 1) {
                    var ci: MIRInst;
                    ci.op = TIR_OP_CONST;
                    ci.st = ins.st;
                    ci.dst = ins.dst;
                    ci.line = ins.line;
                    ci.cmt = "";
                    ci.is_comment = false;
                    ci.args = [];
                    append(ci.args, tir_op_st(base.i2s(g_sval), ins.st));
                    append(newi, ci);
                    changed = true;
                    k = k + 1;
                    continue;
                }
                if (g_sact == 2) {
                    mir_sub_put(ins.dst.name, g_sother, g_sother_st);
                    changed = true;
                    k = k + 1;
                    continue;
                }
                ins = mir_apply_subst_args(ins);
                if (g_subbed) { changed = true; }
                append(newi, ins);
                k = k + 1;
                continue;
            }

            // 终止符 ret/br 或含副作用指令：保留，仅对值操作数做替换
            ins = mir_apply_subst_args(ins);
            if (g_subbed) { changed = true; }
            append(newi, ins);
            k = k + 1;
        }
        blk.insts = newi;
        f.blocks[b] = blk;
        b = b + 1;
    }
    return changed;
}

// ── 代数/常量化简判定（结果写入 g_sact* 全局）──────────────────
fn mir_try_simplify(ins: MIRInst) void {
    g_sact = 0;
    var op: i64 = ins.op;
    if (mir_op_is_binop(op) == false) { return; }
    if (slice_len(ins.args) as i64 < 2) { return; }
    var a0: TirOperand = ins.args[0];
    var a1: TirOperand = ins.args[1];
    var isfloat: bool = (ins.st == ST_F32 || ins.st == ST_F64);

    // 常量折叠（两操作数均为 const，且结果为整数类型）
    if (isfloat == false && mir_def_has(a0.name) && mir_def_has(a1.name) && mir_is_int(ins.st)) {
        var v0: i64 = mir_def_val(a0.name);
        var v1: i64 = mir_def_val(a1.name);
        mir_fold(op, v0, v1, ins.st);
        if (g_fok) { g_sact = 1; g_sval = g_fval; return; }
    }
    if (isfloat) { return; }

    var v1c: bool = mir_def_has(a1.name);
    var v1val: i64 = 0; if (v1c) { v1val = mir_def_val(a1.name); }
    var v0c: bool = mir_def_has(a0.name);
    var v0val: i64 = 0; if (v0c) { v0val = mir_def_val(a0.name); }

    // a + 0 / a - 0 / a | 0 / a ^ 0 → a（操作数 0 在右侧）
    if ((op == TIR_OP_ADD || op == TIR_OP_SUB || op == TIR_OP_OR || op == TIR_OP_XOR) && v1c && v1val == 0) {
        g_sact = 2; g_sother = a0.name; g_sother_st = a0.st; return;
    }
    // 0 + a / 0 | a / 0 ^ a → a（操作数 0 在左侧，非 and）
    if ((op == TIR_OP_ADD || op == TIR_OP_MUL || op == TIR_OP_OR || op == TIR_OP_XOR) && v0c && v0val == 0) {
        g_sact = 2; g_sother = a1.name; g_sother_st = a1.st; return;
    }
    if (op == TIR_OP_AND) {
        if (v1c && v1val == 0) { g_sact = 1; g_sval = 0; return; }
        if (v0c && v0val == 0) { g_sact = 1; g_sval = 0; return; }
        if (a0.name == a1.name) { g_sact = 2; g_sother = a0.name; g_sother_st = a0.st; return; }
    }
    if (op == TIR_OP_MUL) {
        if (v1c && v1val == 0) { g_sact = 1; g_sval = 0; return; }
        if (v0c && v0val == 0) { g_sact = 1; g_sval = 0; return; }
        if (v1c && v1val == 1) { g_sact = 2; g_sother = a0.name; g_sother_st = a0.st; return; }
    }
    if ((op == TIR_OP_SDIV || op == TIR_OP_UDIV) && v1c && v1val == 1) { g_sact = 2; g_sother = a0.name; g_sother_st = a0.st; return; }
    if ((op == TIR_OP_SREM || op == TIR_OP_UREM) && v1c && v1val == 1) { g_sact = 1; g_sval = 0; return; }
    if ((op == TIR_OP_SHL || op == TIR_OP_LSHR || op == TIR_OP_ASHR) && v1c && v1val == 0) { g_sact = 2; g_sother = a0.name; g_sother_st = a0.st; return; }

    // 自反 / 同操作数化简
    if (a0.name == a1.name) {
        if (op == TIR_OP_SUB || op == TIR_OP_XOR) { g_sact = 1; g_sval = 0; return; }
        if (op == TIR_OP_AND || op == TIR_OP_OR) { g_sact = 2; g_sother = a0.name; g_sother_st = a0.st; return; }
        if (op == TIR_OP_EQ) { g_sact = 1; g_sval = 1; return; }
        if (op == TIR_OP_NE) { g_sact = 1; g_sval = 0; return; }
        if (op == TIR_OP_SLT || op == TIR_OP_SGT) { g_sact = 1; g_sval = 0; return; }
        if (op == TIR_OP_SLE || op == TIR_OP_SGE) { g_sact = 1; g_sval = 1; return; }
    }
}

// ── 常量求值（结果写入 g_fok / g_fval）────────────────────────
fn mir_fold(op: i64, v0: i64, v1: i64, st: i64) void {
    g_fok = false;
    if (op == TIR_OP_ADD) { g_fval = v0 + v1; g_fok = true; return; }
    if (op == TIR_OP_SUB) { g_fval = v0 - v1; g_fok = true; return; }
    if (op == TIR_OP_MUL) { g_fval = v0 * v1; g_fok = true; return; }
    if (op == TIR_OP_AND) { g_fval = v0 & v1; g_fok = true; return; }
    if (op == TIR_OP_OR) { g_fval = v0 | v1; g_fok = true; return; }
    if (op == TIR_OP_XOR) { g_fval = v0 ^ v1; g_fok = true; return; }
    if (op == TIR_OP_SDIV) { if (v1 != 0) { g_fval = v0 / v1; g_fok = true; } return; }
    if (op == TIR_OP_SREM) { if (v1 != 0) { g_fval = v0 % v1; g_fok = true; } return; }
    // 无符号除/余：正确性优先，暂不在中端折叠（避免 i64 符号歧义）
    if (op == TIR_OP_EQ) { if (v0 == v1) { g_fval = 1; } else { g_fval = 0; } g_fok = true; return; }
    if (op == TIR_OP_NE) { if (v0 != v1) { g_fval = 1; } else { g_fval = 0; } g_fok = true; return; }
    if (op == TIR_OP_SLT) { if (v0 < v1) { g_fval = 1; } else { g_fval = 0; } g_fok = true; return; }
    if (op == TIR_OP_SGT) { if (v0 > v1) { g_fval = 1; } else { g_fval = 0; } g_fok = true; return; }
    if (op == TIR_OP_SLE) { if (v0 <= v1) { g_fval = 1; } else { g_fval = 0; } g_fok = true; return; }
    if (op == TIR_OP_SGE) { if (v0 >= v1) { g_fval = 1; } else { g_fval = 0; } g_fok = true; return; }
}

// ── 替换表（dst → 其它槽；用于代数恒等式就地复制传播）──────────
fn mir_sub_put(k: string, v: string, vst: i64) void {
    var n: i64 = slice_len(g_sub_k) as i64;
    var i: i64 = 0;
    while (i < n) { if (g_sub_k[i] == k) { g_sub_v[i] = v; g_sub_vst[i] = vst; return; } i = i + 1; }
    append(g_sub_k, k);
    append(g_sub_v, v);
    append(g_sub_vst, vst);
}

// 传递闭包解析（a→b→c ⇒ 返回 c）
fn mir_sub_resolve(name: string, inst_st: i64) void {
    g_rok = false;
    var cur: string = name;
    var curst: i64 = inst_st;
    var i: i64 = 0;
    while (i < 16) {
        var found: bool = false;
        var j: i64 = 0;
        var n: i64 = slice_len(g_sub_k) as i64;
        while (j < n) {
            if (g_sub_k[j] == cur) { cur = g_sub_v[j]; curst = g_sub_vst[j]; found = true; break; }
            j = j + 1;
        }
        if (found == false) { break; }
        i = i + 1;
    }
    if (i > 0) { g_rok = true; g_rname = cur; g_rst = curst; }
}

// 对指令的操作数（及 RET 的返回值）应用替换；块标签与 callee(@开头) 不动
fn mir_apply_subst_args(ins: MIRInst) MIRInst {
    g_subbed = false;
    var op: i64 = ins.op;
    var na: i64 = slice_len(ins.args) as i64;
    var a: i64 = 0;
    while (a < na) {
        if (op == TIR_OP_BR && a == 0) { a = a + 1; continue; }
        if (op == TIR_OP_BR_COND && (a == 1 || a == 2)) { a = a + 1; continue; }
        if (op == TIR_OP_CALL && a == 0) {
            // callee：以 @ 开头的全局函数名不替换（间接调用槽才替换）
            if (slice_len(ins.args[a].name) as i64 > 0 && ins.args[a].name[0] == 64) { a = a + 1; continue; }
        }
        var nm: string = ins.args[a].name;
        mir_sub_resolve(nm, ins.args[a].st);
        if (g_rok) { ins.args[a] = tir_op_st(g_rname, g_rst); g_subbed = true; }
        a = a + 1;
    }
    if (op == TIR_OP_RET) {
        var nm: string = ins.dst.name;
        mir_sub_resolve(nm, ins.dst.st);
        if (g_rok) { ins.dst = tir_op_st(g_rname, g_rst); g_subbed = true; }
    }
    return ins;
}

// ── 常量定义表（CONST 指令定义槽 → 字面量）───────────────────
fn mir_build_def(f: MIRFunc) void {
    g_def_k = []; g_def_v = []; g_def_vst = [];
    var nb: i64 = slice_len(f.blocks) as i64;
    var b: i64 = 0;
    while (b < nb) {
        var blk: MIRBlock = f.blocks[b];
        var nin: i64 = slice_len(blk.insts) as i64;
        var k: i64 = 0;
        while (k < nin) {
            var ins: MIRInst = blk.insts[k];
            if (ins.op == TIR_OP_CONST && slice_len(ins.args) as i64 >= 1) {
                append(g_def_k, ins.dst.name);
                append(g_def_v, ins.args[0].name);
                append(g_def_vst, ins.st);
            }
            k = k + 1;
        }
        b = b + 1;
    }
}

fn mir_def_has(name: string) bool {
    var n: i64 = slice_len(g_def_k) as i64;
    var i: i64 = 0;
    while (i < n) { if (g_def_k[i] == name) { return true; } i = i + 1; }
    return false;
}

fn mir_def_val(name: string) i64 {
    var n: i64 = slice_len(g_def_k) as i64;
    var i: i64 = 0;
    while (i < n) { if (g_def_k[i] == name) { return tir_digits_to_i64(g_def_v[i]); } i = i + 1; }
    return 0;
}

// ── 使用集合（所有操作数名 + 参数名）──────────────────────────
fn mir_build_used(f: MIRFunc) []string {
    var used: []string = [];
    var np: i64 = slice_len(f.params) as i64;
    var p: i64 = 0;
    while (p < np) {
        var pv: string = f.params[p];
        var col: i64 = 0;
        var pl: i64 = str_len(pv) as i64;
        while (col < pl) { if (pv[col] == 58) { break; } col = col + 1; }
        if (col > 0) { append(used, str_slice(pv, 0, col)); }
        p = p + 1;
    }
    var nb: i64 = slice_len(f.blocks) as i64;
    var b: i64 = 0;
    while (b < nb) {
        var blk: MIRBlock = f.blocks[b];
        var nin: i64 = slice_len(blk.insts) as i64;
        var k: i64 = 0;
        while (k < nin) {
            var ins: MIRInst = blk.insts[k];
            var na: i64 = slice_len(ins.args) as i64;
            var a: i64 = 0;
            while (a < na) { append(used, ins.args[a].name); a = a + 1; }
            // RET 的返回值在操作数 dst（非 args）
            if (ins.op == TIR_OP_RET && str_len(ins.dst.name) as i64 > 0) { append(used, ins.dst.name); }
            k = k + 1;
        }
        b = b + 1;
    }
    return used;
}

fn mir_in(hay: []string, needle: string) bool {
    var n: i64 = slice_len(hay) as i64;
    var i: i64 = 0;
    while (i < n) { if (hay[i] == needle) { return true; } i = i + 1; }
    return false;
}

// ── 纯值指令判定（无副作用、可安全 DIE/化简）─────────────────
fn mir_is_pure(op: i64) bool {
    if (op == TIR_OP_CONST) { return true; }
    if (op == TIR_OP_ADD || op == TIR_OP_SUB || op == TIR_OP_MUL) { return true; }
    if (op == TIR_OP_SDIV || op == TIR_OP_UDIV || op == TIR_OP_SREM || op == TIR_OP_UREM) { return true; }
    if (op == TIR_OP_AND || op == TIR_OP_OR || op == TIR_OP_XOR) { return true; }
    if (op == TIR_OP_SHL || op == TIR_OP_LSHR || op == TIR_OP_ASHR) { return true; }
    if (op == TIR_OP_SLT || op == TIR_OP_SGT || op == TIR_OP_SGE || op == TIR_OP_SLE) { return true; }
    if (op == TIR_OP_ULT || op == TIR_OP_UGT || op == TIR_OP_ULE || op == TIR_OP_UGE) { return true; }
    if (op == TIR_OP_EQ || op == TIR_OP_NE) { return true; }
    if (op == TIR_OP_NOT || op == TIR_OP_LNOT || op == TIR_OP_NEG) { return true; }
    if (op == TIR_OP_TRUNC || op == TIR_OP_ZEXT || op == TIR_OP_SEXT) { return true; }
    if (op == TIR_OP_FPEXT || op == TIR_OP_FPTRUNC || op == TIR_OP_SITOFP || op == TIR_OP_UITOFP) { return true; }
    if (op == TIR_OP_FPTOSI || op == TIR_OP_FPTOUI || op == TIR_OP_BITCAST) { return true; }
    if (op == TIR_OP_ADDR_OF) { return true; }
    return false;
}

fn mir_op_is_binop(op: i64) bool {
    if (op == TIR_OP_ADD || op == TIR_OP_SUB || op == TIR_OP_MUL) { return true; }
    if (op == TIR_OP_SDIV || op == TIR_OP_UDIV || op == TIR_OP_SREM || op == TIR_OP_UREM) { return true; }
    if (op == TIR_OP_AND || op == TIR_OP_OR || op == TIR_OP_XOR) { return true; }
    if (op == TIR_OP_SHL || op == TIR_OP_LSHR || op == TIR_OP_ASHR) { return true; }
    if (op == TIR_OP_SLT || op == TIR_OP_SGT || op == TIR_OP_SGE || op == TIR_OP_SLE) { return true; }
    if (op == TIR_OP_ULT || op == TIR_OP_UGT || op == TIR_OP_ULE || op == TIR_OP_UGE) { return true; }
    if (op == TIR_OP_EQ || op == TIR_OP_NE) { return true; }
    return false;
}

fn mir_is_int(st: i64) bool {
    if (st == ST_I1 || st == ST_I8 || st == ST_U8 || st == ST_I16 || st == ST_U16) { return true; }
    if (st == ST_I32 || st == ST_U32 || st == ST_I64 || st == ST_U64) { return true; }
    return false;
}

// ── 不可达基本块消除 ──────────────────────────────────────────
fn mir_opt_remove_unreachable(f: MIRFunc) void {
    var nb: i64 = slice_len(f.blocks) as i64;
    if (nb == 0) { return; }
    var reach: []bool = [];
    var i: i64 = 0;
    while (i < nb) { append(reach, false); i = i + 1; }
    var stack: []i64 = [];
    append(stack, 0);
    reach[0] = true;
    while (slice_len(stack) as i64 > 0) {
        var cur: i64 = stack[0];
        stack = mir_slice_drop_first(stack);
        var blk: MIRBlock = f.blocks[cur];
        var nin: i64 = slice_len(blk.insts) as i64;
        if (nin > 0) {
            var term: MIRInst = blk.insts[nin - 1];
            var succs: []string = mir_block_succ(term);
            var s: i64 = 0;
            while (s < slice_len(succs) as i64) {
                var idx: i64 = mir_block_index(f, succs[s]);
                if (idx >= 0 && reach[idx] == false) { reach[idx] = true; append(stack, idx); }
                s = s + 1;
            }
        }
    }
    var newb: []MIRBlock = [];
    i = 0;
    while (i < nb) { if (reach[i]) { append(newb, f.blocks[i]); } i = i + 1; }
    f.blocks = newb;
}

fn mir_block_succ(term: MIRInst) []string {
    var r: []string = [];
    var op: i64 = term.op;
    if (op == TIR_OP_BR) {
        if (slice_len(term.args) as i64 >= 1) { append(r, term.args[0].name); }
    } else if (op == TIR_OP_BR_COND) {
        if (slice_len(term.args) as i64 >= 3) { append(r, term.args[1].name); append(r, term.args[2].name); }
    }
    return r;
}

fn mir_block_index(f: MIRFunc, name: string) i64 {
    var nb: i64 = slice_len(f.blocks) as i64;
    var i: i64 = 0;
    while (i < nb) { if (f.blocks[i].name == name) { return i; } i = i + 1; }
    return -1;
}

fn mir_slice_drop_first(s: []i64) []i64 {
    var r: []i64 = [];
    var i: i64 = 1;
    while (i < slice_len(s) as i64) { append(r, s[i]); i = i + 1; }
    return r;
}
