// ══════════════════════════════════════════════════════════════════
// src/tc.tc — 驱动层 / 入口：命令行分发与 main()
//
// 编译器本体已按编译步骤拆分为多模块，本文件仅做 import 汇总与 CLI 派发：
//   base → lex → parse → sema → codegen_c → tir → tir_to_ll
// 测试运行器与 REPL 各自独立成模块（src/test.tc / lib/repl.tc），
// 本文件只 import 它们并派发 `tc test` / REPL 子命令。
// ══════════════════════════════════════════════════════════════════

@import("src.base" :: *);
@import("src.lex" :: *);
@import("src.parse" :: *);
@import("src.sema" :: *);
@import("src.comptime_fold" :: *);
@import("src.codegen_c" :: *);
@import("src.codegen_dev" :: *);
@import("src.tir" :: *);
@import("src.tir_to_ll" :: tir_to_ll_emit, g_has_main, build_tlib);
@import("src.tmir" :: tir_to_tmir_lower, TMIRModule);
@import("src.codegen_wasm" :: tmir_to_wasm);
@import("src.codegen_riscv" :: tmir_to_riscv);
@import("src.mir" :: *);
@import("src.test" :: *);
@import("repl" :: *);

// ── Device 子系统：host 模块是否含 kernel（驱动注入 __t_devmod_blob 用）──
pub fn module_has_kernels() bool {
    var n: i64 = slice_len(lex.decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = lex.decl_list[i];
        var dn: Node = base.nodes[d];
        if (dn.kind == "FuncDecl" && dn.bf == true) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn print_help() void {
    print("tc — 静态类型数据驱动语言(t)编译器\n");
    print("用法:\n");
    print("  tc <lex|check|compile|emit-ll|build|run|test> <file.tc> [选项]\n");
    print("  tc --help | -h | help            显示本帮助并退出 0\n\n");
    print("子命令:\n");
    print("  lex       词法分析，输出 token 流(JSON)\n");
    print("  check     类型/语义检查，输出诊断(JSON)\n");
    print("  compile   产出 C 源码(.c/.h)\n");
    print("  emit-ll   产出 LLVM IR(.ll)\n");
    print("  build     编译并链接为可执行文件(.exe)\n");
    print("  run       build 后立即运行，透传子进程退出码\n");
    print("  test      收集 `test \"名字\" {}` 并运行，汇总 passed/failed/skipped\n\n");
    print("选项:\n");
    print("  --example <name>   编译 examples/<name>.tc\n");
    print("  --filter <substr>  test: 只跑显示名含该子串的用例\n");
    print("  --tag <name>       test: 只跑带 @tag(<name>) 的用例\n");
    print("  --no-run           test: 只编译不执行\n");
    print("  --mode <dbg|rls>   调试/发布(默认 dbg)\n");
    print("  --output <path>    指定输出路径前缀\n");
    print("  --clang <path>     指定 clang 路径\n");
    print("  --runtime <dir>    指定运行时目录(默认 runtime/)\n");
    print("  --debug-libs       链接调试态库 .tlibd（缺少则回退 .tlib）\n");
    print("  --debug            build --lib 时产出调试态归档 .tlibd\n");
    print("  --emit-deps        check 时打印模块依赖图(JSON)后退出\n\n");
    print("退出码: 0=成功, 1=编译/运行错误, 2=命令行用法错误\n");
}
fn main() i32 @main {
    var argv: []string = args();
    lex.init_keywords();
    base.init_node_kinds();
    base.init_xid();
    // 帮助：任意位置出现 --help / -h，或顶层 help 子命令 → 显式请求帮助，退出 0
    // （不再被当作“参数不足”而归入用法错误 2）
    var hai: i64 = 0;
    var han: i64 = slice_len(argv) as i64;
    while (hai < han) {
        if (argv[hai] == "--help" || argv[hai] == "-h") {
            print_help();
            return 0;
        }
        hai = hai + 1;
    }
    if (han >= 2 && argv[1] == "help") {
        print_help();
        return 0;
    }
    // `tc test` 少于 3 个参数时会被下面的通用门槛吞掉，给出的用法串又不含 test，
    // 于是必须在门之前特判，输出针对性的用法（见 src/tc.tc 的 argv 门槛铁律）。
    if (han == 2 && argv[1] == "test") {
        eprint("usage: tc test <file.tc> [--filter <substr>] [--tag <name>] [--mode dbg|rls] [--no-run]\n");
        return 2;
    }
    if (slice_len(argv) < 3) {
        // 无参数的「裸 tc」进入 REPL 模式（输入表达式即时求值）。
        // 注意：`tc help` / `tc --help` / `tc test` 已在上方特判（返回 0 或用法串），
        // 故走到这里且参数不足时，只有「纯 tc 无子命令」一种情况 → REPL。
        if (slice_len(argv) < 2) {
            return repl.run_repl(base.to_bs(argv[0]));
        }
        eprint("usage: tc <lex|check|compile|emit-ll|build|run|test> <file.tc> [--example <name>] [--mode dbg|rls] [--output <path>] [--clang <path>] [--runtime <dir>]\n");
        return 2;
    }
    var cmd: string = argv[1];
    var file: string = argv[2];

    if (cmd == "lex") {
        return lex.run_lex(file);
    }

    if (cmd == "check") {
        // 解析中性开关：--emit-deps（输出依赖图）、--debug-libs（优先 .tlibd）、--debug、
        // --lib-dir（调用方如 tote 注入的库搜索目录）
        // 旗标位置无关：从 argv[2] 起扫描，首个非 -- 旗标即入口文件。
        // 兼容 `tc check <file> --flag` 与 `tc check --flag <file>`（tote 委托时旗标在前）。
        var ai: i64 = 2;
        var an: i64 = slice_len(argv) as i64;
        var found_file: string = "";
        while (ai < an) {
            if (argv[ai] == "--emit-deps") { lex.g_emit_deps = true; ai = ai + 1; continue; }
            if (argv[ai] == "--debug-libs") { lex.g_debug_libs = true; ai = ai + 1; continue; }
            if (argv[ai] == "--debug") { lex.g_lib_debug = true; ai = ai + 1; continue; }
            if (argv[ai] == "--lib-dir") {
                if (ai + 1 < an) { append(lex.g_lib_dirs, argv[ai + 1]); ai = ai + 2; continue; }
            }
            if (argv[ai] == "--diagnostics") {
                if (ai + 1 < an) { base.g_diag_fmt = argv[ai + 1]; ai = ai + 2; continue; }
            }
            if (argv[ai] == "--json") { base.g_diag_fmt = "json"; ai = ai + 1; continue; }
            if (argv[ai] == "--trace-comptime") { sema.g_meta_trace = true; ai = ai + 1; continue; }
            if (found_file == "") { found_file = argv[ai]; }
            ai = ai + 1;
        }
        base.g_file = base.rel_path(found_file);
        var src: string = file_read_all(found_file);
        lex.tokenize(src);
        // 阶段闸门：词法错误会让 token 流失去结构（未终结串、坏数字…），
        // 继续 parse 只会撞上无关的 `parse error` 硬中断并盖掉真正的病因。
        if (sema.has_errors()) { base.emit_diags(); return 1; }
        lex.pos = 0;
        sema.init_anndefs();
        parse.parse_unit();
        sema.run_check();
        sema.run_device_check();
        comptime_fold.comptime_fold_pass();
        sema.meta_trace_flush();
        sema.flag_pass();
        sema.ann_pass();
        if (lex.g_emit_deps) {
            sema.emit_deps();
            if (sema.has_errors()) { return 1; }
            return 0;
        }
        base.emit_diags();
        if (sema.has_errors()) {
            return 1;
        }
        return 0;
    }

    if (cmd == "compile") {
        var out_dir: string = "";
        var has_out: bool = false;
        var mode: string = "dbg";
        var ai: i64 = 3;
        var an: i64 = slice_len(argv) as i64;
        while (ai < an) {
            if (argv[ai] == "--mode") {
                if (ai + 1 < an) {
                    mode = argv[ai + 1];
                    ai = ai + 2;
                    continue;
                }
            }
            if (argv[ai] == "--output") {
                if (ai + 1 < an) {
                    out_dir = argv[ai + 1];
                    has_out = true;
                    ai = ai + 2;
                    continue;
                }
            }
            if (argv[ai] == "--diagnostics") {
                if (ai + 1 < an) { base.g_diag_fmt = argv[ai + 1]; ai = ai + 2; continue; }
            }
            if (argv[ai] == "--json") { base.g_diag_fmt = "json"; ai = ai + 1; continue; }
            if (argv[ai] == "--trace-comptime") { sema.g_meta_trace = true; ai = ai + 1; continue; }
            ai = ai + 1;
        }
        if (base.valid_mode(mode) == false) {
            eprint(base.sb_cat3("error: unknown --mode `", mode, "` (expected dbg|rls)\n"));
            return 2;
        }

        base.g_file = base.rel_path(file);
        var src2: string = file_read_all(file);
        lex.tokenize(src2);
        if (sema.has_errors()) { base.emit_diags(); return 1; }
        lex.pos = 0;
        sema.init_anndefs();
        parse.parse_unit();
        sema.run_check();
        comptime_fold.comptime_fold_pass();
        sema.meta_trace_flush();
        sema.flag_pass();
        sema.ann_pass();
        if (sema.has_errors()) {
            base.emit_diags();
            return 1;
        }

        var mod: string = base.base_no_tc(file);
        codegen_c.emit_unit(mod);

        if (has_out == false) {
            // 缺省按 --mode 落入 out/dbg|out/rls
            out_dir = base.sb_cat3("out/", mode, "");
        }

        var hp: string = base.sb_cat4(out_dir, "/", mod, ".h");
        var cp: string = base.sb_cat4(out_dir, "/", mod, ".c");
        base.ensure_parent(hp);
        file_write_all(hp, codegen_c.h_join());
        file_write_all(cp, codegen_c.s_join());
        print(base.sb_cat6("Generated: ", base.to_bs(hp), ", ", base.to_bs(cp), "\n", ""));
        return 0;
    }

    if (cmd == "emit-dev") {
        // Device 子系统（docs/compiler/device-design.md §2 L4）：把模块里的 `kernel fn` emit 成
        // Device Dialect 文本（.mlir），供 tools/mlir-t-device 的 --device-to-nvvm 预演
        // lowering → PTX。只需前端（parse 后 decl_list 已就绪），不做 host 双后端发射。
        var out_p: string = "";
        var has_outp: bool = false;
        var ai3: i64 = 2;
        var an3: i64 = slice_len(argv) as i64;
        while (ai3 < an3) {
            if (argv[ai3] == "--output") {
                if (ai3 + 1 < an3) {
                    out_p = argv[ai3 + 1];
                    has_outp = true;
                    ai3 = ai3 + 2;
                    continue;
                }
            }
            ai3 = ai3 + 1;
        }
        if (has_outp == false) {
            var mod3: string = base.base_no_tc(file);
            out_p = base.sb_cat4("out/dbg/", mod3, "", ".mlir");
        }
        base.g_file = base.rel_path(file);
        var src4: string = file_read_all(file);
        lex.tokenize(src4);
        if (sema.has_errors()) { base.emit_diags(); return 1; }
        lex.pos = 0;
        sema.init_anndefs();
        parse.parse_unit();
        if (sema.has_errors()) {
            base.emit_diags();
            return 1;
        }
        var mlir: string = codegen_dev.emit_device_module();
        base.ensure_parent(out_p);
        file_write_all(out_p, mlir);
        print(base.sb_cat3("Generated device dialect: ", base.to_bs(out_p), "\n"));
        return 0;
    }

    if (cmd == "emit-tir") {
        // TIR 后端桥（compiler-pipeline-design.md §4.4 / tir-design.md）：把已擦除类型的编译单元
        // 降级为类型擦除·文件级·线性 TIR 文本（src/tir.tc）。新增加性命令，不动 C/LLVM 后端。
        var out_p: string = "";
        var has_outp: bool = false;
        var mode: string = "dbg";
        var src_file: string = "";
        var has_src: bool = false;
        var ex_name: string = "";
        var is_example: bool = false;
        var ai2: i64 = 2;
        var an2: i64 = slice_len(argv) as i64;
        while (ai2 < an2) {
            if (argv[ai2] == "--output") {
                if (ai2 + 1 < an2) { out_p = argv[ai2 + 1]; has_outp = true; }
                ai2 = ai2 + 2; continue;
            }
            if (argv[ai2] == "--mode") {
                if (ai2 + 1 < an2) { mode = argv[ai2 + 1]; }
                ai2 = ai2 + 2; continue;
            }
            if (argv[ai2] == "--diagnostics") {
                if (ai2 + 1 < an2) { base.g_diag_fmt = argv[ai2 + 1]; }
                ai2 = ai2 + 2; continue;
            }
            if (argv[ai2] == "--json") { base.g_diag_fmt = "json"; ai2 = ai2 + 1; continue; }
            if (argv[ai2] == "--example") {
                if (ai2 + 1 < an2) { ex_name = argv[ai2 + 1]; is_example = true; }
                ai2 = ai2 + 2; continue;
            }
            if (has_src == false) { src_file = argv[ai2]; has_src = true; }
            ai2 = ai2 + 1;
        }
        if (base.valid_mode(mode) == false) {
            eprint(base.sb_cat3("error: unknown --mode `", mode, "` (expected dbg|rls)\n"));
            return 2;
        }
        if (is_example) {
            var probe: string = base.sb_cat4("cmd /c if exist \"examples\\", ex_name, ".tc\" (exit 0) else (exit 1)", "");
            var prc: i32 = sys_run(probe);
            if (prc != 0) {
                eprint(base.sb_cat3("error: no example named `", ex_name, "`\n"));
                return 2;
            }
            src_file = base.sb_cat3("examples/", ex_name, ".tc");
            has_src = true;
            if (has_outp == false) {
                var exdir: string = base.to_bs(base.sb_cat3("out/", mode, "/examples"));
                sys_run(base.sb_cat5("cmd /c if not exist \"", exdir, "\" mkdir \"", exdir, "\""));
                out_p = base.sb_cat4("out/", mode, "/examples/", ex_name);
                has_outp = true;
            }
        }
        if (has_src == false) {
            eprint("usage: tc emit-tir <file.tc> | --example <name> [--mode dbg|rls] [--output <path>]\n");
            return 2;
        }
        base.g_file = base.rel_path(src_file);
        var src3: string = file_read_all(src_file);
        lex.tokenize(src3);
        if (sema.has_errors()) { base.emit_diags(); return 1; }
        lex.pos = 0;
        sema.init_anndefs();
        parse.parse_unit();
        sema.run_check();
        sema.run_device_check();
        comptime_fold.comptime_fold_pass();
        sema.meta_trace_flush();
        sema.flag_pass();
        sema.ann_pass();
        if (sema.has_errors()) { base.emit_diags(); return 1; }
        var mod2: string = base.base_no_tc(src_file);
        tir.lower_unit(mod2, src_file);
        if (has_outp == false) { out_p = base.sb_cat4("out/", mode, "/", mod2); }
        var tirp: string = base.sb_cat2(out_p, ".tir");
        base.ensure_parent(tirp);
        file_write_all(tirp, tir.tir_to_text());
        eprint(base.sb_cat3("Generated: ", base.to_bs(tirp), "\n"));
        return 0;
    }

    if (cmd == "emit-tir-ll") {
        // TIR -> LLVM IR 薄后端（设计 §9.2 / Stage 3）。消费 tir.lower_unit 产出的 TIR 文本，
        // 翻译为 LLVM IR 文本。新增加性命令，不动 emit-ll/build（保留自举不动点）。
        var out_p: string = "";
        var has_outp: bool = false;
        var mode: string = "dbg";
        var src_file: string = "";
        var has_src: bool = false;
        var ex_name: string = "";
        var is_example: bool = false;
        var emit_link_deps: bool = false;   // 仅输出 emit 后解析到的外部链接库（.tlib），供 diffpipe 手动 link 复用
        var ai2: i64 = 2;
        var an2: i64 = slice_len(argv) as i64;
        while (ai2 < an2) {
            if (argv[ai2] == "--output") {
                if (ai2 + 1 < an2) { out_p = argv[ai2 + 1]; has_outp = true; }
                ai2 = ai2 + 2; continue;
            }
            if (argv[ai2] == "--mode") {
                if (ai2 + 1 < an2) { mode = argv[ai2 + 1]; }
                ai2 = ai2 + 2; continue;
            }
            if (argv[ai2] == "--example") {
                if (ai2 + 1 < an2) { ex_name = argv[ai2 + 1]; is_example = true; }
                ai2 = ai2 + 2; continue;
            }
            if (argv[ai2] == "--link-deps") {
                emit_link_deps = true;
                ai2 = ai2 + 1; continue;
            }
            if (has_src == false) { src_file = argv[ai2]; has_src = true; }
            ai2 = ai2 + 1;
        }
        if (base.valid_mode(mode) == false) {
            eprint(base.sb_cat3("error: unknown --mode `", mode, "` (expected dbg|rls)\n"));
            return 2;
        }
        if (is_example) {
            var probe: string = base.sb_cat4("cmd /c if exist \"examples\\", ex_name, ".tc\" (exit 0) else (exit 1)", "");
            var prc: i32 = sys_run(probe);
            if (prc != 0) {
                eprint(base.sb_cat3("error: no example named `", ex_name, "`\n"));
                return 2;
            }
            src_file = base.sb_cat3("examples/", ex_name, ".tc");
            has_src = true;
        }
        if (has_src == false) {
            eprint("usage: tc emit-tir-ll <file.tc> | --example <name> [--mode dbg|rls] [--output <path>]\n");
            return 2;
        }
        base.g_file = base.rel_path(src_file);
        var src3: string = file_read_all(src_file);
        lex.tokenize(src3);
        if (sema.has_errors()) { base.emit_diags(); return 1; }
        lex.pos = 0;
        sema.init_anndefs();
        parse.parse_unit();
        sema.run_check();
        sema.run_device_check();
        comptime_fold.comptime_fold_pass();
        sema.meta_trace_flush();
        sema.flag_pass();
        sema.ann_pass();
        if (sema.has_errors()) { base.emit_diags(); return 1; }
        var mod2: string = base.base_no_tc(src_file);
        tir.lower_unit(mod2, src_file);
        if (has_outp == false) { out_p = base.sb_cat4("out/", mode, "/tirll_", mod2); }
        var llp: string = base.sb_cat2(out_p, ".tir.ll");
        base.ensure_parent(llp);
        tir.tir_verify_module();
        var lltext: string = tir_to_ll__tir_to_ll_emit(tir.g_mod);
        file_write_all(llp, lltext);
        eprint(base.sb_cat3("Generated: ", base.to_bs(llp), "\n"));
        // --link-deps：把解析到的外部链接库（.tlib 归档）逐行打到 stdout，
        // 供 diffpipe 新轨手动 clang link 时一并并入（与 tc build 的 g_ext_link 一致）。
        if (emit_link_deps) {
            var nlk: i64 = slice_len(lex.g_ext_link) as i64;
            var elk: i64 = 0;
            while (elk < nlk) {
                print(lex.g_ext_link[elk]); print("\n");
                elk = elk + 1;
            }
        }
        return 0;
    }

    if (cmd == "emit-ll" || cmd == "build" || cmd == "run") {
        var out_p: string = "";
        var has_outp: bool = false;
        var rt_dir: string = "runtime";
        var clang_p: string = "clang";
        var backend: string = "tir";   // S5 收口
        var opt_level: i64 = 0;   // 中端优化等级（--opt/-O）；默认 0=关闭，保护自举不动点；新轨 TIR→LLVM 结构化翻译（§5.3/§5.6 合规）
        var mode: string = "dbg";
        var src_file: string = "";
        var has_src: bool = false;
        var ex_name: string = "";
        var is_example: bool = false;
        var is_lib: bool = false;        // build --lib：预编译外部库为 .tlib（归档 + 接口块）
        var lib_alias: string = "";      // 库规范别名（= 源文件名 stem），用于名字重整前缀
        var ai2: i64 = 2;
        var an2: i64 = slice_len(argv) as i64;
        while (ai2 < an2) {
            if (argv[ai2] == "--output") {
                if (ai2 + 1 < an2) {
                    out_p = argv[ai2 + 1];
                    has_outp = true;
                    ai2 = ai2 + 2;
                    continue;
                }
            }
            if (argv[ai2] == "--mode") {
                if (ai2 + 1 < an2) {
                    mode = argv[ai2 + 1];
                    ai2 = ai2 + 2;
                    continue;
                }
            }
            if (argv[ai2] == "--runtime") {
                if (ai2 + 1 < an2) {
                    rt_dir = argv[ai2 + 1];
                    ai2 = ai2 + 2;
                    continue;
                }
            }
            if (argv[ai2] == "--clang") {
                if (ai2 + 1 < an2) {
                    clang_p = argv[ai2 + 1];
                    ai2 = ai2 + 2;
                    continue;
                }
            }
            // T2「TIR 唯一 IR」：主编译路径（build/emit-ll/run）统一走新轨 TIR→LLVM，
            // 旧轨 codegen_ll 已彻底删除（.tlib 库归档亦迁至 tir_to_ll.build_tlib）
            if (argv[ai2] == "--opt" || argv[ai2] == "-O") {
                opt_level = 1;
                ai2 = ai2 + 1;
                continue;
            }
            // 中性输入：显式追加一个库搜索目录（由调用方如 tote 解析环境变量/T_LIB_PATH 后传入）。
            // tc 自身不读环境变量；这里只接受显式参数，确保包搜索策略留在 tote。
            if (argv[ai2] == "--lib-dir") {
                if (ai2 + 1 < an2) {
                    append(lex.g_lib_dirs, argv[ai2 + 1]);
                    ai2 = ai2 + 2;
                    continue;
                }
            }
            if (argv[ai2] == "--lib") {
                is_lib = true;
                ai2 = ai2 + 1;
                continue;
            }
            if (argv[ai2] == "--debug") {
                lex.g_lib_debug = true;
                ai2 = ai2 + 1;
                continue;
            }
            if (argv[ai2] == "--debug-libs") {
                lex.g_debug_libs = true;
                ai2 = ai2 + 1;
                continue;
            }
            if (argv[ai2] == "--diagnostics") {
                if (ai2 + 1 < an2) { base.g_diag_fmt = argv[ai2 + 1]; ai2 = ai2 + 2; continue; }
            }
            if (argv[ai2] == "--json") { base.g_diag_fmt = "json"; ai2 = ai2 + 1; continue; }
            if (argv[ai2] == "--trace-comptime") { sema.g_meta_trace = true; ai2 = ai2 + 1; continue; }
            if (argv[ai2] == "--example") {
                if (ai2 + 1 < an2) {
                    ex_name = argv[ai2 + 1];
                    is_example = true;
                    ai2 = ai2 + 2;
                    continue;
                }
            }
            // 位置参数：第一个非 flag 即源文件
            if (has_src == false) {
                src_file = argv[ai2];
                has_src = true;
            }
            ai2 = ai2 + 1;
        }
        if (base.valid_mode(mode) == false) {
            eprint(base.sb_cat3("error: unknown --mode `", mode, "` (expected dbg|rls)\n"));
            return 2;
        }

        // cargo 风格 example：源 = examples/<name>.tc，产物 = out/<mode>/examples/<name>.exe
        if (is_example) {
            var probe: string = base.sb_cat4("cmd /c if exist \"examples\\", ex_name, ".tc\" (exit 0) else (exit 1)", "");
            var prc: i32 = sys_run(probe);
            if (prc != 0) {
                eprint(base.sb_cat3("error: no example named `", ex_name, "`\navailable examples:\n"));
                sys_run("cmd /c dir /b examples\\*.tc 2>nul");
                return 2;
            }
            src_file = base.sb_cat3("examples/", ex_name, ".tc");
            has_src = true;
            if (has_outp == false) {
                var exdir: string = base.to_bs(base.sb_cat3("out/", mode, "/examples"));
                sys_run(base.sb_cat5("cmd /c if not exist \"", exdir, "\" mkdir \"", exdir, "\""));
                out_p = base.sb_cat4("out/", mode, "/examples/", ex_name);
                has_outp = true;
            }
        }
        if (has_src == false) {
            eprint("usage: tc build|run <file.tc> | --example <name>\n");
            return 2;
        }

        // 缺省 clang：PATH 上没有时探测标准安装路径。
        // ⚠ 严禁用 sys_run("cmd /c if exist <绝对路径>") 探测：绝对路径触发 arena OOM
        //   （见 sema.tc:12383 同款问题），会污染 arena 致后续 anndefs append 段错误（build 必崩）。
        //   改用稳健的 file_exists 内建（C fopen 直查 / LLVM @tll_file_exists）。
        // hermetic：允许用 TC_CLANG 环境变量显式指定 clang，使「门禁解析一次、
        // 全链路继承」成为现实（gate 解析出 clang 后注入 TC_CLANG，所有 tc 子进程
        // 用同一份 clang 链接，避免隐式依赖 PATH / 硬编码路径漂移）。
        var tc_clang: string = getenv("TC_CLANG");
        if (tc_clang != "") {
            clang_p = tc_clang;
        } else {
            if (clang_p == "clang") {
                if (file_exists("C:/Program Files/LLVM/bin/clang.exe")) {
                    clang_p = "C:/Program Files/LLVM/bin/clang.exe";
                }
            }
        }

        base.g_file = base.rel_path(src_file);
        var src3: string = file_read_all(src_file);
        lex.tokenize(src3);
        if (sema.has_errors()) { base.emit_diags(); return 1; }
        lex.pos = 0;
        sema.init_anndefs();
        if (is_lib) {
            // 预编译库：以规范别名（源文件名 stem）作为名字重整命名空间，
            // 使产出的 .tlib 归档符号（json__version）与下游 import(json) 的重整结果一致。
            lib_alias = base.base_no_tc(src_file);
            base.g_cur_mod = lib_alias;
            lex.g_lib_emit = true;       // 跳过进程级全局发射（t.__ginit / atom 表），避免链接冲突
        }
        parse.parse_unit();
        if (is_lib) { base.g_cur_mod = ""; }
        sema.run_check();
        sema.run_device_check();
        comptime_fold.comptime_fold_pass();
        sema.meta_trace_flush();
        sema.flag_pass();
        sema.ann_pass();
        if (sema.has_errors()) {
            base.emit_diags();
            return 1;
        }
        if (sema.has_warnings()) {
            sema.print_warn_summary();
        }

        var mod2: string = base.base_no_tc(src_file);
        var lltext: string = "";
        var out_ext: string = ".ll";   // 输出文件扩展名（tmir 后端改为 .wat/.s）
        var out_text: string = "";      // 实际写出内容（tir/ll 时为 lltext）

        if (backend == "tmir-wasm") {
            // 路线 §11：sema → mir(pre-TIR 优化) → TIR → tmir → WAT
            // 开启录制：tir.lower_unit 在 TIR 发射期并行录制 pre-TIR 线性 MIR 到 g_mir
            tir__g_recording_mir = true;
            tir.lower_unit(mod2, src_file);
            tir__g_recording_mir = false;
            tir__g_mir.globals = tir__g_mod.globals;   // 非函数部分录制期不含，从 g_mod 取（优化不影响 globals）
            tir__g_mir.types = tir__g_mod.types;
            tir__g_mir.strings = tir__g_mod.strings;
            var mir_mod: MIRModule = mir__mir_from_tir(tir__g_mir);
            mir__mir_run(mir_mod, opt_level);          // 架构/设备/后端无关优化；opt=0 恒等
            var tm: TIRModule = mir__mir_to_tir_lower(mir_mod);   // CFG→线性 TIR，opt=0 字节级还原 g_mod
            var mm: TMIRModule = tmir__tir_to_tmir_lower(tm);
            out_text = codegen_wasm__tmir_to_wasm(mm);
            out_ext = ".wat";
        } else if (backend == "tmir-riscv") {
            // 路线 §11：sema → mir(pre-TIR 优化) → TIR → tmir → rv64 汇编
            tir__g_recording_mir = true;
            tir.lower_unit(mod2, src_file);
            tir__g_recording_mir = false;
            tir__g_mir.globals = tir__g_mod.globals;
            tir__g_mir.types = tir__g_mod.types;
            tir__g_mir.strings = tir__g_mod.strings;
            var mir_mod: MIRModule = mir__mir_from_tir(tir__g_mir);
            mir__mir_run(mir_mod, opt_level);
            var tm: TIRModule = mir__mir_to_tir_lower(mir_mod);
            var mm: TMIRModule = tmir__tir_to_tmir_lower(tm);
            out_text = codegen_riscv__tmir_to_riscv(mm);
            out_ext = ".s";
        } else if (backend == "tir") {
            // S5 新轨（--backend tir 时进入）：sema → TIR → LLVM，结构化翻译（无文本 round-trip，§5.3/§5.6 合规）
            tir.lower_unit(mod2, src_file);
            tir.tir_verify_module();
            lltext = tir_to_ll__tir_to_ll_emit(tir.g_mod);
            out_text = lltext;
        }

        // 输出目录：--output 指定 exe/目录前缀；缺省按 --mode 落入 out/dbg|out/rls
        if (has_outp == false) {
            if (is_lib) {
                // 预编译库产物：模式无关的归档缓存 out/lib/<stem>.tlib（+ 伴随 .ll），
                // 与 resolve_external_lib_archive 的 out/lib 搜索路径一致。
                out_p = base.sb_cat2("out/lib/", mod2);
            } else {
                out_p = base.sb_cat4("out/", mode, "/", mod2);
            }
        }

        var llp: string = base.sb_cat2(out_p, out_ext);
        base.ensure_parent(llp);
        file_write_all(llp, out_text);
        eprint(base.sb_cat3("Generated: ", base.to_bs(llp), "\n"));

        // tmir 后端（wasm/riscv）：产出的 .wat/.s 需目标工具链（wat2wasm / riscv64 gcc）
        // 才能链接运行；此处等价 emit-ll，仅写出 IR 即返回（链接留待工具链机器）。
        if (cmd == "emit-ll" || backend == "tmir-wasm" || backend == "tmir-riscv") {
            return 0;
        }

        // 库预编译（build --lib）：emit-ll 后直接产出 .tlib（归档 + 接口块），不链 exe、不要求 main
        if (is_lib) {
            return tir_to_ll.build_tlib(out_p, lib_alias, clang_p);
        }

        // 无入口时提前报错：否则 lld-link 只会给出
        // "subsystem must be defined" 这类无从下手的链接期诊断。
        // tmir 后端在 emit-ll 等价路径已返回，不会走到此处。
        if (backend == "tir") {
            if (tir_to_ll.g_has_main == false) {
                eprint(base.sb_cat3("error: no entry point: ", base.to_bs(src_file), " 缺少 @main 标注的函数（build/run 需要入口；只想产出 IR 请用 emit-ll）\n"));
                return 1;
            }
        }

        // build：调 clang 一步链接 runtime 出 exe
        var exep: string = base.sb_cat2(out_p, ".exe");
        // 依赖静态库：默认 out/<mode>/deps/t_runtime.lib（tools/build_runtime.mjs 预编译）
        // 缺失时回退直编 <rt_dir> 下的 runtime 源码，保证任意 t 项目开箱即用
        var deps_lib: string = base.sb_cat3("out/", mode, "/deps/t_runtime.lib");
        var use_lib: bool = sema.path_exists(deps_lib);
        var opt: string = "-O2";
        if (mode == "dbg") { opt = "-O0 -gcodeview"; }
        var csb2: StringBuilder = sb_new();
        sb_append_str(csb2, "\"");
        sb_append_str(csb2, clang_p);
        sb_append_str(csb2, "\" ");
        sb_append_str(csb2, opt);
        sb_append_str(csb2, " -o \"");
        sb_append_str(csb2, exep);
        sb_append_str(csb2, "\" -Wl,-subsystem:console -Xlinker /STACK:4294967296,134217728 \"");
        sb_append_str(csb2, llp);
        sb_append_str(csb2, "\" ");
        if (use_lib) {
            sb_append_str(csb2, "\"");
            sb_append_str(csb2, deps_lib);
            sb_append_str(csb2, "\"");
        } else {
            sb_append_str(csb2, "\"");
            sb_append_str(csb2, rt_dir);
            sb_append_str(csb2, "/t_runtime.c\" \"");
            sb_append_str(csb2, rt_dir);
            sb_append_str(csb2, "/t_shim_ll.c\" \"");
            sb_append_str(csb2, rt_dir);
            sb_append_str(csb2, "/t_runtime_gpu.c\" -I \"");
            sb_append_str(csb2, rt_dir);
            sb_append_str(csb2, "\"");
        }
        // 链接模式外部库：把命中的 .tlib 归档（重命名的 .a）一并交给链接器
        var elk: i64 = 0;
        var nelk: i64 = slice_len(lex.g_ext_link) as i64;
        while (elk < nelk) {
            sb_append_str(csb2, " \"");
            sb_append_str(csb2, lex.g_ext_link[elk]);
            sb_append_str(csb2, "\"");
            elk = elk + 1;
        }
        var rc: i32 = sys_run(sb_to_str(csb2));
        if (rc != 0) {
            eprint("clang link failed\n");
            return 1;
        }
        eprint(base.sb_cat3("Built: ", base.to_bs(exep), "\n"));

        // run：构建成功后立即执行，透传子进程退出码（cargo run 语义）
        if (cmd == "run") {
            var run_cmd: string = base.sb_cat3("\"", base.to_bs(exep), "\"");
            var rrc: i32 = sys_run(run_cmd);
            return rrc;
        }
        return 0;
    }

    if (cmd == "test") {
        return test.run_test_cmd(argv);
    }

    eprint("unknown command\n");
    return 2;
}