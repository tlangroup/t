// ── 命名规范校验（复刻 parser.ts validate*Name）───────────────

is_lower_snake fn(name: string) -> bool {
    var n: u64 = str_len(name);
    if (n == 0) {
        return false;
    }
    var c0: u8 = name[0];
    if (c0 < 97 || c0 > 122) {
        return false;
    }
    var i: u64 = 1;
    while (i < n) {
        var c: u8 = name[i];
        var ok: bool = (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95;
        if (ok == false) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

is_upper_snake_name fn(name: string) -> bool {
    var n: u64 = str_len(name);
    if (n == 0) {
        return false;
    }
    var c0: u8 = name[0];
    if (c0 < 65 || c0 > 90) {
        return false;
    }
    var i: u64 = 1;
    while (i < n) {
        var c: u8 = name[i];
        var ok: bool = (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95;
        if (ok == false) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

is_pascal_rest_ok fn(name: string) -> bool {
    var n: u64 = str_len(name);
    var i: u64 = 1;
    while (i < n) {
        var c: u8 = name[i];
        var ok: bool = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95;
        if (ok == false) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// 以 token 下标 ti 处的 line/col 报命名告警
warn_name fn(code: string, msg: string, ti: i64, name_len: i64) -> void {
    var tk: Tok = toks[ti];
    var l: i64 = tk.line as i64;
    var c: i64 = tk.col as i64;
    diag_new(code, "warning", msg, g_file, l, c, l, c + name_len);
}

validate_decl_name fn(name: string, ti: i64) -> void {
    var n: u64 = str_len(name);
    if (n == 0) {
        return;
    }
    var c0: u8 = name[0];
    if (c0 >= 65 && c0 <= 90) {
        if (is_pascal_rest_ok(name) == false) {
            warn_name("T_NAME_TYPE_CAMEL", sb_cat3("type name '", name, "' should be PascalCase (e.g. EntityState)"), ti, n as i64);
        }
    }
}

validate_var_name fn(name: string, ti: i64) -> void {
    if (is_lower_snake(name) == false) {
        warn_name("T_NAME_VAR_SNAKE", sb_cat3("variable name '", name, "' should be snake_case (e.g. entity_id)"), ti, str_len(name) as i64);
    }
}

validate_const_name fn(name: string, ti: i64) -> void {
    if (is_upper_snake_name(name) == false) {
        warn_name("T_NAME_CONST_UPPER", sb_cat3("constant name '", name, "' should be UPPER_SNAKE_CASE (e.g. MAX_RENDER_LAYER)"), ti, str_len(name) as i64);
    }
}

// ── 字符分类（照抄 lexer.tc）───────────────────────────────────

// >>> GEN:xid (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>

// XID_Start / XID_Continue 范围表（十进制 [lo,hi] 闭区间，来自 Unicode UCD）
var xid_start_lo: []i64;
var xid_start_hi: []i64;
var xid_cont_lo: []i64;
var xid_cont_hi: []i64;

utf8_w0 fn(c0: u8) -> i64 {
    if (c0 < 128) { return 1; }
    if (c0 < 224) { return 2; }
    if (c0 < 240) { return 3; }
    return 4;
}

utf8_cp_at fn(src: string, i: i64, n: i64) -> i64 {
    var c0: u8 = src[i];
    if (c0 < 128) { return c0 as i64; }
    if (c0 < 224) {
        var cp: i64 = (c0 & 31) as i64;
        cp = (cp << 6) | (src[i + 1] & 63) as i64;
        return cp;
    }
    if (c0 < 240) {
        var cp: i64 = (c0 & 15) as i64;
        cp = (cp << 6) | (src[i + 1] & 63) as i64;
        cp = (cp << 6) | (src[i + 2] & 63) as i64;
        return cp;
    }
    var cp: i64 = (c0 & 7) as i64;
    cp = (cp << 6) | (src[i + 1] & 63) as i64;
    cp = (cp << 6) | (src[i + 2] & 63) as i64;
    cp = (cp << 6) | (src[i + 3] & 63) as i64;
    return cp;
}

cp_in_ranges fn(cp: i64, lo: []i64, hi: []i64) -> bool {
    var lo_i: i64 = 0;
    var hi_i: i64 = (slice_len(lo) as i64) - 1;
    while (lo_i <= hi_i) {
        var mid: i64 = (lo_i + hi_i) / 2;
        if (cp < lo[mid]) { hi_i = mid - 1; }
        else if (cp > hi[mid]) { lo_i = mid + 1; }
        else { return true; }
    }
    return false;
}

init_xid fn() -> void {
    var _xidv: i64 = 0;
    _xidv = 65; append(xid_start_lo, _xidv);
    _xidv = 90; append(xid_start_hi, _xidv);
    _xidv = 97; append(xid_start_lo, _xidv);
    _xidv = 122; append(xid_start_hi, _xidv);
    _xidv = 170; append(xid_start_lo, _xidv);
    _xidv = 170; append(xid_start_hi, _xidv);
    _xidv = 181; append(xid_start_lo, _xidv);
    _xidv = 181; append(xid_start_hi, _xidv);
    _xidv = 186; append(xid_start_lo, _xidv);
