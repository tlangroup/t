    }
    var __id: i64 = mk_SL(r_Ident, parse_int_str(r_Integer), flag_offset_of(r_anns), flag_has_offset(r_anns), r_anns, -1);
    return __id;
}

parse_flag_decl fn(name: string, anns: i64) -> i64 {
    advance_i();
    var r_Ident: string = "";
    if (cur_t() == "LBracket") {
    expect_tok("LBracket");
    r_Ident = expect_tok("Identifier");
    expect_tok("RBracket");
    }
    var r_anns: i64 = parse_annotations();
    expect_tok("LBrace");
    var r_slot: i64 = -1;
