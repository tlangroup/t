        if (r_slot < 0) { r_slot = r_slot_t; }
    }
    expect_tok("RBrace");
    var __id: i64 = mk_FlagDecl(name, str_or(r_Ident, "u32"), list_concat(anns, r_anns), r_slot, -1);
