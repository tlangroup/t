// ══════════════════════════════════════════════════════════════════
// src/tc.tc — 驱动层 / 入口：命令行分发与 main()
//
// 编译器本体已按编译步骤拆分为多模块，本文件仅做 import 汇总与 CLI 派发：
//   base → lex → parse → sema → codegen_c → codegen_ll
// ══════════════════════════════════════════════════════════════════

import(src.base :: *);
import(src.lex :: *);
import(src.parse :: *);
import(src.sema :: *);
import(src.codegen_c :: *);
import(src.codegen_ll :: *);

main fn() i32 @main {
    var argv: []string = args();
    init_keywords();
    init_node_kinds();
    init_xid();
    // 帮助：任意位置出现 --help / -h，或顶层 help 子命令 → 显式请求帮助，退出 0
    // （不再被当作“参数不足”而归入用法错误 2）
    var hai: i64 = 0;
    var han: i64 = slice_len(argv) as i64;
    while (hai < han) {
        if (argv[hai] == "--help" || argv[hai] == "-h") {
            print_help();
            return 0;
        }
        hai = hai + 1;
    }
    if (han >= 2 && argv[1] == "help") {
        print_help();
        return 0;
    }
    // `tc test` 少于 3 个参数时会被下面的通用门槛吞掉，给出的用法串又不含 test，
    // 于是必须在门之前特判，输出针对性的用法（见 src/tc.tc 的 argv 门槛铁律）。
    if (han == 2 && argv[1] == "test") {
        eprint("usage: tc test <file.tc> [--filter <substr>] [--tag <name>] [--mode dbg|rls] [--no-run]\n");
        return 2;
    }
    if (slice_len(argv) < 3) {
        eprint("usage: tc <lex|check|compile|emit-ll|build|run|test> <file.tc> [--example <name>] [--mode dbg|rls] [--output <path>] [--clang <path>] [--runtime <dir>]\n");
        return 2;
    }
    var cmd: string = argv[1];
    var file: string = argv[2];

    if (cmd == "lex") {
        return run_lex(file);
    }

    if (cmd == "check") {
        // 解析中性开关：--emit-deps（输出依赖图）、--debug-libs（优先 .tlibd）、--debug、
        // --lib-dir（调用方如 tote 注入的库搜索目录）
        // 旗标位置无关：从 argv[2] 起扫描，首个非 -- 旗标即入口文件。
        // 兼容 `tc check <file> --flag` 与 `tc check --flag <file>`（tote 委托时旗标在前）。
        var ai: i64 = 2;
        var an: i64 = slice_len(argv) as i64;
        var found_file: string = "";
        while (ai < an) {
            if (argv[ai] == "--emit-deps") { g_emit_deps = true; ai = ai + 1; continue; }
            if (argv[ai] == "--debug-libs") { g_debug_libs = true; ai = ai + 1; continue; }
            if (argv[ai] == "--debug") { g_lib_debug = true; ai = ai + 1; continue; }
            if (argv[ai] == "--lib-dir") {
                if (ai + 1 < an) { append(g_lib_dirs, argv[ai + 1]); ai = ai + 2; continue; }
            }
            if (found_file == "") { found_file = argv[ai]; }
            ai = ai + 1;
        }
        g_file = path_resolve(found_file);
        var src: string = file_read_all(found_file);
        tokenize(src);
        pos = 0;
        init_anndefs();
        parse_unit();
        run_check();
        flag_pass();
        ann_pass();
        if (g_emit_deps) {
            emit_deps();
            if (has_errors()) { return 1; }
            return 0;
        }
        print_json();
        if (has_errors()) {
            return 1;
        }
        return 0;
    }

    if (cmd == "compile") {
        var out_dir: string = "";
        var has_out: bool = false;
        var mode: string = "dbg";
        var ai: i64 = 3;
        var an: i64 = slice_len(argv) as i64;
        while (ai < an) {
            if (argv[ai] == "--mode") {
                if (ai + 1 < an) {
                    mode = argv[ai + 1];
                    ai = ai + 2;
                    continue;
                }
            }
            if (argv[ai] == "--output") {
                if (ai + 1 < an) {
                    out_dir = argv[ai + 1];
                    has_out = true;
                    ai = ai + 2;
                    continue;
                }
            }
            ai = ai + 1;
        }
        if (valid_mode(mode) == false) {
            eprint(sb_cat3("error: unknown --mode `", mode, "` (expected dbg|rls)\n"));
            return 2;
        }

        g_file = path_resolve(file);
        var src2: string = file_read_all(file);
        tokenize(src2);
        pos = 0;
        init_anndefs();
        parse_unit();
        run_check();
        flag_pass();
        ann_pass();
        if (has_errors()) {
            print_json();
            return 1;
        }

        var mod: string = base_no_tc(file);
        emit_unit(mod);

        if (has_out == false) {
            // 缺省按 --mode 落入 out/dbg|out/rls
            out_dir = sb_cat3("out/", mode, "");
        }

        var hp: string = sb_cat4(out_dir, "/", mod, ".h");
        var cp: string = sb_cat4(out_dir, "/", mod, ".c");
        ensure_parent(hp);
        file_write_all(hp, h_join());
        file_write_all(cp, s_join());
        print(sb_cat6("Generated: ", to_bs(hp), ", ", to_bs(cp), "\n", ""));
        return 0;
    }

    if (cmd == "emit-ll" || cmd == "build" || cmd == "run") {
        var out_p: string = "";
        var has_outp: bool = false;
        var rt_dir: string = "runtime";
        var clang_p: string = "clang";
        var mode: string = "dbg";
        var src_file: string = "";
        var has_src: bool = false;
        var ex_name: string = "";
        var is_example: bool = false;
        var is_lib: bool = false;        // build --lib：预编译外部库为 .tlib（归档 + 接口块）
        var lib_alias: string = "";      // 库规范别名（= 源文件名 stem），用于名字重整前缀
        var ai2: i64 = 2;
        var an2: i64 = slice_len(argv) as i64;
        while (ai2 < an2) {
            if (argv[ai2] == "--output") {
                if (ai2 + 1 < an2) {
                    out_p = argv[ai2 + 1];
                    has_outp = true;
                    ai2 = ai2 + 2;
                    continue;
                }
            }
            if (argv[ai2] == "--mode") {
                if (ai2 + 1 < an2) {
                    mode = argv[ai2 + 1];
                    ai2 = ai2 + 2;
                    continue;
                }
            }
            if (argv[ai2] == "--runtime") {
                if (ai2 + 1 < an2) {
                    rt_dir = argv[ai2 + 1];
                    ai2 = ai2 + 2;
                    continue;
                }
            }
            if (argv[ai2] == "--clang") {
                if (ai2 + 1 < an2) {
                    clang_p = argv[ai2 + 1];
                    ai2 = ai2 + 2;
                    continue;
                }
            }
            // 中性输入：显式追加一个库搜索目录（由调用方如 tote 解析环境变量/T_LIB_PATH 后传入）。
            // tc 自身不读环境变量；这里只接受显式参数，确保包搜索策略留在 tote。
            if (argv[ai2] == "--lib-dir") {
                if (ai2 + 1 < an2) {
                    append(g_lib_dirs, argv[ai2 + 1]);
                    ai2 = ai2 + 2;
                    continue;
                }
            }
            if (argv[ai2] == "--lib") {
                is_lib = true;
                ai2 = ai2 + 1;
                continue;
            }
            if (argv[ai2] == "--debug") {
                g_lib_debug = true;
                ai2 = ai2 + 1;
                continue;
            }
            if (argv[ai2] == "--debug-libs") {
                g_debug_libs = true;
                ai2 = ai2 + 1;
                continue;
            }
            if (argv[ai2] == "--example") {
                if (ai2 + 1 < an2) {
                    ex_name = argv[ai2 + 1];
                    is_example = true;
                    ai2 = ai2 + 2;
                    continue;
                }
            }
            // 位置参数：第一个非 flag 即源文件
            if (has_src == false) {
                src_file = argv[ai2];
                has_src = true;
            }
            ai2 = ai2 + 1;
        }
        if (valid_mode(mode) == false) {
            eprint(sb_cat3("error: unknown --mode `", mode, "` (expected dbg|rls)\n"));
            return 2;
        }

        // cargo 风格 example：源 = examples/<name>.tc，产物 = out/<mode>/examples/<name>.exe
        if (is_example) {
            var probe: string = sb_cat4("cmd /c if exist \"examples\\", ex_name, ".tc\" (exit 0) else (exit 1)", "");
            var prc: i32 = sys_run(probe);
            if (prc != 0) {
                eprint(sb_cat3("error: no example named `", ex_name, "`\navailable examples:\n"));
                sys_run("cmd /c dir /b examples\\*.tc 2>nul");
                return 2;
            }
            src_file = sb_cat3("examples/", ex_name, ".tc");
            has_src = true;
            if (has_outp == false) {
                var exdir: string = to_bs(sb_cat3("out/", mode, "/examples"));
                sys_run(sb_cat5("cmd /c if not exist \"", exdir, "\" mkdir \"", exdir, "\""));
                out_p = sb_cat4("out/", mode, "/examples/", ex_name);
                has_outp = true;
            }
        }
        if (has_src == false) {
            eprint("usage: tc build|run <file.tc> | --example <name>\n");
            return 2;
        }

        // 缺省 clang：PATH 上没有时探测标准安装路径
        if (clang_p == "clang") {
            var crc: i32 = sys_run("cmd /c if exist \"C:\\Program Files\\LLVM\\bin\\clang.exe\" (exit 0) else (exit 1)");
            if (crc == 0) {
                clang_p = "C:/Program Files/LLVM/bin/clang.exe";
            }
        }

        g_file = path_resolve(src_file);
        var src3: string = file_read_all(src_file);
        tokenize(src3);
        pos = 0;
        init_anndefs();
        if (is_lib) {
            // 预编译库：以规范别名（源文件名 stem）作为名字重整命名空间，
            // 使产出的 .tlib 归档符号（json__version）与下游 import(json) 的重整结果一致。
            lib_alias = base_no_tc(src_file);
            g_cur_mod = lib_alias;
            g_lib_emit = true;       // 跳过进程级全局发射（t.__ginit / atom 表），避免链接冲突
        }
        parse_unit();
        if (is_lib) { g_cur_mod = ""; }
        run_check();
        flag_pass();
        ann_pass();
        if (has_errors()) {
            print_json();
            return 1;
        }

        var mod2: string = base_no_tc(src_file);
        emit_llunit(mod2);

        // 输出目录：--output 指定 exe/目录前缀；缺省按 --mode 落入 out/dbg|out/rls
        if (has_outp == false) {
            if (is_lib) {
                // 预编译库产物：模式无关的归档缓存 out/lib/<stem>.tlib（+ 伴随 .ll），
                // 与 resolve_external_lib_archive 的 out/lib 搜索路径一致。
                out_p = sb_cat2("out/lib/", mod2);
            } else {
                out_p = sb_cat4("out/", mode, "/", mod2);
            }
        }

        var llp: string = sb_cat2(out_p, ".ll");
        ensure_parent(llp);
        file_write_all(llp, ll_join());
        print(sb_cat3("Generated: ", to_bs(llp), "\n"));

        if (cmd == "emit-ll") {
            return 0;
        }

        // 库预编译（build --lib）：emit-ll 后直接产出 .tlib（归档 + 接口块），不链 exe、不要求 main
        if (is_lib) {
            return build_tlib(out_p, lib_alias, clang_p);
        }

        // 无入口时提前报错：否则 lld-link 只会给出
        // "subsystem must be defined" 这类无从下手的链接期诊断。
        if (ll_has_main == false) {
            eprint(sb_cat3("error: no entry point: ", to_bs(src_file), " 缺少 @main 标注的函数（build/run 需要入口；只想产出 IR 请用 emit-ll）\n"));
            return 1;
        }

        // build：调 clang 一步链接 runtime 出 exe
        var exep: string = sb_cat2(out_p, ".exe");
        // 依赖静态库：默认 out/<mode>/deps/t_runtime.lib（tools/build_runtime.mjs 预编译）
        // 缺失时回退直编 <rt_dir> 下的 runtime 源码，保证任意 t 项目开箱即用
        var deps_lib: string = sb_cat3("out/", mode, "/deps/t_runtime.lib");
        var use_lib: bool = path_exists(deps_lib);
        var opt: string = "-O2";
        if (mode == "dbg") { opt = "-O0 -gcodeview"; }
        var csb2: StringBuilder = sb_new();
        sb_append_str(csb2, "\"");
        sb_append_str(csb2, clang_p);
        sb_append_str(csb2, "\" ");
        sb_append_str(csb2, opt);
        sb_append_str(csb2, " -o \"");
        sb_append_str(csb2, exep);
        sb_append_str(csb2, "\" -Wl,-subsystem:console \"");
        sb_append_str(csb2, llp);
        sb_append_str(csb2, "\" ");
        if (use_lib) {
            sb_append_str(csb2, "\"");
            sb_append_str(csb2, deps_lib);
            sb_append_str(csb2, "\"");
        } else {
            sb_append_str(csb2, "\"");
            sb_append_str(csb2, rt_dir);
            sb_append_str(csb2, "/t_runtime.c\" \"");
            sb_append_str(csb2, rt_dir);
            sb_append_str(csb2, "/t_shim_ll.c\" -I \"");
            sb_append_str(csb2, rt_dir);
            sb_append_str(csb2, "\"");
        }
        // 链接模式外部库：把命中的 .tlib 归档（重命名的 .a）一并交给链接器
        var elk: i64 = 0;
        var nelk: i64 = slice_len(g_ext_link) as i64;
        while (elk < nelk) {
            sb_append_str(csb2, " \"");
            sb_append_str(csb2, g_ext_link[elk]);
            sb_append_str(csb2, "\"");
            elk = elk + 1;
        }
        var rc: i32 = sys_run(sb_to_str(csb2));
        if (rc != 0) {
            eprint("clang link failed\n");
            return 1;
        }
        print(sb_cat3("Built: ", to_bs(exep), "\n"));

        // run：构建成功后立即执行，透传子进程退出码（cargo run 语义）
        if (cmd == "run") {
            var run_cmd: string = sb_cat3("\"", to_bs(exep), "\"");
            var rrc: i32 = sys_run(run_cmd);
            return rrc;
        }
        return 0;
    }

    if (cmd == "test") {
        return run_test_cmd(argv);
    }

    eprint("unknown command\n");
    return 2;
}

// ══════════════════════════════════════════════════════════════════
// `tc test` —— 测试收集与运行器（docs/syntax/drafts/decl_test.md §5）
//
// 实现要点：**单遍 parse + token 追加**。tokenize() 是 append 语义（不清空
// toks），parse_unit() 遇 Eof 即停。因此：
//   ① tokenize(用户源码)  → 记下此刻 slice_len(toks)（= 用户 Eof 之后）
//   ② pos=0; parse_unit() → 收集 decl_list 里 bd==true 的测试元数据
//   ③ 按元数据生成 runner 源码（一个 @main 入口）
//   ④ tokenize(runner)    → 追加到同一 token 池
//   ⑤ pos=<①的标记>; parse_unit() → runner 声明追加进同一 decl_list
//   ⑥ run_check/flag_pass/ann_pass → 用户代码与 runner 走**同一次**完整 sema
//   ⑦ emit_llunit → clang 链接 → sys_run 执行，透传退出码
//
// 这样既无需重置 nodes/decl_list/g_test_seq 等一大票全局（重置易漏、易污染），
// 也让 runner 里的 format/print 走正常 sema 通路（format 的整数分派依赖 infer）。
// ══════════════════════════════════════════════════════════════════

// 收集到的测试（平行数组；顺序 = decl_list 顺序 = 源码书写顺序）
var tt_fn: []string;      // 合成函数名 __test_<k>
var tt_name: []string;    // 完整显示名（"suite / 子suite / 用例"）
var tt_skip: []bool;      // @skip：不调用，计入 skipped
var tt_xfail: []bool;     // @should_fail：返回 false 才算通过

// 把任意字符串安全嵌入生成源码的字符串字面量（转义 \ 与 "）
tt_esc fn(s: string) string {
    var sb: StringBuilder = sb_new();
    var i: u64 = 0;
    var n: u64 = str_len(s);
    while (i < n) {
        var ch: string = str_slice(s, i, i + 1);
        if (ch == "\\") {
            sb_append_str(sb, "\\\\");
        } else if (ch == "\"") {
            sb_append_str(sb, "\\\"");
        } else {
            sb_append_str(sb, ch);
        }
        i = i + 1;
    }
    return sb_to_str(sb);
}

// 朴素子串匹配（--filter 用；t 无 str_find 内建）
tt_has_sub fn(hay: string, needle: string) bool {
    var hn: u64 = str_len(hay);
    var nn: u64 = str_len(needle);
    if (nn == 0) { return true; }
    if (nn > hn) { return false; }
    var i: u64 = 0;
    while (i + nn <= hn) {
        if (str_slice(hay, i, i + nn) == needle) { return true; }
        i = i + 1;
    }
    return false;
}

// 从声明的注解链上摘掉 `@main`，返回是否摘到。
// 测试文件常常同时是一个可运行程序；`tc test` 要自带入口，两个 @main 会撞车。
// 与其把这类文件一票否决，不如让用户入口在**测试运行**这一趟里退位——
// 函数体照常编译，只是不再是进程入口。
tt_strip_main fn(d: i64) bool {
    var nd: Node = nodes[d];
    var prev: i64 = -1;
    var c: i64 = nd.la;
    while (c >= 0) {
        var k: Child = kids[c];
        if (nodes[k.val].sa == "main") {
            if (prev < 0) {
                nd.la = k.next;
                slice_set(nodes, d, nd);
            } else {
                var pk: Child = kids[prev];
                pk.next = k.next;
                slice_set(kids, prev, pk);
            }
            return true;
        }
        prev = c;
        c = k.next;
    }
    return false;
}

// 注解链上是否带 `@tag(x, ...)` 且含 want（实参节点无论 ident 还是 string 都存 sa）
tt_has_tag fn(head: i64, want: string) bool {
    var it: i64 = head;
    while (it >= 0) {
        var c: Child = kids[it];
        var an: Node = nodes[c.val];
        if (an.sa == "tag") {
            var p: i64 = an.la;
            while (p >= 0) {
                var pc: Child = kids[p];
                var pn: Node = nodes[pc.val];
                if (pn.sa == want) { return true; }
                p = pc.next;
            }
        }
        it = c.next;
    }
    return false;
}

// 生成 runner 源码：一个 `@main` 入口，顺序调用各 __test_k 并汇总
tt_gen_runner fn() string {
    var cnt: i64 = slice_len(tt_fn) as i64;
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "\n__tc_test_main fn() i32 @main {\n");
    sb_append_str(sb, "    var __tp: i64 = 0;\n");
    sb_append_str(sb, "    var __tf: i64 = 0;\n");
    sb_append_str(sb, "    var __ts: i64 = 0;\n");
    sb_append_str(sb, "    print(format(\"\\nrunning {} test(s)\\n\\n\", ");
    sb_append_str(sb, i2s(cnt));
    sb_append_str(sb, "));\n");
    // 判定行**在测试跑完之后**才打印：expect 的失败详情走 stderr，判定行走 stdout，
    // 于是详情总在对应判定行之上（编译器诊断式「证据在前、结论在后」），
    // 而单独重定向 stdout 时能得到一份纯净可机读的用例清单。
    var i: i64 = 0;
    while (i < cnt) {
        var lead: string = sb_cat3("print(\"test ", tt_esc(tt_name[i]), " ... ");
        if (tt_skip[i]) {
            sb_append_str(sb, "    ");
            sb_append_str(sb, lead);
            sb_append_str(sb, "skipped\\n\");\n");
            sb_append_str(sb, "    __ts = __ts + 1;\n");
        } else {
            sb_append_str(sb, "    if (");
            sb_append_str(sb, tt_fn[i]);
            sb_append_str(sb, "()) {\n        ");
            if (tt_xfail[i]) {
                sb_append_str(sb, lead);
                sb_append_str(sb, "FAILED (expected failure, but passed)\\n\");\n");
                sb_append_str(sb, "        __tf = __tf + 1;\n    } else {\n        ");
                sb_append_str(sb, lead);
                sb_append_str(sb, "ok (expected failure)\\n\");\n");
                sb_append_str(sb, "        __tp = __tp + 1;\n    }\n");
            } else {
                sb_append_str(sb, lead);
                sb_append_str(sb, "ok\\n\");\n");
                sb_append_str(sb, "        __tp = __tp + 1;\n    } else {\n        ");
                sb_append_str(sb, lead);
                sb_append_str(sb, "FAILED\\n\");\n");
                sb_append_str(sb, "        __tf = __tf + 1;\n    }\n");
            }
        }
        i = i + 1;
    }
    sb_append_str(sb, "    print(format(\"\\ntest result: {} passed, {} failed, {} skipped\\n\", __tp, __tf, __ts));\n");
    sb_append_str(sb, "    if (__tf > 0) { return 1; }\n");
    sb_append_str(sb, "    return 0;\n}\n");
    return sb_to_str(sb);
}

run_test_cmd fn(argv: []string) i32 {
    var mode: string = "dbg";
    var clang_p: string = "clang";
    var rt_dir: string = "runtime";
    var filter: string = "";
    var tag: string = "";
    var src_file: string = "";
    var has_src: bool = false;
    var no_run: bool = false;       // --no-run：只编译不执行（gate/CI 用）
    var ai: i64 = 2;
    var an: i64 = slice_len(argv) as i64;
    while (ai < an) {
        if (argv[ai] == "--mode") {
            if (ai + 1 < an) { mode = argv[ai + 1]; ai = ai + 2; continue; }
        }
        if (argv[ai] == "--clang") {
            if (ai + 1 < an) { clang_p = argv[ai + 1]; ai = ai + 2; continue; }
        }
        if (argv[ai] == "--runtime") {
            if (ai + 1 < an) { rt_dir = argv[ai + 1]; ai = ai + 2; continue; }
        }
        if (argv[ai] == "--filter") {
            if (ai + 1 < an) { filter = argv[ai + 1]; ai = ai + 2; continue; }
        }
        if (argv[ai] == "--tag") {
            if (ai + 1 < an) { tag = argv[ai + 1]; ai = ai + 2; continue; }
        }
        if (argv[ai] == "--lib-dir") {
            if (ai + 1 < an) { append(g_lib_dirs, argv[ai + 1]); ai = ai + 2; continue; }
        }
        if (argv[ai] == "--no-run") { no_run = true; ai = ai + 1; continue; }
        if (has_src == false) { src_file = argv[ai]; has_src = true; }
        ai = ai + 1;
    }
    if (has_src == false) {
        eprint("usage: tc test <file.tc> [--filter <substr>] [--tag <name>] [--mode dbg|rls] [--no-run]\n");
        return 2;
    }
    if (valid_mode(mode) == false) {
        eprint(sb_cat3("error: unknown --mode `", mode, "` (expected dbg|rls)\n"));
        return 2;
    }
    if (clang_p == "clang") {
        var crc0: i32 = sys_run("cmd /c if exist \"C:\\Program Files\\LLVM\\bin\\clang.exe\" (exit 0) else (exit 1)");
        if (crc0 == 0) { clang_p = "C:/Program Files/LLVM/bin/clang.exe"; }
    }

    // ── ① 用户源码：tokenize + parse ──────────────────────────
    g_file = path_resolve(src_file);
    var src: string = file_read_all(src_file);
    tokenize(src);
    var tok_mark: i64 = slice_len(toks) as i64;   // 用户源码 Eof 之后
    pos = 0;
    init_anndefs();
    parse_unit();

    // ── ② 收集测试；先扫一遍看有没有 @only ────────────────────
    var dn: i64 = slice_len(decl_list) as i64;
    var has_only: bool = false;
    var di: i64 = 0;
    while (di < dn) {
        var d0i: i64 = decl_list[di];
        var d0: Node = nodes[d0i];
        if (d0.kind == "FuncDecl") {
            if (d0.bd && ann_find(d0.la, "only") >= 0) { has_only = true; }
            if (d0.bd == false && ann_find(d0.la, "main") >= 0) {
                if (tt_strip_main(d0i)) {
                    eprint(sb_cat3("note: `", d0.sa,
                        "` 的 @main 在本次 test 运行中被忽略（测试入口由 tc 合成）\n"));
                }
            }
        }
        di = di + 1;
    }

    var total: i64 = 0;      // 源码里的测试总数（过滤前）
    di = 0;
    while (di < dn) {
        var d: i64 = decl_list[di];
        var nd: Node = nodes[d];
        if (nd.kind == "FuncDecl" && nd.bd) {
            total = total + 1;
            var disp: string = nd.sb;
            if (str_len(nd.sc) > 0) { disp = sb_cat3(nd.sc, " / ", nd.sb); }
            var keep: bool = true;
            if (has_only && ann_find(nd.la, "only") < 0) { keep = false; }
            if (str_len(filter) > 0 && tt_has_sub(disp, filter) == false) { keep = false; }
            if (str_len(tag) > 0 && tt_has_tag(nd.la, tag) == false) { keep = false; }
            if (keep) {
                append(tt_fn, nd.sa);
                append(tt_name, disp);
                append(tt_skip, ann_find(nd.la, "skip") >= 0);
                append(tt_xfail, ann_find(nd.la, "should_fail") >= 0);
            }
        }
        di = di + 1;
    }
    var sel: i64 = slice_len(tt_fn) as i64;
    if (total == 0) {
        eprint(sb_cat3("error: ", to_bs(src_file), " 中没有任何测试（`\"名字\" test { ... }`）\n"));
        return 1;
    }
    if (sel == 0) {
        eprint("error: 过滤条件未命中任何测试（检查 --filter / --tag / @only）\n");
        return 1;
    }

    // ── ③④⑤ 生成 runner，追加 token 后接着 parse ────────────
    tokenize(tt_gen_runner());
    pos = tok_mark;
    parse_unit();

    // ── ⑥ 用户代码 + runner 一次性走完整 sema ────────────────
    run_check();
    flag_pass();
    ann_pass();
    if (has_errors()) {
        print_json();
        return 1;
    }

    // ── ⑦ emit → link → run ──────────────────────────────────
    var mod2: string = base_no_tc(src_file);
    emit_llunit(mod2);
    var out_p: string = sb_cat4("out/", mode, "/tests/", mod2);
    var llp: string = sb_cat2(out_p, ".ll");
    ensure_parent(llp);
    file_write_all(llp, ll_join());
    if (ll_has_main == false) {
        eprint("error: internal: 合成的测试入口未产生 @main\n");
        return 1;
    }

    var exep: string = sb_cat2(out_p, ".exe");
    var deps_lib: string = sb_cat3("out/", mode, "/deps/t_runtime.lib");
    var use_lib: bool = path_exists(deps_lib);
    var opt: string = "-O2";
    if (mode == "dbg") { opt = "-O0 -gcodeview"; }
    var csb: StringBuilder = sb_new();
    sb_append_str(csb, "\"");
    sb_append_str(csb, clang_p);
    sb_append_str(csb, "\" ");
    sb_append_str(csb, opt);
    sb_append_str(csb, " -o \"");
    sb_append_str(csb, exep);
    sb_append_str(csb, "\" -Wl,-subsystem:console \"");
    sb_append_str(csb, llp);
    sb_append_str(csb, "\" ");
    if (use_lib) {
        sb_append_str(csb, "\"");
        sb_append_str(csb, deps_lib);
        sb_append_str(csb, "\"");
    } else {
        sb_append_str(csb, "\"");
        sb_append_str(csb, rt_dir);
        sb_append_str(csb, "/t_runtime.c\" \"");
        sb_append_str(csb, rt_dir);
        sb_append_str(csb, "/t_shim_ll.c\" -I \"");
        sb_append_str(csb, rt_dir);
        sb_append_str(csb, "\"");
    }
    var elk: i64 = 0;
    var nelk: i64 = slice_len(g_ext_link) as i64;
    while (elk < nelk) {
        sb_append_str(csb, " \"");
        sb_append_str(csb, g_ext_link[elk]);
        sb_append_str(csb, "\"");
        elk = elk + 1;
    }
    var rc: i32 = sys_run(sb_to_str(csb));
    if (rc != 0) {
        eprint("clang link failed\n");
        return 1;
    }
    if (no_run) {
        print(sb_cat3("Built: ", to_bs(exep), "\n"));
        return 0;
    }
    return sys_run(sb_cat3("\"", to_bs(exep), "\""));
}
