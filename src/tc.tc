// <<< GEN:parser_rules <<<

// ═══════════════════════════════════════════════════════════════
// M7-2: 类型检查器（移植 tc0/types/checker.ts + types.ts）
// ═══════════════════════════════════════════════════════════════

// ── TypeInfo 扁平池（复刻 types.ts TypeInfo）──────────────────
// kind: Scalar/Void/String/StringBuilder/Array/Slice/Map/Pointer/
//       Optional/Struct/Enum/Flag/FlagSet/Union/Variant/Func/Named/Unknown

TI struct {
    kind: string;
    name: string;   // Scalar/Struct/Enum/Flag/FlagSet/Union/Func/Named
    und: string;    // Enum/Flag underlying
    bw: i64;        // Scalar bitWidth
    elem: i64;      // Array/Slice/Pointer/Optional 子类型（TI 索引）
    key: i64;       // Map key
    val: i64;       // Map value
    alen: i64;      // Array length
}

var tis: []TI;

// 函数类型（Func）签名侧池：索引与 tis 对齐（ti_mk 每次同步追加）
var tif_ret: []i64;     // 返回类型 TI 索引
var tif_pstart: []i64;  // 参数 TI 扁平池起点
var tif_pcount: []i64;  // 参数个数
var tif_params: []i64;  // 参数 TI 扁平池

ti_mk fn(kind: string) -> i64 {
    var t: TI;
    t.kind = kind;
    t.name = "";
    t.und = "";
    t.bw = 0;
    t.elem = -1;
    t.key = -1;
    t.val = -1;
    t.alen = 0;
    append(tis, t);
    var i: i64 = (slice_len(tis) as i64) - 1;
    append(tif_ret, -1);
    append(tif_pstart, -1);
    append(tif_pcount, 0);
    return i;
}

ti_named fn(kind: string, name: string) -> i64 {
    var i: i64 = ti_mk(kind);
    var t: TI = tis[i];
    t.name = name;
    slice_set(tis, i, t);
    return i;
}

ti_with_und fn(kind: string, name: string, und: string) -> i64 {
    var i: i64 = ti_named(kind, name);
    var t: TI = tis[i];
    t.und = und;
    slice_set(tis, i, t);
    return i;
}

ti_elem_of fn(kind: string, elem: i64) -> i64 {
    var i: i64 = ti_mk(kind);
    var t: TI = tis[i];
    t.elem = elem;
    slice_set(tis, i, t);
    return i;
}

// 函数类型：ret = 返回类型 TI，参数 TI 存于扁平池 tif_params[pstart .. pstart+pcount)
ti_func fn(ret: i64, pstart: i64, pcount: i64) -> i64 {
    var i: i64 = ti_mk("Func");
    tif_ret[i] = ret;
    tif_pstart[i] = pstart;
    tif_pcount[i] = pcount;
    return i;
}

// ── 标量类型工具（复刻 types.ts）───────────────────────────────

// >>> GEN:scalar_bits (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
is_int_name fn(name: string) -> bool {
    if (name == "u8" || name == "u16" || name == "u32" || name == "u64") {
        return true;
    }
    return name == "i8" || name == "i16" || name == "i32" || name == "i64";
}

is_float_name fn(name: string) -> bool {
    return name == "f16" || name == "f32" || name == "f64";
}

get_bw fn(name: string) -> i64 {
    if (name == "u8" || name == "i8") {
        return 8;
    }
    if (name == "u16" || name == "i16" || name == "f16") {
        return 16;
    }
    if (name == "u32" || name == "i32" || name == "f32") {
        return 32;
    }
    if (name == "u64" || name == "i64" || name == "f64") {
        return 64;
    }
    if (name == "bool") {
        return 1;
    }
    if (name == "atom" || name == "fid") {
        return 64;
    }
    return -1;
}
// <<< GEN:scalar_bits <<<

ti_scalar fn(name: string) -> i64 {
    var i: i64 = ti_named("Scalar", name);
    var t: TI = tis[i];
    t.bw = get_bw(name);
    slice_set(tis, i, t);
    return i;
}

tip_kind fn(i: i64) -> string {
    if (i < 0) {
        return "Unknown";
    }
    var t: TI = tis[i];
    return t.kind;
}

tip_name fn(i: i64) -> string {
    var t: TI = tis[i];
    return t.name;
}

// 条件位置（if / while / for 的条件，match 的 `when` 守卫）只接受 bool。
// Unknown 一律放行：该表达式多半已有诊断，再报一次只会级联噪声。
//
// ⚠ 判据不可写成 `tip_kind(i) == "Scalar" && tip_name(i) != "bool"`。
// 那样只拦住标量，String / Slice / Struct / Enum / Func 全部静默漏过 ——
// `if ("hello")`、`while (some_slice)` 曾零诊断通过（2026-08-02 实测）。
// 正确的形状是白名单：唯有 Scalar/bool 合法，其余皆拒。
is_cond_bool fn(i: i64) -> bool {
    var ck: string = tip_kind(i);
    if (ck == "Unknown") {
        return true;
    }
    if (ck == "Scalar" && tip_name(i) == "bool") {
        return true;
    }
    return false;
}

is_int_ti fn(i: i64) -> bool {
    var t: TI = tis[i];
    if (t.kind != "Scalar") {
        return false;
    }
    return is_int_name(t.name);
}

is_float_ti fn(i: i64) -> bool {
    var t: TI = tis[i];
    if (t.kind != "Scalar") {
        return false;
    }
    return is_float_name(t.name);
}

// typesEqual（递归）
ti_equal fn(ai: i64, bi: i64) -> bool {
    var a: TI = tis[ai];
    var b: TI = tis[bi];
    if (a.kind != b.kind) {
        return false;
    }
    if (a.kind == "Scalar") {
        return a.name == b.name;
    }
    if (a.kind == "Void" || a.kind == "String" || a.kind == "StringBuilder") {
        return true;
    }
    if (a.kind == "Variant" || a.kind == "Unknown") {
        return true;
    }
    if (a.kind == "Array") {
        if (a.alen != b.alen) {
            return false;
        }
        return ti_equal(a.elem, b.elem);
    }
    if (a.kind == "Slice" || a.kind == "Pointer" || a.kind == "Optional") {
        return ti_equal(a.elem, b.elem);
    }
    if (a.kind == "Map" && b.kind == "Map") {
        // 任一侧 key/val 为 Unknown（如 map_new 返回值）即放行，支持 map_new() -> map[K]V 赋值
        var okk: bool = (a.key < 0 || b.key < 0 || ti_equal(a.key, b.key));
        var okv: bool = (a.val < 0 || b.val < 0 || ti_equal(a.val, b.val));
        return okk && okv;
    }
    if (a.kind == "Sym") {
        // 同类型 Sym：同 tag 且同位宽；跨池即不同类型（禁止互赋）
        return a.name == b.name && a.bw == b.bw;
    }
    if (a.kind == "Func") {
        if (tif_pcount[ai] != tif_pcount[bi]) { return false; }
        if (ti_equal(tif_ret[ai], tif_ret[bi]) == false) { return false; }
        var fj: i64 = 0;
        while (fj < tif_pcount[ai]) {
            if (ti_equal(tif_params[tif_pstart[ai] + fj], tif_params[tif_pstart[bi] + fj]) == false) {
                return false;
            }
            fj = fj + 1;
        }
        return true;
    }
    return a.name == b.name;
}

// canExplicitCast
can_cast fn(fi: i64, ti2: i64) -> bool {
    if (ti_equal(fi, ti2)) {
        return true;
    }
    // 数组 ↔ 切片：元素可转型即可（目标为定长数组时要求长度一致）
    var fk: string = tip_kind(fi);
    var tk: string = tip_kind(ti2);
    if ((fk == "Array" || fk == "Slice") && (tk == "Array" || tk == "Slice")) {
        var f: TI = tis[fi];
        var t: TI = tis[ti2];
        if (fk == "Array" && tk == "Array" && f.alen != t.alen) {
            return false;
        }
        if (tip_kind(f.elem) == "Unknown" || tip_kind(t.elem) == "Unknown") {
            return true;
        }
        return can_cast(f.elem, t.elem);
    }
    if (is_int_ti(fi) && is_int_ti(ti2)) {
        return true;
    }
    if (is_float_ti(fi) && is_float_ti(ti2)) {
        return true;
    }
    if (is_int_ti(fi) && is_float_ti(ti2)) {
        return true;
    }
    if (is_float_ti(fi) && is_int_ti(ti2)) {
        return true;
    }
    var f: TI = tis[fi];
    var t: TI = tis[ti2];
    if (f.kind == "Scalar" && f.name == "bool" && is_int_ti(ti2)) {
        return true;
    }
    if (is_int_ti(fi) && t.kind == "Scalar" && t.name == "bool") {
        return true;
    }
    return false;
}

// typeToString（递归）
ti_str fn(i: i64) -> string {
    var t: TI = tis[i];
    if (t.kind == "Scalar") {
        return t.name;
    }
    if (t.kind == "Void") {
        return "void";
    }
    if (t.kind == "String") {
        return "string";
    }
    if (t.kind == "StringBuilder") {
        return "StringBuilder";
    }
    if (t.kind == "Array") {
        return sb_cat4("[", i2s(t.alen), "]", ti_str(t.elem));
    }
    if (t.kind == "Slice") {
        return sb_cat2("[]", ti_str(t.elem));
    }
    if (t.kind == "Map") {
        return sb_cat4("map[", ti_str(t.key), "]", ti_str(t.val));
    }
    if (t.kind == "Sym") {
        return sb_cat5("Sym", i2s(t.bw), "(\"", t.name, "\")");
    }
    if (t.kind == "Pointer") {
        return sb_cat2("*", ti_str(t.elem));
    }
    if (t.kind == "Optional") {
        return sb_cat2("?", ti_str(t.elem));
    }
    if (t.kind == "Variant") {
        return "Variant";
    }
    if (t.kind == "Func") {
        var s: StringBuilder = sb_new();
        sb_append_str(s, "fn(");
        var fj2: i64 = 0;
        while (fj2 < tif_pcount[i]) {
            if (fj2 > 0) { sb_append_str(s, ", "); }
            sb_append_str(s, ti_str(tif_params[tif_pstart[i] + fj2]));
            fj2 = fj2 + 1;
        }
        sb_append_str(s, ") -> ");
        sb_append_str(s, ti_str(tif_ret[i]));
        return sb_to_str(s);
    }
    if (t.kind == "Unknown") {
        return "<unknown>";
    }
    return t.name;
}

// ── 符号表（扁平池 + scope 链）─────────────────────────────────

Sym struct {
    name: string;
    kind: string;   // type/var/func/const
    ti: i64;        // TI 索引
    decl: i64;      // Node 索引（decl），-1 = 无
    scope: i64;
}

var syms: []Sym;
var scope_parents: []i64;

scope_new fn(parent: i64) -> i64 {
    append(scope_parents, parent);
    return (slice_len(scope_parents) as i64) - 1;
}

// 仅在指定 scope 内查找（不上溯）
sym_find_in fn(scope: i64, name: string) -> i64 {
    var n: i64 = slice_len(syms) as i64;
    var i: i64 = 0;
    while (i < n) {
        var s: Sym = syms[i];
        if (s.scope == scope && s.name == name) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// Map.set 语义：已存在则忽略（首定义保留）
sym_define fn(scope: i64, name: string, kind: string, ti2: i64, decl: i64) -> void {
    // 保留标识符（M51）：stdin/stdout/stderr 在表达式位置恒为内建 fid 常量，
    // 若允许同名声明，引用点仍会解析成常量 → 静默错编。故声明位置直接拒绝。
    if (fid_const_of(name) >= 0) {
        fc_err("T_FID_RESERVED_NAME",
            sb_cat3("`", name, "` 是内建文件描述符常量（保留标识符），不可用作变量 / 参数 / 函数 / 类型名；请改用其他名字"),
            decl);
        return;
    }
    if (sym_find_in(scope, name) >= 0) {
        return;
    }
    var s: Sym;
    s.name = name;
    s.kind = kind;
    s.ti = ti2;
    s.decl = decl;
    s.scope = scope;
    append(syms, s);
}

// 沿 scope 链上溯查找
sym_lookup fn(scope: i64, name: string) -> i64 {
    var sc: i64 = scope;
    while (sc >= 0) {
        var f: i64 = sym_find_in(sc, name);
        if (f >= 0) {
            return f;
        }
        sc = scope_parents[sc];
    }
    return -1;
}

var global_scope: i64;
var cur_scope: i64;
var cur_ret: i64;   // 当前函数返回类型（TI 索引）

// ── 诊断定位助手（复刻 tok?.file ?? "" 等）────────────────────

n_file fn(ni: i64) -> string {
    if (ni < 0) {
        return "";
    }
    var n: Node = nodes[ni];
    if (n.ln == 0) {
        return "";
    }
    return g_file;
}

n_line fn(ni: i64) -> i64 {
    if (ni < 0) {
        return 1;
    }
    var n: Node = nodes[ni];
    if (n.ln == 0) {
        return 1;
    }
    return n.ln as i64;
}

n_col fn(ni: i64) -> i64 {
    if (ni < 0) {
        return 1;
    }
    var n: Node = nodes[ni];
    if (n.ln == 0) {
        return 1;
    }
    return n.cl as i64;
}

// errorTypeMismatch（复刻 checker.ts:678）
// 间接调用（通过函数类型变量）的实参校验：元数 + 逐位类型
check_indirect_call fn(e: i64, fti: i64) -> void {
    var n: Node = nodes[e];
    var want: i64 = tif_pcount[fti];
    var got: i64 = 0;
    var c: i64 = n.la;
    while (c >= 0) {
        var k: Child = kids[c];
        if (got < want) {
            var at: i64 = infer_expr(k.val);
            var pt: i64 = tif_params[tif_pstart[fti] + got];
            if (tip_kind(at) != "Unknown" && ti_equal(pt, at) == false && can_cast(at, pt) == false) {
                err_type_mismatch(k.val, pt, at);
            }
        }
        got = got + 1;
        c = k.next;
    }
    if (got != want) {
        fc_err("T_CALL_ARITY",
            sb_cat6("间接调用实参个数不符：", ti_str(fti), " 需要 ", i2s(want),
                sb_cat3(" 个实参，实际给了 ", i2s(got), " 个"), ""), e);
    }
}

err_type_mismatch fn(eni: i64, exp: i64, act: i64) -> void {
    var es: string = ti_str(exp);
    var fs2: string = ti_str(act);
    var l: i64 = n_line(eni);
    var c: i64 = n_col(eni);
    var di: i64 = diag_new("T_TYPE_MISMATCH", "error",
        sb_cat4("type mismatch: expected ", es, " but got ", fs2),
        n_file(eni), l, c, l, c + 5);
    slb_begin();
    slb_add(sb_cat2("expected: ", es));
    slb_add(sb_cat2("found:    ", fs2));
    diag_set_nt(di, slb_head);
}

// ── 整数字面量解析（复刻 BigInt(value) 与 parseInt(value,radix)）──

// BigInt 语义：识别 0x/0X/0b/0B 前缀
lit_u64 fn(v: string) -> u64 {
    var n: u64 = str_len(v);
    var r: u64 = 0;
    if (n >= 2 && v[0] == 48 && (v[1] == 120 || v[1] == 88)) {
        var i: u64 = 2;
        while (i < n) {
            var c: u8 = v[i];
            var d: u64 = 0;
            if (c >= 48 && c <= 57) {
                d = (c - 48) as u64;
            } else {
                if (c >= 97 && c <= 102) {
                    d = (c - 87) as u64;
                } else {
                    d = (c - 55) as u64;
                }
            }
            r = r * 16 + d;
            i = i + 1;
        }
        return r;
    }
    if (n >= 2 && v[0] == 48 && (v[1] == 98 || v[1] == 66)) {
        var j: u64 = 2;
        while (j < n) {
            r = r * 2 + ((v[j] - 48) as u64);
            j = j + 1;
        }
        return r;
    }
    var k: u64 = 0;
    while (k < n) {
        r = r * 10 + ((v[k] - 48) as u64);
        k = k + 1;
    }
    return r;
}

// parseInt(value, radix) 语义：radix=16 接受 0x 前缀；其余按位解析，
// 遇非法字符停止
parse_int_len fn(v: string, radix: i64) -> i64 {
    var n: u64 = str_len(v);
    var r: i64 = 0;
    if (radix == 16) {
        var i: u64 = 0;
        if (n >= 2 && v[0] == 48 && (v[1] == 120 || v[1] == 88)) {
            i = 2;
        }
        while (i < n) {
            var c: u8 = v[i];
            var d: i64 = -1;
            if (c >= 48 && c <= 57) {
                d = (c - 48) as i64;
            }
            if (c >= 97 && c <= 102) {
                d = (c - 87) as i64;
            }
            if (c >= 65 && c <= 70) {
                d = (c - 55) as i64;
            }
            if (d < 0) {
                return r;
            }
            r = r * 16 + d;
            i = i + 1;
        }
        return r;
    }
    if (radix == 2) {
        var j: u64 = 0;
        while (j < n) {
            var c2: u8 = v[j];
            if (c2 != 48 && c2 != 49) {
                return r;
            }
            r = r * 2 + ((c2 - 48) as i64);
            j = j + 1;
        }
        return r;
    }
    var k: u64 = 0;
    while (k < n) {
        var c3: u8 = v[k];
        if (c3 < 48 || c3 > 57) {
            return r;
        }
        r = r * 10 + ((c3 - 48) as i64);
        k = k + 1;
    }
    return r;
}

// ── 类型解析 resolveType（复刻 checker.ts:134）────────────────

resolve_ti fn(tn: i64) -> i64 {
    if (tn < 0) {
        return ti_mk("Unknown");
    }
    var n: Node = nodes[tn];
    if (n.kind == "scalar") {
        if (is_scalar_name(n.sa)) {
            return ti_scalar(n.sa);
        }
        if (n.sa == "void") {
            return ti_mk("Void");
        }
        if (n.sa == "string") {
            return ti_mk("String");
        }
        if (n.sa == "StringBuilder") {
            return ti_mk("StringBuilder");
        }
        return ti_named("Named", n.sa);
    }
    if (n.kind == "array") {
        var elem: i64 = resolve_ti(n.na);
        var length: i64 = 0;
        if (n.nb >= 0) {
            var le: Node = nodes[n.nb];
            if (le.kind == "int") {
                length = parse_int_len(le.sa, le.ia);
            }
        }
        var ai: i64 = ti_elem_of("Array", elem);
        var at: TI = tis[ai];
        at.alen = length;
        slice_set(tis, ai, at);
        return ai;
    }
// >>> GEN:type_slice (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
    if (n.kind == "slice") {
        return ti_elem_of("Slice", resolve_ti(n.na));
    }
// <<< GEN:type_slice <<<
    if (n.kind == "map") {
        var kt: i64 = resolve_ti(n.na);
        var vt: i64 = resolve_ti(n.nb);
        var mi: i64 = ti_mk("Map");
        var mt: TI = tis[mi];
        mt.key = kt;
        mt.val = vt;
        slice_set(tis, mi, mt);
        return mi;
    }
    if (n.kind == "sym") {
        var syi: i64 = ti_named("Sym", n.sa);
        var syt: TI = tis[syi];
        syt.bw = n.ia;
        slice_set(tis, syi, syt);
        return syi;
    }
    if (n.kind == "named") {
        if (n.sa == "TypeInfo") { return ti_mk("TypeInfo"); }
        if (n.sa == "FieldInfo") { return ti_mk("FieldInfo"); }
        var si: i64 = sym_lookup(global_scope, n.sa);
        if (si >= 0) {
            var s: Sym = syms[si];
            return s.ti;
        }
        return ti_named("Named", n.sa);
    }
// >>> GEN:type_resolve (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
    if (n.kind == "variant") {
        return ti_mk("Variant");
    }
    if (n.kind == "flag") {
        return ti_with_und("Flag", "<anonymous>", n.sa);
    }
    if (n.kind == "flag_set") {
        return ti_named("FlagSet", "<anonymous>");
    }
    if (n.kind == "pointer") {
        return ti_elem_of("Pointer", resolve_ti(n.na));
    }
    if (n.kind == "optional") {
        return ti_elem_of("Optional", resolve_ti(n.na));
    }
// <<< GEN:type_resolve <<<
    if (n.kind == "func_type") {
        // 先把参数类型解析到局部表，再整段搬进 tif_params——
        // 嵌套函数类型会在递归里自行 append，直接边解析边 append 会打断本层参数区的连续性。
        var fret: i64 = resolve_ti(n.na);
        var fbuf: []i64;
        var fk: i64 = n.la;
        while (fk >= 0) {
            var fc: Child = kids[fk];
            append(fbuf, resolve_ti(fc.val));
            fk = fc.next;
        }
        var fpstart: i64 = slice_len(tif_params) as i64;
        var fpc: i64 = slice_len(fbuf) as i64;
        var fj0: i64 = 0;
        while (fj0 < fpc) {
            append(tif_params, fbuf[fj0]);
            fj0 = fj0 + 1;
        }
        return ti_func(fret, fpstart, fpc);
    }
    return ti_mk("Unknown");
}

// ── 声明注册 registerDecl（复刻 checker.ts:97）────────────────

// >>> GEN:type_declreg (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
register_decl fn(d: i64) -> void {
    var n: Node = nodes[d];
    if (n.kind == "StructDecl") {
        sym_define(global_scope, n.sa, "type", ti_named("Struct", n.sa), d);
        return;
    }
    if (n.kind == "EnumDecl") {
        sym_define(global_scope, n.sa, "type", ti_with_und("Enum", n.sa, n.sb), d);
        return;
    }
    if (n.kind == "FlagDecl") {
        sym_define(global_scope, n.sa, "type", ti_with_und("Flag", n.sa, n.sb), d);
        return;
    }
    if (n.kind == "FlagSetDecl") {
        sym_define(global_scope, n.sa, "type", ti_named("FlagSet", n.sa), d);
        return;
    }
    if (n.kind == "UnionDecl") {
        sym_define(global_scope, n.sa, "type", ti_named("Union", n.sa), d);
        return;
    }
    if (n.kind == "VariantDecl") {
        sym_define(global_scope, n.sa, "type", ti_named("Variant", n.sa), d);
        register_variant_helpers(d);
        return;
    }
    if (n.kind == "FuncDecl") {
        var fti: i64 = ti_named("Func", n.sa);
        // 记录具名函数的真实签名，供「函数作为值」可赋值性 / 间接调用使用
        var fret2: i64 = resolve_ti(n.na);
        var fbuf2: []i64;
        var fp: i64 = n.lb;
        while (fp >= 0) {
            var fpid: i64 = kids[fp].val;
            var fpn: Node = nodes[fpid];
            append(fbuf2, resolve_ti(fpn.na));
            fp = kids[fp].next;
        }
        var fpstart2: i64 = slice_len(tif_params) as i64;
        var fpc2: i64 = slice_len(fbuf2) as i64;
        var fj1: i64 = 0;
        while (fj1 < fpc2) {
            append(tif_params, fbuf2[fj1]);
            fj1 = fj1 + 1;
        }
        tif_ret[fti] = fret2;
        tif_pstart[fti] = fpstart2;
        tif_pcount[fti] = fpc2;
        sym_define(global_scope, n.sa, "func", fti, d);
        return;
    }
    if (n.kind == "GlobalVarDecl") {
        sym_define(global_scope, n.sa, "var", resolve_ti(n.na), d);
        return;
    }
    if (n.kind == "GlobalConstDecl") {
        var cti: i64 = -1;
        if (n.na >= 0) {
            cti = resolve_ti(n.na);
        } else {
            cti = ti_mk("Unknown");
        }
        sym_define(global_scope, n.sa, "const", cti, d);
        return;
    }
    if (n.kind == "TypeAliasDecl") {
        sym_define(global_scope, n.sa, "type", resolve_ti(n.na), d);
        return;
    }
}
// <<< GEN:type_declreg <<<

// 为 Variant 的每个 case 注册合成函数符号（构造器/判别器/取载荷），
// 指向合成 FuncDecl 节点但不在 decl_list 中，故仅作类型检查可见、不被 emitter 重复发射。
register_variant_helpers fn(d: i64) -> void {
    var n: Node = nodes[d];
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var vc: Node = nodes[k.val];
        var cname: string = vc.sa;
        // 构造器 Name_from_Case(载荷?) -> Name
        var ffrom: string = sb_cat3(n.sa, "_from_", cname);
        var retNode: i64 = mk_named(n.sa, -1);
        var plist: i64 = -1;
        var ptail: i64 = -1;
        if (vc.na >= 0) {
            var pid: i64 = mk_P("v", vc.na, -1, -1);
            ptail = list_push(plist, ptail, pid);
            if (plist < 0) {
                plist = ptail;
            }
        }
        var fdecl1: i64 = mk_FuncDecl(ffrom, true, false, retNode, -1, plist, -2, -1);
        sym_define(global_scope, ffrom, "func", ti_named("Func", ffrom), fdecl1);

        // 判别器 Name_is_Case(self: Name) -> bool
        var fis: string = sb_cat3(n.sa, "_is_", cname);
        var retBool: i64 = mk_scalar("bool", -1);
        var pid2: i64 = node_new("P");
        var pn2: Node = nodes[pid2];
        pn2.sa = "self";
        var selfTn: i64 = mk_named(n.sa, -1);
        pn2.na = selfTn;
        slice_set(nodes, pid2, pn2);
        var plist2: i64 = -1;
        var ptail2: i64 = -1;
        ptail2 = list_push(plist2, ptail2, pid2);
        if (plist2 < 0) {
            plist2 = ptail2;
        }
        var fdecl2: i64 = mk_FuncDecl(fis, true, false, retBool, -1, plist2, -2, -1);
        sym_define(global_scope, fis, "func", ti_named("Func", fis), fdecl2);

        // 取载荷 Name_as_Case(self: Name) -> 载荷（仅当携带载荷）
        if (vc.na >= 0) {
            var fas: string = sb_cat3(n.sa, "_as_", cname);
            var fdecl3: i64 = mk_FuncDecl(fas, true, false, vc.na, -1, plist2, -2, -1);
            sym_define(global_scope, fas, "func", ti_named("Func", fas), fdecl3);
        }
        c = k.next;
    }
}

// ── 列表助手 ───────────────────────────────────────────────────

list_last_val fn(head: i64) -> i64 {
    var c: i64 = head;
    var last: i64 = -1;
    while (c >= 0) {
        var k: Child = kids[c];
        last = k.val;
        c = k.next;
    }
    return last;
}

list_count fn(head: i64) -> i64 {
    var c: i64 = head;
    var n: i64 = 0;
    while (c >= 0) {
        var k: Child = kids[c];
        n = n + 1;
        c = k.next;
    }
    return n;
}

// ── 内置函数返回类型（复刻 checker.ts:616）────────────────────

// >>> GEN:builtins (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
builtin_ret fn(name: string) -> i64 {
    if (name == "assert_eq" || name == "assert_true" || name == "assert_false") {
        return ti_mk("Void");
    }
    if (name == "assert_panic" || name == "flag_set" || name == "print") {
        return ti_mk("Void");
    }
    if (name == "println" || name == "append" || name == "slice_set") {
        return ti_mk("Void");
    }
    if (name == "exit" || name == "eprint" || name == "sb_append_str") {
        return ti_mk("Void");
    }
    if (name == "sb_append_char" || name == "sb_append_u64" || name == "sb_append_i64") {
        return ti_mk("Void");
    }
    if (name == "sb_clear") {
        return ti_mk("Void");
    }
    if (name == "flag_get") {
        return ti_scalar("u32");
    }
    if (name == "sys_run") {
        return ti_scalar("i32");
    }
    if (name == "str_len" || name == "slice_len") {
        return ti_scalar("u64");
    }
    if (name == "str_at") {
        return ti_scalar("u8");
    }
    if (name == "file_read_all" || name == "path_resolve" || name == "str_slice") {
        return ti_mk("String");
    }
    if (name == "sb_to_str" || name == "to_string") {
        return ti_mk("String");
    }
    if (name == "int_to_str" || name == "i2s") {
        return ti_mk("String");
    }
    if (name == "file_write_all" || name == "file_exists") {
        return ti_scalar("bool");
    }
    if (name == "args") {
        return ti_elem_of("Slice", ti_mk("String"));
    }
    if (name == "sb_new") {
        return ti_mk("StringBuilder");
    }
    if (name == "map_new") {
        return ti_mk("Map");
    }
    if (name == "map_set") {
        return ti_mk("Void");
    }
    if (name == "map_has" || name == "map_del") {
        return ti_scalar("bool");
    }
    if (name == "map_len") {
        return ti_scalar("i64");
    }
    if (name == "map_get") {
        return ti_mk("Unknown");
    }
    if (name == "ti_name" || name == "fi_name" || name == "fi_type_name") {
        return ti_mk("String");
    }
    if (name == "ti_size" || name == "ti_kind" || name == "ti_field_count" || name == "fi_offset" || name == "fi_type_size" || name == "fi_tag") {
        return ti_scalar("i64");
    }
    if (name == "ti_field") {
        return ti_mk("FieldInfo");
    }
    if (name == "fi_is_ptr") {
        return ti_scalar("bool");
    }
    if (name == "sym_str") {
        return ti_mk("String");
    }
    if (name == "sym_release" || name == "sym_release_all") {
        return ti_mk("Void");
    }
    if (name == "atom_str") {
        return ti_mk("String");
    }
    // 文件描述符内建（M51）
    if (name == "fopen") {
        return ti_scalar("fid");
    }
    if (name == "fclose" || name == "fflush" || name == "fmt_register") {
        return ti_mk("Void");
    }
    if (name == "fid_is_open") {
        return ti_scalar("bool");
    }
    // 读路径 EOF 探针（M52，Option B）：`f > T` 返回裸 T，EOF 时给默认值，
    // 「是否还有数据」由此探针独立表达。
    if (name == "fid_eof") {
        return ti_scalar("bool");
    }
    if (name == "fid_format") {
        return ti_scalar("atom");
    }
    if (name == "fid_error") {
        return ti_mk("String");
    }
    if (name == "fseek") {
        return ti_scalar("bool");
    }
    if (name == "ftell") {
        return ti_scalar("i64");
    }
    // 时间格式化（M56）/ 解析与固定时区（M57）：
    // now() / parse_time* / time_invalid() 返回微秒 epoch（i64），format_time* 返回字符串
    if (name == "now" || name == "time_invalid" || name == "parse_time" || name == "parse_time_local") {
        return ti_scalar("i64");
    }
    if (name == "format_time" || name == "format_time_local" || name == "format_time_tz") {
        return ti_mk("String");
    }
    // 格式化（Python 格式规范迷你语言子集）
    if (name == "format_int" || name == "format_uint" || name == "format_float" || name == "format_str" || name == "format_bool" || name == "format_char") {
        return ti_mk("String");
    }
    if (name == "sb_append_fmt_int" || name == "sb_append_fmt_uint" || name == "sb_append_fmt_float" || name == "sb_append_fmt_str" || name == "sb_append_fmt_bool" || name == "sb_append_fmt_char") {
        return ti_mk("Void");
    }
    return ti_mk("Unknown");
}
// <<< GEN:builtins <<<

// ── match 穷尽性：enum case 覆盖分析 ────────────────────────────
// 裁定（2026-08-02）：scrutinee 为 enum 且**每个**成员都被一条无守卫的
// `X.Case` 臂覆盖时，该 match 视为穷尽，`_` 通配变为可选。
// 这样给 enum 新增成员会让所有旧 match 立刻报错、强制回访 —— 正是穷尽性检查的价值所在；
// 若一律要求 `_`，新成员会静默落进兜底分支，漏处理无从察觉。

// C2 模式消歧（PascalCase 约定）：模式位置的裸标识符，首字母大写即 CaseName，
// 小写才是绑定名。没有这条约定，`Red => ...` 会被当成不可反驳绑定 ——
// 它匹配一切、让后续所有臂不可达，且完全静默，是最难察觉的一类错。
starts_upper fn(name: string) -> bool {
    if (str_len(name) == 0) {
        return false;
    }
    var c0: u8 = name[0];
    return c0 >= 65 && c0 <= 90;
}

// scrutinee 所属 enum 是否含有名为 cname 的成员。
enum_has_case fn(scr: i64, cname: string) -> bool {
    if (tip_kind(scr) != "Enum") {
        return false;
    }
    var hsi: i64 = sym_lookup(global_scope, tip_name(scr));
    if (hsi < 0) {
        return false;
    }
    var hsym: Sym = syms[hsi];
    if (hsym.decl < 0) {
        return false;
    }
    var hd: Node = nodes[hsym.decl];
    if (hd.kind != "EnumDecl") {
        return false;
    }
    var hc: i64 = hd.lb;
    while (hc >= 0) {
        var hk: Child = kids[hc];
        var hv: Node = nodes[hk.val];
        if (hv.sa == cname) {
            return true;
        }
        hc = hk.next;
    }
    return false;
}

// 某个 case 名是否被 match 的某条「无守卫」臂以 `X.Case` 形式覆盖。
// 带守卫的臂不算覆盖：守卫可能为假，控制流仍会漏出。
// 只比对 member 模式的字段名而不校验限定符 —— scrutinee 已限定为该 enum，
// 若写成别的 enum 的成员，会先被上面的 arm 模式类型检查拦下。
match_covers_case fn(e: i64, cname: string) -> bool {
    var mn: Node = nodes[e];
    var mc: i64 = mn.la;
    while (mc >= 0) {
        var mk: Child = kids[mc];
        var arm: Node = nodes[mk.val];
        if (arm.nb < 0 && arm.na >= 0) {
            var pat: Node = nodes[arm.na];
            if (pat.kind == "member" && pat.sa == cname) {
                return true;
            }
        }
        mc = mk.next;
    }
    return false;
}

// scrutinee 类型 scr 若是 enum，判断 match 是否覆盖了它的全部成员。
// 非 enum、查不到声明、或成员表为空 → 一律返回 false（退回「需要 `_`」的旧判据）。
enum_all_cases_covered fn(e: i64, scr: i64) -> bool {
    if (tip_kind(scr) != "Enum") {
        return false;
    }
    var esi: i64 = sym_lookup(global_scope, tip_name(scr));
    if (esi < 0) {
        return false;
    }
    var esym: Sym = syms[esi];
    if (esym.decl < 0) {
        return false;
    }
    var ednode: Node = nodes[esym.decl];
    if (ednode.kind != "EnumDecl") {
        return false;
    }
    if (ednode.lb < 0) {
        return false;
    }
    var covered: bool = true;
    var vc: i64 = ednode.lb;
    while (vc >= 0) {
        var vk: Child = kids[vc];
        var vnode: Node = nodes[vk.val];
        if (match_covers_case(e, vnode.sa) == false) {
            covered = false;
        }
        vc = vk.next;
    }
    return covered;
}

// 未被覆盖的 enum 成员，形如 `Color.Green, Color.Blue`；非 enum 或已全覆盖时返回空串。
// 供 T_MATCH_NONEXHAUSTIVE 指名道姓地报缺口，而不是只说「加个 `_`」。
enum_missing_cases fn(e: i64, scr: i64) -> string {
    if (tip_kind(scr) != "Enum") {
        return "";
    }
    var esi: i64 = sym_lookup(global_scope, tip_name(scr));
    if (esi < 0) {
        return "";
    }
    var esym: Sym = syms[esi];
    if (esym.decl < 0) {
        return "";
    }
    var ednode: Node = nodes[esym.decl];
    if (ednode.kind != "EnumDecl") {
        return "";
    }
    var sb: StringBuilder = sb_new();
    var cnt: i64 = 0;
    var vc: i64 = ednode.lb;
    while (vc >= 0) {
        var vk: Child = kids[vc];
        var vnode: Node = nodes[vk.val];
        if (match_covers_case(e, vnode.sa) == false) {
            if (cnt > 0) {
                sb_append_str(sb, ", ");
            }
            sb_append_str(sb, tip_name(scr));
            sb_append_str(sb, ".");
            sb_append_str(sb, vnode.sa);
            cnt = cnt + 1;
        }
        vc = vk.next;
    }
    return sb_to_str(sb);
}

// ── 文件描述符内建的编译期校验（M51）──────────────────────────

fid_atom_allowed fn(sel: string) -> string {
    if (sel == "mode") {
        return ":read / :write / :append / :read_binary / :write_binary / :append_binary";
    }
    if (sel == "kind") {
        return ":text / :binary";
    }
    return ":text / :json / :rawbin / :protobuf";
}

fid_atom_ok fn(sel: string, v: string) -> bool {
    if (sel == "mode") {
        if (v == "read" || v == "write" || v == "append") {
            return true;
        }
        return v == "read_binary" || v == "write_binary" || v == "append_binary";
    }
    if (sel == "kind") {
        return v == "text" || v == "binary";
    }
    return v == "text" || v == "json" || v == "rawbin" || v == "protobuf";
}

// 诊断码分轴：mode 轴（fopen 打开方式）与 format 轴（fmt_register 的类别 / 格式）
// 各自成码 —— 「格式取值非法」却报 BAD_MODE 会误导定位。
fid_code_lit fn(sel: string) -> string {
    if (sel == "mode") { return "T_FID_MODE_NOT_LITERAL"; }
    return "T_FID_FORMAT_NOT_LITERAL";
}
fid_code_bad fn(sel: string) -> string {
    if (sel == "mode") { return "T_FID_BAD_MODE"; }
    return "T_FID_BAD_FORMAT";
}

// atom 形参必须是字面量且取值在白名单内 —— 打开方式 / 格式决定字节形态，
// 若允许运行期取值，`<` 的语义就不再是编译期确定的（违反 L-02 / L-03）。
check_atom_arg fn(a: i64, what: string, sel: string, anchor: i64) -> void {
    if (a < 0) {
        fc_err(fid_code_lit(sel),
            sb_cat3(what, " 缺失；必须是 atom 字面量，取值：", fid_atom_allowed(sel)), anchor);
        return;
    }
    var an: Node = nodes[a];
    if (an.kind != "atom") {
        fc_err(fid_code_lit(sel),
            sb_cat3(what, " 必须是 atom **字面量**（编译期可判定），取值：", fid_atom_allowed(sel)), a);
        return;
    }
    if (fid_atom_ok(sel, an.sa) == false) {
        fc_err(fid_code_bad(sel),
            sb_cat6(what, " 取值非法：`:", an.sa, "`；合法取值：", fid_atom_allowed(sel), ""), a);
    }
}

// 时间格式化 spec 字段码扫描（M56/M57）：编译期校验 format_time / format_time_local /
// format_time_tz 的 spec 字面量。已知字段码：
//   最小集 %Y %y %m %d %H %M %S %f %%
//   扩展集 %a %A %b %B %p %I %j %w %U %W %z %Z
//   locale 集（M57）%c %x %X
// 其余 `%?` 一律报 T_TIME_BAD_SPEC。运行期对非常量 spec 宽容原样保留。
check_time_spec fn(spec: string, d: i64) -> void {
    var sl: u64 = str_len(spec);
    var i: u64 = 0;
    while (i < sl) {
        var c: i64 = spec[i] as i64;
        if (c != 37) {                 // '%'
            i = i + 1;
            continue;
        }
        if (i + 1 >= sl) {
            fc_err("T_TIME_BAD_SPEC",
                "时间格式串以 `%` 结尾，缺少后续字段码；合法示例：`%Y-%m-%d %H:%M:%S`", d);
            return;
        }
        var x: i64 = spec[i + 1] as i64;
        if (x == 89 || x == 121 || x == 109 || x == 100 || x == 72
            || x == 77 || x == 83 || x == 102 || x == 37
            || x == 97 || x == 65 || x == 98 || x == 66 || x == 112
            || x == 73 || x == 106 || x == 119 || x == 85 || x == 87
            || x == 122 || x == 90
            || x == 99 || x == 120 || x == 88) {
            i = i + 2;                 // Y y m d H M S f % a A b B p I j w U W z Z c x X
            continue;
        }
        fc_err("T_TIME_BAD_SPEC",
            "时间格式串含未知字段码（以 `%` 打头的非法保留序列）；支持 %Y %y %m %d %H %M %S %f %% %a %A %b %B %p %I %j %w %U %W %z %Z %c %x %X",
            d);
        i = i + 2;
    }
}

// 时间**解析** spec 字段码扫描（M57）：parse_time / parse_time_local 的白名单
// 严格小于格式化白名单 —— %w %U %W 是从日期推导出的派生量，反过来定不出唯一时刻；
// %Z 是自由文本时区缩写（"CST" 同时是北京和美中部），无从消歧。四者一律拒绝，
// 而不是运行期静默返回哨兵：让"这个串根本不该用于解析"在编译期就暴露。
check_time_parse_spec fn(spec: string, d: i64) -> void {
    var sl: u64 = str_len(spec);
    var i: u64 = 0;
    while (i < sl) {
        var c: i64 = spec[i] as i64;
        if (c != 37) {
            i = i + 1;
            continue;
        }
        if (i + 1 >= sl) {
            fc_err("T_TIME_BAD_SPEC",
                "时间解析串以 `%` 结尾，缺少后续字段码；合法示例：`%Y-%m-%d %H:%M:%S`", d);
            return;
        }
        var x: i64 = spec[i + 1] as i64;
        if (x == 89 || x == 121 || x == 109 || x == 100 || x == 72
            || x == 77 || x == 83 || x == 102 || x == 37
            || x == 97 || x == 65 || x == 98 || x == 66 || x == 112
            || x == 73 || x == 106 || x == 122
            || x == 99 || x == 120 || x == 88) {
            i = i + 2;                 // Y y m d H M S f % a A b B p I j z c x X
            continue;
        }
        if (x == 119 || x == 85 || x == 87 || x == 90) {
            fc_err("T_TIME_PARSE_UNSUPPORTED",
                "时间解析不支持该字段码：%w / %U / %W 是日期的派生量（无法反推唯一日期），%Z 是有歧义的时区缩写；请改用 %z 表示数值偏移",
                d);
            i = i + 2;
            continue;
        }
        fc_err("T_TIME_BAD_SPEC",
            "时间解析串含未知字段码（以 `%` 打头的非法保留序列）；解析支持 %Y %y %m %d %H %M %S %f %% %a %A %b %B %p %I %j %z %c %x %X",
            d);
        i = i + 2;
    }
}

// 数字/字符串格式化 spec 文法校验（M54/M55 补充）：编译期校验 format_int / format_uint /
// format_float / format_str / format_bool / format_char 的 spec 字面量。
// 复刻 runtime/t_runtime.c fmt_parse 的外壳剥除（剥 {} 仅当首尾都是；剥到最后一个 ':'），
// 并在文法解析后强制"无残留字符"。因此能拦住 {:z}（非法 type）、{:>10z}（残留）这类
// 运行期会被静默吞掉的笔误。非常量 spec 维持运行期宽松（fmt_parse 贪婪吞尾）。
check_fmt_spec fn(spec: string, d: i64) -> void {
    var sl: u64 = str_len(spec);
    // 是否像「模板」（含替换字段 {…}）：用户常把 format_int 当成 str.format 用，
    // 写了 "x={0}" 这类带字面量文本的串；此时报错顺手提示改用 format()。
    var g_tmpl_hint: bool = false;
    var gi: u64 = 0;
    while (gi < sl) { if ((spec[gi] as i64) == 123) { g_tmpl_hint = true; } gi = gi + 1; }
    var start: u64 = 0;
    var end: u64 = sl;
    if (sl >= 2 && (spec[0] as i64) == 123 && (spec[sl - 1] as i64) == 125) { start = 1; end = sl - 1; } // 剥 {}
    var j: u64 = start;
    var lc: i64 = -1;
    while (j < end) { if ((spec[j] as i64) == 58) { lc = j as i64; } j = j + 1; }  // 最后一个 ':'
    if (lc >= 0) { start = (lc + 1) as u64; }
    var i: u64 = start;
    // [fill]align
    if (end - i >= 2) {
        var c1: i64 = spec[i] as i64;
        var c2: i64 = spec[i + 1] as i64;
        if (c2 == 60 || c2 == 62 || c2 == 61 || c2 == 94) { i = i + 2; }       // < > = ^
        else if (c1 == 60 || c1 == 62 || c1 == 61 || c1 == 94) { i = i + 1; }
    } else if (end - i >= 1) {
        var c1: i64 = spec[i] as i64;
        if (c1 == 60 || c1 == 62 || c1 == 61 || c1 == 94) { i = i + 1; }
    }
    if (end - i >= 1) { var c: i64 = spec[i] as i64; if (c == 43 || c == 45 || c == 32) { i = i + 1; } } // + - ' '
    if (end - i >= 1) { var c: i64 = spec[i] as i64; if (c == 35) { i = i + 1; } }                     // '#'
    if (end - i >= 1) { var c: i64 = spec[i] as i64; if (c == 48) { i = i + 1; } }                     // '0'
    while (end - i >= 1) { var c: i64 = spec[i] as i64; if (c >= 48 && c <= 57) { i = i + 1; } else { break; } } // width
    if (end - i >= 1) { var c: i64 = spec[i] as i64; if (c == 44 || c == 95) { i = i + 1; } }           // ',' '_'
    if (end - i >= 1) { var c: i64 = spec[i] as i64; if (c == 46) {                                       // '.' precision
        i = i + 1;
        while (end - i >= 1) { var d2: i64 = spec[i] as i64; if (d2 >= 48 && d2 <= 57) { i = i + 1; } else { break; } }
    } }
    var has_type: bool = false;
    var tc: i64 = 0;
    if (end - i >= 1) { has_type = true; tc = spec[i] as i64; i = i + 1; }
    if (has_type) {
        // 允许的类型字符集（与 reference.md §3.10.2 一致）；'!' 是 format_bool 的专属
        // 合法 type（runtime t_format_bool 对未识别 type 一律走 true/false 分支，故 lenient）。
        var ok: bool = (tc == 98 || tc == 99 || tc == 100 || tc == 101 || tc == 69
            || tc == 102 || tc == 70 || tc == 103 || tc == 71 || tc == 110
            || tc == 111 || tc == 115 || tc == 120 || tc == 88 || tc == 37
            || tc == 33); // b c d e E f F g G n o s x X %  + '!'(bool)
        if (!ok) {
            var m1: string = "格式化 spec 含非法类型字符；M54 允许的 type 为 b c d e E f F g G n o s x X %";
            if (g_tmpl_hint) {
                m1 = sb_cat2(m1, "；若需带字面量文本的模板（如 \"x={0}\"），请改用 str.format：format(\"x={0}\", v) 或 \"x={0}\".format(v)");
            }
            fc_err("T_FMT_BAD_SPEC", m1, d);
            return;
        }
    }
    if (i < end) {
        var m2: string = "格式化 spec 文法非法（含无法解析的残留字符）；合法示例：\":>10\" \"{:>10.2f}\" \"#x\" \"{:,}\"";
        if (g_tmpl_hint) {
            m2 = sb_cat2(m2, "；若需带字面量文本的模板（如 \"x={0}\"），请改用 str.format：format(\"x={0}\", v) 或 \"x={0}\".format(v)");
        }
        fc_err("T_FMT_BAD_SPEC", m2, d);
    }
}

// 序列化右操作数类型白名单（M51 v1）：标量（含 atom / bool / 浮点）与 string。
// 结构体 / slice / map 需走 type_info 反射逐字段展开，留待 v2。
check_serializable fn(e: i64, sti: i64) -> void {
    var k: string = tip_kind(sti);
    if (k == "Scalar" || k == "String" || k == "Unknown") {
        return;
    }
    fc_err("T_FID_UNSERIALIZABLE",
        sb_cat3("`<` 不支持序列化该类型：", ti_str(sti),
            "；v1 仅支持标量（整数 / 浮点 / bool / atom / fid）与 string，聚合类型请逐字段写出"), e);
}

// ── format 模板替换字段（M55）──────────────────────────────
//
// Python `str.format` 分两层：**替换字段**（`{0}` 选第几个实参）与**格式规范**
// （`:` 之后的 `>10.2f`，M54 已实现）。这里补上层。
//
// t 无变参、无 kwargs、无 Any，做不出运行期模板引擎，故三条硬约束：
//   ① 模板必须是字符串**字面量** —— 编译期解析，运行期零模板开销（L-03 静态优先）
//   ② 只有位置索引 `{0}` 与自动编号 `{}`；`{name}` 无 kwargs 可查，直接报错
//   ③ 脱糖成提升函数 `__fmt_N`，体内 StringBuilder 顺序拼接，实参按值传入
//
// 实参在**调用点**求值一次后传参，故 `"{0} {0}"` 只求值一次 —— 这是提升函数
// 相对宏展开的关键优势（`format("{0}{0}", next())` 不会调用两次 next）。
var g_fmt_counter: i64;
var g_fmt_ak: [64]i64;   // 各值实参的种类码（见 fmt_kind_of）
var g_fmt_at: [64]i64;   // 各值实参对应的形参类型节点

// 值类型 → 种类码。-1 表示不可格式化（聚合类型等）。
// ⚠ 整数字面量按最小无符号宽度推断（`42` 是 u8），故必须按名字判有无符号，
//    不能只比 "i64"，否则 `format("{0}", 42)` 会错走有符号通道。
fmt_kind_of fn(t: i64) -> i64 {
    var k: string = tip_kind(t);
    if (k == "String") { return 3; }
    if (k == "Scalar") {
        var nm: string = tip_name(t);
        if (nm == "bool") { return 4; }
        if (is_float_name(nm)) { return 2; }
        if (nm == "u8" || nm == "u16" || nm == "u32" || nm == "u64") { return 1; }
        if (is_int_name(nm)) { return 0; }
    }
    return -1;
}

fmt_append_fn fn(k: i64) -> string {
    if (k == 0) { return "sb_append_fmt_int"; }
    if (k == 1) { return "sb_append_fmt_uint"; }
    if (k == 2) { return "sb_append_fmt_float"; }
    if (k == 3) { return "sb_append_fmt_str"; }
    return "sb_append_fmt_bool";
}

// 形参类型节点：string 与各标量都由 mk_scalar 承载（见 parse_type:4959/4993）
fmt_type_node fn(t: i64) -> i64 {
    if (tip_kind(t) == "String") { return mk_scalar("string", -1); }
    return mk_scalar(tip_name(t), -1);
}

// 把一条语句追加进函数体链表。head 为 -1 时同时把它设成表头。
// 返回新的 tail；调用方需自行同步 head（与 synthesize_loader 的定式一致）。
fmt_push_stmt fn(head: i64, tail: i64, stmt: i64) -> i64 {
    return list_push(head, tail, stmt);
}

// format(tmpl, a, b, ...) 的脱糖入口。
// 成功则**就地改写** e 为 `__fmt_N(a, b, ...)` 并返回 String；失败返回 Unknown。
desugar_format_call fn(e: i64) -> i64 {
    var n: Node = nodes[e];

    // ── 1. 模板必须存在且是字面量 ──────────────────────────
    var tmpl_node: i64 = call_arg_node(e, 0);
    if (tmpl_node < 0) {
        fc_err("T_FMT_NO_TEMPLATE",
            "format 至少需要一个实参：模板字符串字面量，如 format(\"{0} 分\", n)", e);
        return ti_mk("Unknown");
    }
    var tnode: Node = nodes[tmpl_node];
    if (tnode.kind != "string") {
        fc_err("T_FMT_TEMPLATE_NOT_LITERAL",
            "format 的模板必须是字符串**字面量**（编译期解析，运行期无模板引擎）；变量模板请改用 StringBuilder 逐段拼接",
            tmpl_node);
        return ti_mk("Unknown");
    }
    var tmpl: string = tnode.sa;

    // ── 2. 收集值实参并推断类型 ────────────────────────────
    var argc: i64 = 0;
    var c0: i64 = n.la;
    if (c0 >= 0) {
        var k0: Child = kids[c0];
        c0 = k0.next;                      // 跳过模板串本身
    }
    while (c0 >= 0) {
        var ck: Child = kids[c0];
        if (argc >= 64) {
            fc_err("T_FMT_TOO_MANY_ARGS", "format 的值实参不能超过 64 个", e);
            return ti_mk("Unknown");
        }
        var at: i64 = infer_expr(ck.val);
        var kind: i64 = fmt_kind_of(at);
        if (kind < 0 && tip_kind(at) != "Unknown") {
            fc_err("T_FMT_ARG_TYPE",
                sb_cat3("format 的第 ", i2s(argc),
                    sb_cat3(" 个值实参类型不可格式化：", ti_str(at),
                        "；仅支持整数 / 浮点 / bool / string，聚合类型请逐字段写出")),
                ck.val);
            return ti_mk("Unknown");
        }
        if (kind < 0) { kind = 0; }        // Unknown：已有诊断，按 int 兜底避免级联
        g_fmt_ak[argc] = kind;
        g_fmt_at[argc] = fmt_type_node(at);
        argc = argc + 1;
        c0 = ck.next;
    }

    // ── 3. 解析模板，边解析边生成函数体语句 ────────────────
    var body_head: i64 = -1;
    var body_tail: i64 = -1;

    // var __fb: StringBuilder = sb_new();
    var sbdecl: i64 = mk_var_decl("__fb", false, mk_scalar("StringBuilder", -1),
        mk_call(mk_ident("sb_new", -1), -1, -1), -1);
    body_tail = fmt_push_stmt(body_head, body_tail, sbdecl);
    if (body_head < 0) { body_head = body_tail; }

    var lit: StringBuilder = sb_new();
    var tl: u64 = str_len(tmpl);
    var i: u64 = 0;
    var auto_next: i64 = 0;
    var used_auto: bool = false;
    var used_manual: bool = false;
    var used_idx: i64 = 0;                 // 位掩码不够用，退化为「最大引用下标 + 1」

    while (i < tl) {
        var ch: i64 = tmpl[i] as i64;

        // `}}` → 字面 `}`；单独的 `}` 是笔误
        if (ch == 125) {
            if (i + 1 < tl && (tmpl[i + 1] as i64) == 125) {
                sb_append_char(lit, 125);
                i = i + 2;
                continue;
            }
            fc_err("T_FMT_BAD_TEMPLATE",
                "模板里孤立的 `}`；要输出字面右花括号请写 `}}`", tmpl_node);
            return ti_mk("Unknown");
        }

        if (ch != 123) {                   // 普通字符
            sb_append_char(lit, ch);
            i = i + 1;
            continue;
        }

        // `{{` → 字面 `{`
        if (i + 1 < tl && (tmpl[i + 1] as i64) == 123) {
            sb_append_char(lit, 123);
            i = i + 2;
            continue;
        }

        // ── 替换字段 ──
        // 先把攒下的字面段冲刷成一条 sb_append_str
        var seg: string = sb_to_str(lit);
        if (str_len(seg) > 0) {
            var sa_head: i64 = -1;
            var sa_tail: i64 = -1;
            sa_tail = list_push(sa_head, sa_tail, mk_ident("__fb", -1));
            if (sa_head < 0) { sa_head = sa_tail; }
            sa_tail = list_push(sa_head, sa_tail, mk_string(seg, -1));
            if (sa_head < 0) { sa_head = sa_tail; }
            var scall: i64 = mk_call(mk_ident("sb_append_str", -1), sa_head, -1);
            body_tail = fmt_push_stmt(body_head, body_tail, mk_expr(scall, -1));
            if (body_head < 0) { body_head = body_tail; }
        }
        sb_clear(lit);

        i = i + 1;                         // 跳过 '{'

        // 索引：数字串 或 空（自动编号）
        var idx: i64 = -1;
        var has_digit: bool = false;
        while (i < tl) {
            var dc: i64 = tmpl[i] as i64;
            if (dc < 48 || dc > 57) { i = i; break; }
            if (has_digit == false) { idx = 0; has_digit = true; }
            idx = idx * 10 + (dc - 48);
            i = i + 1;
        }

        // 既没数字，下一个也不是 ':' / '}' ⇒ 命名字段
        if (has_digit == false && i < tl) {
            var pc: i64 = tmpl[i] as i64;
            if (pc != 58 && pc != 125) {
                fc_err("T_FMT_NAMED_FIELD",
                    "不支持命名字段 `{name}`（t 没有关键字实参）；请改用位置索引 `{0}` 或自动编号 `{}`",
                    tmpl_node);
                return ti_mk("Unknown");
            }
        }

        if (has_digit) {
            used_manual = true;
        } else {
            used_auto = true;
            idx = auto_next;
            auto_next = auto_next + 1;
        }
        // 与 CPython 一致：自动编号与手动索引不得混用，否则读者要心算下一个是几号
        if (used_auto && used_manual) {
            fc_err("T_FMT_MIXED_NUMBERING",
                "同一模板里不能混用自动编号 `{}` 与手动索引 `{0}`；请统一其中一种",
                tmpl_node);
            return ti_mk("Unknown");
        }

        // 格式规范（可选）
        var spec: string = "";
        if (i < tl && (tmpl[i] as i64) == 58) {
            i = i + 1;
            var sp0: u64 = i;
            while (i < tl && (tmpl[i] as i64) != 125) { i = i + 1; }
            spec = str_slice(tmpl, sp0, i);
        }

        if (i >= tl || (tmpl[i] as i64) != 125) {
            fc_err("T_FMT_BAD_TEMPLATE",
                "替换字段没有闭合的 `}`；要输出字面左花括号请写 `{{`", tmpl_node);
            return ti_mk("Unknown");
        }
        i = i + 1;                         // 跳过 '}'

        if (idx < 0 || idx >= argc) {
            fc_err("T_FMT_INDEX_RANGE",
                sb_cat3("模板引用了第 ", i2s(idx),
                    sb_cat3(" 个值实参，但只传入了 ", i2s(argc), " 个")),
                tmpl_node);
            return ti_mk("Unknown");
        }
        if (idx + 1 > used_idx) { used_idx = idx + 1; }

        // sb_append_fmt_X(__fb, "spec", aK);
        var fa_head: i64 = -1;
        var fa_tail: i64 = -1;
        fa_tail = list_push(fa_head, fa_tail, mk_ident("__fb", -1));
        if (fa_head < 0) { fa_head = fa_tail; }
        fa_tail = list_push(fa_head, fa_tail, mk_string(spec, -1));
        if (fa_head < 0) { fa_head = fa_tail; }
        fa_tail = list_push(fa_head, fa_tail, mk_ident(sb_cat2("a", i2s(idx)), -1));
        if (fa_head < 0) { fa_head = fa_tail; }
        var fcall: i64 = mk_call(mk_ident(fmt_append_fn(g_fmt_ak[idx]), -1), fa_head, -1);
        body_tail = fmt_push_stmt(body_head, body_tail, mk_expr(fcall, -1));
        if (body_head < 0) { body_head = body_tail; }
    }

    // 收尾字面段
    var tailseg: string = sb_to_str(lit);
    if (str_len(tailseg) > 0) {
        var ta_head: i64 = -1;
        var ta_tail: i64 = -1;
        ta_tail = list_push(ta_head, ta_tail, mk_ident("__fb", -1));
        if (ta_head < 0) { ta_head = ta_tail; }
        ta_tail = list_push(ta_head, ta_tail, mk_string(tailseg, -1));
        if (ta_head < 0) { ta_head = ta_tail; }
        var tcall: i64 = mk_call(mk_ident("sb_append_str", -1), ta_head, -1);
        body_tail = fmt_push_stmt(body_head, body_tail, mk_expr(tcall, -1));
        if (body_head < 0) { body_head = body_tail; }
    }

    // return sb_to_str(__fb);
    var ra_head: i64 = -1;
    var ra_tail: i64 = -1;
    ra_tail = list_push(ra_head, ra_tail, mk_ident("__fb", -1));
    if (ra_head < 0) { ra_head = ra_tail; }
    var rcall: i64 = mk_call(mk_ident("sb_to_str", -1), ra_head, -1);
    body_tail = fmt_push_stmt(body_head, body_tail, mk_return(rcall, -1));
    if (body_head < 0) { body_head = body_tail; }

    // ── 4. 合成形参列表 a0..a(argc-1) ──────────────────────
    var p_head: i64 = -1;
    var p_tail: i64 = -1;
    var pi: i64 = 0;
    while (pi < argc) {
        var pn: i64 = mk_P(sb_cat2("a", i2s(pi)), g_fmt_at[pi], -1, -1);
        p_tail = list_push(p_head, p_tail, pn);
        if (p_head < 0) { p_head = p_tail; }
        pi = pi + 1;
    }

    // ── 5. 提升为顶层函数并注册 ────────────────────────────
    var fn_name: string = sb_cat2("__fmt_", i2s(g_fmt_counter));
    g_fmt_counter = g_fmt_counter + 1;
    var fdecl: i64 = mk_FuncDecl(fn_name, false, false, mk_scalar("string", -1),
        -1, p_head, body_head, -1);
    // 锚点承接：合成函数若在发射期出诊断，得能指回用户写 format 的那一行
    var fdn: Node = nodes[fdecl];
    fdn.ln = n.ln;
    fdn.cl = n.cl;
    fdn.tv = n.tv;
    slice_set(nodes, fdecl, fdn);
    sym_define(global_scope, fn_name, "func", ti_named("Func", fn_name), fdecl);
    append(decl_list, fdecl);

    // ── 6. 就地改写调用点：format(tmpl, a, b) → __fmt_N(a, b) ──
    var nn: Node = nodes[e];
    nn.na = mk_ident(fn_name, -1);
    if (nn.la >= 0) {
        var fk: Child = kids[nn.la];
        nn.la = fk.next;                   // 丢掉模板串实参
    }
    slice_set(nodes, e, nn);
    return ti_mk("String");
}

// 调用实参**不走通用遍历**（见 run_check 尾部关于 scan_fid_format_atoms 的长注释），
// 于是 `show(format(...))` / `sb_append_str(b, format(...))` 里的 format 永远等不到
// infer，发射期只会吐一行 `; UNSUPPORTED call format` 然后生成 `load %TStr, ptr 0`。
// 平坦扫描救不了它 —— 脱糖要实参的静态类型，而类型要作用域，出了 check 就没了。
// 故在 call 分支入口就地补扫实参子树：此刻 cur_scope 正确，命中即交回 infer_expr。
//
// 递归保护用节点池的天然不变式：`node_new` 顺序追加 ⇒ 子节点索引恒小于父节点。
// 只向索引更小处递归，既杜绝成环，也挡住「某 kind 把非节点整数存进 na」的误伤。
// （开关 g_has_format 声明在 parse_post_call 附近，与置位点同处。）

fmt_scan_list fn(h: i64, lim: i64) -> void {
    var c: i64 = h;
    while (c >= 0) {
        var k: Child = kids[c];
        fmt_scan_subtree(k.val, lim);
        c = k.next;
    }
}

fmt_scan_subtree fn(x: i64, lim: i64) -> void {
    if (x < 0 || x >= lim) { return; }
    var xn: Node = nodes[x];
    if (xn.kind == "call" && xn.na >= 0) {
        var cee: Node = nodes[xn.na];
        if (cee.sa == "format" && (cee.kind == "ident" || cee.kind == "member")) {
            infer_expr(x);          // 就地改写成 __fmt_N(...)，幂等
            xn = nodes[x];          // 重读：na/la 已被改写
        }
    }
    fmt_scan_subtree(xn.na, lim);
    fmt_scan_subtree(xn.nb, lim);
    fmt_scan_subtree(xn.nc, lim);
    fmt_scan_subtree(xn.nd, lim);
    fmt_scan_list(xn.la, lim);
    fmt_scan_list(xn.lb, lim);
    fmt_scan_list(xn.lc, lim);
}

// ── 表达式类型推断 inferExprType（复刻 checker.ts:479）────────

infer_expr fn(e: i64) -> i64 {
    var n: Node = nodes[e];
    if (n.kind == "int") {
        var v: u64 = lit_u64(n.sa);
        if (v <= 255) {
            return ti_scalar("u8");
        }
        if (v <= 65535) {
            return ti_scalar("u16");
        }
        if (v <= 4294967295) {
            return ti_scalar("u32");
        }
        return ti_scalar("u64");
    }
    // Erlang 式原子字面量：类型 = 64 位标量 "atom"，值 = 编译期 intern 的稳定 i64 id
    if (n.kind == "atom") {
        n.ia = atom_intern(n.sa);
        slice_set(nodes, e, n);
        return ti_scalar("atom");
    }
    // 内建文件描述符常量（M51）：stdin/stdout/stderr → 64 位标量 "fid"
    if (n.kind == "fidconst") {
        return ti_scalar("fid");
    }
    // 序列化操作符（M51）：`f < v` 的值即目标 fid 本身，故左结合可链式
    if (n.kind == "serialize") {
        infer_expr(n.na);
        infer_expr(n.nb);
        return ti_scalar("fid");
    }
    // 反序列化操作符（M52 读路径）：`f > Type` 的值是裸 Type；右操作数是类型表达式，不调 infer_expr
    if (n.kind == "deserialize") {
        infer_expr(n.na);
        return ti_from_td(deser_type_of(n.nb));
    }
// >>> GEN:type_infer1 (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
    if (n.kind == "float") {
        return ti_scalar("f64");
    }
    if (n.kind == "string") {
        return ti_mk("String");
    }
    if (n.kind == "bool") {
        return ti_scalar("bool");
    }
    if (n.kind == "null") {
        return ti_mk("Unknown");
    }
// <<< GEN:type_infer1 <<<
    if (n.kind == "typeinfo") {
        return ti_mk("TypeInfo");
    }
    // 闭包构造点（M48）：值类型 = 合成函数的函数类型（env 首参对用户不可见）
    if (n.kind == "closure_make") {
        var cmi: i64 = sym_lookup(global_scope, n.sa);
        if (cmi >= 0) {
            var cms: Sym = syms[cmi];
            return cms.ti;
        }
        return ti_mk("Unknown");
    }
    if (n.kind == "ident") {
        var si: i64 = sym_lookup(cur_scope, n.sa);
        if (si >= 0) {
            var s: Sym = syms[si];
            return s.ti;
        }
        if (n.sa == "true" || n.sa == "false") {
            return ti_scalar("bool");
        }
        // 未解析的标识符。静默退化成 Unknown 属**静默错编**：C 后端会一路漏到
        // 生成的 .c 里才报「未声明标识符」，LLVM 后端更糟——直接产出读 0 的垃圾值。
        // （本诊断即由此坑倒逼补上：parse_lambda_expr 误写 `cur_i`，检查期 0 errors、
        //  LLVM 自举照常通过，直到 C 后端自举才在 tc.c:8610 炸出来。）
        // bb 标志保证 infer_expr 重入时只报一次。
        if (n.bb == false) {
            var lcap: Node = nodes[e];
            lcap.bb = true;
            slice_set(nodes, e, lcap);
            if (g_in_lambda) {
                // 合成函数体里的未解析名：捕获分析已在提升期扫过外层作用域，
                // 走到这里说明外层同样没有该名字（拼写错 / 声明晚于字面量）。
                fc_err("T_UNDEFINED_IDENT",
                    sb_cat3("匿名函数体内未定义的标识符 `", n.sa,
                        "`：外层作用域也没有该名字（按值捕获只认字面量之前已声明的局部/参数），请检查拼写或调整声明位置"), e);
            } else {
                fc_err("T_UNDEFINED_IDENT",
                    sb_cat3("未定义的标识符 `", n.sa,
                        "`：请检查拼写，或先声明对应的变量/常量/函数"), e);
            }
        }
        return ti_mk("Unknown");
    }
    // match 表达式（L-15）：分支结果类型统一 + when 守卫布尔显式 + 穷尽性
    if (n.kind == "match") {
        var m_scr: i64 = infer_expr(n.na);
        var m_res: i64 = -1;
        var m_irref: bool = false;
        var m_rep: bool = n.bb == false;   // 诊断只报一次（infer_expr 可能被重入）
        if (m_rep) {
            var m_self: Node = nodes[e];
            m_self.bb = true;
            slice_set(nodes, e, m_self);
        }
        var m_c: i64 = n.la;
        while (m_c >= 0) {
            var m_k: Child = kids[m_c];
            var m_an: Node = nodes[m_k.val];
            // C2 模式消歧：裸标识符首字母大写 → CaseName，改写为等价的 member 模式
            // （`Case` ⇒ `Enum.Case`），让 checker 与 C/LLVM 双后端复用既有 member 路径。
            // 改写后 sa 清空，故对 infer_expr 的重入天然幂等。
            if (str_len(m_an.sa) > 0 && m_an.na < 0 && m_an.ba == false && starts_upper(m_an.sa)) {
                if (enum_has_case(m_scr, m_an.sa)) {
                    var cs_base: i64 = mk_ident(tip_name(m_scr), -1);
                    var cs_bn: Node = nodes[cs_base];
                    cs_bn.ln = m_an.ln;
                    cs_bn.cl = m_an.cl;
                    cs_bn.tv = m_an.tv;
                    slice_set(nodes, cs_base, cs_bn);
                    var cs_mem: i64 = mk_member(m_an.sa, cs_base, -1);
                    var cs_mn: Node = nodes[cs_mem];
                    cs_mn.ln = m_an.ln;
                    cs_mn.cl = m_an.cl;
                    cs_mn.tv = m_an.tv;
                    slice_set(nodes, cs_mem, cs_mn);
                    m_an.na = cs_mem;
                    m_an.sa = "";
                    slice_set(nodes, m_k.val, m_an);
                } else {
                    if (m_rep) {
                        var cs_l: i64 = n_line(m_k.val);
                        var cs_c: i64 = n_col(m_k.val);
                        var cs_msg: string = sb_cat3(
                            "pattern `", m_an.sa,
                            "` starts with an uppercase letter, so it is read as a case name, not a binding");
                        if (tip_kind(m_scr) == "Enum") {
                            cs_msg = sb_cat5("unknown case `", m_an.sa, "` for enum ", tip_name(m_scr),
                                " — check the spelling, or use a lowercase name to bind instead");
                        }
                        var cs_di: i64 = diag_new("T_MATCH_UNKNOWN_CASE", "error", cs_msg,
                            n_file(m_k.val), cs_l, cs_c, cs_l, cs_c + (str_len(m_an.sa) as i64));
                        var cs_fx: i64 = fix_one("use a lowercase binding name",
                            n_file(m_k.val), cs_l, cs_c, cs_l, cs_c + (str_len(m_an.sa) as i64),
                            "<lowercase_name>");
                        diag_set_fs(cs_di, cs_fx);
                    }
                }
            }
            var m_prev: i64 = cur_scope;
            cur_scope = scope_new(m_prev);
            if (str_len(m_an.sa) > 0) {
                sym_define(cur_scope, m_an.sa, "var", m_scr, -1);
            }
            if (m_an.na >= 0) {
                var m_pt: i64 = infer_expr(m_an.na);
                if (m_rep && tip_kind(m_pt) != "Unknown" && tip_kind(m_scr) != "Unknown") {
                    if (ti_equal(m_pt, m_scr) == false && can_cast(m_pt, m_scr) == false) {
                        err_type_mismatch(m_an.na, m_scr, m_pt);
                    }
                }
            }
            if (m_an.nb >= 0) {
                var m_gt: i64 = infer_expr(m_an.nb);
                if (m_rep && is_cond_bool(m_gt) == false) {
                    var m_gl: i64 = n_line(m_an.nb);
                    var m_gc: i64 = n_col(m_an.nb);
                    diag_new("T_STMT_IMPLICIT_BOOL", "error",
                        sb_cat2("match `when` guard must be bool, got ", ti_str(m_gt)),
                        n_file(m_an.nb), m_gl, m_gc, m_gl, m_gc + 4);
                }
            }
            var m_bt: i64 = infer_expr(m_an.nc);
            cur_scope = m_prev;
            if (m_res < 0) {
                m_res = m_bt;
            } else {
                if (m_rep && tip_kind(m_bt) != "Unknown" && tip_kind(m_res) != "Unknown") {
                    if (ti_equal(m_bt, m_res) == false && can_cast(m_bt, m_res) == false) {
                        var m_bl: i64 = n_line(m_an.nc);
                        var m_bc: i64 = n_col(m_an.nc);
                        diag_new("T_MATCH_ARM_TYPE", "error",
                            sb_cat4("match arms have different types: ", ti_str(m_res), " vs ", ti_str(m_bt)),
                            n_file(m_an.nc), m_bl, m_bc, m_bl, m_bc + 4);
                    }
                }
            }
            if (m_an.nb < 0 && (m_an.ba || str_len(m_an.sa) > 0)) {
                m_irref = true;
            }
            m_c = m_k.next;
        }
        // enum scrutinee 的全 case 覆盖同样构成穷尽，此时 `_` 不再必需。
        if (m_irref == false && enum_all_cases_covered(e, m_scr)) {
            m_irref = true;
        }
        if (m_rep && m_irref == false) {
            var m_l: i64 = n_line(e);
            var m_col: i64 = n_col(e);
            var m_miss: string = enum_missing_cases(e, m_scr);
            var m_msg: string = "match is not exhaustive: add a `_` wildcard arm or a binding arm without guard";
            if (str_len(m_miss) > 0) {
                m_msg = sb_cat3("match is not exhaustive: unhandled case(s) ", m_miss,
                    " — cover them all, or add a `_` wildcard arm");
            }
            var m_di: i64 = diag_new("T_MATCH_NONEXHAUSTIVE", "error", m_msg,
                n_file(e), m_l, m_col, m_l, m_col + 5);
            var m_fx: i64 = fix_one("add wildcard arm", n_file(e), m_l, m_col, m_l, m_col, "_ => <default>");
            diag_set_fs(m_di, m_fx);
        }
        if (m_res < 0) {
            return ti_mk("Unknown");
        }
        return m_res;
    }
    if (n.kind == "binary") {
        var op: string = n.sa;
        // ── 序列化/反序列化操作符脱糖（M51 `<` 写；M52 读路径 `>` 读）────────
        // 语义由**左操作数静态类型**唯一判定：fid ⇒ 序列化/反序列化，否则 ⇒ 普通比较。
        // fid 无序，故 `<`/`>` 作比较时不存在二义（L-04）；`>` 作反序列化时右操作数是「类型」而非值。
        var lt: i64 = infer_expr(n.na);
        var lfid: bool = tip_kind(lt) == "Scalar" && tip_name(lt) == "fid";
        if (lfid && op == "<") {
            var rt: i64 = infer_expr(n.nb);
            check_serializable(n.nb, rt);
            n.kind = "serialize";
            slice_set(nodes, e, n);
            return ti_scalar("fid");
        }
        if (lfid && op == ">") {
            // 右操作数是「类型」，不是值：按类型解析，不调 infer_expr(n.nb)
            var rtd: i64 = deser_type_of(n.nb);
            if (rtd < 0 || tds[rtd].cat == "unknown") {
                fc_err("T_FID_DESERIALIZE_NEEDS_TYPE",
                    "反序列化 `fid > Type` 的右操作数必须是类型（如 i64 / string / MyStruct）；当前无法解析为类型", e);
                return ti_mk("Unknown");
            }
            if (deser_supported(rtd) == false) {
                fc_err("T_FID_DESERIALIZE_AGG",
                    "反序列化暂仅支持标量（i8..i64 / u8..u64 / f32 / f64 / bool / atom）与 string；聚合类型（struct / array / slice / map / pointer）读属 v2", e);
                return ti_mk("Unknown");
            }
            n.kind = "deserialize";
            slice_set(nodes, e, n);
            return ti_from_td(rtd);          // Option B：结果类型为裸 T，EOF 由 fid_eof 探针表达
        }
        // parse 期把 `> string` / `> map[K]V` 等关键字型类型收成了类型节点；若左操作数
        // 并非 fid，这就不是反序列化，而是把类型当值比较 —— 须给出定位准确的诊断，
        // 否则 infer_expr 会在类型节点上得到 Unknown，报出与病因无关的错误。
        if (op == ">" && node_type_only(n.nb)) {
            fc_err("T_FID_DESERIALIZE_NEEDS_FID",
                "`>` 的右操作数写成了类型 —— 只有左操作数是 fid 时 `>` 才是反序列化；普通比较的两侧都必须是值", e);
            return ti_mk("Unknown");
        }
        // 其余：正常推断右操作数，再按既有规则处理比较/有序错误
        var rt: i64 = infer_expr(n.nb);
        var rfid: bool = tip_kind(rt) == "Scalar" && tip_name(rt) == "fid";
        if (lfid || rfid) {
            if (op == "<" || op == ">" || op == "<=" || op == ">=") {
                fc_err("T_FID_NOT_ORDERED",
                    sb_cat3("fid 是无序句柄，不支持 `", op,
                        "` 比较；写出用 `目标fid < 值`（序列化），读入用 `源fid > 类型`（反序列化），判等用 `==` / `!=`"), e);
                return ti_scalar("bool");
            }
        }
        if (op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=") {
            return ti_scalar("bool");
        }
        if (op == "&&" || op == "||") {
            return ti_scalar("bool");
        }
        if (tip_kind(lt) == "Scalar" && tip_kind(rt) == "Scalar") {
            if (ti_equal(lt, rt)) {
                return lt;
            }
            var ln2: Node = nodes[n.na];
            var rn2: Node = nodes[n.nb];
            var llit: bool = ln2.kind == "int";
            var rlit: bool = rn2.kind == "int";
            if (llit && rlit == false) {
                return rt;
            }
            if (rlit && llit == false) {
                return lt;
            }
            if (llit && rlit) {
                return lt;
            }
            var di: i64 = diag_new("T_TYPE_IMPLICIT_CAST", "error",
                sb_cat6("binary operator '", op, "' requires same types, got ", ti_str(lt), " and ", ti_str(rt)),
                "", 1, 1, 1, 5);
            slb_begin();
            slb_add("use explicit cast: `expr as Type`");
            diag_set_nt(di, slb_head);
        }
        if (tip_kind(lt) != "Unknown") {
            return lt;
        }
        return rt;
    }
    if (n.kind == "unary") {
        var ot: i64 = infer_expr(n.na);
        if (n.sa == "!") {
            return ti_scalar("bool");
        }
        return ot;
    }
    if (n.kind == "assign") {
        var atl: i64 = infer_expr(n.na);
        var atr: i64 = infer_expr(n.nb);
        // Sym 赋值：LHS 为 Sym 时，仅允许 string（自动 intern）或同池同类型 Sym；
        // 跨池 Sym→Sym（不同 tag）或其它类型赋值均为 T_TYPE_MISMATCH。
        if (tip_kind(atl) == "Sym" && ti_equal(atl, atr) == false) {
            if (tip_kind(atr) != "String" && tip_kind(atr) != "Unknown") {
                err_type_mismatch(n.nb, atl, atr);
            }
        }
        return atl;
    }
    if (n.kind == "call") {
        // 实参不走通用遍历，嵌套其中的 format 只能在这里补扫（详见 fmt_scan_subtree）
        if (g_has_format) { fmt_scan_list(n.la, e); }
        var cn: Node = nodes[n.na];
        // 方法式 `"tmpl".format(a, b)`（M57）：与函数式 `format("tmpl", a, b)` 完全同义。
        // 实现取「归一化」而非「另起一套」——就地把 receiver 挪成第 0 个实参、callee 换成
        // 裸 `format`，随后交给同一个 desugar_format_call。两种写法因此共享同一份模板文法、
        // 同一组诊断码，永远不会各自漂移。
        if (cn.kind == "member" && cn.sa == "format") {
            var mfa_recv: i64 = cn.na;
            var mfa_rn: Node = nodes[mfa_recv];
            if (mfa_rn.kind == "string") {
                var mfa_h: i64 = -1;
                var mfa_t: i64 = -1;
                mfa_t = list_push(mfa_h, mfa_t, mfa_recv);
                if (mfa_h < 0) { mfa_h = mfa_t; }
                var mfa_c: i64 = n.la;
                while (mfa_c >= 0) {
                    var mfa_k: Child = kids[mfa_c];
                    mfa_t = list_push(mfa_h, mfa_t, mfa_k.val);
                    if (mfa_h < 0) { mfa_h = mfa_t; }
                    mfa_c = mfa_k.next;
                }
                var mfa_n: Node = nodes[e];
                mfa_n.na = mk_ident("format", -1);
                mfa_n.la = mfa_h;
                slice_set(nodes, e, mfa_n);
                return desugar_format_call(e);
            }
            var mfa_rt: i64 = infer_expr(mfa_recv);
            if (tip_kind(mfa_rt) == "String") {
                fc_err("T_FMT_TEMPLATE_NOT_LITERAL",
                    "`.format(...)` 的接收者必须是字符串**字面量**（编译期解析，运行期无模板引擎）；变量模板请改用 StringBuilder 逐段拼接",
                    mfa_recv);
                return ti_mk("Unknown");
            }
        }
        if (cn.kind == "ident") {
            var fname: string = cn.sa;
            var si2: i64 = sym_lookup(global_scope, fname);
            if (si2 < 0) { si2 = sym_lookup(cur_scope, fname); }
            if (si2 >= 0) {
                var s2: Sym = syms[si2];
                if (tip_kind(s2.ti) == "Func") {
                    if (s2.decl >= 0) {
                        var fd: Node = nodes[s2.decl];
                        if (fd.kind == "FuncDecl") {
                            return resolve_ti(fd.na);
                        }
                    }
                    // 函数类型变量 / 参数：校验实参后返回签名的返回类型。
                    // 这里必须校验——间接调用没有 C 原型兜底，元数不符会一路漏到
                    // clang 报错或生成语义错误的 IR。
                    check_indirect_call(e, s2.ti);
                    return tif_ret[s2.ti];
                }
                // 对非函数的值做调用：给出明确诊断，别让它退化成「未知内建」
                if (s2.kind == "var" && tip_kind(s2.ti) != "Unknown") {
                    fc_err("T_NOT_CALLABLE",
                        sb_cat4("`", fname, "` 不是函数，不能调用；它的类型是 ", ti_str(s2.ti)), e);
                    return ti_mk("Unknown");
                }
            }
            // format(tmpl, ...) 的替换字段脱糖（M55）。必须挂在这里而非 parse 期：
            // 选 sb_append_fmt_int 还是 _float 取决于实参的**静态类型**，只有
            // infer 之后才知道。脱糖会就地把本节点改写成 __fmt_N(...) 调用，
            // callee 名随之改变，故重复 infer 天然幂等。
            if (fname == "format") {
                return desugar_format_call(e);
            }
            // map_get(m, k) 的返回类型 = 映射的 V（需从首个实参的 map 类型反查）
            if (fname == "map_get" && n.la >= 0) {
                var mgn: i64 = kids[n.la].val;
                var mgt: i64 = infer_expr(mgn);
                if (tip_kind(mgt) == "Map") {
                    var mgti: TI = tis[mgt];
                    if (mgti.val >= 0) {
                        return mgti.val;
                    }
                }
                return ti_mk("Unknown");
            }
            // print / println / eprint 的实参必须是字符串。若不校验，LLVM 后端会把标量
            // 当做 ptr 传给 @tll_print，导致 IR 校验失败（'i64' but expected 'ptr'）并使
            // `clang link failed`。这里在检查阶段给出清晰的类型错误。
            if (fname == "print" || fname == "println" || fname == "eprint") {
                if (n.la >= 0) {
                    var pan: i64 = kids[n.la].val;
                    var pat: i64 = infer_expr(pan);
                    if (tip_kind(pat) != "String" && tip_kind(pat) != "Unknown") {
                        diag_new("T_TYPE_MISMATCH", "error",
                            sb_cat3(fname, " 的实参必须是字符串（String）；标量请先用 int_to_str / to_string / StringBuilder 拼接。当前收到: ", ti_str(pat)),
                            n_file(e), n_line(e), n_col(e), n_line(e), n_col(e) + 5);
                    }
                }
            }
            // 文件描述符内建（M51）：atom 形参必须是**字面量** —— 打开方式与格式
            // 决定后续每一次 `<` 的字节形态，必须编译期可判定（L-02 显式 / L-03 静态）。
            if (fname == "fopen") {
                check_atom_arg(call_arg_node(e, 1), "fopen 的第 2 个实参（打开方式）", "mode", e);
            }
            if (fname == "fmt_register") {
                check_atom_arg(call_arg_node(e, 0), "fmt_register 的第 1 个实参（打开方式类别）", "kind", e);
                check_atom_arg(call_arg_node(e, 2), "fmt_register 的第 3 个实参（格式）", "fmt", e);
            }
            // fid_error 的实参必须是 fid（与 serialize 脱糖的 fid 判定同款：kind==Scalar && name==fid）。
            // 传非 fid（如 i64）应报 T_FID_ERROR_ARG，而非退化成「未知内建」或静默按 i64 传递。
            if (fname == "fid_error") {
                if (n.la >= 0) {
                    var fean: i64 = kids[n.la].val;
                    var feat: i64 = infer_expr(fean);
                    var feok: bool = (tip_kind(feat) == "Scalar" && tip_name(feat) == "fid") || tip_kind(feat) == "Unknown";
                    if (!feok) {
                        diag_new("T_FID_ERROR_ARG", "error",
                            sb_cat2("fid_error 的实参必须是 fid；当前收到: ", ti_str(feat)),
                            n_file(e), n_line(e), n_col(e), n_line(e), n_col(e) + 5);
                    }
                }
            }
            // fid_eof 同理：探针只对句柄有意义，传 i64 必须拦下而不是让运行时兜底。
            if (fname == "fid_eof") {
                if (n.la >= 0) {
                    var feon: i64 = kids[n.la].val;
                    var feot: i64 = infer_expr(feon);
                    var feook: bool = (tip_kind(feot) == "Scalar" && tip_name(feot) == "fid") || tip_kind(feot) == "Unknown";
                    if (!feook) {
                        diag_new("T_FID_EOF_ARG", "error",
                            sb_cat2("fid_eof 的实参必须是 fid；当前收到: ", ti_str(feot)),
                            n_file(e), n_line(e), n_col(e), n_line(e), n_col(e) + 5);
                    }
                }
            }
            // fseek/ftell 的首个实参必须是 fid；fseek 的偏移必须是整型标量。
            // fid 与 i64 不隐式互转，写反参数顺序（fseek(0, f)）必须在检查期就拦下。
            if (fname == "fseek" || fname == "ftell") {
                if (n.la >= 0) {
                    var skn: i64 = kids[n.la].val;
                    var skt: i64 = infer_expr(skn);
                    var skok: bool = (tip_kind(skt) == "Scalar" && tip_name(skt) == "fid") || tip_kind(skt) == "Unknown";
                    if (!skok) {
                        diag_new("T_FID_SEEK_ARG", "error",
                            sb_cat3(fname, " 的第 1 个实参必须是 fid；当前收到: ", ti_str(skt)),
                            n_file(e), n_line(e), n_col(e), n_line(e), n_col(e) + 5);
                    }
                }
                if (fname == "fseek") {
                    var skon: i64 = call_arg_node(e, 1);
                    if (skon >= 0) {
                        var skot: i64 = infer_expr(skon);
                        var skoname: string = tip_name(skot);
                        var skoint: bool = tip_kind(skot) == "Scalar" && skoname != "fid" && skoname != "atom"
                            && skoname != "bool" && skoname != "f32" && skoname != "f64";
                        if (!skoint && tip_kind(skot) != "Unknown") {
                            diag_new("T_FID_SEEK_ARG", "error",
                                sb_cat2("fseek 的第 2 个实参（偏移）必须是整型标量；当前收到: ", ti_str(skot)),
                                n_file(e), n_line(e), n_col(e), n_line(e), n_col(e) + 5);
                        }
                    }
                }
            }
            // 时间格式化（M56）：spec 字面量扫描字段码；实参类型校验
            if (fname == "format_time" || fname == "format_time_local" || fname == "format_time_tz") {
                var ftn: i64 = call_arg_node(e, 0);
                if (ftn >= 0) {
                    var ftnode: Node = nodes[ftn];
                    if (ftnode.kind == "string") {
                        check_time_spec(ftnode.sa, ftn);
                    } else {
                        var ftt: i64 = infer_expr(ftn);
                        if (tip_kind(ftt) != "String" && tip_kind(ftt) != "Unknown") {
                            diag_new("T_TIME_SPEC_TYPE", "error",
                                sb_cat3(fname, " 的第 1 个实参（格式串）必须是字符串；当前收到: ", ti_str(ftt)),
                                n_file(e), n_line(e), n_col(e), n_line(e), n_col(e) + 5);
                        }
                    }
                }
                var ftmn: i64 = call_arg_node(e, 1);
                if (ftmn >= 0) {
                    var ftmt: i64 = infer_expr(ftmn);
                    var ftmname: string = tip_name(ftmt);
                    var ftmint: bool = tip_kind(ftmt) == "Scalar" && ftmname != "fid" && ftmname != "atom"
                        && ftmname != "bool" && ftmname != "f32" && ftmname != "f64";
                    if (!ftmint && tip_kind(ftmt) != "Unknown") {
                        diag_new("T_TIME_ARG_TYPE", "error",
                            sb_cat3(fname, " 的第 2 个实参（时间微秒 epoch）必须是整型（i64）；当前收到: ", ti_str(ftmt)),
                            n_file(e), n_line(e), n_col(e), n_line(e), n_col(e) + 5);
                    }
                }
                // format_time_tz 的第 3 参：时区偏移分钟数（东为正），须整型
                if (fname == "format_time_tz") {
                    var tzn: i64 = call_arg_node(e, 2);
                    if (tzn < 0) {
                        fc_err("T_CALL_ARITY",
                            "format_time_tz(spec, t, tz_minutes) 需要 3 个实参：格式串、微秒 epoch、时区偏移分钟数（东为正，如东八区 480）", e);
                    } else {
                        var tzt: i64 = infer_expr(tzn);
                        var tzname: string = tip_name(tzt);
                        var tzint: bool = tip_kind(tzt) == "Scalar" && tzname != "fid" && tzname != "atom"
                            && tzname != "bool" && tzname != "f32" && tzname != "f64";
                        if (!tzint && tip_kind(tzt) != "Unknown") {
                            diag_new("T_TIME_ARG_TYPE", "error",
                                sb_cat2("format_time_tz 的第 3 个实参（时区偏移分钟数）必须是整型；当前收到: ", ti_str(tzt)),
                                n_file(e), n_line(e), n_col(e), n_line(e), n_col(e) + 5);
                        }
                    }
                }
            }
            // 时间解析（M57）：spec 走更严的解析白名单；第 2 参必须是字符串
            if (fname == "parse_time" || fname == "parse_time_local") {
                var ptn: i64 = call_arg_node(e, 0);
                if (ptn < 0) {
                    fc_err("T_CALL_ARITY",
                        sb_cat3(fname, "(spec, s) 需要 2 个实参：格式串与待解析字符串；失败返回 time_invalid()", ""), e);
                }
                if (ptn >= 0) {
                    var ptnode: Node = nodes[ptn];
                    if (ptnode.kind == "string") {
                        check_time_parse_spec(ptnode.sa, ptn);
                    } else {
                        var ptt2: i64 = infer_expr(ptn);
                        if (tip_kind(ptt2) != "String" && tip_kind(ptt2) != "Unknown") {
                            diag_new("T_TIME_SPEC_TYPE", "error",
                                sb_cat3(fname, " 的第 1 个实参（格式串）必须是字符串；当前收到: ", ti_str(ptt2)),
                                n_file(e), n_line(e), n_col(e), n_line(e), n_col(e) + 5);
                        }
                    }
                    var psn: i64 = call_arg_node(e, 1);
                    if (psn < 0) {
                        fc_err("T_CALL_ARITY",
                            sb_cat3(fname, "(spec, s) 缺少第 2 个实参（待解析字符串）", ""), e);
                    } else {
                        var pst: i64 = infer_expr(psn);
                        if (tip_kind(pst) != "String" && tip_kind(pst) != "Unknown") {
                            diag_new("T_TIME_ARG_TYPE", "error",
                                sb_cat3(fname, " 的第 2 个实参（待解析文本）必须是字符串；当前收到: ", ti_str(pst)),
                                n_file(e), n_line(e), n_col(e), n_line(e), n_col(e) + 5);
                        }
                    }
                }
            }
            if (fname == "time_invalid") {
                if (call_arg_node(e, 0) >= 0) {
                    fc_err("T_CALL_ARITY", "time_invalid() 不接受任何实参（返回解析失败哨兵：i64 最小值）", e);
                }
            }
            // 数字/字符串格式化（M54）：spec 字面量文法校验；实参类型校验
            if (fname == "format_int" || fname == "format_uint" || fname == "format_float"
                || fname == "format_str" || fname == "format_bool" || fname == "format_char") {
                var fspecn: i64 = call_arg_node(e, 0);
                if (fspecn >= 0) {
                    var fsn: Node = nodes[fspecn];
                    if (fsn.kind == "string") {
                        check_fmt_spec(fsn.sa, fspecn);
                    } else {
                        var fst: i64 = infer_expr(fspecn);
                        if (tip_kind(fst) != "String" && tip_kind(fst) != "Unknown") {
                            diag_new("T_FMT_SPEC_TYPE", "error",
                                sb_cat3(fname, " 的第 1 个实参（格式串 spec）必须是字符串；当前收到: ", ti_str(fst)),
                                n_file(e), n_line(e), n_col(e), n_line(e), n_col(e) + 5);
                        }
                    }
                }
            }
            // now() 不接受任何实参
            if (fname == "now") {
                if (call_arg_node(e, 0) >= 0) {
                    fc_err("T_CALL_ARITY", "now() 不接受任何实参（返回当前微秒 epoch）", e);
                }
            }
            return builtin_ret(fname);
        }
        // callee 是任意表达式（结构体字段 / 数组元素 / 调用结果…）：若其类型是函数类型，
        // 与 ident 路径同样校验实参并返回签名的返回类型。
        var xcti: i64 = infer_expr(n.na);
        if (tip_kind(xcti) == "Func") {
            check_indirect_call(e, xcti);
            return tif_ret[xcti];
        }
        return ti_mk("Unknown");
    }
    if (n.kind == "member") {
        var obt: i64 = infer_expr(n.na);
        var obk: string = tip_kind(obt);
        if (obk == "Struct" || obk == "Named") {
            var si3: i64 = sym_lookup(global_scope, tip_name(obt));
            if (si3 >= 0) {
                var s3: Sym = syms[si3];
                if (s3.decl >= 0) {
                    var sd: Node = nodes[s3.decl];
                    if (sd.kind == "StructDecl") {
                        var c: i64 = sd.lb;
                        while (c >= 0) {
                            var k: Child = kids[c];
                            var f: Node = nodes[k.val];
                            if (f.sa == n.sa) {
                                return resolve_ti(f.na);
                            }
                            c = k.next;
                        }
                    }
                }
            }
        }
        if (obk == "Enum") {
            return obt;
        }
        return ti_mk("Unknown");
    }
    if (n.kind == "index") {
        var obt2: i64 = infer_expr(n.na);
        var obk2: string = tip_kind(obt2);
        if (obk2 == "Array" || obk2 == "Slice") {
            var t2: TI = tis[obt2];
            return t2.elem;
        }
        if (obk2 == "String") {
            return ti_scalar("u8");
        }
        if (obk2 == "Map") {
            var t3: TI = tis[obt2];
            return t3.val;
        }
        return ti_mk("Unknown");
    }
    if (n.kind == "array_lit") {
        var cnt: i64 = list_count(n.la);
        if (cnt > 0) {
            var k2: Child = kids[n.la];
            var et: i64 = infer_expr(k2.val);
            // 数组字面量的整型元素按「默认 int」提升为 i64（与多数语言一致，
            // 避免 [1,2,3] 被推成 []u8）；其余类型（bool/f64/struct…）保持不变。
            if (tip_kind(et) == "Scalar" && is_int_name(tip_name(et)) && tip_name(et) != "i64" && tip_name(et) != "i32") {
                et = ti_scalar("i64");
            }
            var ai: i64 = ti_elem_of("Array", et);
            var at: TI = tis[ai];
            at.alen = cnt;
            slice_set(tis, ai, at);
            return ai;
        }
        // 空数组字面量：元素类型未知，配合 can_cast 可赋给任意 []T / [N]T。
        return ti_elem_of("Array", ti_mk("Unknown"));
    }
    if (n.kind == "map_lit") {
        if (n.la >= 0) {
            var k3: Child = kids[n.la];
            var en: Node = nodes[k3.val];
            var kt: i64 = infer_expr(en.na);
            var vt: i64 = infer_expr(en.nb);
            // 与数组字面量同规则：整型键/值按「默认 int」提升为 i64，
            // 避免 [1: 2] 被推成 map[u8]u8。
            if (tip_kind(kt) == "Scalar" && is_int_name(tip_name(kt)) && tip_name(kt) != "i64" && tip_name(kt) != "i32") {
                kt = ti_scalar("i64");
            }
            if (tip_kind(vt) == "Scalar" && is_int_name(tip_name(vt)) && tip_name(vt) != "i64" && tip_name(vt) != "i32") {
                vt = ti_scalar("i64");
            }
            var mi: i64 = ti_mk("Map");
            var mt: TI = tis[mi];
            mt.key = kt;
            mt.val = vt;
            slice_set(tis, mi, mt);
            return mi;
        }
        var mi2: i64 = ti_mk("Map");
        var ku: i64 = ti_mk("Unknown");
        var vu: i64 = ti_mk("Unknown");
        var mt2: TI = tis[mi2];
        mt2.key = ku;
        mt2.val = vu;
        slice_set(tis, mi2, mt2);
        return mi2;
    }
// >>> GEN:type_infer2 (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
    if (n.kind == "struct_lit") {
        // 默认填充：struct 字段有默认值(expr)但未在字面量中给出 → 合成 FV 追加进 n.la。
        // 后端以「指定符初始化器」按名映射，故追加在尾部与顺序无关，天然幂等。
        var sname: string = n.sa;
        var fh: i64 = find_struct_fields(sname);
        if (fh >= 0) {
            var present: []string;
            var p: i64 = n.la;
            while (p >= 0) {
                var pv: Node = nodes[kids[p].val];
                append(present, pv.sa);
                p = kids[p].next;
            }
            var c: i64 = fh;
            while (c >= 0) {
                var f: Node = nodes[kids[c].val];
                if (f.nb >= 0) {
                    var found: bool = false;
                    var i: i64 = 0;
                    var pl: i64 = slice_len(present);
                    while (i < pl) {
                        if (present[i] == f.sa) { found = true; break; }
                        i = i + 1;
                    }
                    if (found == false) {
                        var fvid: i64 = mk_FV(f.sa, f.nb, -1);
                        if (n.la < 0) {
                            n.la = list_push(-1, -1, fvid);
                        } else {
                            var tail: i64 = n.la;
                            while (kids[tail].next >= 0) { tail = kids[tail].next; }
                            list_push(n.la, tail, fvid);
                        }
                    }
                }
                c = kids[c].next;
            }
            slice_set(nodes, e, n);
        }
        return ti_named("Struct", n.sa);
    }
    if (n.kind == "cast") {
        return resolve_ti(n.nb);
    }
    if (n.kind == "paren") {
        return infer_expr(n.na);
    }
    if (n.kind == "comptime") {
        return infer_expr(n.na);
    }
// <<< GEN:type_infer2 <<<
    return ti_mk("Unknown");
}

// ── 返回路径分析（复刻 checker.ts:653）────────────────────────

all_paths_return fn(head: i64) -> bool {
    if (head < 0) {
        return false;
    }
    var last: i64 = list_last_val(head);
    if (last < 0) {
        return false;
    }
    return stmt_returns(last);
}

stmt_returns fn(s: i64) -> bool {
    var n: Node = nodes[s];
    if (n.kind == "return") {
        return true;
    }
    if (n.kind == "if") {
        if (n.lb != -2) {
            if (all_paths_return(n.la)) {
                return all_paths_return(n.lb);
            }
            return false;
        }
        return false;
    }
    if (n.kind == "block") {
        return all_paths_return(n.la);
    }
    return false;
}

// ── 语句检查 checkStmt（复刻 checker.ts:345）──────────────────

check_stmt fn(s: i64) -> void {
    var n: Node = nodes[s];
    // 闭包体首的捕获变量重建（M48）：类型来自捕获点的原始声明，直接定义同名局部
    if (n.kind == "closure_capture") {
        if (n.na >= 0) {
            sym_define(cur_scope, n.sa, "var", resolve_ti(n.na), -1);
        }
        return;
    }
    if (n.kind == "var_decl") {
        var vt: i64 = -1;
        if (n.na >= 0) {
            vt = resolve_ti(n.na);
        } else {
            // 发射侧（collect_local_types / emit_stmt / ll_stmt）都以 `n.na >= 0`
            // 为前提，无类型标注的局部声明会被整条丢弃 → 变量读出 0 的静默错编。
            // 在检查期挡住，比让它一路漏到运行期强得多。
            fc_err("T_VAR_NO_TYPE",
                sb_cat3("局部变量 `", n.sa,
                    "` 缺少类型标注：当前不支持局部类型推断，请写成 `var 名字: 类型 = 初值;`"), s);
        }
        if (n.nb >= 0) {
            var it: i64 = infer_expr(n.nb);
            if (vt >= 0 && tip_kind(it) != "Unknown" && ti_equal(it, vt) == false) {
                var vk: string = tip_kind(vt);
                var int_to_fe: bool = (vk == "Flag" || vk == "Enum") && is_int_ti(it);
                // Sym 字段允许由字符串赋值（自动 intern → id）
                var str_to_sym: bool = vk == "Sym" && tip_kind(it) == "String";
                if (int_to_fe == false && str_to_sym == false && can_cast(it, vt) == false) {
                    err_type_mismatch(n.nb, vt, it);
                }
            }
            if (vt < 0) {
                sym_define(cur_scope, n.sa, "var", it, -1);
                return;
            }
        }
        if (vt >= 0) {
            sym_define(cur_scope, n.sa, "var", vt, -1);
        }
        return;
    }
    if (n.kind == "if") {
        var ct: i64 = infer_expr(n.na);
        if (is_cond_bool(ct) == false) {
            var di: i64 = diag_new("T_STMT_IMPLICIT_BOOL", "error",
                sb_cat2("if condition must be bool or explicit comparison, got ", ti_str(ct)),
                "", 1, 1, 1, 5);
            var fx: i64 = fix_one("add explicit comparison", "", 1, 1, 1, 1, "(expr != 0)");
            diag_set_fs(di, fx);
        }
        var prev: i64 = cur_scope;
        cur_scope = scope_new(prev);
        var c: i64 = n.la;
        while (c >= 0) {
            var k: Child = kids[c];
            check_stmt(k.val);
            c = k.next;
        }
        if (n.lb != -2) {
            cur_scope = scope_new(prev);
            var c2: i64 = n.lb;
            while (c2 >= 0) {
                var k2: Child = kids[c2];
                check_stmt(k2.val);
                c2 = k2.next;
            }
        }
        cur_scope = prev;
        return;
    }
    if (n.kind == "for" || n.kind == "while") {
        // 循环头与循环体共用一层作用域。C 式 for 的初始化变量必须**先**入作用域，
        // 条件与步进才解析得到它 —— 原实现在建作用域前就推断条件，`for (var i...; i <= n; ...)`
        // 里的 `i` 解析不到，靠 infer_expr 的 Unknown 兜底才没炸（T_UNDEFINED_IDENT 上线后暴露）。
        var prev2: i64 = cur_scope;
        cur_scope = scope_new(prev2);
        if (n.kind == "for" && n.na >= 0) {
            check_stmt(n.na);
        }
        var cond: i64 = n.na;
        if (n.kind == "for") {
            cond = n.nb;
        }
        if (cond >= 0) {
            var ct2: i64 = infer_expr(cond);
            if (is_cond_bool(ct2) == false) {
                diag_new("T_STMT_IMPLICIT_BOOL", "error",
                    sb_cat2("loop condition must be bool, got ", ti_str(ct2)),
                    "", 1, 1, 1, 5);
            }
        }
        var c3: i64 = n.la;
        while (c3 >= 0) {
            var k3: Child = kids[c3];
            check_stmt(k3.val);
            c3 = k3.next;
        }
        // 步进语句此前**完全未被检查**（发射侧照常发射），一并补上。
        if (n.kind == "for" && n.nc >= 0) {
            check_stmt(n.nc);
        }
        cur_scope = prev2;
        return;
    }
    if (n.kind == "for_each") {
        var itt: i64 = infer_expr(n.na);
        var prev3: i64 = cur_scope;
        cur_scope = scope_new(prev3);
        var et: i64 = -1;
        var itk: string = tip_kind(itt);
        if (itk == "Slice" || itk == "Array") {
            var t4: TI = tis[itt];
            et = t4.elem;
        } else {
        if (itk == "Map") {
            // map 的 for-in 迭代键（按插入序）
            var t5: TI = tis[itt];
            et = t5.key;
        } else {
            et = ti_mk("Unknown");
        }}
        sym_define(cur_scope, n.sa, "var", et, -1);
        // 双变量形式 `for (k, v in m)`：第二个变量绑定值类型
        if (str_len(n.sb) > 0) {
            var vt5: i64 = ti_mk("Unknown");
            if (itk == "Map") {
                var t6: TI = tis[itt];
                vt5 = t6.val;
            } else {
                diag_new("T_TYPE_MISMATCH", "error",
                    "for (k, v in x): 双变量迭代仅支持 map",
                    n_file(n.na), n_line(n.na), n_col(n.na), n_line(n.na), n_col(n.na) + 5);
            }
            sym_define(cur_scope, n.sb, "var", vt5, -1);
        }
        var c4: i64 = n.la;
        while (c4 >= 0) {
            var k4: Child = kids[c4];
            check_stmt(k4.val);
            c4 = k4.next;
        }
        cur_scope = prev3;
        return;
    }
    if (n.kind == "return") {
        if (n.na >= 0) {
            var rt: i64 = infer_expr(n.na);
            if (tip_kind(rt) != "Unknown" && ti_equal(rt, cur_ret) == false) {
                if (can_cast(rt, cur_ret) == false) {
                    err_type_mismatch(n.na, cur_ret, rt);
                }
            }
        }
        return;
    }
    if (n.kind == "assignment") {
        var tt: i64 = infer_expr(n.na);
        var vt2: i64 = infer_expr(n.nb);
        if (tip_kind(tt) != "Unknown" && tip_kind(vt2) != "Unknown" && ti_equal(tt, vt2) == false) {
            // Sym 字段允许由字符串赋值（自动 intern）；跨池 Sym→Sym 仍报错
            var str_to_sym2: bool = tip_kind(tt) == "Sym" && tip_kind(vt2) == "String";
            if (str_to_sym2 == false && can_cast(vt2, tt) == false) {
                err_type_mismatch(n.nb, tt, vt2);
            }
        }
        return;
    }
    if (n.kind == "expr") {
        infer_expr(n.na);
        return;
    }
    if (n.kind == "block" || n.kind == "defer" || n.kind == "comptime_block") {
        var prev4: i64 = cur_scope;
        cur_scope = scope_new(prev4);
        var c5: i64 = n.la;
        while (c5 >= 0) {
            var k5: Child = kids[c5];
            check_stmt(k5.val);
            c5 = k5.next;
        }
        cur_scope = prev4;
        return;
    }
}

// ── 声明检查（复刻 checker.ts:178-341）────────────────────────

check_func_decl fn(d: i64) -> void {
    var n: Node = nodes[d];
    if (n.lc == -2) {
        return;
    }

    var prev: i64 = cur_scope;
    cur_scope = scope_new(global_scope);

    // 由 lambda 提升而来的合成函数：函数体已脱离原词法环境，未解析的标识符
    // 即「试图捕获外层局部」，需给出可执行的诊断（见 infer_expr ident 分支）。
    var prev_lam: bool = g_in_lambda;
    g_in_lambda = n.sc == "__lambda__";

    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var p: Node = nodes[k.val];
        sym_define(cur_scope, p.sa, "var", resolve_ti(p.na), -1);
        c = k.next;
    }

    var prev_ret: i64 = cur_ret;
    cur_ret = resolve_ti(n.na);

    var c2: i64 = n.lc;
    while (c2 >= 0) {
        var k2: Child = kids[c2];
        check_stmt(k2.val);
        c2 = k2.next;
    }

    if (tip_kind(cur_ret) != "Void") {
        if (all_paths_return(n.lc) == false) {
            var anchor: i64 = list_last_val(n.lc);
            var l: i64 = n_line(anchor);
            var cc: i64 = n_col(anchor);
            diag_new("T_PARSE_INVALID_EXPR", "error",
                sb_cat3("function '", n.sa, "' is missing return on some code paths (all branches must explicitly return)"),
                n_file(anchor), l, cc, l, cc + 10);
        }
    }

    cur_ret = prev_ret;
    cur_scope = prev;
    g_in_lambda = prev_lam;
}

check_struct_decl fn(d: i64) -> void {
    var n: Node = nodes[d];
    var c: i64 = n.lb;
    var total: i64 = 0;
    var tag_count: i64 = 0;
    // 第一遍：解析字段类型 + 统计显式 tagID 字段数
    while (c >= 0) {
        var k: Child = kids[c];
        var f: Node = nodes[k.val];
        total = total + 1;
        if (f.ib >= 1) { tag_count = tag_count + 1; }
        if (f.ia == -1) {
            resolve_ti(f.na);
        }
        c = k.next;
    }
    // ── 全有 / 全无 规则：struct 内 tagID 要么全显式(@N)，要么全自动，禁止混合 ──
    if (tag_count > 0 && tag_count < total) {
        diag_new("T_TAGID_MIXED", "error",
            sb_cat3("struct '", n.sa, "' 的字段 tagID 必须「全显式 @N」或「全自动」：不能部分字段写 @N、部分不写"),
            n_file(d), n_line(d), n_col(d), n_line(d), n_col(d) + 4);
        return;
    }
    // ── 全显式：去重；全自动：顺序分配 1,2,3…（写入 f.ib 供后续 type_info / 序列化使用）──
    if (total > 0) {
        if (tag_count == total) {
            // 去重：O(n^2) 两两比对（struct 字段数极少）
            var p: i64 = n.lb;
            while (p >= 0) {
                var pf: Node = nodes[kids[p].val];
                var q: i64 = kids[p].next;
                while (q >= 0) {
                    var qf: Node = nodes[kids[q].val];
                    if (pf.ib >= 1 && qf.ib == pf.ib) {
                        var osb: StringBuilder = sb_new();
                        sb_append_str(osb, "struct '");
                        sb_append_str(osb, n.sa);
                        sb_append_str(osb, "': 字段 tagID 重复 @");
                        sb_append_i64(osb, pf.ib);
                        sb_append_str(osb, "（字段 '");
                        sb_append_str(osb, pf.sa);
                        sb_append_str(osb, "' 与 '");
                        sb_append_str(osb, qf.sa);
                        sb_append_str(osb, "'）");
                        diag_new("T_TAGID_DUP", "error", sb_to_str(osb),
                            n_file(d), n_line(d), n_col(d), n_line(d), n_col(d) + 4);
                    }
                    q = kids[q].next;
                }
                p = kids[p].next;
            }
        } else {
            // 全自动：顺序分配（基值 1）
            var idx: i64 = 1;
            var cc: i64 = n.lb;
            while (cc >= 0) {
                var ff: Node = nodes[kids[cc].val];
                ff.ib = idx;
                slice_set(nodes, kids[cc].val, ff);
                idx = idx + 1;
                cc = kids[cc].next;
            }
        }
    }
    // ── 默认表达式类型检查：f.nb（默认）须可赋给字段类型 f.na ──
    c = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var f: Node = nodes[k.val];
        if (f.nb >= 0) {
            var ft: i64 = resolve_ti(f.na);
            var dt: i64 = infer_expr(f.nb);
            if (tip_kind(dt) != "Unknown" && ti_equal(dt, ft) == false && can_cast(dt, ft) == false) {
                err_type_mismatch(f.nb, ft, dt);
            }
        }
        c = k.next;
    }
}

check_enum_decl fn(d: i64) -> void {
    var n: Node = nodes[d];
    if (is_int_name(n.sb) == false) {
        var di: i64 = diag_new("T_TYPE_MISMATCH", "error",
            sb_cat5("enum '", n.sa, "' underlying type must be an integer type, got '", n.sb, "'"),
            "", 1, 1, 1, 10);
        slb_begin();
        slb_add("u8");
        slb_add("u16");
        slb_add("u32");
        slb_add("u64");
        slb_add("i8");
        slb_add("i16");
        slb_add("i32");
        slb_add("i64");
        diag_set_vv(di, slb_head);
    }

    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var v: Node = nodes[k.val];
        if (v.na >= 0) {
            var vt: i64 = infer_expr(v.na);
            if (tip_kind(vt) == "Scalar" && is_int_name(tip_name(vt)) == false) {
                diag_new("T_TYPE_MISMATCH", "error",
                    sb_cat2("enum variant value must be integer, got ", ti_str(vt)),
                    "", 1, 1, 1, 5);
            }
        }
        c = k.next;
    }
}

// flag decl 检查用的 usedBits 暂存池（append-only，按 base 划分）
var fd_names: []string;
var fd_starts: []i64;
var fd_ends: []i64;

check_flag_decl fn(d: i64) -> void {
    var n: Node = nodes[d];
    var is_flag: bool = n.kind == "FlagDecl";
    if (is_flag && is_int_name(n.sb) == false) {
        var di: i64 = diag_new("T_TYPE_MISMATCH", "error",
            sb_cat5("flag '", n.sa, "' underlying type must be an integer type, got '", n.sb, "'"),
            "", 1, 1, 1, 10);
        slb_begin();
        slb_add("u8");
        slb_add("u16");
        slb_add("u32");
        slb_add("u64");
        diag_set_vv(di, slb_head);
    }

    var auto_off: i64 = 0;
    var base: i64 = slice_len(fd_names) as i64;

    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var sl: Node = nodes[k.val];
        var start: i64 = auto_off;
        if (sl.bb) {
            start = sl.ib;
        }
        var end: i64 = start + sl.ia;

        var i: i64 = base;
        var total: i64 = slice_len(fd_names) as i64;
        while (i < total) {
            var us: i64 = fd_starts[i];
            var ue: i64 = fd_ends[i];
            if (start < ue && end > us) {
                var msb: StringBuilder = sb_new();
                sb_append_str(msb, "flag slot '");
                sb_append_str(msb, sl.sa);
                sb_append_str(msb, "' (bits ");
                sb_append_i64(msb, start);
                sb_append_str(msb, "-");
                sb_append_i64(msb, end - 1);
                sb_append_str(msb, ") overlaps with '");
                sb_append_str(msb, fd_names[i]);
                sb_append_str(msb, "' (bits ");
                sb_append_i64(msb, us);
                sb_append_str(msb, "-");
                sb_append_i64(msb, ue - 1);
                sb_append_str(msb, ")");
                diag_new("T_FLAG_OFFSET_CONFLICT", "error", sb_to_str(msb), "", 1, 1, 1, 10);
            }
            i = i + 1;
        }

        append(fd_names, sl.sa);
        append(fd_starts, start);
        append(fd_ends, end);

        if (is_flag) {
            var tw: i64 = get_bw(n.sb);
            if (tw > 0 && end > tw) {
                var osb: StringBuilder = sb_new();
                sb_append_str(osb, "flag '");
                sb_append_str(osb, n.sa);
                sb_append_str(osb, "' slot '");
                sb_append_str(osb, sl.sa);
                sb_append_str(osb, "' exceeds ");
                sb_append_str(osb, n.sb);
                sb_append_str(osb, " (");
                sb_append_i64(osb, tw);
                sb_append_str(osb, " bits): uses bits ");
                sb_append_i64(osb, start);
                sb_append_str(osb, "-");
                sb_append_i64(osb, end - 1);
                var di2: i64 = diag_new("T_FLAG_OVERFLOW", "error", sb_to_str(osb), "", 1, 1, 1, 10);
                slb_begin();
                slb_add(sb_cat3("0-", i2s(tw - 1), " bits"));
                diag_set_vv(di2, slb_head);
            }
        }

        auto_off = end;
        c = k.next;
    }
}

check_decl fn(d: i64) -> void {
    var n: Node = nodes[d];
    if (n.kind == "FuncDecl") {
        check_func_decl(d);
        return;
    }
    if (n.kind == "StructDecl") {
        check_struct_decl(d);
        return;
    }
    if (n.kind == "EnumDecl") {
        check_enum_decl(d);
        return;
    }
    if (n.kind == "FlagDecl" || n.kind == "FlagSetDecl") {
        check_flag_decl(d);
        return;
    }
    if (n.kind == "GlobalVarDecl") {
        if (n.nb >= 0) {
            var it: i64 = infer_expr(n.nb);
            var vt: i64 = resolve_ti(n.na);
            if (tip_kind(it) != "Unknown" && ti_equal(it, vt) == false) {
                // Sym 全局变量允许由字符串赋值（自动 intern → id）
                var gss: bool = tip_kind(vt) == "Sym" && tip_kind(it) == "String";
                if (gss == false && can_cast(it, vt) == false) {
                    err_type_mismatch(n.nb, vt, it);
                }
            }
        }
        return;
    }
    if (n.kind == "GlobalConstDecl") {
        if (n.nb >= 0) {
            var it2: i64 = infer_expr(n.nb);
            if (n.na >= 0) {
                var ct: i64 = resolve_ti(n.na);
                if (tip_kind(it2) != "Unknown" && ti_equal(it2, ct) == false) {
                    if (can_cast(it2, ct) == false) {
                        err_type_mismatch(n.nb, ct, it2);
                    }
                }
            }
        }
        return;
    }
    // 注：ImportModDecl 节点已在 resolve_modules（run_check 入口）内联解析时
    // 被整体移除，故此处不会再遇到；若残留（理论上不会）将由下方通用分支兜底。
}

// ── §7.2 CTFE 导入脱糖（M27）──────────────────────────────────
// 在 register_decl 全部完成后、check_decl 之前执行。
// 检测 var x: []Struct = import_csv("path") / import_json("path") →
// 编译期读文件 → 解析 → 值域校验 → 合成 __import_N 加载函数 → 替换 init。
// 残存调用报 T_IMPORT_CONTEXT。

var g_imp_counter: i64;

// 从切片类型节点提取元素 struct 名。na 指向 slice 节点（na=named），返回 struct 名或 ""。
import_elem_struct_name fn(type_node: i64) -> string {
    if (type_node < 0) { return ""; }
    var tn: Node = nodes[type_node];
    if (tn.kind != "slice") { return ""; }
    if (tn.na < 0) { return ""; }
    var elem: Node = nodes[tn.na];
    if (elem.kind == "named") { return elem.sa; }
    return "";
}

// 从 struct 名查找 StructDecl，返回其字段链表头（n.lb）或 -1。
find_struct_fields fn(sname: string) -> i64 {
    var si: i64 = sym_lookup(global_scope, sname);
    if (si < 0) { return -1; }
    var s: Sym = syms[si];
    if (s.decl < 0) { return -1; }
    var dn: Node = nodes[s.decl];
    if (dn.kind != "StructDecl") { return -1; }
    return dn.lb;
}

// 从字段链表收集 (字段名, 标量类型名) 对。结果写入全局 imp_fnames/imp_ftypes。
// 注意：t 的 slice 是值传递，无法用 out 参数，故用全局。
var imp_fnames: []string;
var imp_ftypes: []string;
// 当前正在处理的 import 的字段表起始下标（调用 collect_struct_fields 前记录）
var imp_fbase: i64;
// JSON 解析临时键值表（同样因 slice 值传递限制而用全局）
var jp_keys: []string;
var jp_vals: []string;

// 返回值：字段数。字段写入 imp_fnames/imp_ftypes 的尾部，
// 起始下标由调用方在调用前用 slice_len 记录（同 fr_resolve_flag 的 base 手法）。
collect_struct_fields fn(field_head: i64) -> i64 {
    var count: i64 = 0;
    var c: i64 = field_head;
    while (c >= 0) {
        var k: Child = kids[c];
        var f: Node = nodes[k.val];
        var fname: string = f.sa;
        var tname: string = "";
        if (f.na >= 0) {
            var ft: Node = nodes[f.na];
            if (ft.kind == "scalar") {
                tname = ft.sa;
            }
        }
        append(imp_fnames, fname);
        append(imp_ftypes, tname);
        count = count + 1;
        c = k.next;
    }
    return count;
}

// 校验单个值是否可赋给标量类型。返回 true=ok。
validate_scalar_value fn(val: string, tname: string, row_idx: i64, col_idx: i64) -> bool {
    if (tname == "string") { return true; }
    if (tname == "bool") {
        if (val == "true" || val == "false") { return true; }
        return false;
    }
    if (is_int_name(tname)) {
        // 简单检查：首字符可选负号，其余全数字
        var L: u64 = str_len(val);
        if (L == 0) { return false; }
        var start: u64 = 0;
        var c0: u8 = val[0];
        if (c0 == 45) { start = 1; }
        if (start >= L) { return false; }
        var i: u64 = start;
        while (i < L) {
            var ch: u8 = val[i];
            if (ch < 48 || ch > 57) { return false; }
            i = i + 1;
        }
        return true;
    }
    if (is_float_name(tname)) {
        // 简单检查：包含 . 或 e/E，或纯数字
        var L2: u64 = str_len(val);
        if (L2 == 0) { return false; }
        var has_dot: bool = false;
        var has_digit: bool = false;
        var i2: u64 = 0;
        if (val[0] == 45) { i2 = 1; }
        while (i2 < L2) {
            var ch2: u8 = val[i2];
            if (ch2 >= 48 && ch2 <= 57) { has_digit = true; }
            if (ch2 == 46) { has_dot = true; }
            i2 = i2 + 1;
        }
        if (has_digit == false) { return false; }
        return true;
    }
    return false;
}

// 为单个值合成标量字面量 AST 节点（int/float/bool/string + cast）
make_value_node fn(val: string, tname: string) -> i64 {
    if (tname == "string") {
        return mk_string(val, -1);
    }
    if (tname == "bool") {
        if (val == "true") { return mk_bool(true, -1); }
        return mk_bool(false, -1);
    }
    if (is_int_name(tname)) {
        var inode: i64 = mk_int(val, 10, -1);
        var target: i64 = mk_scalar(tname, -1);
        return mk_cast(inode, target, -1);
    }
    if (is_float_name(tname)) {
        var fnode: i64 = mk_float(val, -1);
        var target2: i64 = mk_scalar(tname, -1);
        return mk_cast(fnode, target2, -1);
    }
    return mk_string(val, -1);
}

// CSV 解析：返回行数组，每行是列数组。简单实现：逗号分隔，双引号转义。
// 输出写入 out_rows（每行用 \x1f 分隔列）。
csv_parse fn(content: string) -> []string {
    var rows: []string;
    var sb: StringBuilder = sb_new();
    var in_quotes: bool = false;
    var row_buf: StringBuilder = sb_new();
    var col_buf: StringBuilder = sb_new();
    var L: u64 = str_len(content);
    var i: u64 = 0;
    while (i < L) {
        var ch: u8 = content[i];
        if (in_quotes) {
            if (ch == 34) {
                if (i + 1 < L && content[i + 1] == 34) {
                    sb_append_char(col_buf, 34);
                    i = i + 2;
                    continue;
                }
                in_quotes = false;
                i = i + 1;
                continue;
            }
            sb_append_char(col_buf, ch);
            i = i + 1;
            continue;
        }
        if (ch == 34) {
            in_quotes = true;
            i = i + 1;
            continue;
        }
        if (ch == 44) {
            // 逗号 → 列分隔
            sb_append_str(row_buf, sb_to_str(col_buf));
            sb_append_char(row_buf, 31);
            col_buf = sb_new();
            i = i + 1;
            continue;
        }
        if (ch == 10) {
            // 换行 → 行结束
            sb_append_str(row_buf, sb_to_str(col_buf));
            append(rows, sb_to_str(row_buf));
            row_buf = sb_new();
            col_buf = sb_new();
            i = i + 1;
            continue;
        }
        if (ch == 13) {
            // CR → 跳过
            i = i + 1;
            continue;
        }
        sb_append_char(col_buf, ch);
        i = i + 1;
    }
    // 尾行
    if (str_len(sb_to_str(col_buf)) > 0 || str_len(sb_to_str(row_buf)) > 0) {
        sb_append_str(row_buf, sb_to_str(col_buf));
        append(rows, sb_to_str(row_buf));
    }
    return rows;
}

// 从 CSV 行中提取第 col 列的值（\x1f 分隔）
csv_col fn(row: string, col: i64) -> string {
    var idx: i64 = 0;
    var sb2: StringBuilder = sb_new();
    var L: u64 = str_len(row);
    var i: u64 = 0;
    while (i < L) {
        var ch: u8 = row[i];
        if (ch == 31) {
            if (idx == col) {
                return sb_to_str(sb2);
            }
            idx = idx + 1;
            sb2 = sb_new();
            i = i + 1;
            continue;
        }
        sb_append_char(sb2, ch);
        i = i + 1;
    }
    if (idx == col) {
        return sb_to_str(sb2);
    }
    return "";
}

// JSON 解析：期望顶层是对象数组 [ {..}, {..} ]。
// 按 imp_fnames[imp_fbase .. imp_fbase+num_fields) 的字段序，把每个对象
// 归一化成与 CSV 相同的 \x1f 分隔行，从而复用后续的值域校验与合成逻辑。
// 缺失的键归一化为空串（后续值域校验会报 T_IMPORT_VALUE）。
// 返回行数组；解析失败返回空数组。
json_parse fn(content: string, num_fields: i64) -> []string {
    var rows: []string;
    var L: u64 = str_len(content);
    var i: u64 = 0;

    // 跳到第一个 '['
    while (i < L && content[i] != 91) { i = i + 1; }
    if (i >= L) { return rows; }
    i = i + 1;

    while (i < L) {
        // 跳空白与逗号
        while (i < L) {
            var c0: u8 = content[i];
            if (c0 == 32 || c0 == 9 || c0 == 10 || c0 == 13 || c0 == 44) {
                i = i + 1;
                continue;
            }
            break;
        }
        if (i >= L) { break; }
        if (content[i] == 93) { break; }
        if (content[i] != 123) { return rows; }
        i = i + 1;

        // 收集本对象的键值对到临时并列表
        var kbase: i64 = slice_len(jp_keys) as i64;
        while (i < L) {
            // 跳空白与逗号
            while (i < L) {
                var c1: u8 = content[i];
                if (c1 == 32 || c1 == 9 || c1 == 10 || c1 == 13 || c1 == 44) {
                    i = i + 1;
                    continue;
                }
                break;
            }
            if (i >= L) { break; }
            if (content[i] == 125) { i = i + 1; break; }
            if (content[i] != 34) { return rows; }

            // 读键
            i = i + 1;
            var kb: StringBuilder = sb_new();
            while (i < L && content[i] != 34) {
                sb_append_char(kb, content[i]);
                i = i + 1;
            }
            i = i + 1;

            // 跳到冒号
            while (i < L && content[i] != 58) { i = i + 1; }
            i = i + 1;
            while (i < L) {
                var c2: u8 = content[i];
                if (c2 == 32 || c2 == 9 || c2 == 10 || c2 == 13) {
                    i = i + 1;
                    continue;
                }
                break;
            }
            if (i >= L) { break; }

            // 读值：字符串带引号，其余读到分隔符
            var vb: StringBuilder = sb_new();
            if (content[i] == 34) {
                i = i + 1;
                while (i < L && content[i] != 34) {
                    if (content[i] == 92 && i + 1 < L) {
                        i = i + 1;
                        var esc: u8 = content[i];
                        if (esc == 110) { sb_append_char(vb, 10); }
                        if (esc == 116) { sb_append_char(vb, 9); }
                        if (esc == 114) { sb_append_char(vb, 13); }
                        if (esc == 34) { sb_append_char(vb, 34); }
                        if (esc == 92) { sb_append_char(vb, 92); }
                        i = i + 1;
                        continue;
                    }
                    sb_append_char(vb, content[i]);
                    i = i + 1;
                }
                i = i + 1;
            } else {
                while (i < L) {
                    var c3: u8 = content[i];
                    if (c3 == 44 || c3 == 125 || c3 == 32 || c3 == 9 || c3 == 10 || c3 == 13) {
                        break;
                    }
                    sb_append_char(vb, c3);
                    i = i + 1;
                }
            }
            append(jp_keys, sb_to_str(kb));
            append(jp_vals, sb_to_str(vb));
        }

        // 按字段序拼成 \x1f 行
        var kn: i64 = slice_len(jp_keys) as i64;
        var rb: StringBuilder = sb_new();
        var fi: i64 = 0;
        while (fi < num_fields) {
            if (fi > 0) { sb_append_char(rb, 31); }
            var want: string = imp_fnames[(imp_fbase + fi) as u64];
            var ki: i64 = kbase;
            while (ki < kn) {
                if (jp_keys[ki as u64] == want) {
                    sb_append_str(rb, jp_vals[ki as u64]);
                    ki = kn;
                    continue;
                }
                ki = ki + 1;
            }
            fi = fi + 1;
        }
        append(rows, sb_to_str(rb));
    }
    return rows;
}

// 合成 __import_N 加载函数并返回其节点索引。
// 形态: __import_N fn() -> []StructName {
//   var __r: []StructName;
//   var __imp_r0: StructName = StructName{ f1: val1, f2: val2, ... };
//   append(__r, __imp_r0);
//   ...
//   return __r;
// }
synthesize_loader fn(sname: string, rows: []string, header_row: string, num_fields: i64, is_csv: bool) -> i64 {
    var fn_name: string = sb_cat2("__import_", i2s(g_imp_counter));
    g_imp_counter = g_imp_counter + 1;

    // 返回类型: []StructName
    var elem_named: i64 = mk_named(sname, -1);
    var ret_slice: i64 = mk_slice(elem_named, -1);

    // 函数体语句链表
    var body_head: i64 = -1;
    var body_tail: i64 = -1;

    // var __r: []StructName;
    var r_type: i64 = mk_slice(mk_named(sname, -1), -1);
    var r_decl: i64 = mk_var_decl("__r", false, r_type, -1, -1);
    body_tail = list_push(body_head, body_tail, r_decl);
    if (body_head < 0) { body_head = body_tail; }

    // CSV: header_row 是第一行，用于字段名映射
    // JSON: rows 直接是对象数组，field_names 已固定
    var nrows: i64 = slice_len(rows) as i64;
    var ri: i64 = 0;
    if (is_csv) {
        ri = 1; // 跳过表头
    }
    while (ri < nrows) {
        var row: string = rows[ri];
        // 构建 struct_lit 的字段链表
        var fv_head: i64 = -1;
        var fv_tail: i64 = -1;
        var ci: i64 = 0;
        while (ci < num_fields) {
            var fname: string = imp_fnames[(imp_fbase + ci) as u64];
            var ftype: string = imp_ftypes[(imp_fbase + ci) as u64];
            var col_val: string;
            if (is_csv) {
                // 根据 header_row 中的列名映射
                col_val = csv_col(row, ci);
            } else {
                col_val = csv_col(row, ci);
            }
            var vnode: i64 = make_value_node(col_val, ftype);
            var fv: i64 = mk_FV(fname, vnode, -1);
            fv_tail = list_push(fv_head, fv_tail, fv);
            if (fv_head < 0) { fv_head = fv_tail; }
            ci = ci + 1;
        }
        var lit: i64 = mk_struct_lit(sname, fv_head, -1);
        var tmp_name: string = sb_cat2("__imp_r", i2s(ri));
        var tmp_decl: i64 = mk_var_decl(tmp_name, false, mk_named(sname, -1), lit, -1);
        body_tail = list_push(body_head, body_tail, tmp_decl);
        if (body_head < 0) { body_head = body_tail; }

        // append(__r, __imp_r0);
        var call_args_head: i64 = -1;
        var call_args_tail: i64 = -1;
        call_args_tail = list_push(call_args_head, call_args_tail, mk_ident("__r", -1));
        if (call_args_head < 0) { call_args_head = call_args_tail; }
        call_args_tail = list_push(call_args_head, call_args_tail, mk_ident(tmp_name, -1));
        if (call_args_head < 0) { call_args_head = call_args_tail; }
        var append_call: i64 = mk_call(mk_ident("append", -1), call_args_head, -1);
        var append_stmt: i64 = mk_expr(append_call, -1);
        body_tail = list_push(body_head, body_tail, append_stmt);
        if (body_head < 0) { body_head = body_tail; }

        ri = ri + 1;
    }

    // return __r;
    var ret_stmt: i64 = mk_return(mk_ident("__r", -1), -1);
    body_tail = list_push(body_head, body_tail, ret_stmt);
    if (body_head < 0) { body_head = body_tail; }

    // ba=is_extern 必须为 false，否则 emitter 只发 declare 不发函数体；
    // lb=参数列表用 -2 表示空（-1 会被当作 null 链表头处理）
    var fdecl: i64 = mk_FuncDecl(fn_name, false, false, ret_slice, -1, -1, body_head, -1);
    // 注册符号
    sym_define(global_scope, fn_name, "func", ti_named("Func", fn_name), fdecl);
    // 加入 decl_list，使 emitter 能发射该合成函数。
    // 注意：desugar_imports 在 register 循环之后、check 循环之前运行，
    // check 循环用 slice_len(decl_list) 重新取长度，故新增项也会被检查。
    append(decl_list, fdecl);
    return fdecl;
}

// 检测一个表达式是否是 import_csv/import_json 调用
is_import_call fn(expr_idx: i64) -> string {
    if (expr_idx < 0) { return ""; }
    var n: Node = nodes[expr_idx];
    if (n.kind != "call") { return ""; }
    if (n.na < 0) { return ""; }
    var callee: Node = nodes[n.na];
    if (callee.kind != "ident") { return ""; }
    if (callee.sa == "import_csv") { return "csv"; }
    if (callee.sa == "import_json") { return "json"; }
    return "";
}

// 从 import call 节点提取路径参数字符串
import_path_arg fn(call_idx: i64) -> string {
    var n: Node = nodes[call_idx];
    var c: i64 = n.la;
    if (c < 0) { return ""; }
    var k: Child = kids[c];
    var arg: Node = nodes[k.val];
    if (arg.kind == "string") { return arg.sa; }
    return "";
}

// 对单个 var_decl 执行脱糖。成功返回 true。
desugar_one fn(var_idx: i64, file_for_diag: string, ln: i64, cl: i64) -> bool {
    var vn: Node = nodes[var_idx];
    var imp_kind: string = is_import_call(vn.nb);
    if (imp_kind == "") { return false; }

    // 提取目标类型: []StructName
    var sname: string = import_elem_struct_name(vn.na);
    if (sname == "") {
        diag_new("T_IMPORT_CONTEXT", "error",
            "import_csv/import_json requires target type []StructName",
            file_for_diag, ln, cl, ln, cl + 20);
        return false;
    }

    // 查找 struct 字段
    var field_head: i64 = find_struct_fields(sname);
    if (field_head < 0) {
        diag_new("T_IMPORT_CONTEXT", "error",
            sb_cat3("struct '", sname, "' not found for import"),
            file_for_diag, ln, cl, ln, cl + 20);
        return false;
    }

    imp_fbase = slice_len(imp_fnames) as i64;
    var num_fields: i64 = collect_struct_fields(field_head);

    // 提取路径参数
    var path: string = import_path_arg(vn.nb);
    if (path == "") {
        diag_new("T_IMPORT_CONTEXT", "error",
            "import_csv/import_json requires a string literal path argument",
            file_for_diag, ln, cl, ln, cl + 20);
        return false;
    }

    // 解析路径（相对源文件目录）
    var dir: string = "";
    var slash: i64 = -1;
    var pl: u64 = str_len(g_file);
    var pi: u64 = 0;
    while (pi < pl) {
        var ch: u8 = g_file[pi];
        if (ch == 47 || ch == 92) { slash = pi as i64; }
        pi = pi + 1;
    }
    if (slash >= 0) {
        dir = str_slice(g_file, 0, slash + 1);
    }
    var full_path: string = sb_cat2(dir, path);

    // 存在性检查
    if (file_exists(full_path) == false) {
        diag_new("T_IMPORT_IO", "error",
            sb_cat3("import: file not found: ", full_path, ""),
            file_for_diag, ln, cl, ln, cl + 20);
        return false;
    }

    // 读文件
    var content: string = file_read_all(full_path);

    // 解析
    var rows: []string;
    var is_csv: bool;
    if (imp_kind == "csv") {
        // CSV 首行是表头，后续按 is_csv 跳过
        is_csv = true;
        rows = csv_parse(content);
    } else {
        // JSON 已按字段序归一化，无表头行
        is_csv = false;
        rows = json_parse(content, num_fields);
    }

    if (slice_len(rows) as i64 == 0) {
        diag_new("T_IMPORT_IO", "error",
            sb_cat3("import: file is empty: ", full_path, ""),
            file_for_diag, ln, cl, ln, cl + 20);
        return false;
    }

    // CSV: 验证表头
    if (imp_kind == "csv") {
        var header: string = rows[0];
        var hi: i64 = 0;
        while (hi < num_fields) {
            var hval: string = csv_col(header, hi);
            if (hval != imp_fnames[(imp_fbase + hi) as u64]) {
                diag_new("T_IMPORT_HEADER", "error",
                    sb_cat5("CSV header column ", i2s(hi), ": expected '", imp_fnames[(imp_fbase + hi) as u64], "'"),
                    file_for_diag, ln, cl, ln, cl + 20);
                return false;
            }
            hi = hi + 1;
        }
    }

    // 值域校验
    var nrows: i64 = slice_len(rows) as i64;
    var ri2: i64 = 0;
    if (is_csv) { ri2 = 1; }
    while (ri2 < nrows) {
        var row2: string = rows[ri2];
        var ci2: i64 = 0;
        while (ci2 < num_fields) {
            var val2: string = csv_col(row2, ci2);
            var ftype2: string = imp_ftypes[(imp_fbase + ci2) as u64];
            if (validate_scalar_value(val2, ftype2, ri2, ci2) == false) {
                diag_new("T_IMPORT_VALUE", "error",
                    sb_cat5("import: row ", i2s(ri2), " col ", i2s(ci2), ": invalid value for type"),
                    file_for_diag, ln, cl, ln, cl + 20);
                return false;
            }
            ci2 = ci2 + 1;
        }
        ri2 = ri2 + 1;
    }

    // 合成加载函数
    var loader_fn: i64 = synthesize_loader(sname, rows, rows[0], num_fields, is_csv);

    // 替换原 init 为对加载函数的调用
    var new_call: i64 = mk_call(mk_ident(sb_cat2("__import_", i2s(g_imp_counter - 1)), -1), -1, -1);
    var nn: Node = nodes[var_idx];
    nn.nb = new_call;
    slice_set(nodes, var_idx, nn);

    return true;
}

// 遍历函数体语句链表，检测 import 脱糖点
desugar_stmts fn(stmt_head: i64, file_for_diag: string) -> void {
    var c: i64 = stmt_head;
    while (c >= 0) {
        var k: Child = kids[c];
        var s: Node = nodes[k.val];
        if (s.kind == "var_decl") {
            desugar_one(k.val, file_for_diag, s.ln, s.cl);
        }
        // 残存的 import 调用（不在 var 初始化位置）→ T_IMPORT_CONTEXT
        if (s.kind == "expr") {
            if (is_import_call(s.na) != "") {
                diag_new("T_IMPORT_CONTEXT", "error",
                    "import_csv/import_json is only allowed as a var initializer",
                    file_for_diag, s.ln, s.cl, s.ln, s.cl + 20);
            }
        }
        // 递归 if/while/for/block 体
        if (s.kind == "if") {
            desugar_stmts(s.la, file_for_diag);
            if (s.lb > -2) { desugar_stmts(s.lb, file_for_diag); }
        }
        if (s.kind == "while" || s.kind == "block") {
            desugar_stmts(s.la, file_for_diag);
        }
        if (s.kind == "for") {
            desugar_stmts(s.la, file_for_diag);
        }
        c = k.next;
    }
}

desugar_imports fn() -> void {
    g_imp_counter = 0;
    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = decl_list[i];
        var dn: Node = nodes[d];
        if (dn.kind == "FuncDecl" && dn.lc != -2) {
            desugar_stmts(dn.lc, n_file(d));
        }
        i = i + 1;
    }
}

// ── 模块系统：whole-program 内联解析 ──────────────────────────

// 取路径的目录部分（兼容 / 与 \）
mod_dir_of fn(p: string) -> string {
    var n: u64 = str_len(p);
    var i: u64 = n;
    while (i > 0) {
        i = i - 1;
        var c: u8 = p[i];
        if (c == 47 || c == 92) {
            return str_slice(p, 0, i);
        }
    }
    return ".";
}

// 取父目录（纯字符串，不依赖 _fullpath；盘符根/无分隔符返回 "" 表示已到顶）。
// 兼容 / 与 \；先剥除末尾分隔符，避免 "C:/" 被误判；用于 import 源码根向上遍历，
// 杜绝 _fullpath 把 "C:" 展开为「C 盘当前目录」导致的 C:/ <-> C:/Users/... 震荡 OOM。
parent_dir_of fn(p: string) -> string {
    var n: u64 = str_len(p);
    if (n == 0) { return ""; }
    var end: u64 = n;
    while (end > 0) {
        var c: u8 = p[end - 1];
        if (c == 47 || c == 92) { end = end - 1; } else { break; }
    }
    if (end == 0) { return ""; }
    var i: u64 = end;
    while (i > 0) {
        i = i - 1;
        var c: u8 = p[i];
        if (c == 47 || c == 92) {
            if (i == 0) { return ""; }   // 形如 /foo 的 unix 绝对路径，无更上层
            return str_slice(p, 0, i);
        }
    }
    return "";   // 无分隔符（如 C: 或裸名）
}

in_mod_aliases fn(sa: string) -> bool {
    var n: i64 = slice_len(g_mod_aliases) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (g_mod_aliases[i] == sa) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

in_mod_visited fn(p: string) -> bool {
    var n: i64 = slice_len(g_mod_visited) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (g_mod_visited[i] == p) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

mod_alias_add fn(nm: string, alias: string) -> void {
    if (alias == "") {
        if (in_mod_aliases(nm) == false) {
            append(g_mod_aliases, nm);
        }
    } else {
        if (in_mod_aliases(alias) == false) {
            append(g_mod_aliases, alias);
        }
    }
}

// 把模块文件解析为顶层声明，追加进 decl_list。
// 其内嵌的 import 在此就地递归解析（内联），不会以 ImportModDecl 形式残留。
// 注：解析后不再恢复 toks/pos —— check/emit 只依赖 AST，不再需要词法状态。
load_module_file fn(path: string) -> void {
    var saved_pos: i64 = pos;                 // 保存调用方的 token 流位置（支持嵌套 import 透明返回）
    var base: i64 = slice_len(toks) as i64;   // 模块 token 将从此下标开始（tokenize 是 append 语义）
    var msrc: string = file_read_all(path);
    tokenize(msrc);                           // 追加在入口/父模块 token 之后
    pos = base;                               // 从本模块起点解析，而非 0（否则会重解析入口文件）
    while (cur_t() != "Eof") {
        if (cur_t() == "Semicolon") {
            advance_i();
            continue;
        }
        var d: i64 = parse_declaration();
        if (d < 0) {
            continue;
        }
        if (nodes[d].kind == "ImportModDecl") {
            // 嵌套 import：就地递归解析，不加入 decl_list（统一相对候选源码根）
            handle_one_import(d);
        } else {
            append(decl_list, d);
        }
    }
    pos = saved_pos;                          // 恢复调用方（入口或父模块）的解析位置
}

// 解析单个 import 声明：定位模块文件 → 去重/环检测 → 内联加载
handle_one_import fn(imp: i64) -> void {
    var nm: string = nodes[imp].sb;
    var user_alias: string = nodes[imp].sc;
    if (nodes[imp].bc) {
        fc_err("T_EXPORT_SCOPE", "export 不能修饰 import 声明", imp);
        return;
    }
    // 工程内 import 统一相对候选源码根解析；模块名中的 '.' 即路径分隔符：import d.e => <root>/d/e.tc
    var rel: string = dots_to_slashes(nm);
    var chosen: string = "";
    var i: i64 = 0;
    var nr: i64 = slice_len(g_src_roots) as i64;
    while (i < nr) {
        var cand: string = path_resolve(sb_cat4(g_src_roots[i], "/", rel, ".tc"));
        if (path_exists(cand)) { chosen = cand; break; }
        i = i + 1;
    }
    if (chosen == "") {
        fc_err("T_IMPORT_NOT_FOUND",
            sb_cat3("模块 '", nm, "' 无法解析：未在任何源码根下找到对应 .tc 文件"), imp);
        return;
    }
    // 限定访问前缀 = 模块名最后一段（Go 风格）：import d.e 以 e.foo() 调用；
    // 用户显式 as 优先。
    var alias: string = user_alias;
    if (alias == "") { alias = last_segment(nm); }
    mod_alias_add(nm, alias);
    // 已加载过则跳过（同时天然打破 import 成环，避免无限递归）
    if (in_mod_visited(chosen)) {
        return;
    }
    append(g_mod_visited, chosen);
    load_module_file(chosen);
}

// 候选源码根列表（按优先级）：入口目录兜底 + 各祖先工程根/src（最近优先）。
// import 解析时依序尝试每个候选根下的 <rel>.tc，首个命中即采用。
// 这样既满足「工程根/src」约定（用户规范），又不破坏扁平/示例项目（入口目录兜底）。
var g_src_roots: []string;

// 计算候选源码根：
//  1) 入口文件所在目录（兜底，等同旧的「相对导入方」，保证扁平/示例/老项目可用）；
//  2) 从入口目录向上遍历祖先目录，凡是含 tote.toml 者，其 src 子目录即候选源码根
//     （<工程根>/src 约定，最近祖先优先），版本钉由 tote.toml 负责。
// path_exists 现已改用稳健的 file_exists 内建（不再走 sys_run 外 shell，消除 arena OOM），
// 故向上遍历在绝对路径下也安全。
compute_src_roots fn() -> void {
    var roots: []string;
    // 入口目录兜底（仅此处用一次 path_resolve 规范化，已知安全）。
    var entry_dir: string = path_resolve(mod_dir_of(g_file));
    append(roots, entry_dir);
    // 从入口目录向上遍历祖先，凡是含 tote.toml 者，其 src 子目录即候选源码根。
    // 循环内只用纯字符串 parent_dir_of（不碰 _fullpath），并设硬上限，杜绝震荡 OOM。
    // 拼接走 StringBuilder（LLVM 后端不支持 sb_cat2..6，故不用 sb_cat2）。
    var cur: string = entry_dir;
    var guard: i64 = 0;
    while (guard < 32) {
        guard = guard + 1;
        var parent: string = parent_dir_of(cur);
        if (parent == "" || parent == cur) { break; }
        cur = parent;
        var sb: StringBuilder = sb_new();
        sb_append_str(sb, cur);
        sb_append_str(sb, "/tote.toml");
        var toml: string = sb_to_str(sb);
        if (path_exists(toml)) {
            var sb2: StringBuilder = sb_new();
            sb_append_str(sb2, cur);
            sb_append_str(sb2, "/src");
            append(roots, sb_to_str(sb2));
        }
    }
    g_src_roots = roots;
}

// 取模块名最后一段作为限定访问前缀（Go 风格：import d.e 以 e.foo() 调用）。
last_segment fn(s: string) -> string {
    var n: u64 = str_len(s);
    var i: u64 = n;
    while (i > 0) {
        i = i - 1;
        var c: u8 = s[i];
        if (c == 46 || c == 47 || c == 92) {
            return str_slice(s, i + 1, n);
        }
    }
    return s;
}

// 模块名中的 '.' 转为路径分隔符：d.e -> d/e（用于拼接 .tc 路径）。
dots_to_slashes fn(s: string) -> string {
    var n: u64 = str_len(s);
    var sb: StringBuilder = sb_new();
    var i: u64 = 0;
    while (i < n) {
        var c: u8 = s[i];
        if (c == 46) { sb_append_char(sb, 47); }
        else { sb_append_char(sb, c); }
        i = i + 1;
    }
    return sb_to_str(sb);
}

// 顶层入口：内联所有 import，并构建模块别名集合。
// ImportModDecl 节点留在 decl_list 中无害（register/emit 均对其忽略）。
resolve_modules fn() -> void {
    compute_src_roots();
    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = decl_list[i];
        if (nodes[d].kind == "ImportModDecl") {
            handle_one_import(d);
        }
        i = i + 1;
    }
}

// 模块限定访问脱糖：`hello.add` / `hello.add(...)` → 裸 `add` 标识符。
// 仅当对象为标识符且其 sa 命中模块别名时才改写，结构体字段访问不受影响。
desugar_module_qualifiers fn() -> void {
    var tot: i64 = slice_len(nodes) as i64;
    var i: i64 = 0;
    while (i < tot) {
        var nd: Node = nodes[i];
        if (nd.kind == "member") {
            var ob: Node = nodes[nd.na];
            if (ob.kind == "ident" && in_mod_aliases(ob.sa)) {
                nd.kind = "ident";
                nd.na = -1;   // 丢弃对象（模块名）子节点
                slice_set(nodes, i, nd);
            }
        }
        i = i + 1;
    }
}

// ── check 主流程（复刻 checker.ts:83）─────────────────────────

run_check fn() -> void {
    global_scope = scope_new(-1);
    cur_scope = global_scope;
    cur_ret = ti_mk("Void");

    // 模块内联：在注册声明之前把 import 的模块整体并入 decl_list，
    // 并把 `hello.add` 限定访问改写成裸 `add`。单文件程序（无 import）零影响。
    resolve_modules();
    desugar_module_qualifiers();

    // 子句合并 + lambda 提升：必须在 register 之前跑（子句组先并成单一 FuncDecl，
    // 否则同名多条 FuncDecl 会被 register 当成重复定义）。覆盖模块内联后的整张 decl_list。
    desugar_func_clauses();
    desugar_lambdas();

    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        register_decl(decl_list[i]);
        i = i + 1;
    }
    desugar_imports();
    // desugar 可能追加合成的 __import_N 函数，重新取长度以便一并检查
    var n2: i64 = slice_len(decl_list) as i64;
    var j: i64 = 0;
    while (j < n2) {
        check_decl(decl_list[j]);
        j = j + 1;
    }
    scan_fid_format_atoms();
}

// fid_format(f) 返回 atom，四个格式名必须进本程序的原子表，且**必须在发射前**入表：
// LLVM 后端的 @t_atom_table 先于函数体发射，发射期再 intern 就漏到表外
// （id ≥ t_atom_count → atom_str 还原成空串）。
// 不能挂在 infer_expr 的 call 分支上——内建调用的实参不会被通用遍历，
// `atom_str(fid_format(f))` 这种嵌套里的内层调用根本不会被 infer 到。
// 故在检查末尾对全节点做一次平坦扫描，两个后端拿到的 id 也因此一致。
scan_fid_format_atoms fn() -> void {
    var tot: i64 = slice_len(nodes) as i64;
    var i: i64 = 0;
    while (i < tot) {
        var nd: Node = nodes[i];
        if (nd.kind == "call") {
            if (nd.na >= 0) {
                var ce: Node = nodes[nd.na];
                if (ce.kind == "ident" && ce.sa == "fid_format") {
                    fid_intern_fmt_atoms();
                    return;
                }
            }
        }
        i = i + 1;
    }
}

// ── Flag Resolver（复刻 tc0/flag/bitfield.ts resolve）─────────
// 注意：与 checker.checkFlagDecl 不同——overflow 先检、overlap 后检；
// FlagSetDecl 不产生诊断。

var fr_names: []string;
var fr_starts: []i64;
var fr_ends: []i64;

fr_resolve_flag fn(d: i64) -> void {
    var n: Node = nodes[d];
    var tw: i64 = get_bw(n.sb);
    if (tw < 0) {
        tw = 32;
    }
    var auto_off: i64 = 0;
    var base: i64 = slice_len(fr_names) as i64;

    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var sl: Node = nodes[k.val];
        var start: i64 = auto_off;
        if (sl.bb) {
            start = sl.ib;
        }
        var end: i64 = start + sl.ia;

        if (end > tw) {
            var osb: StringBuilder = sb_new();
            sb_append_str(osb, "flag '");
            sb_append_str(osb, n.sa);
            sb_append_str(osb, "' slot '");
            sb_append_str(osb, sl.sa);
            sb_append_str(osb, "' exceeds ");
            sb_append_str(osb, n.sb);
            sb_append_str(osb, " capacity: uses bits ");
            sb_append_i64(osb, start);
            sb_append_str(osb, "-");
            sb_append_i64(osb, end - 1);
            sb_append_str(osb, ", but ");
            sb_append_str(osb, n.sb);
            sb_append_str(osb, " only has ");
            sb_append_i64(osb, tw);
            sb_append_str(osb, " bits");
            var di: i64 = diag_new("T_FLAG_OVERFLOW", "error", sb_to_str(osb), "", 0, 0, 0, 0);
            slb_begin();
            slb_add(sb_cat2("0-", i2s(tw - 1)));
            diag_set_vv(di, slb_head);
            var fx: i64 = fix_one("reduce bit width or use larger underlying type (u64)", "", 0, 0, 0, 0, "flag[u64]");
            diag_set_fs(di, fx);
        }

        var i: i64 = base;
        var total: i64 = slice_len(fr_names) as i64;
        while (i < total) {
            var us: i64 = fr_starts[i];
            var ue: i64 = fr_ends[i];
            if (start < ue && end > us) {
                var msb: StringBuilder = sb_new();
                sb_append_str(msb, "flag slot '");
                sb_append_str(msb, sl.sa);
                sb_append_str(msb, "' (bits ");
                sb_append_i64(msb, start);
                sb_append_str(msb, "-");
                sb_append_i64(msb, end - 1);
                sb_append_str(msb, ") overlaps with '");
                sb_append_str(msb, fr_names[i]);
                sb_append_str(msb, "' (bits ");
                sb_append_i64(msb, us);
                sb_append_str(msb, "-");
                sb_append_i64(msb, ue - 1);
                sb_append_str(msb, ")");
                diag_new("T_FLAG_OFFSET_CONFLICT", "error", sb_to_str(msb), "", 0, 0, 0, 0);
            }
            i = i + 1;
        }

        append(fr_names, sl.sa);
        append(fr_starts, start);
        append(fr_ends, end);
        auto_off = end;
        c = k.next;
    }
}

flag_pass fn() -> void {
    // 复刻 index.ts compilePipeline：每个 FlagDecl 被 resolve 两次——
    // 一次经 typeInfoProvider.registerDecl（内部调 flagResolver.resolve），
    // 一次为管线中的直接 flagResolver.resolve(decl)。诊断因此重复两遍。
    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = decl_list[i];
        var nd: Node = nodes[d];
        if (nd.kind == "FlagDecl") {
            fr_resolve_flag(d);
            fr_resolve_flag(d);
        }
        i = i + 1;
    }
}

// ── 注解注册表（复刻 tc0/annotations/registry.ts）─────────────

AnnDef struct {
    name: string;
    spec: string;       // none/string/ident/ident_list/number/mixed
    targets: string;    // ", " 分隔（照 validTargets.join(", ") 顺序）
    depr: bool;
    repl: string;
}

var anndefs: []AnnDef;

ad fn(name: string, spec: string, targets: string) -> void {
    var a: AnnDef;
    a.name = name;
    a.spec = spec;
    a.targets = targets;
    a.depr = false;
    a.repl = "";
    append(anndefs, a);
}

// >>> GEN:annotations (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
init_anndefs fn() -> void {
    ad("test", "none", "func");
    ad("test_skip", "none", "func");
    ad("test_only", "none", "func");
    ad("expect_fail", "none", "func");
    ad("test_group", "string", "func");
    ad("derive", "ident_list", "struct, enum, flag, flag_set, union");
    ad("cfg", "ident", "global, func, struct, enum, var, const");
    ad("cfg_attr", "mixed", "global, func, struct, enum");
    ad("allow", "ident_list", "global, func, struct, var, const");
    ad("warn", "ident_list", "global, func, struct, var, const");
    ad("deny", "ident_list", "global, func, struct, var, const");
    ad("deprecated", "string", "global, func, struct, enum, var, const");
    ad("repr", "ident", "struct, enum, union");
    ad("no_padding", "none", "struct, flag");
    ad("align", "number", "struct, union");
    ad("bitpack", "ident", "struct");
    ad("offset", "number", "flag_slot");
    ad("binary_offset", "number", "field");
    ad("binary_skip", "none", "field");
    ad("soa", "none", "struct");
    ad("aos", "none", "struct");
    ad("inline", "none", "func");
    ad("no_inline", "none", "func");
    ad("must_use", "none", "func");
    ad("const_fn", "none", "func");
    ad("unsafe", "none", "func");
    ad("main", "none", "func");
    ad("export_symbol", "string", "func");
    ad("link_name", "string", "func");
    ad("panic_handler", "none", "func");
    ad("doc", "string", "global");
    ad("doc_file", "string", "func, struct, enum");
    ad("export", "mixed", "field, func, var, const");
    ad("auto_convert", "none", "struct, enum");
    // 弃用标记（数据驱动生成）
    var diauto_convert: i64 = anndef_find("auto_convert");
    if (diauto_convert >= 0) {
        var aauto_convert: AnnDef = anndefs[diauto_convert];
        aauto_convert.depr = true;
        aauto_convert.repl = "@derive(FromString)";
        slice_set(anndefs, diauto_convert, aauto_convert);
    }
}
// <<< GEN:annotations <<<

anndef_find fn(name: string) -> i64 {
    var n: i64 = slice_len(anndefs) as i64;
    var i: i64 = 0;
    while (i < n) {
        var a: AnnDef = anndefs[i];
        if (a.name == name) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// ", " 分隔的 targets 中精确匹配
targets_has fn(ts: string, t: string) -> bool {
    var n: i64 = str_len(ts) as i64;
    var start: i64 = 0;
    var i: i64 = 0;
    while (i <= n) {
        var hit: bool = i == n;
        if (hit == false) {
            hit = ts[i] == 44;
        }
        if (hit) {
            var seg: string = str_slice(ts, start, i);
            if (seg == t) {
                return true;
            }
            start = i + 2;
            i = i + 1;
        }
        i = i + 1;
    }
    return false;
}

// 把 targets 逐段加入 slb（validValues）
targets_push_vv fn(ts: string) -> void {
    var n: i64 = str_len(ts) as i64;
    var start: i64 = 0;
    var i: i64 = 0;
    while (i <= n) {
        var hit: bool = i == n;
        if (hit == false) {
            hit = ts[i] == 44;
        }
        if (hit) {
            slb_add(str_slice(ts, start, i));
            start = i + 2;
            i = i + 1;
        }
        i = i + 1;
    }
}

starts_with fn(s: string, p: string) -> bool {
    var np: u64 = str_len(p);
    if (str_len(s) < np) {
        return false;
    }
    var i: u64 = 0;
    while (i < np) {
        if (s[i] != p[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

is_cfg_cond fn(v: string) -> bool {
    if (v == "debug" || v == "release" || v == "windows" || v == "linux") {
        return true;
    }
    return v == "mac" || v == "android" || v == "web";
}

is_derive_trait fn(v: string) -> bool {
    if (v == "ToString" || v == "FromString" || v == "Clone" || v == "Copy") {
        return true;
    }
    if (v == "DebugPrint" || v == "BinarySerde" || v == "Eq") {
        return true;
    }
    return v == "PartialEq" || v == "Hash";
}

is_valid_warning fn(v: string) -> bool {
    if (v == "unused" || v == "unused_field" || v == "dead_code") {
        return true;
    }
    if (v == "overflow_literal" || v == "implicit_cast") {
        return true;
    }
    return v == "bitfield_overlap" || v == "deprecated";
}

// >>> GEN:derives (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
vv_derive_traits fn() -> void {
    slb_add("ToString");
    slb_add("FromString");
    slb_add("Clone");
    slb_add("Copy");
    slb_add("DebugPrint");
    slb_add("BinarySerde");
    slb_add("Eq");
    slb_add("PartialEq");
    slb_add("Hash");
}
// <<< GEN:derives <<<

vv_warnings fn() -> void {
    slb_add("unused");
    slb_add("unused_field");
    slb_add("dead_code");
    slb_add("overflow_literal");
    slb_add("implicit_cast");
    slb_add("bitfield_overlap");
    slb_add("deprecated");
}

vv_cfg fn() -> void {
    slb_add("debug");
    slb_add("release");
    slb_add("windows");
    slb_add("linux");
    slb_add("mac");
    slb_add("android");
    slb_add("web");
}

// derive/allow/warn/deny 的 trait/warning 项遍历校验
ann_check_items fn(ai: i64, is_derive: bool, l: i64, c: i64) -> void {
    var an: Node = nodes[ai];
    var c1: i64 = an.la;
    while (c1 >= 0) {
        var k: Child = kids[c1];
        var arg: Node = nodes[k.val];
        if (arg.kind == "list") {
            var c2: i64 = arg.la;
            while (c2 >= 0) {
                var k2: Child = kids[c2];
                var m: Node = nodes[k2.val];
                var v: string = "";
                if (m.kind == "ident") {
                    v = m.sa;
                }
                ann_check_item(v, is_derive, l, c);
                c2 = k2.next;
            }
        } else {
            var v2: string = "";
            if (arg.kind == "ident") {
                v2 = arg.sa;
            }
            ann_check_item(v2, is_derive, l, c);
        }
        c1 = k.next;
    }
}

ann_check_item fn(v: string, is_derive: bool, l: i64, c: i64) -> void {
    if (is_derive) {
        if (is_derive_trait(v) == false) {
            var di: i64 = diag_new("T_DERIVE_UNSUPPORTED", "error",
                sb_cat3("unsupported derive trait '", v, "'"),
                g_file, l, c, l, c + 20);
            slb_begin();
            vv_derive_traits();
            diag_set_vv(di, slb_head);
        }
        return;
    }
    if (is_valid_warning(v) == false) {
        var di2: i64 = diag_new("T_ANNOTATION_INVALID_ARG", "error",
            sb_cat3("unknown warning item '", v, "'"),
            g_file, l, c, l, c + 20);
        slb_begin();
        vv_warnings();
        diag_set_vv(di2, slb_head);
    }
}

// validate（复刻 registry.ts:168）；ai = A 节点索引
ann_validate fn(ai: i64, target: string) -> void {
    var an: Node = nodes[ai];
    var name: string = an.sa;
    var l: i64 = an.ln as i64;
    var c: i64 = an.cl as i64;
    var name_len: i64 = str_len(name) as i64;
    var di_: i64 = anndef_find(name);

    if (di_ < 0) {
        var d1: i64 = diag_new("T_ANNOTATION_UNKNOWN", "error",
            sb_cat3("unknown annotation '@", name, "'"),
            g_file, l, c, l, c + name_len + 1);
        slb_begin();
        var n: i64 = slice_len(anndefs) as i64;
        var i: i64 = 0;
        while (i < n) {
            var a: AnnDef = anndefs[i];
            slb_add(sb_cat2("@", a.name));
            i = i + 1;
        }
        diag_set_vv(d1, slb_head);
        return;
    }

    var def: AnnDef = anndefs[di_];

    if (def.depr) {
        var msg: string = sb_cat3("annotation '@", name, "' is deprecated");
        if (str_len(def.repl) > 0) {
            msg = sb_cat4(msg, ", use ", def.repl, " instead");
        }
        diag_new("T_ANNOTATION_UNKNOWN", "warning", msg, g_file, l, c, l, c + name_len + 1);
    }

    if (targets_has(def.targets, target) == false) {
        var d2: i64 = diag_new("T_ANNOTATION_WRONG_TARGET", "error",
            sb_cat6("annotation '@", name, "' cannot be applied to ", target, ", valid targets: ", def.targets),
            g_file, l, c, l, c + name_len + 1);
        slb_begin();
        targets_push_vv(def.targets);
        diag_set_vv(d2, slb_head);
    }

    // ── validateArgs ──
    var argc: i64 = list_count(an.la);

    if (def.spec == "none") {
        if (argc > 0) {
            diag_new("T_ANNOTATION_INVALID_ARG", "error",
                sb_cat3("annotation '@", name, "' takes no arguments"),
                g_file, l, c, l, c + name_len + 1);
        }
        return;
    }
    if (def.spec == "string") {
        var bad: bool = argc != 1;
        if (bad == false) {
            var k0: Child = kids[an.la];
            var a0: Node = nodes[k0.val];
            bad = a0.kind != "string";
        }
        if (bad) {
            var d3: i64 = diag_new("T_ANNOTATION_INVALID_ARG", "error",
                sb_cat3("annotation '@", name, "' requires exactly one string argument"),
                g_file, l, c, l, c + name_len + 1);
            slb_begin();
            slb_add("@${annotation.name}(\"text\")");
            diag_set_vv(d3, slb_head);
        }
        return;
    }
    if (def.spec == "ident") {
        var bad2: bool = argc != 1;
        var a0k: string = "";
        var a0v: string = "";
        if (argc >= 1) {
            var k1: Child = kids[an.la];
            var a1: Node = nodes[k1.val];
            a0k = a1.kind;
            a0v = a1.sa;
        }
        if (bad2 == false) {
            bad2 = a0k != "ident" && a0k != "list";
        }
        if (bad2) {
            diag_new("T_ANNOTATION_INVALID_ARG", "error",
                sb_cat3("annotation '@", name, "' requires one identifier argument"),
                g_file, l, c, l, c + name_len + 1);
        }
        if (name == "cfg" && a0k == "ident") {
            if (is_cfg_cond(a0v) == false && starts_with(a0v, "feature=") == false) {
                var d4: i64 = diag_new("T_ANNOTATION_INVALID_ARG", "error",
                    sb_cat3("invalid @cfg condition '", a0v, "'"),
                    g_file, l, c, l, c + name_len + 1);
                slb_begin();
                vv_cfg();
                diag_set_vv(d4, slb_head);
            }
        }
        return;
    }
    if (def.spec == "ident_list") {
        if (argc < 1) {
            diag_new("T_ANNOTATION_INVALID_ARG", "error",
                sb_cat3("annotation '@", name, "' requires at least one argument"),
                g_file, l, c, l, c + name_len + 1);
        }
        if (name == "derive") {
            ann_check_items(ai, true, l, c);
        }
        if (name == "allow" || name == "warn" || name == "deny") {
            ann_check_items(ai, false, l, c);
        }
        return;
    }
    if (def.spec == "number") {
        var bad3: bool = argc != 1;
        if (bad3 == false) {
            var k2: Child = kids[an.la];
            var a2: Node = nodes[k2.val];
            bad3 = a2.kind != "number";
        }
        if (bad3) {
            diag_new("T_ANNOTATION_INVALID_ARG", "error",
                sb_cat3("annotation '@", name, "' requires one numeric argument"),
                g_file, l, c, l, c + name_len + 1);
        }
        return;
    }
}

// getDeclTarget（复刻 index.ts:181）
decl_target fn(kind: string) -> string {
    if (kind == "StructDecl") {
        return "struct";
    }
    if (kind == "EnumDecl") {
        return "enum";
    }
    if (kind == "FlagDecl") {
        return "flag";
    }
    if (kind == "FlagSetDecl") {
        return "flag_set";
    }
    if (kind == "UnionDecl") {
        return "union";
    }
    if (kind == "VariantDecl") {
        return "variant";
    }
    if (kind == "FuncDecl") {
        return "func";
    }
    if (kind == "GlobalVarDecl") {
        return "var";
    }
    if (kind == "GlobalConstDecl") {
        return "const";
    }
    return "global";
}

ann_pass fn() -> void {
    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = decl_list[i];
        var nd: Node = nodes[d];
        var target: string = decl_target(nd.kind);
        var c: i64 = nd.la;
        while (c >= 0) {
            var k: Child = kids[c];
            ann_validate(k.val, target);
            c = k.next;
        }
        i = i + 1;
    }
}

// ── pretty JSON 输出（复刻 JSON.stringify(x, null, 2)）────────

hex_digit fn(v: u8) -> u8 {
    if (v < 10) {
        return 48 + v;
    }
    return 97 + (v - 10);
}

json_escape_into fn(out: StringBuilder, s: string) -> void {
    var i: u64 = 0;
    var n: u64 = str_len(s);
    while (i < n) {
        var b: u8 = s[i];
        if (b == 34) {
            sb_append_char(out, 92);
            sb_append_char(out, 34);
        } else {
        if (b == 92) {
            sb_append_char(out, 92);
            sb_append_char(out, 92);
        } else {
        if (b == 10) {
            sb_append_char(out, 92);
            sb_append_char(out, 110);
        } else {
        if (b == 9) {
            sb_append_char(out, 92);
            sb_append_char(out, 116);
        } else {
        if (b == 13) {
            sb_append_char(out, 92);
            sb_append_char(out, 114);
        } else {
        if (b == 8) {
            sb_append_char(out, 92);
            sb_append_char(out, 98);
        } else {
        if (b == 12) {
            sb_append_char(out, 92);
            sb_append_char(out, 102);
        } else {
        if (b < 32) {
            sb_append_char(out, 92);
            sb_append_char(out, 117);
            sb_append_char(out, 48);
            sb_append_char(out, 48);
            sb_append_char(out, hex_digit(b / 16));
            sb_append_char(out, hex_digit(b % 16));
        } else {
            sb_append_char(out, b);
        }}}}}}}}
        i = i + 1;
    }
}

j_qstr fn(out: StringBuilder, s: string) -> void {
    sb_append_char(out, 34);
    json_escape_into(out, s);
    sb_append_char(out, 34);
}

// "      \"key\": \"value\",\n" 之类的辅助
jkv_str fn(out: StringBuilder, ind: string, key: string, val: string, comma: bool) -> void {
    sb_append_str(out, ind);
    sb_append_char(out, 34);
    sb_append_str(out, key);
    sb_append_str(out, "\": ");
    j_qstr(out, val);
    if (comma) {
        sb_append_char(out, 44);
    }
    sb_append_char(out, 10);
}

jkv_num fn(out: StringBuilder, ind: string, key: string, val: i64, comma: bool) -> void {
    sb_append_str(out, ind);
    sb_append_char(out, 34);
    sb_append_str(out, key);
    sb_append_str(out, "\": ");
    sb_append_i64(out, val);
    if (comma) {
        sb_append_char(out, 44);
    }
    sb_append_char(out, 10);
}

// location/range 对象输出
j_loc fn(out: StringBuilder, ind: string, ind2: string, key: string, file: string, sl: i64, sc: i64, el: i64, ec: i64, comma: bool) -> void {
    sb_append_str(out, ind);
    sb_append_char(out, 34);
    sb_append_str(out, key);
    sb_append_str(out, "\": {");
    sb_append_char(out, 10);
    jkv_str(out, ind2, "file", file, true);
    jkv_num(out, ind2, "startLine", sl, true);
    jkv_num(out, ind2, "startCol", sc, true);
    jkv_num(out, ind2, "endLine", el, true);
    jkv_num(out, ind2, "endCol", ec, false);
    sb_append_str(out, ind);
    sb_append_char(out, 125);
    if (comma) {
        sb_append_char(out, 44);
    }
    sb_append_char(out, 10);
}

// 字符串链表数组输出（validValues/notes）；head=-1 输出 null
j_str_list fn(out: StringBuilder, ind: string, ind2: string, key: string, head: i64, comma: bool) -> void {
    sb_append_str(out, ind);
    sb_append_char(out, 34);
    sb_append_str(out, key);
    sb_append_str(out, "\": ");
    if (head < 0) {
        sb_append_str(out, "null");
    } else {
        sb_append_char(out, 91);
        sb_append_char(out, 10);
        var c: i64 = head;
        while (c >= 0) {
            var it: SI = sitems[c];
            sb_append_str(out, ind2);
            j_qstr(out, it.s);
            if (it.next >= 0) {
                sb_append_char(out, 44);
            }
            sb_append_char(out, 10);
            c = it.next;
        }
        sb_append_str(out, ind);
        sb_append_char(out, 93);
    }
    if (comma) {
        sb_append_char(out, 44);
    }
    sb_append_char(out, 10);
}

print_json fn() -> void {
    var out: StringBuilder = sb_new();
    var nd: i64 = slice_len(diags) as i64;

    sb_append_str(out, "{\n");
    if (nd == 0) {
        sb_append_str(out, "  \"diagnostics\": [],\n");
    } else {
        sb_append_str(out, "  \"diagnostics\": [\n");
        var i: i64 = 0;
        while (i < nd) {
            var d: Diag = diags[i];
            sb_append_str(out, "    {\n");
            jkv_str(out, "      ", "code", d.code, true);
            jkv_str(out, "      ", "severity", d.sev, true);
            jkv_str(out, "      ", "message", d.msg, true);
            j_loc(out, "      ", "        ", "location", d.file, d.sl, d.sc, d.el, d.ec, true);
            j_str_list(out, "      ", "        ", "validValues", d.vv, true);

            // fixSuggestions
            sb_append_str(out, "      \"fixSuggestions\": ");
            if (d.fs < 0) {
                sb_append_str(out, "null");
            } else {
                sb_append_str(out, "[\n");
                var f: i64 = d.fs;
                while (f >= 0) {
                    var fx: FixS = fixes[f];
                    sb_append_str(out, "        {\n");
                    jkv_str(out, "          ", "description", fx.desc, true);
                    j_loc(out, "          ", "            ", "range", fx.file, fx.sl, fx.sc, fx.el, fx.ec, true);
                    jkv_str(out, "          ", "replacement", fx.repl, false);
                    sb_append_str(out, "        }");
                    if (fx.next >= 0) {
                        sb_append_char(out, 44);
                    }
                    sb_append_char(out, 10);
                    f = fx.next;
                }
                sb_append_str(out, "      ]");
            }
            sb_append_str(out, ",\n");

            j_str_list(out, "      ", "        ", "notes", d.nt, false);

            sb_append_str(out, "    }");
            if (i + 1 < nd) {
                sb_append_char(out, 44);
            }
            sb_append_char(out, 10);
            i = i + 1;
        }
        sb_append_str(out, "  ],\n");
    }

    var errs: i64 = 0;
    var warns: i64 = 0;
    var infos: i64 = 0;
    var j: i64 = 0;
    while (j < nd) {
        var d2: Diag = diags[j];
        if (d2.sev == "error") {
            errs = errs + 1;
        }
        if (d2.sev == "warning") {
            warns = warns + 1;
        }
        if (d2.sev == "info") {
            infos = infos + 1;
        }
        j = j + 1;
    }
    sb_append_str(out, "  \"summary\": {\n");
    jkv_num(out, "    ", "total", nd, true);
    jkv_num(out, "    ", "errors", errs, true);
    jkv_num(out, "    ", "warnings", warns, true);
    jkv_num(out, "    ", "infos", infos, false);
    sb_append_str(out, "  }\n");
    sb_append_str(out, "}");

    print(sb_to_str(out));
    print("\n");
}

has_errors fn() -> bool {
    var n: i64 = slice_len(diags) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: Diag = diags[i];
        if (d.sev == "error") {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// ═══════════════════════════════════════════════════════════════
// M8: C Emitter（复刻 tc0/codegen/emitter.ts）
// ═══════════════════════════════════════════════════════════════

// ── 输出行池 ───────────────────────────────────────────────────

var hlines: []string;   // headerLines
var slines: []string;   // sourceLines
var glines: []string;   // 全局初始化函数体（t__ginit）
// 重定向开关：为 true 时 spush 写入 glines（全局 var 初始化器需运行期构建，
// 如 map 字面量在 C 中不是编译期常量，必须搬进 t__ginit）。
var g_spush_to_ginit: bool = false;
// type_info(T) 编译期常量合成（M36）：去重表 + 模块级常量定义缓冲
var ti_lines: []string;
var ti_done: []string;

hpush fn(s: string) -> void {
    append(hlines, s);
}

spush fn(s: string) -> void {
    if (g_spush_to_ginit) {
        append(glines, s);
        return;
    }
    append(slines, s);
}

// 向最后一行追加文本（ForStmt 拼接用）
sappend_last fn(s: string) -> void {
    var n: i64 = slice_len(slines) as i64;
    var last: string = slines[n - 1];
    var joined: string = sb_cat2(last, s);
    slice_set(slines, n - 1, joined);
}

// ── 小工具 ─────────────────────────────────────────────────────

to_upper fn(s: string) -> string {
    var sb: StringBuilder = sb_new();
    var i: u64 = 0;
    var n: u64 = str_len(s);
    while (i < n) {
        var c: u8 = s[i];
        if (c >= 97 && c <= 122) {
            sb_append_char(sb, c - 32);
        } else {
            sb_append_char(sb, c);
        }
        i = i + 1;
    }
    return sb_to_str(sb);
}

ends_with_star fn(s: string) -> bool {
    var n: u64 = str_len(s);
    if (n == 0) {
        return false;
    }
    return s[n - 1] == 42;
}

// ── TypeDesc 池（复刻 TypeDesc interface）──────────────────────
// cat: "string" | "slice" | "map" | "named" | "scalar" | "unknown" | "void"

TD struct {
    cat: string;
    name: string;
    elem: i64;   // TD 索引，-1 = 无
    key: i64;
    val: i64;
    alen: i64;   // cat == "array" 时的定长长度，其余为 -1
}

var tds: []TD;

// 函数类型（cat == "func"）签名侧池：索引与 tds 对齐
var tdf_ret: []i64;      // 返回类型 TD 索引
var tdf_pstart: []i64;   // 参数区起点（tdf_params 下标）
var tdf_pcount: []i64;   // 参数个数
var tdf_params: []i64;   // 参数类型 TD 索引扁平区

// 字段类型可读名（用于 TypeInfo 的 type_name 字段，双后端一致）
td_readable fn(td: i64) -> string {
    if (td < 0) { return "?"; }
    var t: TD = tds[td];
    if (t.cat == "scalar") {
        if (t.name == "") { return "i64"; }
        return t.name;
    }
    if (t.cat == "string") { return "string"; }
    if (t.cat == "void") { return "void"; }
    if (t.cat == "unknown") { return "unknown"; }
    if (t.cat == "named") { return t.name; }
    if (t.cat == "typeinfo") { return t.name; }
    if (t.cat == "fieldinfo") { return "FieldInfo"; }
    if (t.cat == "slice") { return sb_cat2("[]", td_readable(t.elem)); }
    if (t.cat == "array") { return sb_cat4("[", i2s(t.alen), "]", td_readable(t.elem)); }
    if (t.cat == "map") { return sb_cat4("map[", td_readable(t.key), "]", td_readable(t.val)); }
    if (t.cat == "sym") { return sb_cat5("Sym", i2s(t.alen), "(\"", t.name, "\")"); }
    if (t.cat == "func") {
        var fb: StringBuilder = sb_new();
        sb_append_str(fb, "fn(");
        var fi: i64 = 0;
        while (fi < tdf_pcount[td]) {
            if (fi > 0) { sb_append_str(fb, ", "); }
            sb_append_str(fb, td_readable(tdf_params[tdf_pstart[td] + fi]));
            fi = fi + 1;
        }
        sb_append_str(fb, ") -> ");
        sb_append_str(fb, td_readable(tdf_ret[td]));
        return sb_to_str(fb);
    }
    return "?";
}

// 字段是否引用类型（指针/聚合，is_ptr=1）；标量/void 为 false
is_ref_type fn(td: i64) -> bool {
    if (td < 0) { return false; }
    var t: TD = tds[td];
    if (t.cat == "scalar" || t.cat == "void" || t.cat == "unknown") { return false; }
    return true;
}

td_mk fn(cat: string) -> i64 {
    var t: TD;
    t.cat = cat;
    t.name = "";
    t.elem = -1;
    t.key = -1;
    t.val = -1;
    t.alen = -1;
    append(tds, t);
    var idx: i64 = (slice_len(tds) as i64) - 1;
    append(tdf_ret, -1);
    append(tdf_pstart, -1);
    append(tdf_pcount, 0);
    return idx;
}

// 构造函数类型 TD：参数类型须已 append 到 tdf_params[pstart .. pstart+pcount)
td_func fn(ret: i64, pstart: i64, pcount: i64) -> i64 {
    var i: i64 = td_mk("func");
    tdf_ret[i] = ret;
    tdf_pstart[i] = pstart;
    tdf_pcount[i] = pcount;
    return i;
}

// ── 闭包表示（FuncType v2 / M47）───────────────────────────────
// 函数类型的**值**在两个后端都是「指向 TClosure { void* fn; void* env; } 的指针」：
//   C 后端    → TClosure*
//   LLVM 后端 → ptr（沿用 v1 的不透明指针，避开 Win64 聚合 ABI）
// 底层被调函数统一按 `Ret (*)(void* env, Args...)` 调用，env 为首参。
// 顶层具名函数（含提升后的 lambda）自身没有 env 首参，故「函数作为值」时经
// 一层 static trampoline 吃掉 env 再转发；捕获型闭包（Stage B2）则直接把提升
// 函数的 env 首参接上堆分配的环境记录。
//
// 调用点强转类型：`Ret (*)(void*, A0, A1)`（无名声明子）
td_func_c_fnptr fn(td: i64) -> string {
    var b: StringBuilder = sb_new();
    sb_append_str(b, desc_to_c(tdf_ret[td]));
    sb_append_str(b, " (*)(void*");
    var i: i64 = 0;
    while (i < tdf_pcount[td]) {
        sb_append_str(b, ", ");
        sb_append_str(b, desc_to_c(tdf_params[tdf_pstart[td] + i]));
        i = i + 1;
    }
    sb_append_str(b, ")");
    return sb_to_str(b);
}

// 该 TD 是否为函数类型
td_is_func fn(td: i64) -> bool {
    if (td < 0) { return false; }
    return tds[td].cat == "func";
}

// 「被当作值使用」的顶层函数名，发射期惰性去重收集；全部函数体发射完毕后
// 统一生成 trampoline 与闭包全局（C 追加到头文件尾，LLVM 追加到模块尾）。
// 只有真正取值的函数才生成，避免为全库上千个函数产出无用代码。
var clos_names: []string;

clos_mark fn(name: string) -> void {
    var n: i64 = slice_len(clos_names) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (clos_names[i] == name) { return; }
        i = i + 1;
    }
    append(clos_names, name);
}

// 按名字回查顶层 FuncDecl 节点。只在生成 trampoline 时调用，规模 = 被取值的
// 函数个数（通常个位数），线性扫描无性能问题。
clos_decl_of fn(name: string) -> i64 {
    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = decl_list[i];
        var dn: Node = nodes[d];
        if (dn.kind == "FuncDecl") {
            if (dn.sa == name) {
                return d;
            }
        }
        i = i + 1;
    }
    return -1;
}

// 间接调用点所需的函数类型 TD：局部变量优先，其次全局变量；顶层具名函数
// （tm 里有 "name()" 条目）不算间接调用。
clos_callee_td fn(cn: string) -> i64 {
    var td: i64 = -1;
    if (em_in_fn) {
        td = fs_get(em_cur_fn, mb_sub(cn));
    }
    if (td_is_func(td)) {
        return td;
    }
    if (tm_get(sb_cat2(cn, "()")) >= 0) {
        return -1;
    }
    var g: i64 = tm_get(mb_sub(cn));
    if (td_is_func(g)) {
        return g;
    }
    return -1;
}

// 「类型 + 名字」的 C 声明。函数类型已统一为 TClosure*（普通指针），
// 不再需要把名字嵌进函数指针声明子。
c_decl_of fn(td: i64, name: string) -> string {
    return sb_cat3(desc_to_c(td), " ", name);
}

// 指向该类型的 C 指针类型名
c_ptr_to fn(td: i64) -> string {
    return sb_cat2(desc_to_c(td), "*");
}

// 同上，但输入是类型节点（发射期大多数位置持有的是节点索引）
c_decl_of_node fn(tn: i64, name: string) -> string {
    return sb_cat3(emit_ctype(tn), " ", name);
}

td_named_mk fn(cat: string, name: string) -> i64 {
    var i: i64 = td_mk(cat);
    var t: TD = tds[i];
    t.name = name;
    slice_set(tds, i, t);
    return i;
}

td_elem_mk fn(cat: string, elem: i64) -> i64 {
    var i: i64 = td_mk(cat);
    var t: TD = tds[i];
    t.elem = elem;
    slice_set(tds, i, t);
    return i;
}

// ── typeMap / fnScopes / structFields（扁平池，last-match-wins）─

var tm_names: []string;   // 全局 typeMap（globals + "fn()" 返回类型）
var tm_tds: []i64;

var fs_fns: []string;     // 函数级 scope：函数名 + 变量名 → td
var fs_vars: []string;
var fs_tds: []i64;

var sf_structs: []string; // struct 字段：struct 名 + 字段名 → td
var sf_fields: []string;
var sf_tds: []i64;

var em_cur_fn: string;    // 当前作用域函数名（"" = 无）
var em_in_fn: bool;

var em_main_fn: string;   // @main 函数的 mangle 名
var em_has_main: bool;

// C 后端：按字段依赖拓扑排序后，已先发射的 struct 族类型名集合（供主循环跳过）。
// 原因：C 要求 struct 在被值内嵌（作为字段）之前已完整定义；而导入模块的 struct
// （如 physics 的 Position/Velocity）被追加在 entry 之后，按 decl_list 顺序发射会因
// 类型未完成而报错。拓扑排序保证「被依赖者先定义」。指针/切片字段不强制顺序。
var g_emitted_structs: []string;

// 判断字符串是否已在切片中（用于 g_emitted_structs 查重）。
str_in_slice fn(sl: []string, v: string) -> bool {
    var n: i64 = slice_len(sl) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (sl[i] == v) { return true; }
        i = i + 1;
    }
    return false;
}

// 按字段依赖拓扑排序，先发射所有 struct/union/variant 族类型的完整定义。
// 工作表算法：反复发射「依赖均已满足」的类型，直到无进展；残留（环等异常）原序补发。
emit_struct_families_ordered fn() -> void {
    var _empty: []string;
    g_emitted_structs = _empty;
    var sdecls: []i64;
    var snames: []string;
    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = decl_list[i];
        var k: string = nodes[d].kind;
        if (k == "StructDecl" || k == "UnionDecl" || k == "VariantDecl") {
            append(sdecls, d);
            append(snames, nodes[d].sa);
        }
        i = i + 1;
    }
    var m: i64 = slice_len(sdecls) as i64;
    if (m == 0) { return; }
    var done: []bool;
    var di: i64 = 0;
    while (di < m) { append(done, false); di = di + 1; }

    var progressed: bool = true;
    var guard: i64 = 0;
    while (progressed) {
        progressed = false;
        var j: i64 = 0;
        while (j < m) {
            if (done[j]) { j = j + 1; continue; }
            var d: i64 = sdecls[j];
            var ok: bool = true;
            var depbuf: []string;
            var c: i64 = nodes[d].lb;
            while (c >= 0) {
                var f: Node = nodes[kids[c].val];
                if (f.na >= 0) {
                    var tn: i64 = f.na;
                    var tk: string = nodes[tn].kind;
                    if (tk == "named") {
                        append(depbuf, nodes[tn].sa);
                    } else if (tk == "array") {
                        var en: i64 = nodes[tn].na;
                        if (en >= 0 && nodes[en].kind == "named") {
                            append(depbuf, nodes[en].sa);
                        }
                    }
                }
                c = kids[c].next;
            }
            var dl: i64 = slice_len(depbuf) as i64;
            var kk: i64 = 0;
            while (kk < dl) {
                var dep: string = depbuf[kk];
                var is_sd: bool = false;
                var sd_idx: i64 = -1;
                var si: i64 = 0;
                while (si < m) {
                    if (snames[si] == dep) { is_sd = true; sd_idx = si; }
                    si = si + 1;
                }
                if (is_sd && done[sd_idx] == false) { ok = false; }
                kk = kk + 1;
            }
            if (ok) {
                var kk2: string = nodes[d].kind;
                if (kk2 == "StructDecl") { emit_struct_decl(d); }
                else if (kk2 == "UnionDecl") { emit_union_decl(d); }
                else if (kk2 == "VariantDecl") { emit_variant_decl(d); }
                append(g_emitted_structs, snames[j]);
                done[j] = true;
                progressed = true;
            }
            j = j + 1;
        }
        guard = guard + 1;
        if (guard > m + 2) { progressed = false; }
    }
    var j2: i64 = 0;
    while (j2 < m) {
        if (done[j2] == false) {
            var d: i64 = sdecls[j2];
            var kk2: string = nodes[d].kind;
            if (kk2 == "StructDecl") { emit_struct_decl(d); }
            else if (kk2 == "UnionDecl") { emit_union_decl(d); }
            else if (kk2 == "VariantDecl") { emit_variant_decl(d); }
            append(g_emitted_structs, snames[j2]);
            done[j2] = true;
        }
        j2 = j2 + 1;
    }
}

tm_set fn(name: string, td: i64) -> void {
    append(tm_names, name);
    append(tm_tds, td);
}

tm_get fn(name: string) -> i64 {
    var n: i64 = slice_len(tm_names) as i64;
    var i: i64 = n - 1;
    while (i >= 0) {
        if (tm_names[i] == name) {
            return tm_tds[i];
        }
        i = i - 1;
    }
    return -1;
}

fs_set fn(fn_name: string, var_name: string, td: i64) -> void {
    append(fs_fns, fn_name);
    append(fs_vars, var_name);
    append(fs_tds, td);
}

fs_get fn(fn_name: string, var_name: string) -> i64 {
    var n: i64 = slice_len(fs_fns) as i64;
    var i: i64 = n - 1;
    while (i >= 0) {
        if (fs_fns[i] == fn_name && fs_vars[i] == var_name) {
            return fs_tds[i];
        }
        i = i - 1;
    }
    return -1;
}

sf_set fn(st: string, fname: string, td: i64) -> void {
    append(sf_structs, st);
    append(sf_fields, fname);
    append(sf_tds, td);
}

sf_get fn(st: string, fname: string) -> i64 {
    var n: i64 = slice_len(sf_structs) as i64;
    var i: i64 = n - 1;
    while (i >= 0) {
        if (sf_structs[i] == st && sf_fields[i] == fname) {
            return sf_tds[i];
        }
        i = i - 1;
    }
    return -1;
}

// ── scalarToC（复刻 emitter.ts scalarToC + emitType scalar map）─

// >>> GEN:scalar_ctype (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
scalar_to_c fn(name: string) -> string {
    if (name == "u8") { return "uint8_t"; }
    if (name == "u16") { return "uint16_t"; }
    if (name == "u32") { return "uint32_t"; }
    if (name == "u64") { return "uint64_t"; }
    if (name == "i8") { return "int8_t"; }
    if (name == "i16") { return "int16_t"; }
    if (name == "i32") { return "int32_t"; }
    if (name == "i64") { return "int64_t"; }
    if (name == "f16") { return "_Float16"; }
    if (name == "f32") { return "float"; }
    if (name == "f64") { return "double"; }
    if (name == "bool") { return "bool"; }
    if (name == "void") { return "void"; }
    if (name == "atom") { return "int64_t"; }
    if (name == "fid") { return "int64_t"; }
    return name;
}
// <<< GEN:scalar_ctype <<<

// ── emitType（复刻 emitter.ts emitType；tn = 类型节点索引）─────

emit_ctype fn(tn: i64) -> string {
    if (tn < 0) {
        return "void";
    }
    var n: Node = nodes[tn];
    if (n.kind == "scalar") {
        if (n.sa == "string") { return "TStr"; }
        if (n.sa == "StringBuilder") { return "TSb*"; }
        if (n.sa == "atom") { return "int64_t"; }
        return scalar_to_c(n.sa);
    }
    if (n.kind == "named") {
        // type_info 自省类型：C 后端一律按指针（与 LLVM 后端的 ptr 一致），
        // 因为运行时 t_ti_*/t_fi_* 接收 TTypeInfo*/TFieldInfo*。
        if (n.sa == "TypeInfo") { return "TTypeInfo*"; }
        if (n.sa == "FieldInfo") { return "TFieldInfo*"; }
        return n.sa;
    }
    if (n.kind == "array") {
        return sb_cat2(emit_ctype(n.na), "*");
    }
    if (n.kind == "slice") {
        return "TSlice";
    }
    if (n.kind == "map") {
        return "TMap*";
    }
    if (n.kind == "sym") {
        if (n.ia == 16) { return "uint16_t"; }
        return "uint32_t";
    }
    if (n.kind == "pointer") {
        return sb_cat2(emit_ctype(n.na), "*");
    }
    if (n.kind == "optional") {
        return emit_ctype(n.na);
    }
    if (n.kind == "flag") {
        return n.sa;
    }
    if (n.kind == "flag_set") {
        return "void*";
    }
    if (n.kind == "variant") {
        return "void*";
    }
    if (n.kind == "func_type") {
        return "TClosure*";
    }
    return "void";
}

// ── resolveTypeDesc（复刻 emitter.ts resolveTypeDesc）──────────

resolve_type_desc fn(tn: i64) -> i64 {
    if (tn < 0) {
        return td_mk("unknown");
    }
    var n: Node = nodes[tn];
    if (n.kind == "scalar") {
// >>> GEN:td_scalar (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
        if (n.sa == "string") { return td_mk("string"); }
        if (n.sa == "void") { return td_mk("void"); }
        if (n.sa == "StringBuilder") { return td_named_mk("named", "TSb*"); }
        return td_named_mk("scalar", n.sa);
// <<< GEN:td_scalar <<<
    }
// >>> GEN:td_rslice (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
    if (n.kind == "slice") {
        return td_elem_mk("slice", resolve_type_desc(n.na));
    }
// <<< GEN:td_rslice <<<
    // 定长数组 [N]T：LLVM 后端映射为 [N x T]，C 后端仍走 T[]／T*
    if (n.kind == "array") {
        var ai: i64 = td_elem_mk("array", resolve_type_desc(n.na));
        var alen: i64 = 0;
        if (n.nb >= 0) {
            var le: Node = nodes[n.nb];
            if (le.kind == "int") {
                alen = parse_int_len(le.sa, le.ia);
            }
        }
        var at: TD = tds[ai];
        at.alen = alen;
        slice_set(tds, ai, at);
        return ai;
    }
    if (n.kind == "map") {
        var mi: i64 = td_mk("map");
        var kt: i64 = resolve_type_desc(n.na);
        var vt: i64 = resolve_type_desc(n.nb);
        var t: TD = tds[mi];
        t.key = kt;
        t.val = vt;
        slice_set(tds, mi, t);
        return mi;
    }
    if (n.kind == "sym") {
        var syi: i64 = td_named_mk("sym", n.sa);
        var syt: TD = tds[syi];
        syt.alen = n.ia;
        slice_set(tds, syi, syt);
        return syi;
    }
    // 反射内建类型（M36）：TypeInfo/FieldInfo 为不透明句柄，双后端均落为指针。
    // 必须放在 GEN:td_rnamed 之前——生成区间由 build/ebnf.json 驱动，手改会被覆盖。
    if (n.kind == "named" && n.sa == "TypeInfo") { return td_named_mk("typeinfo", n.sa); }
    if (n.kind == "named" && n.sa == "FieldInfo") { return td_named_mk("fieldinfo", n.sa); }
// >>> GEN:td_rnamed (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
    if (n.kind == "named") {
        return td_named_mk("named", n.sa);
    }
// <<< GEN:td_rnamed <<<
    if (n.kind == "func_type") {
        // 与 resolve_ti 同理：先收进局部表再整段搬入，保证参数区连续。
        var fret: i64 = resolve_type_desc(n.na);
        var fbuf: []i64;
        var fk: i64 = n.la;
        while (fk >= 0) {
            var fc: Child = kids[fk];
            append(fbuf, resolve_type_desc(fc.val));
            fk = fc.next;
        }
        var fpstart: i64 = slice_len(tdf_params) as i64;
        var fpc: i64 = slice_len(fbuf) as i64;
        var fj: i64 = 0;
        while (fj < fpc) {
            append(tdf_params, fbuf[fj]);
            fj = fj + 1;
        }
        return td_func(fret, fpstart, fpc);
    }
    return td_mk("unknown");
}

// ── tiToTd：TI → TD 转换（map 字面量作为表达式时需从推断类型取元素 TD）──
ti_to_td fn(ti: i64) -> i64 {
    if (ti < 0) {
        return td_mk("unknown");
    }
    var t: TI = tis[ti];
    if (t.kind == "Scalar") { return td_named_mk("scalar", t.name); }
    if (t.kind == "String") { return td_mk("string"); }
    if (t.kind == "StringBuilder") { return td_named_mk("named", "TSb*"); }
    if (t.kind == "Void") { return td_mk("void"); }
    if (t.kind == "Slice") { return td_elem_mk("slice", ti_to_td(t.elem)); }
    if (t.kind == "Array") {
        var r: i64 = td_elem_mk("array", ti_to_td(t.elem));
        var at: TD = tds[r];
        at.alen = t.alen;
        slice_set(tds, r, at);
        return r;
    }
    if (t.kind == "Map") {
        var r: i64 = td_mk("map");
        var mt: TD = tds[r];
        mt.key = ti_to_td(t.key);
        mt.val = ti_to_td(t.val);
        slice_set(tds, r, mt);
        return r;
    }
    if (t.kind == "Sym") {
        var rs: i64 = td_named_mk("sym", t.name);
        var st: TD = tds[rs];
        st.alen = t.bw;
        slice_set(tds, rs, st);
        return rs;
    }
    if (t.kind == "Named") { return td_named_mk("named", t.name); }
    if (t.kind == "Func") {
        var fret: i64 = ti_to_td(tif_ret[ti]);
        var fbuf: []i64;
        var fj: i64 = 0;
        while (fj < tif_pcount[ti]) {
            append(fbuf, ti_to_td(tif_params[tif_pstart[ti] + fj]));
            fj = fj + 1;
        }
        var fpstart: i64 = slice_len(tdf_params) as i64;
        var fpc: i64 = slice_len(fbuf) as i64;
        var fj2: i64 = 0;
        while (fj2 < fpc) {
            append(tdf_params, fbuf[fj2]);
            fj2 = fj2 + 1;
        }
        return td_func(fret, fpstart, fpc);
    }
    return td_mk("unknown");
}


// ── descToC（复刻 emitter.ts descToC）──────────────────────────

desc_to_c fn(td: i64) -> string {
    if (td < 0) {
        return "void*";
    }
    var t: TD = tds[td];
    if (t.cat == "string") { return "TStr"; }
    if (t.cat == "typeinfo") { return "TTypeInfo*"; }
    if (t.cat == "fieldinfo") { return "TFieldInfo*"; }
    if (t.cat == "slice") { return "TSlice"; }
    if (t.cat == "array") { return c_ptr_to(t.elem); }
    if (t.cat == "map") { return "TMap*"; }
    if (t.cat == "sym") {
        if (t.alen == 16) { return "uint16_t"; }
        return "uint32_t";
    }
    if (t.cat == "scalar") {
        if (t.name == "") {
            return scalar_to_c("i64");
        }
        return scalar_to_c(t.name);
    }
    if (t.cat == "named") {
        if (t.name == "") {
            return "void*";
        }
        return t.name;
    }
    if (t.cat == "void") { return "void"; }
    if (t.cat == "func") { return "TClosure*"; }
    return "void*";
}

// ── match arm 绑定替换栈（L-15 脱糖）──────────────────────────
// match 的 arm 绑定名只是「被匹配值临时量」的别名，发射期把标识符引用直接替换为
// `_tms<no>`，即可避免在 C / LLVM 两端生成重复声明或遮蔽外层同名局部。
// 用节点索引 + 序号存储，避免全局定长 string 数组（LLVM 后端全局聚合限制）。
var g_mb_arm: [64]i64;
var g_mb_no: [64]i64;
var g_mb_n: i64 = 0;

mb_push fn(arm: i64, no: i64) -> void {
    if (g_mb_n < 64) {
        g_mb_arm[g_mb_n] = arm;
        g_mb_no[g_mb_n] = no;
        g_mb_n = g_mb_n + 1;
    }
}

mb_drop fn(k: i64) -> void {
    var i: i64 = 0;
    while (i < k) {
        if (g_mb_n > 0) {
            g_mb_n = g_mb_n - 1;
        }
        i = i + 1;
    }
}

mb_sub fn(name: string) -> string {
    if (g_mb_n == 0) {
        return name;
    }
    var i: i64 = g_mb_n - 1;
    while (i >= 0) {
        var an: Node = nodes[g_mb_arm[i]];
        if (an.sa == name) {
            return sb_cat2("_tms", i2s(g_mb_no[i]));
        }
        i = i - 1;
    }
    return name;
}

// ── exprTypeDesc（复刻 emitter.ts exprTypeDesc）────────────────

expr_type_desc fn(e: i64) -> i64 {
    if (e < 0) {
        return td_mk("unknown");
    }
    var n: Node = nodes[e];
// >>> GEN:td_expr1 (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
    if (n.kind == "string") { return td_mk("string"); }
    if (n.kind == "int") { return td_named_mk("scalar", "i64"); }
    if (n.kind == "float") { return td_named_mk("scalar", "f64"); }
    if (n.kind == "bool") { return td_named_mk("scalar", "bool"); }
// <<< GEN:td_expr1 <<<
    if (n.kind == "atom") { return td_named_mk("scalar", "atom"); }
    if (n.kind == "fidconst") { return td_named_mk("scalar", "fid"); }
    if (n.kind == "serialize") { return td_named_mk("scalar", "fid"); }
    if (n.kind == "deserialize") { return deser_type_of(n.nb); }
    if (n.kind == "typeinfo") {
        return td_named_mk("typeinfo", n.sa);
    }
    // 闭包构造点（M48）：值类型 = 合成函数的函数类型（build_type_map 已按裸名登记）
    if (n.kind == "closure_make") {
        var cmtd: i64 = tm_get(n.sa);
        if (cmtd >= 0) {
            return cmtd;
        }
        return td_mk("unknown");
    }
    if (n.kind == "ident") {
        var etd_idn: string = mb_sub(n.sa);
        if (em_in_fn) {
            var f: i64 = fs_get(em_cur_fn, etd_idn);
            if (f >= 0) {
                return f;
            }
        }
        var g: i64 = tm_get(etd_idn);
        if (g >= 0) {
            return g;
        }
        return td_mk("unknown");
    }
// >>> GEN:td_expr2 (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
    if (n.kind == "paren") {
        return expr_type_desc(n.na);
    }
    if (n.kind == "cast") {
        return resolve_type_desc(n.nb);
    }
// <<< GEN:td_expr2 <<<
    if (n.kind == "index") {
        var od: i64 = expr_type_desc(n.na);
        var ot: TD = tds[od];
        if (ot.cat == "string") {
            return td_named_mk("scalar", "u8");
        }
        if (ot.cat == "slice" || ot.cat == "array") {
            if (ot.elem >= 0) {
                return ot.elem;
            }
            return td_mk("unknown");
        }
        if (ot.cat == "map") {
            if (ot.val >= 0) {
                return ot.val;
            }
            return td_mk("unknown");
        }
        return td_mk("unknown");
    }
    if (n.kind == "call") {
        var cal: Node = nodes[n.na];
        if (cal.kind == "ident") {
            var cn: string = cal.sa;
// >>> GEN:td_calls (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
            if (cn == "file_read_all") { return td_mk("string"); }
            if (cn == "path_resolve") { return td_mk("string"); }
            if (cn == "str_len") { return td_named_mk("scalar", "u64"); }
            if (cn == "slice_len") { return td_named_mk("scalar", "u64"); }
            if (cn == "str_at") { return td_named_mk("scalar", "u8"); }
            if (cn == "args") {
                return td_elem_mk("slice", td_mk("string"));
            }
            if (cn == "file_write_all") { return td_named_mk("scalar", "bool"); }
            if (cn == "file_exists") { return td_named_mk("scalar", "bool"); }
            if (cn == "str_slice") { return td_mk("string"); }
            if (cn == "sb_to_str") { return td_mk("string"); }
            if (cn == "int_to_str" || cn == "i2s") { return td_mk("string"); }
            if (cn == "sb_new") { return td_named_mk("named", "TSb*"); }
            if (cn == "map_has") { return td_named_mk("scalar", "bool"); }
            if (cn == "map_del") { return td_named_mk("scalar", "bool"); }
            if (cn == "map_len") { return td_named_mk("scalar", "i64"); }
            if (cn == "map_set") { return td_mk("void"); }
            if (cn == "map_new") { return td_mk("map"); }
            if (cn == "ti_name") { return td_mk("string"); }
            if (cn == "fi_name") { return td_mk("string"); }
            if (cn == "fi_type_name") { return td_mk("string"); }
            if (cn == "ti_size") { return td_named_mk("scalar", "i64"); }
            if (cn == "ti_kind") { return td_named_mk("scalar", "i64"); }
            if (cn == "ti_field_count") { return td_named_mk("scalar", "i64"); }
            if (cn == "fi_offset") { return td_named_mk("scalar", "i64"); }
            if (cn == "fi_tag") { return td_named_mk("scalar", "i64"); }
            if (cn == "fi_type_size") { return td_named_mk("scalar", "i64"); }
            if (cn == "ti_field") { return td_named_mk("fieldinfo", "FieldInfo"); }
            if (cn == "fi_is_ptr") { return td_named_mk("scalar", "bool"); }
            if (cn == "sym_str") { return td_mk("string"); }
            if (cn == "sym_release") { return td_mk("void"); }
            if (cn == "sym_release_all") { return td_mk("void"); }
            if (cn == "atom_str") { return td_mk("string"); }
            if (cn == "fopen") { return td_named_mk("scalar", "fid"); }
            if (cn == "fclose" || cn == "fflush" || cn == "fmt_register") { return td_mk("void"); }
            if (cn == "fid_is_open") { return td_named_mk("scalar", "bool"); }
            if (cn == "fid_eof") { return td_named_mk("scalar", "bool"); }
            if (cn == "fid_format") { return td_named_mk("scalar", "atom"); }
            if (cn == "fid_error") { return td_mk("string"); }
            if (cn == "fseek") { return td_named_mk("scalar", "bool"); }
            if (cn == "ftell") { return td_named_mk("scalar", "i64"); }
            // 时间格式化（M56）/ 解析与固定时区（M57）
            if (cn == "now" || cn == "time_invalid" || cn == "parse_time" || cn == "parse_time_local") { return td_named_mk("scalar", "i64"); }
            if (cn == "format_time" || cn == "format_time_local" || cn == "format_time_tz") { return td_mk("string"); }
            // 格式化（Python 格式规范迷你语言子集）
            if (cn == "format_int" || cn == "format_uint" || cn == "format_float" || cn == "format_str" || cn == "format_bool" || cn == "format_char") { return td_mk("string"); }
            if (cn == "sb_append_fmt_int" || cn == "sb_append_fmt_uint" || cn == "sb_append_fmt_float" || cn == "sb_append_fmt_str" || cn == "sb_append_fmt_bool" || cn == "sb_append_fmt_char") { return td_mk("void"); }
// <<< GEN:td_calls <<<
            // map_get(m, k) 的返回类型 = 映射的 V（从首个实参的 map 类型反查）
            if (cn == "map_get" && n.la >= 0) {
                var mn: i64 = kids[n.la].val;
                var mtd: i64 = expr_type_desc(mn);
                if (mtd >= 0) {
                    var mt: TD = tds[mtd];
                    if (mt.cat == "map" && mt.val >= 0) {
                        return mt.val;
                    }
                }
                return td_mk("unknown");
            }
            // 间接调用：被调者是函数类型的局部变量时，取其签名返回类型（局部遮蔽同名全局函数）
            var lftd: i64 = -1;
            if (em_in_fn) {
                lftd = fs_get(em_cur_fn, mb_sub(cn));
            }
            if (td_is_func(lftd)) {
                return tdf_ret[lftd];
            }
            var rt: i64 = tm_get(sb_cat2(cn, "()"));
            if (rt >= 0) {
                return rt;
            }
            var gftd: i64 = tm_get(mb_sub(cn));
            if (td_is_func(gftd)) {
                return tdf_ret[gftd];
            }
            return td_mk("unknown");
        }
        // callee 是任意表达式（结构体字段 / 数组元素 / 调用结果…）：按其静态类型取返回类型
        var xftd: i64 = expr_type_desc(n.na);
        if (td_is_func(xftd)) {
            return tdf_ret[xftd];
        }
        return td_mk("unknown");
    }
    if (n.kind == "binary") {
        var op: string = n.sa;
        if (op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=" || op == "&&" || op == "||") {
            return td_named_mk("scalar", "bool");
        }
        return expr_type_desc(n.na);
    }
    if (n.kind == "member") {
        var od2: i64 = expr_type_desc(n.na);
        var ot2: TD = tds[od2];
        if (ot2.cat == "named" && ot2.name != "") {
            var fd: i64 = sf_get(ot2.name, n.sa);
            if (fd >= 0) {
                return fd;
            }
        }
        return td_mk("unknown");
    }
    return td_mk("unknown");
}

// ── collectLocalTypes（复刻 emitter.ts collectLocalTypes）──────

collect_local_types fn(head: i64) -> void {
    if (head < -1) {
        return;
    }
    var c: i64 = head;
    while (c >= 0) {
        var k: Child = kids[c];
        var n: Node = nodes[k.val];
        if (n.kind == "var_decl") {
            if (n.na >= 0) {
                fs_set(em_cur_fn, n.sa, resolve_type_desc(n.na));
            }
        }
        // 闭包体首重建的捕获变量（M48）：与普通局部同权，须登记类型
        if (n.kind == "closure_capture") {
            if (n.na >= 0) {
                fs_set(em_cur_fn, n.sa, resolve_type_desc(n.na));
            }
        }
        if (n.kind == "if") {
            collect_local_types(n.la);
            if (n.lb > -2) {
                collect_local_types(n.lb);
            }
        }
        if (n.kind == "while" || n.kind == "block") {
            collect_local_types(n.la);
        }
        if (n.kind == "for") {
            if (n.na >= 0) {
                var ini: Node = nodes[n.na];
                if (ini.kind == "var_decl") {
                    if (ini.na >= 0) {
                        fs_set(em_cur_fn, ini.sa, resolve_type_desc(ini.na));
                    }
                }
            }
            collect_local_types(n.la);
        }
        if (n.kind == "for_each") {
            var it: i64 = expr_type_desc(n.na);
            var itd: TD = tds[it];
            if (itd.cat == "slice" && itd.elem >= 0) {
                fs_set(em_cur_fn, n.sa, itd.elem);
            }
            if (itd.cat == "map" && itd.key >= 0) {
                fs_set(em_cur_fn, n.sa, itd.key);
                if (str_len(n.sb) > 0 && itd.val >= 0) {
                    fs_set(em_cur_fn, n.sb, itd.val);
                }
            }
            collect_local_types(n.la);
        }
        c = k.next;
    }
}

// ── buildTypeMap（复刻 emitter.ts buildTypeMap）────────────────

// 具名函数的「函数类型」TD。用于「函数作为值」的类型推断：
//   var f = add;                  // 无类型标注
//   var g = fn(a: i64) -> i64 {}  // 提升后同样是裸函数名
// 没有它，expr_type_desc 会对函数名返回 unknown，导致 var_decl 发射出错误的 C 类型。
funcdecl_td fn(rt_node: i64, params_head: i64) -> i64 {
    var rtd: i64 = resolve_type_desc(rt_node);
    var buf: []i64;
    var c: i64 = params_head;
    while (c >= 0) {
        var k: Child = kids[c];
        var p: Node = nodes[k.val];
        append(buf, resolve_type_desc(p.na));
        c = k.next;
    }
    // 先收局部表再整段搬入扁平池：嵌套函数类型解析会递归 append，
    // 直接边解析边 append 会打断本层参数区的连续性。
    var ps: i64 = slice_len(tdf_params) as i64;
    var pc: i64 = slice_len(buf) as i64;
    var i: i64 = 0;
    while (i < pc) {
        append(tdf_params, buf[i]);
        i = i + 1;
    }
    return td_func(rtd, ps, pc);
}

build_type_map fn() -> void {
    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = decl_list[i];
        var dn: Node = nodes[d];
        if (dn.kind == "StructDecl") {
            var fc: i64 = dn.lb;
            while (fc >= 0) {
                var fk: Child = kids[fc];
                var f: Node = nodes[fk.val];
                if (f.na >= 0) {
                    sf_set(dn.sa, f.sa, resolve_type_desc(f.na));
                }
                fc = fk.next;
            }
        }
        if (dn.kind == "GlobalVarDecl" || dn.kind == "GlobalConstDecl") {
            if (dn.na >= 0) {
                tm_set(dn.sa, resolve_type_desc(dn.na));
            }
        }
        if (dn.kind == "FuncDecl") {
            if (dn.na >= 0) {
                tm_set(sb_cat2(dn.sa, "()"), resolve_type_desc(dn.na));
            }
            // 裸函数名 → 函数类型（函数作为值）。局部变量优先级更高，不会被遮蔽。
            tm_set(dn.sa, funcdecl_td(dn.na, dn.lb));
            em_cur_fn = dn.sa;
            em_in_fn = true;
            var pc: i64 = dn.lb;
            while (pc >= 0) {
                var pk: Child = kids[pc];
                var p: Node = nodes[pk.val];
                if (p.na >= 0) {
                    fs_set(dn.sa, p.sa, resolve_type_desc(p.na));
                }
                pc = pk.next;
            }
            if (dn.lc > -2) {
                collect_local_types(dn.lc);
            }
            em_in_fn = false;
            em_cur_fn = "";
        }
        i = i + 1;
    }
}

// ── C 字符串转义（复刻 emitter.ts escapeCString）───────────────

esc_c fn(s: string) -> string {
    var sb: StringBuilder = sb_new();
    var i: u64 = 0;
    var n: u64 = str_len(s);
    while (i < n) {
        var c: u8 = s[i];
        if (c == 92) {
            sb_append_str(sb, "\\\\");
        } else {
        if (c == 34) {
            sb_append_str(sb, "\\\"");
        } else {
        if (c == 10) {
            sb_append_str(sb, "\\n");
        } else {
        if (c == 13) {
            sb_append_str(sb, "\\r");
        } else {
        if (c == 9) {
            sb_append_str(sb, "\\t");
        } else {
        if (c == 0) {
            sb_append_str(sb, "\\0");
        } else {
            sb_append_char(sb, c);
        }}}}}}
        i = i + 1;
    }
    return sb_to_str(sb);
}

// ── 缩进 ───────────────────────────────────────────────────────

mk_pad fn(indent: i64) -> string {
    var sb: StringBuilder = sb_new();
    var i: i64 = 0;
    while (i < indent) {
        sb_append_str(sb, "    ");
        i = i + 1;
    }
    return sb_to_str(sb);
}

// ── emitExpr（复刻 emitter.ts emitExpr）────────────────────────

// map 读索引助手：t_map_val_ptr 返回存储值字节指针，按 V 类型解引用。
// 注意：key 需是左值（&k），与 append 字面量取址限制一致。
// 取调用节点的第 ix 个实参节点 id（-1 表示不存在）。
call_arg_node fn(cid: i64, ix: i64) -> i64 {
    if (cid < 0) {
        return -1;
    }
    var cn9: Node = nodes[cid];
    var c9: i64 = cn9.la;
    var j9: i64 = 0;
    while (c9 >= 0) {
        var ck9: Child = kids[c9];
        if (j9 == ix) {
            return ck9.val;
        }
        j9 = j9 + 1;
        c9 = ck9.next;
    }
    return -1;
}

// map 键取地址（C 后端）：整型键统一提升为 int64_t 存储——runtime 按 int64_t 读键，
// 直接对 i32/u8 变量取址会让高位字节变成垃圾（M30 前的静默失配）。用 C99 复合字面量，
// 顺带允许键写成字面量或表达式。string 键是 TStr 聚合，仍取原表达式地址。
c_map_keyp fn(mn: i64, kn: i64) -> string {
    var ktd9: i64 = -1;
    var mtd9: i64 = expr_type_desc(mn);
    if (mtd9 >= 0) {
        var mt9: TD = tds[mtd9];
        ktd9 = mt9.key;
    }
    if (ktd9 >= 0 && tds[ktd9].cat != "scalar") {
        return sb_cat2("&", emit_expr(kn));
    }
    return sb_cat3("&(int64_t){(int64_t)(", emit_expr(kn), ")}");
}

// map 值取地址（C 后端）：标量值按声明的 V 落进复合字面量（宽度对齐 val_size，
// 且允许值写成字面量）；聚合值取原表达式地址。
c_map_valp fn(mn: i64, vn: i64) -> string {
    var vtd8: i64 = -1;
    var mtd8: i64 = expr_type_desc(mn);
    if (mtd8 >= 0) {
        var mt8: TD = tds[mtd8];
        vtd8 = mt8.val;
    }
    if (vtd8 < 0 || tds[vtd8].cat != "scalar") {
        return sb_cat2("&", emit_expr(vn));
    }
    var vc8: string = desc_to_c(vtd8);
    return sb_cat6("&(", vc8, "){(", vc8, ")(", sb_cat2(emit_expr(vn), ")}"));
}

c_map_get fn(mn: i64, kn: i64) -> string {
    var mtd: i64 = expr_type_desc(mn);
    var mt: TD = tds[mtd];
    var valc: string = desc_to_c(mt.val);
    var mstr: string = emit_expr(mn);
    var kstr: string = c_map_keyp(mn, kn);
    return sb_cat6("(*(", valc, "*)t_map_val_ptr(", mstr, ", ", sb_cat2(kstr, "))"));
}

// map 索引写时求 LHS 的 TMap* 基指针：
// 单层 m[k] → m（变量本身即 TMap*）；嵌套 deep[a][x] → deep[a] 求内层 TMap* 值。
// 用于 t_map_put 的第一个实参。
c_map_lhs_ptr fn(nd: i64) -> string {
    var n1: Node = nodes[nd];
    if (n1.kind == "index") {
        var btd: i64 = expr_type_desc(nd);
        if (btd >= 0 && tds[btd].cat == "map") {
            // 嵌套：base 是 m[k] 本身也是 map，求内层 TMap* 值（t_map_val_ptr 返回槽指针，解引用得 TMap*）
            var base: string = emit_expr(n1.na);
            var key: string = c_map_keyp(nd, n1.nb);
            return sb_cat6("(*(TMap**)", "t_map_val_ptr(", base, ", ", key, "))");
        }
    }
    return emit_expr(nd);
}

// map 字面量作为表达式（调用实参 / 返回值 / 嵌套值 / 赋值右值）时，
// 建临时 TMap* 变量并逐项 put，返回该变量名。pad 为缩进（表达式场景通常为 ""）。
var g_map_lit_cnt: i64 = 0;
var g_match_cnt: i64 = 0;      // match 表达式序号（结果/被匹配值临时量命名）
var g_clos_cnt: i64 = 0;       // 闭包构造序号（环境/闭包临时量命名，M48）
var g_stmt_pad: string = "";   // 当前语句缩进（map 字面量作表达式时对齐用）
var g_defer: [1024]i64;         // defer 延迟栈（节点索引），函数级、LIFO 于 return/函数尾运行
var g_defer_n: i64 = 0;         // g_defer 栈顶计数

// ── Atom 表（M50：Erlang 式原子）──────────────────────────────
// 编译期 intern：名字 → 稳定 i64 id（等价 Erlang 原子表）。
// 同一个名字两次 intern 返回相同 id，故 `:ok == :ok` 恒为真、`match` 按 id 分发。
// 约定 0 为非原子（null 占位），故有效 id 从 1 起。
var g_atom_names: []string;
var g_atom_cnt: i64 = 0;
atom_intern fn(name: string) -> i64 {
    var i: i64 = 0;
    while (i < g_atom_cnt) {
        if (g_atom_names[i] == name) { return i + 1; }
        i = i + 1;
    }
    append(g_atom_names, name);
    g_atom_cnt = g_atom_cnt + 1;
    return g_atom_cnt;
}

// fid_format(f) 会把这四个名字当返回值交给用户，必须保证它们进了原子表。
// LLVM 后端的 @t_atom_table 先于函数体发射，因此只能在检查期调用本函数。
fid_intern_fmt_atoms fn() -> void {
    var t0: i64 = atom_intern("text");
    var t1: i64 = atom_intern("json");
    var t2: i64 = atom_intern("rawbin");
    var t3: i64 = atom_intern("protobuf");
}

c_emit_map_lit fn(en: i64, mname: string, pad: string, keytd: i64, valtd: i64) -> void {
    var mlkk: i64 = 0;
    if (tds[keytd].cat != "string") { mlkk = 1; }
    var mlkc: string = desc_to_c(keytd);
    var mlvc: string = desc_to_c(valtd);
    spush(sb_cat5(pad, "TMap* ", mname, " = t_map_new(t_arena_current(), ", sb_cat3(i2s(mlkk), ", (int64_t)sizeof(", sb_cat2(mlvc, "));"))));
    var mlkx: string = "";
    if (tds[keytd].cat == "scalar") {
        mlkc = "int64_t";
        mlkx = "(int64_t)";
    }
    var mlvx: string = "";
    if (tds[valtd].cat == "scalar") {
        mlvx = sb_cat3("(", mlvc, ")");
    }
    var mlnode: Node = nodes[en];
    var mlc: i64 = mlnode.la;
    var mlix: i64 = 0;
    while (mlc >= 0) {
        var mlck: Child = kids[mlc];
        var mlen: Node = nodes[mlck.val];
        var mlkn: string = sb_cat4("_ml_", mname, "k", i2s(mlix));
        var mlvn: string = sb_cat4("_ml_", mname, "v", i2s(mlix));
        spush(sb_cat6(pad, mlkc, " ", mlkn, sb_cat3(" = ", mlkx, emit_expr(mlen.na)), ";"));
        spush(sb_cat6(pad, mlvc, " ", mlvn, sb_cat3(" = ", mlvx, emit_expr(mlen.nb)), ";"));
        spush(sb_cat6(pad, "t_map_put(", mname, ", &", mlkn, sb_cat3(", &", mlvn, ");")));
        mlix = mlix + 1;
        mlc = mlck.next;
    }
}

// ── match 脱糖（L-15 / match.md §2「函数子句为 match 语法糖」同一机制）──
// 由 arm 链表递归合成 if/else 语句链，交给既有 emit_stmt / emit_llstmt 发射：
//   arm 体      → `<rname> = <body>;`（expr 语句包 assign 节点）
//   等值模式    → `<sname> == <pat>`
//   when 守卫   → 与等值模式 `&&` 合取；仅有守卫时即为条件本身
//   不可反驳 arm（`_` / 裸绑定且无守卫）→ 作为 else 体，其后 arm 不可达
// 返回语句链表头；-2 表示无（对应 mk_if 的「无 else」约定）。
match_chain_from fn(c: i64, rname: string, sname: string) -> i64 {
    if (c < 0) {
        return -2;
    }
    var mc_k: Child = kids[c];
    var mc_an: Node = nodes[mc_k.val];
    var mc_asg: i64 = mk_expr(mk_assign("=", mk_ident(rname, -1), mc_an.nc, -1), -1);
    var mc_body: i64 = list_push(-1, -1, mc_asg);
    var mc_cond: i64 = -1;
    if (mc_an.na >= 0) {
        mc_cond = mk_binary("==", mk_ident(sname, -1), mc_an.na, -1);
    }
    if (mc_an.nb >= 0) {
        if (mc_cond < 0) {
            mc_cond = mc_an.nb;
        } else {
            mc_cond = mk_binary("&&", mc_cond, mc_an.nb, -1);
        }
    }
    if (mc_cond < 0) {
        return mc_body;
    }
    var mc_rest: i64 = match_chain_from(mc_k.next, rname, sname);
    var mc_if: i64 = mk_if(mc_cond, mc_body, mc_rest, -1);
    return list_push(-1, -1, mc_if);
}

// 把该 match 所有 arm 的绑定名压入替换栈，返回压入个数（供 mb_drop 配对弹出）
match_bind_push fn(e: i64, no: i64) -> i64 {
    var mb_n2: i64 = 0;
    var mb_c: i64 = nodes[e].la;
    while (mb_c >= 0) {
        var mb_k: Child = kids[mb_c];
        var mb_an: Node = nodes[mb_k.val];
        if (str_len(mb_an.sa) > 0) {
            mb_push(mb_k.val, no);
            mb_n2 = mb_n2 + 1;
        }
        mb_c = mb_k.next;
    }
    return mb_n2;
}

// 首个 arm 的体表达式（match 结果类型以其为准）
match_first_body fn(e: i64) -> i64 {
    var mf_c: i64 = nodes[e].la;
    if (mf_c < 0) {
        return -1;
    }
    var mf_k: Child = kids[mf_c];
    return nodes[mf_k.val].nc;
}

// 切片元素的 C 类型名。append / slice_set 的元素宽度必须取自**切片**，
// 不能用 `sizeof(<实参表达式>)`：`append(xs, -1)` 的 sizeof 是 sizeof(int)==4，
// 对 []i64 只会写入半个元素（静默错编）。
c_elem_ctype fn(slice_expr: i64) -> string {
    if (slice_expr >= 0) {
        var ce_d: i64 = expr_type_desc(slice_expr);
        if (ce_d >= 0) {
            var ce_t: TD = tds[ce_d];
            if (ce_t.elem >= 0) {
                return desc_to_c(ce_t.elem);
            }
        }
    }
    return "int64_t";
}

// ── fid 打开方式 / 格式的编译期编码（M51，双后端共用）─────────
// mode / kind / fmt 形参已由 check_atom_arg 保证是白名单内的 atom 字面量，
// 故发射期直接降为小整数码，运行时不必反查 atom 名表（也就不依赖名表内容）。
fid_code_of fn(sel: string, v: string) -> i64 {
    if (sel == "mode") {
        if (v == "read") { return 0; }
        if (v == "write") { return 1; }
        if (v == "append") { return 2; }
        if (v == "read_binary") { return 3; }
        if (v == "write_binary") { return 4; }
        return 5;
    }
    if (sel == "kind") {
        if (v == "text") { return 0; }
        return 1;
    }
    if (v == "text") { return 0; }
    if (v == "json") { return 1; }
    if (v == "rawbin") { return 2; }
    return 3;
}

fid_arg_code fn(a: i64, sel: string) -> string {
    if (a < 0) {
        return "0";
    }
    var fan: Node = nodes[a];
    return i2s(fid_code_of(sel, fan.sa));
}

// fid_format 返回 atom：运行时只知道格式码，atom id 作为**实参**传下去，
// 无需全局预注册、不扰动既有 id 分配。
// 入表动作在检查期由 fid_intern_fmt_atoms 完成（LLVM 的 @t_atom_table 先于函数体发射）；
// 这里的 atom_intern 是幂等查表，只负责取回已分配的 id。
fid_fmt_atom_args fn() -> string {
    var a0: string = i2s(atom_intern("text"));
    var a1: string = i2s(atom_intern("json"));
    var a2: string = i2s(atom_intern("rawbin"));
    var a3: string = i2s(atom_intern("protobuf"));
    return sb_cat6(a0, ", ", a1, ", ", a2, sb_cat2(", ", a3));
}

// 同上，LLVM 调用点形态（每个实参都要带类型前缀）
ll_fmt_atom_args fn() -> string {
    var b0: string = i2s(atom_intern("text"));
    var b1: string = i2s(atom_intern("json"));
    var b2: string = i2s(atom_intern("rawbin"));
    var b3: string = i2s(atom_intern("protobuf"));
    return sb_cat6(b0, ", i64 ", b1, ", i64 ", b2, sb_cat3(", i64 ", b3, ")"));
}

// ── 序列化值分派（M51，双后端共用判定）───────────────────────
// 返回选择子："str" | "atom" | "bool" | "f" | "i"。位宽/符号另由 ll_bits/ll_signed 取，
// 因为 rawbin 格式要按静态位宽写定长小端字节 —— 判定必须编译期完成。
ser_sel fn(td: i64) -> string {
    if (td < 0) {
        return "i";
    }
    var t: TD = tds[td];
    if (t.cat == "string") {
        return "str";
    }
    var sn: string = td_sname(td);
    if (sn == "atom") {
        return "atom";
    }
    if (sn == "bool") {
        return "bool";
    }
    if (sn == "f16" || sn == "f32" || sn == "f64") {
        return "f";
    }
    return "i";
}

// ── 反序列化（读路径，M52 读路径，Option B）：`fid > Type` 的右操作数是「类型」──
// 把右操作数（类型表达式节点）解析为 TD，并判定读路径是否支持该类型。

// 该节点是否由 parse_cmp 的 tok_type_only 分支（parse_type）产出 —— 即「一望即知是类型、
// 不可能是值」的节点。用于左操作数非 fid 时给出准确诊断。
node_type_only fn(nb: i64) -> bool {
    if (nb < 0) { return false; }
    var k: string = nodes[nb].kind;
    return k == "scalar" || k == "map";
}

deser_type_of fn(nb: i64) -> i64 {
    if (nb < 0) { return td_mk("unknown"); }
    var n: Node = nodes[nb];
    if (n.kind == "scalar") { return resolve_type_desc(nb); }   // 类型位置直接写 i64（少见）
    if (n.kind == "paren")  { return deser_type_of(n.na); }
    if (n.kind == "ident") {
        var nm: string = n.sa;
        if (nm == "string") { return td_mk("string"); }
        if (nm == "bool")   { return td_named_mk("scalar", "bool"); }
        if (nm == "atom")   { return td_named_mk("scalar", "atom"); }
        if (nm == "fid")    { return td_named_mk("scalar", "fid"); }
        if (is_int_name(nm) || is_float_name(nm)) { return td_named_mk("scalar", nm); }
        // 命名类型（struct/enum/flag/variant/typealias）。注意**不能**用 tm_get ——
        // 那是 emitter 的 typeMap，check 阶段尚未填充，会把已声明的类型误判成「不是类型」。
        // check 阶段的权威来源是全局符号表里 kind == "type" 的条目。
        var si: i64 = sym_lookup(global_scope, nm);
        if (si >= 0) {
            if (syms[si].kind == "type") { return td_named_mk("named", nm); }
            return td_mk("unknown");                             // 是个值（变量/函数/常量），不是类型
        }
        var g: i64 = tm_get(nm);                                 // 发射期回退（此时符号表已释放）
        if (g >= 0) { return g; }
        return td_mk("unknown");
    }
    return resolve_type_desc(nb);                                // slice/array/map/func_type 等真正类型节点
}

// 读路径 v1 仅支持：标量数值 / bool / atom / string。聚合类型（struct/array/slice/map/pointer）读属 v2。
deser_supported fn(td: i64) -> bool {
    if (td < 0) { return false; }
    var t: TD = tds[td];
    if (t.cat == "string") { return true; }
    if (t.cat == "scalar") {
        var nm: string = td_sname(td);
        if (nm == "fid") { return false; }     // 不能从文件读 fid 句柄
        return nm == "atom" || nm == "bool" || is_int_name(nm) || is_float_name(nm);
    }
    return false;
}

// TD → TI（读路径结果类型为裸 T）。
ti_from_td fn(td: i64) -> i64 {
    if (td < 0) { return ti_mk("Unknown"); }
    var t: TD = tds[td];
    if (t.cat == "string") { return ti_mk("String"); }
    if (t.cat == "scalar") { return ti_scalar(td_sname(td)); }
    return ti_mk("Unknown");
}

emit_expr fn(e: i64) -> string {
    if (e < 0) {
        return "";
    }
    var n: Node = nodes[e];

    if (n.kind == "int") {
        if (n.ia == 16) {
            return n.sa;
        }
        if (n.ia == 2) {
            // value.replace(/^0b/i, "") 再加 0b 前缀
            var v: string = n.sa;
            var body: string = v;
            if (str_len(v) >= 2) {
                if (v[0] == 48 && (v[1] == 98 || v[1] == 66)) {
                    body = str_slice(v, 2, str_len(v));
                }
            }
            return sb_cat2("0b", body);
        }
        return n.sa;
    }
    if (n.kind == "atom") {
        if (n.ia <= 0) { n.ia = atom_intern(n.sa); slice_set(nodes, e, n); }
        return i2s(n.ia);
    }
    // 内建 fid 常量（M51）：编译期常量 0/1/2，无运行时查找
    if (n.kind == "fidconst") {
        return i2s(n.ia);
    }
    // 序列化操作符（M51）：t_ser_* 一律**返回目标 fid**，故链式 `f < a < b`
    // 直接落成嵌套调用 t_ser_x(t_ser_y(f, a), b)，无需临时量。
    if (n.kind == "serialize") {
        var sfid: string = emit_expr(n.na);
        var sval: string = emit_expr(n.nb);
        var std2: i64 = expr_type_desc(n.nb);
        var ssel: string = ser_sel(std2);
        if (ssel == "str") { return sb_cat5("t_ser_str(", sfid, ", ", sval, ")"); }
        if (ssel == "atom") { return sb_cat5("t_ser_atom(", sfid, ", ", sval, ")"); }
        if (ssel == "bool") { return sb_cat5("t_ser_bool(", sfid, ", ", sval, ")"); }
        var sbits: string = i2s(ll_bits(td_sname(std2)));
        if (ssel == "f") {
            return sb_cat6("t_ser_f64(", sfid, ", ", sval, ", ", sb_cat2(sbits, ")"));
        }
        var ssgn: string = "0";
        if (ll_signed(td_sname(std2))) { ssgn = "1"; }
        return sb_cat6("t_ser_int(", sfid, ", ", sval, ", ", sb_cat4(sbits, ", ", ssgn, ")"));
    }
    // 反序列化（M52 读路径）：t_deser_* 返回裸 T 值；EOF/错误返默认值，调用方用 fid_eof 探测
    if (n.kind == "deserialize") {
        var dfid: string = emit_expr(n.na);
        var dtd: i64 = deser_type_of(n.nb);
        var dsel: string = ser_sel(dtd);
        if (dsel == "str") { return sb_cat3("t_deser_str(", dfid, ")"); }
        if (dsel == "atom") { return sb_cat3("t_deser_atom(", dfid, ")"); }
        if (dsel == "bool") { return sb_cat3("t_deser_bool(", dfid, ")"); }
        var dbits: string = i2s(get_bw(td_sname(dtd)));
        if (dsel == "f") {
            return sb_cat5("t_deser_f64(", dfid, ", ", dbits, ")");
        }
        var dsgn: string = "0";
        if (ll_signed(td_sname(dtd))) { dsgn = "1"; }
        return sb_cat6("t_deser_int(", dfid, ", ", dbits, ", ", sb_cat2(dsgn, ")"));
    }
    if (n.kind == "float") {
        return n.sa;
    }
    if (n.kind == "string") {
        return sb_cat3("TSTR_LIT(\"", esc_c(n.sa), "\")");
    }
    if (n.kind == "typeinfo") {
        return emit_type_info_c(n.sa);
    }
    if (n.kind == "bool") {
        if (n.ba) {
            return "true";
        }
        return "false";
    }
    if (n.kind == "null") {
        return "NULL";
    }
    if (n.kind == "ident") {
        var idn: string = mb_sub(n.sa);
        // 顶层具名函数出现在**值位置** → 取其闭包全局的地址（FuncType v2 / M47）。
        // 直接调用的 callee 不经此分支（call 分支直接读 cal.sa），故凡是走到这里
        // 且解析到 FuncDecl 的标识符，必然是「函数作为值」。局部/参数同名时局部优先。
        if (em_in_fn == false || fs_get(em_cur_fn, idn) < 0) {
            if (clos_decl_of(idn) >= 0) {
                clos_mark(idn);
                return sb_cat3("(&__tclos_", idn, ")");
            }
        }
        return idn;
    }
    // 闭包构造（M48）：堆分配环境 → 按值拷入捕获量 → 堆分配 TClosure → 返回其指针。
    // 借 map 字面量同款「前置语句 + 临时量」机制，故可出现在任意表达式位置。
    if (n.kind == "closure_make") {
        g_clos_cnt = g_clos_cnt + 1;
        var cm_pad: string = g_stmt_pad;
        var cm_e: string = sb_cat2("_tcloe", i2s(g_clos_cnt));
        var cm_c: string = sb_cat2("_tclo", i2s(g_clos_cnt));
        var cm_ep: string = sb_cat2(n.sb, "*");
        spush(sb_cat6(cm_pad, cm_ep, " ", cm_e, sb_cat4(" = (", cm_ep, ")t_alloc(sizeof(", n.sb), "));"));
        var cm_ch: i64 = n.la;
        while (cm_ch >= 0) {
            var cm_k: Child = kids[cm_ch];
            var cm_f: Node = nodes[cm_k.val];
            var cm_v: string = emit_expr(cm_k.val);
            spush(sb_cat6(cm_pad, cm_e, "->", cm_f.sa, " = ", sb_cat2(cm_v, ";")));
            cm_ch = cm_k.next;
        }
        spush(sb_cat6(cm_pad, "TClosure* ", cm_c, " = (TClosure*)t_alloc(sizeof(TClosure));", "", ""));
        spush(sb_cat6(cm_pad, cm_c, "->fn = (void*)", n.sa, ";", ""));
        spush(sb_cat6(cm_pad, cm_c, "->env = (void*)", cm_e, ";", ""));
        fs_set(em_cur_fn, cm_c, expr_type_desc(e));
        g_stmt_pad = cm_pad;
        return cm_c;
    }
    if (n.kind == "map_lit") {
        g_map_lit_cnt = g_map_lit_cnt + 1;
        var mname: string = sb_cat2("_tmlit", i2s(g_map_lit_cnt));
        var mti: i64 = infer_expr(e);
        var mt: TI = tis[mti];
        var keytd: i64 = ti_to_td(mt.key);
        var valtd: i64 = ti_to_td(mt.val);
        c_emit_map_lit(e, mname, g_stmt_pad, keytd, valtd);
        return mname;
    }
    // match 表达式（L-15）：提升为「结果临时量 + if/else 链」，返回临时量名
    if (n.kind == "match") {
        g_match_cnt = g_match_cnt + 1;
        var mq_no: i64 = g_match_cnt;
        var mq_pad: string = g_stmt_pad;
        var mq_rn: string = sb_cat2("_tmr", i2s(mq_no));
        var mq_sn: string = sb_cat2("_tms", i2s(mq_no));
        var mq_std: i64 = expr_type_desc(n.na);
        fs_set(em_cur_fn, mq_sn, mq_std);
        var mq_sv: string = emit_expr(n.na);
        var mq_pushed: i64 = match_bind_push(e, mq_no);
        var mq_rtd: i64 = expr_type_desc(match_first_body(e));
        fs_set(em_cur_fn, mq_rn, mq_rtd);
        spush(sb_cat4(mq_pad, desc_to_c(mq_rtd), " ", sb_cat2(mq_rn, ";")));
        spush(sb_cat6(mq_pad, desc_to_c(mq_std), " ", mq_sn, " = ", sb_cat2(mq_sv, ";")));
        var mq_ind: i64 = (str_len(mq_pad) as i64) / 4;
        var mq_s: i64 = match_chain_from(n.la, mq_rn, mq_sn);
        while (mq_s >= 0) {
            var mq_sk: Child = kids[mq_s];
            emit_stmt(mq_sk.val, mq_ind);
            mq_s = mq_sk.next;
        }
        mb_drop(mq_pushed);
        g_stmt_pad = mq_pad;
        return mq_rn;
    }
    if (n.kind == "binary") {
        var op: string = n.sa;
        if (op == "==" || op == "!=") {
            var lt: i64 = expr_type_desc(n.na);
            var rt: i64 = expr_type_desc(n.nb);
            var ltc: TD = tds[lt];
            var rtc: TD = tds[rt];
            if (ltc.cat == "string" || rtc.cat == "string") {
                var cmp: string = sb_cat5("t_str_eq(", emit_expr(n.na), ", ", emit_expr(n.nb), ")");
                if (op == "==") {
                    return cmp;
                }
                return sb_cat3("(!", cmp, ")");
            }
        }
        return sb_cat6("(", emit_expr(n.na), " ", op, " ", sb_cat2(emit_expr(n.nb), ")"));
    }
    if (n.kind == "unary") {
        return sb_cat4("(", n.sa, emit_expr(n.na), ")");
    }
    if (n.kind == "assign") {
        // m[k] = v : map 索引写须走 t_map_put（find-or-insert），不能对读值再存回
        if (n.sa == "=") {
            var lnode: Node = nodes[n.na];
            if (lnode.kind == "index") {
                var lotd: i64 = expr_type_desc(lnode.na);
                if (lotd >= 0 && tds[lotd].cat == "map") {
                    var mptr: string = c_map_lhs_ptr(lnode.na);
                    return sb_cat6("t_map_put(", mptr, ", ", c_map_keyp(lnode.na, lnode.nb), ", ", sb_cat2(c_map_valp(lnode.na, n.nb), ")"));
                }
            }
            // Sym = string : 自动 intern（LHS 存 id）；Sym = Sym（同池）走普通 id 拷贝
            var lhtd: i64 = expr_type_desc(n.na);
            if (lhtd >= 0 && tds[lhtd].cat == "sym") {
                var rhtd: i64 = expr_type_desc(n.nb);
                if (rhtd >= 0 && tds[rhtd].cat == "string") {
                    var stg: TD = tds[lhtd];
                    var tagl: string = sb_cat3("TSTR_LIT(\"", esc_c(stg.name), "\")");
                    var intr: string = sb_cat6("t_sym_intern(", tagl, ", ", emit_expr(n.nb), ", ", sb_cat2(i2s(stg.alen), ")"));
                    return sb_cat5("(", emit_expr(n.na), " = ", intr, ")");
                }
            }
        }
        return sb_cat6("(", emit_expr(n.na), " ", n.sa, " ", sb_cat2(emit_expr(n.nb), ")"));
    }
    if (n.kind == "call") {
        var cal: Node = nodes[n.na];
        if (cal.kind == "ident") {
            var cn: string = cal.sa;
            // 收集参数
            var av: []string;
            var c: i64 = n.la;
            while (c >= 0) {
                var k: Child = kids[c];
                var one_arg: string = emit_expr(k.val);
                append(av, one_arg);
                c = k.next;
            }
            var argc: i64 = slice_len(av) as i64;
            if (cn == "str_len") { return sb_cat3("t_str_len(", av[0], ")"); }
            if (cn == "str_at") { return sb_cat5("t_str_byte_at(", av[0], ", ", av[1], ")"); }
            if (cn == "slice_len") { return sb_cat3("t_slice_len(", av[0], ")"); }
            if (cn == "append") {
                // 实参可能是非左值（字面量 / 运算结果），`&(-1)` 不是合法 C。
                // 用**数组**复合字面量 `(ElemT[1]){ 值 }` materialize 出可取址的临时量：
                // 数组初始化列表填的是元素 0，故标量 / 结构体 / TStr 一律正确
                // （标量复合字面量 `(Node){ n }` 会误初始化第一个成员，不能用）；
                // 数组自动退化为指针，无需再取址。顺带把 sizeof 锚到元素类型。
                var ap_ct: string = c_elem_ctype(call_arg_node(e, 0));
                return sb_cat6("t_slice_append_sized(&", av[0],
                    sb_cat3(", (", ap_ct, "[1]){ "), av[1],
                    sb_cat3(" }, (int64_t)sizeof(", ap_ct, "))"), "");
            }
            if (cn == "slice_set") {
                var ss_ct: string = c_elem_ctype(call_arg_node(e, 0));
                return sb_cat6("t_slice_set(", av[0], ", ", av[1],
                    sb_cat3(", (", ss_ct, "[1]){ "), sb_cat2(av[2], " })"));
            }
            if (cn == "file_read_all") { return sb_cat3("t_file_read_all(t_cstr(", av[0], "))"); }
            if (cn == "file_exists") { return sb_cat3("t_file_exists(t_cstr(", av[0], "))"); }
            if (cn == "path_resolve") { return sb_cat3("t_path_resolve(t_cstr(", av[0], "))"); }
            if (cn == "file_write_all") {
                return sb_cat6("t_file_write_all(t_cstr(", av[0], "), ", av[1], ")", "");
            }
            if (cn == "args") { return "t_args()"; }
            if (cn == "ti_name" || cn == "ti_size" || cn == "ti_kind" || cn == "ti_field_count" || cn == "ti_field" || cn == "fi_name" || cn == "fi_offset" || cn == "fi_type_name" || cn == "fi_type_size" || cn == "fi_is_ptr" || cn == "fi_tag") {
                return c_emit_accessor_call(cn, av);
            }
            if (cn == "exit") { return sb_cat3("t_exit(", av[0], ")"); }
            if (cn == "sys_run") { return sb_cat3("sys_run(", av[0], ")"); }
            if (cn == "print") { return sb_cat3("t_print(", av[0], ")"); }
            if (cn == "eprint") { return sb_cat3("t_eprint(", av[0], ")"); }
            if (cn == "println") { return sb_cat3("t_println(", av[0], ")"); }
            if (cn == "str_slice") {
                return sb_cat6("t_str_slice(", av[0], ", ", av[1], ", ", sb_cat2(av[2], ")"));
            }
            if (cn == "sb_new") { return "t_sb_new(t_arena_current())"; }
            if (cn == "sb_append_str") { return sb_cat5("t_sb_append_str(", av[0], ", ", av[1], ")"); }
            if (cn == "sb_append_char") { return sb_cat5("t_sb_append_char(", av[0], ", ", av[1], ")"); }
            if (cn == "sb_append_u64") { return sb_cat5("t_sb_append_u64(", av[0], ", ", av[1], ")"); }
            if (cn == "sb_append_i64") { return sb_cat5("t_sb_append_i64(", av[0], ", ", av[1], ")"); }
            if (cn == "sb_to_str") { return sb_cat3("t_sb_to_str(", av[0], ")"); }
            if (cn == "int_to_str" || cn == "i2s") { return sb_cat3("t_int_to_str(", av[0], ")"); }
            // 格式化（Python 格式规范迷你语言子集）
            if (cn == "format_int") { return sb_cat5("t_format_int(", av[0], ", ", av[1], ")"); }
            if (cn == "format_uint") { return sb_cat5("t_format_uint(", av[0], ", (uint64_t)(", av[1], "))"); }
            if (cn == "format_float") { return sb_cat5("t_format_float(", av[0], ", ", av[1], ")"); }
            if (cn == "format_str") { return sb_cat5("t_format_str(", av[0], ", ", av[1], ")"); }
            if (cn == "format_bool") { return sb_cat5("t_format_bool(", av[0], ", ", av[1], ")"); }
            if (cn == "format_char") { return sb_cat5("t_format_char(", av[0], ", (uint8_t)(", av[1], "))"); }
            // 时间格式化（M56）/ 解析与固定时区（M57）
            if (cn == "format_time") { return sb_cat5("t_format_time(", av[0], ", ", av[1], ", 0)"); }
            if (cn == "format_time_local") { return sb_cat5("t_format_time(", av[0], ", ", av[1], ", 1)"); }
            if (cn == "format_time_tz") { return sb_cat6("t_format_time_tz(", av[0], ", ", av[1], ", (int64_t)(", sb_cat2(av[2], "))")); }
            if (cn == "parse_time") { return sb_cat5("t_parse_time(", av[0], ", ", av[1], ", 0)"); }
            if (cn == "parse_time_local") { return sb_cat5("t_parse_time(", av[0], ", ", av[1], ", 1)"); }
            if (cn == "time_invalid") { return "INT64_MIN"; }
            if (cn == "now") { return "t_now()"; }
            if (cn == "sb_append_fmt_int") { return sb_cat6("t_sb_append_fmt_int(", av[0], ", ", av[1], ", ", sb_cat2(av[2], ")")); }
            if (cn == "sb_append_fmt_uint") { return sb_cat6("t_sb_append_fmt_uint(", av[0], ", ", av[1], ", (uint64_t)(", sb_cat2(av[2], "))")); }
            if (cn == "sb_append_fmt_float") { return sb_cat6("t_sb_append_fmt_float(", av[0], ", ", av[1], ", ", sb_cat2(av[2], ")")); }
            if (cn == "sb_append_fmt_str") { return sb_cat6("t_sb_append_fmt_str(", av[0], ", ", av[1], ", ", sb_cat2(av[2], ")")); }
            if (cn == "sb_append_fmt_bool") { return sb_cat6("t_sb_append_fmt_bool(", av[0], ", ", av[1], ", ", sb_cat2(av[2], ")")); }
            if (cn == "sb_append_fmt_char") { return sb_cat6("t_sb_append_fmt_char(", av[0], ", ", av[1], ", (uint8_t)(", sb_cat2(av[2], "))")); }
            if (cn == "sb_clear") { return sb_cat3("t_sb_clear(", av[0], ")"); }
            if (cn == "map_new") {
                var mnw0: i64 = -1;
                if (n.la >= 0) { mnw0 = kids[n.la].val; }
                var mnwtd: i64 = expr_type_desc(mnw0);
                var mnwt: TD = tds[mnwtd];
                var mnwkk: i64 = 0;
                if (tds[mnwt.key].cat != "string") { mnwkk = 1; }
                var mnwvs: string = sb_cat3("sizeof(", desc_to_c(mnwt.val), ")");
                return sb_cat5("t_map_new(t_arena_current(), ", i2s(mnwkk), ", (int64_t)", mnwvs, ")");
            }
            if (cn == "map_set") {
                var ms0: i64 = call_arg_node(e, 0);
                var ms1: i64 = call_arg_node(e, 1);
                var ms2: i64 = call_arg_node(e, 2);
                return sb_cat6("t_map_put(", av[0], ", ", c_map_keyp(ms0, ms1), ", ", sb_cat2(c_map_valp(ms0, ms2), ")"));
            }
            if (cn == "map_has") {
                var mh0: i64 = call_arg_node(e, 0);
                return sb_cat4("t_map_has(", av[0], sb_cat2(", ", c_map_keyp(mh0, call_arg_node(e, 1))), ")");
            }
            if (cn == "map_len") { return sb_cat3("t_map_len(", av[0], ")"); }
            if (cn == "map_del") {
                var md0: i64 = call_arg_node(e, 0);
                return sb_cat4("t_map_del(", av[0], sb_cat2(", ", c_map_keyp(md0, call_arg_node(e, 1))), ")");
            }
            if (cn == "map_get") {
                return c_map_get(call_arg_node(e, 0), call_arg_node(e, 1));
            }
            if (cn == "sym_str") {
                var ssarg: i64 = call_arg_node(e, 0);
                var sstd: i64 = expr_type_desc(ssarg);
                var sstag: string = "";
                if (sstd >= 0 && tds[sstd].cat == "sym") { sstag = tds[sstd].name; }
                var sstaglit: string = sb_cat3("TSTR_LIT(\"", esc_c(sstag), "\")");
                return sb_cat5("t_sym_str(", sstaglit, ", ", av[0], ")");
            }
            if (cn == "sym_release") { return sb_cat3("t_sym_release(", av[0], ")"); }
            if (cn == "sym_release_all") { return "t_sym_release_all()"; }
            if (cn == "atom_str") { return sb_cat3("t_atom_str(", av[0], ")"); }
            // 文件描述符内建（M51）
            if (cn == "fopen") {
                return sb_cat5("t_fopen(t_cstr(", av[0], "), ",
                    fid_arg_code(call_arg_node(e, 1), "mode"), ")");
            }
            if (cn == "fclose") { return sb_cat3("t_fclose(", av[0], ")"); }
            if (cn == "fflush") { return sb_cat3("t_fflush(", av[0], ")"); }
            if (cn == "fid_is_open") { return sb_cat3("t_fid_is_open(", av[0], ")"); }
            if (cn == "fid_eof") { return sb_cat3("t_fid_eof(", av[0], ")"); }
            if (cn == "fid_error") { return sb_cat3("t_fid_error(", av[0], ")"); }
            if (cn == "fseek") { return sb_cat5("t_fseek(", av[0], ", ", av[1], ")"); }
            if (cn == "ftell") { return sb_cat3("t_ftell(", av[0], ")"); }
            if (cn == "fid_format") {
                return sb_cat5("t_fid_format(", av[0], ", ",
                    fid_fmt_atom_args(), ")");
            }
            if (cn == "fmt_register") {
                return sb_cat6("t_fmt_register(", fid_arg_code(call_arg_node(e, 0), "kind"),
                    ", t_cstr(", av[1], "), ",
                    sb_cat2(fid_arg_code(call_arg_node(e, 2), "fmt"), ")"));
            }
            // 间接调用：被调者是函数类型的变量/参数/全局，其值是 TClosure*，须解包成
            // `((Ret(*)(void*,A...))(f->fn))(f->env, args)`。顶层具名函数的直接调用
            // 不会命中（clos_callee_td 见到 "name()" 条目即返回 -1）。
            var ictd: i64 = clos_callee_td(cn);
            if (td_is_func(ictd)) {
                var icv: string = mb_sub(cn);
                var icb: StringBuilder = sb_new();
                sb_append_str(icb, "((");
                sb_append_str(icb, td_func_c_fnptr(ictd));
                sb_append_str(icb, ")((");
                sb_append_str(icb, icv);
                sb_append_str(icb, ")->fn))((");
                sb_append_str(icb, icv);
                sb_append_str(icb, ")->env");
                var ici: i64 = 0;
                while (ici < argc) {
                    sb_append_str(icb, ", ");
                    sb_append_str(icb, av[ici]);
                    ici = ici + 1;
                }
                sb_append_str(icb, ")");
                return sb_to_str(icb);
            }
            // 普通调用
            var sb: StringBuilder = sb_new();
            sb_append_str(sb, cn);
            sb_append_char(sb, 40);
            var i: i64 = 0;
            while (i < argc) {
                if (i > 0) {
                    sb_append_str(sb, ", ");
                }
                sb_append_str(sb, av[i]);
                i = i + 1;
            }
            sb_append_char(sb, 41);
            return sb_to_str(sb);
        }
        // callee 非 ident（结构体字段 / 数组元素 / 调用结果…）。若其静态类型是函数类型，
        // 说明拿到的是 TClosure*，须与 ident 路径同样解包。callee 表达式**只能求值一次**
        // （可能是带副作用的调用），故借 clang 语句表达式落到临时量再解包。
        var xctd: i64 = expr_type_desc(n.na);
        if (td_is_func(xctd)) {
            var xcb: StringBuilder = sb_new();
            sb_append_str(xcb, "({ TClosure* __ic = ");
            sb_append_str(xcb, emit_expr(n.na));
            sb_append_str(xcb, "; ((");
            sb_append_str(xcb, td_func_c_fnptr(xctd));
            sb_append_str(xcb, ")(__ic->fn))(__ic->env");
            var xc: i64 = n.la;
            while (xc >= 0) {
                var xk: Child = kids[xc];
                sb_append_str(xcb, ", ");
                sb_append_str(xcb, emit_expr(xk.val));
                xc = xk.next;
            }
            sb_append_str(xcb, "); })");
            return sb_to_str(xcb);
        }
        var sb2: StringBuilder = sb_new();
        sb_append_str(sb2, emit_expr(n.na));
        sb_append_char(sb2, 40);
        var c2: i64 = n.la;
        var first: bool = true;
        while (c2 >= 0) {
            var k2: Child = kids[c2];
            if (!first) {
                sb_append_str(sb2, ", ");
            }
            sb_append_str(sb2, emit_expr(k2.val));
            first = false;
            c2 = k2.next;
        }
        sb_append_char(sb2, 41);
        return sb_to_str(sb2);
    }
    if (n.kind == "member") {
        return sb_cat3(emit_expr(n.na), ".", n.sa);
    }
    if (n.kind == "index") {
        var od: i64 = expr_type_desc(n.na);
        var ot: TD = tds[od];
        var obj: string = emit_expr(n.na);
        var idx: string = emit_expr(n.nb);
        if (ot.cat == "string") {
            return sb_cat5("t_str_byte_at(", obj, ", ", idx, ")");
        }
        if (ot.cat == "slice") {
            var ec: string = c_ptr_to(ot.elem);
            return sb_cat6("(*(", ec, ")t_slice_at(", obj, ", ", sb_cat2(idx, "))"));
        }
        if (ot.cat == "map") {
            return c_map_get(n.na, n.nb);
        }
        return sb_cat6("(", obj, "[", idx, "]", ")");
    }
    if (n.kind == "array_lit") {
        var sb3: StringBuilder = sb_new();
        sb_append_char(sb3, 123);
        var c3: i64 = n.la;
        var first3: bool = true;
        while (c3 >= 0) {
            var k3: Child = kids[c3];
            if (!first3) {
                sb_append_str(sb3, ", ");
            }
            sb_append_str(sb3, emit_expr(k3.val));
            first3 = false;
            c3 = k3.next;
        }
        sb_append_char(sb3, 125);
        return sb_to_str(sb3);
    }
    if (n.kind == "struct_lit") {
        var sb4: StringBuilder = sb_new();
        sb_append_char(sb4, 40);
        sb_append_str(sb4, n.sa);
        sb_append_str(sb4, "){");
        var c4: i64 = n.la;
        var first4: bool = true;
        while (c4 >= 0) {
            var k4: Child = kids[c4];
            var fv: Node = nodes[k4.val];
            if (!first4) {
                sb_append_str(sb4, ", ");
            }
            sb_append_char(sb4, 46);
            sb_append_str(sb4, fv.sa);
            sb_append_str(sb4, " = ");
            sb_append_str(sb4, emit_expr(fv.na));
            first4 = false;
            c4 = k4.next;
        }
        sb_append_char(sb4, 125);
        return sb_to_str(sb4);
    }
    if (n.kind == "cast") {
        return sb_cat6("((", emit_ctype(n.nb), ")", emit_expr(n.na), ")", "");
    }
    if (n.kind == "paren") {
        return sb_cat3("(", emit_expr(n.na), ")");
    }
    return "/* unsupported expr */";
}

// 判定表达式节点是否为数组字面量（切片字面量构造用）
is_array_lit fn(e: i64) -> bool {
    if (e < 0) {
        return false;
    }
    var an: Node = nodes[e];
    return an.kind == "array_lit";
}

is_map_lit fn(e: i64) -> bool {
    if (e < 0) {
        return false;
    }
    var mln: Node = nodes[e];
    return mln.kind == "map_lit";
}

// ── emitStmt（复刻 emitter.ts emitStmt；输出到 slines）─────────

emit_stmt fn(sid: i64, indent: i64) -> void {
    var pad: string = mk_pad(indent);
    g_stmt_pad = pad;    // 供 emit_expr 的 map 字面量分支对齐缩进
    var n: Node = nodes[sid];

    // defer：登记到延迟栈，待 return / 函数尾按 LIFO 运行（见 emit_func_decl 收尾）
    if (n.kind == "defer") {
        if (g_defer_n < 1024) {
            g_defer[g_defer_n] = sid;
            g_defer_n = g_defer_n + 1;
        }
        return;
    }
    // comptime_block：无 CTFE，退化为运行期内联块（避免被静默丢弃）
    if (n.kind == "comptime_block") {
        spush(sb_cat2(pad, "{"));
        var cb: i64 = n.la;
        while (cb >= 0) {
            var ckb: Child = kids[cb];
            emit_stmt(ckb.val, indent + 1);
            cb = ckb.next;
        }
        spush(sb_cat2(pad, "}"));
        return;
    }

    if (n.kind == "expr") {
        spush(sb_cat3(pad, emit_expr(n.na), ";"));
        return;
    }
    // 闭包体首重建捕获变量（M48）：从 env 结构按值拷回同名局部
    if (n.kind == "closure_capture") {
        if (n.na >= 0) {
            var cctd: i64 = resolve_type_desc(n.na);
            spush(sb_cat6(pad, desc_to_c(cctd), " ", n.sa,
                sb_cat4(" = ((", n.sb, "*)__env)->", n.sa), ";"));
        }
        return;
    }
    if (n.kind == "var_decl") {
        if (n.na >= 0) {
            var td: i64 = resolve_type_desc(n.na);
            var t: TD = tds[td];
            if (t.cat == "slice" && n.nb < 0) {
                spush(sb_cat6(pad, "TSlice ", n.sa, " = t_slice_new(sizeof(", desc_to_c(t.elem), "));"));
                return;
            }
            // 切片字面量：`var xs: []T = [a, b, c];` 运行期逐元素构造
            if (t.cat == "slice" && n.nb >= 0 && is_array_lit(n.nb)) {
                var lt: Node = nodes[n.nb];
                var ecs: string = desc_to_c(t.elem);
                spush(sb_cat6(pad, "TSlice ", n.sa, " = t_slice_new(sizeof(", ecs, "));"));
                var cc: i64 = lt.la;
                var ei: i64 = 0;
                while (cc >= 0) {
                    var ck: Child = kids[cc];
                    var tn: string = sb_cat4("_sl_", n.sa, "_", i2s(ei));
                    var ev: string = emit_expr(ck.val);
                    spush(sb_cat6(pad, ecs, " ", tn, sb_cat4(" = (", ecs, ")", ev), ";"));
                    spush(sb_cat6(pad, "t_slice_append(&", n.sa, ", &", tn, ");"));
                    ei = ei + 1;
                    cc = ck.next;
                }
                return;
            }
            // map：`var m: map[K]V;` 建空表；`= [k: v, ...]` 建表后逐项插入；
            // 从变量/表达式赋值（含 map 字面量表达式）则交给下面的通用分支。
            if (t.cat == "map") {
                if (n.nb < 0 || is_map_lit(n.nb)) {
                    if (n.nb < 0) {
                        var mlkk: i64 = 0;
                        if (tds[t.key].cat != "string") { mlkk = 1; }
                        var mlvc: string = desc_to_c(t.val);
                        spush(sb_cat5(pad, "TMap* ", n.sa, " = t_map_new(t_arena_current(), ", sb_cat3(i2s(mlkk), ", (int64_t)sizeof(", sb_cat2(mlvc, "));"))));
                    } else {
                        c_emit_map_lit(n.nb, n.sa, pad, t.key, t.val);
                    }
                    return;
                }
            }
            // Sym：字段仅存 u32/u16 id。无初始化 → 0；`= "str"` → 自动 intern。
            if (t.cat == "sym") {
                var symcty: string = desc_to_c(td);   // "uint32_t" / "uint16_t"
                if (n.nb < 0) {
                    spush(sb_cat5(pad, symcty, " ", n.sa, " = 0;"));
                } else {
                    var symtagl: string = sb_cat3("TSTR_LIT(\"", esc_c(t.name), "\")");
                    var symintr: string = sb_cat6("t_sym_intern(", symtagl, ", ", emit_expr(n.nb), ", ", sb_cat2(i2s(t.alen), ")"));
                    var symhead: string = sb_cat5(pad, symcty, " ", n.sa, " = ");
                    spush(sb_cat2(symhead, sb_cat2(symintr, ";")));
                }
                return;
            }
            // 函数类型：C 侧是闭包指针 TClosure*
            if (t.cat == "func") {
                var fdecl: string = c_decl_of(td, n.sa);
                if (n.nb < 0) {
                    spush(sb_cat3(pad, fdecl, " = NULL;"));
                } else {
                    spush(sb_cat5(pad, fdecl, " = ", emit_expr(n.nb), ";"));
                }
                return;
            }
            if (t.cat == "string" && n.nb < 0) {
                spush(sb_cat4(pad, "TStr ", n.sa, " = {0};"));
                return;
            }
            if (t.cat == "named" && n.nb < 0) {
                var cty: string = desc_to_c(td);
                if (ends_with_star(cty)) {
                    spush(sb_cat6(pad, cty, " ", n.sa, " = NULL;", ""));
                } else {
                    spush(sb_cat6(pad, cty, " ", n.sa, " = {0};", ""));
                }
                return;
            }
            // 定长数组局部：C 后端把 [N]T 表示为 T*，指针本身不带存储。须先声明定长
            // 缓冲再让指针指向它，否则 `var a: [8]i64;` 之后 a[0]=x 会写野指针。
            if (t.cat == "array" && t.alen > 0) {
                var aecy: string = desc_to_c(t.elem);
                var abuf: string = sb_cat2(n.sa, "_abuf");
                var adim: string = sb_cat3("[", i2s(t.alen), "]");
                if (n.nb < 0) {
                    spush(sb_cat5(pad, aecy, " ", abuf, sb_cat2(adim, ";")));
                } else {
                    spush(sb_cat6(pad, aecy, " ", abuf, adim, sb_cat3(" = ", emit_expr(n.nb), ";")));
                }
                spush(sb_cat6(pad, aecy, "* ", n.sa, " = ", sb_cat2(abuf, ";")));
                return;
            }
        }
        var ty: string = "auto";
        if (n.na >= 0) {
            ty = emit_ctype(n.na);
        }
        var init: string = "";
        if (n.nb >= 0) {
            init = sb_cat2(" = ", emit_expr(n.nb));
        }
        spush(sb_cat6(pad, ty, " ", n.sa, init, ";"));
        return;
    }
    if (n.kind == "for_each") {
        var itd: i64 = expr_type_desc(n.na);
        var it: TD = tds[itd];
        // map 的 for-in：按插入序迭代键
        if (it.cat == "map") {
            var mfkc: string = desc_to_c(it.key);
            var mfat: string = "t_map_key_int_at";
            if (tds[it.key].cat == "string") { mfat = "t_map_key_str_at"; }
            var mfit: string = emit_expr(n.na);
            spush(sb_cat4(pad, "for (int64_t _fe_i = 0; _fe_i < t_map_count(", mfit, "); _fe_i = _fe_i + 1) {"));
            spush(sb_cat6(sb_cat2(pad, "    "), mfkc, " ", n.sa, sb_cat6(" = ", mfat, "(", mfit, ", _fe_i);", ""), ""));
            // 双变量形式 `for (k, v in m)`：v 由插入序下标直接取值
            if (str_len(n.sb) > 0) {
                var mfvc: string = desc_to_c(it.val);
                spush(sb_cat6(sb_cat2(pad, "    "), mfvc, " ", n.sb, sb_cat5(" = *((", mfvc, "*)t_map_val_at(", mfit, ", _fe_i));"), ""));
            }
            var mfb: i64 = n.la;
            while (mfb >= 0) {
                var mfbk: Child = kids[mfb];
                emit_stmt(mfbk.val, indent + 2);
                mfb = mfbk.next;
            }
            spush(sb_cat2(pad, "}"));
            return;
        }
        var fe_elem_td: i64 = -1;
        if (it.cat == "slice" && it.elem >= 0) {
            fe_elem_td = it.elem;
        }
        var iter: string = emit_expr(n.na);
        spush(sb_cat6(pad, "for (int64_t _fe_i = 0; _fe_i < t_slice_len(", iter, "); _fe_i = _fe_i + 1) {", "", ""));
        spush(sb_cat6(sb_cat2(pad, "    "), c_decl_of(fe_elem_td, n.sa), " = *((", c_ptr_to(fe_elem_td), sb_cat4(")t_slice_at(", iter, ", _fe_i));", ""), ""));
        var b: i64 = n.la;
        while (b >= 0) {
            var bk: Child = kids[b];
            emit_stmt(bk.val, indent + 2);
            b = bk.next;
        }
        spush(sb_cat2(pad, "}"));
        return;
    }
    if (n.kind == "if") {
        spush(sb_cat4(pad, "if (", emit_expr(n.na), ") {"));
        var tb: i64 = n.la;
        while (tb >= 0) {
            var tk: Child = kids[tb];
            emit_stmt(tk.val, indent + 1);
            tb = tk.next;
        }
        if (n.lb > -2) {
            spush(sb_cat2(pad, "} else {"));
            var eb: i64 = n.lb;
            while (eb >= 0) {
                var ek: Child = kids[eb];
                emit_stmt(ek.val, indent + 1);
                eb = ek.next;
            }
        }
        spush(sb_cat2(pad, "}"));
        return;
    }
    if (n.kind == "while") {
        spush(sb_cat4(pad, "while (", emit_expr(n.na), ") {"));
        var wb: i64 = n.la;
        while (wb >= 0) {
            var wk: Child = kids[wb];
            emit_stmt(wk.val, indent + 1);
            wb = wk.next;
        }
        spush(sb_cat2(pad, "}"));
        return;
    }
    if (n.kind == "for") {
        spush(sb_cat2(pad, "for ("));
        if (n.na >= 0) {
            var ini: Node = nodes[n.na];
            if (ini.kind == "var_decl") {
                var ity: string = "int";
                if (ini.na >= 0) {
                    ity = emit_ctype(ini.na);
                }
                var iin: string = "";
                if (ini.nb >= 0) {
                    iin = sb_cat2(" = ", emit_expr(ini.nb));
                }
                sappend_last(sb_cat4(ity, " ", ini.sa, iin));
            }
            if (ini.kind == "expr") {
                sappend_last(emit_expr(ini.na));
            }
        }
        var cnd: string = "";
        if (n.nb >= 0) {
            cnd = emit_expr(n.nb);
        }
        var upd: string = "";
        if (n.nc >= 0) {
            upd = emit_expr(n.nc);
        }
        sappend_last(sb_cat6("; ", cnd, "; ", upd, ") {", ""));
        var fb: i64 = n.la;
        while (fb >= 0) {
            var fk: Child = kids[fb];
            emit_stmt(fk.val, indent + 1);
            fb = fk.next;
        }
        spush(sb_cat2(pad, "}"));
        return;
    }
    if (n.kind == "return") {
        // 运行延迟语句（defer）LIFO：后登记的先执行
        var di: i64 = g_defer_n - 1;
        while (di >= 0) {
            var dnode: Node = nodes[g_defer[di]];
            var dpad: string = mk_pad(indent);
            spush(sb_cat2(dpad, "{"));
            var dbb: i64 = dnode.la;
            while (dbb >= 0) {
                var dbk: Child = kids[dbb];
                emit_stmt(dbk.val, indent + 1);
                dbb = dbk.next;
            }
            spush(sb_cat2(dpad, "}"));
            di = di - 1;
        }
        g_defer_n = 0;
        if (n.na >= 0) {
            spush(sb_cat4(pad, "return ", emit_expr(n.na), ";"));
        } else {
            spush(sb_cat2(pad, "return;"));
        }
        return;
    }
    if (n.kind == "break") {
        spush(sb_cat2(pad, "break;"));
        return;
    }
    if (n.kind == "continue") {
        spush(sb_cat2(pad, "continue;"));
        return;
    }
    if (n.kind == "assignment") {
        // 注：普通 a = b 语句实际是 "assign" 表达式节点（见 emit_expr），"assignment"
        // 节点在此保留为兜底；map 索引写已在 emit_expr 的 "assign" 分支处理。
        spush(sb_cat6(pad, emit_expr(n.na), " ", n.sa, " ", sb_cat2(emit_expr(n.nb), ";")));
        return;
    }
    if (n.kind == "block") {
        spush(sb_cat2(pad, "{"));
        var bb: i64 = n.la;
        while (bb >= 0) {
            var bk2: Child = kids[bb];
            emit_stmt(bk2.val, indent + 1);
            bb = bk2.next;
        }
        spush(sb_cat2(pad, "}"));
        return;
    }
    // 其余未识别节点：不输出（fallthrough）
}

// ═══════════════════════════════════════════════════════════════
// E3: emit_decl / derive / flag 布局 / emit 编排 / 驱动 main
// ═══════════════════════════════════════════════════════════════

// ── JS parseInt 复刻（enum autoValue 用；radix 16 允许 0x 前缀，
//    radix 2 遇 'b' 停在 "0" → 0，复刻 tc0 quirk）────────────────

js_parse_int fn(s: string, radix: i64) -> i64 {
    var i: u64 = 0;
    var n: u64 = str_len(s);
    var neg: bool = false;
    if (i < n) {
        if (s[i] == 43 || s[i] == 45) {
            if (s[i] == 45) {
                neg = true;
            }
            i = i + 1;
        }
    }
    if (radix == 16 && i + 1 < n) {
        if (s[i] == 48 && (s[i + 1] == 120 || s[i + 1] == 88)) {
            i = i + 2;
        }
    }
    var val: i64 = 0;
    while (i < n) {
        var c: u8 = s[i];
        var d: i64 = -1;
        if (c >= 48 && c <= 57) {
            d = (c - 48) as i64;
        }
        if (c >= 97 && c <= 122) {
            d = (c - 87) as i64;
        }
        if (c >= 65 && c <= 90) {
            d = (c - 55) as i64;
        }
        if (d < 0 || d >= radix) {
            break;
        }
        val = val * radix + d;
        i = i + 1;
    }
    if (neg) {
        return 0 - val;
    }
    return val;
}

// ── JS (1 << bw) - 1 复刻（int32 回绕；flag slot maxValue）─────

js_max_val fn(bw: i64) -> i64 {
    var sh: i64 = bw % 32;
    if (sh < 0) {
        sh = sh + 32;
    }
    var v: i64 = 1 << sh;
    if (sh == 31) {
        v = 0 - 2147483648;
    }
    return v - 1;
}

// ── Flag 槽布局池（复刻 bitfield.ts resolve 的布局部分，无诊断；
//    growing pool + base 偏移，同 fr_names 模式）──────────────────

var fl_names: []string;
var fl_starts: []i64;
var fl_lens: []i64;
var fl_ends: []i64;

fr_layout fn(d: i64) -> i64 {
    var base: i64 = slice_len(fl_names) as i64;
    var n: Node = nodes[d];
    var auto_off: i64 = 0;
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var sl: Node = nodes[k.val];
        var start: i64 = auto_off;
        if (sl.bb) {
            start = sl.ib;
        }
        var end: i64 = start + sl.ia;
        append(fl_names, sl.sa);
        append(fl_starts, start);
        append(fl_lens, sl.ia);
        append(fl_ends, end);
        auto_off = end;
        c = k.next;
    }
    return base;
}

// ── derive traits / fields 收集（growing pool + base 偏移）─────

var dt_traits: []string;

collect_traits fn(d: i64) -> i64 {
    var base: i64 = slice_len(dt_traits) as i64;
    var n: Node = nodes[d];
    var ai: i64 = ann_find(n.la, "derive");
    if (ai < 0) {
        return base;
    }
    var an: Node = nodes[ai];
    var c: i64 = an.la;
    while (c >= 0) {
        var k: Child = kids[c];
        var arg: Node = nodes[k.val];
        if (arg.kind == "ident") {
            append(dt_traits, arg.sa);
        }
        if (arg.kind == "list") {
            var c2: i64 = arg.la;
            while (c2 >= 0) {
                var k2: Child = kids[c2];
                var v: Node = nodes[k2.val];
                if (v.kind == "ident") {
                    append(dt_traits, v.sa);
                }
                c2 = k2.next;
            }
        }
        c = k.next;
    }
    return base;
}

var df_names: []string;
var df_anns: []i64;

collect_fields fn(d: i64) -> i64 {
    var base: i64 = slice_len(df_names) as i64;
    var n: Node = nodes[d];
    if (n.kind == "VariantDecl") {
        return base;
    }
    if (n.kind == "StructDecl") {
        var c: i64 = n.lb;
        while (c >= 0) {
            var k: Child = kids[c];
            var f: Node = nodes[k.val];
            if (f.ia < 0) {
                append(df_names, f.sa);
                append(df_anns, f.la);
            }
            c = k.next;
        }
        return base;
    }
    if (n.kind == "EnumDecl" || n.kind == "UnionDecl") {
        var c2: i64 = n.lb;
        while (c2 >= 0) {
            var k2: Child = kids[c2];
            var f2: Node = nodes[k2.val];
            append(df_names, f2.sa);
            append(df_anns, f2.la);
            c2 = k2.next;
        }
    }
    return base;
}

// ── derive 代码生成（复刻 derive.ts；含 [object Object] 与
//    t 语法方法体等 tc0 bug，逐字节一致要求）───────────────────

gen_trait fn(trait: string, name: string, fb: i64, fe: i64) -> string {
    var sb: StringBuilder = sb_new();

    if (trait == "ToString") {
        sb_append_str(sb, "// @derive(ToString) — auto-generated\nto_string fn(self: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ") -> string {\n    return \"");
        sb_append_str(sb, name);
        sb_append_str(sb, " { ");
        var i: i64 = fb;
        while (i < fe) {
            if (i > fb) {
                sb_append_str(sb, ", ");
            }
            sb_append_str(sb, df_names[i]);
            sb_append_str(sb, "=$");
            sb_append_str(sb, df_names[i]);
            i = i + 1;
        }
        sb_append_str(sb, " }\";\n}");
        return sb_to_str(sb);
    }

    if (trait == "FromString") {
        sb_append_str(sb, "// @derive(FromString) — auto-generated\nfrom_string fn(s: string) -> ");
        sb_append_str(sb, name);
        sb_append_str(sb, " {\n    var result: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ";\n    // parse fields: ");
        var i2: i64 = fb;
        while (i2 < fe) {
            if (i2 > fb) {
                sb_append_str(sb, ", ");
            }
            sb_append_str(sb, df_names[i2]);
            i2 = i2 + 1;
        }
        sb_append_str(sb, "\n    return result;\n}");
        return sb_to_str(sb);
    }

    if (trait == "Clone") {
        sb_append_str(sb, "// @derive(Clone) — auto-generated\nclone fn(self: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ") -> ");
        sb_append_str(sb, name);
        sb_append_str(sb, " {\n    return ");
        sb_append_str(sb, name);
        sb_append_str(sb, " { ");
        var i3: i64 = fb;
        while (i3 < fe) {
            if (i3 > fb) {
                sb_append_str(sb, ", ");
            }
            sb_append_str(sb, df_names[i3]);
            sb_append_str(sb, ": self.");
            sb_append_str(sb, df_names[i3]);
            i3 = i3 + 1;
        }
        sb_append_str(sb, " };\n}");
        return sb_to_str(sb);
    }

    if (trait == "Copy") {
        sb_append_str(sb, "// @derive(Copy) — auto-generated\n// ");
        sb_append_str(sb, name);
        sb_append_str(sb, " is marked as Copy (bitwise copy on assignment)");
        return sb_to_str(sb);
    }

    if (trait == "DebugPrint") {
        sb_append_str(sb, "// @derive(DebugPrint) — auto-generated\ndebug_print fn(self: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ") -> string {\n    return \"");
        sb_append_str(sb, name);
        sb_append_str(sb, "(");
        var i4: i64 = fb;
        while (i4 < fe) {
            if (i4 > fb) {
                sb_append_str(sb, ", ");
            }
            sb_append_str(sb, df_names[i4]);
            sb_append_str(sb, ": {self.");
            sb_append_str(sb, df_names[i4]);
            sb_append_str(sb, "}");
            i4 = i4 + 1;
        }
        sb_append_str(sb, ")\";\n}");
        return sb_to_str(sb);
    }

    if (trait == "BinarySerde") {
        sb_append_str(sb, "// @derive(BinarySerde) — auto-generated\nserialize fn(self: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ") -> []u8 {\n");
        // serializeLines: filter 掉 @binary_skip，索引按过滤后数组计
        var cnt: i64 = 0;
        var i5: i64 = fb;
        while (i5 < fe) {
            if (ann_find(df_anns[i5], "binary_skip") < 0) {
                if (cnt > 0) {
                    sb_append_str(sb, "\n");
                }
                sb_append_str(sb, "    // offset ");
                var oa: i64 = ann_find(df_anns[i5], "binary_offset");
                var has_off: bool = false;
                if (oa >= 0) {
                    if (ann_first_arg(oa) >= 0) {
                        has_off = true;
                    }
                }
                if (has_off) {
                    // tc0 bug: 模板串里插入 arg 对象 → "[object Object]"
                    sb_append_str(sb, "[object Object]");
                } else {
                    sb_append_i64(sb, cnt * 4);
                }
                sb_append_str(sb, ": write self.");
                sb_append_str(sb, df_names[i5]);
                cnt = cnt + 1;
            }
            i5 = i5 + 1;
        }
        sb_append_str(sb, "\n    return buffer;\n}\n\ndeserialize fn(data: []u8) -> ");
        sb_append_str(sb, name);
        sb_append_str(sb, " {\n    var result: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ";\n    // read fields from data at specified offsets\n    return result;\n}");
        return sb_to_str(sb);
    }

    if (trait == "Eq" || trait == "PartialEq") {
        sb_append_str(sb, "// @derive(Eq) — auto-generated\neq fn(self: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ", other: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ") -> bool {\n    return ");
        if (fb == fe) {
            sb_append_str(sb, "true");
        } else {
            var i6: i64 = fb;
            while (i6 < fe) {
                if (i6 > fb) {
                    sb_append_str(sb, " && ");
                }
                sb_append_str(sb, "self.");
                sb_append_str(sb, df_names[i6]);
                sb_append_str(sb, " == other.");
                sb_append_str(sb, df_names[i6]);
                i6 = i6 + 1;
            }
        }
        sb_append_str(sb, ";\n}");
        return sb_to_str(sb);
    }

    if (trait == "Hash") {
        sb_append_str(sb, "// @derive(Hash) — auto-generated\nhash fn(self: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ") -> u64 {\n    var hash: u64 = 0;\n");
        var i7: i64 = fb;
        while (i7 < fe) {
            if (i7 > fb) {
                sb_append_str(sb, "\n");
            }
            sb_append_str(sb, "    hash = hash_combine(hash, hash_of(self.");
            sb_append_str(sb, df_names[i7]);
            sb_append_str(sb, "));");
            i7 = i7 + 1;
        }
        sb_append_str(sb, "\n    return hash;\n}");
        return sb_to_str(sb);
    }

    return "";
}

process_derive fn(d: i64) -> void {
    var n: Node = nodes[d];
    var tb: i64 = collect_traits(d);
    var te: i64 = slice_len(dt_traits) as i64;
    if (tb == te) {
        return;
    }
    var fb: i64 = collect_fields(d);
    var fe: i64 = slice_len(df_names) as i64;
    var i: i64 = tb;
    while (i < te) {
        var code: string = gen_trait(dt_traits[i], n.sa, fb, fe);
        if (code != "") {
            spush(code);
            spush("");
        }
        i = i + 1;
    }
}

// ── emitAttributes（复刻 emitter.ts emitAttributes）────────────

emit_attributes fn(head: i64) -> string {
    var sb: StringBuilder = sb_new();
    var cnt: i64 = 0;
    var c: i64 = head;
    while (c >= 0) {
        var k: Child = kids[c];
        var a: Node = nodes[k.val];
        var s: string = "";
        var has: bool = false;
        if (a.sa == "inline") {
            s = "__attribute__((always_inline))";
            has = true;
        }
        if (a.sa == "no_inline") {
            s = "__attribute__((noinline))";
            has = true;
        }
        if (a.sa == "deprecated") {
            s = "__attribute__((deprecated))";
            var arg: i64 = ann_first_arg(k.val);
            if (arg >= 0) {
                var an: Node = nodes[arg];
                if (an.kind == "string") {
                    s = sb_cat3("__attribute__((deprecated(\"", an.sa, "\")))");
                }
            }
            has = true;
        }
        if (a.sa == "must_use") {
            s = "__attribute__((warn_unused_result))";
            has = true;
        }
        if (a.sa == "export_symbol") {
            var arg2: i64 = ann_first_arg(k.val);
            if (arg2 >= 0) {
                var an2: Node = nodes[arg2];
                if (an2.kind == "string") {
                    s = "__attribute__((visibility(\"default\")))";
                    has = true;
                }
            }
        }
        if (has) {
            if (cnt > 0) {
                sb_append_str(sb, " ");
            }
            sb_append_str(sb, s);
            cnt = cnt + 1;
        }
        c = k.next;
    }
    return sb_to_str(sb);
}

// ── 各声明 emitter（复刻 emitter.ts emitDecl 系列）─────────────

emit_struct_decl fn(d: i64) -> void {
    var n: Node = nodes[d];
    var attrs: string = emit_attributes(n.la);

    if (n.ba && n.has_sc) {
        hpush(sb_cat3("// @bitpack(", n.sc, ") struct"));
        if (attrs != "") {
            hpush(attrs);
        }
        hpush(sb_cat3("typedef struct ", n.sa, " {"));
        var c: i64 = n.lb;
        while (c >= 0) {
            var k: Child = kids[c];
            var f: Node = nodes[k.val];
            var fsb: StringBuilder = sb_new();
            sb_append_str(fsb, "    ");
            sb_append_str(fsb, scalar_to_c(n.sc));
            sb_append_str(fsb, " ");
            sb_append_str(fsb, f.sa);
            sb_append_str(fsb, " : ");
            sb_append_i64(fsb, f.ia);
            sb_append_str(fsb, ";");
            hpush(sb_to_str(fsb));
            c = k.next;
        }
        hpush(sb_cat3("} ", n.sa, ";"));
    } else {
        var layout_attr: string = "";
        if (n.sb == "soa") {
            layout_attr = " // #soa layout";
        }
        if (attrs != "") {
            hpush(attrs);
        }
        hpush(sb_cat4("typedef struct ", n.sa, " {", layout_attr));
        var c2: i64 = n.lb;
        while (c2 >= 0) {
            var k2: Child = kids[c2];
            var f2: Node = nodes[k2.val];
            if (f2.ia < 0) {
                var fattrs: string = emit_attributes(f2.la);
                if (fattrs != "") {
                    hpush(sb_cat2("    ", fattrs));
                }
                hpush(sb_cat3("    ", c_decl_of_node(f2.na, f2.sa), ";"));
            }
            c2 = k2.next;
        }
        hpush(sb_cat3("} ", n.sa, ";"));
    }

    process_derive(d);
}

emit_enum_decl fn(d: i64) -> void {
    var n: Node = nodes[d];
    hpush(sb_cat6("typedef ", scalar_to_c(n.sb), " ", n.sa, ";", ""));
    hpush("");
    var auto_val: i64 = 0;
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var v: Node = nodes[k.val];
        if (v.na >= 0) {
            hpush(sb_cat6("#define ", n.sa, "_", v.sa, " ", emit_expr(v.na)));
            var vn: Node = nodes[v.na];
            if (vn.kind == "int") {
                auto_val = js_parse_int(vn.sa, vn.ia) + 1;
            }
        } else {
            hpush(sb_cat6("#define ", n.sa, "_", v.sa, " ", i2s(auto_val)));
            auto_val = auto_val + 1;
        }
        c = k.next;
    }
}

emit_flag_decl fn(d: i64) -> void {
    var n: Node = nodes[d];
    hpush(sb_cat4("// flag[", n.sb, "] ", n.sa));
    hpush(sb_cat6("typedef ", scalar_to_c(n.sb), " ", n.sa, ";", ""));
    hpush("");

    var base: i64 = fr_layout(d);
    var total: i64 = slice_len(fl_names) as i64;
    var i: i64 = base;
    while (i < total) {
        if (fl_lens[i] == 1) {
            var ssb: StringBuilder = sb_new();
            sb_append_str(ssb, "#define ");
            sb_append_str(ssb, n.sa);
            sb_append_str(ssb, "_");
            sb_append_str(ssb, fl_names[i]);
            sb_append_str(ssb, " (1u << ");
            sb_append_i64(ssb, fl_starts[i]);
            sb_append_str(ssb, ")");
            hpush(sb_to_str(ssb));
        } else {
            var csb: StringBuilder = sb_new();
            sb_append_str(csb, "// ");
            sb_append_str(csb, fl_names[i]);
            sb_append_str(csb, ": bits ");
            sb_append_i64(csb, fl_starts[i]);
            sb_append_str(csb, "-");
            sb_append_i64(csb, fl_ends[i] - 1);
            sb_append_str(csb, " (");
            sb_append_i64(csb, fl_lens[i]);
            sb_append_str(csb, " bits, max=");
            sb_append_i64(csb, js_max_val(fl_lens[i]));
            sb_append_str(csb, ")");
            hpush(sb_to_str(csb));
            var hsb: StringBuilder = sb_new();
            sb_append_str(hsb, "#define ");
            sb_append_str(hsb, n.sa);
            sb_append_str(hsb, "_");
            sb_append_str(hsb, fl_names[i]);
            sb_append_str(hsb, "_SHIFT ");
            sb_append_i64(hsb, fl_starts[i]);
            hpush(sb_to_str(hsb));
            var msb: StringBuilder = sb_new();
            sb_append_str(msb, "#define ");
            sb_append_str(msb, n.sa);
            sb_append_str(msb, "_");
            sb_append_str(msb, fl_names[i]);
            sb_append_str(msb, "_MASK (((1u << ");
            sb_append_i64(msb, fl_lens[i]);
            sb_append_str(msb, ") - 1) << ");
            sb_append_i64(msb, fl_starts[i]);
            sb_append_str(msb, ")");
            hpush(sb_to_str(msb));
        }
        i = i + 1;
    }
}

emit_flag_set_decl fn(d: i64) -> void {
    var n: Node = nodes[d];
    hpush(sb_cat3("// flag_set ", n.sa, " (dynamic length bitfield)"));
    hpush(sb_cat3("typedef struct ", n.sa, " {"));
    hpush("    uint8_t* data;");
    hpush("    size_t bit_count;");
    hpush("    size_t byte_count;");
    hpush(sb_cat3("} ", n.sa, ";"));
    hpush("");

    var base: i64 = fr_layout(d);
    var total: i64 = slice_len(fl_names) as i64;
    var i: i64 = base;
    while (i < total) {
        var csb: StringBuilder = sb_new();
        sb_append_str(csb, "// ");
        sb_append_str(csb, fl_names[i]);
        sb_append_str(csb, ": bits ");
        sb_append_i64(csb, fl_starts[i]);
        sb_append_str(csb, "-");
        sb_append_i64(csb, fl_ends[i] - 1);
        sb_append_str(csb, " (");
        sb_append_i64(csb, fl_lens[i]);
        sb_append_str(csb, " bits)");
        hpush(sb_to_str(csb));
        var hsb: StringBuilder = sb_new();
        sb_append_str(hsb, "#define ");
        sb_append_str(hsb, n.sa);
        sb_append_str(hsb, "_");
        sb_append_str(hsb, fl_names[i]);
        sb_append_str(hsb, "_SHIFT ");
        sb_append_i64(hsb, fl_starts[i]);
        hpush(sb_to_str(hsb));
        var msb: StringBuilder = sb_new();
        sb_append_str(msb, "#define ");
        sb_append_str(msb, n.sa);
        sb_append_str(msb, "_");
        sb_append_str(msb, fl_names[i]);
        sb_append_str(msb, "_MASK (((1u << ");
        sb_append_i64(msb, fl_lens[i]);
        sb_append_str(msb, ") - 1) << ");
        sb_append_i64(msb, fl_starts[i]);
        sb_append_str(msb, ")");
        hpush(sb_to_str(msb));
        i = i + 1;
    }
}

emit_union_decl fn(d: i64) -> void {
    var n: Node = nodes[d];
    hpush(sb_cat3("typedef union ", n.sa, " {"));
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var m: Node = nodes[k.val];
        hpush(sb_cat6("    ", emit_ctype(m.na), " ", m.sa, ";", ""));
        c = k.next;
    }
    hpush(sb_cat3("} ", n.sa, ";"));
}

// Variant：tagged union。发射 struct { uint32_t _tag; union { 载荷 _uN; } _u; } 及各 case 的
// static inline 构造器/判别器/取载荷（直接落头文件，函数体用 StringBuilder 拼 tag 整数）。
emit_variant_decl fn(d: i64) -> void {
    var n: Node = nodes[d];
    var hsb: StringBuilder = sb_new();
    sb_append_str(hsb, "// variant ");
    sb_append_str(hsb, n.sa);
    hpush(sb_to_str(hsb));
    hpush(sb_cat3("typedef struct ", n.sa, " {"));
    hpush("    uint32_t _tag;");
    hpush("    union {");
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var vc: Node = nodes[k.val];
        if (vc.na >= 0) {
            var us: StringBuilder = sb_new();
            sb_append_str(us, "        ");
            sb_append_str(us, emit_ctype(vc.na));
            sb_append_str(us, " _u");
            sb_append_i64(us, vc.ia);
            sb_append_str(us, ";");
            hpush(sb_to_str(us));
        }
        c = k.next;
    }
    hpush("    } _u;");
    hpush(sb_cat3("} ", n.sa, ";"));
    hpush("");

    c = n.lb;
    while (c >= 0) {
        var k2: Child = kids[c];
        var vc2: Node = nodes[k2.val];
        var cname: string = vc2.sa;
        // 构造器
        var fsb: StringBuilder = sb_new();
        sb_append_str(fsb, "static inline ");
        sb_append_str(fsb, n.sa);
        sb_append_str(fsb, " ");
        sb_append_str(fsb, n.sa);
        sb_append_str(fsb, "_from_");
        sb_append_str(fsb, cname);
        if (vc2.na >= 0) {
            sb_append_str(fsb, "(");
            sb_append_str(fsb, emit_ctype(vc2.na));
            sb_append_str(fsb, " v) {");
        } else {
            sb_append_str(fsb, "(void) {");
        }
        hpush(sb_to_str(fsb));
        hpush(sb_cat3("    ", n.sa, " _s;"));
        var tsb: StringBuilder = sb_new();
        sb_append_str(tsb, "    _s._tag = ");
        sb_append_i64(tsb, vc2.ia);
        sb_append_str(tsb, ";");
        hpush(sb_to_str(tsb));
        if (vc2.na >= 0) {
            var asb: StringBuilder = sb_new();
            sb_append_str(asb, "    _s._u._u");
            sb_append_i64(asb, vc2.ia);
            sb_append_str(asb, " = v;");
            hpush(sb_to_str(asb));
        }
        hpush("    return _s;");
        hpush("}");
        // 判别器
        var isb: StringBuilder = sb_new();
        sb_append_str(isb, "static inline bool ");
        sb_append_str(isb, n.sa);
        sb_append_str(isb, "_is_");
        sb_append_str(isb, cname);
        sb_append_str(isb, "(");
        sb_append_str(isb, n.sa);
        sb_append_str(isb, " self) {");
        hpush(sb_to_str(isb));
        var isb2: StringBuilder = sb_new();
        sb_append_str(isb2, "    return self._tag == ");
        sb_append_i64(isb2, vc2.ia);
        sb_append_str(isb2, ";");
        hpush(sb_to_str(isb2));
        hpush("}");
        // 取载荷
        if (vc2.na >= 0) {
            var asb2: StringBuilder = sb_new();
            sb_append_str(asb2, "static inline ");
            sb_append_str(asb2, emit_ctype(vc2.na));
            sb_append_str(asb2, " ");
            sb_append_str(asb2, n.sa);
            sb_append_str(asb2, "_as_");
            sb_append_str(asb2, cname);
            sb_append_str(asb2, "(");
            sb_append_str(asb2, n.sa);
            sb_append_str(asb2, " self) {");
            hpush(sb_to_str(asb2));
            var asb3: StringBuilder = sb_new();
            sb_append_str(asb3, "    return self._u._u");
            sb_append_i64(asb3, vc2.ia);
            sb_append_str(asb3, ";");
            hpush(sb_to_str(asb3));
            hpush("}");
        }
        c = k2.next;
    }
    hpush("");
}

emit_func_decl fn(d: i64) -> void {
    var n: Node = nodes[d];
    var emit_name: string = n.sa;
    if (ann_find(n.la, "main") >= 0) {
        emit_name = sb_cat2("t_entry_", n.sa);
        em_main_fn = emit_name;
        em_has_main = true;
    }
    var attrs: string = emit_attributes(n.la);

    var psb: StringBuilder = sb_new();
    var cnt: i64 = 0;
    // 带捕获的合成闭包函数（M48）：env 指针为首参，与 TClosure ABI 一致
    if (str_len(n.sb) > 0) {
        sb_append_str(psb, "void* __env");
        cnt = 1;
    }
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var p: Node = nodes[k.val];
        if (cnt > 0) {
            sb_append_str(psb, ", ");
        }
        sb_append_str(psb, c_decl_of_node(p.na, p.sa));
        cnt = cnt + 1;
        c = k.next;
    }
    var param_str: string = "void";
    if (cnt > 0) {
        param_str = sb_to_str(psb);
    }
    // 返回函数指针的函数必须写成 `Ret (*name(params))(Args)`——把 `name(params)`
    // 整体当作声明子塞进函数指针声明里，不能拼成 `Ret (*)(Args) name(params)`。
    var sig: string = c_decl_of_node(n.na, sb_cat4(emit_name, "(", param_str, ")"));

    if (n.ba) {
        if (attrs != "") {
            hpush(attrs);
        }
        hpush(sb_cat2(sig, ";"));
        return;
    }

    if (attrs != "") {
        hpush(attrs);
    }
    hpush(sb_cat2(sig, ";"));

    em_cur_fn = n.sa;
    em_in_fn = true;
    g_defer_n = 0;   // 每个函数独立延迟栈
    spush(sb_cat2(sig, " {"));
    if (n.lc > -2) {
        var b: i64 = n.lc;
        while (b >= 0) {
            var bk: Child = kids[b];
            emit_stmt(bk.val, 1);
            b = bk.next;
        }
    }
    // 函数正常结束（无显式 return）：运行剩余 defer（LIFO）
    {
        var di: i64 = g_defer_n - 1;
        while (di >= 0) {
            var dnode: Node = nodes[g_defer[di]];
            spush("    {");
            var dbb: i64 = dnode.la;
            while (dbb >= 0) {
                var dbk: Child = kids[dbb];
                emit_stmt(dbk.val, 2);
                dbb = dbk.next;
            }
            spush("    }");
            di = di - 1;
        }
        g_defer_n = 0;
    }
    spush("}");
    em_in_fn = false;
    em_cur_fn = "";
    spush("");
}

emit_global_var fn(d: i64) -> void {
    var n: Node = nodes[d];
    hpush(sb_cat3("extern ", c_decl_of_node(n.na, n.sa), ";"));
    // Sym 全局变量：字段仅存 u32/u16 id。无初始化 → 零值；`= "str"` →
    // 运行期 intern（函数调用），须搬进 t__ginit（C 文件作用域不允许调用）。
    var gtd0: i64 = resolve_type_desc(n.na);
    var gt0: TD = tds[gtd0];
    if (gt0.cat == "sym") {
        var symcty: string = emit_ctype(n.na);
        if (n.nb < 0) {
            spush(sb_cat5(symcty, " ", n.sa, ";", ""));
            return;
        }
        var symtagl: string = sb_cat3("TSTR_LIT(\"", esc_c(gt0.name), "\")");
        var symintr: string = sb_cat6("t_sym_intern(", symtagl, ", ", emit_expr(n.nb), ", ", sb_cat2(i2s(gt0.alen), ")"));
        spush(sb_cat5(symcty, " ", n.sa, ";", ""));
        append(glines, sb_cat4("    ", n.sa, " = ", sb_cat2(symintr, ";")));
        return;
    }
    // 定长数组全局：C 后端把 [N]T 表示为 T*，但指针本身没有存储 → 须分配定长缓冲并让
    // 变量指向它，否则 g_fc_d[0] = x 之类会写 NULL 地址（LLVM 后端用 [N x T]，无此问题）。
    if (gt0.cat == "array" && gt0.alen > 0) {
        var gaecy: string = desc_to_c(gt0.elem);
        var gabuf: string = sb_cat2(n.sa, "_abuf");
        var gadim: string = sb_cat3("[", i2s(gt0.alen), "]");
        if (n.nb < 0) {
            spush(sb_cat4(gaecy, " ", gabuf, sb_cat2(gadim, ";")));
        } else {
            spush(sb_cat5(gaecy, " ", gabuf, gadim, sb_cat3(" = ", emit_expr(n.nb), ";")));
        }
        spush(sb_cat5(gaecy, "* ", n.sa, " = ", sb_cat2(gabuf, ";")));
        return;
    }
    if (n.nb < 0) {
        spush(sb_cat2(c_decl_of_node(n.na, n.sa), ";"));
        return;
    }
    // 先在重定向模式下发射初始化器：若它产生了辅助语句（如 map 字面量的
    // t_map_new/t_map_put），说明不是 C 的编译期常量，须搬进 t__ginit。
    var gbase: i64 = slice_len(glines) as i64;
    g_spush_to_ginit = true;
    g_stmt_pad = "    ";
    var gv: string = emit_expr(n.nb);
    g_spush_to_ginit = false;
    g_stmt_pad = "";
    if ((slice_len(glines) as i64) > gbase) {
        spush(sb_cat2(c_decl_of_node(n.na, n.sa), ";"));
        append(glines, sb_cat4("    ", n.sa, " = ", sb_cat2(gv, ";")));
        return;
    }
    spush(sb_cat4(c_decl_of_node(n.na, n.sa), " = ", gv, ";"));
}

emit_global_const fn(d: i64) -> void {
    var n: Node = nodes[d];
    hpush(sb_cat6("#define ", n.sa, " (", emit_expr(n.nb), ")", ""));
}

emit_decl fn(d: i64) -> void {
    var n: Node = nodes[d];
    if (n.kind == "StructDecl") {
        emit_struct_decl(d);
        return;
    }
    if (n.kind == "EnumDecl") {
        emit_enum_decl(d);
        return;
    }
    if (n.kind == "FlagDecl") {
        emit_flag_decl(d);
        return;
    }
    if (n.kind == "FlagSetDecl") {
        emit_flag_set_decl(d);
        return;
    }
    if (n.kind == "UnionDecl") {
        emit_union_decl(d);
        return;
    }
    if (n.kind == "VariantDecl") {
        emit_variant_decl(d);
        return;
    }
    if (n.kind == "FuncDecl") {
        emit_func_decl(d);
        return;
    }
    if (n.kind == "GlobalVarDecl") {
        emit_global_var(d);
        return;
    }
    if (n.kind == "GlobalConstDecl") {
        emit_global_const(d);
        return;
    }
    if (n.kind == "ImportDecl") {
        hpush(sb_cat3("#include \"", n.sb, "\""));
        return;
    }
    if (n.kind == "ImportModDecl") {
        // 模块导入（M-Module）：单文件 tc 不解析模块，发射期不产生任何 C 输出；
        // 模块解析与头文件内联由 tote 构建层完成。
        return;
    }
    if (n.kind == "TypeAliasDecl") {
        hpush(sb_cat6("typedef ", emit_ctype(n.na), " ", n.sa, ";", ""));
        return;
    }
}

// ── Flag 操作宏（复刻 emitFlagMacros）──────────────────────────

emit_flag_macros fn() -> void {
    hpush("");
    hpush("// ── Flag operations (spec 6.4) ──");
    hpush("// 1-bit: use | & ^ operators, check with (mask & FLAG) != 0");
    hpush("// multi-bit: use flag_set_val/flag_get_val macros");
    hpush("");
    hpush("#define flag_set_val(flags, shift, mask, val) do { (flags) = ((flags) & ~(mask)) | (((val) << (shift)) & (mask)); } while(0)");
    hpush("#define flag_get_val(flags, shift, mask) (((flags) & (mask)) >> (shift))");
    hpush("");
}

// ── emit 编排（复刻 CEmitter.emit）─────────────────────────────

// ── 函数值闭包的 C 侧落地（FuncType v2 / M47）───────────────────
// 顶层具名函数的 C 定义是 `Ret g(Args)`，没有 env 首参；而函数**值**的统一
// 调用约定是 `Ret (*)(void* env, Args)`。直接强转会让 env 挤掉首个真实参数，
// 故为每个被取值的函数生成一层 static trampoline 吃掉 env 再转发：
//
//   static Ret __tramp_g(void* __env, A0 __a0, A1 __a1) {
//       (void)__env; return g(__a0, __a1);
//   }
//   static TClosure __tclos_g = { (void*)__tramp_g, NULL };
//
// 输出进头文件尾部：此时全部函数原型已在其上方，且生成的 .c 首行即 #include
// 该头文件，故所有函数体引用 `(&__tclos_g)` 时它已定义。
emit_c_closures fn() -> void {
    var cn: i64 = slice_len(clos_names) as i64;
    if (cn == 0) {
        return;
    }
    hpush("");
    hpush("// ── 函数值闭包（FuncType v2）：trampoline + 静态闭包记录 ──");
    var i: i64 = 0;
    while (i < cn) {
        var nm: string = clos_names[i];
        var d: i64 = clos_decl_of(nm);
        if (d >= 0) {
            var dn: Node = nodes[d];
            var callee: string = nm;
            if (ann_find(dn.la, "main") >= 0) {
                callee = sb_cat2("t_entry_", nm);
            }
            var rty: string = emit_ctype(dn.na);
            var psb: StringBuilder = sb_new();
            var asb: StringBuilder = sb_new();
            sb_append_str(psb, "void* __env");
            var c: i64 = dn.lb;
            var pi: i64 = 0;
            while (c >= 0) {
                var k: Child = kids[c];
                var p: Node = nodes[k.val];
                var pn: string = sb_cat2("__a", i2s(pi));
                sb_append_str(psb, ", ");
                sb_append_str(psb, c_decl_of_node(p.na, pn));
                if (pi > 0) {
                    sb_append_str(asb, ", ");
                }
                sb_append_str(asb, pn);
                pi = pi + 1;
                c = k.next;
            }
            hpush(sb_cat6("static ", rty, " __tramp_", nm, "(", sb_cat2(sb_to_str(psb), ") {")));
            hpush("    (void)__env;");
            if (rty == "void") {
                hpush(sb_cat5("    ", callee, "(", sb_to_str(asb), ");"));
            } else {
                hpush(sb_cat5("    return ", callee, "(", sb_to_str(asb), ");"));
            }
            hpush("}");
            hpush(sb_cat6("static TClosure __tclos_", nm, " = { (void*)__tramp_", nm, ", NULL };", ""));
        }
        i = i + 1;
    }
}

// 全局 atom 名表（C 后端）：索引 0 为占位空串，其后按 g_atom_names 顺序；
// 因 atom_intern 返回 1-based id，故 t_atom_table[id] 直接命中（index 0 不用）。
// 运行时 t_atom_str(id) 经 extern 引用此表。无 atom 时也发射最小表以满足链接。
emit_c_atom_table fn() -> void {
    var cnt: i64 = g_atom_cnt;
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "TStr t_atom_table[] = { TSTR_LIT(\"\")");
    var i: i64 = 0;
    while (i < cnt) {
        sb_append_str(sb, ", TSTR_LIT(\"");
        sb_append_str(sb, esc_c(g_atom_names[i]));
        sb_append_str(sb, "\")");
        i = i + 1;
    }
    sb_append_str(sb, " };");
    spush(sb_to_str(sb));
    var sb2: StringBuilder = sb_new();
    sb_append_str(sb2, "int64_t t_atom_count = ");
    sb_append_i64(sb2, cnt + 1);
    sb_append_str(sb2, ";");
    spush(sb_to_str(sb2));
}

emit_unit fn(mod: string) -> void {
    var guard: string = sb_cat3("TC_", to_upper(mod), "_H");
    hpush(sb_cat2("#ifndef ", guard));
    hpush(sb_cat2("#define ", guard));
    hpush("");
    hpush("#include <stdint.h>");
    hpush("#include <stdbool.h>");
    hpush("#include <stddef.h>");
    hpush("#include \"t_runtime.h\"");
    hpush("");
    // type_info(T) 常量结构（M36）：TTypeInfo/TFieldInfo 由 t_runtime.h 提供，
    // 此处不再重复 typedef（否则与 t_runtime.h 重定义冲突）。

    spush(sb_cat3("#include \"", mod, ".h\""));
    spush("#include <stdio.h>");
    spush("#include <stdlib.h>");
    spush("#include <string.h>");
    spush("#include \"t_runtime.h\"");
    spush("");

    build_type_map();

    // 先按字段依赖拓扑排序，发射所有 struct/union/variant 族类型的完整定义。
    // 这保证被值内嵌的类型（如 entry 的 NpcState 内嵌 physics 的 Velocity）在引用
    // 之前已完整定义，消解跨模块 / 前向引用导致的 C 编译错误。
    emit_struct_families_ordered();

    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = decl_list[i];
        var k: string = nodes[d].kind;
        // 已在上方按拓扑序发射，主循环跳过，避免重复定义。
        if (k == "StructDecl" || k == "UnionDecl" || k == "VariantDecl") {
            if (str_in_slice(g_emitted_structs, nodes[d].sa)) {
                i = i + 1;
                continue;
            }
        }
        emit_decl(decl_list[i]);
        i = i + 1;
    }

    emit_c_atom_table();

    // type_info(T) 编译期常量（引用 StructDecl，须在类型定义后输出）
    var tln: i64 = slice_len(ti_lines) as i64;
    if (tln > 0) {
        spush("");
        var ti: i64 = 0;
        while (ti < tln) {
            spush(ti_lines[ti]);
            ti = ti + 1;
        }
    }

    // 全局 var 的运行期初始化器（非编译期常量）汇总为 t__ginit，在 main 开头调用
    var gn: i64 = slice_len(glines) as i64;
    if (gn > 0) {
        spush("");
        spush("static void t__ginit(void) {");
        var gi: i64 = 0;
        while (gi < gn) {
            spush(glines[gi]);
            gi = gi + 1;
        }
        spush("}");
    }

    if (em_has_main) {
        spush("");
        spush("int main(int argc, char** argv) {");
        spush("    t_runtime_init(argc, argv);");
        spush("    t_runtime_set_arena(t_arena_new());");
        if (gn > 0) {
            spush("    t__ginit();");
        }
        spush(sb_cat3("    int32_t _exit_code = ", em_main_fn, "();"));
        spush("    t_runtime_done();");
        spush("    return (int)_exit_code;");
        spush("}");
        spush("");
    }

    emit_flag_macros();

    // 函数值闭包须在全部函数原型之后落地（trampoline 要调用它们）
    emit_c_closures();

    hpush("");
    hpush(sb_cat2("#endif // ", guard));
}

// ── 输出行拼接（join("\n")，无末尾换行）────────────────────────

h_join fn() -> string {
    var sb: StringBuilder = sb_new();
    var n: i64 = slice_len(hlines) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (i > 0) {
            sb_append_str(sb, "\n");
        }
        sb_append_str(sb, hlines[i]);
        i = i + 1;
    }
    return sb_to_str(sb);
}

s_join fn() -> string {
    var sb: StringBuilder = sb_new();
    var n: i64 = slice_len(slines) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (i > 0) {
            sb_append_str(sb, "\n");
        }
        sb_append_str(sb, slines[i]);
        i = i + 1;
    }
    return sb_to_str(sb);
}

// ═══════════════════════════════════════════════════════════════
// M13: LLVM IR Emitter — .tc 直出 .ll，配合 clang 一步到可执行程序
//
// 值模型：
//   * 标量表达式 → SSA 值（bool 统一 i8，仅分支处转 i1）
//   * 聚合表达式（string/slice/struct/variant/union）→ 指向存储的 ptr
//   * 全部 alloca 集中在函数 entry 块（循环内不增长栈）
//   * 与 C runtime 的交互统一经 t_shim_ll.c 的 tll_* 指针化桥接；
//     模块内 t 函数间聚合按值传递（同模块 lowering 一致，无 ABI 风险）
// ═══════════════════════════════════════════════════════════════

var ll_head: []string;    // 模块头：类型定义 + declare
var ll_glob: []string;    // 字符串常量 + 全局变量定义
var ll_body: []string;    // 函数定义
var ll_fal: []string;     // 当前函数 entry 块 alloca 行
var ll_fb: []string;      // 当前函数体指令行
var g_defer_ll: [1024]i64; // defer 延迟栈（LLVM 后端），与 g_defer 同源语义
var g_defer_ll_n: i64 = 0; // g_defer_ll 栈顶计数
var ll_tmpc: i64;         // SSA 临时值计数（每函数重置）
var ll_lblc: i64;         // 标签计数（每函数重置）
var ll_scc: i64;          // scratch alloca 计数（每函数重置）
var ll_strc: i64;         // 字符串常量计数（模块级）
var ll_term: bool;        // 当前块是否已被终结指令封口
var ll_cur_blk: string;   // 当前基本块标签（phi 前驱用）
var ll_cur_ret: i64;      // 当前函数返回类型 td
var ll_has_main: bool;
var ll_main_fn: string;
var ll_last_sref: string; // 最近一次字符串常量的 @.sN 引用
var ll_last_slen: i64;

llph fn(s: string) -> void { append(ll_head, s); }
llpg fn(s: string) -> void { append(ll_glob, s); }
llpb fn(s: string) -> void { append(ll_body, s); }
llfa fn(s: string) -> void { append(ll_fal, s); }
llfb fn(s: string) -> void { append(ll_fb, s); }

// ── 具名类型注册表 ─────────────────────────────────────────────

var llt_names: []string;
var llt_kinds: []string;   // struct | enum | flag | variant | union | alias
var llt_unders: []string;  // enum/flag 底层标量名
var llt_atd: []i64;        // alias 目标 td（其余 -1）

var llsf_st: []string;     // struct 字段：名/字段/序号/td
var llsf_fld: []string;
var llsf_idx: []i64;
var llsf_td: []i64;
var llsf_tag: []i64;       // 字段 tagID（@N 显式 / 全显式时自动分配；解析后 ≥1）

var llec_e: []string;      // enum 常量：类型名/成员名/值
var llec_m: []string;
var llec_v: []i64;

var llfl_f: []string;      // flag 槽位：类型名/槽名/start/len
var llfl_s: []string;
var llfl_start: []i64;
var llfl_len: []i64;

var llv_v: []string;       // variant case：类型名/case 名/tag/载荷 td(-1 无)
var llv_c: []string;
var llv_tag: []i64;
var llv_ptd: []i64;

var llu_u: []string;       // union 成员：类型名/成员名/td
var llu_m: []string;
var llu_td: []i64;

var llfn_n: []string;      // 函数签名：名/返回 td/参数池起点/参数数/extern
var llfn_r: []i64;
var llfn_ps: []i64;
var llfn_pc: []i64;
var llfn_x: []bool;
var llfp_td: []i64;        // 参数 td 扁平池

var llgv_n: []string;      // 全局 var：名/td/init 节点(-1 无)
var llgv_td: []i64;
var llgv_init: []i64;

var llcn_n: []string;      // 全局 const：名/表达式节点（使用处内联展开）
var llcn_e: []i64;

var lla_n: []string;       // 当前函数已 alloca 的名字（去重）
var llbrk: []string;       // break/continue 目标栈（top = ll_loopd-1）
var llcnt: []string;
var ll_loopd: i64;

llt_find fn(name: string) -> i64 {
    var n: i64 = slice_len(llt_names) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (llt_names[i] == name) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

llsf_find fn(st: string, f: string) -> i64 {
    var n: i64 = slice_len(llsf_st) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (llsf_st[i] == st && llsf_fld[i] == f) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

llec_find fn(e: string, m: string) -> i64 {
    var n: i64 = slice_len(llec_e) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (llec_e[i] == e && llec_m[i] == m) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

llfl_find fn(f: string, s: string) -> i64 {
    var n: i64 = slice_len(llfl_f) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (llfl_f[i] == f && llfl_s[i] == s) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

llfn_find fn(name: string) -> i64 {
    var n: i64 = slice_len(llfn_n) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (llfn_n[i] == name) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

llgv_find fn(name: string) -> i64 {
    var n: i64 = slice_len(llgv_n) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (llgv_n[i] == name) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

llcn_find fn(name: string) -> i64 {
    var n: i64 = slice_len(llcn_n) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (llcn_n[i] == name) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

lla_has fn(name: string) -> bool {
    var n: i64 = slice_len(lla_n) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (lla_n[i] == name) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// variant 辅助函数名匹配：Name_from_Case / Name_is_Case / Name_as_Case
// 命中后设置 ll_vm_kind ("from"/"is"/"as") 与池下标 ll_vm_i
var ll_vm_kind: string;
var ll_vm_i: i64;

llv_match fn(cn: string) -> bool {
    ll_vm_kind = "";
    ll_vm_i = -1;
    var n: i64 = slice_len(llv_v) as i64;
    var i: i64 = 0;
    while (i < n) {
        var f1: string = sb_cat4(llv_v[i], "_from_", llv_c[i], "");
        if (cn == f1) {
            ll_vm_kind = "from";
            ll_vm_i = i;
            return true;
        }
        var f2: string = sb_cat4(llv_v[i], "_is_", llv_c[i], "");
        if (cn == f2) {
            ll_vm_kind = "is";
            ll_vm_i = i;
            return true;
        }
        var f3: string = sb_cat4(llv_v[i], "_as_", llv_c[i], "");
        if (cn == f3) {
            ll_vm_kind = "as";
            ll_vm_i = i;
            return true;
        }
        i = i + 1;
    }
    return false;
}

// ── 标量 → LLVM 类型 ───────────────────────────────────────────

// >>> GEN:scalar_llmap (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
scalar_to_ll fn(name: string) -> string {
    if (name == "u8" || name == "i8" || name == "bool") { return "i8"; }
    if (name == "u16" || name == "i16") { return "i16"; }
    if (name == "u32" || name == "i32") { return "i32"; }
    if (name == "f32") { return "float"; }
    if (name == "f64") { return "double"; }
    return "i64";
}

ll_bits fn(name: string) -> i64 {
    if (name == "u8" || name == "i8" || name == "bool") { return 8; }
    if (name == "u16" || name == "i16") { return 16; }
    if (name == "u32" || name == "i32" || name == "f32") { return 32; }
    return 64;
}
// <<< GEN:scalar_llmap <<<

ll_signed fn(name: string) -> bool {
    if (str_len(name) == 0) {
        return false;
    }
    return name[0] == 105 || name[0] == 102;
}

ll_isf fn(name: string) -> bool {
    return name == "f32" || name == "f64";
}

// ── td → LLVM 类型 ─────────────────────────────────────────────

ll_named fn(name: string) -> string {
    if (name == "TSb*") { return "ptr"; }
    var i: i64 = llt_find(name);
    if (i < 0) {
        return "i64";
    }
    var k: string = llt_kinds[i];
    if (k == "struct") { return sb_cat2("%st.", name); }
    if (k == "variant") { return sb_cat2("%vt.", name); }
    if (k == "union") { return sb_cat2("%un.", name); }
    if (k == "enum" || k == "flag") { return scalar_to_ll(llt_unders[i]); }
    if (k == "alias") { return ll_td(llt_atd[i]); }
    return "i64";
}

ll_td fn(td: i64) -> string {
    if (td < 0) {
        return "i64";
    }
    var t: TD = tds[td];
    if (t.cat == "string") { return "%TStr"; }
    if (t.cat == "slice") { return "%TSlice"; }
    if (t.cat == "array") {
        var an: i64 = t.alen;
        if (an < 0) {
            an = 0;
        }
        return sb_cat5("[", i2s(an), " x ", ll_td(t.elem), "]");
    }
    if (t.cat == "map") { return "ptr"; }
    if (t.cat == "sym") {
        if (t.alen == 16) { return "i16"; }
        return "i32";
    }
    if (t.cat == "typeinfo" || t.cat == "fieldinfo") { return "ptr"; }
    // 函数类型在 LLVM 里就是不透明指针（opaque pointer），签名信息在调用点重建
    if (t.cat == "func") { return "ptr"; }
    if (t.cat == "void") { return "void"; }
    if (t.cat == "scalar") {
        if (t.name == "") {
            return "i64";
        }
        return scalar_to_ll(t.name);
    }
    if (t.cat == "named") {
        if (t.name == "") {
            return "ptr";
        }
        return ll_named(t.name);
    }
    return "i64";
}

// td 是否聚合（值模型走 ptr）
ll_isagg fn(td: i64) -> bool {
    if (td < 0) {
        return false;
    }
    var t: TD = tds[td];
    if (t.cat == "string" || t.cat == "slice" || t.cat == "array") {
        return true;
    }
    if (t.cat == "named") {
        if (t.name == "TSb*") {
            return false;
        }
        var i: i64 = llt_find(t.name);
        if (i < 0) {
            return false;
        }
        var k: string = llt_kinds[i];
        if (k == "struct" || k == "variant" || k == "union") {
            return true;
        }
        if (k == "alias") {
            return ll_isagg(llt_atd[i]);
        }
        return false;
    }
    return false;
}

// td 的标量名（"" = 非标量）；enum/flag/alias 归一到底层标量
td_sname fn(td: i64) -> string {
    if (td < 0) {
        return "i64";
    }
    var t: TD = tds[td];
    if (t.cat == "scalar") {
        if (t.name == "") {
            return "i64";
        }
        return t.name;
    }
    // Sym 底层是无符号 id：Sym16→u16、Sym32→u32（供比较/运算取正确 LLVM 位宽）
    if (t.cat == "sym") {
        if (t.alen == 16) { return "u16"; }
        return "u32";
    }
    if (t.cat == "unknown") {
        return "i64";
    }
    if (t.cat == "named") {
        var i: i64 = llt_find(t.name);
        if (i < 0) {
            return "";
        }
        var k: string = llt_kinds[i];
        if (k == "enum" || k == "flag") {
            return llt_unders[i];
        }
        if (k == "alias") {
            return td_sname(llt_atd[i]);
        }
        return "";
    }
    return "";
}

ll_sizeof fn(ty: string) -> string {
    return sb_cat3("ptrtoint (ptr getelementptr (", ty, ", ptr null, i32 1) to i64)");
}

ll_zero fn(ty: string) -> string {
    if (str_len(ty) > 0) {
        // 37 = '%'（具名聚合），91 = '['（定长数组 [N x T]）
        if (ty[0] == 37 || ty[0] == 91) {
            return "zeroinitializer";
        }
    }
    if (ty == "float" || ty == "double") {
        return "0.0";
    }
    if (ty == "ptr") {
        return "null";
    }
    return "0";
}

// ── 字符串常量 ─────────────────────────────────────────────────

esc_ll fn(s: string) -> string {
    var sb: StringBuilder = sb_new();
    var i: u64 = 0;
    var n: u64 = str_len(s);
    while (i < n) {
        var c: u8 = s[i];
        if (c >= 32 && c <= 126 && c != 34 && c != 92) {
            sb_append_char(sb, c);
        } else {
            sb_append_char(sb, 92);
            sb_append_char(sb, hex_digit(c / 16));
            sb_append_char(sb, hex_digit(c % 16));
        }
        i = i + 1;
    }
    return sb_to_str(sb);
}

// 生成字符串常量对（[N x i8] + %TStr），返回 "@.tsN"（聚合 ptr 值）
ll_strlit fn(s: string) -> string {
    var idx: i64 = ll_strc;
    ll_strc = ll_strc + 1;
    var sn: string = sb_cat2("@.s", i2s(idx));
    var tn: string = sb_cat2("@.ts", i2s(idx));
    var L: i64 = str_len(s) as i64;
    if (L == 0) {
        llpg(sb_cat2(sn, " = private unnamed_addr constant [1 x i8] zeroinitializer"));
    } else {
        var line: StringBuilder = sb_new();
        sb_append_str(line, sn);
        sb_append_str(line, " = private unnamed_addr constant [");
        sb_append_i64(line, L);
        sb_append_str(line, " x i8] c\"");
        sb_append_str(line, esc_ll(s));
        sb_append_str(line, "\"");
        llpg(sb_to_str(line));
    }
    var l2: StringBuilder = sb_new();
    sb_append_str(l2, tn);
    sb_append_str(l2, " = private unnamed_addr constant %TStr { ptr ");
    sb_append_str(l2, sn);
    sb_append_str(l2, ", i64 ");
    sb_append_i64(l2, L);
    sb_append_str(l2, " }");
    llpg(sb_to_str(l2));
    ll_last_sref = sn;
    ll_last_slen = L;
    return tn;
}

// ── 临时值 / 标签 / scratch ────────────────────────────────────

ll_tmp fn() -> string {
    var v: i64 = ll_tmpc;
    ll_tmpc = v + 1;
    return sb_cat2("%t", i2s(v));
}

ll_lbl fn(p: string) -> string {
    var v: i64 = ll_lblc;
    ll_lblc = v + 1;
    return sb_cat2(p, i2s(v));
}

ll_label fn(name: string) -> void {
    llfb(sb_cat2(name, ":"));
    ll_cur_blk = name;
    ll_term = false;
}

ll_open fn() -> void {
    if (ll_term) {
        var L: string = ll_lbl("dead");
        ll_label(L);
    }
}

// 每个调用点一个 scratch alloca（置于 entry，循环安全）
ll_scratch fn(ty: string) -> string {
    var v: i64 = ll_scc;
    ll_scc = v + 1;
    var name: string = sb_cat2("%s", i2s(v));
    llfa(sb_cat4("  ", name, " = alloca ", ty));
    return name;
}

// ── 注册表构建 ─────────────────────────────────────────────────

ll_build_reg fn() -> void {
    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = decl_list[i];
        var dn: Node = nodes[d];
        if (dn.kind == "StructDecl") {
            append(llt_names, dn.sa);
            append(llt_kinds, "struct");
            append(llt_unders, "");
            var neg1: i64 = -1;
            append(llt_atd, neg1);
            var fi: i64 = 0;
            var c: i64 = dn.lb;
            while (c >= 0) {
                var k: Child = kids[c];
                var f: Node = nodes[k.val];
                if (f.ia < 0) {
                    append(llsf_st, dn.sa);
                    append(llsf_fld, f.sa);
                    append(llsf_idx, fi);
                    var ftd: i64 = resolve_type_desc(f.na);
                    append(llsf_td, ftd);
                    append(llsf_tag, f.ib);   // 解析后的 tagID（全显式或全自动均已分配）
                    fi = fi + 1;
                }
                c = k.next;
            }
        }
        if (dn.kind == "EnumDecl") {
            append(llt_names, dn.sa);
            append(llt_kinds, "enum");
            append(llt_unders, dn.sb);
            var neg2: i64 = -1;
            append(llt_atd, neg2);
            var auto_val: i64 = 0;
            var c2: i64 = dn.lb;
            while (c2 >= 0) {
                var k2: Child = kids[c2];
                var v: Node = nodes[k2.val];
                if (v.na >= 0) {
                    var vn: Node = nodes[v.na];
                    if (vn.kind == "int") {
                        var r: i64 = vn.ia;
                        if (r < 2) {
                            r = 10;
                        }
                        var pv: i64 = js_parse_int(vn.sa, r);
                        append(llec_e, dn.sa);
                        append(llec_m, v.sa);
                        append(llec_v, pv);
                        auto_val = pv + 1;
                    }
                } else {
                    append(llec_e, dn.sa);
                    append(llec_m, v.sa);
                    append(llec_v, auto_val);
                    auto_val = auto_val + 1;
                }
                c2 = k2.next;
            }
        }
        if (dn.kind == "FlagDecl") {
            append(llt_names, dn.sa);
            append(llt_kinds, "flag");
            append(llt_unders, dn.sb);
            var neg3: i64 = -1;
            append(llt_atd, neg3);
            var auto_off: i64 = 0;
            var c3: i64 = dn.lb;
            while (c3 >= 0) {
                var k3: Child = kids[c3];
                var sl: Node = nodes[k3.val];
                var start: i64 = auto_off;
                if (sl.bb) {
                    start = sl.ib;
                }
                append(llfl_f, dn.sa);
                append(llfl_s, sl.sa);
                append(llfl_start, start);
                append(llfl_len, sl.ia);
                auto_off = start + sl.ia;
                c3 = k3.next;
            }
        }
        if (dn.kind == "VariantDecl") {
            append(llt_names, dn.sa);
            append(llt_kinds, "variant");
            append(llt_unders, "");
            var neg4: i64 = -1;
            append(llt_atd, neg4);
            var c4: i64 = dn.lb;
            while (c4 >= 0) {
                var k4: Child = kids[c4];
                var vc: Node = nodes[k4.val];
                append(llv_v, dn.sa);
                append(llv_c, vc.sa);
                append(llv_tag, vc.ia);
                var ptd: i64 = -1;
                if (vc.na >= 0) {
                    ptd = resolve_type_desc(vc.na);
                }
                append(llv_ptd, ptd);
                c4 = k4.next;
            }
        }
        if (dn.kind == "UnionDecl") {
            append(llt_names, dn.sa);
            append(llt_kinds, "union");
            append(llt_unders, "");
            var neg5: i64 = -1;
            append(llt_atd, neg5);
            var c5: i64 = dn.lb;
            while (c5 >= 0) {
                var k5: Child = kids[c5];
                var m: Node = nodes[k5.val];
                append(llu_u, dn.sa);
                append(llu_m, m.sa);
                var mtd: i64 = resolve_type_desc(m.na);
                append(llu_td, mtd);
                c5 = k5.next;
            }
        }
        if (dn.kind == "TypeAliasDecl") {
            append(llt_names, dn.sa);
            append(llt_kinds, "alias");
            append(llt_unders, "");
            var atd: i64 = resolve_type_desc(dn.na);
            append(llt_atd, atd);
        }
        if (dn.kind == "FuncDecl") {
            append(llfn_n, dn.sa);
            var rtd: i64 = resolve_type_desc(dn.na);
            append(llfn_r, rtd);
            var ps: i64 = slice_len(llfp_td) as i64;
            append(llfn_ps, ps);
            var pc: i64 = 0;
            var c6: i64 = dn.lb;
            while (c6 >= 0) {
                var k6: Child = kids[c6];
                var p: Node = nodes[k6.val];
                var ptd2: i64 = resolve_type_desc(p.na);
                append(llfp_td, ptd2);
                pc = pc + 1;
                c6 = k6.next;
            }
            append(llfn_pc, pc);
            append(llfn_x, dn.ba);
        }
        if (dn.kind == "GlobalVarDecl") {
            append(llgv_n, dn.sa);
            var gtd: i64 = resolve_type_desc(dn.na);
            append(llgv_td, gtd);
            append(llgv_init, dn.nb);
        }
        if (dn.kind == "GlobalConstDecl") {
            append(llcn_n, dn.sa);
            append(llcn_e, dn.nb);
        }
        i = i + 1;
    }
}

// ── 表达式类型（expr_type_desc 的 LLVM 补丁包装）───────────────

ll_etd fn(e: i64) -> i64 {
    if (e < 0) {
        return td_mk("unknown");
    }
    var n: Node = nodes[e];
    if (n.kind == "unary") {
        if (n.sa == "!") {
            return td_named_mk("scalar", "bool");
        }
        return ll_etd(n.na);
    }
    if (n.kind == "struct_lit") {
        return td_named_mk("named", n.sa);
    }
    if (n.kind == "member") {
        var ob: Node = nodes[n.na];
        if (ob.kind == "ident") {
            var ti: i64 = llt_find(ob.sa);
            if (ti >= 0) {
                if (llt_kinds[ti] == "enum") {
                    return td_named_mk("scalar", llt_unders[ti]);
                }
            }
        }
        var od: i64 = expr_type_desc(e);
        var ot: TD = tds[od];
        if (ot.cat != "unknown") {
            return od;
        }
        // union 成员
        var obd: i64 = ll_etd(n.na);
        var obt: TD = tds[obd];
        if (obt.cat == "named") {
            var ui: i64 = llt_find(obt.name);
            if (ui >= 0) {
                if (llt_kinds[ui] == "union") {
                    var un: i64 = slice_len(llu_u) as i64;
                    var uj: i64 = 0;
                    while (uj < un) {
                        if (llu_u[uj] == obt.name && llu_m[uj] == n.sa) {
                            return llu_td[uj];
                        }
                        uj = uj + 1;
                    }
                }
            }
        }
        return od;
    }
    if (n.kind == "paren") {
        return ll_etd(n.na);
    }
    if (n.kind == "binary") {
        var bop9: string = n.sa;
        if (bop9 == "==" || bop9 == "!=" || bop9 == "<" || bop9 == ">") {
            return td_named_mk("scalar", "bool");
        }
        if (bop9 == "<=" || bop9 == ">=" || bop9 == "&&" || bop9 == "||") {
            return td_named_mk("scalar", "bool");
        }
        return ll_bin_td(e);
    }
    if (n.kind == "call") {
        var cal: Node = nodes[n.na];
        if (cal.kind == "ident") {
            var cn: string = cal.sa;
            if (cn == "flag_get") {
                return td_named_mk("scalar", "u32");
            }
            if (cn == "sys_run") {
                return td_named_mk("scalar", "i32");
            }
            if (llv_match(cn)) {
                if (ll_vm_kind == "from") {
                    return td_named_mk("named", llv_v[ll_vm_i]);
                }
                if (ll_vm_kind == "is") {
                    return td_named_mk("scalar", "bool");
                }
                return llv_ptd[ll_vm_i];
            }
        }
        return expr_type_desc(e);
    }
    return expr_type_desc(e);
}

// 二元运算的统一操作数类型：字面量让位于有类型的一侧
ll_bin_td fn(e: i64) -> i64 {
    var n: Node = nodes[e];
    var ln: Node = nodes[n.na];
    var rn: Node = nodes[n.nb];
    var llit: bool = ln.kind == "int" || ln.kind == "float";
    var rlit: bool = rn.kind == "int" || rn.kind == "float";
    if (llit && rlit == false) {
        return ll_etd(n.nb);
    }
    return ll_etd(n.na);
}

// ── 数值转换 ───────────────────────────────────────────────────

ll_cast_v fn(v: string, ftd: i64, ttd: i64) -> string {
    var fs: string = td_sname(ftd);
    var ts: string = td_sname(ttd);
    if (fs == "" || ts == "") {
        return v;
    }
    if (str_len(v) == 0) {
        return v;
    }
    if (v[0] != 37) {
        return v;    // 常量文本随目标类型自适应
    }
    var fb2: i64 = ll_bits(fs);
    var tb: i64 = ll_bits(ts);
    var ff: bool = ll_isf(fs);
    var tf: bool = ll_isf(ts);
    var fty: string = scalar_to_ll(fs);
    var tty: string = scalar_to_ll(ts);
    if (ff && tf) {
        if (fb2 == tb) {
            return v;
        }
        var t1: string = ll_tmp();
        if (fb2 < tb) {
            llfb(sb_cat6("  ", t1, " = fpext ", fty, " ", sb_cat4(v, " to ", tty, "")));
        } else {
            llfb(sb_cat6("  ", t1, " = fptrunc ", fty, " ", sb_cat4(v, " to ", tty, "")));
        }
        return t1;
    }
    if (ff && tf == false) {
        var t2: string = ll_tmp();
        if (ll_signed(ts)) {
            llfb(sb_cat6("  ", t2, " = fptosi ", fty, " ", sb_cat4(v, " to ", tty, "")));
        } else {
            llfb(sb_cat6("  ", t2, " = fptoui ", fty, " ", sb_cat4(v, " to ", tty, "")));
        }
        return t2;
    }
    if (ff == false && tf) {
        var t3: string = ll_tmp();
        if (ll_signed(fs)) {
            llfb(sb_cat6("  ", t3, " = sitofp ", fty, " ", sb_cat4(v, " to ", tty, "")));
        } else {
            llfb(sb_cat6("  ", t3, " = uitofp ", fty, " ", sb_cat4(v, " to ", tty, "")));
        }
        return t3;
    }
    if (ts == "bool") {
        if (fs == "bool") {
            return v;
        }
        var t4: string = ll_tmp();
        llfb(sb_cat6("  ", t4, " = icmp ne ", fty, " ", sb_cat3(v, ", ", "0")));
        var t5: string = ll_tmp();
        llfb(sb_cat6("  ", t5, " = zext i1 ", t4, " to i8", ""));
        return t5;
    }
    if (fb2 == tb) {
        return v;
    }
    var t6: string = ll_tmp();
    if (fb2 < tb) {
        if (ll_signed(fs)) {
            llfb(sb_cat6("  ", t6, " = sext ", fty, " ", sb_cat4(v, " to ", tty, "")));
        } else {
            llfb(sb_cat6("  ", t6, " = zext ", fty, " ", sb_cat4(v, " to ", tty, "")));
        }
    } else {
        llfb(sb_cat6("  ", t6, " = trunc ", fty, " ", sb_cat4(v, " to ", tty, "")));
    }
    return t6;
}

// i8 bool 值 → i1（分支条件）
ll_to_i1 fn(v: string) -> string {
    if (v == "1") {
        return "true";
    }
    if (v == "0") {
        return "false";
    }
    var t: string = ll_tmp();
    llfb(sb_cat4("  ", t, " = icmp ne i8 ", sb_cat2(v, ", 0")));
    return t;
}

// i1 → i8
ll_b8 fn(v1: string) -> string {
    var t: string = ll_tmp();
    llfb(sb_cat4("  ", t, " = zext i1 ", sb_cat2(v1, " to i8")));
    return t;
}

// 从 ptr 装载
ll_load fn(ty: string, p: string) -> string {
    var t: string = ll_tmp();
    llfb(sb_cat6("  ", t, " = load ", ty, ", ptr ", p));
    return t;
}

// 聚合复制：src ptr → dst ptr（load/store 按值搬运）
ll_copy fn(ty: string, src: string, dst: string) -> void {
    var t: string = ll_load(ty, src);
    llfb(sb_cat6("  store ", ty, " ", t, ", ptr ", dst));
}

// ── 左值地址 ───────────────────────────────────────────────────

ll_addr fn(e: i64) -> string {
    var n: Node = nodes[e];
    if (n.kind == "paren") {
        return ll_addr(n.na);
    }
    if (n.kind == "ident") {
        var la_idn: string = mb_sub(n.sa);
        if (em_in_fn) {
            var f: i64 = fs_get(em_cur_fn, la_idn);
            if (f >= 0) {
                return sb_cat2("%v.", la_idn);
            }
        }
        var g: i64 = llgv_find(la_idn);
        if (g >= 0) {
            return sb_cat2("@", la_idn);
        }
        return "null";
    }
    if (n.kind == "member") {
        var obd: i64 = ll_etd(n.na);
        var obt: TD = tds[obd];
        var op: string = emit_lle(n.na);
        if (obt.cat == "named") {
            var ti: i64 = llt_find(obt.name);
            if (ti >= 0) {
                if (llt_kinds[ti] == "struct") {
                    var fi: i64 = llsf_find(obt.name, n.sa);
                    if (fi >= 0) {
                        var t: string = ll_tmp();
                        var line: StringBuilder = sb_new();
                        sb_append_str(line, "  ");
                        sb_append_str(line, t);
                        sb_append_str(line, " = getelementptr inbounds %st.");
                        sb_append_str(line, obt.name);
                        sb_append_str(line, ", ptr ");
                        sb_append_str(line, op);
                        sb_append_str(line, ", i32 0, i32 ");
                        sb_append_i64(line, llsf_idx[fi]);
                        llfb(sb_to_str(line));
                        return t;
                    }
                }
                if (llt_kinds[ti] == "union") {
                    return op;    // 所有成员共址 offset 0
                }
            }
        }
        return "null";
    }
    if (n.kind == "index") {
        var od: i64 = ll_etd(n.na);
        var ot: TD = tds[od];
        if (ot.cat == "slice") {
            var sp: string = emit_lle(n.na);
            var iv: string = emit_lle(n.nb);
            var t2: string = ll_tmp();
            llfb(sb_cat6("  ", t2, " = call ptr @tll_slice_at(ptr ", sp, ", i64 ", sb_cat2(iv, ")")));
            return t2;
        }
        if (ot.cat == "array") {
            var ap: string = ll_addr(n.na);
            var av2: string = ll_widen_idx(emit_lle(n.nb), n.nb);
            var t7: string = ll_tmp();
            var gsb: StringBuilder = sb_new();
            sb_append_str(gsb, "  ");
            sb_append_str(gsb, t7);
            sb_append_str(gsb, " = getelementptr ");
            sb_append_str(gsb, ll_td(od));
            sb_append_str(gsb, ", ptr ");
            sb_append_str(gsb, ap);
            sb_append_str(gsb, ", i64 0, i64 ");
            sb_append_str(gsb, av2);
            llfb(sb_to_str(gsb));
            return t7;
        }
        return "null";
    }
    return "null";
}

// ── 表达式发射 ─────────────────────────────────────────────────

emit_lle fn(e: i64) -> string {
    if (e < 0) {
        return "0";
    }
    var n: Node = nodes[e];

    if (n.kind == "int") {
        var r: i64 = n.ia;
        if (r < 2) {
            r = 10;
        }
        return i2s(js_parse_int(n.sa, r));
    }
    if (n.kind == "atom") {
        if (n.ia <= 0) { n.ia = atom_intern(n.sa); slice_set(nodes, e, n); }
        return i2s(n.ia);
    }
    // 内建 fid 常量（M51）：编译期常量 0/1/2
    if (n.kind == "fidconst") {
        return i2s(n.ia);
    }
    // 序列化操作符（M51）：@tll_ser_* 返回目标 fid（i64），链式即嵌套求值
    if (n.kind == "serialize") {
        var lsf: string = emit_lle(n.na);
        var lstd: i64 = ll_etd(n.nb);
        var lssel: string = ser_sel(lstd);
        var lst: string = ll_tmp();
        if (lssel == "str") {
            var lsp: string = emit_lle(n.nb);
            llfb(sb_cat6("  ", lst, " = call i64 @tll_ser_str(i64 ", lsf,
                sb_cat3(", ptr ", lsp, ")"), ""));
            return lst;
        }
        if (lssel == "atom") {
            var lsa: string = emit_lle(n.nb);
            llfb(sb_cat6("  ", lst, " = call i64 @tll_ser_atom(i64 ", lsf,
                sb_cat3(", i64 ", lsa, ")"), ""));
            return lst;
        }
        if (lssel == "bool") {
            var lsb2: string = emit_lle(n.nb);
            llfb(sb_cat6("  ", lst, " = call i64 @tll_ser_bool(i64 ", lsf,
                sb_cat3(", i8 ", lsb2, ")"), ""));
            return lst;
        }
        var lsbits: string = i2s(ll_bits(td_sname(lstd)));
        if (lssel == "f") {
            var lsfv: string = ll_cast_v(emit_lle(n.nb), lstd, td_named_mk("scalar", "f64"));
            llfb(sb_cat6("  ", lst, " = call i64 @tll_ser_f64(i64 ", lsf,
                sb_cat3(", double ", lsfv, ", i32 "), sb_cat2(lsbits, ")")));
            return lst;
        }
        var lsiv: string = ll_cast_v(emit_lle(n.nb), lstd, td_named_mk("scalar", "i64"));
        var lssgn: string = "0";
        if (ll_signed(td_sname(lstd))) { lssgn = "1"; }
        llfb(sb_cat6("  ", lst, " = call i64 @tll_ser_int(i64 ", lsf,
            sb_cat3(", i64 ", lsiv, ", i32 "),
            sb_cat4(lsbits, ", i32 ", lssgn, ")")));
        return lst;
    }
    // 反序列化（M52 读路径，Option B）：tll_deser_* 返回裸 T 值；string 走 sret（ptr out）
    if (n.kind == "deserialize") {
        var ldf: string = emit_lle(n.na);
        var ldtd: i64 = deser_type_of(n.nb);
        var ldsel: string = ser_sel(ldtd);
        if (ldsel == "str") {
            var lout: string = ll_scratch("%TStr");
            llfb(sb_cat5("  call void @tll_deser_str(i64 ", ldf, ", ptr ", lout, ")"));
            return lout;
        }
        if (ldsel == "atom") {
            var lat: string = ll_tmp();
            llfb(sb_cat4("  ", lat, " = call i64 @tll_deser_atom(i64 ", sb_cat2(ldf, ")")));
            return lat;
        }
        if (ldsel == "bool") {
            var lbt: string = ll_tmp();
            llfb(sb_cat4("  ", lbt, " = call i8 @tll_deser_bool(i64 ", sb_cat2(ldf, ")")));
            return lbt;
        }
        // 运行时桥接统一以最宽标量返回（double / i64）—— 目标窄于它时必须显式收窄，
        // 否则 `store i64 ... , ptr %v.b`（b: i8）是非法 IR。C 后端靠隐式转换，LLVM 不会。
        if (ldsel == "f") {
            var ldft: string = ll_tmp();
            var ldbits: string = i2s(get_bw(td_sname(ldtd)));
            llfb(sb_cat6("  ", ldft, " = call double @tll_deser_f64(i64 ", ldf,
                ", i32 ", sb_cat2(ldbits, ")")));
            return ll_cast_v(ldft, td_named_mk("scalar", "f64"), ldtd);
        }
        var lint: string = ll_tmp();
        var lbits2: string = i2s(get_bw(td_sname(ldtd)));
        var lsgn2: string = "0";
        if (ll_signed(td_sname(ldtd))) { lsgn2 = "1"; }
        llfb(sb_cat6("  ", lint, " = call i64 @tll_deser_int(i64 ", ldf,
            sb_cat3(", i32 ", lbits2, ", i32 "), sb_cat2(lsgn2, ")")));
        return ll_cast_v(lint, td_named_mk("scalar", "i64"), ldtd);
    }
    if (n.kind == "float") {
        // 确保带小数点（LLVM 浮点常量语法）
        var has_dot: bool = false;
        var i: u64 = 0;
        var L: u64 = str_len(n.sa);
        while (i < L) {
            if (n.sa[i] == 46 || n.sa[i] == 101 || n.sa[i] == 69) {
                has_dot = true;
            }
            i = i + 1;
        }
        if (has_dot) {
            return n.sa;
        }
        return sb_cat2(n.sa, ".0");
    }
    if (n.kind == "string") {
        return ll_strlit(n.sa);
    }
    if (n.kind == "typeinfo") {
        return emit_type_info_ll(n.sa);
    }
    if (n.kind == "bool") {
        if (n.ba) {
            return "1";
        }
        return "0";
    }
    if (n.kind == "null") {
        return "null";
    }
    if (n.kind == "ident") {
        var le_idn: string = mb_sub(n.sa);
        if (em_in_fn) {
            var f: i64 = fs_get(em_cur_fn, le_idn);
            if (f >= 0) {
                if (ll_isagg(f)) {
                    return sb_cat2("%v.", le_idn);
                }
                return ll_load(ll_td(f), sb_cat2("%v.", le_idn));
            }
        }
        var g: i64 = llgv_find(le_idn);
        if (g >= 0) {
            var gtd: i64 = llgv_td[g];
            if (ll_isagg(gtd)) {
                return sb_cat2("@", le_idn);
            }
            return ll_load(ll_td(gtd), sb_cat2("@", le_idn));
        }
        var ci: i64 = llcn_find(le_idn);
        if (ci >= 0) {
            return emit_lle(llcn_e[ci]);
        }
        // 顶层具名函数作为**值**：取其闭包全局（FuncType v2 / M47）。函数值统一是
        // 指向 %TClosure { ptr fn; ptr env } 的 ptr，直接取函数地址会让间接调用点
        // 把代码当记录来 GEP。直接调用的 callee 不经此分支（ll_call 按名解析）。
        if (llfn_find(le_idn) >= 0) {
            clos_mark(le_idn);
            return sb_cat2("@t.clos.", le_idn);
        }
        return "0";
    }
    // match 表达式（L-15）：结果槽 alloca + if/else 链，末尾装载结果
    if (n.kind == "match") {
        g_match_cnt = g_match_cnt + 1;
        var mv_no: i64 = g_match_cnt;
        var mv_rn: string = sb_cat2("_tmr", i2s(mv_no));
        var mv_sn: string = sb_cat2("_tms", i2s(mv_no));
        var mv_std: i64 = ll_etd(n.na);
        fs_set(em_cur_fn, mv_sn, mv_std);
        ll_local_decl(mv_sn, mv_std, n.na);
        var mv_pushed: i64 = match_bind_push(e, mv_no);
        var mv_rtd: i64 = ll_etd(match_first_body(e));
        fs_set(em_cur_fn, mv_rn, mv_rtd);
        ll_local_decl(mv_rn, mv_rtd, -1);
        var mv_s: i64 = match_chain_from(n.la, mv_rn, mv_sn);
        while (mv_s >= 0) {
            var mv_sk: Child = kids[mv_s];
            emit_llstmt(mv_sk.val);
            mv_s = mv_sk.next;
        }
        mb_drop(mv_pushed);
        if (ll_isagg(mv_rtd)) {
            return sb_cat2("%v.", mv_rn);
        }
        return ll_load(ll_td(mv_rtd), sb_cat2("%v.", mv_rn));
    }
    // map 字面量作为表达式：就地建表并返回 TMap* 临时量
    if (n.kind == "map_lit") {
        var mlqp: string = ll_tmp();
        var mlqi: i64 = infer_expr(e);
        var mlqt: TI = tis[mlqi];
        ll_build_map_lit(e, mlqp, ti_to_td(mlqt.key), ti_to_td(mlqt.val));
        return mlqp;
    }
    if (n.kind == "paren") {
        return emit_lle(n.na);
    }
    if (n.kind == "binary") {
        return ll_binary(e);
    }
    if (n.kind == "unary") {
        return ll_unary(e);
    }
    if (n.kind == "assign") {
        // m[k] = v : map 索引写须走 tll_map_put（find-or-insert）
        if (n.sa == "=") {
            var ln: Node = nodes[n.na];
            if (ln.kind == "index") {
                var lotd: i64 = ll_etd(ln.na);
                var lott: TD = tds[lotd];
                if (lott.cat == "map") {
                    var mp: string = emit_lle(ln.na);
                    var kp: string = ll_map_keyptr(ln.nb, lott.key);
                    var vp: string = ll_map_argptr(n.nb, lott.val);
                    llfb(sb_cat6("  call void @tll_map_put(ptr ", mp, ", ptr ", kp, ", ptr ", sb_cat2(vp, ")")));
                    return "0";
                }
            }
        }
        // Sym = string : 自动 intern（LHS 存 id）；Sym = Sym（同池）走下面普通 id 拷贝
        if (n.sa == "=") {
            var lsymtd: i64 = ll_etd(n.na);
            if (lsymtd >= 0 && tds[lsymtd].cat == "sym") {
                var rsymtd: i64 = ll_etd(n.nb);
                if (rsymtd >= 0 && tds[rsymtd].cat == "string") {
                    var symv: string = emit_lle(n.nb);                    // ptr → RHS TStr
                    var symtag: string = ll_strlit(tds[lsymtd].name);    // ptr → tag TStr
                    var symbits: string = i2s(tds[lsymtd].alen);
                    var symid: string = ll_tmp();
                    llfb(sb_cat6("  ", symid, " = call i32 @tll_sym_intern(ptr ", symtag, ", ptr ", sb_cat3(symv, ", i64 ", sb_cat2(symbits, ")"))));
                    var symsty: string = ll_td(lsymtd);                  // i32 / i16
                    var symstored: string = symid;
                    if (symsty == "i16") {
                        symstored = ll_tmp();
                        llfb(sb_cat4("  ", symstored, " = trunc i32 ", sb_cat2(symid, " to i16")));
                    }
                    var symad: string = ll_addr(n.na);
                    llfb(sb_cat6("  store ", symsty, " ", symstored, ", ptr ", symad));
                    return symstored;
                }
            }
        }
        var v: string = emit_lle(n.nb);
        var ltd: i64 = ll_etd(n.na);
        var ad: string = ll_addr(n.na);
        if (ll_isagg(ltd)) {
            ll_copy(ll_td(ltd), v, ad);
        } else {
            var cv: string = ll_cast_v(v, ll_etd(n.nb), ltd);
            llfb(sb_cat6("  store ", ll_td(ltd), " ", cv, ", ptr ", ad));
        }
        return v;
    }
    if (n.kind == "call") {
        return ll_call(e);
    }
    if (n.kind == "member") {
        var ob: Node = nodes[n.na];
        if (ob.kind == "ident") {
            var ti: i64 = llt_find(ob.sa);
            if (ti >= 0) {
                if (llt_kinds[ti] == "enum") {
                    var ei: i64 = llec_find(ob.sa, n.sa);
                    if (ei >= 0) {
                        return i2s(llec_v[ei]);
                    }
                    return "0";
                }
            }
        }
        var mtd: i64 = ll_etd(e);
        var p: string = ll_addr(e);
        if (ll_isagg(mtd)) {
            return p;
        }
        return ll_load(ll_td(mtd), p);
    }
    if (n.kind == "index") {
        var od: i64 = ll_etd(n.na);
        var ot: TD = tds[od];
        if (ot.cat == "string") {
            var sp: string = emit_lle(n.na);
            var iv: string = emit_lle(n.nb);
            var iv2: string = ll_widen_idx(iv, n.nb);
            var t: string = ll_tmp();
            llfb(sb_cat6("  ", t, " = call i64 @tll_str_at(ptr ", sp, ", i64 ", sb_cat2(iv2, ")")));
            var t2: string = ll_tmp();
            llfb(sb_cat4("  ", t2, " = trunc i64 ", sb_cat2(t, " to i8")));
            return t2;
        }
        if (ot.cat == "slice") {
            var sp2: string = emit_lle(n.na);
            var iv3: string = emit_lle(n.nb);
            var iv4: string = ll_widen_idx(iv3, n.nb);
            var t3: string = ll_tmp();
            llfb(sb_cat6("  ", t3, " = call ptr @tll_slice_at(ptr ", sp2, ", i64 ", sb_cat2(iv4, ")")));
            if (ot.elem >= 0) {
                if (ll_isagg(ot.elem)) {
                    return t3;
                }
                return ll_load(ll_td(ot.elem), t3);
            }
            return ll_load("i64", t3);
        }
        if (ot.cat == "array") {
            var gp2: string = ll_addr(e);
            if (ot.elem >= 0) {
                if (ll_isagg(ot.elem)) {
                    return gp2;
                }
                return ll_load(ll_td(ot.elem), gp2);
            }
            return ll_load("i64", gp2);
        }
        if (ot.cat == "map") {
            return ll_map_get(n.na, n.nb);
        }
        return "0";
    }
    // 闭包构造（M48）：堆分配环境 → 按值拷入捕获量 → 堆分配 TClosure → 返回其指针。
    // 函数值在 LLVM 里就是 ptr，故此处直接把 %TClosure* 当值返回。
    if (n.kind == "closure_make") {
        var cmety: string = sb_cat2("%st.", n.sb);
        var cmep: string = ll_tmp();
        llfb(sb_cat5("  ", cmep, " = call ptr @t_alloc(i64 ", ll_sizeof(cmety), ")"));
        var cmc: i64 = n.la;
        while (cmc >= 0) {
            var cmk: Child = kids[cmc];
            var cmf: Node = nodes[cmk.val];
            var cmfi: i64 = llsf_find(n.sb, cmf.sa);
            if (cmfi >= 0) {
                var cmfp: string = ll_tmp();
                llfb(sb_cat6(sb_cat4("  ", cmfp, " = getelementptr inbounds ", cmety),
                    ", ptr ", cmep, ", i32 0, i32 ", i2s(llsf_idx[cmfi]), ""));
                var cmftd: i64 = llsf_td[cmfi];
                var cmfty: string = ll_td(cmftd);
                var cmfv: string = emit_lle(cmk.val);
                if (ll_isagg(cmftd)) {
                    ll_copy(cmfty, cmfv, cmfp);
                } else {
                    var cmcv: string = ll_cast_v(cmfv, ll_etd(cmk.val), cmftd);
                    llfb(sb_cat6("  store ", cmfty, " ", cmcv, ", ptr ", cmfp));
                }
            }
            cmc = cmk.next;
        }
        var cmcp: string = ll_tmp();
        llfb(sb_cat5("  ", cmcp, " = call ptr @t_alloc(i64 ", ll_sizeof("%TClosure"), ")"));
        var cmg0: string = ll_tmp();
        llfb(sb_cat6("  ", cmg0, " = getelementptr inbounds %TClosure, ptr ", cmcp, ", i32 0, i32 0", ""));
        llfb(sb_cat6("  store ptr @t.", n.sa, ", ptr ", cmg0, "", ""));
        var cmg1: string = ll_tmp();
        llfb(sb_cat6("  ", cmg1, " = getelementptr inbounds %TClosure, ptr ", cmcp, ", i32 0, i32 1", ""));
        llfb(sb_cat4("  store ptr ", cmep, ", ptr ", cmg1));
        return cmcp;
    }
    if (n.kind == "struct_lit") {
        var sty: string = sb_cat2("%st.", n.sa);
        var s: string = ll_scratch(sty);
        llfb(sb_cat4("  store ", sty, " zeroinitializer, ptr ", s));
        var c: i64 = n.la;
        while (c >= 0) {
            var k: Child = kids[c];
            var fv: Node = nodes[k.val];
            var fi2: i64 = llsf_find(n.sa, fv.sa);
            if (fi2 >= 0) {
                var fp: string = ll_tmp();
                var line: StringBuilder = sb_new();
                sb_append_str(line, "  ");
                sb_append_str(line, fp);
                sb_append_str(line, " = getelementptr inbounds ");
                sb_append_str(line, sty);
                sb_append_str(line, ", ptr ");
                sb_append_str(line, s);
                sb_append_str(line, ", i32 0, i32 ");
                sb_append_i64(line, llsf_idx[fi2]);
                llfb(sb_to_str(line));
                var ftd: i64 = llsf_td[fi2];
                var fvv: string = emit_lle(fv.na);
                if (ll_isagg(ftd)) {
                    ll_copy(ll_td(ftd), fvv, fp);
                } else {
                    var cv2: string = ll_cast_v(fvv, ll_etd(fv.na), ftd);
                    llfb(sb_cat6("  store ", ll_td(ftd), " ", cv2, ", ptr ", fp));
                }
            }
            c = k.next;
        }
        return s;
    }
    if (n.kind == "cast") {
        var v2: string = emit_lle(n.na);
        var ttd: i64 = resolve_type_desc(n.nb);
        return ll_cast_v(v2, ll_etd(n.na), ttd);
    }
    llfb("  ; UNSUPPORTED expr");
    return "0";
}

// 索引值统一拓宽为 i64（str_at/slice_at 的下标参数）
ll_widen_idx fn(v: string, e: i64) -> string {
    var td: i64 = ll_etd(e);
    var i64td: i64 = td_named_mk("scalar", "i64");
    return ll_cast_v(v, td, i64td);
}

// ── 二元 / 一元 ────────────────────────────────────────────────

ll_binary fn(e: i64) -> string {
    var n: Node = nodes[e];
    var op: string = n.sa;

    if (op == "&&" || op == "||") {
        var lv: string = emit_lle(n.na);
        var l1: string = ll_to_i1(lv);
        var lend: string = ll_cur_blk;
        var rhsL: string = ll_lbl("sc.r");
        var mrgL: string = ll_lbl("sc.m");
        if (op == "&&") {
            llfb(sb_cat6("  br i1 ", l1, ", label %", rhsL, ", label %", mrgL));
        } else {
            llfb(sb_cat6("  br i1 ", l1, ", label %", mrgL, ", label %", rhsL));
        }
        ll_label(rhsL);
        var rv: string = emit_lle(n.nb);
        var r1: string = ll_to_i1(rv);
        var rend: string = ll_cur_blk;
        llfb(sb_cat3("  br label %", mrgL, ""));
        ll_label(mrgL);
        var sc_const: string = "false";
        if (op == "||") {
            sc_const = "true";
        }
        var t: string = ll_tmp();
        llfb(sb_cat6("  ", t, " = phi i1 [ ", sc_const, ", %", sb_cat6(lend, " ], [ ", r1, ", %", rend, " ]")));
        return ll_b8(t);
    }

    // 字符串相等
    if (op == "==" || op == "!=") {
        var lt: i64 = ll_etd(n.na);
        var rt: i64 = ll_etd(n.nb);
        var ltc: TD = tds[lt];
        var rtc: TD = tds[rt];
        if (ltc.cat == "string" || rtc.cat == "string") {
            var lp: string = emit_lle(n.na);
            var rp: string = emit_lle(n.nb);
            var t0: string = ll_tmp();
            llfb(sb_cat6("  ", t0, " = call i32 @tll_str_eq(ptr ", lp, ", ptr ", sb_cat2(rp, ")")));
            var t1: string = ll_tmp();
            if (op == "==") {
                llfb(sb_cat4("  ", t1, " = icmp ne i32 ", sb_cat2(t0, ", 0")));
            } else {
                llfb(sb_cat4("  ", t1, " = icmp eq i32 ", sb_cat2(t0, ", 0")));
            }
            return ll_b8(t1);
        }
    }

    var utd: i64 = ll_bin_td(e);
    var sn: string = td_sname(utd);
    if (sn == "") {
        sn = "i64";
    }
    var ty: string = scalar_to_ll(sn);
    var isf: bool = ll_isf(sn);
    var sg: bool = ll_signed(sn);
    var a: string = emit_lle(n.na);
    a = ll_cast_v(a, ll_etd(n.na), utd);
    var b: string = emit_lle(n.nb);
    b = ll_cast_v(b, ll_etd(n.nb), utd);

    if (op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=") {
        var cc: string = "";
        if (isf) {
            if (op == "==") { cc = "oeq"; }
            if (op == "!=") { cc = "one"; }
            if (op == "<") { cc = "olt"; }
            if (op == ">") { cc = "ogt"; }
            if (op == "<=") { cc = "ole"; }
            if (op == ">=") { cc = "oge"; }
            var tf: string = ll_tmp();
            llfb(sb_cat6("  ", tf, " = fcmp ", cc, " ", sb_cat6(ty, " ", a, ", ", b, "")));
            return ll_b8(tf);
        }
        if (op == "==") { cc = "eq"; }
        if (op == "!=") { cc = "ne"; }
        if (sg) {
            if (op == "<") { cc = "slt"; }
            if (op == ">") { cc = "sgt"; }
            if (op == "<=") { cc = "sle"; }
            if (op == ">=") { cc = "sge"; }
        } else {
            if (op == "<") { cc = "ult"; }
            if (op == ">") { cc = "ugt"; }
            if (op == "<=") { cc = "ule"; }
            if (op == ">=") { cc = "uge"; }
        }
        var ti2: string = ll_tmp();
        llfb(sb_cat6("  ", ti2, " = icmp ", cc, " ", sb_cat6(ty, " ", a, ", ", b, "")));
        return ll_b8(ti2);
    }

    var ins: string = "";
    if (isf) {
        if (op == "+") { ins = "fadd"; }
        if (op == "-") { ins = "fsub"; }
        if (op == "*") { ins = "fmul"; }
        if (op == "/") { ins = "fdiv"; }
        if (op == "%") { ins = "frem"; }
    } else {
        if (op == "+") { ins = "add"; }
        if (op == "-") { ins = "sub"; }
        if (op == "*") { ins = "mul"; }
        if (op == "/") {
            ins = "udiv";
            if (sg) {
                ins = "sdiv";
            }
        }
        if (op == "%") {
            ins = "urem";
            if (sg) {
                ins = "srem";
            }
        }
        if (op == "<<") { ins = "shl"; }
        if (op == ">>") {
            ins = "lshr";
            if (sg) {
                ins = "ashr";
            }
        }
        if (op == "&") { ins = "and"; }
        if (op == "|") { ins = "or"; }
        if (op == "^") { ins = "xor"; }
    }
    if (ins == "") {
        llfb("  ; UNSUPPORTED binop");
        return "0";
    }
    var t3: string = ll_tmp();
    llfb(sb_cat6("  ", t3, " = ", ins, " ", sb_cat6(ty, " ", a, ", ", b, "")));
    return t3;
}

ll_unary fn(e: i64) -> string {
    var n: Node = nodes[e];
    var op: string = n.sa;
    if (op == "!") {
        var v: string = emit_lle(n.na);
        var t: string = ll_tmp();
        llfb(sb_cat4("  ", t, " = icmp eq i8 ", sb_cat2(v, ", 0")));
        return ll_b8(t);
    }
    var otd: i64 = ll_etd(n.na);
    var sn: string = td_sname(otd);
    if (sn == "") {
        sn = "i64";
    }
    var ty: string = scalar_to_ll(sn);
    var v2: string = emit_lle(n.na);
    if (op == "-") {
        if (str_len(v2) > 0) {
            if (v2[0] != 37) {
                return sb_cat2("-", v2);    // 常量折叠
            }
        }
        if (ll_isf(sn)) {
            var tf: string = ll_tmp();
            llfb(sb_cat6("  ", tf, " = fneg ", ty, " ", v2));
            return tf;
        }
        var t2: string = ll_tmp();
        llfb(sb_cat6("  ", t2, " = sub ", ty, " 0, ", v2));
        return t2;
    }
    if (op == "~") {
        var t3: string = ll_tmp();
        llfb(sb_cat6("  ", t3, " = xor ", ty, " ", sb_cat2(v2, ", -1")));
        return t3;
    }
    return v2;
}

// ── 尺寸计算（union/variant 载荷字节数，保守 8 字节对齐上估）──

ll_round8 fn(v: i64) -> i64 {
    return ((v + 7) / 8) * 8;
}

ll_size_bytes fn(td: i64) -> i64 {
    if (td < 0) {
        return 8;
    }
    var t: TD = tds[td];
    if (t.cat == "scalar") {
        if (t.name == "") {
            return 8;
        }
        return ll_bits(t.name) / 8;
    }
    if (t.cat == "string") {
        return 16;
    }
    if (t.cat == "slice") {
        return 32;
    }
    if (t.cat == "map") {
        return 8;
    }
    if (t.cat == "named") {
        if (t.name == "TSb*") {
            return 8;
        }
        var i: i64 = llt_find(t.name);
        if (i < 0) {
            return 8;
        }
        var k: string = llt_kinds[i];
        if (k == "enum" || k == "flag") {
            return ll_bits(llt_unders[i]) / 8;
        }
        if (k == "alias") {
            return ll_size_bytes(llt_atd[i]);
        }
        if (k == "struct") {
            var sum: i64 = 0;
            var n: i64 = slice_len(llsf_st) as i64;
            var j: i64 = 0;
            while (j < n) {
                if (llsf_st[j] == t.name) {
                    sum = sum + ll_round8(ll_size_bytes(llsf_td[j]));
                }
                j = j + 1;
            }
            if (sum == 0) {
                sum = 8;
            }
            return sum;
        }
        if (k == "variant") {
            return 8 + ll_variant_paymax(t.name);
        }
        if (k == "union") {
            return ll_union_max(t.name);
        }
    }
    return 8;
}

ll_variant_paymax fn(name: string) -> i64 {
    var mx: i64 = 8;
    var n: i64 = slice_len(llv_v) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (llv_v[i] == name && llv_ptd[i] >= 0) {
            var s: i64 = ll_round8(ll_size_bytes(llv_ptd[i]));
            if (s > mx) {
                mx = s;
            }
        }
        i = i + 1;
    }
    return mx;
}

ll_union_max fn(name: string) -> i64 {
    var mx: i64 = 8;
    var n: i64 = slice_len(llu_u) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (llu_u[i] == name) {
            var s: i64 = ll_round8(ll_size_bytes(llu_td[i]));
            if (s > mx) {
                mx = s;
            }
        }
        i = i + 1;
    }
    return mx;
}

// iN 类型的常量文本：超出有符号范围时按补码回绕成负十进制
ll_iconst fn(v: i64, bits: i64) -> string {
    if (bits == 8) {
        if (v > 127) {
            return i2s(v - 256);
        }
    }
    if (bits == 16) {
        if (v > 32767) {
            return i2s(v - 65536);
        }
    }
    if (bits == 32) {
        if (v > 2147483647) {
            return i2s(v - 4294967296);
        }
    }
    return i2s(v);
}

// 复合赋值/二元共用的算术指令名
ll_arith_ins fn(op: string, sn: string) -> string {
    var isf: bool = ll_isf(sn);
    var sg: bool = ll_signed(sn);
    if (isf) {
        if (op == "+") { return "fadd"; }
        if (op == "-") { return "fsub"; }
        if (op == "*") { return "fmul"; }
        if (op == "/") { return "fdiv"; }
        if (op == "%") { return "frem"; }
        return "";
    }
    if (op == "+") { return "add"; }
    if (op == "-") { return "sub"; }
    if (op == "*") { return "mul"; }
    if (op == "/") {
        if (sg) {
            return "sdiv";
        }
        return "udiv";
    }
    if (op == "%") {
        if (sg) {
            return "srem";
        }
        return "urem";
    }
    if (op == "<<") { return "shl"; }
    if (op == ">>") {
        if (sg) {
            return "ashr";
        }
        return "lshr";
    }
    if (op == "&") { return "and"; }
    if (op == "|") { return "or"; }
    if (op == "^") { return "xor"; }
    return "";
}

// ── 调用发射 ───────────────────────────────────────────────────

// map 读索引助手（LLVM）：tll_map_val_ptr 返回存储值字节指针，按 V 类型 load。
// map 操作数取指针助手（LLVM）：按 map 声明的 K/V 类型落盘，
// 标量 alloca+store（必要时先转宽），聚合直接取地址。want<0 表示沿用实参自身类型。
// map 键取指针（LLVM 后端）：整型键统一按 i64 存储——runtime 按 int64_t 读键，
// 直接存 i32/u8 会让高位字节是垃圾。string 键是 TStr 聚合，走原路径。
ll_map_keyptr fn(kn: i64, keytd: i64) -> string {
    if (keytd >= 0 && ll_isagg(keytd)) {
        return ll_map_argptr(kn, keytd);
    }
    return ll_map_argptr(kn, td_named_mk("scalar", "i64"));
}

ll_map_argptr fn(an: i64, want: i64) -> string {
    var atd: i64 = ll_etd(an);
    var used: i64 = atd;
    if (want >= 0) {
        used = want;
    }
    if (ll_isagg(used)) {
        return emit_lle(an);
    }
    var aty: string = ll_td(used);
    var av: string = emit_lle(an);
    av = ll_cast_v(av, atd, used);
    var asc: string = ll_scratch(aty);
    llfb(sb_cat6("  store ", aty, " ", av, ", ptr ", asc));
    return asc;
}

ll_map_get fn(mn: i64, kn: i64) -> string {
    var mtd: i64 = ll_etd(mn);
    var mt: TD = tds[mtd];
    var valtd: i64 = mt.val;
    var valty: string = ll_td(valtd);
    var mp: string = emit_lle(mn);
    var kp: string = ll_map_keyptr(kn, mt.key);
    var addr: string = ll_tmp();
    llfb(sb_cat6("  ", addr, " = call ptr @tll_map_val_ptr(ptr ", mp, ", ptr ", sb_cat2(kp, ")")));
    if (ll_isagg(valtd)) {
        return addr;
    }
    var out: string = ll_tmp();
    llfb(sb_cat6("  ", out, " = load ", valty, ", ptr ", addr));
    return out;
}

// 闭包解包间接调用（FuncType v2 / M47）：函数值是指向 %TClosure { ptr fn; ptr env }
// 的指针；被调函数统一为 `Ret (ptr env, Args...)`，env 作首参。
// callee 可以是任意表达式（ident / 结构体字段 / 数组元素 / 调用结果…），
// 这里只求值一次再解包，避免重复副作用。
ll_call_indirect fn(e: i64, iftd: i64) -> string {
    var n: Node = nodes[e];
    var ae: []i64;
    var c: i64 = n.la;
    while (c >= 0) {
        var k: Child = kids[c];
        append(ae, k.val);
        c = k.next;
    }
    var argc: i64 = slice_len(ae) as i64;
    var iclp: string = emit_lle(n.na);
    var ifnp: string = ll_tmp();
    llfb(sb_cat6("  ", ifnp, " = getelementptr inbounds %TClosure, ptr ", iclp, ", i32 0, i32 0", ""));
    var fpv: string = ll_load("ptr", ifnp);
    var ienp: string = ll_tmp();
    llfb(sb_cat6("  ", ienp, " = getelementptr inbounds %TClosure, ptr ", iclp, ", i32 0, i32 1", ""));
    var ienv: string = ll_load("ptr", ienp);
    var icsb: StringBuilder = sb_new();
    sb_append_str(icsb, "ptr ");
    sb_append_str(icsb, ienv);
    var ii: i64 = 0;
    while (ii < argc) {
        sb_append_str(icsb, ", ");
        var iptd: i64 = -1;
        if (ii < tdf_pcount[iftd]) {
            iptd = tdf_params[tdf_pstart[iftd] + ii];
        }
        var iaty: string = ll_td(iptd);
        var iav: string = emit_lle(ae[ii]);
        if (iptd >= 0 && ll_isagg(iptd)) {
            iav = ll_load(iaty, iav);
        } else {
            iav = ll_cast_v(iav, ll_etd(ae[ii]), iptd);
        }
        sb_append_str(icsb, iaty);
        sb_append_str(icsb, " ");
        sb_append_str(icsb, iav);
        ii = ii + 1;
    }
    var irtd: i64 = tdf_ret[iftd];
    var irty: string = ll_td(irtd);
    var iargs: string = sb_to_str(icsb);
    if (irty == "void") {
        llfb(sb_cat5("  call void ", fpv, "(", iargs, ")"));
        return "0";
    }
    var itmp: string = ll_tmp();
    llfb(sb_cat6(sb_cat3("  ", itmp, " = call "), irty, " ", fpv, sb_cat3("(", iargs, ")"), ""));
    if (ll_isagg(irtd)) {
        var isc: string = ll_scratch(irty);
        llfb(sb_cat6("  store ", irty, " ", itmp, ", ptr ", isc));
        return isc;
    }
    return itmp;
}

ll_call fn(e: i64) -> string {
    var n: Node = nodes[e];
    var cal: Node = nodes[n.na];
    if (cal.kind != "ident") {
        // callee 是任意表达式（结构体字段 / 数组元素 / 调用结果…）：只要它的静态类型
        // 是函数类型，就按闭包解包间接调用；否则才是真的不支持。
        var xftd: i64 = ll_etd(n.na);
        if (td_is_func(xftd)) {
            return ll_call_indirect(e, xftd);
        }
        llfb("  ; UNSUPPORTED call target");
        return "0";
    }
    var cn: string = cal.sa;
    var ae: []i64;
    var c: i64 = n.la;
    while (c >= 0) {
        var k: Child = kids[c];
        append(ae, k.val);
        c = k.next;
    }
    var argc: i64 = slice_len(ae) as i64;
    var td_i64: i64 = td_named_mk("scalar", "i64");
    var td_i32: i64 = td_named_mk("scalar", "i32");

    if (cn == "print" || cn == "eprint" || cn == "println") {
        var p: string = emit_lle(ae[0]);
        var fnm: string = "@tll_print";
        if (cn == "eprint") {
            fnm = "@tll_eprint";
        }
        if (cn == "println") {
            fnm = "@tll_println";
        }
        llfb(sb_cat4("  call void ", fnm, "(ptr ", sb_cat2(p, ")")));
        return "0";
    }
    if (cn == "str_len" || cn == "slice_len") {
        var p2: string = emit_lle(ae[0]);
        var fn2: string = "@tll_str_len";
        if (cn == "slice_len") {
            fn2 = "@tll_slice_len";
        }
        var t0: string = ll_tmp();
        llfb(sb_cat6("  ", t0, " = call i64 ", fn2, "(ptr ", sb_cat2(p2, ")")));
        return t0;
    }
    if (cn == "str_at") {
        var sp: string = emit_lle(ae[0]);
        var iv: string = emit_lle(ae[1]);
        iv = ll_cast_v(iv, ll_etd(ae[1]), td_i64);
        var t1: string = ll_tmp();
        llfb(sb_cat6("  ", t1, " = call i64 @tll_str_at(ptr ", sp, ", i64 ", sb_cat2(iv, ")")));
        var t2: string = ll_tmp();
        llfb(sb_cat4("  ", t2, " = trunc i64 ", sb_cat2(t1, " to i8")));
        return t2;
    }
    if (cn == "str_slice") {
        var sp2: string = emit_lle(ae[0]);
        var a1: string = emit_lle(ae[1]);
        a1 = ll_cast_v(a1, ll_etd(ae[1]), td_i64);
        var b1: string = emit_lle(ae[2]);
        b1 = ll_cast_v(b1, ll_etd(ae[2]), td_i64);
        var out0: string = ll_scratch("%TStr");
        var lsb: StringBuilder = sb_new();
        sb_append_str(lsb, "  call void @tll_str_slice(ptr ");
        sb_append_str(lsb, sp2);
        sb_append_str(lsb, ", i64 ");
        sb_append_str(lsb, a1);
        sb_append_str(lsb, ", i64 ");
        sb_append_str(lsb, b1);
        sb_append_str(lsb, ", ptr ");
        sb_append_str(lsb, out0);
        sb_append_str(lsb, ")");
        llfb(sb_to_str(lsb));
        return out0;
    }
    if (cn == "append") {
        var std: i64 = ll_etd(ae[0]);
        var st: TD = tds[std];
        var ety: string = "i64";
        var etd: i64 = -1;
        if (st.cat == "slice") {
            etd = st.elem;
        }
        if (etd >= 0) {
            ety = ll_td(etd);
        }
        var sp3: string = emit_lle(ae[0]);
        var ep: string = "";
        var isagg: bool = false;
        if (etd >= 0) {
            isagg = ll_isagg(etd);
        }
        if (isagg) {
            ep = emit_lle(ae[1]);
        } else {
            var v0: string = emit_lle(ae[1]);
            if (etd >= 0) {
                v0 = ll_cast_v(v0, ll_etd(ae[1]), etd);
            }
            var sc0: string = ll_scratch(ety);
            llfb(sb_cat6("  store ", ety, " ", v0, ", ptr ", sc0));
            ep = sc0;
        }
        var asb: StringBuilder = sb_new();
        sb_append_str(asb, "  call void @tll_slice_append(ptr ");
        sb_append_str(asb, sp3);
        sb_append_str(asb, ", ptr ");
        sb_append_str(asb, ep);
        sb_append_str(asb, ", i64 ");
        sb_append_str(asb, ll_sizeof(ety));
        sb_append_str(asb, ")");
        llfb(sb_to_str(asb));
        return "0";
    }
    if (cn == "slice_set") {
        var std2: i64 = ll_etd(ae[0]);
        var st2: TD = tds[std2];
        var etd2: i64 = -1;
        if (st2.cat == "slice") {
            etd2 = st2.elem;
        }
        var ety2: string = "i64";
        if (etd2 >= 0) {
            ety2 = ll_td(etd2);
        }
        var sp4: string = emit_lle(ae[0]);
        var iv2: string = emit_lle(ae[1]);
        iv2 = ll_cast_v(iv2, ll_etd(ae[1]), td_i64);
        var ep2: string = "";
        var isagg2: bool = false;
        if (etd2 >= 0) {
            isagg2 = ll_isagg(etd2);
        }
        if (isagg2) {
            ep2 = emit_lle(ae[2]);
        } else {
            var v1: string = emit_lle(ae[2]);
            if (etd2 >= 0) {
                v1 = ll_cast_v(v1, ll_etd(ae[2]), etd2);
            }
            var sc1: string = ll_scratch(ety2);
            llfb(sb_cat6("  store ", ety2, " ", v1, ", ptr ", sc1));
            ep2 = sc1;
        }
        var ssb: StringBuilder = sb_new();
        sb_append_str(ssb, "  call void @tll_slice_set(ptr ");
        sb_append_str(ssb, sp4);
        sb_append_str(ssb, ", i64 ");
        sb_append_str(ssb, iv2);
        sb_append_str(ssb, ", ptr ");
        sb_append_str(ssb, ep2);
        sb_append_str(ssb, ")");
        llfb(sb_to_str(ssb));
        return "0";
    }
    if (cn == "file_read_all" || cn == "path_resolve") {
        var pp0: string = emit_lle(ae[0]);
        var fn3: string = "@tll_file_read_all";
        if (cn == "path_resolve") {
            fn3 = "@tll_path_resolve";
        }
        var out1: string = ll_scratch("%TStr");
        llfb(sb_cat6("  call void ", fn3, "(ptr ", pp0, ", ptr ", sb_cat2(out1, ")")));
        return out1;
    }
    // type_info accessor 内建（M36）
    if (cn == "ti_name" || cn == "fi_name" || cn == "fi_type_name") {
        var p: string = emit_lle(ae[0]);
        var out: string = ll_scratch("%TStr");
        llfb(sb_cat6("  call void @tll_", cn, "(ptr ", p, ", ptr ", sb_cat2(out, ")")));
        return out;
    }
    if (cn == "ti_size" || cn == "ti_kind" || cn == "ti_field_count" || cn == "fi_offset" || cn == "fi_type_size" || cn == "fi_tag") {
        var p: string = emit_lle(ae[0]);
        var out: string = ll_tmp();
        llfb(sb_cat6("  ", out, " = call i64 @tll_", cn, "(ptr ", sb_cat2(p, ")")));
        return out;
    }
    if (cn == "ti_field") {
        var p: string = emit_lle(ae[0]);
        var iv: string = emit_lle(ae[1]);
        iv = ll_cast_v(iv, ll_etd(ae[1]), td_i64);
        var out: string = ll_tmp();
        llfb(sb_cat6("  ", out, " = call ptr @tll_ti_field(ptr ", p, ", i64 ", sb_cat2(iv, ")")));
        return out;
    }
    if (cn == "fi_is_ptr") {
        var p: string = emit_lle(ae[0]);
        var out: string = ll_tmp();
        // bool 在 LLVM 后端一律 i8（与 file_write_all 等一致），不能用 i1
        llfb(sb_cat4("  ", out, " = call i8 @tll_fi_is_ptr(ptr ", sb_cat2(p, ")")));
        return out;
    }
    if (cn == "file_write_all") {
        var pa: string = emit_lle(ae[0]);
        var pb: string = emit_lle(ae[1]);
        var t3: string = ll_tmp();
        llfb(sb_cat6("  ", t3, " = call i32 @tll_file_write_all(ptr ", pa, ", ptr ", sb_cat2(pb, ")")));
        var t4: string = ll_tmp();
        llfb(sb_cat4("  ", t4, " = trunc i32 ", sb_cat2(t3, " to i8")));
        return t4;
    }
    if (cn == "file_exists") {
        var pfe: string = emit_lle(ae[0]);
        var t5: string = ll_tmp();
        llfb(sb_cat4("  ", t5, " = call i32 @tll_file_exists(ptr ", sb_cat2(pfe, ")")));
        var t6: string = ll_tmp();
        llfb(sb_cat4("  ", t6, " = trunc i32 ", sb_cat2(t5, " to i8")));
        return t6;
    }
    if (cn == "args") {
        var out2: string = ll_scratch("%TSlice");
        llfb(sb_cat3("  call void @tll_args(ptr ", out2, ")"));
        return out2;
    }
    if (cn == "exit") {
        var cv: string = emit_lle(ae[0]);
        cv = ll_cast_v(cv, ll_etd(ae[0]), td_i32);
        llfb(sb_cat3("  call void @tll_exit(i32 ", cv, ")"));
        return "0";
    }
    if (cn == "sys_run") {
        var cp: string = emit_lle(ae[0]);
        var t5: string = ll_tmp();
        llfb(sb_cat4("  ", t5, " = call i32 @tll_system(ptr ", sb_cat2(cp, ")")));
        return t5;
    }
    if (cn == "sb_new") {
        var t6: string = ll_tmp();
        llfb(sb_cat3("  ", t6, " = call ptr @tll_sb_new()"));
        return t6;
    }
    if (cn == "sb_append_str") {
        var bp: string = emit_lle(ae[0]);
        var sv: string = emit_lle(ae[1]);
        llfb(sb_cat6("  call void @tll_sb_append_str(ptr ", bp, ", ptr ", sv, ")", ""));
        return "0";
    }
    if (cn == "sb_append_char" || cn == "sb_append_u64" || cn == "sb_append_i64") {
        var bp2: string = emit_lle(ae[0]);
        var cv2: string = emit_lle(ae[1]);
        cv2 = ll_cast_v(cv2, ll_etd(ae[1]), td_i64);
        var fn4: string = "@tll_sb_append_char";
        if (cn == "sb_append_u64") {
            fn4 = "@tll_sb_append_u64";
        }
        if (cn == "sb_append_i64") {
            fn4 = "@tll_sb_append_i64";
        }
        llfb(sb_cat6("  call void ", fn4, "(ptr ", bp2, ", i64 ", sb_cat2(cv2, ")")));
        return "0";
    }
    if (cn == "sb_to_str") {
        var bp3: string = emit_lle(ae[0]);
        var out3: string = ll_scratch("%TStr");
        llfb(sb_cat6("  call void @tll_sb_to_str(ptr ", bp3, ", ptr ", out3, ")", ""));
        return out3;
    }
    if (cn == "sb_clear") {
        var bp4: string = emit_lle(ae[0]);
        llfb(sb_cat3("  call void @tll_sb_clear(ptr ", bp4, ")"));
        return "0";
    }
    if (cn == "int_to_str" || cn == "i2s") {
        var iv5: string = emit_lle(ae[0]);
        iv5 = ll_cast_v(iv5, ll_etd(ae[0]), td_i64);
        var out5: string = ll_scratch("%TStr");
        llfb(sb_cat6("  call void @tll_int_to_str(i64 ", iv5, ", ptr ", out5, ")", ""));
        return out5;
    }
    // 格式化（Python 格式规范迷你语言子集）
    if (cn == "format_int") {
        var spf: string = emit_lle(ae[0]);
        var vvf: string = ll_cast_v(emit_lle(ae[1]), ll_etd(ae[1]), td_i64);
        var outf: string = ll_scratch("%TStr");
        llfb(sb_cat6("  call void @tll_format_int(ptr ", spf, ", i64 ", vvf, sb_cat3(", ptr ", outf, ")"), ""));
        return outf;
    }
    // 时间格式化（M56）
    if (cn == "format_time" || cn == "format_time_local") {
        var sp: string = emit_lle(ae[0]);
        var vt: string = ll_cast_v(emit_lle(ae[1]), ll_etd(ae[1]), td_i64);
        var uloc: string = "0";
        if (cn == "format_time_local") { uloc = "1"; }
        var outt: string = ll_scratch("%TStr");
        var call_s: string = sb_cat6("  call void @tll_format_time(ptr ", sp, ", i64 ", vt, ", i64 ", uloc);
        call_s = sb_cat2(call_s, sb_cat3(", ptr ", outt, ")"));
        llfb(call_s);
        return outt;
    }
    if (cn == "format_time_tz") {
        var tzsp: string = emit_lle(ae[0]);
        var tzvt: string = ll_cast_v(emit_lle(ae[1]), ll_etd(ae[1]), td_i64);
        var tzvz: string = ll_cast_v(emit_lle(ae[2]), ll_etd(ae[2]), td_i64);
        var tzout: string = ll_scratch("%TStr");
        var tzcall: string = sb_cat6("  call void @tll_format_time_tz(ptr ", tzsp, ", i64 ", tzvt, ", i64 ", tzvz);
        tzcall = sb_cat2(tzcall, sb_cat3(", ptr ", tzout, ")"));
        llfb(tzcall);
        return tzout;
    }
    if (cn == "parse_time" || cn == "parse_time_local") {
        var ptsp: string = emit_lle(ae[0]);
        var ptss: string = emit_lle(ae[1]);
        var ptloc: string = "0";
        if (cn == "parse_time_local") { ptloc = "1"; }
        var ptt: string = ll_tmp();
        var ptcall: string = sb_cat6("  ", ptt, " = call i64 @tll_parse_time(ptr ", ptsp, ", ptr ", ptss);
        ptcall = sb_cat3(ptcall, sb_cat3(", i64 ", ptloc, ")"), "");
        llfb(ptcall);
        return ptt;
    }
    // 解析失败哨兵：i64 最小值。纯常量，无需 runtime 符号，双后端同值。
    if (cn == "time_invalid") { return "-9223372036854775808"; }
    if (cn == "now") {
        var now_t: string = ll_tmp();
        llfb(sb_cat2("  ", sb_cat2(now_t, " = call i64 @tll_now()")));
        return now_t;
    }
    if (cn == "format_uint") {
        var spg: string = emit_lle(ae[0]);
        var vvg: string = ll_cast_v(emit_lle(ae[1]), ll_etd(ae[1]), td_i64);
        var outg: string = ll_scratch("%TStr");
        llfb(sb_cat6("  call void @tll_format_uint(ptr ", spg, ", i64 ", vvg, sb_cat3(", ptr ", outg, ")"), ""));
        return outg;
    }
    if (cn == "format_float") {
        var sph: string = emit_lle(ae[0]);
        var vvh: string = ll_cast_v(emit_lle(ae[1]), ll_etd(ae[1]), td_named_mk("scalar", "f64"));
        var outh: string = ll_scratch("%TStr");
        llfb(sb_cat6("  call void @tll_format_float(ptr ", sph, ", double ", vvh, sb_cat3(", ptr ", outh, ")"), ""));
        return outh;
    }
    if (cn == "format_str") {
        var spi: string = emit_lle(ae[0]);
        var vvi: string = emit_lle(ae[1]);
        var outi: string = ll_scratch("%TStr");
        llfb(sb_cat6("  call void @tll_format_str(ptr ", spi, ", ptr ", vvi, sb_cat3(", ptr ", outi, ")"), ""));
        return outi;
    }
    if (cn == "format_bool") {
        var spj: string = emit_lle(ae[0]);
        var vvj: string = ll_cast_v(emit_lle(ae[1]), ll_etd(ae[1]), td_named_mk("scalar", "bool"));
        var outj: string = ll_scratch("%TStr");
        llfb(sb_cat6("  call void @tll_format_bool(ptr ", spj, ", i8 ", vvj, sb_cat3(", ptr ", outj, ")"), ""));
        return outj;
    }
    if (cn == "format_char") {
        var spk: string = emit_lle(ae[0]);
        var vvk: string = ll_cast_v(emit_lle(ae[1]), ll_etd(ae[1]), td_i64);
        var outk: string = ll_scratch("%TStr");
        llfb(sb_cat6("  call void @tll_format_char(ptr ", spk, ", i64 ", vvk, sb_cat3(", ptr ", outk, ")"), ""));
        return outk;
    }
    if (cn == "sb_append_fmt_int") {
        var bpf: string = emit_lle(ae[0]);
        var spf2: string = emit_lle(ae[1]);
        var vvf2: string = ll_cast_v(emit_lle(ae[2]), ll_etd(ae[2]), td_i64);
        llfb(sb_cat6("  call void @tll_sb_append_fmt_int(ptr ", bpf, ", ptr ", spf2, ", i64 ", sb_cat2(vvf2, ")")));
        return "0";
    }
    if (cn == "sb_append_fmt_uint") {
        var bpg: string = emit_lle(ae[0]);
        var spg2: string = emit_lle(ae[1]);
        var vvg2: string = ll_cast_v(emit_lle(ae[2]), ll_etd(ae[2]), td_i64);
        llfb(sb_cat6("  call void @tll_sb_append_fmt_uint(ptr ", bpg, ", ptr ", spg2, ", i64 ", sb_cat2(vvg2, ")")));
        return "0";
    }
    if (cn == "sb_append_fmt_float") {
        var bph: string = emit_lle(ae[0]);
        var sph2: string = emit_lle(ae[1]);
        var vvh2: string = ll_cast_v(emit_lle(ae[2]), ll_etd(ae[2]), td_named_mk("scalar", "f64"));
        llfb(sb_cat6("  call void @tll_sb_append_fmt_float(ptr ", bph, ", ptr ", sph2, ", double ", sb_cat2(vvh2, ")")));
        return "0";
    }
    if (cn == "sb_append_fmt_str") {
        var bpi: string = emit_lle(ae[0]);
        var spi2: string = emit_lle(ae[1]);
        var vvi2: string = emit_lle(ae[2]);
        llfb(sb_cat6("  call void @tll_sb_append_fmt_str(ptr ", bpi, ", ptr ", spi2, ", ptr ", sb_cat2(vvi2, ")")));
        return "0";
    }
    if (cn == "sb_append_fmt_bool") {
        var bpj: string = emit_lle(ae[0]);
        var spj2: string = emit_lle(ae[1]);
        var vvj2: string = ll_cast_v(emit_lle(ae[2]), ll_etd(ae[2]), td_named_mk("scalar", "bool"));
        llfb(sb_cat6("  call void @tll_sb_append_fmt_bool(ptr ", bpj, ", ptr ", spj2, ", i8 ", sb_cat2(vvj2, ")")));
        return "0";
    }
    if (cn == "sb_append_fmt_char") {
        var bpk: string = emit_lle(ae[0]);
        var spk2: string = emit_lle(ae[1]);
        var vvk2: string = ll_cast_v(emit_lle(ae[2]), ll_etd(ae[2]), td_i64);
        llfb(sb_cat6("  call void @tll_sb_append_fmt_char(ptr ", bpk, ", ptr ", spk2, ", i64 ", sb_cat2(vvk2, ")")));
        return "0";
    }
    if (cn == "map_new") {
        var mtd2: i64 = ll_etd(ae[0]);
        var mt2: TD = tds[mtd2];
        var kk2: i64 = 0;
        if (tds[mt2.key].cat != "string") { kk2 = 1; }
        var vs2: string = ll_sizeof(ll_td(mt2.val));
        var tnew: string = ll_tmp();
        llfb(sb_cat6("  ", tnew, " = call ptr @tll_map_new(i64 ", i2s(kk2), ", i64 ", sb_cat2(vs2, ")")));
        return tnew;
    }
    if (cn == "map_get") {
        return ll_map_get(ae[0], ae[1]);
    }
    if (cn == "map_set") {
        var mtd3: i64 = ll_etd(ae[0]);
        var mt3: TD = tds[mtd3];
        var mp3: string = emit_lle(ae[0]);
        var kp3: string = ll_map_keyptr(ae[1], mt3.key);
        var vp3: string = ll_map_argptr(ae[2], mt3.val);
        llfb(sb_cat6("  call void @tll_map_put(ptr ", mp3, ", ptr ", kp3, ", ptr ", sb_cat2(vp3, ")")));
        return "0";
    }
    if (cn == "map_has") {
        var mtd4: i64 = ll_etd(ae[0]);
        var mt4: TD = tds[mtd4];
        var mp4: string = emit_lle(ae[0]);
        var kp4: string = ll_map_keyptr(ae[1], mt4.key);
        var t4: string = ll_tmp();
        llfb(sb_cat6("  ", t4, " = call i32 @tll_map_has(ptr ", mp4, ", ptr ", sb_cat2(kp4, ")")));
        var t4b: string = ll_tmp();
        llfb(sb_cat4("  ", t4b, " = trunc i32 ", sb_cat2(t4, " to i8")));
        return t4b;
    }
    if (cn == "map_len") {
        var mp5: string = emit_lle(ae[0]);
        var t5: string = ll_tmp();
        llfb(sb_cat6("  ", t5, " = call i64 @tll_map_len(ptr ", mp5, ")", ""));
        return t5;
    }
    if (cn == "map_del") {
        var mtd6: i64 = ll_etd(ae[0]);
        var mt6: TD = tds[mtd6];
        var mp6: string = emit_lle(ae[0]);
        var kp6: string = ll_map_keyptr(ae[1], mt6.key);
        var t6: string = ll_tmp();
        llfb(sb_cat6("  ", t6, " = call i32 @tll_map_del(ptr ", mp6, ", ptr ", sb_cat2(kp6, ")")));
        var t6b: string = ll_tmp();
        llfb(sb_cat4("  ", t6b, " = trunc i32 ", sb_cat2(t6, " to i8")));
        return t6b;
    }
    // Sym：sym_str(v) 由变量 Sym 类型推出 tag；id 归一到 i32（Sym16 需 zext）
    if (cn == "sym_str") {
        var sstd: i64 = ll_etd(ae[0]);
        var sstag: string = "";
        if (sstd >= 0 && tds[sstd].cat == "sym") { sstag = tds[sstd].name; }
        var sstagp: string = ll_strlit(sstag);
        var ssid: string = emit_lle(ae[0]);
        if (ll_td(sstd) == "i16") {
            var ssz: string = ll_tmp();
            llfb(sb_cat4("  ", ssz, " = zext i16 ", sb_cat2(ssid, " to i32")));
            ssid = ssz;
        }
        var ssout: string = ll_scratch("%TStr");
        llfb(sb_cat6("  call void @tll_sym_str(ptr ", sstagp, ", i32 ", ssid, ", ptr ", sb_cat2(ssout, ")")));
        return ssout;
    }
    if (cn == "sym_release") {
        var srp: string = emit_lle(ae[0]);
        llfb(sb_cat3("  call void @tll_sym_release(ptr ", srp, ")"));
        return "0";
    }
    if (cn == "sym_release_all") {
        llfb("  call void @tll_sym_release_all()");
        return "0";
    }
    if (cn == "atom_str") {
        var as_id: string = emit_lle(ae[0]);
        var as_out: string = ll_scratch("%TStr");
        llfb(sb_cat6("  call void @tll_atom_str(i64 ", as_id, ", ptr ", as_out, ")", ""));
        return as_out;
    }
    // ── 文件描述符内建（M51）──────────────────────────────────
    if (cn == "fopen") {
        var fo_p: string = emit_lle(ae[0]);
        var fo_t: string = ll_tmp();
        llfb(sb_cat6("  ", fo_t, " = call i64 @tll_fopen(ptr ", fo_p, ", i32 ",
            sb_cat2(fid_arg_code(ae[1], "mode"), ")")));
        return fo_t;
    }
    if (cn == "fclose" || cn == "fflush") {
        var fc_f: string = emit_lle(ae[0]);
        var fc_n: string = "@tll_fclose";
        if (cn == "fflush") { fc_n = "@tll_fflush"; }
        llfb(sb_cat5("  call void ", fc_n, "(i64 ", fc_f, ")"));
        return "0";
    }
    if (cn == "fid_is_open") {
        var fio_f: string = emit_lle(ae[0]);
        var fio_t: string = ll_tmp();
        llfb(sb_cat4("  ", fio_t, " = call i32 @tll_fid_is_open(i64 ", sb_cat2(fio_f, ")")));
        var fio_b: string = ll_tmp();
        llfb(sb_cat4("  ", fio_b, " = trunc i32 ", sb_cat2(fio_t, " to i8")));
        return fio_b;
    }
    if (cn == "fid_eof") {
        var feo_f: string = emit_lle(ae[0]);
        var feo_t: string = ll_tmp();
        llfb(sb_cat4("  ", feo_t, " = call i32 @tll_fid_eof(i64 ", sb_cat2(feo_f, ")")));
        var feo_b: string = ll_tmp();
        llfb(sb_cat4("  ", feo_b, " = trunc i32 ", sb_cat2(feo_t, " to i8")));
        return feo_b;
    }
    if (cn == "fid_error") {
        var fe_f: string = emit_lle(ae[0]);
        var fe_out: string = ll_scratch("%TStr");
        llfb(sb_cat5("  call void @tll_fid_error(i64 ", fe_f, ", ptr ", fe_out, ")"));
        return fe_out;
    }
    if (cn == "fseek") {
        var fsk_f: string = emit_lle(ae[0]);
        var fsk_o: string = emit_lle(ae[1]);
        var fsk_t: string = ll_tmp();
        llfb(sb_cat6("  ", fsk_t, " = call i32 @tll_fseek(i64 ", fsk_f, ", i64 ",
            sb_cat2(fsk_o, ")")));
        var fsk_b: string = ll_tmp();
        llfb(sb_cat4("  ", fsk_b, " = trunc i32 ", sb_cat2(fsk_t, " to i8")));
        return fsk_b;
    }
    if (cn == "ftell") {
        var ftl_f: string = emit_lle(ae[0]);
        var ftl_t: string = ll_tmp();
        llfb(sb_cat4("  ", ftl_t, " = call i64 @tll_ftell(i64 ", sb_cat2(ftl_f, ")")));
        return ftl_t;
    }
    if (cn == "fid_format") {
        var ff_f: string = emit_lle(ae[0]);
        var ff_t: string = ll_tmp();
        llfb(sb_cat6("  ", ff_t, " = call i64 @tll_fid_format(i64 ", ff_f, ", i64 ",
            ll_fmt_atom_args()));
        return ff_t;
    }
    if (cn == "fmt_register") {
        var fr_s: string = emit_lle(ae[1]);
        llfb(sb_cat6("  call void @tll_fmt_register(i32 ", fid_arg_code(ae[0], "kind"),
            ", ptr ", fr_s, ", i32 ", sb_cat2(fid_arg_code(ae[2], "fmt"), ")")));
        return "0";
    }
    if (cn == "flag_get" || cn == "flag_set") {
        var mn: Node = nodes[ae[1]];
        var slot: i64 = -1;
        if (mn.kind == "member") {
            var ob: Node = nodes[mn.na];
            if (ob.kind == "ident") {
                slot = llfl_find(ob.sa, mn.sa);
            }
        }
        if (slot < 0) {
            llfb("  ; UNSUPPORTED flag slot");
            return "0";
        }
        var ftd: i64 = ll_etd(ae[0]);
        var un: string = td_sname(ftd);
        if (un == "") {
            un = "u32";
        }
        var fty: string = scalar_to_ll(un);
        var bits: i64 = ll_bits(un);
        var start: i64 = llfl_start[slot];
        var mval: i64 = js_max_val(llfl_len[slot]);
        var m: i64 = mval * pow2_i64(start);
        if (cn == "flag_get") {
            var fv: string = emit_lle(ae[0]);
            var g1: string = ll_tmp();
            llfb(sb_cat6("  ", g1, " = lshr ", fty, " ", sb_cat4(fv, ", ", i2s(start), "")));
            var g2: string = ll_tmp();
            llfb(sb_cat6("  ", g2, " = and ", fty, " ", sb_cat4(g1, ", ", ll_iconst(mval, bits), "")));
            var utd: i64 = td_named_mk("scalar", un);
            var u32td: i64 = td_named_mk("scalar", "u32");
            return ll_cast_v(g2, utd, u32td);
        }
        var ad0: string = ll_addr(ae[0]);
        var old: string = ll_load(fty, ad0);
        var notm: i64 = 0 - m - 1;
        var s1: string = ll_tmp();
        llfb(sb_cat6("  ", s1, " = and ", fty, " ", sb_cat4(old, ", ", i2s(notm), "")));
        var xv: string = emit_lle(ae[2]);
        var utd2: i64 = td_named_mk("scalar", un);
        xv = ll_cast_v(xv, ll_etd(ae[2]), utd2);
        var s2: string = ll_tmp();
        llfb(sb_cat6("  ", s2, " = shl ", fty, " ", sb_cat4(xv, ", ", i2s(start), "")));
        var s3: string = ll_tmp();
        llfb(sb_cat6("  ", s3, " = and ", fty, " ", sb_cat4(s2, ", ", ll_iconst(m, bits), "")));
        var s4: string = ll_tmp();
        llfb(sb_cat6("  ", s4, " = or ", fty, " ", sb_cat4(s1, ", ", s3, "")));
        llfb(sb_cat6("  store ", fty, " ", s4, ", ptr ", ad0));
        return "0";
    }
    if (cn == "assert_eq" || cn == "assert_true" || cn == "assert_false" || cn == "assert_panic") {
        llfb("  ; assert (test-only, no-op in llvm backend)");
        return "0";
    }
    if (llv_match(cn)) {
        var vi: i64 = ll_vm_i;
        var vty: string = sb_cat2("%vt.", llv_v[vi]);
        if (ll_vm_kind == "from") {
            var scv: string = ll_scratch(vty);
            llfb(sb_cat4("  store ", vty, " zeroinitializer, ptr ", scv));
            var tp: string = ll_tmp();
            llfb(sb_cat6("  ", tp, " = getelementptr inbounds ", vty, ", ptr ", sb_cat2(scv, ", i32 0, i32 0")));
            llfb(sb_cat6("  store i64 ", i2s(llv_tag[vi]), ", ptr ", tp, "", ""));
            if (llv_ptd[vi] >= 0 && argc > 0) {
                var ppp: string = ll_tmp();
                llfb(sb_cat6("  ", ppp, " = getelementptr inbounds ", vty, ", ptr ", sb_cat2(scv, ", i32 0, i32 1")));
                var ptd: i64 = llv_ptd[vi];
                var pty: string = ll_td(ptd);
                if (ll_isagg(ptd)) {
                    var pv: string = emit_lle(ae[0]);
                    ll_copy(pty, pv, ppp);
                } else {
                    var pv2: string = emit_lle(ae[0]);
                    pv2 = ll_cast_v(pv2, ll_etd(ae[0]), ptd);
                    llfb(sb_cat6("  store ", pty, " ", pv2, ", ptr ", ppp));
                }
            }
            return scv;
        }
        var vp: string = emit_lle(ae[0]);
        if (ll_vm_kind == "is") {
            var tp2: string = ll_tmp();
            llfb(sb_cat6("  ", tp2, " = getelementptr inbounds ", vty, ", ptr ", sb_cat2(vp, ", i32 0, i32 0")));
            var tv: string = ll_load("i64", tp2);
            var ic: string = ll_tmp();
            llfb(sb_cat6("  ", ic, " = icmp eq i64 ", tv, ", ", i2s(llv_tag[vi])));
            return ll_b8(ic);
        }
        var pp2: string = ll_tmp();
        llfb(sb_cat6("  ", pp2, " = getelementptr inbounds ", vty, ", ptr ", sb_cat2(vp, ", i32 0, i32 1")));
        var ptd2: i64 = llv_ptd[vi];
        if (ptd2 >= 0) {
            if (ll_isagg(ptd2)) {
                return pp2;
            }
            return ll_load(ll_td(ptd2), pp2);
        }
        return "0";
    }
    // 间接调用：被调者是函数类型的变量（函数指针）。局部优先，其次全局。
    var iftd: i64 = -1;
    if (em_in_fn) {
        iftd = fs_get(em_cur_fn, mb_sub(cn));
    }
    if (td_is_func(iftd) == false) {
        var igv: i64 = llgv_find(mb_sub(cn));
        if (igv >= 0) {
            iftd = llgv_td[igv];
        }
    }
    if (td_is_func(iftd)) {
        return ll_call_indirect(e, iftd);
    }
    // 用户函数：模块内按值传递聚合
    var fi: i64 = llfn_find(cn);
    if (fi >= 0) {
        var rtd: i64 = llfn_r[fi];
        var ps: i64 = llfn_ps[fi];
        var pc: i64 = llfn_pc[fi];
        var csb: StringBuilder = sb_new();
        var i: i64 = 0;
        while (i < argc) {
            if (i > 0) {
                sb_append_str(csb, ", ");
            }
            var ptd3: i64 = -1;
            if (i < pc) {
                ptd3 = llfp_td[ps + i];
            }
            var aty: string = ll_td(ptd3);
            var avv: string = emit_lle(ae[i]);
            if (ptd3 >= 0 && ll_isagg(ptd3)) {
                avv = ll_load(aty, avv);
            } else {
                avv = ll_cast_v(avv, ll_etd(ae[i]), ptd3);
            }
            sb_append_str(csb, aty);
            sb_append_str(csb, " ");
            sb_append_str(csb, avv);
            i = i + 1;
        }
        var rty: string = ll_td(rtd);
        var argstr: string = sb_to_str(csb);
        if (rty == "void") {
            llfb(sb_cat6("  call void @t.", cn, "(", argstr, ")", ""));
            return "0";
        }
        var t7: string = ll_tmp();
        var line: StringBuilder = sb_new();
        sb_append_str(line, "  ");
        sb_append_str(line, t7);
        sb_append_str(line, " = call ");
        sb_append_str(line, rty);
        sb_append_str(line, " @t.");
        sb_append_str(line, cn);
        sb_append_str(line, "(");
        sb_append_str(line, argstr);
        sb_append_str(line, ")");
        llfb(sb_to_str(line));
        if (ll_isagg(rtd)) {
            var sc2: string = ll_scratch(rty);
            llfb(sb_cat6("  store ", rty, " ", t7, ", ptr ", sc2));
            return sc2;
        }
        return t7;
    }
    llfb(sb_cat2("  ; UNSUPPORTED call ", cn));
    return "0";
}

// 2^n（flag 掩码用；n < 63）
pow2_i64 fn(n: i64) -> i64 {
    var r: i64 = 1;
    var i: i64 = 0;
    while (i < n) {
        r = r * 2;
        i = i + 1;
    }
    return r;
}

// ── 循环目标栈（brk/cnt 成对维护）──────────────────────────────

ll_loop_push2 fn(brk: string, cnt: string) -> void {
    if (ll_loopd < slice_len(llbrk) as i64) {
        slice_set(llbrk, ll_loopd, brk);
        slice_set(llcnt, ll_loopd, cnt);
    } else {
        append(llbrk, brk);
        append(llcnt, cnt);
    }
    ll_loopd = ll_loopd + 1;
}

ll_loop_pop fn() -> void {
    ll_loopd = ll_loopd - 1;
}

// ── 局部变量声明（alloca 进 entry，初始化留当前块）─────────────

// map 字面量构建：在 mdp 中建 TMap* 并逐项 tll_map_put。keytd/valtd 为 TD 索引。
ll_build_map_lit fn(en: i64, mdp: string, keytd: i64, valtd: i64) -> void {
    var mdkk: i64 = 0;
    if (tds[keytd].cat != "string") { mdkk = 1; }
    var mdvty: string = ll_td(valtd);
    llfb(sb_cat5(sb_cat4("  ", mdp, " = call ptr @tll_map_new(i64 ", i2s(mdkk)), ", i64 ", ll_sizeof(mdvty), ")", ""));
    var mdn: Node = nodes[en];
    var mdc: i64 = mdn.la;
    while (mdc >= 0) {
        var mdck: Child = kids[mdc];
        var mden: Node = nodes[mdck.val];
        var mdkp: string = ll_map_keyptr(mden.na, keytd);
        var mdvp: string = ll_map_argptr(mden.nb, valtd);
        llfb(sb_cat5(sb_cat4("  call void @tll_map_put(ptr ", mdp, ", ptr ", mdkp), ", ptr ", mdvp, ")", ""));
        mdc = mdck.next;
    }
}

ll_local_decl fn(name: string, td: i64, init_e: i64) -> void {
    var ty: string = ll_td(td);
    var vn: string = sb_cat2("%v.", name);
    if (lla_has(name) == false) {
        append(lla_n, name);
        llfa(sb_cat4("  ", vn, " = alloca ", ty));
    }
    var t0: TD = tds[td];
    // 定长数组：先整体零初始化，再按 GEP 逐元素 store
    if (t0.cat == "array") {
        llfb(sb_cat6("  store ", ty, " ", ll_zero(ty), ", ptr ", vn));
        if (is_array_lit(init_e)) {
            var aety: string = "i64";
            if (t0.elem >= 0) {
                aety = ll_td(t0.elem);
            }
            var an1: Node = nodes[init_e];
            var cc1: i64 = an1.la;
            var ix1: i64 = 0;
            while (cc1 >= 0) {
                var ck1: Child = kids[cc1];
                var gp1: string = ll_tmp();
                llfb(sb_cat6(sb_cat4("  ", gp1, " = getelementptr ", ty), ", ptr ", vn, ", i64 0, i64 ", i2s(ix1), ""));
                if (ll_isagg(t0.elem)) {
                    ll_copy(aety, emit_lle(ck1.val), gp1);
                } else {
                    var av1: string = emit_lle(ck1.val);
                    if (t0.elem >= 0) {
                        av1 = ll_cast_v(av1, ll_etd(ck1.val), t0.elem);
                    }
                    llfb(sb_cat6("  store ", aety, " ", av1, ", ptr ", gp1));
                }
                ix1 = ix1 + 1;
                cc1 = ck1.next;
            }
        }
        return;
    }
    // map：`var m: map[K]V;` 建空表；`= [k: v, ...]` 建表后逐项插入
    if (t0.cat == "map") {
        if (init_e < 0 || is_map_lit(init_e)) {
            var mdp: string = ll_tmp();
            if (init_e < 0) {
                var mdkk2: i64 = 0;
                if (tds[t0.key].cat != "string") { mdkk2 = 1; }
                llfb(sb_cat5(sb_cat4("  ", mdp, " = call ptr @tll_map_new(i64 ", i2s(mdkk2)), ", i64 ", ll_sizeof(ll_td(t0.val)), ")", ""));
            } else {
                ll_build_map_lit(init_e, mdp, t0.key, t0.val);
            }
            llfb(sb_cat4("  store ptr ", mdp, ", ptr ", vn));
            return;
        }
    }
    // 切片字面量：`var xs: []T = [a, b, c];` → slice_new + 逐元素 append
    if (t0.cat == "slice" && is_array_lit(init_e)) {
        var ety0: string = "i64";
        if (t0.elem >= 0) {
            ety0 = ll_td(t0.elem);
        }
        llfb(sb_cat6("  call void @tll_slice_new(i64 ", ll_sizeof(ety0), ", ptr ", vn, ")", ""));
        var ln0: Node = nodes[init_e];
        var cc0: i64 = ln0.la;
        while (cc0 >= 0) {
            var ck0: Child = kids[cc0];
            var ep0: string = "";
            if (ll_isagg(t0.elem)) {
                ep0 = emit_lle(ck0.val);
            } else {
                var v0: string = emit_lle(ck0.val);
                if (t0.elem >= 0) {
                    v0 = ll_cast_v(v0, ll_etd(ck0.val), t0.elem);
                }
                var sc0: string = ll_scratch(ety0);
                llfb(sb_cat6("  store ", ety0, " ", v0, ", ptr ", sc0));
                ep0 = sc0;
            }
            var asb0: StringBuilder = sb_new();
            sb_append_str(asb0, "  call void @tll_slice_append(ptr ");
            sb_append_str(asb0, vn);
            sb_append_str(asb0, ", ptr ");
            sb_append_str(asb0, ep0);
            sb_append_str(asb0, ", i64 ");
            sb_append_str(asb0, ll_sizeof(ety0));
            sb_append_str(asb0, ")");
            llfb(sb_to_str(asb0));
            cc0 = ck0.next;
        }
        return;
    }
    // Sym = string : 自动 intern（LHS 存 id）。Sym=Sym（同池）/ 无初始化
    // 由下面通用 id 拷贝 / 零值路径处理（td_sname(sym)=="" → ll_cast_v 原样返回）。
    if (t0.cat == "sym" && init_e >= 0) {
        var isymtd: i64 = ll_etd(init_e);
        if (isymtd >= 0 && tds[isymtd].cat == "string") {
            var symtagp: string = ll_strlit(t0.name);
            var symv: string = emit_lle(init_e);
            var symbits: string = i2s(t0.alen);
            var symid: string = ll_tmp();
            llfb(sb_cat6("  ", symid, " = call i32 @tll_sym_intern(ptr ", symtagp, ", ptr ", sb_cat3(symv, ", i64 ", sb_cat2(symbits, ")"))));
            var symstored: string = symid;
            if (ty == "i16") {
                symstored = ll_tmp();
                llfb(sb_cat4("  ", symstored, " = trunc i32 ", sb_cat2(symid, " to i16")));
            }
            llfb(sb_cat6("  store ", ty, " ", symstored, ", ptr ", vn));
            return;
        }
    }
    if (init_e >= 0) {
        var v: string = emit_lle(init_e);
        if (ll_isagg(td)) {
            ll_copy(ty, v, vn);
        } else {
            v = ll_cast_v(v, ll_etd(init_e), td);
            llfb(sb_cat6("  store ", ty, " ", v, ", ptr ", vn));
        }
        return;
    }
    var t: TD = tds[td];
    if (t.cat == "slice") {
        var ety: string = "i64";
        if (t.elem >= 0) {
            ety = ll_td(t.elem);
        }
        llfb(sb_cat6("  call void @tll_slice_new(i64 ", ll_sizeof(ety), ", ptr ", vn, ")", ""));
        return;
    }
    llfb(sb_cat6("  store ", ty, " ", ll_zero(ty), ", ptr ", vn));
}

// ── 语句发射 ───────────────────────────────────────────────────

emit_llstmt fn(sid: i64) -> void {
    if (ll_term) {
        ll_open();
    }
    var n: Node = nodes[sid];

    // defer：登记到延迟栈，待 return / 函数尾按 LIFO 运行（见 emit_llfunc_decl 收尾）
    if (n.kind == "defer") {
        if (g_defer_ll_n < 1024) {
            g_defer_ll[g_defer_ll_n] = sid;
            g_defer_ll_n = g_defer_ll_n + 1;
        }
        return;
    }
    // comptime_block：无 CTFE，退化为运行期内联块（避免被静默丢弃）
    if (n.kind == "comptime_block") {
        var cb: i64 = n.la;
        while (cb >= 0) {
            var ckb: Child = kids[cb];
            emit_llstmt(ckb.val);
            cb = ckb.next;
        }
        return;
    }

    if (n.kind == "expr") {
        var xx: string = emit_lle(n.na);
        xx = "";
        return;
    }
    // 闭包体首（M48）：从环境结构按值拷回捕获变量，成为普通局部
    if (n.kind == "closure_capture") {
        if (n.na >= 0) {
            var cctd: i64 = resolve_type_desc(n.na);
            var ccty: string = ll_td(cctd);
            var ccvn: string = sb_cat2("%v.", n.sa);
            if (lla_has(n.sa) == false) {
                append(lla_n, n.sa);
                llfa(sb_cat4("  ", ccvn, " = alloca ", ccty));
            }
            var ccgp: string = ll_tmp();
            llfb(sb_cat3(sb_cat4("  ", ccgp, " = getelementptr inbounds %st.", n.sb),
                ", ptr %__env, i32 0, i32 ", i2s(n.ia)));
            ll_copy(ccty, ccgp, ccvn);
        }
        return;
    }
    if (n.kind == "var_decl") {
        if (n.na >= 0) {
            ll_local_decl(n.sa, resolve_type_desc(n.na), n.nb);
        }
        return;
    }
    if (n.kind == "assignment") {
        var op: string = n.sa;
        var ltd: i64 = ll_etd(n.na);
        var lty: string = ll_td(ltd);
        if (op == "=") {
            // m[k] = v : map 索引写须走 tll_map_put（find-or-insert），不能对读值再存回
            if (n.na >= 0) {
                var ln: Node = nodes[n.na];
                if (ln.kind == "index") {
                    var lotd: i64 = ll_etd(ln.na);
                    var lott: TD = tds[lotd];
                    if (lott.cat == "map") {
                        var mp: string = emit_lle(ln.na);
                        var kp: string = ll_map_keyptr(ln.nb, lott.key);
                        var vp: string = ll_map_argptr(n.nb, lott.val);
                        llfb(sb_cat6("  call void @tll_map_put(ptr ", mp, ", ptr ", kp, ", ptr ", sb_cat2(vp, ")")));
                        return;
                    }
                }
            }
            var v: string = emit_lle(n.nb);
            var ad: string = ll_addr(n.na);
            if (ll_isagg(ltd)) {
                ll_copy(lty, v, ad);
            } else {
                v = ll_cast_v(v, ll_etd(n.nb), ltd);
                llfb(sb_cat6("  store ", lty, " ", v, ", ptr ", ad));
            }
            return;
        }
        // 复合赋值：load-op-store
        var bop: string = str_slice(op, 0, str_len(op) - 1);
        var ad2: string = ll_addr(n.na);
        var old: string = ll_load(lty, ad2);
        var rv: string = emit_lle(n.nb);
        rv = ll_cast_v(rv, ll_etd(n.nb), ltd);
        var sn: string = td_sname(ltd);
        if (sn == "") {
            sn = "i64";
        }
        var ins: string = ll_arith_ins(bop, sn);
        if (ins == "") {
            llfb("  ; UNSUPPORTED compound assign");
            return;
        }
        var t: string = ll_tmp();
        llfb(sb_cat6("  ", t, " = ", ins, " ", sb_cat6(lty, " ", old, ", ", rv, "")));
        llfb(sb_cat6("  store ", lty, " ", t, ", ptr ", ad2));
        return;
    }
    if (n.kind == "if") {
        var cv: string = emit_lle(n.na);
        var c1: string = ll_to_i1(cv);
        var thenL: string = ll_lbl("if.t");
        var endL: string = ll_lbl("if.e");
        var elseL: string = endL;
        var has_else: bool = n.lb > -2;
        if (has_else) {
            elseL = ll_lbl("if.f");
        }
        llfb(sb_cat6("  br i1 ", c1, ", label %", thenL, ", label %", elseL));
        ll_term = true;
        ll_label(thenL);
        var tb: i64 = n.la;
        while (tb >= 0) {
            var tk: Child = kids[tb];
            emit_llstmt(tk.val);
            tb = tk.next;
        }
        if (ll_term == false) {
            llfb(sb_cat2("  br label %", endL));
            ll_term = true;
        }
        if (has_else) {
            ll_label(elseL);
            var eb: i64 = n.lb;
            while (eb >= 0) {
                var ek: Child = kids[eb];
                emit_llstmt(ek.val);
                eb = ek.next;
            }
            if (ll_term == false) {
                llfb(sb_cat2("  br label %", endL));
                ll_term = true;
            }
        }
        ll_label(endL);
        return;
    }
    if (n.kind == "while") {
        var condL: string = ll_lbl("wh.c");
        var bodyL: string = ll_lbl("wh.b");
        var endL2: string = ll_lbl("wh.e");
        llfb(sb_cat2("  br label %", condL));
        ll_label(condL);
        var cv2: string = emit_lle(n.na);
        var c2: string = ll_to_i1(cv2);
        llfb(sb_cat6("  br i1 ", c2, ", label %", bodyL, ", label %", endL2));
        ll_term = true;
        ll_label(bodyL);
        ll_loop_push2(endL2, condL);
        var wb: i64 = n.la;
        while (wb >= 0) {
            var wk: Child = kids[wb];
            emit_llstmt(wk.val);
            wb = wk.next;
        }
        ll_loop_pop();
        if (ll_term == false) {
            llfb(sb_cat2("  br label %", condL));
            ll_term = true;
        }
        ll_label(endL2);
        return;
    }
    if (n.kind == "for") {
        if (n.na >= 0) {
            var ini: Node = nodes[n.na];
            if (ini.kind == "var_decl") {
                if (ini.na >= 0) {
                    ll_local_decl(ini.sa, resolve_type_desc(ini.na), ini.nb);
                }
            }
            if (ini.kind == "expr") {
                var xi: string = emit_lle(ini.na);
                xi = "";
            }
        }
        var condL2: string = ll_lbl("fo.c");
        var bodyL2: string = ll_lbl("fo.b");
        var stepL: string = ll_lbl("fo.s");
        var endL3: string = ll_lbl("fo.e");
        llfb(sb_cat2("  br label %", condL2));
        ll_label(condL2);
        if (n.nb >= 0) {
            var cv3: string = emit_lle(n.nb);
            var c3: string = ll_to_i1(cv3);
            llfb(sb_cat6("  br i1 ", c3, ", label %", bodyL2, ", label %", endL3));
        } else {
            llfb(sb_cat2("  br label %", bodyL2));
        }
        ll_term = true;
        ll_label(bodyL2);
        ll_loop_push2(endL3, stepL);
        var fb2: i64 = n.la;
        while (fb2 >= 0) {
            var fk: Child = kids[fb2];
            emit_llstmt(fk.val);
            fb2 = fk.next;
        }
        ll_loop_pop();
        if (ll_term == false) {
            llfb(sb_cat2("  br label %", stepL));
            ll_term = true;
        }
        ll_label(stepL);
        if (n.nc >= 0) {
            var xu: string = emit_lle(n.nc);
            xu = "";
        }
        llfb(sb_cat2("  br label %", condL2));
        ll_term = true;
        ll_label(endL3);
        return;
    }
    if (n.kind == "for_each") {
        var itd0: i64 = ll_etd(n.na);
        var it0: TD = tds[itd0];
        var etd: i64 = -1;
        if (it0.cat == "slice") {
            etd = it0.elem;
        }
        // map 的 for-in：按插入序迭代键（tll_map_count + tll_map_key_*_at）
        if (it0.cat == "map") {
            var mfkd: i64 = it0.key;
            var mfkty: string = ll_td(mfkd);
            var mfiter: string = emit_lle(n.na);
            var mfcnt: string = ll_tmp();
            llfb(sb_cat4("  ", mfcnt, " = call i64 @tll_map_count(ptr ", sb_cat2(mfiter, ")")));
            var mfidx: string = ll_scratch("i64");
            llfb(sb_cat2("  store i64 0, ptr ", mfidx));
            if (lla_has(n.sa) == false) {
                append(lla_n, n.sa);
                llfa(sb_cat4("  %v.", n.sa, " = alloca ", mfkty));
            }
            var mfvn: string = sb_cat2("%v.", n.sa);
            var mfcL: string = ll_lbl("fm.c");
            var mfbL: string = ll_lbl("fm.b");
            var mfsL: string = ll_lbl("fm.s");
            var mfeL: string = ll_lbl("fm.e");
            llfb(sb_cat2("  br label %", mfcL));
            ll_label(mfcL);
            var mfi: string = ll_load("i64", mfidx);
            var mfcc: string = ll_tmp();
            llfb(sb_cat6("  ", mfcc, " = icmp slt i64 ", mfi, ", ", mfcnt));
            llfb(sb_cat6("  br i1 ", mfcc, ", label %", mfbL, ", label %", mfeL));
            ll_term = true;
            ll_label(mfbL);
            var mfi2: string = ll_load("i64", mfidx);
            if (tds[mfkd].cat == "string") {
                llfb(sb_cat5(sb_cat4("  call void @tll_map_key_str_at(ptr ", mfiter, ", i64 ", mfi2), ", ptr ", mfvn, ")", ""));
            } else {
                var mfkv: string = ll_tmp();
                llfb(sb_cat5(sb_cat4("  ", mfkv, " = call i64 @tll_map_key_int_at(ptr ", mfiter), ", i64 ", mfi2, ")", ""));
                var mfsv: string = mfkv;
                if (mfkty != "i64") {
                    var mftr: string = ll_tmp();
                    llfb(sb_cat6("  ", mftr, " = trunc i64 ", mfkv, " to ", mfkty));
                    mfsv = mftr;
                }
                llfb(sb_cat6("  store ", mfkty, " ", mfsv, ", ptr ", mfvn));
            }
            // 双变量形式 `for (k, v in m)`：v 由插入序下标直接取值
            if (str_len(n.sb) > 0) {
                var mfvd: i64 = it0.val;
                var mfvty: string = ll_td(mfvd);
                var mfvvn: string = sb_cat2("%v.", n.sb);
                if (lla_has(n.sb) == false) {
                    append(lla_n, n.sb);
                    llfa(sb_cat4("  ", mfvvn, " = alloca ", mfvty));
                }
                var mfvp: string = ll_tmp();
                llfb(sb_cat5(sb_cat4("  ", mfvp, " = call ptr @tll_map_val_at(ptr ", mfiter), ", i64 ", mfi2, ")", ""));
                if (ll_isagg(mfvd)) {
                    ll_copy(mfvty, mfvp, mfvvn);
                } else {
                    var mfvv: string = ll_load(mfvty, mfvp);
                    llfb(sb_cat6("  store ", mfvty, " ", mfvv, ", ptr ", mfvvn));
                }
            }
            ll_loop_push2(mfeL, mfsL);
            var mfbb: i64 = n.la;
            while (mfbb >= 0) {
                var mfbk2: Child = kids[mfbb];
                emit_llstmt(mfbk2.val);
                mfbb = mfbk2.next;
            }
            ll_loop_pop();
            if (ll_term == false) {
                llfb(sb_cat2("  br label %", mfsL));
                ll_term = true;
            }
            ll_label(mfsL);
            var mfi3: string = ll_load("i64", mfidx);
            var mfi4: string = ll_tmp();
            llfb(sb_cat4("  ", mfi4, " = add i64 ", sb_cat2(mfi3, ", 1")));
            llfb(sb_cat5("  store i64 ", mfi4, ", ptr ", mfidx, ""));
            llfb(sb_cat2("  br label %", mfcL));
            ll_term = true;
            ll_label(mfeL);
            return;
        }
        var ety: string = "i64";
        if (etd >= 0) {
            ety = ll_td(etd);
        }
        var iter: string = emit_lle(n.na);
        var lenv: string = ll_tmp();
        llfb(sb_cat4("  ", lenv, " = call i64 @tll_slice_len(ptr ", sb_cat2(iter, ")")));
        var idx: string = ll_scratch("i64");
        llfb(sb_cat3("  store i64 0, ptr ", idx, ""));
        if (lla_has(n.sa) == false) {
            append(lla_n, n.sa);
            llfa(sb_cat4("  %v.", n.sa, " = alloca ", ety));
        }
        var condL3: string = ll_lbl("fe.c");
        var bodyL3: string = ll_lbl("fe.b");
        var stepL2: string = ll_lbl("fe.s");
        var endL4: string = ll_lbl("fe.e");
        llfb(sb_cat2("  br label %", condL3));
        ll_label(condL3);
        var iv: string = ll_load("i64", idx);
        var cc: string = ll_tmp();
        llfb(sb_cat6("  ", cc, " = icmp slt i64 ", iv, ", ", lenv));
        llfb(sb_cat6("  br i1 ", cc, ", label %", bodyL3, ", label %", endL4));
        ll_term = true;
        ll_label(bodyL3);
        var iv2: string = ll_load("i64", idx);
        var ep: string = ll_tmp();
        llfb(sb_cat6("  ", ep, " = call ptr @tll_slice_at(ptr ", iter, ", i64 ", sb_cat2(iv2, ")")));
        ll_copy(ety, ep, sb_cat2("%v.", n.sa));
        ll_loop_push2(endL4, stepL2);
        var bb: i64 = n.la;
        while (bb >= 0) {
            var bk: Child = kids[bb];
            emit_llstmt(bk.val);
            bb = bk.next;
        }
        ll_loop_pop();
        if (ll_term == false) {
            llfb(sb_cat2("  br label %", stepL2));
            ll_term = true;
        }
        ll_label(stepL2);
        var iv3: string = ll_load("i64", idx);
        var iv4: string = ll_tmp();
        llfb(sb_cat4("  ", iv4, " = add i64 ", sb_cat2(iv3, ", 1")));
        llfb(sb_cat6("  store i64 ", iv4, ", ptr ", idx, "", ""));
        llfb(sb_cat2("  br label %", condL3));
        ll_term = true;
        ll_label(endL4);
        return;
    }
    if (n.kind == "return") {
        // 运行延迟语句（defer）LIFO：后登记的先执行
        var di: i64 = g_defer_ll_n - 1;
        while (di >= 0) {
            var dnode: Node = nodes[g_defer_ll[di]];
            var dbb: i64 = dnode.la;
            while (dbb >= 0) {
                var dbk: Child = kids[dbb];
                emit_llstmt(dbk.val);
                dbb = dbk.next;
            }
            di = di - 1;
        }
        g_defer_ll_n = 0;
        var rty: string = ll_td(ll_cur_ret);
        if (n.na < 0 || rty == "void") {
            llfb("  ret void");
            ll_term = true;
            return;
        }
        var rv2: string = emit_lle(n.na);
        if (ll_isagg(ll_cur_ret)) {
            var rl: string = ll_load(rty, rv2);
            llfb(sb_cat4("  ret ", rty, " ", rl));
        } else {
            rv2 = ll_cast_v(rv2, ll_etd(n.na), ll_cur_ret);
            llfb(sb_cat4("  ret ", rty, " ", rv2));
        }
        ll_term = true;
        return;
    }
    if (n.kind == "break") {
        llfb(sb_cat2("  br label %", llbrk[ll_loopd - 1]));
        ll_term = true;
        return;
    }
    if (n.kind == "continue") {
        llfb(sb_cat2("  br label %", llcnt[ll_loopd - 1]));
        ll_term = true;
        return;
    }
    if (n.kind == "block") {
        var bb2: i64 = n.la;
        while (bb2 >= 0) {
            var bk2: Child = kids[bb2];
            emit_llstmt(bk2.val);
            bb2 = bk2.next;
        }
        return;
    }
    // 其余未识别节点：不输出（fallthrough）
}

// ── 函数发射 ───────────────────────────────────────────────────

ll_reset_fn fn() -> void {
    var e1: []string;
    ll_fal = e1;
    var e2: []string;
    ll_fb = e2;
    var e3: []string;
    lla_n = e3;
    var e4: []string;
    llbrk = e4;
    var e5: []string;
    llcnt = e5;
    ll_loopd = 0;
    ll_tmpc = 0;
    ll_lblc = 0;
    ll_scc = 0;
    ll_cur_blk = "entry";
    ll_term = false;
}

emit_llfunc fn(d: i64) -> void {
    var n: Node = nodes[d];
    var fi: i64 = llfn_find(n.sa);
    var rtd: i64 = -1;
    if (fi >= 0) {
        rtd = llfn_r[fi];
    }
    var rty: string = ll_td(rtd);

    // 签名
    var psb: StringBuilder = sb_new();
    var cnt: i64 = 0;
    // 闭包合成函数（M48）：sb 记环境结构名 → 前置 env 首参（与 TClosure ABI 一致）。
    // %__env 直接当 ptr 用，无需 alloca；closure_capture 语句会从中拷回捕获量。
    if (str_len(n.sb) > 0) {
        sb_append_str(psb, "ptr %__env");
        cnt = 1;
    }
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var p: Node = nodes[k.val];
        if (cnt > 0) {
            sb_append_str(psb, ", ");
        }
        var ptd: i64 = resolve_type_desc(p.na);
        sb_append_str(psb, ll_td(ptd));
        sb_append_str(psb, " %p.");
        sb_append_str(psb, p.sa);
        cnt = cnt + 1;
        c = k.next;
    }
    var params: string = sb_to_str(psb);

    if (n.ba) {
        // extern：绑定 C 符号（无 t. 前缀），参数类型按同规则
        llph(sb_cat6("declare ", rty, " @", n.sa, "(", sb_cat2(params, ")")));
        return;
    }

    if (ann_find(n.la, "main") >= 0) {
        ll_has_main = true;
        ll_main_fn = n.sa;
    }

    ll_reset_fn();
    g_defer_ll_n = 0;   // 每个函数独立延迟栈
    em_cur_fn = n.sa;
    em_in_fn = true;
    ll_cur_ret = rtd;

    // 参数落地：alloca %v.x + store
    var c2: i64 = n.lb;
    while (c2 >= 0) {
        var k2: Child = kids[c2];
        var p2: Node = nodes[k2.val];
        var ptd2: i64 = resolve_type_desc(p2.na);
        var pty: string = ll_td(ptd2);
        append(lla_n, p2.sa);
        llfa(sb_cat6("  %v.", p2.sa, " = alloca ", pty, "", ""));
        llfb(sb_cat6("  store ", pty, " %p.", p2.sa, ", ptr %v.", p2.sa));
        c2 = k2.next;
    }

    if (n.lc > -2) {
        var b: i64 = n.lc;
        while (b >= 0) {
            var bk: Child = kids[b];
            emit_llstmt(bk.val);
            b = bk.next;
        }
    }
    // 函数体结束：运行剩余 defer（无显式 return 的路径）LIFO
    {
        var di: i64 = g_defer_ll_n - 1;
        while (di >= 0) {
            var dnode: Node = nodes[g_defer_ll[di]];
            var dbb: i64 = dnode.la;
            while (dbb >= 0) {
                var dbk: Child = kids[dbb];
                emit_llstmt(dbk.val);
                dbb = dbk.next;
            }
            di = di - 1;
        }
        g_defer_ll_n = 0;
    }
    if (ll_term == false) {
        if (rty == "void") {
            llfb("  ret void");
        } else {
            llfb(sb_cat4("  ret ", rty, " ", ll_zero(rty)));
        }
    }

    // 组装
    llpb(sb_cat6("define ", rty, " @t.", n.sa, "(", sb_cat2(params, ") {")));
    llpb("entry:");
    var na: i64 = slice_len(ll_fal) as i64;
    var i: i64 = 0;
    while (i < na) {
        llpb(ll_fal[i]);
        i = i + 1;
    }
    var nb: i64 = slice_len(ll_fb) as i64;
    var j: i64 = 0;
    while (j < nb) {
        llpb(ll_fb[j]);
        j = j + 1;
    }
    llpb("}");
    llpb("");
    em_in_fn = false;
    em_cur_fn = "";
}

// ── 类型定义 / 全局 / 模块编排 ─────────────────────────────────

emit_lltypes fn() -> void {
    var n: i64 = slice_len(llt_names) as i64;
    var i: i64 = 0;
    while (i < n) {
        var name: string = llt_names[i];
        var k: string = llt_kinds[i];
        if (k == "struct") {
            var sb: StringBuilder = sb_new();
            sb_append_str(sb, "%st.");
            sb_append_str(sb, name);
            sb_append_str(sb, " = type { ");
            var m: i64 = slice_len(llsf_st) as i64;
            var j: i64 = 0;
            var first: bool = true;
            while (j < m) {
                if (llsf_st[j] == name) {
                    if (first == false) {
                        sb_append_str(sb, ", ");
                    }
                    sb_append_str(sb, ll_td(llsf_td[j]));
                    first = false;
                }
                j = j + 1;
            }
            if (first) {
                sb_append_str(sb, "i8");
            }
            sb_append_str(sb, " }");
            llph(sb_to_str(sb));
        }
        if (k == "variant") {
            var sb2: StringBuilder = sb_new();
            sb_append_str(sb2, "%vt.");
            sb_append_str(sb2, name);
            sb_append_str(sb2, " = type { i64, [");
            sb_append_i64(sb2, ll_variant_paymax(name));
            sb_append_str(sb2, " x i8] }");
            llph(sb_to_str(sb2));
        }
        if (k == "union") {
            var sb3: StringBuilder = sb_new();
            sb_append_str(sb3, "%un.");
            sb_append_str(sb3, name);
            sb_append_str(sb3, " = type { [");
            sb_append_i64(sb3, ll_union_max(name));
            sb_append_str(sb3, " x i8] }");
            llph(sb_to_str(sb3));
        }
        i = i + 1;
    }
}

emit_lldeclares fn() -> void {
    llph("declare void @tll_print(ptr)");
    llph("declare void @tll_eprint(ptr)");
    llph("declare void @tll_println(ptr)");
    llph("declare i64 @tll_str_len(ptr)");
    llph("declare i64 @tll_str_at(ptr, i64)");
    llph("declare i32 @tll_str_eq(ptr, ptr)");
    llph("declare void @tll_str_slice(ptr, i64, i64, ptr)");
    llph("declare ptr @tll_sb_new()");
    llph("declare void @tll_sb_append_str(ptr, ptr)");
    llph("declare void @tll_sb_append_char(ptr, i64)");
    llph("declare void @tll_sb_append_u64(ptr, i64)");
    llph("declare void @tll_sb_append_i64(ptr, i64)");
    llph("declare void @tll_sb_to_str(ptr, ptr)");
    llph("declare void @tll_int_to_str(i64, ptr)");
    // 格式化（Python 格式规范迷你语言子集）
    llph("declare void @tll_format_int(ptr, i64, ptr)");
    llph("declare void @tll_format_time(ptr, i64, i64, ptr)");
    llph("declare void @tll_format_time_tz(ptr, i64, i64, ptr)");
    llph("declare i64 @tll_parse_time(ptr, ptr, i64)");
    llph("declare i64 @tll_now()");
    llph("declare void @tll_format_uint(ptr, i64, ptr)");
    llph("declare void @tll_format_float(ptr, double, ptr)");
    llph("declare void @tll_format_str(ptr, ptr, ptr)");
    llph("declare void @tll_format_bool(ptr, i8, ptr)");
    llph("declare void @tll_format_char(ptr, i64, ptr)");
    llph("declare void @tll_sb_append_fmt_int(ptr, ptr, i64)");
    llph("declare void @tll_sb_append_fmt_uint(ptr, ptr, i64)");
    llph("declare void @tll_sb_append_fmt_float(ptr, ptr, double)");
    llph("declare void @tll_sb_append_fmt_str(ptr, ptr, ptr)");
    llph("declare void @tll_sb_append_fmt_bool(ptr, ptr, i8)");
    llph("declare void @tll_sb_append_fmt_char(ptr, ptr, i64)");
    llph("declare void @tll_sb_clear(ptr)");
    llph("declare void @tll_slice_new(i64, ptr)");
    llph("declare void @tll_slice_append(ptr, ptr, i64)");
    llph("declare ptr @tll_slice_at(ptr, i64)");
    llph("declare void @tll_slice_set(ptr, i64, ptr)");
    llph("declare i64 @tll_slice_len(ptr)");
    llph("declare ptr @tll_map_new(i64, i64)");
    llph("declare void @tll_map_put(ptr, ptr, ptr)");
    llph("declare ptr @tll_map_val_ptr(ptr, ptr)");
    llph("declare i32 @tll_map_has(ptr, ptr)");
    llph("declare i64 @tll_map_len(ptr)");
    llph("declare i32 @tll_map_del(ptr, ptr)");
    llph("declare i64 @tll_map_count(ptr)");
    llph("declare void @tll_map_key_str_at(ptr, i64, ptr)");
    llph("declare i64 @tll_map_key_int_at(ptr, i64)");
    llph("declare ptr @tll_map_val_at(ptr, i64)");
    llph("declare void @tll_file_read_all(ptr, ptr)");
    llph("declare i32 @tll_file_write_all(ptr, ptr)");
    llph("declare i32 @tll_file_exists(ptr)");
    // Sym：字符串驻留符号池（M40）
    llph("declare i32 @tll_sym_intern(ptr, ptr, i64)");
    llph("declare void @tll_sym_str(ptr, i32, ptr)");
    llph("declare void @tll_sym_release(ptr)");
    llph("declare void @tll_sym_release_all()");
    // Atom：全局符号表（编译期 intern 的稳定 i64 id → 名字还原）
    llph("declare void @tll_atom_str(i64, ptr)");
    // Fid：文件描述符句柄 + 序列化操作符（M51）。ser_* 一律返回目标 fid 以支持链式。
    llph("declare i64 @tll_fopen(ptr, i32)");
    llph("declare void @tll_fclose(i64)");
    llph("declare void @tll_fflush(i64)");
    llph("declare i32 @tll_fid_is_open(i64)");
    llph("declare void @tll_fid_error(i64, ptr)");
    llph("declare i32 @tll_fid_eof(i64)");
    llph("declare i32 @tll_fseek(i64, i64)");
    llph("declare i64 @tll_ftell(i64)");
    llph("declare i64 @tll_fid_format(i64, i64, i64, i64, i64)");
    llph("declare void @tll_fmt_register(i32, ptr, i32)");
    llph("declare i64 @tll_ser_int(i64, i64, i32, i32)");
    llph("declare i64 @tll_ser_f64(i64, double, i32)");
    llph("declare i64 @tll_ser_bool(i64, i8)");
    llph("declare i64 @tll_ser_atom(i64, i64)");
    llph("declare i64 @tll_ser_str(i64, ptr)");
    llph("declare i64 @tll_deser_int(i64, i32, i32)");
    llph("declare double @tll_deser_f64(i64, i32)");
    llph("declare i8 @tll_deser_bool(i64)");
    llph("declare i64 @tll_deser_atom(i64)");
    llph("declare void @tll_deser_str(i64, ptr)");
    // type_info accessor 内建（M36）
    llph("declare void @tll_ti_name(ptr, ptr)");
    llph("declare i64 @tll_ti_size(ptr)");
    llph("declare i64 @tll_ti_kind(ptr)");
    llph("declare i64 @tll_ti_field_count(ptr)");
    llph("declare ptr @tll_ti_field(ptr, i64)");
    llph("declare void @tll_fi_name(ptr, ptr)");
    llph("declare i64 @tll_fi_offset(ptr)");
    llph("declare i64 @tll_fi_tag(ptr)");
    llph("declare void @tll_fi_type_name(ptr, ptr)");
    llph("declare i64 @tll_fi_type_size(ptr)");
    llph("declare i8 @tll_fi_is_ptr(ptr)");
    llph("declare void @tll_path_resolve(ptr, ptr)");
    llph("declare void @tll_args(ptr)");
    llph("declare void @tll_exit(i32)");
    llph("declare i32 @tll_system(ptr)");
    // 闭包环境 / TClosure 记录的堆分配（M48）
    llph("declare ptr @t_alloc(i64)");
    llph("declare void @t_runtime_init(i32, ptr)");
    llph("declare ptr @t_arena_new()");
    llph("declare void @t_runtime_set_arena(ptr)");
    llph("declare void @t_runtime_done()");
    llph("");
}

emit_llglobals fn() -> void {
    var n: i64 = slice_len(llgv_n) as i64;
    var i: i64 = 0;
    while (i < n) {
        var ty: string = ll_td(llgv_td[i]);
        llpg(sb_cat6("@", llgv_n[i], " = global ", ty, " ", ll_zero(ty)));
        i = i + 1;
    }
}

// 全局初始化函数：非常量初始值 + 未初始化 slice 的 elem_size 建立
emit_llginit fn() -> void {
    ll_reset_fn();
    em_in_fn = false;
    em_cur_fn = "";
    ll_cur_ret = -1;
    var n: i64 = slice_len(llgv_n) as i64;
    var i: i64 = 0;
    while (i < n) {
        var td: i64 = llgv_td[i];
        var ty: string = ll_td(td);
        var gp: string = sb_cat2("@", llgv_n[i]);
        var t0: TD = tds[td];
        if (t0.cat == "sym") {
            // Sym 全局变量：运行期 intern 字符串 → id，存进 @g（在 t.__ginit 中执行）
            if (llgv_init[i] >= 0) {
                var symtagp: string = ll_strlit(t0.name);
                var symv: string = emit_lle(llgv_init[i]);
                var symbits: string = i2s(t0.alen);
                var symid: string = ll_tmp();
                llfb(sb_cat6("  ", symid, " = call i32 @tll_sym_intern(ptr ", symtagp, ", ptr ", sb_cat3(symv, ", i64 ", sb_cat2(symbits, ")"))));
                var symstored: string = symid;
                if (ty == "i16") {
                    symstored = ll_tmp();
                    llfb(sb_cat4("  ", symstored, " = trunc i32 ", sb_cat2(symid, " to i16")));
                }
                llfb(sb_cat6("  store ", ty, " ", symstored, ", ptr ", gp));
            } else {
                llfb(sb_cat4("  store ", ty, " 0, ptr ", gp));
            }
        } else if (llgv_init[i] >= 0) {
            var v: string = emit_lle(llgv_init[i]);
            if (ll_isagg(td)) {
                ll_copy(ty, v, gp);
            } else {
                v = ll_cast_v(v, ll_etd(llgv_init[i]), td);
                llfb(sb_cat6("  store ", ty, " ", v, ", ptr ", gp));
            }
        } else {
            var t: TD = tds[td];
            if (t.cat == "slice") {
                var ety: string = "i64";
                if (t.elem >= 0) {
                    ety = ll_td(t.elem);
                }
                llfb(sb_cat6("  call void @tll_slice_new(i64 ", ll_sizeof(ety), ", ptr ", gp, ")", ""));
            }
        }
        i = i + 1;
    }
    llfb("  ret void");
    llpb("define void @t.__ginit() {");
    llpb("entry:");
    var na: i64 = slice_len(ll_fal) as i64;
    var j: i64 = 0;
    while (j < na) {
        llpb(ll_fal[j]);
        j = j + 1;
    }
    var nb: i64 = slice_len(ll_fb) as i64;
    var j2: i64 = 0;
    while (j2 < nb) {
        llpb(ll_fb[j2]);
        j2 = j2 + 1;
    }
    llpb("}");
    llpb("");
}

// ── 函数值闭包的 LLVM 侧落地（FuncType v2 / M47）────────────────
// 与 C 后端同构：为每个被取值的顶层函数生成 trampoline（吃掉 env 首参后转发）
// 与一个内部闭包全局。函数值在 LLVM 里就是指向该全局的 ptr。
emit_ll_closures fn() -> void {
    var cn: i64 = slice_len(clos_names) as i64;
    if (cn == 0) {
        return;
    }
    var i: i64 = 0;
    while (i < cn) {
        var nm: string = clos_names[i];
        var fi: i64 = llfn_find(nm);
        if (fi >= 0) {
            var rty: string = ll_td(llfn_r[fi]);
            var sym: string = sb_cat2("@t.", nm);
            if (llfn_x[fi]) {
                sym = sb_cat2("@", nm);
            }
            var psb: StringBuilder = sb_new();
            var asb: StringBuilder = sb_new();
            sb_append_str(psb, "ptr %__env");
            var ps: i64 = llfn_ps[fi];
            var pc: i64 = llfn_pc[fi];
            var pi: i64 = 0;
            while (pi < pc) {
                var pty: string = ll_td(llfp_td[ps + pi]);
                sb_append_str(psb, ", ");
                sb_append_str(psb, pty);
                sb_append_str(psb, " %__a");
                sb_append_str(psb, i2s(pi));
                if (pi > 0) {
                    sb_append_str(asb, ", ");
                }
                sb_append_str(asb, pty);
                sb_append_str(asb, " %__a");
                sb_append_str(asb, i2s(pi));
                pi = pi + 1;
            }
            llpb(sb_cat6("define internal ", rty, " @t.tramp.", nm, "(", sb_cat2(sb_to_str(psb), ") {")));
            llpb("entry:");
            if (rty == "void") {
                llpb(sb_cat5("  call void ", sym, "(", sb_to_str(asb), ")"));
                llpb("  ret void");
            } else {
                llpb(sb_cat6("  %r = call ", rty, " ", sym, "(", sb_cat2(sb_to_str(asb), ")")));
                llpb(sb_cat3("  ret ", rty, " %r"));
            }
            llpb("}");
            llpb("");
            llpg(sb_cat6("@t.clos.", nm, " = internal global %TClosure { ptr @t.tramp.", nm, ", ptr null }", ""));
        }
        i = i + 1;
    }
}

// 全局 atom 名表（LLVM 后端）：@t_atom_table = [M x %TStr]，index 0 占位空串，
// 其后按 g_atom_names 顺序；atom_intern 返回 1-based id → t_atom_table[id] 命中。
// `global`（外部链接）以便 C 运行时 t_atom_str 经 extern 链接此表。无 atom 时也发射最小表。
emit_ll_atom_table fn() -> void {
    var cnt: i64 = g_atom_cnt;
    // 数组常量的元素必须是内联 %TStr 结构常量，不能用 @.tsN（那是指针）。
    // ll_strlit 会把字节常量写进全局区，并把该串的 @.sN / 长度留在 ll_last_*。
    var elems: StringBuilder = sb_new();
    var dummy: string = ll_strlit("");
    sb_append_str(elems, "%TStr { ptr ");
    sb_append_str(elems, ll_last_sref);
    sb_append_str(elems, ", i64 ");
    sb_append_i64(elems, ll_last_slen);
    sb_append_str(elems, " }");
    var i: i64 = 0;
    while (i < cnt) {
        var ts: string = ll_strlit(g_atom_names[i]);
        sb_append_str(elems, ", %TStr { ptr ");
        sb_append_str(elems, ll_last_sref);
        sb_append_str(elems, ", i64 ");
        sb_append_i64(elems, ll_last_slen);
        sb_append_str(elems, " }");
        i = i + 1;
    }
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "@t_atom_table = global [");
    sb_append_i64(sb, cnt + 1);
    sb_append_str(sb, " x %TStr] [ ");
    sb_append_str(sb, sb_to_str(elems));
    sb_append_str(sb, " ]");
    llpg(sb_to_str(sb));
    var sb2: StringBuilder = sb_new();
    sb_append_str(sb2, "@t_atom_count = global i64 ");
    sb_append_i64(sb2, cnt + 1);
    llpg(sb_to_str(sb2));
}

emit_llunit fn(mod: string) -> void {
    build_type_map();
    ll_build_reg();
    llph(sb_cat2("; ModuleID = ", mod));
    llph("%TStr = type { ptr, i64 }");
    llph("%TSlice = type { ptr, i64, i64, i64 }");
    // 函数值的统一表示（FuncType v2 / M47）：{ 函数指针, 环境指针 }
    llph("%TClosure = type { ptr, ptr }");
    // type_info(T) 常量结构（M36）
    llph("%TFieldInfo = type { %TStr, i64, %TStr, i64, i8, i64 }");
    llph("%TTypeInfo = type { %TStr, i64, i64, i64, %TSlice }");
    emit_lltypes();
    llph("");
    emit_lldeclares();
    emit_llglobals();
    emit_ll_atom_table();
    emit_llginit();

    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var dn: Node = nodes[decl_list[i]];
        if (dn.kind == "FuncDecl") {
            emit_llfunc(decl_list[i]);
        }
        i = i + 1;
    }

    // 函数值闭包：全部函数体发射完毕后统一落地（LLVM 无前向声明顺序约束）
    emit_ll_closures();

    if (ll_has_main) {
        llpb("define i32 @main(i32 %argc, ptr %argv) {");
        llpb("entry:");
        llpb("  call void @t_runtime_init(i32 %argc, ptr %argv)");
        llpb("  %a = call ptr @t_arena_new()");
        llpb("  call void @t_runtime_set_arena(ptr %a)");
        llpb("  call void @t.__ginit()");
        llpb(sb_cat3("  %r = call i32 @t.", ll_main_fn, "()"));
        llpb("  call void @t_runtime_done()");
        llpb("  ret i32 %r");
        llpb("}");
    }
}

ll_join fn() -> string {
    var sb: StringBuilder = sb_new();
    var n1: i64 = slice_len(ll_head) as i64;
    var i: i64 = 0;
    while (i < n1) {
        sb_append_str(sb, ll_head[i]);
        sb_append_str(sb, "\n");
        i = i + 1;
    }
    var n2: i64 = slice_len(ll_glob) as i64;
    var j: i64 = 0;
    while (j < n2) {
        sb_append_str(sb, ll_glob[j]);
        sb_append_str(sb, "\n");
        j = j + 1;
    }
    sb_append_str(sb, "\n");
    var n3: i64 = slice_len(ll_body) as i64;
    var k: i64 = 0;
    while (k < n3) {
        sb_append_str(sb, ll_body[k]);
        sb_append_str(sb, "\n");
        k = k + 1;
    }
    return sb_to_str(sb);
}

// ── 路径工具 ───────────────────────────────────────────────────

base_no_tc fn(path: string) -> string {
    var n: u64 = str_len(path);
    var start: u64 = 0;
    var i: u64 = 0;
    while (i < n) {
        if (path[i] == 47 || path[i] == 92) {
            start = i + 1;
        }
        i = i + 1;
    }
    var end: u64 = n;
    if (n >= start + 3) {
        if (path[n - 3] == 46 && path[n - 2] == 116 && path[n - 1] == 99) {
            end = n - 3;
        }
    }
    return str_slice(path, start, end);
}

// --mode 只接受 dbg|rls（t 默认目录结构：out/dbg 调试、out/rls 发布）
valid_mode fn(m: string) -> bool {
    if (m == "dbg") {
        return true;
    }
    if (m == "rls") {
        return true;
    }
    return false;
}

// 探测路径是否存在。直接调用稳健的 file_exists 内建（C fopen 直查 / LLVM @tll_file_exists），
// 取代原先的 sys_run("cmd /c if exist ...") 外 shell 方案——后者在绝对路径下会触发 arena OOM。
path_exists fn(p: string) -> bool {
    return file_exists(p);
}

// 写出文件前确保父目录存在（Windows: cmd /c mkdir，幂等）
ensure_parent fn(p: string) -> void {
    var nn: u64 = str_len(p);
    var cut: u64 = 0;
    var pi: u64 = 0;
    while (pi < nn) {
        if (p[pi] == 47 || p[pi] == 92) { cut = pi; }
        pi = pi + 1;
    }
    if (cut > 0) {
        var d: string = to_bs(str_slice(p, 0, cut));
        sys_run(sb_cat5("cmd /c if not exist \"", d, "\" mkdir \"", d, "\""));
    }
}

to_bs fn(s: string) -> string {
    var sb: StringBuilder = sb_new();
    var i: u64 = 0;
    var n: u64 = str_len(s);
    while (i < n) {
        if (s[i] == 47) {
            sb_append_char(sb, 92);
        } else {
            sb_append_char(sb, s[i]);
        }
        i = i + 1;
    }
    return sb_to_str(sb);
}

// ── lex 子命令（token 池 → JSON，同 tc0 lex --json）────────────

run_lex fn(file: string) -> i32 {
    var src: string = file_read_all(file);
    tokenize(src);
    var out: StringBuilder = sb_new();
    sb_append_char(out, 91);
    var n: i64 = slice_len(toks) as i64;
    var i: i64 = 0;
    while (i < n) {
        var t: Tok = toks[i];
        if (i > 0) {
            sb_append_char(out, 44);
        }
        sb_append_str(out, "{\"type\":\"");
        sb_append_str(out, t.t);
        sb_append_str(out, "\",\"value\":\"");
        json_escape_into(out, t.v);
        sb_append_str(out, "\",\"line\":");
        sb_append_u64(out, t.line);
        sb_append_str(out, ",\"col\":");
        sb_append_u64(out, t.col);
        sb_append_char(out, 125);
        i = i + 1;
    }
    sb_append_char(out, 93);
    print(sb_to_str(out));
    print("\n");
    return 0;
}

// ── 驱动 main：lex / check / compile 派发 ──────────────────────

print_help fn() -> void {
    print("tc — 静态类型数据驱动语言(t)编译器\n");
    print("用法:\n");
    print("  tc <lex|check|compile|emit-ll|build|run> <file.tc> [选项]\n");
    print("  tc --help | -h | help            显示本帮助并退出 0\n\n");
    print("子命令:\n");
    print("  lex       词法分析，输出 token 流(JSON)\n");
    print("  check     类型/语义检查，输出诊断(JSON)\n");
    print("  compile   产出 C 源码(.c/.h)\n");
    print("  emit-ll   产出 LLVM IR(.ll)\n");
    print("  build     编译并链接为可执行文件(.exe)\n");
    print("  run       build 后立即运行，透传子进程退出码\n\n");
    print("选项:\n");
    print("  --example <name>   编译 examples/<name>.tc\n");
    print("  --mode <dbg|rls>   调试/发布(默认 dbg)\n");
    print("  --output <path>    指定输出路径前缀\n");
    print("  --clang <path>     指定 clang 路径\n");
    print("  --runtime <dir>    指定运行时目录(默认 runtime/)\n\n");
    print("退出码: 0=成功, 1=编译/运行错误, 2=命令行用法错误\n");
}

main fn() -> i32 @main {
    var argv: []string = args();
    init_keywords();
    init_node_kinds();
    init_xid();
    // 帮助：任意位置出现 --help / -h，或顶层 help 子命令 → 显式请求帮助，退出 0
    // （不再被当作“参数不足”而归入用法错误 2）
    var hai: i64 = 0;
    var han: i64 = slice_len(argv) as i64;
    while (hai < han) {
        if (argv[hai] == "--help" || argv[hai] == "-h") {
            print_help();
            return 0;
        }
        hai = hai + 1;
    }
    if (han >= 2 && argv[1] == "help") {
        print_help();
        return 0;
    }
    if (slice_len(argv) < 3) {
        eprint("usage: tc <lex|check|compile|emit-ll|build|run> <file.tc> [--example <name>] [--mode dbg|rls] [--output <path>] [--clang <path>] [--runtime <dir>]\n");
        return 2;
    }
    var cmd: string = argv[1];
    var file: string = argv[2];

    if (cmd == "lex") {
        return run_lex(file);
    }

    if (cmd == "check") {
        g_file = path_resolve(file);
        var src: string = file_read_all(file);
        tokenize(src);
        pos = 0;
        init_anndefs();
        parse_unit();
        run_check();
        flag_pass();
        ann_pass();
        print_json();
        if (has_errors()) {
            return 1;
        }
        return 0;
    }

    if (cmd == "compile") {
        var out_dir: string = "";
        var has_out: bool = false;
        var mode: string = "dbg";
        var ai: i64 = 3;
        var an: i64 = slice_len(argv) as i64;
        while (ai < an) {
            if (argv[ai] == "--mode") {
                if (ai + 1 < an) {
                    mode = argv[ai + 1];
                    ai = ai + 2;
                    continue;
                }
            }
            if (argv[ai] == "--output") {
                if (ai + 1 < an) {
                    out_dir = argv[ai + 1];
                    has_out = true;
                    ai = ai + 2;
                    continue;
                }
            }
            ai = ai + 1;
        }
        if (valid_mode(mode) == false) {
            eprint(sb_cat3("error: unknown --mode `", mode, "` (expected dbg|rls)\n"));
            return 2;
        }

        g_file = path_resolve(file);
        var src2: string = file_read_all(file);
        tokenize(src2);
        pos = 0;
        init_anndefs();
        parse_unit();
        run_check();
        flag_pass();
        ann_pass();
        if (has_errors()) {
            print_json();
            return 1;
        }

        var mod: string = base_no_tc(file);
        emit_unit(mod);

        if (has_out == false) {
            // 缺省按 --mode 落入 out/dbg|out/rls
            out_dir = sb_cat3("out/", mode, "");
        }

        var hp: string = sb_cat4(out_dir, "/", mod, ".h");
        var cp: string = sb_cat4(out_dir, "/", mod, ".c");
        ensure_parent(hp);
        file_write_all(hp, h_join());
        file_write_all(cp, s_join());
        print(sb_cat6("Generated: ", to_bs(hp), ", ", to_bs(cp), "\n", ""));
        return 0;
    }

    if (cmd == "emit-ll" || cmd == "build" || cmd == "run") {
        var out_p: string = "";
        var has_outp: bool = false;
        var rt_dir: string = "runtime";
        var clang_p: string = "clang";
        var mode: string = "dbg";
        var src_file: string = "";
        var has_src: bool = false;
        var ex_name: string = "";
        var is_example: bool = false;
        var ai2: i64 = 2;
        var an2: i64 = slice_len(argv) as i64;
        while (ai2 < an2) {
            if (argv[ai2] == "--output") {
                if (ai2 + 1 < an2) {
                    out_p = argv[ai2 + 1];
                    has_outp = true;
                    ai2 = ai2 + 2;
                    continue;
                }
            }
            if (argv[ai2] == "--mode") {
                if (ai2 + 1 < an2) {
                    mode = argv[ai2 + 1];
                    ai2 = ai2 + 2;
                    continue;
                }
            }
            if (argv[ai2] == "--runtime") {
                if (ai2 + 1 < an2) {
                    rt_dir = argv[ai2 + 1];
                    ai2 = ai2 + 2;
                    continue;
                }
            }
            if (argv[ai2] == "--clang") {
                if (ai2 + 1 < an2) {
                    clang_p = argv[ai2 + 1];
                    ai2 = ai2 + 2;
                    continue;
                }
            }
            if (argv[ai2] == "--example") {
                if (ai2 + 1 < an2) {
                    ex_name = argv[ai2 + 1];
                    is_example = true;
                    ai2 = ai2 + 2;
                    continue;
                }
            }
            // 位置参数：第一个非 flag 即源文件
            if (has_src == false) {
                src_file = argv[ai2];
                has_src = true;
            }
            ai2 = ai2 + 1;
        }
        if (valid_mode(mode) == false) {
            eprint(sb_cat3("error: unknown --mode `", mode, "` (expected dbg|rls)\n"));
            return 2;
        }

        // cargo 风格 example：源 = examples/<name>.tc，产物 = out/<mode>/examples/<name>.exe
        if (is_example) {
            var probe: string = sb_cat4("cmd /c if exist \"examples\\", ex_name, ".tc\" (exit 0) else (exit 1)", "");
            var prc: i32 = sys_run(probe);
            if (prc != 0) {
                eprint(sb_cat3("error: no example named `", ex_name, "`\navailable examples:\n"));
                sys_run("cmd /c dir /b examples\\*.tc 2>nul");
                return 2;
            }
            src_file = sb_cat3("examples/", ex_name, ".tc");
            has_src = true;
            if (has_outp == false) {
                var exdir: string = to_bs(sb_cat3("out/", mode, "/examples"));
                sys_run(sb_cat5("cmd /c if not exist \"", exdir, "\" mkdir \"", exdir, "\""));
                out_p = sb_cat4("out/", mode, "/examples/", ex_name);
                has_outp = true;
            }
        }
        if (has_src == false) {
            eprint("usage: tc build|run <file.tc> | --example <name>\n");
            return 2;
        }

        // 缺省 clang：PATH 上没有时探测标准安装路径
        if (clang_p == "clang") {
            var crc: i32 = sys_run("cmd /c if exist \"C:\\Program Files\\LLVM\\bin\\clang.exe\" (exit 0) else (exit 1)");
            if (crc == 0) {
                clang_p = "C:/Program Files/LLVM/bin/clang.exe";
            }
        }

        g_file = path_resolve(src_file);
        var src3: string = file_read_all(src_file);
        tokenize(src3);
        pos = 0;
        init_anndefs();
        parse_unit();
        run_check();
        flag_pass();
        ann_pass();
        if (has_errors()) {
            print_json();
            return 1;
        }

        var mod2: string = base_no_tc(src_file);
        emit_llunit(mod2);

        // 输出目录：--output 指定 exe/目录前缀；缺省按 --mode 落入 out/dbg|out/rls
        if (has_outp == false) {
            out_p = sb_cat4("out/", mode, "/", mod2);
        }

        var llp: string = sb_cat2(out_p, ".ll");
        ensure_parent(llp);
        file_write_all(llp, ll_join());
        print(sb_cat3("Generated: ", to_bs(llp), "\n"));

        if (cmd == "emit-ll") {
            return 0;
        }

        // 无入口时提前报错：否则 lld-link 只会给出
        // "subsystem must be defined" 这类无从下手的链接期诊断。
        if (ll_has_main == false) {
            eprint(sb_cat3("error: no entry point: ", to_bs(src_file), " 缺少 @main 标注的函数（build/run 需要入口；只想产出 IR 请用 emit-ll）\n"));
            return 1;
        }

        // build：调 clang 一步链接 runtime 出 exe
        var exep: string = sb_cat2(out_p, ".exe");
        // 依赖静态库：默认 out/<mode>/deps/t_runtime.lib（tools/build_runtime.mjs 预编译）
        // 缺失时回退直编 <rt_dir> 下的 runtime 源码，保证任意 t 项目开箱即用
        var deps_lib: string = sb_cat3("out/", mode, "/deps/t_runtime.lib");
        var use_lib: bool = path_exists(deps_lib);
        var opt: string = "-O2";
        if (mode == "dbg") { opt = "-O0 -gcodeview"; }
        var csb2: StringBuilder = sb_new();
        sb_append_str(csb2, "\"");
        sb_append_str(csb2, clang_p);
        sb_append_str(csb2, "\" ");
        sb_append_str(csb2, opt);
        sb_append_str(csb2, " -o \"");
        sb_append_str(csb2, exep);
        sb_append_str(csb2, "\" -Wl,-subsystem:console \"");
        sb_append_str(csb2, llp);
        sb_append_str(csb2, "\" ");
        if (use_lib) {
            sb_append_str(csb2, "\"");
            sb_append_str(csb2, deps_lib);
            sb_append_str(csb2, "\"");
        } else {
            sb_append_str(csb2, "\"");
            sb_append_str(csb2, rt_dir);
            sb_append_str(csb2, "/t_runtime.c\" \"");
            sb_append_str(csb2, rt_dir);
            sb_append_str(csb2, "/t_shim_ll.c\" -I \"");
            sb_append_str(csb2, rt_dir);
            sb_append_str(csb2, "\"");
        }
        var rc: i32 = sys_run(sb_to_str(csb2));
        if (rc != 0) {
            eprint("clang link failed\n");
            return 1;
        }
        print(sb_cat3("Built: ", to_bs(exep), "\n"));

        // run：构建成功后立即执行，透传子进程退出码（cargo run 语义）
        if (cmd == "run") {
            var run_cmd: string = sb_cat3("\"", to_bs(exep), "\"");
            var rrc: i32 = sys_run(run_cmd);
            return rrc;
        }
        return 0;
    }

    eprint("unknown command\n");
    return 2;
}

// ── type_info(T) 编译期常量合成（M36）─────────────────────────
// type_info(Point) 在编译期遍历 StructDecl 字段，合成全局常量
// __ti_Point（含字段数组），返回其地址（LLVM: ptr @__ti_Point；C: &__ti_Point）。
// accessor 内建（ti_name/ti_field/fi_*）在运行时读取该常量。

c_emit_accessor_call fn(cn: string, av: []string) -> string {
    var r: string = sb_cat2("t_", cn);
    r = sb_cat2(r, "(");
    var i: i64 = 0;
    var n: i64 = slice_len(av) as i64;
    while (i < n) {
        if (i > 0) { r = sb_cat2(r, ", "); }
        r = sb_cat2(r, av[i]);
        i = i + 1;
    }
    return sb_cat2(r, ")");
}

// 按名查 StructDecl 节点下标。emit 期只能依赖 decl_list —— checker 的
// global_scope/syms 在发射阶段已不保证有效，用 sym_lookup 会取到野下标。
ti_struct_decl fn(tname: string) -> i64 {
    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = decl_list[i];
        var dn: Node = nodes[d];
        if (dn.kind == "StructDecl" && dn.sa == tname) { return d; }
        i = i + 1;
    }
    return -1;
}

emit_type_info_c fn(tname: string) -> string {
    var gref: string = sb_cat2("&__ti_", tname);
    var di: i64 = 0;
    var dn2: i64 = slice_len(ti_done) as i64;
    while (di < dn2) {
        if (ti_done[di] == tname) { return gref; }
        di = di + 1;
    }
    var d: i64 = ti_struct_decl(tname);
    if (d < 0) {
        diag_new("T_TYPE_MISMATCH", "error", sb_cat2("type_info: '", sb_cat2(tname, "' 不是 struct 类型（当前仅支持 struct）")), "", 1, 1, 1, 10);
        return "0";
    }
    append(ti_done, tname);
    // C 后端：type_info 常量定义在 t_entry_main 之后（emit 期才合成），
    // 但 C 的 static 先用后定义在同 TU 非法；故在 .h 内放前向声明。
    // （Point 等 struct 已落在 .h，故 .c 顶部 include 后即可见。）
    hpush(sb_cat3("static TTypeInfo __ti_", tname, ";"));
    hpush(sb_cat3("static TFieldInfo __ti_", tname, "_f[];"));
    var decl: Node = nodes[d];

    var fsb: StringBuilder = sb_new();
    sb_append_str(fsb, "static TFieldInfo __ti_");
    sb_append_str(fsb, tname);
    sb_append_str(fsb, "_f[] = { ");
    var n: i64 = 0;
    var c: i64 = decl.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var f: Node = nodes[k.val];
        if (f.ia < 0) {
            if (n > 0) { sb_append_str(fsb, ", "); }
            var ftd: i64 = resolve_type_desc(f.na);
            var cty: string = emit_ctype(f.na);
            var isp: i64 = 0;
            if (is_ref_type(ftd)) { isp = 1; }
            sb_append_str(fsb, sb_cat3("{ TSTR_LIT(\"", esc_c(f.sa), "\"), "));
            sb_append_str(fsb, sb_cat5("offsetof(", tname, ", ", f.sa, "), "));
            sb_append_str(fsb, sb_cat3("TSTR_LIT(\"", esc_c(td_readable(ftd)), "\"), "));
            sb_append_str(fsb, sb_cat3("sizeof(", cty, "), "));
            sb_append_i64(fsb, isp);
            sb_append_str(fsb, ", ");
            sb_append_i64(fsb, f.ib);   // 字段 tagID（@N 显式 / 全自动自动分配）
            sb_append_str(fsb, " }");
            n = n + 1;
        }
        c = k.next;
    }
    sb_append_str(fsb, " };");

    var tsb: StringBuilder = sb_new();
    sb_append_str(tsb, "static TTypeInfo __ti_");
    sb_append_str(tsb, tname);
    sb_append_str(tsb, sb_cat3(" = { TSTR_LIT(\"", esc_c(tname), "\"), "));
    sb_append_str(tsb, sb_cat3("sizeof(", tname, "), 0, "));
    sb_append_i64(tsb, n);
    sb_append_str(tsb, sb_cat3(", { __ti_", tname, "_f, "));
    sb_append_i64(tsb, n);
    sb_append_str(tsb, ", ");
    sb_append_i64(tsb, n);
    sb_append_str(tsb, ", (int64_t)sizeof(TFieldInfo) } };");
    // 字段数组必须先于 TTypeInfo 输出（后者引用前者）
    append(ti_lines, sb_to_str(fsb));
    append(ti_lines, sb_to_str(tsb));
    return gref;
}

emit_type_info_ll fn(tname: string) -> string {
    var gref: string = sb_cat2("@__ti_", tname);
    var di: i64 = 0;
    var dn2: i64 = slice_len(ti_done) as i64;
    while (di < dn2) {
        if (ti_done[di] == tname) { return gref; }
        di = di + 1;
    }
    // 字段元数据取自 ll_build_reg 建好的注册表（emit 期唯一可靠来源）
    var lti: i64 = llt_find(tname);
    if (lti < 0) {
        diag_new("T_TYPE_MISMATCH", "error", sb_cat2("type_info: '", sb_cat2(tname, "' 不是 struct 类型（当前仅支持 struct）")), "", 1, 1, 1, 10);
        return "null";
    }
    if (llt_kinds[lti] != "struct") {
        diag_new("T_TYPE_MISMATCH", "error", sb_cat2("type_info: '", sb_cat2(tname, "' 不是 struct 类型（当前仅支持 struct）")), "", 1, 1, 1, 10);
        return "null";
    }
    append(ti_done, tname);
    var sty: string = ll_named(tname);

    var m: i64 = slice_len(llsf_st) as i64;
    var n: i64 = 0;
    var j: i64 = 0;
    while (j < m) {
        if (llsf_st[j] == tname) { n = n + 1; }
        j = j + 1;
    }

    var fsb: StringBuilder = sb_new();
    sb_append_str(fsb, gref);
    sb_append_str(fsb, "_f = internal constant [");
    sb_append_i64(fsb, n);
    sb_append_str(fsb, " x %TFieldInfo] [");
    var i: i64 = 0;
    j = 0;
    while (j < m) {
        if (llsf_st[j] == tname) {
            if (i > 0) { sb_append_str(fsb, ", "); }
            var ftd: i64 = llsf_td[j];
            // ll_strlit 发射 @.sN 字面量并回填 ll_last_sref/ll_last_slen；
            // 常量初始化器要的是内联 %TStr 值，不能用它返回的 @.tsN 指针。
            ll_strlit(llsf_fld[j]);
            var fns: string = sb_cat5("%TStr { ptr ", ll_last_sref, ", i64 ", i2s(ll_last_slen), " }");
            ll_strlit(td_readable(ftd));
            var tns: string = sb_cat5("%TStr { ptr ", ll_last_sref, ", i64 ", i2s(ll_last_slen), " }");
            var isp: i64 = 0;
            if (is_ref_type(ftd)) { isp = 1; }
            sb_append_str(fsb, sb_cat3("%TFieldInfo { ", fns, ", i64 ptrtoint (ptr getelementptr ("));
            sb_append_str(fsb, sty);
            sb_append_str(fsb, ", ptr null, i32 0, i32 ");
            sb_append_i64(fsb, llsf_idx[j]);
            sb_append_str(fsb, ") to i64), ");
            sb_append_str(fsb, tns);
            sb_append_str(fsb, ", i64 ");
            sb_append_str(fsb, ll_sizeof(ll_td(ftd)));
            sb_append_str(fsb, ", i8 ");
            sb_append_i64(fsb, isp);
            sb_append_str(fsb, ", i64 ");
            sb_append_i64(fsb, llsf_tag[j]);   // 字段 tagID（@N 显式 / 全自动自动分配）
            sb_append_str(fsb, " }");
            i = i + 1;
        }
        j = j + 1;
    }
    sb_append_str(fsb, "]");
    llpg(sb_to_str(fsb));

    ll_strlit(tname);
    var tnm: string = sb_cat5("%TStr { ptr ", ll_last_sref, ", i64 ", i2s(ll_last_slen), " }");
    var tsb: StringBuilder = sb_new();
    sb_append_str(tsb, gref);
    sb_append_str(tsb, " = internal constant %TTypeInfo { ");
    sb_append_str(tsb, tnm);
    sb_append_str(tsb, ", i64 ");
    sb_append_str(tsb, ll_sizeof(sty));
    sb_append_str(tsb, ", i64 0, i64 ");
    sb_append_i64(tsb, n);
    sb_append_str(tsb, sb_cat3(", %TSlice { ptr ", gref, "_f, i64 "));
    sb_append_i64(tsb, n);
    sb_append_str(tsb, ", i64 ");
    sb_append_i64(tsb, n);
    sb_append_str(tsb, ", i64 ");
    sb_append_str(tsb, ll_sizeof("%TFieldInfo"));
    sb_append_str(tsb, " } }");
    llpg(sb_to_str(tsb));
    return gref;
}
