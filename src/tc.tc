// ══════════════════════════════════════════════════════════════════
// src/tc.tc — 驱动层 / 入口：命令行分发与 main()
//
// 编译器本体已按编译步骤拆分为多模块，本文件仅做 import 汇总与 CLI 派发：
//   base → lex → parse → sema → codegen_c → tir → tir_to_ll
// 测试运行器与 REPL 各自独立成模块（src/test.tc / lib/repl.tc），
// 本文件只 import 它们并派发 `tc test` / REPL 子命令。
// ══════════════════════════════════════════════════════════════════

const base = @import("src.base");
const lex = @import("src.lex");
const parse = @import("src.parse");
const hir = @import("src.hir");
const hir_eval = @import("src.hir_eval");
const sema = @import("src.sema");
const comptime_fold = @import("src.comptime_fold");
const codegen_dev = @import("src.codegen_dev");
const tir = @import("src.tir");
const tir_to_ll = @import("src.tir_to_ll" :: tir_to_ll_emit, g_has_main, build_tlib);
const tmir = @import("src.tmir" :: tir_to_tmir_lower, TMIRModule);
const codegen_wasm = @import("src.codegen_wasm" :: tmir_to_wasm);
const codegen_riscv = @import("src.codegen_riscv" :: tmir_to_riscv);
const codegen_c_tmir = @import("src.codegen_c_tmir" :: tmir_to_c);
const cst = @import("std.rc.cst");   // 20-H：直连 cst（原经 lex / base 的 pub @import 重导出）
const mir = @import("src.mir");
const test = @import("src.test");
const repl = @import("repl");
const derive_gen = @import("src.derive_gen");   // P6：@derive 8 trait 源码级注入

// ── Device 子系统：host 模块是否含 kernel（驱动注入 __t_devmod_blob 用）──
pub fn module_has_kernels() bool {
    var n: i64 = slice_len(lex.decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = lex.decl_list[i];
        // S4 §0.14.7 SoA：bf 已外置（原 `dn.bf`）
        if (base.node_kind((d as u64)) == "FuncDecl" and base.node_bf((d as u64)) == true) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// ── 多文件编译单元（R2 基础）────────────────────────────────
// 接受多个源文件作为同一个编译单元：按序读取并拼接为一份源码，tokenize 后统一
// parse_unit 填入同一 lex.decl_list。所有文件共享入口命名空间（不做模块名字重整），
// 因此跨文件 `extend fn` 与同文件一致——desugar_func_clauses 按名合并时
// 自然把不同文件的同名子句并入同一组。单文件时 files 仅含一个元素，与原单文件路径
// 逐字节一致（分隔符仅插在文件「之间」，末文件不追加换行）。
// 注意：仅拼源码、不切 g_file 溯源——诊断 file 统一指向首个文件（多文件项目可改进，
// 但不影响编译产物与门禁；门禁始终单文件）。
pub fn tc_load_src(files: []string) string {
    var combined: StringBuilder = sb_new();
    var nf: i64 = slice_len(files) as i64;
    var k: i64 = 0;
    while (k < nf) {
        // 仅在文件「之间」插入换行分隔符，防止跨文件 token 粘连；
        // 末文件尾部不追加换行——保持与旧单文件路径逐字节一致，否则未终结
        // 字符串位于 EOF 时会被多出的换行误判为「串内裸换行」(T-LEX-E003
        // 而非预期的 T-LEX-E000，见 f93_lex_unterminated_string.tc)。
        if (k > 0) { sb_append_str(combined, "\n"); }
        sb_append_str(combined, file_read_all(files[k]));
        k = k + 1;
    }
    var src: string = sb_to_str(combined);
    // P6：@derive 源码级注入。若源码含 @derive 子串，临时解析提取 struct/union
    // 的字段与 trait 列表，生成 8 trait 方法源码并追加到末尾；否则（含编译器自身
    // src）原样返回，零自举成本。注入后交由下方统一 tokenize + 外层 parse_unit 重解析。
    src = derive_gen.derive_inject(src);
    base.g_file = base.rel_path(files[0]);
    lex.tokenize(src);
    hir.g_last_src = src;
    lex.pos = 0;
    sema.init_anndefs();
    return src;
}

pub fn print_help() void {
    print("tc — 静态类型数据驱动语言(t)编译器\n");
    print("用法:\n");
    print("  tc <lex|check|compile|emit-ll|build|run|test> <file.tc> [选项]\n");
    print("  tc --help | -h | help            显示本帮助并退出 0\n\n");
    print("子命令:\n");
    print("  lex       词法分析，输出 token 流(JSON)\n");
    print("  check     类型/语义检查，输出诊断(JSON)\n");
    print("  compile   产出 C 源码(.c/.h)\n");
    print("  emit-ll   产出 LLVM IR(.ll)\n");
    print("  build     编译并链接为可执行文件(.exe)\n");
    print("  run       build 后立即运行，透传子进程退出码\n");
    print("  test      收集 `test \"名字\" {}` 并运行，汇总 passed/failed/skipped\n\n");
    print("选项:\n");
    print("  --example <name>   编译 examples/<name>.tc\n");
    print("  --filter <substr>  test: 只跑显示名含该子串的用例\n");
    print("  --tag <name>       test: 只跑带 @tag(<name>) 的用例\n");
    print("  --no-run           test: 只编译不执行\n");
    print("  --mode <dbg|rls>   调试/发布(默认 dbg)\n");
    print("  --output <path>    指定输出路径前缀\n");
    print("  --clang <path>     指定 clang 路径\n");
    print("  --runtime <dir>    指定运行时目录(默认 runtime/)\n");
    print("  --debug-libs       链接调试态库 .tlibd（缺少则回退 .tlib）\n");
    print("  --debug            build --lib 时产出调试态归档 .tlibd\n");
    print("  --emit-deps        check 时打印模块依赖图(JSON)后退出\n\n");
    print("退出码: 0=成功, 1=编译/运行错误, 2=命令行用法错误\n");
}
fn main() i32 @main {
    var argv: []string = args();
    cst.init_keywords();
    cst.init_node_kinds();
    base.init_xid();
    // 帮助：任意位置出现 --help / -h，或顶层 help 子命令 → 显式请求帮助，退出 0
    // （不再被当作“参数不足”而归入用法错误 2）
    var hai: i64 = 0;
    var han: i64 = slice_len(argv) as i64;
    while (hai < han) {
        if (argv[hai] == "--help" or argv[hai] == "-h") {
            print_help();
            return 0;
        }
        hai = hai + 1;
    }
    if (han >= 2 and argv[1] == "help") {
        print_help();
        return 0;
    }
    // `tc test` 少于 3 个参数时会被下面的通用门槛吞掉，给出的用法串又不含 test，
    // 于是必须在门之前特判，输出针对性的用法（见 src/tc.tc 的 argv 门槛铁律）。
    if (han == 2 and argv[1] == "test") {
        eprint("usage: tc test <file.tc> [--filter <substr>] [--tag <name>] [--mode dbg|rls] [--no-run]\n");
        return 2;
    }
    if (slice_len(argv) < 3) {
        // 无参数的「裸 tc」进入 REPL 模式（输入表达式即时求值）。
        // 注意：`tc help` / `tc --help` / `tc test` 已在上方特判（返回 0 或用法串），
        // 故走到这里且参数不足时，只有「纯 tc 无子命令」一种情况 → REPL。
        if (slice_len(argv) < 2) {
            return repl.run_repl(base.to_bs(argv[0]));
        }
        eprint("usage: tc <lex|check|compile|emit-ll|build|run|test|fmt|lint> <file.tc> [--example <name>] [--mode dbg|rls] [--output <path>] [--clang <path>] [--runtime <dir>]\n");
        return 2;
    }
    var cmd: string = argv[1];
    var file: string = argv[2];

    if (cmd == "lex") {
        return lex.run_lex(file);
    }

    if (cmd == "emit-hir") {
        // HIR（ZIR 槽位）：AstGen 在 sema **之前** 产出未定型·线性·可序列化 IR。
        // 见 docs/compiler/hir-design.md。emit-hir 不跑语义检查（pre-type）。
        var out_p: string = "";
        var has_outp: bool = false;
        var src_file: string = "";
        var has_src: bool = false;
        var files: []string;
        var as_bin: bool = false;
        var from_bin: bool = false;
        var ai2: i64 = 2;
        var an2: i64 = slice_len(argv) as i64;
        while (ai2 < an2) {
            if (argv[ai2] == "--output") {
                if (ai2 + 1 < an2) { out_p = argv[ai2 + 1]; has_outp = true; }
                ai2 = ai2 + 2; continue;
            }
            if (argv[ai2] == "--bin") { as_bin = true; ai2 = ai2 + 1; continue; }
            if (argv[ai2] == "--from-bin") { from_bin = true; ai2 = ai2 + 1; continue; }
            if (argv[ai2] == "--example") {
                if (ai2 + 1 < an2) { src_file = base.sb_cat3("examples/", argv[ai2 + 1], ".tc"); has_src = true; }
                ai2 = ai2 + 2; continue;
            }
            if (has_src == false) { src_file = argv[ai2]; has_src = true; }
            ai2 = ai2 + 1;
        }
        if (has_src == false) {
            eprint("usage: tc emit-hir <file.tc> | --example <name> [--output <path>] [--bin] [--from-bin <file.hirbin>]\n");
            return 2;
        }
        // --from-bin：读取二进制 HIR 并还原为文本（验证 hir_to_bin/hir_from_bin 往返一致性）
        if (from_bin) {
            var bin: string = file_read_all(src_file);
            var m2: HirModule = hir.hir_from_bin(bin);
            print(hir.hir_to_text(m2));
            return 0;
        }
        base.g_file = base.rel_path(src_file);
        var src: string = file_read_all(src_file);
        lex.tokenize(src);
        hir.g_last_src = src;
        if (sema.has_errors()) { base.emit_diags(); return 1; }
        lex.pos = 0;
        sema.init_anndefs();
        parse.parse_unit();
        // ⚠ 2026-10-18：parse 后的错误检查不可省。此前缺失 ⇒ 源含语法错误时 decl_list
        //   残缺、HIR 为空，命令仍 print("") 并 return 0，表现为「空输出 + exit 0」——
        //   nightly 的 hir_test 只能报「空输出」，无从诊断（2026-10-16 nightly 即栽于此）。
        //   pre-sema 命令不跑 run_check，故必须在此显式闸门。
        if (sema.has_errors()) { base.emit_diags(); return 1; }
        var m: HirModule = hir.hir_build(src);
        if (as_bin) {
            if (has_outp == false) {
                eprint("error: --bin 需配合 --output <path>\n");
                return 2;
            }
            file_write_all(out_p, hir.hir_to_bin(m));
            return 0;
        }
        var txt: string = hir.hir_to_text(m);
        if (has_outp) { file_write_all(out_p, txt); }
        else { print(txt); }
        return 0;
    }

    if (cmd == "comptime-eval") {
        // Stage A'：CTFE 重写 —— 解释 HIR 指令流（见 docs/compiler/hir-design.md §5/§7）。
        // 不求类型、不跑 sema，直接对顶层 const 初始化式做编译期求值并打印结果。
        var src_file: string = "";
        var has_src: bool = false;
        var files: []string;
        var name_filter: string = "";
        var has_name: bool = false;
        var out_p: string = "";
        var has_outp: bool = false;
        var ai3: i64 = 2;
        var an3: i64 = slice_len(argv) as i64;
        while (ai3 < an3) {
            if (argv[ai3] == "--output") {
                if (ai3 + 1 < an3) { out_p = argv[ai3 + 1]; has_outp = true; }
                ai3 = ai3 + 2; continue;
            }
            if (argv[ai3] == "--name") {
                if (ai3 + 1 < an3) { name_filter = argv[ai3 + 1]; has_name = true; }
                ai3 = ai3 + 2; continue;
            }
            if (argv[ai3] == "--example") {
                if (ai3 + 1 < an3) { src_file = base.sb_cat3("examples/", argv[ai3 + 1], ".tc"); has_src = true; }
                ai3 = ai3 + 2; continue;
            }
            if (has_src == false) { src_file = argv[ai3]; has_src = true; }
            ai3 = ai3 + 1;
        }
        if (has_src == false) {
            eprint("usage: tc comptime-eval <file.tc> | --example <name> [--name <const>] [--output <path>]\n");
            return 2;
        }
        base.g_file = base.rel_path(src_file);
        var src: string = file_read_all(src_file);
        lex.tokenize(src);
        hir.g_last_src = src;
        if (sema.has_errors()) { base.emit_diags(); return 1; }
        lex.pos = 0;
        sema.init_anndefs();
        parse.parse_unit();
        if (sema.has_errors()) { base.emit_diags(); return 1; }   // 同 emit-hir：禁止静默空跑
        hir.hir_run(src);
        var m: HirModule = hir.g_hir;
        var out_s: string = "";
        if (has_name) {
            out_s = hir_eval.hv_eval_const_named(m, name_filter);
        } else {
            out_s = hir_eval.hv_eval_module(m);
        }
        if (has_outp) { file_write_all(out_p, out_s); }
        else { print(out_s); }
        if (hir_eval.g_hv_err) { return 1; }
        return 0;
    }

    if (cmd == "check") {
        // 解析中性开关：--emit-deps（输出依赖图）、--debug-libs（优先 .tlibd）、--debug、
        // --lib-dir（调用方如 tote 注入的库搜索目录）
        // 旗标位置无关：从 argv[2] 起扫描，首个非 -- 旗标即入口文件。
        // 兼容 `tc check <file> --flag` 与 `tc check --flag <file>`（tote 委托时旗标在前）。
        var ai: i64 = 2;
        var an: i64 = slice_len(argv) as i64;
        var found_file: string = "";
        var files: []string;
        var want_memstats: bool = false;
        while (ai < an) {
            if (argv[ai] == "--emit-deps") { lex.g_emit_deps = true; ai = ai + 1; continue; }
            if (argv[ai] == "--debug-libs") { lex.g_debug_libs = true; ai = ai + 1; continue; }
            if (argv[ai] == "--debug") { lex.g_lib_debug = true; ai = ai + 1; continue; }
            if (argv[ai] == "--lib-dir") {
                if (ai + 1 < an) { append(lex.g_lib_dirs, argv[ai + 1]); ai = ai + 2; continue; }
            }
            if (argv[ai] == "--diagnostics") {
                if (ai + 1 < an) { base.g_diag_fmt = argv[ai + 1]; ai = ai + 2; continue; }
            }
            if (argv[ai] == "--json") { base.g_diag_fmt = "json"; ai = ai + 1; continue; }
            if (argv[ai] == "--trace-comptime") { sema.g_meta_trace = true; ai = ai + 1; continue; }
            if (argv[ai] == "--memstats") { want_memstats = true; ai = ai + 1; continue; }
            // R2 多文件：首个非 flag 即入口文件，其后所有位置参数并入同一编译单元
            if (found_file == "") { found_file = argv[ai]; }
            append(files, argv[ai]);
            ai = ai + 1;
        }
        base.g_file = base.rel_path(found_file);
        var src: string = tc_load_src(files);
        hir.g_last_src = src;
        // 阶段闸门：词法错误会让 token 流失去结构（未终结串、坏数字…），
        // 继续 parse 只会撞上无关的 `parse error` 硬中断并盖掉真正的病因。
        if (sema.has_errors()) { base.emit_diags(); return 1; }
        base.g_intern_active = false; // 阶段 1：parse 期不驻留（g_parse 临时串不得作 canonical）
        base.str_intern_init();       // 阶段 1：在 g_arena 预分配字符串驻留表（运行期定址写，不污染 parse arena）
        arena_use_parse();            // 前端本块 arena：parse 期 AST/CST 落 g_parse
        parse.parse_unit();
        if (want_memstats) { eprint("PHASE after_parse"); dbg_report_mem(); }
        arena_use_default();          // sema 持久表（类型/符号）须落 g_arena，切回默认
        base.g_intern_active = true;  // 阶段 1：进入持久阶段，开启字符串驻留（canonical 落 g_arena，安全）
        // HIR（ZIR 槽位）AstGen：pre-sema 真实跑一次，存 g_hir 供增量缓存锚点消费。
        // Stage A 仅产出生存（不崩溃 + 可序列化），sema 仍吃 CST，未消费 g_hir。
        hir.hir_run(src);
        if (want_memstats) { eprint("PHASE after_hir"); dbg_report_mem(); }
        sema.run_check();
        if (want_memstats) { eprint("PHASE after_sema"); dbg_report_mem(); }
        sema.run_device_check();
        comptime_fold.comptime_fold_pass();
        sema.meta_trace_flush();
        sema.ann_pass();
        if (want_memstats) { eprint("PHASE after_ann"); dbg_report_mem(); }
        arena_reset_parse();        // 前端完成：释放 parse 期 AST/CST（g_parse）；check 无 emit，安全
        if (want_memstats) {
            var _n: i64 = base.node_count();
            // SoA 侧表壳（每节点固定宽，dedup 不可缩；可变 backing 另计）：
            // 10×i64(80) + 7×string(112) + Span(24) + Trivia头(32) = 248 B/节点
            var _shell: i64 = _n * 248;
            var _ntd: i64 = slice_len(sema.tds);
            var _nti: i64 = slice_len(sema.tis);
            // TD=72B, TI=88B, + tdf_*/tif_* 平行数组约 24B/项（tds 计 96B、tis 计 112B 粗估）
            var _tds_MB: i64 = _ntd * 96 / 1048576;
            var _tis_MB: i64 = _nti * 112 / 1048576;
            eprint("MEMSTATS node_count=" + base.i2s(_n)
                + " tds_count=" + base.i2s(_ntd) + " tis_count=" + base.i2s(_nti)
                + " tds_MB=" + base.i2s(_tds_MB) + " tis_MB=" + base.i2s(_tis_MB)
                + " soa_shell_MB=" + base.i2s(_shell / 1048576));
            dbg_report_mem();
        }
        if (lex.g_emit_deps) {
            sema.emit_deps();
            if (sema.has_errors()) { return 1; }
            return 0;
        }
        base.emit_diags();
        if (sema.has_errors()) {
            return 1;
        }
        return 0;
    }

    if (cmd == "compile") {
        var out_dir: string = "";
        var has_out: bool = false;
        var mode: string = "dbg";
        var ai: i64 = 3;
        var an: i64 = slice_len(argv) as i64;
        var src_file: string = "";
        var has_src: bool = false;
        var files: []string;
        while (ai < an) {
            if (argv[ai] == "--mode") {
                if (ai + 1 < an) {
                    mode = argv[ai + 1];
                    ai = ai + 2;
                    continue;
                }
            }
            if (argv[ai] == "--output") {
                if (ai + 1 < an) {
                    out_dir = argv[ai + 1];
                    has_out = true;
                    ai = ai + 2;
                    continue;
                }
            }
            if (argv[ai] == "--diagnostics") {
                if (ai + 1 < an) { base.g_diag_fmt = argv[ai + 1]; ai = ai + 2; continue; }
            }
            if (argv[ai] == "--json") { base.g_diag_fmt = "json"; ai = ai + 1; continue; }
            if (argv[ai] == "--trace-comptime") { sema.g_meta_trace = true; ai = ai + 1; continue; }
            // R2 多文件：非 flag 位置参数并入同一编译单元
            if (str_len(argv[ai]) as i64 >= 2 and str_slice(argv[ai], 0, 2) != "--") {
                append(files, argv[ai]);
                if (has_src == false) { src_file = argv[ai]; has_src = true; }
            }
            ai = ai + 1;
        }
        if (base.valid_mode(mode) == false) {
            eprint(base.sb_cat3("error: unknown --mode `", mode, "` (expected dbg|rls)\n"));
            return 2;
        }

        // R2 多文件：确保入口文件在编译单元内（单文件时 argv[2] 即唯一源）
        if (slice_len(files) as i64 == 0) { append(files, file); }
        base.g_file = base.rel_path(file);
        var src2: string = tc_load_src(files);
        if (sema.has_errors()) { base.emit_diags(); return 1; }
        parse.parse_unit();
        sema.run_check();
        comptime_fold.comptime_fold_pass();
        sema.meta_trace_flush();
        sema.ann_pass();
        if (sema.has_errors()) {
            base.emit_diags();
            return 1;
        }

        // S5-删除：旧 C 后端 codegen_c.emit_unit/h_join/s_join 已移除；
        // compile --emit-c 改走 tmir→C 便携后端（与 emit-ll --backend tmir-c 同源），产出单 .c。
        var mod2: string = base.base_no_tc(file);
        var opt_level: i64 = 0;
            tir__tir_set_recording_mir(true);
            tir.g_relowering = false;
        tir.lower_unit(mod2, file);
        tir__tir_set_recording_mir(false);
        tir__g_mir.globals = tir__g_mod.globals;
        tir__g_mir.types = tir__g_mod.types;
        tir__g_mir.strings = tir__g_mod.strings;
        var mir_mod: MIRModule = mir__mir_from_tir(tir__g_mir);
        mir__mir_run(mir_mod, opt_level);
        var tm: TIRModule = mir__mir_to_tir_lower(mir_mod);
        var mm: TMIRModule = tmir.tir_to_tmir_lower(tm);
        var out_text: string = codegen_c_tmir.tmir_to_c(mm);

        if (has_out == false) {
            // 缺省按 --mode 落入 out/dbg|out/rls
            out_dir = base.sb_cat3("out/", mode, "");
        }

        var cp: string = base.sb_cat4(out_dir, "/", mod2, ".c");
        base.ensure_parent(cp);
        file_write_all(cp, out_text);
        print(base.sb_cat4("Generated: ", base.to_bs(cp), "\n", ""));
        return 0;
    }

    if (cmd == "emit-dev") {
        // Device 子系统（docs/compiler/device-design.md §2 L4）：把模块里的 `kernel fn` emit 成
        // Device Dialect 文本（.mlir），供 tools/mlir-t-device 的 --device-to-nvvm 预演
        // lowering → PTX。只需前端（parse 后 decl_list 已就绪），不做 host 双后端发射。
        var out_p: string = "";
        var has_outp: bool = false;
        var ai3: i64 = 2;
        var an3: i64 = slice_len(argv) as i64;
        while (ai3 < an3) {
            if (argv[ai3] == "--output") {
                if (ai3 + 1 < an3) {
                    out_p = argv[ai3 + 1];
                    has_outp = true;
                    ai3 = ai3 + 2;
                    continue;
                }
            }
            ai3 = ai3 + 1;
        }
        if (has_outp == false) {
            var mod3: string = base.base_no_tc(file);
            out_p = base.sb_cat4("out/dbg/", mod3, "", ".mlir");
        }
        base.g_file = base.rel_path(file);
        var src4: string = file_read_all(file);
        lex.tokenize(src4);
        hir.g_last_src = src4;
        if (sema.has_errors()) { base.emit_diags(); return 1; }
        lex.pos = 0;
        sema.init_anndefs();
        parse.parse_unit();
        if (sema.has_errors()) {
            base.emit_diags();
            return 1;
        }
        var mlir: string = codegen_dev.emit_device_module();
        base.ensure_parent(out_p);
        file_write_all(out_p, mlir);
        print(base.sb_cat3("Generated device dialect: ", base.to_bs(out_p), "\n"));
        return 0;
    }

    if (cmd == "dump-ast") {
        // S5 step4：序列化 parse 后 CST 为 `.ast` 文本（供 IDE / 增量重编锚点 / `tc --format` 往返）。
        // 仅遍历语法树，不跑语义检查（与 emit-hir 同层，但产出源忠实树而非 HIR）。
        var src_file: string = "";
        var has_src: bool = false;
        var out_p: string = "";
        var has_outp: bool = false;
        var ai2: i64 = 2;
        var an2: i64 = slice_len(argv) as i64;
        while (ai2 < an2) {
            if (argv[ai2] == "--output") {
                if (ai2 + 1 < an2) { out_p = argv[ai2 + 1]; has_outp = true; }
                ai2 = ai2 + 2; continue;
            }
            if (argv[ai2] == "--example") {
                if (ai2 + 1 < an2) { src_file = base.sb_cat3("examples/", argv[ai2 + 1], ".tc"); has_src = true; }
                ai2 = ai2 + 2; continue;
            }
            if (has_src == false) { src_file = argv[ai2]; has_src = true; }
            ai2 = ai2 + 1;
        }
        if (has_src == false) {
            eprint("usage: tc dump-ast <file.tc> | --example <name> [--output <path>]\n");
            return 2;
        }
        base.g_file = base.rel_path(src_file);
        var src: string = file_read_all(src_file);
        lex.tokenize(src);
        hir.g_last_src = src;
        if (sema.has_errors()) { base.emit_diags(); return 1; }
        lex.pos = 0;
        sema.init_anndefs();
        parse.parse_unit();
        if (sema.has_errors()) { base.emit_diags(); return 1; }   // 同 emit-hir：禁止静默空跑
        base.assign_trivia();   // S5 step5：把 lexer 保留的 trivia 分配到各节点 leading/trailing 间隙
        var txt: string = base.cst_to_ast_str(lex.decl_list);
        if (has_outp) { file_write_all(out_p, txt); }
        else { print(txt); }
        return 0;
    }

    if (cmd == "fmt") {
        // S8 step1（§0.16.11）+ step2（§0.16.12）：trivia 感知源码再发射 / 规范化重排。
        // 默认 = 规范化重排（括号深度缩进 + 去行尾空白 + 折叠多空行；注释原样保留）；
        // `--identity` = step1 忠实还原（逐字节复现源码，用于验证归并正确性）。
        // 两者都只消费词法 token 流 + trivia 流，不跑语法/语义分析（见下方 append-only 说明）。
        var src_file: string = "";
        var has_src: bool = false;
        var out_p: string = "";
        var has_outp: bool = false;
        var ident: bool = false;
        var ai2: i64 = 2;
        var an2: i64 = slice_len(argv) as i64;
        while (ai2 < an2) {
            if (argv[ai2] == "--output") {
                if (ai2 + 1 < an2) { out_p = argv[ai2 + 1]; has_outp = true; }
                ai2 = ai2 + 2; continue;
            }
            if (argv[ai2] == "--example") {
                if (ai2 + 1 < an2) { src_file = base.sb_cat3("examples/", argv[ai2 + 1], ".tc"); has_src = true; }
                ai2 = ai2 + 2; continue;
            }
            if (argv[ai2] == "--identity") { ident = true; ai2 = ai2 + 1; continue; }
            if (has_src == false) { src_file = argv[ai2]; has_src = true; }
            ai2 = ai2 + 1;
        }
        if (has_src == false) {
            eprint("usage: tc fmt <file.tc> | --example <name> [--output <path>] [--identity]\n");
            return 2;
        }
        base.g_file = base.rel_path(src_file);
        var src: string = file_read_all(src_file);
        // S8 step1（§0.16.11）：忠实还原仅消费词法 token 流 + trivia 流（append-only 契约），
        // 不跑语法/语义分析——parse_unit 会经 fstr_parse_expr 再次 tokenize，把插值子表达式
        // token 追加进 toks，破坏「token 流 == 源码 token 序列」的逐字节还原。命令层先重置
        // 两条流（tokenize 本身保持 append-only，见 lex.tc 顶部注释），再 tokenize 主文件。
        base.toks = [];
        base.g_trivia_toks = [];
        lex.tokenize(src);
        var txt: string = "";
        if (ident) { txt = base.cst_format_tokens(); }
        else { txt = base.cst_format_normalized(4); }   // 4 空格/级 = examples 主导风格
        if (has_outp) { file_write_all(out_p, txt); }
        else { print(txt); }
        return 0;
    }

    if (cmd == "lint") {
        // S8 step3（§0.16.13）：HIR 上的结构化静态检查。
        // G7（§4.13.3）：与 fmt 共用 lexer/parser 底层，但消费层不同 —— fmt 只吃词法流+trivia，
        // lint 吃 HIR。故**本命令可以跑 parse_unit**（不需要 token 流与源码逐字节对应，
        // f-string 插值 token 追加到 toks 尾部不影响 HIR 构建）。
        // 本步不跑 sema（pre-type HIR）：三条规则都是结构性的，不依赖类型；语义侧表规则留后续步。
        var src_file: string = "";
        var has_src: bool = false;
        var strict: bool = false;
        var ai2: i64 = 2;
        var an2: i64 = slice_len(argv) as i64;
        while (ai2 < an2) {
            if (argv[ai2] == "--strict") { strict = true; ai2 = ai2 + 1; continue; }
            if (argv[ai2] == "--example") {
                if (ai2 + 1 < an2) { src_file = base.sb_cat3("examples/", argv[ai2 + 1], ".tc"); has_src = true; }
                ai2 = ai2 + 2; continue;
            }
            if (has_src == false) { src_file = argv[ai2]; has_src = true; }
            ai2 = ai2 + 1;
        }
        if (has_src == false) {
            eprint("usage: tc lint <file.tc> | --example <name> [--strict]\n");
            return 2;
        }
        base.g_file = base.rel_path(src_file);
        var src: string = file_read_all(src_file);
        lex.tokenize(src);
        hir.g_last_src = src;
        if (sema.has_errors()) { base.emit_diags(); return 1; }
        lex.pos = 0;
        sema.init_anndefs();
        parse.parse_unit();
        if (sema.has_errors()) { base.emit_diags(); return 1; }   // 同 emit-hir：禁止静默空跑
        hir.hir_build(src);          // 结果落在 hir.g_hir（lint 直接扫 g_hir）
        var cnt: i64 = hir.lint_run();
        if (strict and cnt > 0) { return 1; }
        return 0;
    }

    if (cmd == "emit-tir") {
        // TIR 后端桥（compiler-pipeline-design.md §4.4 / tir-design.md）：把已擦除类型的编译单元
        // 降级为类型擦除·文件级·线性 TIR 文本（src/tir.tc）。新增加性命令，不动 C/LLVM 后端。
        var out_p: string = "";
        var has_outp: bool = false;
        var mode: string = "dbg";
        var src_file: string = "";
        var has_src: bool = false;
        var files: []string;
        var ex_name: string = "";
        var is_example: bool = false;
        var ai2: i64 = 2;
        var an2: i64 = slice_len(argv) as i64;
        while (ai2 < an2) {
            if (argv[ai2] == "--output") {
                if (ai2 + 1 < an2) { out_p = argv[ai2 + 1]; has_outp = true; }
                ai2 = ai2 + 2; continue;
            }
            if (argv[ai2] == "--mode") {
                if (ai2 + 1 < an2) { mode = argv[ai2 + 1]; }
                ai2 = ai2 + 2; continue;
            }
            if (argv[ai2] == "--diagnostics") {
                if (ai2 + 1 < an2) { base.g_diag_fmt = argv[ai2 + 1]; }
                ai2 = ai2 + 2; continue;
            }
            if (argv[ai2] == "--json") { base.g_diag_fmt = "json"; ai2 = ai2 + 1; continue; }
            if (argv[ai2] == "--example") {
                if (ai2 + 1 < an2) { ex_name = argv[ai2 + 1]; is_example = true; }
                ai2 = ai2 + 2; continue;
            }
            if (has_src == false) { src_file = argv[ai2]; has_src = true; }
            ai2 = ai2 + 1;
        }
        if (base.valid_mode(mode) == false) {
            eprint(base.sb_cat3("error: unknown --mode `", mode, "` (expected dbg|rls)\n"));
            return 2;
        }
        if (is_example) {
            var probe: string = base.sb_cat4("cmd /c if exist \"examples\\", ex_name, ".tc\" (exit 0) else (exit 1)", "");
            var prc: i32 = sys_run(probe);
            if (prc != 0) {
                eprint(base.sb_cat3("error: no example named `", ex_name, "`\n"));
                return 2;
            }
            src_file = base.sb_cat3("examples/", ex_name, ".tc");
            has_src = true;
            if (has_outp == false) {
                var exdir: string = base.to_bs(base.sb_cat3("out/", mode, "/examples"));
                sys_run(base.sb_cat5("cmd /c if not exist \"", exdir, "\" mkdir \"", exdir, "\""));
                out_p = base.sb_cat4("out/", mode, "/examples/", ex_name);
                has_outp = true;
            }
        }
        if (has_src == false) {
            eprint("usage: tc emit-tir <file.tc> | --example <name> [--mode dbg|rls] [--output <path>]\n");
            return 2;
        }
        base.g_file = base.rel_path(src_file);
        var src3: string = file_read_all(src_file);
        lex.tokenize(src3);
        hir.g_last_src = src3;
        if (sema.has_errors()) { base.emit_diags(); return 1; }
        lex.pos = 0;
        sema.init_anndefs();
        parse.parse_unit();
        sema.run_check();
        sema.run_device_check();
        comptime_fold.comptime_fold_pass();
        sema.meta_trace_flush();
        sema.ann_pass();
        if (sema.has_errors()) { base.emit_diags(); return 1; }
        var mod2: string = base.base_no_tc(src_file);
        tir.g_relowering = false;
        tir.lower_unit(mod2, src_file);
        if (has_outp == false) { out_p = base.sb_cat4("out/", mode, "/", mod2); }
        var tirp: string = base.sb_cat2(out_p, ".tir");
        base.ensure_parent(tirp);
        file_write_all(tirp, tir.tir_to_text());
        eprint(base.sb_cat3("Generated: ", base.to_bs(tirp), "\n"));
        return 0;
    }

    if (cmd == "emit-tir-ll") {
        // TIR -> LLVM IR 薄后端（设计 §9.2 / Stage 3）。消费 tir.lower_unit 产出的 TIR 文本，
        // 翻译为 LLVM IR 文本。新增加性命令，不动 emit-ll/build（保留自举不动点）。
        var out_p: string = "";
        var has_outp: bool = false;
        var mode: string = "dbg";
        var src_file: string = "";
        var has_src: bool = false;
        var files: []string;
        var ex_name: string = "";
        var is_example: bool = false;
        var emit_link_deps: bool = false;   // 仅输出 emit 后解析到的外部链接库（.tlib），供 diffpipe 手动 link 复用
        var ai2: i64 = 2;
        var an2: i64 = slice_len(argv) as i64;
        while (ai2 < an2) {
            if (argv[ai2] == "--output") {
                if (ai2 + 1 < an2) { out_p = argv[ai2 + 1]; has_outp = true; }
                ai2 = ai2 + 2; continue;
            }
            if (argv[ai2] == "--mode") {
                if (ai2 + 1 < an2) { mode = argv[ai2 + 1]; }
                ai2 = ai2 + 2; continue;
            }
            if (argv[ai2] == "--example") {
                if (ai2 + 1 < an2) { ex_name = argv[ai2 + 1]; is_example = true; }
                ai2 = ai2 + 2; continue;
            }
            if (argv[ai2] == "--link-deps") {
                emit_link_deps = true;
                ai2 = ai2 + 1; continue;
            }
            if (has_src == false) { src_file = argv[ai2]; has_src = true; }
            ai2 = ai2 + 1;
        }
        if (base.valid_mode(mode) == false) {
            eprint(base.sb_cat3("error: unknown --mode `", mode, "` (expected dbg|rls)\n"));
            return 2;
        }
        if (is_example) {
            var probe: string = base.sb_cat4("cmd /c if exist \"examples\\", ex_name, ".tc\" (exit 0) else (exit 1)", "");
            var prc: i32 = sys_run(probe);
            if (prc != 0) {
                eprint(base.sb_cat3("error: no example named `", ex_name, "`\n"));
                return 2;
            }
            src_file = base.sb_cat3("examples/", ex_name, ".tc");
            has_src = true;
        }
        if (has_src == false) {
            eprint("usage: tc emit-tir-ll <file.tc> | --example <name> [--mode dbg|rls] [--output <path>]\n");
            return 2;
        }
        base.g_file = base.rel_path(src_file);
        var src3: string = file_read_all(src_file);
        lex.tokenize(src3);
        hir.g_last_src = src3;
        if (sema.has_errors()) { base.emit_diags(); return 1; }
        lex.pos = 0;
        sema.init_anndefs();
        parse.parse_unit();
        sema.run_check();
        sema.run_device_check();
        comptime_fold.comptime_fold_pass();
        sema.meta_trace_flush();
        sema.ann_pass();
        if (sema.has_errors()) { base.emit_diags(); return 1; }
        var mod2: string = base.base_no_tc(src_file);
        // ⚠ 代际分配器（2026-10-22）：emit-ll 走 LLVM 后端，启用逐函数重降级压低峰值
        // （函数体落 g_func 本块、emit 后立即 arena_reset_func 回收；tmir-c 后端禁用，因其消费 g_mod 真实体）。
        // 持久全局累加 slice（g_ll_named_types / g_func_names / g_func_paramsts / g_ll_extern_funcs /
        // g_ll_declared / g_clo_consts / g_clo_thunk_req / g_ll_valptr / g_ll_addrslot / g_ll_addrst /
        // g_ll_func_rets / ps 及其字符串元素）已在 emit 侧统一「切 g_arena 追加」保护，跨函数回收后不悬垂。
        tir.g_relowering = true;
        tir.lower_unit(mod2, src_file);
        if (has_outp == false) { out_p = base.sb_cat4("out/", mode, "/tirll_", mod2); }
        var llp: string = base.sb_cat2(out_p, ".tir.ll");
        base.ensure_parent(llp);
        tir.tir_verify_module();
        var lltext: string = tir_to_ll.tir_to_ll_emit(tir.g_mod);
        file_write_all(llp, lltext);
        tir.g_relowering = false;   // ⚠ 代际分配器：emit 完成后才关重降级（emit 期间须保持 true 以逐函数重降级）
        eprint(base.sb_cat3("Generated: ", base.to_bs(llp), "\n"));
        // --link-deps：把解析到的外部链接库（.tlib 归档）逐行打到 stdout，
        // 供 diffpipe 新轨手动 clang link 时一并并入（与 tc build 的 g_ext_link 一致）。
        if (emit_link_deps) {
            var nlk: i64 = slice_len(lex.g_ext_link) as i64;
            var elk: i64 = 0;
            while (elk < nlk) {
                print(lex.g_ext_link[elk]); print("\n");
                elk = elk + 1;
            }
        }
        return 0;
    }

    if (cmd == "emit-ll" or cmd == "build" or cmd == "run") {
        var out_p: string = "";
        var has_outp: bool = false;
        var rt_dir: string = "runtime";
        var clang_p: string = "clang";
        var backend: string = "tir";   // S5 收口
        var opt_level: i64 = 0;   // 中端优化等级（--opt/-O）；默认 0=关闭，保护自举不动点；新轨 TIR→LLVM 结构化翻译（§5.3/§5.6 合规）
        var mode: string = "dbg";
        var src_file: string = "";
        var has_src: bool = false;
        var files: []string;
        var ex_name: string = "";
        var is_example: bool = false;
        var is_lib: bool = false;        // build --lib：预编译外部库为 .tlib（归档 + 接口块）
        var lib_alias: string = "";      // 库规范别名（= 源文件名 stem 或 --mod-id 覆写），用于名字重整前缀
        var mod_id_override: string = "";// --mod-id：内部模块 build --lib 时显式指定完整路径身份（如 "src.base"），
                                         // 使产出的 .tlib 符号与入口 import 重整一致（入口按 idn 重整，非 stem）。
        var ai2: i64 = 2;
        var an2: i64 = slice_len(argv) as i64;
        while (ai2 < an2) {
            if (argv[ai2] == "--output") {
                if (ai2 + 1 < an2) {
                    out_p = argv[ai2 + 1];
                    has_outp = true;
                    ai2 = ai2 + 2;
                    continue;
                }
            }
            if (argv[ai2] == "--mode") {
                if (ai2 + 1 < an2) {
                    mode = argv[ai2 + 1];
                    ai2 = ai2 + 2;
                    continue;
                }
            }
            if (argv[ai2] == "--runtime") {
                if (ai2 + 1 < an2) {
                    rt_dir = argv[ai2 + 1];
                    ai2 = ai2 + 2;
                    continue;
                }
            }
            if (argv[ai2] == "--clang") {
                if (ai2 + 1 < an2) {
                    clang_p = argv[ai2 + 1];
                    ai2 = ai2 + 2;
                    continue;
                }
            }
            // T2「TIR 唯一 IR」：主编译路径（build/emit-ll/run）统一走新轨 TIR→LLVM，
            // 旧轨 codegen_ll 已彻底删除（.tlib 库归档亦迁至 tir_to_ll.build_tlib）
            // --opt / -O：中端优化等级（G3）。--opt 或 -O → 1（安全 pass 轨）；
            // --opt 2 / -O2 → 2（安全 pass + 内联轨）；--opt 0 → 0（关闭，护自举不动点）。
            // 仅影响 mir 优化轨，opt=0 默认路径字节级恒等，不动 fixed-point。
            if (argv[ai2] == "--opt") {
                opt_level = 1;
                if (ai2 + 1 < an2) {
                    var nx: string = argv[ai2 + 1];
                    if (nx == "2") { opt_level = 2; ai2 = ai2 + 1; }
                    else if (nx == "1") { opt_level = 1; ai2 = ai2 + 1; }
                    else if (nx == "0") { opt_level = 0; ai2 = ai2 + 1; }
                }
                ai2 = ai2 + 1; continue;
            }
            if (argv[ai2] == "-O") {
                opt_level = 1;
                if (ai2 + 1 < an2) {
                    var nx: string = argv[ai2 + 1];
                    if (nx == "2") { opt_level = 2; ai2 = ai2 + 1; }
                    else if (nx == "1") { opt_level = 1; ai2 = ai2 + 1; }
                    else if (nx == "0") { opt_level = 0; ai2 = ai2 + 1; }
                }
                ai2 = ai2 + 1; continue;
            }
            // -O2 / -O1 / -O0 后缀简写：用 string==string 比较（str 安全，C 后端可正确发射）。
            // 注意：勿在此对 string 调 slice_len/str_slice 之外再传给 []u8 形参——
            // C 后端对「string 实参→[]u8 形参」尚缺 str→slice 转换（LLVM 后端无此问题），
            // 会触发 clang 编译错误；该后端缺陷单列任务修复，编译器自身源码避免触发。
            if (argv[ai2] == "-O2") { opt_level = 2; ai2 = ai2 + 1; continue; }
            if (argv[ai2] == "-O1") { opt_level = 1; ai2 = ai2 + 1; continue; }
            if (argv[ai2] == "-O0") { opt_level = 0; ai2 = ai2 + 1; continue; }
            // 中性输入：显式追加一个库搜索目录（由调用方如 tote 解析环境变量/T_LIB_PATH 后传入）。
            // tc 自身不读环境变量；这里只接受显式参数，确保包搜索策略留在 tote。
            if (argv[ai2] == "--lib-dir") {
                if (ai2 + 1 < an2) {
                    append(lex.g_lib_dirs, argv[ai2 + 1]);
                    ai2 = ai2 + 2;
                    continue;
                }
            }
            // --backend：选择发射目标后端（T2 收口后仅新轨可选）
            //   tir         = TIR -> LLVM（默认，主编译路径）
            //   tmir-wasm   = TIR -> tmir(机器层) -> WAT
            //   tmir-riscv  = TIR -> tmir(机器层) -> rv64 汇编
            // 旧轨 ll（legacy codegen_ll）已删除：显式拒绝而不是静默回落默认，
            // 避免调用方以为在跑机器层、实际拿到 LLVM 产物（T2 期间 tmir 即因此不可达）。
            if (argv[ai2] == "--backend") {
                if (ai2 + 1 < an2) {
                    if (argv[ai2 + 1] == "tir" or argv[ai2 + 1] == "tmir-wasm" or argv[ai2 + 1] == "tmir-riscv" or argv[ai2 + 1] == "tmir-c") {
                        backend = argv[ai2 + 1];
                        ai2 = ai2 + 2;
                        continue;
                    }
                    eprint(base.sb_cat3("error: unknown --backend `", argv[ai2 + 1], "` (expected tir|tmir-wasm|tmir-riscv|tmir-c; legacy ll retired)\n"));
                    return 2;
                }
            }
            if (argv[ai2] == "--lib") {
                is_lib = true;
                ai2 = ai2 + 1;
                continue;
            }
            // --mod-id <idn>：内部模块 build --lib 时指定完整路径身份（如 "src.base"），
            // 使 .tlib 符号重整与入口 import(idn) 一致；外部库（idn==stem）无需传。
            if (argv[ai2] == "--mod-id") {
                if (ai2 + 1 < an2) { mod_id_override = argv[ai2 + 1]; ai2 = ai2 + 2; continue; }
            }
            if (argv[ai2] == "--debug") {
                lex.g_lib_debug = true;
                ai2 = ai2 + 1;
                continue;
            }
            if (argv[ai2] == "--debug-libs") {
                lex.g_debug_libs = true;
                ai2 = ai2 + 1;
                continue;
            }
            if (argv[ai2] == "--diagnostics") {
                if (ai2 + 1 < an2) { base.g_diag_fmt = argv[ai2 + 1]; ai2 = ai2 + 2; continue; }
            }
            if (argv[ai2] == "--json") { base.g_diag_fmt = "json"; ai2 = ai2 + 1; continue; }
            if (argv[ai2] == "--trace-comptime") { sema.g_meta_trace = true; ai2 = ai2 + 1; continue; }
            if (argv[ai2] == "--example") {
                if (ai2 + 1 < an2) {
                    ex_name = argv[ai2 + 1];
                    is_example = true;
                    ai2 = ai2 + 2;
                    continue;
                }
            }
            // 位置参数：第一个非 flag 即源文件；其后所有位置参数并入同一编译单元（R2 多文件）
            if (has_src == false) {
                src_file = argv[ai2];
                has_src = true;
            }
            append(files, argv[ai2]);
            ai2 = ai2 + 1;
        }
        if (base.valid_mode(mode) == false) {
            eprint(base.sb_cat3("error: unknown --mode `", mode, "` (expected dbg|rls)\n"));
            return 2;
        }

        // cargo 风格 example：源 = examples/<name>.tc，产物 = out/<mode>/examples/<name>.exe
        if (is_example) {
            var probe: string = base.sb_cat4("cmd /c if exist \"examples\\", ex_name, ".tc\" (exit 0) else (exit 1)", "");
            var prc: i32 = sys_run(probe);
            if (prc != 0) {
                eprint(base.sb_cat3("error: no example named `", ex_name, "`\navailable examples:\n"));
                sys_run("cmd /c dir /b examples\\*.tc 2>nul");
                return 2;
            }
            src_file = base.sb_cat3("examples/", ex_name, ".tc");
            has_src = true;
            if (has_outp == false) {
                var exdir: string = base.to_bs(base.sb_cat3("out/", mode, "/examples"));
                sys_run(base.sb_cat5("cmd /c if not exist \"", exdir, "\" mkdir \"", exdir, "\""));
                out_p = base.sb_cat4("out/", mode, "/examples/", ex_name);
                has_outp = true;
            }
        }
        if (has_src == false) {
            eprint("usage: tc build|run <file.tc> | --example <name>\n");
            return 2;
        }
        // R2 多文件：--example 模式未走位置参数收集，此处补入唯一的源文件
        if (slice_len(files) as i64 == 0) { append(files, src_file); }

        // 缺省 clang：PATH 上没有时探测标准安装路径。
        // ⚠ 严禁用 sys_run("cmd /c if exist <绝对路径>") 探测：绝对路径触发 arena OOM
        //   （见 sema.tc:12383 同款问题），会污染 arena 致后续 anndefs append 段错误（build 必崩）。
        //   改用稳健的 file_exists 内建（C fopen 直查 / LLVM @tll_file_exists）。
        // hermetic：允许用 TC_CLANG 环境变量显式指定 clang，使「门禁解析一次、
        // 全链路继承」成为现实（gate 解析出 clang 后注入 TC_CLANG，所有 tc 子进程
        // 用同一份 clang 链接，避免隐式依赖 PATH / 硬编码路径漂移）。
        var tc_clang: string = getenv("TC_CLANG");
        if (tc_clang != "") {
            clang_p = tc_clang;
        } else {
            if (clang_p == "clang") {
                if (file_exists("C:/Program Files/LLVM/bin/clang.exe")) {
                    clang_p = "C:/Program Files/LLVM/bin/clang.exe";
                }
            }
        }

        base.g_file = base.rel_path(src_file);
        var src3: string = tc_load_src(files);
        if (sema.has_errors()) { base.emit_diags(); return 1; }
        if (is_lib) {
            // 预编译库：lib_alias 作为名字重整命名空间 + 模块值自引用（M.xxx）键，
            // 须与下游 import 的 alias 逐字节一致，否则链接缺符号。
            //   · 外部库（无 --mod-id）：alias = 源文件名 stem（如 "json"），idn==alias。
            //   · 内部模块（--mod-id src.base）：alias 取 idn 末段 "base"，
            //     与入口 import(src.base) 的 alias=last_segment(idn)="base" 一致；
            //     重整符号 = base__foo（mangled_name 内部对 alias 取末段，src.base→base），
            //     入口侧同样以 alias "base" 重整 → 两侧 base__foo 匹配。
            //   · g_lib_mod_idn 始终保留完整 idn（"src.base"），供 per-module ginit 符号
            //     t_ginit_src_base 命名；入口 declare/call 亦用 idn，两侧一致。
            lib_alias = base.base_no_tc(src_file);
            if (mod_id_override != "") {
                lib_alias = sema.last_segment(mod_id_override);   // "base"（模块值别名 / 子进程重整末段）
                lex.g_lib_mod_idn = mod_id_override;          // "src.base"（完整 idn）
            } else {
                lex.g_lib_mod_idn = lib_alias;
            }
            // 解析期 provenance = 完整 idn（"src.base"）：① 符号 node_mod 落为 "src.base"，
            //   与模块值键一致 → base.xxx 自引用经 g_modval_get("base")→"src.base" 命中本模块符号；
            //   ② 重整取 last_segment(g_cur_mod) = "base" → 符号 base__foo，与入口 import(src.base)
            //   的 alias="base" 重整逐字节一致。代码生成期（line ~1007）g_cur_mod 会被重置为 ""，
            //   故在此捕获 provenance 即可。
            base.g_cur_mod = lex.g_lib_mod_idn;
            // 独立编译（build --lib）时本模块是「入口」而非被导入，handle_one_import 不会为其登记
            // 模块值，导致 body 内的 base.xxx 自引用报「未定义标识符 base」。手动补登记：
            //   alias("base") → idn("src.base")，与下游 import 的模块值键一致。
            sema.g_modval_set(lib_alias, lex.g_lib_mod_idn);
            lex.g_lib_emit = true;       // 跳过进程级全局发射（t.__ginit / atom 表），避免链接冲突
        }
        base.g_intern_active = false; // 阶段 1：parse 期不驻留（g_parse 临时串不得作 canonical）
        base.str_intern_init();       // 阶段 1：在 g_arena 预分配字符串驻留表（运行期定址写，不污染 parse arena）
        arena_use_parse();            // 前端本块 arena：parse 期 AST/CST 落 g_parse
        parse.parse_unit();
        arena_use_default();          // sema 持久表（类型/符号）须落 g_arena，切回默认
        base.g_intern_active = true;  // 阶段 1：进入持久阶段，开启字符串驻留（canonical 落 g_arena，安全）
        if (is_lib) { base.g_cur_mod = ""; }
        file_write_all("out/dbg/_phase.log", "run_check\n");
        sema.run_check();
        file_write_all("out/dbg/_phase.log", "run_check_done\n");
        sema.run_device_check();
        file_write_all("out/dbg/_phase.log", "device_check_done\n");
        comptime_fold.comptime_fold_pass();
        file_write_all("out/dbg/_phase.log", "comptime_done\n");
        sema.meta_trace_flush();
        file_write_all("out/dbg/_phase.log", "flag_done\n");
        sema.ann_pass();
        file_write_all("out/dbg/_phase.log", "ann_done\n");
        if (sema.has_errors()) {
            base.emit_diags();
            return 1;
        }
        if (sema.has_warnings()) {
            sema.print_warn_summary();
        }
        arena_reset_parse();        // 前端完成：释放 parse 期 AST/CST（g_parse）；lower/emit 只依赖 TIR+持久表
        file_write_all("out/dbg/_phase.log", "front_reset_done\n");

        var mod2: string = base.base_no_tc(src_file);
        var lltext: string = "";
        var out_ext: string = ".ll";   // 输出文件扩展名（tmir 后端改为 .wat/.s）
        var out_text: string = "";      // 实际写出内容（tir/ll 时为 lltext）

        if (backend == "tmir-wasm") {
            // 路线 §11：sema → mir(pre-TIR 优化) → TIR → tmir → WAT
            // 开启录制：tir.lower_unit 在 TIR 发射期并行录制 pre-TIR 线性 MIR 到 g_mir
            tir__tir_set_recording_mir(true);
            tir.g_relowering = false;
            tir.lower_unit(mod2, src_file);
            tir__tir_set_recording_mir(false);
            tir__g_mir.globals = tir__g_mod.globals;   // 非函数部分录制期不含，从 g_mod 取（优化不影响 globals）
            tir__g_mir.types = tir__g_mod.types;
            tir__g_mir.strings = tir__g_mod.strings;
            var mir_mod: MIRModule = mir__mir_from_tir(tir__g_mir);
            mir__mir_run(mir_mod, opt_level);          // 架构/设备/后端无关优化；opt=0 恒等
            var tm: TIRModule = mir__mir_to_tir_lower(mir_mod);   // CFG→线性 TIR，opt=0 字节级还原 g_mod
            var mm: TMIRModule = tmir.tir_to_tmir_lower(tm);
            out_text = codegen_wasm.tmir_to_wasm(mm);
            out_ext = ".wat";
        } else if (backend == "tmir-riscv") {
            // 路线 §11：sema → mir(pre-TIR 优化) → TIR → tmir → rv64 汇编
            tir__tir_set_recording_mir(true);
            tir.g_relowering = false;
            tir.lower_unit(mod2, src_file);
            tir__tir_set_recording_mir(false);
            tir__g_mir.globals = tir__g_mod.globals;
            tir__g_mir.types = tir__g_mod.types;
            tir__g_mir.strings = tir__g_mod.strings;
            var mir_mod: MIRModule = mir__mir_from_tir(tir__g_mir);
            mir__mir_run(mir_mod, opt_level);
            var tm: TIRModule = mir__mir_to_tir_lower(mir_mod);
            var mm: TMIRModule = tmir.tir_to_tmir_lower(tm);
            out_text = codegen_riscv.tmir_to_riscv(mm);
            out_ext = ".s";
        } else if (backend == "tir") {
            // S5 新轨（--backend tir 时进入）：sema → TIR → LLVM，结构化翻译（无文本 round-trip，§5.3/§5.6 合规）
            file_write_all("out/dbg/_phase.log", "lower_start\n");
            // ⚠ 代际分配器（2026-10-22）：LLVM 后端启用逐函数重降级压低峰值
            // （函数体落 g_func 本块、emit 后立即 arena_reset_func 回收；tmir-c 后端禁用，因其消费 g_mod 真实体）。
            // 持久全局累加 slice 已在 emit 侧统一「切 g_arena 追加」保护（见 tir_to_ll.tc 各 append 站点），
            // 跨函数回收后不悬垂。emit 完成后于下方重置回 false。
            tir.g_relowering = true;
            tir.lower_unit(mod2, src_file);
            file_write_all("out/dbg/_phase.log", "lower_done\n");
            tir.tir_verify_module();
            file_write_all("out/dbg/_phase.log", "verify_done\n");
            lltext = tir_to_ll.tir_to_ll_emit(tir.g_mod);
            file_write_all("out/dbg/_phase.log", "emit_done\n");
            tir.g_relowering = false;   // ⚠ 代际分配器：emit 完成后才关重降级（emit 期间须保持 true 以逐函数重降级）
            out_text = lltext;

            out_text = lltext;
        } else if (backend == "tmir-c") {
            // M2：tmir → C 便携后端（无需 LLVM）。sema → mir → TIR → tmir → .c。
            // ⚠ 代际分配器：tmir-c 消费 g_mod/g_mir 真实体，禁用逐函数重降级（必须保留完整函数体）。
            tir.g_relowering = false;
            tir__tir_set_recording_mir(true);
            tir.g_relowering = false;
            tir.lower_unit(mod2, src_file);
            tir__tir_set_recording_mir(false);
            tir__g_mir.globals = tir__g_mod.globals;
            tir__g_mir.types = tir__g_mod.types;
            tir__g_mir.strings = tir__g_mod.strings;
            var mir_mod: MIRModule = mir__mir_from_tir(tir__g_mir);
            mir__mir_run(mir_mod, opt_level);
            var tm: TIRModule = mir__mir_to_tir_lower(mir_mod);
            var mm: TMIRModule = tmir.tir_to_tmir_lower(tm);
            out_text = codegen_c_tmir.tmir_to_c(mm);
            out_ext = ".c";
        }

        // 输出目录：--output 指定 exe/目录前缀；缺省按 --mode 落入 out/dbg|out/rls
        if (has_outp == false) {
            if (is_lib) {
                // 预编译库产物：模式无关的归档缓存 out/lib/<stem>.tlib（+ 伴随 .ll），
                // 与 resolve_external_lib_archive 的 out/lib 搜索路径一致。
                out_p = base.sb_cat2("out/lib/", mod2);
            } else {
                out_p = base.sb_cat4("out/", mode, "/", mod2);
            }
        }

        var llp: string = base.sb_cat2(out_p, out_ext);
        base.ensure_parent(llp);
        file_write_all(llp, out_text);
        eprint(base.sb_cat3("Generated: ", base.to_bs(llp), "\n"));

        // tmir 后端（wasm/riscv）：产出的 .wat/.s 需目标工具链（wat2wasm / riscv64 gcc）
        // 才能链接运行；此处等价 emit-ll，仅写出 IR 即返回（链接留待工具链机器）。
        if (cmd == "emit-ll" or backend == "tmir-wasm" or backend == "tmir-riscv") {
            return 0;
        }

        // 库预编译（build --lib）：emit-ll 后直接产出 .tlib（归档 + 接口块），不链 exe、不要求 main
        if (is_lib) {
            return tir_to_ll.build_tlib(out_p, lib_alias, clang_p);
        }

        // 无入口时提前报错：否则 lld-link 只会给出
        // "subsystem must be defined" 这类无从下手的链接期诊断。
        // tmir 后端在 emit-ll 等价路径已返回，不会走到此处。
        if (backend == "tir") {
            if (tir_to_ll.g_has_main == false) {
                eprint(base.sb_cat3("error: no entry point: ", base.to_bs(src_file), " 缺少 @main 标注的函数（build/run 需要入口；只想产出 IR 请用 emit-ll）\n"));
                return 1;
            }
        }

        // build：调 clang 一步链接 runtime 出 exe
        var exep: string = base.sb_cat2(out_p, ".exe");
        // 依赖静态库：out/<mode>/deps/t_runtime.lib（tools/build_runtime.mjs 预编译）
        // ⚠ 2026-09-26 起**没有回退**：t_runtime.c 已依赖 vendored 的
        //   mimalloc / fdlibm / imath / Ryu，缺 `-I mimalloc/include` 与那 100 个
        //   .obj 必然编不过（此前「回退直编 runtime 源码」会给出一串无从下手的
        //   clang 错误）。缺失时直接报可操作诊断。
        var deps_lib: string = base.sb_cat3("out/", mode, "/deps/t_runtime.lib");
        var use_lib: bool = sema.path_exists(deps_lib);
        // ⚠ dbg 也走 -O2（保留 -gcodeview 供调试符号）：tir_to_ll 发射的 IR 采用全栈分配
        // （每个局部一个 alloca）且无尾调用消除；编译器自举编译自身巨型 src/tc.tc 时 -O0
        // 帧过大、深递归无 TCO ⇒ 爆栈（exit 127 / STATUS_STACK_OVERFLOW）。-O2 折叠尾递归后
        // 4GB 预留栈绰绰有余。
        // 发射产物 .ll 由发射器逻辑决定，与宿主编译器优化级别无关（已验证 -O0/-O2 发射
        // 逐字节一致），故提高 dbg 优化级不影响任何 IR 快照 / 示例 / conformance 结果。
        var opt: string = "-O2 -gcodeview";
        if (mode == "rls") { opt = "-O2"; }
        var csb2: StringBuilder = sb_new();
        sb_append_str(csb2, "\"");
        sb_append_str(csb2, clang_p);
        sb_append_str(csb2, "\" ");
        sb_append_str(csb2, opt);
        sb_append_str(csb2, " -o \"");
        sb_append_str(csb2, exep);
        sb_append_str(csb2, "\" -Wl,-subsystem:console -Xlinker /STACK:4294967296,134217728 \"");
        sb_append_str(csb2, llp);
        sb_append_str(csb2, "\" ");
        // C 后端（tmir-c）产物含 `#include "t_runtime.h"` 并调用运行时函数
        //   （t_int_to_str / t_slice_at 等），必须注入 -I <runtime> 并链接 t_runtime.lib，
        //   与 LLVM 后端共用同一份预编译运行时（run_examples.mjs 同款路径）。
        //   此前 tmir-c 既不注入 -I 也不链 runtime → 生成的 .c 编译期找不到 t_runtime.h、
        //   运行期缺运行时符号。--runtime 可覆盖默认 rt_dir。
        sb_append_str(csb2, "-I \"");
        sb_append_str(csb2, rt_dir);
        sb_append_str(csb2, "\" ");
        if (use_lib) {
            sb_append_str(csb2, "\"");
            sb_append_str(csb2, deps_lib);
            sb_append_str(csb2, "\"");
        } else {
            eprint(base.sb_cat5("error: 运行时静态库缺失：", deps_lib,
                " —— t_runtime.c 已依赖 vendored 的 mimalloc / fdlibm / imath / Ryu，不可从源码直编。",
                "\n  先执行：node tools/build_runtime.mjs", "\n"));
            return 1;
        }
        // 链接模式外部库：把命中的 .tlib 归档（重命名的 .a）一并交给链接器
        var elk: i64 = 0;
        var nelk: i64 = slice_len(lex.g_ext_link) as i64;
        while (elk < nelk) {
            sb_append_str(csb2, " \"");
            sb_append_str(csb2, lex.g_ext_link[elk]);
            sb_append_str(csb2, "\"");
            elk = elk + 1;
        }
        var rc: i32 = sys_run(sb_to_str(csb2));
        if (rc != 0) {
            eprint("clang link failed\n");
            return 1;
        }
        eprint(base.sb_cat3("Built: ", base.to_bs(exep), "\n"));

        // run：构建成功后立即执行，透传子进程退出码（cargo run 语义）
        if (cmd == "run") {
            var run_cmd: string = base.sb_cat3("\"", base.to_bs(exep), "\"");
            var rrc: i32 = sys_run(run_cmd);
            return rrc;
        }
        return 0;
    }

    if (cmd == "test") {
        return test.run_test_cmd(argv);
    }

    eprint("unknown command\n");
    return 2;
}