parse_case fn(ci: i64) -> i64 {
    var r_Ident: string = expect_tok("Identifier");
    var r_type: i64 = -1;
    if (cur_t() == "LParen") {
    expect_tok("LParen");
    r_type = parse_type();
    expect_tok("RParen");
    }
    var r_anns: i64 = parse_annotations();
    if (cur_t() == "Comma" || cur_t() == "Semicolon") {
    if (cur_t() == "Comma") {
    expect_tok("Comma");
    }    else if (cur_t() == "Semicolon") {
    expect_tok("Semicolon");
    } else {
        eprint("parse error: unexpected token in alternative\n"); exit(1);
    }
    }
    var __id: i64 = mk_VC(r_Ident, ci, r_type, r_anns, -1);
    return __id;
}

parse_variant_decl fn(name: string, anns: i64) -> i64 {
    advance_i();
    var r_anns: i64 = parse_annotations();
    expect_tok("LBrace");
    var r_case: i64 = -1;
