// totter.tc — 数据驱动的程序生成器（用 t 语言编写）
//
// 它读取当前的 `src/tote.tc`（编译器前端 + 引擎），把其中用
// `// >>> GEN:xxx >>>` ... `// <<< GEN:xxx <<<` 标记的数据表区间，
// 替换为「由 build/ebnf.json（由 reference.md 的 ebnf 块经 tools/gen_ebnf.mjs 生成）数据驱动生成」的代码，输出 `gen/tote.tc`。
//
// 数据模型（真相源链）来自 reference.md 的 ebnf 块 → tools/gen_ebnf.mjs → build/ebnf.json，
// 由下方的 JSON 解析器加载到全局表：
//   - 关键字表   kw_t / kw_k               → 生成 kw_lookup（词法）
//   - 内建函数表 bi_cond / bi_ret          → 生成 builtin_ret（类型检查）
//   - 派生策略表 dv_names                   → 生成 vv_derive_traits（@derive）
//   - 诊断码表   dg_code / dg_sev          → 生成 diag_sev（诊断严重度查询）
//   - 注解注册表 an_name / an_spec / an_targets / an_repl → 生成 init_anndefs（§4.8）
//   - 解析器分发表 dp_*（来自 ebnf.json dispatches 段，见 reference.md §2.7）→ 生成 parse_decl_body 的 GEN:parser_dispatch 区间
//
// 生成的 gen/tote.tc 行为须与 src/tote.tc 逐字节等价（difftest 验证），
// 从而证明「用数据驱动方式生成 tote」不破坏编译器语义。

// ───────────── 全局数据表（由 build/ebnf.json 填充）─────────────

var kw_t: []string;          // 关键字文本
var kw_k: []string;          // 对应 token 种类

var bi_cond: []string;       // 内建名判定条件（完整 if 条件文本）
var bi_ret: []string;        // 返回类型构造表达式

var dv_names: []string;      // @derive 支持的 trait 名

var dg_code: []string;       // 诊断码名（T_XXX）
var dg_sev: []string;        // 规范严重度（"error" / "warning"；调用点可覆盖）

var an_name: []string;       // 注解名
var an_spec: []string;       // 参数规约（none/string/ident/ident_list/number/mixed）
var an_targets: []string;    // 合法作用目标（", " 分隔）
var an_repl: []string;       // 弃用替代（非空表示 deprecated）

var nd_name: []string;       // AST 节点种类名（reference.md §2.9 NodeTable）
var nd_slots: []string;      // 该种类使用的槽，空格分隔（按 Node 结构字段序）
var slt_name: []string;      // 槽定义表（reference.md §2.9 SlotTable，行序 = Node 结构字段序）
var slt_note: []string;      // 记法（str/has/int/bool/node/list/anchor）
var slt_ty: []string;        // t 类型（string/bool/i64/u64）
var slt_def: []string;       // node_new 初值（t 字面量文本）
var slt_cmt: []string;       // 结构体字段注释（仅锚点槽有）

// ── 解析器分发表（由 build/ebnf.json 的 dispatches 段驱动，见 reference.md §2.7）──
// 为避免嵌套 slice，分发表以扁平 1D 数组存储：dp_name[i] + dp_start[i] + dp_len[i]
// 描述第 i 张表的名称与在扁平数组中的区间 [start, start+len)。
var dp_name: []string;      // 各分发表名（如 "DeclBody"）
var dp_start: []i64;       // 在扁平数组中的起始下标
var dp_len: []i64;         // 条目数
var dp_mkind: []string;     // 匹配种类：token / idval / default
var dp_mval: []string;      // 匹配值（token 种类名 / id 字面量；default 为空）
var dp_call: []string;      // 调用的 parse_* 表达式

// ── 数据驱动 parser 生成（由 build/ebnf.json 的 grammar 段驱动，见 reference.md §2.8）──
// 每条 grammar 规则生成一个 `parse_<name>` 递归下降函数。
var gp_name: []string;      // 规则名（函数名 = "parse_" + name）
var gp_params: []string;    // 函数参数串，如 "name: string, anns: i64"
var gp_ret: []string;       // 返回类型
var gp_node: []string;      // 构造的 AST 节点种类（空表示无）
var gp_eat: []string;       // "true" 表示先 advance_i() 吃掉分发表匹配的关键字
var gp_fold: []string;      // 规则生成模式："bin" = 左折叠二元运算塔，"" = 普通节点构造
var gp_mk: []string;        // "inline" = 构造块退回内联 node_new（槽表达式会分配节点时必需）
var gp_tree: []i64;         // grammar 结构化 EBNF 树（JSON 节点）
var gp_construct: []i64;    // 节点构造块数组（JSON 节点）
var gp_sb: StringBuilder;   // 生成时的全局 StringBuilder
var g_json_root: i64;       // load_tables 解析后的 JSON 根节点

// ── XID_Start / XID_Continue 范围表（来自 build/ebnf.json 的 xid_start/xid_continue，
//    由 tools/gen_xid.mjs 从 unicode-xid 的 UCD 范围表生成，十进制 [lo,hi] 闭区间）──
// 注意：ebnf.json 中范围为数字，totter 以字符串形式保存其十进制文本，发射时直接拼入源码。
var xid_start_lo: []string;
var xid_start_hi: []string;
var xid_cont_lo: []string;
var xid_cont_hi: []string;

// ───────────── 最小 JSON 解析器（索引式树，规避递归结构体类型）─────────────
// 节点不持有递归 slice 字段，改用 child/sib 索引链接，根节点统一存于 jnodes。
JsonNode :: struct {
    kind: i64;    // 0=obj, 1=arr, 2=str, 3=num, 4=bool, 5=null
    s: string;    // str/bool/num 文本
    key: string;  // object member key
    child: i64;   // 首个子节点（obj 成员 / arr 元素）
    sib: i64;     // 下一个兄弟节点
}

var jnodes: []JsonNode;
var jtext: string;
var jpos: i64;
var jl: i64;

jch :: func() -> i64 {
    if (jpos < 0 || jpos >= jl) { return -1; }
    return str_at(jtext, jpos);
}

json_newnode :: func(kind: i64, s: string) -> i64 {
    var n: JsonNode;
    n.kind = kind;
    n.s = s;
    n.key = "";
    n.child = -1;
    n.sib = -1;
    append(jnodes, n);
    return (slice_len(jnodes) as i64) - 1;
}

json_skip_ws :: func() -> void {
    var l: i64 = str_len(jtext) as i64;
    while (jpos < l) {
        var c: i64 = jch();
        if (c == 32 || c == 9 || c == 10 || c == 13) {
            jpos = jpos + 1;
        } else {
            break;
        }
    }
}

json_parse_value :: func() -> i64 {
    json_skip_ws();
    var c: i64 = jch();
    if (c == 34) { return json_parse_string(); }
    if (c == 123) { return json_parse_object(); }
    if (c == 91) { return json_parse_array(); }
    if (c == 116 || c == 102 || c == 110) { return json_parse_lit(); }
    return json_parse_number();
}

json_parse_string :: func() -> i64 {
    jpos = jpos + 1;   // 跳过开引号
    var buf: StringBuilder = sb_new();
    var l: i64 = str_len(jtext) as i64;
    while (jpos < l) {
        var c: i64 = jch();
        if (c == 34) { jpos = jpos + 1; break; }   // 闭引号
        if (c == 92) {   // 反斜杠转义
            jpos = jpos + 1;
            var e: i64 = jch();
            if (e == 34) { sb_append_char(buf, 34); }
            else if (e == 92) { sb_append_char(buf, 92); }
            else if (e == 47) { sb_append_char(buf, 47); }
            else if (e == 110) { sb_append_char(buf, 10); }
            else if (e == 116) { sb_append_char(buf, 9); }
            else if (e == 114) { sb_append_char(buf, 13); }
            else if (e == 98) { sb_append_char(buf, 8); }
            else if (e == 102) { sb_append_char(buf, 12); }
            else if (e == 117) {   // \uXXXX
                jpos = jpos + 1;
                var cp: i64 = 0;
                var k: i64 = 0;
                while (k < 4) {
                    var hc: i64 = jch();
                    var d: i64 = 0;
                    if (hc >= 48 && hc <= 57) { d = hc - 48; }
                    else if (hc >= 97 && hc <= 102) { d = hc - 87; }
                    else if (hc >= 65 && hc <= 70) { d = hc - 55; }
                    cp = cp * 16 + d;
                    jpos = jpos + 1;
                    k = k + 1;
                }
                if (cp < 128) { sb_append_char(buf, cp); } else { sb_append_char(buf, 63); }
            }
            else { sb_append_char(buf, e); }
            jpos = jpos + 1;
        } else {
            sb_append_char(buf, c);
            jpos = jpos + 1;
        }
    }
    return json_newnode(2, sb_to_str(buf));
}

json_parse_lit :: func() -> i64 {
    if (jch() == 116) {   // true
        jpos = jpos + 4;
        return json_newnode(4, "true");
    }
    if (jch() == 102) {   // false
        jpos = jpos + 5;
        return json_newnode(4, "false");
    }
    jpos = jpos + 4;   // null
    return json_newnode(5, "null");
}

json_parse_number :: func() -> i64 {
    var start: i64 = jpos;
    var l: i64 = str_len(jtext) as i64;
    while (jpos < l) {
        var c: i64 = jch();
        if ((c >= 48 && c <= 57) || c == 45 || c == 46 || c == 101 || c == 69 || c == 43) {
            jpos = jpos + 1;
        } else { break; }
    }
    return json_newnode(3, str_slice(jtext, start, jpos));
}

json_parse_array :: func() -> i64 {
    jpos = jpos + 1;   // 跳过 [
    var first: i64 = -1;
    var prev: i64 = -1;
    json_skip_ws();
    if (jch() == 93) { jpos = jpos + 1; }   // 空数组
    else {
        while (true) {
            // 元素值节点直接入链表（不再包一层 wrapper），与对象成员一致
            var v: i64 = json_parse_value();
            if (first < 0) { first = v; }
            else {
                var pv: JsonNode = jnodes[prev];
                pv.sib = v;
                slice_set(jnodes, prev, pv);
            }
            prev = v;
            json_skip_ws();
            var c: i64 = jch();
            if (c == 44) { jpos = jpos + 1; }
            else if (c == 93) { jpos = jpos + 1; break; }
            else { break; }
        }
    }
    var arrNode: i64 = json_newnode(1, "");
    var arrN: JsonNode = jnodes[arrNode];
    arrN.child = first;
    slice_set(jnodes, arrNode, arrN);
    return arrNode;
}

json_parse_object :: func() -> i64 {
    jpos = jpos + 1;   // 跳过 {
    var first: i64 = -1;
    var prev: i64 = -1;
    json_skip_ws();
    if (jch() == 125) { jpos = jpos + 1; }   // 空对象
    else {
        while (true) {
            json_skip_ws();
            var keyNode: i64 = json_parse_string();
            var key: string = jnodes[keyNode].s;
            json_skip_ws();
            jpos = jpos + 1;   // 跳过 :
            var v: i64 = json_parse_value();
            var m: JsonNode;
            m.kind = jnodes[v].kind;
            m.s = jnodes[v].s;
            m.key = key;
            m.child = v;
            m.sib = -1;
            append(jnodes, m);
            var midx: i64 = (slice_len(jnodes) as i64) - 1;
            if (first < 0) { first = midx; }
            else {
                var pm: JsonNode = jnodes[prev];
                pm.sib = midx;
                slice_set(jnodes, prev, pm);
            }
            prev = midx;
            json_skip_ws();
            var c: i64 = jch();
            if (c == 44) { jpos = jpos + 1; }
            else if (c == 125) { jpos = jpos + 1; break; }
            else { break; }
        }
    }
    var objNode: i64 = json_newnode(0, "");
    var objN: JsonNode = jnodes[objNode];
    objN.child = first;
    slice_set(jnodes, objNode, objN);
    return objNode;
}

// 在对象节点中按 key 查找成员，返回成员节点 idx（未找到返回 -1）
json_obj_get :: func(nidx: i64, key: string) -> i64 {
    if (nidx < 0) { return -1; }
    var m: i64 = jnodes[nidx].child;
    while (m >= 0) {
        if (jnodes[m].key == key) { return m; }
        m = jnodes[m].sib;
    }
    return -1;
}

load_tables :: func() -> void {
    // 数据来自 build/ebnf.json（由 reference.md 的 ebnf 块经 tools/gen_ebnf.mjs 抽取生成）。
    // totter 直接用下方最小 JSON 解析器读取它，填充各全局数据表；
    // 修改文法应改 reference.md 的 ebnf 产生式并重新生成 ebnf.json，而非本函数体。
    jtext = file_read_all("build/ebnf.json");
    jpos = 0;
    jl = str_len(jtext) as i64;
    var root: i64 = json_parse_value();

    // ── 关键字 → token 种类 ──
    // 约定：对象成员 child 直接指向值节点；数组节点 child 指向首个元素值节点，
    // 因此数组访问需先 descent 一层（n_X.child = 数组节点，再 .child = 首个元素）。
    var n_kw: i64 = json_obj_get(root, "keywords");
    var arr_kw: i64 = jnodes[n_kw].child;     // 数组节点
    var m: i64 = jnodes[arr_kw].child;        // 首个元素（对象节点）
    while (m >= 0) {
        var obj: i64 = m;                      // 元素即对象节点
        append(kw_t, jnodes[json_obj_get(obj, "text")].s);
        append(kw_k, jnodes[json_obj_get(obj, "kind")].s);
        m = jnodes[m].sib;
    }

    // ── 内建函数返回类型 ──
    var n_bi: i64 = json_obj_get(root, "builtins");
    var arr_bi: i64 = jnodes[n_bi].child;
    m = jnodes[arr_bi].child;
    while (m >= 0) {
        var obj: i64 = m;
        append(bi_cond, jnodes[json_obj_get(obj, "cond")].s);
        append(bi_ret, jnodes[json_obj_get(obj, "ret")].s);
        m = jnodes[m].sib;
    }

    // ── @derive 支持的 trait（数组元素为字符串，直接用 .s）──
    var n_dv: i64 = json_obj_get(root, "derives");
    var arr_dv: i64 = jnodes[n_dv].child;
    m = jnodes[arr_dv].child;
    while (m >= 0) {
        append(dv_names, jnodes[m].s);
        m = jnodes[m].sib;
    }

    // ── 诊断码 → 规范严重度 ──
    var n_dg: i64 = json_obj_get(root, "diagnostics");
    var arr_dg: i64 = jnodes[n_dg].child;
    m = jnodes[arr_dg].child;
    while (m >= 0) {
        var obj: i64 = m;
        append(dg_code, jnodes[json_obj_get(obj, "code")].s);
        append(dg_sev, jnodes[json_obj_get(obj, "sev")].s);
        m = jnodes[m].sib;
    }

    // ── 注解注册表（spec §4.8）──
    var n_an: i64 = json_obj_get(root, "annotations");
    var arr_an: i64 = jnodes[n_an].child;
    m = jnodes[arr_an].child;
    while (m >= 0) {
        var obj: i64 = m;
        append(an_name, jnodes[json_obj_get(obj, "name")].s);
        append(an_spec, jnodes[json_obj_get(obj, "spec")].s);
        append(an_targets, jnodes[json_obj_get(obj, "targets")].s);
        append(an_repl, jnodes[json_obj_get(obj, "repl")].s);
        m = jnodes[m].sib;
    }

    // ── AST 节点种类表（reference.md §2.9）──
    var n_nd: i64 = json_obj_get(root, "nodes");
    var arr_nd: i64 = jnodes[n_nd].child;
    m = jnodes[arr_nd].child;
    while (m >= 0) {
        var obj: i64 = m;
        var ndn: string = jnodes[json_obj_get(obj, "name")].s;
        append(nd_name, ndn);
        var sbs: StringBuilder = sb_new();
        var first: bool = true;
        var sl_arr: i64 = jchild(obj, "slots");
        var sl: i64 = -1;
        if (sl_arr >= 0) { sl = jnodes[sl_arr].child; }
        while (sl >= 0) {
            if (!first) { sb_append_str(sbs, " "); }
            first = false;
            sb_append_str(sbs, jstr(sl, "slot"));
            sl = jnodes[sl].sib;
        }
        var slstr: string = sb_to_str(sbs);
        append(nd_slots, slstr);
        m = jnodes[m].sib;
    }

    // ── 槽定义表（reference.md §2.9 SlotTable）──
    var n_sl: i64 = json_obj_get(root, "slots");
    var arr_sl: i64 = jnodes[n_sl].child;
    m = jnodes[arr_sl].child;
    while (m >= 0) {
        append(slt_name, jnodes[json_obj_get(m, "name")].s);
        append(slt_note, jnodes[json_obj_get(m, "note")].s);
        append(slt_ty, jnodes[json_obj_get(m, "ty")].s);
        append(slt_def, jnodes[json_obj_get(m, "def")].s);
        append(slt_cmt, jnodes[json_obj_get(m, "cmt")].s);
        m = jnodes[m].sib;
    }

    load_dispatches(root);
    load_xid(root);
    g_json_root = root;
}

// 读取 build/ebnf.json 的 grammar 段（每条规则的 EBNF 树 + 节点构造块）。
load_grammar :: func(root: i64) -> void {
    var n_g: i64 = json_obj_get(root, "grammar");
    if (n_g < 0) { return; }
    var arr: i64 = jnodes[n_g].child;
    var el: i64 = jnodes[arr].child;
    while (el >= 0) {
        // 临时变量承接下标，规避 t 发射器 append(slice, 函数返回值) 的 &右值 缺陷（&65 同类）
        var nm: string = jstr(el, "name");
        var prm: string = jstr(el, "params");
        var rt: string = jstr(el, "ret");
        var nd: string = jstr(el, "node");
        var et: string = jstr(el, "eatFirst");
        var fo: string = jstr(el, "fold");
        var mkm: string = jstr(el, "mk");
        var tr: i64 = jchild(el, "tree");
        var cn: i64 = jchild(el, "construct");
        append(gp_name, nm);
        append(gp_params, prm);
        append(gp_ret, rt);
        append(gp_node, nd);
        append(gp_eat, et);
        append(gp_fold, fo);
        append(gp_mk, mkm);
        append(gp_tree, tr);
        append(gp_construct, cn);
        el = jnodes[el].sib;
    }
}

// JSON 辅助：取对象成员的值字符串 / 子节点（数组或嵌套对象）
jstr :: func(nidx: i64, key: string) -> string {
    var m: i64 = json_obj_get(nidx, key);
    if (m < 0) { return ""; }
    return jnodes[m].s;
}
jchild :: func(nidx: i64, key: string) -> i64 {
    var m: i64 = json_obj_get(nidx, key);
    if (m < 0) { return -1; }
    return jnodes[m].child;
}
// 在 grammar 全局表里按规则名查参数串
gp_params_of :: func(name: string) -> string {
    var i: i64 = 0;
    while (i < slice_len(gp_name) as i64) {
        if (gp_name[i] == name) { return gp_params[i]; }
        i = i + 1;
    }
    return "";
}

// 把构造块表达式里的 `@sym` 解析为目标结果变量 `r_<sym>`，其余原样保留。
resolve_expr :: func(s: string) -> string {
    var out: StringBuilder = sb_new();
    var i: i64 = 0;
    var l: i64 = str_len(s) as i64;
    while (i < l) {
        var c: i64 = str_at(s, i);
        if (c == 64) {  // '@'
            i = i + 1;
            var j: i64 = i;
            while (j < l) {
                var d: i64 = str_at(s, j);
                if ((d >= 65 && d <= 90) || (d >= 97 && d <= 122) || (d >= 48 && d <= 57) || d == 95) { j = j + 1; }
                else { break; }
            }
            sb_append_str(out, "r_");
            sb_append_str(out, str_slice(s, i, j));
            i = j;
            continue;
        }
        sb_append_char(out, c);
        i = i + 1;
    }
    return sb_to_str(out);
}

// 生成 FIRST 集条件：`cur_t() == "K1" || cur_t() == "K2" ...`（空集则恒真）
first_cond :: func(arrNode: i64) -> string {
    var out: StringBuilder = sb_new();
    var first: bool = true;
    var el: i64 = jnodes[arrNode].child;
    while (el >= 0) {
        if (!first) { sb_append_str(out, " || "); }
        sb_append_str(out, "cur_t() == \"");
        sb_append_str(out, jnodes[el].s);
        sb_append_str(out, "\"");
        first = false;
        el = jnodes[el].sib;
    }
    if (first) { return "true"; }
    return sb_to_str(out);
}

// 在子树里找第一个会产生结果变量的符号（nt → r_<v>，id → r_Ident），用于 opt 的变量声明
result_var_of :: func(nidx: i64) -> string {
    if (nidx < 0) { return ""; }
    var k: string = jstr(nidx, "k");
    if (k == "nt") {
        var b: StringBuilder = sb_new();
        sb_append_str(b, "r_"); sb_append_str(b, jstr(nidx, "v"));
        return sb_to_str(b);
    }
    if (k == "id") { return "r_Ident"; }
    if (k == "int") { return "r_Integer"; }
    if (k == "group" || k == "opt" || k == "star" || k == "plus") { return result_var_of(jchild(nidx, "kid")); }
    if (k == "seq") {
        var kids: i64 = jchild(nidx, "kids");
        var kd: i64 = jnodes[kids].child;
        while (kd >= 0) {
            var r: string = result_var_of(kd);
            if (r != "") { return r; }
            kd = jnodes[kd].sib;
        }
    }
    return "";
}

// 拆分 "a: i64, b: bool" 形式的参数串，写入声明/参数/自增
split_params :: func(plist: string) -> []string {
    // 返回扁平数组：[name0, type0, name1, type1, ...]
    var out: []string;
    var i: i64 = 0;
    var l: i64 = str_len(plist) as i64;
    while (i < l) {
        // 跳到参数起始（非空白、非逗号）
        while (i < l && (str_at(plist, i) == 32 || str_at(plist, i) == 9 || str_at(plist, i) == 44)) { i = i + 1; }
        if (i >= l) { break; }
        var s: i64 = i;
        while (i < l && str_at(plist, i) != 58 && str_at(plist, i) != 44) { i = i + 1; }  // 到 ':' 或 ','
        var e: i64 = i;
        while (e > s && (str_at(plist, e - 1) == 32 || str_at(plist, e - 1) == 9)) { e = e - 1; }
        var nm: string = str_slice(plist, s, e);
        if (i < l && str_at(plist, i) == 58) { i = i + 1; }  // 跳过 ':'
        while (i < l && (str_at(plist, i) == 32 || str_at(plist, i) == 9)) { i = i + 1; }  // 跳过类型前空白
        var ts: i64 = i;
        while (i < l && str_at(plist, i) != 44) { i = i + 1; }  // 到 ','
        var te: i64 = i;
        while (te > ts && (str_at(plist, te - 1) == 32 || str_at(plist, te - 1) == 9)) { te = te - 1; }
        var ty: string = str_slice(plist, ts, te);
        if (nm != "") {
            append(out, nm);
            append(out, ty);
        }
    }
    return out;
}

// ── mk_<kind>(...) 构造器调用发射 ─────────────────────────────────────
// fields / exprs 是换行分隔的并行列表（槽名 → 赋值表达式）；§2.9 声明了但未列出的
// 槽自动填 node_new 的初值，因此与「node_new + 逐槽赋值 + slice_set」逐字节等价。
// ⚠ 铁律：仅当所有 expr 都不分配新节点时才可用。函数实参先于 node_new 求值，
//   若某 expr 内部分配子节点，子节点索引会挪到父节点之前 → AST 漂移。

nl_count :: func(s: string) -> i64 {
    var n: i64 = str_len(s) as i64;
    if (n == 0) { return 0; }
    var c: i64 = 1;
    var i: i64 = 0;
    while (i < n) {
        if (str_at(s, i) == 10) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

nl_at :: func(s: string, k: i64) -> string {
    var n: i64 = str_len(s) as i64;
    var start: i64 = 0;
    var idx: i64 = 0;
    var i: i64 = 0;
    while (i <= n) {
        var isend: bool = false;
        if (i == n) {
            isend = true;
        } else {
            if (str_at(s, i) == 10) { isend = true; }
        }
        if (isend) {
            if (idx == k) { return str_slice(s, start, i); }
            idx = idx + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

nl_find :: func(s: string, item: string) -> i64 {
    var c: i64 = nl_count(s);
    var i: i64 = 0;
    while (i < c) {
        if (nl_at(s, i) == item) { return i; }
        i = i + 1;
    }
    return -1;
}

// 槽在 node_new 里的初值——未显式赋值的参数一律填它。
slot_default :: func(s: string) -> string {
    var i: i64 = 0;
    while (i < slice_len(slt_name) as i64) {
        if (slt_name[i] == s) { return slt_def[i]; }
        i = i + 1;
    }
    return "?SLOT_DEF?";  // 表外槽：发射非法 token 让生成物编译失败（暴露 SlotTable 遗漏）
}

nd_slots_of :: func(kind: string) -> string {
    var i: i64 = 0;
    while (i < slice_len(nd_name) as i64) {
        if (nd_name[i] == kind) { return nd_slots[i]; }
        i = i + 1;
    }
    return "";
}

// 发射 `<indent><lhs>mk_<kind>(槽…, ti);`；ti 传 "-1" 表示不打 anchor。
emit_mk_call :: func(indent: string, lhs: string, kind: string, fields: string, exprs: string, ti: string) -> void {
    var sl: string = nd_slots_of(kind);
    var cnt: i64 = slot_count(sl);
    // 校验：construct 用到表外槽说明 §2.9 标注漏了，发射非法 token 让编译立刻失败
    var fc: i64 = nl_count(fields);
    var f: i64 = 0;
    while (f < fc) {
        var fname: string = nl_at(fields, f);
        var hit: i64 = -1;
        var q: i64 = 0;
        while (q < cnt) {
            if (slot_at(sl, q) == fname) { hit = q; }
            q = q + 1;
        }
        if (hit < 0) {
            sb_append_str(gp_sb, "!!! undeclared slot ");
            sb_append_str(gp_sb, fname);
            sb_append_str(gp_sb, " on node ");
            sb_append_str(gp_sb, kind);
            sb_append_str(gp_sb, " -- fix reference.md 2.9\n");
        }
        f = f + 1;
    }
    sb_append_str(gp_sb, indent);
    sb_append_str(gp_sb, lhs);
    sb_append_str(gp_sb, "mk_");
    sb_append_str(gp_sb, kind);
    sb_append_str(gp_sb, "(");
    var k: i64 = 0;
    while (k < cnt) {
        var pn: string = slot_at(sl, k);
        var fi: i64 = nl_find(fields, pn);
        if (fi < 0) {
            sb_append_str(gp_sb, slot_default(pn));
        } else {
            sb_append_str(gp_sb, nl_at(exprs, fi));
        }
        sb_append_str(gp_sb, ", ");
        k = k + 1;
    }
    sb_append_str(gp_sb, ti);
    sb_append_str(gp_sb, ");\n");
}

// ── 语句体专用 fold 发射器（骨架与手写 parse_* 逐字节等价，含 node_at 守卫）──

// fold=whilex：纯序列 while "(" expr ")" block
emit_whilex :: func(idx: i64) -> void {
    var name: string = gp_name[idx];
    var ret: string = gp_ret[idx];
    sb_append_str(gp_sb, "parse_"); sb_append_str(gp_sb, name);
    sb_append_str(gp_sb, " :: func() -> "); sb_append_str(gp_sb, ret); sb_append_str(gp_sb, " {\n");
    sb_append_str(gp_sb, "    var ti: i64 = advance_i();\n");
    sb_append_str(gp_sb, "    expect_tok(\"LParen\");\n");
    sb_append_str(gp_sb, "    var cond: i64 = parse_expr();\n");
    sb_append_str(gp_sb, "    expect_tok(\"RParen\");\n");
    sb_append_str(gp_sb, "    var body: i64 = parse_block();\n");
    emit_mk_call("    ", "var id: i64 = ", "while", "na\nla", "cond\nbody", "ti");
    sb_append_str(gp_sb, "    return id;\n");
    sb_append_str(gp_sb, "}\n\n");
}

// fold=returnx：return expr? ";"
emit_returnx :: func(idx: i64) -> void {
    var name: string = gp_name[idx];
    var ret: string = gp_ret[idx];
    sb_append_str(gp_sb, "parse_"); sb_append_str(gp_sb, name);
    sb_append_str(gp_sb, " :: func() -> "); sb_append_str(gp_sb, ret); sb_append_str(gp_sb, " {\n");
    sb_append_str(gp_sb, "    var ti: i64 = advance_i();\n");
    sb_append_str(gp_sb, "    var val: i64 = -1;\n");
    sb_append_str(gp_sb, "    if (cur_t() != \"Semicolon\") {\n");
    sb_append_str(gp_sb, "        val = parse_expr();\n");
    sb_append_str(gp_sb, "    }\n");
    sb_append_str(gp_sb, "    expect_tok(\"Semicolon\");\n");
    emit_mk_call("    ", "var id: i64 = ", "return", "na", "val", "ti");
    sb_append_str(gp_sb, "    return id;\n");
    sb_append_str(gp_sb, "}\n\n");
}

// fold=ifx：if "(" expr ")" block ("else" (block | if_stmt))?  —— else 分支的嵌套 if 须包成单元素 list 兜底
emit_ifx :: func(idx: i64) -> void {
    var name: string = gp_name[idx];
    var ret: string = gp_ret[idx];
    sb_append_str(gp_sb, "parse_"); sb_append_str(gp_sb, name);
    sb_append_str(gp_sb, " :: func() -> "); sb_append_str(gp_sb, ret); sb_append_str(gp_sb, " {\n");
    sb_append_str(gp_sb, "    var ti: i64 = advance_i();\n");
    sb_append_str(gp_sb, "    expect_tok(\"LParen\");\n");
    sb_append_str(gp_sb, "    var cond: i64 = parse_expr();\n");
    sb_append_str(gp_sb, "    expect_tok(\"RParen\");\n");
    sb_append_str(gp_sb, "    var then_head: i64 = parse_block();\n");
    sb_append_str(gp_sb, "    var else_head: i64 = -2;\n");
    sb_append_str(gp_sb, "    if (cur_t() == \"KwElse\") {\n");
    sb_append_str(gp_sb, "        advance_i();\n");
    sb_append_str(gp_sb, "        if (cur_t() == \"KwIf\") {\n");
    sb_append_str(gp_sb, "            var nested: i64 = parse_"); sb_append_str(gp_sb, name); sb_append_str(gp_sb, "();\n");
    sb_append_str(gp_sb, "            var h: i64 = -1;\n");
    sb_append_str(gp_sb, "            h = list_push(h, -1, nested);\n");
    sb_append_str(gp_sb, "            else_head = h;\n");
    sb_append_str(gp_sb, "        } else {\n");
    sb_append_str(gp_sb, "            else_head = parse_block();\n");
    sb_append_str(gp_sb, "        }\n");
    sb_append_str(gp_sb, "    }\n");
    emit_mk_call("    ", "var id: i64 = ", "if", "na\nla\nlb", "cond\nthen_head\nelse_head", "ti");
    sb_append_str(gp_sb, "    return id;\n");
    sb_append_str(gp_sb, "}\n\n");
}

// fold=forx：for "(" ( Ident "in" expr | (expr? ";" expr? ";" expr?) ) ")" block
//   —— peek_t(1)==KwIn 分流 for_each / C 式三段（init/cond/upd）
emit_forx :: func(idx: i64) -> void {
    var name: string = gp_name[idx];
    var ret: string = gp_ret[idx];
    sb_append_str(gp_sb, "parse_"); sb_append_str(gp_sb, name);
    sb_append_str(gp_sb, " :: func() -> "); sb_append_str(gp_sb, ret); sb_append_str(gp_sb, " {\n");
    sb_append_str(gp_sb, "    var ti: i64 = advance_i();\n");
    sb_append_str(gp_sb, "    expect_tok(\"LParen\");\n");
    sb_append_str(gp_sb, "    if (cur_t() == \"Identifier\" && peek_t(1) == \"KwIn\") {\n");
    sb_append_str(gp_sb, "        var vi: i64 = advance_i();\n");
    sb_append_str(gp_sb, "        var vname: string = tk_v(vi);\n");
    sb_append_str(gp_sb, "        advance_i();\n");
    sb_append_str(gp_sb, "        var iterable: i64 = parse_expr();\n");
    sb_append_str(gp_sb, "        expect_tok(\"RParen\");\n");
    sb_append_str(gp_sb, "        var body: i64 = parse_block();\n");
    emit_mk_call("        ", "var id: i64 = ", "for_each", "sa\nna\nla", "vname\niterable\nbody", "ti");
    sb_append_str(gp_sb, "        return id;\n");
    sb_append_str(gp_sb, "    }\n");
    sb_append_str(gp_sb, "    var init: i64 = -1;\n");
    sb_append_str(gp_sb, "    if (cur_t() != \"Semicolon\") {\n");
    sb_append_str(gp_sb, "        if (cur_t() == \"KwVar\") {\n");
    sb_append_str(gp_sb, "            init = parse_local_var(false);\n");
    sb_append_str(gp_sb, "        } else {\n");
    sb_append_str(gp_sb, "        if (cur_t() == \"KwConst\") {\n");
    sb_append_str(gp_sb, "            init = parse_local_var(true);\n");
    sb_append_str(gp_sb, "        } else {\n");
    sb_append_str(gp_sb, "            var e: i64 = parse_expr();\n");
    sb_append_str(gp_sb, "            expect_tok(\"Semicolon\");\n");
    emit_mk_call("            ", "init = ", "expr", "na", "e", "-1");
    sb_append_str(gp_sb, "        }}\n");
    sb_append_str(gp_sb, "    } else {\n");
    sb_append_str(gp_sb, "        advance_i();\n");
    sb_append_str(gp_sb, "    }\n");
    sb_append_str(gp_sb, "    var cond: i64 = -1;\n");
    sb_append_str(gp_sb, "    if (cur_t() != \"Semicolon\") {\n");
    sb_append_str(gp_sb, "        cond = parse_expr();\n");
    sb_append_str(gp_sb, "    }\n");
    sb_append_str(gp_sb, "    expect_tok(\"Semicolon\");\n");
    sb_append_str(gp_sb, "    var upd: i64 = -1;\n");
    sb_append_str(gp_sb, "    if (cur_t() != \"RParen\") {\n");
    sb_append_str(gp_sb, "        upd = parse_expr();\n");
    sb_append_str(gp_sb, "    }\n");
    sb_append_str(gp_sb, "    expect_tok(\"RParen\");\n");
    sb_append_str(gp_sb, "    var body2: i64 = parse_block();\n");
    emit_mk_call("    ", "var id2: i64 = ", "for", "na\nnb\nnc\nla", "init\ncond\nupd\nbody2", "ti");
    sb_append_str(gp_sb, "    return id2;\n");
    sb_append_str(gp_sb, "}\n\n");
}

// fold=swx：switch "(" expr ")" "{" ( "case" expr ":" statement* | "default" ":" statement* )* "}"
//   —— case 聚合为 CS 节点入 cases 列表；default 缺省 -2 兜底
emit_swx :: func(idx: i64) -> void {
    var name: string = gp_name[idx];
    var ret: string = gp_ret[idx];
    sb_append_str(gp_sb, "parse_"); sb_append_str(gp_sb, name);
    sb_append_str(gp_sb, " :: func() -> "); sb_append_str(gp_sb, ret); sb_append_str(gp_sb, " {\n");
    sb_append_str(gp_sb, "    var ti: i64 = advance_i();\n");
    sb_append_str(gp_sb, "    expect_tok(\"LParen\");\n");
    sb_append_str(gp_sb, "    var e: i64 = parse_expr();\n");
    sb_append_str(gp_sb, "    expect_tok(\"RParen\");\n");
    sb_append_str(gp_sb, "    expect_tok(\"LBrace\");\n");
    sb_append_str(gp_sb, "    var cases_head: i64 = -1;\n");
    sb_append_str(gp_sb, "    var cases_tail: i64 = -1;\n");
    sb_append_str(gp_sb, "    var default_head: i64 = -2;\n");
    sb_append_str(gp_sb, "    while (cur_t() != \"RBrace\" && cur_t() != \"Eof\") {\n");
    sb_append_str(gp_sb, "        if (cur_t() == \"KwCase\") {\n");
    sb_append_str(gp_sb, "            advance_i();\n");
    sb_append_str(gp_sb, "            var pat: i64 = parse_expr();\n");
    sb_append_str(gp_sb, "            expect_tok(\"Colon\");\n");
    sb_append_str(gp_sb, "            var bh: i64 = -1;\n");
    sb_append_str(gp_sb, "            var bt: i64 = -1;\n");
    sb_append_str(gp_sb, "            while (cur_t() != \"KwCase\" && cur_t() != \"KwDefault\" && cur_t() != \"RBrace\" && cur_t() != \"Eof\") {\n");
    sb_append_str(gp_sb, "                var s: i64 = parse_statement();\n");
    sb_append_str(gp_sb, "                if (s >= 0) {\n");
    sb_append_str(gp_sb, "                    bt = list_push(bh, bt, s);\n");
    sb_append_str(gp_sb, "                    if (bh < 0) {\n");
    sb_append_str(gp_sb, "                        bh = bt;\n");
    sb_append_str(gp_sb, "                    }\n");
    sb_append_str(gp_sb, "                }\n");
    sb_append_str(gp_sb, "            }\n");
    emit_mk_call("            ", "var cid: i64 = ", "CS", "na\nla", "pat\nbh", "-1");
    sb_append_str(gp_sb, "            cases_tail = list_push(cases_head, cases_tail, cid);\n");
    sb_append_str(gp_sb, "            if (cases_head < 0) {\n");
    sb_append_str(gp_sb, "                cases_head = cases_tail;\n");
    sb_append_str(gp_sb, "            }\n");
    sb_append_str(gp_sb, "        } else {\n");
    sb_append_str(gp_sb, "        if (cur_t() == \"KwDefault\") {\n");
    sb_append_str(gp_sb, "            advance_i();\n");
    sb_append_str(gp_sb, "            expect_tok(\"Colon\");\n");
    sb_append_str(gp_sb, "            var dh: i64 = -1;\n");
    sb_append_str(gp_sb, "            var dt: i64 = -1;\n");
    sb_append_str(gp_sb, "            while (cur_t() != \"KwCase\" && cur_t() != \"RBrace\" && cur_t() != \"Eof\") {\n");
    sb_append_str(gp_sb, "                var s2: i64 = parse_statement();\n");
    sb_append_str(gp_sb, "                if (s2 >= 0) {\n");
    sb_append_str(gp_sb, "                    dt = list_push(dh, dt, s2);\n");
    sb_append_str(gp_sb, "                    if (dh < 0) {\n");
    sb_append_str(gp_sb, "                        dh = dt;\n");
    sb_append_str(gp_sb, "                    }\n");
    sb_append_str(gp_sb, "                }\n");
    sb_append_str(gp_sb, "            }\n");
    sb_append_str(gp_sb, "            default_head = dh;\n");
    sb_append_str(gp_sb, "        } else {\n");
    sb_append_str(gp_sb, "            eprint(\"parse error: expected case or default in switch\\n\");\n");
    sb_append_str(gp_sb, "            exit(1);\n");
    sb_append_str(gp_sb, "        }}\n");
    sb_append_str(gp_sb, "    }\n");
    sb_append_str(gp_sb, "    expect_tok(\"RBrace\");\n");
    emit_mk_call("    ", "var id: i64 = ", "switch", "na\nla\nlb", "e\ncases_head\ndefault_head", "ti");
    sb_append_str(gp_sb, "    return id;\n");
    sb_append_str(gp_sb, "}\n\n");
}

// ── 生成单条规则的 parse 函数 ──
emit_rule :: func(idx: i64) -> void {
    var name: string = gp_name[idx];
    var params: string = gp_params[idx];
    var ret: string = gp_ret[idx];
    var node: string = gp_node[idx];
    var eat: string = gp_eat[idx];
    var tree: i64 = gp_tree[idx];
    var cons: i64 = gp_construct[idx];
    if (gp_fold[idx] == "bin") { emit_binfold(idx); return; }
    if (gp_fold[idx] == "pre") { emit_pre(idx); return; }
    if (gp_fold[idx] == "post") { emit_post(idx); return; }
    if (gp_fold[idx] == "prim") { emit_prim(idx); return; }
    if (gp_fold[idx] == "disp") { emit_disp(idx); return; }
    if (gp_fold[idx] == "whilex") { emit_whilex(idx); return; }
    if (gp_fold[idx] == "returnx") { emit_returnx(idx); return; }
    if (gp_fold[idx] == "ifx") { emit_ifx(idx); return; }
    if (gp_fold[idx] == "forx") { emit_forx(idx); return; }
    if (gp_fold[idx] == "swx") { emit_swx(idx); return; }

    sb_append_str(gp_sb, "parse_"); sb_append_str(gp_sb, name);
    sb_append_str(gp_sb, " :: func("); sb_append_str(gp_sb, params);
    sb_append_str(gp_sb, ") -> "); sb_append_str(gp_sb, ret); sb_append_str(gp_sb, " {\n");

    if (eat == "true") { sb_append_str(gp_sb, "    advance_i();\n"); }

    emit_node(tree, "decl");

    if (node != "") {
        var ce: i64 = -1;  // cons = construct 数组节点，child = 首元素对象
        if (cons >= 0) { ce = jnodes[cons].child; }
        if (gp_mk[idx] == "inline") {
            // 槽表达式内部会分配节点，必须先 node_new 占位再逐槽赋值（详见 §2.8 mk=inline）
            sb_append_str(gp_sb, "    var __id: i64 = node_new(\""); sb_append_str(gp_sb, node);
            sb_append_str(gp_sb, "\");\n");
            sb_append_str(gp_sb, "    var __n: Node = nodes[__id];\n");
            while (ce >= 0) {
                var field: string = jstr(ce, "field");
                var expr: string = jstr(ce, "expr");
                sb_append_str(gp_sb, "    __n."); sb_append_str(gp_sb, field);
                sb_append_str(gp_sb, " = "); sb_append_str(gp_sb, resolve_expr(expr));
                sb_append_str(gp_sb, ";\n");
                ce = jnodes[ce].sib;
            }
            sb_append_str(gp_sb, "    slice_set(nodes, __id, __n);\n");
        } else {
            var fsb: StringBuilder = sb_new();
            var esb: StringBuilder = sb_new();
            var first: bool = true;
            while (ce >= 0) {
                var field2: string = jstr(ce, "field");
                var expr2: string = jstr(ce, "expr");
                if (first == false) {
                    sb_append_str(fsb, "\n");
                    sb_append_str(esb, "\n");
                }
                first = false;
                sb_append_str(fsb, field2);
                sb_append_str(esb, resolve_expr(expr2));
                ce = jnodes[ce].sib;
            }
            var fstr: string = sb_to_str(fsb);
            var estr: string = sb_to_str(esb);
            emit_mk_call("    ", "var __id: i64 = ", node, fstr, estr, "-1");
        }
        sb_append_str(gp_sb, "    return __id;\n");
    }
    sb_append_str(gp_sb, "}\n\n");
}

// 发射 fold=bin 规则：左结合二元运算塔（or/and/bitor/.../mul）。
// 文法形状：base ( (op | op | ...) base )*  →  while (op) { left = mk_bin(op, left, parse_base(), ti); }
emit_binfold :: func(idx: i64) -> void {
    var name: string = gp_name[idx];
    var ret: string = gp_ret[idx];
    var tree: i64 = gp_tree[idx];
    // tree = seq[ baseNT, star( group( seq[ opLit(s)|alt[opLits], baseNT ] ) ) ]
    var kidsN: i64 = jchild(tree, "kids");
    var baseKid: i64 = jnodes[kidsN].child;
    var starKid: i64 = jnodes[baseKid].sib;
    var baseCall: string = jstr(baseKid, "call");
    var groupKid: i64 = jchild(starKid, "kid");
    var innerSeq: i64 = jchild(groupKid, "kid");
    var innerKids: i64 = jchild(innerSeq, "kids");
    var opNode: i64 = jnodes[innerKids].child;   // 运算符位置：lit(单) 或 alt(多)，可能被 group 包裹
    while (jstr(opNode, "k") == "group") { opNode = jchild(opNode, "kid"); }
    var lit1: i64 = -1; var lit2: i64 = -1; var lit3: i64 = -1; var lit4: i64 = -1; var nops: i64 = 0;
    if (jstr(opNode, "k") == "alt") {
        var opKidsNode: i64 = jchild(opNode, "kids");   // 临时变量承接下标，规避 t 发射器对 slice[函数调用()] 的缺陷
        var l: i64 = jnodes[opKidsNode].child;
        while (l >= 0) {
            if (nops == 0) { lit1 = l; }
            else if (nops == 1) { lit2 = l; }
            else if (nops == 2) { lit3 = l; }
            else { lit4 = l; }
            nops = nops + 1;
            l = jnodes[l].sib;
        }
    } else {
        lit1 = opNode; nops = 1;
    }
    sb_append_str(gp_sb, "parse_"); sb_append_str(gp_sb, name);
    sb_append_str(gp_sb, " :: func() -> "); sb_append_str(gp_sb, ret); sb_append_str(gp_sb, " {\n");
    sb_append_str(gp_sb, "    var left: i64 = "); sb_append_str(gp_sb, baseCall); sb_append_str(gp_sb, "();\n");
    sb_append_str(gp_sb, "    while (");
    var fi: i64 = 0;
    var cur: i64 = lit1;
    while (fi < nops) {
        if (fi > 0) { sb_append_str(gp_sb, " || "); }
        sb_append_str(gp_sb, "cur_t() == \""); sb_append_str(gp_sb, jstr(cur, "kind")); sb_append_str(gp_sb, "\"");
        fi = fi + 1;
        if (fi == 1) { cur = lit2; } else if (fi == 2) { cur = lit3; } else if (fi == 3) { cur = lit4; }
    }
    sb_append_str(gp_sb, ") {\n");
    sb_append_str(gp_sb, "        var t: string = cur_t();\n");
    sb_append_str(gp_sb, "        var op: string = \""); sb_append_str(gp_sb, jstr(lit1, "v")); sb_append_str(gp_sb, "\";\n");
    var bi: i64 = 1;
    var bc: i64 = lit2;
    while (bi < nops) {
        sb_append_str(gp_sb, "        if (t == \""); sb_append_str(gp_sb, jstr(bc, "kind"));
        sb_append_str(gp_sb, "\") { op = \""); sb_append_str(gp_sb, jstr(bc, "v")); sb_append_str(gp_sb, "\"; }\n");
        bi = bi + 1;
        if (bi == 2) { bc = lit3; } else if (bi == 3) { bc = lit4; }
    }
    sb_append_str(gp_sb, "        var ti: i64 = advance_i();\n");
    sb_append_str(gp_sb, "        var right: i64 = "); sb_append_str(gp_sb, baseCall); sb_append_str(gp_sb, "();\n");
    sb_append_str(gp_sb, "        left = mk_bin(op, left, right, ti);\n");
    sb_append_str(gp_sb, "    }\n");
    sb_append_str(gp_sb, "    return left;\n");
    sb_append_str(gp_sb, "}\n\n");
}

// 发射 fold=pre 规则：前缀一元折叠（unary 等）。
// 文法形状：( (op | op | ...) )* base  →  if (cur in ops) { op; operand = parse_self(); return mk_un(op, operand, ti); } return parse_base();
// 递归目标为规则自身（允许 !!x 堆叠），无 op 时落到 base。op 字面量即 mk_un 的 op 串。
emit_pre :: func(idx: i64) -> void {
    var name: string = gp_name[idx];
    var ret: string = gp_ret[idx];
    var tree: i64 = gp_tree[idx];
    // tree = seq[ star( opAlt ), baseNT ]
    var kidsN: i64 = jchild(tree, "kids");
    var starKid: i64 = jnodes[kidsN].child;        // 第一个 child = star(op 列表)
    var baseKid: i64 = jnodes[starKid].sib;        // 第二个 child = base NT
    var baseCall: string = jstr(baseKid, "call");
    // star 内部：op 的 alt（可能被 group 包裹）
    var inner: i64 = jchild(starKid, "kid");
    while (jstr(inner, "k") == "group") { inner = jchild(inner, "kid"); }
    var lit1: i64 = -1; var lit2: i64 = -1; var lit3: i64 = -1; var lit4: i64 = -1; var nops: i64 = 0;
    if (jstr(inner, "k") == "alt") {
        var opKidsNode: i64 = jchild(inner, "kids");   // 临时变量承接下标，规避 t 发射器对 slice[函数调用()] 的缺陷
        var l: i64 = jnodes[opKidsNode].child;
        while (l >= 0) {
            if (nops == 0) { lit1 = l; }
            else if (nops == 1) { lit2 = l; }
            else if (nops == 2) { lit3 = l; }
            else { lit4 = l; }
            nops = nops + 1;
            l = jnodes[l].sib;
        }
    } else {
        lit1 = inner; nops = 1;
    }
    sb_append_str(gp_sb, "parse_"); sb_append_str(gp_sb, name);
    sb_append_str(gp_sb, " :: func() -> "); sb_append_str(gp_sb, ret); sb_append_str(gp_sb, " {\n");
    sb_append_str(gp_sb, "    var t: string = cur_t();\n");
    sb_append_str(gp_sb, "    if (");
    var fi: i64 = 0;
    var cur: i64 = lit1;
    while (fi < nops) {
        if (fi > 0) { sb_append_str(gp_sb, " || "); }
        sb_append_str(gp_sb, "t == \""); sb_append_str(gp_sb, jstr(cur, "kind")); sb_append_str(gp_sb, "\"");
        fi = fi + 1;
        if (fi == 1) { cur = lit2; } else if (fi == 2) { cur = lit3; } else if (fi == 3) { cur = lit4; }
    }
    sb_append_str(gp_sb, ") {\n");
    sb_append_str(gp_sb, "        var op: string = \""); sb_append_str(gp_sb, jstr(lit1, "v")); sb_append_str(gp_sb, "\";\n");
    var bi: i64 = 1;
    var bc: i64 = lit2;
    while (bi < nops) {
        sb_append_str(gp_sb, "        if (t == \""); sb_append_str(gp_sb, jstr(bc, "kind"));
        sb_append_str(gp_sb, "\") { op = \""); sb_append_str(gp_sb, jstr(bc, "v")); sb_append_str(gp_sb, "\"; }\n");
        bi = bi + 1;
        if (bi == 2) { bc = lit3; } else if (bi == 3) { bc = lit4; }
    }
    sb_append_str(gp_sb, "        var ti: i64 = advance_i();\n");
    sb_append_str(gp_sb, "        var operand: i64 = parse_"); sb_append_str(gp_sb, name); sb_append_str(gp_sb, "();\n");
    sb_append_str(gp_sb, "        return mk_un(op, operand, ti);\n");
    sb_append_str(gp_sb, "    }\n");
    sb_append_str(gp_sb, "    return "); sb_append_str(gp_sb, baseCall); sb_append_str(gp_sb, "();\n");
    sb_append_str(gp_sb, "}\n\n");
}

// 发射 fold=post 规则：左结合后缀折叠（postfix 等）。
// 文法形状：base ( lead nt | lead nt | ... )* ( lead nt )?
// 每分支 = 引导 token 字面量 + 胶水 NT（签名 (e, ti) -> i64）。
// 生成：e = parse_base(); while (lead 集合) { t; ti = advance_i(); if (t==K) { e = helper(e, ti); } ... } 尾部 opt 单次 if。
emit_post :: func(idx: i64) -> void {
    var name: string = gp_name[idx];
    var ret: string = gp_ret[idx];
    var tree: i64 = gp_tree[idx];
    // tree = seq[ baseNT, star( group( alt[ seq(lit,nt) ... ] ) ), opt( group( seq(lit,nt) ) )? ]
    var kidsN: i64 = jchild(tree, "kids");
    var baseKid: i64 = jnodes[kidsN].child;
    var starKid: i64 = jnodes[baseKid].sib;
    var optKid: i64 = jnodes[starKid].sib;      // 可能为 -1（无尾部可选分支）
    var baseCall: string = jstr(baseKid, "call");
    // star 内部：alt（可能被 group 包裹）；alt 每个 kid 是 seq[lit, nt]
    var inner: i64 = jchild(starKid, "kid");
    while (jstr(inner, "k") == "group") { inner = jchild(inner, "kid"); }
    var k1: string = ""; var k2: string = ""; var k3: string = ""; var k4: string = "";
    var c1: string = ""; var c2: string = ""; var c3: string = ""; var c4: string = "";
    var nbr: i64 = 0;
    var br: i64 = -1;
    if (jstr(inner, "k") == "alt") {
        var altKids: i64 = jchild(inner, "kids");   // 临时变量承接下标，规避发射器缺陷
        br = jnodes[altKids].child;
    } else {
        br = inner;                                  // 单分支：inner 本身就是 seq
    }
    while (br >= 0) {
        var brKids: i64 = jchild(br, "kids");
        var litN: i64 = jnodes[brKids].child;
        var ntN: i64 = jnodes[litN].sib;
        var kk: string = jstr(litN, "kind");
        var cc: string = jstr(ntN, "call");
        if (nbr == 0) { k1 = kk; c1 = cc; }
        else if (nbr == 1) { k2 = kk; c2 = cc; }
        else if (nbr == 2) { k3 = kk; c3 = cc; }
        else { k4 = kk; c4 = cc; }
        nbr = nbr + 1;
        if (jstr(inner, "k") == "alt") { br = jnodes[br].sib; } else { br = 0 - 1; }
    }
    // 尾部 opt：group( seq[lit, nt] )
    var optKind: string = "";
    var optCall: string = "";
    if (optKid >= 0) {
        var oin: i64 = jchild(optKid, "kid");
        while (jstr(oin, "k") == "group") { oin = jchild(oin, "kid"); }
        var oKids: i64 = jchild(oin, "kids");
        var oLit: i64 = jnodes[oKids].child;
        var oNt: i64 = jnodes[oLit].sib;
        optKind = jstr(oLit, "kind");
        optCall = jstr(oNt, "call");
    }
    sb_append_str(gp_sb, "parse_"); sb_append_str(gp_sb, name);
    sb_append_str(gp_sb, " :: func() -> "); sb_append_str(gp_sb, ret); sb_append_str(gp_sb, " {\n");
    sb_append_str(gp_sb, "    var e: i64 = "); sb_append_str(gp_sb, baseCall); sb_append_str(gp_sb, "();\n");
    sb_append_str(gp_sb, "    while (");
    var fi: i64 = 0;
    while (fi < nbr) {
        if (fi > 0) { sb_append_str(gp_sb, " || "); }
        var wk: string = k1;
        if (fi == 1) { wk = k2; } else if (fi == 2) { wk = k3; } else if (fi == 3) { wk = k4; }
        sb_append_str(gp_sb, "cur_t() == \""); sb_append_str(gp_sb, wk); sb_append_str(gp_sb, "\"");
        fi = fi + 1;
    }
    sb_append_str(gp_sb, ") {\n");
    sb_append_str(gp_sb, "        var t: string = cur_t();\n");
    sb_append_str(gp_sb, "        var ti: i64 = advance_i();\n");
    var bi: i64 = 0;
    while (bi < nbr) {
        var bk: string = k1;
        var bc: string = c1;
        if (bi == 1) { bk = k2; bc = c2; } else if (bi == 2) { bk = k3; bc = c3; } else if (bi == 3) { bk = k4; bc = c4; }
        sb_append_str(gp_sb, "        if (t == \""); sb_append_str(gp_sb, bk);
        sb_append_str(gp_sb, "\") { e = "); sb_append_str(gp_sb, bc); sb_append_str(gp_sb, "(e, ti); }\n");
        bi = bi + 1;
    }
    sb_append_str(gp_sb, "    }\n");
    if (optKid >= 0) {
        sb_append_str(gp_sb, "    if (cur_t() == \""); sb_append_str(gp_sb, optKind); sb_append_str(gp_sb, "\") {\n");
        sb_append_str(gp_sb, "        var ti2: i64 = advance_i();\n");
        sb_append_str(gp_sb, "        e = "); sb_append_str(gp_sb, optCall); sb_append_str(gp_sb, "(e, ti2);\n");
        sb_append_str(gp_sb, "    }\n");
    }
    sb_append_str(gp_sb, "    return e;\n");
    sb_append_str(gp_sb, "}\n\n");
}

// fold=prim：终端驱动 dispatch。tree = alt[ seq(term, nt) ... ]
// 每分支发射 if (cur_t()=="K") { var ti = advance_i(); return parse_<胶水>(ti); }，末尾错误兜底。
emit_prim :: func(idx: i64) -> void {
    var name: string = gp_name[idx];
    var ret: string = gp_ret[idx];
    var tree: i64 = gp_tree[idx];
    sb_append_str(gp_sb, "parse_"); sb_append_str(gp_sb, name);
    sb_append_str(gp_sb, " :: func() -> "); sb_append_str(gp_sb, ret); sb_append_str(gp_sb, " {\n");
    sb_append_str(gp_sb, "    var t: string = cur_t();\n");
    var inner: i64 = tree;
    while (jstr(inner, "k") == "group") { inner = jchild(inner, "kid"); }
    var altKids: i64 = jchild(inner, "kids");
    var br: i64 = jnodes[altKids].child;
    while (br >= 0) {
        var brKids: i64 = jchild(br, "kids");
        var termN: i64 = jnodes[brKids].child;
        var ntN: i64 = jnodes[termN].sib;
        var tk: string = jstr(termN, "k");
        var kk: string = jstr(termN, "kind");
        if (tk == "id") { kk = "Identifier"; }
        if (tk == "int") { kk = "Integer"; }
        var cc: string = jstr(ntN, "call");
        sb_append_str(gp_sb, "    if (t == \""); sb_append_str(gp_sb, kk); sb_append_str(gp_sb, "\") {\n");
        sb_append_str(gp_sb, "        var ti_"); sb_append_str(gp_sb, kk);
        sb_append_str(gp_sb, ": i64 = advance_i();\n");
        sb_append_str(gp_sb, "        return "); sb_append_str(gp_sb, cc);
        sb_append_str(gp_sb, "(ti_"); sb_append_str(gp_sb, kk); sb_append_str(gp_sb, ");\n");
        sb_append_str(gp_sb, "    }\n");
        br = jnodes[br].sib;
    }
    sb_append_str(gp_sb, "    eprint(\"parse error: unexpected token in expression: \");\n");
    sb_append_str(gp_sb, "    eprint(cur_v());\n");
    sb_append_str(gp_sb, "    eprint(\"\\n\");\n");
    sb_append_str(gp_sb, "    exit(1);\n");
    sb_append_str(gp_sb, "    return -1;\n");
    sb_append_str(gp_sb, "}\n\n");
}

// fold=disp：守卫式分发。形状 alt[ seq(lit, nt), ..., nt(兜底) ]。
// 骨架不消费引导 token：if (t == "K") { return parse_X(); } 链；裸 NT 分支为兜底 return。
emit_disp :: func(idx: i64) -> void {
    var name: string = gp_name[idx];
    var ret: string = gp_ret[idx];
    var tree: i64 = gp_tree[idx];
    sb_append_str(gp_sb, "parse_"); sb_append_str(gp_sb, name);
    sb_append_str(gp_sb, " :: func() -> "); sb_append_str(gp_sb, ret); sb_append_str(gp_sb, " {\n");
    sb_append_str(gp_sb, "    var t: string = cur_t();\n");
    var inner: i64 = tree;
    while (jstr(inner, "k") == "group") { inner = jchild(inner, "kid"); }
    var altKids: i64 = jchild(inner, "kids");
    var br: i64 = jnodes[altKids].child;
    var fallback: string = "";
    while (br >= 0) {
        var bk: string = jstr(br, "k");
        if (bk == "nt") {
            fallback = jstr(br, "call");
        } else {
            var brKids: i64 = jchild(br, "kids");
            var termN: i64 = jnodes[brKids].child;
            var ntN: i64 = jnodes[termN].sib;
            var kk: string = jstr(termN, "kind");
            var cc: string = jstr(ntN, "call");
            sb_append_str(gp_sb, "    if (t == \""); sb_append_str(gp_sb, kk); sb_append_str(gp_sb, "\") {\n");
            sb_append_str(gp_sb, "        return "); sb_append_str(gp_sb, cc); sb_append_str(gp_sb, "();\n");
            sb_append_str(gp_sb, "    }\n");
        }
        br = jnodes[br].sib;
    }
    sb_append_str(gp_sb, "    return "); sb_append_str(gp_sb, fallback); sb_append_str(gp_sb, "();\n");
    sb_append_str(gp_sb, "}\n\n");
}

// 递归发射 EBNF 树节点代码。mode="decl" 声明结果变量，"assign" 赋值到已声明变量。
emit_node :: func(nidx: i64, mode: string) -> void {
    if (nidx < 0) { return; }
    var k: string = jstr(nidx, "k");
    if (k == "lit") {
        sb_append_str(gp_sb, "    expect_tok(\""); sb_append_str(gp_sb, jstr(nidx, "kind"));
        sb_append_str(gp_sb, "\");\n");
    } else if (k == "id") {
        if (mode == "decl") { sb_append_str(gp_sb, "    var r_Ident: string = expect_tok(\"Identifier\");\n"); }
        else { sb_append_str(gp_sb, "    r_Ident = expect_tok(\"Identifier\");\n"); }
    } else if (k == "int") {
        if (mode == "decl") { sb_append_str(gp_sb, "    var r_Integer: string = expect_tok(\"Integer\");\n"); }
        else { sb_append_str(gp_sb, "    r_Integer = expect_tok(\"Integer\");\n"); }
    } else if (k == "nt") {
        var v: string = jstr(nidx, "v");
        if (mode == "decl") {
            sb_append_str(gp_sb, "    var r_"); sb_append_str(gp_sb, v);
            sb_append_str(gp_sb, ": i64 = "); sb_append_str(gp_sb, jstr(nidx, "call"));
            sb_append_str(gp_sb, "();\n");
        } else {
            sb_append_str(gp_sb, "    r_"); sb_append_str(gp_sb, v);
            sb_append_str(gp_sb, " = "); sb_append_str(gp_sb, jstr(nidx, "call"));
            sb_append_str(gp_sb, "();\n");
        }
    } else if (k == "group") {
        emit_node(jchild(nidx, "kid"), mode);
    } else if (k == "seq") {
        var kids: i64 = jchild(nidx, "kids");
        var kd: i64 = jnodes[kids].child;
        while (kd >= 0) { emit_node(kd, mode); kd = jnodes[kd].sib; }
    } else if (k == "alt") {
        emit_alt(nidx, mode);
    } else if (k == "opt") {
        emit_opt(nidx);
    } else if (k == "star" || k == "plus") {
        emit_loop(nidx, k);
    }
}

emit_alt :: func(nidx: i64, mode: string) -> void {
    var kids: i64 = jchild(nidx, "kids");
    // decl 模式：先在 if 链外预声明各分支的结果变量（与 emit_opt 同构），
    // 分支体内一律 assign 模式，避免结果变量作用域困在分支块里。
    // 注：每分支只取第一个结果变量（result_var_of），与 opt 的能力边界一致。
    if (mode == "decl") {
        var dkd: i64 = jnodes[kids].child;
        var seen: []string;
        while (dkd >= 0) {
            var rv: string = result_var_of(dkd);
            if (rv != "") {
                var dup: bool = false;
                var si: i64 = 0;
                while (si < slice_len(seen) as i64) {
                    if (seen[si] == rv) { dup = true; }
                    si = si + 1;
                }
                if (!dup) {
                    append(seen, rv);
                    sb_append_str(gp_sb, "    var "); sb_append_str(gp_sb, rv);
                    if (rv == "r_Ident" || rv == "r_Integer") { sb_append_str(gp_sb, ": string = \"\";\n"); }
                    else { sb_append_str(gp_sb, ": i64 = -1;\n"); }
                }
            }
            dkd = jnodes[dkd].sib;
        }
    }
    var kd: i64 = jnodes[kids].child;
    var isFirst: bool = true;
    while (kd >= 0) {
        var fcond: string = first_cond(jchild(kd, "first"));
        if (isFirst) { sb_append_str(gp_sb, "    if ("); isFirst = false; }
        else { sb_append_str(gp_sb, "    else if ("); }
        sb_append_str(gp_sb, fcond); sb_append_str(gp_sb, ") {\n");
        emit_node(kd, "assign");
        sb_append_str(gp_sb, "    }");
        kd = jnodes[kd].sib;
    }
    if (!isFirst) {
        sb_append_str(gp_sb, " else {\n        eprint(\"parse error: unexpected token in alternative\\n\"); exit(1);\n    }\n");
    }
}

emit_opt :: func(nidx: i64) -> void {
    var kid: i64 = jchild(nidx, "kid");
    var cond: string = first_cond(jchild(nidx, "first"));
    var rv: string = result_var_of(kid);
    if (rv != "") {
        // 声明结果变量（默认 -1 / ""），循环/可选内赋值
        sb_append_str(gp_sb, "    var "); sb_append_str(gp_sb, rv);
        if (rv == "r_Ident" || rv == "r_Integer") { sb_append_str(gp_sb, ": string = \"\";\n"); }
        else { sb_append_str(gp_sb, ": i64 = -1;\n"); }
    }
    sb_append_str(gp_sb, "    if ("); sb_append_str(gp_sb, cond); sb_append_str(gp_sb, ") {\n");
    emit_node(kid, "assign");
    sb_append_str(gp_sb, "    }\n");
}

emit_loop :: func(nidx: i64, kind: string) -> void {
    var kid: i64 = jchild(nidx, "kid");
    var v: string = jstr(kid, "v");
    var call: string = jstr(kid, "call");
    // 列表头/尾
    sb_append_str(gp_sb, "    var r_"); sb_append_str(gp_sb, v); sb_append_str(gp_sb, ": i64 = -1;\n");
    sb_append_str(gp_sb, "    var r_"); sb_append_str(gp_sb, v); sb_append_str(gp_sb, "_t: i64 = -1;\n");
    // 循环参数（被调规则的参数）作为本地计数器
    var plist: string = gp_params_of(v);
    var ps: []string = split_params(plist);
    var pi: i64 = 0;
    while (pi < slice_len(ps) as i64) {
        var nm: string = ps[pi];
        var ty: string = ps[pi + 1];
        var z: string = "0";
        if (ty == "string") { z = "\"\""; }
        else if (ty == "bool") { z = "false"; }
        sb_append_str(gp_sb, "    var "); sb_append_str(gp_sb, nm);
        sb_append_str(gp_sb, ": "); sb_append_str(gp_sb, ty);
        sb_append_str(gp_sb, " = "); sb_append_str(gp_sb, z); sb_append_str(gp_sb, ";\n");
        pi = pi + 2;
    }
    var cond: string = first_cond(jchild(nidx, "first"));
    sb_append_str(gp_sb, "    while ("); sb_append_str(gp_sb, cond);
    sb_append_str(gp_sb, " && cur_t() != \"Eof\") {\n");
    // 调用 parse_<v>(args)
    sb_append_str(gp_sb, "        var __it: i64 = "); sb_append_str(gp_sb, call); sb_append_str(gp_sb, "(");
    pi = 0;
    while (pi < slice_len(ps) as i64) {
        if (pi > 0) { sb_append_str(gp_sb, ", "); }
        sb_append_str(gp_sb, ps[pi]);
        pi = pi + 2;
    }
    sb_append_str(gp_sb, ");\n");
    sb_append_str(gp_sb, "        r_"); sb_append_str(gp_sb, v);
    sb_append_str(gp_sb, "_t = list_push(r_"); sb_append_str(gp_sb, v);
    sb_append_str(gp_sb, ", r_"); sb_append_str(gp_sb, v); sb_append_str(gp_sb, "_t, __it);\n");
    sb_append_str(gp_sb, "        if (r_"); sb_append_str(gp_sb, v);
    sb_append_str(gp_sb, " < 0) { r_"); sb_append_str(gp_sb, v); sb_append_str(gp_sb, " = r_"); sb_append_str(gp_sb, v); sb_append_str(gp_sb, "_t; }\n");
    // 自增循环参数
    pi = 0;
    while (pi < slice_len(ps) as i64) {
        sb_append_str(gp_sb, "        "); sb_append_str(gp_sb, ps[pi]);
        sb_append_str(gp_sb, " = "); sb_append_str(gp_sb, ps[pi]); sb_append_str(gp_sb, " + 1;\n");
        pi = pi + 2;
    }
    sb_append_str(gp_sb, "    }\n");
}

// 生成整个 GEN:parser 区间
emit_parser :: func() -> string {
    gp_sb = sb_new();
    sb_append_str(gp_sb, "// >>> GEN:parser_rules (generated by tools/totter.tc from build/ebnf.json grammar -- DO NOT EDIT) >>>\n");
    // 逆序发射：先定义被调用规则（如 case），再定义调用者（如 variant_decl），规避前向引用
    var i: i64 = slice_len(gp_name) as i64 - 1;
    while (i >= 0) {
        emit_rule(i);
        i = i - 1;
    }
    sb_append_str(gp_sb, "// <<< GEN:parser_rules <<<");
    return sb_to_str(gp_sb);
}

// 加载 build/ebnf.json 的 xid_start / xid_continue 段（均为 [[lo,hi], ...] 数字数组）。
load_xid :: func(root: i64) -> void {
    load_xid_arr(root, "xid_start", 0);
    load_xid_arr(root, "xid_continue", 1);
}

// which: 0 -> xid_start_lo/hi, 1 -> xid_cont_lo/hi（直接 append 到全局，规避 slice 参数别名）
load_xid_arr :: func(root: i64, key: string, which: i64) -> void {
    var n: i64 = json_obj_get(root, key);
    if (n < 0) { return; }
    var arr: i64 = jnodes[n].child;        // 数组节点（顶层 [[lo,hi],...]）
    var el: i64 = jnodes[arr].child;       // 首个元素 = [lo,hi] 数组节点
    while (el >= 0) {
        var e0: i64 = jnodes[el].child;    // lo 数字节点
        var e1: i64 = jnodes[e0].sib;      // hi 数字节点
        if (which == 0) {
            append(xid_start_lo, jnodes[e0].s);
            append(xid_start_hi, jnodes[e1].s);
        } else {
            append(xid_cont_lo, jnodes[e0].s);
            append(xid_cont_hi, jnodes[e1].s);
        }
        el = jnodes[el].sib;
    }
}

// 加载 build/ebnf.json 的 dispatches 段（解析器分发表）到扁平 1D 数组。
// dispatches 是对象：键为分发表名（如 "DeclBody"），值为 [{matchKind, matchVal?, call}] 数组。
load_dispatches :: func(root: i64) -> void {
    var n_dp: i64 = json_obj_get(root, "dispatches");
    if (n_dp < 0) { return; }
    var dpObj: i64 = jnodes[n_dp].child;    // dispatches 对象节点（值）
    var mem: i64 = jnodes[dpObj].child;     // 首个成员节点（"DeclBody"）
    while (mem >= 0) {
        var kname: string = jnodes[mem].key;     // 分发表名
        var arr: i64 = jnodes[mem].child;        // 数组节点（DeclBody 的值）
        var el: i64 = jnodes[arr].child;         // 首个元素对象节点
        var start: i64 = slice_len(dp_mkind) as i64;
        var cnt: i64 = 0;
        while (el >= 0) {
            var obj: i64 = el;                   // 元素对象本身 {matchKind, matchVal?, call}
            var knd: i64 = json_obj_get(obj, "matchKind");
            var kind: string = jnodes[jnodes[knd].child].s;
            var cln: i64 = json_obj_get(obj, "call");
            var call: string = jnodes[jnodes[cln].child].s;
            var val: string = "";
            var vn: i64 = json_obj_get(obj, "matchVal");
            if (vn >= 0) { val = jnodes[jnodes[vn].child].s; }
            append(dp_mkind, kind);
            append(dp_mval, val);
            append(dp_call, call);
            cnt = cnt + 1;
            el = jnodes[el].sib;
        }
        append(dp_name, kname);
        append(dp_start, start);
        append(dp_len, cnt);
        mem = jnodes[mem].sib;
    }
}

// ───────────── 字符串工具（t 无 str_find，自实现）─────────────

str_find :: func(hay: string, needle: string) -> i64 {
    var hl: i64 = str_len(hay) as i64;
    var nl: i64 = str_len(needle) as i64;
    if (nl == 0) { return 0; }
    var i: i64 = 0;
    while (i + nl <= hl) {
        var j: i64 = 0;
        var ok: bool = true;
        while (j < nl) {
            if (str_at(hay, i + j) != str_at(needle, j)) { ok = false; break; }
            j = j + 1;
        }
        if (ok) { return i; }
        i = i + 1;
    }
    return -1;
}

// 用 newBlock 替换 src 中 [startMarker, endMarker] 闭区间（含标记行）
replace_interval :: func(src: string, startMarker: string, endMarker: string, newBlock: string) -> string {
    var s: i64 = str_find(src, startMarker);
    var e: i64 = str_find(src, endMarker);
    if (s < 0 || e < 0) {
        return src;   // 未找到则原样返回（不应发生）
    }
    var head: string = str_slice(src, 0, s);
    var tail: string = str_slice(src, e + str_len(endMarker), str_len(src));
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, head);
    sb_append_str(sb, newBlock);
    sb_append_str(sb, tail);
    return sb_to_str(sb);
}

// ───────────── 各区间的代码生成 ─────────────

emit_kw :: func() -> string {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "// >>> GEN:kw_lookup (generated by tools/totter.tc from build/ebnf.json -- DO NOT EDIT) >>>\n");
    sb_append_str(sb, "KwEntry :: struct {\n");
    sb_append_str(sb, "    text: string;\n");
    sb_append_str(sb, "    kind: string;\n");
    sb_append_str(sb, "}\n\n");
    sb_append_str(sb, "var keywords_tbl: []KwEntry;\n\n");
    sb_append_str(sb, "kw_reg :: func(t: string, k: string) -> void {\n");
    sb_append_str(sb, "    var e: KwEntry;\n");
    sb_append_str(sb, "    e.text = t;\n");
    sb_append_str(sb, "    e.kind = k;\n");
    sb_append_str(sb, "    append(keywords_tbl, e);\n");
    sb_append_str(sb, "}\n\n");
    sb_append_str(sb, "init_keywords :: func() -> void {\n");
    var i: i64 = 0;
    while (i < slice_len(kw_t) as i64) {
        sb_append_str(sb, "    kw_reg(\"");
        sb_append_str(sb, kw_t[i]);
        sb_append_str(sb, "\", \"");
        sb_append_str(sb, kw_k[i]);
        sb_append_str(sb, "\");\n");
        i = i + 1;
    }
    sb_append_str(sb, "}\n\n");
    sb_append_str(sb, "kw_lookup :: func(text: string) -> string {\n");
    sb_append_str(sb, "    var i: i64 = 0;\n");
    sb_append_str(sb, "    while (i < (slice_len(keywords_tbl) as i64)) {\n");
    sb_append_str(sb, "        if (keywords_tbl[i].text == text) { return keywords_tbl[i].kind; }\n");
    sb_append_str(sb, "        i = i + 1;\n");
    sb_append_str(sb, "    }\n");
    sb_append_str(sb, "    return \"\";\n");
    sb_append_str(sb, "}\n");
    sb_append_str(sb, "// <<< GEN:kw_lookup <<<");
    return sb_to_str(sb);
}

emit_bi :: func() -> string {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "// >>> GEN:builtins (generated by tools/totter.tc from build/ebnf.json -- DO NOT EDIT) >>>\n");
    sb_append_str(sb, "builtin_ret :: func(name: string) -> i64 {\n");
    var i: i64 = 0;
    while (i < slice_len(bi_cond) as i64) {
        sb_append_str(sb, "    if (");
        sb_append_str(sb, bi_cond[i]);
        sb_append_str(sb, ") {\n");
        sb_append_str(sb, "        return ");
        sb_append_str(sb, bi_ret[i]);
        sb_append_str(sb, ";\n");
        sb_append_str(sb, "    }\n");
        i = i + 1;
    }
    sb_append_str(sb, "    return ti_mk(\"Unknown\");\n");
    sb_append_str(sb, "}\n");
    sb_append_str(sb, "// <<< GEN:builtins <<<");
    return sb_to_str(sb);
}

emit_dv :: func() -> string {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "// >>> GEN:derives (generated by tools/totter.tc from build/ebnf.json -- DO NOT EDIT) >>>\n");
    sb_append_str(sb, "vv_derive_traits :: func() -> void {\n");
    var i: i64 = 0;
    while (i < slice_len(dv_names) as i64) {
        sb_append_str(sb, "    slb_add(\"");
        sb_append_str(sb, dv_names[i]);
        sb_append_str(sb, "\");\n");
        i = i + 1;
    }
    sb_append_str(sb, "}\n");
    sb_append_str(sb, "// <<< GEN:derives <<<");
    return sb_to_str(sb);
}

emit_dg :: func() -> string {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "// >>> GEN:diagnostics (generated by tools/totter.tc from build/ebnf.json -- DO NOT EDIT) >>>\n");
    sb_append_str(sb, "// 诊断码 → 规范严重度查询。diag_new 在 sev==\"\" 时以此作为兜底默认值；\n");
    sb_append_str(sb, "// 调用点显式传 sev 时优先（如 T_ANNOTATION_UNKNOWN 的 warning 用例）。\n");
    sb_append_str(sb, "diag_sev :: func(code: string) -> string {\n");
    var i: i64 = 0;
    while (i < slice_len(dg_code) as i64) {
        sb_append_str(sb, "    if (code == \"");
        sb_append_str(sb, dg_code[i]);
        sb_append_str(sb, "\") { return \"");
        sb_append_str(sb, dg_sev[i]);
        sb_append_str(sb, "\"; }\n");
        i = i + 1;
    }
    sb_append_str(sb, "    return \"\";\n");
    sb_append_str(sb, "}\n");
    sb_append_str(sb, "// <<< GEN:diagnostics <<<");
    return sb_to_str(sb);
}

emit_ann :: func() -> string {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "// >>> GEN:annotations (generated by tools/totter.tc from build/ebnf.json -- DO NOT EDIT) >>>\n");
    sb_append_str(sb, "init_anndefs :: func() -> void {\n");
    var i: i64 = 0;
    while (i < slice_len(an_name) as i64) {
        sb_append_str(sb, "    ad(\"");
        sb_append_str(sb, an_name[i]);
        sb_append_str(sb, "\", \"");
        sb_append_str(sb, an_spec[i]);
        sb_append_str(sb, "\", \"");
        sb_append_str(sb, an_targets[i]);
        sb_append_str(sb, "\");\n");
        i = i + 1;
    }
    // 弃用标记（数据驱动：repl 非空者标记 deprecated）
    sb_append_str(sb, "    // 弃用标记（数据驱动生成）\n");
    i = 0;
    while (i < slice_len(an_name) as i64) {
        var r: string = an_repl[i];
        if (str_len(r) as i64 > 0) {
            sb_append_str(sb, "    var di");
            sb_append_str(sb, an_name[i]);
            sb_append_str(sb, ": i64 = anndef_find(\"");
            sb_append_str(sb, an_name[i]);
            sb_append_str(sb, "\");\n");
            sb_append_str(sb, "    if (di");
            sb_append_str(sb, an_name[i]);
            sb_append_str(sb, " >= 0) {\n");
            sb_append_str(sb, "        var a");
            sb_append_str(sb, an_name[i]);
            sb_append_str(sb, ": AnnDef = anndefs[di");
            sb_append_str(sb, an_name[i]);
            sb_append_str(sb, "];\n");
            sb_append_str(sb, "        a");
            sb_append_str(sb, an_name[i]);
            sb_append_str(sb, ".depr = true;\n");
            sb_append_str(sb, "        a");
            sb_append_str(sb, an_name[i]);
            sb_append_str(sb, ".repl = \"");
            sb_append_str(sb, r);
            sb_append_str(sb, "\";\n");
            sb_append_str(sb, "        slice_set(anndefs, di");
            sb_append_str(sb, an_name[i]);
            sb_append_str(sb, ", a");
            sb_append_str(sb, an_name[i]);
            sb_append_str(sb, ");\n");
            sb_append_str(sb, "    }\n");
        }
        i = i + 1;
    }
    sb_append_str(sb, "}\n");
    sb_append_str(sb, "// <<< GEN:annotations <<<");
    return sb_to_str(sb);
}

emit_parser_dispatch :: func() -> string {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "// >>> GEN:parser_dispatch (generated by tools/totter.tc from build/ebnf.json dispatches -- DO NOT EDIT) >>>\n");
    sb_append_str(sb, "    var t: string = cur_t();\n");
    // 找到名为 "DeclBody" 的分发表（扁平数组中的区间）
    var bi: i64 = -1;
    var k: i64 = 0;
    while (k < slice_len(dp_name) as i64) {
        if (dp_name[k] == "DeclBody") { bi = k; }
        k = k + 1;
    }
    if (bi >= 0) {
        var start: i64 = dp_start[bi];
        var len: i64 = dp_len[bi];
        var i: i64 = start;
        while (i < start + len) {
            var kind: string = dp_mkind[i];
            var val: string = dp_mval[i];
            var call: string = dp_call[i];
            if (kind == "default") {
                sb_append_str(sb, "    return ");
                sb_append_str(sb, call);
                sb_append_str(sb, ";\n");
            } else if (kind == "idval") {
                sb_append_str(sb, "    if (t == \"Identifier\" && cur_v() == \"");
                sb_append_str(sb, val);
                sb_append_str(sb, "\") {\n        return ");
                sb_append_str(sb, call);
                sb_append_str(sb, ";\n    }\n");
            } else {
                sb_append_str(sb, "    if (t == \"");
                sb_append_str(sb, val);
                sb_append_str(sb, "\") {\n        return ");
                sb_append_str(sb, call);
                sb_append_str(sb, ";\n    }\n");
            }
            i = i + 1;
        }
    }
    sb_append_str(sb, "// <<< GEN:parser_dispatch <<<");
    return sb_to_str(sb);
}

// 生成 GEN:xid 区间：XID 范围全局表 + UTF-8 解码助手 + 二分查表 + init_xid()。
// 数据来自 build/ebnf.json 的 xid_start / xid_continue（[[lo,hi],...] 十进制）。
emit_xid :: func() -> string {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "// >>> GEN:xid (generated by tools/totter.tc from build/ebnf.json -- DO NOT EDIT) >>>\n");
    sb_append_str(sb, "\n");
    sb_append_str(sb, "// XID_Start / XID_Continue 范围表（十进制 [lo,hi] 闭区间，来自 Unicode UCD）\n");
    sb_append_str(sb, "var xid_start_lo: []i64;\n");
    sb_append_str(sb, "var xid_start_hi: []i64;\n");
    sb_append_str(sb, "var xid_cont_lo: []i64;\n");
    sb_append_str(sb, "var xid_cont_hi: []i64;\n\n");
    // UTF-8 解码助手（src 为字符串，按字节索引；返回码点 + 首字节宽度）
    sb_append_str(sb, "utf8_w0 :: func(c0: u8) -> i64 {\n");
    sb_append_str(sb, "    if (c0 < 128) { return 1; }\n");
    sb_append_str(sb, "    if (c0 < 224) { return 2; }\n");
    sb_append_str(sb, "    if (c0 < 240) { return 3; }\n");
    sb_append_str(sb, "    return 4;\n");
    sb_append_str(sb, "}\n\n");
    sb_append_str(sb, "utf8_cp_at :: func(src: string, i: i64, n: i64) -> i64 {\n");
    sb_append_str(sb, "    var c0: u8 = src[i];\n");
    sb_append_str(sb, "    if (c0 < 128) { return c0 as i64; }\n");
    sb_append_str(sb, "    if (c0 < 224) {\n");
    sb_append_str(sb, "        var cp: i64 = (c0 & 31) as i64;\n");
    sb_append_str(sb, "        cp = (cp << 6) | (src[i + 1] & 63) as i64;\n");
    sb_append_str(sb, "        return cp;\n");
    sb_append_str(sb, "    }\n");
    sb_append_str(sb, "    if (c0 < 240) {\n");
    sb_append_str(sb, "        var cp: i64 = (c0 & 15) as i64;\n");
    sb_append_str(sb, "        cp = (cp << 6) | (src[i + 1] & 63) as i64;\n");
    sb_append_str(sb, "        cp = (cp << 6) | (src[i + 2] & 63) as i64;\n");
    sb_append_str(sb, "        return cp;\n");
    sb_append_str(sb, "    }\n");
    sb_append_str(sb, "    var cp: i64 = (c0 & 7) as i64;\n");
    sb_append_str(sb, "    cp = (cp << 6) | (src[i + 1] & 63) as i64;\n");
    sb_append_str(sb, "    cp = (cp << 6) | (src[i + 2] & 63) as i64;\n");
    sb_append_str(sb, "    cp = (cp << 6) | (src[i + 3] & 63) as i64;\n");
    sb_append_str(sb, "    return cp;\n");
    sb_append_str(sb, "}\n\n");
    // 二分查表
    sb_append_str(sb, "cp_in_ranges :: func(cp: i64, lo: []i64, hi: []i64) -> bool {\n");
    sb_append_str(sb, "    var lo_i: i64 = 0;\n");
    sb_append_str(sb, "    var hi_i: i64 = (slice_len(lo) as i64) - 1;\n");
    sb_append_str(sb, "    while (lo_i <= hi_i) {\n");
    sb_append_str(sb, "        var mid: i64 = (lo_i + hi_i) / 2;\n");
    sb_append_str(sb, "        if (cp < lo[mid]) { hi_i = mid - 1; }\n");
    sb_append_str(sb, "        else if (cp > hi[mid]) { lo_i = mid + 1; }\n");
    sb_append_str(sb, "        else { return true; }\n");
    sb_append_str(sb, "    }\n");
    sb_append_str(sb, "    return false;\n");
    sb_append_str(sb, "}\n\n");
    // init_xid —— 注意：append(slice, 字面量) 会被发射器生成 &字面量（非法 C），
    // 故先把每个范围端点存入临时量 _xidv，再 append(_xidv)（&_xidv 合法）。
    sb_append_str(sb, "init_xid :: func() -> void {\n");
    sb_append_str(sb, "    var _xidv: i64 = 0;\n");
    var i: i64 = 0;
    while (i < slice_len(xid_start_lo) as i64) {
        sb_append_str(sb, "    _xidv = ");
        sb_append_str(sb, xid_start_lo[i]);
        sb_append_str(sb, "; append(xid_start_lo, _xidv);\n");
        sb_append_str(sb, "    _xidv = ");
        sb_append_str(sb, xid_start_hi[i]);
        sb_append_str(sb, "; append(xid_start_hi, _xidv);\n");
        i = i + 1;
    }
    i = 0;
    while (i < slice_len(xid_cont_lo) as i64) {
        sb_append_str(sb, "    _xidv = ");
        sb_append_str(sb, xid_cont_lo[i]);
        sb_append_str(sb, "; append(xid_cont_lo, _xidv);\n");
        sb_append_str(sb, "    _xidv = ");
        sb_append_str(sb, xid_cont_hi[i]);
        sb_append_str(sb, "; append(xid_cont_hi, _xidv);\n");
        i = i + 1;
    }
    sb_append_str(sb, "}\n");
    sb_append_str(sb, "// <<< GEN:xid <<<");
    return sb_to_str(sb);
}

// 生成 GEN:ast 区间：AST 节点池地基（Node 结构 / node_new / node_at，固定文本）
// 槽串（空格分隔）工具：计数 / 取第 k 个 / 由槽名推导 t 参数类型。
slot_count :: func(s: string) -> i64 {
    var n: i64 = str_len(s) as i64;
    if (n == 0) { return 0; }
    var c: i64 = 1;
    var i: i64 = 0;
    while (i < n) {
        if (str_at(s, i) == 32) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

slot_at :: func(s: string, k: i64) -> string {
    var n: i64 = str_len(s) as i64;
    var start: i64 = 0;
    var idx: i64 = 0;
    var i: i64 = 0;
    while (i <= n) {
        var isend: bool = false;
        if (i == n) {
            isend = true;
        } else {
            if (str_at(s, i) == 32) { isend = true; }
        }
        if (isend) {
            if (idx == k) { return str_slice(s, start, i); }
            idx = idx + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

slot_ty :: func(s: string) -> string {
    var i: i64 = 0;
    while (i < slice_len(slt_name) as i64) {
        if (slt_name[i] == s) { return slt_ty[i]; }
        i = i + 1;
    }
    return "?SLOT_TY?";  // 表外槽：发射非法 token 让生成物编译失败
}

// + 节点种类注册表（node_kind_names / init_node_kinds / is_node_kind，由 nodes 表生成）。
// + 每种类的构造器 mk_<kind>(槽参数…, ti)（由 nodes 表的槽标注生成）。
emit_ast :: func() -> string {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "// >>> GEN:ast (generated by tools/totter.tc from build/ebnf.json nodes -- DO NOT EDIT) >>>\n");
    sb_append_str(sb, "// ── AST 节点池（扁平化，索引引用）──────────────────────────────\n");
    sb_append_str(sb, "// 约定：\n");
    sb_append_str(sb, "//   na/nb/nc/nd : 子节点索引，-1 = null\n");
    sb_append_str(sb, "//   la/lb/lc    : 子节点列表头（Child 池索引），-1 = 空列表，-2 = null 列表\n");
    sb_append_str(sb, "//   sa/sb/sc    : 字符串载荷；has_sa=false 表示 sa 语义为 null\n");
    sb_append_str(sb, "//   ia/ib       : 整型载荷（radix / bitWidth / offset），-1 = null\n");
    sb_append_str(sb, "//   ba/bb       : 布尔载荷（isConst/isExtern/isComptime/isBitpack...）\n");
    sb_append_str(sb, "\n");
    sb_append_str(sb, "Node :: struct {\n");
    sb_append_str(sb, "    kind: string;\n");
    var si: i64 = 0;
    while (si < slice_len(slt_name) as i64) {
        sb_append_str(sb, "    ");
        sb_append_str(sb, slt_name[si]);
        sb_append_str(sb, ": ");
        sb_append_str(sb, slt_ty[si]);
        sb_append_str(sb, ";");
        if (slt_cmt[si] != "") {
            // 注释对齐到列 16（不足补空格，至少 1 个）
            var w: i64 = 4 + (str_len(slt_name[si]) as i64) + 2 + (str_len(slt_ty[si]) as i64) + 1;
            if (w >= 16) { w = 15; }
            while (w < 16) { sb_append_str(sb, " "); w = w + 1; }
            sb_append_str(sb, "// ");
            sb_append_str(sb, slt_cmt[si]);
        }
        sb_append_str(sb, "\n");
        si = si + 1;
    }
    sb_append_str(sb, "}\n");
    sb_append_str(sb, "\n");
    sb_append_str(sb, "var nodes: []Node;\n");
    sb_append_str(sb, "\n");
    sb_append_str(sb, "Child :: struct {\n");
    sb_append_str(sb, "    val: i64;\n");
    sb_append_str(sb, "    next: i64;\n");
    sb_append_str(sb, "}\n");
    sb_append_str(sb, "\n");
    sb_append_str(sb, "var kids: []Child;\n");
    sb_append_str(sb, "\n");
    sb_append_str(sb, "// 新建节点：全部字段置于\"空\"语义，返回索引\n");
    sb_append_str(sb, "node_new :: func(kind: string) -> i64 {\n");
    sb_append_str(sb, "    var n: Node;\n");
    sb_append_str(sb, "    n.kind = kind;\n");
    si = 0;
    while (si < slice_len(slt_name) as i64) {
        sb_append_str(sb, "    n.");
        sb_append_str(sb, slt_name[si]);
        sb_append_str(sb, " = ");
        sb_append_str(sb, slt_def[si]);
        sb_append_str(sb, ";\n");
        si = si + 1;
    }
    sb_append_str(sb, "    append(nodes, n);\n");
    sb_append_str(sb, "    return (slice_len(nodes) as i64) - 1;\n");
    sb_append_str(sb, "}\n");
    sb_append_str(sb, "\n");
    sb_append_str(sb, "// 给节点打 anchor token（诊断定位用），tok 索引 → line/col/text\n");
    sb_append_str(sb, "node_at :: func(ni: i64, ti: i64) -> void {\n");
    sb_append_str(sb, "    var tk: Tok = toks[ti];\n");
    sb_append_str(sb, "    var n: Node = nodes[ni];\n");
    sb_append_str(sb, "    n.ln = tk.line;\n");
    sb_append_str(sb, "    n.cl = tk.col;\n");
    sb_append_str(sb, "    n.tv = tk.v;\n");
    sb_append_str(sb, "    slice_set(nodes, ni, n);\n");
    sb_append_str(sb, "}\n");
    sb_append_str(sb, "\n");
    sb_append_str(sb, "// ── 节点种类注册表（来自 reference.md §2.9 NodeTable）──\n");
    sb_append_str(sb, "var node_kind_names: []string;\n");
    sb_append_str(sb, "\n");
    sb_append_str(sb, "init_node_kinds :: func() -> void {\n");
    var i: i64 = 0;
    while (i < slice_len(nd_name) as i64) {
        sb_append_str(sb, "    append(node_kind_names, \"");
        sb_append_str(sb, nd_name[i]);
        sb_append_str(sb, "\");\n");
        i = i + 1;
    }
    sb_append_str(sb, "}\n");
    sb_append_str(sb, "\n");
    sb_append_str(sb, "is_node_kind :: func(k: string) -> bool {\n");
    sb_append_str(sb, "    var i: i64 = 0;\n");
    sb_append_str(sb, "    while (i < slice_len(node_kind_names) as i64) {\n");
    sb_append_str(sb, "        if (node_kind_names[i] == k) { return true; }\n");
    sb_append_str(sb, "        i = i + 1;\n");
    sb_append_str(sb, "    }\n");
    sb_append_str(sb, "    return false;\n");
    sb_append_str(sb, "}\n");
    sb_append_str(sb, "\n");
    sb_append_str(sb, "// ── 节点构造器（槽参数按 Node 字段序，末位 ti；ti < 0 表示不打 anchor）──\n");
    i = 0;
    while (i < slice_len(nd_name) as i64) {
        var kn: string = nd_name[i];
        var sl: string = nd_slots[i];
        var cnt: i64 = slot_count(sl);
        sb_append_str(sb, "\nmk_");
        sb_append_str(sb, kn);
        sb_append_str(sb, " :: func(");
        var k: i64 = 0;
        while (k < cnt) {
            var pn: string = slot_at(sl, k);
            sb_append_str(sb, pn);
            sb_append_str(sb, ": ");
            sb_append_str(sb, slot_ty(pn));
            sb_append_str(sb, ", ");
            k = k + 1;
        }
        sb_append_str(sb, "ti: i64) -> i64 {\n");
        sb_append_str(sb, "    var id: i64 = node_new(\"");
        sb_append_str(sb, kn);
        sb_append_str(sb, "\");\n");
        if (cnt > 0) {
            sb_append_str(sb, "    var n: Node = nodes[id];\n");
            k = 0;
            while (k < cnt) {
                var pn2: string = slot_at(sl, k);
                sb_append_str(sb, "    n.");
                sb_append_str(sb, pn2);
                sb_append_str(sb, " = ");
                sb_append_str(sb, pn2);
                sb_append_str(sb, ";\n");
                k = k + 1;
            }
            sb_append_str(sb, "    slice_set(nodes, id, n);\n");
        }
        sb_append_str(sb, "    if (ti >= 0) { node_at(id, ti); }\n");
        sb_append_str(sb, "    return id;\n");
        sb_append_str(sb, "}\n");
        i = i + 1;
    }
    sb_append_str(sb, "// <<< GEN:ast <<<");
    return sb_to_str(sb);
}

// ───────────── 主流程 ─────────────

main_fn :: func() -> i32 @main {
    load_tables();
    load_grammar(g_json_root);

    var src: string = file_read_all("src/tote.tc");
    var out: string = src;

    out = replace_interval(out,
        "// >>> GEN:kw_lookup",
        "// <<< GEN:kw_lookup <<<",
        emit_kw());
    out = replace_interval(out,
        "// >>> GEN:builtins",
        "// <<< GEN:builtins <<<",
        emit_bi());
    out = replace_interval(out,
        "// >>> GEN:derives",
        "// <<< GEN:derives <<<",
        emit_dv());
    out = replace_interval(out,
        "// >>> GEN:diagnostics",
        "// <<< GEN:diagnostics <<<",
        emit_dg());
    out = replace_interval(out,
        "// >>> GEN:annotations",
        "// <<< GEN:annotations <<<",
        emit_ann());
    out = replace_interval(out,
        "// >>> GEN:parser_dispatch",
        "// <<< GEN:parser_dispatch <<<",
        emit_parser_dispatch());
    out = replace_interval(out,
        "// >>> GEN:xid",
        "// <<< GEN:xid <<<",
        emit_xid());
    out = replace_interval(out,
        "// >>> GEN:parser_rules",
        "// <<< GEN:parser_rules <<<",
        emit_parser());
    out = replace_interval(out,
        "// >>> GEN:ast",
        "// <<< GEN:ast <<<",
        emit_ast());

    file_write_all("gen/tote.tc", out);
    return 0;
}
