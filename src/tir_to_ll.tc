// tir_to_ll: TIR (memory-first linear IR) -> LLVM IR 薄后端（设计 §9.2 / Stage 3）
//
// 设计要点：TIR 是 memory-first（非 SSA）。每个 TIR slot `$x` 映射为 LLVM `alloca`；
// 任意对 $x 的值读取 = `load`，写入 = `store`。LLVM 的 mem2reg/SROA 会自动把
// 这些 alloca 提升回寄存器，故等价性由 TIR 文本保证（设计 §9.2 结论）。
//
// 本模块只读 `tir.tir_to_text()` 产出的文本（格式见 tir-design.md §4，已验证），
// 做两遍扫描：第 1 遍收集函数签名 + 发射 TT 类型；第 2 遍发射函数体。
// 通过新子命令 `emit-tir-ll` 暴露；不动现有 `emit-ll`/`build`，保留自举不动点。

@import("src.base" :: *);

pub var g_ll: StringBuilder;
pub var g_ll_tmpc: i64;
pub var g_ll_names: []string;   // TIR 槽名($x) -> LLVM 类型(ST) 并行数组
pub var g_ll_sts: []string;
pub var g_func_names: []string;       // 函数名 -> 参数 ST 列表（供 call 用）
pub var g_func_paramsts: [][]string;
pub var g_ll_func_rets: []string;     // 兼容保留
pub var g_pf_name: string;            // ll_parse_func 结果（t 不支持多返回值，用全局传递）
pub var g_pf_params: []string;
pub var g_pf_ret: string;
pub var g_ll_curfn: string;           // 当前函数名前缀：LLVM 寄存器/标签是模块全局，按函数加前缀避免重名
pub var g_ll_declared: []string;       // 已 emit 过 declare 的外部函数名
pub var g_ll_declbuf: StringBuilder;   // 外部 declare 缓冲（函数体扫描后追加到模块末尾）
pub var g_opaque_emitted: []string;    // 已 emit 过 opaque 定义的运行时结构类型名（如 TSb）
pub var g_ll_globals: []string;         // 模块级全局变量名（@ 已剥离）
pub var g_ll_globalsts: []string;       // 对应的存储类型 ST（与 g_ll_globals 并行）
pub var g_in_globals: bool = false;     // 当前是否处于 TIR globals: 段
pub var g_ll_named_types: []string;     // 引用但未在 types: 段声明的命名类型（%Perm 等位标志/枚举，i64 底类型）
pub var g_str_table: []string;          // TIR strings: 段内容（tir_esc 转义后的字面量，可直接用作 LLVM c"..." 内容）
pub var g_in_strings: bool = false;     // 当前是否处于 TIR strings: 段
pub var g_ll_struct_types: []string;     // types: 段内已声明为 struct 的命名类型（%Node 等用户聚合，禁止被误判为 i64 标量）
pub var g_has_main: bool = false;        // TIR 是否含入口函数（@main 标注），用于补 @main 包装器
pub var g_main_fn: string = "";          // 入口函数 LLVM 名（mangled），如 main_fn

pub fn ll_tmp() string {
    var v: i64 = g_ll_tmpc;
    g_ll_tmpc = v + 1;
    return base.sb_cat3("%", g_ll_curfn, base.sb_cat2(".llt", base.i2s(v)));
}

pub fn ll_reset() void {
    g_ll = sb_new();
    g_ll_tmpc = 0;
    g_ll_names = [];
    g_ll_sts = [];
    g_func_names = [];
    g_func_paramsts = [];
    g_ll_func_rets = [];
    g_pf_name = "";
    g_pf_params = [];
    g_pf_ret = "void";
    g_ll_curfn = "";
    g_ll_declared = [];
    g_ll_declbuf = sb_new();
    g_opaque_emitted = [];
    g_ll_globals = [];
    g_ll_globalsts = [];
    g_in_globals = false;
    g_str_table = [];
    g_in_strings = false;
    g_ll_struct_types = [];
    g_ll_named_types = [];
    g_has_main = false;
    g_main_fn = "";
}

pub fn ll_get_st(name: string) string {
    var n: i64 = slice_len(g_ll_names) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (g_ll_names[i] == name) { return g_ll_sts[i]; }
        i = i + 1;
    }
    return "i64";
}

pub fn ll_set_st(name: string, st: string) void {
    var n: i64 = slice_len(g_ll_names) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (g_ll_names[i] == name) { g_ll_sts[i] = st; return; }
        i = i + 1;
    }
    append(g_ll_names, name);
    append(g_ll_sts, st);
}

pub fn ll_llname(tname: string) string {
    // $x -> %curfn.x (值寄存器，按函数加前缀) ; @fn -> fn (全局函数名，去 @)
    if (str_len(tname) < 1) { return tname; }
    if (tname[0] == 36) {
        var s: string = str_slice(tname, 1, str_len(tname));
        return base.sb_cat3("%", g_ll_curfn, base.sb_cat2(".", ll_mangle(s)));
    }
    if (tname[0] == 64) { return ll_mangle(str_slice(tname, 1, str_len(tname))); }                        // '@'
    return tname;
}

// 指针目的地（store/load 的 ptr 操作数、addr_of 目标）用此变体：@name 全局引用保留 '@' 前缀。
// 例：store i32 %v, ptr @gNpc —— 全局变量作为存放目标必须带 '@'。
pub fn ll_llname_ptr(tname: string) string {
    if (str_len(tname) >= 1 && tname[0] == 64) {
        return "@" + ll_mangle(str_slice(tname, 1, str_len(tname)));
    }
    return ll_llname(tname);
}

// @name 是否为已声明的函数（避免把函数名误当作全局变量声明）
pub fn ll_is_func(name: string) bool {
    var n: i64 = slice_len(g_func_names) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (g_func_names[i] == name) { return true; }
        i = i + 1;
    }
    return false;
}

// 遇到引用但未声明的 @name 全局：登记为 `global <st> zeroinitializer`，模块末尾统一 emit。
// （tir.tc 暂不建模模块级全局变量声明，此处由翻译器兜底，使 legacy emit-ll 能编译的示例在 TIR 路径同样可编译。）
pub fn ll_register_global(name: string, st: string) void {
    var n: i64 = slice_len(g_ll_globals) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (g_ll_globals[i] == name) { return; }
        i = i + 1;
    }
    append(g_ll_globals, name);
    append(g_ll_globalsts, st_to_ll(st));
}

// 分支标签：@Lx -> curfn.Lx（LLVM 标签是函数局域，需加函数前缀避免跨函数重名）
pub fn ll_label(name: string) string {
    var s: string = name;
    if (str_len(s) > 0 && s[0] == 64) { s = str_slice(s, 1, str_len(s)); }
    return base.sb_cat2(g_ll_curfn, base.sb_cat2(".", s));
}

// 标识符 LLVM 合法化：非 [A-Za-z0-9_.$\u0080-] 字符转义为 _uXXXX_，确保首字符合法（LLVM 标识符首字符须为字母/_/./$）
pub fn ll_mangle(s: string) string {
    var n: i64 = str_len(s);
    if (n == 0) { return "_"; }
    var sb: StringBuilder = sb_new();
    var i: i64 = 0;
    while (i < n) {
        var c: i64 = str_at(s, i);
        if ((c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c == 46 || c == 36) {
            sb_append_char(sb, c);
        } else {
            sb_append_char(sb, 95);
            sb_append_char(sb, 117);
            sb_append_char(sb, base.hex_digit((c >> 12) & 15) as i64);
            sb_append_char(sb, base.hex_digit((c >> 8) & 15) as i64);
            sb_append_char(sb, base.hex_digit((c >> 4) & 15) as i64);
            sb_append_char(sb, base.hex_digit(c & 15) as i64);
            sb_append_char(sb, 95);
        }
        i = i + 1;
    }
    var r: string = sb_to_str(sb);
    var fc: i64 = str_at(r, 0);
    if (fc >= 48 && fc <= 57) { r = base.sb_cat2("_", r); }
    return r;
}

pub fn ll_ensure_slot(tname: string, st: string) void {
    var n: i64 = slice_len(g_ll_names) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (g_ll_names[i] == tname) { return; }
        i = i + 1;
    }
    append(g_ll_names, tname);
    append(g_ll_sts, st);
    sb_append_str(g_ll, "  ");
    sb_append_str(g_ll, ll_llname(tname));
    sb_append_str(g_ll, " = alloca ");
    sb_append_str(g_ll, st_to_ll(st));
    sb_append_str(g_ll, "\n");
}

// 取 $x 承载值的 LLVM 寄存器（load 出 alloca）
pub fn ll_load(tname: string, st: string) string {
    // 字面量立即数（整数/浮点，如 0 / -1 / 1.5）：直接作为值返回，不可按临时量去 load，
    // 否则会生成非法的 `load X, ptr 0`。
    if (str_len(tname) >= 1 && tname[0] != 36 && tname[0] != 64) { return tname; }
    // 全局引用 @name（函数或全局变量）：全局符号在 LLVM 中恒为指针，作值操作数时必须 load 出其值。
    // 对函数引用：load ptr, ptr @fn 等价于直接使用 @fn（取其地址）；对全局变量：load 出存储值。两种情形都正确。
    if (str_len(tname) >= 1 && tname[0] == 64) {
        var gnm: string = str_slice(tname, 1, str_len(tname));
        if (ll_is_func(gnm) == false) { ll_register_global(gnm, st); }
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = load ");
        sb_append_str(g_ll, st_to_ll(st));
        sb_append_str(g_ll, ", ptr @");
        sb_append_str(g_ll, ll_mangle(gnm));
        sb_append_str(g_ll, "\n");
        return r;
    }
    var r: string = ll_tmp();
    sb_append_str(g_ll, "  ");
    sb_append_str(g_ll, r);
    sb_append_str(g_ll, " = load ");
    sb_append_str(g_ll, st_to_ll(st));
    sb_append_str(g_ll, ", ptr ");
    sb_append_str(g_ll, ll_llname_ptr(tname));
    sb_append_str(g_ll, "\n");
    return r;
}

pub fn ll_store(tname: string, st: string, val: string) void {
    if (str_len(tname) >= 1 && tname[0] == 64) {
        var gnm: string = str_slice(tname, 1, str_len(tname));
        if (ll_is_func(gnm) == false) { ll_register_global(gnm, st); }
    }
    sb_append_str(g_ll, "  store ");
    sb_append_str(g_ll, st_to_ll(st));
    sb_append_str(g_ll, " ");
    sb_append_str(g_ll, val);
    sb_append_str(g_ll, ", ptr ");
    sb_append_str(g_ll, ll_llname_ptr(tname));
    sb_append_str(g_ll, "\n");
}

pub fn ll_find(s: string, sub: string) i64 {
    var n: i64 = str_len(s);
    var m: i64 = str_len(sub);
    var i: i64 = 0;
    while (i + m <= n) {
        var j: i64 = 0;
        var ok: bool = true;
        while (j < m) {
            if (str_at(s, i + j) != str_at(sub, j)) { ok = false; break; }
            j = j + 1;
        }
        if (ok) { return i; }
        i = i + 1;
    }
    return -1;
}

// 十进制字符串 → i64（用于 const.str 的索引解析）。忽略非数字前缀；空/非法返回 0。
pub fn ll_atoi(s: string) i64 {
    var n: i64 = str_len(s);
    var i: i64 = 0;
    var v: i64 = 0;
    var neg: bool = false;
    if (n >= 1 && str_at(s, 0) == 45) { neg = true; i = 1; }   // '-'
    while (i < n) {
        var c: i64 = str_at(s, i);
        if (c < 48 || c > 57) { break; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    if (neg) { v = 0 - v; }
    return v;
}

// 计算 tir_esc 转义串的原始字节长度（\XX 计 1 字节，其余计 1 字节）
pub fn ll_str_rawlen(content: string) i64 {
    var cn: i64 = str_len(content);
    var ci: i64 = 0;
    var blen: i64 = 0;
    while (ci < cn) {
        if (str_at(content, ci) == 92) { ci = ci + 3; } else { ci = ci + 1; }
        blen = blen + 1;
    }
    return blen;
}

// 最右一次子串出现位置（数组计数分隔符 " x " 须取最右，因元素类型本身可嵌套 arr<... x ...>）
pub fn ll_rfind(s: string, sub: string) i64 {
    var n: i64 = str_len(s);
    var m: i64 = str_len(sub);
    if (m <= 0 || m > n) { return -1; }
    var i: i64 = n - m;
    while (i >= 0) {
        var j: i64 = 0;
        var ok: bool = true;
        while (j < m) {
            if (str_at(s, i + j) != str_at(sub, j)) { ok = false; break; }
            j = j + 1;
        }
        if (ok) { return i; }
        i = i - 1;
    }
    return -1;
}

// 真·前缀判断（t 内置 str_starts 实为相等判断，不可用）
pub fn ll_starts(s: string, pre: string) bool {
    var n: i64 = str_len(pre);
    if (str_len(s) < n) { return false; }
    var i: i64 = 0;
    while (i < n) {
        if (str_at(s, i) != str_at(pre, i)) { return false; }
        i = i + 1;
    }
    return true;
}

// TIR ST -> LLVM 类型
pub fn st_to_ll(st: string) string {
    if (st == "void") { return "void"; }
    if (st == "bool") { return "i8"; }
    if (st == "u8") { return "i8"; }
    if (st == "u16") { return "i16"; }
    if (st == "u32") { return "i32"; }
    if (st == "u64") { return "i64"; }
    if (st == "f32") { return "float"; }
    if (st == "f64") { return "double"; }
    if (ll_starts(st, "ptr<")) {
        return "ptr";
    }
    if (ll_starts(st, "arr<")) {
        var inner: string = str_slice(st, 4, str_len(st) - 1);
        // 计数分隔符 " x " 取最右一次：元素类型本身可能嵌套 arr<... x ...>（如 arr<arr<i32 x 3> x 2>）
        var sp: i64 = ll_rfind(inner, " x ");
        if (sp < 0) { return "ptr"; }   // 兜底：无计数的动态数组降级为缓冲指针，防越界 panic
        var elem: string = str_slice(inner, 0, sp);
        var nn: string = str_slice(inner, sp + 3, str_len(inner));
        return base.sb_cat5("[", nn, " x ", st_to_ll(elem), "]");
    }
    if (ll_starts(st, "vec<")) {
        var inner: string = str_slice(st, 4, str_len(st) - 1);
        var sp: i64 = ll_rfind(inner, " x ");
        if (sp < 0) { return "ptr"; }
        var elem: string = str_slice(inner, 0, sp);
        var nn: string = str_slice(inner, sp + 3, str_len(inner));
        return base.sb_cat5("<", nn, " x ", st_to_ll(elem), ">");
    }
    if (ll_starts(st, "fn<")) {
        return "ptr";
    }
    return st;
}

// 收集引用但未在 types: 段声明的命名类型（%Perm 等位标志/枚举，i64 底类型）。
// 排除运行期结构类型 %T*（%TStr 等已由 types: 段或 opaque 处理）。
// 类型是否已由 types: 段声明为 struct（%Node 等用户聚合），若是则不应被盖成 i64 标量。
pub fn ll_is_struct_type(st: string) bool {
    var n: i64 = slice_len(g_ll_struct_types) as i64;
    var i: i64 = 0;
    while (i < n) { if (g_ll_struct_types[i] == st) { return true; } i = i + 1; }
    return false;
}

pub fn ll_register_named_type(st: string) void {
    // 仅处理命名类型（%X，非运行期结构 %T*）；且须排除 types: 段已声明为 struct 的用户聚合
    // （%Node 等）——那些已是正确 struct 定义，不可再被盖成 `type i64`。
    if (ll_starts(st, "%") && ll_starts(st, "%T") == false && ll_is_struct_type(st) == false) {
        var n: i64 = slice_len(g_ll_named_types) as i64;
        var i: i64 = 0;
        var seen: bool = false;
        while (i < n) {
            if (g_ll_named_types[i] == st) { seen = true; break; }
            i = i + 1;
        }
        if (seen == false) { append(g_ll_named_types, st); }
    }
}

pub fn ll_arg_types(args: string) string {
    if (str_len(args) == 0) { return ""; }
    var out: StringBuilder = sb_new();
    var n: i64 = str_len(args);
    var i: i64 = 0;
    var cur: StringBuilder = sb_new();
    var first: bool = true;
    while (i < n) {
        var c: i64 = str_at(args, i);
        if (c == 44) {   // ','
            if (first == false) { sb_append_str(out, ", "); }
            sb_append_str(out, st_to_ll(sb_to_str(cur)));
            cur = sb_new();
            first = false;
        } else {
            sb_append_char(cur, c);
        }
        i = i + 1;
    }
    if (first == false) { sb_append_str(out, ", "); }
    sb_append_str(out, st_to_ll(sb_to_str(cur)));
    return sb_to_str(out);
}

pub fn ll_ptr_inner(st: string) string {
    // ptr<ST> -> 元素 ST（已转 LLVM 类型）。防御：非 ptr< 前缀（如 gep 值型基址分支传入标量 i64，
    // 或 bitcast 把 ptr<%__env> 擦成 ptr 后）直接整体转译，避免对标量做 str_slice(st,4,...) 越界 panic。
    if (ll_starts(st, "ptr<") == false) { return st_to_ll(st); }
    return st_to_ll(str_slice(st, 4, str_len(st) - 1));
}

pub fn ll_is_int(st: string) bool {
    return ll_starts(st, "i") || ll_starts(st, "u") || st == "bool";
}

// 是否为标量类型（整数/浮点/布尔）。聚合/指针/命名类型返回 false。
pub fn ll_is_scalar_st(st: string) bool {
    return st == "bool" || st == "i1" || st == "i8" || st == "i16" ||
           st == "i32" || st == "i64" || st == "u8" || st == "u16" ||
           st == "u32" || st == "u64" || st == "f32" || st == "f64";
}

pub fn ll_is_float(st: string) bool {
    return st == "f32" || st == "f64";
}

// 八进制整数字面量 -> 十进制（LLVM IR 不支持 0o755，但支持 0x.. 与十进制）
pub fn ll_oct_to_dec(s: string) string {
    var n: i64 = str_len(s);
    var i: i64 = 2;   // 跳过 "0o"
    if (i >= n) { return "0"; }
    var val: i64 = 0;
    while (i < n) {
        var c: i64 = str_at(s, i);
        var d: i64 = c - 48;   // '0' = 48
        if (d < 0 || d > 7) { d = 0; }
        val = val * 8 + d;
        i = i + 1;
    }
    return base.i2s(val);
}

// 十六进制整数字面量 -> 十进制（裸 0x.. 在 LLVM IR 中易被误判为浮点，转十进制最稳）
pub fn ll_hex_to_dec(s: string) string {
    var n: i64 = str_len(s);
    var i: i64 = 2;   // 跳过 "0x"
    var val: i64 = 0;
    while (i < n) {
        var c: i64 = str_at(s, i);
        var d: i64;
        if (c >= 48 && c <= 57) { d = c - 48; }        // '0'-'9'
        else if (c >= 65 && c <= 70) { d = c - 55; }   // 'A'-'F'
        else if (c >= 97 && c <= 102) { d = c - 87; }  // 'a'-'f'
        else { d = 0; }
        val = val * 16 + d;
        i = i + 1;
    }
    return base.i2s(val);
}

// 二进制整数字面量 -> 十进制（LLVM IR 不支持 0b..）
pub fn ll_bin_to_dec(s: string) string {
    var n: i64 = str_len(s);
    var i: i64 = 2;   // 跳过 "0b"
    if (i >= n) { return "0"; }
    var val: i64 = 0;
    while (i < n) {
        var c: i64 = str_at(s, i);
        var d: i64 = c - 48;   // '0'=48 '1'=49
        if (d < 0 || d > 1) { d = 0; }
        val = val * 2 + d;
        i = i + 1;
    }
    return base.i2s(val);
}

// 归一化立即数：浮点处理 inf/nan，二/八/十六进制转十进制；十进制/负数 LLVM 原生支持
// 判断立即数是否为纯整数字面量（可选前导 '-' + 数字，不含 '.'/'e'/'x' 等）
pub fn ll_imm_is_int(s: string) bool {
    var n: i64 = str_len(s);
    if (n == 0) { return false; }
    var i: i64 = 0;
    if (str_at(s, 0) == 45) { i = 1; }   // '-'
    if (i == n) { return false; }
    while (i < n) {
        var c: i64 = str_at(s, i);
        if (c < 48 || c > 57) { return false; }
        i = i + 1;
    }
    return true;
}

pub fn ll_norm_imm(imm: string, st: string) string {    if (ll_starts(st, "f")) {
        if (imm == "inf") { if (st == "f32") { return "0x7F800000"; } return "0x7FF0000000000000"; }
        if (imm == "-inf") { if (st == "f32") { return "0xFF800000"; } return "0xFFF0000000000000"; }
        if (imm == "nan") { if (st == "f32") { return "0x7FC00000"; } return "0x7FF8000000000000"; }
        // 整数字面量（如 -1、1000）作为浮点常量需补 .0，否则 LLVM 报
        // "integer constant must have integer type"（store double -1 非法）。
        if (ll_imm_is_int(imm)) { return base.sb_cat2(imm, ".0"); }
        return imm;
    }
    if (ll_starts(imm, "0b") || ll_starts(imm, "0B")) { return ll_bin_to_dec(imm); }
    if (ll_starts(imm, "0o") || ll_starts(imm, "0O")) { return ll_oct_to_dec(imm); }
    if (ll_starts(imm, "0x") || ll_starts(imm, "0X")) { return ll_hex_to_dec(imm); }
    return imm;
}

// 为模块内未定义的被调函数 emit declare（可被多次调用，仅首见时声明一次）
pub fn ll_maybe_declare(fname: string, retst: string, argsts: []string) void {
    var i: i64 = 0;
    var n: i64 = slice_len(g_func_names) as i64;
    while (i < n) {
        if (g_func_names[i] == fname) { return; }   // 本模块已定义
        i = i + 1;
    }
    var j: i64 = 0;
    var m: i64 = slice_len(g_ll_declared) as i64;
    while (j < m) {
        if (g_ll_declared[j] == fname) { return; }  // 已声明
        j = j + 1;
    }
    append(g_ll_declared, fname);
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "declare ");
    sb_append_str(sb, st_to_ll(retst));
    sb_append_str(sb, " @");
    sb_append_str(sb, fname);
    sb_append_str(sb, "(");
    var k: i64 = 0;
    var am: i64 = slice_len(argsts) as i64;
    var first: bool = true;
    while (k < am) {
        if (first == false) { sb_append_str(sb, ", "); }
        sb_append_str(sb, st_to_ll(argsts[k]));
        first = false;
        k = k + 1;
    }
    sb_append_str(sb, ")\n");
    sb_append_str(g_ll_declbuf, sb_to_str(sb));
}

// 发射一条 `call void @fname(...)`（参数类型/值并行给出）。内建降级统一走此helper，
// 避免手写 sb_append_str 时误把 ll_load 的副作用（load 指令）注入到 call 实参中间。
pub fn ll_call_void(fname: string, argsts: []string, argv: []string) void {
    ll_maybe_declare(fname, "void", argsts);
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "  call void @");
    sb_append_str(sb, fname);
    sb_append_str(sb, "(");
    var i: i64 = 0;
    var n: i64 = slice_len(argsts) as i64;
    var first: bool = true;
    while (i < n) {
        if (first == false) { sb_append_str(sb, ", "); }
        sb_append_str(sb, argsts[i]);
        sb_append_str(sb, " ");
        sb_append_str(sb, argv[i]);
        first = false;
        i = i + 1;
    }
    sb_append_str(sb, ")\n");
    sb_append_str(g_ll, sb_to_str(sb));
}

// 发射一条 `call <retst> @fname(...)` 并把结果存入 dest 槽 d（结果类型即 retst）。
pub fn ll_call_ret(fname: string, retst: string, argsts: []string, argv: []string, d: string) void {
    ll_maybe_declare(fname, retst, argsts);
    var r: string = ll_tmp();
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "  ");
    sb_append_str(sb, r);
    sb_append_str(sb, " = call ");
    sb_append_str(sb, retst);
    sb_append_str(sb, " @");
    sb_append_str(sb, fname);
    sb_append_str(sb, "(");
    var i: i64 = 0;
    var n: i64 = slice_len(argsts) as i64;
    var first: bool = true;
    while (i < n) {
        if (first == false) { sb_append_str(sb, ", "); }
        sb_append_str(sb, argsts[i]);
        sb_append_str(sb, " ");
        sb_append_str(sb, argv[i]);
        first = false;
        i = i + 1;
    }
    sb_append_str(sb, ")\n");
    sb_append_str(g_ll, sb_to_str(sb));
    ll_ensure_slot(d, retst); ll_set_st(d, retst); ll_store(d, retst, r);
}

pub fn ll_binop(op: string) string {
    if (op == "add") { return "add"; }
    if (op == "sub") { return "sub"; }
    if (op == "mul") { return "mul"; }
    if (op == "sdiv") { return "sdiv"; }
    if (op == "udiv") { return "udiv"; }
    if (op == "srem") { return "srem"; }
    if (op == "urem") { return "urem"; }
    if (op == "and") { return "and"; }
    if (op == "or") { return "or"; }
    if (op == "xor") { return "xor"; }
    if (op == "shl") { return "shl"; }
    if (op == "lshr") { return "lshr"; }
    if (op == "ashr") { return "ashr"; }
    return "add";
}
// 浮点二元助记符：整数 binop 的浮点对应（add.f64 → fadd 等）
pub fn ll_fbinop(op: string) string {
    if (op == "add") { return "fadd"; }
    if (op == "sub") { return "fsub"; }
    if (op == "mul") { return "fmul"; }
    if (op == "sdiv" || op == "udiv" || op == "div") { return "fdiv"; }
    if (op == "srem" || op == "urem" || op == "mod") { return "frem"; }
    return "fadd";
}

pub fn ll_icmp(op: string) string {
    if (op == "slt") { return "slt"; }
    if (op == "sgt") { return "sgt"; }
    if (op == "sge") { return "sge"; }
    if (op == "sle") { return "sle"; }
    if (op == "ult") { return "ult"; }
    if (op == "ugt") { return "ugt"; }
    if (op == "ule") { return "ule"; }
    if (op == "uge") { return "uge"; }
    if (op == "eq") { return "eq"; }
    if (op == "ne") { return "ne"; }
    return "eq";
}

// 浮点比较谓词（icmp 仅接受整数类型，浮点必须用 fcmp）
pub fn ll_fcmp(op: string) string {
    if (op == "eq") { return "oeq"; }
    if (op == "ne") { return "one"; }
    if (op == "slt") { return "olt"; }
    if (op == "sgt") { return "ogt"; }
    if (op == "sle") { return "ole"; }
    if (op == "sge") { return "oge"; }
    if (op == "ult") { return "ult"; }
    if (op == "ugt") { return "ugt"; }
    if (op == "ule") { return "ule"; }
    if (op == "uge") { return "uge"; }
    return "oeq";
}

// 取比较 op 的前缀：无点形式 slti64 -> "slt"（算术用点 slt.i64，比较用无点 slti64）
pub fn ll_cmp_prefix(op: string) string {
    if (ll_starts(op, "slt")) { return "slt"; }
    if (ll_starts(op, "sgt")) { return "sgt"; }
    if (ll_starts(op, "sge")) { return "sge"; }
    if (ll_starts(op, "sle")) { return "sle"; }
    if (ll_starts(op, "ult")) { return "ult"; }
    if (ll_starts(op, "ugt")) { return "ugt"; }
    if (ll_starts(op, "ule")) { return "ule"; }
    if (ll_starts(op, "uge")) { return "uge"; }
    if (ll_starts(op, "eq")) { return "eq"; }
    if (ll_starts(op, "ne")) { return "ne"; }
    return "";
}

// 取 op.ST 的 '.' 分隔位置（op 与 st 在调用处就地拆分，t 不支持多返回值）
pub fn ll_split_dot(s: string) i64 {
    return ll_find(s, ".");
}

// 简单空白分词（先把 ( ) , 换成空格）。类型参数（arr<T x N> / vec<T x N>）内含空格，
// 须按 '<' 深度计数保留其为类型 token 的一部分，否则会被切成 arr<i64 / x / 3> 多个 token，
// 导致函数签名与 bitcast/slot 等指令的类型解析错位（st_to_ll 收到缺 '>' 的残缺类型而越界 panic）。
pub fn ll_tokens(line: string) []string {
    var n: i64 = str_len(line);
    var i: i64 = 0;
    var out: StringBuilder = sb_new();
    var depth: i64 = 0;   // '<' 深度
    while (i < n) {
        var c: i64 = str_at(line, i);
        if (c == 60) { depth = depth + 1; sb_append_char(out, c); }            // '<' 进入类型参数
        else if (c == 62) { if (depth > 0) { depth = depth - 1; } sb_append_char(out, c); }  // '>' 退出
        else if (c == 40 || c == 41 || c == 44) { sb_append_char(out, 32); }   // ( ) , -> space
        else { sb_append_char(out, c); }
        i = i + 1;
    }
    var s2: string = sb_to_str(out);
    var n2: i64 = str_len(s2);
    var j: i64 = 0;
    var buf: StringBuilder = sb_new();
    var toks: []string = [];
    var d2: i64 = 0;   // 第二遍同样按 '<' 深度，避免切分类型参数内的空格
    while (j < n2) {
        var c: i64 = str_at(s2, j);
        if (c == 60) { d2 = d2 + 1; }
        else if (c == 62) { if (d2 > 0) { d2 = d2 - 1; } }
        if ((c == 32 || c == 9 || c == 10 || c == 13) && d2 == 0) {
            if (str_len(sb_to_str(buf)) > 0) {
                append(toks, sb_to_str(buf));
                buf = sb_new();
            }
        } else {
            sb_append_char(buf, c);
        }
        j = j + 1;
    }
    if (str_len(sb_to_str(buf)) > 0) { append(toks, sb_to_str(buf)); }
    return toks;
}

// 解析 func 行，结果写入 g_pf_name / g_pf_params / g_pf_ret（t 不支持多返回值）
pub fn ll_parse_func(line: string) void {
    var toks: []string = ll_tokens(line);   // func @name($a: ST, $b: ST): ST {
    g_pf_name = ll_mangle(str_slice(toks[1], 1, str_len(toks[1])));   // 去 @ 并 LLVM 合法化
    g_pf_params = [];
    g_pf_ret = "void";
    var i: i64 = 2;
    var m: i64 = slice_len(toks) as i64;
    while (i < m) {
        if (toks[i] == ":") {
            g_pf_ret = toks[i + 1];
            break;
        }
        var p: string = toks[i];
        if (str_at(p, str_len(p) - 1) == 58) { p = str_slice(p, 0, str_len(p) - 1); }   // 去末尾 ':'
        append(g_pf_params, p);
        append(g_pf_params, toks[i + 1]);
        i = i + 2;
    }
}

pub fn ll_lookup_params(fname: string) []string {
    var i: i64 = 0;
    var n: i64 = slice_len(g_func_names) as i64;
    while (i < n) {
        if (g_func_names[i] == fname) { return g_func_paramsts[i]; }
        i = i + 1;
    }
    var __ll_empty: []string = [];
    return __ll_empty;
}

pub fn ll_emit_func(name: string, params: []string, ret: string) void {
    g_ll_curfn = name;
    g_ll_tmpc = 0;
    g_ll_names = [];
    g_ll_sts = [];
    append(g_ll_func_rets, ret);
    var sig: StringBuilder = sb_new();
    sb_append_str(sig, "define ");
    sb_append_str(sig, st_to_ll(ret));
    sb_append_str(sig, " @");
    // 入口函数（@main 标注）改名 @t.<name>，避免与下方补的 @main 包装器重名
    // （用户若把入口命名为 main，直接发 @main 会与包装器 @main 冲突：invalid redefinition）。
    if (g_has_main && name == g_main_fn) { sb_append_str(sig, "t."); }
    sb_append_str(sig, name);
    sb_append_str(sig, "(");
    var m: i64 = slice_len(params) as i64;
    var i: i64 = 0;
    var first: bool = true;
    while (i < m) {
        if (i + 1 >= m) { break; }
        var pname: string = params[i];
        var pst: string = params[i + 1];
        if (first == false) { sb_append_str(sig, ", "); }
        sb_append_str(sig, st_to_ll(pst));
        sb_append_str(sig, " ");
        sb_append_str(sig, ll_llname(pname));
        sb_append_str(sig, ".in");
        first = false;
        i = i + 2;
    }
    sb_append_str(sig, ") {\n");
    sb_append_str(g_ll, sb_to_str(sig));
    // 参数 alloca + store
    i = 0;
    while (i < m) {
        if (i + 1 >= m) { break; }
        var pname: string = params[i];
        var pst: string = params[i + 1];
        ll_ensure_slot(pname, pst);
        ll_set_st(pname, pst);
        sb_append_str(g_ll, "  store ");
        sb_append_str(g_ll, st_to_ll(pst));
        sb_append_str(g_ll, " ");
        sb_append_str(g_ll, ll_llname(pname));
        sb_append_str(g_ll, ".in, ptr ");
        sb_append_str(g_ll, ll_llname(pname));
        sb_append_str(g_ll, "\n");
        i = i + 2;
    }
}

// ── 内建降级（§4）：TIR 路径把高层内建（@println/@int_to_str/@sb_*…）桥接到 runtime 的 tll_*。
// TIR 前端给这些内建猜了错误的结果类型（多为 i64），翻译器在此按真实 ABI 重写：
//   - runtime 的 tll_* 一律按「指针传聚合」约定：TStr 参数 = TStr*（即 %TStr slot 的 alloca 指针），
//     故消费 %TStr 的内建直接把参数 slot 的 alloca 指针（ll_llname）传入，无需 GEP 取 data 指针。
//   - 返回 %TStr 的内建（int_to_str/sb_to_str/str_slice/str_concat）把 DST slot 直接当作 %TStr alloca，
//     作为 out 参数传给 tll_*，使下游以 %TStr 类型正确消费该 slot。
//   - 返回标量（i64/i32）的内建走 ll_store 写回 DST。
pub fn ll_emit_builtin(cn: string, toks: []string) bool {
    var d: string = toks[2];
    if (cn == "println" || cn == "print") {
        var ap: string = ll_llname(toks[4]);
        var rt: string = "tll_println";
        if (cn == "print") { rt = "tll_print"; }
        ll_maybe_declare(rt, "void", ["ptr"]);
        sb_append_str(g_ll, "  call void @");
        sb_append_str(g_ll, rt);
        sb_append_str(g_ll, "(ptr ");
        sb_append_str(g_ll, ap);
        sb_append_str(g_ll, ")\n");
        return true;
    }
    if (cn == "str_len") {
        var ap: string = ll_llname(toks[4]);
        ll_maybe_declare("tll_str_len", "i64", ["ptr"]);
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = call i64 @tll_str_len(ptr ");
        sb_append_str(g_ll, ap);
        sb_append_str(g_ll, ")\n");
        ll_ensure_slot(d, "i64"); ll_set_st(d, "i64"); ll_store(d, "i64", r);
        return true;
    }
    if (cn == "str_at") {
        var ap: string = ll_llname(toks[4]);
        var iv: string = ll_load(toks[5], "i64");
        ll_maybe_declare("tll_str_at", "i64", ["ptr", "i64"]);
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = call i64 @tll_str_at(ptr ");
        sb_append_str(g_ll, ap);
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, iv);
        sb_append_str(g_ll, ")\n");
        ll_ensure_slot(d, "i64"); ll_set_st(d, "i64"); ll_store(d, "i64", r);
        return true;
    }
    if (cn == "str_eq") {
        var ap: string = ll_llname(toks[4]);
        var bp: string = ll_llname(toks[5]);
        ll_maybe_declare("tll_str_eq", "i32", ["ptr", "ptr"]);
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = call i32 @tll_str_eq(ptr ");
        sb_append_str(g_ll, ap);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, bp);
        sb_append_str(g_ll, ")\n");
        ll_ensure_slot(d, "i32"); ll_set_st(d, "i32"); ll_store(d, "i32", r);
        return true;
    }
    if (cn == "slice_len") {
        var ap: string = ll_llname(toks[4]);
        ll_maybe_declare("tll_slice_len", "i64", ["ptr"]);
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = call i64 @tll_slice_len(ptr ");
        sb_append_str(g_ll, ap);
        sb_append_str(g_ll, ")\n");
        ll_ensure_slot(d, "i64"); ll_set_st(d, "i64"); ll_store(d, "i64", r);
        return true;
    }
    if (cn == "sb_new") {
        ll_maybe_declare("tll_sb_new", "ptr", []);
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = call ptr @tll_sb_new()\n");
        ll_ensure_slot(d, "ptr"); ll_set_st(d, "ptr"); ll_store(d, "ptr", r);
        return true;
    }
    if (cn == "sb_append_str") {
        var bp: string = ll_load(toks[4], "ptr");
        var ap: string = ll_llname(toks[5]);
        ll_maybe_declare("tll_sb_append_str", "void", ["ptr", "ptr"]);
        sb_append_str(g_ll, "  call void @tll_sb_append_str(ptr ");
        sb_append_str(g_ll, bp);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, ap);
        sb_append_str(g_ll, ")\n");
        return true;
    }
    if (cn == "sb_append_char") {
        var bp: string = ll_load(toks[4], "ptr");
        var iv: string = ll_load(toks[5], "i64");
        ll_maybe_declare("tll_sb_append_char", "void", ["ptr", "i64"]);
        sb_append_str(g_ll, "  call void @tll_sb_append_char(ptr ");
        sb_append_str(g_ll, bp);
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, iv);
        sb_append_str(g_ll, ")\n");
        return true;
    }
    if (cn == "sb_append_i64" || cn == "sb_append_u64") {
        var bp: string = ll_load(toks[4], "ptr");
        var iv: string = ll_load(toks[5], "i64");
        if (cn == "sb_append_i64") {
            ll_maybe_declare("tll_sb_append_i64", "void", ["ptr", "i64"]);
            sb_append_str(g_ll, "  call void @tll_sb_append_i64(ptr ");
        } else {
            ll_maybe_declare("tll_sb_append_u64", "void", ["ptr", "i64"]);
            sb_append_str(g_ll, "  call void @tll_sb_append_u64(ptr ");
        }
        sb_append_str(g_ll, bp);
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, iv);
        sb_append_str(g_ll, ")\n");
        return true;
    }
    if (cn == "sb_to_str") {
        var bp: string = ll_load(toks[4], "ptr");
        ll_ensure_slot(d, "%TStr"); ll_set_st(d, "%TStr");
        var outp: string = ll_llname(d);
        ll_maybe_declare("tll_sb_to_str", "void", ["ptr", "ptr"]);
        sb_append_str(g_ll, "  call void @tll_sb_to_str(ptr ");
        sb_append_str(g_ll, bp);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, outp);
        sb_append_str(g_ll, ")\n");
        return true;
    }
    if (cn == "int_to_str" || cn == "i2s") {
        var iv: string = ll_load(toks[4], "i64");
        ll_ensure_slot(d, "%TStr"); ll_set_st(d, "%TStr");
        var outp: string = ll_llname(d);
        ll_maybe_declare("tll_int_to_str", "void", ["i64", "ptr"]);
        sb_append_str(g_ll, "  call void @tll_int_to_str(i64 ");
        sb_append_str(g_ll, iv);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, outp);
        sb_append_str(g_ll, ")\n");
        return true;
    }
    if (cn == "str_slice") {
        var ap: string = ll_llname(toks[4]);
        var lo: string = ll_load(toks[5], "i64");
        var hi: string = ll_load(toks[6], "i64");
        ll_ensure_slot(d, "%TStr"); ll_set_st(d, "%TStr");
        var outp: string = ll_llname(d);
        ll_maybe_declare("tll_str_slice", "void", ["ptr", "i64", "i64", "ptr"]);
        sb_append_str(g_ll, "  call void @tll_str_slice(ptr ");
        sb_append_str(g_ll, ap);
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, lo);
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, hi);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, outp);
        sb_append_str(g_ll, ")\n");
        return true;
    }
    if (cn == "str_concat") {
        var ap: string = ll_llname(toks[4]);
        var bp: string = ll_llname(toks[5]);
        ll_ensure_slot(d, "%TStr"); ll_set_st(d, "%TStr");
        var outp: string = ll_llname(d);
        ll_maybe_declare("tll_str_concat", "void", ["ptr", "ptr", "ptr"]);
        sb_append_str(g_ll, "  call void @tll_str_concat(ptr ");
        sb_append_str(g_ll, ap);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, bp);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, outp);
        sb_append_str(g_ll, ")\n");
        return true;
    }
    // ── 直通重命名降级：TIR 已给出正确实参类型，仅缺 runtime 符号/返回类型 ──
    if (cn == "ti_size" || cn == "ti_kind" || cn == "ti_field_count" ||
        cn == "fi_offset" || cn == "fi_type_size" || cn == "fi_is_ptr") {
        var tlln: string = base.sb_cat2("tll_", cn);
        ll_maybe_declare(tlln, "i64", ["ptr"]);
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = call i64 @");
        sb_append_str(g_ll, tlln);
        sb_append_str(g_ll, "(ptr ");
        sb_append_str(g_ll, ll_llname_ptr(toks[4]));
        sb_append_str(g_ll, ")\n");
        ll_ensure_slot(d, "i64"); ll_set_st(d, "i64"); ll_store(d, "i64", r);
        return true;
    }
    if (cn == "map_len") {
        ll_maybe_declare("tll_map_len", "i64", ["ptr"]);
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = call i64 @tll_map_len(ptr ");
        sb_append_str(g_ll, ll_llname_ptr(toks[4]));
        sb_append_str(g_ll, ")\n");
        ll_ensure_slot(d, "i64"); ll_set_st(d, "i64"); ll_store(d, "i64", r);
        return true;
    }
    if (cn == "map_has") {
        ll_maybe_declare("tll_map_has", "i32", ["ptr", "ptr"]);
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = call i32 @tll_map_has(ptr ");
        sb_append_str(g_ll, ll_llname_ptr(toks[4]));
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, ll_llname(toks[5]));
        sb_append_str(g_ll, ")\n");
        ll_ensure_slot(d, "i32"); ll_set_st(d, "i32"); ll_store(d, "i32", r);
        return true;
    }
    if (cn == "map_new") {
        ll_maybe_declare("tll_map_new", "ptr", ["i64", "i64"]);
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = call ptr @tll_map_new(i64 ");
        sb_append_str(g_ll, ll_load(toks[4], "i64"));
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, ll_load(toks[5], "i64"));
        sb_append_str(g_ll, ")\n");
        ll_ensure_slot(d, "ptr"); ll_set_st(d, "ptr"); ll_store(d, "ptr", r);
        return true;
    }
    if (cn == "map_put" || cn == "map_del" || cn == "map_set") {
        var tlln: string = "tll_map_put";
        if (cn == "map_del") { tlln = "tll_map_del"; }
        ll_maybe_declare(tlln, "void", ["ptr", "ptr", "ptr"]);
        sb_append_str(g_ll, "  call void @");
        sb_append_str(g_ll, tlln);
        sb_append_str(g_ll, "(ptr ");
        sb_append_str(g_ll, ll_llname_ptr(toks[4]));
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, ll_llname(toks[5]));
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, ll_llname(toks[6]));
        sb_append_str(g_ll, ")\n");
        return true;
    }
    if (cn == "sym_release") {
        ll_maybe_declare("tll_sym_release", "void", ["ptr"]);
        sb_append_str(g_ll, "  call void @tll_sym_release(ptr ");
        sb_append_str(g_ll, ll_llname(toks[4]));
        sb_append_str(g_ll, ")\n");
        return true;
    }
    if (cn == "sym_release_all") {
        ll_maybe_declare("tll_sym_release_all", "void", []);
        sb_append_str(g_ll, "  call void @tll_sym_release_all()\n");
        return true;
    }
    if (cn == "unwrap") {
        ll_maybe_declare("tll_opt_unwrap", "ptr", ["ptr"]);
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = call ptr @tll_opt_unwrap(ptr ");
        sb_append_str(g_ll, ll_llname_ptr(toks[4]));
        sb_append_str(g_ll, ")\n");
        ll_ensure_slot(d, "ptr"); ll_set_st(d, "ptr"); ll_store(d, "ptr", r);
        return true;
    }
    // ── out 参数聚合返回：DST 直接作为 %TStr/%TSlice alloca 传给 tll_* ──
    // ⚠ 必须内联拼写 call：t 数组字面量末尾/中间 var 元素会被丢弃（见 _fix_tirll 记录），
    //    走 ll_call_void([..., var]) 会丢末参 → IR 非法。仿 map_get 直接 sb_append_str 构造。
    if (cn == "atom_str") {
        var idv: string = ll_load(toks[4], "i64");
        ll_ensure_slot(d, "%TStr"); ll_set_st(d, "%TStr");
        var outp: string = ll_llname(d);
        ll_maybe_declare("tll_atom_str", "void", ["i64", "ptr"]);
        sb_append_str(g_ll, "  call void @tll_atom_str(i64 ");
        sb_append_str(g_ll, idv);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, outp);
        sb_append_str(g_ll, ")\n");
        return true;
    }
    if (cn == "slice_sub") {
        var lo: string = ll_load(toks[5], "i64");
        var hi: string = ll_load(toks[6], "i64");
        ll_ensure_slot(d, "%TSlice"); ll_set_st(d, "%TSlice");
        var outp: string = ll_llname(d);
        ll_maybe_declare("tll_slice_sub", "void", ["ptr", "i64", "i64", "ptr"]);
        sb_append_str(g_ll, "  call void @tll_slice_sub(ptr ");
        sb_append_str(g_ll, ll_llname_ptr(toks[4]));
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, lo);
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, hi);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, outp);
        sb_append_str(g_ll, ")\n");
        return true;
    }
    // ── append：runtime t_slice_append 自切片元数据推断元素大小，返回 void；TIR 期望 i64，补 0 ──
    if (cn == "append") {
        ll_call_void("t_slice_append", ["ptr", "ptr"],
                     [ll_llname(toks[4]), ll_llname(toks[5])]);
        ll_ensure_slot(d, "i64"); ll_set_st(d, "i64"); ll_store(d, "i64", "0");
        return true;
    }
    // ── map_get：value 字节写入 dest 槽（%TStr 16B 足够覆盖 i64 标量）；
    //    返回 i32(found) 丢弃，d 保持 %TStr 承载取出的 value ──
    if (cn == "map_get") {
        var mp: string = ll_llname(toks[4]);
        var kp: string = ll_llname(toks[5]);
        ll_ensure_slot(d, "%TStr"); ll_set_st(d, "%TStr");
        var outp: string = ll_llname(d);
        ll_maybe_declare("tll_map_get", "i32", ["ptr", "ptr", "ptr"]);
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = call i32 @tll_map_get(ptr ");
        sb_append_str(g_ll, mp);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, kp);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, outp);
        sb_append_str(g_ll, ")\n");
        return true;
    }
    // ── 可选类型 ?T（可空指针模型）：some(x) 取 x 的地址作为 optional 指针 ──
    if (cn == "some") {
        var c0: string = toks[4];
        var pv: string;
        if (str_len(c0) >= 1 && (c0[0] == 36 || c0[0] == 64)) {
            pv = ll_llname(c0);   // $slot / @global → 其地址即聚合/标量的存放地址
        } else {
            var ns: string = ll_tmp();
            sb_append_str(g_ll, "  "); sb_append_str(g_ll, ns); sb_append_str(g_ll, " = alloca i64\n");
            sb_append_str(g_ll, "  store i64 "); sb_append_str(g_ll, c0); sb_append_str(g_ll, ", ptr ");
            sb_append_str(g_ll, ns); sb_append_str(g_ll, "\n");
            pv = ns;
        }
        var pi: string = ll_tmp();
        sb_append_str(g_ll, "  "); sb_append_str(g_ll, pi);
        sb_append_str(g_ll, " = ptrtoint ptr "); sb_append_str(g_ll, pv); sb_append_str(g_ll, " to i64\n");
        ll_ensure_slot(d, "i64"); ll_set_st(d, "i64"); ll_store(d, "i64", pi);
        return true;
    }
    if (cn == "is_some" || cn == "is_none") {
        var pv: string = ll_load(toks[4], "ptr");
        var pred: string = "ne";
        if (cn == "is_none") { pred = "eq"; }
        var cmp: string = ll_tmp();
        sb_append_str(g_ll, "  "); sb_append_str(g_ll, cmp);
        sb_append_str(g_ll, " = icmp "); sb_append_str(g_ll, pred);
        sb_append_str(g_ll, " ptr "); sb_append_str(g_ll, pv); sb_append_str(g_ll, ", null\n");
        var z: string = ll_tmp();
        sb_append_str(g_ll, "  "); sb_append_str(g_ll, z);
        sb_append_str(g_ll, " = zext i1 "); sb_append_str(g_ll, cmp); sb_append_str(g_ll, " to i64\n");
        ll_ensure_slot(d, "i64"); ll_set_st(d, "i64"); ll_store(d, "i64", z);
        return true;
    }
    // ── time_invalid：编译期宏 T_TIME_INVALID = INT64_MIN ──
    if (cn == "time_invalid") {
        ll_ensure_slot(d, "i64"); ll_set_st(d, "i64"); ll_store(d, "i64", "-9223372036854775808");
        return true;
    }
    // ── format_*：spec, value → TStr out ──
    if (cn == "format_int" || cn == "format_uint" || cn == "format_float" ||
        cn == "format_str" || cn == "format_bool" || cn == "format_char") {
        var fn2: string = base.sb_cat2("tll_", cn);
        var specp: string = ll_llname(toks[4]);
        var argv2: []string = [specp];
        var argsts2: []string = ["ptr"];
        if (cn == "format_str") { append(argv2, ll_llname(toks[5])); append(argsts2, "ptr"); }
        else if (cn == "format_bool") { append(argv2, ll_load(toks[5], "i8")); append(argsts2, "i8"); }
        else { append(argv2, ll_load(toks[5], "i64")); append(argsts2, "i64"); }
        append(argv2, ll_llname(d)); append(argsts2, "ptr");
        ll_ensure_slot(d, "%TStr"); ll_set_st(d, "%TStr");
        ll_call_void(fn2, argsts2, argv2);
        return true;
    }
    // ── parse_time / parse_time_local：spec, s, use_local → i64（正常返回，d 存 i64 结果）──
    if (cn == "parse_time" || cn == "parse_time_local") {
        var ul: string = "0";
        if (cn == "parse_time_local") { ul = "1"; } else { ul = ll_load(toks[6], "i64"); }
        ll_ensure_slot(d, "i64"); ll_set_st(d, "i64");
        var outp: string = ll_llname(d);
        ll_maybe_declare("tll_parse_time", "i64", ["ptr", "ptr", "i64"]);
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  "); sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = call i64 @tll_parse_time(ptr ");
        sb_append_str(g_ll, ll_llname(toks[4]));
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, ll_llname(toks[5]));
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, ul);
        sb_append_str(g_ll, ")\n");
        ll_store(d, "i64", r);
        return true;
    }
    // ── format_time / format_time_local / format_time_tz：spec, t, [tz] → TStr out ──
    if (cn == "format_time" || cn == "format_time_local") {
        var ul: string = "0";
        if (cn == "format_time_local") { ul = "1"; } else { ul = ll_load(toks[6], "i64"); }
        ll_ensure_slot(d, "%TStr"); ll_set_st(d, "%TStr");
        var outp: string = ll_llname(d);
        ll_maybe_declare("tll_format_time", "void", ["ptr", "i64", "i64", "ptr"]);
        sb_append_str(g_ll, "  call void @tll_format_time(ptr ");
        sb_append_str(g_ll, ll_llname(toks[4]));
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, ll_load(toks[5], "i64"));
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, ul);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, outp);
        sb_append_str(g_ll, ")\n");
        return true;
    }
    if (cn == "format_time_tz") {
        ll_ensure_slot(d, "%TStr"); ll_set_st(d, "%TStr");
        var outp: string = ll_llname(d);
        ll_maybe_declare("tll_format_time_tz", "void", ["ptr", "i64", "i64", "ptr"]);
        sb_append_str(g_ll, "  call void @tll_format_time_tz(ptr ");
        sb_append_str(g_ll, ll_llname(toks[4]));
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, ll_load(toks[5], "i64"));
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, ll_load(toks[6], "i64"));
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, outp);
        sb_append_str(g_ll, ")\n");
        return true;
    }
    // ── fid_error：f → TStr out ──
    if (cn == "fid_error") {
        ll_ensure_slot(d, "%TStr"); ll_set_st(d, "%TStr");
        ll_call_void("tll_fid_error", ["i64", "ptr"],
                     [ll_load(toks[4], "i64"), ll_llname(d)]);
        return true;
    }
    // ── fid_is_open / fid_eof：f → i32→i64 ──
    if (cn == "fid_is_open" || cn == "fid_eof") {
        var fn2: string = base.sb_cat2("tll_", cn);
        ll_call_ret(fn2, "i32", ["i64"], [ll_load(toks[4], "i64")], d);
        return true;
    }
    // ── file_read_all / path_resolve / getenv：path → TStr out ──
    if (cn == "file_read_all" || cn == "path_resolve" || cn == "getenv") {
        var fn2: string = "tll_getenv";
        if (cn == "file_read_all") { fn2 = "tll_file_read_all"; }
        else if (cn == "path_resolve") { fn2 = "tll_path_resolve"; }
        ll_ensure_slot(d, "%TStr"); ll_set_st(d, "%TStr");
        ll_call_void(fn2, ["ptr", "ptr"], [ll_llname(toks[4]), ll_llname(d)]);
        return true;
    }
    // ── fid_format：f, a_text, a_json, a_raw, a_pb → i64 ──
    if (cn == "fid_format") {
        ll_call_ret("tll_fid_format", "i64", ["i64", "i64", "i64", "i64", "i64"],
                    [ll_load(toks[4], "i64"), ll_load(toks[5], "i64"), ll_load(toks[6], "i64"),
                     ll_load(toks[7], "i64"), ll_load(toks[8], "i64")], d);
        return true;
    }
    // ── fopen / fclose / fseek / ftell / fmt_register ──
    if (cn == "fopen") {
        ll_call_ret("tll_fopen", "i64", ["ptr", "i32"],
                    [ll_llname(toks[4]), ll_load(toks[5], "i32")], d);
        return true;
    }
    if (cn == "fclose") {
        ll_call_void("tll_fclose", ["i64"], [ll_load(toks[4], "i64")]);
        return true;
    }
    if (cn == "fseek") {
        ll_call_ret("tll_fseek", "i32", ["i64", "i64"],
                    [ll_load(toks[4], "i64"), ll_load(toks[5], "i64")], d);
        return true;
    }
    if (cn == "ftell") {
        ll_call_ret("tll_ftell", "i64", ["i64"], [ll_load(toks[4], "i64")], d);
        return true;
    }
    if (cn == "fmt_register") {
        ll_call_void("tll_fmt_register", ["i32", "ptr", "i32"],
                     [ll_load(toks[4], "i32"), ll_llname(toks[5]), ll_load(toks[6], "i32")]);
        return true;
    }
    // ── ti_name / fi_name / fi_type_name：ti/fi → TStr out ──
    if (cn == "ti_name" || cn == "fi_name" || cn == "fi_type_name") {
        var fn2: string = base.sb_cat2("tll_", cn);
        ll_ensure_slot(d, "%TStr"); ll_set_st(d, "%TStr");
        ll_call_void(fn2, ["ptr", "ptr"], [ll_llname(toks[4]), ll_llname(d)]);
        return true;
    }
    // ── ti_field：ti, i → TFieldInfo* (ptr) ──
    if (cn == "ti_field") {
        ll_call_ret("tll_ti_field", "ptr", ["ptr", "i64"],
                    [ll_llname(toks[4]), ll_load(toks[5], "i64")], d);
        return true;
    }
    // ── fi_tag：fi → i64 ──
    if (cn == "fi_tag") {
        ll_call_ret("tll_fi_tag", "i64", ["ptr"], [ll_llname(toks[4])], d);
        return true;
    }
    // ── sb_append_fmt_*：void，忽略 i64 返回 ──
    if (ll_starts(cn, "sb_append_fmt")) {
        var fn2: string = base.sb_cat2("tll_", cn);
        var bp: string = ll_llname(toks[4]);
        var specp: string = ll_llname(toks[5]);
        var argv2: []string = [bp, specp];
        var argsts2: []string = ["ptr", "ptr"];
        if (cn == "sb_append_fmt_int" || cn == "sb_append_fmt_uint" || cn == "sb_append_fmt_char") {
            append(argv2, ll_load(toks[6], "i64")); append(argsts2, "i64");
        } else if (cn == "sb_append_fmt_float") {
            append(argv2, ll_load(toks[6], "double")); append(argsts2, "double");
        } else if (cn == "sb_append_fmt_bool") {
            append(argv2, ll_load(toks[6], "i8")); append(argsts2, "i8");
        } else if (cn == "sb_append_fmt_str") {
            append(argv2, ll_llname(toks[6])); append(argsts2, "ptr");
        } else if (cn == "sb_append_fmt_str_conv" || cn == "sb_append_fmt_int_conv" || cn == "sb_append_fmt_uint_conv") {
            append(argv2, ll_llname(toks[6])); append(argsts2, "ptr");
            append(argv2, ll_llname(toks[7])); append(argsts2, "ptr");
        } else if (cn == "sb_append_fmt_big") {
            append(argv2, ll_llname(toks[6])); append(argsts2, "ptr");
            append(argv2, ll_load(toks[7], "i64")); append(argsts2, "i64");
            append(argv2, ll_load(toks[8], "i8")); append(argsts2, "i8");
        }
        ll_call_void(fn2, argsts2, argv2);
        ll_ensure_slot(d, "i64"); ll_set_st(d, "i64"); ll_store(d, "i64", "0");
        return true;
    }
    // ── math__*：裸名 → t_math_<base>（f32 变体名以 f 结尾或 _f）──
    if (ll_starts(cn, "math__")) {
        var base2: string = str_slice(cn, 6, str_len(cn));
        var isf: bool = false;
        var L: i64 = str_len(base2);
        if (L >= 2 && str_at(base2, L - 2) == 95 && str_at(base2, L - 1) == 102) {
            base2 = base.sb_cat2(str_slice(base2, 0, L - 2), "f");
            isf = true;
        } else if (L >= 1 && str_at(base2, L - 1) == 102) {
            isf = true;
        }
        var ty: string = "double";
        if (isf) { ty = "float"; }
        if (base2 == "pow_i") {
            var a0: string = ll_load(toks[4], "double");
            var a1i: string = ll_load(toks[5], "i64");
            var a1: string = ll_tmp();
            sb_append_str(g_ll, "  "); sb_append_str(g_ll, a1);
            sb_append_str(g_ll, " = sitofp i64 "); sb_append_str(g_ll, a1i);
            sb_append_str(g_ll, " to double\n");
            ll_call_ret("t_math_pow", "double", ["double", "double"], [a0, a1], d);
            return true;
        }
        var fn2: string = base.sb_cat2("t_math_", base2);
        var argc: i64 = slice_len(toks) as i64 - 4;
        var argv2: []string = [];
        var argsts2: []string = [];
        var i: i64 = 0;
        while (i < argc) {
            var av: string = ll_load(toks[4 + i], "double");
            if (isf) {
                var fv: string = ll_tmp();
                sb_append_str(g_ll, "  "); sb_append_str(g_ll, fv);
                sb_append_str(g_ll, " = fptrunc double "); sb_append_str(g_ll, av);
                sb_append_str(g_ll, " to float\n");
                append(argv2, fv);
            } else {
                append(argv2, av);
            }
            append(argsts2, ty);
            i = i + 1;
        }
        ll_call_ret(fn2, ty, argsts2, argv2, d);
        return true;
    }
    return false;
}

pub fn ll_emit_inst(toks: []string) void {
    var m: i64 = slice_len(toks) as i64;
    if (m < 1) { return; }
    var op: string = toks[0];
    // ret / ret.void 仅 1 个 token（ret.void 或 ret 无操作数），须先于 m<2 守卫处理，
    // 否则 m<2 直接 return 会丢弃函数终止符，导致函数体缺 ret（clang 报 expected instruction opcode）
    if (op == "ret" || op == "ret.void") {
        if (op == "ret.void" || m < 3) {
            sb_append_str(g_ll, "  ret void\n");
        } else {
            var st: string = toks[1];
            var d: string = toks[2];
            var v: string = ll_load(d, st);
            sb_append_str(g_ll, "  ret ");
            sb_append_str(g_ll, st_to_ll(st));
            sb_append_str(g_ll, " ");
            sb_append_str(g_ll, v);
            sb_append_str(g_ll, "\n");
        }
        return;
    }
    if (m < 2) { return; }   // 防御：裸 '{' 等畸形行
    if (op == "slot") {
        ll_ensure_slot(toks[2], toks[1]);
        ll_set_st(toks[2], toks[1]);
        return;
    }
    if (op == "const.str") {
        // 字符串常量：分配 %TStr slot，并从 strings: 段对应的全局常量 @.tirll_tstr<idx> load 进来。
        // @.tirll_tstr<i> 在 ll_emit_string_globals 阶段发射（constant %TStr { ptr @.tirll_str<i>, i64 N }）。
        // 用 load+store 而非内联聚合，避免全局变量直接作为值引用（LLVM 要求全局引用是 pointer 类型）。
        var d: string = toks[1];
        ll_ensure_slot(d, "%TStr");
        ll_set_st(d, "%TStr");
        var gp: string = base.sb_cat2("@.tirll_tstr", toks[2]);
        var tmp: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, tmp);
        sb_append_str(g_ll, " = load %TStr, ptr ");
        sb_append_str(g_ll, gp);
        sb_append_str(g_ll, "\n");
        sb_append_str(g_ll, "  store %TStr ");
        sb_append_str(g_ll, tmp);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, ll_llname(d));
        sb_append_str(g_ll, "\n");
        return;
    }
    if (op == "const.ptr.null") {
        // 空指针常量：const.ptr.null <TYPE> <DST>  ->  DST 持有 null 指针
        var ty: string = toks[1];   // 形如 ptr<void> / ptr<X>
        var d: string = toks[2];
        ll_ensure_slot(d, "ptr");
        ll_set_st(d, "ptr");
        ll_store(d, "ptr", "null");
        return;
    }
    if (op == "const" || ll_starts(op, "const.")) {
        var st: string;
        var d: string;
        var imm: string;
        if (op == "const") {
            st = toks[1]; d = toks[2]; imm = toks[3];
        } else {
            st = str_slice(op, 6, str_len(op));   // const.i64 -> i64
            d = toks[1]; imm = toks[2];
        }
        var nimm: string = ll_norm_imm(imm, st);
        ll_ensure_slot(d, st);
        ll_set_st(d, st);
        ll_store(d, st, nimm);
        return;
    }
    if (op == "bitcast") {
        // TIR: `bitcast <DST_ST> <DST> <SRC_ST> <SRC>`。
        // opaque-pointer 模型下所有指针都是 `ptr`；TIR 类型信息仅用于 GEP 元素类型与 load/store 宽度，
        // 故 bitcast 一律在指针层面做，且尽量保留源的真实 pointee 类型（避免后续 GEP/load 丢失结构信息）：
        //   - 源是指针/聚合，目标被擦成 ptr<void>/ptr：保留源 pointee（如 ptr<%__env_0>），供结构体 GEP 使用；
        //   - 源是指针，目标是标量（切片数据指针 `bitcast i64 ptr<void>`）：还原为 ptr<i64>，使 gep_idx 能按标量索引；
        //   - 目标是聚合/命名类型（arr<TxN> / %TSlice 等）：bitcast 结果为 ptr，但 slot ST 记录原类型供导航。
        var dstst0: string = toks[1];
        var dst: string = toks[2];
        var srcst0: string = toks[3];
        var src: string = toks[4];
        var src_is_ptr: bool = ll_starts(srcst0, "ptr<") || srcst0 == "ptr" ||
                                ll_starts(srcst0, "arr<") || ll_starts(srcst0, "vec<");
        var dstst_eff: string = dstst0;
        if (src_is_ptr && ll_starts(dstst0, "ptr<") == false && ll_starts(dstst0, "%") == false && ll_is_scalar_st(dstst0)) {
            dstst_eff = base.sb_cat3("ptr<", dstst0, ">");   // 切片数据指针：i64 -> ptr<i64>
        }
        if (dstst0 == "ptr<void>" || dstst0 == "ptr") {
            dstst_eff = srcst0;                              // 保留源真实 pointee
        }
        var dll: string = st_to_ll(dstst_eff);
        if (ll_starts(dstst_eff, "arr<") || ll_starts(dstst_eff, "vec<") || ll_starts(dstst_eff, "%")) { dll = "ptr"; }
        // 源操作数：指针/聚合取地址（alloca 即 ptr），标量则 load 出值
        var sll: string = st_to_ll(srcst0);
        var srcv: string;
        if (src_is_ptr) {
            srcv = ll_llname_ptr(src);
        } else {
            if (ll_starts(sll, "%")) { sll = "i64"; }
            srcv = ll_load(src, sll);
        }
        var t: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, t);
        sb_append_str(g_ll, " = bitcast ");
        if (src_is_ptr) { sb_append_str(g_ll, "ptr "); } else { sb_append_str(g_ll, sll); }
        sb_append_str(g_ll, srcv);
        sb_append_str(g_ll, " to ");
        sb_append_str(g_ll, dll);
        sb_append_str(g_ll, "\n");
        // 聚合（arr<...>/vec<...>/%Struct）在 memory-first 模型下恒以指针表示：
        // bitcast 结果 t 是 ptr，槽类型也必须记 ptr，否则下游把 ptr 当作聚合值使用
        // （struct_new 字段 / gep_idx 基址 / 数组字面量存储）会生成
        // "ptr defined but expected [N x T]/%Struct" 的非法 IR（Cluster Y）。
        if (ll_starts(dstst_eff, "arr<") || ll_starts(dstst_eff, "vec<") || ll_starts(dstst_eff, "%")) {
            ll_ensure_slot(dst, "ptr");
            ll_set_st(dst, "ptr");
            ll_store(dst, "ptr", t);
        } else {
            ll_ensure_slot(dst, dstst_eff);
            ll_set_st(dst, dstst_eff);
            ll_store(dst, dstst_eff, t);
        }
        return;
    }
    if (op == "store") {
        var src: string = toks[1];
        var dst: string = toks[2];
        var dstst: string = ll_get_st(dst);
        if (ll_starts(dstst, "ptr<")) {
            var inner: string = ll_ptr_inner(dstst);
            var srcst: string = ll_get_st(src);
            if (srcst == inner) {
                // *dst = src  (store-through：$dst 承载指针，把 $src 写到该地址)
                var p: string = ll_load(dst, dstst);
                var v: string = ll_load(src, inner);
                sb_append_str(g_ll, "  store ");
                sb_append_str(g_ll, st_to_ll(inner));
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, v);
                sb_append_str(g_ll, ", ptr ");
                sb_append_str(g_ll, p);
                sb_append_str(g_ll, "\n");
            } else {
                // dst = src  (指针拷贝：$src 也是 ptr<X>)
                var v: string = ll_load(src, dstst);
                ll_store(dst, dstst, v);
            }
        } else {
            var vst: string = ll_get_st(src);
            if (str_len(dst) >= 1 && dst[0] == 64) {
                var gnm: string = str_slice(dst, 1, str_len(dst));
                if (ll_is_func(gnm) == false) { ll_register_global(gnm, vst); }
            }
            var v: string = ll_load(src, vst);
            ll_store(dst, vst, v);
        }
        return;
    }
    if (op == "load") {
        var st: string = toks[1];
        var d: string = toks[2];
        var addr: string = toks[3];
        ll_ensure_slot(d, st);
        ll_set_st(d, st);
        var pst: string = ll_get_st(addr);
        var p: string;
        // TIR `load ST $d $addr` 语义：把 $addr 视为「指向 ST 的地址」取出 ST。
        //  - 若 $addr 自身持有指针（ptr<X>/ptr，如 gep 结果、闭包字段）：先 load 出指针值，再解引用。
        //  - 若 $addr 持有普通值（i64 等）：memory-first 下其槽本身即地址，直接 `load ST, ptr %addr`
        //    读出其值；若仍按指针二次解引用会生成 `load ST, ptr <i64 值>` 非法 IR（Cluster X）。
        if (ll_starts(pst, "ptr<") || pst == "ptr") {
            p = ll_load(addr, pst);
        } else {
            p = ll_llname_ptr(addr);
        }
        var v: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, v);
        sb_append_str(g_ll, " = load ");
        sb_append_str(g_ll, st_to_ll(st));
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, p);
        sb_append_str(g_ll, "\n");
        ll_store(d, st, v);
        return;
    }
    if (op == "addr_of") {
        var st: string = toks[1];   // ptr<ST>
        var d: string = toks[2];
        var x: string = toks[3];
        if (str_len(x) >= 1 && x[0] == 64) { ll_register_global(str_slice(x, 1, str_len(x)), ll_ptr_inner(st)); }
        ll_ensure_slot(d, st);
        ll_set_st(d, st);
        // $x 是变量（alloca，LLVM 中即 ptr）或全局 @name（地址亦为 ptr）；取址结果一律为 ptr。
        // 故 store 源操作数类型必须是 ptr，而非 st_to_ll(st)（否则 %TStr 等聚合类型与 ptr 不匹配）。
        sb_append_str(g_ll, "  store ptr ");
        sb_append_str(g_ll, ll_llname_ptr(x));
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, ll_llname(d));
        sb_append_str(g_ll, "\n");
        return;
    }
    if (op == "gep") {
        var st: string = toks[1];
        var g: string = toks[2];
        var p: string = toks[3];
        ll_ensure_slot(g, base.sb_cat3("ptr<", st, ">"));
        ll_set_st(g, base.sb_cat3("ptr<", st, ">"));
        var pst: string = ll_get_st(p);
        // 基址类型分两种情形：
        //  - 指针型 ptr<X>：$p 是存放指针的临时量，GEP 基址取其指针值（load 出）
        //  - 值型 X（如 %TStr）：临时量本身就是 alloca 的地址，GEP 基址直接用该地址，
        //    元素类型即 X（struct 字段访问经此支持）
        var gtypename: string;
        var pv: string;
        if (ll_starts(pst, "ptr<")) {
            gtypename = ll_ptr_inner(pst);
            pv = ll_load(p, pst);
        } else {
            // 值型基址（%TStr / 被 bitcast 擦成 ptr 的指针）：GEP 元素类型即该值自身类型 st
            gtypename = st_to_ll(st);
            pv = ll_llname(p);
        }
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = getelementptr inbounds ");
        sb_append_str(g_ll, gtypename);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, pv);
        var k: i64 = 4;
        var m: i64 = slice_len(toks) as i64;
        while (k < m) {
            var gidx: string = toks[k];
            if (ll_starts(gidx, "$")) {
                var gist: string = ll_get_st(gidx);
                sb_append_str(g_ll, ", ");
                sb_append_str(g_ll, st_to_ll(gist));
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, ll_load(gidx, gist));
            } else {
                sb_append_str(g_ll, ", i32 ");
                sb_append_str(g_ll, gidx);
            }
            k = k + 1;
        }
        sb_append_str(g_ll, "\n");
        ll_store(g, base.sb_cat3("ptr<", st, ">"), r);
        return;
    }
    if (op == "struct_new") {
        // struct_new %Name $d ($f0 $f1 ...) ：按字段顺序构造具名聚合值
        var tyname: string = toks[1];          // "%Point"
        var d: string = toks[2];               // "$t1" 目标 slot
        var llt: string = st_to_ll(tyname);
        var ap: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, ap);
        sb_append_str(g_ll, " = alloca ");
        sb_append_str(g_ll, llt);
        sb_append_str(g_ll, "\n");
        var fi: i64 = 3;
        var fm: i64 = slice_len(toks) as i64;
        while (fi < fm) {
            var fs: string = toks[fi];
            var fst: string = ll_get_st(fs);
            var fv: string = ll_load(fs, fst);
            var gp: string = ll_tmp();
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, gp);
            sb_append_str(g_ll, " = getelementptr inbounds ");
            sb_append_str(g_ll, llt);
            sb_append_str(g_ll, ", ptr ");
            sb_append_str(g_ll, ap);
            sb_append_str(g_ll, ", i32 0, i32 ");
            sb_append_str(g_ll, base.i2s(fi - 3));
            sb_append_str(g_ll, "\n");
            sb_append_str(g_ll, "  store ");
            sb_append_str(g_ll, st_to_ll(fst));
            sb_append_str(g_ll, " ");
            sb_append_str(g_ll, fv);
            sb_append_str(g_ll, ", ptr ");
            sb_append_str(g_ll, gp);
            sb_append_str(g_ll, "\n");
            fi = fi + 1;
        }
        // 聚合变量本质为 alloca（指针）。结构体不能按值 load，数组按值 load 合法；
        // 统一让 $d 承载该地址指针，避免对结构体做非法 load（且下游 load/store 一致走指针语义）。
        ll_ensure_slot(d, base.sb_cat3("ptr<", tyname, ">"));
        ll_set_st(d, base.sb_cat3("ptr<", tyname, ">"));
        sb_append_str(g_ll, "  store ptr ");
        sb_append_str(g_ll, ap);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, ll_llname(d));
        sb_append_str(g_ll, "\n");
        return;
    }
    if (op == "call") {
        var st: string = toks[1];
        var d: string = toks[2];
        var callee: string = toks[3];
        var is_indirect: bool = (str_len(callee) >= 1 && callee[0] == 36);  // '$' -> 函数指针间接调用，不加 @
        var fname: string = ll_llname(callee);   // "@add" -> "add" ; "$t12" -> "%curfn.t12"
        if (ll_emit_builtin(fname, toks)) { return; }   // §4 内建降级优先于通用函数调用
        var m: i64 = slice_len(toks) as i64;
        var k: i64 = 4;
        var argsb: StringBuilder = sb_new();
        var declargs: []string = [];
        var first: bool = true;
        while (k < m) {
            var a: string = toks[k];
            if (str_len(a) >= 1 && a[0] == 64) {
                // @fn 全局函数引用实参：本身即指针值，类型恒为 ptr（tir 未包装成闭包时的兜底）
                if (first == false) { sb_append_str(argsb, ", "); }
                sb_append_str(argsb, "ptr ");
                sb_append_str(argsb, ll_load(a, "ptr<void>"));
                append(declargs, "ptr<void>");
                first = false;
                k = k + 1;
                continue;
            }
            var ast: string = ll_get_st(a);   // 用实参槽真实类型（比签名更准）
            var v: string = ll_load(a, ast);
            if (first == false) { sb_append_str(argsb, ", "); }
            sb_append_str(argsb, st_to_ll(ast));
            sb_append_str(argsb, " ");
            sb_append_str(argsb, v);
            append(declargs, ast);
            first = false;
            k = k + 1;
        }
        if (is_indirect) {
            // 间接调用：callee 是持有函数指针的变量（$sum_vals.m / $main.t56 等闭包/方法变量）。
            // 该变量是局部寄存器（opaque ptr 值），直接 load 出函数指针，由 call 指令语法
            // 提供函数签名间接调用即可；LLVM opaque-pointer 下 `ptr(void,...)` 等函数指针类型
            // 非法（void 不允许出现在函数类型里），故不做 bitcast。此路径按指针调用，无需 declare 符号。
            var fpv: string = ll_load(callee, ll_get_st(callee));
            if (st == "void") {
                sb_append_str(g_ll, "  call void ");
                sb_append_str(g_ll, fpv);
                sb_append_str(g_ll, "(");
                sb_append_str(g_ll, sb_to_str(argsb));
                sb_append_str(g_ll, ")\n");
                return;
            }
            var r: string = ll_tmp();
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, r);
            sb_append_str(g_ll, " = call ");
            sb_append_str(g_ll, st_to_ll(st));
            sb_append_str(g_ll, " ");
            sb_append_str(g_ll, fpv);
            sb_append_str(g_ll, "(");
            sb_append_str(g_ll, sb_to_str(argsb));
            sb_append_str(g_ll, ")\n");
            ll_ensure_slot(d, st);
            ll_set_st(d, st);
            ll_store(d, st, r);
            return;
        }
        // 直接调用：callee 为 @funcname（或 %funcname，剥 % 兜底）
        if (str_len(fname) >= 1 && fname[0] == 37) {
            fname = ll_mangle(str_slice(fname, 1, str_len(fname)));
        }
        ll_maybe_declare(fname, st, declargs);
        if (st == "void") {
            sb_append_str(g_ll, "  call void @");
            sb_append_str(g_ll, fname);
            sb_append_str(g_ll, "(");
            sb_append_str(g_ll, sb_to_str(argsb));
            sb_append_str(g_ll, ")\n");
            return;
        }
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = call ");
        sb_append_str(g_ll, st_to_ll(st));
        sb_append_str(g_ll, " @");
        sb_append_str(g_ll, fname);
        sb_append_str(g_ll, "(");
        sb_append_str(g_ll, sb_to_str(argsb));
        sb_append_str(g_ll, ")\n");
        ll_ensure_slot(d, st);
        ll_set_st(d, st);
        ll_store(d, st, r);
        return;
    }
    if (op == "call_ind") {
        // 间接/闭包调用：函数值是指向 %TClosure { ptr code; ptr env } 的指针。
        // 约定（与 legacy codegen_ll / FuncType 一致）：真实函数签名为 Ret (ptr env, Args...)，
        // env 作首参由本处理器从闭包结构提取并前置。
        var st: string = toks[1];
        var d: string = toks[2];
        var fp: string = ll_llname(toks[3]);   // 闭包指针（ptr<void> 擦除）
        var g0: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, g0);
        sb_append_str(g_ll, " = getelementptr inbounds %TClosure, ptr ");
        sb_append_str(g_ll, fp);
        sb_append_str(g_ll, ", i32 0, i32 0\n");
        var code: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, code);
        sb_append_str(g_ll, " = load ptr, ptr ");
        sb_append_str(g_ll, g0);
        sb_append_str(g_ll, "\n");
        var g1: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, g1);
        sb_append_str(g_ll, " = getelementptr inbounds %TClosure, ptr ");
        sb_append_str(g_ll, fp);
        sb_append_str(g_ll, ", i32 0, i32 1\n");
        var env: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, env);
        sb_append_str(g_ll, " = load ptr, ptr ");
        sb_append_str(g_ll, g1);
        sb_append_str(g_ll, "\n");
        var m: i64 = slice_len(toks) as i64;
        var k: i64 = 4;
        var argsb: StringBuilder = sb_new();
        sb_append_str(argsb, "ptr ");
        sb_append_str(argsb, env);
        while (k < m) {
            var a: string = toks[k];
            if (a == "(" || a == ")") { k = k + 1; continue; }
            if (str_len(a) >= 1 && a[0] == 64) {
                // @fn 全局函数引用实参：本身即指针值，类型恒为 ptr
                sb_append_str(argsb, ", ptr ");
                sb_append_str(argsb, ll_load(a, "ptr<void>"));
                k = k + 1;
                continue;
            }
            var ast: string = ll_get_st(a);
            var v: string = ll_load(a, ast);
            sb_append_str(argsb, ", ");
            sb_append_str(argsb, st_to_ll(ast));
            sb_append_str(argsb, " ");
            sb_append_str(argsb, v);
            k = k + 1;
        }
        if (st == "void") {
            sb_append_str(g_ll, "  call void ");
            sb_append_str(g_ll, code);
            sb_append_str(g_ll, "(");
            sb_append_str(g_ll, sb_to_str(argsb));
            sb_append_str(g_ll, ")\n");
            return;
        }
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = call ");
        sb_append_str(g_ll, st_to_ll(st));
        sb_append_str(g_ll, " ");
        sb_append_str(g_ll, code);
        sb_append_str(g_ll, "(");
        sb_append_str(g_ll, sb_to_str(argsb));
        sb_append_str(g_ll, ")\n");
        ll_ensure_slot(d, st);
        ll_set_st(d, st);
        ll_store(d, st, r);
        return;
    }
    if (op == "br") {
        sb_append_str(g_ll, "  br label %");
        sb_append_str(g_ll, ll_label(toks[1]));
        sb_append_str(g_ll, "\n");
        return;
    }
    if (op == "br_cond") {
        var c: string = toks[1];
        var l1: string = toks[2];
        var l2: string = toks[3];
        var cst: string = ll_get_st(c);
        var cv: string = ll_load(c, cst);
        if (cst != "i1") {
            var t: string = ll_tmp();
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, t);
            sb_append_str(g_ll, " = icmp ne ");
            sb_append_str(g_ll, st_to_ll(cst));
            sb_append_str(g_ll, " ");
            sb_append_str(g_ll, cv);
            sb_append_str(g_ll, ", 0\n");
            cv = t;
        }
        sb_append_str(g_ll, "  br i1 ");
        sb_append_str(g_ll, cv);
        sb_append_str(g_ll, ", label %");
        sb_append_str(g_ll, ll_label(l1));
        sb_append_str(g_ll, ", label %");
        sb_append_str(g_ll, ll_label(l2));
        sb_append_str(g_ll, "\n");
        return;
    }
    if (op == "block") {
        sb_append_str(g_ll, ll_label(toks[1]));
        sb_append_str(g_ll, ":\n");
        return;
    }
    // 类型转换：trunc/zext/sext/fpext/sitofp/uitofp/fptosi/fptoui
    // 布局 OP DST_ST $d SRC_ST $s  ->  LLVM: %d = OP SRC_ST $s to DST_ST
    if (op == "trunc" || op == "zext" || op == "sext" || op == "fpext" ||
        op == "sitofp" || op == "uitofp" || op == "fptosi" || op == "fptoui") {
        var dstst: string = toks[1];
        var d: string = toks[2];
        var srcst: string = toks[3];
        var s: string = toks[4];
        var sv: string = ll_load(s, srcst);
        if (st_to_ll(srcst) == st_to_ll(dstst)) {
            // 无操作转换（如 zext i64->i64、i32->i32）：源与目标 LLVM 类型相同，直接复制值，
            // 避免生成非法的 `zext i64 to i64` / `trunc i32 to i32` 等 cast（clang 报 invalid cast opcode）。
            ll_ensure_slot(d, dstst);
            ll_set_st(d, dstst);
            ll_store(d, dstst, sv);
            return;
        }
        ll_ensure_slot(d, dstst);
        ll_set_st(d, dstst);
        var r: string = ll_tmp();
        // trunc 是泛型窄化：按类型派生真正的 LLVM cast 助记符
        var llvmop: string = op;
        if (op == "trunc") {
            if (ll_is_float(srcst) && ll_is_float(dstst)) { llvmop = "fptrunc"; }
            else if (ll_is_float(srcst) && ll_is_int(dstst)) { llvmop = "fptosi"; }
            else if (ll_is_int(srcst) && ll_is_float(dstst)) { llvmop = "sitofp"; }
            else { llvmop = "trunc"; }
        } else if (op == "zext" || op == "sext") {
            // 浮点间扩宽（f32→f64）走 fpext，而非整数的 zext/sext
            if (ll_is_float(srcst) && ll_is_float(dstst)) { llvmop = "fpext"; }
            // 防御：zext/sext 源类型须为整数标量。前端在 map 索引降级时偶发对聚合类型
            // （如 %TStr 键）误插一条 zext（结果 $d 从未被使用），该指令在 LLVM 中非法；
            // 仅当源为结构体聚合类型时丢弃之。命名标量类型（%Perm 等底层 i64）仍合法保留。
            if (ll_is_struct_type(srcst)) { return; }
        }
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = ");
        sb_append_str(g_ll, llvmop);
        sb_append_str(g_ll, " ");
        sb_append_str(g_ll, st_to_ll(srcst));
        sb_append_str(g_ll, " ");
        sb_append_str(g_ll, sv);
        sb_append_str(g_ll, " to ");
        sb_append_str(g_ll, st_to_ll(dstst));
        sb_append_str(g_ll, "\n");
        ll_store(d, dstst, r);
        return;
    }
    // 二元 / 比较：op.ST $d $a $b  （算术用点 add.i64；比较用无点 slti64）
    var o: string;
    var st: string;
    var dot: i64 = ll_find(op, ".");
    if (dot >= 0) {
        o = str_slice(op, 0, dot);
        st = str_slice(op, dot + 1, str_len(op));
    } else {
        var pre: string = ll_cmp_prefix(op);
        if (str_len(pre) > 0) { o = pre; st = str_slice(op, str_len(pre), str_len(op)); }
        else { o = op; st = "i64"; }
    }
    // 字符串拼接：add.%TStr $d $a $b -> call void @tll_str_concat(ptr $d, ptr $a, ptr $b)
    // （与 codegen_ll 一致：字符串聚合按指针传，dst 走末位 out 指针；tir.tc 把 TStr + 降级为 add.%TStr）
    if (st == "%TStr" && o == "add") {
        var d: string = toks[1];
        var a: string = toks[2];
        var b: string = toks[3];
        ll_ensure_slot(d, "%TStr");
        ll_set_st(d, "%TStr");
        var decl_args: []string = ["ptr", "ptr", "ptr"];
        ll_maybe_declare("tll_str_concat", "void", decl_args);
        sb_append_str(g_ll, "  call void @tll_str_concat(ptr ");
        sb_append_str(g_ll, ll_llname(d));
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, ll_llname(a));
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, ll_llname(b));
        sb_append_str(g_ll, ")\n");
        return;
    }
    // 字符串相等比较：eq.%TStr / ne.%TStr → 调 tll_str_eq（返回 i32，非 0 为真）
    // 其余构造的 struct 比较暂未支持（需 memcmp 降级），与 legacy codegen_ll 仅特判字符串一致。
    if ((o == "eq" || o == "ne") && st == "%TStr") {
        var d: string = toks[1];
        var a: string = toks[2];
        var b: string = toks[3];
        var da: string = ll_llname(a);   // 槽地址（ptr），tll_str_eq 收 TStr*
        var db: string = ll_llname(b);
        ll_maybe_declare("tll_str_eq", "i32", ["ptr", "ptr"]);
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = call i32 @tll_str_eq(ptr ");
        sb_append_str(g_ll, da);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, db);
        sb_append_str(g_ll, ")\n");
        var b1: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, b1);
        sb_append_str(g_ll, " = icmp ne i32 ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, ", 0\n");
        ll_ensure_slot(d, "i1");
        ll_set_st(d, "i1");
        ll_store(d, "i1", b1);
        return;
    }
    if (o == "slt" || o == "sgt" || o == "sge" || o == "sle" || o == "ult" || o == "ugt" ||
        o == "ule" || o == "uge" || o == "eq" || o == "ne") {
        var d: string = toks[1];
        var a: string = toks[2];
        var b: string = toks[3];
        var da: string = ll_load(a, st);
        var db: string = ll_load(b, st);
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = ");
        if (ll_is_float(st)) {
            sb_append_str(g_ll, "fcmp ");
            sb_append_str(g_ll, ll_fcmp(o));
        } else {
            sb_append_str(g_ll, "icmp ");
            sb_append_str(g_ll, ll_icmp(o));
        }
        sb_append_str(g_ll, " ");
        sb_append_str(g_ll, st_to_ll(st));
        sb_append_str(g_ll, " ");
        sb_append_str(g_ll, da);
        sb_append_str(g_ll, ", ");
        sb_append_str(g_ll, db);
        sb_append_str(g_ll, "\n");
        ll_ensure_slot(d, "i1");
        ll_set_st(d, "i1");
        ll_store(d, "i1", r);
        return;
    }
    // 一元运算：not / lnot（逻辑非）、neg（取负）。TIR 形态 op.ST $d $a（仅 3 token），
    // 须先于普通二元处理，否则下方 toks[3] 越界 panic。语义对齐 legacy codegen_ll。
    if (o == "not" || o == "lnot") {
        var d: string = toks[1];
        var a: string = toks[2];
        var da: string = ll_load(a, st);
        var r1: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r1);
        sb_append_str(g_ll, " = icmp eq ");
        sb_append_str(g_ll, st_to_ll(st));
        sb_append_str(g_ll, " ");
        sb_append_str(g_ll, da);
        sb_append_str(g_ll, ", 0\n");
        var r2: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r2);
        sb_append_str(g_ll, " = zext i1 ");
        sb_append_str(g_ll, r1);
        sb_append_str(g_ll, " to ");
        sb_append_str(g_ll, st_to_ll(st));
        sb_append_str(g_ll, "\n");
        ll_ensure_slot(d, st);
        ll_set_st(d, st);
        ll_store(d, st, r2);
        return;
    }
    if (o == "neg") {
        var d: string = toks[1];
        var a: string = toks[2];
        var da: string = ll_load(a, st);
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = ");
        if (ll_is_float(st)) { sb_append_str(g_ll, "fneg "); }
        else { sb_append_str(g_ll, "sub "); }
        sb_append_str(g_ll, st_to_ll(st));
        sb_append_str(g_ll, " ");
        if (ll_is_float(st)) {
            sb_append_str(g_ll, da);
        } else {
            sb_append_str(g_ll, "0, ");
            sb_append_str(g_ll, da);
        }
        sb_append_str(g_ll, "\n");
        ll_ensure_slot(d, st);
        ll_set_st(d, st);
        ll_store(d, st, r);
        return;
    }
    // 数组/切片元素索引：gep_idx <ST> <DST> <BASE> <IDX>
    // BASE 为指向数组/切片的指针（ptr<void> / ptr<X> / ptr<arr<...>>），生成
    //   getelementptr inbounds <ST>, ptr %base, i64 %idx
    // 结果 ST 记录为 ptr<ST>，供后续 load/store 使用。
    if (op == "gep_idx") {
        var st: string = toks[1];
        var d: string = toks[2];
        var base: string = toks[3];
        var idx: string = toks[4];
        var dstst: string = base.sb_cat3("ptr<", st, ">");
        ll_ensure_slot(d, dstst);
        ll_set_st(d, dstst);
        var pst: string = ll_get_st(base);
        var p: string;
        if (ll_starts(pst, "ptr<") || pst == "ptr") {
            p = ll_load(base, pst);
        } else {
            p = ll_llname_ptr(base);
        }
        var ist: string = ll_get_st(idx);
        var iv: string = ll_load(idx, ist);
        // GEP 第二索引必须是 i64。窄整数索引（i32/u32 等）zext 到 i64；但 u64/i64 经 st_to_ll 已是 i64，
        // 若按 TIR 类型字面比较会误判为需要 cast，生成非法的 `zext i64 to i64`。故比较 LLVM 翻译后的类型。
        if (ll_is_int(ist) && st_to_ll(ist) != "i64") {
            var iv64: string = ll_tmp();
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, iv64);
            sb_append_str(g_ll, " = zext ");
            sb_append_str(g_ll, st_to_ll(ist));
            sb_append_str(g_ll, " ");
            sb_append_str(g_ll, iv);
            sb_append_str(g_ll, " to i64\n");
            iv = iv64;
        }
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = getelementptr inbounds ");
        sb_append_str(g_ll, st_to_ll(st));
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, p);
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, iv);
        sb_append_str(g_ll, "\n");
        ll_store(d, dstst, r);
        return;
    }
    // 普通二元（整数/浮点统一）
    var d: string = toks[1];
    var a: string = toks[2];
    var b: string = toks[3];
    var da: string = ll_load(a, st);
    var db: string = ll_load(b, st);
    var r: string = ll_tmp();
    sb_append_str(g_ll, "  ");
    sb_append_str(g_ll, r);
    sb_append_str(g_ll, " = ");
    if (ll_is_float(st)) {
        sb_append_str(g_ll, ll_fbinop(o));
    } else {
        sb_append_str(g_ll, ll_binop(o));
    }
    sb_append_str(g_ll, " ");
    sb_append_str(g_ll, st_to_ll(st));
    sb_append_str(g_ll, " ");
    sb_append_str(g_ll, da);
    sb_append_str(g_ll, ", ");
    sb_append_str(g_ll, db);
    sb_append_str(g_ll, "\n");
    ll_ensure_slot(d, st);
    ll_set_st(d, st);
    ll_store(d, st, r);
}

// ── 文本扫描辅助 ─────────────────────────────────────────────────
pub fn ll_split_lines(text: string) []string {
    var out: []string = [];
    var cur: StringBuilder = sb_new();
    var n: i64 = str_len(text);
    var i: i64 = 0;
    while (i < n) {
        var c: i64 = str_at(text, i);
        if (c == 10) {   // '\n'
            append(out, sb_to_str(cur));
            cur = sb_new();
        } else if (c != 13) {   // skip '\r'
            sb_append_char(cur, c);
        }
        i = i + 1;
    }
    if (str_len(sb_to_str(cur)) > 0) { append(out, sb_to_str(cur)); }
    return out;
}

pub fn ll_trim(s: string) string {
    var n: i64 = str_len(s);
    var i: i64 = 0;
    while (i < n) {
        var c: i64 = str_at(s, i);
        if (c != 32 && c != 9) { break; }
        i = i + 1;
    }
    var j: i64 = n;
    while (j > i) {
        var c: i64 = str_at(s, j - 1);
        if (c == 32 || c == 9) { j = j - 1; } else { break; }
    }
    return str_slice(s, i, j);
}

pub fn ll_emit_type_line(line: string) void {
    var eq: i64 = ll_find(line, " = struct {");
    if (eq < 0) { return; }
    var name: string = ll_trim(str_slice(line, 0, eq));
    // 记录已在 types: 段声明为 struct 的命名类型，供 ll_register_named_type 跳过（避免误判为 i64 标量）。
    var sn: i64 = slice_len(g_ll_struct_types) as i64;
    var si: i64 = 0;
    var sseen: bool = false;
    while (si < sn) { if (g_ll_struct_types[si] == name) { sseen = true; break; } si = si + 1; }
    if (sseen == false) { append(g_ll_struct_types, name); }
    var lbrace: i64 = ll_find(line, "{");
    var rbrace: i64 = ll_find(line, "}");
    if (lbrace < 0 || rbrace < 0) { return; }
    var inner: string = ll_trim(str_slice(line, lbrace + 1, rbrace));
    var fields: StringBuilder = sb_new();
    var cur: StringBuilder = sb_new();
    var first: bool = true;
    var m: i64 = str_len(inner);
    var i: i64 = 0;
    while (i < m) {
        var c: i64 = str_at(inner, i);
        if (c == 44) {   // ','
            if (first == false) { sb_append_str(fields, ", "); }
            sb_append_str(fields, st_to_ll(ll_trim(sb_to_str(cur))));
            cur = sb_new();
            first = false;
        } else if (c == 58) {   // ':' 跳过字段名 (f0:)
            cur = sb_new();
        } else {
            sb_append_char(cur, c);
        }
        i = i + 1;
    }
    if (first == false) { sb_append_str(fields, ", "); }
    sb_append_str(fields, st_to_ll(ll_trim(sb_to_str(cur))));
    sb_append_str(g_ll, name);
    sb_append_str(g_ll, " = type { ");
    sb_append_str(g_ll, sb_to_str(fields));
    sb_append_str(g_ll, " }\n");
}

// 为 TIR 引用但未在 types: 段内联定义的运行时结构类型（如 %TSb）补 opaque 定义；
// 与外部函数 declare 同理——链接器再解析真实布局。类型名均以大写 T 起头（%TStr 等）。
pub fn ll_emit_opaque_defs() void {
    var text: string = sb_to_str(g_ll);
    var n: i64 = str_len(text);
    var i: i64 = 0;
    var buf: StringBuilder = sb_new();
    while (i < n) {
        var c: i64 = str_at(text, i);
        if (c == 37 && (i + 1) < n && str_at(text, i + 1) == 84) {   // '%' + 'T'
            var j: i64 = i + 2;
            while (j < n) {
                var d: i64 = str_at(text, j);
                if ((d >= 65 && d <= 90) || (d >= 97 && d <= 122) || (d >= 48 && d <= 57) || d == 95) { j = j + 1; }
                else { break; }
            }
            var name: string = str_slice(text, i + 1, j);   // 含 'T'，如 "TSb"
            var seen: bool = false;
            var k: i64 = 0;
            var km: i64 = slice_len(g_opaque_emitted) as i64;
            while (k < km) {
                if (g_opaque_emitted[k] == name) { seen = true; break; }
                k = k + 1;
            }
            if (seen == false) {
                var pat: string = base.sb_cat3("%", name, " = type");
                if (ll_find(sb_to_str(g_ll), pat) < 0) {
                    sb_append_str(buf, "%");
                    sb_append_str(buf, name);
                    sb_append_str(buf, " = type opaque\n");
                    append(g_opaque_emitted, name);
                }
            }
            i = j;
        } else {
            i = i + 1;
        }
    }
    var old: string = sb_to_str(g_ll);
    g_ll = sb_new();
    sb_append_str(g_ll, sb_to_str(buf));
    sb_append_str(g_ll, old);
}

// 发射 TIR strings: 段里每个字面量为 LLVM 全局常量：
//   @.tirll_str<i>  = constant [N x i8] c"<esc>"   （tir_esc 的 \XX 转义本就是合法 LLVM c"" 内容）
//   @.tirll_tstr<i> = constant %TStr { ptr @.tirll_str<i>, i64 N }
// const.str $tN <i> 随后直接 `store %TStr @.tirll_tstr<i>, ptr %curfn.tN`，使字符串字面量承载真实数据。
pub fn ll_emit_string_globals() void {
    var i: i64 = 0;
    var n: i64 = slice_len(g_str_table) as i64;
    while (i < n) {
        var content: string = g_str_table[i];          // tir_esc 形式（\XX 合法 LLVM c"" 内容）
        var blen: i64 = 0;
        var cn: i64 = str_len(content);
        var ci: i64 = 0;
        while (ci < cn) {                              // 计算原始字节长度（\XX 记 1 字节）
            if (str_at(content, ci) == 92) { ci = ci + 3; } else { ci = ci + 1; }
            blen = blen + 1;
        }
        sb_append_str(g_ll, "@.tirll_str");
        sb_append_i64(g_ll, i);
        sb_append_str(g_ll, " = private unnamed_addr constant [");
        sb_append_i64(g_ll, blen);
        sb_append_str(g_ll, " x i8] c\"");
        sb_append_str(g_ll, content);
        sb_append_str(g_ll, "\", align 1\n");
        sb_append_str(g_ll, "@.tirll_tstr");
        sb_append_i64(g_ll, i);
        sb_append_str(g_ll, " = constant %TStr { ptr @.tirll_str");
        sb_append_i64(g_ll, i);
        sb_append_str(g_ll, ", i64 ");
        sb_append_i64(g_ll, blen);
        sb_append_str(g_ll, " }\n");
        i = i + 1;
    }
}

// 主入口：消费 tir.tir_to_text() 文本，产出 .ll 文本
pub fn tir_to_ll_translate(text: string) string {
    ll_reset();
    var lines: []string = ll_split_lines(text);
    var n: i64 = slice_len(lines) as i64;
    // 第 1 遍：收集函数签名 + 发射 TT 类型
    var k: i64 = 0;
    while (k < n) {
        var line: string = lines[k];
        var toks: []string = ll_tokens(line);
        var m: i64 = slice_len(toks) as i64;
        if (m == 0) { k = k + 1; continue; }
        if (toks[0] == "globals:") { g_in_globals = true; k = k + 1; continue; }
        if (g_in_globals) {
            // globals: 段内每行 "@name ST"（或 "name ST"），收集用于 emit 全局声明
            if (toks[0] == "func" || toks[0] == "types:" || toks[0] == "strings:" || toks[0] == "module" || toks[0] == "source:") {
                g_in_globals = false;
            } else {
                var gnm: string = toks[0];
                if (str_len(gnm) >= 1 && gnm[0] == 64) { gnm = str_slice(gnm, 1, str_len(gnm)); }
                append(g_ll_globals, gnm);
                append(g_ll_globalsts, toks[1]);
                ll_set_st("@" + gnm, toks[1]);   // 注册全局类型，供 store/load 目标类型推断
                k = k + 1;
                continue;
            }
        }
        if (toks[0] == "strings:") { g_in_strings = true; k = k + 1; continue; }
        if (g_in_strings) {
            if (toks[0] == "func" || toks[0] == "types:" || toks[0] == "module" ||
                toks[0] == "source:" || toks[0] == "globals:") {
                g_in_strings = false;   // 段结束，交给后续正常处理（不 continue）
            } else {
                // "  N: \"content\"" —— 取首 ':' 之后、最外一对双引号之间的内容
                var ci: i64 = ll_find(line, ":");
                if (ci >= 0) {
                    var rest: string = str_slice(line, ci + 1, str_len(line));
                    var q1: i64 = ll_find(rest, "\"");
                    if (q1 >= 0) {
                        var q2: i64 = ll_rfind(rest, "\"");
                        if (q2 > q1) {
                            var content: string = str_slice(rest, q1 + 1, q2);
                            append(g_str_table, content);
                        }
                    }
                }
                k = k + 1; continue;
            }
        }
        if (toks[0] == "func") {
            ll_parse_func(line);
            // 入口函数检测：tir.tc 对 @main 标注函数追加 "@main" 标记 token，
            // 仅在第 1 遍（且每个模块至多一次）捕获，避免第 2 遍 ll_parse_func 重复覆盖。
            if (g_has_main == false) {
                var mi: i64 = 0;
                var mn: i64 = slice_len(toks) as i64;
                while (mi < mn) {
                    if (toks[mi] == "@main") { g_has_main = true; g_main_fn = g_pf_name; break; }
                    mi = mi + 1;
                }
            }
            // 收集命名类型（%Perm 等位标志/枚举，i64 底类型），供后续 emit `%Name = type i64` 声明
            ll_register_named_type(g_pf_ret);
            var pi2: i64 = 0;
            var plen2: i64 = slice_len(g_pf_params) as i64;
            while (pi2 < plen2) {
                ll_register_named_type(g_pf_params[pi2 + 1]);
                pi2 = pi2 + 2;
            }
            var ps: []string = [];
            var pi: i64 = 0;
            var plen: i64 = slice_len(g_pf_params) as i64;
            while (pi < plen) {
                append(ps, g_pf_params[pi + 1]);
                pi = pi + 2;
            }
            append(g_func_names, g_pf_name);
            append(g_func_paramsts, ps);
            k = k + 1;
            continue;
        }
        if (ll_starts(toks[0], "%")) {
            ll_emit_type_line(line);
            k = k + 1;
            continue;
        }
        k = k + 1;
    }
    // 命名类型声明（%Perm 等位标志/枚举，i64 底类型）置于函数之前，类型前向引用在 clang -c 下不被接受
    var ni: i64 = 0;
    var nn: i64 = slice_len(g_ll_named_types) as i64;
    while (ni < nn) {
        sb_append_str(g_ll, g_ll_named_types[ni]);
        sb_append_str(g_ll, " = type i64\n");
        ni = ni + 1;
    }
    // 第 2 遍：发射函数体
    var in_func: bool = false;
    k = 0;
    while (k < n) {
        var line: string = lines[k];
        var tl: string = ll_trim(line);
        if (tl == "") { k = k + 1; continue; }
        if (tl == "{") { k = k + 1; continue; }
        if (tl == "}") {
            // 函数体闭合：收尾 '}' 并复位 in_func，否则后续顶层声明（extern/global）会被误当函数体指令
            if (in_func) { sb_append_str(g_ll, "}\n\n"); in_func = false; }
            k = k + 1;
            continue;
        }
        var toks: []string = ll_tokens(line);
        var m: i64 = slice_len(toks) as i64;
        if (m == 0) { k = k + 1; continue; }
        if (str_at(tl, 0) == 59) { k = k + 1; continue; }   // ';' 注释行跳过（tir.tc 对未降级构造 emit 的 tir_cmt）
        if (toks[0] == "module" || toks[0] == "source:" || toks[0] == "types:" || toks[0] == "strings:") {
            k = k + 1;
            continue;
        }
        if (toks[0] == "func") {
            if (in_func) { sb_append_str(g_ll, "}\n\n"); }
            ll_parse_func(line);
            ll_emit_func(g_pf_name, g_pf_params, g_pf_ret);
            in_func = true;
            k = k + 1;
            continue;
        }
        if (in_func) { ll_emit_inst(toks); }
        k = k + 1;
    }
    if (in_func) { sb_append_str(g_ll, "}\n\n"); }
    sb_append_str(g_ll, sb_to_str(g_ll_declbuf));   // 外部函数 declare 置于模块末尾
    // 模块级全局变量声明：@name = global <ST> zeroinitializer（运行期初始化由 t.__ginit 完成）
    var gi: i64 = 0;
    var gn: i64 = slice_len(g_ll_globals) as i64;
    while (gi < gn) {
        sb_append_str(g_ll, "@");
        sb_append_str(g_ll, ll_mangle(g_ll_globals[gi]));
        sb_append_str(g_ll, " = global ");
        sb_append_str(g_ll, st_to_ll(g_ll_globalsts[gi]));
        sb_append_str(g_ll, " zeroinitializer\n");
        gi = gi + 1;
    }
    ll_emit_string_globals();                         // 字符串字面量全局常量（const.str 引用）
    ll_emit_opaque_defs();                          // 运行时结构类型补 opaque 定义
    ll_emit_main_wrapper();                         // 补 @main 入口包装（emit-tir-ll 此前缺此，导致无法链接运行）
    return sb_to_str(g_ll);
}

// 补 @main 入口包装：emit-tir-ll 此前只发函数体，缺 main 入口，故 clang 链接阶段因无入口失败。
// 与 legacy emit-ll 一致：t_runtime_init -> arena -> t.__ginit -> 用户入口 -> t_runtime_done。
// 运行期函数（t_runtime_init/t_arena_new/...）由 t_runtime.lib 提供，此处仅发 declare。
pub fn ll_emit_main_wrapper() void {
    if (g_has_main == false) { return; }
    sb_append_str(g_ll, "declare void @t_runtime_init(i32, ptr)\n");
    sb_append_str(g_ll, "declare ptr @t_arena_new()\n");
    sb_append_str(g_ll, "declare void @t_runtime_set_arena(ptr)\n");
    sb_append_str(g_ll, "declare void @t_runtime_done()\n");
    // 运行期 t_atom_str/t_deser_atom 总是引用 @t_atom_table/@t_atom_count，
    // legacy emit-ll 始终发射（无 atom 时为 1 元素占位）；TIR 路径此前缺此导致链接 undefined symbol。
    sb_append_str(g_ll, "@.tirll_as0 = private unnamed_addr constant [1 x i8] zeroinitializer\n");
    sb_append_str(g_ll, "@.tirll_ats0 = private unnamed_addr constant %TStr { ptr @.tirll_as0, i64 0 }\n");
    sb_append_str(g_ll, "@t_atom_table = global [1 x %TStr] [ %TStr { ptr @.tirll_as0, i64 0 } ]\n");
    sb_append_str(g_ll, "@t_atom_count = global i64 1\n");
    // 仅当模块未自带 t.__ginit 时补空实现（模块级全局初始化由 tir.tc 路径暂未生成，留空无害）
    var have_ginit: bool = false;
    var gi_i: i64 = 0;
    var gi_n: i64 = slice_len(g_func_names) as i64;
    while (gi_i < gi_n) {
        if (g_func_names[gi_i] == "t.__ginit") { have_ginit = true; break; }
        gi_i = gi_i + 1;
    }
    if (have_ginit == false) {
        sb_append_str(g_ll, "define void @t.__ginit() {\n  ret void\n}\n");
    }
    sb_append_str(g_ll, "define i32 @main(i32 %argc, ptr %argv) {\n");
    sb_append_str(g_ll, "entry:\n");
    sb_append_str(g_ll, "  call void @t_runtime_init(i32 %argc, ptr %argv)\n");
    sb_append_str(g_ll, "  %a = call ptr @t_arena_new()\n");
    sb_append_str(g_ll, "  call void @t_runtime_set_arena(ptr %a)\n");
    sb_append_str(g_ll, "  call void @t.__ginit()\n");
    sb_append_str(g_ll, "  %r = call i32 @t.");
    sb_append_str(g_ll, g_main_fn);
    sb_append_str(g_ll, "()\n");
    sb_append_str(g_ll, "  call void @t_runtime_done()\n");
    sb_append_str(g_ll, "  ret i32 %r\n");
    sb_append_str(g_ll, "}\n");
}
