        ll_ensure_slot(d, "i64"); ll_set_st(d, "i64"); ll_store(d, "i64", "0");
        return true;
    }
    // ── math__*：裸名 → t_math_<base>（f32 变体名以 f 结尾或 _f）──
    if (ll_starts(cn, "math__")) {
        var base2: string = str_slice(cn, 6, str_len(cn));
        var isf: bool = false;
        var L: i64 = str_len(base2);
        if (L >= 2 && str_at(base2, L - 2) == 95 && str_at(base2, L - 1) == 102) {
            base2 = base.sb_cat2(str_slice(base2, 0, L - 2), "f");
            isf = true;
        } else if (L >= 1 && str_at(base2, L - 1) == 102) {
            isf = true;
        }
        var ty: string = "double";
        if (isf) { ty = "float"; }
        if (base2 == "pow_i") {
            var a0: string = ll_load(toks[4], "double");
            var a1i: string = ll_load(toks[5], "i64");
            var a1: string = ll_tmp();
            sb_append_str(g_ll, "  "); sb_append_str(g_ll, a1);
            sb_append_str(g_ll, " = sitofp i64 "); sb_append_str(g_ll, a1i);
            sb_append_str(g_ll, " to double\n");
            // ⚠ 用 append 构造 argv：本语言内联数组字面量 [a0, a1]（含变量 string）只会拷贝首元素，
            // 导致 argv[1] 为空（math__pow_i 第二实参丢失）。改用 append 逐个追加可正确保留两者。
            var argv2: []string = [];
            append(argv2, a0);
            append(argv2, a1);
            ll_call_ret("t_math_pow", "double", ["double", "double"], argv2, d);
            return true;
        }
        var fn2: string = base.sb_cat2("t_math_", base2);
        var argc: i64 = slice_len(toks) as i64 - 4;
        var argv2: []string = [];
        var argsts2: []string = [];
        var i: i64 = 0;
        while (i < argc) {
            var av: string = ll_load(toks[4 + i], "double");
            if (isf) {
                var fv: string = ll_tmp();
                sb_append_str(g_ll, "  "); sb_append_str(g_ll, fv);
                sb_append_str(g_ll, " = fptrunc double "); sb_append_str(g_ll, av);
                sb_append_str(g_ll, " to float\n");
                append(argv2, fv);
            } else {
                append(argv2, av);
            }
            append(argsts2, ty);
            i = i + 1;
        }
        ll_call_ret(fn2, ty, argsts2, argv2, d);
        return true;
    }
    // ── SIMD 向量内建（@vlen / @reduce_* / @splat）──────────────────────
    // 与旧轨 codegen_ll.ll_vec_mbuiltin 语义逐位对齐：门禁比的是程序输出而非 IR，
    // 故此处直接用 LLVM 原生 `<N x T>` 向量指令（extractelement 逐 lane 折叠 / shufflevector 广播），
    // 不依赖 llvm.vector.reduce.* intrinsic（其 lane 类型约束更严）。
    // 与旧轨同构：reduce 用串行 extractelement + 标量 fold（含溢出行为一致），max/min 用
    // icmp/fcmp + select（signed→sgt/slt，unsigned→ugt/ult，float→ogt/olt）。
    if (cn == "vlen" || cn == "reduce_add" || cn == "reduce_max" || cn == "reduce_min" ||
        cn == "reduce_mul" || cn == "reduce_or" || cn == "reduce_and" || cn == "splat") {
        var vst: string = "";
        if (cn == "splat") { vst = toks[1]; }            // @splat 的返回类型即 vec<elem x N>
        else { vst = ll_get_st(toks[4]); }               // 其余：首实参（向量）的类型
        // 解析 vec<elem x N> → (elem_st, N)
        var inner: string = "";
        var elem: string = "i32";
        var N: i64 = 0;
        if (ll_starts(vst, "vec<")) {
            inner = str_slice(vst, 4, str_len(vst) - 1);
            var sp: i64 = ll_rfind(inner, " x ");
            if (sp >= 0) {
                elem = str_slice(inner, 0, sp);
                var nn: string = str_slice(inner, sp + 3, str_len(inner));
                N = ll_atoi(nn);
            }
        }
        var llst: string = st_to_ll(elem);   // 元素 LLVM 类型（i32 / double ...）
        if (cn == "vlen") {
            // @vlen(v)：lane 数编译期已知 → 直接发字面量 i64
            var nv: string = base.i2s(N);
            ll_ensure_slot(d, "i64"); ll_set_st(d, "i64"); ll_store(d, "i64", nv);
            return true;
        }
        if (cn == "splat") {
            // @splat(s, N)：insertelement 写 lane0 + shufflevector 全 0 掩码广播
            var sval: string = ll_load(toks[4], llst);
            var vty: string = st_to_ll(vst);
            var ins: string = ll_tmp();
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, ins);
            sb_append_str(g_ll, " = insertelement ");
            sb_append_str(g_ll, vty);
            sb_append_str(g_ll, " undef, ");
            sb_append_str(g_ll, llst);
            sb_append_str(g_ll, " ");
            sb_append_str(g_ll, sval);
            sb_append_str(g_ll, ", i32 0\n");
            var mask: StringBuilder = sb_new();
            sb_append_str(mask, "<");
            sb_append_str(mask, base.i2s(N));
            sb_append_str(mask, " x i32> <");
            var mi: i64 = 0;
            while (mi < N) {
                if (mi > 0) { sb_append_str(mask, ", "); }
                sb_append_str(mask, "i32 0");
                mi = mi + 1;
            }
            sb_append_str(mask, ">");
            var res: string = ll_tmp();
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, res);
            sb_append_str(g_ll, " = shufflevector ");
            sb_append_str(g_ll, vty);
            sb_append_str(g_ll, " ");
            sb_append_str(g_ll, ins);
            sb_append_str(g_ll, ", ");
            sb_append_str(g_ll, vty);
            sb_append_str(g_ll, " undef, ");
            sb_append_str(g_ll, sb_to_str(mask));
            sb_append_str(g_ll, "\n");
            ll_ensure_slot(d, vst); ll_set_st(d, vst); ll_store(d, vst, res);
            return true;
        }
        // ── reduce_*：extractelement 逐 lane 后串行折叠 ──
        var val: string = ll_load(toks[4], vst);
        var lanes: []string = [];
        var j: i64 = 0;
        while (j < N) {
            var le: string = ll_tmp();
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, le);
            sb_append_str(g_ll, " = extractelement ");
            sb_append_str(g_ll, st_to_ll(vst));
            sb_append_str(g_ll, " ");
            sb_append_str(g_ll, val);
            sb_append_str(g_ll, ", i32 ");
            sb_append_str(g_ll, base.i2s(j));
            sb_append_str(g_ll, "\n");
            append(lanes, le);
            j = j + 1;
        }
        if (slice_len(lanes) as i64 == 0) {
            // 空向量：reduce 退化为零值（与旧轨 ll_zero(elem) 一致）
            var z: string = "0";
            if (ll_is_float(elem)) { z = "0.0"; }
            ll_ensure_slot(d, llst); ll_set_st(d, llst); ll_store(d, llst, z);
            return true;
        }
        var acc: string = lanes[0];
        var k: i64 = 1;
        while (k < slice_len(lanes) as i64) {
            var lv: string = lanes[k];
            if (cn == "reduce_add" || cn == "reduce_mul") {
                var r: string = ll_tmp();
                sb_append_str(g_ll, "  ");
                sb_append_str(g_ll, r);
                sb_append_str(g_ll, " = ");
                if (cn == "reduce_add") {
                    if (ll_is_float(elem)) { sb_append_str(g_ll, "fadd"); } else { sb_append_str(g_ll, "add"); }
                } else {
                    if (ll_is_float(elem)) { sb_append_str(g_ll, "fmul"); } else { sb_append_str(g_ll, "mul"); }
                }
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, llst);
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, acc);
                sb_append_str(g_ll, ", ");
                sb_append_str(g_ll, lv);
                sb_append_str(g_ll, "\n");
                acc = r;
            } else if (cn == "reduce_or" || cn == "reduce_and") {
                var r: string = ll_tmp();
                sb_append_str(g_ll, "  ");
                sb_append_str(g_ll, r);
                sb_append_str(g_ll, " = ");
                if (cn == "reduce_or") { sb_append_str(g_ll, "or"); } else { sb_append_str(g_ll, "and"); }
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, llst);
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, acc);
                sb_append_str(g_ll, ", ");
                sb_append_str(g_ll, lv);
                sb_append_str(g_ll, "\n");
                acc = r;
            } else {
                // reduce_max / reduce_min：icmp/fcmp + select
                var is_max: bool = (cn == "reduce_max");
                var pred: string = "sgt";
                var cmpkind: string = "icmp";
                if (ll_is_float(elem)) {
                    cmpkind = "fcmp";
                    if (is_max) { pred = "ogt"; } else { pred = "olt"; }
                } else if (ll_is_unsigned_st(elem)) {
                    if (is_max) { pred = "ugt"; } else { pred = "ult"; }
                } else {
                    if (is_max) { pred = "sgt"; } else { pred = "slt"; }
                }
                var cmpt: string = ll_tmp();
                sb_append_str(g_ll, "  ");
                sb_append_str(g_ll, cmpt);
                sb_append_str(g_ll, " = ");
                sb_append_str(g_ll, cmpkind);
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, pred);
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, llst);
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, acc);
                sb_append_str(g_ll, ", ");
                sb_append_str(g_ll, lv);
                sb_append_str(g_ll, "\n");
                var selt: string = ll_tmp();
                sb_append_str(g_ll, "  ");
                sb_append_str(g_ll, selt);
                sb_append_str(g_ll, " = select i1 ");
                sb_append_str(g_ll, cmpt);
                sb_append_str(g_ll, ", ");
                sb_append_str(g_ll, llst);
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, acc);
                sb_append_str(g_ll, ", ");
                sb_append_str(g_ll, llst);
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, lv);
                sb_append_str(g_ll, "\n");
                acc = selt;
            }
            k = k + 1;
        }
        ll_ensure_slot(d, llst); ll_set_st(d, llst); ll_store(d, llst, acc);
        return true;
    }
    // ── @Tile 瓦片内建（@tsplat 构造 / @treduce_* 归约）────────────────
    // 与旧轨 ll_vec_mbuiltin 的 tsplat/treduce_* 分支逐位对齐：瓦片 = 嵌套定长数组
    // arr<arr<elem x cols> x rows>，逐元素 GEP 写/读后折叠（max/min 用 icmp/fcmp + select）。
    // 类型解析用「末位顶层 " x "」定行数、内层 " x " 定列数（元素为标量/向量均无空格，rfind 安全）。
    if (cn == "tsplat") {
        var vst: string = toks[1];
        if (ll_starts(vst, "ptr<arr<arr<")) { vst = str_slice(vst, 4, str_len(vst) - 1); }
        var elem: string = "i32";
        var rows: i64 = 1;
        var cols: i64 = 1;
        var p2: i64 = ll_rfind(vst, " x ");
        if (p2 >= 0) {
            rows = ll_atoi(str_slice(vst, p2 + 3, str_len(vst)));
            var rowType: string = str_slice(vst, 0, p2);
            var inner: string = str_slice(rowType, 4, str_len(rowType) - 1);
            var p1: i64 = ll_rfind(inner, " x ");
            if (p1 >= 0) {
                elem = str_slice(inner, 0, p1);
                cols = ll_atoi(str_slice(inner, p1 + 3, str_len(inner)));
            }
        }
        var llst: string = st_to_ll(elem);
        var sval: string = ll_load(toks[4], llst);
        ll_ensure_slot(d, vst); ll_set_st(d, vst);
        var total: i64 = rows * cols;
        var ii: i64 = 0;
        while (ii < total) {
            var ri2: i64 = ii / cols;
            var ci2: i64 = ii % cols;
            var gp: string = ll_tmp();
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, gp);
            sb_append_str(g_ll, " = getelementptr inbounds ");
            sb_append_str(g_ll, st_to_ll(vst));
            sb_append_str(g_ll, ", ptr ");
            sb_append_str(g_ll, d);
            sb_append_str(g_ll, ", i64 0, i64 ");
            sb_append_str(g_ll, base.i2s(ri2));
            sb_append_str(g_ll, ", i64 ");
            sb_append_str(g_ll, base.i2s(ci2));
            sb_append_str(g_ll, "\n");
            sb_append_str(g_ll, "  store ");
            sb_append_str(g_ll, llst);
            sb_append_str(g_ll, " ");
            sb_append_str(g_ll, sval);
            sb_append_str(g_ll, ", ptr ");
            sb_append_str(g_ll, gp);
            sb_append_str(g_ll, "\n");
            ii = ii + 1;
        }
        return true;
    }
    if (cn == "treduce_sum" || cn == "treduce_mul" || cn == "treduce_min" || cn == "treduce_max") {
        var vst: string = ll_get_st(toks[4]);
        if (ll_starts(vst, "ptr<arr<arr<")) { vst = str_slice(vst, 4, str_len(vst) - 1); }
        var elem: string = "i32";
        var rows: i64 = 1;
        var cols: i64 = 1;
        var p2b: i64 = ll_rfind(vst, " x ");
        if (p2b >= 0) {
            rows = ll_atoi(str_slice(vst, p2b + 3, str_len(vst)));
            var rowType2: string = str_slice(vst, 0, p2b);
            var inner2: string = str_slice(rowType2, 4, str_len(rowType2) - 1);
            var p1b: i64 = ll_rfind(inner2, " x ");
            if (p1b >= 0) {
                // ⚠ 瓦片 2 层嵌套：inner2 形如 "arr<i32 x 3>"，需再剥一层 "arr<" 才得元素类型 i32
                elem = str_slice(inner2, 4, p1b);
                cols = ll_atoi(str_slice(inner2, p1b + 3, str_len(inner2)));
            }
        }
        var llst2: string = st_to_ll(elem);
        var total2: i64 = rows * cols;
        var lanes2: []string = [];
        var ii2: i64 = 0;
        while (ii2 < total2) {
            var ri3: i64 = ii2 / cols;
            var ci3: i64 = ii2 % cols;
            var gp2: string = ll_tmp();
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, gp2);
            sb_append_str(g_ll, " = getelementptr inbounds ");
            sb_append_str(g_ll, st_to_ll(vst));
            sb_append_str(g_ll, ", ptr ");
            sb_append_str(g_ll, ll_llname(toks[4]));
            sb_append_str(g_ll, ", i64 0, i64 ");
            sb_append_str(g_ll, base.i2s(ri3));
            sb_append_str(g_ll, ", i64 ");
            sb_append_str(g_ll, base.i2s(ci3));
            sb_append_str(g_ll, "\n");
            var lv2: string = ll_tmp();
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, lv2);
            sb_append_str(g_ll, " = load ");
            sb_append_str(g_ll, llst2);
            sb_append_str(g_ll, ", ptr ");
            sb_append_str(g_ll, gp2);
            sb_append_str(g_ll, "\n");
            append(lanes2, lv2);
            ii2 = ii2 + 1;
        }
        if (slice_len(lanes2) as i64 == 0) {
            var z2: string = "0";
            if (ll_is_float(elem)) { z2 = "0.0"; }
            ll_ensure_slot(d, llst2); ll_set_st(d, llst2); ll_store(d, llst2, z2);
            return true;
        }
        var acc2: string = lanes2[0];
        var k2: i64 = 1;
        while (k2 < slice_len(lanes2) as i64) {
            var lv3: string = lanes2[k2];
            if (cn == "treduce_sum" || cn == "treduce_mul") {
                var r2: string = ll_tmp();
                sb_append_str(g_ll, "  ");
                sb_append_str(g_ll, r2);
                sb_append_str(g_ll, " = ");
                if (cn == "treduce_sum") { if (ll_is_float(elem)) { sb_append_str(g_ll, "fadd"); } else { sb_append_str(g_ll, "add"); } }
                else { if (ll_is_float(elem)) { sb_append_str(g_ll, "fmul"); } else { sb_append_str(g_ll, "mul"); } }
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, llst2);
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, acc2);
                sb_append_str(g_ll, ", ");
                sb_append_str(g_ll, lv3);
                sb_append_str(g_ll, "\n");
                acc2 = r2;
            } else {
                var is_max2: bool = (cn == "treduce_max");
                var pred2: string = "sgt";
                var cmpkind2: string = "icmp";
                if (ll_is_float(elem)) {
                    cmpkind2 = "fcmp";
                    if (is_max2) { pred2 = "ogt"; } else { pred2 = "olt"; }
                } else if (ll_is_unsigned_st(elem)) {
                    if (is_max2) { pred2 = "ugt"; } else { pred2 = "ult"; }
                } else {
                    if (is_max2) { pred2 = "sgt"; } else { pred2 = "slt"; }
                }
                var cmpt2: string = ll_tmp();
                sb_append_str(g_ll, "  ");
                sb_append_str(g_ll, cmpt2);
                sb_append_str(g_ll, " = ");
                sb_append_str(g_ll, cmpkind2);
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, pred2);
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, llst2);
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, acc2);
                sb_append_str(g_ll, ", ");
                sb_append_str(g_ll, lv3);
                sb_append_str(g_ll, "\n");
                var selt2: string = ll_tmp();
                sb_append_str(g_ll, "  ");
                sb_append_str(g_ll, selt2);
                sb_append_str(g_ll, " = select i1 ");
                sb_append_str(g_ll, cmpt2);
                sb_append_str(g_ll, ", ");
                sb_append_str(g_ll, llst2);
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, acc2);
                sb_append_str(g_ll, ", ");
                sb_append_str(g_ll, llst2);
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, lv3);
                sb_append_str(g_ll, "\n");
                acc2 = selt2;
            }
            k2 = k2 + 1;
        }
        ll_ensure_slot(d, llst2); ll_set_st(d, llst2); ll_store(d, llst2, acc2);
        return true;
    }
    return false;
}

// call 指令 → 重建 token 序列（仅供 ll_emit_builtin 内建分发复用其位置约定；
// 主发射逻辑直接读 inst 结构化字段，不再依赖 toks）。
pub fn tir_call_to_toks(inst: TIRInst) []string {
    var toks: []string = ["call", tir_st_to_str(inst.st)];
    if (str_len(inst.dst.name) > 0) { append(toks, inst.dst.name); }
    var k: i64 = 0;
    var an: i64 = slice_len(inst.args) as i64;
    while (k < an) { append(toks, inst.args[k].name); k = k + 1; }
    return toks;
}

// 结构化指令发射：直接消费 inst.op / inst.st / inst.dst / inst.args，
// 不再对整行文本做 split→tokenize 位置解析（§5.6）。类型恢复仍用 g_ll_*
// （翻译期内生寄存器类型表，记录派生/前向类型，属 codegen 内部状态，非层间字符串传递）。
pub fn ll_emit_inst(inst: TIRInst) void {
    var op: i64 = inst.op;
    if (op == TIR_OP_RET || op == TIR_OP_RET_VOID) {
        if (op == TIR_OP_RET_VOID || str_len(tir_st_to_str(inst.st)) == 0) {
            sb_append_str(g_ll, "  ret void\n");
        } else {
            var st: string = tir_st_to_str(inst.st);
            var d: string = inst.dst.name;
            var v: string = ll_load(d, st);
            if (str_len(d) >= 1 && d[0] == 64) {
                var mref: string = ll_mangle(str_slice(d, 1, str_len(d)));
                if (ll_is_func(mref)) { v = ll_emit_closure_const(mref, st); }
            }
            if (g_cur_sret != "") {
                // 聚合 sret 返回：把值写入 sret 槽，ret void
                sb_append_str(g_ll, "  store ");
                sb_append_str(g_ll, st_to_ll(st));
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, v);
                sb_append_str(g_ll, ", ptr ");
                sb_append_str(g_ll, g_cur_sret);
                sb_append_str(g_ll, "\n  ret void\n");
            } else {
                sb_append_str(g_ll, "  ret ");
                sb_append_str(g_ll, st_to_ll(st));
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, v);
                sb_append_str(g_ll, "\n");
            }
        }
        return;
    }
    if (op == TIR_OP_SLOT) {
        // ⚠ 飞地规避：tir_to_ll.tc 大模块 SLOT 分支读 inst 任意字符串字段（dst.name/args[0].name/cmt）
        // 均被种子错编成函数名 "main"，导致槽漏分配/错命名（generics_demo/fid_read_demo/map_iter clang 失败）。
        // 故 SLOT 不再在此分配槽；改由 STORE/LOAD 分支（编译正确）惰性 ll_ensure_slot（见 ll_store/ll_load），
        // 其 tname 读取正确，能产出 %main.<var> 正确名。
        return;
    }
    if (op == TIR_OP_CONST_STR) {
        var d: string = inst.dst.name;
        var idx: string = inst.args[0].name;
        ll_ensure_slot(d, "%TStr");
        ll_set_st(d, "%TStr");
        var gp: string = base.sb_cat2("@.tirll_tstr", idx);
        var tmp: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, tmp);
        sb_append_str(g_ll, " = load %TStr, ptr ");
        sb_append_str(g_ll, gp);
        sb_append_str(g_ll, "\n");
        sb_append_str(g_ll, "  store %TStr ");
        sb_append_str(g_ll, tmp);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, ll_llname(d));
        sb_append_str(g_ll, "\n");
        return;
    }
    if (op == TIR_OP_CONST_PTR_NULL) {
        var d: string = inst.dst.name;
        ll_ensure_slot(d, "ptr");
        ll_set_st(d, "ptr");
        ll_store(d, "ptr", "null");
        return;
    }
    if (op == TIR_OP_CONST || op == TIR_OP_CONST_STR || op == TIR_OP_CONST_PTR_NULL) {
        var st: string;
        var d: string = inst.dst.name;
        var imm: string = inst.args[0].name;
        st = tir_st_to_str(inst.st);
        var nimm: string = ll_norm_imm(imm, st);
        ll_ensure_slot(d, st);
        ll_set_st(d, st);
        ll_store(d, st, nimm);
        return;
    }
    if (op == TIR_OP_BITCAST) {
        var dstst0: string = tir_st_to_str(inst.st);
        var dst: string = inst.dst.name;
        var src: string = inst.args[0].name;
        var sgst: string = ll_get_st(src);
        var src_is_ptr: bool = ll_starts(sgst, "ptr<") || sgst == "ptr" ||
                                ll_starts(sgst, "arr<") || ll_starts(sgst, "vec<");
        var dstst_eff: string = dstst0;
        if (src_is_ptr && ll_starts(dstst0, "ptr<") == false && ll_starts(dstst0, "%") == false && ll_is_scalar_st(dstst0)) {
            dstst_eff = base.sb_cat3("ptr<", dstst0, ">");
        }
        if (dstst0 == "ptr<void>" || dstst0 == "ptr") {
            dstst_eff = sgst;
        }
        var dll: string = st_to_ll(dstst_eff);
        if (ll_starts(dstst_eff, "arr<") || ll_starts(dstst_eff, "vec<") || ll_starts(dstst_eff, "%")) { dll = "ptr"; }
        var srcv: string;
        if (sgst == "ptr" || ll_starts(sgst, "ptr<")) {
            srcv = ll_load(src, sgst);
        } else if (ll_starts(sgst, "arr<") || ll_starts(sgst, "vec<")) {
            srcv = ll_llname_ptr(src);
        } else {
            var sgll: string = st_to_ll(sgst);
            if (ll_starts(sgll, "%")) { sgll = "i64"; }
            srcv = ll_load(src, sgll);
        }
        var t: string = ll_tmp();
        var srcLlTy: string;
        if (sgst == "ptr" || ll_starts(sgst, "ptr<") || ll_starts(sgst, "arr<") || ll_starts(sgst, "vec<")) {
            srcLlTy = "ptr";
        } else {
            srcLlTy = st_to_ll(sgst);
            if (ll_starts(srcLlTy, "%")) { srcLlTy = "i64"; }
        }
        var castop: string = "bitcast";
        var castDst: string = dll;
        var srcIsInt: bool = ll_llty_is_int(srcLlTy);
        var dstIsInt: bool = ll_llty_is_int(dll);
        if (srcLlTy == "ptr" && dstIsInt) {
            castop = "ptrtoint";
        } else if (srcIsInt && ll_starts(dll, "ptr")) {
            castop = "inttoptr";
            castDst = "ptr";
        }
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, t);
        sb_append_str(g_ll, " = ");
        sb_append_str(g_ll, castop);
        sb_append_str(g_ll, " ");
        sb_append_str(g_ll, srcLlTy);
        sb_append_str(g_ll, " ");
        sb_append_str(g_ll, srcv);
        sb_append_str(g_ll, " to ");
        sb_append_str(g_ll, castDst);
        sb_append_str(g_ll, "\n");
        if (ll_starts(dstst_eff, "arr<") || ll_starts(dstst_eff, "vec<") || ll_starts(dstst_eff, "%")) {
            ll_ensure_slot(dst, "ptr");
            ll_set_st(dst, "ptr");
            ll_store(dst, "ptr", t);
        } else {
            ll_ensure_slot(dst, dstst_eff);
            ll_set_st(dst, dstst_eff);
            ll_store(dst, dstst_eff, t);
        }
        return;
    }
    if (op == TIR_OP_STORE) {
        // 发射器恒以「store $src $dst」（2 操作数，无显式 ST）形式产出；ST 由 g_ll_* 恢复。
        var src: string = inst.args[0].name;
        var dst: string = inst.dst.name;
        var dstst: string = ll_get_st(dst);
        if (str_len(src) >= 1 && src[0] == 64 && ll_is_func(ll_mangle(str_slice(src, 1, str_len(src))))) {
            var mref: string = ll_mangle(str_slice(src, 1, str_len(src)));
            // field0 必须存 code（@fn 或 @fn.__clo_thunk），不能存 %TClosure 全局（否则双重包裹 → 段错误）
            var fptr: string = ll_closure_code(mref);
            var p: string = ll_load(dst, dstst);
            sb_append_str(g_ll, "  store ptr ");
            sb_append_str(g_ll, fptr);
            sb_append_str(g_ll, ", ptr ");
            sb_append_str(g_ll, p);
            sb_append_str(g_ll, "\n");
            return;
        }
        if (ll_starts(dstst, "ptr<")) {
            var inner: string = ll_ptr_inner(dstst);
            var srcst: string = ll_get_st(src);
            var src_is_ptr: bool = ll_starts(srcst, "ptr<") || srcst == "ptr";
            if (ll_is_addrslot(dst)) {
                // dst 是 GEP 地址槽（l-value，槽内容=字段地址）：解引用写穿（store v, ptr *dst）。
                // 旧逻辑在 src 也为指针时误把值拷进临时量(覆盖地址)→字段永不写入→闭包捕获读到垃圾。
                var p: string = ll_load(dst, dstst);
                var v: string = ll_load(src, srcst);
                sb_append_str(g_ll, "  store ");
                sb_append_str(g_ll, st_to_ll(srcst));
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, v);
                sb_append_str(g_ll, ", ptr ");
                sb_append_str(g_ll, p);
                sb_append_str(g_ll, "\n");
            } else {
                // dst 是值槽（普通指针变量，槽内容=指针值）：保留旧语义，勿解引用。
                //   - src 为指针：把指针值拷进槽（p = x，值语义）。
                //   - src 为标量：解引用写穿（*p = v，指针变量当缓冲用）。
                // ⚠ 不可改回 ll_store(dst,...)：那会把值写进槽自身的 alloca 而非 *p，破坏 *p=v 语义
                //   （adt_*/fixed_array/generics/vdot 等指针变量缓冲用例会回归）。
                if (src_is_ptr) {
                    var v: string = ll_load(src, srcst);
                    ll_store(dst, srcst, v);
                } else if (srcst == inner) {
                    var p: string = ll_load(dst, dstst);
                    var v: string = ll_load(src, inner);
                    sb_append_str(g_ll, "  store ");
                    sb_append_str(g_ll, st_to_ll(inner));
                    sb_append_str(g_ll, " ");
                    sb_append_str(g_ll, v);
                    sb_append_str(g_ll, ", ptr ");
                    sb_append_str(g_ll, p);
                    sb_append_str(g_ll, "\n");
                } else {
                    var p: string = ll_load(dst, dstst);
                    var v: string = ll_load(src, srcst);
                    sb_append_str(g_ll, "  store ");
                    sb_append_str(g_ll, st_to_ll(srcst));
                    sb_append_str(g_ll, " ");
                    sb_append_str(g_ll, v);
                    sb_append_str(g_ll, ", ptr ");
                    sb_append_str(g_ll, p);
                    sb_append_str(g_ll, "\n");
                }
            }
        } else {
            // ⚠ 裸 ptr 槽（如 tll_slice_at / 聚合取地址返回值，st 记为 ptr 而非 ptr<inner>）：
            // 与 load 侧对称 —— 槽内容可能是「指向目标的地址(l-value)」而非「指针值」。
            //   - src 为指针：值语义，把指针值拷进槽（p = q）。
            //   - src 非指针：槽存地址，解引用写穿（*p = v）。
            // 旧逻辑把裸 ptr 当普通标量槽，直接 ll_store 把值写进槽自身 → slice 元素赋值 /
            // 聚合字段写失效（sort_slice 整体成 no-op、cli/colony append 后乱序）。
            if (dstst == "ptr") {
                var srcst: string = ll_get_st(src);
                var src_is_ptr: bool = (srcst == "ptr" || ll_starts(srcst, "ptr<"));
                if (src_is_ptr) {
                    var v: string = ll_load(src, srcst);
                    ll_store(dst, srcst, v);
                } else {
                    var v: string = ll_load(src, srcst);
                    var p: string = ll_load(dst, "ptr");
                    sb_append_str(g_ll, "  store ");
                    sb_append_str(g_ll, st_to_ll(srcst));
                    sb_append_str(g_ll, " ");
                    sb_append_str(g_ll, v);
                    sb_append_str(g_ll, ", ptr ");
                    sb_append_str(g_ll, p);
                    sb_append_str(g_ll, "\n");
                }
                return;
            }
            var vst: string = ll_get_st(src);
            var v: string = ll_load(src, vst);
            if (dstst != vst && ll_is_scalar_st(dstst) && ll_is_scalar_st(vst)
                && ll_bits(dstst) != ll_bits(vst)) {
                var conv: string = ll_tmp();
                var opcode: string = "";
                if (ll_is_float(dstst) && ll_is_float(vst)) {
                    // 浮点窄化/宽化：f64 常量存进 f32 槽须 fptrunc（对齐旧 LLVM 后端 ll_norm_imm）。
                    // 下行 st_to_ll 已含 f32→float/f64→double。
                    if (ll_bits(vst) > ll_bits(dstst)) { opcode = "fptrunc"; }
                    else { opcode = "fpext"; }
                } else if (ll_is_float(dstst) == false && ll_is_float(vst) == false) {
                    // 整型/Bool 宽度换算
                    opcode = "trunc";
                    if (vst == "i1" && ll_is_int(dstst)) {
                        // ⚠ bool 比较结果(i1) 拓宽到更宽整型/布尔：必须 zext（0/1→0/1）。
                        // base.tc 的 ll_bits("i1") 兜底返回 64，会误判为「源比目标宽」→ 错发
                        // trunc i1 to i8（非法，i1 比 i8 窄）；sext 则把 bool 1 扩成 -1。
                        // 故 i1→任意整型一律 zext。colony_demo/colony_wave 命中。
                        opcode = "zext";
                    } else if (ll_bits(vst) < ll_bits(dstst)) {
                        if (ll_is_unsigned_st(vst)) { opcode = "zext"; } else { opcode = "sext"; }
                    }
                }
                // 浮点↔整型 不在此自动转换（须由 TIR 显式 cast 指令完成），opcode 留空即跳过。
                if (opcode != "") {
                    sb_append_str(g_ll, "  ");
                    sb_append_str(g_ll, conv);
                    sb_append_str(g_ll, " = ");
                    sb_append_str(g_ll, opcode);
                    sb_append_str(g_ll, " ");
                    sb_append_str(g_ll, st_to_ll(vst));
                    sb_append_str(g_ll, " ");
                    sb_append_str(g_ll, v);
                    sb_append_str(g_ll, " to ");
                    sb_append_str(g_ll, st_to_ll(dstst));
                    sb_append_str(g_ll, "\n");
                    v = conv;
                    vst = dstst;
                }
            }
            if (str_len(dst) >= 1 && dst[0] == 64) {
                var gnm: string = str_slice(dst, 1, str_len(dst));
                if (ll_is_func(gnm) == false) { ll_register_global(gnm, vst); }
            }
            ll_store(dst, vst, v);
        }
        return;
    }
    if (op == TIR_OP_LOAD) {
        var st: string = tir_st_to_str(inst.st);
        var d: string = inst.dst.name;
        var addr: string = inst.args[0].name;
        // 全局变量 @name：TIR 指令里的 st 可能因前端对向量/聚合全局退回 i64，
        // 而 globals: 段声明的是真实类型（如 vec<i32 x 4>）。优先用全局已注册类型，
        // 否则 g_scale 之类向量全局被当 i64 加载（只读首 8 字节）→ 运行期全 0。
        if (str_len(addr) >= 1 && addr[0] == 64) {
            var gst: string = ll_get_st(addr);
            if (ll_starts(gst, "vec<") || ll_starts(gst, "arr<") || ll_starts(gst, "%")) { st = gst; }
        }
        ll_ensure_slot(d, st);
        ll_set_st(d, st);
        var pst: string = ll_get_st(addr);
        var p: string;
        if (ll_starts(pst, "ptr<") || pst == "ptr") {
            // ⚠ 源槽为 val_ptr（tll_map_val_ptr 返回值，内容是「值字节指针」）：
            // load 须先取槽中指针(vb)、再解引用取回真值（handle / 值）。
            // 普通 ptr 槽（map_new 句柄）load 只取槽中值本身，不能解引用。两者类型同为 ptr
            // 故用 g_ll_valptr 显式区分：val_ptr 槽走 ll_load 取 vb 后再 load，普通 ptr 槽走 ll_llname_ptr。
            if (ll_is_valptr(addr)) {
                p = ll_load(addr, pst);
            } else if (st == "ptr" || ll_starts(st, "ptr<")) {
                // ⚠ 源槽 st == ptr<目标> 时，源槽持有「指向目标的指针（地址）」（典型：GEP 结果 /
                // 结构体 ptr 字段读取 —— 结构体字段 GEP 返回字段地址，槽 st 记为 ptr<fldst>）。
                // 此时 load 须先解引用取回真值（如 map 句柄），不能把地址当值读出。
                // 源槽 st == 目标 st 时（map_new 句柄等直接持有值的 ptr 槽）用槽地址读出即可。
                if (pst == base.sb_cat3("ptr<", st, ">")) {
                    p = ll_load(addr, pst);
                } else {
                    p = ll_llname_ptr(addr);
                }
            } else {
                p = ll_load(addr, pst);
            }
        } else {
            p = ll_llname_ptr(addr);
        }
        var v: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, v);
        sb_append_str(g_ll, " = load ");
        sb_append_str(g_ll, st_to_ll(st));
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, p);
        sb_append_str(g_ll, "\n");
        ll_store(d, st, v);
        return;
    }
    if (op == TIR_OP_ADDR_OF) {
        var st: string = tir_st_to_str(inst.st);
        var d: string = inst.dst.name;
        var x: string = inst.args[0].name;
        var dstst: string = st;
        if ((ll_starts(st, "ptr<") || st == "ptr") == false) {
            dstst = base.sb_cat3("ptr<", st, ">");
        }
        if (str_len(x) >= 1 && x[0] == 64) { ll_register_global(str_slice(x, 1, str_len(x)), ll_ptr_inner(st)); }
        // ⚠ 飞地规避 + SLOT no-op 后：被取地址的局部槽（如固定数组 var b:[5]i64，仅经 &b[i] 引用）
        // 不会经 store/load 惰性分配，必须在此显式 ensure，否则其 tll_alloc 堆分配永不发射 → undefined。
        if (str_len(x) >= 1 && x[0] == 36) { ll_ensure_slot(x, st); }
        ll_ensure_slot(d, dstst);
        ll_set_st(d, dstst);
        sb_append_str(g_ll, "  store ptr ");
        sb_append_str(g_ll, ll_llname_ptr(x));
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, ll_llname(d));
        sb_append_str(g_ll, "\n");
        return;
    }
    if (op == TIR_OP_GEP) {
        var st: string = tir_st_to_str(inst.st);
        var g: string = inst.dst.name;
        var p: string = inst.args[0].name;
        ll_ensure_slot(g, base.sb_cat3("ptr<", st, ">"));
        ll_set_st(g, base.sb_cat3("ptr<", st, ">"));
        var pst: string = ll_get_st(p);
        var gtypename: string;
        var pv: string;
        if (ll_starts(pst, "ptr<")) {
            gtypename = ll_ptr_inner(pst);
            pv = ll_load(p, pst);
        } else {
            gtypename = st_to_ll(st);
            pv = ll_llname(p);
        }
        var r: string = ll_tmp();
        var operands: string = "";
        var ki: i64 = 1;
        var kn: i64 = slice_len(inst.args) as i64;
        while (ki < kn) {
            var gidx: string = inst.args[ki].name;
            if (ll_starts(gidx, "$")) {
                var gist: string = ll_get_st(gidx);
                var gv: string = ll_load(gidx, gist);
                var operand: string = base.sb_cat2(st_to_ll(gist), " ");
                operand = base.sb_cat2(operand, gv);
                operands = base.sb_cat2(operands, ", ");
                operands = base.sb_cat2(operands, operand);
            } else {
                operands = base.sb_cat2(operands, ", i32 ");
                operands = base.sb_cat2(operands, gidx);
            }
        ki = ki + 1;
    }
    // ⚠ 标量子类型 + 路径 `i32 0, i32 0`：`getelementptr inbounds i64, ptr %x, i32 0, i32 0`
    // 非法（标量只能承受单索引解引用）。字段 0 恰在偏移 0，故降级为单索引 `i32 0`（= &字段0），合法。
    // 根因：通用 ptr 基底经 tir lowering 丢失内类型，GEP inbounds 被错置为字段标量类型而非外层结构。
    // ptr<Struct> 基底走上层分支（gtypename=结构名，非标量），不会误伤。agent_npc_mind/agentkit_demo 命中。
    if (ll_is_scalar_st(gtypename) && operands == ", i32 0, i32 0") {
        operands = ", i32 0";
    }
    sb_append_str(g_ll, "  ");
    sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = getelementptr inbounds ");
        sb_append_str(g_ll, gtypename);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, pv);
        if (ll_starts(gtypename, "[")) { sb_append_str(g_ll, ", i32 0"); }
        sb_append_str(g_ll, operands);
        sb_append_str(g_ll, "\n");
        if (ll_starts(st, "ptr") && (kn - 1) == 1 && ll_starts(pst, "%")) {
            var lv: string = ll_tmp();
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, lv);
            sb_append_str(g_ll, " = load ");
            sb_append_str(g_ll, st_to_ll(st));
            sb_append_str(g_ll, ", ptr ");
            sb_append_str(g_ll, r);
            sb_append_str(g_ll, "\n");
            ll_set_st(g, st);
            ll_store(g, st, lv);
            return;
        }
        ll_mark_addrslot(g);   // GEP 结果是字段/元素地址(l-value)；store 该槽须解引用写穿
        ll_store(g, base.sb_cat3("ptr<", st, ">"), r);
        return;
    }
    if (op == TIR_OP_STRUCT_NEW) {
        var tyname: string = tir_st_to_str(inst.st);
        var d: string = inst.dst.name;
        var llt: string = st_to_ll(tyname);
        if (ll_is_variant(tyname)) {
            var pst: string = base.sb_cat3("ptr<", tyname, ">");
            ll_ensure_slot(d, pst);
            ll_set_st(d, pst);
            var ap: string = ll_tmp();
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, ap);
            sb_append_str(g_ll, " = alloca ");
            sb_append_str(g_ll, llt);
            sb_append_str(g_ll, "\n");
            var fi: i64 = 0;
            var an: i64 = slice_len(inst.args) as i64;
            while (fi < an) {
                var fs: string = inst.args[fi].name;
                var fst: string = ll_get_st(fs);
                var fv: string = ll_load(fs, fst);
                var gp: string = ll_tmp();
                sb_append_str(g_ll, "  ");
                sb_append_str(g_ll, gp);
                sb_append_str(g_ll, " = getelementptr inbounds ");
                sb_append_str(g_ll, llt);
                sb_append_str(g_ll, ", ptr ");
                sb_append_str(g_ll, ap);
                sb_append_str(g_ll, ", i32 0, i32 ");
                sb_append_str(g_ll, base.i2s(fi));
                sb_append_str(g_ll, "\n");
                sb_append_str(g_ll, "  store ");
                sb_append_str(g_ll, st_to_ll(fst));
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, fv);
                sb_append_str(g_ll, ", ptr ");
                sb_append_str(g_ll, gp);
                sb_append_str(g_ll, "\n");
                fi = fi + 1;
            }
            ll_store(d, pst, ap);
            return;
        }
        ll_ensure_slot(d, tyname);
        ll_set_st(d, tyname);
        // 聚合元素目标类型（vec<elem x N> / arr<elem x N>）：用于把字段值 cast 到正确位宽后
        // store，否则 i64 字面量会被原样 store 进 i32 槽 → 越界写内存（reduce 读到垃圾）。
        var etgt: string = "";
        if (ll_starts(tyname, "vec<") || ll_starts(tyname, "arr<")) {
            var inner2: string = str_slice(tyname, 4, str_len(tyname) - 1);
            var sp2: i64 = ll_rfind(inner2, " x ");
            if (sp2 >= 0) { etgt = str_slice(inner2, 0, sp2); }
        }
        var fi2: i64 = 0;
        var an2: i64 = slice_len(inst.args) as i64;
        while (fi2 < an2) {
            var fs: string = inst.args[fi2].name;
            var fst: string = ll_get_st(fs);
            var fv: string = ll_load(fs, fst);
            // 向量/数组字面量：元素位宽与目标不一致时先 cast（int→trunc/zext/sext，float→fptrunc/fpext）
            if (str_len(etgt) > 0 && etgt != fst) {
                var vb: i64 = base.ll_bits(fst);
                var eb: i64 = base.ll_bits(etgt);
                if (vb != eb) {
                    var cv: string = ll_tmp();
                    sb_append_str(g_ll, "  ");
                    sb_append_str(g_ll, cv);
                    if (ll_is_float(fst) && ll_is_float(etgt)) {
                        if (vb > eb) { sb_append_str(g_ll, " = fptrunc "); }
                        else { sb_append_str(g_ll, " = fpext "); }
                    } else if (vb > eb) {
                        sb_append_str(g_ll, " = trunc ");
                    } else if (base.ll_signed(fst)) {
                        sb_append_str(g_ll, " = sext ");
                    } else {
                        sb_append_str(g_ll, " = zext ");
                    }
                    sb_append_str(g_ll, st_to_ll(fst));
                    sb_append_str(g_ll, " ");
                    sb_append_str(g_ll, fv);
                    sb_append_str(g_ll, " to ");
                    sb_append_str(g_ll, st_to_ll(etgt));
                    sb_append_str(g_ll, "\n");
                    fv = cv; fst = etgt;
                }
            }
            var gp: string = ll_tmp();
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, gp);
            sb_append_str(g_ll, " = getelementptr inbounds ");
            sb_append_str(g_ll, llt);
            sb_append_str(g_ll, ", ptr ");
            sb_append_str(g_ll, ll_llname(d));
            sb_append_str(g_ll, ", i32 0, i32 ");
            sb_append_str(g_ll, base.i2s(fi2));
            sb_append_str(g_ll, "\n");
            sb_append_str(g_ll, "  store ");
            sb_append_str(g_ll, st_to_ll(fst));
            sb_append_str(g_ll, " ");
            sb_append_str(g_ll, fv);
            sb_append_str(g_ll, ", ptr ");
            sb_append_str(g_ll, gp);
            sb_append_str(g_ll, "\n");
            fi2 = fi2 + 1;
        }
        return;
    }
    if (op == TIR_OP_CALL) {
        var st: string = tir_st_to_str(inst.st);
        var d: string = inst.dst.name;
        var callee: string = inst.args[0].name;
        var is_indirect: bool = (str_len(callee) >= 1 && callee[0] == 36);
        var fname: string = ll_llname(callee);
        if (ll_emit_builtin(fname, tir_call_to_toks(inst))) { return; }
        var argsb: StringBuilder = sb_new();
        var declargs: []string = [];
        var first: bool = true;
        var nargs: i64 = 0;
        var ki: i64 = 1;
        var kn: i64 = slice_len(inst.args) as i64;
        while (ki < kn) {
            var a: string = inst.args[ki].name;
            if (str_len(a) >= 1 && a[0] == 64) {
                var mref: string = ll_mangle(str_slice(a, 1, str_len(a)));
                if (ll_is_func(mref)) {
                    var clo: string = ll_emit_closure_const(mref, st);
                    if (first == false) { sb_append_str(argsb, ", "); }
                    sb_append_str(argsb, "ptr ");
                    sb_append_str(argsb, clo);
                    append(declargs, "ptr<void>");
                } else {
                    if (first == false) { sb_append_str(argsb, ", "); }
                    sb_append_str(argsb, "ptr ");
                    sb_append_str(argsb, ll_load(a, "ptr<void>"));
                    append(declargs, "ptr<void>");
                }
                first = false;
                nargs = nargs + 1;
                ki = ki + 1;
                continue;
            }
            var ast: string = ll_get_st(a);
            if (ll_starts(fname, "tll_") && ll_is_struct_type(ast)) {
                if (first == false) { sb_append_str(argsb, ", "); }
                sb_append_str(argsb, "ptr ");
                sb_append_str(argsb, ll_llname_ptr(a));
                append(declargs, "ptr");
                first = false;
                nargs = nargs + 1;
                ki = ki + 1;
                continue;
            }
            var v: string = ll_load(a, ast);
            if (first == false) { sb_append_str(argsb, ", "); }
            sb_append_str(argsb, st_to_ll(ast));
            sb_append_str(argsb, " ");
            sb_append_str(argsb, v);
            append(declargs, ast);
            first = false;
            nargs = nargs + 1;
            ki = ki + 1;
        }
        if (is_indirect) {
            var fpv: string = ll_load(callee, ll_get_st(callee));
            if (st == "void") {
                sb_append_str(g_ll, "  call void ");
                sb_append_str(g_ll, fpv);
                sb_append_str(g_ll, "(");
                sb_append_str(g_ll, sb_to_str(argsb));
                sb_append_str(g_ll, ")\n");
                return;
            }
            var r: string = ll_tmp();
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, r);
            sb_append_str(g_ll, " = call ");
            sb_append_str(g_ll, st_to_ll(st));
            sb_append_str(g_ll, " ");
            sb_append_str(g_ll, fpv);
            sb_append_str(g_ll, "(");
            sb_append_str(g_ll, sb_to_str(argsb));
            sb_append_str(g_ll, ")\n");
            ll_ensure_slot(d, st);
            ll_set_st(d, st);
            ll_store(d, st, r);
            return;
        }
        if (str_len(fname) >= 1 && fname[0] == 37) {
            fname = ll_mangle(str_slice(fname, 1, str_len(fname)));
        }
        // 闭包(env 首参)函数才需要传 env；普通函数无 env 形参（与旧轨 codegen_ll 逐字一致，
        // 旧轨仅对 n.sb 非空的合成闭包函数前置 ptr %__env）。此前误用 ll_is_func（对所有已定义函数为真）
        // 给普通函数调用也塞 ptr null env，导致签名多一个实参、ABI 错乱。
        var callee_params: []string = ll_lookup_params(fname);
        var callee_has_env: bool = (slice_len(callee_params) >= 2 && callee_params[0] == "$__env" && callee_params[1] == "ptr<void>");
        if (callee_has_env) {
            var nbargs: StringBuilder = sb_new();
            sb_append_str(nbargs, "ptr null");
            if (nargs > 0) { sb_append_str(nbargs, ", "); sb_append_str(nbargs, sb_to_str(argsb)); }
            argsb = nbargs;
        }
        ll_maybe_declare(fname, st, declargs);
        // 显式 sret 仅用于「闭包(env 首参)且返回结构」的调用：此时 callee 签名 arg0=sret、arg1=env。
        // 普通函数(无 env)走 LLVM 自动 sret（`call %TSlice @f(...)`），与旧轨逐字一致。
        if (ll_needs_sret(st) && callee_has_env) {
            // sret 聚合返回：dst 槽即 sret 指针（首参），env=null 次之，用户实参再次之
            ll_ensure_slot(d, st);
            ll_set_st(d, st);
            var nbargs2: StringBuilder = sb_new();
            sb_append_str(nbargs2, "ptr ");
            sb_append_str(nbargs2, ll_llname(d));
            sb_append_str(nbargs2, ", ptr null");
            if (nargs > 0) { sb_append_str(nbargs2, ", "); sb_append_str(nbargs2, sb_to_str(argsb)); }
            sb_append_str(g_ll, "  call void @");
            sb_append_str(g_ll, fname);
            sb_append_str(g_ll, "(");
            sb_append_str(g_ll, sb_to_str(nbargs2));
            sb_append_str(g_ll, ")\n");
            return;
        }
        if (st == "void") {
            sb_append_str(g_ll, "  call void @");
            sb_append_str(g_ll, fname);
            sb_append_str(g_ll, "(");
            sb_append_str(g_ll, sb_to_str(argsb));
            sb_append_str(g_ll, ")\n");
            return;
        }
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = call ");
        sb_append_str(g_ll, st_to_ll(st));
        sb_append_str(g_ll, " @");
        sb_append_str(g_ll, fname);
        sb_append_str(g_ll, "(");
        sb_append_str(g_ll, sb_to_str(argsb));
        sb_append_str(g_ll, ")\n");
        ll_ensure_slot(d, st);
        ll_set_st(d, st);
        ll_store(d, st, r);
        // ⚠ val_ptr 标记：tll_map_val_ptr/tll_map_val_at 返回「值字节指针」，内容是 ptr；
        // 存于槽后 load 此槽须二次解引用（load ptr, ptr (load ptr, ptr %x)）取回真值。
        // 不标记则 load 只取槽中指针本身(val_ptr)，嵌套读/写会把 val_ptr 当容器 → 段错误。
        if (fname == "tll_map_val_ptr" || fname == "tll_map_val_at") { ll_mark_valptr(d); }
        return;
    }
    if (op == TIR_OP_CALL_IND) {
        var st: string = tir_st_to_str(inst.st);
        var d: string = inst.dst.name;
        var fp_raw: string = ll_llname_ptr(inst.args[0].name);
        var fp: string = fp_raw;
        if (str_len(fp_raw) >= 1 && fp_raw[0] != 64) {
            var fpl: string = ll_tmp();
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, fpl);
            sb_append_str(g_ll, " = load ptr, ptr ");
            sb_append_str(g_ll, fp_raw);
            sb_append_str(g_ll, "\n");
            fp = fpl;
        }
        var g0: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, g0);
        sb_append_str(g_ll, " = getelementptr inbounds %TClosure, ptr ");
        sb_append_str(g_ll, fp);
        sb_append_str(g_ll, ", i32 0, i32 0\n");
        var code: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, code);
        sb_append_str(g_ll, " = load ptr, ptr ");
        sb_append_str(g_ll, g0);
        sb_append_str(g_ll, "\n");
        var g1: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, g1);
        sb_append_str(g_ll, " = getelementptr inbounds %TClosure, ptr ");
        sb_append_str(g_ll, fp);
        sb_append_str(g_ll, ", i32 0, i32 1\n");
        var env: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, env);
        sb_append_str(g_ll, " = load ptr, ptr ");
        sb_append_str(g_ll, g1);
        sb_append_str(g_ll, "\n");
        var argsb: StringBuilder = sb_new();
        if (ll_needs_sret(st)) {
            // sret 聚合返回：dst 槽即 sret 指针（首参），env 次之，用户实参再次之
            ll_ensure_slot(d, st);
            ll_set_st(d, st);
            sb_append_str(argsb, "ptr ");
            sb_append_str(argsb, ll_llname(d));
            sb_append_str(argsb, ", ptr ");
            sb_append_str(argsb, env);
        } else {
            sb_append_str(argsb, "ptr ");
            sb_append_str(argsb, env);
        }
        var ki: i64 = 1;
        var kn: i64 = slice_len(inst.args) as i64;
        while (ki < kn) {
            var a: string = inst.args[ki].name;
            if (a == "(" || a == ")") { ki = ki + 1; continue; }
            if (str_len(a) >= 1 && a[0] == 64) {
                var mref: string = ll_mangle(str_slice(a, 1, str_len(a)));
                if (ll_is_func(mref)) {
                    sb_append_str(argsb, ", ptr ");
                    sb_append_str(argsb, ll_emit_closure_const(mref, st));
                } else {
                    sb_append_str(argsb, ", ptr ");
                    sb_append_str(argsb, ll_load(a, "ptr<void>"));
                }
                ki = ki + 1;
                continue;
            }
            var ast: string = ll_get_st(a);
            var v: string = ll_load(a, ast);
            sb_append_str(argsb, ", ");
            sb_append_str(argsb, st_to_ll(ast));
            sb_append_str(argsb, " ");
            sb_append_str(argsb, v);
            ki = ki + 1;
        }
        if (ll_needs_sret(st)) {
            sb_append_str(g_ll, "  call void ");
            sb_append_str(g_ll, code);
            sb_append_str(g_ll, "(");
            sb_append_str(g_ll, sb_to_str(argsb));
            sb_append_str(g_ll, ")\n");
            return;
        }
        if (st == "void") {
            sb_append_str(g_ll, "  call void ");
            sb_append_str(g_ll, code);
            sb_append_str(g_ll, "(");
            sb_append_str(g_ll, sb_to_str(argsb));
            sb_append_str(g_ll, ")\n");
            return;
        }
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = call ");
        sb_append_str(g_ll, st_to_ll(st));
        sb_append_str(g_ll, " ");
        sb_append_str(g_ll, code);
        sb_append_str(g_ll, "(");
        sb_append_str(g_ll, sb_to_str(argsb));
        sb_append_str(g_ll, ")\n");
        ll_ensure_slot(d, st);
        ll_set_st(d, st);
        ll_store(d, st, r);
        return;
    }
    if (op == TIR_OP_BR) {
        sb_append_str(g_ll, "  br label %");
        sb_append_str(g_ll, ll_label(inst.args[0].name));
        sb_append_str(g_ll, "\n");
        return;
    }
    if (op == TIR_OP_BR_COND) {
        var c: string = inst.args[0].name;
        var l1: string = inst.args[1].name;
        var l2: string = inst.args[2].name;
        var cst: string = ll_get_st(c);
        var cv: string = ll_load(c, cst);
        if (cst != "i1") {
            var t: string = ll_tmp();
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, t);
            sb_append_str(g_ll, " = icmp ne ");
            sb_append_str(g_ll, st_to_ll(cst));
            sb_append_str(g_ll, " ");
            sb_append_str(g_ll, cv);
            sb_append_str(g_ll, ", 0\n");
            cv = t;
        }
        sb_append_str(g_ll, "  br i1 ");
        sb_append_str(g_ll, cv);
        sb_append_str(g_ll, ", label %");
        sb_append_str(g_ll, ll_label(l1));
        sb_append_str(g_ll, ", label %");
        sb_append_str(g_ll, ll_label(l2));
        sb_append_str(g_ll, "\n");
        return;
    }
    if (op == TIR_OP_BLOCK) {
        sb_append_str(g_ll, ll_label(inst.dst.name));
        sb_append_str(g_ll, ":\n");
        return;
    }
    if (op == TIR_OP_TRUNC || op == TIR_OP_ZEXT || op == TIR_OP_SEXT || op == TIR_OP_FPEXT || op == TIR_OP_FPTRUNC ||
        op == TIR_OP_SITOFP || op == TIR_OP_UITOFP || op == TIR_OP_FPTOSI || op == TIR_OP_FPTOUI) {
        var dstst: string = tir_st_to_str(inst.st);
        var d: string = inst.dst.name;
        var s: string = inst.args[0].name;
        var srcst: string = ll_get_st(s);
        var sv: string = ll_load(s, srcst);
        if (st_to_ll(srcst) == st_to_ll(dstst)) {
            ll_ensure_slot(d, dstst);
            ll_set_st(d, dstst);
            ll_store(d, dstst, sv);
            return;
        }
        ll_ensure_slot(d, dstst);
        ll_set_st(d, dstst);
        var r: string = ll_tmp();
        var llvmop: string = tir_op_to_str(op);
        if (op == TIR_OP_TRUNC) {
            if (ll_is_float(srcst) && ll_is_float(dstst)) { llvmop = "fptrunc"; }
            else if (ll_is_float(srcst) && ll_is_int(dstst)) { llvmop = "fptosi"; }
            else if (ll_is_int(srcst) && ll_is_float(dstst)) { llvmop = "sitofp"; }
            // ⚠ i1（bool 比较结果）拓宽到更宽整型（如 i8）用 trunc 非法（src 比 dst 窄），
            // 必须 zext：bool 0/1 零扩展为 0/1，而非符号扩展成 0/-1。colony_demo/colony_wave 命中。
            else if (srcst == "i1") { llvmop = "zext"; }
            else { llvmop = "trunc"; }
        } else if (op == TIR_OP_ZEXT || op == TIR_OP_SEXT) {
            if (ll_is_float(srcst) && ll_is_float(dstst)) { llvmop = "fpext"; }
            if (ll_is_struct_type(srcst)) { return; }
        }
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = ");
        sb_append_str(g_ll, llvmop);
        sb_append_str(g_ll, " ");
        sb_append_str(g_ll, st_to_ll(srcst));
        sb_append_str(g_ll, " ");
        sb_append_str(g_ll, sv);
        sb_append_str(g_ll, " to ");
        sb_append_str(g_ll, st_to_ll(dstst));
        sb_append_str(g_ll, "\n");
        ll_store(d, dstst, r);
        return;
    }
    // 二元 / 比较 / 一元：op.ST 形式（ST 在 op 内）或纯 op（ST 默认 i64），
    // 结构化后 inst.op 已是去掉点的基名，inst.st 为对应 ST。
    var o: i64 = inst.op;
    var st: string = tir_st_to_str(inst.st);
    if (st == "%TStr" && o == TIR_OP_ADD) {
        var d: string = inst.dst.name;
        var a: string = inst.args[0].name;
        var b: string = inst.args[1].name;
        ll_ensure_slot(d, "%TStr");
        ll_set_st(d, "%TStr");
        var decl_args: []string = ["ptr", "ptr", "ptr"];
        ll_maybe_declare("tll_str_concat", "void", decl_args);
        // ⚠ runtime 签名 tll_str_concat(TStr* a, TStr* b, TStr* out)：out 是末位参数！
        // 旧 LLVM 后端对齐 emit：tll_str_concat(ptr a, ptr b, ptr out)。此前把 d(out) 放首位导致
        // 拼接结果写到 a 的槽、println 读到的是未初始化的空串 → 输出空。
        sb_append_str(g_ll, "  call void @tll_str_concat(ptr ");
        sb_append_str(g_ll, ll_llname(a));
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, ll_llname(b));
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, ll_llname(d));
        sb_append_str(g_ll, ")\n");
        return;
    }
    if ((o == TIR_OP_EQ || o == TIR_OP_NE) && st == "%TStr") {
        var d: string = inst.dst.name;
        var a: string = inst.args[0].name;
        var b: string = inst.args[1].name;
        var da: string = ll_llname(a);
        var db: string = ll_llname(b);
        ll_maybe_declare("tll_str_eq", "i32", ["ptr", "ptr"]);
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = call i32 @tll_str_eq(ptr ");
        sb_append_str(g_ll, da);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, db);
        sb_append_str(g_ll, ")\n");
        var b1: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, b1);
        sb_append_str(g_ll, " = icmp ne i32 ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, ", 0\n");
        ll_ensure_slot(d, "i1");
        ll_set_st(d, "i1");
        ll_store(d, "i1", b1);
        return;
    }
    if (o == TIR_OP_SLT || o == TIR_OP_SGT || o == TIR_OP_SGE || o == TIR_OP_SLE || o == TIR_OP_ULT || o == TIR_OP_UGT ||
        o == TIR_OP_ULE || o == TIR_OP_UGE || o == TIR_OP_EQ || o == TIR_OP_NE) {
        var d: string = inst.dst.name;
        var a: string = inst.args[0].name;
        var b: string = inst.args[1].name;
        var da: string = ll_load(a, st);
        var db: string = ll_load(b, st);
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = ");
        if (ll_is_float(st)) {
            sb_append_str(g_ll, "fcmp ");
            sb_append_str(g_ll, ll_fcmp(o));
        } else {
            sb_append_str(g_ll, "icmp ");
            sb_append_str(g_ll, ll_icmp(o));
        }
        sb_append_str(g_ll, " ");
        sb_append_str(g_ll, st_to_ll(st));
        sb_append_str(g_ll, " ");
        sb_append_str(g_ll, da);
        sb_append_str(g_ll, ", ");
        sb_append_str(g_ll, db);
        sb_append_str(g_ll, "\n");
        ll_ensure_slot(d, "i1");
        ll_set_st(d, "i1");
        ll_store(d, "i1", r);
        return;
    }
    if (o == TIR_OP_NOT || o == TIR_OP_LNOT) {
        var d: string = inst.dst.name;
        var a: string = inst.args[0].name;
        var da: string = ll_load(a, st);
        var r1: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r1);
        sb_append_str(g_ll, " = icmp eq ");
        sb_append_str(g_ll, st_to_ll(st));
        sb_append_str(g_ll, " ");
        sb_append_str(g_ll, da);
        sb_append_str(g_ll, ", 0\n");
        var r2: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r2);
        sb_append_str(g_ll, " = zext i1 ");
        sb_append_str(g_ll, r1);
        sb_append_str(g_ll, " to ");
        sb_append_str(g_ll, st_to_ll(st));
        sb_append_str(g_ll, "\n");
        ll_ensure_slot(d, st);
        ll_set_st(d, st);
        ll_store(d, st, r2);
        return;
    }
    if (o == TIR_OP_NEG) {
        var d: string = inst.dst.name;
        var a: string = inst.args[0].name;
        var da: string = ll_load(a, st);
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = ");
        if (ll_is_float(st)) { sb_append_str(g_ll, "fneg "); }
        else { sb_append_str(g_ll, "sub "); }
        sb_append_str(g_ll, st_to_ll(st));
        sb_append_str(g_ll, " ");
        if (ll_is_float(st)) {
            sb_append_str(g_ll, da);
        } else {
            sb_append_str(g_ll, "0, ");
            sb_append_str(g_ll, da);
        }
        sb_append_str(g_ll, "\n");
        ll_ensure_slot(d, st);
        ll_set_st(d, st);
        ll_store(d, st, r);
        return;
    }
    if (op == TIR_OP_GEP_IDX) {
        var st: string = tir_st_to_str(inst.st);
        var d: string = inst.dst.name;
        var base: string = inst.args[0].name;
        var idx: string = inst.args[1].name;
        var dstst: string = base.sb_cat3("ptr<", st, ">");
        ll_ensure_slot(d, dstst);
        ll_set_st(d, dstst);
        var pst: string = ll_get_st(base);
        var p: string;
        if (ll_starts(pst, "ptr<") || pst == "ptr") {
            p = ll_load(base, pst);
        } else {
            p = ll_llname_ptr(base);
        }
        var ist: string = ll_get_st(idx);
        var iv: string = ll_load(idx, ist);
        if (ll_is_int(ist) && st_to_ll(ist) != "i64") {
            var iv64: string = ll_tmp();
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, iv64);
            sb_append_str(g_ll, " = zext ");
            sb_append_str(g_ll, st_to_ll(ist));
            sb_append_str(g_ll, " ");
            sb_append_str(g_ll, iv);
            sb_append_str(g_ll, " to i64\n");
            iv = iv64;
        }
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = getelementptr inbounds ");
        sb_append_str(g_ll, st_to_ll(st));
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, p);
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, iv);
        sb_append_str(g_ll, "\n");
        ll_store(d, dstst, r);
        return;
    }
    if (op == TIR_OP_SLICE_AT) {
        // slice_at <dst> <base_slot> <idx> → dst = call ptr @tll_slice_at(ptr <切片结构地址>, i64 <下标>)
        // base_slot 即 alloca %TSlice（本就是地址），必须原样传 ptr，绝不可 load 出 %TSlice 值（那样 tll_slice_at 收到的是数据指针而非结构地址）。
        var d: string = inst.dst.name;
        var base: string = inst.args[0].name;
        var idx: string = inst.args[1].name;
        var ist: string = ll_get_st(idx);
        var iv: string = ll_load(idx, ist);
        if (ll_is_int(ist) && st_to_ll(ist) != "i64") {
            var iv64: string = ll_tmp();
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, iv64);
            sb_append_str(g_ll, " = zext ");
            sb_append_str(g_ll, st_to_ll(ist));
            sb_append_str(g_ll, " ");
            sb_append_str(g_ll, iv);
            sb_append_str(g_ll, " to i64\n");
            iv = iv64;
        }
        ll_maybe_declare("tll_slice_at", "ptr", ["ptr", "i64"]);
        ll_ensure_slot(d, "ptr");
        ll_set_st(d, "ptr");
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = call ptr @tll_slice_at(ptr ");
        sb_append_str(g_ll, ll_llname_ptr(base));
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, iv);
        sb_append_str(g_ll, ")\n");
        ll_store(d, "ptr", r);
        return;
    }
    if (op == TIR_OP_STR_AT) {
        // str_at <dst> <base_slot> <idx> → dst = call i64 @tll_str_at(ptr <结构地址>, i64 <下标>) 返回字节值
        var d: string = inst.dst.name;
        var base: string = inst.args[0].name;
        var idx: string = inst.args[1].name;
        var ist: string = ll_get_st(idx);
        var iv: string = ll_load(idx, ist);
        if (ll_is_int(ist) && st_to_ll(ist) != "i64") {
            var iv64: string = ll_tmp();
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, iv64);
            sb_append_str(g_ll, " = zext ");
            sb_append_str(g_ll, st_to_ll(ist));
            sb_append_str(g_ll, " ");
            sb_append_str(g_ll, iv);
            sb_append_str(g_ll, " to i64\n");
            iv = iv64;
        }
        ll_maybe_declare("tll_str_at", "i64", ["ptr", "i64"]);
        ll_ensure_slot(d, "i64");
        ll_set_st(d, "i64");
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = call i64 @tll_str_at(ptr ");
        sb_append_str(g_ll, ll_llname_ptr(base));
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, iv);
        sb_append_str(g_ll, ")\n");
        ll_store(d, "i64", r);
        return;
    }
    // 普通二元（整数/浮点统一）
    var d: string = inst.dst.name;
    var a: string = inst.args[0].name;
    var b: string = inst.args[1].name;
    // 瓦片逐元素二元（arr<arr<elem x cols> x rows>）：嵌套 GEP 循环，逐元素 apply op。
    // 与旧轨 codegen_ll tile binop 分支对齐（值级输出一致即可；IR 不必逐字相同）。
    // binop 的 inst.st 常为 ptr（瓦片以指针存储），或操作数槽注册为 ptr<arr<arr<...>>；
    // 归一化为值聚合类型 arr<arr<elem x cols> x rows> 后再走瓦片分支。
    var tst: string = "";
    if (ll_starts(st, "ptr<arr<arr<")) { tst = str_slice(st, 4, str_len(st) - 1); }
    else if (ll_starts(st, "arr<arr<")) { tst = st; }
    else if (st == "ptr") {
        var areg: string = ll_get_st(ll_llname(a));
        if (ll_starts(areg, "ptr<arr<arr<")) { tst = str_slice(areg, 4, str_len(areg) - 1); }
        else if (ll_starts(areg, "arr<arr<")) { tst = areg; }
    }
    if (str_len(tst) > 0) {
        var elem: string = "i32";
        var rows: i64 = 1;
        var cols: i64 = 1;
        var p2t: i64 = ll_rfind(tst, " x ");
        if (p2t >= 0) {
            rows = ll_atoi(str_slice(tst, p2t + 3, str_len(tst)));
            var rowTypeT: string = str_slice(tst, 0, p2t);
            var innerT: string = str_slice(rowTypeT, 4, str_len(rowTypeT) - 1);
            var p1t: i64 = ll_rfind(innerT, " x ");
            if (p1t >= 0) {
                // ⚠ 瓦片是 2 层嵌套：innerT 形如 "arr<i32 x 3>"，需再剥一层 "arr<" 才得元素类型 i32
                elem = str_slice(innerT, 4, p1t);
                cols = ll_atoi(str_slice(innerT, p1t + 3, str_len(innerT)));
            }
        }
        var llstT: string = st_to_ll(elem);
        var lhsp: string = ll_llname(a);
        var rhsp: string = ll_llname(b);
        ll_ensure_slot(d, tst); ll_set_st(d, tst);
        sb_append_str(g_ll, "  store ");
        sb_append_str(g_ll, st_to_ll(tst));
        sb_append_str(g_ll, " zeroinitializer, ptr ");
        sb_append_str(g_ll, ll_llname(d));
        sb_append_str(g_ll, "\n");
        var totalT: i64 = rows * cols;
        var iiT: i64 = 0;
        while (iiT < totalT) {
            var riT: i64 = iiT / cols;
            var ciT: i64 = iiT % cols;
            var lg: string = ll_tmp();
            sb_append_str(g_ll, "  "); sb_append_str(g_ll, lg);
            sb_append_str(g_ll, " = getelementptr inbounds ");
            sb_append_str(g_ll, st_to_ll(tst));
            sb_append_str(g_ll, ", ptr "); sb_append_str(g_ll, lhsp);
            sb_append_str(g_ll, ", i64 0, i64 "); sb_append_str(g_ll, base.i2s(riT));
            sb_append_str(g_ll, ", i64 "); sb_append_str(g_ll, base.i2s(ciT)); sb_append_str(g_ll, "\n");
            var rg: string = ll_tmp();
            sb_append_str(g_ll, "  "); sb_append_str(g_ll, rg);
            sb_append_str(g_ll, " = getelementptr inbounds ");
            sb_append_str(g_ll, st_to_ll(tst));
            sb_append_str(g_ll, ", ptr "); sb_append_str(g_ll, rhsp);
            sb_append_str(g_ll, ", i64 0, i64 "); sb_append_str(g_ll, base.i2s(riT));
            sb_append_str(g_ll, ", i64 "); sb_append_str(g_ll, base.i2s(ciT)); sb_append_str(g_ll, "\n");
            var og: string = ll_tmp();
            sb_append_str(g_ll, "  "); sb_append_str(g_ll, og);
            sb_append_str(g_ll, " = getelementptr inbounds ");
            sb_append_str(g_ll, st_to_ll(tst));
            sb_append_str(g_ll, ", ptr "); sb_append_str(g_ll, ll_llname(d));
            sb_append_str(g_ll, ", i64 0, i64 "); sb_append_str(g_ll, base.i2s(riT));
            sb_append_str(g_ll, ", i64 "); sb_append_str(g_ll, base.i2s(ciT)); sb_append_str(g_ll, "\n");
            var lvT: string = ll_tmp();
            sb_append_str(g_ll, "  "); sb_append_str(g_ll, lvT);
            sb_append_str(g_ll, " = load "); sb_append_str(g_ll, llstT); sb_append_str(g_ll, ", ptr "); sb_append_str(g_ll, lg); sb_append_str(g_ll, "\n");
            var rvT: string = ll_tmp();
            sb_append_str(g_ll, "  "); sb_append_str(g_ll, rvT);
            sb_append_str(g_ll, " = load "); sb_append_str(g_ll, llstT); sb_append_str(g_ll, ", ptr "); sb_append_str(g_ll, rg); sb_append_str(g_ll, "\n");
            var resT: string = ll_tmp();
            sb_append_str(g_ll, "  "); sb_append_str(g_ll, resT);
            sb_append_str(g_ll, " = ");
            if (ll_is_float(elem)) { sb_append_str(g_ll, ll_fbinop(o)); } else { sb_append_str(g_ll, ll_binop(o)); }
            sb_append_str(g_ll, " "); sb_append_str(g_ll, llstT); sb_append_str(g_ll, " ");
            sb_append_str(g_ll, lvT); sb_append_str(g_ll, ", "); sb_append_str(g_ll, rvT); sb_append_str(g_ll, "\n");
            sb_append_str(g_ll, "  store "); sb_append_str(g_ll, llstT); sb_append_str(g_ll, " ");
            sb_append_str(g_ll, resT); sb_append_str(g_ll, ", ptr "); sb_append_str(g_ll, og); sb_append_str(g_ll, "\n");
            iiT = iiT + 1;
        }
        return;
    }
    var da: string = ll_load(a, st);
    var db: string = ll_load(b, st);
    var r: string = ll_tmp();
    sb_append_str(g_ll, "  ");
    sb_append_str(g_ll, r);
    sb_append_str(g_ll, " = ");
    if (ll_is_float(st)) {
        sb_append_str(g_ll, ll_fbinop(o));
    } else {
        sb_append_str(g_ll, ll_binop(o));
    }
    sb_append_str(g_ll, " ");
    sb_append_str(g_ll, st_to_ll(st));
    sb_append_str(g_ll, " ");
    sb_append_str(g_ll, da);
    sb_append_str(g_ll, ", ");
    sb_append_str(g_ll, db);
    sb_append_str(g_ll, "\n");
    ll_ensure_slot(d, st);
    ll_set_st(d, st);
    ll_store(d, st, r);
}

// ── 文本扫描辅助 ─────────────────────────────────────────────────
pub fn ll_split_lines(text: string) []string {
    var out: []string = [];
    var cur: StringBuilder = sb_new();
    var n: i64 = str_len(text);
    var i: i64 = 0;
    while (i < n) {
        var c: i64 = str_at(text, i);
        if (c == 10) {   // '\n'
            append(out, sb_to_str(cur));
            cur = sb_new();
        } else if (c != 13) {   // skip '\r'
            sb_append_char(cur, c);
        }
        i = i + 1;
    }
    if (str_len(sb_to_str(cur)) > 0) { append(out, sb_to_str(cur)); }
    return out;
}

pub fn ll_trim(s: string) string {
    var n: i64 = str_len(s);
    var i: i64 = 0;
    while (i < n) {
        var c: i64 = str_at(s, i);
        if (c != 32 && c != 9) { break; }
        i = i + 1;
    }
    var j: i64 = n;
    while (j > i) {
        var c: i64 = str_at(s, j - 1);
        if (c == 32 || c == 9) { j = j - 1; } else { break; }
    }
    return str_slice(s, i, j);
}

pub fn ll_emit_type_line(line: string) void {
    var eq: i64 = ll_find(line, " = struct {");
    if (eq < 0) { return; }
    var name: string = ll_trim(str_slice(line, 0, eq));
    // 记录已在 types: 段声明为 struct 的命名类型，供 ll_register_named_type 跳过（避免误判为 i64 标量）。
    var sn: i64 = slice_len(g_ll_struct_types) as i64;
    var si: i64 = 0;
    var sseen: bool = false;
    while (si < sn) { if (g_ll_struct_types[si] == name) { sseen = true; break; } si = si + 1; }
    if (sseen == false) { append(g_ll_struct_types, name); }
    var lbrace: i64 = ll_find(line, "{");
    var rbrace: i64 = ll_find(line, "}");
    if (lbrace < 0 || rbrace < 0) { return; }
    var inner: string = ll_trim(str_slice(line, lbrace + 1, rbrace));
    var fields: StringBuilder = sb_new();
    var cur: StringBuilder = sb_new();
    var fldtys: []string = [name];   // [类型名, 字段0st, 字段1st, ...] 供 ll_sizeof_st 计算聚合尺寸
    var first: bool = true;
    var m: i64 = str_len(inner);
    var i: i64 = 0;
    while (i < m) {
        var c: i64 = str_at(inner, i);
        if (c == 44) {   // ','
            if (first == false) { sb_append_str(fields, ", "); }
            var ft: string = ll_trim(sb_to_str(cur));
            sb_append_str(fields, st_to_ll(ft));
            append(fldtys, ft);
            cur = sb_new();
            first = false;
        } else if (c == 58) {   // ':' 跳过字段名 (f0:)
            cur = sb_new();
        } else {
            sb_append_char(cur, c);
        }
        i = i + 1;
    }
    if (first == false) { sb_append_str(fields, ", "); }
    var ft2: string = ll_trim(sb_to_str(cur));
    sb_append_str(fields, st_to_ll(ft2));
    append(fldtys, ft2);
    append(g_ll_struct_fieldtys, fldtys);
    sb_append_str(g_ll, name);
    sb_append_str(g_ll, " = type { ");
    sb_append_str(g_ll, sb_to_str(fields));
    sb_append_str(g_ll, " }\n");
}

// 为 TIR 引用但未在 types: 段内联定义的运行时结构类型（如 %TSb）补 opaque 定义；
// 与外部函数 declare 同理——链接器再解析真实布局。类型名均以大写 T 起头（%TStr 等）。
pub fn ll_emit_opaque_defs() void {
    var text: string = sb_to_str(g_ll);
    var n: i64 = str_len(text);
    var i: i64 = 0;
    var buf: StringBuilder = sb_new();
    while (i < n) {
        var c: i64 = str_at(text, i);
        if (c == 37 && (i + 1) < n && str_at(text, i + 1) == 84) {   // '%' + 'T'
            var j: i64 = i + 2;
            while (j < n) {
                var d: i64 = str_at(text, j);
                if ((d >= 65 && d <= 90) || (d >= 97 && d <= 122) || (d >= 48 && d <= 57) || d == 95) { j = j + 1; }
                else { break; }
            }
            var name: string = str_slice(text, i + 1, j);   // 含 'T'，如 "TSb"
            var seen: bool = false;
            var k: i64 = 0;
            var km: i64 = slice_len(g_opaque_emitted) as i64;
            while (k < km) {
                if (g_opaque_emitted[k] == name) { seen = true; break; }
                k = k + 1;
            }
            if (seen == false) {
                var pat: string = base.sb_cat3("%", name, " = type");
                if (ll_find(sb_to_str(g_ll), pat) < 0) {
                    sb_append_str(buf, "%");
                    sb_append_str(buf, name);
                    sb_append_str(buf, " = type opaque\n");
                    append(g_opaque_emitted, name);
                }
            }
            i = j;
        } else {
            i = i + 1;
        }
    }
    var old: string = sb_to_str(g_ll);
    g_ll = sb_new();
    sb_append_str(g_ll, sb_to_str(buf));
    sb_append_str(g_ll, old);
}

// 发射 TIR strings: 段里每个字面量为 LLVM 全局常量：
//   @.tirll_str<i>  = constant [N x i8] c"<esc>"   （tir_esc 的 \XX 转义本就是合法 LLVM c"" 内容）
//   @.tirll_tstr<i> = constant %TStr { ptr @.tirll_str<i>, i64 N }
// const.str $tN <i> 随后直接 `store %TStr @.tirll_tstr<i>, ptr %curfn.tN`，使字符串字面量承载真实数据。
pub fn ll_emit_string_globals() void {
    var i: i64 = 0;
    var n: i64 = slice_len(g_str_table) as i64;
    while (i < n) {
        var content: string = g_str_table[i];          // tir_esc 形式（\XX 合法 LLVM c"" 内容）
        var blen: i64 = 0;
        var cn: i64 = str_len(content);
        var ci: i64 = 0;
        while (ci < cn) {                              // 计算原始字节长度（\XX 记 1 字节）
            if (str_at(content, ci) == 92) { ci = ci + 3; } else { ci = ci + 1; }
            blen = blen + 1;
        }
        sb_append_str(g_ll, "@.tirll_str");
        sb_append_i64(g_ll, i);
        sb_append_str(g_ll, " = private unnamed_addr constant [");
        sb_append_i64(g_ll, blen);
        sb_append_str(g_ll, " x i8] c\"");
        sb_append_str(g_ll, content);
        sb_append_str(g_ll, "\", align 1\n");
        sb_append_str(g_ll, "@.tirll_tstr");
        sb_append_i64(g_ll, i);
        sb_append_str(g_ll, " = constant %TStr { ptr @.tirll_str");
        sb_append_i64(g_ll, i);
        sb_append_str(g_ll, ", i64 ");
        sb_append_i64(g_ll, blen);
        sb_append_str(g_ll, " }\n");
        i = i + 1;
    }
    sb_append_str(g_ll, "@__dbg_stcount = global i64 ");
    sb_append_i64(g_ll, n);
    sb_append_str(g_ll, "\n");
}

// 结构化入口（§5.6）：直接消费 TIRModule，不再经 tir_to_text() 文本 round-trip。
// 跨层接口为结构体：types/strings/funcs 读 module 字段，globals 读 tir.g_globals_section 缓冲；
// 每条指令直接消费 inst.tokens（结构化 token 列表，发射期由 tir_line 解析，无整行文本字段）。
// 产出 .ll 与 tir_to_ll_translate(tir_to_text()) 逐字节一致（对拍基线不变）。
pub fn tir_to_ll_emit(module: TIRModule) string {
    ll_reset();
    // 第 1 遍：TT 类型 + 字符串表 + 全局 + 函数签名
    var ti: i64 = 0;
    var tn: i64 = slice_len(module.types) as i64;
    while (ti < tn) {
        var t: TIRType = module.types[ti];
        // t.name 已含前导 '%'（如 "%TStr"），ll_emit_type_line 内部会再取 name 段并 emit "name = type"，故此处不可再加 '%'。
        ll_emit_type_line(base.sb_cat3(t.name, " = struct { ", base.sb_cat2(t.body, " }")));
        ti = ti + 1;
    }
    // 字符串表（module.strings 已是原始内容，无需 esc/unesc，等价于 translate 解析 strings: 段）
    var si: i64 = 0;
    var sn: i64 = slice_len(module.strings) as i64;
    // 字符串表：旧路径 tir_to_text 对内容做 tir_esc 后再 emit，translate 提取的是「已转义」串；
    // 故此处直接存 tir_esc(module.strings[si])，与旧 g_str_table 内容逐字节一致（供 ll_emit_string_globals）。
    while (si < sn) { append(g_str_table, tir_esc(module.strings[si])); si = si + 1; }
    // 模块级全局（沿用 g_globals_section 文本缓冲，格式与 translate 解析 globals: 段一致）
    var glines: []string = ll_split_lines(sb_to_str(tir.g_globals_section));
    var gi: i64 = 0;
    var gn: i64 = slice_len(glines) as i64;
    while (gi < gn) {
        var gt: []string = ll_tokens(glines[gi]);
        var gm: i64 = slice_len(gt) as i64;
        if (gm >= 2) {
            var gnm: string = gt[0];
            if (str_len(gnm) >= 1 && gnm[0] == 64) { gnm = str_slice(gnm, 1, str_len(gnm)); }
            // ⚠ st 可能含空格（如向量 `vec<i32 x 4>` 被 ll_tokens 拆成多条），须把 gt[1..] 重拼成一个完整类型串，
            // 否则全局类型被截断成 `vec<i32`（缺 ` x 4>`）→ ll_get_st 返回残串、reduce 内建解析 N=0 → 全 0。
            var gst: string = gt[1];
            var ti: i64 = 2;
            while (ti < gm) { gst = base.sb_cat3(gst, " ", gt[ti]); ti = ti + 1; }
            append(g_ll_globals, gnm);
            append(g_ll_globalsts, gst);
            ll_set_st("@" + gnm, gst);
        }
        gi = gi + 1;
    }
    // 函数签名 + 变体/main/命名类型收集（与 translate 第 1 遍一致）
    var fi: i64 = 0;
    var fn_count: i64 = slice_len(module.funcs) as i64;
    while (fi < fn_count) {
        var f: TIRFunc = module.funcs[fi];
        var head: StringBuilder = sb_new();
        if (f.is_extern) { sb_append_str(head, "extern "); } else { sb_append_str(head, "func "); }
        sb_append_str(head, "@"); sb_append_str(head, f.name);
        sb_append_str(head, "(");
        var pi: i64 = 0; var pn: i64 = slice_len(f.params) as i64;
        while (pi < pn) { if (pi > 0) { sb_append_str(head, ", "); } sb_append_str(head, f.params[pi]); pi = pi + 1; }
        sb_append_str(head, "): "); sb_append_str(head, f.ret_st);
        if (f.is_main) { sb_append_str(head, " @main"); }
        ll_parse_func(sb_to_str(head));
        var fnm: string = g_pf_name;
        var ffi: i64 = ll_find(fnm, "_from_");
        if (ffi >= 0 && ffi + 6 <= str_len(fnm)) {
            var vn: string = str_slice(fnm, 0, ffi);
            if (str_len(vn) >= 1 && vn[0] >= 65 && vn[0] <= 90) {
                var seen: bool = false; var k2: i64 = 0; var k2n: i64 = slice_len(g_ll_variant_types) as i64;
                while (k2 < k2n) { if (g_ll_variant_types[k2] == vn) { seen = true; break; } k2 = k2 + 1; }
                if (seen == false) { append(g_ll_variant_types, vn); }
            }
        }
        // 入口函数检测：直接用结构化字段 f.is_main（等价于旧路径在 func 头 token 中找 "@main"）。
        // 注意 @main 是头标记 token，不在 g_pf_params（参数表）中，故旧路径的「在参数表里找 @main」写法是错误的。
        if (g_has_main == false && f.is_main) {
            g_has_main = true; g_main_fn = g_pf_name; g_main_ret = g_pf_ret;
        }
        ll_register_named_type(g_pf_ret);
        var pi2: i64 = 0; var plen2: i64 = slice_len(g_pf_params) as i64;
        while (pi2 < plen2) { ll_register_named_type(g_pf_params[pi2 + 1]); pi2 = pi2 + 2; }
        var ps: []string = []; var pi3: i64 = 0; var plen3: i64 = slice_len(g_pf_params) as i64;
        while (pi3 < plen3) { append(ps, g_pf_params[pi3 + 1]); pi3 = pi3 + 2; }
        append(g_func_names, g_pf_name); append(g_func_paramsts, ps);
        fi = fi + 1;
    }
    // 命名类型声明（%Perm 等位标志/枚举，i64 底类型）置于函数之前
    var ni: i64 = 0; var nn: i64 = slice_len(g_ll_named_types) as i64;
    while (ni < nn) { sb_append_str(g_ll, g_ll_named_types[ni]); sb_append_str(g_ll, " = type i64\n"); ni = ni + 1; }
    // 第 2 遍：发射函数体
    var fi2: i64 = 0;
    while (fi2 < fn_count) {
        var f: TIRFunc = module.funcs[fi2];
        if (f.is_extern) { fi2 = fi2 + 1; continue; }
        var head2: StringBuilder = sb_new();
        sb_append_str(head2, "func @"); sb_append_str(head2, f.name); sb_append_str(head2, "(");
        var pj: i64 = 0; var pjn: i64 = slice_len(f.params) as i64;
        while (pj < pjn) { if (pj > 0) { sb_append_str(head2, ", "); } sb_append_str(head2, f.params[pj]); pj = pj + 1; }
        sb_append_str(head2, "): "); sb_append_str(head2, f.ret_st);
        if (f.is_main) { sb_append_str(head2, " @main"); }
        ll_parse_func(sb_to_str(head2));
        ll_emit_func(g_pf_name, g_pf_params, g_pf_ret);
        // ⚠ 函数入口预扫描：把局部 $dst 槽的 alloca 集中在函数入口发射，解决 lazy 分配把 alloca 落进
        // 首次使用块（如 if 分支）导致另一分支引用 undefined / does-not-dominate。所有类型（i*/f*/ptr/arr</vec<
        // 及 % 命名聚合 %TStr/%TSlice/%TPoint 等）均在模块顶部 module.types 处已定义（tir_to_ll_emit 第 1 遍，
        // 早于本函数体），故入口分配尺寸确定、合法。仅跳过空 ST（StringBuilder 等）与 "void"（语句表达式槽）。
        // 注：ll_emit_opaque_defs 在模块末尾补的 %T* opaque 名不被 alloca（仅作 ptr 用），不受影响。
        var pscan: i64 = 0; var pscann: i64 = slice_len(f.body) as i64;
        while (pscan < pscann) {
            var pins: TIRInst = f.body[pscan];
            if (pins.is_comment == false && str_len(pins.dst.name) >= 1 && pins.dst.name[0] == 36) {
                var pst: string = tir_st_to_str(pins.st);
                if (str_len(pst) > 0 && pst != "void") {
                    ll_ensure_slot(pins.dst.name, pst);
                }
            }
            pscan = pscan + 1;
        }
        var bi: i64 = 0; var bn: i64 = slice_len(f.body) as i64;
        while (bi < bn) {
            var inst: TIRInst = f.body[bi];
            if (inst.is_comment) { bi = bi + 1; continue; }
            ll_emit_inst(inst);
            bi = bi + 1;
        }
        sb_append_str(g_ll, "}\n\n");
        fi2 = fi2 + 1;
    }
    sb_append_str(g_ll, sb_to_str(g_ll_declbuf));
    var gi2: i64 = 0; var gn2: i64 = slice_len(g_ll_globals) as i64;
    while (gi2 < gn2) {
        sb_append_str(g_ll, "@"); sb_append_str(g_ll, ll_mangle(g_ll_globals[gi2]));
        sb_append_str(g_ll, " = global "); sb_append_str(g_ll, st_to_ll(g_ll_globalsts[gi2]));
        sb_append_str(g_ll, " zeroinitializer\n"); gi2 = gi2 + 1;
    }
    ll_emit_string_globals();
    ll_flush_clo_thunks();
    sb_append_str(g_ll, sb_to_str(g_clo_constbuf));
    ll_emit_opaque_defs();
    ll_emit_main_wrapper();
    return sb_to_str(g_ll);
}

// 全局 atom 名表（TIR 路径）：@t_atom_table = [M x %TStr]，index 0 占位空串，
// 其后按 sema.g_atom_names 顺序；atom_intern 返回 1-based id → t_atom_table[id] 命中。
// 与旧轨 emit_ll_atom_table 完全一致：运行期 t_atom_str/t_deser_atom 经 extern 引用此表。
// 旧轨此前硬编码 1 元素占位表，导致 :ok/:error/:ready 等真实原子未入表 → atom_str 返回空。
pub fn ll_emit_atom_table() void {
    var cnt: i64 = sema.g_atom_cnt;
    var elems: StringBuilder = sb_new();
    sb_append_str(elems, "%TStr { ptr @.tirll_as0, i64 0 }");   // index 0 占位空串
    var i: i64 = 0;
    while (i < cnt) {
        var esc: string = tir_esc(sema.g_atom_names[i]);
        var blen: i64 = 0;
        var cn: i64 = str_len(esc);
        var ci: i64 = 0;
        while (ci < cn) {
            if (str_at(esc, ci) == 92) { ci = ci + 3; } else { ci = ci + 1; }
            blen = blen + 1;
        }
        sb_append_str(g_ll, "@.tirll_aStr");
        sb_append_i64(g_ll, i);
        sb_append_str(g_ll, " = private unnamed_addr constant [");
        sb_append_i64(g_ll, blen);
        sb_append_str(g_ll, " x i8] c\"");
        sb_append_str(g_ll, esc);
        sb_append_str(g_ll, "\", align 1\n");
        sb_append_str(elems, ", %TStr { ptr @.tirll_aStr");
        sb_append_i64(elems, i);
        sb_append_str(elems, ", i64 ");
        sb_append_i64(elems, blen);
        sb_append_str(elems, " }");
        i = i + 1;
    }
    sb_append_str(g_ll, "@t_atom_table = global [");
    sb_append_i64(g_ll, cnt + 1);
    sb_append_str(g_ll, " x %TStr] [ ");
    sb_append_str(g_ll, sb_to_str(elems));
    sb_append_str(g_ll, " ]\n");
    sb_append_str(g_ll, "@t_atom_count = global i64 ");
    sb_append_i64(g_ll, cnt + 1);
    sb_append_str(g_ll, "\n");
}

// 主入口：消费 tir.tir_to_text() 文本，产出 .ll 文本（保留以兼容旧调用/对照）
pub fn ll_emit_main_wrapper() void {
    if (g_has_main == false) { return; }
    sb_append_str(g_ll, "declare void @t_runtime_init(i32, ptr)\n");
    sb_append_str(g_ll, "declare ptr @t_arena_new()\n");
    sb_append_str(g_ll, "declare void @t_runtime_set_arena(ptr)\n");
    sb_append_str(g_ll, "declare void @t_runtime_done()\n");
    sb_append_str(g_ll, "declare ptr @tll_alloc(i64)\n");
    // 运行期 t_atom_str/t_deser_atom 总是引用 @t_atom_table/@t_atom_count，
    // legacy emit-ll 始终发射（无 atom 时为 1 元素占位）；TIR 路径此前缺此导致链接 undefined symbol。
    sb_append_str(g_ll, "@.tirll_as0 = private unnamed_addr constant [1 x i8] zeroinitializer\n");
    sb_append_str(g_ll, "@.tirll_ats0 = private unnamed_addr constant %TStr { ptr @.tirll_as0, i64 0 }\n");
    // 真实原子名表：按 sema.g_atom_names 顺序发射 [cnt+1 x %TStr]（index 0 占位），使 atom_str 正确解析。
    ll_emit_atom_table();
    // 仅当模块未自带 t.__ginit 时补空实现（模块级全局初始化由 tir.tc 路径暂未生成，留空无害）
    var have_ginit: bool = false;
    var gi_i: i64 = 0;
    var gi_n: i64 = slice_len(g_func_names) as i64;
    while (gi_i < gi_n) {
        if (g_func_names[gi_i] == "t.__ginit") { have_ginit = true; break; }
        gi_i = gi_i + 1;
    }
    if (have_ginit == false) {
        sb_append_str(g_ll, "define void @t.__ginit() {\n  ret void\n}\n");
    }
    sb_append_str(g_ll, "define i32 @main(i32 %argc, ptr %argv) {\n");
    sb_append_str(g_ll, "entry:\n");
    sb_append_str(g_ll, "  call void @t_runtime_init(i32 %argc, ptr %argv)\n");
    sb_append_str(g_ll, "  %a = call ptr @t_arena_new()\n");
    sb_append_str(g_ll, "  call void @t_runtime_set_arena(ptr %a)\n");
    sb_append_str(g_ll, "  call void @t.__ginit(ptr null)\n");
    // wrapper 必须按入口函数真实返回类型调用 @t.<main>，否则与 define 的返回类型不匹配
    // （如 fn main() i64 → define i64 @t.main，但此前硬编码 call i32 触发 LLVM 未定义行为/崩溃）。
    // @main 自身恒返回 i32（进程退出码），故在此把真实返回值收敛到 i32。
    if (g_main_ret == "void") {
        sb_append_str(g_ll, "  call void @t.");
        sb_append_str(g_ll, g_main_fn);
        sb_append_str(g_ll, "(ptr null)\n");
        sb_append_str(g_ll, "  call void @t_runtime_done()\n");
        sb_append_str(g_ll, "  ret i32 0\n");
    } else {
        var rt_ll: string = st_to_ll(g_main_ret);
        sb_append_str(g_ll, "  %r = call ");
        sb_append_str(g_ll, rt_ll);
        sb_append_str(g_ll, " @t.");
        sb_append_str(g_ll, g_main_fn);
        sb_append_str(g_ll, "(ptr null)\n");
        sb_append_str(g_ll, "  call void @t_runtime_done()\n");
        // 整数类返回类型 → trunc 到 i32；i32 本身无需 trunc（LLVM 禁止 trunc 到同类型，否则
        // 生成非法 `trunc i32 %r to i32` → clang -c 失败，连带一大批 fn main() i32 示例整体挂掉）。
        if (rt_ll == "i8" || rt_ll == "i16" || rt_ll == "i64") {
            sb_append_str(g_ll, "  %r2 = trunc ");
            sb_append_str(g_ll, rt_ll);
            sb_append_str(g_ll, " %r to i32\n");
            sb_append_str(g_ll, "  ret i32 %r2\n");
        } else if (rt_ll == "i32") {
            sb_append_str(g_ll, "  ret i32 %r\n");
        } else {
            sb_append_str(g_ll, "  ret i32 0\n");
        }
    }
    sb_append_str(g_ll, "}\n");
}
