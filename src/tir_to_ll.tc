// tir_to_ll: TIR (memory-first linear IR) -> LLVM IR 薄后端（设计 §9.2 / Stage 3）
//

// 设计要点：TIR 是 memory-first（非 SSA）。每个 TIR slot `$x` 映射为 LLVM `alloca`；
// 任意对 $x 的值读取 = `load`，写入 = `store`。LLVM 的 mem2reg/SROA 会自动把
// 这些 alloca 提升回寄存器，故等价性由 TIR 文本保证（设计 §9.2 结论）。
//
// 本模块同时支持两种入口：① `tir_to_ll_translate(text)` 兼容旧文本路径；② `tir_to_ll_emit(module)` 直接消费
// 结构化 TIRModule（§5.6），跨层接口为结构体，不再经 tir.tir_to_text() 文本 round-trip。
// 做两遍扫描：第 1 遍收集函数签名 + 发射 TT 类型；第 2 遍发射函数体。
// 通过新子命令 `emit-tir-ll` 暴露；不动现有 `emit-ll`/`build`，保留自举不动点。

const base = @import("src.base");
const tir = @import("src.tir");   // 结构化入口消费 TIRModule / tir.g_globals_section（tir.tc 不反向导入本模块，无环）
const llname = @import("src.llname");  // ⚠ 飞地规避：命名/槽分配子系统抽到小模块（种子对小模块 100% 正确编译）
// type_info 反射：TIR 轨此前无 typeinfo 处理（仅 direct HIR→LLVM 路径 codegen_ll.emit_type_info_ll 有），
// 导致 tc build 编出的程序里 @__ti_<T> 全局永不发射、type_info(T) 返回 null → 段错误。
// 此处自包含发射 @__ti_<T> 全局常量（与 codegen_ll 同布局），复用 sema/lex 的字段元数据。
const sema = @import("src.sema" :: resolve_type_desc, td_readable);
const lex = @import("src.lex" :: decl_list);
const codegen_c = @import("src.codegen_c" :: is_ref_type, math_is_mbuiltin_c, c_dev_has_kernels);
const codegen_dev = @import("src.codegen_dev" :: emit_device_module);

pub var g_ll: StringBuilder;
pub var g_ll_tmpc: i64;
pub var g_func_names: []string;       // 函数名 -> 参数 ST 列表（供 call 用）
pub var g_func_paramsts: [][]string;
pub var g_ll_extern_funcs: []string;   // 导入库的 external 函数名：登记于 g_func_names 但本模块不 emit 函数体，
                                        // 须由链接期 .tlib 归档提供；emit call 时必须补 declare（否则 LLVM verifier 报 undefined value）。
pub var g_ll_func_rets: []string;     // 兼容保留
pub var g_pf_name: string;            // ll_parse_func 结果（t 不支持多返回值，用全局传递）
pub var g_pf_params: []string;
pub var g_pf_ret: string;
pub var g_ll_declared: []string;       // 已 emit 过 declare 的外部函数名
pub var g_ll_declbuf: StringBuilder;   // 外部 declare 缓冲（函数体扫描后追加到模块末尾）
pub var g_opaque_emitted: []string;    // 已 emit 过 opaque 定义的运行时结构类型名（如 TSb）
// 模块级全局类型表已迁至 src.llname.tc（持久、跨函数不变，经 ll_add_global 填充，ll_reset_slots 回填进 g_ll_names）。
pub var g_in_globals: bool = false;     // 当前是否处于 TIR globals: 段
pub var g_ll_named_types: []string;     // 引用但未在 types: 段声明的命名类型（%Perm 等位标志/枚举，i64 底类型）
pub var g_str_table: []string;          // TIR strings: 段内容（tir_esc 转义后的字面量，可直接用作 LLVM c"..." 内容）
pub var g_in_strings: bool = false;     // 当前是否处于 TIR strings: 段
pub var g_ll_struct_types: []string;     // types: 段内已声明为 struct 的命名类型（%Node 等用户聚合，禁止被误判为 i64 标量）
pub var g_ll_variant_types: []string;    // 变体类型名集合（由 @<V>_from_<C> 构造器在第 1 遍收集），供 struct_new 选择指针/值形态
pub var g_has_main: bool = false;        // TIR 是否含入口函数（@main 标注），用于补 @main 包装器
pub var g_main_fn: string = "";          // 入口函数 LLVM 名（mangled），如 main_fn
pub var g_main_ret: string = "i32";      // 入口函数真实返回类型（wrapper 须按此类型调用，再适配成 i32 给 @main）
pub var g_clo_consts: []string;          // 已发射的「裸函数引用 → %TClosure 常量」全局名（避免重复声明）
pub var g_clo_constbuf: StringBuilder;    // 闭包常量全局声明缓冲（模块末尾统一 emit，避免插进函数体）
pub var g_clo_thunk_req: []string;         // 待生成 thunk 的普通函数名（模块末尾统一生成，确保被包装函数已 emit、ret 已知）
pub var g_cur_sret: string = "";          // 当前函数若以 sret 返回聚合（>16B struct），记录 sret 槽名；否则空串
pub var g_ll_struct_fieldtys: [][]string; // 用户聚合类型名 → 字段存储类型列表（并行 g_ll_struct_types），供 sizeof 计算
pub var g_memcpy_declared: bool = false;
pub var g_ll_valptr: []string;   // 槽名集合：内容为「值字节指针(val_ptr，如 tll_map_val_ptr 返回值)」。
                                  // load 此类槽须解引用（load ptr, ptr (load ptr, ptr %x)）取回真正的值；
                                  // 普通 ptr 槽（如 map_new 句柄）load 只取槽中值本身，两者均属 ptr 类型故需显式标记区分。
pub var g_ll_addrslot: []string;  // 槽名集合：GEP 结果（struct/closure 字段地址，l-value）。
pub var g_ll_addrst: []string;    // 与 g_ll_addrslot 平行：该地址槽的「被指类型」（字段/元素 st）。
                                  // ⚠ 解引用写穿时 store 的类型必须取这里，不能取源值类型 —— 否则
                                  // i32 字段被按 i64 写（8 字节写穿踩坏相邻字段）。
pub var g_ll_clofnslot: []string; // 槽名集合：`getelementptr %TClosure, ..., 0, 0` 的结果（闭包 field0 = code 槽）。
                                  // ⚠ 该槽只能存**裸函数指针**(@fn.__clo_thunk)，不能存闭包全局(@.tirll_clo_fn)：
                                  // call_ind 解包时把 field0 当 code 直接 call；若 field0 存的是 %TClosure 全局地址，
                                  // 控制流会跳进数据段 → 段错误（2026-09-19 回归：closure_demo/func_type_demo/
                                  // lambda_demo/closure_struct_demo/pipeline_demo 5 例 LLVM 后端空输出）。
                                  // 而 fn 类型的**变量/结构体字段**槽存的是 ptr %TClosure（闭包值），二者 st 同为
                                  // ptr<void> / ptr<ptr<void>>，无法按类型区分 → 只能按 GEP 基类型记录来源。
// ── type_info 反射（TIR 轨 @__ti_<T> 全局常量缓冲）──────────────────
pub var g_ti_defs: StringBuilder;     // @__ti_<T> / @__ti_<T>_f / 字段名/类型名字符串常量，模块末尾拼入 g_ll
pub var g_ti_ctors: StringBuilder;   // TypeInfo_from_<Kind> 构造器 define（首用 type_info 时一次性注入）
pub var g_ti_typedefs: StringBuilder; // %TypeMeta / %FieldInfo 具体类型定义（opaque-defs 会把 %T* 误补成 opaque，须先于其注入具体布局）
pub var g_ti_ctors_emitted: bool;    // 构造器 define 是否已注入（去重）
pub var g_ti_done: []string;         // 已发射 @__ti_<T> 的 struct 名（去重，避免重复定义）
pub var g_ti_strc: i64;              // type_info 专属字符串常量计数（前缀 .tis，避免与 @.tirll_tstr / @.sN 撞号）
                                  // 写此类槽须「解引用写穿」：store v, ptr *dst（dst 槽内容是字段地址）；
                                  // 指针变量槽不是地址槽，store 直接把值拷进槽（store v, ptr dst）。
                                  // ⚠ 区分根因：TIR_OP_STORE 写 GEP 字段时 dst 是临时量(持有地址)，
                                  // 旧逻辑在 src 也为指针时误把值拷进临时量(覆盖地址)→字段永不被写入→闭包捕获读到垃圾。

pub fn ll_tmp() string {
    var v: i64 = g_ll_tmpc;
    g_ll_tmpc = v + 1;
    return base.sb_cat3("%", llname__g_ll_curfn, base.sb_cat2(".llt", base.i2s(v)));
}

pub fn ll_reset() void {
    g_ll = sb_new();
    g_ll_tmpc = 0;
    llname.ll_reset_slots();   // ⚠ 飞地规避：槽状态(g_ll_names/g_ll_sts/g_ll_emitted/g_ll_curfn)在 llname.tc，经本函数重置
    g_func_names = [];
    g_func_paramsts = [];
    g_ll_extern_funcs = [];
    g_ll_func_rets = [];
    g_pf_name = "";
    g_pf_params = [];
    g_pf_ret = "void";
    g_ll_declared = [];
    g_ll_declbuf = sb_new();
    g_opaque_emitted = [];
    llname__g_ll_globals = [];
    llname__g_ll_globalsts = [];
    llname__g_ll_global_keys = [];
    llname__g_ll_global_sts = [];
    g_in_globals = false;
    g_str_table = [];
    g_in_strings = false;
    g_ll_struct_types = [];
    g_ll_variant_types = [];
    g_ll_named_types = [];
    g_has_main = false;
    g_main_fn = "";
    g_main_ret = "i32";
    g_clo_consts = [];
    g_clo_constbuf = sb_new();
    g_cur_sret = "";
    g_ll_struct_fieldtys = [];
    g_ll_valptr = [];
    g_ll_addrslot = [];
    g_ll_addrst = [];
    g_memcpy_declared = false;
}

// @name 是否为已声明的函数（避免把函数名误当作全局变量声明）
// ⚠ ll_strip_suf/ll_get_st/ll_set_st/ll_llname/ll_llname_ptr 已迁至 src.llname.tc（飞地规避小模块）
pub fn ll_is_func(name: string) bool {
    var n: i64 = slice_len(g_func_names) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (g_func_names[i] == name) { return true; }
        i = i + 1;
    }
    return false;
}

// 裸函数引用（如 @__lam_4）作为「闭包值」使用时（call 实参 / ret 返回值），
// 必须包装成 %TClosure { ptr @fn, ptr null } 方能接入 call_ind 的 code/env 解包 ABI
// （否则 call_ind 会把函数机器码首字节当 code 指针 → 段错误）。
// 返回一个指向该常量 %TClosure 的全局符号名（opaque ptr，可作 ptr<void> 用）。

// 标记/查询某槽是否为「值字节指针(val_ptr)」：内容是 ptr，load 该槽须二次解引用取回值。
pub fn ll_mark_valptr(name: string) void {
    name = llname.ll_strip_suf(name);
    var n: i64 = slice_len(g_ll_valptr) as i64;
    var i: i64 = 0;
    while (i < n) { if (g_ll_valptr[i] == name) { return; } i = i + 1; }
    append(g_ll_valptr, name);
}
pub fn ll_is_valptr(name: string) bool {
    name = llname.ll_strip_suf(name);
    var n: i64 = slice_len(g_ll_valptr) as i64;
    var i: i64 = 0;
    while (i < n) { if (g_ll_valptr[i] == name) { return true; } i = i + 1; }
    return false;
}
// 标记/查询某槽是否为「GEP 地址槽（l-value）」：store 该槽须解引用写穿（store v, ptr *dst），
// 而非把值拷进槽本身。指针变量槽不是地址槽（store 直接拷进槽）。详见 g_ll_addrslot 注释。
pub fn ll_mark_addrslot(name: string, st: string) void {
    name = llname.ll_strip_suf(name);
    var n: i64 = slice_len(g_ll_addrslot) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (g_ll_addrslot[i] == name) { g_ll_addrst[i] = st; return; }
        i = i + 1;
    }
    append(g_ll_addrslot, name);
    append(g_ll_addrst, st);
}
// 取地址槽的「被指类型」（字段/元素 st）；非地址槽返回 ""。
pub fn ll_addrst_of(name: string) string {
    name = llname.ll_strip_suf(name);
    var n: i64 = slice_len(g_ll_addrslot) as i64;
    var i: i64 = 0;
    while (i < n) { if (g_ll_addrslot[i] == name) { return g_ll_addrst[i]; } i = i + 1; }
    return "";
}
// 把标量值 v（当前类型 vst）换算为目标标量类型 want，返回换算后的值名（无需换算则原样返回）。
// ⚠ 仅做宽度换算：整型↔浮点不在此自动转换（须由 TIR 显式 cast 指令完成）。
pub fn ll_coerce_scalar(v: string, vst: string, want: string) string {
    if (want == "" || vst == want) { return v; }
    if (ll_is_scalar_st(vst) == false || ll_is_scalar_st(want) == false) { return v; }
    if (base.ll_bits(vst) == base.ll_bits(want)) { return v; }
    var opcode: string = "";
    if (ll_is_float(want) && ll_is_float(vst)) {
        if (base.ll_bits(vst) > base.ll_bits(want)) { opcode = "fptrunc"; } else { opcode = "fpext"; }
    } else if (ll_is_float(want) == false && ll_is_float(vst) == false) {
        opcode = "trunc";
        if (vst == "i1" && ll_is_int(want)) {
            // ⚠ base.ll_bits("i1") 兜底返回 64，会误判「源比目标宽」→ 错发 trunc i1 to i8（非法）。
            // i1→任意整型一律 zext（bool 0/1 → 0/1）；sext 会把 1 扩成 -1。
            opcode = "zext";
        } else if (base.ll_bits(vst) < base.ll_bits(want)) {
            if (ll_is_unsigned_st(vst)) { opcode = "zext"; } else { opcode = "sext"; }
        }
    }
    if (opcode == "") { return v; }
    var conv: string = ll_tmp();
    sb_append_str(g_ll, "  ");
    sb_append_str(g_ll, conv);
    sb_append_str(g_ll, " = ");
    sb_append_str(g_ll, opcode);
    sb_append_str(g_ll, " ");
    sb_append_str(g_ll, llname.st_to_ll(vst));
    sb_append_str(g_ll, " ");
    sb_append_str(g_ll, v);
    sb_append_str(g_ll, " to ");
    sb_append_str(g_ll, llname.st_to_ll(want));
    sb_append_str(g_ll, "\n");
    return conv;
}
pub fn ll_is_addrslot(name: string) bool {
    name = llname.ll_strip_suf(name);
    var n: i64 = slice_len(g_ll_addrslot) as i64;
    var i: i64 = 0;
    while (i < n) { if (g_ll_addrslot[i] == name) { return true; } i = i + 1; }
    return false;
}
// 发射「裸函数引用 → %TClosure 常量」。retst 为被包装函数的真实返回类型（用于 thunk 转发）。
// 统一 TClosure ABI：CALL_IND 总是 code(env, args)。
//   - 合成闭包函数（params[0]=="$__env"）：code 直接是它（env 是其真实首参），不产生 thunk。
//   - 普通函数（无 env 首参）：生成 @fn.__clo_thunk(ptr %__env, <params...>) 转发，避免 code(env, a, b)
//     把 env 当首参塞给无 env 函数导致 ABI 错乱（func_type_demo/lambda_demo 的 f(3,4) 返回垃圾根因）。
pub fn ll_emit_closure_const(fnname: string, retst: string) string {
    var sym: string = "@" + fnname;            // 含 @ 前缀，如 @__lam_4
    var gname: string = "@.tirll_clo_" + fnname;
    var n: i64 = slice_len(g_clo_consts) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (g_clo_consts[i] == fnname) { return gname; }
        i = i + 1;
    }
    append(g_clo_consts, fnname);
    var params: []string = ll_lookup_params(fnname);
    var has_env: bool = (slice_len(params) as i64 >= 1 && params[0] == "ptr<void>");
    if (has_env) {
        sb_append_str(g_clo_constbuf, gname);
        sb_append_str(g_clo_constbuf, " = global %TClosure { ptr ");
        sb_append_str(g_clo_constbuf, sym);
        sb_append_str(g_clo_constbuf, ", ptr null }\n");
        return gname;
    }
    // 普通函数 → 延迟到模块末尾生成 thunk（ret 在全部函数 emit 后才已知；
    // store/ret 引用时该函数可能尚未 emit，立即生成会得到空返回类型）。
    append(g_clo_thunk_req, fnname);
    return gname;
}

// 返回函数对应的「code 指针」：供 store 处理器写 closure.field0（CALL_IND 解包后直接调用）。
// 普通函数经 thunk（env 首参适配）；合成闭包（has_env）即其裸函数名。
// 注意：与 ll_emit_closure_const 不同，本函数返回 code（函数指针），而非 %TClosure 全局（闭包值）。
// 根因：store 处理器若把「%TClosure 全局」写进 field0，则 field0 成了「指向闭包的指针」而非 code，
// CALL_IND 把该数据地址当函数入口 → 段错误。field0 必须是 code（@fn 或 @fn.__clo_thunk）。
pub fn ll_closure_code(mref: string) string {
    ll_emit_closure_const(mref, "");   // 登记 thunk 需求（延迟生成，确保 ret 已知）
    var params: []string = ll_lookup_params(mref);
    var has_env: bool = (slice_len(params) as i64 >= 1 && params[0] == "ptr<void>");
    if (has_env) { return "@" + mref; }
    return "@" + mref + ".__clo_thunk";
}

// 模块末尾统一生成「普通函数 → %TClosure 常量」的 thunk 转发（延迟原因见 ll_emit_closure_const）。
// 统一 TClosure ABI：CALL_IND 总是 code(env, args)；聚合返回则 code(sret, env, args)。
// 普通函数无 env 首参、且聚合返回走 LLVM 自动 sret，故 thunk 须适配：
//   - 标量返回：define R @fn.__clo_thunk(ptr %__env, <args>) { %r = call R @fn(<args>); ret R %r }
//   - 聚合返回：define void @fn.__clo_thunk(ptr %__sret, ptr %__env, <args>) { call void @fn(ptr %__sret, <args>); ret; }
//     （显式 sret 首参，与合成闭包聚合返回 ABI 逐字一致，使 CALL_IND 的 (sret, env, args) 调用正确落地。）
pub fn ll_flush_clo_thunks() void {
    var n: i64 = slice_len(g_clo_thunk_req) as i64;
    var i: i64 = 0;
    while (i < n) {
        var fnname: string = g_clo_thunk_req[i];
        var sym: string = "@" + fnname;
        var gname: string = "@.tirll_clo_" + fnname;
        var params: []string = ll_lookup_params(fnname);   // 类型表 [st0, st1, ...]
        var retst: string = ll_lookup_ret(fnname);
        var thunk: string = "@" + fnname + ".__clo_thunk";
        var is_sret: bool = ll_needs_sret(retst);
        // 用户实参串（不含 env / sret）
        var argsb: StringBuilder = sb_new();
        var pi: i64 = 0;
        var pn: i64 = slice_len(params) as i64;
        var first: bool = true;
        while (pi < pn) {
            if (first == false) { sb_append_str(argsb, ", "); }
            if (ll_needs_byval(params[pi])) {
                sb_append_str(argsb, "ptr byval(");
                sb_append_str(argsb, llname.st_to_ll(params[pi]));
                sb_append_str(argsb, ") %__p");
            } else {
                sb_append_str(argsb, llname.st_to_ll(params[pi]));
                sb_append_str(argsb, " %__p");
            }
            sb_append_i64(argsb, pi);
            first = false;
            pi = pi + 1;
        }
        var argstr: string = sb_to_str(argsb);
        if (is_sret) {
            sb_append_str(g_clo_constbuf, "define void ");
            sb_append_str(g_clo_constbuf, thunk);
            sb_append_str(g_clo_constbuf, "(ptr sret(");
            sb_append_str(g_clo_constbuf, llname.st_to_ll(retst));
            sb_append_str(g_clo_constbuf, ") %__sret, ptr %__env");
            if (str_len(argstr) > 0) { sb_append_str(g_clo_constbuf, ", "); sb_append_str(g_clo_constbuf, argstr); }
            sb_append_str(g_clo_constbuf, ") {\n");
            sb_append_str(g_clo_constbuf, "  call void ");
            sb_append_str(g_clo_constbuf, sym);
            sb_append_str(g_clo_constbuf, "(ptr sret(");
            sb_append_str(g_clo_constbuf, llname.st_to_ll(retst));
            sb_append_str(g_clo_constbuf, ") %__sret, ptr %__env");
            if (str_len(argstr) > 0) { sb_append_str(g_clo_constbuf, ", "); sb_append_str(g_clo_constbuf, argstr); }
            sb_append_str(g_clo_constbuf, ")\n");
            sb_append_str(g_clo_constbuf, "  ret void\n}\n");
        } else {
            sb_append_str(g_clo_constbuf, "define ");
            sb_append_str(g_clo_constbuf, llname.st_to_ll(retst));
            sb_append_str(g_clo_constbuf, " ");
            sb_append_str(g_clo_constbuf, thunk);
            sb_append_str(g_clo_constbuf, "(ptr %__env");
            if (str_len(argstr) > 0) { sb_append_str(g_clo_constbuf, ", "); sb_append_str(g_clo_constbuf, argstr); }
            sb_append_str(g_clo_constbuf, ") {\n");
            sb_append_str(g_clo_constbuf, "  %__r = call ");
            sb_append_str(g_clo_constbuf, llname.st_to_ll(retst));
            sb_append_str(g_clo_constbuf, " ");
            sb_append_str(g_clo_constbuf, sym);
            sb_append_str(g_clo_constbuf, "(");
            sb_append_str(g_clo_constbuf, argstr);
            sb_append_str(g_clo_constbuf, ")\n");
            sb_append_str(g_clo_constbuf, "  ret ");
            sb_append_str(g_clo_constbuf, llname.st_to_ll(retst));
            sb_append_str(g_clo_constbuf, " %__r\n}\n");
        }
        sb_append_str(g_clo_constbuf, gname);
        sb_append_str(g_clo_constbuf, " = global %TClosure { ptr ");
        sb_append_str(g_clo_constbuf, thunk);
        sb_append_str(g_clo_constbuf, ", ptr null }\n");
        i = i + 1;
    }
}

// 遇到引用但未声明的 @name 全局：登记为 `global <st> zeroinitializer`，模块末尾统一 emit。
// （tir.tc 暂不建模模块级全局变量声明，此处由翻译器兜底，使 legacy emit-ll 能编译的示例在 TIR 路径同样可编译。）
pub fn ll_register_global(name: string, st: string) void {
    name = llname.ll_strip_suf(name);
    var n: i64 = slice_len(llname__g_ll_globals) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (llname__g_ll_globals[i] == name) { return; }
        i = i + 1;
    }
    llname.ll_add_global(name, llname.st_to_ll(st));
}

// 分支标签：@Lx -> curfn.Lx（LLVM 标签是函数局域，需加函数前缀避免跨函数重名）
pub fn ll_label(name: string) string {
    var s: string = name;
    if (str_len(s) > 0 && s[0] == 64) { s = str_slice(s, 1, str_len(s)); }
    return base.sb_cat2(llname__g_ll_curfn, base.sb_cat2(".", s));
}

// ⚠ ll_mangle / ll_ensure_slot 已迁至 src.llname.tc（飞地规避小模块）。本 wrapper 把小模块返回的
// alloca 文本追加进 g_ll（IR 缓冲留在本模块，避免跨模块写 g_ll）。
pub fn ll_ensure_slot(name: string, st: string) void {
    // ⚠ 标量整数槽一律按 i64 分配。t 的「寄存器」宽度是 i64，运行期内建
    // （tll_str_at / tll_slice_at 等）也返回 i64；若槽按声明的 u8 / i1 / i32
    // 分配成 1~4 字节，就会发生「i64 值写进 1 字节槽」→ 写穿相邻栈槽，
    // 之后 load i64 读到邻居脏数据。实测症状：两个 str_at 结果互比恒不等
    // （`==` 永假 / `!=` 永真）→ ll_find 恒 -1 → 类型定义区整段不发射、
    // 类型退化成 `%TStr = type opaque` + `alloca arr<%TStr x 0>`。
    // 注意：alloca 在序言按名排序发射，早于 STR_AT 处的 i64 请求，
    // 故只能在分配处统一加宽，不能在 STR_AT 处补救。
    // ⚠ 2026-09-28 修正（KI-006 运行时索引 bug）：f32 槽**绝不**在此加宽。
    // 曾误将 f32 槽加宽到 i64 以容纳 GEP_IDX 结果指针(ptr,8B)，但同时把真正的
    // f32 值槽也变成 i64 → load 成 i64 再传给期望 float 的内建(如 __fmt_2) → 值错乱
    // （literal_demo 的 `single` 打印成 0）。正确修法在序言预扫描（见 tir_to_ll_emit
    // 第 2 遍开头）：GEP_IDX 的结果槽承载指针，按 `ptr<elem>`(8B) 分配；其余 f32 值
    // 槽保持 float(4B)，load 仍是 float，不受影响。i64 元素因 ptr<i64> → alloca i64(8B)
    // 本就容纳指针，不受影响。
    var ast: string = st;
    if (ast == "i1" || ast == "bool" || ast == "i8" || ast == "u8" || ast == "i16" || ast == "u16" || ast == "i32" || ast == "u32") { ast = "i64"; }
    sb_append_str(g_ll, llname.ll_emit_alloca(name, ast));
}

// 取切片/字符串基底的「结构地址」(ptr <inner>)，供 tll_slice_at / tll_str_at 使用。
//   - 局部切片变量：base 即 alloca 地址 → 直接可用；
//   - 全局切片：@g 即全局地址 → 直接可用；
//   - member 字段读取 / call 返回值：base 是「值」(inner 值寄存器)，须 alloca+store 物化地址，
//     否则把值当 ptr 传入 → tll_slice_at 解引用读垃圾 len/cap → 越界 panic。
// inner 为聚合类型名（%TSlice / %TStr 等）。
pub fn ll_slice_base_addr(base: string, inner: string) string {
    if (str_len(base) >= 1 && base[0] == 64) { return llname.ll_llname_ptr(base); }   // 全局变量 → 地址
    if (llname.ll_is_emitted(base)) { return llname.ll_llname_ptr(base); }                  // 已 emit 的 alloca → 地址
    // base 是「值」(member 读取 / call 返回值) → 物化地址：alloca inner + store 值
    var baslot: string = ll_tmp();
    ll_ensure_slot(baslot, inner);
    llname.ll_set_st(baslot, inner);
    sb_append_str(g_ll, "  ");
    sb_append_str(g_ll, baslot);
    sb_append_str(g_ll, " = alloca ");
    sb_append_str(g_ll, inner);
    sb_append_str(g_ll, "\n");
    sb_append_str(g_ll, "  store ");
    sb_append_str(g_ll, inner);
    sb_append_str(g_ll, " ");
    sb_append_str(g_ll, llname.ll_llname_ptr(base));
    sb_append_str(g_ll, ", ptr ");
    sb_append_str(g_ll, baslot);
    sb_append_str(g_ll, "\n");
    return baslot;
}

// 取 $x 承载值的 LLVM 寄存器（load 出 alloca）
pub fn ll_load(tname: string, st: string) string {
    var dn: string = tname;   // ⚠ 飞地规避：同 ll_store，缓存避免 clobber
    // 字面量立即数（整数/浮点，如 0 / -1 / 1.5）：直接作为值返回，不可按临时量去 load，
    // 否则会生成非法的 `load X, ptr 0`。裸全局名归一化为 @name 走下方 @ 分支（旧轨对裸全局名补 '@'）。
    if (str_len(dn) >= 1 && dn[0] != 36 && dn[0] != 64) {
        if (llname.ll_is_global(dn)) { dn = "@" + dn; }
        else { return dn; }
    }
    // ⚠ 飞地规避：SLOT 分支被错编无法分配槽；此处（LOAD 分支读名正确）惰性分配局部槽（仅 $ 局部，@ 全局不处理）。
    if (str_len(dn) >= 1 && dn[0] == 36) { ll_ensure_slot(dn, st); }
    // 全局引用 @name（函数或全局变量）：全局符号在 LLVM 中恒为指针，作值操作数时必须 load 出其值。
    // 对函数引用：load ptr, ptr @fn 等价于直接使用 @fn（取其地址）；对全局变量：load 出存储值。两种情形都正确。
    if (str_len(dn) >= 1 && dn[0] == 64) {
        // ⚠ 必须剥 TIR 类型后缀 `.sN`（tir_os 给操作数名附的 ".s<ST码>"）：
        //   ll_register_global 登记全局时剥过，此处不剥 ⇒ 引用写成 @g.s9 而定义是 @g
        //   ⇒ clang: use of undefined value。只有「全局引用且带 st」的路径才触发，故时隐时现。
        //   实测触发点：tir_emit_array_lit 里引用全局 g_cur_line（st=9）
        //   ⇒ 自举一代/二代 build 时 clang 报 1 error ⇒ 整条自举链与 run_examples 连带全红。
        var gnm: string = llname.ll_strip_suf(str_slice(dn, 1, str_len(dn)));
        // 函数引用：符号本身即其地址（ptr 值），直接返回，禁止 load（那会读出函数代码字节而非地址，
        // 用作闭包 code 后 call_ind 调用即段错误）。仅当 @name 确为全局变量时才 load 出其存储值。
        if (ll_is_func(llname.ll_mangle(gnm))) { return "@" + llname.ll_mangle(gnm); }
        // ⚠ 优先用 globals 段已注册的真实全局类型：tir 侧 tir_expr_st 对向量全局会回退 i64，
        // 若直接以 i64 重注册会覆盖正确类型 → reduce/vlen 内建解析 N=0、逐元素运算类型错配。
        var reqst: string = st;   // 调用方原始请求类型（gst 覆写 st 前先存住，供下方地址判定）
        var gst: string = llname.ll_get_st("@" + gnm);
        if (llname.ll_starts(gst, "vec<") || llname.ll_starts(gst, "arr<") || llname.ll_starts(gst, "%")) { st = gst; }
        ll_register_global(gnm, st);
        // ⚠ 全局是值类型（struct/slice/i64…）但调用方按指针取（reqst 为 ptr<…>）→ 返回全局地址，不 load。
        // 否则（全局本身是 ptr 变量，或调用方要值）才 load 出值。否则会把结构体值当 ptr 传入 → "expected ptr"。
        // ⚠ 必须用 reqst（覆写前的请求类型）判定：gst 为 '%' 结构体时会把 st 覆写成值类型，导致丢失 ptr 信号。
        // ⚠ 句柄型全局（StringBuilder 等：类型串以 '*' 结尾，如 %TSb*）本身就是指针值，
        // 即便调用方按 ptr 取也必须 load 出句柄本身，不可返回槽位地址：
        // 返回 &slot 会让 shim 把「槽位」当 TSb 结构体读，b->arena 落到槽位相邻字节（常为 0）
        // → t_arena_alloc(NULL) → ACCESS_VIOLATION READ @0x10。
        var gst_is_ptr: bool = llname.ll_starts(gst, "ptr");
        if (str_len(gst) >= 1 && str_slice(gst, str_len(gst) - 1, str_len(gst)) == "*") { gst_is_ptr = true; }
        if (gst != "" && gst_is_ptr == false && llname.ll_starts(reqst, "ptr")) {
            return "@" + llname.ll_mangle(gnm);
        }
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = load ");
        sb_append_str(g_ll, llname.st_to_ll(st));
        sb_append_str(g_ll, ", ptr @");
        sb_append_str(g_ll, llname.ll_mangle(gnm));
        sb_append_str(g_ll, "\n");
        return r;
    }
    // ⚠ 按槽真实 alloca 宽度(realst)加载，再按需转换到请求类型 st：
    // 对抗「f32 实参被 alloca 成 double 后又 ll_set_st retag 成 float」导致 ll_get_st 失真、
    // 按 st=float 误读 double 槽低位字节 → math fabsf/fmin_f/fmax_f/copysign_f 返回 0。
    var realst: string = llname.ll_alloca_st(dn);
    if (realst == "") { realst = st; }
    var r: string = ll_tmp();
    sb_append_str(g_ll, "  ");
    sb_append_str(g_ll, r);
    sb_append_str(g_ll, " = load ");
    sb_append_str(g_ll, llname.st_to_ll(realst));
    sb_append_str(g_ll, ", ptr ");
    sb_append_str(g_ll, llname.ll_llname_ptr(dn));
    sb_append_str(g_ll, "\n");
    if (realst != st) {
        // ⚠ 浮点互转（f32↔f64）。
        if ((realst == "float" || realst == "double") && (st == "float" || st == "double")) {
            var r2: string = ll_tmp();
            sb_append_str(g_ll, "  "); sb_append_str(g_ll, r2);
            sb_append_str(g_ll, " = ");
            if (realst == "double") { sb_append_str(g_ll, "fptrunc double "); } else { sb_append_str(g_ll, "fpext float "); }
            sb_append_str(g_ll, r); sb_append_str(g_ll, " to "); sb_append_str(g_ll, llname.st_to_ll(st)); sb_append_str(g_ll, "\n");
            return r2;
        }
        // ⚠ 整型按槽真实宽度加载后，对齐到请求类型 st（zext/sext/trunc）。否则窄量(如 i8 char)以
        // 原始宽度传给期望 i64 的内建/函数（sb_append_char/tll_*）会 "defined with type 'i8' but expected 'i64'"。
        if (ll_is_int(realst) && ll_is_int(st)) {
            // ⚠ 按【声明类型】而非槽位分配类型选 sext/zext：u8/u16/u32 的值槽可能保留窄类型
            //   （i8/i16/i32），而变量最终槽被 ll_ensure_slot 加宽为 i64；若按 i8 决策会把无符号
            //   窄量错误 sext 成负数（fid_read: c:u8=200 → -56）。仅当声明类型确为无符号窄量且位宽
            //   与槽位一致时改用 zext，其余保持原行为。
            var fromst: string = realst;
            var declst: string = llname.ll_get_st(dn);
            if (declst == "u8" || declst == "u16" || declst == "u32") {
                if (ll_int_bits(declst) == ll_int_bits(realst)) { fromst = declst; }
            }
            return ll_coerce_to(r, fromst, st);
        }
    }
    return r;
}

// 强制以 ptr 类型从槽加载：variant/句柄类局部常被 ll_alloca_st 误登记为 i64（variant 槽的 LLVM 存储类型
// 退化成标量），但 64 位下 ptr 与 i64 同位宽，load ptr 合法且正是 ti_*/fi_* 内建所需的 variant 槽指针
// （指向 24B variant 数据 / FieldInfo 数据）。若按 ll_load 的类型推断会错发 load i64，进而在
// getelementptr i8, ptr <i64> 上被 clang 拒（"defined with type 'i64' but expected 'ptr'"）。
pub fn ll_load_ptr_slot(tname: string) string {
    var dn: string = tname;
    if (str_len(dn) >= 1 && (dn[0] == 36 || dn[0] == 64)) { llname.ll_set_st(dn, "ptr"); }
    var nm: string = llname.ll_llname(dn);
    var r: string = ll_tmp();
    sb_append_str(g_ll, "  ");
    sb_append_str(g_ll, r);
    sb_append_str(g_ll, " = load ptr, ptr ");
    sb_append_str(g_ll, nm);
    sb_append_str(g_ll, "\n");
    return r;
}

pub fn ll_store(tname: string, st: string, val: string) void {
    var dn: string = tname;   // ⚠ 飞地规避：tname 在错编模块内被寄存器复用（clobber），缓存一次保证 alloca 与 store 文本同名
    // 裸全局名归一化为 @name（旧轨对裸全局名补 '@'），使其走下方 @ 分支（登记全局、不分配局部槽）。
    if (str_len(dn) >= 1 && dn[0] != 36 && dn[0] != 64 && dn[0] != 37 && llname.ll_is_global(dn)) {
        dn = "@" + dn;
    }
    if (str_len(dn) >= 1 && dn[0] == 64) {
        var gnm: string = str_slice(dn, 1, str_len(dn));
        if (ll_is_func(gnm) == false) { ll_register_global(gnm, st); }
    } else {
        // ⚠ 飞地规避：SLOT 分支被错编无法分配槽；此处（STORE 分支读名正确）惰性分配局部槽。
        // ll_ensure_slot 自带 g_ll_names 去重，重复调用安全。
        ll_ensure_slot(dn, st);
    }
    sb_append_str(g_ll, "  store ");
    sb_append_str(g_ll, llname.st_to_ll(st));
    sb_append_str(g_ll, " ");
    sb_append_str(g_ll, val);
    sb_append_str(g_ll, ", ptr ");
    sb_append_str(g_ll, llname.ll_llname_ptr(dn));
    sb_append_str(g_ll, "\n");
}

// 把已加载的值 v（实际类型 fromst）拓宽/截断到目标类型 tost，返回新临时量名。
// 用于比较/算术等操作数类型对齐：ll_load 按槽真实宽度 realst 装载，可能 ≠ 指令 st
// （如 i32 变量被 promote 进 i64 槽），直接 icmp st 会 "defined with type X but expected Y"。
pub fn ll_int_bits(st: string) i64 {
    // ⚠ i1 必须显式给出位宽 1：base.awi_bits("i1") 因 1 < base.awi_min_bits("i1") 返回 -1，
    // 若落到 0 ⇒ ll_coerce_to 走 `fb == 0` 早退、跳过宽度对齐 ⇒ i1 槽（比较结果）被原样
    // 喂给期望 i64 的指令，clang 报 "defined with type 'i1' but expected 'i64'"
    //（复现：match (n > 0) { true => .., false => .. }，即值 if 的脱糖形态）。
    if (st == "i1") { return 1; }
    if (st == "bool" || st == "u8" || st == "i8") { return 8; }
    if (st == "u16" || st == "i16") { return 16; }
    if (st == "u32" || st == "i32") { return 32; }
    if (st == "u64" || st == "i64") { return 64; }
    // 任意位宽整数（AWI）：i<N> / u<N> 的位宽由 base.awi_bits 解析（如 i128/u128 → 128）。
    // ⚠ 此前此处 return 0 使 ll_coerce_to 对 AWI 早退、跳过宽度对齐 → "defined with type 'i64' but expected 'i128'"。
    var ab: i64 = base.awi_bits(st);
    if (ab > 0) { return ab; }
    return 0;
}

pub fn ll_coerce_to(v: string, fromst: string, tost: string) string {
    var ft: string = llname.st_to_ll(fromst);
    var tt: string = llname.st_to_ll(tost);
    if (ft == tt) { return v; }
    // 浮点互转
    if ((ft == "float" || ft == "double") && (tt == "float" || tt == "double")) {
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        if (tt == "float") { sb_append_str(g_ll, " = fptrunc double "); sb_append_str(g_ll, v); sb_append_str(g_ll, " to float\n"); }
        else { sb_append_str(g_ll, " = fpext float "); sb_append_str(g_ll, v); sb_append_str(g_ll, " to double\n"); }
        return r;
    }
    // 整型按位宽截断/符号扩展/零扩展
    var fb: i64 = ll_int_bits(fromst);
    var tb: i64 = ll_int_bits(tost);
    if (fb == 0 || tb == 0 || fb == tb) { return v; }
    var r: string = ll_tmp();
    sb_append_str(g_ll, "  ");
    sb_append_str(g_ll, r);
    if (fb > tb) {
        sb_append_str(g_ll, " = trunc ");
        sb_append_str(g_ll, ft);
        sb_append_str(g_ll, " ");
        sb_append_str(g_ll, v);
        sb_append_str(g_ll, " to ");
        sb_append_str(g_ll, tt);
        sb_append_str(g_ll, "\n");
    } else {
        var op: string = "sext";
        // ⚠ 拓宽按【源】类型有无符号选 sext/zext（此前误用目标类型，导致无符号窄量被错误 sext 成负数）。
        if (ll_is_unsigned_st(fromst)) { op = "zext"; }
        // ⚠ i1 是布尔（值域 {0,1}），拓宽必须 zext：sext i1 1 → -1，会把 true 变成 -1
        // （match (n>0) 等值比较时 -1 != 1 ⇒ 分派恒不命中）。
        if (fromst == "i1") { op = "zext"; }
        sb_append_str(g_ll, " = ");
        sb_append_str(g_ll, op);
        sb_append_str(g_ll, " ");
        sb_append_str(g_ll, ft);
        sb_append_str(g_ll, " ");
        sb_append_str(g_ll, v);
        sb_append_str(g_ll, " to ");
        sb_append_str(g_ll, tt);
        sb_append_str(g_ll, "\n");
    }
    return r;
}

// 按操作数真实类型(ast)装载并强制对齐到运算类型(tst)。用于二元/比较运算：LLVM 要求两操作数
// 类型一致，但整数字面量(如 `a + 1` 中的 1)在 TIR 中以默认 i64 发射，运算类型为 i128 时
// 必须 sext/zext 对齐，否则 "defined with type 'i64' but expected 'i128'"。
// ⚠ 仅对数值类型对齐；非数值(指针/聚合)保持原行为（ll_load(name, tst)）。
pub fn ll_load_coerce(name: string, ast: string, tst: string) string {
    if (str_len(ast) > 0 && (ll_is_int(ast) || ll_is_float(ast)) && llname.st_to_ll(ast) != llname.st_to_ll(tst)) {
        var v: string = ll_load(name, ast);
        return ll_coerce_to(v, ast, tst);
    }
    return ll_load(name, tst);
}

pub fn ll_find(s: string, sub: string) i64 {
    var n: i64 = str_len(s);
    var m: i64 = str_len(sub);
    var i: i64 = 0;
    while (i + m <= n) {
        var j: i64 = 0;
        var ok: bool = true;
        while (j < m) {
            if (str_at(s, i + j) != str_at(sub, j)) { ok = false; break; }
            j = j + 1;
        }
        if (ok) { return i; }
        i = i + 1;
    }
    return -1;
}

// 十进制字符串 → i64（用于 const.str 的索引解析）。忽略非数字前缀；空/非法返回 0。
pub fn ll_atoi(s: string) i64 {
    var n: i64 = str_len(s);
    var i: i64 = 0;
    var v: i64 = 0;
    var neg: bool = false;
    if (n >= 1 && str_at(s, 0) == 45) { neg = true; i = 1; }   // '-'
    while (i < n) {
        var c: i64 = str_at(s, i);
        if (c < 48 || c > 57) { break; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    if (neg) { v = 0 - v; }
    return v;
}

// 计算 tir_esc 转义串的原始字节长度（\XX 计 1 字节，其余计 1 字节）
pub fn ll_str_rawlen(content: string) i64 {
    var cn: i64 = str_len(content);
    var ci: i64 = 0;
    var blen: i64 = 0;
    while (ci < cn) {
        if (str_at(content, ci) == 92) { ci = ci + 3; } else { ci = ci + 1; }
        blen = blen + 1;
    }
    return blen;
}

// ⚠ ll_rfind/ll_starts/st_to_ll 已迁至 src.llname.tc（飞地规避小模块），此处经 import 解析。

// 收集引用但未在 types: 段声明的命名类型（%Perm 等位标志/枚举，i64 底类型）。
// 排除运行期结构类型 %T*（%TStr 等已由 types: 段或 opaque 处理）。
// 类型是否已由 types: 段声明为 struct（%Node 等用户聚合），若是则不应被盖成 i64 标量。
pub fn ll_is_struct_type(st: string) bool {
    var n: i64 = slice_len(g_ll_struct_types) as i64;
    var i: i64 = 0;
    while (i < n) { if (g_ll_struct_types[i] == st) { return true; } i = i + 1; }
    return false;
}

// 聚合返回 ABI（Win64 / Microsoft x64 calling convention）：
// ≤8B 结构在 RAX 单寄存器返回；>8B 且 ≤16B 的结构（16B 的 %TStr/%TClosure）在 RAX:RDX 寄存器对返回；
// >16B 的结构（32B 的 %TSlice、更大的 %tir__TIRModule 等）必须经由 sret 隐藏指针返回（首参让位给 sret 槽地址）。
// 阈值取 >16 与 MSVC/clang 编译 C runtime 的 ABI 逐字一致：t_str_slice / t_file_read_all 等返回 %TStr 的
// 运行时函数按 RAX:RDX 返回（非 sret），编译器若误用 sret 会把返回值错位 → TStr.len 读到垃圾 → arena 2^47 OOM。
// ⚠ 此前误改为 >8，把 16B %TStr/%TClosure 也强行 sret，与 C runtime 的 RAX:RDX 返回约定冲突，致自举 OOM。
// 旧轨（codegen_ll）对聚合返回函数不加 env 形参，sret 隐式占用 arg0 因此工作；
// 新轨统一前置 `ptr %__env.in` 会与 sret 隐式指针在 arg0 冲突 → 必须显式 sret 并把 env 后移。
pub fn ll_sizeof_st(st: string) i64 {
    if (st == "i1" || st == "i8") { return 1; }
    if (st == "i16") { return 2; }
    if (st == "i32" || st == "float") { return 4; }
    if (st == "i64" || st == "double") { return 8; }
    if (llname.ll_starts(st, "ptr")) { return 8; }
    if (st == "%TSlice") { return 32; }
    if (st == "%TStr" || st == "%TClosure") { return 16; }
    if (llname.ll_starts(st, "[")) {
        var bx: i64 = ll_find(st, " x ");
        if (bx > 0) {
            var nstr: string = str_slice(st, 1, bx);
            var n: i64 = ll_atoi(nstr);
            var t: string = str_slice(st, bx + 3, str_len(st) - 1);
            return n * ll_sizeof_st(t);
        }
        return 8;
    }
    if (llname.ll_starts(st, "%")) {
        var i: i64 = 0;
        var n: i64 = slice_len(g_ll_struct_fieldtys) as i64;
        while (i < n) {
            if (g_ll_struct_fieldtys[i][0] == st) {
                var fs: []string = g_ll_struct_fieldtys[i];
                var j: i64 = 1;
                var m: i64 = slice_len(fs) as i64;
                var total: i64 = 0;
                while (j < m) { total = total + ll_sizeof_st(fs[j]); j = j + 1; }
                return total;
            }
            i = i + 1;
        }
        return 8;
    }
    return 8;
}

pub fn ll_needs_sret(st: string) bool {
    if (st == "void" || str_len(st) == 0) { return false; }
    // Win64：>16 字节聚合必须 sret 返回（≤16B 的 %TStr/%TClosure 在 RAX:RDX 返回，无需 sret）。
    if (llname.ll_starts(st, "%") || llname.ll_starts(st, "[")) { return ll_sizeof_st(st) > 16; }
    return false;
}

// 按值传参的 byval 阈值（Win64 / Microsoft x64 calling convention）：Win64 有 4 个整数寄存器
// (RCX/RDX/R8/R9)，一个 8B 对齐的结构体每 8B 占一个寄存器。≤32B 聚合（%TSlice=32B）正好填满
// 4 个寄存器、按值传；>32B（%tir__TIRModule）超出寄存器预算，必须走 byval 隐藏指针——否则被当成
// 寄存器值解包 → 字段被指针覆盖崩溃。阈值取 >32 与 MSVC/clang 编译 C runtime 的 ABI 逐字一致。
// ⚠ 此前误改为 >8，把 16B %TStr/%TClosure 也强行 byval，与 C runtime 的「≤16B 按值传(RAX:RDX)」
// 约定冲突，致自举 OOM（read_file 返回的 %TStr 被按指针误读 → 2^47）。
pub fn ll_needs_byval(st: string) bool {
    if (str_len(st) == 0) { return false; }
    if (llname.ll_starts(st, "%") || llname.ll_starts(st, "[") || llname.ll_starts(st, "arr<") || llname.ll_starts(st, "vec<")) {
        return ll_sizeof_st(st) > 32;
    }
    return false;
}

// call 实参 IR：>8B 聚合走 byval(传槽地址)；其余按值 load。
pub fn ll_call_arg_ir(a: string, pst: string, v: string) string {
    if (ll_needs_byval(pst)) {
        return base.sb_cat5("ptr byval(", llname.st_to_ll(pst), ")", " ", llname.ll_llname(a));
    }
    return base.sb_cat3(llname.st_to_ll(pst), " ", v);
}

// declare 用的形参类型串：>8B 聚合补 byval 属性（st_to_ll 对未知串原样透传 → 合法 IR "ptr byval(%T)"）。
pub fn ll_declarg_ty(pst: string) string {
    if (ll_needs_byval(pst)) { return base.sb_cat3("ptr byval(", llname.st_to_ll(pst), ")"); }
    return pst;
}

// LLVM 标量整数类型判定（st_to_ll 结果）。用于 bitcast 在 i64↔ptr 时改发 inttoptr/ptrtoint
// （bitcast 不允许整型与指针互转）。
pub fn ll_llty_is_int(ty: string) bool {
    return ty == "i1" || ty == "i8" || ty == "i16" || ty == "i32" || ty == "i64";
}

// 判定命名类型 tyname（"%Shape" / "%TSlice"）是否为变体。变体值以指针形态流转，
// struct_new 据此分配后端聚合并让目标 slot 持有指向它的指针。第 1 遍由 @<V>_from_<C> 收集。
pub fn ll_is_variant(tyname: string) bool {
    var vn: string = tyname;
    if (str_len(vn) >= 1 && vn[0] == 37) { vn = str_slice(vn, 1, str_len(vn)); }
    var n: i64 = slice_len(g_ll_variant_types) as i64;
    var i: i64 = 0;
    while (i < n) { if (g_ll_variant_types[i] == vn) { return true; } i = i + 1; }
    return false;
}


// 「用户是否真的声明了这个具名类型？」——纠正「%T 前缀 ⇒ 运行期结构」的旧启发式。
// 旧写法把任何 %T*** 一律当成 %TStr/%TSlice 一族运行期结构跳过登记，于是用户写的
// `enum Two : u8` / `struct Token` 等（名字以大写 T 起头）永远不会 emit `%Two = type i64`，
// 最后被 ll_emit_opaque_defs 兜底成 `%Two = type opaque` —— 该类型一旦作形参，
// clang 就报 "invalid type for function argument"（%NoB 这种非 T 起头的同名代码却正常）。
// 判定口径与 tir.t_td_is_variant / t_td_is_enum 一致：回查 decl_list 的用户类型声明。
pub fn ll_is_user_named_type(fname: string) bool {
    if (fname == "") { return false; }
    var n: i64 = slice_len(lex__decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = lex__decl_list[i];
        var kd: string = base.node_kind((d as u64));
        if (kd == "StructDecl" || kd == "EnumDecl" || kd == "VariantDecl"
                || kd == "UnionDecl") {
            if (base.node_sa((d as u64)) == fname) { return true; }
        }
        i = i + 1;
    }
    return false;
}

pub fn ll_register_named_type(st: string) void {
    // 仅处理命名类型（%X）；且须排除 types: 段已声明为 struct 的用户聚合
    // （%Node 等）——那些已是正确 struct 定义，不可再被盖成 `type i64`。
    // ⚠ 不可再用 `llname.ll_starts(st,"%T")==false` 排除运行期结构：那会连带排除掉「名字以 T 起头的
    // 用户类型」。改为：%T 起头时，只有当它确实不是用户声明的类型才按运行期结构跳过。
    if (llname.ll_starts(st, "%") && ll_is_struct_type(st) == false) {
        var rskip: bool = false;
        if (llname.ll_starts(st, "%T")) {
            var uname: string = str_slice(st, 1, str_len(st));
            if (ll_is_user_named_type(uname) == false) { rskip = true; }
        }
        if (rskip == false) {
            var n: i64 = slice_len(g_ll_named_types) as i64;
            var i: i64 = 0;
            var seen: bool = false;
            while (i < n) {
                if (g_ll_named_types[i] == st) { seen = true; break; }
                i = i + 1;
            }
            if (seen == false) { append(g_ll_named_types, st); }
        }
    }
}

pub fn ll_arg_types(args: string) string {
    if (str_len(args) == 0) { return ""; }
    var out: StringBuilder = sb_new();
    var n: i64 = str_len(args);
    var i: i64 = 0;
    var cur: StringBuilder = sb_new();
    var first: bool = true;
    while (i < n) {
        var c: i64 = str_at(args, i);
        if (c == 44) {   // ','
            if (first == false) { sb_append_str(out, ", "); }
            sb_append_str(out, llname.st_to_ll(sb_to_str(cur)));
            cur = sb_new();
            first = false;
        } else {
            sb_append_char(cur, c);
        }
        i = i + 1;
    }
    if (first == false) { sb_append_str(out, ", "); }
    sb_append_str(out, llname.st_to_ll(sb_to_str(cur)));
    return sb_to_str(out);
}

pub fn ll_ptr_inner(st: string) string {
    // ptr<ST> -> 元素 ST（已转 LLVM 类型）。防御：非 ptr< 前缀（如 gep 值型基址分支传入标量 i64，
    // 或 bitcast 把 ptr<%__env> 擦成 ptr 后）直接整体转译，避免对标量做 str_slice(st,4,...) 越界 panic。
    if (llname.ll_starts(st, "ptr<") == false) { return llname.st_to_ll(st); }
    return llname.st_to_ll(str_slice(st, 4, str_len(st) - 1));
}

// map 实参约定（与 codegen_ll.ll_map_argptr / ll_map_keyptr 对齐）：
// runtime tll_map_* 的 key/val 一律按「指向值存储的指针」传参。三种形态：
//  (1) 槽持有指针（map 字面量降级 addr_of、或前端把键/值包成 ptr<...> 槽）→ load 出真指针值；
//  (2) 槽持有聚合值（%TStr / slice / struct / 命名类型）→ 取其槽地址（alloca 即指向值的 ptr）；
//  (3) 槽持有标量（i64/i32/u8/...）→ canonical 一律按 i64 落库（窄键 i32/u8 也升 i64），
//      故装载后 sext/zext 到 i64 再存 scratch，返回 scratch 地址。
pub fn ll_map_argptr(tname: string, st: string) string {
    if (llname.ll_starts(st, "ptr<") || st == "ptr") {
        // ⚠ 仅用于「字面量降级」路径（tir.tc 已对 map 值做 TIR_OP_ADDR_OF，vp 槽持 &vs）：
        // ll_load 取出 &vs（值存储地址），tll_map_put 据此 memcpy 入库，正确。
        // 「map_set/map_put 内置」路径的值槽持「句柄/指针值本身」（未 addr_of），不能走此分支，
        // 须在其处理器内用 ll_llname_ptr 取 &slot（见 map_set/put handler 的 cn 分支）。
        return ll_load(tname, st);
    }
    if (ll_is_scalar_st(st) == false) {
        return llname.ll_llname_ptr(tname);
    }
    var av: string = ll_load(tname, st);
    var casted: string = av;
    if (llname.st_to_ll(st) != "i64") {
        casted = ll_tmp();
        var opcode: string = "sext";
        if (llname.ll_starts(st, "u") || st == "bool") { opcode = "zext"; }
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, casted);
        sb_append_str(g_ll, " = ");
        sb_append_str(g_ll, opcode);
        sb_append_str(g_ll, " ");
        sb_append_str(g_ll, llname.st_to_ll(st));
        sb_append_str(g_ll, " ");
        sb_append_str(g_ll, av);
        sb_append_str(g_ll, " to i64\n");
    }
    var sc: string = ll_tmp();
    sb_append_str(g_ll, "  ");
    sb_append_str(g_ll, sc);
    sb_append_str(g_ll, " = alloca i64\n");
    sb_append_str(g_ll, "  store i64 ");
    sb_append_str(g_ll, casted);
    sb_append_str(g_ll, ", ptr ");
    sb_append_str(g_ll, sc);
    sb_append_str(g_ll, "\n");
    return sc;
}

pub fn ll_is_int(st: string) bool {
    return llname.ll_starts(st, "i") || llname.ll_starts(st, "u") || st == "bool";
}

// 是否为标量类型（整数/浮点/布尔）。聚合/指针/命名类型返回 false。
pub fn ll_is_scalar_st(st: string) bool {
    if (st == "bool" || st == "i1" || st == "i8" || st == "i16" ||
        st == "i32" || st == "i64" || st == "u8" || st == "u16" ||
        st == "u32" || st == "u64" || st == "f32" || st == "f64" ||
        st == "float" || st == "double") { return true; }
    // 任意位宽整数（AWI）：i<N>/u<N>（N>64，如 i128/u128）也是标量，须被 STORE 宽度换算门禁识别，
    // 否则 `store i128 ..., ptr %x` 被当成非标量跳过 → 高位丢失。
    if ((llname.ll_starts(st, "i") || llname.ll_starts(st, "u")) && base.awi_bits(st) > 64) { return true; }
    return false;
}

pub fn ll_is_float(st: string) bool {
    if (st == "f32" || st == "f64" || st == "float" || st == "double") { return true; }
    // 浮点向量（vec<f32 x N> / vec<f64 x N>）：本身是浮点类型，逐元素算术须走 fadd/fmul/fcmp，
    // 不能当整数（否则 emit 出非法的 `add <2 x double>`，链接期即被 LLVM 拒绝）。
    // 与标量对称：vec 的 cast（sitofp/fpext/fptrunc）在 LLVM 中同样合法，宽化无副作用。
    if (llname.ll_starts(st, "vec<f32") || llname.ll_starts(st, "vec<f64")) { return true; }
    return false;
}

// 无符号整型（用于拓宽时选 zext 而非 sext）。
pub fn ll_is_unsigned_st(st: string) bool {
    if (st == "bool" || st == "u8" || st == "u16" || st == "u32" || st == "u64") { return true; }
    // 任意位宽无符号整数 u<N>（如 u128）：拓宽时须 zext 而非 sext。
    if (llname.ll_starts(st, "u")) { var ab: i64 = base.awi_bits(st); if (ab > 0) { return true; } }
    return false;
}

// 八进制整数字面量 -> 十进制（LLVM IR 不支持 0o755，但支持 0x.. 与十进制）
pub fn ll_oct_to_dec(s: string) string {
    var n: i64 = str_len(s);
    var i: i64 = 2;   // 跳过 "0o"
    if (i >= n) { return "0"; }
    var val: i64 = 0;
    while (i < n) {
        var c: i64 = str_at(s, i);
        var d: i64 = c - 48;   // '0' = 48
        if (d < 0 || d > 7) { d = 0; }
        val = val * 8 + d;
        i = i + 1;
    }
    return base.i2s(val);
}

// 十六进制整数字面量 -> 十进制（裸 0x.. 在 LLVM IR 中易被误判为浮点，转十进制最稳）
pub fn ll_hex_to_dec(s: string) string {
    var n: i64 = str_len(s);
    var i: i64 = 2;   // 跳过 "0x"
    var val: i64 = 0;
    while (i < n) {
        var c: i64 = str_at(s, i);
        var d: i64;
        if (c >= 48 && c <= 57) { d = c - 48; }        // '0'-'9'
        else if (c >= 65 && c <= 70) { d = c - 55; }   // 'A'-'F'
        else if (c >= 97 && c <= 102) { d = c - 87; }  // 'a'-'f'
        else { d = 0; }
        val = val * 16 + d;
        i = i + 1;
    }
    return base.i2s(val);
}

// 二进制整数字面量 -> 十进制（LLVM IR 不支持 0b..）
pub fn ll_bin_to_dec(s: string) string {
    var n: i64 = str_len(s);
    var i: i64 = 2;   // 跳过 "0b"
    if (i >= n) { return "0"; }
    var val: i64 = 0;
    while (i < n) {
        var c: i64 = str_at(s, i);
        var d: i64 = c - 48;   // '0'=48 '1'=49
        if (d < 0 || d > 1) { d = 0; }
        val = val * 2 + d;
        i = i + 1;
    }
    return base.i2s(val);
}

// 归一化立即数：浮点处理 inf/nan，二/八/十六进制转十进制；十进制/负数 LLVM 原生支持
// 判断立即数是否为纯整数字面量（可选前导 '-' + 数字，不含 '.'/'e'/'x' 等）
pub fn ll_imm_is_int(s: string) bool {
    var n: i64 = str_len(s);
    if (n == 0) { return false; }
    var i: i64 = 0;
    if (str_at(s, 0) == 45) { i = 1; }   // '-'
    if (i == n) { return false; }
    while (i < n) {
        var c: i64 = str_at(s, i);
        if (c < 48 || c > 57) { return false; }
        i = i + 1;
    }
    return true;
}

pub fn ll_norm_imm(imm: string, st: string) string {    if (llname.ll_starts(st, "f")) {
        if (imm == "inf") { if (st == "f32") { return "0x7F800000"; } return "0x7FF0000000000000"; }
        if (imm == "-inf") { if (st == "f32") { return "0xFF800000"; } return "0xFFF0000000000000"; }
        if (imm == "nan") { if (st == "f32") { return "0x7FC00000"; } return "0x7FF8000000000000"; }
        // 整数字面量（如 -1、1000）作为浮点常量需补 .0，否则 LLVM 报
        // "integer constant must have integer type"（store double -1 非法）。
        if (ll_imm_is_int(imm)) { return base.sb_cat2(imm, ".0"); }
        return imm;
    }
    // 任意位宽整数（AWI）：LLVM IR 仅接受十进制整数字面量（`0x…` 会被当成十六进制浮点、`0b/0o` 非法），
    // 故把 hex/bin/oct 经任意精度转换（base 1e9 大整数）成十进制，避免 ll_hex/oct/bin_to_dec 用 i64 累积溢出。
    if (base.awi_bits(st) > 64) { return ll_awi_imm_to_dec(imm); }
    if (llname.ll_starts(imm, "0b") || llname.ll_starts(imm, "0B")) { return ll_bin_to_dec(imm); }
    if (llname.ll_starts(imm, "0o") || llname.ll_starts(imm, "0O")) { return ll_oct_to_dec(imm); }
    if (llname.ll_starts(imm, "0x") || llname.ll_starts(imm, "0X")) { return ll_hex_to_dec(imm); }
    return imm;
}

// 任意位宽整数字面量（hex/bin/oct）转十进制：i64 累积会溢出，须 base-1e9 任意精度。
// 输入可为 0x/0X/0b/0B/0o/0O 前缀或纯十进制；可带前导 '-'。返回十进制字符串。
pub fn ll_awi_imm_to_dec(imm: string) string {
    if (str_len(imm) > 0 && str_at(imm, 0) == 45) {
        return base.sb_cat2("-", ll_awi_imm_to_dec(str_slice(imm, 1, str_len(imm))));
    }
    var radix: i64 = 10;
    var s: string = imm;
    if (llname.ll_starts(imm, "0x") || llname.ll_starts(imm, "0X")) { radix = 16; s = str_slice(imm, 2, str_len(imm)); }
    else if (llname.ll_starts(imm, "0b") || llname.ll_starts(imm, "0B")) { radix = 2; s = str_slice(imm, 2, str_len(imm)); }
    else if (llname.ll_starts(imm, "0o") || llname.ll_starts(imm, "0O")) { radix = 8; s = str_slice(imm, 2, str_len(imm)); }
    else { return imm; }   // 已是十进制
    // 1) 任意精度累加到 base-1e9 大整数：big = big*radix + digit
    var limbs: []i64 = [];
    var n: i64 = str_len(s);
    var i: i64 = 0;
    while (i < n) {
        var c: i64 = str_at(s, i);
        var d: i64;
        if (c >= 48 && c <= 57) { d = c - 48; }
        else if (c >= 65 && c <= 70) { d = c - 55; }
        else if (c >= 97 && c <= 102) { d = c - 87; }
        else { d = 0; }
        var carry: i64 = d;
        var j: i64 = 0;
        while (j < slice_len(limbs) as i64) {
            var v: i64 = limbs[j] * radix + carry;
            limbs[j] = v % 1000000000;
            carry = v / 1000000000;
            j = j + 1;
        }
        if (carry > 0) { append(limbs, carry); }
        i = i + 1;
    }
    if (slice_len(limbs) as i64 == 0) { return "0"; }
    // 2) 大整数 ÷10 取余逐位生成十进制（从低位向前拼）
    var out: string = "";
    var alive: bool = true;
    while (alive) {
        var rem: i64 = 0;
        var z: i64 = slice_len(limbs) as i64 - 1;
        while (z >= 0) {
            var val: i64 = rem * 1000000000 + limbs[z];
            limbs[z] = val / 10;
            rem = val % 10;
            z = z - 1;
        }
        out = base.sb_cat2(base.i2s(rem), out);
        alive = false;
        var q: i64 = 0;
        while (q < slice_len(limbs) as i64) { if (limbs[q] != 0) { alive = true; } q = q + 1; }
    }
    return out;
}

// 判断函数是否为「导入库 external」函数（登记于 g_func_names 但本模块不 emit 函数体，
// 函数体由链接期 .tlib 归档提供）。此类函数必须 emit declare 才能被合法 call。
pub fn ll_is_extern_func(name: string) bool {
    var n: i64 = slice_len(g_ll_extern_funcs) as i64;
    var i: i64 = 0;
    while (i < n) { if (g_ll_extern_funcs[i] == name) { return true; } i = i + 1; }
    return false;
}

// 为模块内未定义的被调函数 emit declare（可被多次调用，仅首见时声明一次）
pub fn ll_maybe_declare(fname: string, retst: string, argsts: []string) void {
    var i: i64 = 0;
    var n: i64 = slice_len(g_func_names) as i64;
    while (i < n) {
        // 本模块已定义的函数跳过；但 external（导入库）函数虽登记于 g_func_names，
        // 其体由 .tlib 提供，必须补 declare（否则 call 既无 define 又无 declare → verifier 报 undefined value）。
        if (g_func_names[i] == fname && ll_is_extern_func(fname) == false) { return; }
        i = i + 1;
    }
    var j: i64 = 0;
    var m: i64 = slice_len(g_ll_declared) as i64;
    while (j < m) {
        if (g_ll_declared[j] == fname) { return; }  // 已声明
        j = j + 1;
    }
    append(g_ll_declared, fname);
    var sb: StringBuilder = sb_new();
    var sret_ret: bool = ll_needs_sret(retst);
    sb_append_str(sb, "declare ");
    if (sret_ret) { sb_append_str(sb, "void"); } else { sb_append_str(sb, llname.st_to_ll(retst)); }
    sb_append_str(sb, " @");
    sb_append_str(sb, fname);
    sb_append_str(sb, "(");
    var first: bool = true;
    if (sret_ret) { sb_append_str(sb, "ptr sret("); sb_append_str(sb, llname.st_to_ll(retst)); sb_append_str(sb, ")"); first = false; }
    var k: i64 = 0;
    var am: i64 = slice_len(argsts) as i64;
    while (k < am) {
        if (first == false) { sb_append_str(sb, ", "); }
        sb_append_str(sb, llname.st_to_ll(argsts[k]));
        first = false;
        k = k + 1;
    }
    sb_append_str(sb, ")\n");
    sb_append_str(g_ll_declbuf, sb_to_str(sb));
}

// 发射一条 `call void @fname(...)`（参数类型/值并行给出）。内建降级统一走此helper，
// 避免手写 sb_append_str 时误把 ll_load 的副作用（load 指令）注入到 call 实参中间。
pub fn ll_call_void(fname: string, argsts: []string, argv: []string) void {
    ll_maybe_declare(fname, "void", argsts);
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "  call void @");
    sb_append_str(sb, fname);
    sb_append_str(sb, "(");
    var i: i64 = 0;
    var n: i64 = slice_len(argsts) as i64;
    var first: bool = true;
    while (i < n) {
        if (first == false) { sb_append_str(sb, ", "); }
        sb_append_str(sb, argsts[i]);
        sb_append_str(sb, " ");
        sb_append_str(sb, argv[i]);
        first = false;
        i = i + 1;
    }
    sb_append_str(sb, ")\n");
    sb_append_str(g_ll, sb_to_str(sb));
}

// 发射一条 `call <retst> @fname(...)` 并把结果存入 dest 槽 d（结果类型即 retst）。
pub fn ll_call_ret(fname: string, retst: string, argsts: []string, argv: []string, d: string) void {
    ll_maybe_declare(fname, retst, argsts);
    var r: string = ll_tmp();
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "  ");
    sb_append_str(sb, r);
    sb_append_str(sb, " = call ");
    sb_append_str(sb, retst);
    sb_append_str(sb, " @");
    sb_append_str(sb, fname);
    sb_append_str(sb, "(");
    var i: i64 = 0;
    var n: i64 = slice_len(argsts) as i64;
    var first: bool = true;
    while (i < n) {
        if (first == false) { sb_append_str(sb, ", "); }
        sb_append_str(sb, argsts[i]);
        sb_append_str(sb, " ");
        sb_append_str(sb, argv[i]);
        first = false;
        i = i + 1;
    }
    sb_append_str(sb, ")\n");
    sb_append_str(g_ll, sb_to_str(sb));
    ll_ensure_slot(d, retst); llname.ll_set_st(d, retst); ll_store(d, retst, r);
}

pub fn ll_binop(op: i64) string {
    if (op == tir__TIR_OP_ADD) { return "add"; }
    if (op == tir__TIR_OP_SUB) { return "sub"; }
    if (op == tir__TIR_OP_MUL) { return "mul"; }
    if (op == tir__TIR_OP_SDIV) { return "sdiv"; }
    if (op == tir__TIR_OP_UDIV) { return "udiv"; }
    if (op == tir__TIR_OP_SREM) { return "srem"; }
    if (op == tir__TIR_OP_UREM) { return "urem"; }
    if (op == tir__TIR_OP_AND) { return "and"; }
    if (op == tir__TIR_OP_OR) { return "or"; }
    if (op == tir__TIR_OP_XOR) { return "xor"; }
    if (op == tir__TIR_OP_SHL) { return "shl"; }
    if (op == tir__TIR_OP_LSHR) { return "lshr"; }
    if (op == tir__TIR_OP_ASHR) { return "ashr"; }
    return "add";
}
// 浮点二元助记符：整数 binop 的浮点对应（add.f64 → fadd 等）
pub fn ll_fbinop(op: i64) string {
    if (op == tir__TIR_OP_ADD) { return "fadd"; }
    if (op == tir__TIR_OP_SUB) { return "fsub"; }
    if (op == tir__TIR_OP_MUL) { return "fmul"; }
    if (op == tir__TIR_OP_SDIV || op == tir__TIR_OP_UDIV) { return "fdiv"; }
    if (op == tir__TIR_OP_SREM || op == tir__TIR_OP_UREM) { return "frem"; }
    return "fadd";
}

pub fn ll_icmp(op: i64) string {
    if (op == tir__TIR_OP_SLT) { return "slt"; }
    if (op == tir__TIR_OP_SGT) { return "sgt"; }
    if (op == tir__TIR_OP_SGE) { return "sge"; }
    if (op == tir__TIR_OP_SLE) { return "sle"; }
    if (op == tir__TIR_OP_ULT) { return "ult"; }
    if (op == tir__TIR_OP_UGT) { return "ugt"; }
    if (op == tir__TIR_OP_ULE) { return "ule"; }
    if (op == tir__TIR_OP_UGE) { return "uge"; }
    if (op == tir__TIR_OP_EQ) { return "eq"; }
    if (op == tir__TIR_OP_NE) { return "ne"; }
    return "eq";
}

// 浮点比较谓词（icmp 仅接受整数类型，浮点必须用 fcmp）
pub fn ll_fcmp(op: i64) string {
    if (op == tir__TIR_OP_EQ) { return "oeq"; }
    // `!=` 必须是**无序**比较 `une`：IEEE-754 下 `x != y` 等价于 `!(x == y)`，
    // 故 `nan != nan` 为真。`one` 会在任一侧为 NaN 时返回假，与旧 LLVM 后端（codegen_ll.tc:2061）不一致。
    if (op == tir__TIR_OP_NE) { return "une"; }
    if (op == tir__TIR_OP_SLT) { return "olt"; }
    if (op == tir__TIR_OP_SGT) { return "ogt"; }
    if (op == tir__TIR_OP_SLE) { return "ole"; }
    if (op == tir__TIR_OP_SGE) { return "oge"; }
    if (op == tir__TIR_OP_ULT) { return "ult"; }
    if (op == tir__TIR_OP_UGT) { return "ugt"; }
    if (op == tir__TIR_OP_ULE) { return "ule"; }
    if (op == tir__TIR_OP_UGE) { return "uge"; }
    return "oeq";
}

// 取比较 op 的前缀：无点形式 slti64 -> "slt"（算术用点 slt.i64，比较用无点 slti64）
pub fn ll_cmp_prefix(op: string) string {
    if (llname.ll_starts(op, "slt")) { return "slt"; }
    if (llname.ll_starts(op, "sgt")) { return "sgt"; }
    if (llname.ll_starts(op, "sge")) { return "sge"; }
    if (llname.ll_starts(op, "sle")) { return "sle"; }
    if (llname.ll_starts(op, "ult")) { return "ult"; }
    if (llname.ll_starts(op, "ugt")) { return "ugt"; }
    if (llname.ll_starts(op, "ule")) { return "ule"; }
    if (llname.ll_starts(op, "uge")) { return "uge"; }
    if (llname.ll_starts(op, "eq")) { return "eq"; }
    if (llname.ll_starts(op, "ne")) { return "ne"; }
    return "";
}

// 取 op.ST 的 '.' 分隔位置（op 与 st 在调用处就地拆分，t 不支持多返回值）
pub fn ll_split_dot(s: string) i64 {
    return ll_find(s, ".");
}

// 简单空白分词（先把 ( ) , 换成空格）。类型参数（arr<T x N> / vec<T x N>）内含空格，
// 须按 '<' 深度计数保留其为类型 token 的一部分，否则会被切成 arr<i64 / x / 3> 多个 token，
// 导致函数签名与 bitcast/slot 等指令的类型解析错位（st_to_ll 收到缺 '>' 的残缺类型而越界 panic）。
pub fn ll_tokens(line: string) []string {
    var n: i64 = str_len(line);
    var i: i64 = 0;
    var out: StringBuilder = sb_new();
    var depth: i64 = 0;   // '<' 深度
    while (i < n) {
        var c: i64 = str_at(line, i);
        if (c == 60) { depth = depth + 1; sb_append_char(out, c); }            // '<' 进入类型参数
        else if (c == 62) { if (depth > 0) { depth = depth - 1; } sb_append_char(out, c); }  // '>' 退出
        else if (c == 40 || c == 41 || c == 44) { sb_append_char(out, 32); }   // ( ) , -> space
        else { sb_append_char(out, c); }
        i = i + 1;
    }
    var s2: string = sb_to_str(out);
    var n2: i64 = str_len(s2);
    var j: i64 = 0;
    var buf: StringBuilder = sb_new();
    var toks: []string = [];
    var d2: i64 = 0;   // 第二遍同样按 '<' 深度，避免切分类型参数内的空格
    while (j < n2) {
        var c: i64 = str_at(s2, j);
        if (c == 60) { d2 = d2 + 1; }
        else if (c == 62) { if (d2 > 0) { d2 = d2 - 1; } }
        if ((c == 32 || c == 9 || c == 10 || c == 13) && d2 == 0) {
            if (str_len(sb_to_str(buf)) > 0) {
                append(toks, sb_to_str(buf));
                buf = sb_new();
            }
        } else {
            sb_append_char(buf, c);
        }
        j = j + 1;
    }
    if (str_len(sb_to_str(buf)) > 0) { append(toks, sb_to_str(buf)); }
    return toks;
}

// 解析 func 行，结果写入 g_pf_name / g_pf_params / g_pf_ret（t 不支持多返回值）
pub fn ll_parse_func(line: string) void {
    var toks: []string = ll_tokens(line);   // func @name($a: ST, $b: ST): ST {
    g_pf_name = llname.ll_mangle(str_slice(toks[1], 1, str_len(toks[1])));   // 去 @ 并 LLVM 合法化
    g_pf_params = [];
    g_pf_ret = "void";
    var i: i64 = 2;
    var m: i64 = slice_len(toks) as i64;
    while (i < m) {
        if (toks[i] == ":") {
            g_pf_ret = toks[i + 1];
            break;
        }
        var p: string = toks[i];
        if (str_at(p, str_len(p) - 1) == 58) { p = str_slice(p, 0, str_len(p) - 1); }   // 去末尾 ':'
        append(g_pf_params, p);
        append(g_pf_params, toks[i + 1]);
        i = i + 2;
    }
}

pub fn ll_lookup_params(fname: string) []string {
    var i: i64 = 0;
    var n: i64 = slice_len(g_func_names) as i64;
    while (i < n) {
        if (g_func_names[i] == fname) { return g_func_paramsts[i]; }
        i = i + 1;
    }
    var __ll_empty: []string = [];
    return __ll_empty;
}

// 查函数返回值 LLVM 类型（与 g_func_names 同步 append，见 ll_emit_func）。
pub fn ll_lookup_ret(fname: string) string {
    var i: i64 = 0;
    var n: i64 = slice_len(g_func_names) as i64;
    while (i < n) {
        if (g_func_names[i] == fname) {
            var m: i64 = slice_len(g_ll_func_rets) as i64;
            if (i < m) { return g_ll_func_rets[i]; }
            return "";
        }
        i = i + 1;
    }
    return "";
}

// 运行期内建名 → 链接符号解析：
//   - 用户函数（本模块定义发射，在 g_func_names 中）→ 原名；
//   - tll_* shim / llvm.* 内建 → 原名；
//   - 其余 extern（t 运行库函数，库以 t_<name> 导出：t_args/t_eprint/t_exit/t_file_write_all…）
//     → 补 t_ 前缀；sys_run 特例映射到 tll_system（与 print/eprint 同走 ptr 形参 shim）。
// 此前新后端未做此映射，导致 eprint/args/sys_run/file_write_all/exit 以裸名发射 → 链接期
// "undefined symbol"。对齐 codegen_c 的 t_ 前缀约定与 codegen_ll 的 tll_* shim 约定。
pub fn ll_runtime_callee(fname: string) string {
    if (ll_is_func(fname)) { return fname; }
    if (llname.ll_starts(fname, "tll_") || llname.ll_starts(fname, "llvm.")) { return fname; }
    if (llname.ll_starts(fname, "t_")) { return fname; }
    if (fname == "sys_run") { return "tll_system"; }
    return "t_" + fname;
}

// 全局类型现已持久化（见 src.llname.tc 的 g_ll_global_keys/g_ll_global_sts 与 ll_add_global）：
// pass-1 / ll_register_global 一次性登记，ll_reset_slots 直接回填进 g_ll_names，无需每函数重解析模块全局段。

pub fn ll_emit_func(name: string, params: []string, ret: string) void {
    llname.ll_reset_slots();   // ⚠ 飞地规避：槽状态在 llname.tc，经本函数重置（清 g_ll_names/g_ll_sts/g_ll_emitted/g_ll_curfn）
    llname.ll_set_curfn(name); // 重置后再置当前函数前缀
    g_ll_tmpc = 0;
    append(g_ll_func_rets, ret);
    // 聚合返回 ABI（Win64）：>8B 结构一律经显式 sret 隐藏指针返回（ptr sret(...) 首参），
    // 与 declare / call / 运行时 C ABI 逐字一致。无论是否闭包（env 首参），返回槽都用同一套 sret 机制；
    // 闭包时 sret 占 arg0、env 占 arg1，普通函数 sret 占 arg0、无 env，二者不冲突。
    // ⚠ 此前错误：对所有非闭包函数无条件前置 `ptr %__env.in`，导致该 env 占位 arg0 与 sret
    // 隐藏指针冲突 → 返回 %TSlice 的函数签名 ABI 错乱、运行期崩溃；且阈值误用 >16 让 16B 结构按值返回在 -O0 miscompile。
    var m: i64 = slice_len(params) as i64;
    var is_env_first: bool = (m >= 2 && params[0] == "$__env" && params[1] == "ptr<void>");
    var is_sret: bool = ll_needs_sret(ret);
    var use_sret: bool = is_sret;   // 所有聚合返回（>8B 结构）一律显式 sret（ptr sret 首参），与 C runtime/clang Win64 ABI 逐字一致
    if (use_sret) { g_cur_sret = base.sb_cat3("%", name, ".sret"); } else { g_cur_sret = ""; }
    var sig: StringBuilder = sb_new();
    sb_append_str(sig, "define ");
    if (use_sret) {
        sb_append_str(sig, "void @");
    } else {
        sb_append_str(sig, llname.st_to_ll(ret));
        sb_append_str(sig, " @");
    }
    // 入口函数（@main 标注）改名 @t.<name>，避免与下方补的 @main 包装器重名
    // （用户若把入口命名为 main，直接发 @main 会与包装器 @main 冲突：invalid redefinition）。
    if (g_has_main && name == g_main_fn) { sb_append_str(sig, "t."); }
    sb_append_str(sig, name);
    sb_append_str(sig, "(");
    var first: bool = true;
    if (use_sret) {
        // 显式返回槽：调用方把结果槽地址作为首参传入（sret 属性，与 C runtime/clang ABI 一致）。
        sb_append_str(sig, "ptr sret(");
        sb_append_str(sig, llname.st_to_ll(ret));
        sb_append_str(sig, ") ");
        sb_append_str(sig, g_cur_sret);
        first = false;
    }
    var i: i64 = 0;
    while (i < m) {
        if (i + 1 >= m) { break; }
        var pname: string = params[i];
        var pst: string = params[i + 1];
        if (first == false) { sb_append_str(sig, ", "); }
        if (ll_needs_byval(pst)) {
            sb_append_str(sig, "ptr byval(");
            sb_append_str(sig, llname.st_to_ll(pst));
            sb_append_str(sig, ") ");
        } else {
            sb_append_str(sig, llname.st_to_ll(pst));
            sb_append_str(sig, " ");
        }
        sb_append_str(sig, llname.ll_llname(pname));
        sb_append_str(sig, ".in");
        first = false;
        i = i + 2;
    }
    sb_append_str(sig, ") {\n");
    sb_append_str(g_ll, sb_to_str(sig));    // 参数 alloca + store
    i = 0;
    while (i < m) {
        if (i + 1 >= m) { break; }
        var pname: string = params[i];
        var pst: string = params[i + 1];
        ll_ensure_slot(pname, pst);
        llname.ll_set_st(pname, pst);
        if (ll_needs_byval(pst)) {
            // byval：%x.in 是调用方副本指针；拷贝进本地 slot %x（下游按 alloca 取字段，无需改动）。
            if (g_memcpy_declared == false) {
                g_memcpy_declared = true;
                sb_append_str(g_ll_declbuf, "declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)\n");
            }
            sb_append_str(g_ll, "  call void @llvm.memcpy.p0.p0.i64(ptr ");
            sb_append_str(g_ll, llname.ll_llname(pname));
            sb_append_str(g_ll, ", ptr ");
            sb_append_str(g_ll, llname.ll_llname(pname));
            sb_append_str(g_ll, ".in, i64 ");
            sb_append_str(g_ll, base.i2s(ll_sizeof_st(pst)));
            sb_append_str(g_ll, ", i1 false)\n");
        } else {
            sb_append_str(g_ll, "  store ");
            sb_append_str(g_ll, llname.st_to_ll(pst));
            sb_append_str(g_ll, " ");
            sb_append_str(g_ll, llname.ll_llname(pname));
            sb_append_str(g_ll, ".in, ptr ");
            sb_append_str(g_ll, llname.ll_llname(pname));
            sb_append_str(g_ll, "\n");
        }
        i = i + 2;
    }
}

// ── 内建降级（§4）：TIR 路径把高层内建（@println/@int_to_str/@sb_*…）桥接到 runtime 的 tll_*。
// TIR 前端给这些内建猜了错误的结果类型（多为 i64），翻译器在此按真实 ABI 重写：
//   - runtime 的 tll_* 一律按「指针传聚合」约定：TStr 参数 = TStr*（即 %TStr slot 的 alloca 指针），
//     故消费 %TStr 的内建直接把参数 slot 的 alloca 指针（ll_llname）传入，无需 GEP 取 data 指针。
//   - 返回 %TStr 的内建（int_to_str/sb_to_str/str_slice/str_concat）把 DST slot 直接当作 %TStr alloca，
//     作为 out 参数传给 tll_*，使下游以 %TStr 类型正确消费该 slot。
//   - 返回标量（i64/i32）的内建走 ll_store 写回 DST。
// 格式化内建（sb_append_fmt_int/uint/char）的第三实参：runtime 形参恒为 i64，
// 但实参槽可能是 i8/u8/i16/i32/bool。直接 `load i64, ptr <窄槽>` 会跨槽读到相邻栈字节
// （如 u8 变量打印成 36019311685495551），须按槽的真实宽度 sext/zext 到 i64
// （对齐 canonical codegen_ll 的 ll_cast_v(v, ll_etd(e), td_i64)）。
pub fn ll_fmt_int_arg(name: string, cn: string) string {
    var st: string = llname.ll_get_st(name);
    var isu: bool = false;
    if (st == "bool") { st = "i8"; isu = true; }
    else if (st == "u8" || st == "u16" || st == "u32") { isu = true; }
    if (st == "" || st == "i64" || st == "u64" || st == "ptr" || str_len(st) == 0) { return ll_load(name, "i64"); }
    if (st != "i8" && st != "i16" && st != "i32" && st != "u8" && st != "u16" && st != "u32") { return ll_load(name, "i64"); }
    if (cn == "sb_append_fmt_uint") { isu = true; }
    var raw: string = ll_load(name, st);
    var r: string = ll_tmp();
    sb_append_str(g_ll, "  ");
    sb_append_str(g_ll, r);
    if (isu) { sb_append_str(g_ll, " = zext "); }
    else { sb_append_str(g_ll, " = sext "); }
    sb_append_str(g_ll, llname.st_to_ll(st));
    sb_append_str(g_ll, " ");
    sb_append_str(g_ll, raw);
    sb_append_str(g_ll, " to i64\n");
    return r;
}

pub fn ll_emit_builtin(cn: string, toks: []string) bool {
    // ⚠ callee 名经 ll_llname 后保留 '@' 前缀；builtin 匹配需裸名，先剥 '@'（调用方已剥，此处幂等兜底）。
    if (str_len(cn) >= 1 && cn[0] == 64) { cn = str_slice(cn, 1, str_len(cn)); }
    // ⚠ d 归一成 LLVM 名（剥 `$` 前缀）：否则槽表注册 "$main.tN" 而下游 ll_get_st 用 "%main.tN"
    // 查不到 → 回退 i64 → reduce 等返回窄类型的向量内建结果被当 i64 读，高字节栈垃圾。
    var d: string = llname.ll_llname(toks[2]);
    if (cn == "println" || cn == "print" || cn == "eprint") {
        var ap: string = llname.ll_llname(toks[4]);
        var rt: string = "tll_println";
        if (cn == "print") { rt = "tll_print"; }
        if (cn == "eprint") { rt = "tll_eprint"; }
        ll_maybe_declare(rt, "void", ["ptr"]);
        sb_append_str(g_ll, "  call void @");
        sb_append_str(g_ll, rt);
        sb_append_str(g_ll, "(ptr ");
        sb_append_str(g_ll, ap);
        sb_append_str(g_ll, ")\n");
        return true;
    }
    if (cn == "sys_run") {
        var ap: string = llname.ll_llname(toks[4]);
        ll_maybe_declare("tll_system", "i32", ["ptr"]);
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = call i32 @tll_system(ptr ");
        sb_append_str(g_ll, ap);
        sb_append_str(g_ll, ")\n");
        ll_ensure_slot(d, "i32"); llname.ll_set_st(d, "i32"); ll_store(d, "i32", r);
        return true;
    }
    if (cn == "file_write_all") {
        // ⚠ 必须走 tll_ shim：native t_file_write_all 的签名是 (const char*, TStr)，
        // 而 TIR 传来的实参是两个 %TStr。若按 ll_runtime_callee 的 t_ 前缀直发
        // `call i8 @t_file_write_all(%TStr, %TStr)`，Win64 下 path 取到第一个 TStr 的 ptr（碰巧可用），
        // content 却被解释成 {第一个TStr.len, 第二个TStr.ptr} → content.ptr 变成路径长度
        // （如 21=0x15）→ fwrite 从 0x15 读 → ACCESS_VIOLATION READ。改走 tll_file_write_all(ptr, ptr)。
        var fp: string = llname.ll_llname(toks[4]);
        var fc: string = llname.ll_llname(toks[5]);
        ll_maybe_declare("tll_file_write_all", "i32", ["ptr", "ptr"]);
        var rw: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, rw);
        sb_append_str(g_ll, " = call i32 @tll_file_write_all(ptr ");
        sb_append_str(g_ll, fp);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, fc);
        sb_append_str(g_ll, ")\n");
        ll_ensure_slot(d, "i32"); llname.ll_set_st(d, "i32"); ll_store(d, "i32", rw);
        return true;
    }
    if (cn == "str_len") {
        var ap: string = llname.ll_llname(toks[4]);
        ll_maybe_declare("tll_str_len", "i64", ["ptr"]);
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = call i64 @tll_str_len(ptr ");
        sb_append_str(g_ll, ap);
        sb_append_str(g_ll, ")\n");
        ll_ensure_slot(d, "i64"); llname.ll_set_st(d, "i64"); ll_store(d, "i64", r);
        return true;
    }
    if (cn == "str_at") {
        var ap: string = llname.ll_llname(toks[4]);
        var iv: string = ll_load(toks[5], "i64");
        ll_maybe_declare("tll_str_at", "i64", ["ptr", "i64"]);
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = call i64 @tll_str_at(ptr ");
        sb_append_str(g_ll, ap);
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, iv);
        sb_append_str(g_ll, ")\n");
        ll_ensure_slot(d, "i64"); llname.ll_set_st(d, "i64"); ll_store(d, "i64", r);
        return true;
    }
    if (cn == "str_eq") {
        var ap: string = llname.ll_llname(toks[4]);
        var bp: string = llname.ll_llname(toks[5]);
        ll_maybe_declare("tll_str_eq", "i32", ["ptr", "ptr"]);
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = call i32 @tll_str_eq(ptr ");
        sb_append_str(g_ll, ap);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, bp);
        sb_append_str(g_ll, ")\n");
        ll_ensure_slot(d, "i32"); llname.ll_set_st(d, "i32"); ll_store(d, "i32", r);
        return true;
    }
    if (cn == "slice_len") {
        var ap: string = llname.ll_llname(toks[4]);
        ll_maybe_declare("tll_slice_len", "i64", ["ptr"]);
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = call i64 @tll_slice_len(ptr ");
        sb_append_str(g_ll, ap);
        sb_append_str(g_ll, ")\n");
        ll_ensure_slot(d, "i64"); llname.ll_set_st(d, "i64"); ll_store(d, "i64", r);
        return true;
    }
    if (cn == "slice_set") {
        // ⚠ 必须走 tll_slice_set(ptr, i64, ptr)：切片按指针传、元素按指针传。
        // 若按值传 %TSlice(32B)/%base__Node(巨结构)，Win64 调用约定错配——
        // 调用方把 32B 结构按寄存器拆分传入，被调 C 函数 t_slice_set 按隐藏指针
        // (rcx=栈上副本地址) 解读 → s 被当成「指向结构的指针」解引用 →
        // 读到字符串字面量地址、len=4 → 越界 panic（init_anndefs 自举门禁炸点）。
        // 与 append/slice_len 一致：切片与元素均按 ptr 传（tll_slice_set 内部 *s 写入）。
        var slicest: string = llname.ll_get_st(toks[4]);
        var sliceptr: string;
        if (llname.ll_starts(slicest, "ptr<") || slicest == "ptr") {
            sliceptr = ll_load(toks[4], slicest);
        } else {
            sliceptr = llname.ll_llname(toks[4]);
        }
        var iv: string = ll_load(toks[5], "i64");
        var elemptr: string = ll_map_argptr(toks[6], llname.ll_get_st(toks[6]));
        ll_maybe_declare("tll_slice_set", "void", ["ptr", "i64", "ptr"]);
        sb_append_str(g_ll, "  call void @tll_slice_set(ptr ");
        sb_append_str(g_ll, sliceptr);
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, iv);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, elemptr);
        sb_append_str(g_ll, ")\n");
        ll_ensure_slot(d, "i64"); llname.ll_set_st(d, "i64"); ll_store(d, "i64", "0");
        return true;
    }
    if (cn == "sb_new") {
        ll_maybe_declare("tll_sb_new", "ptr", []);
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = call ptr @tll_sb_new()\n");
        ll_ensure_slot(d, "ptr"); llname.ll_set_st(d, "ptr"); ll_store(d, "ptr", r);
        return true;
    }
    if (cn == "sb_append_str") {
        var bp: string = ll_load(toks[4], "ptr");
        var ap: string = llname.ll_llname(toks[5]);
        ll_maybe_declare("tll_sb_append_str", "void", ["ptr", "ptr"]);
        sb_append_str(g_ll, "  call void @tll_sb_append_str(ptr ");
        sb_append_str(g_ll, bp);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, ap);
        sb_append_str(g_ll, ")\n");
        return true;
    }
    if (cn == "sb_append_char") {
        var bp: string = ll_load(toks[4], "ptr");
        var iv: string = ll_load(toks[5], "i64");
        ll_maybe_declare("tll_sb_append_char", "void", ["ptr", "i64"]);
        sb_append_str(g_ll, "  call void @tll_sb_append_char(ptr ");
        sb_append_str(g_ll, bp);
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, iv);
        sb_append_str(g_ll, ")\n");
        return true;
    }
    if (cn == "sb_append_i64" || cn == "sb_append_u64") {
        var bp: string = ll_load(toks[4], "ptr");
        var fmode: string = "sb_append_fmt_int";
        if (cn == "sb_append_u64") { fmode = "sb_append_fmt_uint"; }
        var iv: string = ll_fmt_int_arg(toks[5], fmode);
        if (cn == "sb_append_i64") {
            ll_maybe_declare("tll_sb_append_i64", "void", ["ptr", "i64"]);
            sb_append_str(g_ll, "  call void @tll_sb_append_i64(ptr ");
        } else {
            ll_maybe_declare("tll_sb_append_u64", "void", ["ptr", "i64"]);
            sb_append_str(g_ll, "  call void @tll_sb_append_u64(ptr ");
        }
        sb_append_str(g_ll, bp);
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, iv);
        sb_append_str(g_ll, ")\n");
        return true;
    }
    if (cn == "sb_to_str") {
        var bp: string = ll_load(toks[4], "ptr");
        ll_ensure_slot(d, "%TStr"); llname.ll_set_st(d, "%TStr");
        var outp: string = llname.ll_llname(d);
        ll_maybe_declare("tll_sb_to_str", "void", ["ptr", "ptr"]);
        sb_append_str(g_ll, "  call void @tll_sb_to_str(ptr ");
        sb_append_str(g_ll, bp);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, outp);
        sb_append_str(g_ll, ")\n");
        return true;
    }
    if (cn == "int_to_str" || cn == "i2s") {
        var iv: string = ll_load(toks[4], "i64");
        ll_ensure_slot(d, "%TStr"); llname.ll_set_st(d, "%TStr");
        var outp: string = llname.ll_llname(d);
        ll_maybe_declare("tll_int_to_str", "void", ["i64", "ptr"]);
        sb_append_str(g_ll, "  call void @tll_int_to_str(i64 ");
        sb_append_str(g_ll, iv);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, outp);
        sb_append_str(g_ll, ")\n");
        return true;
    }
    if (cn == "str_slice") {
        var ap: string = llname.ll_llname(toks[4]);
        var lo: string = ll_load(toks[5], "i64");
        var hi: string = ll_load(toks[6], "i64");
        ll_ensure_slot(d, "%TStr"); llname.ll_set_st(d, "%TStr");
        var outp: string = llname.ll_llname(d);
        ll_maybe_declare("tll_str_slice", "void", ["ptr", "i64", "i64", "ptr"]);
        sb_append_str(g_ll, "  call void @tll_str_slice(ptr ");
        sb_append_str(g_ll, ap);
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, lo);
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, hi);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, outp);
        sb_append_str(g_ll, ")\n");
        return true;
    }
    if (cn == "str_concat") {
        var ap: string = llname.ll_llname(toks[4]);
        var bp: string = llname.ll_llname(toks[5]);
        ll_ensure_slot(d, "%TStr"); llname.ll_set_st(d, "%TStr");
        var outp: string = llname.ll_llname(d);
        ll_maybe_declare("tll_str_concat", "void", ["ptr", "ptr", "ptr"]);
        sb_append_str(g_ll, "  call void @tll_str_concat(ptr ");
        sb_append_str(g_ll, ap);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, bp);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, outp);
        sb_append_str(g_ll, ")\n");
        return true;
    }
    // ── 位串字面量构造（§15）：tll_bitstr_* 内建，复用 %TStr 的 ptr-out(sret) 策略 ──
    if (cn == "bitstr_new") {
        var outp: string = llname.ll_llname(toks[4]);
        var bl: string = toks[5];
        ll_maybe_declare("tll_bitstr_new", "void", ["ptr", "i64"]);
        sb_append_str(g_ll, "  call void @tll_bitstr_new(ptr ");
        sb_append_str(g_ll, outp);
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, bl);
        sb_append_str(g_ll, ")\n");
        return true;
    }
    if (cn == "bitstr_append_val") {
        var dstp: string = llname.ll_llname(toks[4]);
        var valv: string = ll_load(toks[5], "i64");
        var bits: string = toks[6];
        var little: string = toks[7];
        ll_maybe_declare("tll_bitstr_append_val", "void", ["ptr", "i64", "i64", "i64"]);
        sb_append_str(g_ll, "  call void @tll_bitstr_append_val(ptr ");
        sb_append_str(g_ll, dstp);
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, valv);
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, bits);
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, little);
        sb_append_str(g_ll, ")\n");
        return true;
    }
    if (cn == "bitstr_concat") {
        var outp: string = llname.ll_llname(toks[4]);
        var ap: string = llname.ll_llname(toks[5]);
        var bp: string = llname.ll_llname(toks[6]);
        ll_maybe_declare("tll_bitstr_concat", "void", ["ptr", "ptr", "ptr"]);
        sb_append_str(g_ll, "  call void @tll_bitstr_concat(ptr ");
        sb_append_str(g_ll, outp);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, ap);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, bp);
        sb_append_str(g_ll, ")\n");
        return true;
    }
    if (cn == "bitstr_extract") {
        var sp: string = llname.ll_llname(toks[4]);
        var off: string = toks[5];
        var bits: string = toks[6];
        var little: string = toks[7];
        ll_maybe_declare("tll_bitstr_extract", "i64", ["ptr", "i64", "i64", "i64"]);
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = call i64 @tll_bitstr_extract(ptr ");
        sb_append_str(g_ll, sp);
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, off);
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, bits);
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, little);
        sb_append_str(g_ll, ")\n");
        ll_ensure_slot(d, "i64"); llname.ll_set_st(d, "i64"); ll_store(d, "i64", r);
        return true;
    }
    if (cn == "bitstr_sub") {
        var outp: string = llname.ll_llname(toks[4]);
        var sp: string = llname.ll_llname(toks[5]);
        var off: string = toks[6];
        ll_maybe_declare("tll_bitstr_sub", "void", ["ptr", "ptr", "i64"]);
        sb_append_str(g_ll, "  call void @tll_bitstr_sub(ptr ");
        sb_append_str(g_ll, outp);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, sp);
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, off);
        sb_append_str(g_ll, ")\n");
        return true;
    }
    if (cn == "map_len") {
        ll_maybe_declare("tll_map_len", "i64", ["ptr"]);
        var r: string = ll_tmp();
        // ⚠ map 实参须 load 出句柄：map 变量是 alloca ptr 槽，槽内才是 TMap* 句柄；
        //   直接传槽地址(ptr*)会被 tll_map_len 当 TMap* 解引用→段错误。与 emit-ll 的
        //   `%t3 = load ptr, ptr %v.m` 对齐。
        var mr: string = ll_load(toks[4], "ptr");
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = call i64 @tll_map_len(ptr ");
        sb_append_str(g_ll, mr);
        sb_append_str(g_ll, ")\n");
        ll_ensure_slot(d, "i64"); llname.ll_set_st(d, "i64"); ll_store(d, "i64", r);
        return true;
    }
    if (cn == "map_has") {
        ll_maybe_declare("tll_map_has", "i32", ["ptr", "ptr"]);
        var r: string = ll_tmp();
        var mr: string = ll_load(toks[4], "ptr");
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = call i32 @tll_map_has(ptr ");
        sb_append_str(g_ll, mr);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, ll_map_argptr(toks[5], llname.ll_get_st(toks[5])));
        sb_append_str(g_ll, ")\n");
        ll_ensure_slot(d, "i32"); llname.ll_set_st(d, "i32"); ll_store(d, "i32", r);
        return true;
    }
    if (cn == "map_new") {
        ll_maybe_declare("tll_map_new", "ptr", ["i64", "i64"]);
        var r: string = ll_tmp();
        var ktd: string = ll_load(toks[4], "i64");
        // val_td 可选：前端在 key/val 同型时省略第二实参，缺省回退到 key_td。
        var vtd: string = ktd;
        if (slice_len(toks) as i64 > 5) { vtd = ll_load(toks[5], "i64"); }
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = call ptr @tll_map_new(i64 ");
        sb_append_str(g_ll, ktd);
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, vtd);
        sb_append_str(g_ll, ")\n");
        ll_ensure_slot(d, "ptr"); llname.ll_set_st(d, "ptr"); ll_store(d, "ptr", r);
        return true;
    }
    // ⚠ tir.tc 的 map 字面量降级路径直接发射 @tll_map_put（带 tll_ 前缀），
    // 而此 handler 原只匹配无前缀的 map_put/map_set/map_del。漏匹配会导致 @tll_map_put
    // 落到通用 call 路径——其把值按「标量」(i64) 传值而非「指针」传址，与 runtime
    // tll_map_put(TMap*, void* key, void* val) 的 val 指针约定冲突 → 解引用坏指针段错误。
    // 故这里一并匹配 tll_map_put。
    if (cn == "map_put" || cn == "map_set" || cn == "map_del" || cn == "tll_map_put") {
        // 两种 TIR 形态，实参位置不同，须按 toks[2] 是否 callee(@ 开头) 区分：
        //  - 内建形式：call <st> <dst> @map_set ($m $k $v)      → toks[2]=dst，实参在 toks[4..6]
        //  - 字面量降级：call void @tll_map_put ($m $k $v)      → toks[2]=callee(无dst)，实参在 toks[3..5]
        var argbase: i64 = 4;
        if (str_len(toks[2]) >= 1 && toks[2][0] == 64) { argbase = 3; }  // '@' -> 无 dst
        // map 实参形态（见 ll_map_argptr 注释）：字面量降级走 addr_of → 槽持指针；
        // 通用 map_set/del(m,k[,v]) 槽持值（聚合值或标量）。统一交给 ll_map_argptr 收口：
        // 指针槽 load 出真指针；聚合值槽取地址；标量槽 sext/zext 到 i64 再取地址。
        // ⚠ map_del 仅 2 实参(mp,key)，绝不可读 toks[argbase+2]，否则越界 panic（见 build 修复）。
        var kst: string = llname.ll_get_st(toks[argbase + 1]);
        var kr: string = ll_map_argptr(toks[argbase + 1], kst);
        // map_del(mp, key) 仅 2 实参；map_put/map_set(mp, key, val) 为 3 实参。
        if (cn == "map_del") {
            // TIR 把 map_del 结果按 i64 槽声明（与 b2i 衔接），但 runtime tll_map_del 返回 i32(1/0)。
            // 故按 i32 槽存结果（与 map_has 同构），b2i 加载时按槽类型 i32 取数。
            ll_maybe_declare("tll_map_del", "i32", ["ptr", "ptr"]);
            var r: string = ll_tmp();
            var mr: string = ll_load(toks[argbase], "ptr");
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, r);
            sb_append_str(g_ll, " = call i32 @tll_map_del(ptr ");
            sb_append_str(g_ll, mr);
            sb_append_str(g_ll, ", ptr ");
            sb_append_str(g_ll, kr);
            sb_append_str(g_ll, ")\n");
            ll_ensure_slot(d, "i32"); llname.ll_set_st(d, "i32"); ll_store(d, "i32", r);
            return true;
        }
        var vst: string = llname.ll_get_st(toks[argbase + 2]);
        var vr: string;
        if (cn == "tll_map_put") {
            // 字面量降级：tir.tc 已对值做 TIR_OP_ADDR_OF（vp 槽持 &vs），ll_map_argptr 的 ll_load
            // 取出 &vs（值存储地址），tll_map_put 据此 memcpy 入库，正确。
            vr = ll_map_argptr(toks[argbase + 2], vst);
        } else {
            // ⚠ map_set/map_put 通用内置：值槽持「句柄/指针值本身」（未 addr_of），
            // 不能 ll_load 出值再当 val 传（runtime 会 memcpy 从「值指向的内存」读 8 字节 → 损坏/段错误）。
            // 须取槽地址 &slot：tll_map_put 按 val_size 字节从「槽地址」memcpy 入库（句柄/指针值即正确）。
            vr = llname.ll_llname_ptr(toks[argbase + 2]);
        }
        var tlln: string = "tll_map_put";
        ll_maybe_declare(tlln, "void", ["ptr", "ptr", "ptr"]);
        var mr: string = ll_load(toks[argbase], "ptr");
        sb_append_str(g_ll, "  call void @");
        sb_append_str(g_ll, tlln);
        sb_append_str(g_ll, "(ptr ");
        sb_append_str(g_ll, mr);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, kr);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, vr);
        sb_append_str(g_ll, ")\n");
        return true;
    }
    if (cn == "sym_release") {
        ll_maybe_declare("tll_sym_release", "void", ["ptr"]);
        sb_append_str(g_ll, "  call void @tll_sym_release(ptr ");
        sb_append_str(g_ll, llname.ll_llname(toks[4]));
        sb_append_str(g_ll, ")\n");
        return true;
    }
    if (cn == "sym_release_all") {
        ll_maybe_declare("tll_sym_release_all", "void", []);
        sb_append_str(g_ll, "  call void @tll_sym_release_all()\n");
        return true;
    }
    // ── 反射访问子 ti_*/fi_*（M36）：操作编译期内建 TypeInfo / FieldInfo，无需 import ──
    // TypeInfo variant = %TypeInfo { i64, [16 x i8] }，payload 持 *TypeMeta；
    // TypeMeta 布局 { %TStr name, i64 size, i64 kind, i64 field_count, %TSlice fields }
    //   → name @0(TStr) / size @16 / kind @24 / field_count @32 / fields @40(TSlice)
    // FieldInfo 布局 { %TStr name, i64 offset, %TStr type_name, i64 type_size, i8 is_ptr, i64 tag }
    //   → name @0 / offset @16 / type_name @24 / type_size @40 / is_ptr @48 / tag @56
    if (cn == "ti_name" || cn == "ti_size" || cn == "ti_kind" || cn == "ti_field_count" || cn == "ti_field") {
        // ti: TypeInfo 在双后端均以「指针」传递（variant >16B → ptr 到固定 24B variant 槽）。
        // variant 槽布局 = { i64 tag, ptr meta }：tag@0，meta(*TypeMeta)@8（对齐 base.tc 同构表示）。
        // 故先取 mptr = *(ti+8)（%TypeInfo 是 opaque，必须 i8 字节偏移 GEP，禁止 GEP 进 opaque）。
        var tip: string = ll_load_ptr_slot(toks[4]);   // ptr to TypeInfo variant slot
        var mgep: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, mgep);
        sb_append_str(g_ll, " = getelementptr i8, ptr ");
        sb_append_str(g_ll, tip);
        sb_append_str(g_ll, ", i64 8\n");
        var mptr: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, mptr);
        sb_append_str(g_ll, " = load ptr, ptr ");
        sb_append_str(g_ll, mgep);
        sb_append_str(g_ll, "\n");
        if (cn == "ti_name") {
            // %TypeMeta 首字段 name(%TStr) @0：bitcast meta 指针为 ptr %TStr 后 load
            var nvp: string = ll_tmp();
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, nvp);
            sb_append_str(g_ll, " = bitcast ptr ");
            sb_append_str(g_ll, mptr);
            sb_append_str(g_ll, " to ptr\n");
            var nv: string = ll_tmp();
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, nv);
            sb_append_str(g_ll, " = load %TStr, ptr ");
            sb_append_str(g_ll, nvp);
            sb_append_str(g_ll, "\n");
            ll_ensure_slot(d, "%TStr"); llname.ll_set_st(d, "%TStr"); ll_store(d, "%TStr", nv);
            return true;
        }
        if (cn == "ti_size" || cn == "ti_kind" || cn == "ti_field_count") {
            var off: i64 = 16;
            if (cn == "ti_kind") { off = 24; }
            if (cn == "ti_field_count") { off = 32; }
            var sbp: string = ll_tmp();
            var spp: string = ll_tmp();
            var sv: string = ll_tmp();
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, sbp);
            sb_append_str(g_ll, " = getelementptr i8, ptr ");
            sb_append_str(g_ll, mptr);
            sb_append_str(g_ll, base.sb_cat3(", i64 ", base.i2s(off), "\n"));
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, spp);
            sb_append_str(g_ll, " = bitcast ptr ");
            sb_append_str(g_ll, sbp);
            sb_append_str(g_ll, " to ptr\n");
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, sv);
            sb_append_str(g_ll, " = load i64, ptr ");
            sb_append_str(g_ll, spp);
            sb_append_str(g_ll, "\n");
            ll_ensure_slot(d, "i64"); llname.ll_set_st(d, "i64"); ll_store(d, "i64", sv);
            return true;
        }
        if (cn == "ti_field") {
            // %TypeMeta 第 4 字段 fields(%TSlice) @40：取数据指针（extractvalue 0），按 i 索引 %FieldInfo。
            var fsp: string = ll_tmp();
            var fspp: string = ll_tmp();
            var fs: string = ll_tmp();
            var arrp: string = ll_tmp();
            var ie: string = ll_load(toks[5], "i64");
            var elem: string = ll_tmp();
            var fi: string = ll_tmp();
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, fsp);
            sb_append_str(g_ll, " = getelementptr i8, ptr ");
            sb_append_str(g_ll, mptr);
            sb_append_str(g_ll, ", i64 40\n");
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, fspp);
            sb_append_str(g_ll, " = bitcast ptr ");
            sb_append_str(g_ll, fsp);
            sb_append_str(g_ll, " to ptr\n");
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, fs);
            sb_append_str(g_ll, " = load %TSlice, ptr ");
            sb_append_str(g_ll, fspp);
            sb_append_str(g_ll, "\n");
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, arrp);
            sb_append_str(g_ll, " = extractvalue %TSlice ");
            sb_append_str(g_ll, fs);
            sb_append_str(g_ll, ", 0\n");
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, elem);
            sb_append_str(g_ll, " = getelementptr %FieldInfo, ptr ");
            sb_append_str(g_ll, arrp);
            sb_append_str(g_ll, ", i64 ");
            sb_append_str(g_ll, ie);
            sb_append_str(g_ll, "\n");
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, fi);
            sb_append_str(g_ll, " = load %FieldInfo, ptr ");
            sb_append_str(g_ll, elem);
            sb_append_str(g_ll, "\n");
            ll_ensure_slot(d, "%FieldInfo"); llname.ll_set_st(d, "%FieldInfo"); ll_store(d, "%FieldInfo", fi);
            return true;
        }
        return true;
    }
    if (cn == "fi_name" || cn == "fi_offset" || cn == "fi_type_name" || cn == "fi_type_size" || cn == "fi_is_ptr" || cn == "fi_tag") {
        // fi: FieldInfo 在双后端均以「指针」传递（struct >16B → ptr 到 FieldInfo 槽）。
        // FieldInfo 布局 { %TStr name, i64 offset, %TStr type_name, i64 type_size, i8 is_ptr, i64 tag }
        //   → name @0 / offset @16 / type_name @24 / type_size @40 / is_ptr @48 / tag @56
        // ⚠ fi: FieldInfo 是 64B struct，按隐藏指针 ABI 传入：toks[4] 本身已是「指向 FieldInfo 的 ptr」
        // （不是持有指针的槽），故直接取 ll_llname 作 fip，绝不可再 load（否则会把 FieldInfo 首 8 字节当指针读穿）。
        // 与 ti 不同：ti 是 variant，槽里存的是 variant 数据指针，需 ll_load_ptr_slot 取出。
        var fip: string = llname.ll_llname(toks[4]);   // ptr to FieldInfo（已是地址，不再 load）
        if (cn == "fi_name" || cn == "fi_type_name") {
            var off: i64 = 0;
            if (cn == "fi_type_name") { off = 24; }
            var vp: string = ll_tmp();
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, vp);
            sb_append_str(g_ll, " = getelementptr i8, ptr ");
            sb_append_str(g_ll, fip);
            sb_append_str(g_ll, base.sb_cat3(", i64 ", base.i2s(off), "\n"));
            var vpp: string = ll_tmp();
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, vpp);
            sb_append_str(g_ll, " = bitcast ptr ");
            sb_append_str(g_ll, vp);
            sb_append_str(g_ll, " to ptr\n");
            var nv: string = ll_tmp();
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, nv);
            sb_append_str(g_ll, " = load %TStr, ptr ");
            sb_append_str(g_ll, vpp);
            sb_append_str(g_ll, "\n");
            ll_ensure_slot(d, "%TStr"); llname.ll_set_st(d, "%TStr"); ll_store(d, "%TStr", nv);
            return true;
        }
        if (cn == "fi_offset" || cn == "fi_type_size" || cn == "fi_tag") {
            var off: i64 = 16;
            if (cn == "fi_type_size") { off = 40; }
            if (cn == "fi_tag") { off = 56; }
            var sbp: string = ll_tmp();
            var spp: string = ll_tmp();
            var sv: string = ll_tmp();
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, sbp);
            sb_append_str(g_ll, " = getelementptr i8, ptr ");
            sb_append_str(g_ll, fip);
            sb_append_str(g_ll, base.sb_cat3(", i64 ", base.i2s(off), "\n"));
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, spp);
            sb_append_str(g_ll, " = bitcast ptr ");
            sb_append_str(g_ll, sbp);
            sb_append_str(g_ll, " to ptr\n");
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, sv);
            sb_append_str(g_ll, " = load i64, ptr ");
            sb_append_str(g_ll, spp);
            sb_append_str(g_ll, "\n");
            ll_ensure_slot(d, "i64"); llname.ll_set_st(d, "i64"); ll_store(d, "i64", sv);
            return true;
        }
        if (cn == "fi_is_ptr") {
            var sbp: string = ll_tmp();
            var spp: string = ll_tmp();
            var sv: string = ll_tmp();
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, sbp);
            sb_append_str(g_ll, " = getelementptr i8, ptr ");
            sb_append_str(g_ll, fip);
            sb_append_str(g_ll, ", i64 48\n");
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, spp);
            sb_append_str(g_ll, " = bitcast ptr ");
            sb_append_str(g_ll, sbp);
            sb_append_str(g_ll, " to ptr\n");
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, sv);
            sb_append_str(g_ll, " = load i8, ptr ");
            sb_append_str(g_ll, spp);
            sb_append_str(g_ll, "\n");
            ll_ensure_slot(d, "i8"); llname.ll_set_st(d, "i8"); ll_store(d, "i8", sv);
            return true;
        }
        return true;
    }
    // sym_str(v)：tag 由前端（tir.tc）从参数 Sym 类型推导并作为首个实参（%TStr 字面量）注入；
    // id 为第二实参（Sym32→i32 / Sym16→i16，需 zext 到 i32）。映射 runtime
    // tll_sym_str(TStr* tag, uint32_t id, TStr* out)。
    if (cn == "sym_str") {
        ll_ensure_slot(d, "%TStr"); llname.ll_set_st(d, "%TStr");
        var outp: string = llname.ll_llname(d);
        var tagp: string = llname.ll_llname(toks[4]);
        var idst: string = llname.ll_get_st(toks[5]);
        // Sym64：id 为 i64，走 tll_sym_str64（i64 id），与既有 i32 路径互不影响
        if (idst == "i64" || idst == "u64") {
            var idv: string = ll_load(toks[5], "i64");
            ll_maybe_declare("tll_sym_str64", "void", ["ptr", "i64", "ptr"]);
            sb_append_str(g_ll, "  call void @tll_sym_str64(ptr ");
            sb_append_str(g_ll, tagp);
            sb_append_str(g_ll, ", i64 ");
            sb_append_str(g_ll, idv);
            sb_append_str(g_ll, ", ptr ");
            sb_append_str(g_ll, outp);
            sb_append_str(g_ll, ")\n");
            return true;
        }
        var idv: string;
        if (idst == "i16") {
            var z: string = ll_tmp();
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, z);
            sb_append_str(g_ll, " = zext i16 ");
            sb_append_str(g_ll, ll_load(toks[5], "i16"));
            sb_append_str(g_ll, " to i32\n");
            idv = z;
        } else {
            idv = ll_load(toks[5], "i32");
        }
        ll_maybe_declare("tll_sym_str", "void", ["ptr", "i32", "ptr"]);
        sb_append_str(g_ll, "  call void @tll_sym_str(ptr ");
        sb_append_str(g_ll, tagp);
        sb_append_str(g_ll, ", i32 ");
        sb_append_str(g_ll, idv);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, outp);
        sb_append_str(g_ll, ")\n");
        return true;
    }
    // sym_intern(tag, val, bits)：映射 runtime tll_sym_intern(TStr* tag, TStr* str, i64 bits) -> i32 id。
    // 由前端在 Sym 变量（局部/全局）字符串初始化处发射，返回的 id 存入 Sym 槽。
    if (cn == "sym_intern") {
        var tagp: string = llname.ll_llname(toks[4]);
        var valp: string = llname.ll_llname(toks[5]);
        var bitv: string = ll_load(toks[6], "i64");
        ll_maybe_declare("tll_sym_intern", "i32", ["ptr", "ptr", "i64"]);
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = call i32 @tll_sym_intern(ptr ");
        sb_append_str(g_ll, tagp);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, valp);
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, bitv);
        sb_append_str(g_ll, ")\n");
        ll_ensure_slot(d, "i32"); llname.ll_set_st(d, "i32"); ll_store(d, "i32", r);
        return true;
    }
    // sym_intern64(tag, val, bits)：Sym64 专用，映射 runtime tll_sym_intern64(...) -> i64 id。
    // 与 sym_intern（i32，供 Sym16/Sym32）并列，互不破坏既有 IR 契约。
    if (cn == "sym_intern64") {
        var tagp: string = llname.ll_llname(toks[4]);
        var valp: string = llname.ll_llname(toks[5]);
        var bitv: string = ll_load(toks[6], "i64");
        ll_maybe_declare("tll_sym_intern64", "i64", ["ptr", "ptr", "i64"]);
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = call i64 @tll_sym_intern64(ptr ");
        sb_append_str(g_ll, tagp);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, valp);
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, bitv);
        sb_append_str(g_ll, ")\n");
        ll_ensure_slot(d, "i64"); llname.ll_set_st(d, "i64"); ll_store(d, "i64", r);
        return true;
    }
    if (cn == "unwrap") {
        // ?T ↔ ptr 模型：unwrap(p) 调 tll_opt_unwrap 取「指向元素值的指针」，再 load 出元素值。
        // 标量 load 出 i64/u8…；聚合(%Point 等) load 出 %Struct 值——与旧轨 codegen_ll 对齐。
        var argst: string = llname.ll_get_st(toks[4]);
        var elem: string = "i64";
        if (llname.ll_starts(argst, "ptr<")) { elem = ll_ptr_inner(argst); }
        else if (argst == "ptr") { elem = "i8"; }
        else { elem = argst; }
        // ⚠ ll_load 会立即把 load 语句 append 到 g_ll，必须先在 call 行之外取好值寄存器名，
        // 再拼 call 行，否则 load 语句会被插进 call 行中间导致 IR 非法。
        var argval: string = ll_load(toks[4], argst);
        ll_maybe_declare("tll_opt_unwrap", "ptr", ["ptr"]);
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = call ptr @tll_opt_unwrap(ptr ");
        sb_append_str(g_ll, argval);
        sb_append_str(g_ll, ")\n");
        var v: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, v);
        sb_append_str(g_ll, " = load ");
        sb_append_str(g_ll, llname.st_to_ll(elem));
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, "\n");
        ll_ensure_slot(d, elem); llname.ll_set_st(d, elem); ll_store(d, elem, v);
        return true;
    }
    // ── out 参数聚合返回：DST 直接作为 %TStr/%TSlice alloca 传给 tll_* ──
    // ⚠ 必须内联拼写 call：t 数组字面量末尾/中间 var 元素会被丢弃（见 _fix_tirll 记录），
    //    走 ll_call_void([..., var]) 会丢末参 → IR 非法。仿 map_get 直接 sb_append_str 构造。
    if (cn == "atom_str") {
        var idv: string = ll_load(toks[4], "i64");
        ll_ensure_slot(d, "%TStr"); llname.ll_set_st(d, "%TStr");
        var outp: string = llname.ll_llname(d);
        ll_maybe_declare("tll_atom_str", "void", ["i64", "ptr"]);
        sb_append_str(g_ll, "  call void @tll_atom_str(i64 ");
        sb_append_str(g_ll, idv);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, outp);
        sb_append_str(g_ll, ")\n");
        return true;
    }
    if (cn == "slice_sub") {
        var lo: string = ll_load(toks[5], "i64");
        var hi: string = ll_load(toks[6], "i64");
        ll_ensure_slot(d, "%TSlice"); llname.ll_set_st(d, "%TSlice");
        var outp: string = llname.ll_llname(d);
        ll_maybe_declare("tll_slice_sub", "void", ["ptr", "i64", "i64", "ptr"]);
        sb_append_str(g_ll, "  call void @tll_slice_sub(ptr ");
        sb_append_str(g_ll, llname.ll_llname_ptr(toks[4]));
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, lo);
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, hi);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, outp);
        sb_append_str(g_ll, ")\n");
        return true;
    }
    // 定长数组 → 切片：tll_slice_from_raw(数组基址, alen, sizeof(elem), out)
    // （不先构造 %TSlice 就会把 [N]T 当切片结构体读 → 长度/步长错 → 段错误）。
    if (cn == "slice_from_raw") {
        var nraw: string = ll_load(toks[5], "i64");
        var esz: string = ll_load(toks[6], "i64");
        ll_ensure_slot(d, "%TSlice"); llname.ll_set_st(d, "%TSlice");
        var outp2: string = llname.ll_llname(d);
        ll_maybe_declare("tll_slice_from_raw", "void", ["ptr", "i64", "i64", "ptr"]);
        sb_append_str(g_ll, "  call void @tll_slice_from_raw(ptr ");
        sb_append_str(g_ll, llname.ll_llname_ptr(toks[4]));
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, nraw);
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, esz);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, outp2);
        sb_append_str(g_ll, ")\n");
        return true;
    }
    // ── append：用 t_slice_append_sized 携带元素大小 ──
    // ⚠ 零初始化的 slice（FIX 5 已置 zeroinitializer）elem_size==0，runtime 首 append 时
    // 按传入 elem_size 自动定型。若用 t_slice_append（自元数据推断）则 elem_size 恒 0 →
    // memcpy 0 字节 → 元素全垃圾（maputil_demo 曾输出 "2010044703744..."）。
    // 元素大小 esz 由前端从「切片声明元素类型」显式传入（第三实参，与 @slice_from_raw 同构），
    // 翻译器直接用、不再从「待追加值槽存储型」反推（窄整数已加宽成 i64 ⇒ []u8 的 elem_size
    // 退化成 8 导致步长错；槽保留 u8 还会误发非法类型令牌 `u8`）。根治 hir.tc 字节缓冲被迫用 string 的 bug。
    if (cn == "append") {
        var eszst: string = llname.ll_get_st(toks[6]);          // 元素字节宽（i64，前端从元素类型导出）
        var esz: string = ll_load(toks[6], eszst);
        ll_maybe_declare("t_slice_append_sized", "void", ["ptr", "ptr", "i64"]);
        // 调用 t_slice_append_sized(slice_ptr, elem_ptr, elem_size)
        // ⚠ 元素次参 tir.tc 按值发射，须用 ll_map_argptr 转指针（含字面量/右值，对齐旧轨
        //   emit-ll 的 `alloca elem; store v; → ptr` 模式；直接 ll_llname 当 ptr 会类型错配/段错误）。
        //   ll_map_argptr 会向 g_ll 追加 load/alloca/store 指令，必须先于 call 行求值发射，
        //   故先取到 elemptr 再写整条 call（否则指令会嵌进 call 操作数 → 语法错误）。
        var elemptr: string = ll_map_argptr(toks[5], llname.ll_get_st(toks[5]));
        // ⚠ slice 首参地址解析：
        //   - ident 局部槽(%TSlice) → ll_llname 直接即首参地址(alloca 即 ptr<%TSlice>)
        //   - 字段 GEP 结果被翻译器存进 alloca(ST=ptr<%TSlice>) → 须 ll_load 取出内部字段地址，
        //     否则传 ptr-to-ptr(t_slice_append_sized 解引用错层 → 段错误)。
        var slicest: string = llname.ll_get_st(toks[4]);
        var sliceptr: string;
        if (llname.ll_starts(slicest, "ptr<") || slicest == "ptr") {
            sliceptr = ll_load(toks[4], slicest);
        } else {
            sliceptr = llname.ll_llname(toks[4]);
        }
        sb_append_str(g_ll, "  call void @t_slice_append_sized(ptr ");
        sb_append_str(g_ll, sliceptr);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, elemptr);
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, esz);
        sb_append_str(g_ll, ")\n");
        ll_ensure_slot(d, "i64"); llname.ll_set_st(d, "i64"); ll_store(d, "i64", "0");
        return true;
    }
    // ── map_get：value 字节写入 dest 槽（%TStr 16B 足够覆盖 i64 标量）；
    //    返回 i32(found) 丢弃，d 保持 %TStr 承载取出的 value ──
    if (cn == "map_get") {
        // ⚠ map 实参须 load 出句柄（同 map_len/map_has/map_put）。
        var mp: string = ll_load(toks[4], "ptr");
        var kp: string = ll_map_argptr(toks[5], llname.ll_get_st(toks[5]));
        ll_ensure_slot(d, "%TStr"); llname.ll_set_st(d, "%TStr");
        var outp: string = llname.ll_llname(d);
        // ⚠ runtime tll_map_get 仅在「命中」时写入 out 槽；未命中时不动 out。
        // 故调用前须把 out 槽清零，使未命中返回零值（i64→0 / string→空），与 canonical
        // emit-ll 的语义（maps.expected.txt: get_bob=0 / int_miss=0）一致。否则读到未初始化栈垃圾。
        sb_append_str(g_ll, "  store %TStr zeroinitializer, ptr ");
        sb_append_str(g_ll, outp);
        sb_append_str(g_ll, "\n");
        ll_maybe_declare("tll_map_get", "i32", ["ptr", "ptr", "ptr"]);
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = call i32 @tll_map_get(ptr ");
        sb_append_str(g_ll, mp);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, kp);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, outp);
        sb_append_str(g_ll, ")\n");
        return true;
    }
    // ── 可选类型 ?T（可空指针模型）：some(x) 经 tll_opt_some 把 x arena 拷贝并返回指针 ──
    // 元素 LLVM 类型从实参槽类型取：标量 argst 即元素；聚合 argst 形如 %Point 即元素；指针 argst 即元素。
    // 旧实现仅取 x 的栈地址→ptrtoint（无拷贝），返回即悬空指针，unwrap 读出垃圾（optional_demo 现 42→1.3e11）。
    if (cn == "some") {
        var argst: string = llname.ll_get_st(toks[4]);
        var elem: string = argst;
        var oslot: string = ll_map_argptr(toks[4], argst);
        // sizeof(elem) = getelementptr <elem>, ptr null, i32 1 → ptrtoint to i64
        var szg: string = ll_tmp();
        sb_append_str(g_ll, "  "); sb_append_str(g_ll, szg);
        sb_append_str(g_ll, " = getelementptr "); sb_append_str(g_ll, llname.st_to_ll(elem));
        sb_append_str(g_ll, ", ptr null, i32 1\n");
        var sz: string = ll_tmp();
        sb_append_str(g_ll, "  "); sb_append_str(g_ll, sz);
        sb_append_str(g_ll, " = ptrtoint ptr "); sb_append_str(g_ll, szg);
        sb_append_str(g_ll, " to i64\n");
        ll_maybe_declare("tll_opt_some", "ptr", ["ptr", "i64"]);
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  "); sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = call ptr @tll_opt_some(ptr ");
        sb_append_str(g_ll, oslot);
        sb_append_str(g_ll, ", i64 "); sb_append_str(g_ll, sz);
        sb_append_str(g_ll, ")\n");
        var dstst: string = base.sb_cat3("ptr<", elem, ">");
        ll_ensure_slot(d, dstst); llname.ll_set_st(d, dstst); ll_store(d, dstst, r);
        return true;
    }
    if (cn == "is_some" || cn == "is_none") {
        var pv: string = ll_load(toks[4], "ptr");
        var pred: string = "ne";
        if (cn == "is_none") { pred = "eq"; }
        var cmp: string = ll_tmp();
        sb_append_str(g_ll, "  "); sb_append_str(g_ll, cmp);
        sb_append_str(g_ll, " = icmp "); sb_append_str(g_ll, pred);
        sb_append_str(g_ll, " ptr "); sb_append_str(g_ll, pv); sb_append_str(g_ll, ", null\n");
        var z: string = ll_tmp();
        sb_append_str(g_ll, "  "); sb_append_str(g_ll, z);
        sb_append_str(g_ll, " = zext i1 "); sb_append_str(g_ll, cmp); sb_append_str(g_ll, " to i64\n");
        ll_ensure_slot(d, "i64"); llname.ll_set_st(d, "i64"); ll_store(d, "i64", z);
        return true;
    }
    // ── time_invalid：编译期宏 T_TIME_INVALID = INT64_MIN ──
    if (cn == "time_invalid") {
        ll_ensure_slot(d, "i64"); llname.ll_set_st(d, "i64"); ll_store(d, "i64", "-9223372036854775808");
        return true;
    }
    // ── format_*：spec, value → TStr out ──
    if (cn == "format_int" || cn == "format_uint" || cn == "format_float" ||
        cn == "format_str" || cn == "format_bool" || cn == "format_char") {
        var fn2: string = base.sb_cat2("tll_", cn);
        var fmt_spec: string = llname.ll_llname(toks[4]);
        var argv2: []string = [fmt_spec];
        var argsts2: []string = ["ptr"];
        if (cn == "format_str") { append(argv2, llname.ll_llname(toks[5])); append(argsts2, "ptr"); }
        else if (cn == "format_bool") { append(argv2, ll_load(toks[5], "i8")); append(argsts2, "i8"); }
        else if (cn == "format_float") {
            // tll_sb_append_fmt_float 收 double；f32 实参须按真实存储类型 load 后 fpext 到 double，
            // 否则会把 4 字节 float 槽按 double(8 字节) load 出垃圾（例：single=-1.14908e-17）。
            // 立即数（字面量）ll_load 直接透传，其文本在 LLVM 中即 double，无需 fpext。
            var fast: string = llname.ll_get_st(toks[5]);
            var fv: string = ll_load(toks[5], fast);
            if (fast == "f32") {
                var fe: string = ll_tmp();
                sb_append_str(g_ll, "  "); sb_append_str(g_ll, fe);
                sb_append_str(g_ll, " = fpext float ");
                sb_append_str(g_ll, fv);
                sb_append_str(g_ll, " to double\n");
                fv = fe;
            }
            append(argv2, fv); append(argsts2, "double");
        }
        else { append(argv2, ll_load(toks[5], "i64")); append(argsts2, "i64"); }
        append(argv2, llname.ll_llname(d)); append(argsts2, "ptr");
        ll_ensure_slot(d, "%TStr"); llname.ll_set_st(d, "%TStr");
        ll_call_void(fn2, argsts2, argv2);
        return true;
    }
    // ── parse_time / parse_time_local：spec, s, use_local → i64（正常返回，d 存 i64 结果）──
    if (cn == "parse_time" || cn == "parse_time_local") {
        var ul: string = "0";
        // use_local 可选实参：缺省按 UTC(0)。原代码无条件读 toks[6]，前端省略该参时越界 panic。
        if (cn == "parse_time_local") { ul = "1"; }
        if (slice_len(toks) as i64 > 6) { ul = ll_load(toks[6], "i64"); }
        ll_ensure_slot(d, "i64"); llname.ll_set_st(d, "i64");
        var outp: string = llname.ll_llname(d);
        ll_maybe_declare("tll_parse_time", "i64", ["ptr", "ptr", "i64"]);
        var r: string = ll_tmp();
        sb_append_str(g_ll, "  "); sb_append_str(g_ll, r);
        sb_append_str(g_ll, " = call i64 @tll_parse_time(ptr ");
        sb_append_str(g_ll, llname.ll_llname(toks[4]));
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, llname.ll_llname(toks[5]));
        sb_append_str(g_ll, ", i64 ");
        sb_append_str(g_ll, ul);
        sb_append_str(g_ll, ")\n");
        ll_store(d, "i64", r);
        return true;
    }
    // ── format_time / format_time_local / format_time_tz：spec, t, [tz] → TStr out ──
    if (cn == "format_time" || cn == "format_time_local") {
        var ul: string = "0";
        // use_local 可选实参：缺省按 UTC(0)。原代码无条件读 toks[6]，前端省略该参时越界 panic。
        if (cn == "format_time_local") { ul = "1"; }
        if (slice_len(toks) as i64 > 6) { ul = ll_load(toks[6], "i64"); }
            ll_ensure_slot(d, "%TStr"); llname.ll_set_st(d, "%TStr");
            var outp: string = llname.ll_llname(d);
            // ⚠ ll_load 有副作用（向 g_ll 追加一条 load 指令），必须在「拼装 call 行」之前调用，
            // 否则 load 指令会被注入到正在拼装的 call 行中间 → 非法 IR。
            var ftv: string = ll_load(toks[5], "i64");
            ll_maybe_declare("tll_format_time", "void", ["ptr", "i64", "i64", "ptr"]);
            sb_append_str(g_ll, "  call void @tll_format_time(ptr ");
            sb_append_str(g_ll, llname.ll_llname(toks[4]));
            sb_append_str(g_ll, ", i64 ");
            sb_append_str(g_ll, ftv);
            sb_append_str(g_ll, ", i64 ");
            sb_append_str(g_ll, ul);
            sb_append_str(g_ll, ", ptr ");
            sb_append_str(g_ll, outp);
            sb_append_str(g_ll, ")\n");
            return true;
    }
        if (cn == "format_time_tz") {
            ll_ensure_slot(d, "%TStr"); llname.ll_set_st(d, "%TStr");
            var outp: string = llname.ll_llname(d);
            var tz: string = "0";
            if (slice_len(toks) as i64 > 6) { tz = ll_load(toks[6], "i64"); }
            // ⚠ ll_load 有副作用，须在拼装 call 行之前调用（见 format_time 注释）。
            var ftzv: string = ll_load(toks[5], "i64");
            ll_maybe_declare("tll_format_time_tz", "void", ["ptr", "i64", "i64", "ptr"]);
            sb_append_str(g_ll, "  call void @tll_format_time_tz(ptr ");
            sb_append_str(g_ll, llname.ll_llname(toks[4]));
            sb_append_str(g_ll, ", i64 ");
            sb_append_str(g_ll, ftzv);
            sb_append_str(g_ll, ", i64 ");
            sb_append_str(g_ll, tz);
            sb_append_str(g_ll, ", ptr ");
            sb_append_str(g_ll, outp);
            sb_append_str(g_ll, ")\n");
            return true;
        }
    // ── fid_error：f → TStr out ──
    if (cn == "fid_error") {
        ll_ensure_slot(d, "%TStr"); llname.ll_set_st(d, "%TStr");
        ll_call_void("tll_fid_error", ["i64", "ptr"],
                     [ll_load(toks[4], "i64"), llname.ll_llname(d)]);
        return true;
    }
    // ── fid_is_open / fid_eof：f → i32→i64 ──
    if (cn == "fid_is_open" || cn == "fid_eof") {
        var fn2: string = base.sb_cat2("tll_", cn);
        ll_call_ret(fn2, "i32", ["i64"], [ll_load(toks[4], "i64")], d);
        return true;
    }
    // ── file_read_all / path_resolve / getenv：path → TStr out ──
    if (cn == "file_read_all" || cn == "path_resolve" || cn == "getenv") {
        var fn2: string = "tll_getenv";
        if (cn == "file_read_all") { fn2 = "tll_file_read_all"; }
        else if (cn == "path_resolve") { fn2 = "tll_path_resolve"; }
        ll_ensure_slot(d, "%TStr"); llname.ll_set_st(d, "%TStr");
        ll_call_void(fn2, ["ptr", "ptr"], [llname.ll_llname(toks[4]), llname.ll_llname(d)]);
        return true;
    }
    // ── read_line：无参 → TStr out ──
    // ⚠ 必须走 tll_read_line 末位 out 指针 shim，不能直接 call %TStr @t_read_line()：
    // clang 在 Win64 把 16B %TStr 聚合返回编译为 sret 隐藏指针（void @t_read_line(ptr sret)），
    // 而编译器若按 RAX:RDX 按值返回发射 `call %TStr @t_read_line()`，调用方读到错位寄存器
    // → TStr.len 取到垃圾（常为 2^47）→ t_arena_alloc 触发 "arena: out of memory"。
    // file_read_all/path_resolve/getenv 同理已走 tll_ 末位 out 指针 shim，read_line 此前漏配，
    // 致 REPL（lib/repl.tc 调 read_line）在 LLVM 后端（含 out/dbg/tc.exe 自身）必 OOM。
    if (cn == "read_line") {
        ll_ensure_slot(d, "%TStr"); llname.ll_set_st(d, "%TStr");
        ll_call_void("tll_read_line", ["ptr"], [llname.ll_llname(d)]);
        return true;
    }
    // ── fid_format：f, a_text, a_json, a_raw, a_pb → i64 ──
    if (cn == "fid_format") {
        // a_text/a_json/a_raw/a_pb 均为可选实参：前端常省略，原代码无条件读 toks[5..8] 会越界 panic。
        // 缺省按 0（各标志位关闭）。
        var a0: string = ll_load(toks[4], "i64");
        var a1: string = "0";
        var a2: string = "0";
        var a3: string = "0";
        var a4: string = "0";
        if (slice_len(toks) as i64 > 5) { a1 = ll_load(toks[5], "i64"); }
        if (slice_len(toks) as i64 > 6) { a2 = ll_load(toks[6], "i64"); }
        if (slice_len(toks) as i64 > 7) { a3 = ll_load(toks[7], "i64"); }
        if (slice_len(toks) as i64 > 8) { a4 = ll_load(toks[8], "i64"); }
        ll_call_ret("tll_fid_format", "i64", ["i64", "i64", "i64", "i64", "i64"],
                    [a0, a1, a2, a3, a4], d);
        return true;
    }
    // ── fopen / fclose / fseek / ftell / fmt_register ──
    if (cn == "fopen") {
        ll_call_ret("tll_fopen", "i64", ["ptr", "i32"],
                    [llname.ll_llname(toks[4]), ll_load(toks[5], "i32")], d);
        return true;
    }
    if (cn == "fclose") {
        ll_call_void("tll_fclose", ["i64"], [ll_load(toks[4], "i64")]);
        return true;
    }
    if (cn == "fseek") {
        ll_call_ret("tll_fseek", "i32", ["i64", "i64"],
                    [ll_load(toks[4], "i64"), ll_load(toks[5], "i64")], d);
        return true;
    }
    if (cn == "ftell") {
        ll_call_ret("tll_ftell", "i64", ["i64"], [ll_load(toks[4], "i64")], d);
        return true;
    }
    if (cn == "fmt_register") {
        ll_call_void("tll_fmt_register", ["i32", "ptr", "i32"],
                     [ll_load(toks[4], "i32"), llname.ll_llname(toks[5]), ll_load(toks[6], "i32")]);
        return true;
    }
    // ── tll_deser_str：void + 显式 sret（out 末位 ptr 实参）──
    // 通用 void 调用路径不 declare 该函数，且其运行期签名为 void（非聚合自动 sret），
    // 故特判：预留 out 槽 + declare + 发射 `call void @tll_deser_str(i64, ptr)`。
    if (cn == "tll_deser_str") {
        ll_ensure_slot(toks[5], "%TStr"); llname.ll_set_st(toks[5], "%TStr");
        ll_maybe_declare("tll_deser_str", "void", ["i64", "ptr"]);
        // ⚠ ll_load 会立即把 load 语句 append 到 g_ll，必须先取好寄存器名再拼 call 行，
        // 否则 load 语句会插进 call 行中间 → IR 非法。
        var fidv: string = ll_load(toks[4], "i64");
        sb_append_str(g_ll, "  call void @tll_deser_str(i64 ");
        sb_append_str(g_ll, fidv);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, llname.ll_llname_ptr(toks[5]));
        sb_append_str(g_ll, ")\n");
        return true;
    }
    // ── sb_append_fmt_*：void，忽略 i64 返回 ──
    if (llname.ll_starts(cn, "sb_append_fmt")) {
        var fn2: string = base.sb_cat2("tll_", cn);
        // ⚠ 首实参（StringBuilder 句柄 __fb）必须 ll_load 取值，不能像 sb_append_fmt_str 的
        // 字符串实参那样直接取槽地址：槽 __fb 持有的是 ptr 句柄，取址会传 TSb** 给
        // tll_sb_append_fmt_*（其形参为 ptr）→ 写入野指针 → 段错误（波及全部 format()/f-string 插值）。
        var bp: string = ll_load(toks[4], "ptr");
        var fmt_spec_b: string = llname.ll_llname(toks[5]);
        var argv2: []string = [bp, fmt_spec_b];
        var argsts2: []string = ["ptr", "ptr"];
        if (cn == "sb_append_fmt_int" || cn == "sb_append_fmt_uint" || cn == "sb_append_fmt_char") {
            append(argv2, ll_fmt_int_arg(toks[6], cn)); append(argsts2, "i64");
        } else if (cn == "sb_append_fmt_float") {
            // tll_sb_append_fmt_float 收 double；f32 实参须按真实存储类型 load 后 fpext 到 double，
            // 否则把 4 字节 float 槽按 double(8 字节) load 出垃圾（例：single=-1.14908e-17）。
            var fst: string = llname.ll_get_st(toks[6]);
            var fv: string = ll_load(toks[6], fst);
            if (fst == "f32") {
                var fe: string = ll_tmp();
                sb_append_str(g_ll, "  "); sb_append_str(g_ll, fe);
                sb_append_str(g_ll, " = fpext float ");
                sb_append_str(g_ll, fv);
                sb_append_str(g_ll, " to double\n");
                fv = fe;
            }
            append(argv2, fv); append(argsts2, "double");
        } else if (cn == "sb_append_fmt_bool") {
            append(argv2, ll_load(toks[6], "i8")); append(argsts2, "i8");
        } else if (cn == "sb_append_fmt_str") {
            append(argv2, llname.ll_llname(toks[6])); append(argsts2, "ptr");
        } else if (cn == "sb_append_fmt_str_conv" || cn == "sb_append_fmt_int_conv" || cn == "sb_append_fmt_uint_conv") {
            append(argv2, llname.ll_llname(toks[6])); append(argsts2, "ptr");
            append(argv2, llname.ll_llname(toks[7])); append(argsts2, "ptr");
        } else if (cn == "sb_append_fmt_big") {
            append(argv2, llname.ll_llname(toks[6])); append(argsts2, "ptr");
            append(argv2, ll_load(toks[7], "i64")); append(argsts2, "i64");
            append(argv2, ll_load(toks[8], "i8")); append(argsts2, "i8");
        }
        ll_call_void(fn2, argsts2, argv2);
        ll_ensure_slot(d, "i64"); llname.ll_set_st(d, "i64"); ll_store(d, "i64", "0");
        return true;
    }
    // ── @math builtins（fabs/sqrt/sin/.../f32 变体/谓词） → t_math_<name> ──
    // 与 C 后端 emit_math_call（t_math_<cn>）及下方 math__ 块同构。此前 @fabs 等裸名内建
    // 落入 ll_runtime_callee 通用路径被加 t_ 前缀 → t_fabs，而 runtime 仅定义 t_math_fabs（无 t_fabs）
    // → 链接 undefined；且返回类型被误判 i64。此处显式拦截，发 t_math_<cn> 并据尾缀定 double/float/i32。
    // 整数辅助（abs/gcd/...）与 pow_i 不在此列（math_is_mbuiltin_c 已排除），走普通函数调用。
    if (llname.ll_starts(cn, "math__") == false && codegen_c__math_is_mbuiltin_c(cn)) {
        var ty: string = "double";
        // 谓词类（isnan/isinf/isfinite/isnormal/signbit）返回 i32，而非浮点。
        if (cn == "signbit" || cn == "isnan" || cn == "isinf" || cn == "isfinite" || cn == "isnormal") {
            ty = "i32";
        } else {
            var Lm: i64 = str_len(cn);
            if (Lm >= 1 && str_at(cn, Lm - 1) == 102) { ty = "float"; }   // 裸 f 后缀 = f32 变体
        }
        var fn2: string = base.sb_cat2("t_math_", cn);
        var argc2: i64 = slice_len(toks) as i64 - 4;
        var argv2: []string = [];
        var argsts2: []string = [];
        var mi: i64 = 0;
        while (mi < argc2) {
            var argnm2: string = toks[4 + mi];
            var realst2: string = llname.ll_alloca_st(argnm2);
            var av2: string = ll_load(argnm2, ty);
            if (realst2 == "double" && ty == "float") {
                var fv2: string = ll_tmp();
                sb_append_str(g_ll, "  "); sb_append_str(g_ll, fv2);
                sb_append_str(g_ll, " = fptrunc double "); sb_append_str(g_ll, av2);
                sb_append_str(g_ll, " to float\n");
                av2 = fv2;
            }
            append(argv2, av2);
            append(argsts2, ty);
            mi = mi + 1;
        }
        ll_call_ret(fn2, ty, argsts2, argv2, d);
        return true;
    }
    // ── math__*：裸名 → t_math_<base>（f32 变体名以 f 结尾或 _f）──
    if (llname.ll_starts(cn, "math__")) {
        var base2: string = str_slice(cn, 6, str_len(cn));
        var isf: bool = false;
        var L: i64 = str_len(base2);
        // ⚠ 区分两种命名（修复 fmin_f/fmax_f/copysign_f 返回 0 的 bug）：
        //   • std f64 包装函数 fmin_f/fmax_f/copysign_f 以 "_f" 结尾 → 去 "_f" 得 f64 内建基名
        //     （fmin/fmax/copysign），走 double 变体 t_math_fmin 等（与 math.tc 声明 f64 一致）。
        //   • 真实 f32 内建变体（sinf/sqrtf/fabsf/fminf/copysignf…）以 "f" 结尾（无下划线）→ float 变体。
        //   旧逻辑把 "_f" 错当 f32 后缀（fmin_f→fminf）发出 float 调用，实参 double 喂 float → 返回 0。
        if (L >= 2 && str_at(base2, L - 2) == 95 && str_at(base2, L - 1) == 102) {
            base2 = str_slice(base2, 0, L - 2);
            isf = false;
        } else if (L >= 1 && str_at(base2, L - 1) == 102) {
            isf = true;
        }
        // ⚠ 仅对「真正的浮点 libm 内建名」拦截并改写 t_math_<base>；
        // math 模块里的整数辅助函数（abs/sign/gcd/min/max/clamp/div_floor/div_ceil/
        // mod_e/ilog2/pow2_i/is_pow2/next_multiple_of/lerp_i）与 pow_i 都是真实函数，
        // 必须走普通函数调用，否则会被误写成 t_math_abs(double) 等导致类型错乱 / 链接失败。
        if (codegen_c__math_is_mbuiltin_c(base2) == false) {
            return false;
        }
        var ty: string = "double";
        if (isf) { ty = "float"; }
        // ⚠ 参数按「槽真实类型」加载，仅当 f32 调用且实参槽为 double 时补 fptrunc：
        // 前端对 f32 实参存储类型不一致（f32 字面量常量存成 double 槽、fptrunc 结果存成 float 槽）。
        // 直接按 ty(float) 加载 double 槽会从 8 字节读 4 字节低位垃圾（如 -3.5f32 读成 0.0）→ fabsf/fminf/... 返回 0；
        // 直接按 double 加载 float 槽会多读 4 字节高位垃圾 → sqrtf/... 返回巨大/微小值。
        // 故按槽真实类型加载（float 槽读 float、double 槽读 double），f32 调用遇 double 实参再 fptrunc 到 float。
        var fn2: string = base.sb_cat2("t_math_", base2);
        var argc: i64 = slice_len(toks) as i64 - 4;
        var argv2: []string = [];
        var argsts2: []string = [];
        var i: i64 = 0;
        while (i < argc) {
            // 按槽真实 alloca 宽度加载；f32 调用且实参槽为 double 时补 fptrunc：
            // 前端对 f32 实参存储类型不一致（f32 字面量/表达式均存成 double 槽），
            // 直接按 float 加载 double 槽会读 8 字节低位 4 字节垃圾（如 -3.5f32 读成 0.0）→ fabsf 返回 0。
            // 故先按真实宽度加载为 double，再 fptrunc 到 float。float 槽（如 sqrtf 的 fptrunc 结果）则不转换。
            var argnm: string = toks[4 + i];
            var realst: string = llname.ll_alloca_st(argnm);
            var av: string = ll_load(argnm, ty);
            if (realst == "double" && ty == "float") {
                var fv: string = ll_tmp();
                sb_append_str(g_ll, "  "); sb_append_str(g_ll, fv);
                sb_append_str(g_ll, " = fptrunc double "); sb_append_str(g_ll, av);
                sb_append_str(g_ll, " to float\n");
                av = fv;
            }
            append(argv2, av);
            append(argsts2, ty);
            i = i + 1;
        }
        ll_call_ret(fn2, ty, argsts2, argv2, d);
        return true;
    }
    // ── SIMD 向量内建（@vlen / @reduce_* / @splat）──────────────────────
    // 与旧轨 codegen_ll.ll_vec_mbuiltin 语义逐位对齐：门禁比的是程序输出而非 IR，
    // 故此处直接用 LLVM 原生 `<N x T>` 向量指令（extractelement 逐 lane 折叠 / shufflevector 广播），
    // 不依赖 llvm.vector.reduce.* intrinsic（其 lane 类型约束更严）。
    // 与旧轨同构：reduce 用串行 extractelement + 标量 fold（含溢出行为一致），max/min 用
    // icmp/fcmp + select（signed→sgt/slt，unsigned→ugt/ult，float→ogt/olt）。
    if (cn == "vlen" || cn == "reduce_add" || cn == "reduce_max" || cn == "reduce_min" ||
        cn == "reduce_mul" || cn == "reduce_or" || cn == "reduce_and" || cn == "splat") {
        var vst: string = "";
        if (cn == "splat") { vst = toks[1]; }            // @splat 的返回类型即 vec<elem x N>
        else { vst = llname.ll_get_st(toks[4]); }               // 其余：首实参（向量）的类型
        // 解析 vec<elem x N> → (elem_st, N)
        var inner: string = "";
        var elem: string = "i32";
        var N: i64 = 0;
        if (llname.ll_starts(vst, "vec<")) {
            inner = str_slice(vst, 4, str_len(vst) - 1);
            var sp: i64 = llname.ll_rfind(inner, " x ");
            if (sp >= 0) {
                elem = str_slice(inner, 0, sp);
                var nn: string = str_slice(inner, sp + 3, str_len(inner));
                N = ll_atoi(nn);
            }
        }
        var llst: string = llname.st_to_ll(elem);   // 元素 LLVM 类型（i32 / double ...）
        if (cn == "vlen") {
            // @vlen(v)：lane 数编译期已知 → 直接发字面量 i64
            var nv: string = base.i2s(N);
            ll_ensure_slot(d, "i64"); llname.ll_set_st(d, "i64"); ll_store(d, "i64", nv);
            return true;
        }
        if (cn == "splat") {
            // @splat(s, N)：insertelement 写 lane0 + shufflevector 全 0 掩码广播
            var sval: string = ll_load(toks[4], llst);
            var vty: string = llname.st_to_ll(vst);
            var ins: string = ll_tmp();
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, ins);
            sb_append_str(g_ll, " = insertelement ");
            sb_append_str(g_ll, vty);
            sb_append_str(g_ll, " undef, ");
            sb_append_str(g_ll, llst);
            sb_append_str(g_ll, " ");
            sb_append_str(g_ll, sval);
            sb_append_str(g_ll, ", i32 0\n");
            var mask: StringBuilder = sb_new();
            sb_append_str(mask, "<");
            sb_append_str(mask, base.i2s(N));
            sb_append_str(mask, " x i32> <");
            var mi: i64 = 0;
            while (mi < N) {
                if (mi > 0) { sb_append_str(mask, ", "); }
                sb_append_str(mask, "i32 0");
                mi = mi + 1;
            }
            sb_append_str(mask, ">");
            var res: string = ll_tmp();
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, res);
            sb_append_str(g_ll, " = shufflevector ");
            sb_append_str(g_ll, vty);
            sb_append_str(g_ll, " ");
            sb_append_str(g_ll, ins);
            sb_append_str(g_ll, ", ");
            sb_append_str(g_ll, vty);
            sb_append_str(g_ll, " undef, ");
            sb_append_str(g_ll, sb_to_str(mask));
            sb_append_str(g_ll, "\n");
            ll_ensure_slot(d, vst); llname.ll_set_st(d, vst); ll_store(d, vst, res);
            return true;
        }
        // ── reduce_*：extractelement 逐 lane 后串行折叠 ──
        var val: string = ll_load(toks[4], vst);
        var lanes: []string = [];
        var j: i64 = 0;
        while (j < N) {
            var le: string = ll_tmp();
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, le);
            sb_append_str(g_ll, " = extractelement ");
            sb_append_str(g_ll, llname.st_to_ll(vst));
            sb_append_str(g_ll, " ");
            sb_append_str(g_ll, val);
            sb_append_str(g_ll, ", i32 ");
            sb_append_str(g_ll, base.i2s(j));
            sb_append_str(g_ll, "\n");
            append(lanes, le);
            j = j + 1;
        }
        if (slice_len(lanes) as i64 == 0) {
            // 空向量：reduce 退化为零值（与旧轨 ll_zero(elem) 一致）
            var z: string = "0";
            if (ll_is_float(elem)) { z = "0.0"; }
            ll_ensure_slot(d, llst); llname.ll_set_st(d, llst); ll_store(d, llst, z);
            return true;
        }
        var acc: string = lanes[0];
        var k: i64 = 1;
        while (k < slice_len(lanes) as i64) {
            var lv: string = lanes[k];
            if (cn == "reduce_add" || cn == "reduce_mul") {
                var r: string = ll_tmp();
                sb_append_str(g_ll, "  ");
                sb_append_str(g_ll, r);
                sb_append_str(g_ll, " = ");
                if (cn == "reduce_add") {
                    if (ll_is_float(elem)) { sb_append_str(g_ll, "fadd"); } else { sb_append_str(g_ll, "add"); }
                } else {
                    if (ll_is_float(elem)) { sb_append_str(g_ll, "fmul"); } else { sb_append_str(g_ll, "mul"); }
                }
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, llst);
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, acc);
                sb_append_str(g_ll, ", ");
                sb_append_str(g_ll, lv);
                sb_append_str(g_ll, "\n");
                acc = r;
            } else if (cn == "reduce_or" || cn == "reduce_and") {
                var r: string = ll_tmp();
                sb_append_str(g_ll, "  ");
                sb_append_str(g_ll, r);
                sb_append_str(g_ll, " = ");
                if (cn == "reduce_or") { sb_append_str(g_ll, "or"); } else { sb_append_str(g_ll, "and"); }
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, llst);
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, acc);
                sb_append_str(g_ll, ", ");
                sb_append_str(g_ll, lv);
                sb_append_str(g_ll, "\n");
                acc = r;
            } else {
                // reduce_max / reduce_min：icmp/fcmp + select
                var is_max: bool = (cn == "reduce_max");
                var pred: string = "sgt";
                var cmpkind: string = "icmp";
                if (ll_is_float(elem)) {
                    cmpkind = "fcmp";
                    if (is_max) { pred = "ogt"; } else { pred = "olt"; }
                } else if (ll_is_unsigned_st(elem)) {
                    if (is_max) { pred = "ugt"; } else { pred = "ult"; }
                } else {
                    if (is_max) { pred = "sgt"; } else { pred = "slt"; }
                }
                var cmpt: string = ll_tmp();
                sb_append_str(g_ll, "  ");
                sb_append_str(g_ll, cmpt);
                sb_append_str(g_ll, " = ");
                sb_append_str(g_ll, cmpkind);
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, pred);
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, llst);
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, acc);
                sb_append_str(g_ll, ", ");
                sb_append_str(g_ll, lv);
                sb_append_str(g_ll, "\n");
                var selt: string = ll_tmp();
                sb_append_str(g_ll, "  ");
                sb_append_str(g_ll, selt);
                sb_append_str(g_ll, " = select i1 ");
                sb_append_str(g_ll, cmpt);
                sb_append_str(g_ll, ", ");
                sb_append_str(g_ll, llst);
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, acc);
                sb_append_str(g_ll, ", ");
                sb_append_str(g_ll, llst);
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, lv);
                sb_append_str(g_ll, "\n");
                acc = selt;
            }
            k = k + 1;
        }
        ll_ensure_slot(d, llst); llname.ll_set_st(d, llst); ll_store(d, llst, acc);
        return true;
    }
    // ── @Tile 瓦片内建（@tsplat 构造 / @treduce_* 归约）────────────────
    // 与旧轨 ll_vec_mbuiltin 的 tsplat/treduce_* 分支逐位对齐：瓦片 = 嵌套定长数组
    // arr<arr<elem x cols> x rows>，逐元素 GEP 写/读后折叠（max/min 用 icmp/fcmp + select）。
    // 类型解析用「末位顶层 " x "」定行数、内层 " x " 定列数（元素为标量/向量均无空格，rfind 安全）。
    if (cn == "tsplat") {
        var vst: string = toks[1];
        if (llname.ll_starts(vst, "ptr<arr<arr<")) { vst = str_slice(vst, 4, str_len(vst) - 1); }
        var elem: string = "i32";
        var rows: i64 = 1;
        var cols: i64 = 1;
        var p2: i64 = llname.ll_rfind(vst, " x ");
        if (p2 >= 0) {
            rows = ll_atoi(str_slice(vst, p2 + 3, str_len(vst)));
            var rowType: string = str_slice(vst, 0, p2);
            var inner: string = str_slice(rowType, 4, str_len(rowType) - 1);
            var p1: i64 = llname.ll_rfind(inner, " x ");
            if (p1 >= 0) {
                // ⚠ 瓦片 2 层嵌套：inner 形如 "arr<i32 x 3>"（rowType 已剥过一层 "arr<"，
                // 这里 inner = "arr<i32 x 3"，末尾 ">" 已切），需再剥一层 "arr<" 才得元素 i32。
                // 漏剥会让 elem = "arr<i32" → st_to_ll 兜底成 "ptr" ⇒ `store ptr %v, ptr %gep`
                // （元素被当指针存，clang: defined with type 'i64' but expected 'ptr'），
                // 这是 tile_demo 早期瓦片元素发射错位的一个根因，已于 2026-09-20 修复
                // （同时修复 inst.st 为空时从 inst.args[0].st 回退聚合类型）。
                elem = str_slice(inner, 4, p1);
                cols = ll_atoi(str_slice(inner, p1 + 3, str_len(inner)));
            }
        }
        var llst: string = llname.st_to_ll(elem);
        var sval: string = ll_load(toks[4], llst);
        ll_ensure_slot(d, vst); llname.ll_set_st(d, vst);
        var total: i64 = rows * cols;
        var ii: i64 = 0;
        while (ii < total) {
            var ri2: i64 = ii / cols;
            var ci2: i64 = ii % cols;
            var gp: string = ll_tmp();
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, gp);
            sb_append_str(g_ll, " = getelementptr inbounds ");
            sb_append_str(g_ll, llname.st_to_ll(vst));
            sb_append_str(g_ll, ", ptr ");
            sb_append_str(g_ll, d);
            sb_append_str(g_ll, ", i64 0, i64 ");
            sb_append_str(g_ll, base.i2s(ri2));
            sb_append_str(g_ll, ", i64 ");
            sb_append_str(g_ll, base.i2s(ci2));
            sb_append_str(g_ll, "\n");
            sb_append_str(g_ll, "  store ");
            sb_append_str(g_ll, llst);
            sb_append_str(g_ll, " ");
            sb_append_str(g_ll, sval);
            sb_append_str(g_ll, ", ptr ");
            sb_append_str(g_ll, gp);
            sb_append_str(g_ll, "\n");
            ii = ii + 1;
        }
        return true;
    }
    if (cn == "treduce_sum" || cn == "treduce_mul" || cn == "treduce_min" || cn == "treduce_max") {
        var vst: string = llname.ll_get_st(toks[4]);
        if (llname.ll_starts(vst, "ptr<arr<arr<")) { vst = str_slice(vst, 4, str_len(vst) - 1); }
        var elem: string = "i32";
        var rows: i64 = 1;
        var cols: i64 = 1;
        var p2b: i64 = llname.ll_rfind(vst, " x ");
        if (p2b >= 0) {
            rows = ll_atoi(str_slice(vst, p2b + 3, str_len(vst)));
            var rowType2: string = str_slice(vst, 0, p2b);
            var inner2: string = str_slice(rowType2, 4, str_len(rowType2) - 1);
            var p1b: i64 = llname.ll_rfind(inner2, " x ");
            if (p1b >= 0) {
                // ⚠ 瓦片 2 层嵌套：inner2 形如 "arr<i32 x 3>"，需再剥一层 "arr<" 才得元素类型 i32
                elem = str_slice(inner2, 4, p1b);
                cols = ll_atoi(str_slice(inner2, p1b + 3, str_len(inner2)));
            }
        }
        var llst2: string = llname.st_to_ll(elem);
        var total2: i64 = rows * cols;
        var lanes2: []string = [];
        var ii2: i64 = 0;
        while (ii2 < total2) {
            var ri3: i64 = ii2 / cols;
            var ci3: i64 = ii2 % cols;
            var gp2: string = ll_tmp();
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, gp2);
            sb_append_str(g_ll, " = getelementptr inbounds ");
            sb_append_str(g_ll, llname.st_to_ll(vst));
            sb_append_str(g_ll, ", ptr ");
            sb_append_str(g_ll, llname.ll_llname(toks[4]));
            sb_append_str(g_ll, ", i64 0, i64 ");
            sb_append_str(g_ll, base.i2s(ri3));
            sb_append_str(g_ll, ", i64 ");
            sb_append_str(g_ll, base.i2s(ci3));
            sb_append_str(g_ll, "\n");
            var lv2: string = ll_tmp();
            sb_append_str(g_ll, "  ");
            sb_append_str(g_ll, lv2);
            sb_append_str(g_ll, " = load ");
            sb_append_str(g_ll, llst2);
            sb_append_str(g_ll, ", ptr ");
            sb_append_str(g_ll, gp2);
            sb_append_str(g_ll, "\n");
            append(lanes2, lv2);
            ii2 = ii2 + 1;
        }
        if (slice_len(lanes2) as i64 == 0) {
            var z2: string = "0";
            if (ll_is_float(elem)) { z2 = "0.0"; }
            ll_ensure_slot(d, llst2); llname.ll_set_st(d, llst2); ll_store(d, llst2, z2);
            return true;
        }
        var acc2: string = lanes2[0];
        var k2: i64 = 1;
        while (k2 < slice_len(lanes2) as i64) {
            var lv3: string = lanes2[k2];
            if (cn == "treduce_sum" || cn == "treduce_mul") {
                var r2: string = ll_tmp();
                sb_append_str(g_ll, "  ");
                sb_append_str(g_ll, r2);
                sb_append_str(g_ll, " = ");
                if (cn == "treduce_sum") { if (ll_is_float(elem)) { sb_append_str(g_ll, "fadd"); } else { sb_append_str(g_ll, "add"); } }
                else { if (ll_is_float(elem)) { sb_append_str(g_ll, "fmul"); } else { sb_append_str(g_ll, "mul"); } }
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, llst2);
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, acc2);
                sb_append_str(g_ll, ", ");
                sb_append_str(g_ll, lv3);
                sb_append_str(g_ll, "\n");
                acc2 = r2;
            } else {
                var is_max2: bool = (cn == "treduce_max");
                var pred2: string = "sgt";
                var cmpkind2: string = "icmp";
                if (ll_is_float(elem)) {
                    cmpkind2 = "fcmp";
                    if (is_max2) { pred2 = "ogt"; } else { pred2 = "olt"; }
                } else if (ll_is_unsigned_st(elem)) {
                    if (is_max2) { pred2 = "ugt"; } else { pred2 = "ult"; }
                } else {
                    if (is_max2) { pred2 = "sgt"; } else { pred2 = "slt"; }
                }
                var cmpt2: string = ll_tmp();
                sb_append_str(g_ll, "  ");
                sb_append_str(g_ll, cmpt2);
                sb_append_str(g_ll, " = ");
                sb_append_str(g_ll, cmpkind2);
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, pred2);
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, llst2);
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, acc2);
                sb_append_str(g_ll, ", ");
                sb_append_str(g_ll, lv3);
                sb_append_str(g_ll, "\n");
                var selt2: string = ll_tmp();
                sb_append_str(g_ll, "  ");
                sb_append_str(g_ll, selt2);
                sb_append_str(g_ll, " = select i1 ");
                sb_append_str(g_ll, cmpt2);
                sb_append_str(g_ll, ", ");
                sb_append_str(g_ll, llst2);
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, acc2);
                sb_append_str(g_ll, ", ");
                sb_append_str(g_ll, llst2);
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, lv3);
                sb_append_str(g_ll, "\n");
                acc2 = selt2;
            }
            k2 = k2 + 1;
        }
        ll_ensure_slot(d, llst2); llname.ll_set_st(d, llst2); ll_store(d, llst2, acc2);
        return true;
    }
    return false;
}

// call 指令 → 重建 token 序列（仅供 ll_emit_builtin 内建分发复用其位置约定；
// 主发射逻辑直接读 inst 结构化字段，不再依赖 toks）。
pub fn tir_call_to_toks(inst: TIRInst) []string {
    var toks: []string = ["call", tir.tir_st_to_str(inst.st)];
    if (str_len(inst.dst.name) > 0) { append(toks, inst.dst.name); }
    var k: i64 = 0;
    var an: i64 = slice_len(inst.args) as i64;
    while (k < an) { append(toks, inst.args[k].name); k = k + 1; }
    return toks;
}

// 结构化指令发射：直接消费 inst.op / inst.st / inst.dst / inst.args，
// 不再对整行文本做 split→tokenize 位置解析（§5.6）。类型恢复仍用 g_ll_*
// （翻译期内生寄存器类型表，记录派生/前向类型，属 codegen 内部状态，非层间字符串传递）。
pub fn ll_emit_inst(inst: TIRInst) void {
    if (getenv("T_LL_TRACE") == "1") { eprint(base.sb_cat3("[LL] ", base.i2s(inst.op), base.sb_cat3(" dst=", inst.dst.name, "\n"))); }
    var op: i64 = inst.op;
    if (op == tir__TIR_OP_RET || op == tir__TIR_OP_RET_VOID) {
        if (op == tir__TIR_OP_RET_VOID || str_len(tir.tir_st_to_str(inst.st)) == 0) {
            sb_append_str(g_ll, "  ret void\n");
        } else {
            var st: string = tir.tir_st_to_str(inst.st);
            var d: string = inst.dst.name;
            var v: string = ll_load(d, st);
            if (str_len(d) >= 1 && d[0] == 64) {
                var mref: string = llname.ll_mangle(str_slice(d, 1, str_len(d)));
                if (ll_is_func(mref)) { v = ll_emit_closure_const(mref, st); }
            }
            if (g_cur_sret != "") {
                // 聚合 sret 返回：把值写入 sret 槽，ret void
                sb_append_str(g_ll, "  store ");
                sb_append_str(g_ll, llname.st_to_ll(st));
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, v);
                sb_append_str(g_ll, ", ptr ");
                sb_append_str(g_ll, g_cur_sret);
                sb_append_str(g_ll, "\n  ret void\n");
            } else {
                sb_append_str(g_ll, "  ret ");
                sb_append_str(g_ll, llname.st_to_ll(st));
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, v);
                sb_append_str(g_ll, "\n");
            }
        }
        return;
    }
    if (op == tir__TIR_OP_SLOT) {
        // ⚠ 飞地规避：tir_to_ll.tc 大模块 SLOT 分支读 inst 任意字符串字段（dst.name/args[0].name/cmt）
        // 均被种子错编成函数名 "main"，导致槽漏分配/错命名（generics_demo/fid_read_demo/map_iter clang 失败）。
        // 故 SLOT 不再在此分配槽；改由 STORE/LOAD 分支（编译正确）惰性 ll_ensure_slot（见 ll_store/ll_load），
        // 其 tname 读取正确，能产出 %main.<var> 正确名。
        return;
    }
    if (op == tir__TIR_OP_CONST_STR) {
        var d: string = inst.dst.name;
        var idx: string = inst.args[0].name;
        ll_ensure_slot(d, "%TStr");
        llname.ll_set_st(d, "%TStr");
        var gp: string = base.sb_cat2("@.tirll_tstr", idx);
        var tmp: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, tmp);
        sb_append_str(g_ll, " = load %TStr, ptr ");
        sb_append_str(g_ll, gp);
        sb_append_str(g_ll, "\n");
        sb_append_str(g_ll, "  store %TStr ");
        sb_append_str(g_ll, tmp);
        sb_append_str(g_ll, ", ptr ");
        sb_append_str(g_ll, llname.ll_llname(d));
        sb_append_str(g_ll, "\n");
        return;
    }
    if (op == tir__TIR_OP_CONST_PTR_NULL) {
        var d: string = inst.dst.name;
        ll_ensure_slot(d, "ptr");
        llname.ll_set_st(d, "ptr");
        ll_store(d, "ptr", "null");
        return;
    }
    if (op == tir__TIR_OP_TYPEINFO) {
        // type_info(T)：合成 @__ti_<T>_meta（%TypeMeta 全局），用生成的
        // TypeInfo_from_<Kind> 构造器包成 variant 值存入结果槽。
        // ⚠ variant 值在双后端均为「指向 variant 数据的指针」：先 alloca 16B 数据槽
        // { i64 tag, ptr meta }（与 C 侧 base__TypeInfo 同构），构造器把 tag@0/meta@8 写进该槽，
        // d 存其指针。不可把 d 直接当 8B ptr 槽传给构造器——构造器会写 16B，溢出 8B 槽 → 写穿相邻栈帧。
        // 用内联结构类型 alloca { i64, ptr }，避免依赖 %TypeInfo 是否已被声明为具体类型（其可能为 opaque）。
        var d: string = inst.dst.name;
        var tname: string = inst.args[0].name;
        var arm: string = ll_ti_arm(tname);
        var gmeta: string = ll_emit_ti_global(tname);
        ll_emit_ti_ctor_def();   // 首用 type_info 时一次性注入 TypeInfo_from_<Kind> define
        var ap: string = ll_tmp();
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, ap);
        sb_append_str(g_ll, " = alloca { i64, ptr }\n");
        ll_ensure_slot(d, "ptr");
        llname.ll_set_st(d, "ptr");
        if (arm == "Bool") {
            ll_call_void(base.sb_cat2("TypeInfo_from_", arm), ["ptr"], [ap]);
        } else {
            ll_call_void(base.sb_cat2("TypeInfo_from_", arm), ["ptr", "ptr"], [ap, gmeta]);
        }
        ll_store(d, "ptr", ap);
        return;
    }
    if (op == tir__TIR_OP_CONST || op == tir__TIR_OP_CONST_STR || op == tir__TIR_OP_CONST_PTR_NULL) {
        var st: string;
        var d: string = inst.dst.name;
        var imm: string = inst.args[0].name;
        st = tir.tir_st_to_str(inst.st);
        var nimm: string = ll_norm_imm(imm, st);
        ll_ensure_slot(d, st);
        llname.ll_set_st(d, st);
        ll_store(d, st, nimm);
        return;
    }
    if (op == tir__TIR_OP_BITCAST) {
        var dstst0: string = tir.tir_st_to_str(inst.st);
        var dst: string = inst.dst.name;
        var src: string = inst.args[0].name;
        var sgst: string = llname.ll_get_st(src);
        // 目标为聚合（%TStr / %st.Pt / %TSlice …）的 bitcast：语义是「值搬运」，不是
        // 「取地址」。此前与标量同路：要么把值槽的地址当结果（`ret %TStr <ptr>`），要么把
        // %Pt 槽按回落的 i64 load 再 inttoptr（`ret %Pt <ptr>`）—— clang -c 均报错。
        // ⚠ 源的登记类型不可靠（match 结果槽 __mres 常被登记成 i64），故一律按目标类型取值。
        if (llname.ll_starts(dstst0, "%") && llname.ll_starts(sgst, "arr<") == false && llname.ll_starts(sgst, "vec<") == false && llname.ll_starts(sgst, "ptr") == false && sgst != "ptr") {
            var bv: string = ll_load(src, dstst0);
            ll_ensure_slot(dst, dstst0);
            llname.ll_set_st(dst, dstst0);
            ll_store(dst, dstst0, bv);
            return;
        }
        var src_is_ptr: bool = llname.ll_starts(sgst, "ptr<") || sgst == "ptr" ||
                                llname.ll_starts(sgst, "arr<") || llname.ll_starts(sgst, "vec<");
        var dstst_eff: string = dstst0;
        if (src_is_ptr && llname.ll_starts(dstst0, "ptr<") == false && llname.ll_starts(dstst0, "%") == false && ll_is_scalar_st(dstst0)) {
            dstst_eff = base.sb_cat3("ptr<", dstst0, ">");
        }
        if (dstst0 == "ptr<void>" || dstst0 == "ptr") {
            dstst_eff = sgst;
        }
        var dll: string = llname.st_to_ll(dstst_eff);
        if (llname.ll_starts(dstst_eff, "arr<") || llname.ll_starts(dstst_eff, "vec<") || llname.ll_starts(dstst_eff, "%")) { dll = "ptr"; }
        var srcv: string;
        if (sgst == "ptr" || llname.ll_starts(sgst, "ptr<")) {
            srcv = ll_load(src, sgst);
        } else if (llname.ll_starts(sgst, "arr<") || llname.ll_starts(sgst, "vec<")) {
            srcv = llname.ll_llname_ptr(src);
        } else if (llname.ll_starts(sgst, "%")) {
            // 聚合（%TSlice / %TStr / 结构体）：值由 alloca 承载，转换源应是它的「地址」。
            // 此前与标量同路、把 % 类型谎报成 i64 → 发出非法 `inttoptr i64 %agg to ptr`
            // （clang -c 直接报错，波及 agent_* / atom / clause / cli / match / slice_literal_arg）。
            srcv = ll_slice_base_addr(src, llname.st_to_ll(sgst));
        } else {
            var sgll: string = llname.st_to_ll(sgst);
            if (llname.ll_starts(sgll, "%")) { sgll = "i64"; }
            srcv = ll_load(src, sgll);
        }
        var t: string = ll_tmp();
        var srcLlTy: string;
        if (sgst == "ptr" || llname.ll_starts(sgst, "ptr<") || llname.ll_starts(sgst, "arr<") || llname.ll_starts(sgst, "vec<") || llname.ll_starts(sgst, "%")) {
            srcLlTy = "ptr";
        } else {
            srcLlTy = llname.st_to_ll(sgst);
            if (llname.ll_starts(srcLlTy, "%")) { srcLlTy = "i64"; }
        }
        var castop: string = "bitcast";
        var castDst: string = dll;
        var srcIsInt: bool = ll_llty_is_int(srcLlTy);
        var dstIsInt: bool = ll_llty_is_int(dll);
        if (srcLlTy == "ptr" && dstIsInt) {
            castop = "ptrtoint";
        } else if (srcIsInt && llname.ll_starts(dll, "ptr")) {
            castop = "inttoptr";
            castDst = "ptr";
        }
        sb_append_str(g_ll, "  ");
        sb_append_str(g_ll, t);
        sb_append_str(g_ll, " = ");
        sb_append_str(g_ll, castop);
        sb_append_str(g_ll, " ");
        sb_append_str(g_ll, srcLlTy);
        sb_append_str(g_ll, " ");
        sb_append_str(g_ll, srcv);
        sb_append_str(g_ll, " to ");
        sb_append_str(g_ll, castDst);
        sb_append_str(g_ll, "\n");
        if (llname.ll_starts(dstst_eff, "arr<") || llname.ll_starts(dstst_eff, "vec<") || llname.ll_starts(dstst_eff, "%")) {
            ll_ensure_slot(dst, "ptr");
            llname.ll_set_st(dst, "ptr");
            ll_store(dst, "ptr", t);
        } else {
            ll_ensure_slot(dst, dstst_eff);
            llname.ll_set_st(dst, dstst_eff);
            ll_store(dst, dstst_eff, t);
        }
        return;
    }
    if (op == tir__TIR_OP_STORE) {
        // 发射器恒以「store $src $dst」（2 操作数，无显式 ST）形式产出；ST 由 g_ll_* 恢复。
        var src: string = inst.args[0].name;
        var dst: string = inst.dst.name;
        var dstst: string = llname.ll_get_st(dst);
        if (str_len(src) >= 1 && src[0] == 64 && ll_is_func(llname.ll_mangle(str_slice(src, 1, str_len(src))))) {
            var mref: string = llname.ll_mangle(str_slice(src, 1, str_len(src)));
            // 两种「函数值」槽，语义互斥，st 相同故只能按来源（GEP 基类型）区分：
            //  (a) %TClosure.field0（闭包构造）→ 必须存**裸 code** @fn.__clo_thunk；
            //      call_ind 解包时直接 call field0，存闭包全局会跳进数据段 → 段错误。
            //  (b) fn 类型的变量 / 结构体字段 → 必须存**闭包值** ptr %TClosure（@.tirll_clo_fn）；
            //      call_ind 先 load 该值再 GEP 解包，存裸 code 会把函数机器码当前 8 字节当
            //      field0 指针 → GEP 出垃圾 → 段错误（colony_wave / func_type 类崩溃根因）。
            var is_clofn: bool = false;
            var si: i64 = 0;
            var sn: i64 = slice_len(g_ll_clofnslot) as i64;
            while (si < sn) {
                if (g_ll_clofnslot[si] == dst) { is_clofn = true; }
                si = si + 1;
            }
            var fptr: string;
            if (is_clofn) { fptr = ll_closure_code(mref); } else { fptr = ll_emit_closure_const(mref, ""); }
            if (is_clofn || ll_is_addrslot(dst)) {
                // 地址槽（%TClosure.field0 / fn 类型的结构体字段）：dst 槽内容=字段地址 → 解引用写穿
                var p: string = ll_load(dst, dstst);
                sb_append_str(g_ll, "  store ptr ");
                sb_append_str(g_ll, fptr);
                sb_append_str(g_ll, ", ptr ");
                sb_append_str(g_ll, p);
                sb_append_str(g_ll, "\n");
            } else {
                // 值槽（fn 类型的**变量**，槽内容即 ptr %TClosure）：直接写槽，**禁止**解引用。
                // 若误按地址槽写穿（`f = sub` → `*f = clo`），闭包指针会被塞进 f 所指 TClosure 的
                // 首 8 字节（= field0/code），下一次 call_ind 把它当 code 调用 → 段错误
                // （func_type_demo / lambda_demo 第二行崩溃的根因，2026-09-19）。
                ll_store(dst, dstst, fptr);
            }
            return;
        }
        if (llname.ll_starts(dstst, "ptr<")) {
            var inner: string = ll_ptr_inner(dstst);
            var srcst: string = llname.ll_get_st(src);
            var src_is_ptr: bool = llname.ll_starts(srcst, "ptr<") || srcst == "ptr";
            if (ll_is_addrslot(dst)) {
                // dst 是 GEP 地址槽（l-value，槽内容=字段地址）：解引用写穿（store v, ptr *dst）。
                // 旧逻辑在 src 也为指针时误把值拷进临时量(覆盖地址)→字段永不写入→闭包捕获读到垃圾。
                var p: string = ll_load(dst, dstst);
                var v: string = ll_load(src, srcst);
                // ⚠ 解引用写穿的存储类型必须取「字段/元素类型」(ptr<inner> 的 inner)，
                // 不能取源值类型。TIR 的整数临时量一律按 i64 宽存储，若直接 store i64 到
                // i32 字段会 8 字节写穿、踩坏相邻字段（tests/m2/b01：P2{i32,i32} 的
                // p.x=3 把 p.y 清零，随后地址计算越界段错误）。i64 字段（b04）因宽度
                // 恰好相同而「偶然正确」——编译器自身结构体字段几乎全 i64，故该 bug
                // 长期不可见。聚合字段(非标量 inner)不参与换算，保持原语义。
                var want: string = ll_ptr_inner(dstst);
                var wst: string = srcst;
                if (ll_is_scalar_st(srcst) && ll_is_scalar_st(want)) {
                    v = ll_coerce_scalar(v, srcst, want);
                    wst = want;
                }
                sb_append_str(g_ll, "  store ");
                sb_append_str(g_ll, llname.st_to_ll(wst));
                sb_append_str(g_ll, " ");
                sb_append_str(g_ll, v);
                sb_append_str(g_ll, ", ptr ");
                sb_append_str(g_ll, p);
                sb_append_str(g_ll, "\n");
            } else {
                // dst 是值槽（普通指针变量，槽内容=指针值）：保留旧语义，勿解引用。
                //   - src 为指针：把指针值拷进槽（p = x，值语义）。
                //   - src 为标量：解引用写穿（*p = v，指针变量当缓冲用）。
                // ⚠ 不可改回 ll_store(dst,...)：那会把值写进槽自身的 alloca 而非 *p，破坏 *p=v 语义
                //   （adt_*/fixed_array/generics/vdot 等指针变量缓冲用例会回归）。
                if (src_is_ptr) {
