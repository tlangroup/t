// ══════════════════════════════════════════════════════════════════
// src/codegen_wasm.tc — tmir → WASM（WAT 文本）薄后端
//
// 职责：消费 TMIRModule，发出 WebAssembly 文本格式（WAT）。这是「取代 LLVM 的
// 轻量后端」之一——tmir 的 CFG 经结构化重建为 WASM 的 block/loop/if + br，无需 LLVM。
//
// 结构化控制流重建（仅对可归约 CFG 正确，S1 的 if/while/for 天然可归约）：
//   1. 计算支配树（dominator tree，迭代数据流 + Cooper-Harvey-Kennedy 求 idom）。
//   2. 按支配树前序 DFS 发射：进入块时按需打开 `block $B`（合并/分支目标）或
//      `loop $B`（循环头，使 `br $B` 回到循环头=重迭代）；
//   3. 终止指令的跳转：目标若为当前块的支配后代（自然落入）→ 不发射 br（落入下一子块）；
//      否则 `br $B`（目标块的外层 wrapper 必然已打开，合法）；循环头目标恒 `br`（再迭代）。
//
// 覆盖：S1 标量子集（i32/i64/f64/bool、算术/比较/位/移位、load/store、call/ret、
// br/br_cond）。S2+（struct/union/数组/字符串/全局内存）暂 comment 兜底。
//
// 注意：本文件无法在沙箱内验证（无 wat2wasm / wasm 运行时）；须工具链机器用
// `wat2wasm out/dbg/<m>.wat` 验证语法，再链接 runtime 跑端到端对拍。
// ══════════════════════════════════════════════════════════════════

const base = @import("src.base");
const tir = @import("src.tir");
const tmir = @import("src.tmir");

// 名字归一化：TIR 操作数名可能带 `.s<ST码>` 类型后缀（tir_os 附加）。
// WASM 端必须剥掉才能与 slot 声明（param/local）对齐，否则同一变量被当成两个槽。
pub fn w_strip_suf(n: string) string {
    var L: i64 = str_len(n) as i64;
    var i: i64 = L - 1;
    while (i >= 1) {
        if (n[i] == 115 and n[i - 1] == 46) {
            var suf: string = str_slice(n, i + 1, L);
            var okd: bool = str_len(suf) > 0;
            var j: i64 = 0;
            while (j < str_len(suf) as i64) { if (suf[j] < 48 or suf[j] > 57) { okd = false; } j = j + 1; }
            if (okd) { return str_slice(n, 0, i - 1); }
        }
        i = i - 1;
    }
    return n;
}

// 调用目标名：剥类型后缀与 '@' 前缀（WASM 以 $ 名引用函数）。
pub fn w_fn_name(n: string) string {
    var s: string = w_strip_suf(n);
    if (str_len(s) as i64 > 0 and s[0] == 64) { return str_slice(s, 1, str_len(s) as i64); }
    return s;
}

// 本地字符串帮手（编译器 stdlib 无 str_find）：返回 needle 首现下标，未找到 -1。
pub fn w_find_col(s: string, needle: string) i64 {
    var L: i64 = str_len(s) as i64;
    var nL: i64 = str_len(needle) as i64;
    var i: i64 = 0;
    while (i + nL <= L) {
        var j: i64 = 0; var ok: bool = true;
        while (j < nL) { if (s[i + j] != needle[j]) { ok = false; break; } j = j + 1; }
        if (ok) { return i; }
        i = i + 1;
    }
    return -1;
}

// 当前函数 CFG 表（emit 期构建）
pub var g_wf: TMIRFunc;
pub var g_wn: i64;            // 块数
pub var g_wrpo: []i64;        // 块索引的 RPO 序
pub var g_wrponum: []i64;     // 块索引 → RPO 序号
pub var g_wpreds: [][]i64;
pub var g_wdom: [][]i64;      // dom[b] = 支配 b 的块索引集合
pub var g_widom: []i64;       // idom[b]
pub var g_wloop: []bool;      // 是否为循环头
pub var g_wchild: [][]i64;    // 支配树子节点
pub var g_wsucc: [][]i64;     // 后继（自然循环判定用）
pub var g_wchin: [][]i64;     // 支配树子节点中「位于 b 循环体内」者（非循环头时全归入此）
pub var g_wchout: [][]i64;    // 支配树子节点中「位于 b 循环体之后」者（仅循环头非空）

// ── S2 聚合内存 ABI ──────────────────────────────────────────
// WASM 的 local 只能装标量；struct/数组等聚合必须落在线性内存里，用 i32 地址引用。
// - 聚合基槽（被 addr_of 取址的 struct/数组变量）：静态分配一段内存，local 存其 i32 基址。
// - addr_of：把基址拷到目标 local（仍是 i32 地址），并记录基类型（%Struct / [N]T）。
// - gep：dst = 基址 + 字节偏移（按基类型布局 + 字段对齐从 args[2] 索引算出），dst 是「带元素类型的地址」。
// - load/store 的源/目标是地址槽时，走 `*.load`/`*.store` 内存指令（宽度取元素类型）。
pub var g_w_base_name: []string;   // 聚合基槽名
pub var g_w_base_off: []i64;       // 对应静态内存基址（i32 常量）
pub var g_w_addr_name: []string;   // 地址槽名（gep/addr_of 结果）
pub var g_w_addr_st: []i64;        // 地址槽的元素 ST（load/store 宽度）
pub var g_w_addr_base_name: []string;  // 地址槽名（gep 基 / addr_of 结果的基）
pub var g_w_addr_base_ty: []string;    // 对应聚合基类型字符串（"%Struct" / "[N]T"）
pub var g_w_addr_slot_name: []string;  // 地址槽名（local 声明类型为 i32：WASM 线性内存地址）
pub var g_w_mem_top: i64;          // 静态内存分配游标（模块级，避免跨函数冲突）
pub var g_w_mod: TMIRModule;       // 当前模块（供 w_find_type_body 查类型表）

pub fn w_base_find(n: string) i64 {
    var i: i64 = 0;
    while (i < slice_len(g_w_base_name) as i64) { if (g_w_base_name[i] == n) { return g_w_base_off[i]; } i = i + 1; }
    return -1;
}
pub fn w_addr_find(n: string) i64 {
    var i: i64 = 0;
    while (i < slice_len(g_w_addr_name) as i64) { if (g_w_addr_name[i] == n) { return g_w_addr_st[i]; } i = i + 1; }
    return tir__ST_NONE;
}
pub fn w_addr_mark(n: string, st: i64) void {
    var i: i64 = 0;
    while (i < slice_len(g_w_addr_name) as i64) { if (g_w_addr_name[i] == n) { g_w_addr_st[i] = st; return; } i = i + 1; }
    append(g_w_addr_name, n); append(g_w_addr_st, st);
}
// 是否为「地址槽」（gep/addr_of/gep_idx 结果）：其 local 声明类型为 i32（WASM 内存地址），
// 与「元素类型」（g_w_addr_st，决定 load/store 宽度）解耦——后者在指令发射期才标记。
pub fn w_is_addr_slot(n: string) bool {
    var i: i64 = 0;
    while (i < slice_len(g_w_addr_slot_name) as i64) { if (g_w_addr_slot_name[i] == n) { return true; } i = i + 1; }
    return false;
}
pub fn w_addr_base_mark(n: string, ty: string) void {
    var i: i64 = 0;
    while (i < slice_len(g_w_addr_base_name) as i64) { if (g_w_addr_base_name[i] == n) { g_w_addr_base_ty[i] = ty; return; } i = i + 1; }
    append(g_w_addr_base_name, n); append(g_w_addr_base_ty, ty);
}
// 字符串前缀判断（替代未导入的 ll_starts）
pub fn w_starts(s: string, pre: string) bool {
    if (str_len(s) as i64 < str_len(pre) as i64) { return false; }
    var i: i64 = 0;
    while (i < str_len(pre) as i64) { if (s[i] != pre[i]) { return false; } i = i + 1; }
    return true;
}
// load/store 宽度 → WASM 内存指令后缀（"i32"/"i64"/"f32"/"f64"）
pub fn w_mem_suffix(st: i64) string {
    if (st == tir__ST_I64 or st == tir__ST_U64) { return "i64"; }
    if (st == tir__ST_F32) { return "f32"; }
    if (st == tir__ST_F64) { return "f64"; }
    return "i32";
}

// ── S2 GEP 偏移计算（按聚合基类型布局 + 字段对齐）──
// 类型字符串 → 尺寸 / 自然对齐（WASM32：ptr 4 字节；i64/f64 8 字节；其余取其宽）
pub fn w_tstr_align(ts: string) i64 {
    if (ts == "i8" or ts == "u8") { return 1; }
    if (ts == "i16" or ts == "u16") { return 2; }
    if (ts == "i32" or ts == "u32") { return 4; }
    if (ts == "i64" or ts == "u64") { return 8; }
    if (ts == "f32") { return 4; }
    if (ts == "f64") { return 8; }
    if (ts == "ptr" or ts == "ptr<void>" or w_starts(ts, "ptr<")) { return 4; }
    if (w_starts(ts, "%")) { return w_struct_align(ts); }
    if (w_starts(ts, "[") or w_is_arr(ts)) { return w_tstr_align(w_array_elem(ts)); }
    return 4;
}
pub fn w_tstr_size(ts: string) i64 {
    if (ts == "i8" or ts == "u8") { return 1; }
    if (ts == "i16" or ts == "u16") { return 2; }
    if (ts == "i32" or ts == "u32") { return 4; }
    if (ts == "i64" or ts == "u64") { return 8; }
    if (ts == "f32") { return 4; }
    if (ts == "f64") { return 8; }
    if (ts == "ptr" or ts == "ptr<void>" or w_starts(ts, "ptr<")) { return 4; }
    if (w_starts(ts, "%")) { return w_struct_size(ts); }
    if (w_starts(ts, "[")) { return w_array_nelems(ts) * w_tstr_size(w_array_elem(ts)); }
    return 4;
}
pub fn w_align_up(off: i64, a: i64) i64 {
    if (a <= 1) { return off; }
    var m: i64 = a - 1;
    var r: i64 = off + m;
    r = r - (r % a);
    return r;
}
// 查 TT 类型表取结构体 body（"f0: T0, f1: T1"）；未命中返回 ""
pub fn w_find_type_body(name: string) string {
    var i: i64 = 0;
    while (i < slice_len(g_w_mod.types) as i64) {
        if (g_w_mod.types[i].name == name) { return g_w_mod.types[i].body; }
        i = i + 1;
    }
    return "";
}
pub fn w_struct_align(name: string) i64 {
    var body: string = w_find_type_body(name);
    if (body == "") { return 8; }
    var maxa: i64 = 1;
    var i: i64 = 0;
    while (true) {
        var ft: string = w_field_type_at(body, i);
        if (ft == "") { break; }
        var a: i64 = w_tstr_align(ft);
        if (a > maxa) { maxa = a; }
        i = i + 1;
    }
    return maxa;
}
pub fn w_struct_size(name: string) i64 {
    var body: string = w_find_type_body(name);
    if (body == "") { return 0; }
    var off: i64 = 0; var i: i64 = 0;
    while (true) {
        var ft: string = w_field_type_at(body, i);
        if (ft == "") { break; }
        off = w_align_up(off, w_tstr_align(ft));
        off = off + w_tstr_size(ft);
        i = i + 1;
    }
    off = w_align_up(off, w_struct_align(name));
    return off;
}
// 取第 idx 个字段的类型：body 形如 "x: i32, y: i32"（字段名: 类型，逗号分隔）。
pub fn w_field_type_at(body: string, idx: i64) string {
    var flds: []string = w_split_comma(body);
    if (idx < 0 or idx >= slice_len(flds) as i64) { return ""; }
    var f: string = flds[idx];
    var ci: i64 = w_find_col(f, ":");  // 跳过 "name: " 前缀
    if (ci < 0) { return w_strip_ws(f); }
    return w_strip_ws(str_slice(f, ci + 1, str_len(f) as i64));
}
// 按顶层逗号切分（尖括号 <...> 内不切分，兼容 ptr<i32> 等）
pub fn w_split_comma(s: string) []string {
    var r: []string = [];
    var cur: string = "";
    var depth: i64 = 0;
    var i: i64 = 0;
    while (i < str_len(s) as i64) {
        var c: i64 = s[i];
        if (c == 60) { depth = depth + 1; }       // '<'
        else if (c == 62) { depth = depth - 1; }  // '>'
        if (c == 44 and depth == 0) { append(r, cur); cur = ""; }  // ','
        else { cur = base.sb_cat2(cur, str_slice(s, i, i + 1)); }
        i = i + 1;
    }
    append(r, cur);
    return r;
}
// 去首尾空白
pub fn w_strip_ws(s: string) string {
    var L: i64 = str_len(s) as i64;
    var a: i64 = 0;
    while (a < L and (s[a] == 32 or s[a] == 9)) { a = a + 1; }
    var b: i64 = L;
    while (b > a and (s[b - 1] == 32 or s[b - 1] == 9)) { b = b - 1; }
    return str_slice(s, a, b);
}
// 数组类型：实际格式 "arr<T x N>"（亦兼容旧 "[N]T"）
pub fn w_is_arr(ts: string) bool { return w_starts(ts, "arr<"); }
pub fn w_array_elem(ts: string) string {
    if (w_is_arr(ts)) {
        var s: i64 = 4;  // 跳过 "arr<"
        var e: i64 = str_len(ts) as i64 - 1;  // 去尾 '>'
        var body: string = str_slice(ts, s, e);  // "T x N"
        var xi: i64 = w_find_col(body, " x ");
        if (xi < 0) { return "i32"; }
        return str_slice(body, 0, xi);
    }
    // [N]T
    var e: i64 = str_len(ts) as i64 - 1;  // 去尾 ']'
    var i: i64 = 1;  // 跳过首 '['
    while (i < str_len(ts) as i64 and ts[i] != 93) { i = i + 1; }  // 93 = ']'
    var inner: string = str_slice(ts, 1, i);
    var j: i64 = 0;
    while (j < str_len(inner) as i64 and inner[j] != 93) { j = j + 1; }
    return str_slice(inner, j + 1, str_len(inner) as i64);
}
pub fn w_array_nelems(ts: string) i64 {
    if (w_is_arr(ts)) {
        var s: i64 = 4;
        var e: i64 = str_len(ts) as i64 - 1;
        var body: string = str_slice(ts, s, e);  // "T x N"
        var xi: i64 = w_find_col(body, " x ");
        if (xi < 0) { return 0; }
        return tir.tir_atoi(str_slice(body, xi + 3, str_len(body) as i64));
    }
    var i: i64 = 1;
    while (i < str_len(ts) as i64 and ts[i] != 93) { i = i + 1; }
    return tir.tir_atoi(str_slice(ts, 1, i));
}
// GEP 字节偏移：基类型 ty 的第 idx 个字段/元素（含对齐）
pub fn w_gep_offset(ty: string, idx: i64) i64 {
    if (w_starts(ty, "[") or w_is_arr(ty)) { return idx * w_tstr_size(w_array_elem(ty)); }
    if (w_starts(ty, "%") == false) { return idx * w_tstr_size(ty); }
    var body: string = w_find_type_body(ty);
    if (body == "") { return idx * 8; }
    var off: i64 = 0; var i: i64 = 0;
    while (i < idx) {
        var ft: string = w_field_type_at(body, i);
        if (ft == "") { break; }
        off = w_align_up(off, w_tstr_align(ft));
        off = off + w_tstr_size(ft);
        i = i + 1;
    }
    var fidx_t: string = w_field_type_at(body, idx);
    off = w_align_up(off, w_tstr_align(fidx_t));
    return off;
}
pub fn w_addr_base_find(n: string) string {
    var i: i64 = 0;
    while (i < slice_len(g_w_addr_base_name) as i64) { if (g_w_addr_base_name[i] == n) { return g_w_addr_base_ty[i]; } i = i + 1; }
    return "";
}
// 查模块全局变量的存储类型（ST 码）；未命中兜底 i32。
pub fn w_global_st(n: string) i64 {
    var i: i64 = 0;
    while (i < slice_len(g_w_mod.globals) as i64) {
        if (g_w_mod.globals[i].name == n) { return g_w_mod.globals[i].td; }
        i = i + 1;
    }
    return tir__ST_I32;
}

pub fn w_lbl(idx: i64) string { return base.sb_cat2("B", base.i2s(idx)); }
pub fn w_xlbl(idx: i64) string { return base.sb_cat2("X", base.i2s(idx)); }  // 循环出口 wrapper
pub fn w_wlbl(idx: i64) string { return base.sb_cat2("W", base.i2s(idx)); }  // 子块 wrapper
pub fn w_bname_to_idx(n: string) i64 {
    var nn: string = w_strip_suf(n);
    var i: i64 = 0;
    while (i < g_wn) {
        if (w_strip_suf(g_wf.blocks[i].name) == nn) { return i; }
        i = i + 1;
    }
    return 0;
}

pub fn w_in_dom(x: i64, y: i64) bool {
    if (x == y) { return false; }
    var s: i64 = 0;
    var n: i64 = slice_len(g_wdom[x]) as i64;
    while (s < n) { if (g_wdom[x][s] == y) { return true; } s = s + 1; }
    return false;
}

// 可达性：a 能否沿后继边走到 b（自然循环判定）
pub fn w_reach_dfs(cur: i64, to: i64, vis: []bool) bool {
    if (cur == to) { return true; }
    vis[cur] = true;
    var i: i64 = 0;
    while (i < slice_len(g_wsucc[cur]) as i64) {
        var nx: i64 = g_wsucc[cur][i];
        if (vis[nx] == false) { if (w_reach_dfs(nx, to, vis)) { return true; } }
        i = i + 1;
    }
    return false;
}
pub fn w_can_reach(a: i64, b: i64) bool {
    var vis: []bool = [];
    var i: i64 = 0;
    while (i < g_wn) { append(vis, false); i = i + 1; }
    return w_reach_dfs(a, b, vis);
}

pub fn w_set_eq(a: []i64, b: []i64) bool {
    var na: i64 = slice_len(a) as i64;
    var nb: i64 = slice_len(b) as i64;
    if (na != nb) { return false; }
    var i: i64 = 0;
    while (i < na) {
        var j: i64 = 0; var found: bool = false;
        while (j < nb) { if (a[i] == b[j]) { found = true; break; } j = j + 1; }
        if (found == false) { return false; }
        i = i + 1;
    }
    return true;
}

pub fn w_intersect(a: []i64, b: []i64) []i64 {
    var r: []i64 = [];
    var i: i64 = 0; var na: i64 = slice_len(a) as i64;
    while (i < na) {
        var j: i64 = 0; var nb: i64 = slice_len(b) as i64; var found: bool = false;
        while (j < nb) { if (a[i] == b[j]) { found = true; break; } j = j + 1; }
        if (found) { append(r, a[i]); }
        i = i + 1;
    }
    return r;
}

pub fn w_intersect_idom(a: i64, b: i64) i64 {
    var x: i64 = a;
    var y: i64 = b;
    while (x != y) {
        var px: i64 = x;
        var py: i64 = y;
        // ⚠ 比较方向：g_wrponum 是**逆后序**序号，入口最小（0）。
        //   必须让「序号大」的一方沿 idom 往上爬。原写法方向相反：爬到入口后
        //   idom(入口)==入口，x 永远不动 ⇒ 死循环（表现为退出码 127 栈溢出）。
        if (g_wrponum[x] > g_wrponum[y]) {
            if (g_widom[x] != x) { x = g_widom[x]; }
        } else {
            if (g_widom[y] != y) { y = g_widom[y]; }
        }
        if (x == px and y == py) { return x; }   // 已无法再上爬（至少一方是入口）
    }
    return x;
}

// 构建 CFG + 支配树
pub fn w_build_cfg(f: TMIRFunc) void {
    g_wf = f;
    g_wn = slice_len(f.blocks) as i64;
    // 重置模块级 CFG 表（tmir_to_wasm 可能多函数连续调用，避免跨函数累积）
    g_wpreds = []; g_wdom = []; g_wloop = []; g_wchild = []; g_wrpo = []; g_wrponum = []; g_widom = [];
    g_wsucc = []; g_wchin = []; g_wchout = [];
    // preds
    var i: i64 = 0;
    while (i < g_wn) {
        append(g_wpreds, []);
        append(g_wdom, []);
        append(g_wloop, false);
        append(g_wchild, []);
        append(g_wsucc, []);
        append(g_wchin, []);
        append(g_wchout, []);
        i = i + 1;
    }
    i = 0;
    while (i < g_wn) {
        var ins: TMIRInst = f.blocks[i].insts[slice_len(f.blocks[i].insts) as i64 - 1];
        if (ins.op == tir__TIR_OP_BR) { append(g_wpreds[w_bname_to_idx(ins.args[0].name)], i); }
        else if (ins.op == tir__TIR_OP_BR_COND) {
            append(g_wpreds[w_bname_to_idx(ins.args[1].name)], i);
            append(g_wpreds[w_bname_to_idx(ins.args[2].name)], i);
        }
        i = i + 1;
    }
    // RPO：从入口（index 0）DFS 后序再反转
    g_wrpo = [];
    var visited: []bool = [];
    var k: i64 = 0;
    while (k < g_wn) { append(visited, false); k = k + 1; }
    w_dfs_post(0, visited);
    // 反转得到 RPO
    var rev: []i64 = [];
    var m: i64 = slice_len(g_wrpo) as i64 - 1;
    while (m >= 0) { append(rev, g_wrpo[m]); m = m - 1; }
    g_wrpo = rev;
    g_wrponum = [];
    var p: i64 = 0;
    while (p < g_wn) {
        append(g_wrponum, 0);
        p = p + 1;
    }
    p = 0;
    while (p < slice_len(g_wrpo) as i64) { g_wrponum[g_wrpo[p]] = p; p = p + 1; }
    // dom 初始化
    i = 0;
    while (i < g_wn) {
        g_wdom[i] = [];
        if (i == 0) { append(g_wdom[i], 0); } else {
            var q: i64 = 0; while (q < g_wn) { append(g_wdom[i], q); q = q + 1; }
        }
        i = i + 1;
    }
    // 迭代求 dom
    var changed: bool = true;
    while (changed) {
        changed = false;
        var r: i64 = 0;
        while (r < slice_len(g_wrpo) as i64) {
            var b: i64 = g_wrpo[r];
            if (b == 0) { r = r + 1; continue; }
            var np: i64 = slice_len(g_wpreds[b]) as i64;
            if (np == 0) { r = r + 1; continue; }
            var newset: []i64 = [];
            var s2: i64 = 0; var nn: i64 = slice_len(g_wdom[g_wpreds[b][0]]) as i64;
            while (s2 < nn) { append(newset, g_wdom[g_wpreds[b][0]][s2]); s2 = s2 + 1; }
            var pi: i64 = 1;
            while (pi < np) { newset = w_intersect(newset, g_wdom[g_wpreds[b][pi]]); pi = pi + 1; }
            // {b} ∪ newset
            var withb: []i64 = []; append(withb, b);
            var w2: i64 = 0; var wn: i64 = slice_len(newset) as i64;
            while (w2 < wn) { var dup: bool = false; var d: i64 = 0; while (d < slice_len(withb) as i64) { if (withb[d] == newset[w2]) { dup = true; } d = d + 1; } if (dup == false) { append(withb, newset[w2]); } w2 = w2 + 1; }
            if (w_set_eq(withb, g_wdom[b]) == false) { g_wdom[b] = withb; changed = true; }
            r = r + 1;
        }
    }
    // idom（Cooper-Harvey-Kennedy）
    g_widom = [];
    var z: i64 = 0; while (z < g_wn) { append(g_widom, -1); z = z + 1; }
    g_widom[0] = 0;
    var r2: i64 = 0;
    while (r2 < slice_len(g_wrpo) as i64) {
        var b: i64 = g_wrpo[r2];
        if (b == 0) { r2 = r2 + 1; continue; }
        var newid: i64 = -1;
        var pp: i64 = 0; var np2: i64 = slice_len(g_wpreds[b]) as i64;
        while (pp < np2) {
            var pr: i64 = g_wpreds[b][pp];
            if (g_widom[pr] != -1) {
                if (newid == -1) { newid = pr; }
                else { newid = w_intersect_idom(newid, pr); }
            }
            pp = pp + 1;
        }
        g_widom[b] = newid;
        r2 = r2 + 1;
    }
    // 子节点 + 循环头（回边目标 = 支配当前块的前驱）
    i = 0;
    while (i < g_wn) {
        if (i != 0 and g_widom[i] >= 0) { append(g_wchild[g_widom[i]], i); }
        i = i + 1;
    }
    var pi2: i64 = 0;
    while (pi2 < g_wn) {
        var nb: i64 = slice_len(g_wpreds[pi2]) as i64;
        var q2: i64 = 0;
        while (q2 < nb) {
            var pr2: i64 = g_wpreds[pi2][q2];
            // 回边判据：边 pr2 → pi2 是回边 ⟺ pi2 支配 pr2（目标支配源）。
            // 原写法 w_in_dom(pi2, pr2) 方向反了：前向树边也被判成回边，exit 块会被误当循环头。
            if (w_in_dom(pr2, pi2)) { g_wloop[pi2] = true; }
            q2 = q2 + 1;
        }
        pi2 = pi2 + 1;
    }
    // 后继表
    i = 0;
    while (i < g_wn) {
        var ti: TMIRInst = f.blocks[i].insts[slice_len(f.blocks[i].insts) as i64 - 1];
        if (ti.op == tir__TIR_OP_BR) { append(g_wsucc[i], w_bname_to_idx(ti.args[0].name)); }
        else if (ti.op == tir__TIR_OP_BR_COND) {
            append(g_wsucc[i], w_bname_to_idx(ti.args[1].name));
            append(g_wsucc[i], w_bname_to_idx(ti.args[2].name));
        }
        i = i + 1;
    }
    // 支配子节点分类：循环头 b 的子节点中「能回到 b」的在循环体内，其余在循环体之后。
    i = 0;
    while (i < g_wn) {
        var c2: i64 = 0;
        while (c2 < slice_len(g_wchild[i]) as i64) {
            var ch2: i64 = g_wchild[i][c2];
            var inside: bool = true;
            if (g_wloop[i]) { inside = w_can_reach(ch2, i); }
            if (inside) { append(g_wchin[i], ch2); } else { append(g_wchout[i], ch2); }
            c2 = c2 + 1;
        }
        i = i + 1;
    }
}

pub fn w_dfs_post(b: i64, visited: []bool) void {
    visited[b] = true;
    var ni: i64 = slice_len(g_wf.blocks[b].insts) as i64;
    if (ni > 0) {
        var term: TMIRInst = g_wf.blocks[b].insts[ni - 1];
        if (term.op == tir__TIR_OP_BR) { var t: i64 = w_bname_to_idx(term.args[0].name); if (visited[t] == false) { w_dfs_post(t, visited); } }
        else if (term.op == tir__TIR_OP_BR_COND) {
            var t0: i64 = w_bname_to_idx(term.args[1].name); if (visited[t0] == false) { w_dfs_post(t0, visited); }
            var t1: i64 = w_bname_to_idx(term.args[2].name); if (visited[t1] == false) { w_dfs_post(t1, visited); }
        }
    }
    append(g_wrpo, b);
}

// ── 主发射 ─────────────────────────────────────────────────────
pub fn tmir_to_wasm(m: TMIRModule) string {
    g_w_mod = m;
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "(module\n");
    // 聚合内存（S2：struct/数组落在线性内存，基址由聚合基槽 local 持有）。
    sb_append_str(sb, "  (memory 1)\n");
    // 全局（可变全局，初值 0；真正初值由 @t.__ginit 在 main 入口写入）
    var ng: i64 = slice_len(m.globals) as i64;
    var gi: i64 = 0;
    while (gi < ng) {
        var gt: string = tmir.tmir_st_wasm(m.globals[gi].td);
        sb_append_str(sb, "  (global $"); sb_append_str(sb, m.globals[gi].name);
        sb_append_str(sb, " (mut "); sb_append_str(sb, gt); sb_append_str(sb, ") (");
        sb_append_str(sb, gt); sb_append_str(sb, ".const 0))\n");
        gi = gi + 1;
    }
    // 重置聚合内存 ABI 状态（模块级）
    g_w_base_name = []; g_w_base_off = []; g_w_addr_name = []; g_w_addr_st = [];
    g_w_addr_base_name = []; g_w_addr_base_ty = []; g_w_addr_slot_name = []; g_w_mem_top = 1024;
    var nf: i64 = slice_len(m.funcs) as i64;
    var i: i64 = 0;
    while (i < nf) {
        var f: TMIRFunc = m.funcs[i];
        if (f.is_extern) { i = i + 1; continue; }
        if (slice_len(f.blocks) as i64 == 0) { i = i + 1; continue; }
        w_build_cfg(f);
        w_emit_func(sb, f);
        i = i + 1;
    }
    sb_append_str(sb, ")\n");
    return sb_to_str(sb);
}

pub fn w_emit_func(sb: StringBuilder, f: TMIRFunc) void {
    sb_append_str(sb, "  (func $"); sb_append_str(sb, f.name);
    // 仅入口函数导出为 "main"；其余函数（helper / @t.__ginit）仅供模块内调用。
    if (f.is_main or f.name == "main" or f.name == "@main") {
        sb_append_str(sb, " (export \""); sb_append_str(sb, w_fn_name(f.name)); sb_append_str(sb, "\")");
    }
    // params
    var np: i64 = slice_len(f.params) as i64;
    var p: i64 = 0;
    while (p < np) {
        var pv: string = f.params[p]; // "$p: ST"
        // 取 $ 名与 ST 文本：按 ':' 拆分
        var col: i64 = w_find_col(pv, ":");
        var pname: string = str_slice(pv, 0, col);
        var pst: i64 = w_st_from_str(str_slice(pv, col + 1, str_len(pv) as i64));
        sb_append_str(sb, " (param $"); sb_append_str(sb, w_strip_suf(pname)); sb_append_str(sb, " "); sb_append_str(sb, tmir.tmir_st_wasm(pst)); sb_append_str(sb, ")");
        p = p + 1;
    }
    if (f.ret_st != "" and f.ret_st != "void") {
        var rst: i64 = w_st_from_str(f.ret_st);
        sb_append_str(sb, " (result "); sb_append_str(sb, tmir.tmir_st_wasm(rst)); sb_append_str(sb, ")");
    }
    sb_append_str(sb, "\n");
    // 预扫描：标记地址槽（gep/addr_of/gep_idx 结果）的 local 为 i32（WASM 内存地址）。
    // 必须在声明 local 之前做——指令发射期才标记的 g_w_addr_st（元素类型）此刻尚未填充。
    {
        var pbi: i64 = 0;
        while (pbi < slice_len(f.blocks) as i64) {
            var pni: i64 = slice_len(f.blocks[pbi].insts) as i64;
            var pk: i64 = 0;
            while (pk < pni) {
                var pins: TMIRInst = f.blocks[pbi].insts[pk];
                if (pins.op == tir__TIR_OP_GEP or pins.op == tir__TIR_OP_ADDR_OF or pins.op == tir__TIR_OP_GEP_IDX) {
                    var dn: string = w_strip_suf(pins.dst.name);
                    var found: bool = false; var fi: i64 = 0;
                    while (fi < slice_len(g_w_addr_slot_name) as i64) { if (g_w_addr_slot_name[fi] == dn) { found = true; } fi = fi + 1; }
                    if (found == false) { append(g_w_addr_slot_name, dn); }
                }
                pk = pk + 1;
            }
            pbi = pbi + 1;
        }
    }
    // locals（非 param 的 slot）
    var slots: []string = w_collect_slots(f);
    var ns: i64 = slice_len(slots) as i64;
    var s: i64 = 0;
    while (s < ns) {
        var nm: string = slots[s];
        var isp: bool = false; var pp2: i64 = 0;
        while (pp2 < np) { if (str_slice(f.params[pp2], 0, w_find_col(f.params[pp2], ":")) == nm) { isp = true; } pp2 = pp2 + 1; }
        if (isp == false) {
            sb_append_str(sb, "    (local $"); sb_append_str(sb, nm); sb_append_str(sb, " "); sb_append_str(sb, tmir.tmir_st_wasm(w_slot_st(nm, f))); sb_append_str(sb, ")\n");
        }
        s = s + 1;
    }
    // ── S2 聚合基槽：收集本函数内被 addr_of 取址的 struct/数组变量，分配静态内存基址 ──
    var agg: []string = [];
    var nb2: i64 = slice_len(f.blocks) as i64;
    var b2: i64 = 0;
    while (b2 < nb2) {
        var ni2: i64 = slice_len(f.blocks[b2].insts) as i64;
        var k2: i64 = 0;
        while (k2 < ni2) {
            var ins2: TMIRInst = f.blocks[b2].insts[k2];
            if (ins2.op == tir__TIR_OP_ADDR_OF and str_len(ins2.args[0].name) as i64 > 0 and ins2.args[0].name[0] == 36) {
                var bn: string = w_strip_suf(ins2.args[0].name);
                var found2: bool = false; var q2: i64 = 0;
                while (q2 < slice_len(agg) as i64) { if (agg[q2] == bn) { found2 = true; } q2 = q2 + 1; }
                if (found2 == false) {
                    // 分配 1024 字节槽（容纳任意中小 struct/数组；GEP 偏移均 < 此值，互不串扰）
                    append(g_w_base_name, bn); append(g_w_base_off, g_w_mem_top); g_w_mem_top = g_w_mem_top + 1024;
                    append(agg, bn);
                }
            }
            k2 = k2 + 1;
        }
        b2 = b2 + 1;
    }
    // 聚合基槽 local 初始化为静态内存基址（i32）
    var na2: i64 = slice_len(agg) as i64;
    var a2: i64 = 0;
    while (a2 < na2) {
        sb_append_str(sb, "    (local.set $"); sb_append_str(sb, agg[a2]);
        sb_append_str(sb, " (i32.const "); sb_append_str(sb, base.i2s(w_base_find(agg[a2])));
        sb_append_str(sb, "))\n");
        a2 = a2 + 1;
    }
    // 入口函数：主体前调用模块级全局初始化函数（@t.__ginit 等，写全局初值）。
    if (f.is_main or f.name == "main" or f.name == "@main") {
        var gi3: i64 = 0;
        while (gi3 < slice_len(g_w_mod.funcs) as i64) {
            var fnm: string = g_w_mod.funcs[gi3].name;
            if (w_starts(fnm, "t.__g")) {
                sb_append_str(sb, "    (call $"); sb_append_str(sb, fnm); sb_append_str(sb, ")\n");
            }
            gi3 = gi3 + 1;
        }
    }
    // 按支配树前序发射（入口块 index 0）
    w_emit_dom(sb, 0);
    // 兜底终结：WASM 校验器在每个 block/loop 的 `end` 之后会重置「不可达」状态，
    // 所以即便所有真实路径都以 return 结束，函数体末尾仍被视为可达且栈为空，
    // 非 void 函数会报 "type mismatch: expected <T> but nothing on stack"。
    // 补一条 unreachable 终结（栈多态下合法），且能让「真漏 return」在运行时炸出来。
    if (f.ret_st != "" and f.ret_st != "void") {
        sb_append_str(sb, "    unreachable\n");
    }
    sb_append_str(sb, "  )\n");
}

pub fn w_collect_slots(f: TMIRFunc) []string {
    var r: []string = [];
    var nb: i64 = slice_len(f.blocks) as i64;
    var b: i64 = 0;
    while (b < nb) {
        var ni: i64 = slice_len(f.blocks[b].insts) as i64;
        var k: i64 = 0;
        while (k < ni) {
            var ins: TMIRInst = f.blocks[b].insts[k];
            if (str_len(ins.dst.name) as i64 > 0 and ins.dst.name[0] == 36) { r = w_add_slot(r, w_strip_suf(ins.dst.name)); }
            var na: i64 = slice_len(ins.args) as i64;
            var a: i64 = 0;
            while (a < na) { if (str_len(ins.args[a].name) as i64 > 0 and ins.args[a].name[0] == 36) { r = w_add_slot(r, w_strip_suf(ins.args[a].name)); } a = a + 1; }
            k = k + 1;
        }
        b = b + 1;
    }
    return r;
}

// ⚠ t 的 slice 是值语义：函数内 append 形参不影响调用者（曾使 local 声明全丢）。
// 故构造新 slice 返回，调用方必须 `r = w_add_slot(r, n)` 接收。
pub fn w_add_slot(sl: []string, n: string) []string {
    var i: i64 = 0; var nn: i64 = slice_len(sl) as i64;
    while (i < nn) { if (sl[i] == n) { return sl; } i = i + 1; }
    var out: []string = [];
    var j: i64 = 0;
    while (j < nn) { append(out, sl[j]); j = j + 1; }
    append(out, n);
    return out;
}

// ── 类型来源 ───────────────────────────────────────────────
// ⚠ 关键事实（实测）：TIR 的 `TirInst.dst.st` **恒为 0（ST_NONE），从不设置**。
//   真正的类型只有两个来源：① 指令自身的 `ins.st`；② 操作数被引用时的 `arg.st`
//   （以及名字后缀 `.s<st>`，如 `$r.s11`）。因此后端一律不得依赖 `dst.st`。
pub fn w_is_cmp_op(op: i64) bool {
    if (op == tir__TIR_OP_EQ or op == tir__TIR_OP_NE) { return true; }
    if (op == tir__TIR_OP_SLT or op == tir__TIR_OP_SGT or op == tir__TIR_OP_SLE or op == tir__TIR_OP_SGE) { return true; }
    if (op == tir__TIR_OP_ULT or op == tir__TIR_OP_UGT or op == tir__TIR_OP_ULE or op == tir__TIR_OP_UGE) { return true; }
    return false;
}
// 操作数类型（算术/比较的参与类型）
pub fn w_val_st(ins: TMIRInst) i64 {
    if (ins.st != tir__ST_NONE) { return ins.st; }
    if (ins.dst.st != tir__ST_NONE) { return ins.dst.st; }
    return tir__ST_I32;
}
// 结果类型（写入 dst slot 的类型）。WASM 的比较/逻辑结果恒为 i32。
pub fn w_res_st(ins: TMIRInst) i64 {
    if (w_is_cmp_op(ins.op)) { return tir__ST_I32; }
    if (ins.op == tir__TIR_OP_NOT or ins.op == tir__TIR_OP_LNOT) { return tir__ST_I32; }
    return w_val_st(ins);
}
// 第 i 个操作数的类型：优先 arg.st，其次回落到该 slot 的声明类型。
pub fn w_arg_st(ins: TMIRInst, i: i64) i64 {
    if (i < 0 or i >= slice_len(ins.args) as i64) { return w_val_st(ins); }
    var a: TirOperand = ins.args[i];
    if (a.st != tir__ST_NONE) { return a.st; }
    if (str_len(a.name) as i64 > 0 and a.name[0] == 36) { return w_slot_st(w_strip_suf(a.name), g_wf); }
    return w_val_st(ins);
}

pub fn w_is_int_st(st: i64) bool {
    if (st == tir__ST_F32 or st == tir__ST_F64) { return false; }
    return true;
}
// 操作数的类型（slot 取语义类型，立即数取自带 st）
pub fn w_operand_st(op: TirOperand) i64 {
    if (str_len(op.name) as i64 > 0 and op.name[0] == 36) { return w_slot_st(w_strip_suf(op.name), g_wf); }
    return op.st;
}
// 按期望类型发射操作数；整数宽度不符时插入 wrap/extend。
// TIR 的整数临时槽按 i64 宽存储，而运算语义宽度可能是 i32 ⇒ 边界必须适配。
pub fn w_emit_operand(sb: StringBuilder, op: TirOperand, want: i64) void {
    if (str_len(op.name) as i64 > 0 and op.name[0] == 36) {
        var have: i64 = w_slot_st(w_strip_suf(op.name), g_wf);
        if (w_is_int_st(have) and w_is_int_st(want)) {
            var h64: bool = (have == tir__ST_I64 or have == tir__ST_U64);
            var w64: bool = (want == tir__ST_I64 or want == tir__ST_U64);
            if (w64 and h64 == false) { sb_append_str(sb, "(i64.extend_i32_s "); w_emit_val_st(sb, op, want); sb_append_str(sb, ")"); return; }
            if (w64 == false and h64) { sb_append_str(sb, "(i32.wrap_i64 "); w_emit_val_st(sb, op, want); sb_append_str(sb, ")"); return; }
        }
    }
    w_emit_val_st(sb, op, want);
}

// 估计某 slot 的语义 ST：① 作为操作数被引用时的 arg.st（最贴近语义）
// → ② 定义它的指令的结果类型 → 兜底 i32。
// ⚠ 不能用 TIR_OP_SLOT 的 ins.st：那是**存储宽度**（整数临时槽一律 i64，见项目笔记坑 7），
//   拿来声明 local 会把 i32 常量槽抬成 i64，进而 i32 变量赋值处报
//   "type mismatch: expected i32, found i64"。
pub fn w_slot_st(n: string, f: TMIRFunc) i64 {
    if (w_is_addr_slot(n)) { return tir__ST_I32; }  // 地址槽：聚合基址/字段偏移均为 i32（WASM 线性内存地址）
    var nb: i64 = slice_len(f.blocks) as i64;
    var b: i64 = 0;
    while (b < nb) {
        var ni: i64 = slice_len(f.blocks[b].insts) as i64;
        var k: i64 = 0;
        while (k < ni) {
            var ins: TMIRInst = f.blocks[b].insts[k];
            var na: i64 = slice_len(ins.args) as i64;
            var a: i64 = 0;
            while (a < na) {
                if (w_strip_suf(ins.args[a].name) == n and ins.args[a].st != tir__ST_NONE) { return ins.args[a].st; }
                a = a + 1;
            }
            k = k + 1;
        }
        b = b + 1;
    }
    b = 0;
    while (b < nb) {
        var ni: i64 = slice_len(f.blocks[b].insts) as i64;
        var k: i64 = 0;
        while (k < ni) {
            var ins: TMIRInst = f.blocks[b].insts[k];
            if (ins.op == tir__TIR_OP_SLOT or ins.op == tir__TIR_OP_CONST_STR) { k = k + 1; continue; }
            // 整数 CONST 的 ins.st 是「临时槽存储宽」（一律 i64），不是语义宽 ⇒ 不可信；
            // 浮点 CONST 的 ins.st 即真实类型 ⇒ 可信。
            if (ins.op == tir__TIR_OP_CONST and ins.st != tir__ST_F32 and ins.st != tir__ST_F64) { k = k + 1; continue; }
            if (w_strip_suf(ins.dst.name) == n and ins.st != tir__ST_NONE) { return w_res_st(ins); }
            k = k + 1;
        }
        b = b + 1;
    }
    return tir__ST_I32;
}

pub fn w_st_from_str(s: string) i64 {
    if (s == "i32" or s == "u32" or s == "i1" or s == "bool") { return tir__ST_I32; }
    if (s == "i64" or s == "u64") { return tir__ST_I64; }
    if (s == "f32") { return tir__ST_F32; }
    if (s == "f64") { return tir__ST_F64; }
    if (s == "ptr" or s == "ptr<void>") { return tir__ST_PTR; }
    return tir__ST_I32;
}

// 支配树前序 DFS 发射
// 跳转目标 → WASM 标签（与 w_emit_dom 的 wrapper 嵌套一一对应）。
// 前提：块按支配树前序发射，每个支配子节点 c 套一层 wrapper `(block $Wc)`，逆序打开
// ⇒ 子 0 在最内层、子 k 在其外层；`br` 是**跳出** block 而非跳入，于是
//   跳到子 k == 跳出子 k-1 的 wrapper。
// 通用做法：自 b 沿 idom 上溯，找最近的祖先 p（含 b 自身）使 t 为 p 的支配子节点；
//   ① t 在 p 的**循环内**子表 chin 中：i==0 顺序落入，否则 br $W<chin[i-1]>；
//   ② t 在 p 的**循环外**子表 chout 中：k==0 表示要从循环里跳出去 ⇒ br $X<p>，
//      否则 br $W<chout[k-1]>。
//   ③ t==b 是回边 ⇒ br 自身 loop；找不到且 t 是祖先 loop ⇒ br $Bt；其余兜底顺序落入。
pub fn w_br_lbl(b: i64, t: i64) string {
    if (t == b) { return w_lbl(b); }
    // 回边：t 是支配 b 的循环头 ⇒ 必须 br 到该 loop 顶部。
    // 不能靠「上溯找祖先子节点」处理——t 会作为入口块的子节点被找到并返回「顺序落入」，
    // 而落入是走到循环后继，不是回到循环头（曾致 while 只跑一轮）。
    if (g_wloop[t] and w_in_dom(b, t)) { return w_lbl(t); }
    var p: i64 = b;
    var guard: i64 = 0;
    while (guard <= g_wn) {
        var chin: []i64 = g_wchin[p];
        var chout: []i64 = g_wchout[p];
        var ncin: i64 = slice_len(chin) as i64;
        var i: i64 = 0;
        while (i < ncin) {
            if (chin[i] == t) {
                if (i == 0) { return ""; }
                return w_wlbl(chin[i - 1]);
            }
            i = i + 1;
        }
        var k2: i64 = 0;
        while (k2 < slice_len(chout) as i64) {
            if (chout[k2] == t) {
                if (k2 == 0) { return w_xlbl(p); }
                return w_wlbl(chout[k2 - 1]);
            }
            k2 = k2 + 1;
        }
        if (p == 0) { break; }
        var ip: i64 = g_widom[p];
        if (ip < 0 or ip == p) { break; }
        p = ip;
        guard = guard + 1;
    }
    if (g_wloop[t]) { return w_lbl(t); }   // 兜底：祖先循环头的回边
    return "";                             // 兜底：顺序落入（不可归约 / 未覆盖情形）
}

// 结构化控制流发射（支配树递归）。
// 布局：
//   循环头 b：(block $Xb (loop $b <in-wrappers> <b 指令> <in 子块…>)) <out-wrappers> <out 子块…>
//   非循环头：<wrappers> <b 指令> <子块…>（逐块关闭）
// ⚠ 循环内子块（in）的 wrapper 必须开在 (loop $b) **之内**、循环外子块（out）的 wrapper 开在
//   (block $Xb) **之外**。若把循环后继也包进 loop，「跳出循环」的 br 会连后继一起跳过
//   （曾致 main 直接落到函数尾 unreachable）。
pub fn w_emit_dom(sb: StringBuilder, b: i64) void {
    var isloop: bool = (g_wloop[b] and b != 0);
    var chin: []i64 = g_wchin[b];
    var ncin: i64 = slice_len(chin) as i64;
    var chout: []i64 = g_wchout[b];
    var ncout: i64 = slice_len(chout) as i64;
    if (isloop) {
        sb_append_str(sb, "    (block $"); sb_append_str(sb, w_xlbl(b)); sb_append_str(sb, "\n");
        sb_append_str(sb, "    (loop $"); sb_append_str(sb, w_lbl(b)); sb_append_str(sb, "\n");
    }
    var i: i64 = ncin - 1;
    while (i >= 0) {
        sb_append_str(sb, "    (block $"); sb_append_str(sb, w_wlbl(chin[i])); sb_append_str(sb, "\n");
        i = i - 1;
    }
    var blk: TMIRBlock = g_wf.blocks[b];
    var ni: i64 = slice_len(blk.insts) as i64;
    var k: i64 = 0;
    while (k + 1 < ni) { w_emit_inst(sb, blk.insts[k]); k = k + 1; }
    if (ni > 0) { w_emit_term(sb, b, blk.insts[ni - 1]); }
    var j: i64 = 0;
    while (j < ncin) {
        w_emit_dom(sb, chin[j]);
        sb_append_str(sb, "    )\n");
        j = j + 1;
    }
    if (isloop) {
        sb_append_str(sb, "    )\n");   // close (loop $b)
        sb_append_str(sb, "    )\n");   // close (block $Xb)
    }
    i = ncout - 1;
    while (i >= 0) {
        sb_append_str(sb, "    (block $"); sb_append_str(sb, w_wlbl(chout[i])); sb_append_str(sb, "\n");
        i = i - 1;
    }
    j = 0;
    while (j < ncout) {
        w_emit_dom(sb, chout[j]);
        sb_append_str(sb, "    )\n");
        j = j + 1;
    }
}

// 自然后继（支配后代）：br→[L]；br_cond→[T,E] 中 in_dom 且非循环头者
pub fn w_natural_succ(b: i64) i64 {
    var blk: TMIRBlock = g_wf.blocks[b];
    var ni: i64 = slice_len(blk.insts) as i64;
    if (ni == 0) { return -1; }
    var term: TMIRInst = blk.insts[ni - 1];
    if (term.op == tir__TIR_OP_BR) {
        var L: i64 = w_bname_to_idx(term.args[0].name);
        if (w_in_dom(b, L) and g_wloop[L] == false) { return L; }
        return -1;
    }
    if (term.op == tir__TIR_OP_BR_COND) {
        var T: i64 = w_bname_to_idx(term.args[1].name);
        var E: i64 = w_bname_to_idx(term.args[2].name);
        if (w_in_dom(b, T) and g_wloop[T] == false) { return T; }
        if (w_in_dom(b, E) and g_wloop[E] == false) { return E; }
        return -1;
    }
    return -1;
}

pub fn w_emit_term(sb: StringBuilder, b: i64, term: TMIRInst) void {
    if (term.op == tir__TIR_OP_RET_VOID) { sb_append_str(sb, "    return\n"); return; }
    if (term.op == tir__TIR_OP_RET) {
        // 返回类型适配：TIR 的 ret 操作数可能是更窄的整型（如字面量 i32 当 i64 返回）。
        var frs: i64 = w_st_from_str(g_wf.ret_st);
        sb_append_str(sb, "    (return ");
        w_emit_operand(sb, term.dst, frs);
        sb_append_str(sb, ")\n"); return;
    }
    if (term.op == tir__TIR_OP_BR) {
        var L: i64 = w_bname_to_idx(term.args[0].name);
        var lb: string = w_br_lbl(b, L);
        if (str_len(lb) > 0) { sb_append_str(sb, "    br $"); sb_append_str(sb, lb); sb_append_str(sb, "\n"); }
        return;
    }
    if (term.op == tir__TIR_OP_BR_COND) {
        var T: i64 = w_bname_to_idx(term.args[1].name);
        var E: i64 = w_bname_to_idx(term.args[2].name);
        var lt: string = w_br_lbl(b, T);
        var le: string = w_br_lbl(b, E);
        // 折叠式 if 必须整体加括号：(if (cond) (then ...) (else ...))；
        // 混用「折叠条件 + 裸 then/else + )」会被 wat2wasm 判为未知记号。
        sb_append_str(sb, "    (if "); w_emit_val(sb, term.args[0]); sb_append_str(sb, "\n");
        sb_append_str(sb, "      (then");
        if (str_len(lt) > 0) { sb_append_str(sb, " (br $"); sb_append_str(sb, lt); sb_append_str(sb, ")"); }
        sb_append_str(sb, ")\n");
        sb_append_str(sb, "      (else");
        if (str_len(le) > 0) { sb_append_str(sb, " (br $"); sb_append_str(sb, le); sb_append_str(sb, ")"); }
        sb_append_str(sb, "))\n");
        return;
    }
    sb_append_str(sb, "    ;; unsupported term\n");
}

// 操作数 → WAT 值表达式。want 为期望类型：立即数常不带 st（实测多为 0），由调用方给出。
pub fn w_emit_val_st(sb: StringBuilder, op: TirOperand, want: i64) void {
    if (str_len(op.name) as i64 > 0 and op.name[0] == 64) { // '@' 全局
        sb_append_str(sb, "(global.get $"); sb_append_str(sb, w_fn_name(op.name)); sb_append_str(sb, ")");
        return;
    }
    if (str_len(op.name) as i64 > 0 and op.name[0] == 36) { // '$' slot
        sb_append_str(sb, "(local.get $"); sb_append_str(sb, w_strip_suf(op.name)); sb_append_str(sb, ")");
        return;
    }
    // 立即数
    var wt: string = tmir.tmir_st_wasm(want);
    if (op.st != tir__ST_NONE) { wt = tmir.tmir_st_wasm(op.st); }
    sb_append_str(sb, "("); sb_append_str(sb, wt); sb_append_str(sb, ".const "); sb_append_str(sb, op.name); sb_append_str(sb, ")");
}
pub fn w_emit_val(sb: StringBuilder, op: TirOperand) void { w_emit_val_st(sb, op, tir__ST_I32); }

pub fn w_emit_inst(sb: StringBuilder, ins: TMIRInst) void {
    if (ins.is_comment) { sb_append_str(sb, "    ;; "); sb_append_str(sb, ins.cmt); sb_append_str(sb, "\n"); return; }
    var op: i64 = ins.op;
    // TIR_OP_SLOT 是帧槽声明：WASM 的 local 已由 w_collect_slots 统一声明，此处无需发射。
    if (op == tir__TIR_OP_SLOT) { return; }
    // ── S2 取址 / GEP：聚合基址 + 字段偏移 ──
    if (op == tir__TIR_OP_ADDR_OF) {
        var dstn: string = w_strip_suf(ins.dst.name);
        var basen: string = w_strip_suf(ins.args[0].name);
        // 聚合基槽 local 已持有静态内存基址（i32），直接拷给 dst（dst 也是 i32 地址）。
        // 记录 dst 的基类型（%Struct / [N]T），供后续 gep 据索引算字节偏移。
        sb_append_str(sb, "    (local.set $"); sb_append_str(sb, dstn);
        sb_append_str(sb, " (local.get $"); sb_append_str(sb, basen); sb_append_str(sb, "))\n");
        w_addr_base_mark(dstn, tir.tir_st_to_str(ins.st));
        return;
    }
    if (op == tir__TIR_OP_GEP) {
        var dstn: string = w_strip_suf(ins.dst.name);
        var basen: string = w_strip_suf(ins.args[0].name);
        var bty: string = w_addr_base_find(basen);   // 基聚合类型（"%Struct"/"[N]T"）
        var idx: i64 = tir.tir_atoi(ins.args[2].name);  // 字段/元素索引（非字节偏移！）
        var off: i64 = w_gep_offset(bty, idx);
        sb_append_str(sb, "    (local.set $"); sb_append_str(sb, dstn);
        sb_append_str(sb, " (i32.add (local.get $"); sb_append_str(sb, basen);
        sb_append_str(sb, ") (i32.const "); sb_append_str(sb, base.i2s(off)); sb_append_str(sb, ")))\n");
        w_addr_mark(dstn, ins.st);  // 记录元素类型（load/store 宽度）
        return;
    }
    // GEP_IDX：运行时节点的数组下标（a[i]）。偏移 = idx * 元素宽，须运行时乘。
    if (op == tir__TIR_OP_GEP_IDX) {
        var dstn: string = w_strip_suf(ins.dst.name);
        var basen: string = w_strip_suf(ins.args[0].name);
        var bty: string = w_addr_base_find(basen);   // 基数组类型 "arr<T x N>"
        var elem: string = w_array_elem(bty);
        var esz: i64 = w_tstr_size(elem);
        sb_append_str(sb, "    (local.set $"); sb_append_str(sb, dstn);
        sb_append_str(sb, " (i32.add (local.get $"); sb_append_str(sb, basen);
        sb_append_str(sb, ") (i32.mul (i32.const "); sb_append_str(sb, base.i2s(esz));
        sb_append_str(sb, ") (local.get $"); sb_append_str(sb, w_strip_suf(ins.args[1].name));
        sb_append_str(sb, "))))\n");
        w_addr_mark(dstn, ins.st);  // 记录元素类型（load/store 宽度）
        return;
    }
    // load / store：目标是地址槽 → 内存指令；否则 slot 间拷贝
    if (op == tir__TIR_OP_LOAD) {
        var dstn: string = w_strip_suf(ins.dst.name);
        var srcn: string = w_strip_suf(ins.args[0].name);
        var ast: i64 = w_addr_find(srcn);
        if (ast != tir__ST_NONE) {
            sb_append_str(sb, "    (local.set $"); sb_append_str(sb, dstn);
            sb_append_str(sb, " ("); sb_append_str(sb, w_mem_suffix(ast)); sb_append_str(sb, ".load (local.get $");
            sb_append_str(sb, srcn); sb_append_str(sb, ")))\n");
            return;
        }
        var wl: i64 = w_slot_st(dstn, g_wf);
        sb_append_str(sb, "    (local.set $"); sb_append_str(sb, dstn); sb_append_str(sb, " ");
        w_emit_operand(sb, ins.args[0], wl); sb_append_str(sb, ")\n"); return;
    }
    if (op == tir__TIR_OP_STORE) {
        var dname: string = ins.dst.name;
        if (str_len(dname) as i64 > 0 and dname[0] == 64) {  // 全局变量写（store @g ...）
            var gname: string = w_fn_name(dname);  // 剥 '@'
            var vst: i64 = w_global_st(gname);
            sb_append_str(sb, "    (global.set $"); sb_append_str(sb, gname);
            sb_append_str(sb, " "); w_emit_operand(sb, ins.args[0], vst); sb_append_str(sb, ")\n");
            return;
        }
        var dstn: string = w_strip_suf(dname);
        var ast: i64 = w_addr_find(dstn);
        if (ast != tir__ST_NONE) {
            sb_append_str(sb, "    ("); sb_append_str(sb, w_mem_suffix(ast));
            sb_append_str(sb, ".store (local.get $"); sb_append_str(sb, dstn); sb_append_str(sb, ") ");
            w_emit_operand(sb, ins.args[0], ast); sb_append_str(sb, ")\n");
            return;
        }
        var ws: i64 = w_slot_st(dstn, g_wf);
        sb_append_str(sb, "    (local.set $"); sb_append_str(sb, dstn); sb_append_str(sb, " ");
        w_emit_operand(sb, ins.args[0], ws); sb_append_str(sb, ")\n"); return;
    }
    if (op == tir__TIR_OP_CONST) { sb_append_str(sb, "    (local.set $"); sb_append_str(sb, w_strip_suf(ins.dst.name)); sb_append_str(sb, " ("); sb_append_str(sb, tmir.tmir_st_wasm(w_slot_st(w_strip_suf(ins.dst.name), g_wf))); sb_append_str(sb, ".const "); sb_append_str(sb, ins.args[0].name); sb_append_str(sb, "))\n"); return; }
    if (op == tir__TIR_OP_CONST_STR) { sb_append_str(sb, "    ;; const.str unsupported (S2)\n"); return; }
    // call
    if (op == tir__TIR_OP_CALL) {
        sb_append_str(sb, "    (local.set $"); sb_append_str(sb, w_strip_suf(ins.dst.name)); sb_append_str(sb, " (call $");
        sb_append_str(sb, w_fn_name(ins.args[0].name)); sb_append_str(sb, "");
        var na: i64 = slice_len(ins.args) as i64;
        var a: i64 = 1;
        while (a < na) { sb_append_str(sb, " "); w_emit_val(sb, ins.args[a]); a = a + 1; }
        sb_append_str(sb, "))\n");
        return;
    }
    // 一元
    if (op == tir__TIR_OP_NEG) { w_set_binop(sb, ins, "sub", "0", "0"); return; }
    if (op == tir__TIR_OP_NOT) { sb_append_str(sb, "    (local.set $"); sb_append_str(sb, w_strip_suf(ins.dst.name)); sb_append_str(sb, " (i32.xor "); w_emit_operand(sb, ins.args[0], tir__ST_I32); sb_append_str(sb, " (i32.const -1)))\n"); return; }
    if (op == tir__TIR_OP_LNOT) { sb_append_str(sb, "    (local.set $"); sb_append_str(sb, w_strip_suf(ins.dst.name)); sb_append_str(sb, " (i32.eqz "); w_emit_operand(sb, ins.args[0], tir__ST_I32); sb_append_str(sb, "))\n"); return; }
    // 转换
    if (op == tir__TIR_OP_ZEXT or op == tir__TIR_OP_SEXT or op == tir__TIR_OP_TRUNC) {
        sb_append_str(sb, "    (local.set $"); sb_append_str(sb, w_strip_suf(ins.dst.name)); sb_append_str(sb, " ");
        var d64: bool = (w_res_st(ins) == tir__ST_I64 or w_res_st(ins) == tir__ST_U64 or w_res_st(ins) == tir__ST_PTR or w_res_st(ins) == tir__ST_PTR_VOID);
        // 源宽度：全局操作数用全局声明类型（@g2count.s4 的 a.st 可能是 i64 误标），其余用 w_arg_st。
        var sst: i64 = w_arg_st(ins, 0);
        if (str_len(ins.args[0].name) as i64 > 0 and ins.args[0].name[0] == 64) { sst = w_global_st(w_fn_name(ins.args[0].name)); }
        var s64: bool = (sst == tir__ST_I64 or sst == tir__ST_U64 or sst == tir__ST_PTR or sst == tir__ST_PTR_VOID);
        if (d64 and s64 == false) {
            if (op == tir__TIR_OP_ZEXT) { sb_append_str(sb, "(i64.extend_i32_u "); } else { sb_append_str(sb, "(i64.extend_i32_s "); }
            w_emit_operand(sb, ins.args[0], w_arg_st(ins, 0)); sb_append_str(sb, "))\n"); return;
        }
        if (d64 == false and s64) { sb_append_str(sb, "(i32.wrap_i64 "); w_emit_operand(sb, ins.args[0], w_arg_st(ins, 0)); sb_append_str(sb, "))\n"); return; }
        w_emit_operand(sb, ins.args[0], w_res_st(ins)); sb_append_str(sb, ")\n"); return;
    }
    // 浮点 ↔ 整数 / 浮点 ↔ 浮点
    if (op == tir__TIR_OP_FPTOSI or op == tir__TIR_OP_FPTOUI or op == tir__TIR_OP_SITOFP or op == tir__TIR_OP_UITOFP or op == tir__TIR_OP_FPEXT or op == tir__TIR_OP_FPTRUNC) {
        var dt: string = tmir.tmir_st_wasm(w_res_st(ins));
        var ss: string = tmir.tmir_st_wasm(w_arg_st(ins, 0));
        var mn: string = "";
        if (op == tir__TIR_OP_FPTOSI) { mn = base.sb_cat3(dt, ".trunc_", base.sb_cat2(ss, "_s")); }
        else if (op == tir__TIR_OP_FPTOUI) { mn = base.sb_cat3(dt, ".trunc_", base.sb_cat2(ss, "_u")); }
        else if (op == tir__TIR_OP_SITOFP) { mn = base.sb_cat3(dt, ".convert_", base.sb_cat2(ss, "_s")); }
        else if (op == tir__TIR_OP_UITOFP) { mn = base.sb_cat3(dt, ".convert_", base.sb_cat2(ss, "_u")); }
        else if (op == tir__TIR_OP_FPEXT) { mn = "f64.promote_f32"; }
        else { mn = "f32.demote_f64"; }
        sb_append_str(sb, "    (local.set $"); sb_append_str(sb, w_strip_suf(ins.dst.name)); sb_append_str(sb, " (");
        sb_append_str(sb, mn); sb_append_str(sb, " "); w_emit_operand(sb, ins.args[0], w_arg_st(ins, 0)); sb_append_str(sb, "))\n");
        return;
    }
    // 二元
    if (w_val_st(ins) == tir__ST_F32 or w_val_st(ins) == tir__ST_F64) { w_emit_fbinop(sb, ins); return; }
    var mnem: string = w_int_mnem(op, w_val_st(ins));
    if (mnem == "") { sb_append_str(sb, "    ;; unsupported op "); sb_append_str(sb, base.i2s(op)); sb_append_str(sb, "\n"); return; }
    sb_append_str(sb, "    (local.set $"); sb_append_str(sb, w_strip_suf(ins.dst.name)); sb_append_str(sb, " (");
    var wa: i64 = w_val_st(ins);
    sb_append_str(sb, mnem); sb_append_str(sb, " "); w_emit_operand(sb, ins.args[0], wa); sb_append_str(sb, " "); w_emit_operand(sb, ins.args[1], wa); sb_append_str(sb, "))\n");
}

// 用 sub 实现 neg（t 无 neg 一元 op 直接映射到 wasm）：a - 0
pub fn w_set_binop(sb: StringBuilder, ins: TMIRInst, mnem: string, filler: string, filler2: string) void {
    sb_append_str(sb, "    (local.set $"); sb_append_str(sb, w_strip_suf(ins.dst.name)); sb_append_str(sb, " (");
    sb_append_str(sb, mnem); sb_append_str(sb, " "); w_emit_operand(sb, ins.args[0], w_val_st(ins)); sb_append_str(sb, " ("); sb_append_str(sb, tmir.tmir_st_wasm(w_val_st(ins))); sb_append_str(sb, ".const 0)))\n");
}

pub fn w_int_mnem(op: i64, st: i64) string {
    var s: string = tmir.tmir_st_wasm(st); // i32/i64/...
    if (op == tir__TIR_OP_ADD) { return base.sb_cat2(s, ".add"); }
    if (op == tir__TIR_OP_SUB) { return base.sb_cat2(s, ".sub"); }
    if (op == tir__TIR_OP_MUL) { return base.sb_cat2(s, ".mul"); }
    if (op == tir__TIR_OP_AND) { return base.sb_cat2(s, ".and"); }
    if (op == tir__TIR_OP_OR) { return base.sb_cat2(s, ".or"); }
    if (op == tir__TIR_OP_XOR) { return base.sb_cat2(s, ".xor"); }
    if (op == tir__TIR_OP_SHL) { return base.sb_cat2(s, ".shl"); }
    if (op == tir__TIR_OP_LSHR) { return base.sb_cat2(s, ".shr_u"); }
    if (op == tir__TIR_OP_ASHR) { return base.sb_cat2(s, ".shr_s"); }
    if (op == tir__TIR_OP_SDIV) { return base.sb_cat2(s, ".div_s"); }
    if (op == tir__TIR_OP_UDIV) { return base.sb_cat2(s, ".div_u"); }
    if (op == tir__TIR_OP_SREM) { return base.sb_cat2(s, ".rem_s"); }
    if (op == tir__TIR_OP_UREM) { return base.sb_cat2(s, ".rem_u"); }
    if (op == tir__TIR_OP_EQ) { return base.sb_cat2(s, ".eq"); }
    if (op == tir__TIR_OP_NE) { return base.sb_cat2(s, ".ne"); }
    if (op == tir__TIR_OP_SLT) { return base.sb_cat2(s, ".lt_s"); }
    if (op == tir__TIR_OP_SGT) { return base.sb_cat2(s, ".gt_s"); }
    if (op == tir__TIR_OP_SLE) { return base.sb_cat2(s, ".le_s"); }
    if (op == tir__TIR_OP_SGE) { return base.sb_cat2(s, ".ge_s"); }
    if (op == tir__TIR_OP_ULT) { return base.sb_cat2(s, ".lt_u"); }
    if (op == tir__TIR_OP_UGT) { return base.sb_cat2(s, ".gt_u"); }
    if (op == tir__TIR_OP_ULE) { return base.sb_cat2(s, ".le_u"); }
    if (op == tir__TIR_OP_UGE) { return base.sb_cat2(s, ".ge_u"); }
    return "";
}

pub fn w_emit_fbinop(sb: StringBuilder, ins: TMIRInst) void {
    var op: i64 = ins.op;
    var fsz: string = "f32"; if (w_val_st(ins) == tir__ST_F64) { fsz = "f64"; }
    var mnem: string = "";
    if (op == tir__TIR_OP_ADD) { mnem = "add"; } else if (op == tir__TIR_OP_SUB) { mnem = "sub"; }
    else if (op == tir__TIR_OP_MUL) { mnem = "mul"; } else if (op == tir__TIR_OP_SDIV or op == tir__TIR_OP_UDIV) { mnem = "div"; }
    else if (op == tir__TIR_OP_EQ) { mnem = "eq"; } else if (op == tir__TIR_OP_NE) { mnem = "ne"; }
    else if (op == tir__TIR_OP_SLT) { mnem = "lt"; } else if (op == tir__TIR_OP_SLE) { mnem = "le"; }
    else if (op == tir__TIR_OP_SGT) { mnem = "gt"; } else if (op == tir__TIR_OP_SGE) { mnem = "ge"; }
    if (mnem == "") { sb_append_str(sb, "    ;; unsupported float op "); sb_append_str(sb, base.i2s(op)); sb_append_str(sb, "\n"); return; }
    sb_append_str(sb, "    (local.set $"); sb_append_str(sb, w_strip_suf(ins.dst.name)); sb_append_str(sb, " (");
    var wf: i64 = w_val_st(ins);
    sb_append_str(sb, fsz); sb_append_str(sb, "."); sb_append_str(sb, mnem); sb_append_str(sb, " "); w_emit_operand(sb, ins.args[0], wf); sb_append_str(sb, " "); w_emit_operand(sb, ins.args[1], wf); sb_append_str(sb, "))\n");
}
