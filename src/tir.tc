// ══════════════════════════════════════════════════════════════════
// src/tir.tc — TIR 后端桥（compiler-pipeline-design.md §4.4 / tir-design.md）
//
// 职责：在 sema(+单态化+CTFE) 之后、codegen_c/codegen_ll 之前，把已擦除类型的
// 编译单元降级为「类型擦除·文件级·线性」的 TIR（memory-first）。本模块是新增的
// 加性层：旧 C/LLVM 后端完全不动，本模块只被 `tc emit-tir` 命令消费。
//
// 本文件实现：
//   - TIR 内存结构（TIRModule / TIRType / TIRInst / TIRFunc）
//   - 文本序列化 tir.to_text()（tir-design.md §4 规范真相源）
//   - TD → ST 映射 tir.st_of_td()（tir-design.md §5/§7，三处偏离 LLVM）
//   - lower_unit() 降级 pass（Stage 0 + Stage 1 + Stage 2 子集）
//
// 内存表示取「扁平 TIRInst 数组」范式（tir-design.md §4.1），与 base 节点池（侧表群）同构；
// 每条指令以完整文本行存储（序列化即按行展开），Stage 4b 二进制格式在其上叠加。
// ══════════════════════════════════════════════════════════════════

const base = @import("src.base");
const sema = @import("src.sema");
const lex = @import("src.lex");
// S2：内建返回类型单一真相源（codegen_c.builtin_ret_td），供降级期查询内建调用返回 TD。
// 单向导入 codegen_c（codegen_c 不导入 tir），无环；tc.tc 已先加载 codegen_c，顺序安全。
// ── S5-删除：原 codegen_c.builtin_ret_td 及其 math 内建分类辅助迁至此处（tir 后端依赖，单一类型真相源）──
pub fn math_is_mbuiltin_c(cn: string) bool {
    if (cn == "sin" or cn == "sinf" or cn == "cos" or cn == "cosf" or cn == "tan" or cn == "tanf"
        or cn == "atan" or cn == "atanf" or cn == "atan2" or cn == "atan2f" or cn == "acos" or cn == "acosf"
        or cn == "asin" or cn == "asinf" or cn == "exp" or cn == "expf" or cn == "log" or cn == "logf"
        or cn == "log10" or cn == "log10f" or cn == "pow" or cn == "powf" or cn == "sinh" or cn == "sinhf") {
        return true;
    }
    if (cn == "cosh" or cn == "coshf" or cn == "tanh" or cn == "tanhf" or cn == "sqrt" or cn == "sqrtf"
        or cn == "fmod" or cn == "fmodf" or cn == "fabs" or cn == "fabsf" or cn == "floor" or cn == "floorf"
        or cn == "ceil" or cn == "ceilf" or cn == "trunc" or cn == "truncf" or cn == "round" or cn == "roundf"
        or cn == "exp2" or cn == "exp2f" or cn == "log2" or cn == "log2f") {
        return true;
    }
    if (cn == "log1p" or cn == "log1pf" or cn == "expm1" or cn == "expm1f" or cn == "hypot" or cn == "hypotf"
        or cn == "cbrt" or cn == "cbrtf"
        or cn == "copysign" or cn == "copysignf" or cn == "nextafter" or cn == "nextafterf"
        or cn == "remainder" or cn == "remainderf" or cn == "fmin" or cn == "fminf"
        or cn == "fmax" or cn == "fmaxf" or cn == "fdim" or cn == "fdimf") {
        return true;
    }
    if (cn == "fma" or cn == "fmaf"
        or cn == "signbit" or cn == "isnan" or cn == "isinf" or cn == "isfinite" or cn == "isnormal") {
        return true;
    }
    return false;
}

pub fn math_is_predicate_c(cn: string) bool {
    if (cn == "signbit" or cn == "isnan" or cn == "isinf" or cn == "isfinite" or cn == "isnormal") {
        return true;
    }
    return false;
}

pub fn math_is_f32_variant_c(cn: string) bool {
    if (str_len(cn) < 1) { return false; }
    if (str_slice(cn, str_len(cn) - 1, str_len(cn)) != "f") { return false; }
    var base: string = str_slice(cn, 0, str_len(cn) - 1);
    return math_is_mbuiltin_c(base);
}

pub fn builtin_ret_td(cn: string) i64 {
    if (cn == "file_read_all") { return sema.td_mk("string"); }
    if (cn == "path_resolve") { return sema.td_mk("string"); }
    if (cn == "getenv") { return sema.td_mk("string"); }
    if (cn == "str_len") { return sema.td_named_mk("scalar", "u64"); }
    if (cn == "slice_len") { return sema.td_named_mk("scalar", "u64"); }
    if (cn == "str_at") { return sema.td_named_mk("scalar", "u8"); }
    if (cn == "args") {
        return sema.td_elem_mk("slice", sema.td_mk("string"));
    }
    if (cn == "read_line") { return sema.td_mk("string"); }
    if (cn == "stdin_eof") { return sema.td_named_mk("scalar", "bool"); }
    if (cn == "file_write_all") { return sema.td_named_mk("scalar", "bool"); }
    if (cn == "file_exists") { return sema.td_named_mk("scalar", "bool"); }
    if (cn == "str_slice") { return sema.td_mk("string"); }
    if (cn == "bytes_len") { return sema.td_named_mk("scalar", "u64"); }
    if (cn == "bytes_at") { return sema.td_named_mk("scalar", "u8"); }
    if (cn == "bytes_slice") { return sema.td_mk("bytes"); }
    if (cn == "bsb_new") { return sema.td_named_mk("named", "TSb*"); }
    if (cn == "bsb_append_u8" or cn == "bsb_append_bytes") { return sema.td_mk("void"); }
    if (cn == "bsb_to_bytes") { return sema.td_mk("bytes"); }
    if (cn == "sb_to_str") { return sema.td_mk("string"); }
    if (cn == "int_to_str" or cn == "i2s") { return sema.td_mk("string"); }
    if (cn == "sb_new") { return sema.td_named_mk("named", "TSb*"); }
    if (cn == "map_has") { return sema.td_named_mk("scalar", "bool"); }
    if (cn == "map_del") { return sema.td_named_mk("scalar", "bool"); }
    if (cn == "map_len") { return sema.td_named_mk("scalar", "i64"); }
    if (cn == "map_set") { return sema.td_mk("void"); }
    if (cn == "map_new") { return -1; }
    if (cn == "sym_str") { return sema.td_mk("string"); }
    if (cn == "sym_release") { return sema.td_mk("void"); }
    if (cn == "sym_release_all") { return sema.td_mk("void"); }
    if (cn == "atom_str") { return sema.td_mk("string"); }
    if (cn == "fopen") { return sema.td_named_mk("scalar", "fid"); }
    if (cn == "fclose" or cn == "fflush" or cn == "fmt_register") { return sema.td_mk("void"); }
    if (cn == "fid_is_open") { return sema.td_named_mk("scalar", "bool"); }
    if (cn == "fid_eof") { return sema.td_named_mk("scalar", "bool"); }
    if (cn == "fid_format") { return sema.td_named_mk("scalar", "atom"); }
    if (cn == "fid_error") { return sema.td_mk("string"); }
    if (cn == "fseek") { return sema.td_named_mk("scalar", "bool"); }
    if (cn == "ftell") { return sema.td_named_mk("scalar", "i64"); }
    if (cn == "now" or cn == "time_invalid" or cn == "parse_time" or cn == "parse_time_local") { return sema.td_named_mk("scalar", "i64"); }
    if (cn == "format_time" or cn == "format_time_local" or cn == "format_time_tz") { return sema.td_mk("string"); }
    if (cn == "format_int" or cn == "format_uint" or cn == "format_float" or cn == "format_str" or cn == "format_bool" or cn == "format_char") { return sema.td_mk("string"); }
    if (cn == "sb_append_fmt_int" or cn == "sb_append_fmt_uint" or cn == "sb_append_fmt_float" or cn == "sb_append_fmt_str" or cn == "sb_append_fmt_bool" or cn == "sb_append_fmt_char") { return sema.td_mk("void"); }
    if (cn == "sb_append_fmt_str_conv" or cn == "sb_append_fmt_int_conv" or cn == "sb_append_fmt_uint_conv") { return sema.td_mk("void"); }
    if (math_is_mbuiltin_c(cn)) {
        if (math_is_predicate_c(cn)) { return sema.td_named_mk("scalar", "i32"); }
        if (math_is_f32_variant_c(cn)) { return sema.td_named_mk("scalar", "f32"); }
        return sema.td_named_mk("scalar", "f64");
    }
    return -1;
}
// 除/取余 op 文本→整数判别码的小模块（见 opmap.tc 注释：规避种子对 tir.tc 大模块的错编）。
// 单向导入，opmap 自包含无回依赖，无环。
const opmap = @import("src.opmap");

// ── 内存结构 ───────────────────────────────────────────────────
pub struct TIRType {
    name: string;   // %Name（TT 条目引用）
    body: string;   // 字段 ST 列表文本，如 "f0: i64, f1: i64"
}

// 操作数：承载「名字」（含 $/@ 前缀）+ 自身存储类型 st（FS-3，取代翻译期 ll_get_st 侧信道）。
// st 经文本后缀 `.s<ST码>` 在 lower→translate 之间携带（TIRInst 由文本解析构造，见 tc.tc:699）。
// 名字与 st 一并随操作数走，翻译器读 operand.st 即得类型，无需按名字反查影子表。
pub struct TirOperand {
    name: string;
    st: i64;       // ST_* 编码；0 = 未携带（翻译期回退 ll_get_st）
}

// 表达式发射结果：name=承载值的 slot；st=实际发射存储类型（取代全局侧信道 g_tir_last_st，
// 使发射顺序不再影响外层 cast/binary/unary/subscript 取到的真实源类型）。
pub struct TirEmitRes {
    name: string;
    st: i64;
}

// 结构化指令：op 为单一 opcode 标记（非位置编码整行文本）；st 为值/结果存储类型；
// dst/args 为结构化操作数。层间不再传递字符串或整行文本（§5.6）。

// 构造单个操作数（避免切片字面量作为表达式位/字段初始化，绕过种子代码生成对 `[]` 的限制）。
pub fn tir_op(name: string) TirOperand { return TirOperand{ name: name, st: 0 }; }

// 构造带存储类型的操作数（FS-3：类型随操作数走，取代 ll_get_st 影子表）。
pub fn tir_op_st(name: string, st: i64) TirOperand { return TirOperand{ name: name, st: st }; }

// 纯数字串 → i64（无标准库 atoi 依赖）。非法返回 -1。
pub fn tir_digits_to_i64(s: string) i64 {
    var r: i64 = 0;
    var i: i64 = 0;
    var n: i64 = str_len(s) as i64;
    while (i < n) {
        var c: i64 = s[i] as i64;
        if (c >= 48 and c <= 57) { r = r * 10 + (c - 48); }
        else { return -1; }
        i = i + 1;
    }
    return r;
}

// 操作数 token 解码：识别尾部 `.s<ST码>` 后缀，提取 st 并从名字剥离（如 `$a.s5` → {name:"$a", st:5}）。
// 名字本身不含 `.s`（slot/global/立即数均无此序列；浮点立即数 `1.5` 的 `.5` ≠ `.s`）。
pub fn tir_op_tok(tok: string) TirOperand {
    var L: i64 = str_len(tok) as i64;
    var i: i64 = L - 1;
    while (i >= 1) {
        if (tok[i] == 115 and tok[i - 1] == 46) {           // 's' 且前驱为 '.'
            var suf: string = str_slice(tok, i + 1, L);
            var code: i64 = tir_digits_to_i64(suf);
            if (suf != "" and code >= 0) {
                return TirOperand{ name: str_slice(tok, 0, i - 1), st: code };
            }
        }
        i = i - 1;
    }
    return TirOperand{ name: tok, st: 0 };
}

// 发射端帮手：给操作数名字附 `.s<ST码>` 后缀（st==0 时原样返回，不动点不变）。
pub fn tir_os(name: string, st: i64) string {
    if (st == 0) { return name; }
    return base.sb_cat3(name, ".s", base.i2s(st));
}



// ── TIR 操作码：整数判别常量（FS-1，替代 TIRInst.op:string）──────────
// 本语言枚举不支持 `==` 比较、且 match 仅允许表达式臂（不能放语句块），无法胜任
// 「30 路多语句分发」，故 op 用整数判别常量实现结构化：文本 op 基名在解析期经
// tir_op_from_str 落成整数码，消费者用 `==` 整数比较分发。设计目标一致——
// TIRInst.op 不再是 string 语义载体（见 docs/compiler/tir-full-struct.md FS-1）。
pub const TIR_OP_NONE: i64 = 0;
pub const TIR_OP_COMMENT: i64 = 1;
pub const TIR_OP_RET_VOID: i64 = 2;
pub const TIR_OP_RET: i64 = 3;
pub const TIR_OP_SLOT: i64 = 4;
pub const TIR_OP_CONST_STR: i64 = 5;
pub const TIR_OP_CONST_PTR_NULL: i64 = 6;
pub const TIR_OP_CONST: i64 = 7;
pub const TIR_OP_BITCAST: i64 = 8;
pub const TIR_OP_STORE: i64 = 9;
pub const TIR_OP_LOAD: i64 = 10;
pub const TIR_OP_ADDR_OF: i64 = 11;
pub const TIR_OP_GEP: i64 = 12;
pub const TIR_OP_GEP_IDX: i64 = 13;
pub const TIR_OP_SLICE_AT: i64 = 14;
pub const TIR_OP_STR_AT: i64 = 15;
pub const TIR_OP_STRUCT_NEW: i64 = 16;
pub const TIR_OP_CALL: i64 = 17;
pub const TIR_OP_CALL_IND: i64 = 18;
pub const TIR_OP_BR: i64 = 19;
pub const TIR_OP_BR_COND: i64 = 20;
pub const TIR_OP_BLOCK: i64 = 21;
pub const TIR_OP_TRUNC: i64 = 22;
pub const TIR_OP_ZEXT: i64 = 23;
pub const TIR_OP_SEXT: i64 = 24;
pub const TIR_OP_FPEXT: i64 = 25;
pub const TIR_OP_FPTRUNC: i64 = 26;
pub const TIR_OP_SITOFP: i64 = 27;
pub const TIR_OP_UITOFP: i64 = 28;
pub const TIR_OP_FPTOSI: i64 = 29;
pub const TIR_OP_FPTOUI: i64 = 30;
pub const TIR_OP_ADD: i64 = 31;
pub const TIR_OP_SUB: i64 = 32;
pub const TIR_OP_MUL: i64 = 33;
// ⚠ 种子编译器（旧 LLVM 后端自举）对「返回 const 值 34-37 的分支」存在静默错编
// （分支被丢弃 → 落到默认 TIR_OP_OTHER），导致新轨 / 与 % 全部降级为 add。
// 将 SDIV/UDIV/SREM/UREM 的判别值挪到 58-61（已知可正确编译区间），规避该错编。
// 所有引用均用名字 TIR_OP_*，值变更自动传播；旧轨 codegen_ll 不消费 TIR_OP_*，无副作用。
pub const TIR_OP_SDIV: i64 = 58;
pub const TIR_OP_UDIV: i64 = 59;
pub const TIR_OP_SREM: i64 = 60;
pub const TIR_OP_UREM: i64 = 61;
pub const TIR_OP_TYPEINFO: i64 = 62;   // type_info(T)：编译期合成 @__ti_<T> 全局常量引用（TIR 轨反射支持）
pub const TIR_OP_CONCAT: i64 = 63;     // 集合合并 `++`（§15.6）：bitstr/String/Slice 合并；按 st 在 LLVM 端分派到 tll_*
pub const TIR_OP_AND: i64 = 38;
pub const TIR_OP_OR: i64 = 39;
pub const TIR_OP_XOR: i64 = 40;
pub const TIR_OP_SHL: i64 = 41;
pub const TIR_OP_LSHR: i64 = 42;
pub const TIR_OP_ASHR: i64 = 43;
pub const TIR_OP_SLT: i64 = 44;
pub const TIR_OP_SGT: i64 = 45;
pub const TIR_OP_SGE: i64 = 46;
pub const TIR_OP_SLE: i64 = 47;
pub const TIR_OP_ULT: i64 = 48;
pub const TIR_OP_UGT: i64 = 49;
pub const TIR_OP_ULE: i64 = 50;
pub const TIR_OP_UGE: i64 = 51;
pub const TIR_OP_EQ: i64 = 52;
pub const TIR_OP_NE: i64 = 53;
pub const TIR_OP_NOT: i64 = 54;
pub const TIR_OP_LNOT: i64 = 55;
pub const TIR_OP_NEG: i64 = 56;
pub const TIR_OP_OTHER: i64 = 57;

// ── TIR 存储类型：整数判别码（FS-2a，替代 TIRInst.st:string）──────────
// 与 TIR_OP_* 同源：本语言无可用枚举（不能 `==`、match 不能放语句块），故 st 用
// 整数判别码。基元有固定码；命名/指针类型（%Xxx、ptr<%Y>）经拼写池 g_st_pool
// 内部化，tir_st_to_str 逐字节还原文本（emit-ll 输出须与旧轨一致）。
pub const ST_NONE: i64 = 0;
pub const ST_I1: i64 = 1;
pub const ST_I8: i64 = 2;
pub const ST_I16: i64 = 3;
pub const ST_I32: i64 = 4;
pub const ST_I64: i64 = 5;
pub const ST_U8: i64 = 6;
pub const ST_U16: i64 = 7;
pub const ST_U32: i64 = 8;
pub const ST_U64: i64 = 9;
pub const ST_F32: i64 = 10;
pub const ST_F64: i64 = 11;
pub const ST_PTR: i64 = 12;          // 裸 ptr（无元素拼写）
pub const ST_PTR_VOID: i64 = 13;     // ptr<void>
pub const ST_NAMED_BASE: i64 = 100;  // 命名/指针拼写：code = ST_NAMED_BASE + g_st_pool 下标

pub var g_st_pool: []string;   // 命名/指针 ST 拼写池（FS-2a）；声明即空（BSS 零化），勿带 `= []` 初始化器，否则旧编译器对空切片全局生成非法 `ptr 0`

pub fn tir_st_intern(s: string) i64 {
    var i: i64 = 0;
    var n: i64 = slice_len(g_st_pool) as i64;
    while (i < n) {
        if (g_st_pool[i] == s) { return ST_NAMED_BASE + i; }
        i = i + 1;
    }
    // ⚠ 代际分配器（2026-10-22）：类型拼写池 g_st_pool 及其元素必须常驻 g_arena。
    // 否则 backing 或元素串落 g_func，会被 arena_reset_func 回收 → tir_st_to_str 读到悬垂指针
    // → emit-ll 阶段（pass-1 扫命名类型 / pass-2 重降级）访问 decommitted 页 → 段错误。
    // (1) 把元素串逃逸提升到 g_arena（str_persist 拷贝 + 切 g_arena）；(2) append 前切 g_arena
    // 使 backing 也落 g_arena；(3) 还原 arena 到调用方上下文（与包裹式持久 append 同口径，
    // 见 base.g_relowering_scratch_func：lower_unit 期还原 g_arena，emit 重降级期还原 g_func）。
    if (base.g_relowering) { arena_use_default(); }
    append(g_st_pool, base.str_persist(s));
    if (base.g_relowering) {
        if (base.g_relowering_scratch_func) { arena_use_func(); } else { arena_use_default(); }
    } else { arena_use_default(); }
    return ST_NAMED_BASE + (slice_len(g_st_pool) as i64) - 1;
}

pub fn tir_st_from_str(s: string) i64 {
    if (s == "") { return ST_NONE; }
    if (s == "i1") { return ST_I1; }
    if (s == "i8") { return ST_I8; }
    if (s == "i16") { return ST_I16; }
    if (s == "i32") { return ST_I32; }
    if (s == "i64") { return ST_I64; }
    if (s == "u8") { return ST_U8; }
    if (s == "u16") { return ST_U16; }
    if (s == "u32") { return ST_U32; }
    if (s == "u64") { return ST_U64; }
    if (s == "f32") { return ST_F32; }
    if (s == "f64") { return ST_F64; }
    if (s == "ptr") { return ST_PTR; }
    if (s == "ptr<void>") { return ST_PTR_VOID; }
    return tir_st_intern(s);
}

pub fn tir_st_to_str(code: i64) string {
    if (code == ST_NONE) { return ""; }
    if (code == ST_I1) { return "i1"; }
    if (code == ST_I8) { return "i8"; }
    if (code == ST_I16) { return "i16"; }
    if (code == ST_I32) { return "i32"; }
    if (code == ST_I64) { return "i64"; }
    if (code == ST_U8) { return "u8"; }
    if (code == ST_U16) { return "u16"; }
    if (code == ST_U32) { return "u32"; }
    if (code == ST_U64) { return "u64"; }
    if (code == ST_F32) { return "f32"; }
    if (code == ST_F64) { return "f64"; }
    if (code == ST_PTR) { return "ptr"; }
    if (code == ST_PTR_VOID) { return "ptr<void>"; }
    if (code >= ST_NAMED_BASE) {
        var i: i64 = code - ST_NAMED_BASE;
        if (i >= 0 and i < slice_len(g_st_pool) as i64) { return g_st_pool[i]; }
    }
    return "i64";
}


// 整数判别码 → 文本基名（仅 tir_inst_to_text 调试序列化与 ll_emit_inst 取 LLVM 助记符用）
pub fn tir_op_to_str(o: i64) string {
    if (o == TIR_OP_NONE) { return ""; }
    if (o == TIR_OP_COMMENT) { return ";"; }
    if (o == TIR_OP_RET_VOID) { return "ret.void"; }
    if (o == TIR_OP_RET) { return "ret"; }
    if (o == TIR_OP_SLOT) { return "slot"; }
    if (o == TIR_OP_CONST_STR) { return "const.str"; }
    if (o == TIR_OP_CONST_PTR_NULL) { return "const.ptr.null"; }
    if (o == TIR_OP_CONST) { return "const"; }
    if (o == TIR_OP_BITCAST) { return "bitcast"; }
    if (o == TIR_OP_STORE) { return "store"; }
    if (o == TIR_OP_LOAD) { return "load"; }
    if (o == TIR_OP_ADDR_OF) { return "addr_of"; }
    if (o == TIR_OP_GEP) { return "gep"; }
    if (o == TIR_OP_GEP_IDX) { return "gep_idx"; }
    if (o == TIR_OP_SLICE_AT) { return "slice_at"; }
    if (o == TIR_OP_STR_AT) { return "str_at"; }
    if (o == TIR_OP_STRUCT_NEW) { return "struct_new"; }
    if (o == TIR_OP_CALL) { return "call"; }
    if (o == TIR_OP_CALL_IND) { return "call_ind"; }
    if (o == TIR_OP_TYPEINFO) { return "typeinfo"; }
    if (o == TIR_OP_CONCAT) { return "concat"; }
    if (o == TIR_OP_BR) { return "br"; }
    if (o == TIR_OP_BR_COND) { return "br_cond"; }
    if (o == TIR_OP_BLOCK) { return "block"; }
    if (o == TIR_OP_TRUNC) { return "trunc"; }
    if (o == TIR_OP_ZEXT) { return "zext"; }
    if (o == TIR_OP_SEXT) { return "sext"; }
    if (o == TIR_OP_FPEXT) { return "fpext"; }
    if (o == TIR_OP_FPTRUNC) { return "fptrunc"; }
    if (o == TIR_OP_SITOFP) { return "sitofp"; }
    if (o == TIR_OP_UITOFP) { return "uitofp"; }
    if (o == TIR_OP_FPTOSI) { return "fptosi"; }
    if (o == TIR_OP_FPTOUI) { return "fptoui"; }
    if (o == TIR_OP_ADD) { return "add"; }
    if (o == TIR_OP_SUB) { return "sub"; }
    if (o == TIR_OP_MUL) { return "mul"; }
    if (o == TIR_OP_SDIV) { return "div_s"; }
    if (o == TIR_OP_UDIV) { return "div_u"; }
    if (o == TIR_OP_SREM) { return "rem_s"; }
    if (o == TIR_OP_UREM) { return "rem_u"; }
    if (o == TIR_OP_AND) { return "and"; }
    if (o == TIR_OP_OR) { return "or"; }
    if (o == TIR_OP_XOR) { return "xor"; }
    if (o == TIR_OP_SHL) { return "shl"; }
    if (o == TIR_OP_LSHR) { return "lshr"; }
    if (o == TIR_OP_ASHR) { return "ashr"; }
    if (o == TIR_OP_SLT) { return "slt"; }
    if (o == TIR_OP_SGT) { return "sgt"; }
    if (o == TIR_OP_SGE) { return "sge"; }
    if (o == TIR_OP_SLE) { return "sle"; }
    if (o == TIR_OP_ULT) { return "ult"; }
    if (o == TIR_OP_UGT) { return "ugt"; }
    if (o == TIR_OP_ULE) { return "ule"; }
    if (o == TIR_OP_UGE) { return "uge"; }
    if (o == TIR_OP_EQ) { return "eq"; }
    if (o == TIR_OP_NE) { return "ne"; }
    if (o == TIR_OP_NOT) { return "not"; }
    if (o == TIR_OP_LNOT) { return "lnot"; }
    if (o == TIR_OP_NEG) { return "neg"; }
    return "<other>";
}

pub struct TIRInst {
    op: i64;            // 操作码整数判别（见 TIR_OP_* 常量；文本基名经 tir_op_from_str 落地）         // 操作码标记（"store"/"add.i64"/"trunc"…）
    st: i64;    // 值/结果存储类型（FS-2a：整数判别码，见 tir_st_to_str）
    dst: TirOperand;    // 目标操作数
    args: []TirOperand; // 源操作数列表
    is_comment: bool;   // true → 注释行（不支持构造的兜底）
    line: u64;          // 源锚点行（诊断用）
    cmt: string;        // 注释内容（is_comment 时有效）
}

// TIRInst 由各发射器直接结构化构造（tir_emit_* 帮手），经 tir_emit 统一 append + g_term；
// 不再经过文本 round-trip。结构化 → 文本仅由 tir_inst_to_text（调试/快照）单向派生。

pub struct TIRFunc {
    name: string;        // @name（不含 @）
    params: []string;    // "$p: ST" 文本列表
    ret_st: string;      // 返回存储类型
    body: []TIRInst;     // 线性指令数组
    is_extern: bool;
    is_kernel: bool;
    is_main: bool;       // @main 入口标注（供 emit-tir-ll 补 @main 包装器）
}

pub struct TIRGlobal {
    name: string;        // 全局变量名（不含 @）
    td: i64;             // 类型描述符
    init: i64;           // 初始化表达式节点（-1 表示无）
    is_link: i64;        // 0=本模块, 1/2=链接库（跳过初始化）
}

pub struct TIRModule {
    mod: string;         // 来源模块名（去 .tc）
    source: string;      // 源文件路径
    types: []TIRType;    // TT 类型表
    strings: []string;   // 字符串表
    funcs: []TIRFunc;    // 函数 + extern 声明
    globals: []TIRGlobal; // 模块级全局变量（Stage 4 降级目标）
}

// ── 模块级状态 ─────────────────────────────────────────────────
pub var g_mod: TIRModule;
pub var g_cur_func: TIRFunc;
pub var g_cur_line: u64;
pub var g_term: bool = false;       // 当前基本块是否已终止（ret/br 之后不再发射指令）
pub var g_recording_mir: bool = false;  // mir 录制开关（仅 tmir 后端路径开启；TIR 发射期并行录制 pre-TIR MIR）
// ⚠ 代际分配器（2026-10-22）：emit 阶段逐函数重降级标志。置 true 时 lower_unit 对 FuncDecl
// 只降级「签名 + 空体」进 g_arena（g_mod.funcs 恒持久），函数体本身推迟到 emit 阶段逐函数
// 重降级进 g_func 本块 arena（用完即 arena_reset_func 回收）。这样 emit 峰值从「语义图地板 +
// 全模块函数体」降为「语义图地板 + 单函数体」——这是压低 emit-ll src/tc.tc 峰值的唯一杠杆
// （函数体是唯一可随 emit 推进逐块回收的大宗瞬态；模块级类型表/符号/字符串是真实持久地板）。
// 仅 LLVM（tir_to_ll_emit）路径启用；tmir-c 后端消费 g_mod/g_mir 真实体，须保持 base.g_relowering=false。
// ⚠ 代际分配器：与 g_mod.funcs 等长的「重降级 decl 索引」表（仅 base.g_relowering 时构建）。
// 每位 = 对应 g_mod.funcs[fi] 的来源 FuncDecl 节点，或 -1（extern / ginit / 变体合成函数等
// 真实体须跨阶段持久、不可重降级）。emit pass-2 据此区分「需重降级」与「直接用 module 真实体」。
pub var g_relowering_decls: []i64 = [];
// ⚠ 代际分配器：tir_append_cur_func 调用前由 driver 写入「当前函数的重降级 decl 索引」；
// >=0 ⇒ FuncDecl（追加空体 + 记 decl）；-1 ⇒ 非 FuncDecl（追加真实体、不重降级）。
pub var g_cur_relower_decl: i64 = -1;
// ⚠ 代际分配器：emit 重降级调用 tir_lower_func 时置 true，抑制其向 g_mod.funcs 追加
// （体已由 g_cur_func 持有、直接供 emit 消费，避免重复追加/悬垂）。
pub var g_lower_suppress_append: bool = false;
// ⚠ 代际分配器（2026-10-22）：包裹式「持久 append」的还原目标 arena 标志。
// lower_unit 期 = false ⇒ 还原到 g_arena（默认持久区）——保证 g_mod.funcs / g_relowering_decls
//   及变体·ginit 真实函数体落在 g_arena，跨 emit 的 arena_reset_func() 不被回收/覆盖；
// emit 重降级期 = true ⇒ 还原到 g_func（scratch）——保证重降级 FuncDecl 体落在 g_func，
//   emit 后立即 arena_reset_func() 收得回（峰值 ≈ 语义图地板 + 单函数体）。
// 若不区分：lower_unit 的包裹还原会切到 g_func，使上述持久结构随 emit 首次 reset 被覆盖 → 段错误。
pub var g_mir: TIRModule;                // 录制得到的 pre-TIR 线性 MIR（与 g_mod 平行，仅函数体由 tir_emit 录制）
pub var g_mir_cur: TIRFunc;             // 当前函数的 MIR 录制缓冲

// mir 录制开关的跨模块访问器：驱动层（tc.tc）经此开关录制，
// 避免依赖跨模块直接写 pub var（各降级路径对跨模块全局写入的支持不一致）。
pub fn tir_set_recording_mir(v: bool) void { g_recording_mir = v; }
pub fn tir_recording_mir() bool { return g_recording_mir; }

pub var g_tmpc: i64;             // 临时 slot 计数（$tN）
pub var g_lblc: i64;             // 基本块标签计数（@LN）
pub var g_slotc: i64;            // 具名局部 slot 唯一化计数

pub var g_local_names: []string; // 与下面两个并行：局部名 → slot / ST
pub var g_local_slots: []string;
pub var g_local_sts: []string;
pub var g_local_tds: []i64;      // emit 期唯一可靠的局部类型来源（符号表在 emit 期无效）
pub var g_local_depths: []i64;   // 与上面并行：该局部声明处的块嵌套深度（0 = 函数体）
pub var g_blk_depth: i64;        // 当前块嵌套深度。TIR 把全函数局部铺平，必须显式管理块作用域：
                                 // C 后端靠 C 自身 {} 块作用域天然正确；TIR 若不做深度过滤，
                                 // if/while 块内声明的同名局部会在块结束后继续遮蔽外层，
                                 // 静默取到零初始化的内层槽（自举误编译根因之一）。

// (FS-2b) g_tir_last_st 侧信道已移除：各值发射器返回 TirEmitRes{name, st} 显式携带真实发射类型。

// 循环标签栈（break/continue 目标；支持嵌套循环）
pub var g_loop_head: []string;   // 栈顶 = 最内层循环头（continue 目标）
pub var g_loop_end: []string;    // 栈顶 = 最内层循环尾（break 目标）
pub var g_idx_elem_st: string = "i64";  // tir_emit_index_addr 写回的元素 ST（read/write 共用）
pub var g_idx_is_value: bool = false;    // true: 下标返回「值」(str_at → i64 字节，read 不 load)；false: 返回「地址」(slice_at → ptr)
pub var g_tir_defer: []i64;          // 延迟语句节点栈（defer → LIFO，遇 return/函数尾排空）
pub var g_tir_func_names: []string;   // 模块内函数名 → FuncDecl 节点（call 实参定长数组降级用）
pub var g_tir_func_decls: []i64;
pub var g_cur_ret_td: i64 = -1;       // 当前函数返回类型 TD（return 字面量定长数组降级用）
// 调用方已知的目标类型 ST 码（由 return/var_decl/assignment 等上下文注入）。tir_emit_expr
// 取 est 时优先用它，解决「运行期 scrutinee 的 match 无法从 sema 反推结果类型（meta_eval_match
// 直接 -1）导致返回 string/struct 的 match 的 __mres 槽宽度不足（as-模式 v @ range => str 等）」。
// 仅作用于顶层表达式一次：读取后立即清零，避免污染子表达式的真实类型。
pub var g_expect_st: i64 = ST_NONE;

// O-7：隐式提升的递归抑制（见 tir_emit_expr 的提升分支）。
pub var g_optlift_busy: []i64;

pub fn tir_optlift_busy_has(e: i64) bool {
    var i: i64 = 0;
    var n: i64 = slice_len(g_optlift_busy) as i64;
    while (i < n) {
        if (g_optlift_busy[i] == e) { return true; }
        i = i + 1;
    }
    return false;
}

pub fn tir_optlift_busy_del(e: i64) void {
    var i: i64 = 0;
    var n: i64 = slice_len(g_optlift_busy) as i64;
    while (i < n) {
        if (g_optlift_busy[i] == e) {
            slice_set(g_optlift_busy, i, -1);
            return;
        }
        i = i + 1;
    }
}
// 当前 match 的 scrutinee 表达式节点（S6 切片模式取元素 scr[i] 时用，
// 避免把临时量名字反查回节点）。tir_emit_match 进入时设置，退出时不清零（单帧内有效）。
pub var g_match_scrut: i64 = -1;

// ── 模块级全局变量（Stage 4 降级目标，解锁 func_type/lambda/map 全局等示例）──
pub var g_globals_section: StringBuilder;   // 缓冲 `globals:` 段文本（@name ST 每行）
// 阶段 C 多进程自举：被跳过的「链接库模块全局」登记表（同格式文本 `  @name ST`）。
// 这些全局的定义由链接期 .tlib 归档提供，本模块只须声明 external；此前完全不登记，
// 只有「经 ll_load/ll_store 惰性登记」的引用点位能拿到 external 声明，
// 而内建直发路径（append / slice_set 等直接以内联文本取全局地址）不经过登记
// ⇒ clang: use of undefined value '@base__g_trivia_toks'。故在此统一登记。
pub var g_link_globals_section: StringBuilder;
pub var g_global_names: []string;            // 顶层全局变量名（与下行并行）
pub var g_global_fnval: []bool;              // 是否函数值（%TClosure）全局
pub var g_global_map: []bool;                // 是否 map 全局（需 ginit 运行期建表）
pub var g_global_td: []i64;                  // 各全局的类型描述符（map/标量 init 用）
pub var g_global_vdecl: []i64;               // 各全局的 var_decl 节点索引（取 init 用）
pub var g_global_fnref: []string;            // fn 值全局：函数符号文本（"@add" / "@__lam_N"）

// ══════════════════════════════════════════════════════════════════
// 基础工具
// ══════════════════════════════════════════════════════════════════

pub fn tir_reset() void {
    var zt: []TIRType = [];
    var zs: []string = [];
    var zf: []TIRFunc = [];
    var zg: []TIRGlobal = [];
    g_mod = TIRModule{ mod: "", source: "", types: zt, strings: zs, funcs: zf, globals: zg };
    var zp: []string = [];
    var zb: []TIRInst = [];
    g_cur_func = TIRFunc{ name: "", params: zp, ret_st: "void", body: zb, is_extern: false, is_kernel: false, is_main: false };
    g_tmpc = 0;
    g_lblc = 0;
    g_slotc = 0;
    var zln: []string = [];
    g_local_names = zln;
    var zls: []string = [];
    g_local_slots = zls;
    var zlt: []string = [];
    g_local_sts = zlt;
    var zld: []i64 = [];
    g_local_tds = zld;
    var zldp: []i64 = [];
    g_local_depths = zldp;
    g_blk_depth = 0;
    var zlh: []string = [];
    g_loop_head = zlh;
    var zle: []string = [];
    g_loop_end = zle;
    var zde: []i64 = [];
    g_tir_defer = zde;
    var zvk: []string = [];
    g_vf_keys = zvk;
    var zvn: [][]i64 = [];
    g_vf_nodes = zvn;
    var zvt: [][]i64 = [];
    g_vf_tds = zvt;
    g_globals_section = sb_new();
    g_link_globals_section = sb_new();
    g_global_names = [];
    g_global_fnval = [];
    g_global_map = [];
    g_global_td = [];
    g_global_vdecl = [];
    g_global_fnref = [];
}

pub fn tir_tmp() string {
    var v: i64 = g_tmpc;
    g_tmpc = v + 1;
    return base.sb_cat2("$t", base.i2s(v));
}

pub fn tir_lbl(p: string) string {
    var v: i64 = g_lblc;
    g_lblc = v + 1;
    return base.sb_cat2("@L", base.sb_cat2(p, base.i2s(v)));
}


// tokens 列表 → 单空格连接（tir_to_text 单向调试序列化的逆 tokenize）
pub fn tir_join_toks(tk: []string) string {
    var sb: StringBuilder = sb_new();
    var i: i64 = 0;
    var n: i64 = slice_len(tk) as i64;
    while (i < n) {
        if (i > 0) { sb_append_str(sb, " "); }
        sb_append_str(sb, tk[i]);
        i = i + 1;
    }
    return sb_to_str(sb);
}

// 结构化指令 → 可读文本行（仅调试/快照；非层间接口）。
pub fn tir_inst_to_text(inst: TIRInst) string {
    var sb: StringBuilder = sb_new();
    // ⚠ 与消费者 ll_emit_inst 一致：先把结构体字段 inst.op 取到局部 opcode，再调用 tir_op_to_str；
    // 直接把 inst.op（i64 结构体字段）作函数实参会被种子 codegen 误当 i64 传参，导致返回 string 被错编。
    var opcode: i64 = inst.op;
    var opstr: string = tir_op_to_str(opcode);
    sb_append_str(sb, opstr);
    var ststr: string = tir_st_to_str(inst.st);
    if (str_len(ststr) > 0) { sb_append_str(sb, " "); sb_append_str(sb, ststr); }
    if (str_len(inst.dst.name) > 0) { sb_append_str(sb, " "); sb_append_str(sb, tir_os(inst.dst.name, inst.dst.st)); }
    var ai: i64 = 0;
    var an: i64 = slice_len(inst.args) as i64;
    while (ai < an) { sb_append_str(sb, " "); sb_append_str(sb, tir_os(inst.args[ai].name, inst.args[ai].st)); ai = ai + 1; }
    return sb_to_str(sb);
}


pub fn tir_cmt(text: string) void {
    if (g_term) { return; }
        var __cmt_args: []TirOperand = [];
    append(g_cur_func.body, TIRInst{ op: TIR_OP_COMMENT, st: ST_NONE, dst: TirOperand{ name: "", st: 0 }, args: __cmt_args, is_comment: true, line: g_cur_line, cmt: text });
}

pub fn tir_block(label: string) void {
    g_term = false;   // 进入新块：重置终止状态
    tir_emit(TIRInst{ op: TIR_OP_BLOCK, st: ST_NONE, dst: tir_op(label), args: tir_a0(), is_comment: false, line: g_cur_line, cmt: "" });
}

// ══════════════════════════════════════════════════════════════════
// FS-4：直接结构化发射（删文本 round-trip）
// 每个 tir_emit_<op> 返回 TIRInst（顶层返回→切片堆提升，发射期可安全随机访问），
// 由 tir_emit 统一 append + g_term。语义严格复刻 tir_parse_inst 各分支
// （同 op / st / dst / args 位置与内容），保证 func.body 与旧轨逐字节等价。
// 操作数 st 在 FS-4 阶段恒为 0（翻译器仍走 ll_get_st 影子表，见 FS-4 阶段②），
// 故此处统一用 tir_op(name)（st=0），不携带 .s 后缀。
// ══════════════════════════════════════════════════════════════════
pub fn tir_emit(inst: TIRInst) void {
    if (getenv("T_TIR_TRACE") == "1") { eprint(base.sb_cat3("[TIR] ", tir_op_to_str(inst.op), base.sb_cat3(" dst=", inst.dst.name, "\n"))); }
    if (g_term) { return; }   // 终止符之后当前块不再发射（避免 ret 后出现死指令）
    append(g_cur_func.body, inst);
    if (g_recording_mir) { append(g_mir_cur.body, inst); }
    // 终止符（ret / br / br_cond）之后当前块终止
    if (inst.op == TIR_OP_BR or inst.op == TIR_OP_BR_COND or inst.op == TIR_OP_RET or inst.op == TIR_OP_RET_VOID) { g_term = true; }
}

// ── T0：TIR 发射期校验器（TIR-VERIFY）─────────────────────────────────
// 动机：后端静默错编（结构体槽位错位 / 空操作数 / 未登记具名类型）在「发射那一刻」
// 是完全可见的，却要等到运行时 arena OOM 或 exit 127 才以无位置信号浮现。
// 本校验器在「TIR 发射完成后、翻译为 LLVM 之前」做低成本结构自检，把静默错编
// 变成带函数名与行号的显式错误。
// 开关：环境变量 T_TIR_VERIFY=1（仅报告）|=fail（有错即 exit 3）。未设置 → 零开销。

pub var g_tir_verify_on: bool = false;
pub var g_tir_verify_errs: i64 = 0;

pub fn tir_verify_init() void {
    var v: string = getenv("T_TIR_VERIFY");
    if (str_len(v) > 0) { g_tir_verify_on = true; }
    g_tir_verify_errs = 0;
}

pub fn tir_verify_report(code: string, msg: string) void {
    if (g_tir_verify_on == false) { return; }
    g_tir_verify_errs = g_tir_verify_errs + 1;
    eprint(base.sb_cat4("TIR-VERIFY ", code, ": ", base.sb_cat2(msg, "\n")));
}

// sname（不含 % ）是否为已声明结构体；返回声明字段数，-1 = sema 未登记。
pub fn tir_verify_field_count(sname: string) i64 {
    var fh: i64 = sema.find_struct_fields(sname);
    if (fh < 0) { return -1; }
    var c: i64 = 0;
    var cur: i64 = fh;
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
    var cur_ks: []i64 = base.kids_chain(cur);
    var cur_ki: i64 = 0;
    while (cur_ki < slice_len(cur_ks) as i64) {
        c = c + 1;
        cur_ki = cur_ki + 1;
    }
    return c;
}

pub fn tir_verify_has_field(fh: i64, fname: string) bool {
    var c: i64 = fh;
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
    var c_ks: []i64 = base.kids_chain(c);
    var c_ki: i64 = 0;
    while (c_ki < slice_len(c_ks) as i64) {
        var c_kv: i64 = c_ks[c_ki];
        if (base.node_sa((c_kv as u64)) == fname) { return true; }
        c_ki = c_ki + 1;
    }
    return false;
}

// tname（含 % ）是否已登记于 g_mod.types（内建 %TStr/%TSlice/%TClosure 等在此）。
pub fn tir_verify_in_types(tname: string) bool {
    var i: i64 = 0;
    var n: i64 = slice_len(g_mod.types) as i64;
    while (i < n) {
        var ty: TIRType = g_mod.types[i];
        if (ty.name == tname) { return true; }
        i = i + 1;
    }
    return false;
}

pub fn tir_verify_inst(fname: string, inst: TIRInst) void {
    if (g_tir_verify_on == false) { return; }
    if (inst.is_comment) { return; }
    var na: i64 = slice_len(inst.args) as i64;
    var tn: string = tir_st_to_str(inst.st);
    // V001/V002：具名结构体构造的槽位契约（后端按 "i32 <arg_index>" 落槽）
    if (inst.op == TIR_OP_STRUCT_NEW) {
        if (str_len(tn) > 1) {
            if (tn[0] == 37) {
                var sname: string = str_slice(tn, 1, str_len(tn) as i64);
                var fc: i64 = tir_verify_field_count(sname);
                if (fc < 0) {
                    if (tir_verify_in_types(tn) == false) {
                        tir_verify_report("V002", base.sb_cat3(base.sb_cat2(fname, ": "), "未知具名类型 ", tn));
                    }
                } else {
                    if (na > fc) {
                        tir_verify_report("V001", base.sb_cat3(base.sb_cat4(fname, ": ", tn, " 实参 "), base.i2s(na), base.sb_cat2(" > 声明字段 ", base.i2s(fc))));
                    }
                    // V006（已撤防）：部分初始化 na < fc。
                    // 历史上 phase-1 后端把书写序实参直接落槽，na < fc 会让缺失字段后的
                    // 字段错位 → arena OOM。但当前 TIR 发射器 tir_emit_struct_lit 已按
                    // 声明序归位、缺失字段留 zeroinitializer（tir.tc:3667-3683），故
                    // 「先给若干字段、剩余随后逐字段赋值」是合法写法
                    // （examples/fmt_json_a1a.tc 的 Shape 即如此），不应判错。
                    // 过参情形仍由上方 V001 (na > fc) 拦截。
                    var c5: i64 = sema.find_struct_fields(sname);
                    var i5: i64 = 0;
                    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
                    var c5_ks: []i64 = base.kids_chain(c5);
                    var c5_ki: i64 = 0;
                    while (c5_ki < slice_len(c5_ks) as i64) {
                        var c5_kv: i64 = c5_ks[c5_ki];
                        if (i5 < na) {
                            var fst5: string = tir_st_of_td(sema.resolve_type_desc(base.node_na((c5_kv as u64))));
                            var ast5: string = tir_st_to_str(inst.args[i5].st);
                            if (str_len(fst5) > 1) {
                                if (str_len(ast5) > 1) {
                                    if (fst5[0] == 37) {
                                        if (ast5[0] == 37) {
                                            if (fst5 != ast5) {
                                                tir_verify_report("V005", base.sb_cat4(fname, ": ", tn, base.sb_cat4(" 字段#", base.i2s(i5 + 1), " 期望 ", base.sb_cat3(fst5, " 实参 ", ast5))));
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        i5 = i5 + 1;
                        c5_ki = c5_ki + 1;
                    }
                }
            }
        }
    }
    // V003：空操作数 → 直接产出非法 IR
    var k: i64 = 0;
    while (k < na) {
        var a: TirOperand = inst.args[k];
        if (str_len(a.name) == 0) {
            tir_verify_report("V003", base.sb_cat3(base.sb_cat2(fname, ": 空操作数 arg#"), base.i2s(k), base.sb_cat3(" (line ", base.i2s(inst.line as i64), ")")));
        }
        k = k + 1;
    }
}

pub fn tir_verify_module() i64 {
    if (g_tir_verify_on == false) { return 0; }
    var fi: i64 = 0;
    var nf: i64 = slice_len(g_mod.funcs) as i64;
    while (fi < nf) {
        var f: TIRFunc = g_mod.funcs[fi];
        var bi: i64 = 0;
        var nb: i64 = slice_len(f.body) as i64;
        while (bi < nb) {
            tir_verify_inst(f.name, f.body[bi]);
            bi = bi + 1;
        }
        fi = fi + 1;
    }
    eprint(base.sb_cat3("TIR-VERIFY: ", base.i2s(g_tir_verify_errs), " error(s)\n"));
    if (g_tir_verify_errs > 0) {
        if (getenv("T_TIR_VERIFY") == "fail") { exit(3); }
    }
    return g_tir_verify_errs;
}

pub fn tir_emit_ret_void() TIRInst {
    var __a: []TirOperand = [];
    return TIRInst{ op: TIR_OP_RET_VOID, st: ST_NONE, dst: tir_op(""), args: __a, is_comment: false, line: g_cur_line, cmt: "" };
}
