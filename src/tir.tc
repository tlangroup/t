}

// ⚠ DEBUG（#36 隔离 t_slice_at -1 panic 用，完成后删除）
pub fn dbg_neg(ctx: string) void {
    file_write_all("out/dbg/dbg_neg.txt", base.sb_cat5(ctx, " | fn=", g_cur_func.name, " | line=", base.i2s(g_cur_line)));
}
pub fn tir_emit_slot(st: string, dst: string) TIRInst {
    // ⚠ 飞地规避：槽名同时放进 args[0]（译器 TIR_OP_SLOT 从 inst.args[0].name 读取，
    // 避开巨型模块 tir_to_ll.tc 的 SLOT 分支把 inst.dst.name 错编成 "main"）。
    return TIRInst{ op: TIR_OP_SLOT, st: tir_st_from_str(st), dst: tir_op(dst), args: tir_a1(dst), is_comment: false, line: g_cur_line, cmt: dst };
}
