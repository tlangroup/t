// ══════════════════════════════════════════════════════════════════
// src/tir.tc — TIR 后端桥（compiler-pipeline-design.md §4.4 / tir-design.md）
//
// 职责：在 sema(+单态化+CTFE) 之后、codegen_c/codegen_ll 之前，把已擦除类型的
// 编译单元降级为「类型擦除·文件级·线性」的 TIR（memory-first）。本模块是新增的
// 加性层：旧 C/LLVM 后端完全不动，本模块只被 `tc emit-tir` 命令消费。
//
// 本文件实现：
//   - TIR 内存结构（TIRModule / TIRType / TIRInst / TIRFunc）
//   - 文本序列化 tir.to_text()（tir-design.md §4 规范真相源）
//   - TD → ST 映射 tir.st_of_td()（tir-design.md §5/§7，三处偏离 LLVM）
//   - lower_unit() 降级 pass（Stage 0 + Stage 1 + Stage 2 子集）
//
// 内存表示取「扁平 TIRInst 数组」范式（tir-design.md §4.1），与 base.nodes 同构；
// 每条指令以完整文本行存储（序列化即按行展开），Stage 4b 二进制格式在其上叠加。
// ══════════════════════════════════════════════════════════════════

@import("src.base" :: *);
@import("src.sema" :: *);
@import("src.lex" :: *);

// ── 内存结构 ───────────────────────────────────────────────────
pub struct TIRType {
    name: string;   // %Name（TT 条目引用）
    body: string;   // 字段 ST 列表文本，如 "f0: i64, f1: i64"
}

pub struct TIRInst {
    text: string;       // 完整指令文本（不含前导缩进）
    is_comment: bool;   // true → 作为注释行（不支持构造的兜底）
    line: u64;          // 源锚点行（诊断用）
}

pub struct TIRFunc {
    name: string;        // @name（不含 @）
    params: []string;    // "$p: ST" 文本列表
    ret_st: string;      // 返回存储类型
    body: []TIRInst;     // 线性指令数组
    is_extern: bool;
    is_kernel: bool;
}

pub struct TIRModule {
    mod: string;         // 来源模块名（去 .tc）
    source: string;      // 源文件路径
    types: []TIRType;    // TT 类型表
    strings: []string;   // 字符串表
    funcs: []TIRFunc;    // 函数 + extern 声明
}

// ── 模块级状态 ─────────────────────────────────────────────────
pub var g_mod: TIRModule;
pub var g_cur_func: TIRFunc;
pub var g_cur_line: u64;
pub var g_term: bool = false;       // 当前基本块是否已终止（ret/br 之后不再发射指令）

pub var g_tmpc: i64;             // 临时 slot 计数（$tN）
pub var g_lblc: i64;             // 基本块标签计数（@LN）
pub var g_slotc: i64;            // 具名局部 slot 唯一化计数

pub var g_local_names: []string; // 与下面两个并行：局部名 → slot / ST
pub var g_local_slots: []string;
pub var g_local_sts: []string;
pub var g_local_tds: []i64;      // emit 期唯一可靠的局部类型来源（符号表在 emit 期无效）

// 循环标签栈（break/continue 目标；支持嵌套循环）
pub var g_loop_head: []string;   // 栈顶 = 最内层循环头（continue 目标）
pub var g_loop_end: []string;    // 栈顶 = 最内层循环尾（break 目标）
pub var g_idx_elem_st: string = "i64";  // tir_emit_index_addr 写回的元素 ST（read/write 共用）
pub var g_tir_defer: []i64;          // 延迟语句节点栈（defer → LIFO，遇 return/函数尾排空）
pub var g_tir_func_names: []string;   // 模块内函数名 → FuncDecl 节点（call 实参定长数组降级用）
pub var g_tir_func_decls: []i64;
pub var g_cur_ret_td: i64 = -1;       // 当前函数返回类型 TD（return 字面量定长数组降级用）

// ══════════════════════════════════════════════════════════════════
// 基础工具
// ══════════════════════════════════════════════════════════════════

pub fn tir_reset() void {
    var zt: []TIRType = [];
    var zs: []string = [];
    var zf: []TIRFunc = [];
    g_mod = TIRModule{ mod: "", source: "", types: zt, strings: zs, funcs: zf };
    var zp: []string = [];
    var zb: []TIRInst = [];
    g_cur_func = TIRFunc{ name: "", params: zp, ret_st: "void", body: zb, is_extern: false, is_kernel: false };
    g_tmpc = 0;
    g_lblc = 0;
    g_slotc = 0;
    var zln: []string = [];
    g_local_names = zln;
    var zls: []string = [];
    g_local_slots = zls;
    var zlt: []string = [];
    g_local_sts = zlt;
    var zld: []i64 = [];
    g_local_tds = zld;
    var zlh: []string = [];
    g_loop_head = zlh;
    var zle: []string = [];
    g_loop_end = zle;
    var zde: []i64 = [];
    g_tir_defer = zde;
}

pub fn tir_tmp() string {
    var v: i64 = g_tmpc;
    g_tmpc = v + 1;
    return base.sb_cat2("$t", base.i2s(v));
}

pub fn tir_lbl(p: string) string {
    var v: i64 = g_lblc;
    g_lblc = v + 1;
    return base.sb_cat2("@L", base.sb_cat2(p, base.i2s(v)));
}

pub fn tir_line(text: string) void {
    if (g_term) { return; }   // 终止符之后当前块不再发射（避免 ret 后出现死指令）
    append(g_cur_func.body, TIRInst{ text: text, is_comment: false, line: g_cur_line });
    // 终止符（ret / br / br_cond）之后当前块终止
    if (str_len(text) >= 2 && str_slice(text, 0, 2) == "br") { g_term = true; }
    else if (str_len(text) >= 3 && str_slice(text, 0, 3) == "ret") { g_term = true; }
}

pub fn tir_cmt(text: string) void {
    if (g_term) { return; }
    append(g_cur_func.body, TIRInst{ text: text, is_comment: true, line: g_cur_line });
}

pub fn tir_block(label: string) void {
    g_term = false;   // 进入新块：重置终止状态
    tir_line(base.sb_cat2("block ", label));
}

// ── 循环标签栈（break/continue）──────────────────────────────────
pub fn tir_loop_push(head: string, end: string) void {
    append(g_loop_head, head);
    append(g_loop_end, end);
}
pub fn tir_loop_pop() void {
    var n: i64 = slice_len(g_loop_head) as i64;
    if (n <= 0) { return; }
    var nh: []string = [];
    var i: i64 = 0;
    while (i < n - 1) { append(nh, g_loop_head[i]); i = i + 1; }
    g_loop_head = nh;
    var ne: []string = [];
    var j: i64 = 0;
    while (j < n - 1) { append(ne, g_loop_end[j]); j = j + 1; }
    g_loop_end = ne;
}
pub fn tir_loop_top_head() string {
    var n: i64 = slice_len(g_loop_head) as i64;
    if (n > 0) { return g_loop_head[n - 1]; }
    return "";
}
pub fn tir_loop_top_end() string {
    var n: i64 = slice_len(g_loop_end) as i64;
    if (n > 0) { return g_loop_end[n - 1]; }
    return "";
}

// 小写标量类型名 → 带符号性的 ST（tir-design.md §5.1 偏离 1）
pub fn tir_scalar_st(name: string) string {
    if (name == "i8") { return "i8"; }
    if (name == "u8") { return "u8"; }
    if (name == "i16") { return "i16"; }
    if (name == "u16") { return "u16"; }
    if (name == "i32") { return "i32"; }
    if (name == "u32") { return "u32"; }
    if (name == "i64") { return "i64"; }
    if (name == "u64") { return "u64"; }
    if (name == "f32") { return "f32"; }
    if (name == "f64") { return "f64"; }
    if (name == "bool") { return "i8"; }     // 存储型 i8（tir-design.md §5.2）
    if (name == "atom" || name == "fid") { return "u64"; }
    if (name == "char") { return "i8"; }
    return "i64";
}

// TD → ST 映射（tir-design.md §7，对齐 ll_td 但输出 TIR 记号）
pub fn tir_st_of_td(td: i64) string {
    if (td < 0) { return "i64"; }
    var t: TD = sema.tds[td];
    if (t.cat == "string" || t.cat == "bytes") { return "%TStr"; }
    if (t.cat == "pointer") {
        if (t.memspace > 0) { return "i64"; }   // 设备指针句柄（不透明 i64）
        return base.sb_cat2("ptr<", tir_st_of_td(t.elem));
    }
    if (t.cat == "slice") { return "%TSlice"; }
    if (t.cat == "array") {
        var an: i64 = t.alen;
        if (an < 0) { an = 0; }
        return base.sb_cat5("arr<", tir_st_of_td(t.elem), " x ", base.i2s(an), ">");
    }
    if (t.cat == "vector") {
        var vln: i64 = t.alen;
        if (vln < 1) { vln = 1; }
        return base.sb_cat5("vec<", tir_st_of_td(t.elem), " x ", base.i2s(vln), ">");
    }
    if (t.cat == "map") { return "ptr<void>"; }
    if (t.cat == "optional") { return base.sb_cat2("ptr<", tir_st_of_td(t.elem)); }  // Stage 1 opt.boxed
    if (t.cat == "sym") {
        if (t.alen == 16) { return "u16"; }
        return "u32";
    }
    if (t.cat == "typeinfo" || t.cat == "fieldinfo") { return "ptr<void>"; }
    if (t.cat == "func") { return "ptr<void>"; }
    if (t.cat == "void") { return "void"; }
    if (t.cat == "scalar") {
        if (t.name == "") { return "i64"; }
        return tir_scalar_st(t.name);
    }
    if (t.cat == "named") {
        if (t.name == "") { return "ptr<void>"; }
        return base.sb_cat2("%", t.name);    // 具名聚合 → %Name（偏离 3）
    }
    return "i64";
}

pub fn tir_strip_pct(s: string) string {
    if (str_len(s) > 0 && s[0] == 37) { return str_slice(s, 1, str_len(s)); }
    return s;
}

// 表达式 → TD（emit 期可靠）：
//  - ident 局部/形参：直接取本模块维护的 g_local_tds（符号表在 emit 期无效，不可 sym_lookup）
//  - 其它（member/index/call/cast/struct_lit/...）：用 sema.meta_type_of_expr 推断
//  - 字面量不进 meta_type_of_expr（其 u8 推断会把 const.i64 改成 const.u8，破坏 Stage 0+1 基线）
pub fn tir_expr_td(e: i64) i64 {
    if (e < 0) { return -1; }
    var n: Node = base.nodes[e];
    if (n.kind == "ident") {
        var idx: i64 = tir_find_local_idx(n.sa);
        if (idx >= 0) { return g_local_tds[idx]; }
    }
    var tnode: i64 = sema.meta_type_of_expr(e);
    if (tnode >= 0) { return sema.resolve_type_desc(tnode); }
    return -1;
}

pub fn tir_expr_st(e: i64) string {
    if (e < 0) { return "i64"; }
    var n: Node = base.nodes[e];
    var kd: string = n.kind;
    // 局部/形参：emit 期唯一可靠来源
    if (kd == "ident") {
        var idx: i64 = tir_find_local_idx(n.sa);
        if (idx >= 0) { return g_local_sts[idx]; }
    }
    // 字面量保持旧行为（避免 meta_type_of_expr 的 u8 推断改变 const 宽度，破坏基线）
    if (kd == "float") { return "f64"; }   // 浮点字面量固定 f64：st_of_td 对字面节点返回 -1 → i64（错编）
    if (kd == "int" || kd == "bool" || kd == "char" ||
        kd == "null" || kd == "opt_none" || kd == "string") {
        return tir_st_of_td(sema.resolve_type_desc(e));
    }
    // 其它表达式：用 meta_type_of_expr 推断
    var td: i64 = tir_expr_td(e);
    if (td >= 0) { return tir_st_of_td(td); }
    return "i64";
}

// 索引元素存储型：slice/array/vector → 元素 ST；string/bytes → i8；其余退化为 i64
pub fn tir_elem_st(td: i64) string {
    if (td < 0) { return "i64"; }
    var t: TD = sema.tds[td];
    if (t.cat == "string" || t.cat == "bytes") { return "i8"; }
    if (t.cat == "slice") { return tir_st_of_td(t.elem); }
    if (t.cat == "array") { return tir_st_of_td(t.elem); }
    if (t.cat == "vector") { return tir_st_of_td(t.elem); }
    if (t.cat == "map") { return tir_st_of_td(t.val); }
    return "i64";
}

// ══════════════════════════════════════════════════════════════════
// 局部符号表
// ══════════════════════════════════════════════════════════════════

pub fn tir_find_local_idx(name: string) i64 {
    var n: i64 = slice_len(g_local_names) as i64;
    var i: i64 = n - 1;
    while (i >= 0) {
        if (g_local_names[i] == name) { return i; }
        i = i - 1;
    }
    return -1;
}

// 判定 name 是否为模块内某个函数（含泛型/库函数）的名字。
// 用于函数值作为闭包值（ptr<void>）包裹成 %TClosure 的判定。
pub fn tir_is_func_name(name: string) bool {
    var m: i64 = slice_len(g_tir_func_names) as i64;
    var i: i64 = 0;
    while (i < m) {
        if (g_tir_func_names[i] == name) { return true; }
        i = i + 1;
    }
    return false;
}

// 查被调函数第 argidx 个形参的类型 TD。
// call 实参为 array_lit 时，按形参是否定长数组决定降级为 arr<elem x N> 还是 %TSlice。
pub fn tir_callee_param_td(cname: string, argidx: i64) i64 {
    var m: i64 = slice_len(g_tir_func_names) as i64;
    var i: i64 = 0;
    while (i < m) {
        if (g_tir_func_names[i] == cname) {
            var fd: i64 = g_tir_func_decls[i];
            var fnd: Node = base.nodes[fd];
            var c: i64 = fnd.lb;
            var j: i64 = 0;
            while (c >= 0) {
                if (j == argidx) {
                    var p: Node = base.nodes[base.kids[c].val];
                    return sema.resolve_type_desc(p.na);
                }
                j = j + 1;
                c = base.kids[c].next;
            }
            return -1;
        }
        i = i + 1;
    }
    return -1;
}

pub fn tir_new_named_slot(td: i64, st: string, name: string) string {
    var slot: string = base.sb_cat2("$", name);
    var idx: i64 = tir_find_local_idx(name);
    if (idx >= 0) {
        // 同作用域重名（shadowing）：唯一化 slot 名，避免文本歧义
        slot = base.sb_cat4("$", name, "__", base.i2s(g_slotc));
        g_slotc = g_slotc + 1;
    }
    append(g_local_names, name);
    append(g_local_slots, slot);
    append(g_local_sts, st);
    append(g_local_tds, td);
    tir_line(base.sb_cat4("slot ", st, " ", slot));
    return slot;
}

// ══════════════════════════════════════════════════════════════════
// TT 类型表构建
// ══════════════════════════════════════════════════════════════════

pub fn tir_add_std_types() void {
    append(g_mod.types, TIRType{ name: "%TStr", body: "f0: ptr<i8>, f1: i64" });
    append(g_mod.types, TIRType{ name: "%TSlice", body: "f0: ptr<void>, f1: i64, f2: i64, f3: i64" });
    append(g_mod.types, TIRType{ name: "%TClosure", body: "f0: ptr<void>, f1: ptr<void>" });
}

// 字段 ST：尽力从字段类型节点解析（非标量退化为 i64；TT 可读性为主，顺序才关键）
pub fn tir_field_st(structname: string, fieldname: string) string {
    var fh: i64 = sema.find_struct_fields(structname);
    if (fh < 0) { return "i64"; }
    var c: i64 = fh;
    while (c >= 0) {
        var k: Child = base.kids[c];
        var f: Node = base.nodes[k.val];
        if (f.sa == fieldname) {
            if (f.na >= 0) {
                var ft: i64 = sema.resolve_type_desc(f.na);
                if (ft >= 0) { return tir_st_of_td(ft); }
            }
            return "i64";
        }
        c = k.next;
    }
    return "i64";
}

pub fn tir_field_index(structname: string, fieldname: string) i64 {
    var fh: i64 = sema.find_struct_fields(structname);
    if (fh < 0) { return 0; }
    var c: i64 = fh;
    var idx: i64 = 0;
    while (c >= 0) {
        var k: Child = base.kids[c];
        var f: Node = base.nodes[k.val];
        if (f.sa == fieldname) { return idx; }
        idx = idx + 1;
        c = k.next;
    }
    return 0;
}

// 在栈上构造一个 %TClosure 值（与 TClosure ABI 一致），返回 ptr<void> 槽。
// fnref：函数指针值文本（如 "@__lam_0" 或 "$fnptr"）；envref：环境指针值文本，"" 表示 null 环境。
// 设计锚点：tir-design.md §6.6 closure_new / §6.7 call_ind / %TClosure={fnptr,envptr}。
pub fn tir_make_closure_value(fnref: string, envref: string) string {
    var clo: string = tir_tmp();
    tir_line(base.sb_cat2("slot %TClosure ", clo));
    var cloaddr: string = tir_tmp();
    tir_line(base.sb_cat4("addr_of ptr<%TClosure> ", cloaddr, " ", clo));
    var fpaddr: string = tir_tmp();
    tir_line(base.sb_cat5("gep ptr<void> ", fpaddr, " ", cloaddr, " 0 0"));
    tir_line(base.sb_cat4("store ", fnref, " ", fpaddr));
    var epaddr: string = tir_tmp();
    tir_line(base.sb_cat5("gep ptr<void> ", epaddr, " ", cloaddr, " 0 1"));
    if (str_len(envref) == 0) {
        var nul: string = tir_tmp();
        tir_line(base.sb_cat2("const.ptr.null ptr<void> ", nul));
        tir_line(base.sb_cat4("store ", nul, " ", epaddr));
    } else {
        tir_line(base.sb_cat4("store ", envref, " ", epaddr));
    }
    var dst: string = tir_tmp();
    tir_line(base.sb_cat6("bitcast ptr<void> ", dst, " ", "ptr<%TClosure>", " ", cloaddr));
    return dst;
}

pub fn tir_add_struct_tt(name: string, field_head: i64) void {
    var sb: StringBuilder = sb_new();
    var c: i64 = field_head;
    var first: bool = true;
    while (c >= 0) {
        var k: Child = base.kids[c];
        var f: Node = base.nodes[k.val];
        var fst: string = "i64";
        if (f.na >= 0) {
            var ft: i64 = sema.resolve_type_desc(f.na);
            if (ft >= 0) { fst = tir_st_of_td(ft); }
        }
        if (first == false) { sb_append_str(sb, ", "); }
        sb_append_str(sb, base.sb_cat2(f.sa, ": "));
        sb_append_str(sb, fst);
        first = false;
        c = k.next;
    }
    append(g_mod.types, TIRType{ name: base.sb_cat2("%", name), body: sb_to_str(sb) });
}

pub fn tir_add_variant_tt(name: string) void {
    // variant 擦除为 { i8 tag, <data...> }；Stage 1 仅登记 %Name 占位（data 布局后续补全）
    append(g_mod.types, TIRType{ name: base.sb_cat2("%", name), body: "f0: i8" });
}

pub fn tir_add_union_tt(name: string) void {
    // union 擦除为 { i8 tag, <max-member ST> }；Stage 1 仅登记 %Name 占位
    append(g_mod.types, TIRType{ name: base.sb_cat2("%", name), body: "f0: i8" });
}

// ══════════════════════════════════════════════════════════════════
// 顶层降级入口
// ══════════════════════════════════════════════════════════════════

pub fn lower_unit(mod: string, source: string) void {
    tir_reset();
    g_mod.mod = mod;
    g_mod.source = source;
    tir_add_std_types();

    var n: i64 = slice_len(lex.decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = lex.decl_list[i];
        var dn: Node = base.nodes[d];
        if (dn.kind == "StructDecl") { tir_add_struct_tt(dn.sa, dn.lb); }
        else if (dn.kind == "VariantDecl") { tir_add_variant_tt(dn.sa); }
        else if (dn.kind == "UnionDecl") { tir_add_union_tt(dn.sa); }
        i = i + 1;
    }

    // 预收集全部函数名（含泛型/库函数），供函数值闭包包装判定（tir_is_func_name）使用，
    // 不依赖函数体降级顺序。
    var j0: i64 = 0;
    while (j0 < n) {
        var d0: i64 = lex.decl_list[j0];
        var dn0: Node = base.nodes[d0];
        if (dn0.kind == "FuncDecl") {
            append(g_tir_func_names, dn0.sa);
            append(g_tir_func_decls, d0);
        }
        j0 = j0 + 1;
    }

    var j: i64 = 0;
    while (j < n) {
        var d: i64 = lex.decl_list[j];
        var dn: Node = base.nodes[d];
        if (dn.kind == "FuncDecl") {
            if (sema.func_is_generic(d) == false && dn.bf == false) {
                if (lex.in_link_libs(base.g_node_mod[d])) {
                    if (dn.bc) { tir_emit_extern(d); }
                } else if (dn.ba) {
                    tir_emit_extern(d);
                } else {
                    tir_lower_func(d);
                }
            }
        }
        j = j + 1;
    }
}

pub fn tir_emit_extern(d: i64) void {
    var n: Node = base.nodes[d];
    var ep: []string = [];
    var eb: []TIRInst = [];
    g_cur_func = TIRFunc{ name: n.sa, ret_st: tir_st_of_td(tir_func_ret_td(d)), params: ep, body: eb, is_extern: true, is_kernel: false };
    g_cur_ret_td = tir_func_ret_td(d);
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = base.kids[c];
        var p: Node = base.nodes[k.val];
        var pst: string = tir_st_of_td(sema.resolve_type_desc(p.na));
        append(g_cur_func.params, base.sb_cat4("$", p.sa, ": ", pst));
        c = k.next;
    }
    append(g_mod.funcs, g_cur_func);
}

pub fn tir_func_ret_td(d: i64) i64 {
    // FuncDecl 的返回类型 desc 存于 n.la 链之后的类型信息；复用 resolve_type_desc 取函数返回。
    // 现有实现中函数返回类型在 sema 通过 ti 记录，这里用 fn 签名 td 解析：
    var n: Node = base.nodes[d];
    // n.na 通常为返回类型 desc 节点（见 mk_FuncDecl 布局）；退回用 resolve_type_desc(n.la 首个 child 的父)
    if (n.na >= 0) {
        var rt: i64 = sema.resolve_type_desc(n.na);
        if (rt >= 0) { return rt; }
    }
    return sema.resolve_type_desc(d);
}

pub fn tir_lower_func(d: i64) void {
    var n: Node = base.nodes[d];
    var fp: []string = [];
    var fb: []TIRInst = [];
    g_cur_func = TIRFunc{ name: n.sa, ret_st: tir_st_of_td(tir_func_ret_td(d)), params: fp, body: fb, is_extern: false, is_kernel: false };
    g_cur_ret_td = tir_func_ret_td(d);
    var fln: []string = [];
    g_local_names = fln;
    var fls: []string = [];
    g_local_slots = fls;
    var flt: []string = [];
    g_local_sts = flt;
    var fld: []i64 = [];
    g_local_tds = fld;
    g_slotc = 0;
    g_term = false;
    var zlh: []string = [];
    g_loop_head = zlh;
    var zle: []string = [];
    g_loop_end = zle;
    var zde: []i64 = [];
    g_tir_defer = zde;

    // 参数：以 $name 作预填充 slot（memory-first：参数即本地 slot）
    // 闭包合成函数（M48）：仅 lambda 提升出的 FuncDecl（sc=="__lambda__"）且携带环境结构名
    // 时，前置 env 首参（与 TClosure ABI 一致）。普通函数（含 @__test_N 等）sc 非 __lambda__，
    // 即便 sb 被复用也不得加 env 形参，否则会向无关函数注入未被调用的 $__env 槽。
    if (n.sc == "__lambda__" && str_len(n.sb) > 0) {
        var envst: string = "ptr<void>";
        var envslot: string = "$__env";
        append(g_cur_func.params, base.sb_cat4(envslot, ": ", envst, ""));
        append(g_local_names, "__env");
        append(g_local_slots, envslot);
        append(g_local_sts, envst);
        append(g_local_tds, -1);
        tir_line(base.sb_cat4("slot ", envst, " ", envslot));
    }
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = base.kids[c];
        var p: Node = base.nodes[k.val];
        var pst: string = tir_st_of_td(sema.resolve_type_desc(p.na));
        var pslot: string = base.sb_cat2("$", p.sa);
        append(g_cur_func.params, base.sb_cat4(pslot, ": ", pst, ""));
        append(g_local_names, p.sa);
        append(g_local_slots, pslot);
        append(g_local_sts, pst);
        append(g_local_tds, sema.resolve_type_desc(p.na));
        tir_line(base.sb_cat4("slot ", pst, " ", pslot));
        c = k.next;
    }

    if (n.lc > -2) {
        var b: i64 = n.lc;
        while (b >= 0) {
            var bk: Child = base.kids[b];
            tir_emit_stmt(bk.val);
            b = bk.next;
        }
    }

    // 函数尾兜底返回（无显式 return 的路径）：先排空 defer（LIFO）
    g_term = false;
    tir_flush_defer();
    if (g_cur_func.ret_st == "void") {
        tir_line("ret.void");
    } else {
        var z: string = tir_tmp();
        tir_line(base.sb_cat5("const ", g_cur_func.ret_st, " ", z, " 0"));
        tir_line(base.sb_cat4("ret ", g_cur_func.ret_st, " ", z));
    }
    append(g_mod.funcs, g_cur_func);
}

// ══════════════════════════════════════════════════════════════════
// 语句发射（dispatch on node.kind）
// ══════════════════════════════════════════════════════════════════

pub fn tir_emit_stmt(sid: i64) void {
    g_cur_line = base.nodes[sid].ln;
    var n: Node = base.nodes[sid];
    var kd: string = n.kind;
    if (g_term) { return; }   // 当前块已终止：后续语句均为死代码，跳过

    if (kd == "var_decl") {
        var st: string = "i64";
        var t: i64 = -1;
        if (n.na >= 0) { t = sema.resolve_type_desc(n.na); if (t >= 0) { st = tir_st_of_td(t); } }
        var slot: string = tir_new_named_slot(t, st, n.sa);
        if (n.nb >= 0) {
            if (base.nodes[n.nb].kind == "array_lit") {
                var init: string = tir_emit_array_lit(n.nb, t);
                tir_line(base.sb_cat4("store ", init, " ", slot));
            } else if (base.nodes[n.nb].kind == "map_lit") {
                var init: string = tir_emit_map_lit(n.nb, t);
                tir_line(base.sb_cat4("store ", init, " ", slot));
            } else if (st == "ptr<void>" && base.nodes[n.nb].kind == "ident" && tir_is_func_name(base.nodes[n.nb].sa)) {
                // 函数作为闭包值：包进 %TClosure（与 codegen_ll 的 @t.clos.X 全局一致）
                var clo: string = tir_make_closure_value(base.sb_cat2("@", base.nodes[n.nb].sa), "");
                tir_line(base.sb_cat4("store ", clo, " ", slot));
            } else {
                var init: string = tir_emit_expr(n.nb);
                tir_line(base.sb_cat4("store ", init, " ", slot));
            }
        }
        return;
    }
    if (kd == "expr") {
        var _x: string = tir_emit_expr(n.na);
        return;
    }
    if (kd == "if") { tir_emit_if(n); return; }
    if (kd == "for") { tir_emit_for(n); return; }
    if (kd == "while") { tir_emit_while(n); return; }
    if (kd == "for_each") { tir_emit_for_each(n); return; }
    if (kd == "block") {
        var c: i64 = n.la;
        while (c >= 0) {
            var k: Child = base.kids[c];
            tir_emit_stmt(k.val);
            c = k.next;
        }
        return;
    }
    if (kd == "comptime_block") {
        var c: i64 = n.la;
        while (c >= 0) {
            var k: Child = base.kids[c];
            tir_emit_stmt(k.val);
            c = k.next;
        }
        return;
    }
    if (kd == "return") {
        g_term = false;
        tir_flush_defer();
        if (n.na >= 0) {
            var rk: Node = base.nodes[n.na];
            var s: string;
            if (rk.kind == "array_lit" && g_cur_ret_td >= 0 && sema.tds[g_cur_ret_td].cat == "array") {
                s = tir_emit_array_lit(n.na, g_cur_ret_td);
            } else {
                s = tir_emit_expr(n.na);
            }
            tir_line(base.sb_cat4("ret ", g_cur_func.ret_st, " ", s));
        } else {
            tir_line("ret.void");
        }
        return;
    }
    if (kd == "assignment" || kd == "assign") { tir_emit_assign(n); return; }
    if (kd == "defer") {
        append(g_tir_defer, sid);   // 登记延迟语句，遇 return / 函数尾按 LIFO 排空
        return;
    }
    if (kd == "match") { tir_emit_match(n, true); return; }
    if (kd == "break") {
        var endL: string = tir_loop_top_end();
        if (endL != "") { tir_line(base.sb_cat3("br ", endL, "")); }
        else { tir_cmt("break outside loop"); }
        return;
    }
    if (kd == "continue") {
        var headL: string = tir_loop_top_head();
        if (headL != "") { tir_line(base.sb_cat3("br ", headL, "")); }
        else { tir_cmt("continue outside loop"); }
        return;
    }
    if (kd == "closure_capture") { tir_emit_closure_capture(n); return; }
    tir_cmt(base.sb_cat3("unsupported stmt: ", kd, ""));
}

// 闭包捕获（Stage 6）：从 lambda 首参 $__env（ptr<void>）按字段拷回被捕获量到本地 slot。
// n.sa=变量名, n.sb=环境结构名(__env_N), n.na=类型 desc, n.ia=字段索引。
// 镜像 codegen_ll.tc:4259 closure_capture（gep %st.<sb>, ptr %__env, 0, n.ia）。
pub fn tir_emit_closure_capture(n: Node) void {
    var cctd: i64 = sema.resolve_type_desc(n.na);
    var ccst: string = "i64";
    if (cctd >= 0) { ccst = tir_st_of_td(cctd); }
    // 登记为本地 slot，使 lambda 体内对该变量的 ident 引用解析到本地（而非 @全局）
    var cvslot: string = tir_new_named_slot(cctd, ccst, n.sa);
    var envty: string = base.sb_cat2("%", n.sb);
    var eptr: string = tir_tmp();
    tir_line(base.sb_cat5("bitcast ptr<", envty, "> ", eptr, " ptr<void> $__env"));
    var faddr: string = tir_tmp();
    tir_line(base.sb_cat8("gep ", ccst, " ", faddr, " ", eptr, " 0 ", base.i2s(n.ia)));
    var ld: string = tir_tmp();
    tir_line(base.sb_cat6("load ", ccst, " ", ld, " ", faddr));
    tir_line(base.sb_cat4("store ", ld, " ", cvslot));
}

pub fn tir_emit_if(n: Node) void {
    var cond: string = tir_emit_expr(n.na);
    var thenL: string = tir_lbl("if.t");
    var endL: string = tir_lbl("if.e");
    var has_else: bool = n.lb > -2;
    var elseL: string = endL;
    if (has_else) { elseL = tir_lbl("if.f"); }
    tir_line(base.sb_cat6("br_cond ", cond, " ", thenL, " ", elseL));
    tir_block(thenL);
    var tb: i64 = n.la;
    while (tb >= 0) {
        tir_emit_stmt(base.kids[tb].val);
        tb = base.kids[tb].next;
    }
    tir_line(base.sb_cat3("br ", endL, ""));
    if (has_else) {
        tir_block(elseL);
        var eb: i64 = n.lb;
        while (eb >= 0) {
            tir_emit_stmt(base.kids[eb].val);
            eb = base.kids[eb].next;
        }
        tir_line(base.sb_cat3("br ", endL, ""));
    }
    tir_block(endL);
}

pub fn tir_emit_for(n: Node) void {
    if (n.na >= 0) { tir_emit_stmt(n.na); }    // 初始化（通常 var_decl）
    var headL: string = tir_lbl("for.h");
    var bodyL: string = tir_lbl("for.b");
    var endL: string = tir_lbl("for.e");
    tir_loop_push(headL, endL);
    tir_line(base.sb_cat3("br ", headL, ""));
    tir_block(headL);
    if (n.nb >= 0) {
        var cond: string = tir_emit_expr(n.nb);
        tir_line(base.sb_cat6("br_cond ", cond, " ", bodyL, " ", endL));
    } else {
        tir_line(base.sb_cat3("br ", bodyL, ""));
    }
    tir_block(bodyL);
    var bc: i64 = n.la;
    while (bc >= 0) {
        tir_emit_stmt(base.kids[bc].val);
        bc = base.kids[bc].next;
    }
    if (n.nc >= 0) { tir_emit_stmt(n.nc); }     // 增量（通常 assignment）
    tir_line(base.sb_cat3("br ", headL, ""));
    tir_block(endL);
    tir_loop_pop();
}

pub fn tir_emit_while(n: Node) void {
    var headL: string = tir_lbl("while.h");
    var bodyL: string = tir_lbl("while.b");
    var endL: string = tir_lbl("while.e");
    tir_loop_push(headL, endL);
    tir_line(base.sb_cat3("br ", headL, ""));
    tir_block(headL);
    var cond: string = tir_emit_expr(n.na);
    tir_line(base.sb_cat6("br_cond ", cond, " ", bodyL, " ", endL));
    tir_block(bodyL);
    var bc: i64 = n.la;
    while (bc >= 0) {
        tir_emit_stmt(base.kids[bc].val);
        bc = base.kids[bc].next;
    }
    tir_line(base.sb_cat3("br ", headL, ""));
    tir_block(endL);
    tir_loop_pop();
}

// for_each 降级（Stage 4）：slice / 定长数组迭代。
// n.sa=循环变量名, n.sb=可选第二变量(map 双变量, 本期不覆盖), n.na=集合表达式, n.la=循环体。
// slice 长度自 %TSlice 字段 1 读取（不依赖 tll_slice_len 运行时）；定长数组用编译期 N。
pub fn tir_emit_for_each(n: Node) void {
    if (g_term) { return; }
    var coll_td: i64 = tir_expr_td(n.na);
    if (coll_td < 0) { tir_cmt("unsupported for_each: untyped collection"); return; }
    var ct: TD = sema.tds[coll_td];
    var etd: i64 = -1;
    var is_arr: bool = false;
    var arr_n: i64 = -1;
    if (ct.cat == "slice") { etd = ct.elem; }
    else if (ct.cat == "array") { etd = ct.elem; is_arr = true; arr_n = ct.alen; }
    else if (ct.cat == "map") {
        var keytd: i64 = ct.key;
        var keyst: string = tir_st_of_td(keytd);
        var valtd: i64 = -1;
        var valst: string = "i64";
        var has_val: bool = false;
        if (ct.val >= 0) { valtd = ct.val; valst = tir_st_of_td(valtd); has_val = true; }
        var iter: string = tir_emit_expr(n.na);
        var lv: string = tir_new_named_slot(keytd, keyst, n.sa);
        var lvval: string = "";
        if (has_val && str_len(n.sb) > 0) { lvval = tir_new_named_slot(valtd, valst, n.sb); }
        var cnt: string = tir_tmp();
        tir_line(base.sb_cat5("call i64 ", cnt, " @tll_map_count (", iter, ")"));
        var idx: string = tir_new_named_slot(-1, "i64", "__fe_idx");
        var z: string = tir_tmp();
        tir_line(base.sb_cat4("const.i64 ", z, " 0", ""));
        tir_line(base.sb_cat4("store ", z, " ", idx));
        var headL: string = tir_lbl("fe.h");
        var bodyL: string = tir_lbl("fe.b");
        var stepL: string = tir_lbl("fe.s");
        var endL: string = tir_lbl("fe.e");
        tir_loop_push(headL, endL);
        tir_line(base.sb_cat3("br ", headL, ""));
        tir_block(headL);
        var cidx: string = tir_tmp();
        tir_line(base.sb_cat4("load i64 ", cidx, " ", idx));
        var ccmp: string = tir_tmp();
        tir_line(base.sb_cat6("slt.i64 ", ccmp, " ", cidx, " ", cnt));
        tir_line(base.sb_cat6("br_cond ", ccmp, " ", bodyL, " ", endL));
        tir_block(bodyL);
        if (sema.tds[keytd].cat == "string") {
            var kaddr: string = tir_tmp();
            tir_line(base.sb_cat6("addr_of ptr<", keyst, "> ", kaddr, " ", lv));
            tir_line(base.sb_cat7("call void @tll_map_key_str_at (", iter, ", ", cidx, ", ", kaddr, ")"));
        } else {
            var kv: string = tir_tmp();
            tir_line(base.sb_cat7("call i64 ", kv, " @tll_map_key_int_at (", iter, ", ", cidx, ")"));
            if (keyst != "i64") {
                var ktr: string = tir_tmp();
                tir_line(base.sb_cat6("trunc ", keyst, " ", ktr, " i64 ", kv));
                tir_line(base.sb_cat4("store ", ktr, " ", lv));
            } else {
                tir_line(base.sb_cat4("store ", kv, " ", lv));
            }
        }
        if (has_val && str_len(n.sb) > 0) {
            var vp: string = tir_tmp();
            tir_line(base.sb_cat9("call ptr<", valst, "> ", vp, " @tll_map_val_at (", iter, ", ", cidx, ")"));
            var vv: string = tir_tmp();
            tir_line(base.sb_cat6("load ", valst, " ", vv, " ", vp));
            tir_line(base.sb_cat4("store ", vv, " ", lvval));
        }
        var bc: i64 = n.la;
        while (bc >= 0) {
            tir_emit_stmt(base.kids[bc].val);
            bc = base.kids[bc].next;
        }
        tir_line(base.sb_cat3("br ", stepL, ""));
        tir_block(stepL);
        var cidx2: string = tir_tmp();
        tir_line(base.sb_cat4("load i64 ", cidx2, " ", idx));
        var cidx3: string = tir_tmp();
        tir_line(base.sb_cat5("add.i64 ", cidx3, " ", cidx2, " 1"));
        tir_line(base.sb_cat4("store ", cidx3, " ", idx));
        tir_line(base.sb_cat3("br ", headL, ""));
        tir_block(endL);
        tir_loop_pop();
        return;
    } else {
        tir_cmt(base.sb_cat3("unsupported for_each collection: ", ct.cat, ""));
        return;
    }
    var elem_st: string = tir_st_of_td(etd);
    var iter: string = tir_emit_expr(n.na);   // slot of %TSlice / arr<...>
    // 循环变量：按 n.sa 登记进 ident 查找表，循环体 ident 解析到本 slot
    var lv: string = tir_new_named_slot(etd, elem_st, n.sa);
    var idx: string = tir_new_named_slot(-1, "i64", "__fe_idx");
    // 长度
    var len: string;
    if (is_arr) {
        len = tir_tmp();
        tir_line(base.sb_cat4("const.i64 ", len, " ", base.i2s(arr_n)));
    } else {
        var laddr: string = tir_tmp();
        tir_line(base.sb_cat5("gep i64 ", laddr, " ", iter, " 1"));
        len = tir_tmp();
        tir_line(base.sb_cat4("load i64 ", len, " ", laddr));
    }
    // idx = 0
    var z: string = tir_tmp();
    tir_line(base.sb_cat4("const.i64 ", z, " 0", ""));
    tir_line(base.sb_cat4("store ", z, " ", idx));
    // 循环骨架
    var headL: string = tir_lbl("fe.h");
    var bodyL: string = tir_lbl("fe.b");
    var stepL: string = tir_lbl("fe.s");
    var endL: string = tir_lbl("fe.e");
    tir_loop_push(headL, endL);
    tir_line(base.sb_cat3("br ", headL, ""));
    tir_block(headL);
    var cidx: string = tir_tmp();
    tir_line(base.sb_cat4("load i64 ", cidx, " ", idx));
    var ccmp: string = tir_tmp();
    tir_line(base.sb_cat6("slt.i64 ", ccmp, " ", cidx, " ", len));
    tir_line(base.sb_cat6("br_cond ", ccmp, " ", bodyL, " ", endL));
    tir_block(bodyL);
    // 元素地址
    var eptr: string;
    if (is_arr) {
        var bptr: string = tir_tmp();
        tir_line(base.sb_cat6("addr_of ptr<", tir_st_of_td(coll_td), "> ", bptr, " ", iter));
        eptr = tir_tmp();
        tir_line(base.sb_cat8("gep_idx ", elem_st, " ", eptr, " ", bptr, " ", cidx));
    } else {
        var vaddr: string = tir_tmp();
        tir_line(base.sb_cat5("gep ptr<void> ", vaddr, " ", iter, " 0"));
        var vptr: string = tir_tmp();
        tir_line(base.sb_cat4("load ptr<void> ", vptr, " ", vaddr));
        var eptr0: string = tir_tmp();
        tir_line(base.sb_cat8("bitcast ", elem_st, " ", eptr0, " ", "ptr<void>", " ", vptr));
        eptr = tir_tmp();
        tir_line(base.sb_cat8("gep_idx ", elem_st, " ", eptr, " ", eptr0, " ", cidx));
    }
    var ev: string = tir_tmp();
    tir_line(base.sb_cat6("load ", elem_st, " ", ev, " ", eptr));
    tir_line(base.sb_cat4("store ", ev, " ", lv));
    // 循环体
    var bc: i64 = n.la;
    while (bc >= 0) {
        tir_emit_stmt(base.kids[bc].val);
        bc = base.kids[bc].next;
    }
    tir_line(base.sb_cat3("br ", stepL, ""));
    tir_block(stepL);
    var cidx2: string = tir_tmp();
    tir_line(base.sb_cat4("load i64 ", cidx2, " ", idx));
    var cidx3: string = tir_tmp();
    tir_line(base.sb_cat5("add.i64 ", cidx3, " ", cidx2, " 1"));
    tir_line(base.sb_cat4("store ", cidx3, " ", idx));
    tir_line(base.sb_cat3("br ", headL, ""));
    tir_block(endL);
    tir_loop_pop();
}

pub fn tir_emit_assign(n: Node) string {
    var op: string = n.sa;
    if (op == "=") {
        var rhs: string;
        if (base.nodes[n.nb].kind == "array_lit") {
            // 期望类型来自 LHS（ident 局部 TD / 其余退化）；使固定数组字面量落到 arr< 而非 slice
            var lhstd: i64 = -1;
            var lhn: Node = base.nodes[n.na];
            if (lhn.kind == "ident") {
                var idx: i64 = tir_find_local_idx(lhn.sa);
                if (idx >= 0) { lhstd = g_local_tds[idx]; }
            }
            rhs = tir_emit_array_lit(n.nb, lhstd);
        } else if (base.nodes[n.nb].kind == "map_lit") {
            var lhstd: i64 = -1;
            var lhn: Node = base.nodes[n.na];
            if (lhn.kind == "ident") {
                var idx: i64 = tir_find_local_idx(lhn.sa);
                if (idx >= 0) { lhstd = g_local_tds[idx]; }
            }
            rhs = tir_emit_map_lit(n.nb, lhstd);
        } else {
            rhs = tir_emit_expr(n.nb);
        }
        var lhs: Node = base.nodes[n.na];
        if (lhs.kind == "ident") {
            var idx: i64 = tir_find_local_idx(lhs.sa);
            if (idx >= 0) {
                tir_line(base.sb_cat4("store ", rhs, " ", g_local_slots[idx]));
                return rhs;
            } else {
                tir_cmt(base.sb_cat3("assign to global: ", lhs.sa, " (unsupported in Stage 1)"));
            }
        } else if (lhs.kind == "member") {
            var faddr: string = tir_member_addr(lhs);
            if (faddr != "") {
                tir_line(base.sb_cat4("store ", rhs, " ", faddr));
                return rhs;
            } else {
                tir_cmt("assign to member (unsupported base)");
            }
        } else if (lhs.kind == "index") {
            var eptr: string = tir_emit_index_addr(n.na);
            tir_line(base.sb_cat4("store ", rhs, " ", eptr));
            return rhs;
        } else {
            tir_cmt(base.sb_cat3("unsupported assign lhs: ", lhs.kind, ""));
        }
        var z: string = tir_tmp();
        tir_line(base.sb_cat4("const.i64 ", z, " 0", ""));
        return z;
    }
    // 复合赋值：仅支持 ident 左值标量
    var baseop: string = str_slice(op, 0, str_len(op) - 1);
    var lhs: Node = base.nodes[n.na];
    if (lhs.kind == "ident") {
        var idx: i64 = tir_find_local_idx(lhs.sa);
        if (idx >= 0) {
            var lst: string = g_local_sts[idx];
            var cur: string = tir_tmp();
            tir_line(base.sb_cat6("load ", lst, " ", cur, " ", g_local_slots[idx]));
            var rs: string = tir_emit_expr(n.nb);
            var dst: string = tir_tmp();
            tir_line(base.sb_cat7(tir_binop(baseop, lst), " ", dst, " ", cur, " ", rs));
            tir_line(base.sb_cat4("store ", dst, " ", g_local_slots[idx]));
            return dst;
        }
    }
    tir_cmt(base.sb_cat3("unsupported compound assign: ", op, ""));
    var z: string = tir_tmp();
    tir_line(base.sb_cat4("const.i64 ", z, " 0", ""));
    return z;
}

// ══════════════════════════════════════════════════════════════════
// 表达式发射：返回承载值的 slot（memory-first）
// ══════════════════════════════════════════════════════════════════

pub fn tir_emit_expr(e: i64) string {
    g_cur_line = base.nodes[e].ln;
    var n: Node = base.nodes[e];
    var kd: string = n.kind;

    if (kd == "assign" || kd == "assignment") { return tir_emit_assign(n); }
    if (kd == "match") { return tir_emit_match(n, false); }
    if (kd == "int") {
        var st: string = tir_expr_st(e);
        var d: string = tir_tmp();
        tir_line(base.sb_cat6("const ", st, " ", d, " ", n.sa));
        return d;
    }
    if (kd == "float") {
        var st: string = tir_expr_st(e);
        var d: string = tir_tmp();
        tir_line(base.sb_cat6("const ", st, " ", d, " ", n.sa));
        return d;
    }
    if (kd == "string") {
        var id: i64 = slice_len(g_mod.strings) as i64;
        append(g_mod.strings, n.sa);
        var d: string = tir_tmp();
        tir_line(base.sb_cat4("const.str ", d, " ", base.i2s(id)));
        return d;
    }
    if (kd == "bool") {
        var d: string = tir_tmp();
        if (n.ba) { tir_line(base.sb_cat3("const.i8 ", d, " 1")); }
        else { tir_line(base.sb_cat3("const.i8 ", d, " 0")); }
        return d;
    }
    if (kd == "null" || kd == "opt_none") {
        var d: string = tir_tmp();
        tir_line(base.sb_cat3("const.ptr.null ptr<void> ", d, ""));
        return d;
    }
    if (kd == "ident") {
        var idx: i64 = tir_find_local_idx(n.sa);
        if (idx >= 0) { return g_local_slots[idx]; }
        // 全局符号：Stage 1 直接引用 @name（聚合按地址、标量按值，调用方处理）
        return base.sb_cat2("@", n.sa);
    }
    if (kd == "paren" || kd == "comptime") { return tir_emit_expr(n.na); }
    if (kd == "binary") { return tir_emit_binary(n); }
    if (kd == "unary") { return tir_emit_unary(n); }
    if (kd == "call") { return tir_emit_call(e); }
    if (kd == "member") { return tir_member_read(n); }
    if (kd == "cast") { return tir_emit_cast(n); }
    if (kd == "struct_lit" || kd == "struct") { return tir_emit_struct_lit(e); }
    if (kd == "atom") {
        if (n.ia <= 0) { n.ia = sema.atom_intern(n.sa); slice_set(base.nodes, e, n); }
        var d: string = tir_tmp();
        tir_line(base.sb_cat4("const.u64 ", d, " ", base.i2s(n.ia)));
        return d;
    }
    if (kd == "fidconst") {
        var d: string = tir_tmp();
        tir_line(base.sb_cat4("const.i64 ", d, " ", base.i2s(n.ia)));
        return d;
    }
    if (kd == "array_lit") { return tir_emit_array_lit(e, -1); }
    if (kd == "map_lit") { return tir_emit_map_lit(e, -1); }
    if (kd == "index") { return tir_emit_index_read(e); }
    if (kd == "closure_make") { return tir_emit_closure_make(n); }
    // 兜底：不支持的表达式 → 零 slot，绝不崩溃
    tir_cmt(base.sb_cat3("unsupported expr: ", kd, ""));
    var z: string = tir_tmp();
    tir_line(base.sb_cat4("const.i64 ", z, " 0", ""));
    return z;
}

// 闭包构造（Stage 6）：在栈上构造环境结构 %<n.sb>，逐字段存入被捕获量的值，
// 再构造 %TClosure { fnptr=@<n.sa>, envptr=env } 并以 ptr<void> 返回（与 TClosure ABI 一致）。
// n.sa=合成 lambda 名(__lam_N), n.sb=环境结构名(__env_N), n.la=捕获量链(kids, 每节点 sa=变量名)。
// 镜像 codegen_ll.tc:1627 closure_make（per-capture gep %st.<sb> + store；再 %TClosure {fnptr,envptr}）。
pub fn tir_emit_closure_make(n: Node) string {
    var envty: string = base.sb_cat2("%", n.sb);
    var env: string = tir_tmp();
    tir_line(base.sb_cat4("slot ", envty, " ", env));
    var envaddr: string = tir_tmp();
    tir_line(base.sb_cat6("addr_of ptr<", envty, "> ", envaddr, " ", env));
    var cmc: i64 = n.la;
    while (cmc >= 0) {
        var cmk: Child = base.kids[cmc];
        var cmf: Node = base.nodes[cmk.val];
        var cvname: string = cmf.sa;
        var fidx: i64 = tir_field_index(tir_strip_pct(envty), cvname);
        var cvval: string = tir_emit_expr(cmk.val);
        var cvst: string = tir_expr_st(cmk.val);
        var faddr: string = tir_tmp();
        tir_line(base.sb_cat8("gep ", cvst, " ", faddr, " ", envaddr, " 0 ", base.i2s(fidx)));
        tir_line(base.sb_cat4("store ", cvval, " ", faddr));
        cmc = cmk.next;
    }
    var envptr: string = tir_tmp();
    tir_line(base.sb_cat6("addr_of ptr<", envty, "> ", envptr, " ", env));
    var envpv: string = tir_tmp();
    tir_line(base.sb_cat7("bitcast ptr<void> ", envpv, " ", "ptr<", envty, "> ", envptr));
    return tir_make_closure_value(base.sb_cat2("@", n.sa), envpv);
}

pub fn tir_emit_binary(n: Node) string {
    var op: string = n.sa;
    if (op == "&&" || op == "||") {
        return tir_emit_logical(n, op == "&&");
    }
    var ls: string = tir_emit_expr(n.na);
    var rs: string = tir_emit_expr(n.nb);
    var ost: string = tir_expr_st(n.na);
    var opc: string = tir_binop(n.sa, ost);
    var d: string = tir_tmp();
    tir_line(base.sb_cat7(opc, " ", d, " ", ls, " ", rs));
    return d;
}

// 短路逻辑 && / ||（memory-first，无 phi；镜像 codegen_ll.tc:1898-1922 的 br i1+phi 短路控制流，
// 但 TIR 走 memory-first：两臂各自 store 同一结果 slot，汇合点无需 φ）。
//   a && b → a 假则 res=false（不求值 b）；a 真则 res=b（求值 b）
//   a || b → a 真则 res=true（不求值 b）；a 假则 res=b（求值 b）
// 实测探针 out/dbg/sc_probe.tc 确认 t 的 &&/|| 短路生效，与 codegen_ll 一致
// （项目记忆「t 的 && 不短路」已证伪——以 codegen_ll 运行时行为为准）。
pub fn tir_emit_logical(n: Node, is_and: bool) string {
    var lst: string = tir_expr_st(n.na);   // 操作数存储型（bool → i8）
    var ls: string = tir_emit_expr(n.na);
    var res: string = tir_tmp();
    tir_line(base.sb_cat4("slot ", lst, " ", res));
    var thenL: string = tir_lbl("sc.t");
    var elseL: string = tir_lbl("sc.f");
    var endL: string = tir_lbl("sc.e");
    tir_line(base.sb_cat6("br_cond ", ls, " ", thenL, " ", elseL));
    // then 臂
    tir_block(thenL);
    if (is_and) {
        var rs: string = tir_emit_expr(n.nb);
        tir_line(base.sb_cat4("store ", rs, " ", res));
    } else {
        var one: string = tir_tmp();
        tir_line(base.sb_cat5("const.", lst, " ", one, " 1"));
        tir_line(base.sb_cat4("store ", one, " ", res));
    }
    tir_line(base.sb_cat3("br ", endL, ""));
    // else 臂
    tir_block(elseL);
    if (is_and) {
        var zero: string = tir_tmp();
        tir_line(base.sb_cat5("const.", lst, " ", zero, " 0"));
        tir_line(base.sb_cat4("store ", zero, " ", res));
    } else {
        var rse: string = tir_emit_expr(n.nb);
        tir_line(base.sb_cat4("store ", rse, " ", res));
    }
    tir_line(base.sb_cat3("br ", endL, ""));
    // 汇合点：两臂均已 store 进同一 $res，无需 φ
    tir_block(endL);
    return res;
}

pub fn tir_binop(op: string, st: string) string {
    if (op == "+") { return base.sb_cat2("add.", st); }
    if (op == "-") { return base.sb_cat2("sub.", st); }
    if (op == "*") { return base.sb_cat2("mul.", st); }
    if (op == "/") { return base.sb_cat2(tir_divop(st), st); }
    if (op == "%") { return base.sb_cat2(tir_remop(st), st); }
    if (op == "&") { return "and"; }
    if (op == "|") { return "or"; }
    if (op == "^") { return "xor"; }
    if (op == "<<") { return "shl"; }
    if (op == ">>") { return "ashr"; }
    if (op == "==") { return base.sb_cat2("eq.", st); }
    if (op == "!=") { return base.sb_cat2("ne.", st); }
    if (op == "<") { return base.sb_cat2(tir_cmpop(op, st), st); }
    if (op == "<=") { return base.sb_cat2(tir_cmpop("<=", st), st); }
    if (op == ">") { return base.sb_cat2(tir_cmpop(">", st), st); }
    if (op == ">=") { return base.sb_cat2(tir_cmpop(">=", st), st); }
    return "unsupported_binop";
}

pub fn tir_divop(st: string) string {
    if (str_len(st) > 0 && st[0] == 117) { return "udiv"; }   // 'u'
    return "sdiv";
}

pub fn tir_remop(st: string) string {
    if (str_len(st) > 0 && st[0] == 117) { return "urem"; }
    return "srem";
}

pub fn tir_cmpop(op: string, st: string) string {
    var uns: bool = false;
    if (str_len(st) > 0 && st[0] == 117) { uns = true; }
    if (op == "<") { if (uns) { return "ult"; } return "slt"; }
    if (op == "<=") { if (uns) { return "ule"; } return "sle"; }
    if (op == ">") { if (uns) { return "ugt"; } return "sgt"; }
    if (op == ">=") { if (uns) { return "uge"; } return "sge"; }
    return "slt";
}

pub fn tir_emit_unary(n: Node) string {
    var a: string = tir_emit_expr(n.na);
    var st: string = tir_expr_st(n.na);
    var d: string = tir_tmp();
    if (n.sa == "-") {
        tir_line(base.sb_cat6("neg.", st, " ", d, " ", a));
        return d;
    }
    if (n.sa == "!") {
        tir_line(base.sb_cat4("not.i8 ", d, " ", a));
        return d;
    }
    if (n.sa == "~") {
        tir_line(base.sb_cat8("xor.", st, " ", d, " ", a, " -1", ""));
        return d;
    }
    tir_cmt(base.sb_cat3("unsupported unary: ", n.sa, ""));
    return d;
}

pub fn tir_emit_call(e: i64) string {
    var n: Node = base.nodes[e];
    var callee: Node = base.nodes[n.na];
    var cname: string = callee.sa;
    var retst: string = tir_expr_st(e);
    var d: string = tir_tmp();
    var sb: StringBuilder = sb_new();
    var first: bool = true;
    var argi: i64 = 0;
    var ac: i64 = n.la;
    while (ac >= 0) {
        var k: Child = base.kids[ac];
        var ak: Node = base.nodes[k.val];
        var aslot: string;
        if (ak.kind == "array_lit") {
            var ptd: i64 = tir_callee_param_td(cname, argi);
            if (ptd >= 0 && sema.tds[ptd].cat == "array") {
                aslot = tir_emit_array_lit(k.val, ptd);
            } else {
                aslot = tir_emit_expr(k.val);
            }
        } else if (ak.kind == "map_lit") {
            var ptd: i64 = tir_callee_param_td(cname, argi);
            if (ptd >= 0 && sema.tds[ptd].cat == "map") {
                aslot = tir_emit_map_lit(k.val, ptd);
            } else {
                aslot = tir_emit_expr(k.val);
            }
        } else {
            aslot = tir_emit_expr(k.val);
        }
        if (first == false) { sb_append_str(sb, " "); }
        sb_append_str(sb, aslot);
        first = false;
        argi = argi + 1;
        ac = k.next;
    }
    // 间接调用：被调者是本地槽（闭包值，ptr<void> 指向 %TClosure）→ call_ind；
    // 否则是被调函数名 → 直接 call。镜像 codegen_ll.tc ll_call（局部/全局函数类型变量 → 间接）。
    var callee_ref: string = base.sb_cat2("@", cname);
    var is_ind: bool = false;
    if (tir_find_local_idx(cname) >= 0) {
        callee_ref = base.sb_cat2("$", cname);
        is_ind = true;
    }
    var op: string = "call";
    if (is_ind) { op = "call_ind"; }
    tir_line(base.sb_cat8(op, " ", retst, " ", d, " ", callee_ref, base.sb_cat3(" (", sb_to_str(sb), ")")));
    return d;
}

pub fn tir_emit_cast(n: Node) string {
    // 致命坑⑤：表达式位（return / call-arg）的 array_lit 被 sema 包进 cast 节点，
    // 在此顶部拦截，按 cast 目标类型直接降级（避免落到兜底 unsupported）。
    if (base.nodes[n.na].kind == "array_lit") {
        var ttd: i64 = sema.resolve_type_desc(n.nb);
        return tir_emit_array_lit(n.na, ttd);
    }
    var inner: string = tir_emit_expr(n.na);
    var inner_st: string = tir_expr_st(n.na);
    var target_st: string = tir_st_of_td(sema.resolve_type_desc(n.nb));
    if (inner_st == target_st) { return inner; }
    var d: string = tir_tmp();
    var wi: i64 = tir_width(inner_st);
    var wt: i64 = tir_width(target_st);
    if (wi < wt) {
        if (str_len(inner_st) > 0 && inner_st[0] == 117) { tir_line(base.sb_cat8("zext ", target_st, " ", d, " ", inner_st, " ", inner)); }
        else { tir_line(base.sb_cat8("sext ", target_st, " ", d, " ", inner_st, " ", inner)); }
    } else if (wi > wt) {
        tir_line(base.sb_cat8("trunc ", target_st, " ", d, " ", inner_st, " ", inner));
    } else {
        tir_line(base.sb_cat8("bitcast ", target_st, " ", d, " ", inner_st, " ", inner));
    }
    return d;
}

pub fn tir_width(st: string) i64 {
    if (st == "i8" || st == "u8") { return 8; }
    if (st == "i16" || st == "u16") { return 16; }
    if (st == "i32" || st == "u32") { return 32; }
    if (st == "i64" || st == "u64") { return 64; }
    if (st == "f32") { return 32; }
    if (st == "f64") { return 64; }
    return 64;
}

pub fn tir_emit_struct_lit(e: i64) string {
    var n: Node = base.nodes[e];
    var target_st: string = tir_expr_st(e);
    var d: string = tir_tmp();
    var sb: StringBuilder = sb_new();
    var first: bool = true;
    var fc: i64 = n.la;
    while (fc >= 0) {
        var k: Child = base.kids[fc];
        var fs: string = tir_emit_expr(k.val);
        if (first == false) { sb_append_str(sb, " "); }
        sb_append_str(sb, fs);
        first = false;
        fc = k.next;
    }
    tir_line(base.sb_cat6("struct_new ", target_st, " ", d, " (", base.sb_cat3(sb_to_str(sb), ")", "")));
    return d;
}

// ══════════════════════════════════════════════════════════════════
// 数组 / 切片字面量降级（Stage 3）
// ══════════════════════════════════════════════════════════════════

// 数组/切片字面量降级（Stage 3）：
//  - 固定数组（TD.cat=="array"）：struct_new arr<elem x N> (e0..eN-1)
//  - 切片（TD.cat=="slice" 或未知类型兜底）：在栈上开 arr<elem x N> 后备槽，逐元素存，
//    再用 bitcast 取得 ptr<void> 数据指针，struct_new %TSlice (data, len, cap, 0)
//  - force_td：来自 var_decl / assign LHS / cast 的显式期望类型；<0 时退回 meta_type_of_expr / 首元素推断
pub fn tir_emit_array_lit(e: i64, force_td: i64) string {
    var n: Node = base.nodes[e];
    var elems: []i64 = [];
    var c: i64 = n.la;
    while (c >= 0) { append(elems, base.kids[c].val); c = base.kids[c].next; }
    var N: i64 = slice_len(elems) as i64;
    var td: i64 = force_td;
    if (td < 0) { td = tir_expr_td(e); }
    var cat: string = "";
    var elem_st: string = "i64";
    if (td >= 0) {
        var t: TD = sema.tds[td];
        cat = t.cat;
        elem_st = tir_st_of_td(t.elem);
    } else if (N > 0) {
        elem_st = tir_expr_st(elems[0]);
    }
    if (cat == "array") {
        var arrst: string = base.sb_cat5("arr<", elem_st, " x ", base.i2s(N), ">");
        var d: string = tir_tmp();
        var sb: StringBuilder = sb_new();
        var first: bool = true;
        var i: i64 = 0;
        while (i < N) {
            var es: string = tir_emit_expr(elems[i]);
            if (first == false) { sb_append_str(sb, " "); }
            sb_append_str(sb, es);
            first = false;
            i = i + 1;
        }
        tir_line(base.sb_cat6("struct_new ", arrst, " ", d, " (", base.sb_cat3(sb_to_str(sb), ")", "")));
        return d;
    }
    // 切片字面量：后备槽 + %TSlice
    var arrst: string = base.sb_cat5("arr<", elem_st, " x ", base.i2s(N), ">");
    var back: string = tir_tmp();
    tir_line(base.sb_cat4("slot ", arrst, " ", back));
    var i: i64 = 0;
    while (i < N) {
        var es: string = tir_emit_expr(elems[i]);
        var eaddr: string = tir_tmp();
        tir_line(base.sb_cat6("addr_of ptr<", arrst, "> ", eaddr, " ", back));
        var faddr: string = tir_tmp();
        tir_line(base.sb_cat8("gep ", elem_st, " ", faddr, " ", eaddr, " ", base.i2s(i)));
        tir_line(base.sb_cat4("store ", es, " ", faddr));
        i = i + 1;
    }
    var bptr: string = tir_tmp();
    tir_line(base.sb_cat6("addr_of ptr<", arrst, "> ", bptr, " ", back));
    var vptr: string = tir_tmp();
    tir_line(base.sb_cat8("bitcast ", "ptr<void>", " ", vptr, " ", arrst, " ", bptr));
    var slen: string = tir_tmp();
    tir_line(base.sb_cat4("const.i64 ", slen, " ", base.i2s(N)));
    var scap: string = tir_tmp();
    tir_line(base.sb_cat4("const.i64 ", scap, " ", base.i2s(N)));
    var szero: string = tir_tmp();
    tir_line(base.sb_cat3("const.i64 ", szero, " 0"));
    var fsb: StringBuilder = sb_new();
    sb_append_str(fsb, vptr);
    sb_append_str(fsb, " ");
    sb_append_str(fsb, slen);
    sb_append_str(fsb, " ");
    sb_append_str(fsb, scap);
    sb_append_str(fsb, " ");
    sb_append_str(fsb, szero);
    var d: string = tir_tmp();
    var sline: StringBuilder = sb_new();
    sb_append_str(sline, "struct_new %TSlice ");
    sb_append_str(sline, d);
    sb_append_str(sline, " (");
    sb_append_str(sline, sb_to_str(fsb));
    sb_append_str(sline, ")");
    tir_line(sb_to_str(sline));
    return d;
}

// defer 排空（LIFO）：遇显式 return 或函数尾调用；每次排空后清空栈（保证仅运行一次）
pub fn tir_flush_defer() void {
    var n: i64 = slice_len(g_tir_defer) as i64;
    while (n > 0) {
        n = n - 1;
        var dn: Node = base.nodes[g_tir_defer[n]];
        g_cur_line = dn.ln;
        var c: i64 = dn.la;
        while (c >= 0) {
            tir_emit_stmt(base.kids[c].val);
            c = base.kids[c].next;
        }
    }
    var z: []i64 = [];
    g_tir_defer = z;
}

// ══════════════════════════════════════════════════════════════════
// 字段地址（ptr<ST>）：用于 member 读/写
pub fn tir_member_addr(mnode: Node) string {
    var base_st: string = tir_expr_st(mnode.na);
    var base_slot: string = tir_emit_expr(mnode.na);
    var addr: string = tir_tmp();
    tir_line(base.sb_cat6("addr_of ptr<", base_st, "> ", addr, " ", base_slot));
    var sname: string = tir_strip_pct(base_st);
    var fidx: i64 = tir_field_index(sname, mnode.sa);
    var fldst: string = tir_field_st(sname, mnode.sa);
    var faddr: string = tir_tmp();
    tir_line(base.sb_cat8("gep ", fldst, " ", faddr, " ", addr, " ", base.i2s(fidx)));
    return faddr;
}

pub fn tir_member_read(mnode: Node) string {
    var base_st: string = tir_expr_st(mnode.na);
    var faddr: string = tir_member_addr(mnode);
    var sname: string = tir_strip_pct(base_st);
    var fldst: string = tir_field_st(sname, mnode.sa);
    var ld: string = tir_tmp();
    tir_line(base.sb_cat6("load ", fldst, " ", ld, " ", faddr));
    return ld;
}

// ══════════════════════════════════════════════════════════════════
// 下标访问（Stage 2）：a[i] 读 / a[i] = v 写
// ══════════════════════════════════════════════════════════════════

// 计算下标元素地址（ptr<elem_st>），写回 g_idx_elem_st。不支持的基类型降级为注释。
pub fn tir_sizeof(st: string) i64 {
    if (st == "i64" || st == "u64" || st == "f64") { return 8; }
    if (st == "i32" || st == "u32" || st == "f32") { return 4; }
    if (st == "i16" || st == "u16") { return 2; }
    if (st == "i8" || st == "u8" || st == "bool") { return 1; }
    if (st == "%TStr") { return 16; }
    return 8;
}

pub fn tir_emit_map_lit(e: i64, force_td: i64) string {
    var n: Node = base.nodes[e];
    var td: i64 = force_td;
    if (td < 0) { td = tir_expr_td(e); }
    if (td < 0) {
        tir_cmt("unsupported expr: map_lit (untyped)");
        var z: string = tir_tmp();
        tir_line(base.sb_cat4("const.i64 ", z, " 0", ""));
        return z;
    }
    var mt: TD = sema.tds[td];
    var valtd: i64 = mt.val;
    if (valtd >= 0 && (sema.tds[valtd].cat == "string" || sema.tds[valtd].cat == "named" ||
        sema.tds[valtd].cat == "array" || sema.tds[valtd].cat == "struct" || sema.tds[valtd].cat == "slice" ||
        sema.tds[valtd].cat == "map")) {
        tir_cmt("unsupported expr: map_lit (aggregate val)");
        var z: string = tir_tmp();
        tir_line(base.sb_cat4("const.i64 ", z, " 0", ""));
        return z;
    }
    var keykind: i64 = 1;
    if (sema.tds[mt.key].cat == "string") { keykind = 0; }
    var valst: string = tir_st_of_td(valtd);
    var valsz: i64 = tir_sizeof(valst);
    var kk: string = tir_tmp();
    tir_line(base.sb_cat4("const.i64 ", kk, " ", base.i2s(keykind)));
    var vsz: string = tir_tmp();
    tir_line(base.sb_cat4("const.i64 ", vsz, " ", base.i2s(valsz)));
    var m: string = tir_tmp();
    tir_line(base.sb_cat4("slot ptr<void> ", m, "", ""));
    tir_line(base.sb_cat7("call ptr<void> ", m, " @tll_map_new (", kk, ", ", vsz, ")"));
    var ec: i64 = n.la;
    while (ec >= 0) {
        var en: Node = base.nodes[base.kids[ec].val];
        var ks: string = tir_emit_expr(en.na);
        var kst: string = tir_expr_st(en.na);
        var kc: string = ks;
        if (kst != "i64") { kc = tir_tmp(); tir_line(base.sb_cat8("zext ", "i64", " ", kc, " ", kst, " ", ks)); }
        var kp: string = tir_tmp();
        if (sema.tds[mt.key].cat == "string") {
            tir_line(base.sb_cat4("addr_of %TStr ", kp, " ", ks));
        } else {
            tir_line(base.sb_cat4("addr_of ptr<i64> ", kp, " ", kc));
        }
        var vs: string = tir_emit_expr(en.nb);
        var vp: string = tir_tmp();
        tir_line(base.sb_cat6("addr_of ", valst, " ", vp, " ", vs));
        tir_line(base.sb_cat7("call void @tll_map_put (", m, ", ", kp, ", ", vp, ")"));
        ec = base.kids[ec].next;
    }
    return m;
}

pub fn tir_emit_index_addr(ine: i64) string {
    var n: Node = base.nodes[ine];
    var base_td: i64 = tir_expr_td(n.na);
    if (base_td < 0) {
        tir_cmt("unsupported index base (untyped)");
        var z: string = tir_tmp();
        tir_line(base.sb_cat4("const.i64 ", z, " 0", ""));
        g_idx_elem_st = "i64";
        return z;
    }
    var base_st: string = tir_st_of_td(base_td);
    var base_slot: string = tir_emit_expr(n.na);
    var idx: string = tir_emit_expr(n.nb);
    g_idx_elem_st = tir_elem_st(base_td);
    var dptr: string = base_slot;
    if (base_st == "%TSlice") {
        dptr = tir_tmp();
        tir_line(base.sb_cat5("gep ptr<void> ", dptr, " ", base_slot, " 0"));
    } else if (base_st == "%TStr") {
        dptr = tir_tmp();
        tir_line(base.sb_cat5("gep ptr<i8> ", dptr, " ", base_slot, " 0"));
    } else if (str_len(base_st) >= 4 && str_slice(base_st, 0, 4) == "arr<") {
        dptr = tir_tmp();
        tir_line(base.sb_cat6("addr_of ptr<", base_st, "> ", dptr, " ", base_slot));
    } else if (str_len(base_st) >= 4 && str_slice(base_st, 0, 4) == "vec<") {
        dptr = tir_tmp();
        tir_line(base.sb_cat6("addr_of ptr<", base_st, "> ", dptr, " ", base_slot));
    } else if (sema.tds[base_td].cat == "map") {
        var mt: TD = sema.tds[base_td];
        var valtd: i64 = mt.val;
        var valst: string = tir_st_of_td(valtd);
        if (valtd >= 0 && (sema.tds[valtd].cat == "string" || sema.tds[valtd].cat == "named" ||
            sema.tds[valtd].cat == "array" || sema.tds[valtd].cat == "struct" || sema.tds[valtd].cat == "slice" ||
            sema.tds[valtd].cat == "map")) {
            tir_cmt("unsupported map index val (aggregate)");
            var zz: string = tir_tmp();
            tir_line(base.sb_cat4("const.i64 ", zz, " 0", ""));
            g_idx_elem_st = "i64";
            return zz;
        }
        g_idx_elem_st = valst;
        var ks: string = tir_emit_expr(n.nb);
        var kst: string = tir_expr_st(n.nb);
        var kc: string = ks;
        if (kst != "i64") { kc = tir_tmp(); tir_line(base.sb_cat8("zext ", "i64", " ", kc, " ", kst, " ", ks)); }
        var kp: string = tir_tmp();
        if (sema.tds[mt.key].cat == "string") {
            tir_line(base.sb_cat4("addr_of %TStr ", kp, " ", ks));
        } else {
            tir_line(base.sb_cat4("addr_of ptr<i64> ", kp, " ", kc));
        }
        var vp: string = tir_tmp();
        tir_line(base.sb_cat7("call ptr<void> ", vp, " @tll_map_val_ptr (", base_slot, ", ", kp, ")"));
        return vp;
    } else {
        tir_cmt(base.sb_cat3("unsupported index base: ", base_st, ""));
        var z: string = tir_tmp();
        tir_line(base.sb_cat4("const.i64 ", z, " 0", ""));
        g_idx_elem_st = "i64";
        return z;
    }
    var eptr: string = tir_tmp();
    tir_line(base.sb_cat8("gep_idx ", g_idx_elem_st, " ", eptr, " ", dptr, " ", idx));
    return eptr;
}

pub fn tir_emit_index_read(e: i64) string {
    var eptr: string = tir_emit_index_addr(e);
    var ld: string = tir_tmp();
    tir_line(base.sb_cat6("load ", g_idx_elem_st, " ", ld, " ", eptr));
    return ld;
}

// ══════════════════════════════════════════════════════════════════
// match 降级（Stage 2）：字面量 / 枚举·变体构造器 / 绑定 / _ / when 守卫
// ══════════════════════════════════════════════════════════════════

// 单臂模式条件（布尔 slot）；不支持的模式返回 ""（调用方降级为注释并跳过该臂）。
pub fn tir_match_pattern_cond(arm: Node, scr: string, scr_st: string, scr_td: i64) string {
    var p: Node = base.nodes[arm.na];
    // ── 字面量模式 ──
    if (p.kind == "int" || p.kind == "float" || p.kind == "bool" || p.kind == "char" || p.kind == "null" || p.kind == "opt_none") {
        var pv: string = tir_emit_expr(arm.na);
        var cond: string = tir_tmp();
        tir_line(base.sb_cat8("eq.", scr_st, " ", cond, " ", scr, " ", pv));
        return cond;
    }
    // ── 原子字面量模式：u64 相等 ──
    if (p.kind == "atom") {
        var aid: i64 = p.ia;
        if (aid <= 0) { aid = sema.atom_intern(p.sa); slice_set(base.nodes, arm.na, p); }
        var pv: string = tir_tmp();
        tir_line(base.sb_cat4("const.u64 ", pv, " ", base.i2s(aid)));
        var cond: string = tir_tmp();
        tir_line(base.sb_cat6("eq.u64 ", cond, " ", scr, " ", pv));
        return cond;
    }
    // ── 字符串字面量模式：tll_str_eq == 0 ──
    if (p.kind == "string") {
        var sp: string = tir_tmp();
        tir_line(base.sb_cat5("gep ptr<i8> ", sp, " ", scr, " 0"));
        var pvslot: string = tir_emit_expr(arm.na);
        var pp: string = tir_tmp();
        tir_line(base.sb_cat5("gep ptr<i8> ", pp, " ", pvslot, " 0"));
        var cmp: string = tir_tmp();
        tir_line(base.sb_cat7("call i32 ", cmp, " @tll_str_eq (", sp, ", ", pp, ")"));
        var cond: string = tir_tmp();
        tir_line(base.sb_cat5("eq.i32 ", cond, " ", cmp, " 0"));
        return cond;
    }
    // ── 枚举 / 变体构造器模式（ident 或 Enum.Case / Variant.Case 的 member）──
    var cname: string = p.sa;
    if (p.kind == "member") { cname = p.sa; }
    if (p.kind == "ident" || p.kind == "member") {
        if (sema.tip_kind(scr_td) == "Enum") {
            var ename: string = sema.tip_name(scr_td);
            if (sema.enum_has_case(scr_td, cname)) {
                var cn: i64 = sema.enum_const_lookup(ename, cname);
                var val: i64 = -1;
                if (cn >= 0) { val = base.nodes[cn].ia; }
                var pv: string = tir_tmp();
                tir_line(base.sb_cat6("const ", scr_st, " ", pv, " ", base.i2s(val)));
                var cond: string = tir_tmp();
                tir_line(base.sb_cat8("eq.", scr_st, " ", cond, " ", scr, " ", pv));
                return cond;
            }
        } else if (sema.tip_kind(scr_td) == "Variant") {
            var vd: i64 = sema.variant_decl_of(scr_td);
            var ci: i64 = sema.variant_find_case(vd, cname);
            if (ci >= 0) {
                var idx: i64 = 0;
                var cc: i64 = base.nodes[vd].lb;
                while (cc >= 0) {
                    if (base.nodes[base.kids[cc].val].sa == cname) { break; }
                    idx = idx + 1;
                    cc = base.kids[cc].next;
                }
                var tagp_addr: string = tir_tmp();
                tir_line(base.sb_cat6("addr_of ptr<", tagp_addr, " ", scr_st, "> ", scr));
                var tagp: string = tir_tmp();
                tir_line(base.sb_cat5("gep i8 ", tagp, " ", tagp_addr, " 0"));
                var tagv: string = tir_tmp();
                tir_line(base.sb_cat4("load i8 ", tagv, " ", tagp));
                var pv: string = tir_tmp();
                tir_line(base.sb_cat4("const.i8 ", pv, " ", base.i2s(idx)));
                var cond: string = tir_tmp();
                tir_line(base.sb_cat6("eq.i8 ", cond, " ", tagv, " ", pv));
                return cond;
            }
        }
        return "";
    }
    return "";
}

// match 降级（as_stmt=true 当作语句；false 当作表达式，返回结果 slot）。
// 两遍发射：第一遍构造条件链（每臂的 eq+br_cond 落在上一臂的 next 块内，形成正确 CFG），
// 第二遍发射各臂 body 块（各自 br 到 endL）。支持 字面量/_/绑定/when 守卫/枚举·变体构造器。
// 绑定名在 match entry 预声明为局部 slot 并绑定 scrutinee，使守卫与体均引用局部 slot（避免 @name 全局误引用）。
pub fn tir_emit_match(n: Node, as_stmt: bool) string {
    if (g_term) { return ""; }
    g_term = false;
    var scr: string = tir_emit_expr(n.na);
    var scr_st: string = tir_expr_st(n.na);
    var scr_td: i64 = sema.resolve_type_desc(n.na);
    var endL: string = tir_lbl("m.e");
    var res: string = "";
    if (as_stmt == false) { res = tir_new_named_slot(scr_td, scr_st, "__mres"); }
    // 收集所有臂
    var armIds: []i64 = [];
    var c: i64 = n.la;
    while (c >= 0) { append(armIds, base.kids[c].val); c = base.kids[c].next; }
    var nArm: i64 = slice_len(armIds);
    // 预声明绑定名 slot（match entry）：使守卫/体都引用局部 slot，且声明早于使用
    var i: i64 = 0;
    while (i < nArm) {
        var arm: Node = base.nodes[armIds[i]];
        if (arm.na < 0 && arm.sa != "") {
            // 同绑定名跨多臂只建一个 slot（避免 $x / $x__0 重复死槽）；已声明则复用
            var bidx: i64 = tir_find_local_idx(arm.sa);
            if (bidx < 0) {
                var bs: string = tir_new_named_slot(scr_td, scr_st, arm.sa);
                tir_line(base.sb_cat4("store ", scr, " ", bs));
            }
        }
        i = i + 1;
    }
    var armLabels: []string = [];
    // 第一遍：条件链（每臂的 br_cond/br 紧随上一臂打开的 next 块，确保 cond 落在该 next 块内）
    i = 0;
    while (i < nArm) {
        var arm: Node = base.nodes[armIds[i]];
        var armL: string = tir_lbl("m.b");
        append(armLabels, armL);
        var cond: string = "";
        var skip_arm: bool = false;
        if (arm.na >= 0) {
            cond = tir_match_pattern_cond(arm, scr, scr_st, scr_td);
            if (cond == "") {
                tir_cmt(base.sb_cat2("unsupported match arm pattern: ", base.nodes[arm.na].kind));
                skip_arm = true;
            }
        }
        if (arm.nb >= 0) {   // when 守卫：与模式条件做 and（纯绑定臂则守卫即条件）
            var g: string = tir_emit_expr(arm.nb);
            if (cond == "") { cond = g; }
            else { var comb: string = tir_tmp(); tir_line(base.sb_cat6("and.i8 ", comb, " ", cond, " ", g)); cond = comb; }
        }
        var is_term: bool = (arm.na < 0 && arm.nb < 0);   // 纯 _ 或纯绑定：无条件臂
        if (skip_arm) {
            tir_line(base.sb_cat3("br ", armL, ""));        // 不支持模式：降级为终极端（兜底，永不崩溃）
        } else if (is_term) {
            tir_line(base.sb_cat3("br ", armL, ""));
        } else {
            var nextL: string = tir_lbl("m.n");
            tir_line(base.sb_cat6("br_cond ", cond, " ", armL, " ", nextL));
            tir_block(nextL);   // 打开 next 块，后续臂条件链落于此
        }
        i = i + 1;
    }
    // 第二遍：body 块（绑定名已在 entry 绑定，无需重复 store）
    i = 0;
    while (i < nArm) {
        var arm: Node = base.nodes[armIds[i]];
        var armL: string = armLabels[i];
        tir_block(armL);
        if (as_stmt) {
            tir_emit_stmt(arm.nc);
        } else {
            var bv: string = tir_emit_expr(arm.nc);
            if (res != "") { tir_line(base.sb_cat4("store ", bv, " ", res)); }
        }
        g_term = false;   // 臂内可能有 return/break；强制补上收尾 br
        tir_line(base.sb_cat3("br ", endL, ""));
        i = i + 1;
    }
    tir_block(endL);
    if (as_stmt == false) { return res; }
    return "";
}

// ══════════════════════════════════════════════════════════════════
// 文本序列化（tir-design.md §4 / §12.1 规范真相源）
// ══════════════════════════════════════════════════════════════════

pub fn tir_esc(s: string) string {
    var sb: StringBuilder = sb_new();
    var i: u64 = 0;
    var L: u64 = str_len(s);
    while (i < L) {
        var c: u8 = s[i];
        if (c >= 32 && c <= 126 && c != 34 && c != 92) {
            sb_append_char(sb, c);
        } else {
            sb_append_char(sb, 92);   // backslash
            sb_append_char(sb, base.hex_digit(c / 16));
            sb_append_char(sb, base.hex_digit(c % 16));
        }
        i = i + 1;
    }
    return sb_to_str(sb);
}

pub fn tir_to_text() string {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "module \"");
    sb_append_str(sb, g_mod.mod);
    sb_append_str(sb, "\"\n");
    sb_append_str(sb, "source: \"");
    sb_append_str(sb, g_mod.source);
    sb_append_str(sb, "\"\n\n");

    sb_append_str(sb, "types:\n");
    var ti: i64 = 0;
    var tn: i64 = slice_len(g_mod.types) as i64;
    while (ti < tn) {
        var t: TIRType = g_mod.types[ti];
        sb_append_str(sb, "  ");
        sb_append_str(sb, t.name);
        sb_append_str(sb, " = struct { ");
        sb_append_str(sb, t.body);
        sb_append_str(sb, " }\n");
        ti = ti + 1;
    }
    sb_append_str(sb, "\n");

    if (slice_len(g_mod.strings) > 0) {
        sb_append_str(sb, "strings:\n");
        var si: i64 = 0;
        var sn: i64 = slice_len(g_mod.strings) as i64;
        while (si < sn) {
            sb_append_str(sb, "  ");
            sb_append_i64(sb, si);
            sb_append_str(sb, ": \"");
            sb_append_str(sb, tir_esc(g_mod.strings[si]));
            sb_append_str(sb, "\"\n");
            si = si + 1;
        }
        sb_append_str(sb, "\n");
    }

    var fi: i64 = 0;
    var fncount: i64 = slice_len(g_mod.funcs) as i64;
    while (fi < fncount) {
        var f: TIRFunc = g_mod.funcs[fi];
        var head: StringBuilder = sb_new();
        if (f.is_extern) { sb_append_str(head, "extern "); }
        else { sb_append_str(head, "func "); }
        sb_append_str(head, "@");
        sb_append_str(head, f.name);
        sb_append_str(head, "(");
        var pi: i64 = 0;
        var pn: i64 = slice_len(f.params) as i64;
        while (pi < pn) {
            if (pi > 0) { sb_append_str(head, ", "); }
            sb_append_str(head, f.params[pi]);
            pi = pi + 1;
        }
        sb_append_str(head, "): ");
        sb_append_str(head, f.ret_st);
        sb_append_str(sb, sb_to_str(head));
        sb_append_str(sb, "\n");
        if (f.is_extern == false) {
            sb_append_str(sb, "{\n");
            var bi: i64 = 0;
            var bn: i64 = slice_len(f.body) as i64;
            while (bi < bn) {
                var inst: TIRInst = f.body[bi];
                if (inst.is_comment) {
                    sb_append_str(sb, "  ; ");
                    sb_append_str(sb, inst.text);
                } else {
                    sb_append_str(sb, "  ");
                    sb_append_str(sb, inst.text);
                }
                sb_append_str(sb, "\n");
                bi = bi + 1;
            }
            sb_append_str(sb, "}\n\n");
        }
        fi = fi + 1;
    }
    return sb_to_str(sb);
}
