            elemst = base.nodes[arg0n].sb;
        } else {
            var rtd: i64 = sema.meta_type_of_expr(e);
            if (rtd >= 0 && rtd < slice_len(sema.tds) as i64 && sema.tds[rtd].cat == "vector") {
