// FS-4：结构化 args 构造器（每个元素 st=0，与 tir_parse_inst 经 tir_op_tok 剥离 .s 后缀一致）。
// 供机械改写脚本将 tir_line(text) 重写为 tir_emit(TIRInst{ op/st/dst/args 直填 }) 时使用。
pub fn tir_a0() []TirOperand { var __z: []TirOperand = []; return __z; }
pub fn tir_a1(n1: string) []TirOperand { var __z: []TirOperand = []; append(__z, tir_op(n1)); return __z; }
