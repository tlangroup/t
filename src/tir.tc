pub fn tir_emit_load(st: string, dst: string, src: string) TIRInst {
    var __a: []TirOperand = [];
    append(__a, tir_op(src));
    return TIRInst{ op: TIR_OP_LOAD, st: tir_st_from_str(st), dst: tir_op(dst), args: __a, is_comment: false, line: g_cur_line, cmt: "" };
}
pub fn tir_emit_addr_of(st: string, dst: string, src: string) TIRInst {
    var __a: []TirOperand = [];
    append(__a, tir_op(src));
    return TIRInst{ op: TIR_OP_ADDR_OF, st: tir_st_from_str(st), dst: tir_op(dst), args: __a, is_comment: false, line: g_cur_line, cmt: "" };
}
pub fn tir_emit_gep(st: string, dst: string, src: string, idxs: []string) TIRInst {
    var __a: []TirOperand = [];
    append(__a, tir_op(src));
    var i: i64 = 0;
    var n: i64 = slice_len(idxs) as i64;
    while (i < n) { append(__a, tir_op(idxs[i])); i = i + 1; }
    return TIRInst{ op: TIR_OP_GEP, st: tir_st_from_str(st), dst: tir_op(dst), args: __a, is_comment: false, line: g_cur_line, cmt: "" };
}
pub fn tir_emit_gep_idx(st: string, dst: string, src: string, idx: string) TIRInst {
    var __a: []TirOperand = [];
    append(__a, tir_op(src));
    append(__a, tir_op(idx));
    return TIRInst{ op: TIR_OP_GEP_IDX, st: tir_st_from_str(st), dst: tir_op(dst), args: __a, is_comment: false, line: g_cur_line, cmt: "" };
}
pub fn tir_emit_struct_new(st: string, dst: string, src: string) TIRInst {
    var __a: []TirOperand = [];
    append(__a, tir_op(src));
    return TIRInst{ op: TIR_OP_STRUCT_NEW, st: tir_st_from_str(st), dst: tir_op(dst), args: __a, is_comment: false, line: g_cur_line, cmt: "" };
}
// call 有 DST 形式：call <st> <dst> <callee> (args...)  → args=[callee, cargs...]
pub fn tir_e_call(st: string, dst: string, callee: string, cargs: []string) TIRInst {
    var __a: []TirOperand = [];
    append(__a, tir_op(callee));
    var i: i64 = 0;
    var n: i64 = slice_len(cargs) as i64;
    while (i < n) { append(__a, tir_op(cargs[i])); i = i + 1; }
    return TIRInst{ op: TIR_OP_CALL, st: tir_st_from_str(st), dst: tir_op(dst), args: __a, is_comment: false, line: g_cur_line, cmt: "" };
}
// call 无 DST 形式（全局 callee 以 @ 开头）：call <st> (callee) (args...)  → args=[callee, cargs...]
pub fn tir_emit_call_nodst(st: string, callee: string, cargs: []string) TIRInst {
    var __a: []TirOperand = [];
    append(__a, tir_op(callee));
    var i: i64 = 0;
    var n: i64 = slice_len(cargs) as i64;
    while (i < n) { append(__a, tir_op(cargs[i])); i = i + 1; }
    return TIRInst{ op: TIR_OP_CALL, st: tir_st_from_str(st), dst: tir_op(""), args: __a, is_comment: false, line: g_cur_line, cmt: "" };
}
// call_ind：call_ind <st> <dst> <fnptr> (args...)  → args=[fnptr, cargs...]（跳过括号）
pub fn tir_emit_call_ind(st: string, dst: string, fnptr: string, cargs: []string) TIRInst {
    var __a: []TirOperand = [];
    append(__a, tir_op(fnptr));
    var i: i64 = 0;
    var n: i64 = slice_len(cargs) as i64;
    while (i < n) { append(__a, tir_op(cargs[i])); i = i + 1; }
    return TIRInst{ op: TIR_OP_CALL_IND, st: tir_st_from_str(st), dst: tir_op(dst), args: __a, is_comment: false, line: g_cur_line, cmt: "" };
}
pub fn tir_emit_br(label: string) TIRInst {
    var __a: []TirOperand = [];
    append(__a, tir_op(label));
    return TIRInst{ op: TIR_OP_BR, st: ST_NONE, dst: tir_op(""), args: __a, is_comment: false, line: g_cur_line, cmt: "" };
