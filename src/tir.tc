pub fn tir_a4(n1: string, n2: string, n3: string, n4: string) []TirOperand { var __z: []TirOperand = []; append(__z, tir_op(n1)); append(__z, tir_op(n2)); append(__z, tir_op(n3)); append(__z, tir_op(n4)); return __z; }
pub fn tir_a5(n1: string, n2: string, n3: string, n4: string, n5: string) []TirOperand { var __z: []TirOperand = []; append(__z, tir_op(n1)); append(__z, tir_op(n2)); append(__z, tir_op(n3)); append(__z, tir_op(n4)); append(__z, tir_op(n5)); return __z; }
pub fn tir_a6(n1: string, n2: string, n3: string, n4: string, n5: string, n6: string) []TirOperand { var __z: []TirOperand = []; append(__z, tir_op(n1)); append(__z, tir_op(n2)); append(__z, tir_op(n3)); append(__z, tir_op(n4)); append(__z, tir_op(n5)); append(__z, tir_op(n6)); return __z; }
pub fn tir_a7(n1: string, n2: string, n3: string, n4: string, n5: string, n6: string, n7: string) []TirOperand { var __z: []TirOperand = []; append(__z, tir_op(n1)); append(__z, tir_op(n2)); append(__z, tir_op(n3)); append(__z, tir_op(n4)); append(__z, tir_op(n5)); append(__z, tir_op(n6)); append(__z, tir_op(n7)); return __z; }
pub fn tir_a8(n1: string, n2: string, n3: string, n4: string, n5: string, n6: string, n7: string, n8: string) []TirOperand { var __z: []TirOperand = []; append(__z, tir_op(n1)); append(__z, tir_op(n2)); append(__z, tir_op(n3)); append(__z, tir_op(n4)); append(__z, tir_op(n5)); append(__z, tir_op(n6)); append(__z, tir_op(n7)); append(__z, tir_op(n8)); return __z; }

// ── 循环标签栈（break/continue）──────────────────────────────────
pub fn tir_loop_push(head: string, end: string) void {
    append(g_loop_head, head);
    append(g_loop_end, end);
}
pub fn tir_loop_pop() void {
    var n: i64 = slice_len(g_loop_head) as i64;
    if (n <= 0) { return; }
    var nh: []string = [];
    var i: i64 = 0;
    while (i < n - 1) { append(nh, g_loop_head[i]); i = i + 1; }
    g_loop_head = nh;
    var ne: []string = [];
    var j: i64 = 0;
    while (j < n - 1) { append(ne, g_loop_end[j]); j = j + 1; }
    g_loop_end = ne;
}
pub fn tir_loop_top_head() string {
    var n: i64 = slice_len(g_loop_head) as i64;
    if (n > 0) { return g_loop_head[n - 1]; }
    return "";
}
pub fn tir_loop_top_end() string {
    var n: i64 = slice_len(g_loop_end) as i64;
    if (n > 0) { return g_loop_end[n - 1]; }
    return "";
}

// 小写标量类型名 → 带符号性的 ST（tir-design.md §5.1 偏离 1）
pub fn tir_scalar_st(name: string) string {
    if (name == "i8") { return "i8"; }
    if (name == "u8") { return "u8"; }
    if (name == "i16") { return "i16"; }
    if (name == "u16") { return "u16"; }
    if (name == "i32") { return "i32"; }
    if (name == "u32") { return "u32"; }
    if (name == "i64") { return "i64"; }
    if (name == "u64") { return "u64"; }
    if (name == "f32") { return "f32"; }
    if (name == "f64") { return "f64"; }
    if (name == "bool") { return "i8"; }     // 存储型 i8（tir-design.md §5.2）
    if (name == "atom" or name == "fid") { return "u64"; }
    if (name == "char") { return "i8"; }
    // 任意位宽整数 > 64（u128 / i128 及更宽）：LLVM 原生 i<N>，与 C 的 _BitInt(N) 逐位一致。
    // 缺此分支会回落到 i64，造成 128 位值被截断（awi_demo：b=2^128-1 丢高 64 位 → 地址垃圾）。
    var ab: i64 = base.awi_bits(name);
    if (ab > 64) { return base.sb_cat3("i", base.i2s(ab), ""); }
    return "i64";
}

// TD → ST 映射（tir-design.md §7，对齐 ll_td 但输出 TIR 记号）
// A-fix：识别「注入合成的反射变体」（当前仅 TypeInfo）。
// 背景：ensure_reflection_builtins 把 TypeInfo 登记在 **global_scope 的 sym** 上，刻意不放进
// lex.decl_list（放进去会与反射支持硬编码的 `%TypeInfo = type { i64, ptr }` 重复定义，
// 见 sema.ensure_reflection_builtins 注释）。于是所有「按名字回查 decl_list」的判定
// （t_td_is_variant / t_variant_decl_of_name）对它恒假 ⇒ tir_emit_match 认不出 scrutinee 是
// 变体 ⇒ **整条模式条件链被跳过** ⇒ 入口退化成 `br label <首臂>`，任何 TypeInfo 的 match
// 都无条件命中第一个 arm（即使运行时 tag 不同）。此处按 sym 的 decl 节点回退判定。
pub fn tir_is_reflection_variant(td: i64) bool {
    if (td < 0) { return false; }
    if (td >= slice_len(sema.tds) as i64) { return false; }
    if (sema.tds[td].name != "TypeInfo") { return false; }
    var rsi: i64 = sema.sym_lookup(sema.global_scope, "TypeInfo");
    if (rsi < 0) { return false; }
    var rsd: i64 = sema.syms[rsi].decl;
    if (rsd < 0) { return false; }
    return base.node_kind((rsd as u64)) == "VariantDecl";
}

// 判断 TD 是否为变体类型。注意：sema.tip_kind 读 tis[]（TypeInfo 索引），而此处 td 是
// sema.tds[]（TypeDef 索引），二者不可混用；故直接扫 decl_list 的 VariantDecl 判定。
// ⚠ A-fix：除手写 VariantDecl 外，还须覆盖「注入合成的反射变体」（tir_is_reflection_variant）。
// 这是**唯一真相源**——下游 8 个调用点（tir_st_of_td / tir_st_value_of_td / 变体全局初始化 /
// 构造器 sret / 实参 ABI / match 条件链）全部依赖本判定。漏掉 TypeInfo 会让
// tir_st_of_td 回落 `t.cat=="named"` 分支返回 `%TypeInfo`（值槽），而 type_info(T) 的
// TIR_OP_TYPEINFO 返回的是**指向 variant 数据的指针** ⇒ 变量槽存的是地址，后续
// `load i64` 读到地址本身去和 tag 常量比较 ⇒ 条件恒假、全部落 `_` 兜底臂。
pub fn t_td_is_variant(td: i64) bool {
    if (td < 0) { return false; }
    if (td >= slice_len(sema.tds) as i64) { return false; }
    var t: TD = sema.tds[td];
    if (t.cat != "named") { return false; }
    if (tir_is_reflection_variant(td)) { return true; }
    var n: i64 = slice_len(lex.decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = lex.decl_list[i];
        if (base.node_kind((d as u64)) == "VariantDecl" and base.node_sa((d as u64)) == t.name) { return true; }
        i = i + 1;
    }
    return false;
}

// A-fix：变体 case 所在的 VariantDecl 反查，覆盖「注入合成变体」（decl_list 回退，见上）。
pub fn t_variant_decl_of_name_ex(vname: string) i64 {
    var dv: i64 = t_variant_decl_of_name(vname);
    if (dv >= 0) { return dv; }
    if (vname == "TypeInfo") {
        var esi: i64 = sema.sym_lookup(sema.global_scope, "TypeInfo");
        if (esi >= 0 and sema.syms[esi].decl >= 0 and base.node_kind((sema.syms[esi].decl as u64)) == "VariantDecl") {
            return sema.syms[esi].decl;
        }
    }
    return -1;
}

// 判断 TD 是否为枚举类型。⚠ 与 t_td_is_variant 同构：引擎对「用户具名类型」一律登记
// cat=="named"（cat=="enum" 只出现在极少数字面 TD 上），故仅判 cat=="enum" 恒为假——
// 这正是「enum scrutinee 的 match 恒命中首臂」的根因：模式条件返回空串 → 整条条件链被跳过
// → 入口变成 `br label <首臂>`。必须按 named TD 的 name 回查 decl_list 的 EnumDecl。
pub fn t_td_is_enum(td: i64) bool {
    if (td < 0) { return false; }
    if (td >= slice_len(sema.tds) as i64) { return false; }
    var t: TD = sema.tds[td];
    if (t.cat == "enum") { return true; }
    if (t.cat != "named") { return false; }
    if (t.name == "") { return false; }
    var n: i64 = slice_len(lex.decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = lex.decl_list[i];
        if (base.node_kind((d as u64)) == "EnumDecl" and base.node_sa((d as u64)) == t.name) { return true; }
        i = i + 1;
    }
    return false;
}
// 按变体名查找 VariantDecl 节点索引（emit 期 lex.decl_list 可靠，无需 sym 表）。
pub fn t_variant_decl_of_name(vname: string) i64 {
    if (vname == "") { return -1; }
    var n: i64 = slice_len(lex.decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = lex.decl_list[i];
        if (base.node_kind((d as u64)) == "VariantDecl" and base.node_sa((d as u64)) == vname) { return d; }
        i = i + 1;
    }
    return -1;
}
// 按变体 case/ident 名反查其所属变体名（emit 期 lex.decl_list 可靠，无需 sym 表）。
pub fn t_variant_name_of_case(cname: string) string {
    if (cname == "") { return ""; }
    var n: i64 = slice_len(lex.decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = lex.decl_list[i];
        if (base.node_kind((d as u64)) == "VariantDecl") {
            var cc: i64 = base.node_lb((d as u64));
            // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
            var cc_ks: []i64 = base.kids_chain(cc);
            var cc_ki: i64 = 0;
            while (cc_ki < slice_len(cc_ks) as i64) {
                var cc_kv: i64 = cc_ks[cc_ki];
                if (base.node_sa((cc_kv as u64)) == cname) { return base.node_sa((d as u64)); }
                cc_ki = cc_ki + 1;
            }
        }
        i = i + 1;
    }
    return "";
}
pub fn tir_st_of_td(td: i64) string {
    if (td < 0) { return "i64"; }
    // ⚠ 越界 TD 索引掩盖（meta_type_of_expr+resolve_type_desc 潜伏缺陷：偶发返回 == TD 表长的越界索引，
    // 多因 node.td 缓存值取自更大 sema.tds 上下文后该表被重置/收窄。对齐 tir_maybe_array_to_slice 既有范式）。
    if (td >= slice_len(sema.tds) as i64) { return "i64"; }
    var t: TD = sema.tds[td];
    if (t_td_is_variant(td)) { return base.sb_cat3("ptr<%", t.name, ">"); }   // 变体值统一以指针形态流转（对齐 struct_new/匹配提取）
    if (t.cat == "string" or t.cat == "bytes") { return "%TStr"; }
    if (t.cat == "pointer") {
        if (t.memspace > 0) { return "i64"; }   // 设备指针句柄（不透明 i64）
        return base.sb_cat3("ptr<", tir_st_of_td(t.elem), ">");
    }
    if (t.cat == "slice") { return "%TSlice"; }
    if (t.cat == "array") {
        var an: i64 = t.alen;
        if (an < 0) { an = 0; }
        return base.sb_cat5("arr<", tir_st_of_td(t.elem), " x ", base.i2s(an), ">");
    }
    if (t.cat == "vector") {
        var vln: i64 = t.alen;
        if (vln < 1) { vln = 1; }
        return base.sb_cat5("vec<", tir_st_of_td(t.elem), " x ", base.i2s(vln), ">");
    }
    if (t.cat == "tile") {
        // 瓦片 = 嵌套定长数组：outer arr<row x rows>，row = arr<elem x cols>
        var rows: i64 = t.alen;
        if (rows < 0) { rows = 0; }
        var trow: i64 = t.elem;
        var cols: i64 = 0;
        var scalar_st: string = "i64";
        if (trow >= 0 and trow < slice_len(sema.tds) as i64) {
            cols = sema.tds[trow].alen;
            scalar_st = tir_st_of_td(sema.tds[trow].elem);
        }
        if (cols < 0) { cols = 0; }
        var rowst: string = base.sb_cat5("arr<", scalar_st, " x ", base.i2s(cols), ">");
        return base.sb_cat5("arr<", rowst, " x ", base.i2s(rows), ">");
    }
    if (t.cat == "map") { return "ptr<void>"; }
    if (t.cat == "bitstr") { return "%TBitStr"; }   // 位串（§15）：与 TStr/TSlice 同构，LLVM 侧为聚合 {ptr,i64,i64}
    // O-6：opt.tagged —— 按值 `{ i64 __tag, E __val }`，零分配（取代 opt.boxed 的 ptr<E> 装箱）。
    if (t.cat == "optional") { return tir_ensure_opt_tagged(tir_st_of_td(t.elem)); }
    if (t.cat == "sym") {
        if (t.alen == 16) { return "u16"; }
        if (t.alen == 64) { return "u64"; }
        return "u32";
    }
    if (t.cat == "func") { return "ptr<void>"; }
    if (t.cat == "void") { return "void"; }
    if (t.cat == "scalar") {
        if (t.name == "") { return "i64"; }
        return tir_scalar_st(t.name);
    }
    if (t.cat == "named") {
        if (t.name == "") { return "ptr<void>"; }
        return base.sb_cat2("%", t.name);    // 具名聚合 → %Name（偏离 3）
    }
    return "i64";
}

// 值布局存储型（与 tir_st_of_td 同构，但变体返回 %Name 而非 ptr<%Name>）。
// 变体在函数 ABI 里以指针形态流转（tir_st_of_td 返回 ptr<%V>），但在切片/数组里
// 是「按值存储」的 %V（8(tag) + mx 字节）。for-each / 下标 GEP 步长必须按值布局算，
// 否则 stride 退化为 8（指针尺寸）→ []Variant 元素错位 → 段错误
// （examples/shapes.tc：%Shape=24 字节，却按 8 字节步长寻址）。
pub fn tir_st_value_of_td(td: i64) string {
    if (td < 0) { return "i64"; }
    if (td >= slice_len(sema.tds) as i64) { return "i64"; }
    if (t_td_is_variant(td)) { return base.sb_cat2("%", sema.tds[td].name); }
    return tir_st_of_td(td);
}

pub fn tir_strip_pct(s: string) string {
    if (str_len(s) > 0 and s[0] == 37) { return str_slice(s, 1, str_len(s)); }
    return s;
}

// 表达式 → TD（emit 期可靠）：
//  - ident 局部/形参：直接取本模块维护的 g_local_tds（符号表在 emit 期无效，不可 sym_lookup）
//  - 其它（member/index/call/cast/struct_lit/...）：用 sema.meta_type_of_expr 推断
//  - 字面量不进 meta_type_of_expr（其 u8 推断会把 const.i64 改成 const.u8，破坏 Stage 0+1 基线）

// 按类型名查 TypeDef 索引（named 类型，含 variant）。用于变体构造器调用绕过 meta_type_of_expr。
pub fn t_td_of_named(vname: string) i64 {
    var m: i64 = slice_len(sema.tds) as i64;
    var i: i64 = 0;
    while (i < m) {
        if (sema.tds[i].cat == "named" and sema.tds[i].name == vname) { return i; }
        i = i + 1;
    }
    return -1;
}

// 判定 e 是否为变体构造器调用（callee 为 ident 且名为 <V>_from_<C>，且 <V> 确为已声明变体）。
// 返回变体名；非构造器调用返回 ""。
pub fn tir_is_variant_ctor_call(e: i64) string {
    if (e < 0) { return ""; }
    if (base.node_kind((e as u64)) != "call") { return ""; }
    if (base.node_na((e as u64)) < 0) { return ""; }
    if (base.node_kind((base.node_na((e as u64)) as u64)) != "ident") { return ""; }
    var cname: string = base.node_sa((base.node_na((e as u64)) as u64));
    var L: i64 = str_len(cname) as i64;
    var k: i64 = 0;
    while (k < L) {
        if (k + 6 <= L and str_slice(cname, k, k + 6) == "_from_") {
            var vn: string = str_slice(cname, 0, k);
            if (t_variant_decl_of_name(vn) >= 0) { return vn; }
            return "";
        }
        k = k + 1;
    }
    return "";
}

// 返回 "atom" 标量类型的 TD 索引（首次扫描后缓存到 g_atom_td）。
// 仅用于 serialize/deserialize 选择器对齐旧轨 ser_sel；运行时序列化按 atom id 走 tll_ser_atom。
var g_atom_td: i64 = -1;
pub fn tir_atom_td() i64 {
    if (g_atom_td >= 0) { return g_atom_td; }
    var n: i64 = slice_len(sema.tds) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (sema.td_sname(i) == "atom") { g_atom_td = i; return i; }
        i = i + 1;
    }
    return -1;
}

pub fn tir_expr_td(e: i64) i64 {
    if (e < 0) { return -1; }
    // 原子字面量 :x 的类型恒为 64 位标量 "atom"。其 node.td 缓存与 meta_type_of_expr
    // 在 N 轨下常回落到非 atom TD（导致 serialize 误判为 int），故在此直接返回 atom TD。
    // 注意：此处 base.node_kind(e) 为单层调用，且本函数无 TirEmitRes 局部，
    // 旧轨 emit-ll 不会触发 str_eq 槽位冲突 / null 指针访问。
    if (base.node_kind((e as u64)) == "atom") { return tir_atom_td(); }
    // 结构体字面量：类型即其命名类型 n0.sa（如 Pt{...} → Pt TD）。
    // 此前无此分支 → 落到下方 meta_type_of_expr，经 .td 缓存（line 1033）易取到脏标量 TD，
    // 使 match 返回结构体时 __mres 槽退化为 i64 → 槽宽不足 / IR 类型不匹配
    //（match_return_struct：store %Pt … ptr %__mres(alloca i64) + load i64 误编）。
    if (base.node_kind((e as u64)) == "struct_lit") {
        var sl_td: i64 = t_td_of_named(base.node_sa((e as u64)));
        if (sl_td >= 0) { return sl_td; }
    }
    // P1 Stage 1b：多语句值块的 TD = **尾随表达式**的 TD（与 codegen_c 的
    // expr_type_desc 同构）。缺这一支会落到 meta_type_of_expr，值块返回非 i64
    // 时可能拿到脏标量 TD → __mres / _tmrN 槽宽退化（笔记第 20 条同类问题）。
    if (base.node_kind((e as u64)) == "block_expr") {
        var be_c3: i64 = base.node_la((e as u64));
        var be_lv3: i64 = -1;
        while (be_c3 >= 0) {
            be_lv3 = base.kids[be_c3].val;
            be_c3 = base.kids[be_c3].next;
        }
        if (be_lv3 >= 0 and base.node_kind((be_lv3 as u64)) == "expr") {
            var be_td: i64 = tir_expr_td(base.node_na((be_lv3 as u64)));
            if (be_td >= 0) { return be_td; }
        }
    }
    // P5：() 空元组字面量 = unit 值，类型即 void TD（与 codegen_c 的 expr_type_desc 同构）。
    if (base.node_kind((e as u64)) == "unit_lit") { return sema.td_mk("void"); }
    // `++` 集合合并（§15.6）：结果类型 **不能**沿用「二元运算取左操作数类型」的常规推导。
    // 定长数组 [N]T ++ [M]T ⇒ [N+M]T，与左右操作数都不同。取左型会让结果槽按 [N x T] 分配
    // 却被写入 N+M 个元素（写穿邻槽），且下游只拷回前 N 个（实测拼接结果 `10 20 30 0 0`）。
    // String/Slice/BitStr 合并后类型与左操作数一致，无需特判。
    // ⚠ 必须放在下方 node.td 缓存早返回之前：缓存里可能已残留「左操作数」的错误 TD。
    if (base.node_kind((e as u64)) == "binary" and base.node_sa((e as u64)) == "Concat") {
        var arrcat_ltd: i64 = tir_expr_td(base.node_na((e as u64)));
        var arrcat_rtd: i64 = tir_expr_td(base.node_nb((e as u64)));
        if (arrcat_ltd >= 0 and arrcat_rtd >= 0 and
            arrcat_ltd < slice_len(sema.tds) as i64 and arrcat_rtd < slice_len(sema.tds) as i64) {
            if (sema.tds[arrcat_ltd].cat == "array" and sema.tds[arrcat_rtd].cat == "array") {
                var arrcat_ot: i64 = sema.td_elem_mk("array", sema.tds[arrcat_ltd].elem);
                var arrcat_td: TD = sema.tds[arrcat_ot];
                arrcat_td.alen = sema.tds[arrcat_ltd].alen + sema.tds[arrcat_rtd].alen;
                slice_set(sema.tds, arrcat_ot, arrcat_td);
                return arrcat_ot;
            }
        }
    }
    // v3 §5.3：优先读 HIR 类型槽（sema 一次性填入），避免每次重推导 + 影子表反推。
    // ⚠ 缓存值须做越界检查：node.td 可能取自更大 sema.tds 上下文的残留索引，直接返回会毒化下游 sema.tds[td] 索引。
    var cached_td: i64 = base.node_type(e);
    if (cached_td > 0 and cached_td < slice_len(sema.tds) as i64) { return cached_td; }
    if (cached_td > 0) { base.node_set_type(e, -1); }   // 越界缓存：丢弃，回落下方重新推导
    var d: i64 = -1;
    // 变体构造器调用 V_from_C：直接返回变体 TD，绕过 meta_type_of_expr。
    // 构造器在 emit 期才合成、符号表的 decl 指向越界节点 → 走常规路径会 index_out_of_bounds。
    if (base.node_kind((e as u64)) == "call") {
        var vn: string = tir_is_variant_ctor_call(e);
        if (vn != "") { d = t_td_of_named(vn); }
    }
    // 内建调用：variant 构造器未命中时，优先走 builtin_ret_td 单一真相源（meta_type_of_expr 退化为错类型）。
    if (d < 0 and base.node_kind((e as u64)) == "call") {
        if (base.node_kind((base.node_na((e as u64)) as u64)) == "ident") {
            var brt: i64 = builtin_ret_td(base.node_sa((base.node_na((e as u64)) as u64)));
            if (brt >= 0) { d = brt; }
        }
    }
    if (d < 0 and base.node_kind((e as u64)) == "ident") {
        var idx: i64 = tir_find_local_idx(base.node_sa((e as u64)));
        if (idx >= 0) { d = g_local_tds[idx]; }
    }
    // 结构体字段访问（member）：用基底类型 + 字段名查字段 TD。
    // ⚠ 缺此分支时 tir_expr_td(c.opts) 退化到 meta_type_of_expr 返回错类型（i64），
    // 导致 map 索引读 tir_emit_index_addr 永不进入 cat=="map" 分支 → 返回 0（c.opts[k] 恒为 0）。
    // ⚠ 注意：tir_expr_td 顶部有 node.td 缓存早返回，member 节点 .td 易残留污染，
    //   故本分支对「缓存命中但类型不对」的情况无效；map 索引读路径在 tir_emit_index_addr 另做强制校正。
    if (d < 0 and base.node_kind((e as u64)) == "member") {
        var base_e: i64 = base.node_na((e as u64));
        var btd: i64 = tir_expr_td(base_e);
        if (btd >= 0) {
            var bst: string = tir_st_of_td(btd);
            if (str_len(bst) > 0 and bst[0] == '%') {
                var sname: string = str_slice(bst, 1, str_len(bst));
                d = tir_field_td(sname, base.node_sa((e as u64)));
            }
        }
    }
    // 嵌套索引 m[k1][k2]：lhs.na 是 index 节点（非 ident），meta_type_of_expr 在发射期
    // cur_scope 非本函数作用域 → sym_lookup 取不到局部 → 返回 -1。直接递归 tir_expr_td
    // （ident 分支走 g_local_tds，与 cur_scope 无关）并从 TD 的 val/elem 取元素类型。
    if (d < 0 and base.node_kind((e as u64)) == "index") {
        var btd: i64 = tir_expr_td(base.node_na((e as u64)));
        if (btd >= 0 and sema.tds[btd].cat == "map") { d = sema.tds[btd].val; }
        else if (btd >= 0 and (sema.tds[btd].cat == "array" or sema.tds[btd].cat == "slice")) { d = sema.tds[btd].elem; }
    }
    if (d < 0) {
        var tnode: i64 = sema.meta_type_of_expr(e);
        if (tnode >= base.node_count()) { }
        if (tnode >= 0) { d = sema.resolve_type_desc(tnode); }
    }
    // ⚠ 越界 TD 索引掩盖（潜伏缺陷）：resolve_type_desc 偶发返回越界索引，须拦下，否则下游 sema.tds[td] panic。
    if (d >= slice_len(sema.tds) as i64) { d = -1; }
    if (d > 0) { base.node_set_type(e, d); }   // 回填类型槽：后续查询走槽而非影子表
    return d;
}

pub fn tir_expr_st(e: i64) string {
    if (e < 0) { return "i64"; }
    var kd: string = base.node_kind((e as u64));
    // 局部/形参：优先读 HIR 类型槽（S1 预标注已填），影子表 `g_local_sts` 仅兜底
    if (kd == "ident") {
        // ⚠ 缓存的 node.td 须越界检查；越界则丢弃并回落影子表 g_local_sts（持有本模块真实发射类型）。
        var ntd: i64 = base.node_type(e);
        if (ntd > 0 and ntd < slice_len(sema.tds) as i64) { return tir_st_of_td(ntd); }
        // ⚠ 严格等价说明：原 `n.td = -1` 写在 `var n: Node = base.nodes[e]` 的**值拷贝**上，从未写回
        // nodes[]（且此后不再读 n.td），故无实际效果；迁侧表时不得升级为 node_set_type，否则改变行为。
        // 越界缓存的真正回收点在上方 tir_expr_td 顶部（base.node_set_type(e, -1)），语义已对齐。
        var idx: i64 = tir_find_local_idx(base.node_sa((e as u64)));
        if (idx >= 0) {
            // 影子表理论上同步（tir_new_named_slot 四表同时 append），此处为防御性上界保护。
            if (idx >= slice_len(g_local_sts) as i64) { return "i64"; }
            return g_local_sts[idx];
        }
    }
    // 字面量保持旧行为（避免 meta_type_of_expr 的 u8 推断改变 const 宽度，破坏基线）
    if (kd == "float") {
        // 浮点字面量按上下文真实类型（f32/f64）发射：否则 `var x: float = 1.5` 会存成
        // f64 常量进 f32 槽 → 值错配（literal_demo: single=1.5 打成 -1.1e-17）。
        // 越界/非浮点 TD 回落 f64，避免 tir_st_of_td(-1)→i64 误编。
        var ftd: i64 = sema.resolve_type_desc(e);
        var fst: string = tir_st_of_td(ftd);
        if (fst == "f32" or fst == "f64") { return fst; }
        return "f64";
    }
    // 字符串/字节字面量在 TIR ABI 中恒为 %TStr（tir_st_of_td 的 cat=="string"/"bytes" 分支亦如此）。
    // 直接返回，避免 meta_type_of_expr/resolve_type_desc 对字面量推断退化成 i64，
    // 否则 match 返回 string/struct 时 __mres 槽宽不足（8 字节 i64 槽存 16 字节 %TStr）→ 返回脏结构。
    if (kd == "string" or kd == "bytes") { return "%TStr"; }
    if (kd == "int" or kd == "bool" or kd == "char" or
        kd == "null" or kd == "opt_none") {
        return tir_st_of_td(sema.resolve_type_desc(e));
    }
    // 其它表达式：用 meta_type_of_expr 推断
    var td: i64 = tir_expr_td(e);
    if (td >= 0) { return tir_st_of_td(td); }
    return "i64";
}

// 索引元素存储型：slice/array/vector → 元素 ST；string/bytes → i8；其余退化为 i64
pub fn tir_elem_st(td: i64) string {
    if (td < 0) { return "i64"; }
    // ⚠ 越界 TD 索引掩盖（同 tir_st_of_td 范式）：否则 match_demo 等用例 sema.tds[td] panic。
    if (td >= slice_len(sema.tds) as i64) { return "i64"; }
    var t: TD = sema.tds[td];
    if (t.cat == "string" or t.cat == "bytes") { return "i8"; }
    if (t.cat == "slice") { return tir_st_of_td(t.elem); }
    if (t.cat == "array") { return tir_st_of_td(t.elem); }
    if (t.cat == "vector") { return tir_st_of_td(t.elem); }
    if (t.cat == "map") { return tir_st_of_td(t.val); }
    return "i64";
}

// ══════════════════════════════════════════════════════════════════
// 局部符号表
// ══════════════════════════════════════════════════════════════════

pub fn tir_find_local_idx(name: string) i64 {
    var n: i64 = slice_len(g_local_names) as i64;
    var i: i64 = n - 1;
    while (i >= 0) {
        if (g_local_names[i] == name and i < slice_len(g_local_depths) as i64 and g_local_depths[i] <= g_blk_depth) { return i; }
        i = i - 1;
    }
    return -1;
}

// 块作用域进出：见 g_blk_depth 注释。TIR 无 {} 结构，须显式维护嵌套深度。
pub fn tir_blk_push() void {
    g_blk_depth = g_blk_depth + 1;
}

pub fn tir_blk_pop() void {
    if (g_blk_depth > 0) { g_blk_depth = g_blk_depth - 1; }
}

// 判定 name 是否为模块内某个函数（含泛型/库函数）的名字。
// 用于函数值作为闭包值（ptr<void>）包裹成 %TClosure 的判定。
pub fn tir_is_func_name(name: string) bool {
    var m: i64 = slice_len(g_tir_func_names) as i64;
    var i: i64 = 0;
    while (i < m) {
        if (g_tir_func_names[i] == name) { return true; }
        i = i + 1;
    }
    return false;
}

// 查被调函数第 argidx 个形参的类型 TD。
// call 实参为 array_lit 时，按形参是否定长数组决定降级为 arr<elem x N> 还是 %TSlice。
pub fn tir_callee_param_td(cname: string, argidx: i64) i64 {
    var m: i64 = slice_len(g_tir_func_names) as i64;
    var i: i64 = 0;
    while (i < m) {
        if (g_tir_func_names[i] == cname) {
            var fd: i64 = g_tir_func_decls[i];
            var c: i64 = base.node_lb((fd as u64));
            var j: i64 = 0;
            while (c >= 0) {
                if (j == argidx) {
                    var ptd: i64 = sema.resolve_type_desc(base.node_na((base.kids[c].val as u64)));
                    // ⚠ 越界 TD 索引掩盖（resolve_type_desc 潜伏缺陷：偶发返回越界索引，
                    // 直接作 sema.tds[aptd] 索引会 panic）。越界则视为无类型信息，回落调用点兜底。
                    if (ptd >= slice_len(sema.tds) as i64) { return -1; }
                    return ptd;
                }
                j = j + 1;
                c = base.kids[c].next;
            }
            return -1;
        }
        i = i + 1;
    }
    return -1;
}

pub fn tir_new_named_slot(td: i64, st: string, name: string) string {
    var slot: string = base.sb_cat2("$", name);
    var idx: i64 = tir_find_local_idx(name);
    if (idx >= 0) {
        // 同作用域重名（shadowing）：唯一化 slot 名，避免文本歧义
        slot = base.sb_cat4("$", name, "__", base.i2s(g_slotc));
        g_slotc = g_slotc + 1;
    }
    append(g_local_names, name);
    append(g_local_slots, slot);
    append(g_local_sts, st);
    append(g_local_tds, td);
    append(g_local_depths, g_blk_depth);
    // ⚠ 飞地规避：把槽名同时放进 args[0]（字符串常量）。译器 TIR_OP_SLOT 改从 inst.args[0].name
    // 读取（inst.dst.name 在巨型模块 tir_to_ll.tc 的 SLOT 分支被种子错编成函数名 "main"，
    // 而 inst.args[0].name 在该分支读取正确，见 generics_demo/fid_read_demo/map_iter）。
    tir_emit(TIRInst{ op: TIR_OP_SLOT, st: tir_st_from_str(st), dst: tir_op(slot), args: tir_a1(slot), is_comment: false, line: g_cur_line, cmt: slot });
    return slot;
}

// ══════════════════════════════════════════════════════════════════
// TT 类型表构建
// ══════════════════════════════════════════════════════════════════

pub fn tir_add_std_types() void {
    append(g_mod.types, TIRType{ name: "%TStr", body: "f0: ptr<i8>, f1: i64" });
    append(g_mod.types, TIRType{ name: "%TSlice", body: "f0: ptr<void>, f1: i64, f2: i64, f3: i64" });
    append(g_mod.types, TIRType{ name: "%TClosure", body: "f0: ptr<void>, f1: ptr<void>" });
    append(g_mod.types, TIRType{ name: "%TBitStr", body: "f0: ptr<i8>, f1: i64, f2: i64" });
}

// 字段 ST：尽力从字段类型节点解析（非标量退化为 i64；TT 可读性为主，顺序才关键）
pub fn tir_field_st(structname: string, fieldname: string) string {
    // P5：packed struct 的「字段」是宿主整型本身（单 host 字段，索引恒 0）。
    var pk: i64 = sema.pk_find_struct(structname);
    if (pk >= 0) { return sema.pk_host_st(sema.pk_struct_under[pk]); }
    var fh: i64 = sema.find_struct_fields(structname);
    if (fh < 0) { return "i64"; }
    var c: i64 = fh;
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
    var c_ks: []i64 = base.kids_chain(c);
    var c_ki: i64 = 0;
    while (c_ki < slice_len(c_ks) as i64) {
        var c_kv: i64 = c_ks[c_ki];
        if (base.node_sa((c_kv as u64)) == fieldname) {
            if (base.node_na((c_kv as u64)) >= 0) {
                var ft: i64 = sema.resolve_type_desc(base.node_na((c_kv as u64)));
                if (ft >= 0) { return tir_st_of_td(ft); }
            }
            return "i64";
        }
        c_ki = c_ki + 1;
    }
    return "i64";
}

pub fn tir_field_td(structname: string, fieldname: string) i64 {
    var fh: i64 = sema.find_struct_fields(structname);
    if (fh < 0) { return -1; }
    var c: i64 = fh;
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
    var c_ks: []i64 = base.kids_chain(c);
    var c_ki: i64 = 0;
    while (c_ki < slice_len(c_ks) as i64) {
        var c_kv: i64 = c_ks[c_ki];
        if (base.node_sa((c_kv as u64)) == fieldname) {
            if (base.node_na((c_kv as u64)) >= 0) { return sema.resolve_type_desc(base.node_na((c_kv as u64))); }
            return -1;
        }
        c_ki = c_ki + 1;
    }
    return -1;
}

// A-fix 0c：member 表达式（含 `s[i].f` 链）的**字段 TD**，供「发射前必须先知道类型」的
// 场景（match 结果槽 __mres）使用。返回 -1 表示无法判定，调用方回落原逻辑。
//
// ⚠ 为何不能复用 tir_member_base_st：它对 index 基底返回全局 `g_idx_elem_st`，而那是
// **上一次索引发射**留下的值 —— TD 推断发生在发射之前，读到的是脏数据。故此处沿
// member 链自己递归解析，不碰该全局。
// ⚠ 指针接收者（如 TypeInfo arm 载荷 `*TypeMeta`）须剥一层 `ptr<…>`，与
// tir_member_addr 的自动解引用约定保持一致。
// A-fix 0c：取「变体 arm 的载荷 TD」（如 TypeInfo.Struct 的 `*TypeMeta`）。
// 用于 conpat 载荷绑定的槽尚未创建时，为 member 链提供根类型。
pub fn tir_conpat_payload_root_td(scr_td: i64, armId: i64) i64 {
    if (scr_td < 0 or scr_td >= slice_len(sema.tds) as i64) { return -1; }
    if (t_td_is_variant(scr_td) == false) { return -1; }
    if (armId < 0) { return -1; }
    if (base.node_na((armId as u64)) < 0) { return -1; }
    if (base.node_kind((base.node_na((armId as u64)) as u64)) != "conpat") { return -1; }
    var vd: i64 = t_variant_decl_of_name_ex(sema.tds[scr_td].name);
    if (vd < 0) { return -1; }
    var cname: string = base.node_sa((base.node_na((armId as u64)) as u64));
    var vc: i64 = sema.variant_find_case(vd, cname);
    if (vc < 0) { return -1; }
    if (base.node_na((vc as u64)) < 0) { return -1; }
    var ptd: i64 = sema.resolve_type_desc(base.node_na((vc as u64)));
    if (ptd < 0 or ptd >= slice_len(sema.tds) as i64) { return -1; }
    return ptd;
}

pub fn tir_member_expr_td(e: i64) i64 {
    return tir_member_expr_td2(e, -1);
}
pub fn tir_member_expr_td2(e: i64, root_td: i64) i64 {
    if (e < 0) { return -1; }
    if (base.node_kind((e as u64)) != "member") { return -1; }
    var bn: i64 = base.node_na((e as u64));
    var btd: i64 = -1;
    if (base.node_kind((bn as u64)) == "index") {
        // s[i].f：元素类型 = 切片/数组基底的 elem（基底本身可能又是一条 member 链）
        btd = tir_member_expr_td2(base.node_na((bn as u64)), root_td);
        if (btd < 0) { btd = tir_expr_td(base.node_na((bn as u64))); }
        if (btd < 0 or btd >= slice_len(sema.tds) as i64) { return -1; }
        var bcat: string = sema.tds[btd].cat;
        if (bcat != "slice" and bcat != "array") { return -1; }
        btd = sema.tds[btd].elem;
    } else if (base.node_kind((bn as u64)) == "member") {
        btd = tir_member_expr_td2(bn, root_td);
    } else {
        btd = tir_expr_td(bn);
        // ⚠ 链根是 **conpat 载荷绑定**（如 `Struct(m)` 的 m）时，其槽由后文 5700 行的
        // 预声明循环创建，**晚于** match 结果槽 __mres 的分配 ⇒ 此处 tir_expr_td 拿不到
        // （-1 或 unknown）。故由调用方把「该 arm 的载荷 TD」作为 root_td 传进来兜底。
        var btd_bad: bool = (btd < 0 or btd >= slice_len(sema.tds) as i64);
        if (btd_bad == false) { if (sema.tds[btd].cat == "unknown") { btd_bad = true; } }
        if (btd_bad and root_td >= 0) { btd = root_td; }
    }
    if (btd < 0 or btd >= slice_len(sema.tds) as i64) { return -1; }
    var bst: string = tir_st_of_td(btd);
    if (str_len(bst) > 4 and str_slice(bst, 0, 4) == "ptr<") {
        bst = str_slice(bst, 4, str_len(bst) - 1);
    }
    if (str_len(bst) == 0 or bst[0] != '%') { return -1; }
    return tir_field_td(str_slice(bst, 1, str_len(bst)), base.node_sa((e as u64)));
}

pub fn tir_field_index(structname: string, fieldname: string) i64 {
    // P5：packed struct 的字段全部落在宿主整型（单 host 字段，索引恒 0）。
    if (sema.pk_find_struct(structname) >= 0) { return 0; }
    var fh: i64 = sema.find_struct_fields(structname);
    if (fh < 0) { return 0; }
    var c: i64 = fh;
    var idx: i64 = 0;
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
    var c_ks: []i64 = base.kids_chain(c);
    var c_ki: i64 = 0;
    while (c_ki < slice_len(c_ks) as i64) {
        var c_kv: i64 = c_ks[c_ki];
        if (base.node_sa((c_kv as u64)) == fieldname) { return idx; }
        idx = idx + 1;
        c_ki = c_ki + 1;
    }
    return 0;
}

// 构造一个 %TClosure 值（与 TClosure ABI 一致），返回 ptr<void> 槽。
// fnref：函数指针值文本（如 "@__lam_0" 或 "$fnptr"）；envref：环境指针值文本，"" 表示 null 环境。
// 设计锚点：tir-design.md §6.6 closure_new / §6.7 call_ind / %TClosure={fnptr,envptr}。
// ⚠ %TClosure 必须**堆分配**：闭包值可逃逸出创建帧（如 make_adder 返回闭包），若栈分配则
// 返回后指针悬垂 → use-after-free（call_ind 经 field0/field1 读垃圾 → 段错误）。
// 对齐 codegen_ll.tc:1652 的 call ptr @t_alloc(i64 sizeof(%TClosure))；sizeof(%TClosure)=16（双 ptr）。
pub fn tir_make_closure_value(fnref: string, envref: string) string {
    var szslot: string = tir_tmp();
    tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str("i64"), dst: tir_op(szslot), args: tir_a1("16"), is_comment: false, line: g_cur_line, cmt: "" });
    var heap: string = tir_tmp();   // t_alloc 返回 ptr<void>（堆 %TClosure）
    tir_emit(tir_e_call("ptr<void>", heap, "@t_alloc", [szslot]));
    var cloaddr: string = tir_tmp();  // 降到 ptr<%TClosure> 供字段 GEP（translator 据此索引 %TClosure）
    tir_emit(tir_emit_bitcast("ptr<%TClosure>", cloaddr, heap));
    var fpaddr: string = tir_tmp();
    tir_emit(TIRInst{ op: TIR_OP_GEP, st: tir_st_from_str("ptr<void>"), dst: tir_op(fpaddr), args: tir_a3(cloaddr, "0", "0"), is_comment: false, line: g_cur_line, cmt: "" });
    tir_emit(TIRInst{ op: TIR_OP_STORE, st: ST_NONE, dst: tir_op(fpaddr), args: tir_a1(fnref), is_comment: false, line: g_cur_line, cmt: "" });
    var epaddr: string = tir_tmp();
    tir_emit(TIRInst{ op: TIR_OP_GEP, st: tir_st_from_str("ptr<void>"), dst: tir_op(epaddr), args: tir_a3(cloaddr, "0", "1"), is_comment: false, line: g_cur_line, cmt: "" });
    if (str_len(envref) == 0) {
        var nul: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_CONST_PTR_NULL, st: tir_st_from_str("ptr<void>"), dst: tir_op(nul), args: tir_a0(), is_comment: false, line: g_cur_line, cmt: "" });
        tir_emit(TIRInst{ op: TIR_OP_STORE, st: ST_NONE, dst: tir_op(epaddr), args: tir_a1(nul), is_comment: false, line: g_cur_line, cmt: "" });
    } else {
        tir_emit(TIRInst{ op: TIR_OP_STORE, st: ST_NONE, dst: tir_op(epaddr), args: tir_a1(envref), is_comment: false, line: g_cur_line, cmt: "" });
    }
    // 返回值是堆 %TClosure 的 ptr<void>（call_ind 解包 ABI：field0=code, field1=env）。
    return heap;
}

// 具名结构体「字段 ST 表」：供 tir_sizeof 计算结构体真实字节尺寸。
// ⚠ 此前 tir_sizeof 对任意 %Struct 一律兜底返 8 → 空切片字面量 `var zt: []TIRType = []`
//   的 elem_size 被填成 8（应为 32）→ 后续 append 每元素只拷 8 字节、步长 8 →
//   读元素时 name.len 读到「下一个元素的 name.ptr」（地址量级）→ memcpy 长度爆炸 →
//   越界读穿 rdata 直抵 arena 预留区 → ACCESS_VIOLATION（emit-ll 自举崩溃）。
pub var g_ssz_name: []string;      // "%tir__TIRType" 形态的 TIR 结构体类型名
pub var g_ssz_fields: [][]string;  // 与上一表并行：各字段的 TIR ST 列表
var g_ssz_depth: i64 = 0;          // 递归守卫（自引用结构体）
// 变体真实字节尺寸：降准时捕获，供 tir_sizeof / 切片 elem_size 使用。
// ⚠ 与 %V 类型体 { i64, [mx x i8] } 字节对齐一致：变体总尺寸 = 8(tag) + mx(payload 缓冲)。
// 不可走 g_ssz_name 兜底 8 —— 否则 []Variant 切片 elem_size=8、步长错 → 元素错位 → 段错误
// （examples/shapes.tc 即此坑：%Shape={i64,[16 x i8]} 实为 24 字节，却被当作 8 字节步长寻址）。
pub var g_var_names: []string;     // 变体名（"Shape"），与 g_var_sizes 并行
pub var g_var_sizes: []i64;        // 变体真实字节尺寸 = 8 + mx
pub fn tir_add_struct_tt(name: string, field_head: i64) void {
    // P5：packed struct → 单宿主整型（%Name = type { i32 }，即一个 host 字段的聚合）。
    // 字段位域经 shift/mask 在成员访问点抽取（见 tir_member_read / tir_emit_assign），
    // 故 TT 只登记一个 host 字段；g_ssz 也按单 host 字段计尺寸。
    var pidx: i64 = sema.pk_find_struct(name);
    if (pidx >= 0) {
        var hostst: string = sema.pk_host_st(sema.pk_struct_under[pidx]);
        append(g_mod.types, TIRType{ name: base.sb_cat2("%", name), body: hostst });
        append(g_ssz_name, base.sb_cat2("%", name));
        append(g_ssz_fields, [hostst]);
        return;
    }
    var sb: StringBuilder = sb_new();
    var fsts: []string = [];
    // T1 cut2：字段类型经 sema.struct_field_tds 单一解析源（与 C 后端 emit_ctype 同源到 resolve_type_desc）。
    var ftds: []i64 = sema.struct_field_tds(field_head);
    var c: i64 = field_head;
    var fi: i64 = 0;
    var first: bool = true;
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
    var c_ks: []i64 = base.kids_chain(c);
    var c_ki: i64 = 0;
    while (c_ki < slice_len(c_ks) as i64) {
        var c_kv: i64 = c_ks[c_ki];
        var td: i64 = ftds[fi];
        var fst: string = "i64";
        if (td >= 0) { fst = tir_st_of_td(td); }
        append(fsts, fst);
        if (first == false) { sb_append_str(sb, ", "); }
        sb_append_str(sb, base.sb_cat2(base.node_sa((c_kv as u64)), ": "));
        sb_append_str(sb, fst);
        first = false;
        fi = fi + 1;
        c_ki = c_ki + 1;
    }
    append(g_mod.types, TIRType{ name: base.sb_cat2("%", name), body: sb_to_str(sb) });
    append(g_ssz_name, base.sb_cat2("%", name));
    append(g_ssz_fields, fsts);
}

pub fn tir_add_union_tt(name: string) void {
    // union 擦除为 { i8 tag, <max-member ST> }；Stage 1 仅登记 %Name 占位
    append(g_mod.types, TIRType{ name: base.sb_cat2("%", name), body: "f0: i8" });
}

// ── O-6 opt.tagged：?T 的按值布局 ─────────────────────────────────────────
//
// 旧 ABI（opt.boxed）把 ?T 抹成 `ptr<E>`：`some(x)` = arena 分配 + memcpy，none = 空指针。
// 代价是**每次构造都堆分配且永不回收**，于是 `T → ?T` 隐式提升（O-7）会把「开销」也一起隐形，
// 这比 L-02 原本要防的「空值隐形」更糟。
//
// 新 ABI（opt.tagged）：?T = `%Opt_<E>` = `struct { i64 __tag, E __val }`，按值、零分配。
//   none ⇒ __tag == 0；some ⇒ __tag != 0 且 __val 有效。
//   tag 用 **i64 而非 i8** 是刻意的：payload 偏移恒为 8，与 t 的 8 字节对齐布局一致，
//   C 后端（手工偏移 memcpy）与 LLVM（`{ i64, E }` 的默认对齐）无需各自算对齐即可逐字节对齐。
//
// 类型名由元素 ST **派生**（同元素 ⇒ 同名），而非按首次出现顺序编号：
//   std 的 .tlib 与主程序分别编译时，编号会错位导致同名异义；派生名天然保证跨模块类型等价。

pub fn tir_opt_tagged_name(elem_st: string) string {
    var s: string = "";
    var i: i64 = 0;
    var n: i64 = str_len(elem_st) as i64;
    while (i < n) {
        var ch: string = str_slice(elem_st, i, i + 1);
        // 元素 ST 可能含 `ptr<>` / `arr<E x N>` / `%Name` —— 全部压成合法标识符字符。
        if (ch == "%" or ch == "<" or ch == ">" or ch == " " or ch == "," or ch == ":" or ch == ".") { ch = "_"; }
        s = base.sb_cat2(s, ch);
        i = i + 1;
    }
    return base.sb_cat2("%Opt_", s);
}

// 幂等注册：已注册则直接返回名字，否则补进 module.types（后端类型声明段）与 g_ssz（tir_sizeof）。
// ⚠ 同时登记进 **g_opt_types**：后端拿到的 module 是值拷贝，其 types 未必包含此处追加的条目
//   （实测：降级当场注册的通常在拷贝里；后期才用到的不在）⇒ 后端必须改读本表再自行补发，
//   否则该类型被兜底成 `= type i64`（单字段）⇒ GEP `i32 0, i32 1` 非法。
pub var g_opt_types: []TIRType;

pub fn tir_ensure_opt_tagged(elem_st: string) string {
    var nm: string = tir_opt_tagged_name(elem_st);
    var k: i64 = 0;
    var kn: i64 = slice_len(g_opt_types) as i64;
    while (k < kn) {
        if (g_opt_types[k].name == nm) { return nm; }
        k = k + 1;
    }
    var obody: string = base.sb_cat3("__tag: i64, __val: ", elem_st, "");
    append(g_opt_types, TIRType{ name: nm, body: obody });
    var i: i64 = 0;
    var n: i64 = slice_len(g_mod.types) as i64;
    while (i < n) {
        if (g_mod.types[i].name == nm) { return nm; }
        i = i + 1;
    }
    append(g_mod.types, TIRType{ name: nm, body: obody });
    append(g_ssz_name, nm);
    var fs: []string = [];
    append(fs, "i64");
    append(fs, elem_st);
    append(g_ssz_fields, fs);
    return nm;
}

// 预注册：后端在发射「类型声明段」之前必须调一次。
// ⚠ 不能只靠 tir_st_of_td 的惰性注册 —— 函数体是在类型声明段**之后**才降级的，
//   那时补进 g_mod.types 的条目不会出现在声明里 ⇒ LLVM "use of undefined type"。
//   这里改为遍历 sema 的类型表直接扫出全部 optional（含嵌套 ??T，由 tir_st_of_td 递归带出）。
// 由 opt.tagged 类型名反解元素 ST。
// ⚠ 名字是 sanitize 过的（`<`/`>`/`%` 全压成 `_`）⇒ **不可逆**，必须查登记表而不是字符串切割，
//    否则 `?ptr<i64>` 会被解成 `ptr_i64_` 这种不存在的类型 → LLVM "use of undefined type"。
pub fn tir_opt_elem_st(optname: string) string {
    var i: i64 = 0;
    var n: i64 = slice_len(g_ssz_name) as i64;
    while (i < n) {
        if (g_ssz_name[i] == optname) {
            var fs: []string = g_ssz_fields[i];
            if (slice_len(fs) as i64 >= 2) { return fs[1]; }
        }
        i = i + 1;
    }
    return "i64";
}

// 把「期望类型」注入给即将发射的 RHS —— **仅当**目标是 ?T 且 RHS 是 none 字面量时才注入，
// 因此对其余所有赋值/初始化路径零影响（不触碰既有基线）。注入后由 tir_emit_expr 的 null 分支消费。
pub fn tir_maybe_expect_opt_none(rhs: i64, dst_st: string) void {
    if (rhs < 0) { return; }
    if (str_len(dst_st) <= 5) { return; }
    if (str_slice(dst_st, 0, 5) != "%Opt_") { return; }
    var k: string = base.node_kind((rhs as u64));
    if (k != "null" and k != "opt_none") { return; }
    g_expect_st = tir_st_from_str(dst_st);
}

pub fn tir_pregister_opt_types() void {
    var i: i64 = 0;
    var n: i64 = slice_len(sema.tds) as i64;
    while (i < n) {
        if (sema.tds[i].cat == "optional") { var _unused: string = tir_st_of_td(i); }
        i = i + 1;
    }
}

// 收集全部 opt.tagged 类型条目，供后端合并进**它自己那份** module（TIRModule 按值传参 ⇒
// 后端拿到的是拷贝，写 tir.g_mod 不会自动同步过去；必须显式交给后端 append）。
// 幂等：同元素类型只产出一条。后端侧再按 name 去重即可安全重复调用。
pub fn tir_collect_opt_types() []TIRType {
    var out: []TIRType = [];
    var i: i64 = 0;
    var n: i64 = slice_len(sema.tds) as i64;
    while (i < n) {
        if (sema.tds[i].cat == "optional") {
            var el: i64 = sema.tds[i].elem;
            var est: string = "i64";
            if (el >= 0 and el < slice_len(sema.tds) as i64) { est = tir_st_of_td(el); }
            var nm: string = tir_opt_tagged_name(est);
            var fd: bool = false;
            var j: i64 = 0;
            var m: i64 = slice_len(out) as i64;
            while (j < m) { if (out[j].name == nm) { fd = true; } j = j + 1; }
            if (fd == false) { append(out, TIRType{ name: nm, body: base.sb_cat3("__tag: i64, __val: ", est, "") }); }
        }
        i = i + 1;
    }
    return out;
}

// ── 变体 ADT 辅助（T1：构造器发射 + conpat 绑定提取）──────────────────
pub fn tir_round8(v: i64) i64 {
    var r: i64 = v % 8;
    if (r == 0) { return v; }
    return v + (8 - r);
}
// 变体最大载荷字节尺寸 mx：复用 g_vf_keys/g_vf_nodes（case 字段节点缓存）按 8 对齐累加。
// ⚠ 与降级的 %V 类型体 { i64, [mx x i8] } 同源；func 降级前的「预注册 pass」与 func 降级后的
// 变体 type-table 发射均调用本函数，保证切片 elem_size 与类型体逐字节一致（否则步长错 → 段错误）。
// 字段尺寸走 tir_size_bytes(resolve_type_desc)，与降级期同就绪状态，故两处结果一致。
pub fn tir_variant_mx(vname: string) i64 {
    var mx: i64 = 8;
    var pki: i64 = 0;
    var pkmax: i64 = slice_len(g_vf_keys) as i64;
    if (slice_len(g_vf_nodes) as i64 < pkmax) { pkmax = slice_len(g_vf_nodes) as i64; }
    while (pki < pkmax) {
        var key: string = g_vf_keys[pki];
        // 仅处理属于本变体的 case（key 形如 "Vname_Case"）
        if (str_len(key) > str_len(vname) + 1
            and str_slice(key, 0, str_len(vname) as i64) == vname
            and key[str_len(vname)] == 95) {   // '_'
            var pflds: []i64 = g_vf_nodes[pki];
            var pm: i64 = slice_len(pflds) as i64;
            var poff: i64 = 0;
            var pfi: i64 = 0;
            while (pfi < pm) {
                poff = tir_round8(poff) + tir_size_bytes(sema.resolve_type_desc(pflds[pfi]));
                pfi = pfi + 1;
            }
            poff = tir_round8(poff) + 8;
            if (poff > mx) { mx = poff; }
        }
        pki = pki + 1;
    }
    return mx;
}
// 类型 TD → 字节尺寸（前端可用；递归变体按 16 兜底，避免无限递归；与 legacy ll_size_bytes 近似一致）。
// ⚠ TD-vs-TI：td 是 sema.tds[]（TypeDef）索引，必须用 TD 字段（cat/name）判定，
// 绝不可喂给 sema.tip_kind/tip_name（读 tis[]，会越界 panic）。
pub fn tir_size_bytes(td: i64) i64 {
    if (td < 0 or td >= slice_len(sema.tds) as i64) { return 8; }
    var t: TD = sema.tds[td];
    var k: string = t.cat;
    var nm: string = t.name;
    if (nm == "i8" or nm == "u8" or nm == "bool") { return 1; }
    if (nm == "i16" or nm == "u16") { return 2; }
    if (nm == "i32" or nm == "u32" or nm == "rune" or nm == "f32") { return 4; }
    if (nm == "i64" or nm == "u64" or nm == "f64") { return 8; }
    if (str_len(nm) >= 4 and str_slice(nm, 0, 4) == "ptr<") { return 8; }
    if (k == "struct" or k == "union" or k == "variant" or k == "enum") { return 16; }
    return 8;
}
// 变体 case 载荷字段缓存：在类型表构建期（VC 节点尚未被后续 match 降级改动）预填充
// 「类型描述节点索引」列表（pristine）。字段尺寸解析推迟到类型系统完全解析（func 降级之后），
// 否则 resolve_type_desc 返回未就绪 TD（size 错 → paymax 错 → 结构体内存布局错位）。
pub var g_vf_keys: []string;
pub var g_vf_nodes: [][]i64;
// 与 g_vf_nodes 同索引：各 case 字段「已解析 TD 列表」（在构造器发射期解析——此时 variant 声明节点
// 尚未被后续 match 降级改写，resolve_type_desc 结果正确）。提取端复用此缓存，规避「节点索引后被改写为
// Variant/Struct 类导致 tir_size_bytes 兜底 16、偏移错位」的坑。TF 数字常量，不受节点改写影响。
pub var g_vf_tds: [][]i64;

// ══════════════════════════════════════════════════════════════════
// 顶层降级入口
// ══════════════════════════════════════════════════════════════════

// S1（v3 §5.3）：在降级前把当前模块全部表达式节点的 HIR 类型槽 **预标注** 好，
// 使 `node.td` 成为权威类型源，后续 `tir_expr_td`/`tir_expr_st` 一律读槽、影子表
// （`g_local_tds`/`g_local_sts`）仅作兜底。类型经 `sema.meta_type_of_expr` 一次性
// 推导并 `resolve_type_desc` 落槽，避免发射期逐次重推导带来的不一致（S0 已实证缓存
// 可消 4 例不一致）。按 `base.g_node_mod` 作用域隔离，避免跨模块节点被错标。
//
// ⚠ 仅对表达式节点调用类型推导（非 expr 节点不写槽）。内建调用优先走 builtin_ret_td 单一真相源，
// 避免 meta_type_of_expr 退化（内建无 FuncDecl → 退化为 %TSlice 等错类型，毒化 node.td）。
// builtin_ret_td 已对空/短 callee 名做守卫，对任意 call 节点均安全；未命中内建才回退 meta_type_of_expr。
pub fn tir_annotate_types(mod: string) void {
    var tot: i64 = base.node_count();
    var i: i64 = 0;
    while (i < tot) {
        // ⚠ 入口模块节点 g_node_mod == ""（base.tc node_new 用 g_cur_mod，入口为 ""），
        // 而 mod 取自 base.base_no_tc(文件名)（如 "maps"），故须同时匹配 "" 才能注解入口模块节点。
        // 否则注解空跑、node.td 永不填充，tir_expr_td 只能回落 meta_type_of_expr（有越界 TD 索引缺陷）。
        if (base.node_mod(i) == mod or base.node_mod(i) == "") {
            var rtd: i64 = -1;
            if (base.node_kind((i as u64)) == "call") {
                if (base.node_kind((base.node_na((i as u64)) as u64)) == "ident") {
                    rtd = builtin_ret_td(base.node_sa((base.node_na((i as u64)) as u64)));   // 内建返回类型优先：写槽即权威，后续 emit 不再重推
                }
            }
            if (rtd < 0) {
                var mt: i64 = sema.meta_type_of_expr(i);
                if (mt >= 0) { rtd = sema.resolve_type_desc(mt); }
            }
            // ⚠ 越界检查：resolve_type_desc 偶发返回越界 TD 索引，缓存后会毒化下游 sema.tds[td] 索引 → panic。
            // 越界则不写槽，让发射期回落 meta_type_of_expr / 影子表（与基线行为一致）。
            if (rtd >= 0 and rtd < slice_len(sema.tds) as i64) { base.node_set_type(i, rtd); }
        }
        i = i + 1;
    }
}

pub fn lower_unit(mod: string, source: string) void {
    tir_reset();
    tir_verify_init();
    // ⚠ 代际分配器：lower_unit 全程在 g_arena（持久区）作业——保证 g_mod.funcs / g_relowering_decls
    // 及变体·ginit 真实函数体落在 g_arena，跨 emit 的 arena_reset_func() 不被回收/覆盖。
    // 包裹式持久 append 的还原目标 = g_arena（见 base.g_relowering_scratch_func）。
    base.g_relowering_scratch_func = false;
    if (g_recording_mir) { g_mir = TIRModule{ mod: mod, source: source, types: [], strings: [], funcs: [], globals: [] }; }
    g_mod.mod = mod;
    g_mod.source = source;
    tir_add_std_types();

    var n: i64 = slice_len(lex.decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = lex.decl_list[i];
        if (base.node_kind((d as u64)) == "StructDecl") {
            // concept 约束类型不发射为真实结构体类型（成员即约束，非布局）。
            if (base.node_sb((d as u64)) != "concept") { tir_add_struct_tt(base.node_sa((d as u64)), base.node_lb((d as u64))); }
        }
        // VariantDecl 的 type-table 在 func 降级之后发射：paymax 需 resolve_type_desc 完全就绪，
        // 否则变体字段尺寸取未解析 TD（Struct/Union/Variant 兜底 16）→ paymax 偏大、布局错位。
        else if (base.node_kind((d as u64)) == "UnionDecl") { tir_add_union_tt(base.node_sa((d as u64))); }
        i = i + 1;
    }

    // 变体 ADT：在 type-table 期快照各 case 的载荷字段（VC 节点在后续降级期可能被改写，
    // 必须在此缓存，否则构造器字段数会与 paymax 不一致，导致堆损坏 / link 失败）。
    // 直接内联于 lower_unit：base 节点侧表 / base.kids 在此以全局方式访问（规避跨模块全局快照 bug）。
    var vf_ci: i64 = 0;
    while (vf_ci < n) {
        var vf_cd: i64 = lex.decl_list[vf_ci];
        if (base.node_kind((vf_cd as u64)) == "VariantDecl") {
            var vf_cc: i64 = base.node_lb((vf_cd as u64));
            // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
            var vf_cc_ks: []i64 = base.kids_chain(vf_cc);
            var vf_cc_ki: i64 = 0;
            while (vf_cc_ki < slice_len(vf_cc_ks) as i64) {
                var vf_cc_kv: i64 = vf_cc_ks[vf_cc_ki];
                var vf_cvc: i64 = vf_cc_kv;
                var vf_ckey: string = base.sb_cat3(base.node_sa((vf_cd as u64)), "_", base.node_sa((vf_cvc as u64)));
                var vf_cnodes: []i64 = [];
                if (base.node_lb((vf_cvc as u64)) >= 0) {
                    var vf_ct: i64 = base.node_lb((vf_cvc as u64));
                    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
                    var vf_ct_ks: []i64 = base.kids_chain(vf_ct);
                    var vf_ct_ki: i64 = 0;
                    while (vf_ct_ki < slice_len(vf_ct_ks) as i64) { var vf_ct_kv: i64 = vf_ct_ks[vf_ct_ki]; append(vf_cnodes, vf_ct_kv); vf_ct_ki = vf_ct_ki + 1; }
                } else if (base.node_na((vf_cvc as u64)) >= 0) {
                    append(vf_cnodes, base.node_na((vf_cvc as u64)));
                }
                append(g_vf_keys, vf_ckey);
                append(g_vf_nodes, vf_cnodes);
                // 预热 TD 注册表：在 func 降级之前对每个字段类型节点调用一次 resolve_type_desc，
                // 触发类型系统完成注册（type-table / TD 表），否则提取端在 match 降级期调用
                // sema.resolve_type_desc(cflds[bi3]) 时注册表尚未就绪 → 返回兜底 16 字节 → 偏移错位。
                // 此处仅预热，不缓存（首遍解析出的 TD 可能尚未完全就绪，见下方 g_vf_tds 占位）。
                var vf_wi: i64 = 0;
                while (vf_wi < slice_len(vf_cnodes) as i64) {
                    sema.resolve_type_desc(vf_cnodes[vf_wi]);
                    vf_wi = vf_wi + 1;
                }
                var vf_cvt: []i64 = [];
                append(g_vf_tds, vf_cvt);
                vf_cc_ki = vf_cc_ki + 1;
            }
        }
        vf_ci = vf_ci + 1;
    }

    // 预注册变体真实尺寸（在 func 降级之前）：[]Variant 切片的 elem_size / tir_sizeof 在 func
    // 降级期就需要准确的变体字节尺寸（= 8(tag) + mx），而变体 type-table 发射在 func 降级之后。
    // 若不预注册，tir_sizeof("%V") 在 func 降级期回落 8 → []Variant 切片步长错 → 元素错位 → 段错误
    // （examples/shapes.tc：%Shape={i64,[16 x i8]} 实为 24 字节，却被当作 8 字节步长寻址）。
    var vsz_i: i64 = 0;
    while (vsz_i < n) {
        var vsz_d: i64 = lex.decl_list[vsz_i];
        if (base.node_kind((vsz_d as u64)) == "VariantDecl") {
            var vsz_mx: i64 = tir_variant_mx(base.node_sa((vsz_d as u64)));
            append(g_var_names, base.node_sa((vsz_d as u64)));
            append(g_var_sizes, 8 + vsz_mx);
        }
        vsz_i = vsz_i + 1;
    }

    // 预收集全部函数名（含泛型/库函数），供函数值闭包包装判定（tir_is_func_name）使用，
    // 不依赖函数体降级顺序。
    var j0: i64 = 0;
    while (j0 < n) {
        var d0: i64 = lex.decl_list[j0];
        if (base.node_kind((d0 as u64)) == "FuncDecl") {
            append(g_tir_func_names, base.node_sa((d0 as u64)));
            append(g_tir_func_decls, d0);
        }
        j0 = j0 + 1;
    }

    // 模块级全局变量元数据收集：必须在函数体发射前完成，供 tir_emit_call 判定
    // 全局函数值变量走 call_ind。globals: 段文本在此缓冲，t.__ginit 在末尾追加。
    tir_emit_globals();

    // S1（v3 §5.3）：预标注当前模块全部表达式节点的 HIR 类型槽，使 `node.td` 成为权威源。
    tir_annotate_types(mod);

    var j: i64 = 0;
    while (j < n) {
        var d: i64 = lex.decl_list[j];
        if (base.node_kind((d as u64)) == "FuncDecl") {
            // S8：`comptime fn` 函数体仅存在于编译期（见 T-CLO-E001「其函数体仅存在于编译期」），
            // 运行期永不调用，故不降级为运行期 TIR 函数——两个后端（LLVM / tmir-c）都不会发射其
            // 定义。否则 `@type_info` 等仅编译期 op（TIR_OP_TYPEINFO, op 62）会落进运行期代码，
            // tmir-c 后端无该 op 支撑 → `unsupported op 62` + 临时量未声明致 C 编译失败。
            // comptime fn 在被 comptime 上下文调用时由 comptime 求值器（meta_eval）求值，无需运行期函数体。
            // 注：`g_tir_func_decls`（上方 1780-1786）仍登记该节点，不影响 comptime 求值对它的查找。
            if (base.node_bb((d as u64)) == true) { j = j + 1; continue; }
            // S4 §0.14.7 SoA：bf 已外置（原 `dn.bf`）
            if (sema.func_is_generic(d) == false and base.node_bf((d as u64)) == false) {
                if (lex.in_link_libs(base.node_mod(d))) {
                    if (base.node_bc((d as u64))) { tir_emit_extern(d); }   // S4 §0.14.7 SoA：侧表读（原 dn.bc）
                } else if (base.node_ba((d as u64))) {
                    tir_emit_extern(d);
                } else {
                    // ⚠ 代际分配器：base.g_relowering 模式下 FuncDecl 只降级签名（空体），函数体推迟到
                    // emit 阶段逐函数重降级进 g_func 本块 arena（用完即扔）；非重降级模式走完整降级。
                    g_cur_relower_decl = d;
                    if (base.g_relowering) { tir_lower_func_sig(d); } else { tir_lower_func(d); }
                }
            }
        }
        j = j + 1;
    }
    // ⚠ 代际分配器：变体 ADT 合成函数（构造器/判别器/取载荷）是真实体、须跨阶段持久，不重降级。
    g_cur_relower_decl = -1;
    // 变体 ADT：type-table + 构造器在 func 降级之后发射（paymax 需类型系统完全解析，见上方注释）。
    // 直接内联于 lower_unit：base 节点侧表 / base.kids 以全局方式访问，规避跨模块全局快照 bug。
    var vf_keys: []string = g_vf_keys;
    var vf_nodes: [][]i64 = g_vf_nodes;
    var iv: i64 = 0;
    while (iv < n) {
        var dv: i64 = lex.decl_list[iv];
        if (base.node_kind((dv as u64)) == "VariantDecl") {
            // 阶段 C 多进程自举：链接库模块的 VariantDecl 只须「类型信息」，不得重复合成 ADT 助手
            // （_from_ / _is_ / _as_）—— 本模块合成体与 .tlib 内同名定义撞 →
            // lld-link duplicate symbol（实测 base__TypeInfo_from_Int 等 12 个 × 每个模块一份；
            // 各模块 defines=12 calls=0，纯冗余）。定义统一由 .tlib 归档提供，调用方走 declare。
            if (base.node_mod(dv) != "" and lex.in_link_libs(base.node_mod(dv))) { iv = iv + 1; continue; }
            var vname: string = base.node_sa((dv as u64));
            // 复用 func 降级前「预注册 pass」算好的变体真实尺寸（g_var_names/g_var_sizes），
            // 保证 %V 类型体 { i64, [mx x i8] } 与切片 elem_size 逐字节一致（步长错 → 段错误）。
            // 未命中（理论上不会发生，预注册 pass 已覆盖本模块全部 VariantDecl）则回退重算。
            var mx: i64 = -1;
            var vpi: i64 = 0;
            var vpimax: i64 = slice_len(g_var_names) as i64;
            while (vpi < vpimax) {
                if (g_var_names[vpi] == vname) { mx = g_var_sizes[vpi] - 8; break; }
                vpi = vpi + 1;
            }
            if (mx < 0) { mx = tir_variant_mx(vname); }
            // %V type：tag 用 i64（8 字节）→ payload 固定在字节偏移 8，提取端可硬编码 8 基线（镜像 legacy ll_variant_paymax 的 +8）
            append(g_mod.types, TIRType{ name: base.sb_cat2("%", vname), body: base.sb_cat3("f0: i64, f1: [", base.i2s(mx), " x i8]") });
            // 各 case 构造器 @<V>_from_<C>
            var cc2: i64 = base.node_lb((dv as u64));
            // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
            var cc2_ks: []i64 = base.kids_chain(cc2);
            var cc2_ki: i64 = 0;
            while (cc2_ki < slice_len(cc2_ks) as i64) {
                var cc2_kv: i64 = cc2_ks[cc2_ki];
                var vc2: i64 = cc2_kv;
                var cname: string = base.node_sa((vc2 as u64));
                var key2: string = base.sb_cat3(vname, "_", cname);
                var flds2: []i64 = [];
                var ki2: i64 = 0;
                var kmax: i64 = slice_len(vf_keys) as i64;
                if (slice_len(vf_nodes) as i64 < kmax) { kmax = slice_len(vf_nodes) as i64; }
                while (ki2 < kmax) {
                    if (vf_keys[ki2] == key2) { flds2 = vf_nodes[ki2]; break; }
                    ki2 = ki2 + 1;
                }
                if (slice_len(flds2) as i64 == 0) { tir_cmt(base.sb_cat6("DBG miss key=", key2, " keys=", base.i2s(slice_len(vf_keys) as i64), " nodes=", base.i2s(slice_len(vf_nodes) as i64))); }
                var nf2: i64 = slice_len(flds2) as i64;
                // 解析并缓存字段 TD（构造器发射期：variant 声明节点尚未被后续 match 降级改写，
                // resolve_type_desc 结果正确且与载荷布局一致）。提取端复用 g_vf_tds，规避节点改写坑。
                var flds2_tds: []i64 = [];
                var fi2a: i64 = 0;
                while (fi2a < nf2) {
                    append(flds2_tds, sema.resolve_type_desc(flds2[fi2a]));
                    fi2a = fi2a + 1;
                }
                if (ki2 >= 0 and ki2 < slice_len(g_vf_tds) as i64) { g_vf_tds[ki2] = flds2_tds; }
                // sret 形式：首参 $dest: ptr<%V>，构造器写入该指针所指结构体，返回 void
                var params2: []string = [base.sb_cat3("$dest: ptr<%", vname, ">")];
                var fi2: i64 = 0;
                while (fi2 < nf2) {
                    append(params2, base.sb_cat4("$f", base.i2s(fi2), ": ", tir_st_of_td(flds2_tds[fi2])));
                    fi2 = fi2 + 1;
                }
                var eb2: []TIRInst = [];
                g_cur_func = TIRFunc{ name: base.sb_cat4(vname, "_from_", cname, ""), params: params2, ret_st: "void", body: eb2, is_extern: false, is_kernel: false, is_main: false };
                g_term = false;
                g_cur_line = 0;
                // 录制路径（tmir 后端）必须重置 g_mir_cur，否则构造器指令会续写上一个函数的
                //  stale 缓冲（同名 main），导致 g_mir.funcs 出现重复 main 且构造器体丢失。
                if (g_recording_mir) { g_mir_cur = TIRFunc{ name: g_cur_func.name, ret_st: g_cur_func.ret_st, params: g_cur_func.params, body: [], is_extern: g_cur_func.is_extern, is_kernel: g_cur_func.is_kernel, is_main: g_cur_func.is_main }; }
                // 写 tag 到 $dest 字段 0（i64）
                tir_emit(TIRInst{ op: TIR_OP_GEP, st: tir_st_from_str("i64"), dst: tir_op("$tagp"), args: tir_a3("$dest", "0", "0"), is_comment: false, line: g_cur_line, cmt: "" });
                tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str("i64"), dst: tir_op("$tagv"), args: tir_a1(base.i2s(base.node_ia((vc2 as u64)))), is_comment: false, line: g_cur_line, cmt: "" });
                tir_emit(TIRInst{ op: TIR_OP_STORE, st: ST_NONE, dst: tir_op("$tagp"), args: tir_a1("$tagv"), is_comment: false, line: g_cur_line, cmt: "" });
                // 写载荷到 $dest 字段 1（[mx x i8]）：先取载荷基址 ptr<[mx x i8]>
                tir_emit(TIRInst{ op: TIR_OP_GEP, st: tir_st_from_str(base.sb_cat3("arr<i8 x ", base.i2s(mx), ">")), dst: tir_op("$pay"), args: tir_a3("$dest", "0", "1"), is_comment: false, line: g_cur_line, cmt: "" });
                var off2: i64 = 0;
                var fi3: i64 = 0;
                while (fi3 < nf2) {
                    var ftd2: i64 = flds2_tds[fi3];
                    var fsz2: i64 = tir_size_bytes(ftd2);
                    off2 = tir_round8(off2);
                    var fieldst: string = tir_st_of_td(ftd2);
                    // gep [mx x i8], ptr $pay, 0, off2 -> ptr i8（数组基址 GEP 由翻译器自动补 i32 0）
                    tir_emit(TIRInst{ op: TIR_OP_GEP, st: tir_st_from_str("i8"), dst: tir_op("$fp"), args: tir_a2("$pay", base.i2s(off2)), is_comment: false, line: g_cur_line, cmt: "" });
                    // bitcast ptr i8 -> ptr<fieldst>，再 store 字段值
                    tir_emit(TIRInst{ op: TIR_OP_BITCAST, st: tir_st_from_str(base.sb_cat3("ptr<", fieldst, ">")), dst: tir_op("$fpp"), args: tir_a1("$fp"), is_comment: false, line: g_cur_line, cmt: "" });
                    tir_emit(TIRInst{ op: TIR_OP_STORE, st: ST_NONE, dst: tir_op("$fpp"), args: tir_a1(base.sb_cat2("$f", base.i2s(fi3))), is_comment: false, line: g_cur_line, cmt: "" });
                    off2 = off2 + fsz2;
                    fi3 = fi3 + 1;
                }
                tir_emit(TIRInst{ op: TIR_OP_RET_VOID, st: ST_NONE, dst: tir_op(""), args: tir_a0(), is_comment: false, line: g_cur_line, cmt: "" });
                tir_append_cur_func();
                // ── 判别器 Name_is_Case(self: V) -> bool(i8) ──
                // LLVM 后端消费 g_mod 但此前只发射 _from_ 构造器，缺 _is_/_as_ 函数体
                // → 调用处仅 declare 不 define → 链接期 undefined symbol。C 后端走 legacy
                // emit_variant_decl(static inline)，不读 g_mod，故此处补 TIR 函数不影响 C 后端。
                {
                    var eis: []TIRInst = [];
                    // ⚠ 切片字段不可用内联数组字面量（`params: [ ... ]`）：C 后端会把它
                    // 直译成 C 复合字面量 `.params = { ... }`，而 TSlice 是 {void*,len,cap}
                    // 结构体 → `initializing 'void *' from 'TStr'` 编译错误（自举 C 轨失败）。
                    // 必须先落成局部变量再赋值（见上一处 params2 的写法）。
                    var pip2: []string = [base.sb_cat3("$self: ptr<%", vname, ">")];
                    g_cur_func = TIRFunc{ name: base.sb_cat3(vname, "_is_", cname), params: pip2, ret_st: "i8", body: eis, is_extern: false, is_kernel: false, is_main: false };
                    g_term = false; g_cur_line = 0;
                    // 录制路径重置 g_mir_cur（消除重复 main）
                    if (g_recording_mir) { g_mir_cur = TIRFunc{ name: g_cur_func.name, ret_st: g_cur_func.ret_st, params: g_cur_func.params, body: [], is_extern: g_cur_func.is_extern, is_kernel: g_cur_func.is_kernel, is_main: g_cur_func.is_main }; }
                    tir_emit(TIRInst{ op: TIR_OP_GEP, st: tir_st_from_str("i64"), dst: tir_op("$tp"), args: tir_a3("$self", "0", "0"), is_comment: false, line: g_cur_line, cmt: "" });
                    tir_emit(TIRInst{ op: TIR_OP_LOAD, st: tir_st_from_str("i64"), dst: tir_op("$tv"), args: tir_a1("$tp"), is_comment: false, line: g_cur_line, cmt: "" });
                    tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str("i64"), dst: tir_op("$cv"), args: tir_a1(base.i2s(base.node_ia((vc2 as u64)))), is_comment: false, line: g_cur_line, cmt: "" });
                    tir_emit(TIRInst{ op: TIR_OP_EQ, st: tir_st_from_str("i1"), dst: tir_op("$eq"), args: tir_a2("$tv", "$cv"), is_comment: false, line: g_cur_line, cmt: "" });
                    tir_emit(TIRInst{ op: TIR_OP_ZEXT, st: tir_st_from_str("i8"), dst: tir_op("$rb"), args: tir_a1("$eq"), is_comment: false, line: g_cur_line, cmt: "" });
                    tir_emit(tir_emit_ret("i8", "$rb"));
                    tir_append_cur_func();
                }
                // ── 取载荷：单载荷 Name_as_Case(self)->Payload；多载荷 Name_as_Case_fK(self)->FieldK ──
                // ⚠ 单/多载荷判定以「实际载荷字段数 nf2」为准（与 _from_ 构造器、conpat_walk
                // 调用点命名完全一致：nf2>=2 → _as_C_fK；nf2==1 → _as_C）。决不能用 vc2.lb/vc2.na
                // 指针判定——单载荷 case（如 Circle(f64)）其 lb 也可能 >=0，会误走多载荷分支生成
                // `_as_Circle_f0`，而调用点按单载荷生成 `Shape_as_Circle` → 链接期 undefined symbol。
                {
                    var aoff: i64 = 0; var afi: i64 = 0;
                    if (nf2 >= 2) {
                        while (afi < nf2) {
                            var aftd: i64 = flds2_tds[afi];
                            var afst: string = tir_st_of_td(aftd);
                            var eas: []TIRInst = [];
                            var pap1: []string = [base.sb_cat3("$self: ptr<%", vname, ">")];
                            g_cur_func = TIRFunc{ name: base.sb_cat5(vname, "_as_", cname, "_f", base.i2s(afi)), params: pap1, ret_st: afst, body: eas, is_extern: false, is_kernel: false, is_main: false };
                            g_term = false; g_cur_line = 0;
                            // 录制路径重置 g_mir_cur（消除重复 main）
                            if (g_recording_mir) { g_mir_cur = TIRFunc{ name: g_cur_func.name, ret_st: g_cur_func.ret_st, params: g_cur_func.params, body: [], is_extern: g_cur_func.is_extern, is_kernel: g_cur_func.is_kernel, is_main: g_cur_func.is_main }; }
                            tir_emit(TIRInst{ op: TIR_OP_GEP, st: tir_st_from_str(base.sb_cat3("arr<i8 x ", base.i2s(mx), ">")), dst: tir_op("$pay"), args: tir_a3("$self", "0", "1"), is_comment: false, line: g_cur_line, cmt: "" });
                            aoff = tir_round8(aoff);
                            tir_emit(TIRInst{ op: TIR_OP_GEP, st: tir_st_from_str("i8"), dst: tir_op("$fp"), args: tir_a2("$pay", base.i2s(aoff)), is_comment: false, line: g_cur_line, cmt: "" });
                            tir_emit(TIRInst{ op: TIR_OP_BITCAST, st: tir_st_from_str(base.sb_cat3("ptr<", afst, ">")), dst: tir_op("$fpp"), args: tir_a1("$fp"), is_comment: false, line: g_cur_line, cmt: "" });
                            tir_emit(TIRInst{ op: TIR_OP_LOAD, st: tir_st_from_str(afst), dst: tir_op("$pv"), args: tir_a1("$fpp"), is_comment: false, line: g_cur_line, cmt: "" });
                            tir_emit(tir_emit_ret(afst, "$pv"));
                            tir_append_cur_func();
                            aoff = aoff + tir_size_bytes(aftd);
                            afi = afi + 1;
                        }
                    } else if (nf2 == 1) {
                        var ast: string = tir_st_of_td(flds2_tds[0]);
                        var eas2: []TIRInst = [];
                        var pap2: []string = [base.sb_cat3("$self: ptr<%", vname, ">")];
                        g_cur_func = TIRFunc{ name: base.sb_cat3(vname, "_as_", cname), params: pap2, ret_st: ast, body: eas2, is_extern: false, is_kernel: false, is_main: false };
                        g_term = false; g_cur_line = 0;
                        // 录制路径重置 g_mir_cur（消除重复 main）
                        if (g_recording_mir) { g_mir_cur = TIRFunc{ name: g_cur_func.name, ret_st: g_cur_func.ret_st, params: g_cur_func.params, body: [], is_extern: g_cur_func.is_extern, is_kernel: g_cur_func.is_kernel, is_main: g_cur_func.is_main }; }
                        tir_emit(TIRInst{ op: TIR_OP_GEP, st: tir_st_from_str(base.sb_cat3("arr<i8 x ", base.i2s(mx), ">")), dst: tir_op("$pay"), args: tir_a3("$self", "0", "1"), is_comment: false, line: g_cur_line, cmt: "" });
                        tir_emit(TIRInst{ op: TIR_OP_GEP, st: tir_st_from_str("i8"), dst: tir_op("$fp"), args: tir_a2("$pay", "0"), is_comment: false, line: g_cur_line, cmt: "" });
                        tir_emit(TIRInst{ op: TIR_OP_BITCAST, st: tir_st_from_str(base.sb_cat3("ptr<", ast, ">")), dst: tir_op("$fpp"), args: tir_a1("$fp"), is_comment: false, line: g_cur_line, cmt: "" });
                        tir_emit(TIRInst{ op: TIR_OP_LOAD, st: tir_st_from_str(ast), dst: tir_op("$pv"), args: tir_a1("$fpp"), is_comment: false, line: g_cur_line, cmt: "" });
                        tir_emit(tir_emit_ret(ast, "$pv"));
                        tir_append_cur_func();
                    }
                }
                cc2_ki = cc2_ki + 1;
            }
        }
        iv = iv + 1;
    }
    // 模块级全局变量降级：元数据（g_global_names 等）必须在函数体发射前收集，
    // 否则 tir_emit_call 判定全局函数值变量（走 call_ind）时 g_global_names 尚为空 → 直调崩溃。
    // t.__ginit 初始化函数仍在末尾追加（函数体顺序无关，翻译器统一收集）。
    // 预编译库模式（build --lib）：每个模块发射独立 ginit（t_ginit_<mangled idn>），
    // 由导入方 main 包裹器按 g_link_libs 逐库 declare + call，根治 §4.14.7 全局初始化断裂。
    // 入口模式（非 lib）：沿用旧语义发射 t.__ginit（无全局时由 tir_to_ll main 包裹器补空兜底）。
    if (lex.g_lib_emit) {
        tir_emit_ginit(tir_ginit_sym(lex.g_lib_mod_idn), true);
    } else {
        tir_emit_ginit("t.__ginit", false);
    }
}

// ── 模块级全局变量降级 ───────────────────────────────────────────────
// 收集顶层 var_decl 进 g_globals_section（"@name ST" 每行，供 t.__ginit 运行期初始化
// 与翻译器 globals: 段声明），并记录分类元数据供 tir_emit_ginit / tir_emit_call 使用。
pub fn tir_emit_globals() void {
    var n: i64 = slice_len(lex.decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = lex.decl_list[i];
        // 导入的「链接库」（如 std.math）全局：不内联进当前模块，改由链接期 .tlib 归档提供，
        // 否则与 .tlib 同名符号重复定义（duplicate symbol: math__PI / math__E / math__TAU …）。
        // 入口模块节点 g_node_mod == ""，src 内联导入节点的 g_node_mod 非空但不在 g_link_libs，
        // 二者均正常内联；仅「链接库」模块的全局跳过（其函数体由 tir_to_ll 走 external declare + 链接 .tlib）。
        if (base.node_mod(d) != "" and lex.in_link_libs(base.node_mod(d))) {
            // ⚠ 跳过 ≠ 不声明：链接库全局须登记进 g_link_globals_section，
            // 由 tir_to_ll pass-1 统一注册为 external 声明（定义由 .tlib 提供）。
            // 否则仅「经 ll_load/ll_store 惰性登记」的引用点有声明，内建直发路径
            // （append 等直接内联 `@g` 文本）漏声明 → LLVM "use of undefined value"。
            var lk: string = base.node_kind((d as u64));
            if (lk == "var_decl" or lk == "GlobalVarDecl" or lk == "GlobalConstDecl") {
                var lnm: string = base.node_sa((d as u64));
                var lt: i64 = -1;
                if (base.node_na((d as u64)) >= 0) { lt = sema.resolve_type_desc(base.node_na((d as u64))); }
                var lst: string = "i64";
                if (lt >= 0) {
                    if (sema.tds[lt].cat == "func") { lst = "%TClosure"; }
                    else { lst = tir_st_of_td(lt); }
                }
                sb_append_str(g_link_globals_section, "  @");
                sb_append_str(g_link_globals_section, lnm);
                sb_append_str(g_link_globals_section, " ");
                sb_append_str(g_link_globals_section, lst);
                sb_append_str(g_link_globals_section, "\n");
            }
            i = i + 1; continue;
        }
        if (base.node_kind((d as u64)) != "var_decl" and base.node_kind((d as u64)) != "GlobalVarDecl" and base.node_kind((d as u64)) != "GlobalConstDecl") { i = i + 1; continue; }
        // clause 常量：编译期一等值、无运行期布局 ⇒ 跳过发射（声明仍保留在 decl_list
        // 供 sema 检查，见 base.g_clause_const_ids 的注释）。不跳过会产出
        // `getelementptr [N x %clause]` ⇒ clang "base element of getelementptr must be sized"。
        if (base.clause_const_is_marked(d)) { i = i + 1; continue; }
        var nm: string = base.node_sa((d as u64));
        var t: i64 = -1;
        if (base.node_na((d as u64)) >= 0) { t = sema.resolve_type_desc(base.node_na((d as u64))); }
        var st: string = "i64";
        if (t >= 0) {
            // ⚠ 函数值全局 ABI 上以 %TClosure 形态存在（call_ind 直接 GEP 其上取 code/env）。
            // 此前 td 取自 tir_st_of_td(func_type)（落到 ptr<void>/void*），tmir-c 后端据此把 g_join 声明成
            // `static void* g_join = 0;` 并 ginit 把 16B TClosure 写进 8B void* → 越界/悬空 → 程序退出码 3。
            // 文本段（globals:）本就统一发 %TClosure，故结构化 td 必须与之对齐。
            if (sema.tds[t].cat == "func") { st = "%TClosure"; }
            else { st = tir_st_of_td(t); }
        }
        // 结构化全局表（供 tmir 后端 wasm/riscv 消费；LLVM 走 globals: 文本段，不受影响）。
        append(g_mod.globals, TIRGlobal{ name: nm, td: tir_st_from_str(st), init: base.node_nb((d as u64)), is_link: 0 });
        // 函数值全局：ABI 上以 %TClosure 形态存在（call_ind 直接 GEP 其上取 code/env）
        if (t >= 0 and sema.tds[t].cat == "func") {
            sb_append_str(g_globals_section, "  @");
            sb_append_str(g_globals_section, nm);
            sb_append_str(g_globals_section, " %TClosure\n");
            var ref: string = "";
            if (base.node_nb((d as u64)) >= 0) {
                if (base.node_kind((base.node_nb((d as u64)) as u64)) == "ident") { ref = base.sb_cat2("@", base.node_sa((base.node_nb((d as u64)) as u64))); }
                else if (base.node_kind((base.node_nb((d as u64)) as u64)) == "closure_make") { ref = base.sb_cat2("@", base.node_sa((base.node_nb((d as u64)) as u64))); }
            }
            append(g_global_names, nm);
            append(g_global_fnval, true);
            append(g_global_map, false);
            append(g_global_td, t);
            append(g_global_vdecl, d);
            append(g_global_fnref, ref);
            i = i + 1;
            continue;
        }
        // map 全局：ptr<void> 句柄，ginit 运行期建表
        if (t >= 0 and sema.tds[t].cat == "map") {
            sb_append_str(g_globals_section, "  @");
            sb_append_str(g_globals_section, nm);
            sb_append_str(g_globals_section, " ptr<void>\n");
            append(g_global_names, nm);
            append(g_global_fnval, false);
            append(g_global_map, true);
            append(g_global_td, t);
            append(g_global_vdecl, d);
            append(g_global_fnref, "");
            i = i + 1;
            continue;
        }
        // 标量/聚合全局：声明 + ginit 设常量初值（无 init 则零初始化）
        sb_append_str(g_globals_section, "  @");
        sb_append_str(g_globals_section, nm);
        sb_append_str(g_globals_section, " ");
        sb_append_str(g_globals_section, st);
        sb_append_str(g_globals_section, "\n");
        append(g_global_names, nm);
        append(g_global_fnval, false);
        append(g_global_map, false);
        append(g_global_td, t);
        append(g_global_vdecl, d);
        append(g_global_fnref, "");
        i = i + 1;
    }
}

// 是否函数值（%TClosure）全局变量（供 tir_emit_call 走 call_ind）
pub fn tir_is_global_fnval(cname: string) bool {
    var n: i64 = slice_len(g_global_names) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (g_global_names[i] == cname and g_global_fnval[i]) { return true; }
        i = i + 1;
    }
    return false;
}

// 取全局函数值变量的 FuncType TD（cat=="func"），供 tir_emit_call 取真实返回类型覆盖默认 retst。
pub fn tir_global_fnval_td(name: string) i64 {
    var n: i64 = slice_len(g_global_names) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (g_global_names[i] == name and g_global_fnval[i]) { return g_global_td[i]; }
        i = i + 1;
    }
    return -1;
}

// 由模块身份（idn，如 "src.base" / "json"）推导其独立 ginit 符号名。
// '.' → '_'（C 标识符不允许 '.'，且 LLVM 亦无需 '.'），前缀 t_ginit_。
// 必须与 tir_to_ll main 包裹器（入口侧）的同名推导逐字节一致，否则 declare/call 符号对不上 → 链接失败。
pub fn tir_ginit_sym(idn: string) string {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "t_ginit_");
    var i: i64 = 0;
    var n: i64 = str_len(idn);
    while (i < n) {
        var c: string = str_slice(idn, i, i + 1);
        if (c == ".") { sb_append_str(sb, "_"); }
        else { sb_append_str(sb, c); }
        i = i + 1;
    }
    return sb_to_str(sb);
}

// 发射模块初始化函数：运行期初始化各全局（函数值闭包 / map 建表 / 标量常量）。
// name：函数符号名。always_emit：库模式恒发射（即便空体），保证导入方 main 调用该符号时
//   链接不缺定义；入口模式（false）沿用旧语义——无全局时跳过（由 tir_to_ll main 包裹器补空 t.__ginit 兜底）。
// 这是 §4.14.7 根治：build --lib 此前跳过 t.__ginit，导致链接库全局初值恒零（如编译器自身
// `pub var g_comptime_full: bool = true` 被读成 false）。现每个模块发射独立 ginit（t_ginit_<idn>），
// 由导入方 main 包裹器按 g_link_libs 逐库 declare + call。
pub fn tir_emit_ginit(name: string, always_emit: bool) void {
    g_cur_relower_decl = -1;   // ginit 真实体须持久，不重降级
    if (always_emit == false and slice_len(g_global_names) as i64 == 0) { return; }
    var eb: []TIRInst = [];
    var gpp: []string = [];
    g_cur_func = TIRFunc{ name: name, params: gpp, ret_st: "void", body: eb, is_extern: false, is_kernel: false, is_main: false };
    g_term = false;
    g_cur_line = 0;
    // ⚠ 录制路径（tmir 后端）必须重置 g_mir_cur，否则 ginit 指令会续写上一个函数的
    //  stale 缓冲（同名 main），导致 g_mir.funcs 出现重复 main 且 t.__ginit 丢失。
    if (g_recording_mir) { g_mir_cur = TIRFunc{ name: g_cur_func.name, ret_st: g_cur_func.ret_st, params: g_cur_func.params, body: [], is_extern: g_cur_func.is_extern, is_kernel: g_cur_func.is_kernel, is_main: g_cur_func.is_main }; }
    var n: i64 = slice_len(g_global_names) as i64;
    var i: i64 = 0;
    while (i < n) {
        var nm: string = g_global_names[i];
        if (g_global_fnval[i]) {
            // 在 @nm（%TClosure 全局）上构造闭包：addr_of 取址 → gep 0 0 写 code → gep 0 1 写 env(null)
            var ga: string = tir_tmp();
            tir_emit(tir_emit_addr_of("ptr<%TClosure>", ga, base.sb_cat2("@", nm)));
            var fp: string = tir_tmp();
            tir_emit(tir_emit_gep("ptr<void>", fp, ga, tir_idxs2("0", "0")));
            tir_emit(tir_emit_store(g_global_fnref[i], fp));
            var ep: string = tir_tmp();
            tir_emit(tir_emit_gep("ptr<void>", ep, ga, tir_idxs2("0", "1")));
            var nul: string = tir_tmp();
            tir_emit(tir_emit_const_ptr_null("ptr<void>", nul));
            tir_emit(tir_emit_store(nul, ep));
        } else if (g_global_map[i]) {
            var vd: i64 = g_global_vdecl[i];
            var nb: i64 = base.node_nb((vd as u64));
            if (nb >= 0 and base.node_kind((nb as u64)) == "map_lit") {
                var mr: TirEmitRes = tir_emit_map_lit(nb, g_global_td[i]); var m: string = mr.name;
                tir_emit(tir_emit_store(m, base.sb_cat2("@", nm)));
            }
        } else {
            // 标量：仅当 init 是字面量（int/float）时 store 常量；否则零初始化
            var vd: i64 = g_global_vdecl[i];
            var nb: i64 = base.node_nb((vd as u64));
            if (nb >= 0) {
                // Sym 全局 = 字符串字面量：ginit 内 call sym_intern 取 id 存入 @nm（与局部 Sym 初始化一致）。
                var gsymtd: i64 = g_global_td[i];
                if (gsymtd >= 0 and sema.tds[gsymtd].cat == "sym" and base.node_kind((nb as u64)) == "string") {
                    var valslotr: TirEmitRes = tir_emit_expr(nb); var valslot: string = valslotr.name;
                    var tagid: i64 = slice_len(g_mod.strings) as i64;
                    if (base.g_relowering) { arena_use_default(); }
                    append(g_mod.strings, sema.tds[gsymtd].name);
                    if (base.g_relowering) { if (base.g_relowering_scratch_func) { arena_use_func(); } else { arena_use_default(); } }
                    var tagslot: string = tir_tmp();
                    tir_emit(tir_emit_const_str(tagslot, base.i2s(tagid)));
                    var bitsslot: string = tir_tmp();
                    tir_emit(tir_emit_const_typed("i64", bitsslot, base.i2s(sema.tds[gsymtd].alen)));
                    var gst: string = tir_st_of_td(gsymtd);
                    if (gst == "i16" or gst == "u16") {
                        // 16 位：intern 结果先落临时槽，trunc 到 i16 再 store（绕开 translator store 的非法 trunc）。
                        var sidv: string = tir_tmp();
                        tir_emit(tir_e_call("i32", sidv, "@sym_intern", tir_cargs3(tagslot, valslot, bitsslot)));
                        var st16: string = tir_tmp();
                        tir_emit(tir_e_cast(TIR_OP_TRUNC, "i16", st16, sidv));
                        tir_emit(tir_emit_store(st16, base.sb_cat2("@", nm)));
                    } else if (gst == "i64" or gst == "u64") {
                        // 64 位：intern 结果（i64）直接 store 进 @nm（声明为 i64，两侧同宽）。
                        var sidv: string = tir_tmp();
                        tir_emit(tir_e_call("i64", sidv, "@sym_intern64", tir_cargs3(tagslot, valslot, bitsslot)));
                        tir_emit(tir_emit_store(sidv, base.sb_cat2("@", nm)));
                    } else {
                        // 32 位：intern 结果先落临时槽（translator 的 `call` 解析器不支持
                        // 全局 DST —— toks[2] 以 '@' 开头会被当成 callee）。再 store 进全局；
                        // @nm 声明为 i32，两侧同宽，不会触发 translator store 的窄化 trunc。
                        var sidv: string = tir_tmp();
                        tir_emit(tir_e_call("i32", sidv, "@sym_intern", tir_cargs3(tagslot, valslot, bitsslot)));
                        tir_emit(tir_emit_store(sidv, base.sb_cat2("@", nm)));
                    }
                } else if (base.node_kind((nb as u64)) == "int") {
                    tir_emit(tir_emit_store(base.node_sa((nb as u64)), base.sb_cat2("@", nm)));
                } else if (base.node_kind((nb as u64)) == "array_lit") {
                    // 向量/定长数组全局（如 `var g_scale: @Vector(4,i32) = [2,2,2,2]`）：
                    // 经 array_lit 降级成 vec<...> 聚合，再 STORE 进全局（与局部 var_decl 初始化同构）。
                    // 此前遗漏此分支 → 全局只有 zeroinitializer 声明、无运行期初始化 → 读全 0。
                    var initr: TirEmitRes = tir_emit_array_lit(nb, g_global_td[i]);
                    tir_emit(tir_emit_store(initr.name, base.sb_cat2("@", nm)));
                } else if (base.node_kind((nb as u64)) == "float") {
                    // 浮点字面量须先 materialize 到 f64 槽：直接 store 字面量会被翻译器按 i64 解读
                    // （裸字面量无类型槽），写出 `store i64 3.14` → clang 报错。
                    var ts: string = tir_tmp();
                    tir_emit(tir_emit_const_typed("f64", ts, base.node_sa((nb as u64))));
                    tir_emit(tir_emit_store(ts, base.sb_cat2("@", nm)));
                } else if (base.node_kind((nb as u64)) == "bool") {
                    // ⚠ 布尔全局此前未覆盖：@g 只剩 zeroinitializer（恒 false）。
                    // 编译器自身的 `pub var g_comptime_full: bool = true;` 正是此类，LLVM 自托管下
                    // 被读成 false → comptime_fold_pass 直接 return → 全量编译期折叠整段失效
                    // （`-1` 不再是常量、IR 多出 neg 指令）→ 两代 emit-ll 对不上、无自举不动点。
                    var brr: TirEmitRes = tir_emit_expr(nb); var bslot: string = brr.name;
                    tir_emit(tir_emit_store(bslot, base.sb_cat2("@", nm)));
                } else if (base.node_kind((nb as u64)) == "string") {
                    // 字符串全局（非 Sym）：经字面量发射器物化成 %TStr 槽再 store。
                    var srr: TirEmitRes = tir_emit_expr(nb); var sslot: string = srr.name;
                    tir_emit(tir_emit_store(sslot, base.sb_cat2("@", nm)));
                } else if (base.node_kind((nb as u64)) == "unary") {
                    // 负数字面量（折叠关闭时 `-1` 仍是 unary）：按表达式发射再 store。
                    var urr: TirEmitRes = tir_emit_expr(nb); var uslot: string = urr.name;
                    tir_emit(tir_emit_store(uslot, base.sb_cat2("@", nm)));
                } else if (t_td_is_variant(tir_expr_td(nb))) {
                    // 变体全局常量（如 `const X: V = V{ .A(7) }`）：sema 脱糖后 init 是
                    // `@V_from_A(7)` 调用。构造器运行期 tll_alloc 堆上 16B payload 并填 tag，
                    // 但变体 %V 聚合本身由调用方提供的 dest（指针）承载。tir_emit_expr(nb) 会在
                    // t.__ginit 栈上物化该 %V、把其地址存入 @nm；ginit 返回后栈帧销毁 → @nm 悬空。
                    // 故把栈上 %V 浅拷贝到堆（payload 自身已堆分配，24B 拷贝即持久化）再写回 @nm。
                    // C 后端走 #define 宏展开、不消费本分支（其全局即值、无 ginit store）。
                    var vr: TirEmitRes = tir_emit_expr(nb);          // vr.name = ptr 栈上 %V（即将失效）
                    var vtd: i64 = tir_expr_td(nb);
                    var vnn: string = sema.tds[vtd].name;
                    var sz: i64 = 8 + tir_variant_mx(vnn);           // %V = { i64 tag, [16 x i8] payload } = 24B
                    var hp: string = tir_tmp();
                    tir_emit(tir_e_call("ptr", hp, "@tll_alloc", tir_cargs1(base.i2s(sz))));
                    var md: string = tir_tmp();
                    tir_emit(tir_e_call("void", md, "@tll_memcpy", tir_cargs3(hp, vr.name, base.i2s(sz))));
                    tir_emit(tir_emit_store(hp, base.sb_cat2("@", nm)));
                }
            }
        }
        i = i + 1;
    }
    tir_emit(tir_emit_ret_void());
    tir_append_cur_func();
}

pub fn tir_emit_extern(d: i64) void {
    g_cur_relower_decl = -1;   // extern 真实体须持久，不重降级
    var ep: []string = [];
    var eb: []TIRInst = [];
    g_cur_func = TIRFunc{ name: base.node_sa((d as u64)), ret_st: tir_st_of_td(tir_func_ret_td(d)), params: ep, body: eb, is_extern: true, is_kernel: false, is_main: false };
    // ⚠ 阶段 C 多进程/链接模式：extern 函数同样是一次「新函数开始」，必须重置 MIR 录制缓冲。
    //   漏重置 ⇒ tir_append_cur_func 把上一个函数的 g_mir_cur（名不同、参数被刷新）当作本函数
    //   追加进 g_mir.funcs ⇒ C 后端前向声明全部写成同一个名字（实测 std.math 的数十个函数
    //   全被声明成 `int t_main(<各自签名>)`）⇒ clang: conflicting types for 't_main'。
    if (g_recording_mir) { g_mir_cur = TIRFunc{ name: g_cur_func.name, ret_st: g_cur_func.ret_st, params: g_cur_func.params, body: [], is_extern: g_cur_func.is_extern, is_kernel: g_cur_func.is_kernel, is_main: g_cur_func.is_main }; }
    g_cur_ret_td = tir_func_ret_td(d);
    var c: i64 = base.node_lb((d as u64));
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
    var c_ks: []i64 = base.kids_chain(c);
    var c_ki: i64 = 0;
    while (c_ki < slice_len(c_ks) as i64) {
        var c_kv: i64 = c_ks[c_ki];
        var pst: string = tir_st_of_td(sema.resolve_type_desc(base.node_na((c_kv as u64))));
        append(g_cur_func.params, base.sb_cat4("$", base.node_sa((c_kv as u64)), ": ", pst));
        c_ki = c_ki + 1;
    }
    tir_append_cur_func();
}

pub fn tir_func_ret_td(d: i64) i64 {
    // FuncDecl 的返回类型 desc 存于 n.la 链之后的类型信息；复用 resolve_type_desc 取函数返回。
    // 现有实现中函数返回类型在 sema 通过 ti 记录，这里用 fn 签名 td 解析：
    // n.na 通常为返回类型 desc 节点（见 mk_FuncDecl 布局）；退回用 sema.resolve_type_desc(n.la 首个 child 的父)
    if (base.node_na((d as u64)) >= 0) {
        var rt: i64 = sema.resolve_type_desc(base.node_na((d as u64)));
        if (rt >= 0) { return rt; }
    }
    return sema.resolve_type_desc(d);
}

pub fn tir_ann_has(head: i64, name: string) bool {
    // 本地复刻 parse.ann_find：tir.tc 未导入 parse，但 base.kids/Node 可见。
    var it: i64 = head;
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
    var it_ks: []i64 = base.kids_chain(it);
    var it_ki: i64 = 0;
    while (it_ki < slice_len(it_ks) as i64) {
        var it_kv: i64 = it_ks[it_ki];
        if (base.node_sa((it_kv as u64)) == name) { return true; }
        it_ki = it_ki + 1;
    }
    return false;
}

// ⚠ 代际分配器（2026-10-22）：base.g_relowering 安全追加当前降级函数到 g_mod.funcs。
// 重降级（emit 逐函数）时函数体在 g_func 本块 arena（用完即扔），若原样追加会留下悬垂
// 体指针（arena_reset_func 后）；故 FuncDecl（g_cur_relower_decl>=0）追加「空体元数据」副本，
// 而真实体须持久者（ginit / 变体合成函数，g_cur_relower_decl==-1）仍追加 g_cur_func 全量。
// 非重降级（lower_unit 模块级）走原样追加（体在 g_arena，跨阶段持久）。
pub fn tir_append_cur_func() void {
    if (g_recording_mir) { g_mir_cur.params = g_cur_func.params; append(g_mir.funcs, g_mir_cur); }
    if (base.g_relowering) {
        append(g_relowering_decls, g_cur_relower_decl);
        if (g_cur_relower_decl >= 0) {
            append(g_mod.funcs, TIRFunc{ name: g_cur_func.name, ret_st: g_cur_func.ret_st, params: g_cur_func.params, body: [], is_extern: g_cur_func.is_extern, is_kernel: g_cur_func.is_kernel, is_main: g_cur_func.is_main });
        } else {
            append(g_mod.funcs, g_cur_func);
        }
    } else {
        append(g_mod.funcs, g_cur_func);
    }
}

pub fn tir_lower_func(d: i64) void {
    // ⚠ 代际分配器（2026-10-22）：本函数 arena-agnostic —— 函数体落「当前 arena」。
    //   · emit 阶段逐函数重降级时，调用方先 arena_use_func()（切 g_func 本块）再调用本函数，
    //     体落 g_func，降级完 arena_reset_func() 整体回收，压低峰值；
    //   · lower_unit 模块级降级时当前 arena = g_arena，体落 g_arena（跨阶段持久）。
    // 模块级持久 slice（g_mod.strings/types/globals）经下方 4 处 append 的 base.g_relowering 感知
    // 切换恒落 g_arena，跨函数回收后不悬垂（见各站点注释）。
    var fp: []string = [];
    var fb: []TIRInst = [];
    g_cur_func = TIRFunc{ name: base.node_sa((d as u64)), ret_st: tir_st_of_td(tir_func_ret_td(d)), params: fp, body: fb, is_extern: false, is_kernel: false, is_main: tir_ann_has(base.node_la((d as u64)), "main") };
    if (g_recording_mir) { g_mir_cur = TIRFunc{ name: g_cur_func.name, ret_st: g_cur_func.ret_st, params: g_cur_func.params, body: [], is_extern: g_cur_func.is_extern, is_kernel: g_cur_func.is_kernel, is_main: g_cur_func.is_main }; }
    g_cur_ret_td = tir_func_ret_td(d);
    var fln: []string = [];
    g_local_names = fln;
    var fls: []string = [];
    g_local_slots = fls;
    var flt: []string = [];
    g_local_sts = flt;
    var fld: []i64 = [];
    g_local_tds = fld;
    var fldp: []i64 = [];
    g_local_depths = fldp;
    g_blk_depth = 0;
    g_slotc = 0;
    g_term = false;
    var zlh: []string = [];
    g_loop_head = zlh;
    var zle: []string = [];
    g_loop_end = zle;
    var zde: []i64 = [];
    g_tir_defer = zde;

    // 参数：以 $name 作预填充 slot（memory-first：参数即本地 slot）
    // 闭包合成函数（M48）：仅 lambda 提升出的 FuncDecl（sc=="__lambda__"）且携带环境结构名
    // 时，前置 env 首参（与 TClosure ABI 一致）。普通函数（含 @__test_N 等）sc 非 __lambda__，
    // 即便 sb 被复用也不得加 env 形参，否则会向无关函数注入未被调用的 $__env 槽。
    if (base.node_sc((d as u64)) == "__lambda__" and str_len(base.node_sb((d as u64))) > 0) {
        var envst: string = "ptr<void>";
        var envslot: string = "$__env";
        append(g_cur_func.params, base.sb_cat4(envslot, ": ", envst, ""));
        append(g_local_names, "__env");
        append(g_local_slots, envslot);
        append(g_local_sts, envst);
        append(g_local_tds, -1);
        append(g_local_depths, 0);
        tir_emit(tir_emit_slot(envst, envslot));
    }
    var c: i64 = base.node_lb((d as u64));
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
    var c_ks: []i64 = base.kids_chain(c);
    var c_ki: i64 = 0;
    while (c_ki < slice_len(c_ks) as i64) {
        var c_kv: i64 = c_ks[c_ki];
        var pst: string = tir_st_of_td(sema.resolve_type_desc(base.node_na((c_kv as u64))));
        var pslot: string = base.sb_cat2("$", base.node_sa((c_kv as u64)));
        append(g_cur_func.params, base.sb_cat4(pslot, ": ", pst, ""));
        append(g_local_names, base.node_sa((c_kv as u64)));
        append(g_local_slots, pslot);
        append(g_local_sts, pst);
        append(g_local_tds, sema.resolve_type_desc(base.node_na((c_kv as u64))));
        append(g_local_depths, 0);
        tir_emit(tir_emit_slot(pst, pslot));
        c_ki = c_ki + 1;
    }

    if (base.node_lc((d as u64)) > -2) {
        var b: i64 = base.node_lc((d as u64));
        // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
        var b_ks: []i64 = base.kids_chain(b);
        var b_ki: i64 = 0;
        while (b_ki < slice_len(b_ks) as i64) {
            var b_kv: i64 = b_ks[b_ki];
            tir_emit_stmt(b_kv);
            b_ki = b_ki + 1;
        }
    }

    // 函数尾兜底返回：仅当函数体未以终止指令收尾（g_term==false）时发兜底 ret。
    // 若已有显式 return / br 收尾，g_term==true → 此处是死代码，跳过以避免线性块内重复终止符
    // （设计 §6.8：控制流显式终止；重复 ret 会破坏 Stage 2/3 的 tir→c/tir→ll 后端 verifier）。
    if (g_term == false) {
        tir_flush_defer();
        if (g_cur_func.ret_st == "void") {
            tir_emit(tir_emit_ret_void());
        } else {
            var z: string = tir_tmp();
            tir_emit(tir_emit_const(g_cur_func.ret_st, z, "0"));
            tir_emit(tir_emit_ret(g_cur_func.ret_st, z));
        }
    }
    // ⚠ 代际分配器：emit 逐函数重降级时（g_lower_suppress_append）不向 g_mod.funcs 追加，
    // 体由 g_cur_func 持有直接供 emit 消费（避免重复追加）；其余路径正常追加。
    if (g_lower_suppress_append == false) { tir_append_cur_func(); }
}

// ⚠ 代际分配器（2026-10-22）：签名级降级——只产出 FuncDecl 的「签名 + 空体」元数据进 g_arena，
// 函数体推迟到 emit 阶段逐函数重降级（tir_lower_func + arena_use_func/arena_reset_func）。
// 仅在 base.g_relowering 模式由 lower_unit 调用，代替完整 tir_lower_func（省去全函数体降级开销，
// 且不把体落 g_arena）。参数收集与闭包 env 首参逻辑与 tir_lower_func 保持一致，确保签名等价。
pub fn tir_lower_func_sig(d: i64) void {
    var fp: []string = [];
    g_cur_func = TIRFunc{ name: base.node_sa((d as u64)), ret_st: tir_st_of_td(tir_func_ret_td(d)), params: fp, body: [], is_extern: false, is_kernel: false, is_main: tir_ann_has(base.node_la((d as u64)), "main") };
    // ⚠ 同 tir_emit_extern：新函数开始须同步 MIR 录制缓冲，避免把上一个函数的 g_mir_cur 追加进来。
    if (g_recording_mir) { g_mir_cur = TIRFunc{ name: g_cur_func.name, ret_st: g_cur_func.ret_st, params: g_cur_func.params, body: [], is_extern: g_cur_func.is_extern, is_kernel: g_cur_func.is_kernel, is_main: g_cur_func.is_main }; }
    g_cur_ret_td = tir_func_ret_td(d);
    // 闭包合成函数（M48）：lambda 提升出的 FuncDecl 携带环境结构名时前置 env 首参（与 TClosure ABI 一致）。
    if (base.node_sc((d as u64)) == "__lambda__" and str_len(base.node_sb((d as u64))) > 0) {
        append(g_cur_func.params, base.sb_cat4("$__env", ": ", "ptr<void>", ""));
    }
    var c: i64 = base.node_lb((d as u64));
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
    var c_ks: []i64 = base.kids_chain(c);
    var c_ki: i64 = 0;
    while (c_ki < slice_len(c_ks) as i64) {
        var c_kv: i64 = c_ks[c_ki];
        var pst: string = tir_st_of_td(sema.resolve_type_desc(base.node_na((c_kv as u64))));
        append(g_cur_func.params, base.sb_cat4(base.sb_cat2("$", base.node_sa((c_kv as u64))), ": ", pst, ""));
        c_ki = c_ki + 1;
    }
    tir_append_cur_func();
}

// ══════════════════════════════════════════════════════════════════
// 语句发射（dispatch on node.kind）
// ══════════════════════════════════════════════════════════════════

pub fn tir_emit_stmt(sid: i64) void {
    g_cur_line = base.node_span_id(sid).line;
    var kd: string = base.node_kind((sid as u64));
    if (g_term) { return; }   // 当前块已终止：后续语句均为死代码，跳过

    if (kd == "var_decl") {
        if (sema.skip_var_has(sid)) { return; }   // S3/Q1：持有 type 值的变量 → 代码期擦除
        var st: string = "i64";
        var t: i64 = -1;
        if (base.node_na((sid as u64)) >= 0) { t = sema.resolve_type_desc(base.node_na((sid as u64))); if (t >= 0) { st = tir_st_of_td(t); } }
        // P5：unit/void 局部变量降级丢弃（C 中 `void x;` 非法）；初始化器仍求值以保副作用。
        if (t >= 0 and sema.tds[t].cat == "void") {
            if (base.node_nb((sid as u64)) >= 0) { tir_emit_expr(base.node_nb((sid as u64))); }
            return;
        }
        var slot: string = tir_new_named_slot(t, st, base.node_sa((sid as u64)));
        // map 类型变量声明：无初始化器时按 canonical 同构自动建空表（tll_map_new），
        // 否则后续 map_set/map_get/map_del 会解引用未初始化的句柄槽 → 运行时段错误。
        // 带 map_lit 初始化器时由 tir_emit_map_lit 负责建表+插入，此处跳过。
        // ⚠ 不可写 `sema.tds[t].key.cat`（两级 TD 字段链），emit-tir-ll 翻译嵌套
        // slice_at 会产出 `load i64, ptr null`；须先把 keytd 取到局部变量再单级访问。
        if (t >= 0 and sema.tds[t].cat == "map" and base.node_nb((sid as u64)) < 0) {
            var keytd: i64 = sema.tds[t].key;
            var keykind: i64 = 1;
            if (sema.tds[keytd].cat == "string") { keykind = 0; }
            var valst: string = tir_st_of_td(sema.tds[t].val);
            var valsz: i64 = tir_sizeof(valst);
            tir_emit(TIRInst{ op: TIR_OP_CALL, st: tir_st_from_str("ptr<void>"), dst: tir_op(slot), args: tir_a3("@map_new", base.i2s(keykind), base.i2s(valsz)), is_comment: false, line: g_cur_line, cmt: "" });
        }
        // Sym 类型 = 字符串字面量：自动 intern，slot 存 id（而非字符串本身）。
        // 与 canonical codegen_ll 同构：`call i32 @tll_sym_intern(ptr tag, ptr val, i64 bits)`。
        if (t >= 0 and sema.tds[t].cat == "sym" and base.node_nb((sid as u64)) >= 0 and base.node_kind((base.node_nb((sid as u64)) as u64)) == "string") {
            var valslotr: TirEmitRes = tir_emit_expr(base.node_nb((sid as u64))); var valslot: string = valslotr.name;
            var tagid: i64 = slice_len(g_mod.strings) as i64;
            // ⚠ 代际分配器（2026-10-22）：g_mod.strings 缓冲恒落 g_arena（跨函数回收后不悬垂）；
            // 降级进 g_func 本块时临时切回 g_arena 追加，追加后还原 g_func。
            if (base.g_relowering) { arena_use_default(); }
            append(g_mod.strings, sema.tds[t].name);
            if (base.g_relowering) { if (base.g_relowering_scratch_func) { arena_use_func(); } else { arena_use_default(); } }
            var tagslot: string = tir_tmp();
            tir_emit(TIRInst{ op: TIR_OP_CONST_STR, st: ST_NONE, dst: tir_op(tagslot), args: tir_a1(base.i2s(tagid)), is_comment: false, line: g_cur_line, cmt: "" });
            var bitsslot: string = tir_tmp();
            tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str("i64"), dst: tir_op(bitsslot), args: tir_a1(base.i2s(sema.tds[t].alen)), is_comment: false, line: g_cur_line, cmt: "" });
            // 32 位 Sym：直接把 intern 结果写进变量槽（call 的 DST=slot），绕开 TIR store 指令
            // 触发的 translator 窄化 trunc bug（store i32 -> u32 槽会生成非法 `trunc i64 i32 to i32`）。
            // 16 位 Sym：call 落 tmp，再 trunc i32->i16 后 store i16（同宽，安全）。
            if (st == "i16" or st == "u16") {
                var sidv: string = tir_tmp();
                tir_emit(TIRInst{ op: TIR_OP_CALL, st: tir_st_from_str("i32"), dst: tir_op(sidv), args: tir_a4("@sym_intern", tagslot, valslot, bitsslot), is_comment: false, line: g_cur_line, cmt: "" });
                var st16: string = tir_tmp();
                tir_emit(TIRInst{ op: TIR_OP_TRUNC, st: tir_st_from_str("i16"), dst: tir_op(st16), args: tir_a1(sidv), is_comment: false, line: g_cur_line, cmt: "" });
                tir_emit(TIRInst{ op: TIR_OP_STORE, st: ST_NONE, dst: tir_op(slot), args: tir_a1(st16), is_comment: false, line: g_cur_line, cmt: "" });
            } else if (st == "i64" or st == "u64") {
                // 64 位：intern 结果（i64）直接写进变量槽（call 的 DST=slot），绕开 translator store 的窄化 trunc。
                tir_emit(TIRInst{ op: TIR_OP_CALL, st: tir_st_from_str("i64"), dst: tir_op(slot), args: tir_a4("@sym_intern64", tagslot, valslot, bitsslot), is_comment: false, line: g_cur_line, cmt: "" });
            } else {
                tir_emit(TIRInst{ op: TIR_OP_CALL, st: tir_st_from_str("i32"), dst: tir_op(slot), args: tir_a4("@sym_intern", tagslot, valslot, bitsslot), is_comment: false, line: g_cur_line, cmt: "" });
            }
            return;
        }
        if (base.node_nb((sid as u64)) >= 0) {
            if (base.node_kind((base.node_nb((sid as u64)) as u64)) == "array_lit") {
                var initr: TirEmitRes = tir_emit_array_lit(base.node_nb((sid as u64)), t); var init: string = initr.name;
                tir_emit(TIRInst{ op: TIR_OP_STORE, st: ST_NONE, dst: tir_op(slot), args: tir_a1(init), is_comment: false, line: g_cur_line, cmt: "" });
            } else if (base.node_kind((base.node_nb((sid as u64)) as u64)) == "map_lit") {
                var initr: TirEmitRes = tir_emit_map_lit(base.node_nb((sid as u64)), t); var init: string = initr.name;
                tir_emit(TIRInst{ op: TIR_OP_STORE, st: ST_NONE, dst: tir_op(slot), args: tir_a1(init), is_comment: false, line: g_cur_line, cmt: "" });
            } else if (st == "ptr<void>" and base.node_kind((base.node_nb((sid as u64)) as u64)) == "ident" and tir_is_func_name(base.node_sa((base.node_nb((sid as u64)) as u64)))) {
                // 函数作为闭包值：包进 %TClosure（与 codegen_ll 的 @t.clos.X 全局一致）
                var clo: string = tir_make_closure_value(base.sb_cat2("@", base.node_sa((base.node_nb((sid as u64)) as u64))), "");
                tir_emit(TIRInst{ op: TIR_OP_STORE, st: ST_NONE, dst: tir_op(slot), args: tir_a1(clo), is_comment: false, line: g_cur_line, cmt: "" });
            } else {
                if (base.node_kind((base.node_nb((sid as u64)) as u64)) == "int" and base.awi_bits(st) > 64) {
                    // AWI：整数字面量直接以目标 i<N> 槽类型全精度发射（规避 tir_emit_expr 把字面量
                    // 降级成 i64 → 高位截断，如 u128 2^128-1 / i128 -1 经 ll_norm_imm 溢出成 2^64-1）。
                    var daw: string = tir_tmp();
                    tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str(st), dst: tir_op(daw), args: tir_a1(base.node_sa((base.node_nb((sid as u64)) as u64))), is_comment: false, line: g_cur_line, cmt: "" });
                    tir_emit(TIRInst{ op: TIR_OP_STORE, st: ST_NONE, dst: tir_op(slot), args: tir_a1(daw), is_comment: false, line: g_cur_line, cmt: "" });
                } else {
                    // O-6：`var o: ?i64 = null` 须让初始化器知道目标是 %Opt_X，否则发射成空指针。
                    tir_maybe_expect_opt_none(base.node_nb((sid as u64)), st);
                    var initr: TirEmitRes = tir_emit_expr(base.node_nb((sid as u64))); var init: string = initr.name;
                    if (st == "%TSlice") { init = tir_maybe_array_to_slice(init, base.node_nb((sid as u64))); }
                    tir_emit(TIRInst{ op: TIR_OP_STORE, st: ST_NONE, dst: tir_op(slot), args: tir_a1(init), is_comment: false, line: g_cur_line, cmt: "" });
                }
            }
        }
        // 无初始化器的切片声明：必须在**声明点**显式建空表（带正确 elem_size）。
        // TIR 轨此前只在入口 alloca + zeroinitializer 一次 —— 声明在循环体内时，
        // 上一轮 append 出来的缓冲/长度会被带进下一轮（C 后端在声明点发
        // `TSlice x = t_slice_new(sizeof(T))`，每轮都是新表，LLVM 轨不是）⇒ 双后端分叉。
        // 实测后果：编译器自身 emit_struct_families_ordered 的依赖缓冲 depbuf 跨轮累积，
        // 跨模块结构体拓扑排序退化成 decl_list 顺序 ⇒ agent_npc_mind 的 C 产物
        // `unknown type 'physics__Velocity'`（LLVM 后端静默错编编译器自身的 C 后端）。
        if (base.node_nb((sid as u64)) < 0 and st == "%TSlice") {
            tir_emit_slice_default(slot, t);
        }
        return;
    }
    if (kd == "expr") {
        var _xr: TirEmitRes = tir_emit_expr(base.node_na((sid as u64))); var _x: string = _xr.name;
        return;
    }
    if (kd == "if") { tir_emit_if(sid); return; }
    // ⚠ 传 **节点索引** 而非 Node 值：Node 结构体值传参时末尾字段 `id` 不可靠
    //   （实测形参 n.id 读到垃圾值 75，真实下标为 331），故凡需按 id 查侧表的
    //   发射函数一律收 sid（本批 nc 迁移时定位，详见 §0.14.7 第九批「坑」）。
    if (kd == "for") { tir_emit_for(sid); return; }
    if (kd == "while") { tir_emit_while(sid); return; }
    if (kd == "for_each") { tir_emit_for_each(sid); return; }
    if (kd == "block") {
        // fault B4b 位置②：`var x : T = trap …;` 的脱糖产物块。它只是**一条语句的展开**，
        //   不是新作用域 —— 其中声明的 x 必须对块外继续可见（A-34）。
        //   ⚠ 若不特殊处理，本块的 push/pop 会把 x 登记在子深度，块外 `tir_find_local_idx`
        //   的 `g_local_depths[i] <= g_blk_depth` 过滤就查不到它 ⇒ 被当成未定义全局，
        //   链接期报 `undefined symbol: x`（实测）。bf 标记时跳过深度增减，产物变量留在父深度。
        var tflat: bool = base.node_bf((sid as u64));
        if (tflat == false) { tir_blk_push(); }
        var c: i64 = base.node_la((sid as u64));
        // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
        var c_ks: []i64 = base.kids_chain(c);
        var c_ki: i64 = 0;
        while (c_ki < slice_len(c_ks) as i64) {
            var c_kv: i64 = c_ks[c_ki];
            tir_emit_stmt(c_kv);
            c_ki = c_ki + 1;
        }
        if (tflat == false) { tir_blk_pop(); }
        return;
    }
    if (kd == "comptime_block") {
        var c: i64 = base.node_la((sid as u64));
        // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
        var c_ks: []i64 = base.kids_chain(c);
        var c_ki: i64 = 0;
        while (c_ki < slice_len(c_ks) as i64) {
            var c_kv: i64 = c_ks[c_ki];
            tir_emit_stmt(c_kv);
            c_ki = c_ki + 1;
        }
        return;
    }
    if (kd == "return") {
        g_term = false;
        if (base.node_na((sid as u64)) >= 0) {
            // P5：return () 在 void 函数中 = RET_VOID（unit 无载荷，发射占位值无意义）。
            if (base.node_kind((base.node_na((sid as u64)) as u64)) == "unit_lit") { tir_flush_defer(); tir_emit(tir_emit_ret_void()); return; }
            var s: string;
        if (base.node_kind((base.node_na((sid as u64)) as u64)) == "array_lit" and g_cur_ret_td >= 0 and sema.tds[g_cur_ret_td].cat == "array") {
            var __er1: TirEmitRes = tir_emit_array_lit(base.node_na((sid as u64)), g_cur_ret_td); s = __er1.name;
        } else if (base.node_kind((base.node_na((sid as u64)) as u64)) == "map_lit" and g_cur_ret_td >= 0 and sema.tds[g_cur_ret_td].cat == "map") {
            // ⚠ map 字面量作返回值：tir_emit_expr 落到 map_lit 分支时 force_td=-1，
            // 而 tir_expr_td 对 map_lit 不可靠（sema 不回填 .td），会触发 untyped 兜底返回 0 指针 → 段错误。
            // 故此处显式用函数返回类型 TD 构造（与 array_lit 返回降级同构）。
            var __er1m: TirEmitRes = tir_emit_map_lit(base.node_na((sid as u64)), g_cur_ret_td); s = __er1m.name;
        } else {
            g_expect_st = tir_st_from_str(g_cur_func.ret_st);
            var __er2: TirEmitRes = tir_emit_expr(base.node_na((sid as u64))); s = __er2.name;
            // 返回值按函数返回类型对齐（修复 i64 字面量/表达式直接 ret 给 i32 函数 →
            // LLVM `ret i32 <i64 值>` 类型错配：翻译器按槽真实宽度 load（i64）却 ret i32）。
            var rsts: string = g_cur_func.ret_st;
            if (tir_st_to_str(__er2.st) != rsts) { s = tir_cast_slot(s, __er2.st, rsts); }
        }
            // ⚠ defer 必须在「返回值表达式求值之后、ret 之前」排空。否则含递归调用的返回值
            // 会在 defer 体（如恢复现场 / 解除访问标记）之前执行，导致递归守卫失效 →
            // 无限递归 / STATUS_STACK_OVERFLOW（见 _breakerC.tc：defer{vis[e]=0} 被提前到递归调用前）。
            tir_flush_defer();
            tir_emit(tir_emit_ret(g_cur_func.ret_st, s));
        } else {
            tir_flush_defer();
            tir_emit(tir_emit_ret_void());
        }
        return;
    }
    if (kd == "assignment" or kd == "assign") { tir_emit_assign(sid, tir_st_from_str(tir_expr_st(sid))); return; }
    if (kd == "defer") {
        append(g_tir_defer, sid);   // 登记延迟语句，遇 return / 函数尾按 LIFO 排空
        return;
    }
    if (kd == "match") { tir_emit_match(sid, true, tir_st_from_str(tir_expr_st(sid))); return; }
    if (kd == "break") {
        var endL: string = tir_loop_top_end();
        if (endL != "") { tir_emit(tir_emit_br(endL)); }
        else { tir_cmt("break outside loop"); }
        return;
    }
    if (kd == "continue") {
        var headL: string = tir_loop_top_head();
        if (headL != "") { tir_emit(tir_emit_br(headL)); }
        else { tir_cmt("continue outside loop"); }
        return;
    }
    if (kd == "closure_capture") { tir_emit_closure_capture(sid); return; }
    tir_cmt(base.sb_cat3("unsupported stmt: ", kd, ""));
}

// 闭包捕获（Stage 6）：从 lambda 首参 $__env（ptr<void>）按字段拷回被捕获量到本地 slot。
// n.sa=变量名, n.sb=环境结构名(__env_N), n.na=类型 desc, n.ia=字段索引。
// 镜像 codegen_ll.tc:4259 closure_capture（gep %st.<sb>, ptr %__env, 0, n.ia）。
// ⚠ 收**节点索引**而非 Node 值：Node 结构体值传参时末尾字段 `id` 不可读（批次 9 致命坑），
//   而 sb 已外置为侧表、必须按 id 查 ⇒ 函数内自行取节点（与同文件的 `tir_emit_for(sid)` 同形）。
pub fn tir_emit_closure_capture(sid: i64) void {
    var cctd: i64 = sema.resolve_type_desc(base.node_na((sid as u64)));
    var ccst: string = "i64";
    if (cctd >= 0) { ccst = tir_st_of_td(cctd); }
    // 登记为本地 slot，使 lambda 体内对该变量的 ident 引用解析到本地（而非 @全局）
    var cvslot: string = tir_new_named_slot(cctd, ccst, base.node_sa((sid as u64)));
    var envty: string = base.sb_cat2("%", base.node_sb((sid as u64)));   // S4 §0.14.7 SoA：侧表读（原 base.node_sb((n.id as u64))；第十二批）
    var eptr: string = tir_tmp();
    tir_emit(tir_emit_bitcast(base.sb_cat3("ptr<", envty, ">"), eptr, "$__env"));
    var faddr: string = tir_tmp();
    var __fidxs: []string = [];
    append(__fidxs, "0");
    append(__fidxs, base.i2s(base.node_ia((sid as u64))));
    tir_emit(tir_emit_gep(ccst, faddr, eptr, __fidxs));
    var ld: string = tir_tmp();
    tir_emit(tir_emit_load(ccst, ld, faddr));
    tir_emit(tir_emit_store(ld, cvslot));
}

// ⚠ 形参是**节点索引 sid** 而非 Node 值：Node 结构体值传参时末尾字段 `id` 不可靠
//   （批次 9 致命坑：按 n.id 查侧表会读到错误节点 ⇒ 子节点静默丢失）。本函数要读 lb 侧表，
//   必须收索引 —— 与隔壁 `tir_emit_for(sid)` / `tir_emit_for_each(sid)` 同式；
//   唯一调用点 `tir_emit_stmt` 里 `sid` 现成可用（§0.14.7 第十四批）。
pub fn tir_emit_if(sid: i64) void {
    var condr: TirEmitRes = tir_emit_expr(base.node_na((sid as u64))); var cond: string = condr.name;
    var thenL: string = tir_lbl("if.t");
    var endL: string = tir_lbl("if.e");
    var has_else: bool = base.node_lb((sid as u64)) > -2;
    var elseL: string = endL;
    if (has_else) { elseL = tir_lbl("if.f"); }
    tir_emit(tir_emit_br_cond(cond, thenL, elseL));
    tir_block(thenL);
    tir_blk_push();
    var tb: i64 = base.node_la((sid as u64));
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
    var tb_ks: []i64 = base.kids_chain(tb);
    var tb_ki: i64 = 0;
    while (tb_ki < slice_len(tb_ks) as i64) {
        var tb_kv: i64 = tb_ks[tb_ki];
        tir_emit_stmt(tb_kv);
        tb_ki = tb_ki + 1;
    }
    tir_blk_pop();
    tir_emit(tir_emit_br(endL));
    if (has_else) {
        tir_block(elseL);
        tir_blk_push();
        var eb: i64 = base.node_lb((sid as u64));
        // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
        var eb_ks: []i64 = base.kids_chain(eb);
        var eb_ki: i64 = 0;
        while (eb_ki < slice_len(eb_ks) as i64) {
            var eb_kv: i64 = eb_ks[eb_ki];
            tir_emit_stmt(eb_kv);
            eb_ki = eb_ki + 1;
        }
        tir_blk_pop();
        tir_emit(tir_emit_br(endL));
    }
    tir_block(endL);
}

// ⚠ 形参是**节点索引 sid** 而非 Node 值：见调用点注释（Node 值传参会丢末尾 id 字段）。
pub fn tir_emit_for(sid: i64) void {
    if (base.node_na((sid as u64)) >= 0) { tir_emit_stmt(base.node_na((sid as u64))); }    // 初始化（通常 var_decl）
    var headL: string = tir_lbl("for.h");
    var bodyL: string = tir_lbl("for.b");
    var contL: string = tir_lbl("for.c");   // continue 目标 = 增量块（不跳过增量）
    var endL: string = tir_lbl("for.e");
    // ⚠ for 循环的 continue 必须跳到「增量块」而非「条件头」：否则遇 continue 时增量被跳过，
    //   导致死循环（LLVM 后端字面发射会触发该 bug；C 后端因原生 for(;cond;incr) 语义掩掉）。
    tir_loop_push(contL, endL);
    tir_emit(tir_emit_br(headL));
    tir_block(headL);
    if (base.node_nb((sid as u64)) >= 0) {
        var condr: TirEmitRes = tir_emit_expr(base.node_nb((sid as u64))); var cond: string = condr.name;
        tir_emit(tir_emit_br_cond(cond, bodyL, endL));
    } else {
        tir_emit(tir_emit_br(bodyL));
    }
    tir_block(bodyL);
    tir_blk_push();
    var bc: i64 = base.node_la((sid as u64));
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
    var bc_ks: []i64 = base.kids_chain(bc);
    var bc_ki: i64 = 0;
    while (bc_ki < slice_len(bc_ks) as i64) {
        var bc_kv: i64 = bc_ks[bc_ki];
        tir_emit_stmt(bc_kv);
        bc_ki = bc_ki + 1;
    }
    tir_blk_pop();
    tir_emit(tir_emit_br(contL));   // body 末尾跳增量块（continue 也跳此）
    tir_block(contL);
    var nc_upd: i64 = base.node_nc((sid as u64));   // S4 §0.14.7 SoA：侧表读（原 n.nc；第九批）
    if (nc_upd >= 0) { tir_emit_stmt(nc_upd); }     // 增量（通常 assignment）
    tir_emit(tir_emit_br(headL));
    tir_block(endL);
    tir_loop_pop();
}

// S4 §0.14.7 SoA（第十六批）：本函数要按 id 读 la 侧表，而 **Node 结构体值传参时末尾字段 `id`
//   不可靠**（实测形参读到垃圾值，见 §0.14.7 第九批「坑」）⇒ 唯一调用点（tir_emit_stmt:2289）
//   作用域内已有裸索引 `sid`，据此改为收索引、函数内自行取值。
pub fn tir_emit_while(sid: i64) void {
    var headL: string = tir_lbl("while.h");
    var bodyL: string = tir_lbl("while.b");
    var endL: string = tir_lbl("while.e");
    tir_loop_push(headL, endL);
    tir_emit(tir_emit_br(headL));
    tir_block(headL);
    var condr: TirEmitRes = tir_emit_expr(base.node_na((sid as u64))); var cond: string = condr.name;
    tir_emit(tir_emit_br_cond(cond, bodyL, endL));
    tir_block(bodyL);
    tir_blk_push();
    var bc: i64 = base.node_la((sid as u64));
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
    var bc_ks: []i64 = base.kids_chain(bc);
    var bc_ki: i64 = 0;
    while (bc_ki < slice_len(bc_ks) as i64) {
        var bc_kv: i64 = bc_ks[bc_ki];
        tir_emit_stmt(bc_kv);
        bc_ki = bc_ki + 1;
    }
    tir_blk_pop();
    tir_emit(tir_emit_br(headL));
    tir_block(endL);
    tir_loop_pop();
}

// for_each 降级（Stage 4）：slice / 定长数组迭代。
// n.sa=循环变量名, n.sb=可选第二变量(map 双变量, 本期不覆盖), n.na=集合表达式, n.la=循环体。
// slice 长度自 %TSlice 字段 1 读取（不依赖 tll_slice_len 运行时）；定长数组用编译期 N。
// ⚠ 收**节点索引**而非 Node 值（同 `tir_emit_for` / `tir_emit_closure_capture`）：
//   Node 值传参时末尾字段 `id` 不可读，sb 侧表必须按 id 查 ⇒ 函数内自行取节点。
pub fn tir_emit_for_each(sid: i64) void {
    if (g_term) { return; }
    var coll_td: i64 = tir_expr_td(base.node_na((sid as u64)));
    // ⚠ member 基底（如 c.opts）：tir_expr_td 对 member 节点不可靠（node.td 缓存易污染，
    //   常返回 i64 等错类型），导致 for_each 走入 unsupported 分支、迭代 0 次（map_advanced 末段
    //   for (ck, cv in c.opts) 漏迭代）。用「结构体基底类型 + 字段名」强制查字段 TD 校正
    //   （与 tir_emit_index_addr 的 member 校正同构）。
    if (base.node_kind((base.node_na((sid as u64)) as u64)) == "member") {
        var mbtd: i64 = tir_expr_td(base.node_na((base.node_na((sid as u64)) as u64)));
        if (mbtd >= 0) {
            var mbst: string = tir_st_of_td(mbtd);
            if (str_len(mbst) > 0 and mbst[0] == '%') {
                var ftd: i64 = tir_field_td(str_slice(mbst, 1, str_len(mbst)), base.node_sa((base.node_na((sid as u64)) as u64)));
                if (ftd >= 0) { coll_td = ftd; }
            }
        }
    }
    if (coll_td < 0) { tir_cmt("unsupported for_each: untyped collection"); return; }
    tir_blk_push();
    var ct: TD = sema.tds[coll_td];
    var etd: i64 = -1;
    var is_arr: bool = false;
    var arr_n: i64 = -1;
    if (ct.cat == "slice") { etd = ct.elem; }
    else if (ct.cat == "array") { etd = ct.elem; is_arr = true; arr_n = ct.alen; }
    else if (ct.cat == "map") {
        var keytd: i64 = ct.key;
        var keyst: string = tir_st_of_td(keytd);
        var valtd: i64 = -1;
        var valst: string = "i64";
        var has_val: bool = false;
        if (ct.val >= 0) { valtd = ct.val; valst = tir_st_of_td(valtd); has_val = true; }
        var iterr: TirEmitRes = tir_emit_expr(base.node_na((sid as u64))); var iter: string = iterr.name;
        var lv: string = tir_new_named_slot(keytd, keyst, base.node_sa((sid as u64)));
        var lvval: string = "";
        var n_sb: string = base.node_sb((sid as u64));   // S4 §0.14.7 SoA：侧表读（原 base.node_sb((n.id as u64))；第十二批）
        if (has_val and str_len(n_sb) > 0) { lvval = tir_new_named_slot(valtd, valst, n_sb); }
        var cnt: string = tir_tmp();
        tir_emit(tir_e_call("i64", cnt, "@tll_map_count", tir_cargs1(iter)));
        var idx: string = tir_new_named_slot(-1, "i64", "__fe_idx");
        var z: string = tir_tmp();
        tir_emit(tir_emit_const_typed("i64", z, "0"));
        tir_emit(tir_emit_store(z, idx));
        var headL: string = tir_lbl("fe.h");
        var bodyL: string = tir_lbl("fe.b");
        var stepL: string = tir_lbl("fe.s");
        var endL: string = tir_lbl("fe.e");
        tir_loop_push(stepL, endL);   // ⚠ continue 必须跳 stepL（增量块），否则跳过 idx++
        tir_emit(tir_emit_br(headL));
        tir_block(headL);
        var cidx: string = tir_tmp();
        tir_emit(tir_emit_load("i64", cidx, idx));
        var ccmp: string = tir_tmp();
        tir_emit(tir_emit_binop(TIR_OP_SLT, "i64", ccmp, cidx, cnt));
        tir_emit(tir_emit_br_cond(ccmp, bodyL, endL));
        tir_block(bodyL);
        if (sema.tds[keytd].cat == "string") {
            var kaddr: string = tir_tmp();
            tir_emit(tir_emit_addr_of(base.sb_cat3("ptr<", keyst, ">"), kaddr, lv));
            tir_emit(tir_emit_call_nodst("void", "@tll_map_key_str_at", tir_cargs3(iter, cidx, kaddr)));
        } else {
            var kv: string = tir_tmp();
            tir_emit(tir_e_call("i64", kv, "@tll_map_key_int_at", tir_cargs2(iter, cidx)));
            if (keyst != "i64") {
                var ktr: string = tir_tmp();
                tir_emit(tir_e_cast(TIR_OP_TRUNC, keyst, ktr, kv));
                tir_emit(tir_emit_store(ktr, lv));
            } else {
                tir_emit(tir_emit_store(kv, lv));
            }
        }
        if (has_val and str_len(base.node_sb((sid as u64))) > 0) {   // S4 §0.14.7 SoA：侧表读（原 base.node_sb((n.id as u64))；第十二批）
            var vp: string = tir_tmp();
            tir_emit(tir_e_call(base.sb_cat3("ptr<", valst, ">"), vp, "@tll_map_val_at", tir_cargs2(iter, cidx)));
            var vv: string = tir_tmp();
            tir_emit(tir_emit_load(valst, vv, vp));
            tir_emit(tir_emit_store(vv, lvval));
        }
        var bc: i64 = base.node_la((sid as u64));
        // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
        var bc_ks: []i64 = base.kids_chain(bc);
        var bc_ki: i64 = 0;
        while (bc_ki < slice_len(bc_ks) as i64) {
            var bc_kv: i64 = bc_ks[bc_ki];
            tir_emit_stmt(bc_kv);
            bc_ki = bc_ki + 1;
        }
        tir_emit(tir_emit_br(stepL));
        tir_block(stepL);
        var cidx2: string = tir_tmp();
        tir_emit(tir_emit_load("i64", cidx2, idx));
        var cidx3: string = tir_tmp();
        tir_emit(tir_emit_binop(TIR_OP_ADD, "i64", cidx3, cidx2, "1"));
        tir_emit(tir_emit_store(cidx3, idx));
        tir_emit(tir_emit_br(headL));
        tir_block(endL);
        tir_blk_pop();
        tir_loop_pop();
        return;
    } else if (ct.cat == "bitstr") {
        // 字节遍历：nbytes = ceil(bit_len/8)，元素 u8 从 %TBitStr.f0 ptr[i] 读（与 C 后端 codegen_c.tc:3511 对齐）
        var etd: i64 = sema.td_named_mk("scalar", "u8");
        var elem_st: string = "u8";   // ⚠ 必须是 u8：int_to_str(x) 经 ll_load→zext 才能与 C 端 uint8_t 零扩展一致（否则 -72 vs 184）
        var iterr: TirEmitRes = tir_emit_expr(base.node_na((sid as u64))); var iter: string = iterr.name;
        // 循环变量 x：u8 槽
        var lv: string = tir_new_named_slot(etd, elem_st, base.node_sa((sid as u64)));
        // bit_len = iter.f1
        var bladdr: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_GEP, st: tir_st_from_str("i64"), dst: tir_op(bladdr), args: tir_a2(iter, "1"), is_comment: false, line: g_cur_line, cmt: "" });
        var blen: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_LOAD, st: tir_st_from_str("i64"), dst: tir_op(blen), args: tir_a1(bladdr), is_comment: false, line: g_cur_line, cmt: "" });
        // nbytes = (bit_len + 7) / 8
        var bl7: string = tir_tmp();
        tir_emit(tir_emit_binop(TIR_OP_ADD, "i64", bl7, blen, "7"));
        var len: string = tir_tmp();
        tir_emit(tir_emit_binop(TIR_OP_UDIV, "i64", len, bl7, "8"));
        // idx = 0
        var idx: string = tir_new_named_slot(-1, "i64", "__fe_idx");
        var z: string = tir_tmp();
        tir_emit(tir_emit_const_typed("i64", z, "0"));
        tir_emit(tir_emit_store(z, idx));
        // 循环骨架
        var headL: string = tir_lbl("fe.h");
        var bodyL: string = tir_lbl("fe.b");
        var stepL: string = tir_lbl("fe.s");
        var endL: string = tir_lbl("fe.e");
        tir_loop_push(stepL, endL);   // ⚠ continue 必须跳 stepL（增量块），否则跳过 idx++
        tir_emit(tir_emit_br(headL));
        tir_block(headL);
        var cidx: string = tir_tmp();
        tir_emit(tir_emit_load("i64", cidx, idx));
        var ccmp: string = tir_tmp();
        tir_emit(tir_emit_binop(TIR_OP_SLT, "i64", ccmp, cidx, len));
        tir_emit(tir_emit_br_cond(ccmp, bodyL, endL));
        tir_block(bodyL);
        // 元素地址：buffer ptr = iter.f0 (ptr<i8>)
        var vaddr: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_GEP, st: tir_st_from_str("ptr<i8>"), dst: tir_op(vaddr), args: tir_a2(iter, "0"), is_comment: false, line: g_cur_line, cmt: "" });
        var vptr: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_LOAD, st: tir_st_from_str("ptr<i8>"), dst: tir_op(vptr), args: tir_a1(vaddr), is_comment: false, line: g_cur_line, cmt: "" });
        var eptr: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_GEP_IDX, st: tir_st_from_str("i8"), dst: tir_op(eptr), args: tir_a2(vptr, cidx), is_comment: false, line: g_cur_line, cmt: "" });
        var ev: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_LOAD, st: tir_st_from_str("i8"), dst: tir_op(ev), args: tir_a1(eptr), is_comment: false, line: g_cur_line, cmt: "" });
        // ⚠ 字节元素必须【零扩展】进标量栈槽（恒 i64，见 ll_ensure_slot 加宽）：直接 store i8 会被 sign-extend 成负数
        // （0xB8→-72），而 C 端 uint8_t 零扩展为 184。先 zext i8→i64 再存，确保与 C 后端一致。
        var evi64: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_ZEXT, st: tir_st_from_str("i64"), dst: tir_op(evi64), args: tir_a1(ev), is_comment: false, line: g_cur_line, cmt: "" });
        tir_emit(TIRInst{ op: TIR_OP_STORE, st: ST_NONE, dst: tir_op(lv), args: tir_a1(evi64), is_comment: false, line: g_cur_line, cmt: "" });
        // 循环体
        var bc: i64 = base.node_la((sid as u64));
        // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
        var bc_ks: []i64 = base.kids_chain(bc);
        var bc_ki: i64 = 0;
        while (bc_ki < slice_len(bc_ks) as i64) {
            var bc_kv: i64 = bc_ks[bc_ki];
            tir_emit_stmt(bc_kv);
            bc_ki = bc_ki + 1;
        }
        tir_emit(tir_emit_br(stepL));
        tir_block(stepL);
        var cidx2: string = tir_tmp();
        tir_emit(tir_emit_load("i64", cidx2, idx));
        var cidx3: string = tir_tmp();
        tir_emit(tir_emit_binop(TIR_OP_ADD, "i64", cidx3, cidx2, "1"));
        tir_emit(tir_emit_store(cidx3, idx));
        tir_emit(tir_emit_br(headL));
        tir_block(endL);
        tir_blk_pop();
        tir_loop_pop();
        return;
    } else {
        tir_cmt(base.sb_cat3("unsupported for_each collection: ", ct.cat, ""));
        tir_blk_pop();
        return;
    }
    var elem_st: string = tir_st_value_of_td(etd);   // 值布局：变体按 %V(24B) 而非 ptr<%V>(8B) 算 GEP 步长
    var iterr: TirEmitRes = tir_emit_expr(base.node_na((sid as u64))); var iter: string = iterr.name;   // slot of %TSlice / arr<...>
    // 循环变量：按 n.sa 登记进 ident 查找表，循环体 ident 解析到本 slot
    var lv: string = tir_new_named_slot(etd, elem_st, base.node_sa((sid as u64)));
    var idx: string = tir_new_named_slot(-1, "i64", "__fe_idx");
    // 长度
    var len: string;
    if (is_arr) {
        len = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str("i64"), dst: tir_op(len), args: tir_a1(base.i2s(arr_n)), is_comment: false, line: g_cur_line, cmt: "" });
    } else {
        var laddr: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_GEP, st: tir_st_from_str("i64"), dst: tir_op(laddr), args: tir_a2(iter, "1"), is_comment: false, line: g_cur_line, cmt: "" });
        len = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_LOAD, st: tir_st_from_str("i64"), dst: tir_op(len), args: tir_a1(laddr), is_comment: false, line: g_cur_line, cmt: "" });
    }
    // idx = 0
    var z: string = tir_tmp();
    tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str("i64"), dst: tir_op(z), args: tir_a1("0"), is_comment: false, line: g_cur_line, cmt: "" });
    tir_emit(TIRInst{ op: TIR_OP_STORE, st: ST_NONE, dst: tir_op(idx), args: tir_a1(z), is_comment: false, line: g_cur_line, cmt: "" });
    // 循环骨架
    var headL: string = tir_lbl("fe.h");
    var bodyL: string = tir_lbl("fe.b");
    var stepL: string = tir_lbl("fe.s");
    var endL: string = tir_lbl("fe.e");
    tir_loop_push(stepL, endL);   // ⚠ continue 必须跳 stepL（增量块），否则跳过 idx++
    tir_emit(TIRInst{ op: TIR_OP_BR, st: ST_NONE, dst: tir_op(""), args: tir_a1(headL), is_comment: false, line: g_cur_line, cmt: "" });
    tir_block(headL);
    var cidx: string = tir_tmp();
    tir_emit(TIRInst{ op: TIR_OP_LOAD, st: tir_st_from_str("i64"), dst: tir_op(cidx), args: tir_a1(idx), is_comment: false, line: g_cur_line, cmt: "" });
    var ccmp: string = tir_tmp();
    tir_emit(TIRInst{ op: TIR_OP_SLT, st: tir_st_from_str("i64"), dst: tir_op(ccmp), args: tir_a2(cidx, len), is_comment: false, line: g_cur_line, cmt: "" });
    tir_emit(TIRInst{ op: TIR_OP_BR_COND, st: ST_NONE, dst: tir_op(""), args: tir_a3(ccmp, bodyL, endL), is_comment: false, line: g_cur_line, cmt: "" });
    tir_block(bodyL);
    // 元素地址
    var eptr: string;
    if (is_arr) {
        var bptr: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_ADDR_OF, st: tir_st_from_str(tir_st_of_td(coll_td)), dst: tir_op(bptr), args: tir_a1(iter), is_comment: false, line: g_cur_line, cmt: "" });
        eptr = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_GEP_IDX, st: tir_st_from_str(elem_st), dst: tir_op(eptr), args: tir_a2(bptr, cidx), is_comment: false, line: g_cur_line, cmt: "" });
    } else {
        var vaddr: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_GEP, st: tir_st_from_str("ptr<void>"), dst: tir_op(vaddr), args: tir_a2(iter, "0"), is_comment: false, line: g_cur_line, cmt: "" });
        var vptr: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_LOAD, st: tir_st_from_str("ptr<void>"), dst: tir_op(vptr), args: tir_a1(vaddr), is_comment: false, line: g_cur_line, cmt: "" });
        var eptr0: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_BITCAST, st: tir_st_from_str(elem_st), dst: tir_op(eptr0), args: tir_a1(vptr), is_comment: false, line: g_cur_line, cmt: "" });
        eptr = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_GEP_IDX, st: tir_st_from_str(elem_st), dst: tir_op(eptr), args: tir_a2(eptr0, cidx), is_comment: false, line: g_cur_line, cmt: "" });
    }
    var ev: string = tir_tmp();
    tir_emit(TIRInst{ op: TIR_OP_LOAD, st: tir_st_from_str(elem_st), dst: tir_op(ev), args: tir_a1(eptr), is_comment: false, line: g_cur_line, cmt: "" });
    tir_emit(TIRInst{ op: TIR_OP_STORE, st: ST_NONE, dst: tir_op(lv), args: tir_a1(ev), is_comment: false, line: g_cur_line, cmt: "" });
    // 循环体
    var bc: i64 = base.node_la((sid as u64));
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
    var bc_ks: []i64 = base.kids_chain(bc);
    var bc_ki: i64 = 0;
    while (bc_ki < slice_len(bc_ks) as i64) {
        var bc_kv: i64 = bc_ks[bc_ki];
        tir_emit_stmt(bc_kv);
        bc_ki = bc_ki + 1;
    }
    tir_emit(TIRInst{ op: TIR_OP_BR, st: ST_NONE, dst: tir_op(""), args: tir_a1(stepL), is_comment: false, line: g_cur_line, cmt: "" });
    tir_block(stepL);
    var cidx2: string = tir_tmp();
    tir_emit(TIRInst{ op: TIR_OP_LOAD, st: tir_st_from_str("i64"), dst: tir_op(cidx2), args: tir_a1(idx), is_comment: false, line: g_cur_line, cmt: "" });
    var cidx3: string = tir_tmp();
    tir_emit(TIRInst{ op: TIR_OP_ADD, st: tir_st_from_str("i64"), dst: tir_op(cidx3), args: tir_a2(cidx2, "1"), is_comment: false, line: g_cur_line, cmt: "" });
    tir_emit(TIRInst{ op: TIR_OP_STORE, st: ST_NONE, dst: tir_op(idx), args: tir_a1(cidx3), is_comment: false, line: g_cur_line, cmt: "" });
    tir_emit(TIRInst{ op: TIR_OP_BR, st: ST_NONE, dst: tir_op(""), args: tir_a1(headL), is_comment: false, line: g_cur_line, cmt: "" });
    tir_block(endL);
    tir_blk_pop();
    tir_loop_pop();
}

// 取赋值 LHS 的期望 TD：局部符号表 → 全局/成员 → LHS 表达式自身类型推导。
// ⚠ 此前只查局部符号表（`tir_find_local_idx`），LHS 是**全局变量**时返回 -1 ⇒
//   空切片字面量 `g = []` 的元素类型退化成默认 i64 ⇒ %TSlice.elem_size = 8 而非 16
//   ⇒ t_slice_append / t_slice_at 按 8 字节步长寻址，%TStr 的 len 字段读到邻字节
//   （症状：println 输出空行或内存残片；编译器自举二代 arena OOM 的真因）。
//   C 后端发 `t_slice_new(sizeof(T))` 恒正确，故只有双后端 differential 能暴露。
pub fn tir_lhs_td(na: i64) i64 {
    if (base.node_kind((na as u64)) == "ident") {
        var idx: i64 = tir_find_local_idx(base.node_sa((na as u64)));
        if (idx >= 0) { return g_local_tds[idx]; }
    }
    if (base.node_kind((na as u64)) == "index") {
        var btd: i64 = tir_expr_td(base.node_na((na as u64)));
        if (btd >= 0 and sema.tds[btd].cat == "map") { return sema.tds[btd].val; }
    }
    return tir_expr_td(na);
}

// ⚠ 形参 Node 值 `n` → 节点索引 `sid`（Node 结构体值传参时末尾字段 `id` 不可靠，批次 9 致命坑；
//   本函数读 nb 侧表必须基于索引，§0.14.7 第十五批）。两个调用点均现成有裸索引
//   （`tir_emit_stmt` 的 `sid`、`tir_emit_expr` 的 `e`）。
pub fn tir_emit_assign(sid: i64, est: i64) TirEmitRes {
    var op: string = base.node_sa((sid as u64));
    if (op == "=") {
        var rhs: string;
        if (base.node_kind((base.node_nb((sid as u64)) as u64)) == "array_lit") {
            // 期望类型来自 LHS（局部 TD / 全局 TD / LHS 表达式类型）；使固定数组字面量落到 arr< 而非 slice
            var lhstd: i64 = tir_lhs_td(base.node_na((sid as u64)));
            var __er3: TirEmitRes = tir_emit_array_lit(base.node_nb((sid as u64)), lhstd); rhs = __er3.name;
        } else if (base.node_kind((base.node_nb((sid as u64)) as u64)) == "map_lit") {
            var lhstd: i64 = -1;
            if (base.node_kind((base.node_na((sid as u64)) as u64)) == "ident") {
                var idx: i64 = tir_find_local_idx(base.node_sa((base.node_na((sid as u64)) as u64)));
                if (idx >= 0) { lhstd = g_local_tds[idx]; }
            } else if (base.node_kind((base.node_na((sid as u64)) as u64)) == "index") {
                // 嵌套 map：LHS 是 m[k]，值类型 = 外层 map 的 val TD（递归构造内层的上下文类型）。
                var btd: i64 = tir_expr_td(base.node_na((base.node_na((sid as u64)) as u64)));
                if (btd >= 0 and sema.tds[btd].cat == "map") { lhstd = sema.tds[btd].val; }
            }
            var __er4: TirEmitRes = tir_emit_map_lit(base.node_nb((sid as u64)), lhstd); rhs = __er4.name;
        } else {
            // O-6：`o = null`（o 为 ?T）须让 RHS 知道目标是 %Opt_X，否则发射成空指针。
            tir_maybe_expect_opt_none(base.node_nb((sid as u64)), tir_st_to_str(est));
            var __er5: TirEmitRes = tir_emit_expr(base.node_nb((sid as u64))); rhs = __er5.name;
        }
        if (base.node_kind((base.node_na((sid as u64)) as u64)) == "ident") {
            var idx: i64 = tir_find_local_idx(base.node_sa((base.node_na((sid as u64)) as u64)));
            if (idx >= 0) {
                // Sym 类型 = 字符串字面量：自动 intern（LHS 存 id，而非字符串本身）。
                // 否则会把 %TStr 字面量塞进 i32/i16 槽 → sym_str 拿到垃圾 id → 输出空串。
                var lhstd: i64 = g_local_tds[idx];
                // AWI：整数字面量必须以目标 i<N> 槽类型全精度发射，否则被降级成 i64 → 高位截断
                // （如 u128 2^128-1 / i128 -1 经 ll_norm_imm 溢出成 2^64-1）。字面量值存于 n.sa 文本，
                // sema 对字面量恒标 i64，故在此按 LHS 槽实际宽度重发射常量。
                if (base.node_kind((base.node_nb((sid as u64)) as u64)) == "int") {
                    var lhst: string = g_local_sts[idx];
                    if (base.awi_bits(lhst) > 64) {
                        var daw: string = tir_tmp();
                        tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str(lhst), dst: tir_op(daw), args: tir_a1(base.node_sa((base.node_nb((sid as u64)) as u64))), is_comment: false, line: g_cur_line, cmt: "" });
                        rhs = daw;
                    }
                }
                if (lhstd >= 0 and sema.tds[lhstd].cat == "sym" and base.node_kind((base.node_nb((sid as u64)) as u64)) == "string") {
                    var tagid: i64 = slice_len(g_mod.strings) as i64;
                    if (base.g_relowering) { arena_use_default(); }
                    append(g_mod.strings, sema.tds[lhstd].name);
                    if (base.g_relowering) { if (base.g_relowering_scratch_func) { arena_use_func(); } else { arena_use_default(); } }
                    var tagslot: string = tir_tmp();
                    tir_emit(TIRInst{ op: TIR_OP_CONST_STR, st: ST_NONE, dst: tir_op(tagslot), args: tir_a1(base.i2s(tagid)), is_comment: false, line: g_cur_line, cmt: "" });
                    var bitsslot: string = tir_tmp();
                    tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str("i64"), dst: tir_op(bitsslot), args: tir_a1(base.i2s(sema.tds[lhstd].alen)), is_comment: false, line: g_cur_line, cmt: "" });
                    var lst: string = g_local_sts[idx];
                    var sidv: string = g_local_slots[idx];
                    if (lst == "i16" or lst == "u16") { sidv = tir_tmp(); }
                    if (lst == "i64" or lst == "u64") {
                        // 64 位：intern 结果（i64）直接写进变量槽（call 的 DST=slot）。
                        tir_emit(TIRInst{ op: TIR_OP_CALL, st: tir_st_from_str("i64"), dst: tir_op(sidv), args: tir_a4("@sym_intern64", tagslot, rhs, bitsslot), is_comment: false, line: g_cur_line, cmt: "" });
                    } else {
                        tir_emit(TIRInst{ op: TIR_OP_CALL, st: tir_st_from_str("i32"), dst: tir_op(sidv), args: tir_a4("@sym_intern", tagslot, rhs, bitsslot), is_comment: false, line: g_cur_line, cmt: "" });
                    }
                    if (lst == "i16" or lst == "u16") {
                        var st16: string = tir_tmp();
                        tir_emit(TIRInst{ op: TIR_OP_TRUNC, st: tir_st_from_str("i16"), dst: tir_op(st16), args: tir_a1(sidv), is_comment: false, line: g_cur_line, cmt: "" });
                        tir_emit(TIRInst{ op: TIR_OP_STORE, st: ST_NONE, dst: tir_op(g_local_slots[idx]), args: tir_a1(st16), is_comment: false, line: g_cur_line, cmt: "" });
                    }
                    return TirEmitRes{ name: sidv, st: est };
                }
                // 目标为切片而右值是定长数组 → 补 array→slice 视图构造（否则长度字段是脏栈）。
                if (idx >= 0 and g_local_sts[idx] == "%TSlice") { rhs = tir_maybe_array_to_slice(rhs, base.node_nb((sid as u64))); }
                tir_emit(TIRInst{ op: TIR_OP_STORE, st: ST_NONE, dst: tir_op(g_local_slots[idx]), args: tir_a1(rhs), is_comment: false, line: g_cur_line, cmt: "" });
                return TirEmitRes{ name: rhs, st: est };
            } else {
                // LHS 是全局变量：发射 store <rhs> @global（S1 全局赋值支持）。
                // 翻译器 ll_store 对 '@' 前缀 dst 按全局注册表发射 `store v, ptr @name`。
                tir_emit(TIRInst{ op: TIR_OP_STORE, st: ST_NONE, dst: tir_op(base.sb_cat2("@", base.node_sa((base.node_na((sid as u64)) as u64)))), args: tir_a1(rhs), is_comment: false, line: g_cur_line, cmt: "" });
                return TirEmitRes{ name: rhs, st: est };
            }
        } else if (base.node_kind((base.node_na((sid as u64)) as u64)) == "member") {
            // P5：packed struct 成员写 → 宿主整型 read-modify-write。
            var pmnode: i64 = base.node_na((sid as u64));
            var pmbase: string = tir_member_base_st(pmnode);
            var mpk: i64 = sema.pk_find_struct(tir_strip_pct(pmbase));
            if (mpk >= 0) {
                var msl: i64 = sema.pk_find_slot(tir_strip_pct(pmbase), base.node_sa((pmnode as u64)));
                if (msl >= 0) {
                    var mstart: i64 = sema.pk_slot_starts[msl];
                    var mlen: i64 = sema.pk_slot_lens[msl];
                    var hostst: string = sema.pk_host_st(sema.pk_struct_under[mpk]);
                    // 对象地址 = 宿主整型（packed 单 host 字段，field_index 恒 0 → GEP[0]）
                    var pfaddr: string = tir_member_addr(pmnode);
                    // load 宿主整型
                    var pld: string = tir_tmp();
                    tir_emit(TIRInst{ op: TIR_OP_LOAD, st: tir_st_from_str(hostst), dst: tir_op(pld), args: tir_a1(tir_os(pfaddr, tir_st_from_str(base.sb_cat3("ptr<", hostst, ">")))), is_comment: false, line: g_cur_line, cmt: "" });
                    // 右值（cast 到 hostst 位宽）
                    var pvr: TirEmitRes = tir_emit_expr(base.node_nb((sid as u64)));
                    var pvname: string = pvr.name;
                    var pvrst: string = tir_st_to_str(pvr.st);
                    var pvbits: i64 = base.ll_bits(pvrst);
                    var hostbits: i64 = base.ll_bits(hostst);
                    if (pvbits > hostbits) {
                        pvname = tir_tmp();
                        tir_emit(TIRInst{ op: TIR_OP_TRUNC, st: tir_st_from_str(hostst), dst: tir_op(pvname), args: tir_a1(pvr.name), is_comment: false, line: g_cur_line, cmt: "" });
                    } else if (pvbits < hostbits) {
                        pvname = tir_tmp();
                        tir_emit(TIRInst{ op: TIR_OP_ZEXT, st: tir_st_from_str(hostst), dst: tir_op(pvname), args: tir_a1(pvr.name), is_comment: false, line: g_cur_line, cmt: "" });
                    }
                    // shift left by start
                    var pshl: string = tir_tmp();
                    tir_emit(TIRInst{ op: TIR_OP_SHL, st: tir_st_from_str(hostst), dst: tir_op(pshl), args: tir_a2(pvname, base.i2s(mstart)), is_comment: false, line: g_cur_line, cmt: "" });
                    // mask = (2^mlen - 1) << mstart（全宽字段用 all-ones）
                    var pmv: i64; if (mlen < 64) { pmv = tir_pow2_i64(mlen) - 1; } else { pmv = -1; }
                    var pmc: string = tir_tmp();
                    tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str(hostst), dst: tir_op(pmc), args: tir_a1(base.i2s(pmv)), is_comment: false, line: g_cur_line, cmt: "" });
                    var psm: string = tir_tmp();
                    tir_emit(TIRInst{ op: TIR_OP_SHL, st: tir_st_from_str(hostst), dst: tir_op(psm), args: tir_a2(pmc, base.i2s(mstart)), is_comment: false, line: g_cur_line, cmt: "" });
                    // field bits = (val << start) & mask
                    var pvand: string = tir_tmp();
                    tir_emit(TIRInst{ op: TIR_OP_AND, st: tir_st_from_str(hostst), dst: tir_op(pvand), args: tir_a2(pshl, psm), is_comment: false, line: g_cur_line, cmt: "" });
                    // ~mask = mask ^ allones
                    var pall: string = tir_tmp();
                    tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str(hostst), dst: tir_op(pall), args: tir_a1("-1"), is_comment: false, line: g_cur_line, cmt: "" });
                    var pnotm: string = tir_tmp();
                    tir_emit(TIRInst{ op: TIR_OP_XOR, st: tir_st_from_str(hostst), dst: tir_op(pnotm), args: tir_a2(psm, pall), is_comment: false, line: g_cur_line, cmt: "" });
                    // new = (old & ~mask) | field
                    var pland: string = tir_tmp();
                    tir_emit(TIRInst{ op: TIR_OP_AND, st: tir_st_from_str(hostst), dst: tir_op(pland), args: tir_a2(pld, pnotm), is_comment: false, line: g_cur_line, cmt: "" });
                    var plor: string = tir_tmp();
                    tir_emit(TIRInst{ op: TIR_OP_OR, st: tir_st_from_str(hostst), dst: tir_op(plor), args: tir_a2(pland, pvand), is_comment: false, line: g_cur_line, cmt: "" });
                    tir_emit(TIRInst{ op: TIR_OP_STORE, st: ST_NONE, dst: tir_op(pfaddr), args: tir_a1(plor), is_comment: false, line: g_cur_line, cmt: "" });
                    return TirEmitRes{ name: plor, st: est };
                }
            }
            var faddr: string = tir_member_addr(base.node_na((sid as u64)));
            // ⭐ G-4（与 tir_emit_struct_lit 同因同解，见那里完整注释）：
            //   `b.r0 = seven;` 的右值是**裸函数符号**，而 fn 类型字段的下游按 **TClosure\*** 消费
            //   ⇒ 落槽前必须先包成 %TClosure 值。捕获型 lambda 的右值已是堆指针（非 '@' 开头），
            //   判据天然只命中裸函数符号。
            //   ⚠ 右值指令已在上方发射（本分支只是补一段闭包构造），故此处不重发右值。
            if (str_len(rhs) >= 1 and rhs[0] == 64) {
                // ⚠ 必须用 tir_member_expr_td（沿 member 链自解析），**不能**用 tir_expr_td /
                //   tir_lhs_td：后者对 member 节点落到 meta_type_of_expr 兜底，拿不到字段真实 TD
                //   （实测 `b.r0 = seven` 判不出 func ⇒ 不包闭包 ⇒ C 后端段错误）。
                var mftd: i64 = tir_member_expr_td(pmnode);
                if (mftd >= 0 and mftd < slice_len(sema.tds) as i64 and sema.tds[mftd].cat == "func") {
                    rhs = tir_make_closure_value(rhs, "");
                }
            }
            if (faddr != "") {
                tir_emit(TIRInst{ op: TIR_OP_STORE, st: ST_NONE, dst: tir_op(faddr), args: tir_a1(rhs), is_comment: false, line: g_cur_line, cmt: "" });
                return TirEmitRes{ name: rhs, st: est };
            } else {
                tir_cmt("assign to member (unsupported base)");
            }
        } else if (base.node_kind((base.node_na((sid as u64)) as u64)) == "index") {
            // map 索引写：tll_map_put 插入/覆盖。
            // ⚠ 不能用 tll_map_val_ptr + store：val_ptr 是「查表返回已有值地址」，
            // 对新键不登记键，store 进的是未注册内存 → 读回恒为 0（map_assign 整例 "00000"）。
            // 与 tir_emit_map_lit(3089) 同构：mhp=load 句柄槽、kp=键指针、vp=addr_of(右值)、call tll_map_put。
            var base_td: i64 = tir_expr_td(base.node_na((base.node_na((sid as u64)) as u64)));
            if (base_td >= 0 and sema.tds[base_td].cat == "map") {
            var mt: TD = sema.tds[base_td];
            var mbslotr: TirEmitRes = tir_emit_expr(base.node_na((base.node_na((sid as u64)) as u64))); var mbs: string = mbslotr.name;
            // ⚠ 嵌套 map 写（如 deep["a"]["x"]=v）：lhs.na 为 index/deref 时 tir_emit_expr 已返回
            // 「容器句柄值」，直接作 tll_map_put 的容器句柄；若再 load 会双重解引用，把值存进
            // *容器 而非容器本身。ident/member 基址返回 slot，须 load 取出句柄。
            var sbkind: string = base.node_kind((base.node_na((base.node_na((sid as u64)) as u64)) as u64));
            var mhp: string;
            if (sbkind == "index" or sbkind == "deref") { mhp = mbs; }
            else {
                mhp = tir_tmp();
                tir_emit(TIRInst{ op: TIR_OP_LOAD, st: tir_st_from_str("ptr<void>"), dst: tir_op(mhp), args: tir_a1(mbs), is_comment: false, line: g_cur_line, cmt: "" });
            }
                var vst: string = tir_st_of_td(mt.val);
                var ksr: TirEmitRes = tir_emit_expr(base.node_nb((base.node_na((sid as u64)) as u64))); var ks: string = ksr.name;
                var kst: string = tir_expr_st(base.node_nb((base.node_na((sid as u64)) as u64)));
                var kc: string = ks;
                if (kst != "i64" and sema.tds[mt.key].cat != "string") { kc = tir_tmp(); tir_emit(TIRInst{ op: TIR_OP_ZEXT, st: tir_st_from_str("i64"), dst: tir_op(kc), args: tir_a1(ks), is_comment: false, line: g_cur_line, cmt: "" }); }
                var kp: string = tir_tmp();
                if (sema.tds[mt.key].cat == "string") {
                    tir_emit(TIRInst{ op: TIR_OP_ADDR_OF, st: tir_st_from_str("%TStr"), dst: tir_op(kp), args: tir_a1(ks), is_comment: false, line: g_cur_line, cmt: "" });
                } else {
                    tir_emit(TIRInst{ op: TIR_OP_ADDR_OF, st: tir_st_from_str("ptr<i64>"), dst: tir_op(kp), args: tir_a1(kc), is_comment: false, line: g_cur_line, cmt: "" });
                }
                var vp: string = tir_tmp();
                tir_emit(TIRInst{ op: TIR_OP_ADDR_OF, st: tir_st_from_str(vst), dst: tir_op(vp), args: tir_a1(rhs), is_comment: false, line: g_cur_line, cmt: "" });
                tir_emit(TIRInst{ op: TIR_OP_CALL, st: tir_st_from_str("void"), dst: tir_op(""), args: tir_a4("@tll_map_put", mhp, kp, vp), is_comment: false, line: g_cur_line, cmt: "" });
                return TirEmitRes{ name: rhs, st: est };
            }
            var eptr: string = tir_emit_index_addr(base.node_na((sid as u64)));
            tir_emit(TIRInst{ op: TIR_OP_STORE, st: ST_NONE, dst: tir_op(eptr), args: tir_a1(rhs), is_comment: false, line: g_cur_line, cmt: "" });
            return TirEmitRes{ name: rhs, st: est };
        } else if (base.node_kind((base.node_na((sid as u64)) as u64)) == "deref") {
            var eptrr: TirEmitRes = tir_addr_of(base.node_na((sid as u64))); var eptr: string = eptrr.name;   // *r 作为左值：地址即指针值本身
            tir_emit(TIRInst{ op: TIR_OP_STORE, st: ST_NONE, dst: tir_op(eptr), args: tir_a1(rhs), is_comment: false, line: g_cur_line, cmt: "" });
            return TirEmitRes{ name: rhs, st: est };
        } else {
            tir_cmt(base.sb_cat3("unsupported assign lhs: ", base.node_kind((base.node_na((sid as u64)) as u64)), ""));
        }
        var z: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str("i64"), dst: tir_op(z), args: tir_a1("0"), is_comment: false, line: g_cur_line, cmt: "" });
        return TirEmitRes{ name: z, st: est };
    }
    // 复合赋值：仅支持 ident 左值标量
    var baseop: string = str_slice(op, 0, str_len(op) - 1);
    if (base.node_kind((base.node_na((sid as u64)) as u64)) == "ident") {
        var idx: i64 = tir_find_local_idx(base.node_sa((base.node_na((sid as u64)) as u64)));
        if (idx >= 0) {
            var lst: string = g_local_sts[idx];
            var cur: string = tir_tmp();
            tir_emit(TIRInst{ op: TIR_OP_LOAD, st: tir_st_from_str(lst), dst: tir_op(cur), args: tir_a1(g_local_slots[idx]), is_comment: false, line: g_cur_line, cmt: "" });
            var rsr: TirEmitRes = tir_emit_expr(base.node_nb((sid as u64))); var rs: string = rsr.name;
            var dst: string = tir_tmp();
            tir_emit(tir_emit_binop(opmap.tir_op_from_str(opmap.tir_binop(baseop, lst)), lst, dst, cur, rs));
            tir_emit(TIRInst{ op: TIR_OP_STORE, st: ST_NONE, dst: tir_op(g_local_slots[idx]), args: tir_a1(dst), is_comment: false, line: g_cur_line, cmt: "" });
            return TirEmitRes{ name: dst, st: est };
        }
    }
    tir_cmt(base.sb_cat3("unsupported compound assign: ", op, ""));
    var z: string = tir_tmp();
    tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str("i64"), dst: tir_op(z), args: tir_a1("0"), is_comment: false, line: g_cur_line, cmt: "" });
    return TirEmitRes{ name: z, st: est };
}

// ══════════════════════════════════════════════════════════════════
// 表达式发射：返回承载值的 slot（memory-first）
// ══════════════════════════════════════════════════════════════════

pub fn tir_emit_expr(e: i64) TirEmitRes {
    if (e < 0) { dbg_neg("EMIT_EXPR e<0"); return TirEmitRes{ name: tir_tmp(), st: ST_I64 }; }
    g_cur_line = base.node_span_id(e).line;
    var kd: string = base.node_kind((e as u64));
    // P5：() 空元组字面量 = unit 值，无语义载荷。发射为占位常量（与 C 后端 (void)0 同效），
    //     返回占位 slot 供下游（如尾随表达式）消费；unit-typed 变量声明在 var_decl 分支已降级丢弃。
    if (kd == "unit_lit") {
        var z: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str("i64"), dst: tir_op(z), args: tir_a1("0"), is_comment: false, line: g_cur_line, cmt: "" });
        return TirEmitRes{ name: z, st: tir_st_from_str("i64") };
    }
    // est 优先取调用方注入的预期类型（g_expect_st）：解决 match 等无法从 sema 反推结果类型、
    // 退回 i64 导致 __mres 槽宽度不足的问题。读取后即清零，子表达式改用自身推断类型。
    var est: i64 = ST_NONE;
    if (g_expect_st != ST_NONE) { est = g_expect_st; g_expect_st = ST_NONE; }
    if (est == ST_NONE) { est = tir_st_from_str(tir_expr_st(e)); }

    // O-7：`T → ?T` 隐式提升。sema 已在类型检查处放行并打标记（sema.opt_lift_has），
    // 这里补上真正的包装：先按原语义发射出元素值，再 STRUCT_NEW 成 %Opt_E（__tag=1 + payload）。
    // 用 STRUCT_NEW 而非新指令，双后端（C 的 `{0}` 缓冲 + 逐字段 GEP、LLVM 的 zeroinitializer +
    // 逐字段 store）都已支持，零后端改动。
    // ⚠ 递归会再次命中同一个标记 ⇒ 用 busy 集合作一次性抑制（发射元素值时不再提升）。
    if (sema.opt_lift_has(e) and tir_optlift_busy_has(e) == false) {
        append(g_optlift_busy, e);
        var ev: TirEmitRes = tir_emit_expr(e);
        tir_optlift_busy_del(e);
        var opt_name: string = tir_st_to_str(est);
        if (str_len(opt_name) <= 5 or str_slice(opt_name, 0, 5) != "%Opt_") {
            opt_name = tir_ensure_opt_tagged(tir_st_to_str(ev.st));
        }
        var tagc: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_CONST, st: ST_I64, dst: tir_op(tagc), args: tir_a1("1"), is_comment: false, line: g_cur_line, cmt: "" });
        var dn2: string = tir_tmp();
        var __oa: []string = [];
        append(__oa, tagc);
        append(__oa, ev.name);
        tir_emit(TIRInst{ op: TIR_OP_STRUCT_NEW, st: tir_st_from_str(opt_name), dst: tir_op(dn2), args: __oa, is_comment: false, line: g_cur_line, cmt: "" });
        return TirEmitRes{ name: dn2, st: tir_st_from_str(opt_name) };
    }

    if (kd == "assign" or kd == "assignment") { return tir_emit_assign(e, est); }
    if (kd == "match") { return tir_emit_match(e, false, est); }
    // P1 Stage 1b：多语句值块 `{ s1; ...; sn; e; }` —— 值即**尾随表达式**的槽。
    // 块内语句在新作用域发射（tir_blk_push/pop 维护 g_blk_depth，使块内局部随块结束退出）；
    // 尾随表达式的临时槽位于函数栈上，块退出后仍可读（tir 槽不随块回收）。
    // ⚠ 中间的 expr 语句（如 `f();`）必须照常发射，只有**末条**才走取值路径 ——
    //    否则语句被整条丢弃（静默错编，与"不崩溃的错编最难查"同类）。
    if (kd == "block_expr") {
        tir_blk_push();
        var be_r: TirEmitRes = TirEmitRes{ name: tir_tmp(), st: est };
        var be_c: i64 = base.node_la((e as u64));
        while (be_c >= 0) {
            var be_k: Child = base.kids[be_c];
            var be_s: i64 = be_k.val;
            if (be_k.next < 0 and base.node_kind((be_s as u64)) == "expr") {
                if (est != ST_NONE) { g_expect_st = est; }   // 传预期类型，保结果槽宽度
                be_r = tir_emit_expr(base.node_na((be_s as u64)));
            } else {
                tir_emit_stmt(be_s);
            }
            be_c = be_k.next;
        }
        tir_blk_pop();
        return be_r;
    }
    if (kd == "int") {
        var st: string = tir_expr_st(e);
        var d: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str(st), dst: tir_op(d), args: tir_a1(base.node_sa((e as u64))), is_comment: false, line: g_cur_line, cmt: "" });
        return TirEmitRes{ name: d, st: tir_st_from_str(st) };
    }
    if (kd == "float") {
        var st: string = tir_expr_st(e);
        var d: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str(st), dst: tir_op(d), args: tir_a1(base.node_sa((e as u64))), is_comment: false, line: g_cur_line, cmt: "" });
        return TirEmitRes{ name: d, st: tir_st_from_str(st) };
    }
    if (kd == "string") {
        var id: i64 = slice_len(g_mod.strings) as i64;
        if (base.g_relowering) { arena_use_default(); }
        append(g_mod.strings, base.node_sa((e as u64)));
        if (base.g_relowering) { if (base.g_relowering_scratch_func) { arena_use_func(); } else { arena_use_default(); } }
        var d: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_CONST_STR, st: ST_NONE, dst: tir_op(d), args: tir_a1(base.i2s(id)), is_comment: false, line: g_cur_line, cmt: "" });
        return TirEmitRes{ name: d, st: est };
    }
    // 位串字面量 `<<seg:W, ...>>`（§15）：在 TIR 轨构造 TBitStr 并逐段写位，
    // 与 C 后端 codegen_c.emit 同构（t_bitstr_new + t_bitstr_append_val / tll_bitstr_concat）。
    // 复用 %TStr 的 ptr-base.out(sret) 策略：局部槽 = alloca %TBitStr，tll_ 函数以 ptr 传参。
    if (kd == "bitstr") {
        var bs: string = tir_new_named_slot(-1, "%TBitStr", "bs");
        // 固定段总位宽（容量提示；变长段运行时由 append/concat 累积 bit_len）
        var fixed_bits: i64 = 0;
        var bc0: i64 = base.node_la((e as u64));
        // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
        var bc0_ks: []i64 = base.kids_chain(bc0);
        var bc0_ki: i64 = 0;
        while (bc0_ki < slice_len(bc0_ks) as i64) {
            var bc0_kv: i64 = bc0_ks[bc0_ki];
            if (base.node_ba((bc0_kv as u64)) == false) {
                fixed_bits = fixed_bits + sema.parse_int_len(base.node_sa((base.node_nb((bc0_kv as u64)) as u64)), base.node_ia((base.node_nb((bc0_kv as u64)) as u64)));
            }
            bc0_ki = bc0_ki + 1;
        }
        tir_emit(TIRInst{ op: TIR_OP_CALL, st: tir_st_from_str("void"), dst: tir_op(""), args: tir_a3("@tll_bitstr_new", bs, base.i2s(fixed_bits)), is_comment: false, line: g_cur_line, cmt: "" });
        var bci: i64 = base.node_la((e as u64));
        // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
        var bci_ks: []i64 = base.kids_chain(bci);
        var bci_ki: i64 = 0;
        while (bci_ki < slice_len(bci_ks) as i64) {
            var bci_kv: i64 = bci_ks[bci_ki];
            if (base.node_ba((bci_kv as u64))) {
                // 变长尾段：递归发射段表达式（bitstr 值），再 tll_bitstr_concat(bs, bs, segv)
                var segr: TirEmitRes = tir_emit_expr(base.node_na((bci_kv as u64)));
                tir_emit(TIRInst{ op: TIR_OP_CALL, st: tir_st_from_str("void"), dst: tir_op(""), args: tir_a4("@tll_bitstr_concat", bs, bs, segr.name), is_comment: false, line: g_cur_line, cmt: "" });
            } else {
                var valr: TirEmitRes = tir_emit_expr(base.node_na((bci_kv as u64)));
                var bits: i64 = sema.parse_int_len(base.node_sa((base.node_nb((bci_kv as u64)) as u64)), base.node_ia((base.node_nb((bci_kv as u64)) as u64)));
                var little: i64 = 0;
                if (base.node_sa((bci_kv as u64)) == "little") { little = 1; }
                tir_emit(TIRInst{ op: TIR_OP_CALL, st: tir_st_from_str("void"), dst: tir_op(""), args: tir_a5("@tll_bitstr_append_val", bs, valr.name, base.i2s(bits), base.i2s(little)), is_comment: false, line: g_cur_line, cmt: "" });
            }
            bci_ki = bci_ki + 1;
        }
        return TirEmitRes{ name: bs, st: tir_st_from_str("%TBitStr") };
    }
    if (kd == "bool") {
        var d: string = tir_tmp();
        if (base.node_ba((e as u64))) { tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str("i8"), dst: tir_op(d), args: tir_a1("1"), is_comment: false, line: g_cur_line, cmt: "" }); }
        else { tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str("i8"), dst: tir_op(d), args: tir_a1("0"), is_comment: false, line: g_cur_line, cmt: "" }); }
        return TirEmitRes{ name: d, st: ST_I8 };
    }
    if (kd == "null" or kd == "opt_none") {
        // O-6：?T 已改为按值布局 %Opt_X，none 即「全零」（tag == 0）。
        // 若上下文期望 ?T，必须发射**零初始化的聚合值**（零参 STRUCT_NEW：C 端 `= {0}`、
        // LLVM 端 zeroinitializer），而不能发射空指针常量：
        //   ① C 后端会把聚合槽的缓冲指针改指成 0，后续 some 写入即段错误；
        //   ② LLVM 侧 `store ptr null` 与 %Opt_X 槽类型冲突。
        var nst: string = tir_st_to_str(est);
        if (str_len(nst) > 5 and str_slice(nst, 0, 5) == "%Opt_") {
            var dn: string = tir_tmp();
            tir_emit(TIRInst{ op: TIR_OP_STRUCT_NEW, st: est, dst: tir_op(dn), args: tir_a0(), is_comment: false, line: g_cur_line, cmt: "" });
            return TirEmitRes{ name: dn, st: est };
        }
        var d: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_CONST_PTR_NULL, st: tir_st_from_str("ptr<void>"), dst: tir_op(d), args: tir_a0(), is_comment: false, line: g_cur_line, cmt: "" });
        return TirEmitRes{ name: d, st: ST_PTR_VOID };
    }
    if (kd == "ident") {
        // ⚠ 同 tir_addr_of：前端可能改名局部（out→l），须按声明节点解析槽（对齐旧轨 emit_lle ident）。
        var lname: string = base.node_sa((e as u64));
        var decl: i64 = base.node_resolve(e);
        if (decl >= 0) { lname = base.node_sa((decl as u64)); }
        var idx: i64 = tir_find_local_idx(lname);
        if (idx >= 0) { return TirEmitRes{ name: g_local_slots[idx], st: tir_st_from_str(tir_expr_st(e)) }; }
        // 全局符号：Stage 1 直接引用 @name（聚合按地址、标量按值，调用方处理）
        return TirEmitRes{ name: base.sb_cat2("@", lname), st: est };
    }
    if (kd == "paren" or kd == "comptime") { return tir_emit_expr(base.node_na((e as u64))); }
    if (kd == "binary") { return tir_emit_binary(e); }
    if (kd == "unary") { return tir_emit_unary(e); }
    if (kd == "call") { return tir_emit_call(e); }
    if (kd == "mbuiltin") { return tir_emit_call(e); }   // @sema.name(args) 在表达式位统一为 mbuiltin 节点；降级为普通调用发射
    if (kd == "member") { return tir_member_read(e); }
    if (kd == "cast") { return tir_emit_cast(e, est); }
    if (kd == "struct_lit" or kd == "struct") { return tir_emit_struct_lit(e); }
    if (kd == "atom") {
        if (base.node_ia((e as u64)) <= 0) {   // S4 §0.14.7 SoA：侧表读写（原 `n.ia`）
            base.node_set_ia((e as u64), sema.atom_intern(base.node_sa((e as u64))));
        }
        var d: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str("u64"), dst: tir_op(d), args: tir_a1(base.i2s(base.node_ia((e as u64)))), is_comment: false, line: g_cur_line, cmt: "" });
        return TirEmitRes{ name: d, st: ST_U64 };
    }
    if (kd == "fidconst") {
        var d: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str("i64"), dst: tir_op(d), args: tir_a1(base.i2s(base.node_ia((e as u64)))), is_comment: false, line: g_cur_line, cmt: "" });
        return TirEmitRes{ name: d, st: ST_I64 };
    }
    if (kd == "array_lit") { return tir_emit_array_lit(e, -1); }
    if (kd == "map_lit") { return tir_emit_map_lit(e, -1); }
    if (kd == "index") { return tir_emit_index_read(e); }
    if (kd == "closure_make") { return tir_emit_closure_make(e); }
    if (kd == "amp") { return tir_emit_amp(e, est); }
    if (kd == "deref") { return tir_emit_deref(e); }
    // ── 序列化 / 反序列化操作符（M51/M52）：`f < v` / `f > Type` ──
    // 新轨此前无此分支，< 被当普通小于比较发射 → fid 序列化整段失效。
    if (kd == "serialize") { return tir_emit_serialize(e); }
    if (kd == "deserialize") { return tir_emit_deserialize(e); }
    if (kd == "typeinfo") {
        // type_info(T)：编译期反射，降级为 TIR_OP_TYPEINFO（由 tir_to_ll 发射 @__ti_<T> 全局常量引用）。
        var d: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_TYPEINFO, st: ST_PTR_VOID, dst: tir_op(d), args: tir_a1(base.node_sa((e as u64))), is_comment: false, line: g_cur_line, cmt: "" });
        return TirEmitRes{ name: d, st: ST_PTR_VOID };
    }
    // 兜底：不支持的表达式 → 零 slot，绝不崩溃
    tir_cmt(base.sb_cat3("unsupported expr: ", kd, ""));
    var z: string = tir_tmp();
    tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str("i64"), dst: tir_op(z), args: tir_a1("0"), is_comment: false, line: g_cur_line, cmt: "" });
    return TirEmitRes{ name: z, st: ST_I64 };
}

// ── 序列化 / 反序列化操作符发射（新轨）────────────────────────────
// 选择器与旧轨 codegen_c.ser_sel 一致：按右值 TD / 类型 TD 选 str/atom/bool/f/i。
// 返回整数选择器，避免 string 局部与 TirEmitRes 局部在旧轨 emit-ll 自举时槽位冲突。
// 0=str / 1=atom / 2=bool / 3=f / 4=i
pub fn tir_ser_sel(td: i64) i64 {
    if (td < 0 or td >= slice_len(sema.tds) as i64) { return 4; }
    var t: TD = sema.tds[td];
    if (t.cat == "string") { return 0; }
    var sn: string = sema.td_sname(td);
    if (sn == "atom") { return 1; }
    if (sn == "bool") { return 2; }
    if (sn == "f16" or sn == "f32" or sn == "f64") { return 3; }
    return 4;
}

// 序列化右值的类型描述：双轨对齐旧轨 codegen_ll.ll_etd（一律走 codegen_c.expr_type_desc）。
// ⚠ 但 expr_type_desc 的 ident 分支依赖 codegen_c 的 fs/tm 符号表（由旧轨 emit 填充），
//   新轨（tir）不填充那些表 → 变量会回落成 unknown → 误判为 int → 串口宽度错乱
//   （例：sema.row(f,"n",7) 把字符串变量 k 当 i64 序列化，fid_read_demo 字节流错位→长度前缀爆炸→malloc failed）。
// 故：字面量（int/float/bool/string/atom）用 expr_type_desc 拿默认位宽（整型→i64，规避 sema 把裸字面量
//   标成 i8 的缓存污染）；变量 / 成员 / 索引 / 调用用 tir_expr_td（走新轨 g_local_tds / builtin_ret_td）。
// ── S5-删除：原 codegen_c.expr_type_desc / codegen_c.fid_code_of 迁至此处 ──
// 新 TIR 后端（tir.tc）的序列化路径依赖这二者，不能随 codegen_c.tc 一并删除。
pub fn tir_lit_td(e: i64) i64 {
    var k: string = base.node_kind((e as u64));
    if (k == "string") { return sema.td_mk("string"); }
    if (k == "int") { return sema.td_named_mk("scalar", "i64"); }
    if (k == "float") { return sema.td_named_mk("scalar", "f64"); }
    if (k == "bool") { return sema.td_named_mk("scalar", "bool"); }
    if (k == "atom") { return sema.td_named_mk("scalar", "atom"); }
    return sema.td_mk("unknown");
}

pub fn tir_fid_code_of(sel: string, v: string) i64 {
    if (sel == "mode") {
        if (v == "read") { return 0; }
        if (v == "write") { return 1; }
        if (v == "append") { return 2; }
        if (v == "read_binary") { return 3; }
        if (v == "write_binary") { return 4; }
        return 5;
    }
    if (sel == "kind") {
        if (v == "text") { return 0; }
        return 1;
    }
    if (v == "text") { return 0; }
    if (v == "json") { return 1; }
    if (v == "rawbin") { return 2; }
    return 3;
}

pub fn tir_ser_val_td(e: i64) i64 {
    if (e < 0) { return -1; }
    var k: string = base.node_kind((e as u64));
    if (k == "int" or k == "float" or k == "bool" or k == "string" or k == "atom") {
        return tir_lit_td(e);
    }
    return tir_expr_td(e);
}

// 仅 float 分支调用：f64→0(无需 fpext)，f32/f16→1(需 fpext 到 f64)。
// 分离成独立函数，内部 string 比较不与 TirEmitRes 局部共存，避开旧轨槽位冲突。
pub fn tir_td_flt_needs_fpext(td: i64) i64 {
    if (td < 0 or td >= slice_len(sema.tds) as i64) { return 1; }
    var sn: string = sema.td_sname(td);
    if (sn == "f64") { return 0; }
    return 1;
}

// 仅 int 分支调用：0=无需扩展, 1=符号扩展(SEXT), 2=零扩展(ZEXT)。
pub fn tir_td_int_needs_ext(td: i64) i64 {
    var sn: string = sema.td_sname(td);
    if (sn == "i64" or sn == "u64") { return 0; }
    if (base.ll_signed(sn)) { return 1; }
    return 2;
}

pub fn tir_const_i32(v: i64) string {
    var d: string = tir_tmp();
    tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str("i32"), dst: tir_op(d), args: tir_a1(base.i2s(v)), is_comment: false, line: g_cur_line, cmt: "" });
    return d;
}

pub fn tir_const_i64(v: i64) string {
    var d: string = tir_tmp();
    tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str("i64"), dst: tir_op(d), args: tir_a1(base.i2s(v)), is_comment: false, line: g_cur_line, cmt: "" });
    return d;
}

// 十进制字符串 → i64（@splat 的 lane 数字面量解析用；tir.tc 不导入 tir_to_ll，故本地实现）。
pub fn tir_atoi(s: string) i64 {
    var n: i64 = str_len(s);
    var i: i64 = 0;
    var neg: bool = false;
    if (i < n and str_at(s, i) == 45) { neg = true; i = i + 1; }
    var v: i64 = 0;
    while (i < n) {
        var c: i64 = str_at(s, i);
        if (c >= 48 and c <= 57) { v = v * 10 + (c - 48); }
        i = i + 1;
    }
    if (neg) { v = -v; }
    return v;
}

// `f < v`：按 v 的类型选 tll_ser_*，返回目标 fid（i64）。
// ⚠ 形参是**节点索引 sid** 而非 Node 值：Node 结构体值传参时末尾字段 `id` 不可靠
//   （批次 9 致命坑：按 n.id 查侧表会读到错误节点 ⇒ 子节点静默丢失）。本函数要读 nb 侧表，
//   必须收索引 —— 唯一调用点 `tir_emit_expr` 里 `e` 现成可用（§0.14.7 第十五批）。
pub fn tir_emit_serialize(sid: i64) TirEmitRes {
    var fslot: string = tir_emit_expr(base.node_na((sid as u64))).name;   // sema.fid(i64)
    var vres: TirEmitRes = tir_emit_expr(base.node_nb((sid as u64)));
    var vslot: string = vres.name;
    // ⚠ 值类型：字面量走 codegen_c.expr_type_desc（拿默认位宽 i64，规避 sema 把裸整数字面量
    //   标成 i8 的缓存污染 → ser_int 误用 bits=8 → rawbin 少写字节）；变量/成员/索引/调用走
    //   tir_expr_td（新轨 g_local_tds / builtin_ret_td，expr_type_desc 的 fs/tm 分支在新轨未填充）。
    var vtd: i64 = tir_ser_val_td(base.node_nb((sid as u64)));
    var sel: i64 = tir_ser_sel(vtd);
    var d: string = tir_tmp();
    if (sel == 0) {
        tir_emit(tir_e_call("i64", d, "@tll_ser_str", tir_cargs2(fslot, vslot)));
    } else if (sel == 1) {
        tir_emit(tir_e_call("i64", d, "@tll_ser_atom", tir_cargs2(fslot, vslot)));
    } else if (sel == 2) {
        tir_emit(tir_e_call("i64", d, "@tll_ser_bool", tir_cargs2(fslot, vslot)));
    } else if (sel == 3) {
        var fv: string = vslot;
        if (tir_td_flt_needs_fpext(vtd) == 1) {
            fv = tir_tmp();
            tir_emit(TIRInst{ op: TIR_OP_FPEXT, st: tir_st_from_str("f64"), dst: tir_op(fv), args: tir_a1(vslot), is_comment: false, line: g_cur_line, cmt: "" });
        }
        var bits: string = tir_const_i32(base.ll_bits(sema.td_sname(vtd)));
        tir_emit(tir_e_call("i64", d, "@tll_ser_f64", tir_cargs3(fslot, fv, bits)));
    } else {
        var iv: string = vslot;
        var extop: i64 = tir_td_int_needs_ext(vtd);   // 0=none, 1=sext, 2=zext
        if (extop != 0) {
            // 窄整型按签名零扩展/符号扩展到 i64（ser 运行时按 sgn 解释）
            var cop: i64 = TIR_OP_SEXT;
            if (extop == 2) { cop = TIR_OP_ZEXT; }
            iv = tir_tmp();
            tir_emit(TIRInst{ op: cop, st: tir_st_from_str("i64"), dst: tir_op(iv), args: tir_a1(vslot), is_comment: false, line: g_cur_line, cmt: "" });
        }
        var bits: string = tir_const_i32(base.ll_bits(sema.td_sname(vtd)));
        var sgnv: i64 = 0;
        if (base.ll_signed(sema.td_sname(vtd))) { sgnv = 1; }
        var sgn: string = tir_const_i32(sgnv);
        var cargs4: []string = [];
        append(cargs4, fslot); append(cargs4, iv); append(cargs4, bits); append(cargs4, sgn);
        tir_emit(tir_e_call("i64", d, "@tll_ser_int", cargs4));
    }
    return TirEmitRes{ name: d, st: ST_I64 };
}

// `f > Type`：按 Type 选 tll_deser_*，返回裸 Type 值（窄整型/浮点按需收窄）。
// ⚠ 同 tir_emit_serialize：形参收**节点索引 sid**（nb 侧表读取所需；§0.14.7 第十五批），
//   唯一调用点 `tir_emit_expr` 里 `e` 现成可用。
pub fn tir_emit_deserialize(sid: i64) TirEmitRes {
    var fslot: string = tir_emit_expr(base.node_na((sid as u64))).name;   // sema.fid(i64)
    var ldtd: i64 = sema.deser_type_of(base.node_nb((sid as u64)));
    var sel: i64 = tir_ser_sel(ldtd);
    var sn: string = sema.td_sname(ldtd);
    if (sel == 0) {
        // tll_deser_str 为 void + 显式 sret（out 末位 ptr）；tir 层把 %TStr 槽作为第二实参传入，
        // 翻译器特判 tll_deser_str 负责 ll_ensure_slot + declare。
        var d: string = tir_tmp();
        tir_emit(tir_e_call("void", d, "@tll_deser_str", tir_cargs2(fslot, d)));
        return TirEmitRes{ name: d, st: tir_st_from_str("%TStr") };
    }
    if (sel == 1) {
        var d: string = tir_tmp();
        tir_emit(tir_e_call("i64", d, "@tll_deser_atom", tir_cargs1(fslot)));
        return TirEmitRes{ name: d, st: ST_U64 };
    }
    if (sel == 2) {
        var d: string = tir_tmp();
        tir_emit(tir_e_call("i8", d, "@tll_deser_bool", tir_cargs1(fslot)));
        return TirEmitRes{ name: d, st: ST_I8 };
    }
    if (sel == 3) {
        var d: string = tir_tmp();
        tir_emit(tir_e_call("f64", d, "@tll_deser_f64", tir_cargs2(fslot, tir_const_i32(base.ll_bits(sn)))));
        if (sn == "f32" or sn == "f16") {
            var d2: string = tir_tmp();
            tir_emit(TIRInst{ op: TIR_OP_FPTRUNC, st: tir_st_from_str(sn), dst: tir_op(d2), args: tir_a1(d), is_comment: false, line: g_cur_line, cmt: "" });
            return TirEmitRes{ name: d2, st: tir_st_from_str(sn) };
        }
        return TirEmitRes{ name: d, st: ST_F64 };
    }
    // int：tll_deser_int 返回 i64，按目标宽度截断（与旧轨运行期桥接最宽标量返回对齐）
    var iv: string = tir_tmp();
    var dsgnv: i64 = 0;
    if (base.ll_signed(sn)) { dsgnv = 1; }
    tir_emit(tir_e_call("i64", iv, "@tll_deser_int", tir_cargs3(fslot, tir_const_i32(base.ll_bits(sn)), tir_const_i32(dsgnv))));
    // ⚠ 无符号窄量（u8/u16/u32）：deser 返回 i64，TRUNC 到窄位宽后位模式正确，
    // 但赋给加宽成 i64 的槽位时需 zext（而非 sext），否则 200 被误当作有符号 -56。
    // 故无符号分支在 TRUNC 后补一枚 ZEXT i⟨窄⟩→i64，直接返回 i64，让赋值 i64→i64 槽免误转。
    if (sn == "i8" or sn == "u8") {
        var d: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_TRUNC, st: tir_st_from_str("i8"), dst: tir_op(d), args: tir_a1(iv), is_comment: false, line: g_cur_line, cmt: "" });
        if (base.ll_signed(sn) == false) {
            var d2: string = tir_tmp();
            tir_emit(TIRInst{ op: TIR_OP_ZEXT, st: tir_st_from_str("i64"), dst: tir_op(d2), args: tir_a1(d), is_comment: false, line: g_cur_line, cmt: "" });
            return TirEmitRes{ name: d2, st: ST_I64 };
        }
        return TirEmitRes{ name: d, st: ST_I8 };
    }
    if (sn == "i16" or sn == "u16") {
        var d: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_TRUNC, st: tir_st_from_str("i16"), dst: tir_op(d), args: tir_a1(iv), is_comment: false, line: g_cur_line, cmt: "" });
        if (base.ll_signed(sn) == false) {
            var d2: string = tir_tmp();
            tir_emit(TIRInst{ op: TIR_OP_ZEXT, st: tir_st_from_str("i64"), dst: tir_op(d2), args: tir_a1(d), is_comment: false, line: g_cur_line, cmt: "" });
            return TirEmitRes{ name: d2, st: ST_I64 };
        }
        return TirEmitRes{ name: d, st: tir_st_from_str("i16") };
    }
    if (sn == "i32" or sn == "u32") {
        var d: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_TRUNC, st: tir_st_from_str("i32"), dst: tir_op(d), args: tir_a1(iv), is_comment: false, line: g_cur_line, cmt: "" });
        if (base.ll_signed(sn) == false) {
            var d2: string = tir_tmp();
            tir_emit(TIRInst{ op: TIR_OP_ZEXT, st: tir_st_from_str("i64"), dst: tir_op(d2), args: tir_a1(d), is_comment: false, line: g_cur_line, cmt: "" });
            return TirEmitRes{ name: d2, st: ST_I64 };
        }
        return TirEmitRes{ name: d, st: ST_I32 };
    }
    return TirEmitRes{ name: iv, st: ST_I64 };
}

// 取址 `&x`：x 为左值（局部/全局/字段/下标/解引用）。
// 镜像 codegen_ll.tc ll_addr：返回 x 的地址（ptr<ST>）；x 已是 ptr（&p / *p）则直接取其值。
pub fn tir_addr_of(e: i64) TirEmitRes {
    var okd: string = base.node_kind((e as u64));
    if (okd == "amp" or okd == "deref") {
        return tir_emit_expr(e);   // 已是指针值
    }
    if (okd == "paren") {
        return tir_addr_of(base.node_na((e as u64)));   // 递归到内层
    }
    if (okd == "ident") {
        // ⚠ 前端可能对局部变量改名（如 pop 内 `out`→`l`），但槽仍按声明名注册（$out）。
        // 若直接 t_find_local_idx(o.sa) 字符串匹配会失败、退回全局 → append 改错副本/段错误。
        // 须用 base.node_resolve(e) 取该节点对应的声明节点，按声明名解析槽（对齐旧轨 emit_lle ident）。
        var lname: string = base.node_sa((e as u64));
        var decl: i64 = base.node_resolve(e);
        if (decl >= 0) { lname = base.node_sa((decl as u64)); }
        var idx: i64 = tir_find_local_idx(lname);
        if (idx >= 0) {
            var st: string = tir_expr_st(e);
            var d: string = tir_tmp();
            // P5/P8：packed struct 的宿主整型可能 < 8 字节（%Perm = type { i8 }，1 字节），
            // ADDR_OF 的目标临时槽若按值类型(%Perm)分配，会被 8 字节指针写穿 → 栈破坏 →
            // 运行时段错误。故 packed 结构把 ADDR_OF 的槽类型改成指针宽度 ptr<%Perm>（8 字节）。
            // 与 tir_member_addr 的 P5 修复同源同宽度；非 packed 保持原样。
            // ⚠ 安全性：src/ 与 lib/ 内 packed struct 真实声明数为 0，故此改动对编译器自身
            // 自举产物零语义影响（pk_find_struct 对编译器自身所有类型恒返回 -1）。
            var ao_st: string = st;
            if (sema.pk_find_struct(tir_strip_pct(st)) >= 0) { ao_st = base.sb_cat3("ptr<", st, ">"); }
            tir_emit(TIRInst{ op: TIR_OP_ADDR_OF, st: tir_st_from_str(ao_st), dst: tir_op(d), args: tir_a1(tir_os(g_local_slots[idx], tir_st_from_str(st))), is_comment: false, line: g_cur_line, cmt: "" });
            return TirEmitRes{ name: d, st: tir_st_from_str(tir_expr_st(e)) };
        }
        return TirEmitRes{ name: base.sb_cat2("@", lname), st: tir_st_from_str(tir_expr_st(e)) };   // 全局符号即地址
    }
    if (okd == "index") {
        return TirEmitRes{ name: tir_emit_index_addr(e), st: tir_st_from_str(tir_expr_st(e)) };
    }
    if (okd == "member") {
        return TirEmitRes{ name: tir_member_addr(e), st: tir_st_from_str(tir_expr_st(e)) };
    }
    tir_cmt(base.sb_cat3("unsupported expr: amp (", okd, ")"));
    var z: string = tir_tmp();
    tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str("i64"), dst: tir_op(z), args: tir_a1("0"), is_comment: false, line: g_cur_line, cmt: "" });
    return TirEmitRes{ name: z, st: tir_st_from_str(tir_expr_st(e)) };
}

// S4 §0.14.7 SoA（第十七批·na）：原签名 `tir_emit_amp(n: Node, est: i64)`。
//   唯一调用方 `tir_emit_expr(e: i64)` 传入的 `n` 与 `base.nodes[e]` **恒等**（第三类）
//   ⇒ 删冗余 Node 值形参、改收索引 e。
pub fn tir_emit_amp(e: i64, est: i64) TirEmitRes {
    var ar: TirEmitRes = tir_addr_of(base.node_na((e as u64)));
    return TirEmitRes{ name: ar.name, st: est };
}

// 解引用 `*r` 作为右值：从指针 slot load 出元素值。
// 镜像 codegen_ll.tc ll_addr 的 *r 语义（r 本身即 ptr 值），但 rvalue 需 load。
// 元素 ST 直接取 deref 节点自身类型（meta_type_of_expr 对 *r 解析为被指类型）。
pub fn tir_emit_deref(e: i64) TirEmitRes {
    var addrr: TirEmitRes = tir_emit_expr(base.node_na((e as u64))); var addr: string = addrr.name;   // ptr<ST> 承载 slot
    // 解引用值类型 = 指针元素类型：从 r 的 sema TD（ptr<ST>）剥离 ptr<>，避免 ll_get_st 跨模块调用
    // 与 tir_expr_st 对 *r 的 meta_type_of_expr 越界退化。
    var rst: string = tir_st_of_td(tir_expr_td(base.node_na((e as u64))));
    var st: string = "i64";
    if (str_len(rst) >= 5 and str_slice(rst, 0, 4) == "ptr<") {
        st = str_slice(rst, 4, str_len(rst) - 1);
    }
    var d: string = tir_tmp();
    tir_emit(tir_emit_load(st, d, addr));
    return TirEmitRes{ name: d, st: tir_st_from_str(st) };
}

// 闭包构造（Stage 6）：在栈上构造环境结构 %<n.sb>，逐字段存入被捕获量的值，
// 再构造 %TClosure { fnptr=@<n.sa>, envptr=env } 并以 ptr<void> 返回（与 TClosure ABI 一致）。
// n.sa=合成 lambda 名(__lam_N), n.sb=环境结构名(__env_N), n.la=捕获量链(kids, 每节点 sa=变量名)。
// 镜像 codegen_ll.tc:1627 closure_make（per-capture gep %st.<sb> + store；再 %TClosure {fnptr,envptr}）。
// S4 §0.14.7 SoA（第十六批）：原形参表是 `(n: Node, e: i64)`，而唯一调用点（tir_emit_expr:3056）
//   传的就是 `tir_emit_closure_make(n, e)`，其中 `n == base.nodes[e]`（第十二批迁 sb 时已确认
//   「e 已是本节点索引」）⇒ 属 Node 值形参的**第三类形态：冗余形参**，直接删掉 Node 值形参，
//   由单一真相源 `e` 承担索引职责（留着值形参即留「值拷贝 vs 索引」两个真相源，任一方失同步
//   就会重演批次 9 的静默丢字段）。函数体内自行 locals 取 `var n: Node = base.nodes[e];` 供读
//   结构体字段（na/sa 之类尚未外置的字段）。
pub fn tir_emit_closure_make(e: i64) TirEmitRes {
    var envty: string = base.sb_cat2("%", base.node_sb((e as u64)));   // S4 §0.14.7 SoA：侧表读（原 n.sb；第十二批；e 已是本节点索引）
    // 环境按字段尺寸求和（tir_sizeof 对 %__env_N 未知类型兜底返 8，多字段环境会欠分配 → 必须逐字段加总）。
    // 闭包可逃逸出创建帧（如 make_adder 返回的闭包），环境必须**堆分配**（对齐 codegen_ll.tc:1630 的 t_alloc），
    // 否则 stack alloca 在创建帧返回后即悬垂 → use-after-free（add100(5) 段错误/垃圾）。
    var envsz: i64 = 0;
    var sc: i64 = base.node_la((e as u64));
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
    var sc_ks: []i64 = base.kids_chain(sc);
    var sc_ki: i64 = 0;
    while (sc_ki < slice_len(sc_ks) as i64) {
        var sc_kv: i64 = sc_ks[sc_ki];
        envsz = envsz + tir_sizeof(tir_expr_st(sc_kv));
        sc_ki = sc_ki + 1;
    }
    var szslot: string = tir_tmp();
    tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str("i64"), dst: tir_op(szslot), args: tir_a1(base.i2s(envsz)), is_comment: false, line: g_cur_line, cmt: "" });
    var envptr: string = tir_tmp();   // t_alloc 返回 ptr<void>（堆环境）
    tir_emit(tir_e_call("ptr<void>", envptr, "@t_alloc", [szslot]));
    var envcast: string = tir_tmp();  // 降到 ptr<%__env_N> 供字段 GEP
    tir_emit(tir_emit_bitcast(base.sb_cat3("ptr<", envty, ">"), envcast, envptr));
    var cmc: i64 = base.node_la((e as u64));
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
    var cmc_ks: []i64 = base.kids_chain(cmc);
    var cmc_ki: i64 = 0;
    while (cmc_ki < slice_len(cmc_ks) as i64) {
        var cmc_kv: i64 = cmc_ks[cmc_ki];
        var cvname: string = base.node_sa((cmc_kv as u64));
        var fidx: i64 = tir_field_index(tir_strip_pct(envty), cvname);
        var cvvalr: TirEmitRes = tir_emit_expr(cmc_kv); var cvval: string = cvvalr.name;
        var cvst: string = tir_expr_st(cmc_kv);
        var faddr: string = tir_tmp();
        tir_emit(tir_emit_gep(cvst, faddr, envcast, tir_idxs2("0", base.i2s(fidx))));
        tir_emit(tir_emit_store(cvval, faddr));
        cmc_ki = cmc_ki + 1;
    }
    // TClosure 的 env 字段用堆指针 envptr（ptr<void>）；TClosure 自身仍栈分配（本例不逃逸创建帧）。
    return TirEmitRes{ name: tir_make_closure_value(base.sb_cat2("@", base.node_sa((e as u64))), envptr), st: tir_st_from_str(tir_expr_st(e)) };
}

// ⚠ 形参从 `(n: Node, e: i64)` 简化为 `(e: i64)`：两个形参本是**同一个节点**（调用点写成
//   `tir_emit_binary(n, e)`，而 n == base.nodes[e]），删掉 Node 值形参即可 —— Node 结构体值
//   传参时末尾字段 `id` 不可靠（批次 9 致命坑），本函数读 nb 侧表必须基于索引（§0.14.7 第十五批）。
pub fn tir_emit_binary(e: i64) TirEmitRes {
    var op: string = base.node_sa((e as u64));
    // bool 逻辑（§set-ops 改名）：`and` / `or` → 短路逻辑；`&&` / `||` 现为集合运算符，落通用位运算路径。
    if (op == "and" or op == "or") {
        return tir_emit_logical(op == "and", e);
    }
    var lsr: TirEmitRes = tir_emit_expr(base.node_na((e as u64))); var ls: string = lsr.name;
    // ⚠ 操作数存储型取「实际发射类型」g_tir_last_st（内层 emitter 已置为真实发射类型，
    // 如 index_read→f64 / member_read→成员型），绝不走 tir_expr_st（meta_type_of_expr
    // 对下标/字段表达式偶发返回越界 TD → 退化为 i64，导致 f64/u32 错编为 i64 整数运算）。
    // 必须在发射 rs 之前捕获（发射 rs 会覆盖 st）。tir_expr_st 仅作兜底。
    var ostc: i64 = lsr.st;
    var ost: string = tir_st_to_str(ostc);
    if (ost == "i64") {
        var s2: string = tir_expr_st(base.node_na((e as u64)));
        if (s2 != "i64") { ost = s2; }
    }
    var rsr: TirEmitRes;
    // 向量二元运算：字面量 RHS 须按向量类型构造（否则被当成切片 → 拼接而非逐元素加法，
    // 下游把 %TSlice 当向量 store 进 vec alloca → 内存布局错配崩溃）。LHS 为 @Vector 时用其
    // TD 强制 array_lit 走 vec 分支（对齐旧轨 codegen_ll 把字面量按 LHS 向量类型推断）。
    var ltd: i64 = tir_expr_td(base.node_na((e as u64)));
    var rtd: i64 = tir_expr_td(base.node_nb((e as u64)));
    var vec_td: i64 = -1;
    if (ltd >= 0 and ltd < slice_len(sema.tds) as i64 and sema.tds[ltd].cat == "vector") { vec_td = ltd; }
    else if (rtd >= 0 and rtd < slice_len(sema.tds) as i64 and sema.tds[rtd].cat == "vector") { vec_td = rtd; }
    // 瓦片（@Tile）是聚合值类型；局部瓦片 ident 常以 ptr<arr<arr<...>> 形式返回，
    // 归一化为值类型 arr<arr<elem x cols> x rows>，使 TIR binop 的 st 走 translator 瓦片逐元素分支。
    if (ltd >= 0 and ltd < slice_len(sema.tds) as i64 and sema.tds[ltd].cat == "tile") {
        if (str_len(ost) >= 4 and str_slice(ost, 0, 4) == "ptr<") { ost = str_slice(ost, 4, str_len(ost) - 1); }
    }
    if (vec_td >= 0 and base.node_kind((base.node_nb((e as u64)) as u64)) == "array_lit") {
        rsr = tir_emit_array_lit(base.node_nb((e as u64)), vec_td);
    } else {
        rsr = tir_emit_expr(base.node_nb((e as u64)));
    }
    var rs: string = rsr.name;
    // `++` 定长数组合并（§15.6）：结果存储型必须是 [N+M x T]，绝不能沿用左操作数的 [N x T]
    //（上方 `if (ost == "i64") { ost = tir_expr_st(n.na) }` 回落正是取左型）。否则结果槽只
    // 分配 N 个元素却被写入 N+M 个 → 写穿邻槽，且下游按 [N x T] 拷回，实测拼接结果尾部
    // 恒为 0（`10 20 30 0 0`）。
    // ⚠ 只改结果型 ost，不动 ostc —— ostc 是「操作数」型，用于给入参加标记，改了会污染实参。
    if (op == "Concat" and ltd >= 0 and rtd >= 0 and
        ltd < slice_len(sema.tds) as i64 and rtd < slice_len(sema.tds) as i64 and
        sema.tds[ltd].cat == "array" and sema.tds[rtd].cat == "array") {
        var ccat_td3: i64 = sema.td_elem_mk("array", sema.tds[ltd].elem);
        var ccat_t3: TD = sema.tds[ccat_td3];
        ccat_t3.alen = sema.tds[ltd].alen + sema.tds[rtd].alen;
        slice_set(sema.tds, ccat_td3, ccat_t3);
        ost = tir_st_of_td(ccat_td3);
    }
    // §set-ops Step 2b：位域（packed struct）集合交 / 并 —— 聚合值不能走 `and` / `or` 指令
    // （实测产出非法 IR `and %Perm`），改走「抽宿主整型 → 位运算 → 裹回聚合」三段式。
    // ⚠ 刻意放在 **TIR 层**而不是两个后端各拦一次：ADDR_OF → GEP[0] → LOAD hostst 这条序列
    // 就是 packed 成员读写（P5）已在双后端验证过的通路，STRUCT_NEW 同理（packed 字面量，P5），
    // 故一次实现两端同构，不必再写两套 shim（也就没有「out 参排末位」那类坑）。
    if (op == "&" or op == "|") {
        var pkty: string = tir_packed_bin_ty(ost);
        if (str_len(pkty) > 0) {
            var pkres: string = tir_packed_setop(op, pkty, ls, rs);
            return TirEmitRes{ name: pkres, st: tir_st_from_str(pkty) };
        }
    }
    var opc: string = opmap.tir_binop(base.node_sa((e as u64)), ost);
    var d: string = tir_tmp();
    var __bin_args: []TirOperand = [];
    append(__bin_args, tir_op_tok(tir_os(ls, ostc)));
    append(__bin_args, tir_op_tok(tir_os(rs, ostc)));
    tir_emit(TIRInst{ op: opmap.tir_op_from_str(opc), st: tir_st_from_str(ost), dst: tir_op(d), args: __bin_args, is_comment: false, line: g_cur_line, cmt: "" });
    // 比较运算结果存储型为 i1（icmp/fcmp），其余（算术）为操作数存储型 ost。
    if (base.node_sa((e as u64)) == "==" or base.node_sa((e as u64)) == "!=" or base.node_sa((e as u64)) == "<" or base.node_sa((e as u64)) == ">" or base.node_sa((e as u64)) == "<=" or base.node_sa((e as u64)) == ">=") {
        return TirEmitRes{ name: d, st: ST_I1 };
    }
    return TirEmitRes{ name: d, st: tir_st_from_str(ost) };
}

// 位域（packed struct）二元运算的类型判定：命中返回规范形式 `%Name`，非位域返回 ""。
// ⚠ 只看 `ost`（操作数实际发射类型）：它在本函数上方已对 `ost == "i64"` 做过左操作数兜底。
//   刻意**不再**对整体表达式调 `tir_expr_st` —— 那会经 tir_expr_td 触发 node_set_type 的
//   缓存回收副作用，对**每一个**普通 `&` / `|` 都产生一次额外写入，风险远大于收益。
pub fn tir_packed_bin_ty(ost: string) string {
    if (sema.pk_find_struct(tir_strip_pct(ost)) >= 0) { return base.sb_cat2("%", tir_strip_pct(ost)); }
    return "";
}

// 位域集合交 / 并：两侧宿主整型 AND / OR，再裹回聚合（packed 单 host 字段）。
// 结果与 packed 字面量构造同构（TIR_OP_STRUCT_NEW + 单个 hostst 实参）。
pub fn tir_packed_setop(op: string, psty: string, ls: string, rs: string) string {
    var hostst: string = tir_packed_host_st(psty);
    var hstc: i64 = tir_st_from_str(hostst);
    var ha: string = tir_packed_host(ls, psty);
    var hb: string = tir_packed_host(rs, psty);
    var hr: string = tir_tmp();
    var sop: i64 = TIR_OP_AND;
    if (op == "|") { sop = TIR_OP_OR; }
    var __ps_args: []TirOperand = [];
    append(__ps_args, tir_op(ha));
    append(__ps_args, tir_op(hb));
    tir_emit(TIRInst{ op: sop, st: hstc, dst: tir_op(hr), args: __ps_args, is_comment: false, line: g_cur_line, cmt: "" });
    var d: string = tir_tmp();
    var __pn_args: []TirOperand = [];
    append(__pn_args, tir_op_st(hr, hstc));
    tir_emit(TIRInst{ op: TIR_OP_STRUCT_NEW, st: tir_st_from_str(psty), dst: tir_op(d), args: __pn_args, is_comment: false, line: g_cur_line, cmt: "" });
    return d;
}

// 位域的宿主整型名（u8/u16/u32/u64 → i8/i16/i32/i64）；查不到退回 i64。
pub fn tir_packed_host_st(psty: string) string {
    var pk: i64 = sema.pk_find_struct(tir_strip_pct(psty));
    if (pk >= 0 and pk < slice_len(sema.pk_struct_under) as i64) {
        return sema.pk_host_st(sema.pk_struct_under[pk]);
    }
    return "i64";
}

// 取位域值槽里的宿主整型（packed 单 host 字段，field_index 恒 0 → GEP[0]）。
// 与 tir_member_addr 的 packed 路径逐字同构，含那条 `ptr<%Name>` 的 ADDR_OF 槽型修正 ——
// 宿主整型可能 < 8 字节（%Perm = type { i8 }），按值类型分配会被 8 字节指针写穿栈 → 段错误（P5）。
pub fn tir_packed_host(v: string, psty: string) string {
    var hostst: string = tir_packed_host_st(psty);
    var addr: string = tir_tmp();
    tir_emit(TIRInst{ op: TIR_OP_ADDR_OF, st: tir_st_from_str(base.sb_cat3("ptr<", psty, ">")), dst: tir_op(addr), args: tir_a1(v), is_comment: false, line: g_cur_line, cmt: "" });
    var faddr: string = tir_tmp();
    tir_emit(TIRInst{ op: TIR_OP_GEP, st: tir_st_from_str(hostst), dst: tir_op(faddr), args: tir_a3(addr, "0", "0"), is_comment: false, line: g_cur_line, cmt: "" });
    var hv: string = tir_tmp();
    tir_emit(TIRInst{ op: TIR_OP_LOAD, st: tir_st_from_str(hostst), dst: tir_op(hv), args: tir_a1(tir_os(faddr, tir_st_from_str(base.sb_cat3("ptr<", hostst, ">")))), is_comment: false, line: g_cur_line, cmt: "" });
    return hv;
}

// 短路逻辑 && / ||（memory-first，无 phi；镜像 codegen_ll.tc:1898-1922 的 br i1+phi 短路控制流，
// 但 TIR 走 memory-first：两臂各自 store 同一结果 slot，汇合点无需 φ）。
//   a && b → a 假则 res=false（不求值 b）；a 真则 res=b（求值 b）
//   a || b → a 真则 res=true（不求值 b）；a 假则 res=b（求值 b）
// （项目记忆「t 的 && 不短路」已证伪——以 codegen_ll 运行时行为为准）。
// ⚠ 形参去掉 Node 值 `n`（同 tir_emit_binary：Node 结构体值传参时末尾字段 `id` 不可靠，
//   见批次 9 致命坑；本函数读 nb 侧表必须基于索引 `e`，§0.14.7 第十五批）。
//   原 `(n: Node, is_and: bool, e: i64)` → `(is_and: bool, e: i64)`。
pub fn tir_emit_logical(is_and: bool, e: i64) TirEmitRes {
    var lst: string = tir_expr_st(base.node_na((e as u64)));   // 操作数存储型（bool → i8）
    var lsr: TirEmitRes = tir_emit_expr(base.node_na((e as u64))); var ls: string = lsr.name;
    var res: string = tir_tmp();
    tir_emit(TIRInst{ op: TIR_OP_SLOT, st: tir_st_from_str(lst), dst: tir_op(res), args: tir_a1(res), is_comment: false, line: g_cur_line, cmt: res });
    var thenL: string = tir_lbl("sc.t");
    var elseL: string = tir_lbl("sc.f");
    var endL: string = tir_lbl("sc.e");
    tir_emit(TIRInst{ op: TIR_OP_BR_COND, st: ST_NONE, dst: tir_op(""), args: tir_a3(ls, thenL, elseL), is_comment: false, line: g_cur_line, cmt: "" });
    // then 臂
    tir_block(thenL);
    if (is_and) {
        var rsr: TirEmitRes = tir_emit_expr(base.node_nb((e as u64))); var rs: string = rsr.name;
        tir_emit(TIRInst{ op: TIR_OP_STORE, st: ST_NONE, dst: tir_op(res), args: tir_a1(rs), is_comment: false, line: g_cur_line, cmt: "" });
    } else {
        var one: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str(lst), dst: tir_op(one), args: tir_a1("1"), is_comment: false, line: g_cur_line, cmt: "" });
        tir_emit(TIRInst{ op: TIR_OP_STORE, st: ST_NONE, dst: tir_op(res), args: tir_a1(one), is_comment: false, line: g_cur_line, cmt: "" });
    }
    tir_emit(TIRInst{ op: TIR_OP_BR, st: ST_NONE, dst: tir_op(""), args: tir_a1(endL), is_comment: false, line: g_cur_line, cmt: "" });
    // else 臂
    tir_block(elseL);
    if (is_and) {
        var zero: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str(lst), dst: tir_op(zero), args: tir_a1("0"), is_comment: false, line: g_cur_line, cmt: "" });
        tir_emit(TIRInst{ op: TIR_OP_STORE, st: ST_NONE, dst: tir_op(res), args: tir_a1(zero), is_comment: false, line: g_cur_line, cmt: "" });
    } else {
        var rser: TirEmitRes = tir_emit_expr(base.node_nb((e as u64))); var rse: string = rser.name;
        tir_emit(TIRInst{ op: TIR_OP_STORE, st: ST_NONE, dst: tir_op(res), args: tir_a1(rse), is_comment: false, line: g_cur_line, cmt: "" });
    }
    tir_emit(TIRInst{ op: TIR_OP_BR, st: ST_NONE, dst: tir_op(""), args: tir_a1(endL), is_comment: false, line: g_cur_line, cmt: "" });
    // 汇合点：两臂均已 store 进同一 $res，无需 φ
    tir_block(endL);
    return TirEmitRes{ name: res, st: tir_st_from_str(tir_expr_st(e)) };
}

// S4 §0.14.7 SoA（第十七批·na）：原签名 `tir_emit_unary(n: Node)`。唯一调用方
//   `tir_emit_expr(e: i64)` 传入的 `n` 与 `base.nodes[e]` **恒等**（第三类）⇒ 删冗余
//   Node 值形参、改收索引 e。⚠ 函数体仍读 `n.sa`（sa 未外置），故保留本地取值。
pub fn tir_emit_unary(e: i64) TirEmitRes {
    var ar: TirEmitRes = tir_emit_expr(base.node_na((e as u64))); var a: string = ar.name;
    // 同 binary：操作数存储型取实际发射类型（内层 emitter 已置）。
    var stc: i64 = ar.st;
    var st: string = tir_st_to_str(stc);
    if (st == "i64") {
        var s2: string = tir_expr_st(base.node_na((e as u64)));
        if (s2 != "i64") { st = s2; }
    }
    var d: string = tir_tmp();
    if (base.node_sa((e as u64)) == "-") {
        tir_emit(TIRInst{ op: TIR_OP_NEG, st: tir_st_from_str(st), dst: tir_op(d), args: tir_a1(tir_os(a, stc)), is_comment: false, line: g_cur_line, cmt: "" });
        return TirEmitRes{ name: d, st: tir_st_from_str(st) };
    }
    if (base.node_sa((e as u64)) == "!") {
        tir_emit(TIRInst{ op: TIR_OP_NOT, st: tir_st_from_str("i8"), dst: tir_op(d), args: tir_a1(tir_os(a, ST_I8)), is_comment: false, line: g_cur_line, cmt: "" });
        return TirEmitRes{ name: d, st: tir_st_from_str(st) };
    }
    if (base.node_sa((e as u64)) == "~") {
        tir_emit(TIRInst{ op: TIR_OP_XOR, st: tir_st_from_str(st), dst: tir_op(d), args: tir_a2(tir_os(a, stc), "-1"), is_comment: false, line: g_cur_line, cmt: "" });
        return TirEmitRes{ name: d, st: tir_st_from_str(st) };
    }
    tir_cmt(base.sb_cat3("unsupported unary: ", base.node_sa((e as u64)), ""));
    return TirEmitRes{ name: d, st: tir_st_from_str(st) };
}

// packed struct 底层宿主整型名（sema.packed_host_name 的 u8/u16/u32/u64）→ LLVM 标量类型名。
// P8：flag_set/flag_get 首参为 packed struct 时，读写都必须按「宿主宽度」进行，并把 i64
// 结果截断回宿主宽度再写回。若整块按 i64 store 进 %Perm（宿主 u8 时仅 1 字节）会写穿栈 → 段错误。
pub fn tir_pk_host_st(under: string) string {
    if (under == "u8") { return "i8"; }
    if (under == "u16") { return "i16"; }
    if (under == "u32") { return "i32"; }
    return "i64";
}

pub fn tir_emit_call(e: i64) TirEmitRes {
    // mbuiltin 节点（@sema.name(args)）：名字存于 n.sa，n.na 为 -1（空闲，见 sema.tc:10609）；
    // 其余 call 节点名字在 callee 子节点 n.na 的 .sa。@vlen/@reduce_*/@splat 等 SIMD 内建
    // 保持 mbuiltin 形态（sema 未降级为普通 call），此前误读 base.nodes[n.na]=base.nodes[-1]
    // → t_slice_at 越界 panic。故 mbuiltin 直接取 n.sa，且 callee 退回自身（kind 非 member，
    // 下方 member 分支自然跳过）。
    var cname: string = base.node_sa((e as u64));
    if (base.node_kind((e as u64)) != "mbuiltin") {
        cname = base.node_sa((base.node_na((e as u64)) as u64));
    }
    var retst: string = tir_expr_st(e);
    var ret_td: i64 = tir_expr_td(e);
    // ⚠ SIMD 内建返回类型覆盖：tir_expr_st 对 mbuiltin reduce 节点返回陈旧 i64，
    // 会令下游 `as i64` 把结果当 i64 直接 load（缺 zext）→ 高字节栈垃圾。
    // 对齐旧轨 ll_vec_mbuiltin：vlen 返回 i64；reduce_* 返回向量元素类型（i32/f64...）。
    if (base.node_kind((e as u64)) == "mbuiltin" and (cname == "vlen" or cname == "reduce_add" or cname == "reduce_max" or
            cname == "reduce_min" or cname == "reduce_mul" or cname == "reduce_or" or cname == "reduce_and")) {
        if (cname == "vlen") {
            retst = "i64";
        } else {
            var arg0n: i64 = -1;
            if (base.node_la((e as u64)) >= 0) { arg0n = base.kids[base.node_la((e as u64))].val; }
            var etd: i64 = -1;
            if (arg0n >= 0) {
                etd = tir_expr_td(arg0n);
                if (etd < 0) { etd = sema.meta_type_of_expr(arg0n); }
            }
            if (etd >= 0 and etd < slice_len(sema.tds) as i64 and sema.tds[etd].cat == "vector") {
                retst = tir_st_of_td(sema.tds[etd].elem);
            } else {
                retst = "i32";
            }
        }
    }
    var d: string = tir_tmp();
    var sb: StringBuilder = sb_new();
    var cargs: []string = [];
    var first: bool = true;
    var argi: i64 = 0;
    var ac: i64 = base.node_la((e as u64));
    // sym_str(v)：参数 v 的静态类型即 Sym 类型（如 Sym32("NPCName")），其 TD 的 name 字段就是池 tag。
    // 把 tag 作为首个实参（字符串字面量）注入，供 translator 映射 tll_sym_str(ptr tag, i32 id, ptr out)。
    // 否则 translator 只能看到被擦除的 i32 id，无法定位池 → 输出空串/段错误。
    if (cname == "sym_str") {
        var argnode: i64 = -1;
        if (base.node_la((e as u64)) >= 0) { argnode = base.kids[base.node_la((e as u64))].val; }
        var tag: string = "Sym";
        if (argnode >= 0 and base.node_kind((argnode as u64)) == "ident") {
            // 全局变量 ident：tir_expr_td 返回的 Sym TD（name="Sym"）与全局真实 TD 不同，
            // 必须以 g_global_td 为准（其 name 才是池 tag，如 "NPCName"）。查到即用。
            var gi: i64 = 0;
            var gn: i64 = slice_len(g_global_names) as i64;
            while (gi < gn) {
                if (g_global_names[gi] == base.node_sa((argnode as u64))) {
                    var gtd: i64 = g_global_td[gi];
                    if (gtd >= 0 and sema.tds[gtd].cat == "sym") { tag = sema.tds[gtd].name; }
                    break;
                }
                gi = gi + 1;
            }
            // 局部变量（未命中全局表）：走 tir_expr_td 取 Sym TD
            if (tag == "Sym") {
                var atd: i64 = tir_expr_td(argnode);
                if (atd >= 0 and sema.tds[atd].cat == "sym") { tag = sema.tds[atd].name; }
            }
        }
        var sid: i64 = slice_len(g_mod.strings) as i64;
        if (base.g_relowering) { arena_use_default(); }
        append(g_mod.strings, tag);
        if (base.g_relowering) { if (base.g_relowering_scratch_func) { arena_use_func(); } else { arena_use_default(); } }
        var tagd: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_CONST_STR, st: ST_NONE, dst: tir_op(tagd), args: tir_a1(base.i2s(sid)), is_comment: false, line: g_cur_line, cmt: "" });
        var idd: string = "";
        if (argnode >= 0) { var __ers: TirEmitRes = tir_emit_expr(argnode); idd = __ers.name; }
        tir_emit(TIRInst{ op: TIR_OP_CALL, st: tir_st_from_str("%TStr"), dst: tir_op(d), args: tir_a3("@sym_str", tagd, idd), is_comment: false, line: g_cur_line, cmt: "" });
        return TirEmitRes{ name: d, st: tir_st_from_str(retst) };
    }
    // ── KI-005：device host trampoline（alloc_bytes/free/h2d/d2h/launch）────────
    // 与 C 后端 c_device_call 对齐：device.<m> 成员调用降级为 tll_gpu_* 运行库调用。
    // LLVM 后端此前把 device.launch 当 @device 全局的 TClosure 成员调用（取非法 code 指针）→ 段错误；
    // 这里在通用 call 路径之前拦截，直接发射 tll_gpu_*（blob 由编译器内嵌 @__t_devmod_blob，运行时 extern 引用）。
    // S4 §0.14.7 SoA（第十七批·na）：下方两处 `callee.na` 读的是**子节点**的 na，而 callee
    //   是 `base.nodes[n.na]` 的 Node **值拷贝**、搬不到侧表 ⇒ 必须先还原 callee 的索引。
    //   本分支 `callee.kind == "member"` ⇒ 必非 mbuiltin ⇒ callee 已由 `base.nodes[n.na]`
    //   赋值，故 callee 索引 = base.node_na((e as u64))；mbuiltin 时该值为 -1 但本分支不可达。
    var callee_id: i64 = base.node_na((e as u64));
    if (base.node_kind((callee_id as u64)) == "member") {
        if (base.node_kind((base.node_na((callee_id as u64)) as u64)) == "ident" and base.node_sa((base.node_na((callee_id as u64)) as u64)) == "device") {
            var dev_args: []i64 = [];
            var dc: i64 = base.node_la((e as u64));
            // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
            var dc_ks: []i64 = base.kids_chain(dc);
            var dc_ki: i64 = 0;
            while (dc_ki < slice_len(dc_ks) as i64) {
                var dc_kv: i64 = dc_ks[dc_ki];
                append(dev_args, dc_kv);
                dc_ki = dc_ki + 1;
            }
            if (cname == "alloc_bytes") {
                var sz: string = tir_emit_expr(dev_args[0]).name;
                tir_emit(tir_e_call("i64", d, "@tll_gpu_alloc", tir_cargs1(sz)));
                return TirEmitRes{ name: d, st: tir_st_from_str("i64") };
            }
            if (cname == "free") {
                var p: string = tir_emit_expr(dev_args[0]).name;
                tir_emit(tir_e_call("void", d, "@tll_gpu_free", tir_cargs1(p)));
                return TirEmitRes{ name: d, st: tir_st_from_str(retst) };
            }
            if (cname == "h2d") {
                var d0: string = tir_emit_expr(dev_args[0]).name;
                var s0: string = tir_emit_expr(dev_args[1]).name;
                var n0: string = tir_emit_expr(dev_args[2]).name;
                tir_emit(tir_e_call("void", d, "@tll_gpu_h2d", tir_cargs3(d0, s0, n0)));
                return TirEmitRes{ name: d, st: tir_st_from_str(retst) };
            }
            if (cname == "d2h") {
                var d0: string = tir_emit_expr(dev_args[0]).name;
                var s0: string = tir_emit_expr(dev_args[1]).name;
                var n0: string = tir_emit_expr(dev_args[2]).name;
                tir_emit(tir_e_call("void", d, "@tll_gpu_d2h", tir_cargs3(d0, s0, n0)));
                return TirEmitRes{ name: d, st: tir_st_from_str(retst) };
            }
            if (cname == "launch") {
                // name: TStr → 取 data 字段（field 0）指针即 const char*；grid/block/nargs 为 i64；
                // 变长实参打包成 arr<i64 x N> 栈数组，传其基址（opaque ptr 等价 int64_t*）。
                var nslot: string = tir_emit_expr(dev_args[0]).name;   // %TStr 值
                var gidx0: []string = []; append(gidx0, "0");
                var faddr: string = tir_tmp();
                tir_emit(tir_emit_gep("ptr", faddr, nslot, gidx0));
                var datap: string = tir_tmp();
                tir_emit(tir_emit_load("ptr", datap, faddr));
                var grids: string = tir_emit_expr(dev_args[1]).name;   // i64
                var blocks: string = tir_emit_expr(dev_args[2]).name;  // i64
                var nargs: i64 = slice_len(dev_args) as i64 - 3;
                if (nargs < 0) { nargs = 0; }
                var nargss: string = tir_const_i64(nargs);
                var argvp: string;
                if (nargs > 0) {
                    var arrst: string = base.sb_cat3("arr<i64 x ", base.i2s(nargs), ">");
                    var back: string = tir_tmp();
                    tir_emit(tir_emit_slot(arrst, back));
                    var ki2: i64 = 0;
                    while (ki2 < nargs) {
                        var ev: string = tir_emit_expr(dev_args[3 + ki2]).name;
                        var eaddr: string = tir_tmp();
                        tir_emit(tir_emit_addr_of(arrst, eaddr, back));
                        var gidxk: []string = []; append(gidxk, base.i2s(ki2));
                        var faddr2: string = tir_tmp();
                        tir_emit(tir_emit_gep("i64", faddr2, eaddr, gidxk));
                        tir_emit(tir_emit_store(ev, faddr2));
                        ki2 = ki2 + 1;
                    }
                    argvp = tir_tmp();
                    tir_emit(tir_emit_addr_of(arrst, argvp, back));
                } else {
                    argvp = tir_tmp();
                    tir_emit(tir_emit_const_ptr_null("ptr<i64>", argvp));
                }
                var __la: []string = [];
                append(__la, datap); append(__la, grids); append(__la, blocks); append(__la, nargss); append(__la, argvp);
                tir_emit(tir_e_call("i64", d, "@tll_gpu_launch", __la));
                return TirEmitRes{ name: d, st: tir_st_from_str("i64") };
            }
            // 未知 device 方法：不拦截，落到下方通用 call 路径（不应发生）
        }
    }
    // 变体构造器（返回类型为变体）：统一走 sret——先开 ptr<%V> 槽，构造器写入该槽，调用返回 void。
    // 这样变体值始终以 ptr<%V> 形态流转（对齐 struct_new / match 提取 / 跨函数传参），避免结构体按值返回 ABI 坑。
    if (ret_td >= 0 and t_td_is_variant(ret_td)) {
        var vname: string = sema.tds[ret_td].name;
        // $d 承载 ptr<%V>（struct_new 使 $d = ptr<%V>）
        tir_emit(TIRInst{ op: TIR_OP_STRUCT_NEW, st: tir_st_from_str(base.sb_cat2("%", vname)), dst: tir_op(d), args: tir_a0(), is_comment: false, line: g_cur_line, cmt: "" });
        // 收集字段实参（逐个独立 operand，translator 的 CALL 按 inst.args[1..] 逐参 load）
        var vargs: []string = [];
        append(vargs, d);   // 首参 = sret dest（ptr<%V>）
        ac = base.node_la((e as u64));
        // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
        var ac_ks: []i64 = base.kids_chain(ac);
        var ac_ki: i64 = 0;
        while (ac_ki < slice_len(ac_ks) as i64) {
            var ac_kv: i64 = ac_ks[ac_ki];
            var aslot: string;
            if (base.node_kind((ac_kv as u64)) == "array_lit") {
                var ptd: i64 = tir_callee_param_td(cname, argi);
                if (ptd >= 0 and (sema.tds[ptd].cat == "array" or sema.tds[ptd].cat == "vector")) { var __era: TirEmitRes = tir_emit_array_lit(ac_kv, ptd); aslot = __era.name; }
                else { var __ere: TirEmitRes = tir_emit_expr(ac_kv); aslot = __ere.name; }
            } else if (base.node_kind((ac_kv as u64)) == "map_lit") {
                var ptd: i64 = tir_callee_param_td(cname, argi);
                if (ptd >= 0 and sema.tds[ptd].cat == "map") { var __erm: TirEmitRes = tir_emit_map_lit(ac_kv, ptd); aslot = __erm.name; }
                else { var __ere2: TirEmitRes = tir_emit_expr(ac_kv); aslot = __ere2.name; }
            } else {
                var __er6: TirEmitRes = tir_emit_expr(ac_kv); aslot = __er6.name;
            }
            append(vargs, aslot);
            argi = argi + 1;
            ac_ki = ac_ki + 1;
        }
        // call void @<V>_from_<C> ( ptr<%V> $d <字段实参...> )
        tir_emit(tir_e_call("void", d, base.sb_cat2("@", cname), vargs));
        // ⚠ 结果型必须是 ptr<%V>（带 %），与 tir_st_of_td(变体) 的 ABI 形态逐字一致。
        // 此前写成 ptr<V>（缺 %）→ 与下方 variant 实参适配的 varg_want(ptr<%V>) 字符串不等
        // → 已是指针形态的构造器结果被误判为「值形态」，再套一层 addr_of 取址
        // → 被调方读到「指针值」当 tag → 恒命中 `_` 兜底臂（adt_list 全 -1）。
        return TirEmitRes{ name: d, st: tir_st_from_str(base.sb_cat3("ptr<%", vname, ">")) };

    }
    if (cname == "map_new") {
        // map_new(m) 内建降级：从实参 map 的静态类型推导 key kind / val size，
        // 发射 @map_new (kk, vsz) 字面量实参。否则 translator 会把 $m（未初始化的 map 句柄值）
        // 当 kk/vsz 传入 → tll_map_new 用非法 val_size 分配 → 运行时段错误。
        var mtd: i64 = ret_td;
        if (mtd < 0 and base.node_la((e as u64)) >= 0) { mtd = tir_expr_td(base.kids[base.node_la((e as u64))].val); }
        var keykind: i64 = 1;
        var valsz: i64 = 8;
        if (mtd >= 0 and sema.tds[mtd].cat == "map") {
            var mt: TD = sema.tds[mtd];
            if (sema.tds[mt.key].cat == "string" or sema.tds[mt.key].name == "string") { keykind = 0; }
            valsz = tir_sizeof(tir_st_of_td(mt.val));
        }
        var md: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_CALL, st: tir_st_from_str("ptr<void>"), dst: tir_op(md), args: tir_a3("@map_new", base.i2s(keykind), base.i2s(valsz)), is_comment: false, line: g_cur_line, cmt: "" });
        return TirEmitRes{ name: md, st: tir_st_from_str(retst) };
    }
    // 可选类型内建（可空指针模型）：some(x) → ?T = ptr<elem>；unwrap(p) → elem（标量值或聚合值）。
    // 与旧轨 codegen_ll 对齐：some 经 tll_opt_some 拷贝、unwrap 解引用。须在此显式给出正确返回 ST，
    // 否则 some 被 builtin_ret 退化为 Unknown→i64，下游 tir_expr_st 拿到错类型（unwrap(some(x)) 嵌套、
    // make_opt 返回 some(x) 均会槽类型错配 → unwrap 读出垃圾）。
    if (cname == "some" or cname == "unwrap") {
        var argnode: i64 = -1;
        if (base.node_la((e as u64)) >= 0) { argnode = base.kids[base.node_la((e as u64))].val; }
        var dstst: string = "i64";
        if (cname == "some") {
            var ed: i64 = tir_expr_td(argnode);
            var est: string = "i64";
            if (ed >= 0 and ed < slice_len(sema.tds) as i64) { est = tir_st_of_td(ed); }
            dstst = tir_ensure_opt_tagged(est);   // O-6：?T = %Opt_<E>（按值），不再是 ptr<E>
        } else {
            var otd: i64 = tir_expr_td(argnode);
            if (otd >= 0 and otd < slice_len(sema.tds) as i64 and sema.tds[otd].cat == "optional") {
                var ed: i64 = sema.tds[otd].elem;
                if (ed >= 0 and ed < slice_len(sema.tds) as i64) { dstst = tir_st_of_td(ed); }
            }
        }
        var aslot: string = "";
        if (argnode >= 0) { aslot = tir_emit_expr(argnode).name; }
        var __car: []string = [];
        append(__car, aslot);
        tir_emit(tir_e_call(dstst, d, base.sb_cat2("@", cname), __car));
        return TirEmitRes{ name: d, st: tir_st_from_str(dstst) };
    }
    // ── fid 文件模式 / 格式内建（M51，与旧轨 codegen_ll 对齐）────────
    // fopen 的 mode、fmt_register 的 kind/fmt 实参是白名单 atom 字面量（:read_binary 等），
    // 必须按 codegen_c.fid_code_of 降为整数码传给运行时，不能发射 atom 自身 id
    // （新轨此前误把 :write_binary 当 id=1 → 落到 "w" 文本模式 → 二进制文件损坏 / 反序列化垃圾）。
    // fid_format 须注入 4 个格式 atom 的 id（text/json/rawbin/protobuf）作为运行期比对实参。
    if (cname == "fopen" or cname == "fmt_register" or cname == "fid_format") {
        var a0: i64 = -1;
        var a1: i64 = -1;
        var a2: i64 = -1;
        if (base.node_la((e as u64)) >= 0) {
            a0 = base.kids[base.node_la((e as u64))].val;
            var nx1: i64 = base.kids[base.node_la((e as u64))].next;
            if (nx1 >= 0) { a1 = base.kids[nx1].val; var nx2: i64 = base.kids[nx1].next; if (nx2 >= 0) { a2 = base.kids[nx2].val; } }
        }
        if (cname == "fopen") {
            var p_slot: string = "";
            if (a0 >= 0) { p_slot = tir_emit_expr(a0).name; }
            var m_slot: string;
            if (a1 >= 0 and base.node_kind((a1 as u64)) == "atom") {
                m_slot = tir_const_i32(tir_fid_code_of("mode", base.node_sa((a1 as u64))));
            } else if (a1 >= 0) {
                m_slot = tir_emit_expr(a1).name;
            } else {
                m_slot = tir_const_i32(0);
            }
            tir_emit(tir_e_call("i64", d, "@tll_fopen", tir_cargs2(p_slot, m_slot)));
            return TirEmitRes{ name: d, st: tir_st_from_str(retst) };
        }
        if (cname == "fmt_register") {
            var kind_slot: string;
            if (a0 >= 0 and base.node_kind((a0 as u64)) == "atom") {
                kind_slot = tir_const_i32(tir_fid_code_of("kind", base.node_sa((a0 as u64))));
            } else if (a0 >= 0) {
                kind_slot = tir_emit_expr(a0).name;
            } else {
                kind_slot = tir_const_i32(0);
            }
            var suf_slot: string = "";
            if (a1 >= 0) { suf_slot = tir_emit_expr(a1).name; }
            var fmt_slot: string;
            if (a2 >= 0 and base.node_kind((a2 as u64)) == "atom") {
                fmt_slot = tir_const_i32(tir_fid_code_of("fmt", base.node_sa((a2 as u64))));
            } else if (a2 >= 0) {
                fmt_slot = tir_emit_expr(a2).name;
            } else {
                fmt_slot = tir_const_i32(0);
            }
            var fr_args: []string = [];
            append(fr_args, kind_slot); append(fr_args, suf_slot); append(fr_args, fmt_slot);
            tir_emit(tir_e_call("void", d, "@tll_fmt_register", fr_args));
            return TirEmitRes{ name: d, st: tir_st_from_str(retst) };
        }
        // fid_format(f)：注入 4 个格式 atom id（与旧轨 ll_fmt_atom_args 完全一致）
        var f_slot: string = "";
        if (a0 >= 0) { f_slot = tir_emit_expr(a0).name; }
        var ff_args: []string = [];
        append(ff_args, f_slot);
        append(ff_args, tir_const_i64(sema.atom_intern("text")));
        append(ff_args, tir_const_i64(sema.atom_intern("json")));
        append(ff_args, tir_const_i64(sema.atom_intern("rawbin")));
        append(ff_args, tir_const_i64(sema.atom_intern("protobuf")));
        tir_emit(tir_e_call("i64", d, "@tll_fid_format", ff_args));
        return TirEmitRes{ name: d, st: tir_st_from_str(retst) };
    }
    // fflush(f)：旧轨 codegen_ll 特判为 @tll_fflush（fid 感知，参数 i64 句柄），
    // 新轨若直接发射 @fflush 会落到 libc fflush(FILE*) → 把 i64 句柄当指针解引用 → 段错误。
    if (cname == "fflush") {
        var f_slot: string = "";
        if (base.node_la((e as u64)) >= 0) { f_slot = tir_emit_expr(base.kids[base.node_la((e as u64))].val).name; }
        tir_emit(tir_e_call("void", d, "@tll_fflush", tir_cargs1(f_slot)));
        return TirEmitRes{ name: d, st: tir_st_from_str(retst) };
    }
    // ── append：首参是被原地修改的 slice 左值（局部变量 / 结构体字段 / 切片下标）──
    // ⚠ 必须发射其「地址」（同旧轨 getelementptr 取字段地址），绝不能发射值拷贝：
    // 旧轨 list_push 用 `getelementptr ... %v.self, 0, 0` 取 items 字段地址传给 t_slice_append_sized，
    // 原地改 slice 头。新轨若把 self.items 当值 load 进临时 %TSlice 再取地址，t_slice_append_sized 改的是
    // 临时副本 → 真实 items 头不变 → list_push 后 len 恒为 0（list_demo arena OOM 修复后的残留 bug）。
    // 用 tir_addr_of 发射左值地址（指针槽），translator 的 append 特判直接拿该 ptr 传给 t_slice_append_sized。
    if (cname == "append") {
        // slice 首参须按「存储位置」发射（ptr<%TSlice>），翻译器 append 处理器把它当作
        // t_slice_append_sized 的 slice_ptr 原地改头：
        //   - 局部 ident(out)：tir_emit_expr 返回槽名即地址（alloca 即 ptr<%TSlice>）
        //   - 字段 self.items / 下标：tir_addr_of 取 GEP 地址
        // 元素次参按值发射，翻译器 append 处理器用 ll_map_argptr 转指针（含字面量/右值）。
        // ⚠ n.la 是 kids 数组索引，须 base.kids[n.la].val 取真实首参 NODE 索引。
        var a0n: i64 = -1;
        if (base.node_la((e as u64)) >= 0) { a0n = base.kids[base.node_la((e as u64))].val; }
        var sl: string = "";
        if (a0n >= 0) {
            if (base.node_kind((a0n as u64)) == "member" or base.node_kind((a0n as u64)) == "index" or base.node_kind((a0n as u64)) == "deref") {
                sl = tir_addr_of(a0n).name;        // GEP：字段/元素地址（ptr<%TSlice>）
            } else {
                sl = tir_emit_expr(a0n).name;       // 局部 ident：槽名即 ptr<%TSlice> 存储位置
            }
        }
        var vn: i64 = -1;
        var a1: i64 = base.kids[base.node_la((e as u64))].next;
        if (a1 >= 0) { vn = base.kids[a1].val; }
        // 元素类型 = 首参切片的元素 TD（append 要求值类型 == 元素类型）。
        // 用声明元素类型导出的字节宽作为 elem_size 传给翻译器；绝不可从「待追加值槽的存储型」
        // 反推——窄整数在 TIR 整数临时槽按 i64 加宽 ⇒ []u8 的 elem_size 退化成 8，append 按
        // 8 字节步长寻址，每个字节被填进 8 字节槽、相邻元素读到 0/越界（hir.tc 字节缓冲曾因此
        // 被迫用 string 而非 []u8）；若槽保留 u8 还会误发非法类型令牌 `u8`。与 C 后端 sizeof(ElemT) 同构。
        var etdv: i64 = -1;
        if (a0n >= 0) {
            var atdv: i64 = tir_expr_td(a0n);
            if (atdv >= 0 and atdv < slice_len(sema.tds) as i64) {
                if (sema.tds[atdv].cat == "slice") { etdv = sema.tds[atdv].elem; }
            }
        }
        var esz: i64 = 8;   // 兜底（元素类型不可推断时，如 append(s, []) 空字面量）
        if (etdv >= 0 and etdv < slice_len(sema.tds) as i64) {
            esz = tir_sizeof(tir_st_of_td(etdv));
        }
        var vs: string = "";
        if (vn >= 0) {
            var usedv: bool = false;
            if (etdv >= 0 and etdv < slice_len(sema.tds) as i64 and base.node_kind((vn as u64)) == "array_lit") {
                var ecatv: string = sema.tds[etdv].cat;
                if (ecatv == "slice" or ecatv == "array" or ecatv == "vector" or ecatv == "tile") {
                    var __era1: TirEmitRes = tir_emit_array_lit(vn, etdv); vs = __era1.name; usedv = true;
                }
            }
            if (usedv == false) { vs = tir_emit_expr(vn).name; }      // 待追加元素值（翻译器转指针）
        }
        // 元素尺寸作为第三实参显式传递（与 @slice_from_raw 的 esz 同构），翻译器直接用、不再自推。
        var ez: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str("i64"), dst: tir_op(ez), args: tir_a1(base.i2s(esz)), is_comment: false, line: g_cur_line, cmt: "" });
        tir_emit(tir_e_call(retst, d, "@append", tir_cargs3(sl, vs, ez)));
        return TirEmitRes{ name: d, st: tir_st_from_str(retst) };
    }
    // ── @splat(s, N)：返回 @Vector(N, T) ────────────────────────────────
    // sema 未给 mbuiltin 节点回填向量返回 TD（tir_expr_st 退化 i64 → translator 收到 i64
    // → `insertelement i64 undef` 非法）。故在此显式从「首参标量类型 + 次参 lane 数字面量」
    // 构造向量存储型，覆盖默认 retst，与新轨 array_lit 的 vec 分支同构。
    if (cname == "splat") {
        var arg0n: i64 = -1;
        var arg1n: i64 = -1;
        if (base.node_la((e as u64)) >= 0) {
            arg0n = base.kids[base.node_la((e as u64))].val;
            var nx1: i64 = base.kids[base.node_la((e as u64))].next;
            if (nx1 >= 0) { arg1n = base.kids[nx1].val; }
        }
        // 元素类型 + lane 数：首选首参字面量后缀 n.sb（最可靠，绕过 sema 把裸整数字面量
        // TD 标成 i8 的缓存污染）；否则回退 meta_type_of_expr 的向量返回类型 / tir_expr_td。
        var elemst: string = "i32";
        var N: i64 = 1;
        if (arg0n >= 0 and base.node_kind((arg0n as u64)) == "int" and str_len(base.node_sb((arg0n as u64))) > 0) {
            elemst = base.node_sb((arg0n as u64));
        } else {
            var rtd: i64 = sema.meta_type_of_expr(e);
            if (rtd >= 0 and rtd < slice_len(sema.tds) as i64 and sema.tds[rtd].cat == "vector") {
                elemst = tir_st_of_td(sema.tds[rtd].elem);
            } else if (arg0n >= 0) {
                var etd: i64 = tir_expr_td(arg0n);
                if (etd >= 0) { elemst = tir_st_of_td(etd); }
            }
        }
        if (arg1n >= 0) {
            if (base.node_kind((arg1n as u64)) == "int") { N = tir_atoi(base.node_sa((arg1n as u64))); }
            else if (base.node_kind((arg1n as u64)) == "fidconst") { N = base.node_ia((arg1n as u64)); }
        }
        if (N < 1) { N = 1; }
        var vst: string = base.sb_cat5("vec<", elemst, " x ", base.i2s(N), ">");
        var sslot: string = "";
        if (arg0n >= 0) { sslot = tir_emit_expr(arg0n).name; }
        tir_emit(tir_e_call(vst, d, "@splat", tir_cargs1(sslot)));
        return TirEmitRes{ name: d, st: tir_st_from_str(vst) };
    }
    // ── @Tile 编译期内省：sema 已把行/列/flavor 回填到 mbuiltin 节点 n.ia/n.ib/n.lc ──
    // （sema.tc:5024），直接发射编译期常量 i64（同旧轨 ll_vec_mbuiltin 返回 base.i2s(n.ia)，
    // 无需 translator 支持）。注意：mbuiltin 节点 n 即本调用节点，n.ia/n.ib/n.lc 可直接读。
    if (cname == "tile_rows" or cname == "tile_cols" or cname == "tile_flavor") {
        var dimv: i64 = 0;
        if (cname == "tile_rows") { dimv = base.node_ia((e as u64)); }
        else if (cname == "tile_cols") { dimv = base.node_ib((e as u64)); }   // S4 §0.14.7 SoA：侧表读（原 n.ib）
        else { dimv = base.node_lc((e as u64)); }
        var dd2: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str("i64"), dst: tir_op(dd2), args: tir_a1(base.i2s(dimv)), is_comment: false, line: g_cur_line, cmt: "" });
        return TirEmitRes{ name: dd2, st: tir_st_from_str("i64") };
    }
    // ── @tsplat(scalar, rows, cols)：返回 @Tile 嵌套数组类型 ──
    // 返回类型覆盖为嵌套 arr（tir_st_of_td 的 tile 分支），translator 的 tsplat 处理器
    // 按返回类型推导 rows/cols 发射逐元素 GEP 写（同旧轨读返回类型 rtd 的 alen）。
    // 仅发射标量首参（行/列由返回类型推导，与旧轨一致，不重复传字面量）。
    if (cname == "tsplat") {
        // 返回类型 = 嵌套 arr<arr<elem x cols> x rows>（与 tir_st_of_td 的 tile 分支同构）。
        // ⚠ 不可依赖 sema.meta_type_of_expr(e)：sema 给 @tsplat 回填的是 1x1 tile TD，
        // 会导致 a 被建成 1x1 形状（值当 ptr 塞进 2x3 缓冲，reduce 全错）。
        // 改从实参推导：标量首参类型 + 次参 rows + 三参 cols（同旧轨 ll_vec_mbuiltin 读 rtd.alen/rows）。
        var arg0n: i64 = -1;
        var arg1n: i64 = -1;
        var arg2n: i64 = -1;
        if (base.node_la((e as u64)) >= 0) {
            arg0n = base.kids[base.node_la((e as u64))].val;
            var nx1: i64 = base.kids[base.node_la((e as u64))].next;
            if (nx1 >= 0) {
                arg1n = base.kids[nx1].val;
                var nx2: i64 = base.kids[nx1].next;
                if (nx2 >= 0) { arg2n = base.kids[nx2].val; }
            }
        }
        var elemst: string = "i32";
        if (arg0n >= 0 and base.node_kind((arg0n as u64)) == "int" and str_len(base.node_sb((arg0n as u64))) > 0) {
            elemst = base.node_sb((arg0n as u64));
        } else {
            var rtd2: i64 = sema.meta_type_of_expr(e);
            if (rtd2 >= 0 and rtd2 < slice_len(sema.tds) as i64 and sema.tds[rtd2].cat == "tile") {
                elemst = tir_st_of_td(sema.tds[rtd2].elem);
            } else if (arg0n >= 0) {
                var etd: i64 = tir_expr_td(arg0n);
                if (etd >= 0) { elemst = tir_st_of_td(etd); }
            }
        }
        var rows: i64 = 1;
        var cols: i64 = 1;
        if (arg1n >= 0) {
            if (base.node_kind((arg1n as u64)) == "int") { rows = tir_atoi(base.node_sa((arg1n as u64))); }
            else if (base.node_kind((arg1n as u64)) == "fidconst") { rows = base.node_ia((arg1n as u64)); }
        }
        if (arg2n >= 0) {
            if (base.node_kind((arg2n as u64)) == "int") { cols = tir_atoi(base.node_sa((arg2n as u64))); }
            else if (base.node_kind((arg2n as u64)) == "fidconst") { cols = base.node_ia((arg2n as u64)); }
        }
        if (rows < 1) { rows = 1; }
        if (cols < 1) { cols = 1; }
        var tst2: string = base.sb_cat3(base.sb_cat5("arr<arr<", elemst, " x ", base.i2s(cols), "> x "), base.i2s(rows), ">");
        var sslot2: string = "";
        if (arg0n >= 0) { sslot2 = tir_emit_expr(arg0n).name; }
        tir_emit(tir_e_call(tst2, d, "@tsplat", tir_cargs1(sslot2)));
        return TirEmitRes{ name: d, st: tir_st_from_str(tst2) };
    }
    // ── @treduce_sum/mul/min/max(tile)：返回瓦片元素标量类型 ──
    // est2 由瓦片 TD 的元素类型推导（对齐旧轨 treduce 返回元素标量，下游 `as i64` 才能正确 zext）。
    if (cname == "treduce_sum" or cname == "treduce_mul" or cname == "treduce_min" or cname == "treduce_max") {
        var arg0n2: i64 = -1;
        if (base.node_la((e as u64)) >= 0) { arg0n2 = base.kids[base.node_la((e as u64))].val; }
        var est2: string = "i32";
        var atd2: i64 = -1;
        if (arg0n2 >= 0) {
            atd2 = tir_expr_td(arg0n2);
            if (atd2 < 0 or atd2 >= slice_len(sema.tds) as i64) { atd2 = sema.meta_type_of_expr(arg0n2); }
        }
        if (atd2 >= 0 and atd2 < slice_len(sema.tds) as i64 and sema.tds[atd2].cat == "tile") {
            var trow2: i64 = sema.tds[atd2].elem;
            if (trow2 >= 0 and trow2 < slice_len(sema.tds) as i64) { est2 = tir_st_of_td(sema.tds[trow2].elem); }
        }
        var tslot2: string = "";
        if (arg0n2 >= 0) { tslot2 = tir_emit_expr(arg0n2).name; }
        tir_emit(tir_e_call(est2, d, base.sb_cat2("@", cname), tir_cargs1(tslot2)));
        return TirEmitRes{ name: d, st: tir_st_from_str(est2) };
    }
    // 常规调用：发射各实参 → 直接 call
    ac = base.node_la((e as u64));
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
    var ac_ks: []i64 = base.kids_chain(ac);
    var ac_ki: i64 = 0;
    while (ac_ki < slice_len(ac_ks) as i64) {
        var ac_kv: i64 = ac_ks[ac_ki];
        var aslot: string;
        if (base.node_kind((ac_kv as u64)) == "array_lit") {
            var ptd: i64 = tir_callee_param_td(cname, argi);
            if (ptd >= 0 and (sema.tds[ptd].cat == "array" or sema.tds[ptd].cat == "vector")) {
                var __er7: TirEmitRes = tir_emit_array_lit(ac_kv, ptd); aslot = __er7.name;
            } else {
                var __er8: TirEmitRes = tir_emit_expr(ac_kv); aslot = __er8.name;
            }
        } else if (base.node_kind((ac_kv as u64)) == "map_lit") {
            var ptd: i64 = tir_callee_param_td(cname, argi);
            if (ptd >= 0 and sema.tds[ptd].cat == "map") {
                var __er9: TirEmitRes = tir_emit_map_lit(ac_kv, ptd); aslot = __er9.name;
            } else {
                var __er10: TirEmitRes = tir_emit_expr(ac_kv); aslot = __er10.name;
            }
        } else {
            var __er11: TirEmitRes = tir_emit_expr(ac_kv); aslot = __er11.name;
            // 形参是标量时，按形参实际类型对齐实参（仅浮点互转）：修复 f64 折叠的 f32 字面量/
            // 运算结果（如 -(3.5f32)）直接传给 f32 形参 → LLVM 类型错配（t_math_fabsf(float) 收到
            // double → 低位字节为 0 → 返回 0）的 bug。
            var aptd: i64 = tir_callee_param_td(cname, argi);
            if (aptd >= 0 and sema.tds[aptd].cat == "scalar") {
                var pst: string = tir_st_of_td(aptd);
                var isrc: string = tir_st_to_str(__er11.st);
                if (pst != "" and isrc != "" and isrc != pst and (isrc == "f32" or isrc == "f64") and (pst == "f32" or pst == "f64")) {
                    aslot = tir_cast_slot(aslot, __er11.st, pst);
                }
            }
            // 形参是 []T 而实参是 [N]T：补 array→slice 视图（否则被调用方读到脏长度 → 段错误）。
            if (aptd >= 0 and sema.tds[aptd].cat == "slice") { aslot = tir_maybe_array_to_slice(aslot, ac_kv); }
            // 形参是 variant：ABI 为 ptr<%V>（与 <V>_is_<C>/<V>_as_<C> 构造器一致），但调用方
            // 持有的变体实参是 %V 值（for 循环变量 / 普通变体局部量均为 %V 值 alloca，slice 亦按
            // 值存 24 字节）。若把值直接传进去，被调方按 ptr 解释 → 段错误。故值形态实参统一取地址
            // 再传；实参已是 ptr<%V>（变体参数透传）则直传，不动。
            // ⚠ variant td 的 cat 是 "named"（name=变体名），须用 t_td_is_variant 判定，不能写
            // sema.tds[aptd].cat == "variant"（永远为假）。
            if (aptd >= 0 and t_td_is_variant(aptd)) {
                var varg_st: string = tir_st_to_str(__er11.st);
                // ⚠ 期望型必须直接取 tir_st_of_td（变体 → ptr<%V>，单一真相源）。
                // 此前写成 "ptr<%" + tir_st_value_of_td(aptd) + ">" → value_of_td 自身已带 %
                // → 拼出 ptr<%%V> 与任何实参形态都不等 → 连已是 ptr<%V> 的构造器结果也被
                // 多套一层 addr_of（多一层间接）→ 被调方把「指针」当 tag 读 → 恒走 `_` 臂。
                var varg_want: string = tir_st_of_td(aptd);
                if (varg_st != varg_want) {
                    var vst: string = tir_st_value_of_td(aptd);
                    var vtmp: string = base.sb_cat2("$__vap", base.i2s(g_slotc)); g_slotc = g_slotc + 1;
                    tir_emit(tir_emit_slot(vst, vtmp));
                    tir_emit(tir_emit_store(aslot, vtmp));
                    var vptr: string = base.sb_cat2("$__vap", base.i2s(g_slotc)); g_slotc = g_slotc + 1;
                    tir_emit(tir_emit_addr_of(varg_want, vptr, vtmp));
                    aslot = vptr;
                }
            }
        }
        // ── P8：flag_set/flag_get 首参为 packed struct → 降级到宿主整型传参 ─────────
        // 运行时签名 int64_t t_flag_set/get(int64_t flags, int64_t mask, ...)。packed struct
        // 在 LLVM 侧是单字段聚合体（%Perm = type { i8 }）：若整体按值传入，① call 的 declare
        // 会被推导成 (%Perm, i64, i64)，与运行时 int64 ABI 错配；② 写回处又会把 i64 结果整块
        // store 进 1 字节的 %Perm → 写穿栈 → 段错误。故此处取「宿主字段」的值并 zext 到 i64，
        // declare 随之对齐成正确的 (i64, i64, i64)。
        if (argi == 0 and (cname == "flag_set" or cname == "flag_get")) {
            var fsty: string = tir_expr_st(ac_kv);
            var fpi: i64 = sema.pk_find_struct(tir_strip_pct(fsty));
            if (fpi >= 0 and fpi < slice_len(sema.pk_struct_under) as i64) {
                var fhst: string = tir_pk_host_st(sema.pk_struct_under[fpi]);
                // ⚠ aslot 在通用实参路径上可能是「已加载的值寄存器」（直接 GEP 会多一层索引
                // → invalid getelementptr indices），故统一先取地址得到指针再 GEP（与 tir_member_addr
                // 同一写法：addr_of → gep [0, fidx]）。
                var fptr: TirEmitRes = tir_addr_of(ac_kv);
                var fg1: []string = [];
                append(fg1, "0");
                append(fg1, "0");
                var fhptr: string = tir_tmp();
                tir_emit(tir_emit_gep(fhst, fhptr, fptr.name, fg1));
                var fhv: string = tir_tmp();
                tir_emit(tir_emit_load(fhst, fhv, fhptr));
                // 宿主整型一律无符号（u8/u16/u32/u64），故显式 ZEXT（tir_cast_slot 认 "i8" 为
                // 有符号会发 sext，宿主高位为 1 时会符号扩展成负数）。
                var fz8: string = tir_tmp();
                tir_emit(TIRInst{ op: TIR_OP_ZEXT, st: tir_st_from_str("i64"), dst: tir_op(fz8), args: tir_a1(fhv), is_comment: false, line: g_cur_line, cmt: "" });
                aslot = fz8;
            }
        }
        if (first == false) { sb_append_str(sb, " "); }
        sb_append_str(sb, aslot);
        append(cargs, aslot);
        first = false;
        argi = argi + 1;
        ac_ki = ac_ki + 1;
    }
    // 成员函数指针字段调用（如 h.op(4) / c.step_fn(...)）：callee 是 member 节点，字段类型为 func。
    // 必须保留接收者、经字段槽里的 %TClosure 走 call_ind（code+env 解包），绝不能降级成裸全局 @op 调用
    // （接收者丢失 → link failed: op / step_fn）。tir_member_read 取出字段中的 %TClosure(ptr<void>) 槽，
    // 与本地闭包变量 f1(2) 走 call_ind 的 ABI 完全一致（translator 从槽解包 code/env）。
    if (base.node_kind((callee_id as u64)) == "member") {
        var field_res: TirEmitRes = tir_member_read(base.node_na((e as u64)));
        var call_ind_retst: string = retst;
        var recv_st: string = tir_expr_st(base.node_na((callee_id as u64)));
        var sname: string = tir_strip_pct(recv_st);
        var ftd: i64 = tir_field_td(sname, base.node_sa((callee_id as u64)));
        if (ftd >= 0 and ftd < slice_len(sema.tds) as i64 and sema.tds[ftd].cat == "func") {
            call_ind_retst = tir_st_of_td(sema.tdf_ret[ftd]);
        }
        tir_emit(tir_emit_call_ind(call_ind_retst, d, field_res.name, cargs));
        return TirEmitRes{ name: d, st: tir_st_from_str(call_ind_retst) };
    }
    // ⭐ G-2：`fs[0](args)` —— 被调者是 **index** 节点且元素类型为 func。
    //   此前无此分支 ⇒ 落到下方「被调函数名」路径，而 index 节点取不到函数名（cname 为空）
    //   ⇒ TIR 发 `call i64 $t @ $arg`（空名）⇒ LLVM 发 `call i64 @t__`（未定义符号，链接失败）。
    //   与上面 member 分支同构：用 tir_emit_index_read 把下标表达式求值成元素槽
    //   （ptr<void> = 指向 %TClosure），再 call_ind（后端 GEP 解包 code/env）。
    //   ⚠ 返回类型必须取自元素 TD 的 tdf_ret：retst 默认是 i64，聚合返回（%TStr 等）会签名错配。
    if (base.node_kind((callee_id as u64)) == "index") {
        var idx_td: i64 = tir_expr_td(callee_id);
        if (idx_td >= 0 and idx_td < slice_len(sema.tds) as i64 and sema.tds[idx_td].cat == "func") {
            var idx_res: TirEmitRes = tir_emit_index_read(callee_id);
            var ci_retst: string = tir_st_of_td(sema.tdf_ret[idx_td]);
            tir_emit(tir_emit_call_ind(ci_retst, d, idx_res.name, cargs));
            return TirEmitRes{ name: d, st: tir_st_from_str(ci_retst) };
        }
    }
    // 间接调用：被调者是本地槽（闭包值，ptr<void> 指向 %TClosure）→ call_ind；
    // 否则是被调函数名 → 直接 call。镜像 codegen_ll.tc ll_call（局部/全局函数类型变量 → 间接）。
    var callee_ref: string = base.sb_cat2("@", cname);
    var is_ind: bool = false;
    if (tir_find_local_idx(cname) >= 0) {
        callee_ref = base.sb_cat2("$", cname);
        is_ind = true;
    } else if (tir_is_global_fnval(cname)) {
        // 全局函数值变量（@name 持有 %TClosure）：call_ind 经 GEP 取其 code/env 间接调用
        callee_ref = base.sb_cat2("@", cname);
        is_ind = true;
    }
    var op: string = "call";
    if (is_ind) { op = "call_ind"; }
    // 间接闭包调用（被调为局部/全局函数值变量）：其 TIR 槽类型是 ptr<void>，
    // tir_expr_st 对函数值变量默认回退 i64，会令聚合返回（%TStr 等）经 call_ind 时签名错配 → 末行 <hello> 丢失。
    // 此处从被调函数值变量的 FuncType TD（cat=="func"）取真实返回类型，覆盖默认 retst。
    // ⚠ g_local_tds 存的是 TD 索引（查 sema.tds[].cat），不是 TI 索引——误用 tip_kind 会索引错表、永不命中。
    var ctd: i64 = -1;
    if (is_ind) {
        if (tir_find_local_idx(cname) >= 0) {
            ctd = g_local_tds[tir_find_local_idx(cname)];
        } else if (tir_is_global_fnval(cname)) {
            ctd = tir_global_fnval_td(cname);
        }
        if (ctd >= 0 and ctd < slice_len(sema.tds) as i64 and sema.tds[ctd].cat == "func") {
            ret_td = sema.tdf_ret[ctd];
            retst = tir_st_of_td(ret_td);
        }
    }
    if (is_ind) {
        tir_emit(tir_emit_call_ind(retst, d, callee_ref, cargs));
    } else {
        tir_emit(tir_e_call(retst, d, callee_ref, cargs));
    }
    // ── KI-003：flag_set 写回（LLVM 后端）────────────────────────────────
    // t 的 flag_set(p, mask, val) 语义等价 C 后端宏 ((p) = t_flag_set(p, mask, val))：
    // 必须要把调用返回值写回首参 lvalue。C 后端靠宏内联赋值实现；TIR/LLVM 路径此前
    // 只把结果留在临时 %d，首参 p 是值传递副本，运行期 p 始终为初始 0 → 位域全 0。
    // 此处取首参地址并 STORE 调用结果 d 回去，与 C 宏逐字等价（flag_get 只读，无需写回）。
    if (cname == "flag_set") {
        var a0n: i64 = -1;
        if (base.node_la((e as u64)) >= 0) { a0n = base.kids[base.node_la((e as u64))].val; }
        if (a0n >= 0) {
            var addrr: TirEmitRes = tir_addr_of(a0n);
            // P8：首参为 packed struct 时，写回必须落到「宿主字段」并截断回宿主宽度。
            // 原逻辑把 i64 结果整块 store 进 %Perm（宿主 u8 时仅 1 字节）→ 写穿栈 → 段错误。
            var wsty: string = tir_expr_st(a0n);
            var wpi: i64 = sema.pk_find_struct(tir_strip_pct(wsty));
            if (wpi >= 0 and wpi < slice_len(sema.pk_struct_under) as i64) {
                var whst: string = tir_pk_host_st(sema.pk_struct_under[wpi]);
                var wg1: []string = [];
                append(wg1, "0");
                append(wg1, "0");
                var whptr: string = tir_tmp();
                tir_emit(tir_emit_gep(whst, whptr, addrr.name, wg1));
                var whv: string = tir_tmp();
                tir_emit(TIRInst{ op: TIR_OP_TRUNC, st: tir_st_from_str(whst), dst: tir_op(whv), args: tir_a1(d), is_comment: false, line: g_cur_line, cmt: "" });
                tir_emit(tir_emit_store(whv, whptr));
            } else {
                tir_emit(tir_emit_store(d, addrr.name));
            }
        }
    }
    return TirEmitRes{ name: d, st: tir_st_from_str(retst) };
}

// 定长数组 [N]T → []T 零拷贝切片视图。
// sema 对 `var s: []i64 = arr;` / `f(arr)`（形参 []T）不插 cast 节点，直接把 [N]T 的
// N*esz 字节写进 %TSlice 槽 → 长度/步长字段是脏栈 → 读切片即段错误。
// 故在「目标为切片」的写入点（var_decl 初始器 / assign / call 实参）统一补 @slice_from_raw。
pub fn tir_maybe_array_to_slice(src: string, srce: i64) string {
    var std: i64 = tir_expr_td(srce);
    if (std < 0) { return src; }
    // ⚠ tir_expr_td 在部分路径（meta_type_of_expr + resolve_type_desc）会返回等于 TD 表长度的
    // 越界索引（潜伏缺陷，adt_multi 的 `t_slice_at index==length` panic 同型）。
    // 此处必须先做上界检查再索引 sema.tds，否则把已有 PASS 的用例（vdot_all）打成编译期 panic。
    if (std >= slice_len(sema.tds) as i64) { return src; }
    if (sema.tds[std].cat != "array") { return src; }
    var d: string = tir_tmp();
    var nl: string = tir_tmp();
    tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str("i64"), dst: tir_op(nl), args: tir_a1(base.i2s(sema.tds[std].alen)), is_comment: false, line: g_cur_line, cmt: "" });
    var ez: string = tir_tmp();
    tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str("i64"), dst: tir_op(ez), args: tir_a1(base.i2s(tir_sizeof(tir_st_of_td(sema.tds[std].elem)))), is_comment: false, line: g_cur_line, cmt: "" });
    tir_emit(TIRInst{ op: TIR_OP_CALL, st: tir_st_from_str("%TSlice"), dst: tir_op(d), args: tir_a4("@slice_from_raw", src, nl, ez), is_comment: false, line: g_cur_line, cmt: "" });
    return d;
}

// 无初始化器的切片声明 → 显式空表（elem_size 由声明类型导出，不许兜底 8）。
// 与 C 后端 `TSlice x = t_slice_new(sizeof(T))` 同构：{ptr=null, len=0, cap=0, elem_size}。
// 走 @slice_from_raw(null, 0, esz) 复用既有的「切片返回值经 out 参数」翻译路径
// （tir_to_ll 的 tll_slice_from_raw 分支），不新增 opcode。
pub fn tir_emit_slice_default(slot: string, td: i64) void {
    var esz: i64 = 8;
    if (td >= 0 and td < slice_len(sema.tds) as i64) {
        if (sema.tds[td].cat == "slice") {
            var etd: i64 = sema.tds[td].elem;
            if (etd >= 0 and etd < slice_len(sema.tds) as i64) {
                esz = tir_sizeof(tir_st_of_td(etd));
            }
        }
    }
    var nul: string = tir_tmp();
    tir_emit(TIRInst{ op: TIR_OP_CONST_PTR_NULL, st: tir_st_from_str("ptr<void>"), dst: tir_op(nul), args: tir_a0(), is_comment: false, line: g_cur_line, cmt: "" });
    var nl: string = tir_tmp();
    tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str("i64"), dst: tir_op(nl), args: tir_a1("0"), is_comment: false, line: g_cur_line, cmt: "" });
    var ez: string = tir_tmp();
    tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str("i64"), dst: tir_op(ez), args: tir_a1(base.i2s(esz)), is_comment: false, line: g_cur_line, cmt: "" });
    var d: string = tir_tmp();
    tir_emit(TIRInst{ op: TIR_OP_CALL, st: tir_st_from_str("%TSlice"), dst: tir_op(d), args: tir_a4("@slice_from_raw", nul, nl, ez), is_comment: false, line: g_cur_line, cmt: "" });
    tir_emit(TIRInst{ op: TIR_OP_STORE, st: ST_NONE, dst: tir_op(slot), args: tir_a1(d), is_comment: false, line: g_cur_line, cmt: "" });
}

// ⚠ 形参 Node 值 `n` → 节点索引 `sid`（Node 结构体值传参时末尾字段 `id` 不可靠，批次 9 致命坑；
//   本函数读 nb 侧表必须基于索引，§0.14.7 第十五批）。调用点 `tir_emit_expr` 里 `e` 现成可用。
pub fn tir_emit_cast(sid: i64, est: i64) TirEmitRes {
    // 致命坑⑤：表达式位（return / call-arg）的 array_lit 被 sema 包进 cast 节点，
    // 在此顶部拦截，按 cast 目标类型直接降级（避免落到兜底 unsupported）。
    if (base.node_kind((base.node_na((sid as u64)) as u64)) == "array_lit") {
        var ttd: i64 = sema.resolve_type_desc(base.node_nb((sid as u64)));
        return tir_emit_array_lit(base.node_na((sid as u64)), ttd);
    }
    // 定长数组 → 切片（零拷贝视图）：cast 节点形态的 [N]T → []T。
var cft: i64 = tir_expr_td(base.node_na((sid as u64)));
    var ctt: i64 = sema.resolve_type_desc(base.node_nb((sid as u64)));
    if (cft >= 0 and ctt >= 0 and sema.tds[cft].cat == "array" and sema.tds[ctt].cat == "slice") {
        var avr: TirEmitRes = tir_emit_expr(base.node_na((sid as u64))); var av: string = avr.name;
        var dsl: string = tir_tmp();
        var nl: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str("i64"), dst: tir_op(nl), args: tir_a1(base.i2s(sema.tds[cft].alen)), is_comment: false, line: g_cur_line, cmt: "" });
        var ez: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str("i64"), dst: tir_op(ez), args: tir_a1(base.i2s(tir_sizeof(tir_st_of_td(sema.tds[cft].elem)))), is_comment: false, line: g_cur_line, cmt: "" });
        tir_emit(TIRInst{ op: TIR_OP_CALL, st: tir_st_from_str("%TSlice"), dst: tir_op(dsl), args: tir_a4("@slice_from_raw", av, nl, ez), is_comment: false, line: g_cur_line, cmt: "" });
        return TirEmitRes{ name: dsl, st: tir_st_from_str("%TSlice") };
    }
    var innerr: TirEmitRes = tir_emit_expr(base.node_na((sid as u64))); var inner: string = innerr.name;
    // ⚠ 关键：源类型必须用「实际发射类型」(g_tir_last_st，由内层 emit 设置，如 mul.f64→f64)，
    // 不能用 tir_expr_st（走 meta_type_of_expr，在 `as i64` 整数语境下会把浮点操作数
    // 强制推断成 i64，导致 inner_st==target_st 早返回、丢失 fptosi 转换 → 打印位模式而非数值）。
    // canonical codegen_ll 用 ll_etd(内层) 取发射类型，此处对齐。
    var inner_stc: i64 = innerr.st;
    var inner_st: string = tir_st_to_str(inner_stc);
    if (inner_st == "" or inner_st == "i64") {
        var is2: string = tir_expr_st(base.node_na((sid as u64)));
        if (is2 != "" and is2 != "i64") { inner_st = is2; }
    }
    // 枚举在 TIR 中被擦除为整数，但其 expr_st 仍是 %Name（未声明的 LLVM 类型）。
    // 把枚举操作数按 i64 看待，使 as 转换走正确的整数宽度逻辑（no-op/trunc/zext/sext），
    // 而不是 emit 引用未声明 %Color 的 `bitcast`。
    // ⚠ TD-vs-TI：tir_expr_td 返回 TD 索引，tir_emit_cast 此处需用 TD 字段判定枚举，
    // 绝不可把 TD 索引喂给 sema.tip_kind（读 tis[]，会越界 panic）。
    // ⚠ 枚举 TD 的 cat 是 "named"，用 cat=="enum" 判定永远不生效；必须走 t_td_is_enum 回查 EnumDecl。
    var cast_src_td: i64 = tir_expr_td(base.node_na((sid as u64)));
    if (t_td_is_enum(cast_src_td)) { inner_st = "i64"; }
    var target_st: string = tir_st_of_td(sema.resolve_type_desc(base.node_nb((sid as u64))));
    if (inner_st == target_st) { return TirEmitRes{ name: inner, st: est }; }
    var d: string = tir_tmp();
    var fi: bool = (inner_st == "f32" or inner_st == "f64");
    var ft: bool = (target_st == "f32" or target_st == "f64");
    var ui: bool = (str_len(inner_st) >= 1 and inner_st[0] == 117) or inner_st == "bool";
    var wi: i64 = tir_width(inner_st);
    var wt: i64 = tir_width(target_st);
    var inner_tok: string = tir_os(inner, inner_stc);
    if (fi and ft) {
        // 浮点 → 浮点：按宽窄选 fptrunc / fpext（同宽按 fpext 兜底，下游无操作）。
        if (wi > wt) { tir_emit(TIRInst{ op: TIR_OP_FPTRUNC, st: tir_st_from_str(target_st), dst: tir_op(d), args: tir_a1(inner_tok), is_comment: false, line: g_cur_line, cmt: "" }); }
        else { tir_emit(TIRInst{ op: TIR_OP_FPEXT, st: tir_st_from_str(target_st), dst: tir_op(d), args: tir_a1(inner_tok), is_comment: false, line: g_cur_line, cmt: "" }); }
    } else if (fi and ft == false) {
        // 浮点 → 整数：有符号 fptosi / 无符号 fptoui（修复原 bitcast 误把位模式当整数）。
        if (ui) { tir_emit(TIRInst{ op: TIR_OP_FPTOUI, st: tir_st_from_str(target_st), dst: tir_op(d), args: tir_a1(inner_tok), is_comment: false, line: g_cur_line, cmt: "" }); }
        else { tir_emit(TIRInst{ op: TIR_OP_FPTOSI, st: tir_st_from_str(target_st), dst: tir_op(d), args: tir_a1(inner_tok), is_comment: false, line: g_cur_line, cmt: "" }); }
    } else if (fi == false and ft) {
        // 整数 → 浮点：有符号 sitofp / 无符号 uitofp。
        if (ui) { tir_emit(TIRInst{ op: TIR_OP_UITOFP, st: tir_st_from_str(target_st), dst: tir_op(d), args: tir_a1(inner_tok), is_comment: false, line: g_cur_line, cmt: "" }); }
        else { tir_emit(TIRInst{ op: TIR_OP_SITOFP, st: tir_st_from_str(target_st), dst: tir_op(d), args: tir_a1(inner_tok), is_comment: false, line: g_cur_line, cmt: "" }); }
    } else if (wi < wt) {
        if (ui) { tir_emit(TIRInst{ op: TIR_OP_ZEXT, st: tir_st_from_str(target_st), dst: tir_op(d), args: tir_a1(inner_tok), is_comment: false, line: g_cur_line, cmt: "" }); }
        else { tir_emit(TIRInst{ op: TIR_OP_SEXT, st: tir_st_from_str(target_st), dst: tir_op(d), args: tir_a1(inner_tok), is_comment: false, line: g_cur_line, cmt: "" }); }
    } else if (wi > wt) {
        tir_emit(TIRInst{ op: TIR_OP_TRUNC, st: tir_st_from_str(target_st), dst: tir_op(d), args: tir_a1(inner_tok), is_comment: false, line: g_cur_line, cmt: "" });
    } else {
        tir_emit(TIRInst{ op: TIR_OP_BITCAST, st: tir_st_from_str(target_st), dst: tir_op(d), args: tir_a1(inner_tok), is_comment: false, line: g_cur_line, cmt: "" });
    }
    return TirEmitRes{ name: d, st: est };
}

pub fn tir_width(st: string) i64 {
    if (st == "i8" or st == "u8") { return 8; }
    if (st == "i16" or st == "u16") { return 16; }
    if (st == "i32" or st == "u32") { return 32; }
    if (st == "i64" or st == "u64") { return 64; }
    if (st == "f32") { return 32; }
    if (st == "f64") { return 64; }
    return 64;
}

// 把已发射临时 src（类型 src_stc，i64 st 常量）对齐到目标类型 dst_st（字符串），返回新临时。
// 用于调用实参按形参实际类型对齐：修复 f64 折叠的 f32 字面量/运算结果（如 -(3.5f32)）直接传给
// f32 形参 → LLVM 类型错配（t_math_fabsf(float) 收到 double → 低位字节为 0 → 返回 0）的 bug。
// ⚠ 仅处理浮点互转（其余整型/聚合宽度对齐由各自写入点负责）；发射结构化 TIRInst，
// 种子对结构化 TIRInst 可靠保留，不会像手动 sb_append_str("fptrunc...") 那样被静默丢弃。
pub fn tir_cast_slot(src: string, src_stc: i64, dst_st: string) string {
    var src_st: string = tir_st_to_str(src_stc);
    if (src_st == dst_st) { return src; }
    var d: string = tir_tmp();
    var inner_tok: string = tir_os(src, src_stc);
    var fi: bool = (src_st == "f32" or src_st == "f64");
    var ft: bool = (dst_st == "f32" or dst_st == "f64");
    var ui: bool = (str_len(src_st) >= 1 and src_st[0] == 117) or src_st == "bool";
    var wi: i64 = tir_width(src_st);
    var wt: i64 = tir_width(dst_st);
    if (fi and ft) {
        if (wi > wt) { tir_emit(TIRInst{ op: TIR_OP_FPTRUNC, st: tir_st_from_str(dst_st), dst: tir_op(d), args: tir_a1(inner_tok), is_comment: false, line: g_cur_line, cmt: "" }); }
        else { tir_emit(TIRInst{ op: TIR_OP_FPEXT, st: tir_st_from_str(dst_st), dst: tir_op(d), args: tir_a1(inner_tok), is_comment: false, line: g_cur_line, cmt: "" }); }
    } else if (fi and ft == false) {
        if (ui) { tir_emit(TIRInst{ op: TIR_OP_FPTOUI, st: tir_st_from_str(dst_st), dst: tir_op(d), args: tir_a1(inner_tok), is_comment: false, line: g_cur_line, cmt: "" }); }
        else { tir_emit(TIRInst{ op: TIR_OP_FPTOSI, st: tir_st_from_str(dst_st), dst: tir_op(d), args: tir_a1(inner_tok), is_comment: false, line: g_cur_line, cmt: "" }); }
    } else if (fi == false and ft) {
        if (ui) { tir_emit(TIRInst{ op: TIR_OP_UITOFP, st: tir_st_from_str(dst_st), dst: tir_op(d), args: tir_a1(inner_tok), is_comment: false, line: g_cur_line, cmt: "" }); }
        else { tir_emit(TIRInst{ op: TIR_OP_SITOFP, st: tir_st_from_str(dst_st), dst: tir_op(d), args: tir_a1(inner_tok), is_comment: false, line: g_cur_line, cmt: "" }); }
    } else if (wi < wt) {
        if (ui) { tir_emit(TIRInst{ op: TIR_OP_ZEXT, st: tir_st_from_str(dst_st), dst: tir_op(d), args: tir_a1(inner_tok), is_comment: false, line: g_cur_line, cmt: "" }); }
        else { tir_emit(TIRInst{ op: TIR_OP_SEXT, st: tir_st_from_str(dst_st), dst: tir_op(d), args: tir_a1(inner_tok), is_comment: false, line: g_cur_line, cmt: "" }); }
    } else if (wi > wt) {
        tir_emit(TIRInst{ op: TIR_OP_TRUNC, st: tir_st_from_str(dst_st), dst: tir_op(d), args: tir_a1(inner_tok), is_comment: false, line: g_cur_line, cmt: "" });
    } else {
        tir_emit(TIRInst{ op: TIR_OP_BITCAST, st: tir_st_from_str(dst_st), dst: tir_op(d), args: tir_a1(inner_tok), is_comment: false, line: g_cur_line, cmt: "" });
    }
    return d;
}

pub fn tir_emit_struct_lit(e: i64) TirEmitRes {
    // 目标存储类型：具名结构体字面量名在 n.sa（与 codegen_c.tc:789 / ll_etd struct_lit 分支对齐，
    // 类型名即 TT 条目名）；匿名（n.sa 空）退回 meta 推断（tir-design.md §7 named -> %Name）。
    var target_st: string = "i64";
    if (str_len(base.node_sa((e as u64))) > 0) { target_st = base.sb_cat2("%", base.node_sa((e as u64))); }
    else { target_st = tir_expr_st(e); }
    var d: string = tir_tmp();
    var __sl_args: []TirOperand = [];
    var fc: i64 = base.node_la((e as u64));
    // ⚠ 具名字面量：TIR_OP_STRUCT_NEW 的后端以 "i32 0, i32 <arg_index>" GEP 把实参按
    // **声明槽位**落槽，故 __sl_args 必须是声明序。字面量书写序可能与声明序不同
    // （如 TIRFunc{name,ret_st,params,body} vs 声明 name,params,ret_st,body），
    // 直接按书写序 append 会让 params/ret_st 互换 -> 切片 len 读垃圾 -> arena OOM。
    // 故先按书写序收集 (字段名 -> 值槽名)，再沿声明字段链表顺序归位。
    var fnames: []string = [];
    var fvals: []string = [];
    var fvalsts: []i64 = [];
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
    var fc_ks: []i64 = base.kids_chain(fc);
    var fc_ki: i64 = 0;
    while (fc_ki < slice_len(fc_ks) as i64) {
        var fc_kv: i64 = fc_ks[fc_ki];
        // 字段以 FV（field-value）节点存储：na = 字段值表达式（见 base.mk_FV）；
        // 直接 emit FV 节点会落到 unsupported 兜底，故必须解包到其 .na 值子节点。
        var fs: string;
        var fst: i64 = 0;
        if (str_len(base.node_sa((e as u64))) > 0 and base.node_kind((base.node_na((fc_kv as u64)) as u64)) == "array_lit") {
            // 字段值是切片/数组字面量（含 `types: []` 这类空字面量）：用**字段声明类型**作
            // 期望类型下发。否则空字面量无从推断元素宽度 ⇒ elem_size 兜底成 8（V006）。
            var fatd: i64 = tir_field_td(base.node_sa((e as u64)), base.node_sa((fc_kv as u64)));
            var faus: bool = false;
            if (fatd >= 0 and fatd < slice_len(sema.tds) as i64) {
                var facat: string = sema.tds[fatd].cat;
                if (facat == "slice" or facat == "array" or facat == "vector" or facat == "tile") {
                    var __era2: TirEmitRes = tir_emit_array_lit(base.node_na((fc_kv as u64)), fatd); fs = __era2.name; fst = __era2.st; faus = true;
                }
            }
            if (faus == false) {
                var fsr5: TirEmitRes = tir_emit_expr(base.node_na((fc_kv as u64))); fs = fsr5.name; fst = fsr5.st;
            }
        } else if (str_len(base.node_sa((e as u64))) > 0 and base.node_kind((base.node_na((fc_kv as u64)) as u64)) == "map_lit") {
            // ⚠ map 字面量作具名结构体字段值：tir_emit_expr 落到 map_lit 分支时 force_td=-1，
            // tir_expr_td 不可靠 -> untyped 兜底返回 0 指针。显式用字段类型 TD 构造。
            var ftd: i64 = tir_field_td(base.node_sa((e as u64)), base.node_sa((fc_kv as u64)));
            if (ftd >= 0 and sema.tds[ftd].cat == "map") {
                var fsrm: TirEmitRes = tir_emit_map_lit(base.node_na((fc_kv as u64)), ftd); fs = fsrm.name; fst = fsrm.st;
            } else {
                var fsr2: TirEmitRes = tir_emit_expr(base.node_na((fc_kv as u64))); fs = fsr2.name; fst = fsr2.st;
            }
        } else {
            var fsr: TirEmitRes = tir_emit_expr(base.node_na((fc_kv as u64))); fs = fsr.name; fst = fsr.st;
        }
        // ⭐ G-4 修复：fn 类型字段的「裸函数符号」必须先包成 %TClosure 值再落槽。
        //   形态：`Box{ .r0 = seven }` / `Box{ .r0 = fn(){...} }` —— 字段值是 `@fn`。
        //   而该字段的下游消费方是「取字段值当 **TClosure\***，再 GEP 解包 field0/field1」
        //   （结构体字段存的是 ptr，不是内联 TClosure）⇒ 存裸 code 必炸：
        //     · LLVM 轨：`store i64 @fn` ⇒ clang「global variable reference must have
        //       pointer type」→ 链接失败（改动前的编译器对普通 `P3{ .a = 5 }` 同款的标量字段才炸）；
        //     · tmir-c 轨：字段里存裸 code ⇒ `b.r0()` 把函数机器码当 TClosure 结构读 → 段错误。
        //   ⚠ 捕获型 lambda 已是闭包值（tir_emit_closure_make 产出的是堆指针，**不以 '@' 开头**）
        //     ⇒ 判据「值以 '@' 开头」天然只命中裸函数符号，两类永不重叠。
        //   ⚠ 与 %TClosure.field0 语义互斥：那里必须存**裸 code**（各后端按
        //     g_ll_clofnslot / c_clo_code 判别），此处是 fn 类型字段，存闭包值。
        if (str_len(base.node_sa((e as u64))) > 0 and str_len(fs) >= 1 and fs[0] == 64) {
            var ftdc: i64 = tir_field_td(base.node_sa((e as u64)), base.node_sa((fc_kv as u64)));
            if (ftdc >= 0 and ftdc < slice_len(sema.tds) as i64 and sema.tds[ftdc].cat == "func") {
                fs = tir_make_closure_value(fs, "");
                fst = tir_st_from_str("ptr<void>");
            }
        }
        append(fnames, base.node_sa((fc_kv as u64)));
        append(fvals, fs);
        append(fvalsts, fst);
        fc_ki = fc_ki + 1;
    }
    // P5：packed struct 字面量 → 单宿主整型，字段按 (val << start) & mask 累积 OR。
    var pslit: i64 = sema.pk_find_struct(base.node_sa((e as u64)));
    if (pslit >= 0) {
        var hostst: string = sema.pk_host_st(sema.pk_struct_under[pslit]);
        var acc: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str(hostst), dst: tir_op(acc), args: tir_a1("0"), is_comment: false, line: g_cur_line, cmt: "" });
        var pfi: i64 = 0;
        while (pfi < slice_len(fnames) as i64) {
            var psl: i64 = sema.pk_find_slot(base.node_sa((e as u64)), fnames[pfi]);
            if (psl >= 0) {
                var pstart: i64 = sema.pk_slot_starts[psl];
                var plen: i64 = sema.pk_slot_lens[psl];
                var pvname: string = fvals[pfi];
                var pvbits: i64 = base.ll_bits(tir_st_to_str(fvalsts[pfi]));
                var hostbits: i64 = base.ll_bits(hostst);
                if (pvbits > hostbits) {
                    pvname = tir_tmp();
                    tir_emit(TIRInst{ op: TIR_OP_TRUNC, st: tir_st_from_str(hostst), dst: tir_op(pvname), args: tir_a1(fvals[pfi]), is_comment: false, line: g_cur_line, cmt: "" });
                } else if (pvbits < hostbits) {
                    pvname = tir_tmp();
                    tir_emit(TIRInst{ op: TIR_OP_ZEXT, st: tir_st_from_str(hostst), dst: tir_op(pvname), args: tir_a1(fvals[pfi]), is_comment: false, line: g_cur_line, cmt: "" });
                }
                var pshl: string = tir_tmp();
                tir_emit(TIRInst{ op: TIR_OP_SHL, st: tir_st_from_str(hostst), dst: tir_op(pshl), args: tir_a2(pvname, base.i2s(pstart)), is_comment: false, line: g_cur_line, cmt: "" });
                var pmv: i64; if (plen < 64) { pmv = tir_pow2_i64(plen) - 1; } else { pmv = -1; }
                var pmc: string = tir_tmp();
                tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str(hostst), dst: tir_op(pmc), args: tir_a1(base.i2s(pmv)), is_comment: false, line: g_cur_line, cmt: "" });
                var psm: string = tir_tmp();
                tir_emit(TIRInst{ op: TIR_OP_SHL, st: tir_st_from_str(hostst), dst: tir_op(psm), args: tir_a2(pmc, base.i2s(pstart)), is_comment: false, line: g_cur_line, cmt: "" });
                var pvand: string = tir_tmp();
                tir_emit(TIRInst{ op: TIR_OP_AND, st: tir_st_from_str(hostst), dst: tir_op(pvand), args: tir_a2(pshl, psm), is_comment: false, line: g_cur_line, cmt: "" });
                var pnacc: string = tir_tmp();
                tir_emit(TIRInst{ op: TIR_OP_OR, st: tir_st_from_str(hostst), dst: tir_op(pnacc), args: tir_a2(acc, pvand), is_comment: false, line: g_cur_line, cmt: "" });
                acc = pnacc;
            }
            pfi = pfi + 1;
        }
        // 把 hostst 值裹成 %Name 聚合（单 host 字段）→ 与变量槽类型一致，供下游 STORE。
        // ⚠ args 是 []TirOperand：tir_op_st 已返回单个 TirOperand，须直接 append 入切片，
        // 不可套 tir_a1（tir_a1 入参是 string，套上会把 TirOperand 当 string 传 → IRV003 类型不符）。
        var d: string = tir_tmp();
        var __pk_args: []TirOperand = [];
        append(__pk_args, tir_op_st(acc, tir_st_from_str(hostst)));
        tir_emit(TIRInst{ op: TIR_OP_STRUCT_NEW, st: tir_st_from_str(target_st), dst: tir_op(d), args: __pk_args, is_comment: false, line: g_cur_line, cmt: "" });
        return TirEmitRes{ name: d, st: tir_st_from_str(target_st) };
    }
    var fh: i64 = -1;
    if (str_len(base.node_sa((e as u64))) > 0) { fh = sema.find_struct_fields(base.node_sa((e as u64))); }
    if (fh >= 0) {
        // 按声明顺序归位；未提供值的字段直接跳过（槽位保持 zeroinitializer，
        // 避免发射空操作数 -> 非法 IR）。
        var c: i64 = fh;
        var matched: i64 = 0;
        // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
        var c_ks: []i64 = base.kids_chain(c);
        var c_ki: i64 = 0;
        while (c_ki < slice_len(c_ks) as i64) {
            var c_kv: i64 = c_ks[c_ki];
            var vv: string = "";
            var vst: i64 = 0;
            var j: i64 = 0;
            while (j < slice_len(fnames) as i64) {
                if (fnames[j] == base.node_sa((c_kv as u64))) { vv = fvals[j]; vst = fvalsts[j]; matched = matched + 1; }
                j = j + 1;
            }
            if (str_len(vv) > 0) {
                // 提供了值：按原样落槽（vst 为发射端 ST 码，与字段声明类型一致）。
                append(__sl_args, tir_op_st(vv, vst));
            } else {
                // ⚠ 修复 KI-004：省略字段绝不能「跳过」。后端 STRUCT_NEW 以
                // "i32 0, i32 <arg_index>" GEP 把实参按**声明序槽位**落槽，若跳过，
                // 位于切片/聚合字段之后的字段会被整体左移一位 → 读到错误偏移的垃圾
                // （实测 score 1.5→4.94066e-324、ok true→false）。
                // 改用「声明类型零值」补齐：emit 一个 0 实参的 STRUCT_NEW 物化该字段
                // 类型的零化槽（alloca + zeroinitializer，st 已登记），再作为实参落
                // **声明序对应槽位**，使后续字段索引不被打乱。C 后端走 AST 复合字面量
                // 的 .field 指定，天然正确，不受此处影响。
                var ftd: i64 = tir_field_td(base.node_sa((e as u64)), base.node_sa((c_kv as u64)));
                var fstr: string = tir_st_of_td(ftd);
                var zs: string = tir_tmp();
                tir_emit(TIRInst{ op: TIR_OP_STRUCT_NEW, st: tir_st_from_str(fstr), dst: tir_op(zs), args: [], is_comment: false, line: g_cur_line, cmt: "" });
                append(__sl_args, tir_op_st(zs, tir_st_from_str(fstr)));
            }
            c_ki = c_ki + 1;
        }
        // V004：具名字面量写入了非声明字段 —— 位置落槽后端会把它静默错位。
        if (matched < slice_len(fnames) as i64) {
            var q: i64 = 0;
            while (q < slice_len(fnames) as i64) {
                if (tir_verify_has_field(fh, fnames[q]) == false) {
                    tir_verify_report("V004", base.sb_cat2(base.sb_cat2(base.node_sa((e as u64)), " 具名字面量含非声明字段: "), fnames[q]));
                }
                q = q + 1;
            }
        }
    } else {
        // 匿名字面量 / 查不到声明：退回书写序（原行为）
        var j2: i64 = 0;
        while (j2 < slice_len(fvals) as i64) { append(__sl_args, tir_op(fvals[j2])); j2 = j2 + 1; }
    }
    tir_emit(TIRInst{ op: TIR_OP_STRUCT_NEW, st: tir_st_from_str(target_st), dst: tir_op(d), args: __sl_args, is_comment: false, line: g_cur_line, cmt: "" });
    return TirEmitRes{ name: d, st: tir_st_from_str(target_st) };
}

// ══════════════════════════════════════════════════════════════════
// 数组 / 切片字面量降级（Stage 3）
// ══════════════════════════════════════════════════════════════════

// 数组/切片字面量降级（Stage 3）：
//  - 固定数组（TD.cat=="array"）：struct_new arr<elem x N> (e0..eN-1)
//  - 切片（TD.cat=="slice" 或未知类型兜底）：在栈上开 arr<elem x N> 后备槽，逐元素存，
//    再用 bitcast 取得 ptr<void> 数据指针，struct_new %TSlice (data, len, cap, 0)
//  - force_td：来自 var_decl / assign LHS / cast 的显式期望类型；<0 时退回 meta_type_of_expr / 首元素推断
pub fn tir_emit_array_lit(e: i64, force_td: i64) TirEmitRes {
    var elems: []i64 = [];
    var c: i64 = base.node_la((e as u64));
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
    var c_ks: []i64 = base.kids_chain(c);
    var c_ki: i64 = 0;
    while (c_ki < slice_len(c_ks) as i64) {
        var c_kv: i64 = c_ks[c_ki];
        append(elems, c_kv);
        c_ki = c_ki + 1;
    }
    var N: i64 = slice_len(elems) as i64;
    var td: i64 = force_td;
    if (td < 0) { td = tir_expr_td(e); }
    var cat: string = "";
    var elem_st: string = "i64";
    var elem_td: i64 = -1;   // G-2：元素 TD（判 fn 元素是否需要包 %TClosure）
    if (td >= 0) {
        var t: TD = sema.tds[td];
        cat = t.cat;
        elem_td = t.elem;
        elem_st = tir_st_of_td(t.elem);
    } else if (N > 0) {
        elem_st = tir_expr_st(elems[0]);
    } else if (N == 0) {
        // V006（T1「聚合写入语义」第一刀）：空字面量 + 无期望类型 ⇒ 元素宽度只能兜底成 i64。
        // 「兜底」不是语义，是静默错编：elem_size 写成 8 而元素实为 %TStr(16) 时，
        // t_slice_at / t_slice_append 按 data+idx*elem_size 寻址 ⇒ %TStr.len 读到邻字段
        // （打印空行或内存残片，不崩溃）。自举二代 arena OOM 正由此而起
        // （ll_parse_func: `g_pf_params = []` 后 append 形参名）。
        // 契约：聚合的元素宽度必须由**类型**导出；推导不出就显式报告，不许猜。
        tir_verify_report("V006", base.sb_cat2(
            base.sb_cat2("空切片字面量元素类型不可推断（无期望类型、且无元素可推）⇒ elem_size 退化为 8 —— line ",
                base.i2s(g_cur_line as i64)),
            "；请给它一个期望类型上下文（赋值目标 / 形参 / 返回值）"));
        elem_st = "i64";
    } else {
    }
    if (cat == "array" or cat == "vector") {
        // 向量字面量 `[a,b,c,d]`（期望类型为 @Vector(N,T)）与定长数组同构：
        // 直接发射固定聚合 `vec<elem x N>`，逐 lane store 到 alloca（translator 经 STRUCT_NEW
        // 通用 GEP+store 路径处理）。此前漏此分支 → 落到下方切片分支发射成 %TSlice，
        // 下游 lane 访问 / reduce 把向量当切片，触发 tll_slice_at 越界 panic。
        var arrst: string = base.sb_cat5("arr<", elem_st, " x ", base.i2s(N), ">");
        if (cat == "vector") { arrst = base.sb_cat5("vec<", elem_st, " x ", base.i2s(N), ">"); }
        var d: string = tir_tmp();
        var __al_args: []TirOperand = [];
        var i: i64 = 0;
        while (i < N) {
            var esr: TirEmitRes = tir_emit_expr(elems[i]); var es: string = esr.name;
            // ⭐ G-2：fn 元素的「裸函数符号」必须先包成 %TClosure 值，与 G-4 的 fn 结构体字段
            //   同款（见 tir_emit_struct_lit）。数组元素槽是 ptr<void>（**指向** %TClosure），
            //   下游 call_ind 会 GEP 解包 field0=code / field1=env；存裸 code 的后果：
            //     · LLVM：`store i64 @fn` ⇒ clang「global variable reference must have pointer type」；
            //     · tmir-c：把函数机器码当 %TClosure 读 ⇒ 段错误。
            //   ⚠ 捕获型 lambda 已是堆闭包指针（`tir_emit_closure_make` 产物，**不以 '@' 开头**）
            //     ⇒ 判据天然只命中裸函数符号，两类永不重叠。
            if (elem_td >= 0 and elem_td < slice_len(sema.tds) as i64) {
                if (sema.tds[elem_td].cat == "func" and str_len(es) >= 1 and es[0] == 64) {
                    es = tir_make_closure_value(es, "");
                }
            }
            append(__al_args, tir_op(es));
            i = i + 1;
        }
        tir_emit(TIRInst{ op: TIR_OP_STRUCT_NEW, st: tir_st_from_str(arrst), dst: tir_op(d), args: __al_args, is_comment: false, line: g_cur_line, cmt: "" });
        return TirEmitRes{ name: d, st: tir_st_from_str(arrst) };
    }
    if (cat == "tile") {
        // 瓦片字面量 [[r0c0,r0c1],[r1c0,r1c1],...] → 嵌套定长数组（与旧轨 ll_vec_mbuiltin 同构）：
        // 先逐行构 arr<elem x cols>，再构外层 arr<row x rows>。
        var trow: i64 = sema.tds[td].elem;
        var cols: i64 = sema.tds[trow].alen;
        if (cols < 0) { cols = 0; }
        var scalar_st: string = tir_st_of_td(sema.tds[trow].elem);
        var rowst: string = base.sb_cat5("arr<", scalar_st, " x ", base.i2s(cols), ">");
        var rows: i64 = N;
        var outerst: string = base.sb_cat5("arr<", rowst, " x ", base.i2s(rows), ">");
        var row_slots: []TirOperand = [];
        var ri: i64 = 0;
        while (ri < rows) {
            var rr: TirEmitRes = tir_emit_array_lit(elems[ri], trow);
            append(row_slots, tir_op(rr.name));
            ri = ri + 1;
        }
        var d: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_STRUCT_NEW, st: tir_st_from_str(outerst), dst: tir_op(d), args: row_slots, is_comment: false, line: g_cur_line, cmt: "" });
        return TirEmitRes{ name: d, st: tir_st_from_str(outerst) };
    }
    // 切片字面量：后备槽 + %TSlice
    var arrst: string = base.sb_cat5("arr<", elem_st, " x ", base.i2s(N), ">");
    var back: string = tir_tmp();
    tir_emit(TIRInst{ op: TIR_OP_SLOT, st: tir_st_from_str(arrst), dst: tir_op(back), args: tir_a0(), is_comment: false, line: g_cur_line, cmt: back });
    var i: i64 = 0;
    while (i < N) {
        var esr: TirEmitRes = tir_emit_expr(elems[i]); var es: string = esr.name;
        var eaddr: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_ADDR_OF, st: tir_st_from_str(arrst), dst: tir_op(eaddr), args: tir_a1(back), is_comment: false, line: g_cur_line, cmt: "" });
        var faddr: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_GEP, st: tir_st_from_str(elem_st), dst: tir_op(faddr), args: tir_a2(eaddr, base.i2s(i)), is_comment: false, line: g_cur_line, cmt: "" });
        tir_emit(TIRInst{ op: TIR_OP_STORE, st: ST_NONE, dst: tir_op(faddr), args: tir_a1(es), is_comment: false, line: g_cur_line, cmt: "" });
        i = i + 1;
    }
    var bptr: string = tir_tmp();
    tir_emit(TIRInst{ op: TIR_OP_ADDR_OF, st: tir_st_from_str(arrst), dst: tir_op(bptr), args: tir_a1(back), is_comment: false, line: g_cur_line, cmt: "" });
    var vptr: string = tir_tmp();
    tir_emit(TIRInst{ op: TIR_OP_BITCAST, st: tir_st_from_str("ptr<void>"), dst: tir_op(vptr), args: tir_a1(bptr), is_comment: false, line: g_cur_line, cmt: "" });
    var slen: string = tir_tmp();
    tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str("i64"), dst: tir_op(slen), args: tir_a1(base.i2s(N)), is_comment: false, line: g_cur_line, cmt: "" });
    var scap: string = tir_tmp();
    tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str("i64"), dst: tir_op(scap), args: tir_a1(base.i2s(N)), is_comment: false, line: g_cur_line, cmt: "" });
    var szero: string = tir_tmp();
    // ⚠ elem_size 必须是元素真实字节大小：tll_slice_at/append 用 data+idx*elem_size 寻址，
    // 填 0 会让所有下标都返回元素 0（实测 sum_slice([10,20,30])=30、s[1]=1）。
    tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str("i64"), dst: tir_op(szero), args: tir_a1(base.i2s(tir_sizeof(elem_st))), is_comment: false, line: g_cur_line, cmt: "" });
    var d: string = tir_tmp();
    var __sn_args: []TirOperand = [];
    append(__sn_args, tir_op(vptr));
    append(__sn_args, tir_op(slen));
    append(__sn_args, tir_op(scap));
    append(__sn_args, tir_op(szero));
    tir_emit(TIRInst{ op: TIR_OP_STRUCT_NEW, st: tir_st_from_str("%TSlice"), dst: tir_op(d), args: __sn_args, is_comment: false, line: g_cur_line, cmt: "" });
    return TirEmitRes{ name: d, st: tir_st_from_str(tir_expr_st(e)) };
}

// defer 排空（LIFO）：遇显式 return 或函数尾调用。
// ⚠ 故意【不清空】 g_tir_defer：defer 是函数级、应在「每个」出口（每条 return / 函数尾）都运行一次。
// 若在此清空，则多 return 函数中只有 lowering 顺序上首个 return 会排空，其余出口的 defer 被静默丢弃；
// 而运行期控制流只会实际走到一个出口，故不清空 → 每条出口都发射一遍 defer 体，运行期恰好执行一次。
pub fn tir_flush_defer() void {
    var n: i64 = slice_len(g_tir_defer) as i64;
    while (n > 0) {
        n = n - 1;
        g_cur_line = base.node_span_id(g_tir_defer[n]).line;
        var c: i64 = base.node_la((g_tir_defer[n] as u64));
        // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
        var c_ks: []i64 = base.kids_chain(c);
        var c_ki: i64 = 0;
        while (c_ki < slice_len(c_ks) as i64) {
            var c_kv: i64 = c_ks[c_ki];
            tir_emit_stmt(c_kv);
            c_ki = c_ki + 1;
        }
    }
}

var g_membase_st: string = "";   // tir_member_addr 写回的「基底表达式权威类型」，供 tir_member_read 取字段 ST（嵌套 member 必须，避免 tir_expr_st 对 m.i 误判为 i64）
// 嵌套 member 的基底类型解析（纯字符串路径，不依赖 TD 索引，避免 TD 越界回退 i64 导致字段索引错位）：
// m.i.b → 基底 m.i 的类型 = tir_field_st(typeof(m), "i") = "%Inner"；再用 "%Inner" 查字段索引。
pub fn tir_member_base_st(e: i64) string {
    if (base.node_kind((e as u64)) == "member") {
        var bst: string = tir_member_base_st(base.node_na((e as u64)));
        if (str_len(bst) > 0 and bst[0] == '%') {
            var sname: string = str_slice(bst, 1, str_len(bst));
            // P5：packed struct 整体是单宿主整型聚合，成员访问不应退化为 hostst，
            // 否则 tir_member_read 拿不到结构名、无法判定 packed 做 shift/mask，
            // 且 GEP 物理字段类型与 %Name = type { hostst } 冲突。
            if (sema.pk_find_struct(sname) >= 0) { return base.sb_cat2("%", sname); }
            return tir_field_st(sname, base.node_sa((e as u64)));
        }
        return "i64";
    }
    // A-fix：解引用 `*r` 作 member 基底 —— deref 节点的 TD 即「被指类型」
    // （见 tir_emit_deref 注释：「meta_type_of_expr 对 *r 解析为被指类型」），据此还原 `%Struct` 名。
    // ⚠ 此前 deref 基底直接落到末尾 return tir_expr_st(e)，拿不到结构名（退化成 i64）
    // → tir_field_index 查不到结构 → fidx 恒 0；且 ADDR_OF 槽按 i64 分配却被塞入指针
    // → 生成 `getelementptr i64, ptr %x, i32 0`，静默读到字段 0（如 `(*q).y` 实际读到 x）。
    if (base.node_kind((e as u64)) == "deref") {
        var dbtd: i64 = tir_expr_td(e);
        if (dbtd >= 0) {
            var dbn: string = sema.tds[dbtd].name;
            if (sema.find_struct_fields(dbn) >= 0) { return base.sb_cat2("%", dbn); }
        }
        return tir_expr_st(e);
    }
    if (base.node_kind((e as u64)) == "index") {
        // ⚠ 切片/数组/向量下标作 member 基底：`s[i].field` 的基底类型 = 元素类型。
        // 优先用 tir_emit_index_addr 已算好的权威元素类型 g_idx_elem_st（与 slice_at 同源，
        // 绕开索引节点 .td 缓存被污染成 i64 的陷阱 → 否则字段 GEP 落在 field0，写入错位置
        // / 篡改侦测失效）。退化路径再退回 base_td→elem_st / tir_expr_st。
        if (str_len(g_idx_elem_st) > 0 and g_idx_elem_st[0] == '%') { return g_idx_elem_st; }
        var btd: i64 = tir_expr_td(base.node_na((e as u64)));
        if (btd >= 0) {
            var est: string = tir_elem_st(btd);
            if (str_len(est) > 0 and est[0] == '%') { return est; }
        }
        return tir_expr_st(e);
    }
    return tir_expr_st(e);
}
// ══════════════════════════════════════════════════════════════════
// 字段地址（ptr<ST>）：用于 member 读/写
// S4 §0.14.7 SoA（第十七批·na）：原签名 `tir_member_addr(mnode: Node)`。三个调用方传入的
//   mnode 分别来自 `base.nodes[n.na]` / `base.nodes[e]` / `base.nodes[e]`，均可由调用方直接
//   给索引 ⇒ 改收索引 e（第一类：调用方有裸索引）。⚠ 函数体仍读 `mnode.sa`（sa 未外置），
//   故保留本地取值。
pub fn tir_member_addr(e: i64) string {
    var bn: i64 = base.node_na((e as u64));   // member 基底节点；A-fix 下指针接收者会被换成合成 deref
    // A-fix：指针型接收者**单级自动解引用** —— 语义 `ptrVar.field` ≡ `(*ptrVar).field`，
    // 对齐 C 后端 emit_member 的既有约定：「指针型接收者（如 variant arm 的 *TypeMeta 载荷）
    // 须发 `->`」（codegen_c.tc）。此前 TIR 侧缺失此步 → 接收者槽仍是「指针变量的地址」
    // (ptr-to-ptr)，字段查找拿不到结构名 → fidx 恒 0、GEP 基落在 &ptrVar
    // → 静默把指针值本身当字段 0 读出。触发场景：TypeInfo 反射 `Struct(m) => m.field_count`。
    // 守卫：仅在被指对象确为可查字段的结构体时接管，避免误伤其它 ptr 基底。
    var mbn_auto: string = "";   // A-fix：命中自动解引用时的「被指结构体名」（"" = 未命中）
    if (base.node_kind((bn as u64)) != "index" and base.node_kind((bn as u64)) != "deref") {
        var mbtd: i64 = tir_expr_td(bn);
        if (mbtd >= 0 and sema.tds[mbtd].cat == "pointer" and sema.tds[mbtd].elem >= 0) {
            var mbn: string = sema.tds[sema.tds[mbtd].elem].name;
            if (sema.find_struct_fields(mbn) >= 0) { bn = base.mk_deref(bn, -1); mbn_auto = mbn; }
        }
    }
    var base_slot: string = "";
    // G-5：tir_emit_expr 返回的权威结果类型（兜底用）。
    // ⚠ TirEmitRes.st 是**类型码 i64**（tir_st_from_str 的产物），不是字符串 ——
    //   直接按 string 用 str_len/[0] 会恒不命中（第一版就栽在这里，修复看似生效实则没进）。
    var base_res_st: i64 = ST_NONE;
    if (base.node_kind((bn as u64)) == "index") {
        // 切片/数组下标作 member 基底：必须取「元素地址」（tir_emit_index_addr）。
        // 不能走 tir_emit_expr —— 它内部是 index_read，会 load 出元素「值」，
        // 随后 ADDR_OF 把值物化成临时副本再取址，于是 `s[i].f = v` 只改了副本、
        // 且没有 slice_set 写回 → 写入静默丢失。编译器自身因此永远设不上
        // `nodes[d].bc = true`（pub 标记），跨模块可见性恒假 → src/tc.tc 报
        // 17956 条 T-MOD-E008。判据：examples/_slicefield.tc。
        base_slot = tir_emit_index_addr(bn);
    } else {
        var base_slotr: TirEmitRes = tir_emit_expr(bn);
        base_slot = base_slotr.name;
        base_res_st = base_slotr.st;
    }
    var base_st: string = tir_member_base_st(bn);   // 嵌套 member 权威基底类型（字符串路径，绕开 TD 越界回退 i64）
    // ⭐ G-5：member 基底是**间接调用**（被调者为函数值变量，如 `f(3).s`）时，
    //   tir_member_base_st 末尾走 tir_expr_st → meta_type_of_expr 解析不出间接调用的返回类型
    //   ⇒ 退化成 "i64" ⇒ sname="i64" ⇒ tir_field_index 恒 0、GEP/LOAD 全按 i64
    //   ⇒ **恰好读到字段 0（i64）所以「i64 字段正常」，而 string 字段读出空串**
    //   （台账 G-5 原描述正是此现象）；C 后端还会因 `b = (TStr)(t12);` 强转直接 clang 报错。
    //   tir_emit_expr 的 .st 已由 tir_emit_call 按 FuncType TD 的 tdf_ret 修正过，是权威结果
    //   类型 ⇒ 仅当 base_st 拿不到结构名（非 '%' 开头）时用它兜底，零基线扰动。
    if (str_len(base_st) > 0 and base_st[0] != '%') {
        var brs: string = tir_st_to_str(base_res_st);
        if (str_len(brs) > 0 and brs[0] == '%') { base_st = brs; }
    }
    // ⚠ 合成 deref 节点没有 ti（sema 已跑完，新建节点无类型缓存）→ tir_member_base_st 对它取不到
    // 结构名而退化成 "i64"，导致 sname="i64" → fidx 恒 0、GEP 基类型错。此处按已知被指结构名
    // 直接覆盖，绕开对合成节点做类型推断。
    if (str_len(mbn_auto) > 0) { base_st = base.sb_cat2("%", mbn_auto); }
    g_membase_st = base_st;
    var addr: string = tir_tmp();
    // P5 修复（LLVM segfault 139 根因）：packed struct 宿主整型可能 < 8 字节（如 u32 host
    // → %Perm = type { i32 }，4 字节），其 ADDR_OF 临时槽若按值类型(%Perm)分配会被 8 字节指针写穿
    // → 栈破坏 → 运行时段错误。故仅对「packed 结构」把槽类型改指针宽度(ptr<%Perm> → 经 st_to_ll
    // 映射成不透明 ptr，8 字节)；非 packed 结构(≥8 字节，编译器自身成员访问均属此类)保持原行为不变，
    // 避免动到编译器自身的成员访问（否则会破坏自举链：g2 编译 g3 时原生段错误）。
    var addr_st: string = base_st;
    if (sema.pk_find_struct(tir_strip_pct(base_st)) >= 0) { addr_st = base.sb_cat3("ptr<", base_st, ">"); }
    tir_emit(TIRInst{ op: TIR_OP_ADDR_OF, st: tir_st_from_str(addr_st), dst: tir_op(addr), args: tir_a1(base_slot), is_comment: false, line: g_cur_line, cmt: "" });
    var sname: string = tir_strip_pct(base_st);
    var fidx: i64 = tir_field_index(sname, base.node_sa((e as u64)));
    var fldst: string = tir_field_st(sname, base.node_sa((e as u64)));
    var faddr: string = tir_tmp();
    // ⚠ 结构体字段 GEP 必须带前导 i32 0（索引「结构体数组第 0 个」），再接字段下标：
    // `getelementptr %S, ptr %base, i32 0, i32 <fidx>`。若只给单下标 `i32 <fidx>` 会被 LLVM 当作
    // 「结构体数组第 <fidx> 个元素」→ 越界读到结构体之外的垃圾地址（单字段结构 field0 因偏移 0 巧合正确，
    // 多字段结构 field1+ 必然读错 / 段错误）。闭包 GEP 自己已带前导 0，不受影响。
    tir_emit(TIRInst{ op: TIR_OP_GEP, st: tir_st_from_str(fldst), dst: tir_op(faddr), args: tir_a3(addr, "0", base.i2s(fidx)), is_comment: false, line: g_cur_line, cmt: "" });
    return faddr;
}

// 2^n（i64，n < 63），用于 flag 槽位掩码计算（与 emit-ll flag_get 同一公式）。
pub fn tir_pow2_i64(n: i64) i64 {
    var r: i64 = 1;
    var i: i64 = 0;
    while (i < n) { r = r * 2; i = i + 1; }
    return r;
}

pub fn tir_member_read(e: i64) TirEmitRes {
    // 枚举用例常量：Color.Red → const.i64 <val>（枚举被擦除为整数，用例值即编译期整型）。
    // 此前误走结构体字段路径（addr_of @Color + gep + load），把类型名当值，生成非法 `store ptr Color`。
    // 检测：基为类型名 ident 且 `Enum.Case` 命中枚举常量表；struct 字段访问不在枚举表中，安全回退。
    if (base.node_kind((base.node_na((e as u64)) as u64)) == "ident") {
        var cvnode: i64 = sema.enum_const_lookup(base.node_sa((base.node_na((e as u64)) as u64)), base.node_sa((e as u64)));
        if (cvnode >= 0) {
            var cval: i64 = sema.js_parse_int(base.node_sa((cvnode as u64)), base.node_ia((cvnode as u64)));
            var d: string = tir_tmp();
            tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str("i64"), dst: tir_op(d), args: tir_a1(base.i2s(cval)), is_comment: false, line: g_cur_line, cmt: "" });
            return TirEmitRes{ name: d, st: tir_st_from_str(tir_expr_st(e)) };
        }
    }
    var faddr: string = tir_member_addr(e);
    var base_st: string = g_membase_st;   // 用 tir_member_addr 写回的权威基底类型（嵌套 member 正确）
    var sname: string = tir_strip_pct(base_st);
    var fldst: string = tir_field_st(sname, base.node_sa((e as u64)));
    var ld: string = tir_tmp();
    tir_emit(TIRInst{ op: TIR_OP_LOAD, st: tir_st_from_str(fldst), dst: tir_op(ld), args: tir_a1(tir_os(faddr, tir_st_from_str(base.sb_cat3("ptr<", fldst, ">")))), is_comment: false, line: g_cur_line, cmt: "" });
    // P5：packed struct 字段值访问 → 宿主整型 shift/mask 抽取。
    var pk: i64 = sema.pk_find_struct(sname);
    if (pk >= 0) {
        var sl: i64 = sema.pk_find_slot(sname, base.node_sa((e as u64)));
        if (sl >= 0) {
            var startv: i64 = sema.pk_slot_starts[sl];
            var lenv: i64 = sema.pk_slot_lens[sl];
            var hostst: string = sema.pk_host_st(sema.pk_struct_under[pk]);
            // shr = ld >> start（lshr：无符号零填充右移，正合位域抽取）
            var shr: string = tir_tmp();
            tir_emit(TIRInst{ op: TIR_OP_LSHR, st: tir_st_from_str(hostst), dst: tir_op(shr), args: tir_a2(ld, base.i2s(startv)), is_comment: false, line: g_cur_line, cmt: "" });
            // mask = (2^len - 1)（低 len 位）；shift 已把字段落到 bit0，故直接 & 不左移。
            var mv: i64; if (lenv < 64) { mv = tir_pow2_i64(lenv) - 1; } else { mv = -1; }
            var mc: string = tir_tmp();
            tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str(hostst), dst: tir_op(mc), args: tir_a1(base.i2s(mv)), is_comment: false, line: g_cur_line, cmt: "" });
            // and
            var ar: string = tir_tmp();
            tir_emit(TIRInst{ op: TIR_OP_AND, st: tir_st_from_str(hostst), dst: tir_op(ar), args: tir_a2(shr, mc), is_comment: false, line: g_cur_line, cmt: "" });
            return TirEmitRes{ name: ar, st: tir_st_from_str(hostst) };
        }
    }
    return TirEmitRes{ name: ld, st: tir_st_from_str(fldst) };
}

// ══════════════════════════════════════════════════════════════════
// 下标访问（Stage 2）：a[i] 读 / a[i] = v 写
// ══════════════════════════════════════════════════════════════════

// 计算下标元素地址（ptr<elem_st>），写回 g_idx_elem_st。不支持的基类型降级为注释。
pub fn tir_sizeof(st: string) i64 {
    // 变体等 ABI 形态为 ptr<%V>，但值布局是 %V（8(tag)+mx 字节）：统一剥离 ptr< > 取内层，
    // 否则 tir_sizeof("ptr<%Shape>") 回落 8 → []Variant 切片 elem_size=8、步长错 → 段错误。
    if (str_len(st) >= 6 and str_slice(st, 0, 4) == "ptr<" and st[str_len(st) - 1] == 62) {
        st = str_slice(st, 4, str_len(st) - 1);
    }
    if (st == "i64" or st == "u64" or st == "f64") { return 8; }
    if (st == "i32" or st == "u32" or st == "f32") { return 4; }
    if (st == "i16" or st == "u16") { return 2; }
    if (st == "i8" or st == "u8" or st == "bool") { return 1; }
    if (st == "%TStr") { return 16; }
    if (st == "%TSlice") { return 32; }
    // 具名结构体：按字段 ST 求和 + 8 字节收尾对齐（字段均为 8 字节对齐的 t 布局）。
    // 若兜底 8，则 []Struct 的 elem_size 恒为 8 → append 步长错 → 读元素错位 → 段错误。
    if (str_len(st) >= 1 and st[0] == 37) {
        var i: i64 = 0;
        var n: i64 = slice_len(g_ssz_name) as i64;
        while (i < n) {
            if (g_ssz_name[i] == st) {
                if (g_ssz_depth >= 4) { return 8; }
                g_ssz_depth = g_ssz_depth + 1;
                var tot: i64 = 0;
                var fs: []string = g_ssz_fields[i];
                var j: i64 = 0;
                var m: i64 = slice_len(fs) as i64;
                while (j < m) { tot = tot + tir_sizeof(fs[j]); j = j + 1; }
                g_ssz_depth = g_ssz_depth - 1;
                if (tot <= 8) { return tot; }
                return tir_round8(tot);
            }
            i = i + 1;
        }
    }
    // 变体：降准时已捕获真实尺寸 8 + mx（与 %V 类型体 { i64, [mx x i8] } 字节对齐一致）。
    // ⚠ 不可走下方兜底 8：否则 []Variant 切片 elem_size=8、步长错 → 元素错位 → 段错误
    //    （shapes.tc 即此坑：%Shape={i64,[16 x i8]} 实为 24 字节，却被当作 8 字节步长寻址）。
    if (str_len(st) >= 1 and st[0] == 37) {
        var vnm: string = str_slice(st, 1, str_len(st) as i64);
        var vi: i64 = 0;
        var vn: i64 = slice_len(g_var_names) as i64;
        while (vi < vn) {
            if (g_var_names[vi] == vnm) { return g_var_sizes[vi]; }
            vi = vi + 1;
        }
    }
    return 8;
}

pub fn tir_emit_map_lit(e: i64, force_td: i64) TirEmitRes {
    var td: i64 = force_td;
    if (td < 0) { td = tir_expr_td(e); }
    if (td < 0) {
        tir_cmt("unsupported expr: map_lit (untyped)");
        var z: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str("i64"), dst: tir_op(z), args: tir_a1("0"), is_comment: false, line: g_cur_line, cmt: "" });
        return TirEmitRes{ name: z, st: tir_st_from_str(tir_expr_st(e)) };
    }
    var mt: TD = sema.tds[td];
    var valtd: i64 = mt.val;
    // ⚠ 放宽「聚合值」限制：tll_map_put(ptr, ptr, ptr) 按 val_size 字节指针拷贝，
    //   字符串/具名/结构/切片/数组值均可通过 addr_of + sizeof 正确落库（与 emit-ll 的 ll_build_map_lit 对齐）。
    //   嵌套 map 值现支持：map 的 val 即内层 map 句柄(ptr<void>, 8B)，构造期递归 emit 内层字面量，
    //   外层 tll_map_put 按 8B 把句柄指针拷贝入库（见下方 entry 循环 map_val 分支）。
    var keykind: i64 = 1;
    if (sema.tds[mt.key].cat == "string") { keykind = 0; }
    var valst: string = tir_st_of_td(valtd);
    var valsz: i64 = tir_sizeof(valst);
    var kk: string = tir_tmp();
    tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str("i64"), dst: tir_op(kk), args: tir_a1(base.i2s(keykind)), is_comment: false, line: g_cur_line, cmt: "" });
    var vsz: string = tir_tmp();
    tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str("i64"), dst: tir_op(vsz), args: tir_a1(base.i2s(valsz)), is_comment: false, line: g_cur_line, cmt: "" });
    var m: string = tir_tmp();
    tir_emit(TIRInst{ op: TIR_OP_SLOT, st: tir_st_from_str("ptr<void>"), dst: tir_op(m), args: tir_a0(), is_comment: false, line: g_cur_line, cmt: m });
    tir_emit(TIRInst{ op: TIR_OP_CALL, st: tir_st_from_str("ptr<void>"), dst: tir_op(m), args: tir_a3("@tll_map_new", kk, vsz), is_comment: false, line: g_cur_line, cmt: "" });
    var ec: i64 = base.node_la((e as u64));
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
    var ec_ks: []i64 = base.kids_chain(ec);
    var ec_ki: i64 = 0;
    while (ec_ki < slice_len(ec_ks) as i64) {
        var ec_kv: i64 = ec_ks[ec_ki];
        var ksr: TirEmitRes = tir_emit_expr(base.node_na((ec_kv as u64))); var ks: string = ksr.name;
        var kst: string = tir_expr_st(base.node_na((ec_kv as u64)));
        var kc: string = ks;
        if (kst != "i64" and sema.tds[mt.key].cat != "string") { kc = tir_tmp(); tir_emit(TIRInst{ op: TIR_OP_ZEXT, st: tir_st_from_str("i64"), dst: tir_op(kc), args: tir_a1(ks), is_comment: false, line: g_cur_line, cmt: "" }); }
        var kp: string = tir_tmp();
        if (sema.tds[mt.key].cat == "string") {
            tir_emit(TIRInst{ op: TIR_OP_ADDR_OF, st: tir_st_from_str("%TStr"), dst: tir_op(kp), args: tir_a1(ks), is_comment: false, line: g_cur_line, cmt: "" });
        } else {
            tir_emit(TIRInst{ op: TIR_OP_ADDR_OF, st: tir_st_from_str("ptr<i64>"), dst: tir_op(kp), args: tir_a1(kc), is_comment: false, line: g_cur_line, cmt: "" });
        }
        var vsr: TirEmitRes;
        if (valtd >= 0 and sema.tds[valtd].cat == "map" and base.node_kind((base.node_nb((ec_kv as u64)) as u64)) == "map_lit") {
            // 嵌套 map 值：递归构造内层字面量（force_td=valtd 提供内层类型上下文），返回内层句柄。
            vsr = tir_emit_map_lit(base.node_nb((ec_kv as u64)), valtd);
        } else {
            vsr = tir_emit_expr(base.node_nb((ec_kv as u64)));
        }
        var vs: string = vsr.name;
        var vp: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_ADDR_OF, st: tir_st_from_str(valst), dst: tir_op(vp), args: tir_a1(vs), is_comment: false, line: g_cur_line, cmt: "" });
        tir_emit(TIRInst{ op: TIR_OP_CALL, st: tir_st_from_str("void"), dst: tir_op(""), args: tir_a4("@tll_map_put", m, kp, vp), is_comment: false, line: g_cur_line, cmt: "" });
        ec_ki = ec_ki + 1;
    }
    return TirEmitRes{ name: m, st: tir_st_from_str(tir_expr_st(e)) };
}

pub fn tir_emit_index_addr(ine: i64) string {
    g_idx_is_value = false;   // 默认返回地址；str_at 分支内改为 true（见下）
    var base_td: i64 = tir_expr_td(base.node_na((ine as u64)));
    // ⚠ member 基底（如 c.opts[k]）：tir_expr_td 对 member 节点不可靠（node.td 缓存易污染 /
    //   历史无 member 分支），会返回 i64 等错类型，导致下方 map 分支永不进入、索引读恒为 0。
    // 故此处用「结构体基底类型 + 字段名」强制查字段 TD 校正（与 tir_field_td 同构）。
    if (base.node_kind((base.node_na((ine as u64)) as u64)) == "member") {
        var mbtd: i64 = tir_expr_td(base.node_na((base.node_na((ine as u64)) as u64)));
        if (mbtd >= 0) {
            var mbst: string = tir_st_of_td(mbtd);
            // ⚠ A-fix 0c（TypeInfo 载荷切片索引）：指针接收者的 st 形如 "ptr<%TypeMeta>"，
            // 不以 '%' 开头 ⇒ 原校正整段被跳过 ⇒ 只能退回 `tir_expr_td(m.fields)`，而该函数
            // 对 member 节点本就不可靠（同上注）⇒ base_td 落到 i64/unknown ⇒ 末尾走 else 分支
            // 返回**常量 0 当元素地址**，再 `load` 出来 ⇒ `m.fields[0].name` 静默得到空串、
            // `.offset` 得到 0，**不报错**（最危险的失败形态）。触发场景：
            // `match (ti) { Struct(m) => m.fields[0].name … }`——载荷 m 的类型正是 *TypeMeta。
            // 故先剥一层 "ptr<…>" 再做结构名判定（与 tir_member_addr 的指针自动解引用同构）。
            if (str_len(mbst) > 4 and str_slice(mbst, 0, 4) == "ptr<") {
                mbst = str_slice(mbst, 4, str_len(mbst) - 1);
            }
            if (str_len(mbst) > 0 and mbst[0] == '%') {
                var ftd: i64 = tir_field_td(str_slice(mbst, 1, str_len(mbst)), base.node_sa((base.node_na((ine as u64)) as u64)));
                if (ftd >= 0) { base_td = ftd; }
            }
        }
    }
    if (base_td < 0) {
        tir_cmt("unsupported index base (untyped)");
        var z: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str("i64"), dst: tir_op(z), args: tir_a1("0"), is_comment: false, line: g_cur_line, cmt: "" });
        g_idx_elem_st = "i64";
        return z;
    }
    var base_st: string = tir_st_of_td(base_td);
    var base_slotr: TirEmitRes = tir_emit_expr(base.node_na((ine as u64))); var base_slot: string = base_slotr.name;
    var idxr: TirEmitRes = tir_emit_expr(base.node_nb((ine as u64))); var idx: string = idxr.name;
    g_idx_elem_st = tir_elem_st(base_td);
    var dptr: string = base_slot;
    if (base_st == "%TSlice") {
        // 切片下标：tll_slice_at(ptr <切片结构地址>, i64 <下标>) 返回元素地址（与旧轨 codegen_ll 逐字一致）。
        // ⚠ 必须传「切片结构地址」(base_slot 即 alloca %TSlice，本就是地址)，绝不可 load 出 %TSlice 值当 ptr 传。
        // 旧手写 gep ptr<void> 取出 .data 字段的方式在 TIR 结构化路径下会退化成「把结构当 i64 数组读」，故改用内建调用。
        g_idx_is_value = false;
        var eptr: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_SLICE_AT, st: ST_NONE, dst: tir_op(eptr), args: tir_a2(base_slot, idx), is_comment: false, line: g_cur_line, cmt: "" });
        return eptr;
    } else if (base_st == "%TStr") {
        // 字符串下标：tll_str_at(ptr <结构地址>, i64 <下标>) 直接返回字节值(i64)，不可再 load。
        g_idx_is_value = true;
        g_idx_elem_st = "i64";
        var eptr: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_STR_AT, st: ST_NONE, dst: tir_op(eptr), args: tir_a2(base_slot, idx), is_comment: false, line: g_cur_line, cmt: "" });
        return eptr;
    } else if (str_len(base_st) >= 4 and str_slice(base_st, 0, 4) == "arr<") {
        dptr = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_ADDR_OF, st: tir_st_from_str(base_st), dst: tir_op(dptr), args: tir_a1(base_slot), is_comment: false, line: g_cur_line, cmt: "" });
    } else if (str_len(base_st) >= 4 and str_slice(base_st, 0, 4) == "vec<") {
        dptr = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_ADDR_OF, st: tir_st_from_str(base_st), dst: tir_op(dptr), args: tir_a1(base_slot), is_comment: false, line: g_cur_line, cmt: "" });
    } else if (sema.tds[base_td].cat == "map") {
        var mt: TD = sema.tds[base_td];
        // ⚠ map 变量是「句柄存于 slot 内」的聚合：base_slot 是 slot 地址(ptr*)，
        // 须 load 出真正的 TMap* 句柄再传给 tll_map_val_ptr
        // （与 map_get builtin 里 ll_load(toks[4], "ptr") 同构；否则 tll_map_val_ptr 收到
        // 的是 slot 地址而非句柄，查表错乱 → 索引读恒返回 0）。
        // ⚠ 容器句柄来源的统一规则（取决于 tir_emit_expr 对各类基底返回的是 slot 还是值）：
        //   - ident 局部 map 变量：tir_emit_expr 返回 slot（alloca），须 load 取出句柄；
        //   - member 结构体字段 / call 返回值 / index·deref 嵌套 map：tir_emit_expr 已返回「句柄值」，
        //     直接作为容器句柄传给 tll_map_val_ptr；若再 load 会双重解引用 → 段错误 / 读错容器。
        // （旧注释称 ident/member 均返回 slot 是错误的：tir_member_read 末段 `load fldst` 已取回字段值。）
        var bkind: string = base.node_kind((base.node_na((ine as u64)) as u64));
        var mhp: string;
        if (bkind == "ident") {
            mhp = tir_tmp();
            tir_emit(TIRInst{ op: TIR_OP_LOAD, st: tir_st_from_str("ptr"), dst: tir_op(mhp), args: tir_a1(base_slot), is_comment: false, line: g_cur_line, cmt: "" });
        } else {
            mhp = base_slot;
        }
        var valtd: i64 = mt.val;
        var valst: string = tir_st_of_td(valtd);
        // 聚合值（string/named/struct/array/slice）与标量同构：runtime 按 val_size 字节
        // 把值 memcpy 进 arena，@tll_map_val_ptr 返回其字节首地址；下游 load <valst> 即取回
        // 该聚合值。故不再拒绝聚合值，统一走下方的 @tll_map_val_ptr 路径（与 for-in 双变量
        // @tll_map_val_at 一致）。嵌套 map 值（递归构造）仍交由 map_lit 处拒绝。
        g_idx_elem_st = valst;
        var ksr: TirEmitRes = tir_emit_expr(base.node_nb((ine as u64))); var ks: string = ksr.name;
        var kst: string = tir_expr_st(base.node_nb((ine as u64)));
        var kc: string = ks;
        if (kst != "i64" and sema.tds[mt.key].cat != "string") { kc = tir_tmp(); tir_emit(TIRInst{ op: TIR_OP_ZEXT, st: tir_st_from_str("i64"), dst: tir_op(kc), args: tir_a1(ks), is_comment: false, line: g_cur_line, cmt: "" }); }
        var kp: string = tir_tmp();
        if (sema.tds[mt.key].cat == "string") {
            tir_emit(TIRInst{ op: TIR_OP_ADDR_OF, st: tir_st_from_str("%TStr"), dst: tir_op(kp), args: tir_a1(ks), is_comment: false, line: g_cur_line, cmt: "" });
        } else {
            tir_emit(TIRInst{ op: TIR_OP_ADDR_OF, st: tir_st_from_str("ptr<i64>"), dst: tir_op(kp), args: tir_a1(kc), is_comment: false, line: g_cur_line, cmt: "" });
        }
        var vp: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_CALL, st: tir_st_from_str("ptr<void>"), dst: tir_op(vp), args: tir_a3("@tll_map_val_ptr", mhp, kp), is_comment: false, line: g_cur_line, cmt: "" });
        return vp;
    } else {
        tir_cmt(base.sb_cat3("unsupported index base: ", base_st, ""));
        var z: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str("i64"), dst: tir_op(z), args: tir_a1("0"), is_comment: false, line: g_cur_line, cmt: "" });
        g_idx_elem_st = "i64";
        return z;
    }
    var eptr: string = tir_tmp();
    tir_emit(TIRInst{ op: TIR_OP_GEP_IDX, st: tir_st_from_str(g_idx_elem_st), dst: tir_op(eptr), args: tir_a2(dptr, idx), is_comment: false, line: g_cur_line, cmt: "" });
    return eptr;
}

pub fn tir_emit_index_read(e: i64) TirEmitRes {
    var eptr: string = tir_emit_index_addr(e);
    if (g_idx_is_value) {
        // str_at：eptr 已是 i64 字节值，read 直接返回，无需 load。
        return TirEmitRes{ name: eptr, st: tir_st_from_str(g_idx_elem_st) };
    }
    var ld: string = tir_tmp();
    tir_emit(TIRInst{ op: TIR_OP_LOAD, st: tir_st_from_str(g_idx_elem_st), dst: tir_op(ld), args: tir_a1(tir_os(eptr, tir_st_from_str(base.sb_cat3("ptr<", g_idx_elem_st, ">")))), is_comment: false, line: g_cur_line, cmt: "" });
    return TirEmitRes{ name: ld, st: tir_st_from_str(g_idx_elem_st) };
}

// ══════════════════════════════════════════════════════════════════
// match 降级（Stage 2）：字面量 / 枚举·变体构造器 / 绑定 / _ / when 守卫
// ══════════════════════════════════════════════════════════════════

// 单臂模式条件（布尔 slot）；不支持的模式返回 ""（调用方降级为注释并跳过该臂）。
// S4 §0.14.7 SoA（第十七批·na）：原签名 `tir_match_pattern_cond(arm: Node, ...)`。唯一调用方
//   `tir_emit_match` 传入的 `arm` 与 `base.nodes[armIds[i]]` **恒等**，且宿主手里就有裸索引
//   `armIds[i]` ⇒ 改收索引 armId（第一类）。函数体只用 arm.na，故全部改侧表访问器。
pub fn tir_match_pattern_cond(armId: i64, scr: string, scr_base: string, scr_st: string, scr_td: i64, scr_vname: string) string {
    // ── 字面量模式 ──
    if (base.node_kind((base.node_na((armId as u64)) as u64)) == "int" or base.node_kind((base.node_na((armId as u64)) as u64)) == "float" or base.node_kind((base.node_na((armId as u64)) as u64)) == "bool" or base.node_kind((base.node_na((armId as u64)) as u64)) == "char" or base.node_kind((base.node_na((armId as u64)) as u64)) == "null" or base.node_kind((base.node_na((armId as u64)) as u64)) == "opt_none") {
        var pvr: TirEmitRes = tir_emit_expr(base.node_na((armId as u64))); var pv: string = pvr.name;
        var cond: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_EQ, st: tir_st_from_str(scr_st), dst: tir_op(cond), args: tir_a2(scr, pv), is_comment: false, line: g_cur_line, cmt: "" });
        return cond;
    }
    // ── 原子字面量模式：u64 相等 ──
    if (base.node_kind((base.node_na((armId as u64)) as u64)) == "atom") {
        var aid: i64 = base.node_ia((base.node_na((armId as u64)) as u64));
        if (aid <= 0) { aid = sema.atom_intern(base.node_sa((base.node_na((armId as u64)) as u64))); }
        var pv: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str("u64"), dst: tir_op(pv), args: tir_a1(base.i2s(aid)), is_comment: false, line: g_cur_line, cmt: "" });
        var cond: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_EQ, st: tir_st_from_str("u64"), dst: tir_op(cond), args: tir_a2(scr, pv), is_comment: false, line: g_cur_line, cmt: "" });
        return cond;
    }
    // ── 字符串字面量模式：tll_str_eq != 0（runtime 返回 1=相等，与旧轨 icmp ne t0,0 一致） ──
    // ⚠ tll_str_eq 接受 TStr*（即 %TStr 的地址）。scr 与字面量槽都是 %TStr 指针，须直接传入，
    // 不可取 data 指针（gep ... 0）——否则运行期把 data 指针当 TStr* 解引用读垃圾 → 恒匹配首臂。
    if (base.node_kind((base.node_na((armId as u64)) as u64)) == "string") {
        var pvslotr: TirEmitRes = tir_emit_expr(base.node_na((armId as u64))); var pvslot: string = pvslotr.name;
        var cmp: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_CALL, st: tir_st_from_str("i32"), dst: tir_op(cmp), args: tir_a3("@tll_str_eq", scr, pvslot), is_comment: false, line: g_cur_line, cmt: "" });
        var cond: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_NE, st: tir_st_from_str("i32"), dst: tir_op(cond), args: tir_a2(cmp, "0"), is_comment: false, line: g_cur_line, cmt: "" });
        return cond;
    }
    // ── 范围模式（1..=5 / 6.. / ..5）：LLVM 轨此前漏发此分支（C 轨 match_chain_from
    // 早有 mk_range_test），导致 range 臂条件返回 "" → 整臂被降级为终极端、永不命中，
    // 落到首臂或兜底。此处镜像 C 轨语义合成区间成员测试。
    if (base.node_kind((base.node_na((armId as u64)) as u64)) == "range") {
        var rcond: string = "";
        if (base.node_na((base.node_na((armId as u64)) as u64)) >= 0) {
            var lov: TirEmitRes = tir_emit_expr(base.node_na((base.node_na((armId as u64)) as u64)));
            var loc: string = tir_tmp();
            tir_emit(TIRInst{ op: TIR_OP_SGE, st: tir_st_from_str(scr_st), dst: tir_op(loc), args: tir_a2(scr, lov.name), is_comment: false, line: g_cur_line, cmt: "" });
            rcond = loc;
        }
        if (base.node_nb((base.node_na((armId as u64)) as u64)) >= 0) {
            var hiv: TirEmitRes = tir_emit_expr(base.node_nb((base.node_na((armId as u64)) as u64)));
            var hic: string = tir_tmp();
            if (base.node_ba((base.node_na((armId as u64)) as u64)) == true) {
                tir_emit(TIRInst{ op: TIR_OP_SLE, st: tir_st_from_str(scr_st), dst: tir_op(hic), args: tir_a2(scr, hiv.name), is_comment: false, line: g_cur_line, cmt: "" });
            } else {
                tir_emit(TIRInst{ op: TIR_OP_SLT, st: tir_st_from_str(scr_st), dst: tir_op(hic), args: tir_a2(scr, hiv.name), is_comment: false, line: g_cur_line, cmt: "" });
            }
            if (rcond == "") { rcond = hic; }
            else {
                var comb: string = tir_tmp();
                // 比较结果恒为 i1（tir_to_ll 比较分支硬编码 i1），故内部 AND 也用 i1，
                // 与 br_cond 同型；外部 when 守卫的 AND（tir_emit_match:4618，st=i8）会按需 zext 合并。
                tir_emit(TIRInst{ op: TIR_OP_AND, st: tir_st_from_str("i1"), dst: tir_op(comb), args: tir_a2(rcond, hic), is_comment: false, line: g_cur_line, cmt: "" });
                rcond = comb;
            }
        }
        // 两端全省（..）的 range 臂已在 sema 置 ba=true 等价 `_`，不会走到这里；
        // 保险起见仍为恒真，避免条件链塌陷。
        if (rcond == "") { rcond = "1"; }
        return rcond;
    }
    // ── 切片模式（S6）：[]T 的 `[a,b]` / `[]` / `[first,..,last]` / `[a,..]` / `[..,last]` / `[..]` ──
    if (base.node_kind((base.node_na((armId as u64)) as u64)) == "slice_pat") {
        var sp_na: i64 = base.node_na((base.node_na((armId as u64)) as u64));     // rest 位置（-1 无）
        var sp_nb: i64 = base.node_nb((base.node_na((armId as u64)) as u64));     // 元素总数（含 rest 占位）
        var elem_td: i64 = -1;
        if (scr_td >= 0 and sema.tds[scr_td].cat == "slice") { elem_td = sema.tds[scr_td].elem; }
        var elem_st: string = tir_st_of_td(elem_td);
        // 长度：@slice_len(scr)
        var len_t: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_CALL, st: tir_st_from_str("i64"), dst: tir_op(len_t), args: tir_a2("@slice_len", scr), is_comment: false, line: g_cur_line, cmt: "" });
        var want: i64;
        if (sp_na < 0) { want = sp_nb; } else { want = sp_nb - 1; }
        var lc: string = tir_tmp();
        if (sp_na < 0) {
            tir_emit(TIRInst{ op: TIR_OP_EQ, st: tir_st_from_str("i64"), dst: tir_op(lc), args: tir_a2(len_t, base.i2s(want)), is_comment: false, line: g_cur_line, cmt: "" });
        } else {
            tir_emit(TIRInst{ op: TIR_OP_SGE, st: tir_st_from_str("i64"), dst: tir_op(lc), args: tir_a2(len_t, base.i2s(want)), is_comment: false, line: g_cur_line, cmt: "" });
        }
        var rcond: string = lc;
        // 元素：字面量元素做等值比较；绑定/`_` 不比较（绑定在 body 提取）。
        var sp_e: i64 = base.node_la((base.node_na((armId as u64)) as u64));
        var pos: i64 = 0;
        // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
        var sp_e_ks: []i64 = base.kids_chain(sp_e);
        var sp_e_ki: i64 = 0;
        while (sp_e_ki < slice_len(sp_e_ks) as i64) {
            var sp_e_kv: i64 = sp_e_ks[sp_e_ki];
            if (base.node_kind((sp_e_kv as u64)) != "rest" and base.node_kind((sp_e_kv as u64)) != "ident") {
                var idxv: string;
                if (sp_na < 0 or pos < sp_na) {
                    idxv = base.i2s(pos);
                } else {
                    var off: string = tir_tmp();
                    tir_emit(TIRInst{ op: TIR_OP_SUB, st: tir_st_from_str("i64"), dst: tir_op(off), args: tir_a2(len_t, base.i2s(sp_nb - pos)), is_comment: false, line: g_cur_line, cmt: "" });
                    idxv = off;
                }
                var eptr: string = tir_tmp();
                tir_emit(TIRInst{ op: TIR_OP_SLICE_AT, st: ST_NONE, dst: tir_op(eptr), args: tir_a2(scr, idxv), is_comment: false, line: g_cur_line, cmt: "" });
                var ev: string = tir_tmp();
                if (elem_st == "%TStr") {
                    tir_emit(TIRInst{ op: TIR_OP_LOAD, st: tir_st_from_str("%TStr"), dst: tir_op(ev), args: tir_a1(tir_os(eptr, tir_st_from_str("%TStr"))), is_comment: false, line: g_cur_line, cmt: "" });
                    var cmp: string = tir_tmp();
                    tir_emit(TIRInst{ op: TIR_OP_CALL, st: tir_st_from_str("i32"), dst: tir_op(cmp), args: tir_a3("@tll_str_eq", ev, tir_emit_expr(sp_e_kv).name), is_comment: false, line: g_cur_line, cmt: "" });
                    var ec: string = tir_tmp();
                    tir_emit(TIRInst{ op: TIR_OP_NE, st: tir_st_from_str("i32"), dst: tir_op(ec), args: tir_a2(cmp, "0"), is_comment: false, line: g_cur_line, cmt: "" });
                    if (rcond == "") { rcond = ec; } else { var comb: string = tir_tmp(); tir_emit(TIRInst{ op: TIR_OP_AND, st: tir_st_from_str("i1"), dst: tir_op(comb), args: tir_a2(rcond, ec), is_comment: false, line: g_cur_line, cmt: "" }); rcond = comb; }
                } else {
                    tir_emit(TIRInst{ op: TIR_OP_LOAD, st: tir_st_from_str(elem_st), dst: tir_op(ev), args: tir_a1(tir_os(eptr, tir_st_from_str(base.sb_cat3("ptr<", elem_st, ">")))), is_comment: false, line: g_cur_line, cmt: "" });
                    var pv: string = tir_emit_expr(sp_e_kv).name;
                    var ec: string = tir_tmp();
                    tir_emit(TIRInst{ op: TIR_OP_EQ, st: tir_st_from_str(elem_st), dst: tir_op(ec), args: tir_a2(ev, pv), is_comment: false, line: g_cur_line, cmt: "" });
                    if (rcond == "") { rcond = ec; } else { var comb: string = tir_tmp(); tir_emit(TIRInst{ op: TIR_OP_AND, st: tir_st_from_str("i1"), dst: tir_op(comb), args: tir_a2(rcond, ec), is_comment: false, line: g_cur_line, cmt: "" }); rcond = comb; }
                }
            }
            pos = pos + 1;
            sp_e_ki = sp_e_ki + 1;
        }
        if (rcond == "") { rcond = "1"; }
        return rcond;
    }
    // ── 结构体 / 元组字面量模式（KI-002 修复）：逐字段相等比较 ──
    // 对齐 C 后端 match_chain_from 的 struct_lit 分支（per-field `sname.field == literal` 的 AND 链）。
    // 命名结构（p.sa 非空）直接用 p.sa；匿名元组（p.sa 空）由 scrutinee 的 TD 名反查合成结构名。
    // 取址 / GEP / LOAD 复用 tir_member_addr 的权威配方（ADDR_OF 结构值 → GEP 前导 0 + 字段下标 → LOAD）。
    if (base.node_kind((base.node_na((armId as u64)) as u64)) == "struct_lit") {
        var sname: string = base.node_sa((base.node_na((armId as u64)) as u64));
        if (sname == "" and scr_td >= 0 and scr_td < slice_len(sema.tds) as i64) {
            sname = sema.tds[scr_td].name;
        }
        if (sname != "") {
            var sbase: string = tir_strip_pct(sname);
            var sptr: string = tir_tmp();
            // ⚠ ADDR_OF 的 st 必须带 `%` 前缀（ptr<%Pt>）：tir_to_ll 的 ADDR_OF 直传指针分支
            // 要求 `ll_starts(st, "%")` 成立，否则 GEP 基类型退化成无 `%` 的 `Pt` →
            // LLVM "expected type" 报错。对齐 tir_member_addr（其 base_st 即 ptr<%…>）。
            tir_emit(TIRInst{ op: TIR_OP_ADDR_OF, st: tir_st_from_str(base.sb_cat3("ptr<%", sbase, ">")), dst: tir_op(sptr), args: tir_a1(scr), is_comment: false, line: g_cur_line, cmt: "" });
        var cond: string = "";
        var sl_pos: i64 = 0;   // 位置式（sa==""）字段按列表下标映射
        var fvp: i64 = base.node_la((base.node_na((armId as u64)) as u64));
        // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
        var fvp_ks: []i64 = base.kids_chain(fvp);
        var fvp_ki: i64 = 0;
        while (fvp_ki < slice_len(fvp_ks) as i64) {
            var fvp_kv: i64 = fvp_ks[fvp_ki];
            var fname: string = base.node_sa((fvp_kv as u64));
            var eff: string = fname;
            if (fname == "") { eff = sema.struct_field_name_at(sname, sl_pos); sl_pos = sl_pos + 1; }
            var fval_node: i64 = base.node_na((fvp_kv as u64));
            // 绑定字段（ident，含 _ 通配）：不参与比较条件，仅在命中臂的 body 内提取。
            // 跳过以免把绑定标识符当字面量整体发射比较（静默错编）。
            if (fval_node >= 0 and base.node_kind((fval_node as u64)) == "ident") {
                fvp_ki = fvp_ki + 1;
                continue;
            }
            // ── 谓词模式（fault B2 / 节点 N6）──────────────────────────────
            // 字段值是 `binary(op, member(scr, f), v)`：整段求值即得 i1 条件。
            // ⚠ 与下方字面量路径的区别：字面量走 `GEP+LOAD+EQ`（比较字段值 vs 常量），
            //   谓词走 `tir_emit_expr`（比较字段值 vs **表达式**，op 不限于 ==）。
            //   ⇒ 若此处不改，谓词会被当成字面量发射 `EQ(load(GEP), binary(...))` ⇒ 静默错编。
            if (fval_node >= 0 and base.node_kind((fval_node as u64)) == "binary" and
                parse.pat_is_relop_text(base.node_sa((fval_node as u64)))) {
                var pc: string = tir_emit_expr(fval_node).name;
                if (cond == "") {
                    cond = pc;
                } else {
                    var pcc: string = tir_tmp();
                    tir_emit(TIRInst{ op: TIR_OP_AND, st: tir_st_from_str("i1"), dst: tir_op(pcc), args: tir_a2(cond, pc), is_comment: false, line: g_cur_line, cmt: "" });
                    cond = pcc;
                }
                fvp_ki = fvp_ki + 1;
                continue;
            }
            var fidx: i64 = tir_field_index(sname, eff);
            var fst: string = tir_field_st(sname, eff);
            var faddr: string = tir_tmp();
            tir_emit(TIRInst{ op: TIR_OP_GEP, st: tir_st_from_str(fst), dst: tir_op(faddr), args: tir_a3(sptr, "0", base.i2s(fidx)), is_comment: false, line: g_cur_line, cmt: "" });
                var fval: string = tir_tmp();
                tir_emit(TIRInst{ op: TIR_OP_LOAD, st: tir_st_from_str(fst), dst: tir_op(fval), args: tir_a1(faddr), is_comment: false, line: g_cur_line, cmt: "" });
                var ec: string = tir_tmp();
                if (fst == "%TStr") {
                    var pv: string = tir_emit_expr(base.node_na((fvp_kv as u64))).name;
                    var cmp: string = tir_tmp();
                    tir_emit(TIRInst{ op: TIR_OP_CALL, st: tir_st_from_str("i32"), dst: tir_op(cmp), args: tir_a3("@tll_str_eq", fval, pv), is_comment: false, line: g_cur_line, cmt: "" });
                    tir_emit(TIRInst{ op: TIR_OP_NE, st: tir_st_from_str("i32"), dst: tir_op(ec), args: tir_a2(cmp, "0"), is_comment: false, line: g_cur_line, cmt: "" });
                } else {
                    var pv: string = tir_emit_expr(base.node_na((fvp_kv as u64))).name;
                    tir_emit(TIRInst{ op: TIR_OP_EQ, st: tir_st_from_str(fst), dst: tir_op(ec), args: tir_a2(fval, pv), is_comment: false, line: g_cur_line, cmt: "" });
                }
                if (cond == "") { cond = ec; }
                else {
                    var comb: string = tir_tmp();
                    tir_emit(TIRInst{ op: TIR_OP_AND, st: tir_st_from_str("i1"), dst: tir_op(comb), args: tir_a2(cond, ec), is_comment: false, line: g_cur_line, cmt: "" });
                    cond = comb;
                }
                fvp_ki = fvp_ki + 1;
        }
            if (cond == "") { cond = "1"; }   // 空 {} 模式：恒真
            return cond;
        }
        return "";
    }
    // ── 枚举 / 变体构造器模式（ident 或 Enum.Case / Variant.Case 的 member）──
    var cname: string = base.node_sa((base.node_na((armId as u64)) as u64));
    if (base.node_kind((base.node_na((armId as u64)) as u64)) == "member") { cname = base.node_sa((base.node_na((armId as u64)) as u64)); }
    if (base.node_kind((base.node_na((armId as u64)) as u64)) == "ident" or base.node_kind((base.node_na((armId as u64)) as u64)) == "member") {
        // ⚠ TD-vs-TI：scr_td 是 TD 索引（tir_expr_td 返回），必须用 TD 字段判定枚举，
        // 不可喂给 sema.tip_kind/tip_name/enum_has_case（读 tis[] 或期望 TI 索引，会越界 panic）。
        // enum_const_lookup 取枚举名（字符串）即可，无需 TI 索引。
        // ⚠ 枚举 TD 的 cat 是 "named"（不是 "enum"），必须走 t_td_is_enum 回查 EnumDecl。
        if (t_td_is_enum(scr_td)) {
            var ename: string = sema.tds[scr_td].name;
            var cn: i64 = sema.enum_const_lookup(ename, cname);
            if (cn >= 0) {
                // ⚠ enum_const_lookup 返回的是一个 int 节点，其 ia 字段是**进制**（恒为 10），
                // 真正的成员值在 sa 文本里。直接读 .ia 会让所有枚举成员模式都拿到常量 10
                // → 三臂条件全都 `== 10` → 永不命中。取值写法须与 tir.tc:4135 一致。
                var val: i64 = sema.js_parse_int(base.node_sa((cn as u64)), base.node_ia((cn as u64)));
                var pv: string = tir_tmp();
                tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str(scr_st), dst: tir_op(pv), args: tir_a1(base.i2s(val)), is_comment: false, line: g_cur_line, cmt: "" });
                var cond: string = tir_tmp();
                tir_emit(TIRInst{ op: TIR_OP_EQ, st: tir_st_from_str(scr_st), dst: tir_op(cond), args: tir_a2(scr, pv), is_comment: false, line: g_cur_line, cmt: "" });
                return cond;
            }
        } else if (t_td_is_variant(scr_td)) {
            var vd: i64 = t_variant_decl_of_name_ex(scr_vname);
            var ci: i64 = sema.variant_find_case(vd, cname);
            if (ci >= 0) {
                var idx: i64 = 0;
                var cc: i64 = base.node_lb((vd as u64));
                // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
                var cc_ks: []i64 = base.kids_chain(cc);
                var cc_ki: i64 = 0;
                while (cc_ki < slice_len(cc_ks) as i64) {
                    var cc_kv: i64 = cc_ks[cc_ki];
                    if (base.node_sa((cc_kv as u64)) == cname) { break; }
                    idx = idx + 1;
                    cc_ki = cc_ki + 1;
                }
                var tagp: string = tir_tmp();
                // ⚠ 索引形态必須跟 base 的「指针/值」属性一致：条件链启用后 scrutinee 走的是
                // 指针基（ptr<%TypeInfo>，与 Shape 等普通变体同路径）⇒ 必须给满 [解引用0, 字段0]；
                // 只给单个 "0" 会漏掉字段下标 → `getelementptr %TypeInfo, ptr %x, i32 0`
                // （把指针值本身当 tag 读 → 条件恒假 → 全部落到 `_` 兜底臂）。
                tir_emit(TIRInst{ op: TIR_OP_GEP, st: tir_st_from_str("i64"), dst: tir_op(tagp), args: tir_a3(scr_base, "0", "0"), is_comment: false, line: g_cur_line, cmt: "" });
                var tagv: string = tir_tmp();
                tir_emit(TIRInst{ op: TIR_OP_LOAD, st: tir_st_from_str("i64"), dst: tir_op(tagv), args: tir_a1(tagp), is_comment: false, line: g_cur_line, cmt: "" });
                var pv: string = tir_tmp();
                tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str("i64"), dst: tir_op(pv), args: tir_a1(base.i2s(idx)), is_comment: false, line: g_cur_line, cmt: "" });
                var cond: string = tir_tmp();
                tir_emit(TIRInst{ op: TIR_OP_EQ, st: tir_st_from_str("i64"), dst: tir_op(cond), args: tir_a2(tagv, pv), is_comment: false, line: g_cur_line, cmt: "" });
                return cond;
            }
        }
        return "";
    }
    // ── 变体构造器模式（conpat：带绑定，如 Circle(r) / Rect(w, h) / Empty）──
    // 仅生成 tag 判别条件；载荷绑定提取在 tir_emit_match 的对应 body 块内完成。
    if (base.node_kind((base.node_na((armId as u64)) as u64)) == "conpat") {
        if (t_td_is_variant(scr_td)) {
            // B1 修复：scr_td 是 TypeId 索引，variant_decl_of 期望 TypeInfo 索引 → 必用 vname 反查
            var vd2: i64 = t_variant_decl_of_name_ex(scr_vname);
            var cname2: string = base.node_sa((base.node_na((armId as u64)) as u64));
            var ci2: i64 = sema.variant_find_case(vd2, cname2);
            if (ci2 >= 0) {
                var idx2: i64 = 0;
                var cc2: i64 = base.node_lb((vd2 as u64));
                // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
                var cc2_ks: []i64 = base.kids_chain(cc2);
                var cc2_ki: i64 = 0;
                while (cc2_ki < slice_len(cc2_ks) as i64) {
                    var cc2_kv: i64 = cc2_ks[cc2_ki];
                    if (base.node_sa((cc2_kv as u64)) == cname2) { break; }
                    idx2 = idx2 + 1;
                    cc2_ki = cc2_ki + 1;
                }
                var tagp2: string = tir_tmp();
                tir_emit(TIRInst{ op: TIR_OP_GEP, st: tir_st_from_str("i64"), dst: tir_op(tagp2), args: tir_a3(scr_base, "0", "0"), is_comment: false, line: g_cur_line, cmt: "" });
                var tagv2: string = tir_tmp();
                tir_emit(TIRInst{ op: TIR_OP_LOAD, st: tir_st_from_str("i64"), dst: tir_op(tagv2), args: tir_a1(tagp2), is_comment: false, line: g_cur_line, cmt: "" });
                var pv2: string = tir_tmp();
                tir_emit(TIRInst{ op: TIR_OP_CONST, st: tir_st_from_str("i64"), dst: tir_op(pv2), args: tir_a1(base.i2s(idx2)), is_comment: false, line: g_cur_line, cmt: "" });
                var cond2: string = tir_tmp();
                tir_emit(TIRInst{ op: TIR_OP_EQ, st: tir_st_from_str("i64"), dst: tir_op(cond2), args: tir_a2(tagv2, pv2), is_comment: false, line: g_cur_line, cmt: "" });
                return cond2;
            }
        }
        return "";
    }
    // ── 位串模式（bitstr_pat）：绑定不判别，恒匹配；段内 ident 在 body 提取（§6）──
    if (base.node_kind((base.node_na((armId as u64)) as u64)) == "bitstr_pat") {
        return "";
    }
    return "";
}

// match 降级（as_stmt=true 当作语句；false 当作表达式，返回结果 slot）。
// 两遍发射：第一遍构造条件链（每臂的 eq+br_cond 落在上一臂的 next 块内，形成正确 CFG），
// 第二遍发射各臂 body 块（各自 br 到 endL）。支持 字面量/_/绑定/when 守卫/枚举·变体构造器。
// 绑定名在 match entry 预声明为局部 slot 并绑定 scrutinee，使守卫与体均引用局部 slot（避免 @name 全局误引用）。
// S4 §0.14.7 SoA（第十六批）：同 `tir_emit_while` —— 本函数要按 id 读 la 侧表，Node 值形参的 `.id`
//   不可靠 ⇒ 改为收索引。⚠ 本函数有**两个**调用点且索引名不同（tir_emit_stmt:2349 的 `sid`
//   与 tir_emit_expr:2931 的 `e`），故形参统一取名 `sid`，调用点各自传自己的索引即可。
pub fn tir_emit_match(sid: i64, as_stmt: bool, est: i64) TirEmitRes {
    if (g_term) { return TirEmitRes{ name: "", st: est }; }
    g_term = false;
    g_match_scrut = base.node_na((sid as u64));
    var scrr: TirEmitRes = tir_emit_expr(base.node_na((sid as u64))); var scr: string = scrr.name;
    var scr_st: string = tir_expr_st(base.node_na((sid as u64)));
    var scr_td: i64 = tir_expr_td(base.node_na((sid as u64)));
    var endL: string = tir_lbl("m.e");
    var res: string = "";
    // 收集所有臂
    var armIds: []i64 = [];
    var c: i64 = base.node_la((sid as u64));
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
    var c_ks: []i64 = base.kids_chain(c);
    var c_ki: i64 = 0;
    while (c_ki < slice_len(c_ks) as i64) {
        var c_kv: i64 = c_ks[c_ki];
        append(armIds, c_kv);
        c_ki = c_ki + 1;
    }
    var nArm: i64 = slice_len(armIds);
    if (as_stmt == false) {
        // 结果槽类型优先取「首臂 body 发射类型」：tir_expr_st 对字符串/字节字面量现已直接返回 %TStr，
        // 对结构体字面量走 meta_type_of_expr 亦可靠；而 est（match 整体类型）在 match 返回 string/struct 时
        // 易退化为 i64，导致 __mres 槽宽不足（8 字节 i64 槽存 16 字节 %TStr）→ 栈溢出 / 返回脏结构
        // → match 返回 string/struct 全错（atom / match_demo / type_info_demo / tagid_typeinfo 等）。
        // 变体 match 的 scrutinee 是 ptr<%V> 但 body 返回 i64，首臂 body 类型同样正确，无 scrutinee 误用问题。
        var rtd: i64 = -1;
        var rst: string = "i64";
        if (nArm > 0) {
            if (base.node_nc((armIds[0] as u64)) >= 0) {
                rtd = tir_expr_td(base.node_nc((armIds[0] as u64)));
                if (rtd < 0) { rtd = scr_td; }
                rst = tir_expr_st(base.node_nc((armIds[0] as u64)));
            }
        }
        if (rst == "" or rst == "ptr" or rst == "i64") {
            // 首臂 body 类型仍不可靠（如确为 i64 返回），回退 est（match 整体类型）
            var est_st: string = tir_st_to_str(est);
            if (est_st != "" and est_st != "ptr") { rst = est_st; }
            if (rtd < 0) { rtd = scr_td; }
        }
        // ⚠ A-fix 0c：首臂 body 是 **member 表达式** 时，tir_expr_st 对 member 不可靠
        // （member 节点的 .td 缓存常被污染成 i64；tir_emit_index_addr 处有同构注释）
        // ⇒ __mres 槽按 i64 分配，却被臂内 `store %TStr`（16 字节）**写穿** ⇒
        // `match (ti) { Struct(m) => m.fields[i].name … }` 静默返回空串（不报错）。
        // 补偿：按 member 链的「权威字段类型」重取。仅在已退化为 i64 时介入，
        // 正常形态（body 为字面量/ident/call 等）零影响。
        if ((rst == "i64" or rst == "" or rst == "ptr") and nArm > 0) {
            var b0: i64 = base.node_nc((armIds[0] as u64));
            if (b0 >= 0 and base.node_kind((b0 as u64)) == "member") {
                // 首臂体若以 conpat 载荷绑定为根（`Struct(m) => m.…`），该绑定的槽此刻
                // 尚未创建 ⇒ 把「该 arm 的载荷 TD」作为根类型提示传下去。
                var root_td2: i64 = tir_conpat_payload_root_td(scr_td, armIds[0]);
                var mtd2: i64 = tir_member_expr_td2(b0, root_td2);
                if (mtd2 >= 0 and mtd2 < slice_len(sema.tds) as i64) {
                    var mst2: string = tir_st_of_td(mtd2);
                    if (mst2 != "" and mst2 != "i64" and mst2 != "ptr") { rst = mst2; rtd = mtd2; }
                }
            }
            else if (b0 >= 0 and base.node_kind((b0 as u64)) == "ident") {
                // ⚠ A-fix 0c'：首臂体为 conpat 载荷绑定 ident（`Struct(mt) => mt`）时，该 ident 的
                // TD 此刻尚未登记（bind slot 在 5740+ 才预声明；C 后端另有 match_conpat_binds_register
                // 预登类型表，LLVM 后端没有 ⇒ tir_expr_st 退化为 i64/ptr ⇒ __mres 按 i64 分配 ⇒
                // `var m: *TypeMeta = match (ti) { .Struct(mt) => mt, _ => null }` 在 LLVM 后端静默
                // 拿不到指针（mp 退化 i64、后续 GEP 越界）→ 字段访问崩溃、输出为空。
                // 补偿：仅当该 ident 确为本 match 首臂的 conpat 载荷绑定，按绑定声明的权威 TD 重取
                // （与 5740+ 预声明同源 sema.resolve_type_desc）。仅介入退化形态，正常形态零影响。
                var cn2: i64 = base.node_na((armIds[0] as u64));
                if (cn2 >= 0 and base.node_kind((cn2 as u64)) == "conpat") {
                    var hit: bool = false;
                    var bks: []i64 = base.kids_chain(base.node_la((cn2 as u64)));
                    var bki: i64 = 0;
                    while (bki < slice_len(bks) as i64) {
                        if (base.node_kind((bks[bki] as u64)) == "ident"
                            and base.node_sa((bks[bki] as u64)) == base.node_sa((b0 as u64))) {
                            hit = true; break;
                        }
                        bki = bki + 1;
                    }
                    if (hit) {
                        // 从 conpat 载荷绑定 ident（与 5740+ 预声明同源）取权威 TD；
                        // 注意须用遍历到的 bind ident（bks[bki]），其 na 已链到 var_decl，
                        // 臂体引用 ident（b0）此刻尚未链，resolve 会落空。
                        var mtd2: i64 = sema.resolve_type_desc(base.node_na((bks[bki] as u64)));
                        if (mtd2 < 0 or mtd2 >= slice_len(sema.tds) as i64) {
                            mtd2 = sema.resolve_type_desc(base.node_na((b0 as u64)));
                        }
                        if (mtd2 >= 0 and mtd2 < slice_len(sema.tds) as i64) {
                            var mst2: string = tir_st_of_td(mtd2);
                            if (mst2 != "" and mst2 != "i64" and mst2 != "ptr") { rst = mst2; rtd = mtd2; }
                        }
                    }
                }
            }
        }
        if (rst == "" or rst == "ptr") { rst = "i64"; }
        res = tir_new_named_slot(rtd, rst, "__mres");
    }
    // 取变体名：优先从 scr_td 直接取（t_td_is_variant 已确认是变体时，其 .name 即变体名，最可靠）；
    // 否则回退到「首个 conpat 臂的 case 名反查 VariantDecl」（覆盖 ident-variant 臂无 conpat 的情况）。
    var scr_vname: string = "";
    if (scr_td >= 0 and t_td_is_variant(scr_td)) { scr_vname = sema.tds[scr_td].name; }
    var fi_v: i64 = 0;
    while (fi_v < nArm) {
        if (base.node_na((armIds[fi_v] as u64)) >= 0 and base.node_kind((base.node_na((armIds[fi_v] as u64)) as u64)) == "conpat") {
            var cv: string = base.node_sa((base.node_na((armIds[fi_v] as u64)) as u64));
            var di: i64 = 0;
            var dn2: i64 = slice_len(lex.decl_list) as i64;
            while (di < dn2) {
                var dvi: i64 = lex.decl_list[di];
                if (base.node_kind((dvi as u64)) == "VariantDecl") {
                    var ccx: i64 = base.node_lb((dvi as u64));
                    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
                    var ccx_ks: []i64 = base.kids_chain(ccx);
                    var ccx_ki: i64 = 0;
                    while (ccx_ki < slice_len(ccx_ks) as i64) {
                        var ccx_kv: i64 = ccx_ks[ccx_ki];
                        if (base.node_sa((ccx_kv as u64)) == cv) { scr_vname = base.node_sa((dvi as u64)); break; }
                        ccx_ki = ccx_ki + 1;
                    }
                }
                if (scr_vname != "") { break; }
                di = di + 1;
            }
        }
        if (scr_vname != "") { break; }
        fi_v = fi_v + 1;
    }
    // ⚠ 禁止 sema.variant_decl_of(scr_td)：它内部走 tip_kind/tip_name → 索引 tis[]（TypeInfo），
    // 而 scr_td 是 sema.tds[] 索引；两表长度不同（如 tds=216 / tis=209）→ index_out_of_bounds。
    // 按 TD 名走 decl_list 查 VariantDecl（与 t_td_is_variant 同一判定口径）。
    if (scr_vname == "") {
        if (scr_td >= 0 and scr_td < slice_len(sema.tds) as i64) {
            var svd2: i64 = t_variant_decl_of_name(sema.tds[scr_td].name);
            if (svd2 >= 0) { scr_vname = base.node_sa((svd2 as u64)); }
        }
    }
    // 取 scrutinee 的「指针基址」：变体以聚合值形态落在局部 slot（%Shape），需 addr_of 取其地址；
    // 若已是 ptr<%Shape>（如构造器返回值），直接作为基址。依据「实际 slot 类型」判断。
    var scr_base: string = scr;
    var scr_slot_st: string = scr_st;
    var scr_lname: string = str_slice(scr, 1, str_len(scr));
    var scr_li: i64 = tir_find_local_idx(scr_lname);
    if (scr_li >= 0) { scr_slot_st = g_local_sts[scr_li]; }
    if (scr_slot_st[0] != 112 and scr_vname != "") {
        scr_base = tir_tmp();
        var scr_ptrst: string = base.sb_cat3("ptr<%", scr_vname, ">");
        tir_emit(TIRInst{ op: TIR_OP_ADDR_OF, st: tir_st_from_str(scr_ptrst), dst: tir_op(scr_base), args: tir_a1(scr), is_comment: false, line: g_cur_line, cmt: "" });
    }
    // ⚠ TypeInfo scrutinee 基底「显式物化」（A-fix）：
    // TypeInfo 局部槽在**后端**登记的类型有可能被降级成裸 `ptr` —— 实测触发路径是把该变量
    // 先传给遗留 ti_* 函数（`println(int_to_str(ti_kind(ti)))` 出现在 match 之前），此时
    // GEP 会拿 `ptr`（**标量**）当基类型、却仍收到两级下标 ⇒
    // `getelementptr inbounds ptr, ptr %ti, i32 0, i32 0` → clang `invalid getelementptr indices`，
    // 连 IR 都通不过。（注意：降级发生在后端 llname 注册表，非 TIR 的 g_local_sts，
    // 故无法在前端用「检查 slot st」的方式先验地命中。）
    // 修法：无条件先把「指向变体数据的指针」load 到 st=ptr<%TypeInfo> 的临时槽，再以其为 GEP 基，
    // 使后端永远按「指针基」约定行事（add_deref0=false，前端给满 [解引用0, 字段k]）。
    // 已实测：这与未被污染时后端自行产出的指令完全一致，不会引入额外 IR 差异。
    if (scr_vname == "TypeInfo") {
        var sbfix: string = tir_tmp();
        tir_emit(TIRInst{ op: TIR_OP_LOAD, st: tir_st_from_str("ptr<%TypeInfo>"), dst: tir_op(sbfix), args: tir_a1(scr), is_comment: false, line: g_cur_line, cmt: "" });
        scr_base = sbfix;
    }
    // 预声明绑定名 slot（match entry）：使守卫/体都引用局部 slot，且声明早于使用
    var i: i64 = 0;
    while (i < nArm) {
        // 预声明绑定名 slot：裸绑定 `x`（na<0）与 as-模式 `x @ pat`（S3，na>=0）都要把
        // 整体被匹配值绑到 x，故只按 sa 判定，不要求 na<0。
        if (base.node_sa((armIds[i] as u64)) != "") {
            // 同绑定名跨多臂只建一个 slot（避免 $x / $x__0 重复死槽）；已声明则复用
            var bidx: i64 = tir_find_local_idx(base.node_sa((armIds[i] as u64)));
            if (bidx < 0) {
                var bs: string = tir_new_named_slot(scr_td, scr_st, base.node_sa((armIds[i] as u64)));
                tir_emit(TIRInst{ op: TIR_OP_STORE, st: ST_NONE, dst: tir_op(bs), args: tir_a1(scr), is_comment: false, line: g_cur_line, cmt: "" });
            }
        }
        // conpat 载荷绑定：预声明 slot（类型取绑定 .na），提取在 body 块内进行。
        // 注意：与上方 `arm.sa != ""` 分支是**独立**的 if（非 else if）——as-模式 `c @ Circle(r)`
        // 同时有绑定名 sa="c" 与子模式 conpat，二者都要预声明（否则载荷 r 的 slot 缺失、
        // body 提取 TirEmit 找不到本地槽而不写，r 恒为 0）。
        if (base.node_na((armIds[i] as u64)) >= 0 and base.node_kind((base.node_na((armIds[i] as u64)) as u64)) == "conpat") {
            var bk2: i64 = base.node_la((base.node_na((armIds[i] as u64)) as u64));
            // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
            var bk2_ks: []i64 = base.kids_chain(bk2);
            var bk2_ki: i64 = 0;
            while (bk2_ki < slice_len(bk2_ks) as i64) {
                var bk2_kv: i64 = bk2_ks[bk2_ki];
                if (base.node_kind((bk2_kv as u64)) == "ident" and base.node_sa((bk2_kv as u64)) != "_") {
                    var bidx2: i64 = tir_find_local_idx(base.node_sa((bk2_kv as u64)));
                    if (bidx2 < 0) {
                        var btd2: i64 = sema.resolve_type_desc(base.node_na((bk2_kv as u64)));
                        var bst2: string = tir_st_of_td(btd2);
                        tir_new_named_slot(btd2, bst2, base.node_sa((bk2_kv as u64)));
                    }
                }
                bk2_ki = bk2_ki + 1;
            }
        }
        // S6 切片模式：预声明元素绑定名 slot（类型取切片 elem TD）。
        if (base.node_na((armIds[i] as u64)) >= 0 and base.node_kind((base.node_na((armIds[i] as u64)) as u64)) == "slice_pat") {
            var sp_elem: i64 = -1;
            if (scr_td >= 0 and sema.tds[scr_td].cat == "slice") { sp_elem = sema.tds[scr_td].elem; }
            var sp_st: string = tir_st_of_td(sp_elem);
            var sp_e2: i64 = base.node_la((base.node_na((armIds[i] as u64)) as u64));
            // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
            var sp_e2_ks: []i64 = base.kids_chain(sp_e2);
            var sp_e2_ki: i64 = 0;
            while (sp_e2_ki < slice_len(sp_e2_ks) as i64) {
                var sp_e2_kv: i64 = sp_e2_ks[sp_e2_ki];
                if (base.node_kind((sp_e2_kv as u64)) == "ident" and base.node_sa((sp_e2_kv as u64)) != "_") {
                    var bidx2: i64 = tir_find_local_idx(base.node_sa((sp_e2_kv as u64)));
                    if (bidx2 < 0) { tir_new_named_slot(sp_elem, sp_st, base.node_sa((sp_e2_kv as u64))); }
                }
                sp_e2_ki = sp_e2_ki + 1;
            }
        }
        // 结构体 / 具名元组字面量模式：预声明字段绑定名 slot（类型取字段 TD，与 conpat/slice_pat 同构）。
        // 命名结构名由模式 sa 给出；匿名元组由 scrutinee TD 反查合成结构名。
        if (base.node_na((armIds[i] as u64)) >= 0 and base.node_kind((base.node_na((armIds[i] as u64)) as u64)) == "struct_lit") {
            var sl_name: string = base.node_sa((base.node_na((armIds[i] as u64)) as u64));
            if (sl_name == "" and scr_td >= 0 and scr_td < slice_len(sema.tds) as i64) {
                sl_name = sema.tds[scr_td].name;
            }
            var sl_fvp: i64 = base.node_la((base.node_na((armIds[i] as u64)) as u64));
            var sl_pos_pre: i64 = 0;   // 位置式字段按列表下标映射
            // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
            var sl_fvp_ks: []i64 = base.kids_chain(sl_fvp);
            var sl_fvp_ki: i64 = 0;
            while (sl_fvp_ki < slice_len(sl_fvp_ks) as i64) {
                var sl_fvp_kv: i64 = sl_fvp_ks[sl_fvp_ki];
                var sl_fname: string = base.node_sa((sl_fvp_kv as u64));
                var sl_eff: string = sl_fname;
                if (sl_fname == "") { sl_eff = sema.struct_field_name_at(sl_name, sl_pos_pre); sl_pos_pre = sl_pos_pre + 1; }
                var sl_fval: i64 = base.node_na((sl_fvp_kv as u64));
                if (sl_fval >= 0 and base.node_kind((sl_fval as u64)) == "ident" and base.node_sa((sl_fval as u64)) != "_") {
                    var sl_bidx: i64 = tir_find_local_idx(base.node_sa((sl_fval as u64)));
                    if (sl_bidx < 0) {
                        var sl_ftd: i64 = -1;
                        if (sl_name != "") { sl_ftd = tir_field_td(sl_name, sl_eff); }
                        var sl_fst: string = tir_st_of_td(sl_ftd);
                        if (sl_fst == "") { sl_fst = "i64"; }   // 兜底（字段类型不可得时）
                        tir_new_named_slot(sl_ftd, sl_fst, base.node_sa((sl_fval as u64)));
                    }
                }
                sl_fvp_ki = sl_fvp_ki + 1;
            }
        }
        // 位串模式：预声明段内绑定名 slot（定长段 → i64，/bitstr 尾段 → %TBitStr）
        if (base.node_na((armIds[i] as u64)) >= 0 and base.node_kind((base.node_na((armIds[i] as u64)) as u64)) == "bitstr_pat") {
            var bseg3: i64 = base.node_la((base.node_na((armIds[i] as u64)) as u64));
            // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
            var bseg3_ks: []i64 = base.kids_chain(bseg3);
            var bseg3_ki: i64 = 0;
            while (bseg3_ki < slice_len(bseg3_ks) as i64) {
                var bseg3_kv: i64 = bseg3_ks[bseg3_ki];
                if (base.node_na((bseg3_kv as u64)) >= 0 and base.node_kind((base.node_na((bseg3_kv as u64)) as u64)) == "ident" and base.node_sa((base.node_na((bseg3_kv as u64)) as u64)) != "_") {
                    var bidx3: i64 = tir_find_local_idx(base.node_sa((base.node_na((bseg3_kv as u64)) as u64)));
                    if (bidx3 < 0) {
                        if (base.node_ba((bseg3_kv as u64))) {
                            // /bitstr 尾段绑定：类型必须是 bitstr（不能用 scrutinee 的 scr_td，
                            // 内联 <<...>> 字面量 scr_td 退化为 -1/未知类型，会导致下游 for-each
                            // 走 unsupported 分支、迭代 0 次）。与 C 后端 match_chain_from 同语义。
                            tir_new_named_slot(sema.td_mk("bitstr"), "%TBitStr", base.node_sa((base.node_na((bseg3_kv as u64)) as u64)));
                        } else {
                            tir_new_named_slot(-1, "i64", base.node_sa((base.node_na((bseg3_kv as u64)) as u64)));
                        }
                    }
                }
                bseg3_ki = bseg3_ki + 1;
            }
        }
        i = i + 1;
    }
    var armLabels: []string = [];
    // 第一遍：条件链（每臂的 br_cond/br 紧随上一臂打开的 next 块，确保 cond 落在该 next 块内）
    var last_opened_next: bool = false;   // 末臂为条件臂时，条件链末尾会留一个空 fallthrough 块，需补终止指令
    i = 0;
    while (i < nArm) {
        var armL: string = tir_lbl("m.b");
        append(armLabels, armL);
        var cond: string = "";
        var skip_arm: bool = false;
        if (base.node_na((armIds[i] as u64)) >= 0) {
            cond = tir_match_pattern_cond(armIds[i], scr, scr_base, scr_st, scr_td, scr_vname);
            if (cond == "") {
                tir_cmt(base.sb_cat2("unsupported match arm pattern: ", base.node_kind((base.node_na((armIds[i] as u64)) as u64))));
                skip_arm = true;
            }
        }
        if (base.node_nb((armIds[i] as u64)) >= 0) {   // when 守卫：与模式条件做 and（纯绑定臂则守卫即条件）
            var gr: TirEmitRes = tir_emit_expr(base.node_nb((armIds[i] as u64))); var g: string = gr.name;
            if (cond == "") { cond = g; }
            else { var comb: string = tir_tmp(); tir_emit(TIRInst{ op: TIR_OP_AND, st: tir_st_from_str("i8"), dst: tir_op(comb), args: tir_a2(cond, g), is_comment: false, line: g_cur_line, cmt: "" }); cond = comb; }
        }
        var is_term: bool = (base.node_na((armIds[i] as u64)) < 0 and base.node_nb((armIds[i] as u64)) < 0);   // 纯 _ 或纯绑定：无条件臂
        if (skip_arm) {
            tir_emit(TIRInst{ op: TIR_OP_BR, st: ST_NONE, dst: tir_op(""), args: tir_a1(armL), is_comment: false, line: g_cur_line, cmt: "" });        // 不支持模式：降级为终极端（兜底，永不崩溃）
            last_opened_next = false;
        } else if (is_term) {
            tir_emit(TIRInst{ op: TIR_OP_BR, st: ST_NONE, dst: tir_op(""), args: tir_a1(armL), is_comment: false, line: g_cur_line, cmt: "" });
            last_opened_next = false;
        } else {
            var nextL: string = tir_lbl("m.n");
            tir_emit(TIRInst{ op: TIR_OP_BR_COND, st: ST_NONE, dst: tir_op(""), args: tir_a3(cond, armL, nextL), is_comment: false, line: g_cur_line, cmt: "" });
            tir_block(nextL);   // 打开 next 块，后续臂条件链落于此
            last_opened_next = true;
        }
        i = i + 1;
    }
    // 末臂为条件臂时，条件链末尾的 fallthrough 块无终止指令（且第二遍会紧接打开首臂体块关闭它），
    // 导致空基本块 → LLVM 报 "expected instruction opcode"。穷尽匹配下该块不可达，补 br <end> 即可正确终止。
    if (last_opened_next) { tir_emit(TIRInst{ op: TIR_OP_BR, st: ST_NONE, dst: tir_op(""), args: tir_a1(endL), is_comment: false, line: g_cur_line, cmt: "" }); }
    // 第二遍：body 块（绑定名已在 entry 绑定，无需重复 store）
    i = 0;
    while (i < nArm) {
        var armL: string = armLabels[i];
        tir_block(armL);
        tir_blk_push();
        // conpat 载荷提取：把 scrutinee 各字段 load 进预声明 slot（仅本臂命中时执行）
        if (base.node_na((armIds[i] as u64)) >= 0 and base.node_kind((base.node_na((armIds[i] as u64)) as u64)) == "conpat") {
            // 取得该 case 的字段 TD 列表（与构造器同源：variant 声明 case 的 pristine 字段类型节点），
            // 保证提取偏移与构造器载荷布局逐字节一致。conpat 绑定 .na 在 match 降级后解析不稳定，
            // 故统一由 variant 声明侧查表（构造器正是这么做的）。
            var ckey: string = base.sb_cat3(scr_vname, "_", base.node_sa((base.node_na((armIds[i] as u64)) as u64)));
            var cflds: []i64 = [];
            var cki: i64 = 0;
            var ckmax: i64 = slice_len(g_vf_keys) as i64;
            if (slice_len(g_vf_nodes) as i64 < ckmax) { ckmax = slice_len(g_vf_nodes) as i64; }
            while (cki < ckmax) {
                if (g_vf_keys[cki] == ckey) { cflds = g_vf_nodes[cki]; break; }
                cki = cki + 1;
        }
        var off3: i64 = 0;
        var bi3: i64 = 0;
            var bk3: i64 = base.node_la((base.node_na((armIds[i] as u64)) as u64));
            // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
            var bk3_ks: []i64 = base.kids_chain(bk3);
            var bk3_ki: i64 = 0;
            while (bk3_ki < slice_len(bk3_ks) as i64) {
                var bk3_kv: i64 = bk3_ks[bk3_ki];
                // 字段 TD：优先取 g_vf_tds（构造器发射期解析的「pristine 字段 TD」，不受后续 match 降级
                // 改写 variant 声明节点的影响），保证提取偏移与构造器载荷布局逐字节一致；cflds/bn3.na
                // 仅作回退。
                var ftd3: i64 = -1;
                if (bi3 < slice_len(cflds) as i64 and cki >= 0 and cki < slice_len(g_vf_tds) as i64 and bi3 < slice_len(g_vf_tds[cki]) as i64) {
                    ftd3 = g_vf_tds[cki][bi3];
                }
                if (ftd3 < 0 and bi3 < slice_len(cflds) as i64) { ftd3 = sema.resolve_type_desc(cflds[bi3]); }
                if (ftd3 < 0 and base.node_na((bk3_kv as u64)) >= 0) { ftd3 = sema.resolve_type_desc(base.node_na((bk3_kv as u64))); }
                var fsz3: i64 = tir_size_bytes(ftd3);
                if (base.node_kind((bk3_kv as u64)) == "ident" and base.node_sa((bk3_kv as u64)) != "_") {
                    var fst3: string = tir_st_of_td(ftd3);
                    off3 = tir_round8(off3);
                    var aoff3: i64 = off3;   // payload 内偏移（与构造器载荷布局逐字节一致）
                    var fpi3: string = tir_tmp();
                    // ⚠ TypeInfo 的 arm 载荷是 `*TypeMeta`（指针值），不是内联字节 blob，
                    // 因此取出的必须是「指针值」本身，需要**两次**解引用：
                    //   &payload(GEP) → *( TypeMeta** )&payload → meta 指针
                    // 后端 TIR_OP_LOAD 的穿透解引用仅在 `pst(源槽) == "ptr<" + st + ">"` 时触发；
                    // 本切片 fst3 解析为 `%TypeMeta`（不含 ptr 前缀）⇒ 落进「按值直读」分支，
                    // 从 `&payload` 起连读 72 字节 ⇒ 首 8 字节是 meta 指针、其余是相邻垃圾
                    // （症状：m.field_count 恒 0 / tag 比较后走错分支）。
                    // 令本臂的 LOAD st 为 "ptr"，使源槽 st("ptr<ptr>") == "ptr<ptr>" 成立，
                    // 即得到 *(&payload) = meta 指针；后续 `m.field` 由指针接收者自动解引用承接。
                    var pld3: string = fst3;
                    var is_ti3: bool = (scr_vname == "TypeInfo" or (scr_td >= 0 and sema.tds[scr_td].name == "TypeInfo"));
                    if (is_ti3) { pld3 = "ptr"; }
                    if (is_ti3) {
                        // TypeInfo 是扁平布局 { i64 tag, ptr meta }：每个 arm 的载荷都是 field 1 的
                        // *TypeMeta（非字节 blob）。故直接 GEP 到 field 1 取出 meta 指针，禁止再拖 aoff3
                        // 字节偏移（那会多一层 i32 0 索引去解引用标量 ptr 字段 → verifier 报非法 GEP）。
                        // ⚠ scr_vname 经 t_td_is_variant 查 lex.decl_list 取不到（TypeInfo 是注入合成
                        // 变体，仅存在于 global_scope，不在 decl_list），故此处回退按 TD 名判定。
                        // ⚠ 同上：条件链启用后 scrutinee 是**指针基**（后端不再补 i32 0），
                        // 故必须显式给满 [解引用0, 字段1]；只给 "1" 会漏掉解引用 → 索引层数错位。
                        tir_emit(TIRInst{ op: TIR_OP_GEP, st: tir_st_from_str("ptr"), dst: tir_op(fpi3), args: tir_a3(scr_base, "0", "1"), is_comment: false, line: g_cur_line, cmt: "" });
                    } else {
                        tir_emit(TIRInst{ op: TIR_OP_GEP, st: tir_st_from_str("i8"), dst: tir_op(fpi3), args: tir_a4(scr_base, "0", "1", base.i2s(aoff3)), is_comment: false, line: g_cur_line, cmt: "" });
                    }
                    var vi3: string = tir_tmp();
                    tir_emit(TIRInst{ op: TIR_OP_LOAD, st: tir_st_from_str(pld3), dst: tir_op(vi3), args: tir_a1(fpi3), is_comment: false, line: g_cur_line, cmt: "" });
                    var bidx3: i64 = tir_find_local_idx(base.node_sa((bk3_kv as u64)));
                    if (bidx3 >= 0) {
                        var bslot3: string = g_local_slots[bidx3];
                        tir_emit(TIRInst{ op: TIR_OP_STORE, st: ST_NONE, dst: tir_op(bslot3), args: tir_a1(vi3), is_comment: false, line: g_cur_line, cmt: "" });
                    }
                }
                off3 = off3 + fsz3;
                bi3 = bi3 + 1;
                bk3_ki = bk3_ki + 1;
            }
        }
        // S6 切片模式：提取元素绑定到预声明 slot（scr[i] → load → store）
        if (base.node_na((armIds[i] as u64)) >= 0 and base.node_kind((base.node_na((armIds[i] as u64)) as u64)) == "slice_pat") {
            var sp_na2: i64 = base.node_na((base.node_na((armIds[i] as u64)) as u64));
            var sp_nb2: i64 = base.node_nb((base.node_na((armIds[i] as u64)) as u64));
            var elem_td2: i64 = -1;
            if (scr_td >= 0 and sema.tds[scr_td].cat == "slice") { elem_td2 = sema.tds[scr_td].elem; }
            var elem_st2: string = tir_st_of_td(elem_td2);
            var len_t2: string = tir_tmp();
            tir_emit(TIRInst{ op: TIR_OP_CALL, st: tir_st_from_str("i64"), dst: tir_op(len_t2), args: tir_a2("@slice_len", scr), is_comment: false, line: g_cur_line, cmt: "" });
            var sp_e3: i64 = base.node_la((base.node_na((armIds[i] as u64)) as u64));
            var pos2: i64 = 0;
            // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
            var sp_e3_ks: []i64 = base.kids_chain(sp_e3);
            var sp_e3_ki: i64 = 0;
            while (sp_e3_ki < slice_len(sp_e3_ks) as i64) {
                var sp_e3_kv: i64 = sp_e3_ks[sp_e3_ki];
                if (base.node_kind((sp_e3_kv as u64)) == "ident" and base.node_sa((sp_e3_kv as u64)) != "_") {
                    var idxv2: string;
                    if (sp_na2 < 0 or pos2 < sp_na2) { idxv2 = base.i2s(pos2); }
                    else { var off2: string = tir_tmp(); tir_emit(TIRInst{ op: TIR_OP_SUB, st: tir_st_from_str("i64"), dst: tir_op(off2), args: tir_a2(len_t2, base.i2s(sp_nb2 - pos2)), is_comment: false, line: g_cur_line, cmt: "" }); idxv2 = off2; }
                    var eptr2: string = tir_tmp();
                    tir_emit(TIRInst{ op: TIR_OP_SLICE_AT, st: ST_NONE, dst: tir_op(eptr2), args: tir_a2(scr, idxv2), is_comment: false, line: g_cur_line, cmt: "" });
                    var ev2: string = tir_tmp();
                    tir_emit(TIRInst{ op: TIR_OP_LOAD, st: tir_st_from_str(elem_st2), dst: tir_op(ev2), args: tir_a1(tir_os(eptr2, tir_st_from_str(base.sb_cat3("ptr<", elem_st2, ">")))), is_comment: false, line: g_cur_line, cmt: "" });
                    var bidx3: i64 = tir_find_local_idx(base.node_sa((sp_e3_kv as u64)));
                    if (bidx3 >= 0) {
                        var bslot3: string = g_local_slots[bidx3];
                        tir_emit(TIRInst{ op: TIR_OP_STORE, st: ST_NONE, dst: tir_op(bslot3), args: tir_a1(ev2), is_comment: false, line: g_cur_line, cmt: "" });
                    }
                }
                pos2 = pos2 + 1;
                sp_e3_ki = sp_e3_ki + 1;
            }
        }
        // 结构体 / 具名元组字面量模式：提取绑定字段到预声明 slot（与 C 后端 match_chain_from 同语义）。
        // 配方复用 tir_match_pattern_cond 的 struct_lit 分支：ADDR_OF 结构值 → GEP 字段偏移 → LOAD → STORE。
        if (base.node_na((armIds[i] as u64)) >= 0 and base.node_kind((base.node_na((armIds[i] as u64)) as u64)) == "struct_lit") {
            var sl_name_b: string = base.node_sa((base.node_na((armIds[i] as u64)) as u64));
            if (sl_name_b == "" and scr_td >= 0 and scr_td < slice_len(sema.tds) as i64) {
                sl_name_b = sema.tds[scr_td].name;
            }
            if (sl_name_b != "") {
                var sl_sbase_b: string = tir_tmp();
                tir_emit(TIRInst{ op: TIR_OP_ADDR_OF, st: tir_st_from_str(base.sb_cat3("ptr<%", tir_strip_pct(sl_name_b), ">")), dst: tir_op(sl_sbase_b), args: tir_a1(scr), is_comment: false, line: g_cur_line, cmt: "" });
                var sl_fvp_b: i64 = base.node_la((base.node_na((armIds[i] as u64)) as u64));
                var sl_pos_b: i64 = 0;   // 位置式字段按列表下标映射
                // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
                var sl_fvp_b_ks: []i64 = base.kids_chain(sl_fvp_b);
                var sl_fvp_b_ki: i64 = 0;
                while (sl_fvp_b_ki < slice_len(sl_fvp_b_ks) as i64) {
                    var sl_fvp_b_kv: i64 = sl_fvp_b_ks[sl_fvp_b_ki];
                    var sl_fname_b: string = base.node_sa((sl_fvp_b_kv as u64));
                    var sl_eff_b: string = sl_fname_b;
                    if (sl_fname_b == "") { sl_eff_b = sema.struct_field_name_at(sl_name_b, sl_pos_b); sl_pos_b = sl_pos_b + 1; }
                    var sl_fval_b: i64 = base.node_na((sl_fvp_b_kv as u64));
                    if (sl_fval_b >= 0 and base.node_kind((sl_fval_b as u64)) == "ident" and base.node_sa((sl_fval_b as u64)) != "_") {
                        var sl_fidx_b: i64 = tir_field_index(sl_name_b, sl_eff_b);
                        var sl_fst_b: string = tir_field_st(sl_name_b, sl_eff_b);
                        var sl_faddr_b: string = tir_tmp();
                        tir_emit(TIRInst{ op: TIR_OP_GEP, st: tir_st_from_str(sl_fst_b), dst: tir_op(sl_faddr_b), args: tir_a3(sl_sbase_b, "0", base.i2s(sl_fidx_b)), is_comment: false, line: g_cur_line, cmt: "" });
                        var sl_fvload_b: string = tir_tmp();
                        tir_emit(TIRInst{ op: TIR_OP_LOAD, st: tir_st_from_str(sl_fst_b), dst: tir_op(sl_fvload_b), args: tir_a1(sl_faddr_b), is_comment: false, line: g_cur_line, cmt: "" });
                        var sl_bidx_b: i64 = tir_find_local_idx(base.node_sa((sl_fval_b as u64)));
                        if (sl_bidx_b >= 0) {
                            var sl_bslot_b: string = g_local_slots[sl_bidx_b];
                            tir_emit(TIRInst{ op: TIR_OP_STORE, st: ST_NONE, dst: tir_op(sl_bslot_b), args: tir_a1(sl_fvload_b), is_comment: false, line: g_cur_line, cmt: "" });
                        }
                    }
                    sl_fvp_b_ki = sl_fvp_b_ki + 1;
                }
            }
        }
        // 位串模式解构（§6）：按累计位偏移提取段 → 绑定 slot（与 C 后端 match_chain_from 同语义）
        if (base.node_na((armIds[i] as u64)) >= 0 and base.node_kind((base.node_na((armIds[i] as u64)) as u64)) == "bitstr_pat") {
            var boff: i64 = 0;
            var bseg2: i64 = base.node_la((base.node_na((armIds[i] as u64)) as u64));
            // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环，与原手写链遍历逐点同序
            var bseg2_ks: []i64 = base.kids_chain(bseg2);
            var bseg2_ki: i64 = 0;
            while (bseg2_ki < slice_len(bseg2_ks) as i64) {
                var bseg2_kv: i64 = bseg2_ks[bseg2_ki];
                if (base.node_na((bseg2_kv as u64)) >= 0 and base.node_kind((base.node_na((bseg2_kv as u64)) as u64)) == "ident" and base.node_sa((base.node_na((bseg2_kv as u64)) as u64)) != "_") {
                    var bidx: i64 = tir_find_local_idx(base.node_sa((base.node_na((bseg2_kv as u64)) as u64)));
                    if (bidx >= 0) {
                        var bslot: string = g_local_slots[bidx];
                        if (base.node_ba((bseg2_kv as u64))) {
                            // /bitstr 尾段：tll_bitstr_sub(out, scr, off) → %TBitStr
                            tir_emit(TIRInst{ op: TIR_OP_CALL, st: tir_st_from_str("void"), dst: tir_op(""), args: tir_a4("@tll_bitstr_sub", bslot, scr, base.i2s(boff)), is_comment: false, line: g_cur_line, cmt: "" });
                        } else {
                            // 定长段 v:W：tll_bitstr_extract(scr, off, W, little) → i64
                            var bbits: i64 = sema.parse_int_len(base.node_sa((base.node_nb((bseg2_kv as u64)) as u64)), base.node_ia((base.node_nb((bseg2_kv as u64)) as u64)));
                            var blittle: i64 = 0;
                            if (base.node_sa((bseg2_kv as u64)) == "little") { blittle = 1; }
                            var bext: string = tir_tmp();
                            tir_emit(TIRInst{ op: TIR_OP_CALL, st: tir_st_from_str("i64"), dst: tir_op(bext), args: tir_a5("@tll_bitstr_extract", scr, base.i2s(boff), base.i2s(bbits), base.i2s(blittle)), is_comment: false, line: g_cur_line, cmt: "" });
                            tir_emit(TIRInst{ op: TIR_OP_STORE, st: ST_NONE, dst: tir_op(bslot), args: tir_a1(bext), is_comment: false, line: g_cur_line, cmt: "" });
                        }
                    }
                }
                // 累计位偏移：定长段占 W 位（绑定或字面量皆然）；rest 段为末尾，不累计
                if (base.node_ba((bseg2_kv as u64)) == false) {
                    if (base.node_kind((base.node_nb((bseg2_kv as u64)) as u64)) == "int") { boff = boff + sema.parse_int_len(base.node_sa((base.node_nb((bseg2_kv as u64)) as u64)), base.node_ia((base.node_nb((bseg2_kv as u64)) as u64))); }
                }
                bseg2_ki = bseg2_ki + 1;
            }
        }
        if (as_stmt) {
            tir_emit_stmt(base.node_nc((armIds[i] as u64)));
        } else {
            var bvr: TirEmitRes = tir_emit_expr(base.node_nc((armIds[i] as u64))); var bv: string = bvr.name;
            if (res != "") { tir_emit(TIRInst{ op: TIR_OP_STORE, st: ST_NONE, dst: tir_op(res), args: tir_a1(bv), is_comment: false, line: g_cur_line, cmt: "" }); }
        }
        tir_blk_pop();
        g_term = false;   // 臂内可能有 return/break；强制补上收尾 br
        tir_emit(TIRInst{ op: TIR_OP_BR, st: ST_NONE, dst: tir_op(""), args: tir_a1(endL), is_comment: false, line: g_cur_line, cmt: "" });
        i = i + 1;
    }
    tir_block(endL);
    if (as_stmt == false) { return TirEmitRes{ name: res, st: est }; }
    return TirEmitRes{ name: "", st: est };
}

// ══════════════════════════════════════════════════════════════════
// 文本序列化（tir-design.md §4 / §12.1 规范真相源）
// ══════════════════════════════════════════════════════════════════

pub fn tir_esc(s: string) string {
    var sb: StringBuilder = sb_new();
    var i: u64 = 0;
    var L: u64 = str_len(s);
    while (i < L) {
        var c: u8 = s[i];
        if (c >= 32 and c <= 126 and c != 34 and c != 92) {
            sb_append_char(sb, c);
        } else {
            sb_append_char(sb, 92);   // backslash
            sb_append_char(sb, base.hex_digit(c / 16));
            sb_append_char(sb, base.hex_digit(c % 16));
        }
        i = i + 1;
    }
    return sb_to_str(sb);
}

pub fn tir_to_text() string {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "module \"");
    sb_append_str(sb, g_mod.mod);
    sb_append_str(sb, "\"\n");
    sb_append_str(sb, "source: \"");
    sb_append_str(sb, g_mod.source);
    sb_append_str(sb, "\"\n\n");

    sb_append_str(sb, "types:\n");
    var ti: i64 = 0;
    var tn: i64 = slice_len(g_mod.types) as i64;
    while (ti < tn) {
        var t: TIRType = g_mod.types[ti];
        sb_append_str(sb, "  ");
        sb_append_str(sb, t.name);
        sb_append_str(sb, " = struct { ");
        sb_append_str(sb, t.body);
        sb_append_str(sb, " }\n");
        ti = ti + 1;
    }
    sb_append_str(sb, "\n");

    if (slice_len(g_mod.strings) > 0) {
        sb_append_str(sb, "strings:\n");
        var si: i64 = 0;
        var sn: i64 = slice_len(g_mod.strings) as i64;
        while (si < sn) {
            sb_append_str(sb, "  ");
            sb_append_i64(sb, si);
            sb_append_str(sb, ": \"");
            sb_append_str(sb, tir_esc(g_mod.strings[si]));
            sb_append_str(sb, "\"\n");
            si = si + 1;
        }
        sb_append_str(sb, "\n");
    }

    // 模块级全局变量段（@name ST 每行；运行期初始化由 t.__ginit 完成）
    if (slice_len(g_global_names) as i64 > 0) {
        sb_append_str(sb, "globals:\n");
        sb_append_str(sb, sb_to_str(g_globals_section));
    }

    var fi: i64 = 0;
    var fncount: i64 = slice_len(g_mod.funcs) as i64;
    while (fi < fncount) {
        var f: TIRFunc = g_mod.funcs[fi];
        var head: StringBuilder = sb_new();
        if (f.is_extern) { sb_append_str(head, "extern "); }
        else { sb_append_str(head, "func "); }
        sb_append_str(head, "@");
        sb_append_str(head, f.name);
        sb_append_str(head, "(");
        var pi: i64 = 0;
        var pn: i64 = slice_len(f.params) as i64;
        while (pi < pn) {
            if (pi > 0) { sb_append_str(head, ", "); }
            sb_append_str(head, f.params[pi]);
            pi = pi + 1;
        }
        sb_append_str(head, "): ");
        sb_append_str(head, f.ret_st);
        if (f.is_main) { sb_append_str(head, " @main"); }
        sb_append_str(sb, sb_to_str(head));
        sb_append_str(sb, "\n");
        if (f.is_extern == false) {
            sb_append_str(sb, "{\n");
            var bi: i64 = 0;
            var bn: i64 = slice_len(f.body) as i64;
            while (bi < bn) {
                var inst: TIRInst = f.body[bi];
                if (inst.is_comment) {
                    sb_append_str(sb, "  ; ");
                    sb_append_str(sb, inst.cmt);
                } else {
                    sb_append_str(sb, "  ");
                    sb_append_str(sb, tir_inst_to_text(inst));
                }
                sb_append_str(sb, "\n");
                bi = bi + 1;
            }
            sb_append_str(sb, "}\n\n");
        }
        fi = fi + 1;
    }
    return sb_to_str(sb);
}
