}
// 类型转换（trunc/zext/sext/fpext/fptrunc/sitofp/uitofp/fptosi/fptoui）：<tst> <dst> <ist> <inner> → args=[inner]
pub fn tir_e_cast(op: i64, tst: string, dst: string, inner: string) TIRInst {
    var __a: []TirOperand = [];
    append(__a, tir_op(inner));
    return TIRInst{ op: op, st: tir_st_from_str(tst), dst: tir_op(dst), args: __a, is_comment: false, line: g_cur_line, cmt: "" };
}
// 算术/比较：<op>.<st> <dst> <a> <b> → args=[a, b]
pub fn tir_emit_binop(op: i64, st: string, dst: string, a: string, b: string) TIRInst {
    var __a: []TirOperand = [];
    append(__a, tir_op(a));
    append(__a, tir_op(b));
    return TIRInst{ op: op, st: tir_st_from_str(st), dst: tir_op(dst), args: __a, is_comment: false, line: g_cur_line, cmt: "" };
}
