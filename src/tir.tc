            if (nx1 >= 0) {
                arg1n = base.kids[nx1].val;
                var nx2: i64 = base.kids[nx1].next;
                if (nx2 >= 0) { arg2n = base.kids[nx2].val; }
            }
        }
        var elemst: string = "i32";
        if (arg0n >= 0 && base.nodes[arg0n].kind == "int" && str_len(base.nodes[arg0n].sb) > 0) {
            elemst = base.nodes[arg0n].sb;
        } else {
            var rtd2: i64 = sema.meta_type_of_expr(e);
            if (rtd2 >= 0 && rtd2 < slice_len(sema.tds) as i64 && sema.tds[rtd2].cat == "tile") {
