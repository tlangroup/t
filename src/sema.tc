// ── match 穷尽性：enum case 覆盖分析 ────────────────────────────
// 裁定（2026-08-02）：scrutinee 为 enum 且**每个**成员都被一条无守卫的
// `X.Case` 臂覆盖时，该 match 视为穷尽，`_` 通配变为可选。
// 这样给 enum 新增成员会让所有旧 match 立刻报错、强制回访 —— 正是穷尽性检查的价值所在；
// 若一律要求 `_`，新成员会静默落进兜底分支，漏处理无从察觉。

// C2 模式消歧（PascalCase 约定）：模式位置的裸标识符，首字母大写即 CaseName，
// 小写才是绑定名。没有这条约定，`Red => ...` 会被当成不可反驳绑定 ——
// 它匹配一切、让后续所有臂不可达，且完全静默，是最难察觉的一类错。
pub fn starts_upper(name: string) bool {
    if (str_len(name) == 0) {
        return false;
    }
    var c0: u8 = name[0];
    return c0 >= 65 and c0 <= 90;
}

// scrutinee 所属 enum 是否含有名为 cname 的成员。
pub fn enum_has_case(scr: i64, cname: string) bool {
    if (tip_kind(scr) != "Enum") {
        return false;
    }
    var hsi: i64 = sym_lookup(global_scope, tip_name(scr));
    if (hsi < 0) {
        return false;
    }
    var hsym: Sym = syms[hsi];
    if (hsym.decl < 0) {
        return false;
    }
    if (base.node_kind((hsym.decl as u64)) != "EnumDecl") {
        return false;
    }
    var hc: i64 = base.node_lb((hsym.decl as u64));
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环
    var ks2703: []i64 = base.kids_chain(hc);
    var ki2703: i64 = 0;
    while (ki2703 < slice_len(ks2703) as i64) {
        var kv2703: i64 = ks2703[ki2703];
        if (base.node_sa((kv2703 as u64)) == cname) {
            return true;
        }
        ki2703 = ki2703 + 1;
    }
    return false;
}

// 某个 case 名是否被 match 的某条「无守卫」臂以 `X.Case` 形式覆盖。
// 带守卫的臂不算覆盖：守卫可能为假，控制流仍会漏出。
// 只比对 member 模式的字段名而不校验限定符 —— scrutinee 已限定为该 enum，
// 若写成别的 enum 的成员，会先被上面的 arm 模式类型检查拦下。
pub fn match_covers_case(e: i64, cname: string) bool {
    var mc: i64 = base.node_la((e as u64));
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环
    var ks2719: []i64 = base.kids_chain(mc);
    var ki2719: i64 = 0;
    while (ki2719 < slice_len(ks2719) as i64) {
        var kv2719: i64 = ks2719[ki2719];
        if (base.node_nb((kv2719 as u64)) < 0 and base.node_na((kv2719 as u64)) >= 0) {
            if (base.node_kind((base.node_na((kv2719 as u64)) as u64)) == "member" and base.node_sa((base.node_na((kv2719 as u64)) as u64)) == cname) {
                return true;
            }
        }
        ki2719 = ki2719 + 1;
    }
    return false;
}

// scrutinee 类型 scr 若是 enum，判断 match 是否覆盖了它的全部成员。
// 非 enum、查不到声明、或成员表为空 → 一律返回 false（退回「需要 `_`」的旧判据）。
pub fn enum_all_cases_covered(e: i64, scr: i64) bool {
    if (tip_kind(scr) != "Enum") {
        return false;
    }
    var esi: i64 = sym_lookup(global_scope, tip_name(scr));
    if (esi < 0) {
        return false;
    }
    var esym: Sym = syms[esi];
    if (esym.decl < 0) {
        return false;
    }
    if (base.node_kind((esym.decl as u64)) != "EnumDecl") {
        return false;
    }
    if (base.node_lb((esym.decl as u64)) < 0) {
        return false;
    }
    var covered: bool = true;
    var vc: i64 = base.node_lb((esym.decl as u64));
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环
    var ks2753: []i64 = base.kids_chain(vc);
    var ki2753: i64 = 0;
    while (ki2753 < slice_len(ks2753) as i64) {
        var kv2753: i64 = ks2753[ki2753];
        if (match_covers_case(e, base.node_sa((kv2753 as u64))) == false) {
            covered = false;
        }
        ki2753 = ki2753 + 1;
    }
    return covered;
}

// 无守卫臂是否以布尔字面量模式（true / false）覆盖了 want。
// 与 match_covers_case 同构：带守卫的臂不算覆盖（守卫可能为假，控制流仍会漏出）。
// 差别只在模式形态——enum 成员是 `kind=="member"` + sa 存名，bool 字面量是 `kind=="bool"` + ba 存值。
pub fn match_covers_bool(e: i64, want: bool) bool {
    var mc: i64 = base.node_la((e as u64));
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环
    var ks2768: []i64 = base.kids_chain(mc);
    var ki2768: i64 = 0;
    while (ki2768 < slice_len(ks2768) as i64) {
        var kv2768: i64 = ks2768[ki2768];
        if (base.node_nb((kv2768 as u64)) < 0 and base.node_na((kv2768 as u64)) >= 0) {
            if (base.node_kind((base.node_na((kv2768 as u64)) as u64)) == "bool" and base.node_ba((base.node_na((kv2768 as u64)) as u64)) == want) {
                return true;
            }
        }
        ki2768 = ki2768 + 1;
    }
    return false;
}

// scrutinee 类型若是 bool，判断 match 是否同时覆盖了 true 与 false —— 二者即 bool 值域全集，
// 此时不必再要求 `_` 兜底。
// 修复前：穷尽性只认 member 模式（enum / variant），bool 被当成「无 member 模式的普通标量」，
// 一律退回「需要 `_`」的旧判据 ⇒ 对 `match (c) { true => A, false => B }` 是**假阴性**
// （本就穷尽却报 T-MAT-E742）。该形态正是值 `if` 的脱糖目标形态，故此修复是 P1 的前置。
pub fn bool_all_cases_covered(e: i64, scr: i64) bool {
    if (tip_kind(scr) != "Scalar") {
        return false;
    }
    if (tip_name(scr) != "bool") {
        return false;
    }
    if (match_covers_bool(e, true) == false) {
        return false;
    }
    if (match_covers_bool(e, false) == false) {
        return false;
    }
    return true;
}

// 未被覆盖的 enum 成员，形如 `Color.Green, Color.Blue`；非 enum 或已全覆盖时返回空串。
// 供 T_MATCH_NONEXHAUSTIVE 指名道姓地报缺口，而不是只说「加个 `_`」。
pub fn enum_missing_cases(e: i64, scr: i64) string {
    if (tip_kind(scr) != "Enum") {
        return "";
    }
    var esi: i64 = sym_lookup(global_scope, tip_name(scr));
    if (esi < 0) {
        return "";
    }
    var esym: Sym = syms[esi];
    if (esym.decl < 0) {
        return "";
    }
    if (base.node_kind((esym.decl as u64)) != "EnumDecl") {
        return "";
    }
    var sb: StringBuilder = sb_new();
    var cnt: i64 = 0;
    var vc: i64 = base.node_lb((esym.decl as u64));
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环
    var ks2821: []i64 = base.kids_chain(vc);
    var ki2821: i64 = 0;
    while (ki2821 < slice_len(ks2821) as i64) {
        var kv2821: i64 = ks2821[ki2821];
        if (match_covers_case(e, base.node_sa((kv2821 as u64))) == false) {
            if (cnt > 0) {
                sb_append_str(sb, ", ");
            }
            sb_append_str(sb, tip_name(scr));
            sb_append_str(sb, ".");
            sb_append_str(sb, base.node_sa((kv2821 as u64)));
            cnt = cnt + 1;
        }
        ki2821 = ki2821 + 1;
    }
    return sb_to_str(sb);
}

// ── ADT：variant 构造器模式 / 穷尽性（docs/syntax/drafts/adt_variant.md）──────

// scrutinee 类型 scr 若是 variant，返回其 VariantDecl 节点索引；否则 -1。
pub fn variant_decl_of(scr: i64) i64 {
    if (tip_kind(scr) != "Variant") {
        return -1;
    }
    var vsi: i64 = sym_lookup(global_scope, tip_name(scr));
    if (vsi < 0) {
        return -1;
    }
    var vsym: Sym = syms[vsi];
    if (vsym.decl < 0) {
        return -1;
    }
    if (base.node_kind((vsym.decl as u64)) != "VariantDecl") {
        return -1;
    }
    return vsym.decl;
}

// 按名字在 VariantDecl 的 case 链上找 VC 节点；找不到 -1。
pub fn variant_find_case(d: i64, cname: string) i64 {
    if (d < 0) {
        return -1;
    }
    var c: i64 = base.node_lb((d as u64));
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环
    var ks2864: []i64 = base.kids_chain(c);
    var ki2864: i64 = 0;
    while (ki2864 < slice_len(ks2864) as i64) {
        var kv2864: i64 = ks2864[ki2864];
        if (base.node_sa((kv2864 as u64)) == cname) {
            return kv2864;
        }
        ki2864 = ki2864 + 1;
    }
    return -1;
}

// M5 / P1 静默错编治理：枚举 / 变体 / 位域类型的**成员名存在性**校验。
// 背景：此前 `Color.NotExistAtAll` 与 `Color.Red` 走同一条路径、返回同一类型且零诊断，
// 后端把它当结构体字段访问发射（对 enum 发 GEP 必然非法），报错形态与真实病因（成员名拼错）
// 完全无关，极难定位。与 struct 的 T-SEM-E208 对齐，此处报 T-SEM-E216。
//
// 返回 true = 成员存在，或**无法判定**（类型符号/声明节点缺失、kind 非三类之一）⇒ 一律放行，
// 以免在解析不全的路径上产生误报。仅当「确实查到了声明且确实没有该成员」时才返回 false。
pub fn member_exists_in_type(obt: i64, mname: string) bool {
    var msi: i64 = sym_lookup(global_scope, tip_name(obt));
    if (msi < 0) { return true; }
    var msy: Sym = syms[msi];
    if (msy.decl < 0) { return true; }
    var mdk: string = base.node_kind((msy.decl as u64));
    if (mdk != "EnumDecl" and mdk != "VariantDecl") { return true; }
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环。用 kids_chain（取 node id 比对
    // node_sa），不用 kids_chain_idx（本循环不把游标当 kids entry 索引使用）。
    var ks7730: []i64 = base.kids_chain(base.node_lb((msy.decl as u64)));
    var ki7730: i64 = 0;
    while (ki7730 < slice_len(ks7730) as i64) {
        var kv7730: i64 = ks7730[ki7730];
        if (base.node_sa((kv7730 as u64)) == mname) { return true; }
        ki7730 = ki7730 + 1;
    }
    return false;
}

// 反向查表：case 名 → 它所属 variant 的类型名（如 Circle → Shape）。
// 扫描 decl_list 找含该 case 的 VariantDecl；找不到返回 ""。供 variant 构造器裸名
// 脱糖用（Circle(5) → Shape_from_Circle(5)）。同名 case 跨 variant 时取首个匹配。
//
// ⚠ M5 修复（P0 静默错编）：若上下文已通过 g_lead_expect 注入期望变体类型，且它确实
// 含该 case，优先返回该变体名——否则全局首个匹配在「同名 case 跨多个 variant」时会取错
// 变体，使 `.Circle` 被脱糖成错误构造器（如 B_from_Circle）而静默错编。g_lead_expect 是
// Variant 但不含该 case 时 `break` 走全局兜底，与修复前行为一致。
pub fn variant_name_of_case(cname: string) string {
    if (g_lead_expect >= 0) {
        if (tip_kind(g_lead_expect) == "Variant") {
            var exp_name: string = tip_name(g_lead_expect);
            var n0: i64 = slice_len(lex__decl_list) as i64;
            var i0: i64 = 0;
            while (i0 < n0) {
                var d0: i64 = lex__decl_list[i0];
                if (base.node_kind((d0 as u64)) == "VariantDecl" and base.node_sa((d0 as u64)) == exp_name) {
                    if (variant_find_case(d0, cname) >= 0) {
                        return exp_name;
                    }
                    break;  // 期望变体存在但不含该 case ⇒ 走全局兜底
                }
                i0 = i0 + 1;
            }
        }
    }
    var n: i64 = slice_len(lex__decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = lex__decl_list[i];
        if (base.node_kind((d as u64)) == "VariantDecl") {
            if (variant_find_case(d, cname) >= 0) {
                return base.node_sa((d as u64));
            }
        }
        i = i + 1;
    }
    return "";
}

// 把 match 臂里的前导点变体模式（`.Empty` / `.Circle(r)`）改写成与之等价的 conpat 节点，
// 使其与 `Shape.Circle(r)` 具名形式走同一条 conpat_check 解构路径。非变体前导点模式返回 -1。
pub fn leading_dot_to_conpat(pat: i64, scr: i64) i64 {
    if (pat < 0) { return -1; }
    if (tip_kind(scr) != "Variant") { return -1; }
    // 变体 scrutinee 上的前导点 `.X` 一律当作 case 模式：无论 X 是否为合法 case，都生成 conpat
    // 交给 conpat_check 验证（未知 case → T_MATCH_UNKNOWN_CASE；arity 错 → T_MATCH_PATTERN_ARITY）。
    // 不在此处用 variant_find_case 预筛——否则未知 case（如拼错的 `.Circl(r)`）会漏过 conpat_check
    // 而误报 T-DOT-E102；注入变体 TypeInfo 的 case 也不在 lex__decl_list，预筛同样取不到名。
    // 无 payload：`.Empty` → member{sa, na=-1, lb=1}
    if (base.node_kind((pat as u64)) == "member" and base.node_lb((pat as u64)) == 1 and base.node_na((pat as u64)) < 0) {
        return base.mk_conpat(base.node_sa((pat as u64)), "", -1, 0, -1);
    }
    // 带 payload：`.Circle(r)` → call{na=parse.member(.Circle), la=[r]}
    if (base.node_kind((pat as u64)) == "call") {
        if (base.node_kind((base.node_na((pat as u64)) as u64)) == "member" and base.node_lb((base.node_na((pat as u64)) as u64)) == 1 and base.node_na((base.node_na((pat as u64)) as u64)) < 0) {
            var argc: i64 = 0;
            var hp: i64 = base.node_la((pat as u64));
            // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环
            var ks2910: []i64 = base.kids_chain(hp);
            var ki2910: i64 = 0;
            while (ki2910 < slice_len(ks2910) as i64) {
                argc = argc + 1;
                ki2910 = ki2910 + 1;
            }
            return base.mk_conpat(base.node_sa((base.node_na((pat as u64)) as u64)), "", base.node_la((pat as u64)), argc, -1);
        }
        return -1;
    }
    return -1;
}

// 该 variant 是否为「抽象 / 非穷尽（open）」——声明末位写了 `_`（VariantDecl.ba）。
pub fn variant_is_abstract(scr: i64) bool {
    var d: i64 = variant_decl_of(scr);
    if (d < 0) {
        return false;
    }
    return base.node_ba((d as u64));
}

// 合法 case 名列表，形如 `Circle, Rect, Empty`（供 T_MATCH_UNKNOWN_CASE 指路）。
pub fn variant_case_list(d: i64) string {
    var sb: StringBuilder = sb_new();
    var cnt: i64 = 0;
    var c: i64 = base.node_lb((d as u64));
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环
    var ks2936: []i64 = base.kids_chain(c);
    var ki2936: i64 = 0;
    while (ki2936 < slice_len(ks2936) as i64) {
        var kv2936: i64 = ks2936[ki2936];
        if (cnt > 0) {
            sb_append_str(sb, ", ");
        }
        sb_append_str(sb, base.node_sa((kv2936 as u64)));
        cnt = cnt + 1;
        ki2936 = ki2936 + 1;
    }
    return sb_to_str(sb);
}

// 某 case 是否被一条**无守卫**的构造器模式臂覆盖（带守卫不计，同 enum 的 match_covers_case）。
pub fn variant_covers_case(e: i64, cname: string) bool {
    var mc: i64 = base.node_la((e as u64));
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环
    var ks2951: []i64 = base.kids_chain(mc);
    var ki2951: i64 = 0;
    while (ki2951 < slice_len(ks2951) as i64) {
        var kv2951: i64 = ks2951[ki2951];
        if (base.node_nb((kv2951 as u64)) < 0 and base.node_na((kv2951 as u64)) >= 0) {
            if (base.node_kind((base.node_na((kv2951 as u64)) as u64)) == "conpat" and base.node_sa((base.node_na((kv2951 as u64)) as u64)) == cname) {
                return true;
            }
        }
        ki2951 = ki2951 + 1;
    }
    return false;
}

// A1 推广：variant 的全部具名 case 是否都被无守卫臂覆盖。
pub fn variant_all_cases_covered(e: i64, scr: i64) bool {
    var d: i64 = variant_decl_of(scr);
    if (d < 0) {
        return false;
    }
    if (base.node_lb((d as u64)) < 0) {
        return false;
    }
    var covered: bool = true;
    var vc: i64 = base.node_lb((d as u64));
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环
    var ks2974: []i64 = base.kids_chain(vc);
    var ki2974: i64 = 0;
    while (ki2974 < slice_len(ks2974) as i64) {
        var kv2974: i64 = ks2974[ki2974];
        if (variant_covers_case(e, base.node_sa((kv2974 as u64))) == false) {
            covered = false;
        }
        ki2974 = ki2974 + 1;
    }
    return covered;
}

// 未覆盖的 case，形如 `Shape.Rect, Shape.Empty`；非 variant 或已全覆盖返回空串。
pub fn variant_missing_cases(e: i64, scr: i64) string {
    var d: i64 = variant_decl_of(scr);
    if (d < 0) {
        return "";
    }
    var sb: StringBuilder = sb_new();
    var cnt: i64 = 0;
    var vc: i64 = base.node_lb((d as u64));
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环
    var ks2993: []i64 = base.kids_chain(vc);
    var ki2993: i64 = 0;
    while (ki2993 < slice_len(ks2993) as i64) {
        var kv2993: i64 = ks2993[ki2993];
        if (variant_covers_case(e, base.node_sa((kv2993 as u64))) == false) {
            if (cnt > 0) {
                sb_append_str(sb, ", ");
            }
            sb_append_str(sb, tip_name(scr));
            sb_append_str(sb, ".");
            sb_append_str(sb, base.node_sa((kv2993 as u64)));
            cnt = cnt + 1;
        }
        ki2993 = ki2993 + 1;
    }
    return sb_to_str(sb);
}

// 构造器模式的语义检查 + 决议（递归，支持嵌套解构）。
//   pat = conpat 节点，scr = 被解构值的静态类型（ti）
// 决议结果回填 conpat：ia = case 下标（tag）、sc = variant 类型名（后端据此拼 `<V>_is_<C>`）。
// 载荷绑定在**当前作用域**（调用方已为该臂开了子作用域）中 sym_define。
pub fn conpat_check(pat: i64, scr: i64, rep: bool) void {
    var d: i64 = variant_decl_of(scr);
    if (d < 0) {
        if (rep) {
            parse.fc_err("T-MAT-E740",
                base.sb_cat3("构造器模式 `", base.node_sa((pat as u64)),
                    "(...)` 只能用于 variant，被匹配值不是 variant 类型"), pat);
        }
        return;
    }
    var vname: string = tip_name(scr);
    // 限定写法 `Shape.Circle(...)`：限定符必须与 scrutinee 的 variant 同名
    if (str_len(base.node_sb((pat as u64))) > 0 and base.node_sb((pat as u64)) != vname) {
        if (rep) {
            parse.fc_err("T-MAT-E740",
                base.sb_cat5("构造器模式限定符 `", base.node_sb((pat as u64)), "` 与被匹配值类型 ", vname, " 不符"), pat);
        }
        return;
    }
    var vc: i64 = variant_find_case(d, base.node_sa((pat as u64)));
    if (vc < 0) {
        if (rep) {
            parse.fc_err("T-MAT-E740",
                base.sb_cat5("variant ", vname, " 没有名为 `", base.node_sa((pat as u64)),
                    base.sb_cat3("` 的 case —— 合法 case：", variant_case_list(d), "")), pat);
        }
        return;
    }
    // 载荷个数：单元 0、单载荷 1、多载荷 = vcn.ib（>=2，载荷类型链在 vcn.lb）
    var want: i64 = 0;
    if (base.node_lb((vc as u64)) >= 0) {
        want = base.node_ib((vc as u64));   // S4 §0.14.7 SoA：侧表读（原 vcn.ib）
    } else if (base.node_na((vc as u64)) >= 0) {
        want = 1;
    }
    var got: i64 = base.node_ib((pat as u64));   // S4 §0.14.7 SoA：侧表读（原 pn.ib）
    if (got != want) {
        if (rep) {
            parse.fc_err("T-MAT-E743",
                base.sb_cat5("构造器模式 `", base.node_sa((pat as u64)), "` 载荷个数不符：声明 ",
                    base.i2s(want), base.sb_cat3(" 个，模式写了 ", base.i2s(got), " 个")), pat);
        }
        return;
    }
    // 回填决议结果（供双后端脱糖）
    base.node_set_ia((pat as u64), base.node_ia((vc as u64)));
    base.node_set_sc((pat as u64), vname);   // S4 §0.14.7 SoA：取代 `pn.sc`（下方 slice_set 回写生效）
    // 载荷字段类型节点（供后端取 C 类型拼 `<V>_as_<C>` 绑定；unit case 为 -1）
    base.node_set_na((pat as u64), base.node_na((vc as u64)));
    if (want == 0) {
        return;
    }
    // 多载荷载荷类型链；单载荷恒为 vcn.na
    var plist_head: i64 = -1;
    if (base.node_lb((vc as u64)) >= 0) {
        plist_head = base.node_lb((vc as u64));
    }
    var bi: i64 = 0;
    var sc: i64 = base.node_la((pat as u64));
    var mq_ks3131: []i64 = base.kids_chain_idx(base.node_la((pat as u64)));
    var mq_ki3131: i64 = 0;
    while (mq_ki3131 < slice_len(mq_ks3131) as i64) {
        sc = mq_ks3131[mq_ki3131];
        var sk: Child = base.kids[sc];
        // 第 bi 个载荷的类型节点
        var ptnode: i64 = base.node_na((vc as u64));
        if (plist_head >= 0) {
            var lt: i64 = plist_head;
            var lk: i64 = 0;
            while (lk < bi) {
                lt = base.kids[lt].next;
                lk = lk + 1;
            }
            ptnode = base.kids[lt].val;
        }
        var pti: i64 = resolve_ti(ptnode);
        if (base.node_kind((sk.val as u64)) == "conpat") {
            // 嵌套解构：以该载荷类型为新的 scrutinee 递归
            conpat_check(sk.val, pti, rep);
        } else if (base.node_kind((sk.val as u64)) == "ident") {
            // `_` 只占位不绑定；其余名字绑定该载荷（仅在本臂内可见）
            if (base.node_sa((sk.val as u64)) != "_") {
                sym_define(cur_scope, base.node_sa((sk.val as u64)), "var", pti, -1);
                base.node_set_na((sk.val as u64), ptnode);
            }
        } else {
            // 字面量子模式：与载荷类型比对（等值匹配语义）
            var lt: i64 = infer_expr(sk.val);
            if (rep and tip_kind(lt) != "Unknown" and tip_kind(pti) != "Unknown") {
                if (ti_equal(lt, pti) == false and can_cast(lt, pti) == false) {
                    err_type_mismatch(sk.val, pti, lt);
                }
            }
        }
        bi = bi + 1;
        mq_ki3131 = mq_ki3131 + 1;
        sc = -1;
    }
}

// ── struct / 具名元组 字面量模式解构绑定（KI-002 + 解构绑定 §8.2）──
// 命名字段形式 `Pt{ x: a, y: b }` / `IntPair{ ._0 = a, ._1 = b }`（均解析为 struct_lit 节点）。
//   · ident 值字段 = 绑定（声明为本臂子作用域局部，类型取字段声明类型；`_ ` 仅占位）
//   · 字面量值字段 = 与字段类型比对（等值匹配语义，沿用既有）
//   · 模式结构名须与被匹配值类型一致；未知字段名 / 非 struct 类型 → 诊断
// 仅处理模式位（match 臂 m_an.na）；表达式位的 struct_lit 构造照常走 infer。
// 条件生成（字面量比较）与绑定提取（ident）分别在 tir / codegen_c 的 match 发射期完成。
pub fn struct_lit_pat_check(pat: i64, scr: i64, rep: bool) void {
    var sname: string = base.node_sa((pat as u64));
    if (sname == "" and scr >= 0) {
        // 匿名元组 / 匿名结构模式：scrutinee 是 TI（TD 索引），直接取类型名
        // （含匿名元组合成结构名）。⚠ 切勿用 resolve_ti(scr) —— resolve_ti 把入参当
        // 节点 id 解析，scr 是 TI 索引会越界 panic（t_slice_at OOB）。同文件 line 3120
        // 的 tip_name(scr) 即此语义。
        sname = tip_name(scr);
    }
    // 模式结构名须与被匹配值类型一致（无名元组由 scrutinee 反查，此处 sname=="" 已被填上）
    if (base.node_sa((pat as u64)) != "" and scr >= 0 and tip_name(scr) != sname) {
        if (rep) {
            parse.fc_err("T-MAT-E741",
                base.sb_cat5("字面量模式类型 `", sname, "` 与被匹配值类型 `", tip_name(scr), "` 不符"), pat);
        }
        return;
    }
    var fh: i64 = sema.find_struct_fields(sname);
    if (fh < 0) {
        if (rep) {
            parse.fc_err("T-MAT-E741",
                base.sb_cat3("字面量模式类型 `", sname, "` 不是 struct / 元组，无法做字段解构"), pat);
        }
        return;
    }
    var fvp: i64 = base.node_la((pat as u64));
    var pos_idx: i64 = 0;   // 位置式（sa==""）字段按列表下标映射到结构第 i 个字段
    var mq_ks3202: []i64 = base.kids_chain_idx(base.node_la((pat as u64)));
    var mq_ki3202: i64 = 0;
    while (mq_ki3202 < slice_len(mq_ks3202) as i64) {
        fvp = mq_ks3202[mq_ki3202];
        var fname: string = base.node_sa((base.kids[fvp].val as u64));
        // 位置式（如 `.{a, b}` / `Name{a, b}`）：按列表下标取结构第 pos_idx 个字段名。
        var eff_name: string = fname;
        if (fname == "") {
            eff_name = sema.struct_field_name_at(sname, pos_idx);
            pos_idx = pos_idx + 1;
        }
        // 取字段声明类型节点（同时校验字段存在）
        var ftnode: i64 = -1;
        var fc: i64 = fh;
        // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环
        var ks3154: []i64 = base.kids_chain(fc);
        var ki3154: i64 = 0;
        while (ki3154 < slice_len(ks3154) as i64) {
            var kv3154: i64 = ks3154[ki3154];
            if (base.node_sa((kv3154 as u64)) == eff_name) { ftnode = base.node_na((kv3154 as u64)); break; }
            ki3154 = ki3154 + 1;
        }
        if (ftnode < 0) {
            if (rep) {
                if (fname == "") {
                    parse.fc_err("T-MAT-E741",
                        base.sb_cat5("struct `", sname, "` 没有第 ", base.i2s(pos_idx - 1), " 个字段（位置式模式越界）"), pat);
                } else {
                    parse.fc_err("T-MAT-E741",
                        base.sb_cat3("struct `", sname, base.sb_cat3("` 没有字段 `", fname, "`")), pat);
                }
            }
            mq_ki3202 = mq_ki3202 + 1;
            continue;
        }
        var fti: i64 = resolve_ti(ftnode);
        var fval: i64 = base.node_na((base.kids[fvp].val as u64));
        if (fval >= 0 and base.node_kind((fval as u64)) == "ident") {
            // 绑定：声明为本臂子作用域局部（仅本臂可见，遮蔽外层同名）
            if (base.node_sa((fval as u64)) != "_") {
                sym_define(cur_scope, base.node_sa((fval as u64)), "var", fti, -1);
            }
        } else if (fval >= 0) {
            // 字面量：与字段类型比对（等值匹配语义）
            var lt: i64 = infer_expr(fval);
            if (rep and tip_kind(lt) != "Unknown" and tip_kind(fti) != "Unknown") {
                if (ti_equal(lt, fti) == false and can_cast(lt, fti) == false) {
                    err_type_mismatch(fval, fti, lt);
                }
            }
        }
        mq_ki3202 = mq_ki3202 + 1;
        fvp = -1;
    }
}

// ── 文件描述符内建的编译期校验（M51）──────────────────────────

pub fn fid_atom_allowed(sel: string) string {
    if (sel == "mode") {
        return ":read / :write / :append / :read_binary / :write_binary / :append_binary";
    }
    if (sel == "kind") {
        return ":text / :binary";
    }
    return ":text / :json / :rawbin / :protobuf";
}

pub fn fid_atom_ok(sel: string, v: string) bool {
    if (sel == "mode") {
        if (v == "read" or v == "write" or v == "append") {
            return true;
        }
        return v == "read_binary" or v == "write_binary" or v == "append_binary";
    }
    if (sel == "kind") {
        return v == "text" or v == "binary";
    }
    return v == "text" or v == "json" or v == "rawbin" or v == "protobuf";
}

// 诊断码分轴：mode 轴（fopen 打开方式）与 format 轴（fmt_register 的类别 / 格式）
// 各自成码 —— 「格式取值非法」却报 BAD_MODE 会误导定位。
pub fn fid_code_lit(sel: string) string {
    if (sel == "mode") { return "T-FID-E651"; }
    return "T-FID-E662";
}
pub fn fid_code_bad(sel: string) string {
    if (sel == "mode") { return "T-FID-E652"; }
    return "T-FID-E653";
}

// atom 形参必须是字面量且取值在白名单内 —— 打开方式 / 格式决定字节形态，
// 若允许运行期取值，`<` 的语义就不再是编译期确定的（违反 L-02 / L-03）。
pub fn check_atom_arg(a: i64, what: string, sel: string, anchor: i64) void {
    if (a < 0) {
        parse.fc_err(fid_code_lit(sel),
            base.sb_cat3(what, " 缺失；必须是 atom 字面量，取值：", fid_atom_allowed(sel)), anchor);
        return;
    }
    if (base.node_kind((a as u64)) != "atom") {
        parse.fc_err(fid_code_lit(sel),
            base.sb_cat3(what, " 必须是 atom **字面量**（编译期可判定），取值：", fid_atom_allowed(sel)), a);
        return;
    }
    if (fid_atom_ok(sel, base.node_sa((a as u64))) == false) {
        parse.fc_err(fid_code_bad(sel),
            base.sb_cat6(what, " 取值非法：`:", base.node_sa((a as u64)), "`；合法取值：", fid_atom_allowed(sel), ""), a);
    }
}

// 时间格式化 spec 字段码扫描（M56/M57）：编译期校验 format_time / format_time_local /
// format_time_tz 的 spec 字面量。已知字段码：
//   最小集 %Y %y %m %d %H %M %S %f %%
//   扩展集 %a %A %b %B %p %I %j %w %U %W %z %Z
//   locale 集（M57）%c %x %X
// 其余 `%?` 一律报 T_TIME_BAD_SPEC。运行期对非常量 spec 宽容原样保留。
pub fn check_time_spec(spec: string, d: i64) void {
    var sl: u64 = str_len(spec);
    var i: u64 = 0;
    while (i < sl) {
        var c: i64 = spec[i] as i64;
        if (c != 37) {                 // '%'
            i = i + 1;
            continue;
        }
        if (i + 1 >= sl) {
            parse.fc_err("T-TIM-E700",
                "时间格式串以 `%` 结尾，缺少后续字段码；合法示例：`%Y-%m-%d %H:%M:%S`", d);
            return;
        }
        var x: i64 = spec[i + 1] as i64;
        if (x == 89 or x == 121 or x == 109 or x == 100 or x == 72
            or x == 77 or x == 83 or x == 102 or x == 37
            or x == 97 or x == 65 or x == 98 or x == 66 or x == 112
            or x == 73 or x == 106 or x == 119 or x == 85 or x == 87
            or x == 122 or x == 90
            or x == 99 or x == 120 or x == 88) {
            i = i + 2;                 // Y y m d H M S f % a A b B p I j w U W z Z c x X
            continue;
        }
        parse.fc_err("T-TIM-E700",
            "时间格式串含未知字段码（以 `%` 打头的非法保留序列）；支持 %Y %y %m %d %H %M %S %f %% %a %A %b %B %p %I %j %w %U %W %z %Z %c %x %X",
            d);
        i = i + 2;
    }
}

// 时间**解析** spec 字段码扫描（M57）：parse_time / parse_time_local 的白名单
// 严格小于格式化白名单 —— %w %U %W 是从日期推导出的派生量，反过来定不出唯一时刻；
// %Z 是自由文本时区缩写（"CST" 同时是北京和美中部），无从消歧。四者一律拒绝，
// 而不是运行期静默返回哨兵：让"这个串根本不该用于解析"在编译期就暴露。
pub fn check_time_parse_spec(spec: string, d: i64) void {
    var sl: u64 = str_len(spec);
    var i: u64 = 0;
    while (i < sl) {
        var c: i64 = spec[i] as i64;
        if (c != 37) {
            i = i + 1;
            continue;
        }
        if (i + 1 >= sl) {
            parse.fc_err("T-TIM-E700",
                "时间解析串以 `%` 结尾，缺少后续字段码；合法示例：`%Y-%m-%d %H:%M:%S`", d);
            return;
        }
        var x: i64 = spec[i + 1] as i64;
        if (x == 89 or x == 121 or x == 109 or x == 100 or x == 72
            or x == 77 or x == 83 or x == 102 or x == 37
            or x == 97 or x == 65 or x == 98 or x == 66 or x == 112
            or x == 73 or x == 106 or x == 122
            or x == 99 or x == 120 or x == 88) {
            i = i + 2;                 // Y y m d H M S f % a A b B p I j z c x X
            continue;
        }
        if (x == 119 or x == 85 or x == 87 or x == 90) {
            parse.fc_err("T-TIM-E701",
                "时间解析不支持该字段码：%w / %U / %W 是日期的派生量（无法反推唯一日期），%Z 是有歧义的时区缩写；请改用 %z 表示数值偏移",
                d);
            i = i + 2;
            continue;
        }
        parse.fc_err("T-TIM-E700",
            "时间解析串含未知字段码（以 `%` 打头的非法保留序列）；解析支持 %Y %y %m %d %H %M %S %f %% %a %A %b %B %p %I %j %z %c %x %X",
            d);
        i = i + 2;
    }
}

// 数字/字符串格式化 spec 文法校验（M54/M55 补充）：编译期校验 format_int / format_uint /
// format_float / format_str / format_bool / format_char 的 spec 字面量。
// 复刻 runtime/t_runtime.c fmt_parse 的外壳剥除（剥 {} 仅当首尾都是；剥到最后一个 ':'），
// 并在文法解析后强制"无残留字符"。因此能拦住 {:z}（非法 type）、{:>10z}（残留）这类
// 运行期会被静默吞掉的笔误。非常量 spec 维持运行期宽松（fmt_parse 贪婪吞尾）。
pub fn check_fmt_spec(spec: string, d: i64) void {
    var sl: u64 = str_len(spec);
    // 是否像「模板」（含替换字段 {…}）：用户常把 format_int 当成 str.format 用，
    // 写了 "x={0}" 这类带字面量文本的串；此时报错顺手提示改用 format()。
    var g_tmpl_hint: bool = false;
    var gi: u64 = 0;
    while (gi < sl) { if ((spec[gi] as i64) == 123) { g_tmpl_hint = true; } gi = gi + 1; }
    var start: u64 = 0;
    var end: u64 = sl;
    if (sl >= 2 and (spec[0] as i64) == 123 and (spec[sl - 1] as i64) == 125) { start = 1; end = sl - 1; } // 剥 {}
    var j: u64 = start;
    var lc: i64 = -1;
    while (j < end) { if ((spec[j] as i64) == 58) { lc = j as i64; } j = j + 1; }  // 最后一个 ':'
    if (lc >= 0) { start = (lc + 1) as u64; }
    var i: u64 = start;
    // [fill]align
    if (end - i >= 2) {
        var c1: i64 = spec[i] as i64;
        var c2: i64 = spec[i + 1] as i64;
        if (c2 == 60 or c2 == 62 or c2 == 61 or c2 == 94) { i = i + 2; }       // < > = ^
        else if (c1 == 60 or c1 == 62 or c1 == 61 or c1 == 94) { i = i + 1; }
    } else if (end - i >= 1) {
        var c1: i64 = spec[i] as i64;
        if (c1 == 60 or c1 == 62 or c1 == 61 or c1 == 94) { i = i + 1; }
    }
    if (end - i >= 1) { var c: i64 = spec[i] as i64; if (c == 43 or c == 45 or c == 32) { i = i + 1; } } // + - ' '
    if (end - i >= 1) { var c: i64 = spec[i] as i64; if (c == 35) { i = i + 1; } }                     // '#'
    if (end - i >= 1) { var c: i64 = spec[i] as i64; if (c == 48) { i = i + 1; } }                     // '0'
    while (end - i >= 1) { var c: i64 = spec[i] as i64; if (c >= 48 and c <= 57) { i = i + 1; } else { break; } } // width
    if (end - i >= 1) { var c: i64 = spec[i] as i64; if (c == 44 or c == 95) { i = i + 1; } }           // ',' '_'
    if (end - i >= 1) { var c: i64 = spec[i] as i64; if (c == 46) {                                       // '.' precision
        i = i + 1;
        while (end - i >= 1) { var d2: i64 = spec[i] as i64; if (d2 >= 48 and d2 <= 57) { i = i + 1; } else { break; } }
    } }
    var has_type: bool = false;
    var tc: i64 = 0;
    if (end - i >= 1) { has_type = true; tc = spec[i] as i64; i = i + 1; }
    if (has_type) {
        // 允许的类型字符集（与 reference.md §3.10.2 一致）；'!' 是 format_bool 的专属
        // 合法 type（runtime t_format_bool 对未识别 type 一律走 true/false 分支，故 lenient）。
        var ok: bool = (tc == 98 or tc == 99 or tc == 100 or tc == 101 or tc == 69
            or tc == 102 or tc == 70 or tc == 103 or tc == 71 or tc == 110
            or tc == 111 or tc == 115 or tc == 120 or tc == 88 or tc == 37
            or tc == 33); // b c d e E f F g G n o s x X %  + '!'(bool)
        if (!ok) {
            var m1: string = "格式化 spec 含非法类型字符；M54 允许的 type 为 b c d e E f F g G n o s x X %";
            if (g_tmpl_hint) {
                m1 = base.sb_cat2(m1, "；若需带字面量文本的模板（如 \"x={0}\"），请改用 str.format：format(\"x={0}\", v) 或 \"x={0}\".format(v)");
            }
            parse.fc_err("T-FST-E300", m1, d);
            return;
        }
    }
    if (i < end) {
        var m2: string = "格式化 spec 文法非法（含无法解析的残留字符）；合法示例：\":>10\" \"{:>10.2f}\" \"#x\" \"{:,}\"";
        if (g_tmpl_hint) {
            m2 = base.sb_cat2(m2, "；若需带字面量文本的模板（如 \"x={0}\"），请改用 str.format：format(\"x={0}\", v) 或 \"x={0}\".format(v)");
        }
        parse.fc_err("T-FST-E300", m2, d);
    }
}

// 序列化右操作数类型白名单（M51 v1）：标量（含 atom / bool / 浮点）与 string。
// 结构体 / slice / map 需走 type_info 反射逐字段展开，留待 v2。
pub fn check_serializable(e: i64, sti: i64) void {
    var k: string = tip_kind(sti);
    if (k == "Scalar" or k == "String" or k == "Unknown") {
        return;
    }
    parse.fc_err("T-FID-E654",
        base.sb_cat3("`<` 不支持序列化该类型：", ti_str(sti),
            "；v1 仅支持标量（整数 / 浮点 / bool / atom / fid）与 string，聚合类型请逐字段写出"), e);
}

// ── format 模板替换字段（M55）──────────────────────────────
//
// Python `str.format` 分两层：**替换字段**（`{0}` 选第几个实参）与**格式规范**
// （`:` 之后的 `>10.2f`，M54 已实现）。这里补上层。
//
// t 无变参、无 kwargs、无 Any，做不出运行期模板引擎，故三条硬约束：
//   ① 模板必须是字符串**字面量** —— 编译期解析，运行期零模板开销（L-03 静态优先）
//   ② 只有位置索引 `{0}` 与自动编号 `{}`；`{name}` 无 kwargs 可查，直接报错
//   ③ 脱糖成提升函数 `__fmt_N`，体内 StringBuilder 顺序拼接，实参按值传入
//
// 实参在**调用点**求值一次后传参，故 `"{0} {0}"` 只求值一次 —— 这是提升函数
// 相对宏展开的关键优势（`format("{0}{0}", next())` 不会调用两次 next）。
pub var g_fmt_counter: i64;
pub var g_fmt_ak: [64]i64;   // 各值实参的种类码（见 fmt_kind_of）
pub var g_fmt_at: [64]i64;   // 各值实参对应的形参类型节点
pub var g_fmt_ti: [64]i64;   // 各值实参对应的静态 TI（取位宽/符号用）
pub var g_fmt_json_ti: [64]i64;   // A1a：聚合实参的原始 TI（!j 递归编码用）
pub var g_fmt_json: [64]bool;     // A1a：第 i 个值实参是否为聚合类型（须用 !j 编码）
pub var g_fmt_jsym: i64;          // A1a：JSON 合成体内部局部变量名计数器
// 当前正在 check 的函数声明 id（check_func_decl 进出时维护）。用于 format 脱糖判据：
// 若正处于「泛型模板」体内（comptime 形参未绑定），此刻脱糖拿不到实参的静态类型，
// 须跳过并把 `format` 节点留给实例（单态化、类型已具体）在 instantiate_generic 里再脱糖。
pub var g_cur_func_decl: i64 = -1;

// 值类型 → 种类码。-1 表示不可格式化（聚合类型等）。
// ⚠ 整数字面量按最小无符号宽度推断（`42` 是 u8），故必须按名字判有无符号，
//    不能只比 "i64"，否则 `format("{0}", 42)` 会错走有符号通道。
pub fn fmt_kind_of(t: i64) i64 {
    var k: string = tip_kind(t);
    if (k == "String") { return 3; }
    if (k == "Scalar") {
        var nm: string = tip_name(t);
        if (nm == "bool") { return 4; }
        if (is_float_name(nm)) { return 2; }
        // 任意位宽整数：无符号 u<N> → 1，有符号 i<N> → 0（含 u8..u64 / i8..i64 /
        // u2..u65535 / i2..i65535）。'u' 的 ASCII 是 117，'i' 是 105。
        if (str_len(nm) > 0 and nm[0] == 117) { return 1; }
        if (is_int_name(nm)) { return 0; }
    }
    return -1;
}

pub fn fmt_append_fn(k: i64) string {
    if (k == 0) { return "sb_append_fmt_int"; }
    if (k == 1) { return "sb_append_fmt_uint"; }
    if (k == 2) { return "sb_append_fmt_float"; }
    if (k == 3) { return "sb_append_fmt_str"; }
    return "sb_append_fmt_bool";
}

// ── 转换字段 `!s|!r|!a|!j|!c|!p`（M-fstr）────────────────────
// 语义（与 CPython 同构：**先转换成字符串，再套格式规范**）：
//   !s  str    —— 默认表示，等价于不写转换字段
//   !r  repr   —— 调试表示：字符串加引号并转义（数值/bool 与 !s 相同）
//   !a  ascii  —— repr 之上再把非 ASCII 字节转义成 \xHH
//   !j  json   —— JSON 编码（字符串加引号 + JSON 转义；数值/bool 本就是合法 JSON）
//   !p  pbtxt  —— protobuf text 编码（字符串加引号 + protobuf 风格转义）
//   !c  csv    —— CSV 单元格编码（仅当含 , " CR/LF 时加引号，内部 " 翻倍）
// 以上六种转换均可作用于任意值类型：字符串统一走 *_str_conv 做格式专属转义；
// 标量（整数/浮点/bool）序列化后本就是裸值，三种格式等价，故直接走原追加函数。
// 返回 "" 表示该「种类 × 转换」组合非法（当前已无非法组合，保留以兜底）。
pub fn fmt_conv_fn(k: i64, cv: i64) string {
    if (cv == 0 or cv == 115) { return fmt_append_fn(k); }        // 无 / !s
    if (cv == 114 or cv == 97 or cv == 106 or cv == 99 or cv == 112) {
        if (k == 3) { return "sb_append_fmt_str_conv"; }           // 字符串 → 格式专属转义
        return fmt_append_fn(k);                                   // 标量 → 裸值（json/pbtxt/csv 等价）
    }
    return "";
}

pub fn fmt_conv_name(cv: i64) string {
    if (cv == 114) { return "r"; }
    if (cv == 97) { return "a"; }
    if (cv == 106) { return "j"; }
    if (cv == 99) { return "c"; }
    if (cv == 112) { return "p"; }
    return "s";
}

pub fn fmt_fn_takes_mode(name: string) bool {
    return name == "sb_append_fmt_str_conv" or name == "sb_append_fmt_int_conv" or name == "sb_append_fmt_uint_conv";
}

// 形参类型节点：复用 mk_type_node_from_ti 覆盖标量/字符串/结构/切片/映射/数组。
pub fn fmt_type_node(t: i64) i64 {
    return mk_type_node_from_ti(t);
}

// 把一条语句追加进函数体链表。head 为 -1 时同时把它设成表头。
// 返回新的 tail；调用方需自行同步 head（与 synthesize_loader 的定式一致）。
pub fn fmt_push_stmt(head: i64, tail: i64, stmt: i64) i64 {
    return base.list_push(head, tail, stmt);
}

// ── A1a：!j 聚合值的编译期 JSON 编码 ──────────────────────────
// t 没有运行期 Any / RTTI，故 JSON 编码在脱糖期按各实参的**静态 TI** 生成内联
// 代码（双后端只编译生成的 t 代码，IR 不受影响）。覆盖标量/字符串/结构/切片/
// 定长数组/映射；枚举/变体/Pointer/Optional 等无 RTTI 的类型降级为 null。
pub fn fmt_jstmt2(fnm: string, a1: i64, a2: i64) i64 {
    var ah: i64 = -1; var at: i64 = -1;
    at = base.list_push(ah, at, a1); if (ah < 0) { ah = at; }
    at = base.list_push(ah, at, a2); if (ah < 0) { ah = at; }
    return base.mk_expr(base.mk_call(base.mk_ident(fnm, -1), ah, -1), -1);
}
pub fn fmt_jstmt3(fnm: string, a1: i64, a2: i64, a3: i64) i64 {
    var ah: i64 = -1; var at: i64 = -1;
    at = base.list_push(ah, at, a1); if (ah < 0) { ah = at; }
    at = base.list_push(ah, at, a2); if (ah < 0) { ah = at; }
    at = base.list_push(ah, at, a3); if (ah < 0) { ah = at; }
    return base.mk_expr(base.mk_call(base.mk_ident(fnm, -1), ah, -1), -1);
}
pub fn fmt_jstmt4(fnm: string, a1: i64, a2: i64, a3: i64, a4: i64) i64 {
    var ah: i64 = -1; var at: i64 = -1;
    at = base.list_push(ah, at, a1); if (ah < 0) { ah = at; }
    at = base.list_push(ah, at, a2); if (ah < 0) { ah = at; }
    at = base.list_push(ah, at, a3); if (ah < 0) { ah = at; }
    at = base.list_push(ah, at, a4); if (ah < 0) { ah = at; }
    return base.mk_expr(base.mk_call(base.mk_ident(fnm, -1), ah, -1), -1);
}
pub fn fmt_one_block(stmt: i64) i64 {
    // 注：返回的必须是**子节点链表头（kids head）**，与 parse.parse_block() 一致——
    // if/while/for 的分支在 AST 里就是 kids head，发射期与 collect_local_types 均按
    // kids head 遍历（见 codegen_ll emit_if / collect_local_types）。绝不可返回
    // base.mk_block(h) 的「block 节点 id」，否则 n.la 存成节点 id，kids[la] 越界崩溃
    // （A1a 多载荷结构体第二个字段即触发 t_slice_at index N length M）。
    var h: i64 = -1; var t: i64 = -1;
    t = base.list_push(h, t, stmt); if (h < 0) { h = t; }
    return h;
}
// 把静态类型为 ti 的值 val（表达式节点）的 JSON 编码追加进 __fmt_N 函数体。
// head 为已非空的体链表头，tail 为当前尾；返回新尾。
pub fn fmt_gen_json(head: i64, tail: i64, val: i64, ti: i64) i64 {
    var k: string = tip_kind(ti);
    var kind: i64 = fmt_kind_of(ti);
    if (kind >= 0) {
        // 标量 / 字符串叶
        if (kind == 3) {
            return fmt_push_stmt(head, tail,
                fmt_jstmt4("sb_append_fmt_str_conv", base.mk_ident("__fb", -1), base.mk_string("", -1), val, base.mk_string("j", -1)));
        }
        return fmt_push_stmt(head, tail,
            fmt_jstmt3(fmt_append_fn(kind), base.mk_ident("__fb", -1), base.mk_string("", -1), val));
    }
    // P3：位域 TI kind 已归 `Struct`，但 f-string `!j` 对位域走的是标量/整型输出，
    // 不是「按字段展开成 JSON 对象」。显式排除以保持与 P3 前（kind=="Flag"）逐位一致。
    if (k == "Struct" and tip_is_flag(ti) == false) {
        tail = fmt_push_stmt(head, tail, fmt_jstmt2("sb_append_str", base.mk_ident("__fb", -1), base.mk_string("{", -1)));
        var m: i64 = g_fmt_jsym; g_fmt_jsym = g_fmt_jsym + 1;
        var ff: string = base.sb_cat2("__ff", base.i2s(m));
        tail = fmt_push_stmt(head, tail, base.mk_var_decl(ff, false, base.mk_scalar("bool", -1), base.mk_bool(true, -1), -1));
        var fh: i64 = find_struct_fields(tip_name(ti));
        var f0: i64 = fh;
        var mq_ks3616: []i64 = base.kids_chain_idx(fh);
        var mq_ki3616: i64 = 0;
        while (mq_ki3616 < slice_len(mq_ks3616) as i64) {
            f0 = mq_ks3616[mq_ki3616];
            var fname: string = base.node_sa((base.kids[f0].val as u64));
            var fti: i64 = -1;
            if (base.node_na((base.kids[f0].val as u64)) >= 0) { fti = resolve_ti(base.node_na((base.kids[f0].val as u64))); }
            // if (!ff) { sb_append_str(__fb, ","); }
            tail = fmt_push_stmt(head, tail,
                base.mk_if(base.mk_unary("!", base.mk_ident(ff, -1), -1),
                    fmt_one_block(fmt_jstmt2("sb_append_str", base.mk_ident("__fb", -1), base.mk_string(",", -1))), -1, -1));
            tail = fmt_push_stmt(head, tail, base.mk_assignment("=", base.mk_ident(ff, -1), base.mk_bool(false, -1), -1));
            // 字段名作 JSON 对象键：用 sb_append_fmt_str_conv(..., "j") 做引号 + 转义
            tail = fmt_push_stmt(head, tail,
                fmt_jstmt4("sb_append_fmt_str_conv", base.mk_ident("__fb", -1), base.mk_string("", -1), base.mk_string(fname, -1), base.mk_string("j", -1)));
            tail = fmt_push_stmt(head, tail, fmt_jstmt2("sb_append_str", base.mk_ident("__fb", -1), base.mk_string(":", -1)));
            // 注：mk_member 的第 3 参是 token index（node_at 用于定位源码位置），
            // 绝非类型 TI。字段类型信息已用于递归编码 fti，故此处传 -1（不锚定源码）。
            tail = fmt_gen_json(head, tail, base.mk_member(fname, val, -1), fti);
            mq_ki3616 = mq_ki3616 + 1;
            f0 = -1;
        }
        tail = fmt_push_stmt(head, tail, fmt_jstmt2("sb_append_str", base.mk_ident("__fb", -1), base.mk_string("}", -1)));
        return tail;
    }
    if (k == "Slice") {
        tail = fmt_push_stmt(head, tail, fmt_jstmt2("sb_append_str", base.mk_ident("__fb", -1), base.mk_string("[", -1)));
        var m: i64 = g_fmt_jsym; g_fmt_jsym = g_fmt_jsym + 1;
        var cnt: string = base.sb_cat2("__ji", base.i2s(m));
        var ev: string = base.sb_cat2("__je", base.i2s(m));
        tail = fmt_push_stmt(head, tail, base.mk_var_decl(cnt, false, base.mk_scalar("i64", -1), rng_lit(0), -1));
        var bh: i64 = -1; var bt: i64 = -1;
        var cond: i64 = base.mk_binary(">", base.mk_ident(cnt, -1), rng_lit(0), -1);
        var ifc: i64 = base.mk_if(cond,
            fmt_one_block(fmt_jstmt2("sb_append_str", base.mk_ident("__fb", -1), base.mk_string(",", -1))), -1, -1);
        bt = fmt_push_stmt(bh, bt, ifc); if (bh < 0) { bh = bt; }
        bt = fmt_push_stmt(bh, bt,
            base.mk_assignment("=", base.mk_ident(cnt, -1), base.mk_binary("+", base.mk_ident(cnt, -1), rng_lit(1), -1), -1));
        if (bh < 0) { bh = bt; }
        bt = fmt_gen_json(bh, bt, base.mk_ident(ev, -1), tis[ti].elem);
        var loop: i64 = base.mk_for_each(ev, "", val, bh, -1, -1);
        tail = fmt_push_stmt(head, tail, loop);
        tail = fmt_push_stmt(head, tail, fmt_jstmt2("sb_append_str", base.mk_ident("__fb", -1), base.mk_string("]", -1)));
        return tail;
    }
    if (k == "Array") {
        // 定长数组：__fmt_N 形参即 [N]T（非 slice），不能用 for_each（会按 slice 调 tll_slice_len 读垃圾）。
        // 改为按下标 0..alen 索引遍历，复用数组下标（两后端均已支持）。
        tail = fmt_push_stmt(head, tail, fmt_jstmt2("sb_append_str", base.mk_ident("__fb", -1), base.mk_string("[", -1)));
        var m: i64 = g_fmt_jsym; g_fmt_jsym = g_fmt_jsym + 1;
        var cnt: string = base.sb_cat2("__ji", base.i2s(m));       // 逗号分隔标志
        var ix: string = base.sb_cat2("__jx", base.i2s(m));         // 下标变量（即 for 循环变量）
        var alen: i64 = tis[ti].alen;
        tail = fmt_push_stmt(head, tail, base.mk_var_decl(cnt, false, base.mk_scalar("i64", -1), rng_lit(0), -1));
        var bh: i64 = -1; var bt: i64 = -1;
        var cond: i64 = base.mk_binary(">", base.mk_ident(cnt, -1), rng_lit(0), -1);
        var ifc: i64 = base.mk_if(cond,
            fmt_one_block(fmt_jstmt2("sb_append_str", base.mk_ident("__fb", -1), base.mk_string(",", -1))), -1, -1);
        bt = fmt_push_stmt(bh, bt, ifc); if (bh < 0) { bh = bt; }
        bt = fmt_push_stmt(bh, bt,
            base.mk_assignment("=", base.mk_ident(cnt, -1), base.mk_binary("+", base.mk_ident(cnt, -1), rng_lit(1), -1), -1));
        if (bh < 0) { bh = bt; }
        var aev: i64 = base.mk_index(val, base.mk_ident(ix, -1), -1);
        bt = fmt_gen_json(bh, bt, aev, tis[ti].elem);
        // 注意：mk_int 的 ia 是 RADIX 非值 → 长度须 base.mk_int(base.i2s(alen), 10, -1)（radix 10）。
        var loop: i64 = base.mk_for(rng_i64_decl(ix, rng_lit(0)),
            base.mk_binary("<", base.mk_ident(ix, -1), base.mk_int(base.i2s(alen), 10, -1), -1), rng_incr(ix), bh, -1, -1);
        tail = fmt_push_stmt(head, tail, loop);
        tail = fmt_push_stmt(head, tail, fmt_jstmt2("sb_append_str", base.mk_ident("__fb", -1), base.mk_string("]", -1)));
        return tail;
    }
    if (k == "Map") {
        tail = fmt_push_stmt(head, tail, fmt_jstmt2("sb_append_str", base.mk_ident("__fb", -1), base.mk_string("{", -1)));
        var m: i64 = g_fmt_jsym; g_fmt_jsym = g_fmt_jsym + 1;
        var cnt: string = base.sb_cat2("__ji", base.i2s(m));
        var kk: string = base.sb_cat2("__jk", base.i2s(m));
        var vv: string = base.sb_cat2("__jv", base.i2s(m));
        tail = fmt_push_stmt(head, tail, base.mk_var_decl(cnt, false, base.mk_scalar("i64", -1), rng_lit(0), -1));
        var bh: i64 = -1; var bt: i64 = -1;
        var cond: i64 = base.mk_binary(">", base.mk_ident(cnt, -1), rng_lit(0), -1);
        var ifc: i64 = base.mk_if(cond,
            fmt_one_block(fmt_jstmt2("sb_append_str", base.mk_ident("__fb", -1), base.mk_string(",", -1))), -1, -1);
        bt = fmt_push_stmt(bh, bt, ifc); if (bh < 0) { bh = bt; }
        bt = fmt_push_stmt(bh, bt,
            base.mk_assignment("=", base.mk_ident(cnt, -1), base.mk_binary("+", base.mk_ident(cnt, -1), rng_lit(1), -1), -1));
        if (bh < 0) { bh = bt; }
        // 键：JSON 对象键须为字符串；仅 string 键完全支持，其余键退化为 "?"
        if (tip_kind(tis[ti].key) == "String") {
            bt = fmt_push_stmt(bh, bt,
                fmt_jstmt4("sb_append_fmt_str_conv", base.mk_ident("__fb", -1), base.mk_string("", -1), base.mk_ident(kk, -1), base.mk_string("j", -1)));
        } else {
            bt = fmt_push_stmt(bh, bt,
                fmt_jstmt4("sb_append_fmt_str_conv", base.mk_ident("__fb", -1), base.mk_string("", -1), base.mk_string("?", -1), base.mk_string("j", -1)));
        }
        bt = fmt_push_stmt(bh, bt, fmt_jstmt2("sb_append_str", base.mk_ident("__fb", -1), base.mk_string(":", -1)));
        bt = fmt_gen_json(bh, bt, base.mk_ident(vv, -1), tis[ti].val);
        var loop: i64 = base.mk_for_each(kk, vv, val, bh, -1, -1);
        tail = fmt_push_stmt(head, tail, loop);
        tail = fmt_push_stmt(head, tail, fmt_jstmt2("sb_append_str", base.mk_ident("__fb", -1), base.mk_string("}", -1)));
        return tail;
    }
    // 兜底：无 RTTI 的类型（Enum/Variant/Pointer/Optional 等）输出 null
    return fmt_push_stmt(head, tail, fmt_jstmt2("sb_append_str", base.mk_ident("__fb", -1), base.mk_string("null", -1)));
}

// format(tmpl, a, b, ...) 的脱糖入口。
// 成功则**就地改写** e 为 `__fmt_N(a, b, ...)` 并返回 String；失败返回 Unknown。
pub fn desugar_format_call(e: i64) i64 {

    // A1a：每次脱糖前清理聚合实参槽位 / JSON 局部名计数器，避免上一次 format 调用的残留污染本调用。
    // g_fmt_counter（__fmt_N 函数序号）跨调用单调、不可重置；g_fmt_jsym（__ff/__ji/... 局部名后缀）
    // 仅需在单个函数体内唯一，故每次重置为 0——既消除跨调用残留，又让生成名从 0 重新编号。
    var ri: i64 = 0;
    while (ri < 64) {
        g_fmt_json[ri] = false;
        g_fmt_json_ti[ri] = -1;
        ri = ri + 1;
    }
    g_fmt_jsym = 0;

    // ── 0. 泛型模板体内跳过脱糖 ─────────────────────────────
    // 处于泛型模板体内时，comptime 形参（如 `meta T: type`）尚未绑定，value 实参的
    // 静态类型未知（可能是未定型的 T）。此刻脱糖会生成以「未知类型」为编码目标的
    // __fmt_N，且改写后的 __fmt_N 节点无法再被实例恢复 → 发射期 `UNSUPPORTED call format`。
    // 故模板体内leave `format` 节点原样，待实例（instantiate_generic 重跑 check_func_decl，
    // 类型已具体）再脱糖。模板本身永不发射，仅实例发射，故无副作用。
    if (g_cur_func_decl >= 0 and func_is_generic(g_cur_func_decl)) {
        return ti_mk("String");
    }

    // ── 1. 模板必须存在且是字面量 ──────────────────────────
    var tmpl_node: i64 = call_arg_node(e, 0);
    if (tmpl_node < 0) {
        parse.fc_err("T-FST-E303",
            "format 至少需要一个实参：模板字符串字面量，如 format(\"{0} 分\", n)", e);
        return ti_mk("Unknown");
    }
    if (base.node_kind((tmpl_node as u64)) != "string") {
        parse.fc_err("T-FST-E304",
            "format 的模板必须是字符串**字面量**（编译期解析，运行期无模板引擎）；变量模板请改用 StringBuilder 逐段拼接",
            tmpl_node);
        return ti_mk("Unknown");
    }
    var tmpl: string = base.node_sa((tmpl_node as u64));

    // ── 2. 收集值实参并推断类型 ────────────────────────────
    var argc: i64 = 0;
    var c0: i64 = base.node_la((e as u64));
    if (c0 >= 0) {
        var k0: Child = base.kids[c0];
        c0 = k0.next;                      // 跳过模板串本身
    }
    while (c0 >= 0) {
        var ck: Child = base.kids[c0];
        if (argc >= 64) {
            parse.fc_err("T-FST-E305", "format 的值实参不能超过 64 个", e);
            return ti_mk("Unknown");
        }
        var at: i64 = infer_expr(ck.val);
        var kind: i64 = fmt_kind_of(at);
        g_fmt_at[argc] = fmt_type_node(at);
        g_fmt_ti[argc] = at;
        if (kind < 0) {
            if (tip_kind(at) == "Unknown") {
                // Unknown：已有诊断，按 int 兜底避免级联
                g_fmt_ak[argc] = 0;
                g_fmt_json[argc] = false;
            } else {
                // 聚合类型：标记为需 JSON 编码（!j 分支在 Step 3 处理）
                g_fmt_ak[argc] = -1;
                g_fmt_json[argc] = true;
                g_fmt_json_ti[argc] = at;
            }
        } else {
            g_fmt_ak[argc] = kind;
            g_fmt_json[argc] = false;
        }
        argc = argc + 1;
        c0 = ck.next;
    }

    // ── 3. 解析模板，边解析边生成函数体语句 ────────────────
    var body_head: i64 = -1;
    var body_tail: i64 = -1;

    // var __fb: StringBuilder = sb_new();
    var sbdecl: i64 = base.mk_var_decl("__fb", false, base.mk_scalar("StringBuilder", -1),
        base.mk_call(base.mk_ident("sb_new", -1), -1, -1), -1);
    body_tail = fmt_push_stmt(body_head, body_tail, sbdecl);
    if (body_head < 0) { body_head = body_tail; }

    var lit: StringBuilder = sb_new();
    var tl: u64 = str_len(tmpl);
    var i: u64 = 0;
    var auto_next: i64 = 0;
    var used_auto: bool = false;
    var used_manual: bool = false;
    var used_idx: i64 = 0;                 // 位掩码不够用，退化为「最大引用下标 + 1」

    while (i < tl) {
        var ch: i64 = tmpl[i] as i64;

        // `}}` → 字面 `}`；单独的 `}` 是笔误
        if (ch == 125) {
            if (i + 1 < tl and (tmpl[i + 1] as i64) == 125) {
                sb_append_char(lit, 125);
                i = i + 2;
                continue;
            }
            parse.fc_err("T-FST-E307",
                "模板里孤立的 `}`；要输出字面右花括号请写 `}}`", tmpl_node);
            return ti_mk("Unknown");
        }

        if (ch != 123) {                   // 普通字符
            sb_append_char(lit, ch);
            i = i + 1;
            continue;
        }

        // `{{` → 字面 `{`
        if (i + 1 < tl and (tmpl[i + 1] as i64) == 123) {
            sb_append_char(lit, 123);
            i = i + 2;
            continue;
        }

        // ── 替换字段 ──
        // 先把攒下的字面段冲刷成一条 sb_append_str
        var seg: string = sb_to_str(lit);
        if (str_len(seg) > 0) {
            var sa_head: i64 = -1;
            var sa_tail: i64 = -1;
            sa_tail = base.list_push(sa_head, sa_tail, base.mk_ident("__fb", -1));
            if (sa_head < 0) { sa_head = sa_tail; }
            sa_tail = base.list_push(sa_head, sa_tail, base.mk_string(seg, -1));
            if (sa_head < 0) { sa_head = sa_tail; }
            var scall: i64 = base.mk_call(base.mk_ident("sb_append_str", -1), sa_head, -1);
            body_tail = fmt_push_stmt(body_head, body_tail, base.mk_expr(scall, -1));
            if (body_head < 0) { body_head = body_tail; }
        }
        sb_clear(lit);

        i = i + 1;                         // 跳过 '{'

        // 索引：数字串 或 空（自动编号）
        var idx: i64 = -1;
        var has_digit: bool = false;
        while (i < tl) {
            var dc: i64 = tmpl[i] as i64;
            if (dc < 48 or dc > 57) { i = i; break; }
            if (has_digit == false) { idx = 0; has_digit = true; }
            idx = idx * 10 + (dc - 48);
            i = i + 1;
        }

        // 转换字段 `!s|!r|!a|!j|!c|!p`（M-fstr；`format()` 手写模板同样可用）
        var conv: i64 = 0;
        if (i < tl and (tmpl[i] as i64) == 33) {
            var cvv: i64 = 0;
            if (i + 1 < tl) { cvv = tmpl[i + 1] as i64; }
            if (cvv != 115 and cvv != 114 and cvv != 97 and cvv != 106 and cvv != 99 and cvv != 112) {
                parse.fc_err("T-FST-E301",
                    "转换字段只能是 `!s`（str）/ `!r`（repr）/ `!a`（ascii）/ `!j`（json）/ `!c`（csv）/ `!p`（pbtxt）之一",
                    tmpl_node);
                return ti_mk("Unknown");
            }
            conv = cvv;
            i = i + 2;
        }

        // 既没数字，下一个也不是 ':' / '}' ⇒ 命名字段
        if (has_digit == false and conv == 0 and i < tl) {
            var pc: i64 = tmpl[i] as i64;
            if (pc != 58 and pc != 125) {
                parse.fc_err("T-FST-E308",
                    "不支持命名字段 `{name}`（t 没有关键字实参）；请改用位置索引 `{0}` 或自动编号 `{}`",
                    tmpl_node);
                return ti_mk("Unknown");
            }
        }

        if (has_digit) {
            used_manual = true;
        } else {
            used_auto = true;
            idx = auto_next;
            auto_next = auto_next + 1;
        }
        // 与 CPython 一致：自动编号与手动索引不得混用，否则读者要心算下一个是几号
        if (used_auto and used_manual) {
            parse.fc_err("T-FST-E309",
                "同一模板里不能混用自动编号 `{}` 与手动索引 `{0}`；请统一其中一种",
                tmpl_node);
            return ti_mk("Unknown");
        }

        // 格式规范（可选）
        var spec: string = "";
        if (i < tl and (tmpl[i] as i64) == 58) {
            i = i + 1;
            var sp0: u64 = i;
            while (i < tl and (tmpl[i] as i64) != 125) { i = i + 1; }
            spec = str_slice(tmpl, sp0, i);
        }

        if (i >= tl or (tmpl[i] as i64) != 125) {
            parse.fc_err("T-FST-E307",
                "替换字段没有闭合的 `}`；要输出字面左花括号请写 `{{`", tmpl_node);
            return ti_mk("Unknown");
        }
        i = i + 1;                         // 跳过 '}'

        if (idx < 0 or idx >= argc) {
            parse.fc_err("T-FST-E310",
                base.sb_cat3("模板引用了第 ", base.i2s(idx),
                    base.sb_cat3(" 个值实参，但只传入了 ", base.i2s(argc), " 个")),
                tmpl_node);
            return ti_mk("Unknown");
        }
        if (idx + 1 > used_idx) { used_idx = idx + 1; }

        // A1a：聚合实参（结构体/切片/数组/映射）仅 !j 合法
        if (g_fmt_json[idx]) {
            if (conv != 106) {
                parse.fc_err("T-FST-E306",
                    base.sb_cat3("format 的第 ", base.i2s(idx),
                        " 个值实参是聚合类型，只能用 !j 转换字段做 JSON 编码（如 {0!j}）；非 !j 转换字段仅支持标量 / 字符串"),
                    tmpl_node);
                return ti_mk("Unknown");
            }
            body_tail = fmt_gen_json(body_head, body_tail,
                base.mk_ident(base.sb_cat2("a", base.i2s(idx)), -1), g_fmt_json_ti[idx]);
            if (body_head < 0) { body_head = body_tail; }
            continue;
        }

        // sb_append_fmt_X(__fb, "spec", aK[, "conv"]);
        var appfn: string = fmt_conv_fn(g_fmt_ak[idx], conv);
        if (str_len(appfn) == 0) {
            parse.fc_err("T-FST-E311",
                base.sb_cat3("转换字段 `!", fmt_conv_name(conv),
                    "` 不适用于当前值实参的类型"),
                tmpl_node);
            return ti_mk("Unknown");
        }
        // 任意位宽整数：宽度 > 64 时走通用大整数格式化（按地址传值 + 位宽/符号），
        // 避免既有的 sb_append_fmt_int/uint 把值塞进 i64 而静默截断。
        if (g_fmt_ak[idx] == 0 or g_fmt_ak[idx] == 1) {
            var wti: i64 = g_fmt_ti[idx];
            if (tip_kind(wti) == "Scalar") {
                var wnm: string = tip_name(wti);
                if (is_int_name(wnm) and base.ll_bits(wnm) > 64) {
                    appfn = "sb_append_fmt_big";
                }
            }
        }
        var fa_head: i64 = -1;
        var fa_tail: i64 = -1;
        fa_tail = base.list_push(fa_head, fa_tail, base.mk_ident("__fb", -1));
        if (fa_head < 0) { fa_head = fa_tail; }
        fa_tail = base.list_push(fa_head, fa_tail, base.mk_string(spec, -1));
        if (fa_head < 0) { fa_head = fa_tail; }
        fa_tail = base.list_push(fa_head, fa_tail, base.mk_ident(base.sb_cat2("a", base.i2s(idx)), -1));
        if (fa_head < 0) { fa_head = fa_tail; }
        // 宽整数：补两位实参 —— 位宽(i64) 与 是否带符号(bool)。
        // ⚠ base.mk_int(sa, ia, ti) 的 ia 是「进制」不是「值」：十进制字面量必须传 10，
        //    值由 sa 承载；若把位宽当 ia 传，LLVM 会按该进制解析 sa（72 当进制 → 506）。
        if (appfn == "sb_append_fmt_big") {
            var wbw: i64 = base.ll_bits(tip_name(g_fmt_ti[idx]));
            fa_tail = base.list_push(fa_head, fa_tail, base.mk_int(base.i2s(wbw), 10, -1));
            if (fa_head < 0) { fa_head = fa_tail; }
            fa_tail = base.list_push(fa_head, fa_tail, base.mk_bool(g_fmt_ak[idx] == 0, -1));
            if (fa_head < 0) { fa_head = fa_tail; }
        }
        if (fmt_fn_takes_mode(appfn)) {
            fa_tail = base.list_push(fa_head, fa_tail, base.mk_string(fmt_conv_name(conv), -1));
            if (fa_head < 0) { fa_head = fa_tail; }
        }
        var fcall: i64 = base.mk_call(base.mk_ident(appfn, -1), fa_head, -1);
        body_tail = fmt_push_stmt(body_head, body_tail, base.mk_expr(fcall, -1));
        if (body_head < 0) { body_head = body_tail; }
    }

    // 收尾字面段
    var tailseg: string = sb_to_str(lit);
    if (str_len(tailseg) > 0) {
        var ta_head: i64 = -1;
        var ta_tail: i64 = -1;
        ta_tail = base.list_push(ta_head, ta_tail, base.mk_ident("__fb", -1));
        if (ta_head < 0) { ta_head = ta_tail; }
        ta_tail = base.list_push(ta_head, ta_tail, base.mk_string(tailseg, -1));
        if (ta_head < 0) { ta_head = ta_tail; }
        var tcall: i64 = base.mk_call(base.mk_ident("sb_append_str", -1), ta_head, -1);
        body_tail = fmt_push_stmt(body_head, body_tail, base.mk_expr(tcall, -1));
        if (body_head < 0) { body_head = body_tail; }
    }

    // return sb_to_str(__fb);
    var ra_head: i64 = -1;
    var ra_tail: i64 = -1;
    ra_tail = base.list_push(ra_head, ra_tail, base.mk_ident("__fb", -1));
    if (ra_head < 0) { ra_head = ra_tail; }
    var rcall: i64 = base.mk_call(base.mk_ident("sb_to_str", -1), ra_head, -1);
    body_tail = fmt_push_stmt(body_head, body_tail, base.mk_return(rcall, -1));
    if (body_head < 0) { body_head = body_tail; }

    // ── 4. 合成形参列表 a0..a(argc-1) ──────────────────────
    var p_head: i64 = -1;
    var p_tail: i64 = -1;
    var pi: i64 = 0;
    while (pi < argc) {
        var pn: i64 = base.mk_P(base.sb_cat2("a", base.i2s(pi)), g_fmt_at[pi], -1, -1);
        p_tail = base.list_push(p_head, p_tail, pn);
        if (p_head < 0) { p_head = p_tail; }
        pi = pi + 1;
    }

    // ── 5. 提升为顶层函数并注册 ────────────────────────────
    var fn_name: string = base.sb_cat2("__fmt_", base.i2s(g_fmt_counter));
    g_fmt_counter = g_fmt_counter + 1;
    var fdecl: i64 = base.mk_FuncDecl(fn_name, false, false, base.mk_scalar("string", -1),
        -1, p_head, body_head, -1);
    // 锚点承接：合成函数若在发射期出诊断，得能指回用户写 format 的那一行
    base.node_set_span_id(fdecl, base.node_span_id(e));
    base.node_set_span_id(fdecl, base.node_span_id(e));
    base.node_set_span_id(fdecl, base.node_span_id(e));
    sym_define(global_scope, fn_name, "func", ti_named("Func", fn_name), fdecl);
    append(lex.decl_list, fdecl);

    // ── 6. 就地改写调用点：format(tmpl, a, b) → __fmt_N(a, b) ──
    base.node_set_na((e as u64), base.mk_ident(fn_name, -1));
    if (base.node_la((e as u64)) >= 0) {
        var fk: Child = base.kids[base.node_la((e as u64))];
        base.node_set_la((e as u64), fk.next);   // 丢掉模板串实参
    }
    return ti_mk("String");
}

// 调用实参**不走通用遍历**（见 run_check 尾部关于 scan_fid_format_atoms 的长注释），
// 于是 `show(format(...))` / `sb_append_str(b, format(...))` 里的 format 永远等不到
// infer，发射期只会吐一行 `; UNSUPPORTED call format` 然后生成 `load %TStr, ptr 0`。
// 平坦扫描救不了它 —— 脱糖要实参的静态类型，而类型要作用域，出了 check 就没了。
// 故在 call 分支入口就地补扫实参子树：此刻 cur_scope 正确，命中即交回 infer_expr。
//
// 递归保护用节点池的天然不变式：`node_new` 顺序追加 ⇒ 子节点索引恒小于父节点。
// 只向索引更小处递归，既杜绝成环，也挡住「某 kind 把非节点整数存进 na」的误伤。
// （开关 g_has_format 声明在 parse_post_call 附近，与置位点同处。）

pub fn fmt_scan_list(h: i64, lim: i64) void {
    var c: i64 = h;
    var mq_ks4063: []i64 = base.kids_chain_idx(h);
    var mq_ki4063: i64 = 0;
    while (mq_ki4063 < slice_len(mq_ks4063) as i64) {
        c = mq_ks4063[mq_ki4063];
        var k: Child = base.kids[c];
        fmt_scan_subtree(k.val, lim);
        mq_ki4063 = mq_ki4063 + 1;
        c = -1;
    }
}

pub fn fmt_scan_subtree(x: i64, lim: i64) void {
    if (x < 0 or x >= lim) { return; }
    if (base.node_kind((x as u64)) == "call" and base.node_na((x as u64)) >= 0) {
        if (base.node_sa((base.node_na((x as u64)) as u64)) == "format" and (base.node_kind((base.node_na((x as u64)) as u64)) == "ident" or base.node_kind((base.node_na((x as u64)) as u64)) == "member")) {
            infer_expr(x);          // 就地改写成 __fmt_N(...)，幂等
        }
    }
    fmt_scan_subtree(base.node_na((x as u64)), lim);
    fmt_scan_subtree(base.node_nb((x as u64)), lim);
    fmt_scan_subtree(base.node_nc((x as u64)), lim);
    fmt_scan_subtree(base.node_nd((x as u64)), lim);   // S4 §0.14.7 SoA：侧表访问器（原 .nd）
    fmt_scan_list(base.node_la((x as u64)), lim);
    fmt_scan_list(base.node_lb((x as u64)), lim);
    fmt_scan_list(base.node_lc((x as u64)), lim);
}

// ── 管道算子降解（reference.md §3.15）──────────────────────────
//
// 三个管道节点（pipe_map / pipe_filter / pipe_apply）在 infer_expr 入口被**就地**降解，
// 两个后端因此永远看不到 pipe_*。整体思路与 __fmt_N 同构（见 desugar_format_call）：
// 提升出一个顶层合成函数、把原节点改写成对它的调用。
//
//   · 连续的「元素级」阶段（`|->`、`|>?`、以及分派为逐元素的 `|>`）融合进 **一个**
//     合成函数 `__pipe_N(源, f0, f1, ...)` 里的单趟 for 循环 —— 中间序列不落地；
//   · 「整体应用」形态的 `|>` 改写成 `F(E)`，并先把它之前累积的元素级阶段冲刷成一次
//     __pipe_N 调用（即融合边界）。
//
// 右侧函数一律**先绑成实参**再进循环，而不是在循环体里重复求值 —— 这就是规范
// 「右操作数只求值一次」的实现。
//
// 为什么降解必须落在 sema 而不是 parser：`|>` 的整体/逐元素分派是**类型定向**的，
// 解析期拿不到左操作数的类型。

pub var g_pipe_counter: i64 = 0;
// `|v: T| expr` 简写闭包的「返回类型待推断」标记：resolve_ti 把 infer_ret 占位节点
// 映射到这里（全局唯一的 Infer TI），sema 在用到该 lambda 时才推断真实返回类型。
// 仅简写闭包会触发，既有 `fn (v: T) R {...}` 不受影响。
pub var g_infer_ti: i64 = -1;
// 许可上下文（reference.md §3.15.6）里那个管道根节点的 id。check_stmt 在四个许可槽位
// 上置位（已剥掉外层括号），infer_expr 的管道分支据此判定 E865：出现在别处的管道
// 一律拒绝。判据用节点 id 而非布尔开关，因为 infer_expr 会向子表达式递归，
// 布尔开关会被子树误继承。
pub var g_pipe_root: i64 = -1;
// 降解期追加的合成函数：run_check 的主检查循环长度已冻结，故另行补检（见 run_check 尾部）。
pub var g_pipe_decls: []i64;
// 任一条管道降解出过错。合成函数是从**已经错了**的链拼出来的，再检查它只会
// 级联出二手噪声（谓词返回 i32 → 合成的 if 又报一次隐式布尔），故一旦置位就
// 跳过尾部补检；主诊断已经指在用户写的那个算子上。
pub var g_pipe_bad: bool = false;

pub fn is_pipe_kind(k: string) bool {
    if (k == "pipe_map") { return true; }
    if (k == "pipe_filter") { return true; }
    if (k == "pipe_apply") { return true; }
    return false;
}

// ── `|v: T| expr` 简写闭包的返回类型推断 ──────────────────────
// 简写闭包没有显式返回类型（占位 infer_ret → g_infer_ti）。凡用到它（作为值、
// 或进了管道），就在那时就地扫描函数体里的 `return <expr>` 推断真实返回类型，
// 回填到该函数的 tif_ret 与 FuncDecl 的 n.na。仅对带 infer_ret 占位的函数生效，
// 既有 `fn (v: T) R {...}`（始终带显式 R）完全不受影响。
// 递归保护：若本次推断途中又遇到同一函数（递归/互递归），直接沿用 g_infer_ti 占位，
// 不进入死循环；最终由 check_func_decl 的 all_paths_return 等后续检查兜底。

// 在语句链里找第一个「带值的 return」，返回其推断类型；全程无带值 return → 返回 -1（即 void）。
pub fn infer_scan_return(s: i64) i64 {
    if (s < 0) { return -1; }
    var best: i64 = -1;
    var cur: i64 = s;
    var mq_ks4140: []i64 = base.kids_chain_idx(s);
    var mq_ki4140: i64 = 0;
    while (mq_ki4140 < slice_len(mq_ks4140) as i64) {
        cur = mq_ks4140[mq_ki4140];
        var k: Child = base.kids[cur];
        var st: i64 = k.val;
        if (base.node_kind((st as u64)) == "return") {
            if (base.node_na((st as u64)) >= 0) {
                var rt: i64 = infer_expr(base.node_na((st as u64)));
                if (tip_kind(rt) != "Void" and tip_kind(rt) != "Unknown") { return rt; }
            }
        } else if (base.node_kind((st as u64)) == "block") {
            var r2: i64 = infer_scan_return(base.node_la((st as u64)));
            if (r2 >= 0) { return r2; }
        } else if (base.node_kind((st as u64)) == "if") {
            // if/else 两枝都可能含 return
            if (base.node_na((st as u64)) >= 0) { var r2: i64 = infer_scan_return(base.node_na((st as u64))); if (r2 >= 0) { return r2; } }
            if (base.node_nb((st as u64)) >= 0) { var r3: i64 = infer_scan_return(base.node_nb((st as u64))); if (r3 >= 0) { return r3; } }
        } else if (base.node_kind((st as u64)) == "for" or base.node_kind((st as u64)) == "while") {
            var r2: i64 = infer_scan_return(base.node_la((st as u64)));
            if (r2 >= 0) { return r2; }
        }
        mq_ki4140 = mq_ki4140 + 1;
        cur = -1;
    }
    return best;
}

pub fn infer_lambda_ret_from_decl(d: i64) i64 {
    // 找到该函数对应的 fti（符号表里 kind=="func" 的条目）
    var si: i64 = sym_lookup(global_scope, base.node_sa((d as u64)));
    if (si < 0) { return g_infer_ti; }
    var fti: i64 = syms[si].ti;
    // 已经推断过了（tif_ret 不再是占位）→ 直接返回，幂等
    if (tif_ret[fti] != g_infer_ti) { return tif_ret[fti]; }
    // 防递归：先把 tif_ret 设成一个非占位值（Void），推断完再纠正
    tif_ret[fti] = ti_mk("Void");
    // 在参数作用域里扫描 return 表达式
    var prev_scope: i64 = cur_scope;
    var prev_ret: i64 = cur_ret;
    cur_scope = scope_new_at(global_scope, d);
    var p: i64 = base.node_lb((d as u64));
    var mq_ks4178: []i64 = base.kids_chain_idx(base.node_lb((d as u64)));
    var mq_ki4178: i64 = 0;
    while (mq_ki4178 < slice_len(mq_ks4178) as i64) {
        p = mq_ks4178[mq_ki4178];
        var pk: Child = base.kids[p];
        sym_define(cur_scope, base.node_sa((pk.val as u64)), "var", resolve_ti(base.node_na((pk.val as u64))), -1);
        mq_ki4178 = mq_ki4178 + 1;
        p = -1;
    }
    // 提升后的合成闭包函数：体首的 closure_capture 语句把捕获量（如 base）绑定进环境结构，
    // 返回类型推断时这些名字必须可见，否则 `return x + base` 里的 base 会被判为「未定义标识符」。
    // 此处把体首的 closure_capture 也登记进推断作用域（与完整检查时的绑定一致）。
    var cb: i64 = base.node_lc((d as u64));
    var mq_ks4187: []i64 = base.kids_chain_idx(base.node_lc((d as u64)));
    var mq_ki4187: i64 = 0;
    while (mq_ki4187 < slice_len(mq_ks4187) as i64) {
        cb = mq_ks4187[mq_ki4187];
        if (base.node_kind((base.kids[cb].val as u64)) == "closure_capture") {
            sym_define(cur_scope, base.node_sa((base.kids[cb].val as u64)), "var", resolve_ti(base.node_na((base.kids[cb].val as u64))), -1);
        }
        mq_ki4187 = mq_ki4187 + 1;
        cb = -1;
    }
    var inferred: i64 = infer_scan_return(base.node_lc((d as u64)));
    if (inferred < 0) { inferred = ti_mk("Void"); }
    cur_ret = prev_ret;
    cur_scope = prev_scope;
    // 回填：tif_ret（调用方看到的签名）与 FuncDecl 的 n.na（发射期读的类型节点）
    tif_ret[fti] = inferred;
    base.node_set_na((d as u64), mk_type_node_from_ti(inferred));
    return inferred;
}

// 剥掉外层括号后置位管道根，返回被剥出的节点 id（供调用方判断是否管道）。
pub fn pipe_mark(x: i64) i64 {
    var y: i64 = x;
    var go: bool = true;
    while (go == true) {
        go = false;
        if (y >= 0) {
            if (base.node_kind((y as u64)) == "paren") {
                y = base.node_na((y as u64));
                go = true;
            }
        }
    }
    g_pipe_root = y;
    return y;
}

pub fn pipe_warn(code: string, msg: string, d: i64) void {
    var l: i64 = parse.n_line(d);
    var c: i64 = parse.n_col(d);
    base.diag_new(code, "warning", msg, parse.n_file(d), l, c, l, c + 4);
}

// 可流入判据：同型或可隐式转型 —— 与调用实参用的是同一套规则（见 check_call_args）。
// Unknown 一律放行：该处多半已有诊断，再报一次只是级联噪声。
pub fn pipe_flows(from: i64, to: i64) bool {
    if (from < 0) { return true; }
    if (to < 0) { return true; }
    if (tip_kind(from) == "Unknown") { return true; }
    if (tip_kind(to) == "Unknown") { return true; }
    if (ti_equal(from, to) == true) { return true; }
    return can_cast(from, to);
}

// 序列（切片 / 定长数组）的元素类型；非序列返回 -1。
pub fn pipe_seq_elem(t: i64) i64 {
    var k: string = tip_kind(t);
    if (k == "Slice") {
        var t1: TI = tis[t];
        return t1.elem;
    }
    if (k == "Array") {
        var t2: TI = tis[t];
        return t2.elem;
    }
    return -1;
}

pub fn pipe_is_bool(t: i64) bool {
    if (tip_kind(t) != "Scalar") { return false; }
    return tip_name(t) == "bool";
}

// 把 [seg0, len) 段的元素级阶段冲刷成一个合成函数，返回对它的调用节点。
//   __pipe_N fn(__ps: <src>, __pf0: <F0>, ...) []<out> {
//       var __po: []<out> = [];
//       for (__pe in __ps) { <阶段链> append(__po, <末级值>); }
//       return __po;
//   }
// 循环体自内向外包裹：filter 包一层 if，map 前置一条 var 声明。
pub fn pipe_flush(src_e: i64, src_ti: i64, out_elem: i64, seg0: i64,
              pk: []string, pf: []i64, pft: []i64, prt: []i64, anchor: i64) i64 {
    var nst: i64 = (slice_len(pk) as i64) - seg0;

    // ── 形参：源序列 + 每阶段一个函数值 ────────────────────────
    var ph: i64 = -1;
    var pt: i64 = -1;
    pt = base.list_push(ph, pt, base.mk_P("__ps", mk_type_node_from_ti(src_ti), -1, -1));
    if (ph < 0) { ph = pt; }
    var j: i64 = 0;
    while (j < nst) {
        var ptn: i64 = mk_type_node_from_ti(pft[seg0 + j]);
        pt = base.list_push(ph, pt, base.mk_P(base.sb_cat2("__pf", base.i2s(j)), ptn, -1, -1));
        if (ph < 0) { ph = pt; }
        j = j + 1;
    }

    // ── 每阶段的输入变量名：filter 不改变量，map 产出 __pv<j> ──
    var invar: []string;
    var cvn: string = "__pe";
    var j2: i64 = 0;
    while (j2 < nst) {
        append(invar, cvn);
        if (pk[seg0 + j2] == "map") { cvn = base.sb_cat2("__pv", base.i2s(j2)); }
        j2 = j2 + 1;
    }

    // ── 最内层：append(__po, <末级变量>) ──────────────────────
    var ah: i64 = -1;
    var at: i64 = -1;
    at = base.list_push(ah, at, base.mk_ident("__po", -1));
    if (ah < 0) { ah = at; }
    at = base.list_push(ah, at, base.mk_ident(cvn, -1));
    if (ah < 0) { ah = at; }
    var body: i64 = -1;
    var bt: i64 = -1;
    bt = base.list_push(body, bt, base.mk_expr(base.mk_call(base.mk_ident("append", -1), ah, -1), -1));
    if (body < 0) { body = bt; }

    // ── 自内向外包裹各阶段 ────────────────────────────────────
    var j3: i64 = nst - 1;
    while (j3 >= 0) {
        var ch: i64 = -1;
        var ct: i64 = -1;
        ct = base.list_push(ch, ct, base.mk_ident(invar[j3], -1));
        if (ch < 0) { ch = ct; }
        var callf: i64 = base.mk_call(base.mk_ident(base.sb_cat2("__pf", base.i2s(j3)), -1), ch, -1);
        if (pk[seg0 + j3] == "filter") {
            var nh: i64 = -1;
            var nt: i64 = -1;
            nt = base.list_push(nh, nt, base.mk_if(callf, body, -1, -1));
            if (nh < 0) { nh = nt; }
            body = nh;
        } else {
            var vdecl: i64 = base.mk_var_decl(base.sb_cat2("__pv", base.i2s(j3)), false,
                mk_type_node_from_ti(prt[seg0 + j3]), callf, -1);
            var nh2: i64 = -1;
            var nt2: i64 = -1;
            nt2 = base.list_push(nh2, nt2, vdecl);
            if (nh2 < 0) { nh2 = nt2; }
            var cc: i64 = body;
            var mq_ks4324: []i64 = base.kids_chain_idx(body);
            var mq_ki4324: i64 = 0;
            while (mq_ki4324 < slice_len(mq_ks4324) as i64) {
                cc = mq_ks4324[mq_ki4324];
                var kk: Child = base.kids[cc];
                nt2 = base.list_push(nh2, nt2, kk.val);
                if (nh2 < 0) { nh2 = nt2; }
                mq_ki4324 = mq_ki4324 + 1;
                cc = -1;
            }
            body = nh2;
        }
        j3 = j3 - 1;
    }

    // ── 函数体：声明累加器 → 单趟 for → 返回 ──────────────────
    var fh: i64 = -1;
    var ft: i64 = -1;
    ft = base.list_push(fh, ft, base.mk_var_decl("__po", false,
        base.mk_slice(mk_type_node_from_ti(out_elem), -1), base.mk_array_lit(-1, -1), -1));
    if (fh < 0) { fh = ft; }
    ft = base.list_push(fh, ft, base.mk_for_each("__pe", "", base.mk_ident("__ps", -1), body, -1, -1));
    if (fh < 0) { fh = ft; }
    ft = base.list_push(fh, ft, base.mk_return(base.mk_ident("__po", -1), -1));
    if (fh < 0) { fh = ft; }

    var fname: string = base.sb_cat2("__pipe_", base.i2s(g_pipe_counter));
    g_pipe_counter = g_pipe_counter + 1;
    var fdecl: i64 = base.mk_FuncDecl(fname, false, false,
        base.mk_slice(mk_type_node_from_ti(out_elem), -1), -1, ph, fh, -1);
    // 锚点承接：合成函数若在发射期出诊断，得能指回用户写管道的那一行
    base.node_set_span_id(fdecl, base.node_span_id(anchor));
    base.node_set_span_id(fdecl, base.node_span_id(anchor));
    base.node_set_span_id(fdecl, base.node_span_id(anchor));
    register_decl(fdecl);            // 填 tif_* 真实签名并 sym_define
    append(lex.decl_list, fdecl);
    append(g_pipe_decls, fdecl);

    // ── 调用点：__pipe_N(src, f0, f1, ...) ────────────────────
    var ch2: i64 = -1;
    var ct2: i64 = -1;
    ct2 = base.list_push(ch2, ct2, src_e);
    if (ch2 < 0) { ch2 = ct2; }
    var j4: i64 = 0;
    while (j4 < nst) {
        ct2 = base.list_push(ch2, ct2, pf[seg0 + j4]);
        if (ch2 < 0) { ch2 = ct2; }
        j4 = j4 + 1;
    }
    return base.mk_call(base.mk_ident(fname, -1), ch2, -1);
}

pub fn lower_pipe(e: i64) i64 {
    if (e != g_pipe_root) {
        parse.fc_err("T-PIP-E865",
            "管道表达式只能出现在四个位置：变量/常量初始化、赋值右侧、return、表达式语句",
            e);
    }

    // ── 1. 摘下左脊：chain = [最外层 … 最内层]，cur 落到基表达式 ──
    var chain: []i64;
    var cur: i64 = e;
    while (is_pipe_kind(base.node_kind((cur as u64))) == true) {
        append(chain, cur);
        cur = base.node_na((cur as u64));
    }
    var nchain: i64 = slice_len(chain) as i64;
    var cur_e: i64 = cur;
    var cur_ti: i64 = infer_expr(cur);

    // 待融合的元素级阶段（表只增不清，用 seg0 划出当前融合段）
    var pk: []string;
    var pf: []i64;
    var pft: []i64;
    var prt: []i64;
    var seg0: i64 = 0;
    var in_seg: bool = false;
    var seg_src_e: i64 = -1;
    var seg_src_ti: i64 = -1;
    var seg_elem: i64 = -1;
    var bad: bool = false;

    // ── 2. 按求值序处理各阶段 ────────────────────────────────
    var i: i64 = nchain - 1;
    while (i >= 0) {
        var p: i64 = chain[i];
        var pkind: string = base.node_kind((p as u64));
        var rhs: i64 = base.node_nb((p as u64));
        var fti: i64 = infer_expr(rhs);

        // 逻辑上「当前流动值」的类型与元素类型
        var flow_ti: i64 = cur_ti;
        var flow_elem: i64 = pipe_seq_elem(cur_ti);
        if (in_seg == true) {
            flow_elem = seg_elem;
            flow_ti = ti_elem_of("Slice", seg_elem);
        }
        var is_seq: bool = flow_elem >= 0;

        // ⚠ 定长数组暂不能进管道：降解出的辅助函数以 `[N]T` 接收源，而 `[N]T` 在
        // 双后端都是**裸元素指针**（长度只活在静态类型里），foreach 降解却按
        // TSlice 去读 `t_slice_len/t_slice_at` → 段错误。§3.15.2 规则 4 承诺支持
        // `[N]T`，实现未跟上；在 Array→Slice 构造 lowering 落地前显式拒绝，
        // 不把崩溃留到运行期（宪法 L-02）。
        if (tip_kind(flow_ti) == "Array") {
            parse.fc_err("T-PIP-E863",
                base.sb_cat3("管道暂不支持定长数组左操作数 `", ti_str(flow_ti),
                    "`：请改用切片 `[]T`（定长数组与切片运行时表示不同，尚无转换 lowering）"), p);
            bad = true;
            i = i - 1;
            continue;
        }

        // 右操作数必须是一元函数值
        if (tip_kind(fti) != "Func") {
            parse.fc_err("T-PIP-E860",
                base.sb_cat3("管道右操作数必须是函数值，实为 `", ti_str(fti), "`"), rhs);
            bad = true;
            i = i - 1;
            continue;
        }
        if (tif_pcount[fti] != 1) {
            parse.fc_err("T-PIP-E861",
                base.sb_cat3("管道右侧函数必须恰好接受 1 个形参，实为 ",
                    base.i2s(tif_pcount[fti]), " 个"), rhs);
            bad = true;
            i = i - 1;
            continue;
        }
        var ppt: i64 = tif_params[tif_pstart[fti]];
        var prt1: i64 = tif_ret[fti];

        if (pkind == "pipe_map" or pkind == "pipe_filter") {
            // 元素级算子：左操作数必须是序列
            if (is_seq == false) {
                parse.fc_err("T-PIP-E863",
                    base.sb_cat3("`", pipe_op_text(pkind),
                        base.sb_cat3("` 的左操作数必须是切片或定长数组，实为 `",
                            ti_str(flow_ti), "`")), p);
                bad = true;
                i = i - 1;
                continue;
            }
            if (pipe_flows(flow_elem, ppt) == false) {
                parse.fc_err("T-PIP-E862",
                    base.sb_cat3("元素类型 `", ti_str(flow_elem),
                        base.sb_cat3("` 无法流入形参类型 `", ti_str(ppt), "`")), rhs);
                bad = true;
            }
            if (pkind == "pipe_filter") {
                if (pipe_is_bool(prt1) == false) {
                    parse.fc_err("T-PIP-E864",
                        base.sb_cat3("`|>?` 的谓词必须返回 bool，实为 `", ti_str(prt1), "`"), rhs);
                    bad = true;
                }
            }
            // ⚠ 映射函数返回 void 会产出无意义的 `[]void`，降解出 `var __pv0: void = f(x);`
            // → LLVM `alloca void`（非法 IR，clang 直接拒绝），C 后端同样是坏声明。
            // 管道是**变换**管线，不是副作用遍历（§3.15 明确不含遍历/生成器语义），
            // 副作用请用 `for (x in xs) { ... }`。宪法 L-02：宁可编译期硬错，不产坏 IR。
            if (pkind == "pipe_map") {
                if (tip_kind(prt1) == "Void") {
                    parse.fc_err("T-PIP-E869",
                        "`|->` 的映射函数不能返回 void：管道用于变换，副作用遍历请用 `for (x in xs)`", rhs);
                    bad = true;
                }
            }
            if (in_seg == false) {
                seg0 = slice_len(pk) as i64;
                seg_src_e = cur_e;
                seg_src_ti = cur_ti;
                seg_elem = flow_elem;
                in_seg = true;
            }
            if (pkind == "pipe_filter") {
                append(pk, "filter");
            } else {
                append(pk, "map");
            }
            append(pf, rhs);
            append(pft, fti);
            append(prt, prt1);
            if (pkind == "pipe_map") { seg_elem = prt1; }
            i = i - 1;
            continue;
        }

        // ── `|>` 多态分派（reference.md §3.15.5）─────────────
        // 整体应用优先；两者同时成立给 W866 并取整体应用。
        var whole: bool = pipe_flows(flow_ti, ppt);
        var elemw: bool = false;
        if (is_seq == true) { elemw = pipe_flows(flow_elem, ppt); }
        if (whole == true and elemw == true) {
            pipe_warn("T-PIP-W866",
                base.sb_cat3("`|>` 的整体应用与逐元素映射同时成立，按规范取整体应用；",
                    "如需逐元素请改写为 `|->`", ""), p);
        }
        if (whole == true) {
            // 冲刷已累积的元素级阶段，再对整段结果做一次调用
            if (in_seg == true) {
                cur_e = pipe_flush(seg_src_e, seg_src_ti, seg_elem, seg0, pk, pf, pft, prt, p);
                cur_ti = ti_elem_of("Slice", seg_elem);
                in_seg = false;
            }
            var wh: i64 = -1;
            var wt: i64 = -1;
            wt = base.list_push(wh, wt, cur_e);
            if (wh < 0) { wh = wt; }
            cur_e = base.mk_call(rhs, wh, -1);
            cur_ti = prt1;
            i = i - 1;
            continue;
        }
        if (elemw == true) {
            if (tip_kind(prt1) == "Void") {
                // `|->` / `|>?` 的映射函数返回 void 没有意义（产出 `[]void` → alloca void 非法 IR），
                // 仍按宪法 L-02 硬错；但 `|>` 的逐元素 void 是合法的**副作用遍历**
                // （`(xs) |> |v| print(v)` 等价于 `for (v in xs) { print(v); }`），降级成 for-each。
                if (pkind != "pipe_apply") {
                    parse.fc_err("T-PIP-E869",
                        "`|->` / `|>?` 的函数不能返回 void：管道用于变换，副作用遍历请用 `for (x in xs)` 或 `(xs) |> |v| ...`", rhs);
                    bad = true;
                    i = i - 1;
                    continue;
                }
                // 冲刷已累积的元素级阶段（如有），再对结果做 for-each
                if (in_seg == true) {
                    cur_e = pipe_flush(seg_src_e, seg_src_ti, seg_elem, seg0, pk, pf, pft, prt, p);
                    cur_ti = ti_elem_of("Slice", seg_elem);
                    in_seg = false;
                }
                // 生成：for (var __fe in <seq>) { rhs(__fe); }
                var fevar: string = base.sb_cat2("__fe", base.i2s(g_pipe_counter));
                g_pipe_counter = g_pipe_counter + 1;
                var argl: i64 = -1;
                var arglt: i64 = -1;
                arglt = base.list_push(argl, arglt, base.mk_ident(fevar, -1));
                if (argl < 0) { argl = arglt; }
                var fecall: i64 = base.mk_call(rhs, argl, -1);
                var feblk: i64 = -1;
                var feblkt: i64 = -1;
                feblkt = base.list_push(feblk, feblkt, base.mk_expr(fecall, -1));
                if (feblk < 0) { feblk = feblkt; }
                var feloop: i64 = base.mk_for_each(fevar, "", cur_e, feblk, -1, -1);
                cur_e = feloop;
                cur_ti = ti_mk("Void");
                i = i - 1;
                continue;
            }
            if (in_seg == false) {
                seg0 = slice_len(pk) as i64;
                seg_src_e = cur_e;
                seg_src_ti = cur_ti;
                seg_elem = flow_elem;
                in_seg = true;
            }
            append(pk, "map");
            append(pf, rhs);
            append(pft, fti);
            append(prt, prt1);
            seg_elem = prt1;
            i = i - 1;
            continue;
        }
        if (is_seq == true) {
            parse.fc_err("T-PIP-E867",
                base.sb_cat3("`|>`：右侧函数既不接受整体 `", ti_str(flow_ti),
                    base.sb_cat3("`，也不接受元素 `", ti_str(flow_elem), "`")), p);
        } else {
            parse.fc_err("T-PIP-E862",
                base.sb_cat3("值类型 `", ti_str(flow_ti),
                    base.sb_cat3("` 无法流入形参类型 `", ti_str(ppt), "`")), rhs);
        }
        bad = true;
        i = i - 1;
    }

    // ── 3. 收尾冲刷 ──────────────────────────────────────────
    if (in_seg == true) {
        cur_e = pipe_flush(seg_src_e, seg_src_ti, seg_elem, seg0, pk, pf, pft, prt, e);
        cur_ti = ti_elem_of("Slice", seg_elem);
    }

    // ── 4. 就地改写：管道节点退化成透传 paren，na 指向降解结果 ──
    // 用 paren 而非直接搬运字段：paren 是既有的透传节点，四处（expr_type_desc /
    // ll_etd / emit_expr / emit_lle）都已支持，无需给后端新增分支。
    // 就地改写 kind ⇒ 该节点的 HIR 指令（PIPE 等）即失效：断开映射，
    // 后续分派回落 CST kind，避免按**改写前**的语义标签再走一遍。
    hir.hir_invalidate((e as u64));
    // `|>` 逐元素 + void lambda 降级出的 for-each 循环是语句，不能作为表达式用
    // paren 包裹（那样会走 emit_expr 路径 → 报 unsupported expr）。这里单独把它
    // 包成一个 block 语句块发射。其余情况照旧退化成透传 paren。
    if (base.node_kind((cur_e as u64)) == "for_each") {
        var bh: i64 = -1;
        var bt: i64 = -1;
        bt = base.list_push(bh, bt, cur_e);
        if (bh < 0) { bh = bt; }
        base.node_set_kind((e as u64), "block");
        base.node_set_na((e as u64), -1);
        base.node_set_nb((e as u64), -1);
        base.node_set_la((e as u64), bh);
        if (bad == true) {
            g_pipe_bad = true;
            return ti_mk("Unknown");
        }
        return cur_ti;
    }
    base.node_set_kind((e as u64), "paren");
    base.node_set_na((e as u64), cur_e);
    base.node_set_nb((e as u64), -1);
    base.node_set_la((e as u64), -1);
    if (bad == true) {
        g_pipe_bad = true;
        return ti_mk("Unknown");
    }
    return cur_ti;
}

pub fn pipe_op_text(k: string) string {
    if (k == "pipe_map") { return "|->"; }
    if (k == "pipe_filter") { return "|>?"; }
    return "|>";
}

// ── 区间字面量降解（M-range）──────────────────────────────────
// 设计前提：**区间不是运行期值**。没有 Range 结构体、没有迭代器协议，`range`
// 节点在 sema（个别在 codegen 的 match 脱糖）里按上下文就地降解掉，两个后端
// 永远看不到 `range` —— 故 codegen_c / codegen_ll 对本特性零改动（除新增的
// slice_sub 内建）。
//
//   for (i in a..b)   → block { var _rgN_hi: i64 = b;
//                               for (var i: i64 = a; i < _rgN_hi; i = i+1) { … } }
//   s[a..b]           → str_slice(s, a, b) / slice_sub(s, a, b)
//   x in a..b         → (x >= a && x < b)
//   match { a..b => } → 比较链（codegen 的 match_chain_from，双后端共用）
//   其余值位置        → 物化成 []i64，即 `(0..10) |> f` 走的路
//
// 端点缺省的语义**按上下文定**，而不是给一套统一默认值：
//   迭代必须有起点（`for (i in ..n)` 无从开始 → E870）；
//   取值必须两端俱全（`0..` 是无穷序列，物化会 OOM → E872）；
//   只有索引位允许缺省，缺省端补 0 / 长度（`s[..]` / `s[2..]` / `s[..3]`）。

pub var g_rng_counter: i64 = 0;
// 物化助手 `__range_fill(lo, hi) []i64` 的函数名；整轮编译只合成一次
pub var g_range_fn: string = "";

pub fn is_range_node(e: i64) bool {
    if (e < 0) { return false; }
    return base.node_kind((e as u64)) == "range";
}

pub fn is_slice_pat(e: i64) bool {
    if (e < 0) { return false; }
    return base.node_kind((e as u64)) == "slice_pat";
}

// 切片模式校验（S6）：scr 必须是 []T 切片；逐元素检查绑定/字面量类型；
// 变体构造器（conpat）暂不支持作切片元素。切片模式永不穷尽，故不置 m_irref。
pub fn validate_slice_pat(pat: i64, scr: i64, rep: bool) void {
    if (scr < 0) { return; }
    // ⚠ scr 是 TI（tis 表）索引，不是 sema.tds 索引：sema.tds 在推断期尚未填充，
    // 直接下标会越界 panic（index_out_of_bounds）。切片判定与元素类型一律走 tis，
    // 与 match 循环其余分支（tip_kind / ti_equal / can_cast）保持一致。
    if (tip_kind(scr) != "Slice") {
        if (rep) {
            var l: i64 = parse.n_line(pat);
            var c: i64 = parse.n_col(pat);
            base.diag_new("T-MAT-E750", "error",
                base.sb_cat3("slice pattern requires a `[]T` slice scrutinee, got ", ti_str(scr), ""),
                parse.n_file(pat), l, c, l, c + 1);
        }
        return;
    }
    var elem: i64 = -1;
    if (scr >= 0 and scr < (slice_len(tis) as i64)) { elem = tis[scr].elem; }
    var ele: i64 = base.node_la((pat as u64));
    var pos: i64 = 0;
    var mq_ks4697: []i64 = base.kids_chain_idx(base.node_la((pat as u64)));
    var mq_ki4697: i64 = 0;
    while (mq_ki4697 < slice_len(mq_ks4697) as i64) {
        ele = mq_ks4697[mq_ki4697];
        if (base.node_kind((base.kids[ele].val as u64)) == "rest") {
            // 占位，无类型约束
        } else if (base.node_kind((base.kids[ele].val as u64)) == "ident") {
            if (base.node_sa((base.kids[ele].val as u64)) != "_") {
                // 元素绑定名：在本臂子作用域声明（与整臂绑定 sa 同处理）
                sym_define(cur_scope, base.node_sa((base.kids[ele].val as u64)), "var", elem, -1);
            }
        } else if (base.node_kind((base.kids[ele].val as u64)) == "conpat") {
            if (rep) {
                var l: i64 = parse.n_line(base.kids[ele].val);
                var c: i64 = parse.n_col(base.kids[ele].val);
                base.diag_new("T-MAT-E750", "error",
                    "variant constructor patterns are not supported as slice elements yet",
                    parse.n_file(base.kids[ele].val), l, c, l, c + 1);
            }
        } else {
            // 字面量元素：与切片元素类型比对
            var et: i64 = infer_expr(base.kids[ele].val);
            if (rep and ti_equal(et, elem) == false and can_cast(et, elem) == false and tip_kind(et) != "Unknown") {
                var l: i64 = parse.n_line(base.kids[ele].val);
                var c: i64 = parse.n_col(base.kids[ele].val);
                base.diag_new("T-MAT-E750", "error",
                    base.sb_cat4("slice element literal type ", ti_str(et), " does not match slice element type ", ti_str(elem)),
                    parse.n_file(base.kids[ele].val), l, c, l, c + 4);
            }
        }
        pos = pos + 1;
        mq_ki4697 = mq_ki4697 + 1;
        ele = -1;
    }
}

pub fn rng_lit(v: i64) i64 {
    return base.mk_int(base.i2s(v), v, -1);
}

// `var <name>: i64 = <init>;`
// 端点一律落到 i64：`0..n` 里的 `0` 若按字面量量级会被猜成 u8，与 `n: i64`
// 混算会在比较处炸类型；can_cast(int, int) 恒真，故初值宽窄不限。
pub fn rng_i64_decl(name: string, init: i64) i64 {
    return base.mk_var_decl(name, false, base.mk_scalar("i64", -1), init, -1);
}

// `<v> = <v> + 1`
pub fn rng_incr(v: string) i64 {
    return base.mk_assign("=", base.mk_ident(v, -1),
        base.mk_binary("+", base.mk_ident(v, -1), rng_lit(1), -1), -1);
}

// 把源节点的锚点（文件/行列）抄给合成节点，让降解后的诊断仍指回用户源码
pub fn rng_anchor(dst: i64, src: i64) void {
    if (dst < 0) { return; }
    if (src < 0) { return; }
    base.node_set_span_id(dst, base.node_span_id(src));
    base.node_set_span_id(dst, base.node_span_id(src));
    base.node_set_span_id(dst, base.node_span_id(src));
}

// 表达式是否为可寻址的 lvalue（可取址 `&x` 的候选）。ident / member / index / deref 均算。
pub fn expr_is_lvalue(e: i64) bool {
    if (e < 0) { return false; }
    if (base.node_kind((e as u64)) == "ident") { return true; }
    if (base.node_kind((e as u64)) == "member" or base.node_kind((e as u64)) == "index" or base.node_kind((e as u64)) == "deref") { return true; }
    return false;
}

// 取 lvalue 表达式的根绑定名：`x`→"x"；`g.x.y`/`a[i]`/`*p`→沿 na 递归到根 ident。
// 用于 const 引用静态常量规则与逃逸分析。
pub fn lvalue_root_name(e: i64) string {
    if (e < 0) { return ""; }
    var k: string = base.node_kind((e as u64));
    if (k == "ident") { return base.node_sa((e as u64)); }
    if (k == "member" or k == "index" or k == "deref") {
        return lvalue_root_name(base.node_na((e as u64)));
    }
    return "";
}

// const 引用静态常量规则（T-SEM-E763）：const 绑定的引用初始化器 `&Y` 必须指向
// 静态常量（顶层 const），不得指向全局 var / 全局 let / 局部绑定。
// 仅在 Y 能在全局作用域解析、却非 const（不在 g_const_decl_ids）时报告，
// 避免对前向 const / 局部引用误报。
pub fn check_const_ref(s: i64) void {
    if (s < 0) { return; }
    if (base.node_nb((s as u64)) < 0) { return; }
    if (base.node_kind((base.node_nb((s as u64)) as u64)) != "amp") { return; }  // v1：仅直接 &Y
    var root: string = lvalue_root_name(base.node_na((base.node_nb((s as u64)) as u64)));
    if (str_len(root) == 0) { return; }
    var gi: i64 = sym_lookup(global_scope, root);
    if (gi < 0) { return; }  // 全局不可见：可能是前向 const 或局部，v1 不误报
    var gdecl: i64 = syms[gi].decl;
    if (gdecl < 0) { return; }
    // 目标必须是静态常量（顶层 const）。var / let / 局部都不行。
    if (base.node_const(gdecl) == 0) {
        parse.fc_err("T-SEM-E763",
            base.sb_cat5("const 引用 `", base.node_sa((s as u64)), "` 只能指向静态常量（顶层 const），但 `", root,
                "` 不是静态常量（const 才能被 const 引用）"),
            s);
    }
}

// 表达式是否含有「指向局部绑定（函数内变量 / 参数）的取址 `&`」。
// 局部绑定不在全局作用域 → 该引用随函数返回/块结束而失效（悬垂风险）。
pub fn expr_has_local_addr(e: i64) bool {
    if (e < 0) { return false; }
    var k: string = base.node_kind((e as u64));
    if (k == "amp") {
        var root: string = lvalue_root_name(base.node_na((e as u64)));
        if (str_len(root) > 0 and sym_lookup(global_scope, root) < 0) { return true; }
        return false;
    }
    if (expr_has_local_addr(base.node_na((e as u64)))) { return true; }
    if (expr_has_local_addr(base.node_nb((e as u64)))) { return true; }
    if (expr_has_local_addr(base.node_nc((e as u64)))) { return true; }
    if (expr_has_local_addr(base.node_nd((e as u64)))) { return true; }   // S4 §0.14.7 SoA：侧表访问器（原 .nd）
    return false;
}

// 赋值目标是否为「更长寿」目标（全局变量 / 全局结构体字段 / 全局数组元素）。
// 是 → 把 `&局部` 赋给它即逃逸为悬垂指针。
pub fn assign_target_escapable(e: i64) bool {
    if (e < 0) { return false; }
    var k: string = base.node_kind((e as u64));
    if (k == "ident") {
        return sym_lookup(global_scope, base.node_sa((e as u64))) >= 0;
    }
    if (k == "member" or k == "index") {
        var root: string = lvalue_root_name(e);
        if (str_len(root) > 0) { return sym_lookup(global_scope, root) >= 0; }
        return false;
    }
    return false;
}

// 表达式可否安全重复求值。降解会把 subject / 被索引对象在 AST 里再引用一次
// （后端按树发射 = 求值两次），只有纯表达式允许；否则报 E875 让用户先绑变量。
pub fn rng_pure(e: i64) bool {
    if (e < 0) { return true; }
    if (base.node_kind((e as u64)) == "ident") { return true; }
    if (base.node_kind((e as u64)) == "int" or base.node_kind((e as u64)) == "float" or base.node_kind((e as u64)) == "bool") { return true; }
    if (base.node_kind((e as u64)) == "string" or base.node_kind((e as u64)) == "atom" or base.node_kind((e as u64)) == "fidconst") { return true; }
    if (base.node_kind((e as u64)) == "paren" or base.node_kind((e as u64)) == "cast" or base.node_kind((e as u64)) == "unary") { return rng_pure(base.node_na((e as u64))); }
    if (base.node_kind((e as u64)) == "member") { return rng_pure(base.node_na((e as u64))); }
    if (base.node_kind((e as u64)) == "index" or base.node_kind((e as u64)) == "binary") {
        if (rng_pure(base.node_na((e as u64))) == false) { return false; }
        return rng_pure(base.node_nb((e as u64)));
    }
    return false;
}

// 闭区间 `..=hi` 的**排他**上界：hi + 1。半开区间原样返回。
// ⚠ 闭合区间把 `hi` 抬成 `hi + 1`。此处**不能**无条件合成 `+` 节点：
//   `comptime_fold_pass` 跑在 `run_check()` **之后**（tc.tc 三处调度均是），它会遍历到
//   sema 期合成的节点并折叠；而 `rng_lit(1)` 是合成的字面量、未经 infer ⇒ 折叠期右操作数
//   被当成 0，`8 + 1` 折成 8 —— 表现为 `s[6..=8]` 少一个字符、`1..=4` 物化少一个元素
//   （而端点含变量时因含运行期引用被折叠跳过，反而正确：故「字面量错、变量对」）。
//   常量端点直接算出字面量，不再造二元节点，天然免疫该折叠。
pub fn rng_excl_hi(hi: i64, incl: bool) i64 {
    if (incl == false) { return hi; }
    // ⚠ 字面量的权威值在 **sa**（sema 自身推断 int 类型时就是 `lit_u64(node_sa)`，
    //   从不读 ia）；sb 存位宽后缀（`8i64`），决定类型，必须一并带到新节点上。
    if (base.node_kind((hi as u64)) == "int") {
        var nv: i64 = (lit_u64(base.node_sa((hi as u64))) as i64) + 1;
        var nid: i64 = (base.mk_int(base.i2s(nv), nv, -1) as i64);
        base.node_set_sb((nid as u64), base.node_sb((hi as u64)));   // 位宽后缀：保类型不退化
        base.node_set_span_id(nid, base.node_span_id(hi));
        return nid;
    }
    return base.mk_binary("+", hi, rng_lit(1), -1);
}

// 物化助手（惰性合成，整轮编译共用一份）：
//   __range_fill fn(lo: i64, hi: i64) []i64 {
//       var out: []i64 = [];
//       for (var i: i64 = lo; i < hi; i = i + 1) { append(out, i); }
//       return out;
//   }
// 与 __pipe_N 同一套注入机制：register_decl 填签名 → decl_list 供发射 →
// g_pipe_decls 让 run_check 尾部补检（主检查循环长度已冻结）。
pub fn rng_make_helper() string {
    if (str_len(g_range_fn) > 0) { return g_range_fn; }
    var name: string = "__range_fill";

    var ph: i64 = -1;
    var pt: i64 = -1;
    pt = base.list_push(ph, pt, base.mk_P("lo", base.mk_scalar("i64", -1), -1, -1));
    if (ph < 0) { ph = pt; }
    pt = base.list_push(ph, pt, base.mk_P("hi", base.mk_scalar("i64", -1), -1, -1));
    if (ph < 0) { ph = pt; }

    var apph: i64 = -1;
    var appt: i64 = -1;
    appt = base.list_push(apph, appt, base.mk_ident("out", -1));
    if (apph < 0) { apph = appt; }
    appt = base.list_push(apph, appt, base.mk_ident("i", -1));
    if (apph < 0) { apph = appt; }
    var bodyh: i64 = base.list_push(-1, -1,
        base.mk_expr(base.mk_call(base.mk_ident("append", -1), apph, -1), -1));

    var floop: i64 = base.mk_for(
        rng_i64_decl("i", base.mk_ident("lo", -1)),
        base.mk_binary("<", base.mk_ident("i", -1), base.mk_ident("hi", -1), -1),
        rng_incr("i"), bodyh, -1, -1);

    var fh: i64 = -1;
    var ft: i64 = -1;
    ft = base.list_push(fh, ft, base.mk_var_decl("out", false,
        base.mk_slice(base.mk_scalar("i64", -1), -1), base.mk_array_lit(-1, -1), -1));
    if (fh < 0) { fh = ft; }
    ft = base.list_push(fh, ft, floop);
    if (fh < 0) { fh = ft; }
    ft = base.list_push(fh, ft, base.mk_return(base.mk_ident("out", -1), -1));
    if (fh < 0) { fh = ft; }

    var fdecl: i64 = base.mk_FuncDecl(name, false, false,
        base.mk_slice(base.mk_scalar("i64", -1), -1), -1, ph, fh, -1);
    register_decl(fdecl);
    append(lex.decl_list, fdecl);
    append(g_pipe_decls, fdecl);
    g_range_fn = name;
    return name;
}

// 值位置的区间 → []i64。两端必须俱全：`0..` / `..n` / `..` 是无穷或无起点序列。
pub fn materialize_range(e: i64) i64 {
    var out_ti: i64 = ti_elem_of("Slice", ti_scalar("i64"));
    if (base.node_na((e as u64)) < 0 or base.node_nb((e as u64)) < 0) {
        parse.fc_err("T-RNG-E872",
            "开放区间不能当作值：`a..` / `..b` / `..` 只在切片索引里有意义，取值请写成 `a..b`", e);
        return out_ti;
    }
    infer_expr(base.node_na((e as u64)));
    infer_expr(base.node_nb((e as u64)));
    var fname: string = rng_make_helper();
    var ah: i64 = -1;
    var at: i64 = -1;
    at = base.list_push(ah, at, base.node_na((e as u64)));
    if (ah < 0) { ah = at; }
    at = base.list_push(ah, at, rng_excl_hi(base.node_nb((e as u64)), base.node_ba((e as u64))));
    if (ah < 0) { ah = at; }
    var cl: i64 = base.mk_call(base.mk_ident(fname, -1), ah, -1);
    rng_anchor(cl, e);
    // 就地退化成透传 paren（与管道降解同一手法）：paren 在四处 emit/etd 都已支持，
    // 且重复 infer 天然幂等（第二次走的是 paren 分支）。
    hir.hir_invalidate((e as u64));
    base.node_set_kind((e as u64), "paren");
    base.node_set_na((e as u64), cl);
    base.node_set_nb((e as u64), -1);
    base.node_set_la((e as u64), -1);
    base.node_set_ba((e as u64), false);   // S4 §0.14.7 SoA：侧表写（原 on.ba = false；第十批）
    return out_ti;
}

// `obj[lo..hi]` → str_slice / slice_sub 调用。缺省端补 0 / 长度。
pub fn lower_range_index(e: i64) i64 {
    var ot: i64 = infer_expr(base.node_na((e as u64)));
    var k: string = tip_kind(ot);
    if (base.node_na((base.node_nb((e as u64)) as u64)) >= 0) { infer_expr(base.node_na((base.node_nb((e as u64)) as u64))); }
    if (base.node_nb((base.node_nb((e as u64)) as u64)) >= 0) { infer_expr(base.node_nb((base.node_nb((e as u64)) as u64))); }
    if (k == "Unknown") { return ti_mk("Unknown"); }
    if (k == "Array") {
        // 定长数组在 C 后端是裸 T*、在 LLVM 后端是 [N x T]，都不是 TSlice。
        // Array→Slice 的构造 lowering 已落地（cast 节点 → t_slice_from_raw / @tll_slice_from_raw），
        // 这里包一层 cast 把它降级成零拷贝切片视图，随后与 `[]T` 走同一条 slice_sub 路径。
        var ati: TI = tis[ot];
        var asti: i64 = ti_elem_of("Slice", ati.elem);
        base.node_set_na((e as u64), base.mk_cast(base.node_na((e as u64)), ti_to_type_node(asti), -1));
        ot = asti;
        k = "Slice";
    }
    if (k != "String" and k != "Slice" and k != "Bytes") {
        parse.fc_err("T-RNG-E871",
            base.sb_cat3("类型 `", ti_str(ot), "` 不支持区间索引：只有 string 与 []T 可以按区间切片"), e);
        return ti_mk("Unknown");
    }
    var hi: i64 = -1;
    if (base.node_nb((base.node_nb((e as u64)) as u64)) >= 0) {
        hi = rng_excl_hi(base.node_nb((base.node_nb((e as u64)) as u64)), base.node_ba((base.node_nb((e as u64)) as u64)));
    } else {
        // 上界省略 → 取长度收尾。被索引对象因此在 AST 里出现两次。
        if (rng_pure(base.node_na((e as u64))) == false) {
            parse.fc_err("T-RNG-E875",
                "省略上界的区间索引要对被索引对象多求值一次（取长度），但它含调用或副作用：请先绑定到变量再切", e);
            return ti_mk("Unknown");
        }
        var lenf: string = "slice_len";
        if (k == "String") { lenf = "str_len"; }
        if (k == "Bytes") { lenf = "bytes_len"; }
        var lenargs: i64 = base.list_push(-1, -1, base.node_na((e as u64)));
        // str_len / slice_len 返回 u64，切片函数吃 i64 —— 显式转掉，别指望隐式收敛
        hi = base.mk_cast(base.mk_call(base.mk_ident(lenf, -1), lenargs, -1), base.mk_scalar("i64", -1), -1);
    }
    var lo: i64 = base.node_na((base.node_nb((e as u64)) as u64));
    if (lo < 0) { lo = rng_lit(0); }
    var fname: string = "slice_sub";
    if (k == "String") { fname = "str_slice"; }
    if (k == "Bytes") { fname = "bytes_slice"; }
    var ah: i64 = -1;
    var at: i64 = -1;
    at = base.list_push(ah, at, base.node_na((e as u64)));
    if (ah < 0) { ah = at; }
    at = base.list_push(ah, at, lo);
    if (ah < 0) { ah = at; }
    at = base.list_push(ah, at, hi);
    if (ah < 0) { ah = at; }
    var cl: i64 = base.mk_call(base.mk_ident(fname, -1), ah, -1);
    rng_anchor(cl, e);
    hir.hir_invalidate((e as u64));
    base.node_set_kind((e as u64), "paren");
    base.node_set_na((e as u64), cl);
    base.node_set_nb((e as u64), -1);
    base.node_set_la((e as u64), -1);
    if (k == "String") { return ti_mk("String"); }
    if (k == "Bytes") { return ti_mk("Bytes"); }
    return ot;
}

// `x in lo..hi` → `(x >= lo && x < hi)`。x 出现两次，故要求它可重复求值。
pub fn lower_in_range(e: i64) i64 {
    if (is_range_node(base.node_nb((e as u64))) == false) {
        parse.fc_err("T-RNG-E877",
            "`in` 的右侧只能是区间字面量（`x in 1..10` / `x in 'a'..='z'`）；容器成员测试请自己写循环", e);
        infer_expr(base.node_na((e as u64)));
        return ti_scalar("bool");
    }
    if (rng_pure(base.node_na((e as u64))) == false) {
        parse.fc_err("T-RNG-E875",
            "`in` 的左侧要展开成两次比较（求值两次），但它含调用或副作用：请先绑定到变量", e);
        return ti_scalar("bool");
    }
    infer_expr(base.node_na((e as u64)));
    if (base.node_na((base.node_nb((e as u64)) as u64)) >= 0) { infer_expr(base.node_na((base.node_nb((e as u64)) as u64))); }
    if (base.node_nb((base.node_nb((e as u64)) as u64)) >= 0) { infer_expr(base.node_nb((base.node_nb((e as u64)) as u64))); }
    var test: i64 = base.mk_range_test(base.node_na((e as u64)), base.node_na((e as u64)), base.node_nb((e as u64)));
    rng_anchor(test, e);
    hir.hir_invalidate((e as u64));
    base.node_set_kind((e as u64), "paren");
    base.node_set_sa((e as u64), "");
    base.node_set_na((e as u64), test);
    base.node_set_nb((e as u64), -1);
    base.node_set_la((e as u64), -1);
    infer_expr(test);
    return ti_scalar("bool");
}

// `for (v in lo..hi) { body }` → 零分配计数循环。就地把 for_each 改写成 block：
//   { var _rgN_hi: i64 = hi; for (var v: i64 = lo; v < _rgN_hi; v = v+1) { body } }
// 上界先落进临时量，这就是「右端只求值一次」的实现（`for (i in 0..xs.len())`
// 不会每轮重算）。上界省略（`for (i in 0..)`）则不生成条件 = 无限循环，靠 break 收口。
pub fn lower_for_range(s: i64) void {
    if (base.node_na((base.node_na((s as u64)) as u64)) < 0) {
        parse.fc_err("T-RNG-E870",
            "区间迭代必须有起点：`..n` / `..` 无从开始，请写成 `0..n`", base.node_na((s as u64)));
        return;
    }
    if (str_len(base.node_sb((s as u64))) > 0) {
        parse.fc_err("T-RNG-E870",
            "`for (k, v in ...)` 的双变量形式只用于 map；区间每轮只产出一个整数", base.node_na((s as u64)));
        return;
    }
    var head: i64 = -1;
    var tail: i64 = -1;
    var cond: i64 = -1;
    if (base.node_nb((base.node_na((s as u64)) as u64)) >= 0) {
        var hname: string = base.sb_cat3("_rg", base.i2s(g_rng_counter), "_hi");
        g_rng_counter = g_rng_counter + 1;
        tail = base.list_push(head, tail, rng_i64_decl(hname, base.node_nb((base.node_na((s as u64)) as u64))));
        if (head < 0) { head = tail; }
        var cop: string = "<";
        if (base.node_ba((base.node_na((s as u64)) as u64)) == true) { cop = "<="; }
        cond = base.mk_binary(cop, base.mk_ident(base.node_sa((s as u64)), -1), base.mk_ident(hname, -1), -1);
    }
    var floop: i64 = base.mk_for(rng_i64_decl(base.node_sa((s as u64)), base.node_na((base.node_na((s as u64)) as u64))), cond, rng_incr(base.node_sa((s as u64))), base.node_la((s as u64)), -1, -1);
    rng_anchor(floop, s);
    tail = base.list_push(head, tail, floop);
    if (head < 0) { head = tail; }

    hir.hir_invalidate((s as u64));
    base.node_set_kind((s as u64), "block");
    base.node_set_sa((s as u64), "");
    base.node_set_sb((s as u64), "");
    base.node_set_na((s as u64), -1);
    base.node_set_la((s as u64), head);
}

// `for (v in 定长数组) { body }` → 改写成计数循环，每轮用 `<iter>[i]` 取下标元素
// （与 lower_for_range 同构，避免改动两后端 for_each）。
// 背景：LLVM / C 后端 for_each 只处理 slice 与 map，定长数组会掉进 slice 分支、
// 对数组值调 t_slice_len/t_slice_at 读垃圾 → 运行期段错误。此降级在 sema 层完成，
// 复用数组下标（基础特性，两后端均已支持）。
// 注意：直接对原迭代器表达式下标 `<iter>[i]`，不另绑临时数组 —— 定长数组在 var_decl
// 初始化里不会按元素拷贝（仅 zeroinit），绑临时量会丢失数据。
pub fn lower_for_array(s: i64) void {
    if (str_len(base.node_sb((s as u64))) > 0) {
        parse.fc_err("T-SEM-E202",
            "for (k, v in x): 双变量迭代仅支持 map", base.node_na((s as u64)));
        return;
    }
    var itt: i64 = infer_expr(base.node_na((s as u64)));
    var tt: TI = tis[itt];
    var eti: i64 = tt.elem;
    var alen: i64 = tt.alen;
    if (eti < 0 or alen <= 0) {
        parse.fc_err("T-SEM-E203",
            "for (v in x): 定长数组迭代未能解析元素类型 / 长度", base.node_na((s as u64)));
        return;
    }
    // 循环计数器
    var iname: string = base.sb_cat3("_fa", base.i2s(g_rng_counter), "_i");
    g_rng_counter = g_rng_counter + 1;
    // 长度绑进临时量（与 lower_for_range 的 _rgN_hi 同构：避免「字面量直接作比较右操作数」这一未充分测试的发射路径）
    var lname: string = base.sb_cat3("_fa", base.i2s(g_rng_counter), "_len");
    g_rng_counter = g_rng_counter + 1;
    var lendcl: i64 = base.mk_var_decl(lname, false, base.mk_scalar("i64", -1), base.mk_int(base.i2s(alen), 10, -1), -1);
    // 每轮：var <loopvar>: ElemT = <iter>[i];
    var elidx: i64 = base.mk_index(base.node_na((s as u64)), base.mk_ident(iname, -1), -1);
    var eldecl: i64 = base.mk_var_decl(base.node_sa((s as u64)), false, mk_type_node_from_ti(eti), elidx, -1);
    // 新循环体 = 元素声明 + 原 body
    var bhead: i64 = -1; var btail: i64 = -1;
    btail = base.list_push(bhead, btail, eldecl); if (bhead < 0) { bhead = btail; }
    var bk: i64 = base.node_la((s as u64));
    while (bk >= 0) {
        btail = base.list_push(bhead, btail, base.kids[bk].val);
        bk = base.kids[bk].next;
    }
    if (bhead < 0) { bhead = btail; }
    // 计数循环：for (var _faN_i: i64 = 0; _faN_i < _faN_len; _faN_i = _faN_i + 1) { ... }
    var floop: i64 = base.mk_for(rng_i64_decl(iname, rng_lit(0)),
        base.mk_binary("<", base.mk_ident(iname, -1), base.mk_ident(lname, -1), -1),
        rng_incr(iname), bhead, -1, -1);
    // block 的 la 必须是 kids 链表头：先放长度声明（供循环条件可见），再放循环本身
    var head: i64 = -1; var tail: i64 = -1;
    tail = base.list_push(head, tail, lendcl); if (head < 0) { head = tail; }
    tail = base.list_push(head, tail, floop);
    hir.hir_invalidate((s as u64));
    base.node_set_kind((s as u64), "block");
    base.node_set_sa((s as u64), "");
    base.node_set_sb((s as u64), "");
    base.node_set_na((s as u64), -1);
    base.node_set_la((s as u64), head);
}

// ── 表达式类型推断 inferExprType（复刻 checker.ts:479）────────

// Device 子系统 host 内建类型检查（docs/compiler/device-design.md §6 M3）。
// 全部以 i64 句柄交换设备指针，避免引入 dev_ptr 的 TI 地址空间（TI→TD 会丢 memspace）。
pub fn infer_device_call(e: i64, fname: string) i64 {
    // 实参类型推导（保证嵌套表达式被检查）
    var c: i64 = base.node_la((e as u64));
    var mq_ks5131: []i64 = base.kids_chain_idx(base.node_la((e as u64)));
    var mq_ki5131: i64 = 0;
    while (mq_ki5131 < slice_len(mq_ks5131) as i64) {
        c = mq_ks5131[mq_ki5131];
        infer_expr(base.kids[c].val);
        mq_ki5131 = mq_ki5131 + 1;
        c = -1;
    }
    if (fname == "alloc_bytes") { return ti_scalar("i64"); }
    if (fname == "free") { return ti_mk("Void"); }
    if (fname == "h2d" or fname == "d2h") { return ti_mk("Void"); }
    if (fname == "launch") { return ti_scalar("i32"); }
    parse.fc_err("T-SEM-E201", base.sb_cat3("未知 device 内建 `", fname, "`"), e);
    return ti_mk("Unknown");
}

// ── Device 安全子集校验（M4，docs/compiler/device-design.md §8）──────────────
// 在 kernel fn 体内禁止：闭包 / 动态分配(append) / host 运行时调用；device 专用内建
// 只能出现在 kernel 内；kernel 间调用/递归禁止。emit-dev(parse-only) 与 check/build
// 双路径共用：仅消费 AST 节点类型，不依赖 sema 类型状态（tc.tc 无 kernel → 不影响自举）。
var g_dev_builtins: []string;   // 设备专用内建名（与 g_dev_arity 平行）
var g_dev_arity: []i64;          // 对应期望实参数
var g_dev_forbid: []string;      // kernel 内禁用的 host 运行时内建名
var g_dev_inited: bool;

pub fn dev_init_sets() void {
    if (g_dev_inited) { return; }
    g_dev_inited = true;
    append(g_dev_builtins, "thread_id");     append(g_dev_arity, 1);
    append(g_dev_builtins, "block_id");      append(g_dev_arity, 1);
    append(g_dev_builtins, "block_dim");     append(g_dev_arity, 1);
    append(g_dev_builtins, "grid_dim");      append(g_dev_arity, 1);
    append(g_dev_builtins, "barrier");       append(g_dev_arity, 0);
    append(g_dev_builtins, "atomic_add");    append(g_dev_arity, 2);
    append(g_dev_builtins, "shared_alloc");  append(g_dev_arity, 1);
    append(g_dev_forbid, "print");
    append(g_dev_forbid, "println");
    append(g_dev_forbid, "eprint");
    append(g_dev_forbid, "@panic");
    append(g_dev_forbid, "@assert");
    append(g_dev_forbid, "@assert_eq");
}

pub fn dev_name_in(names: []string, s: string) bool {
    var i: i64 = 0;
    while (i < (slice_len(names) as i64)) {
        if (names[i] == s) { return true; }
        i = i + 1;
    }
    return false;
}

pub fn dev_builtin_arity(name: string) i64 {
    var i: i64 = 0;
    while (i < (slice_len(g_dev_builtins) as i64)) {
        if (g_dev_builtins[i] == name) { return g_dev_arity[i]; }
        i = i + 1;
    }
    return -1;
}

pub fn dev_callee_name(callNode: i64) string {
    if (callNode < 0) { return ""; }
    var nlen: i64 = base.node_count();
    if (callNode >= nlen) { return ""; }
    var na: i64 = base.node_na((callNode as u64));
    if (na < 0 or na >= nlen) { return ""; }
    if (base.node_kind((na as u64)) == "ident") { return base.node_sa((na as u64)); }
    return "";
}

pub fn dev_arg_count(callNode: i64) i64 {
    if (callNode < 0) { return 0; }
    var h: i64 = base.node_la((callNode as u64));
    var c: i64 = h;
    var n: i64 = 0;
    var klen: i64 = slice_len(base.kids) as i64;
    while (c >= 0 and c < klen) {
        n = n + 1;
        c = base.kids[c].next;
    }
    return n;
}

pub fn dev_check_list(h: i64, in_kernel: bool, cur: string, knames: []string) void {
    var klen: i64 = slice_len(base.kids) as i64;
    var c: i64 = h;
    while (c >= 0 and c < klen) {
        dev_check_node(base.kids[c].val, in_kernel, cur, knames);
        c = base.kids[c].next;
    }
}

pub fn dev_check_node(e: i64, in_kernel: bool, cur: string, knames: []string) void {
    if (e < 0) { return; }
    var nlen: i64 = base.node_count();
    if (e >= nlen) { return; }
    if (base.node_kind((e as u64)) == "call") {
        var fname: string = dev_callee_name(e);
        if (in_kernel == false and dev_name_in(g_dev_builtins, fname)) {
            parse.fc_err("T-DEV-E950",
                base.sb_cat3("device-only builtin `", fname, "` 只能用于 kernel fn 体内"), e);
        }
        if (in_kernel and dev_name_in(g_dev_builtins, fname)) {
            var exp: i64 = dev_builtin_arity(fname);
            var got: i64 = dev_arg_count(e);
            if (exp != got) {
                parse.fc_err("T-DEV-E953",
                    base.sb_cat7("device builtin `", fname, "` 期望 ", base.i2s(exp),
                        " 个实参，收到 ", base.i2s(got), ""), e);
            }
        }
        if (in_kernel and dev_name_in(g_dev_forbid, fname)) {
            parse.fc_err("T-DEV-E951",
                base.sb_cat3("kernel 内禁止调用 host 运行时 `", fname, "`"), e);
        }
        if (in_kernel and dev_name_in(knames, fname)) {
            parse.fc_err("T-DEV-E952",
                base.sb_cat5("kernel `", cur, "` 调用了 kernel `", fname,
                    "`（kernel 间调用/递归在设备安全子集内禁止）"), e);
        }
        if (in_kernel and fname == "append") {
            parse.fc_err("T-DEV-E951", "kernel 内禁止动态 append（动态分配）", e);
        }
    }
    if (in_kernel and (base.node_kind((e as u64)) == "closure_make" or base.node_kind((e as u64)) == "closure_capture" or base.node_kind((e as u64)) == "lambda")) {
        parse.fc_err("T-DEV-E951", base.sb_cat3("kernel 内禁止闭包（", base.node_kind((e as u64)), "）"), e);
    }
    // 无捕获闭包在 sema 提升阶段就地降级为 ident(__lam_N)；仍是「kernel 内禁止闭包」
    if (in_kernel and base.node_kind((e as u64)) == "ident" and str_len(base.node_sa((e as u64))) >= 6 and str_slice(base.node_sa((e as u64)), 0, 6) == "__lam_") {
        parse.fc_err("T-DEV-E951", "kernel 内禁止闭包（无捕获闭包降级为 ident）", e);
    }
    // 递归子节点（AST 为树，无环，无需 visited 去重）
    dev_check_node(base.node_na((e as u64)), in_kernel, cur, knames);
    dev_check_node(base.node_nb((e as u64)), in_kernel, cur, knames);
    dev_check_node(base.node_nc((e as u64)), in_kernel, cur, knames);
    dev_check_node(base.node_nd((e as u64)), in_kernel, cur, knames);   // S4 §0.14.7 SoA：侧表访问器（原 .nd）
    dev_check_list(base.node_la((e as u64)), in_kernel, cur, knames);
    dev_check_list(base.node_lb((e as u64)), in_kernel, cur, knames);
    dev_check_list(base.node_lc((e as u64)), in_kernel, cur, knames);
}

pub fn run_device_check() void {
    dev_init_sets();
    // 收集本模块全部 kernel fn 名（递归检测）
    var knames: []string = [];
    var i: i64 = 0;
    var nlen: i64 = base.node_count();
    while (i < nlen) {
        // S4 §0.14.7 SoA：bf 已外置（原 `nd.bf`）
        if (base.node_kind((i as u64)) == "FuncDecl" and base.node_bf((i as u64)) == true) {
            append(knames, base.node_sa((i as u64)));
        }
        i = i + 1;
    }
    // 逐个函数走 body：kernel 体内 in_kernel=true，host 函数 in_kernel=false
    i = 0;
    while (i < nlen) {
        if (base.node_kind((i as u64)) == "FuncDecl") {
            dev_check_list(base.node_lc((i as u64)), base.node_bf((i as u64)), base.node_sa((i as u64)), knames);   // S4 §0.14.7 SoA：原 `nd.bf`
        }
        i = i + 1;
    }
}

// ── 前导点语法的上下文辅助 ────────────────────────────────────
// 查具名结构体某字段的类型 TI（按名在 StructDecl 字段链 sd.lb 中匹配）。供 `.{...}` 推断
// 嵌套结构体字段、`.a` 解析 self 字段类型。查不到返回 -1（调用方退化为 Unknown / 报错）。
// 元组字面量 `.{e1, e2, ...}`：据元素值类型（TI 列表）合成或复用位置字段具名 struct 类型名。
// 与匿名元组类型 `.{T1,T2}`（parse 期合成、已登记 global_scope）共享同一规范名算法，
// 故同构元组（无论是类型标注还是字面量推导）都落到同一 struct 声明，互操作无缝。
pub fn tuple_lit_type_name(elem_tis: []i64) string {
    // 元素 TI → 类型 AST 节点 → mangle（须与 parse.synth_tuple_type_name 永远一致）
    // ⚠ 局部变量曾禁用 `nodes`（会与 `base.nodes` 跨模块裸名冲突触发 T-MOD-E561）⇒ 故名 `elem_nodes`；20-F 已删 `base.nodes`，该冲突不复存在，名字沿用不动。
    var elem_nodes: []i64;
    var i: i64 = 0;
    while (i < slice_len(elem_tis) as i64) {
        append(elem_nodes, ti_to_type_node(elem_tis[i]));
        i = i + 1;
    }
    var sname: string = parse.synth_tuple_type_name(elem_nodes);
    if (sym_lookup(global_scope, sname) >= 0) {
        return sname;
    }
    if (parse.tuple_struct_exists(sname) == false) {
        var fh: i64 = -1;
        var fht: i64 = -1;
        var idx: i64 = 0;
        while (idx < slice_len(elem_nodes) as i64) {
            var fid: i64 = base.node_new("F");
            base.node_set_sa((fid as u64), base.sb_cat2("_", base.i2s(idx)));
            base.node_set_na((fid as u64), elem_nodes[idx]);   // 字段类型节点（元素类型，sema 期 resolve_ti 解析）
            base.node_set_ib((fid as u64), -1);   // S4 §0.14.7 SoA：取代 `fnn.ib`（下方 slice_set 回写生效）
            base.node_set_la((fid as u64), -1);
            base.node_set_nb((fid as u64), -1);
            fht = base.list_push(fh, fht, fid);
            if (fh < 0) { fh = fht; }
            idx = idx + 1;
        }
        var sd: i64 = base.mk_StructDecl(sname, "", "", false, false, -1, fh, -1);
        append(lex.decl_list, sd);
        sym_define(global_scope, sname, "type", ti_named("Struct", sname), sd);
    }
    return sname;
}

pub fn struct_field_ti(sname: string, fname: string) i64 {
    var si: i64 = sym_lookup(global_scope, sname);
    if (si < 0) { return -1; }
    var s: Sym = syms[si];
    if (s.decl < 0) { return -1; }
    if (base.node_kind((s.decl as u64)) != "StructDecl") { return -1; }
    var c: i64 = base.node_lb((s.decl as u64));
    while (c >= 0) {
        if (base.node_sa((base.kids[c].val as u64)) == fname) { return resolve_ti(base.node_na((base.kids[c].val as u64))); }
        c = base.kids[c].next;
    }
    return -1;
}

// ⚠ 兜底 idecl 回填（FS-2b 收尾）：递归收集节点子树内所有标识符并补调 infer_expr，
// 使 C 后端 shadowing 改名能覆盖「嵌套在调用实参中的标识符」。
// 典型现场：TirEmitRes{ name: d, st: tir_st_from_str(st) } —— 字段值 tir_st_from_str(st)
// 是 call 节点，st 作为其实参位于结构体字面量字段内部，旧「仅 direct 字段值 ident」补调
// 漏掉它 → C 后端发射改名时 idecl_get 查不到 st → 报 undeclared identifier。
// 仅对 ident 调 infer_expr（记录其解析到的声明节点），不改写 IR、对 LLVM 后端无碍、幂等。
pub fn sema_idecl_infer_idents(m: i64) void {
    if (base.node_kind((m as u64)) == "ident") {
        // 仅登记 idecl（供后端 shadowing 改名），不跑完整 infer_expr：完整推断会对
        // 跨模块/类型名标识符误报「未定义」，且会重复做类型检查。这里只反查声明节点并
        // 登记，解析不到（如跨模块名在兜底调用上下文不可见）则跳过——那些标识符本就不是
        // 被 shadow 的局部，后端发裸名即可，无需 idecl。
        var si: i64 = sym_lookup(cur_scope, base.node_sa((m as u64)));
        if (si < 0) { si = sym_lookup(global_scope, base.node_sa((m as u64))); }
        if (si >= 0) {
            var s: Sym = syms[si];
            if (s.decl >= 0) { base.node_set_resolve(m, s.decl); }
        }
        return;
    }
    // 表达式子操作数常存于 na/nb（index/member/call/binary/unary/paren/deref/range/cast），
    // 仅走 la 链会漏掉其中的标识符 → 其 idecl 表缺登记 → 后端 shadowing 改名时 idecl_get
    // 查不到，发未唯一化的原名 → C 后端 clang 报 undeclared 'idx'/'lhstd'（cself 门禁炸点）。
    // 对这些承载表达式的节点种类下探 na/nb；cast.nb 是类型描述（非表达式）须跳过，否则会把
    // 类型名当值反查 idecl 误报未定义标识符。
    if (base.node_kind((m as u64)) == "index" or base.node_kind((m as u64)) == "member" or base.node_kind((m as u64)) == "call"
        or base.node_kind((m as u64)) == "binary" or base.node_kind((m as u64)) == "unary" or base.node_kind((m as u64)) == "paren"
        or base.node_kind((m as u64)) == "deref" or base.node_kind((m as u64)) == "range") {
        if (base.node_na((m as u64)) >= 0) { sema_idecl_infer_idents(base.node_na((m as u64))); }
        if (base.node_nb((m as u64)) >= 0) { sema_idecl_infer_idents(base.node_nb((m as u64))); }
    } else if (base.node_kind((m as u64)) == "cast") {
        if (base.node_na((m as u64)) >= 0) { sema_idecl_infer_idents(base.node_na((m as u64))); }
    }
    var c: i64 = base.node_la((m as u64));
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环
    var ks5318: []i64 = base.kids_chain(c);
    var ki5318: i64 = 0;
    while (ki5318 < slice_len(ks5318) as i64) {
        var kv5318: i64 = ks5318[ki5318];
        sema_idecl_infer_idents(kv5318);
        ki5318 = ki5318 + 1;
    }
}

// Stage B：sema 的表达式**分派键**取自 HIR 指令（op → 语义标签），
// 不再直接读 `node.kind`。三类节点回落 CST kind：
//   ① 无 HIR 指令（脱糖合成）；② RAW（AstGen 未建模）；③ 委托指令
//      （paren/expr 的 inst 属于内层子节点，`nd != e` 时不可用）。
pub fn hir_tag(e: i64) string {
    var ei: i64 = hir.hir_of_node((e as u64));
    if (ei >= 0) {
        var en: i64 = hir.hir_inst_node(ei);
        if (en == e) {
            var t: string = hir.hir_tag_of_op(hir.hir_op_of(ei));
            if (t != "") { return t; }
        }
    }
    return base.node_kind((e as u64));
}

// ── Stage B-2：表达式「下降边」也取自 HIR ─────────────────────
// Stage B 只把入口与分派键搬进 HIR，分支体里仍读 `n.na / n.nb / base.kids[...]`
// 找子节点；这里改为向 HIR 指令要操作数：
//   `ie_sub(ei, k, fb)`   —— 取 HIR 第 k 个操作数（positional）；
//   `ie_sub_in(ei, fb)`   —— 在 HIR 操作数表里查找该子节点（列表型子节点用）。
//
// ⚠ 安全网：**只有 HIR 操作数指向的正是 CST 那个子节点时才走 HIR**，否则回落 CST。
//   sema 就地改写过子节点（或该边根本没被 AstGen 建模）时，HIR 反映的是改写前的
//   结构 —— 硬走 HIR 会把「旧子节点」再推一遍，那是**静默错编**，远比回落危险。
//   回落次数由 g_hir_edge_cst 计；它收敛到 0 之后，CST 读法即可整体删掉。
pub var g_hir_edge_hir: i64 = 0;
pub var g_hir_edge_cst: i64 = 0;
pub var g_hir_edge_noinst: i64 = 0;    // 回落原因①：该节点没有 HIR 指令（sema 期合成 / 已失效）
pub var g_hir_edge_mis: i64 = 0;       // 回落原因②：有指令，但操作数不是这个 CST 子节点

// 取节点 e 自己的 HIR 指令。委托指令（paren / expr 的 inst 属于内层子节点，
// `nd != e`）对本节点没有操作数语义，一律当作「无指令」处理。
pub fn ie_inst(e: i64) i64 {
    if (e < 0) { return -1; }
    var ei: i64 = hir.hir_of_node((e as u64));
    if (ei < 0) { return -1; }
    if (hir.hir_inst_node(ei) != e) { return -1; }
    return ei;
}

// 回落原因②的诊断：`T_HIR_EDGE_TRACE=1` 时打印「父 op / 子 kind」，
// 用来分辨是 AstGen 漏建模，还是 sema 就地改写导致两边本就不同。
pub fn ie_mis(ei: i64, fb: i64) void {
    g_hir_edge_mis = g_hir_edge_mis + 1;
    if (str_len(getenv("T_HIR_EDGE_TRACE")) > 0) {
        eprint("HIR-EDGE-MIS parent_op=" + base.i2s(hir.hir_op_of(ei))
            + " child_kind=" + base.node_kind((fb as u64)));
    }
}

// S2b：def-use 遍历的循环断路器。
// 关键坑：t 的 LLVM 后端对**递归函数内的 `defer`** 发射错误——清理语句被提前执行（在子递归
// 调用前就把标记清零），导致真环检测失效、self-host 编译自身大源时无限递归栈溢出
// （exit 127 / 0xC00000FD）。故**禁用 defer**，改用 `infer_expr` 包装层在 body 返回后显式
// 清零（语义等价于正确实现的 defer）。标记存于全局切片 `g_infer_on`（与 C 后端一致，已验证
// 正确）；首入一次性预扩到节点池长度（`base.node_count()`）+ 8M 余量，递归中不再 realloc，避免切片重分配
// 造成已置位标记丢失（LLVM 后端对全局切片重分配敏感）。
var g_infer_on: []i64;
var g_rec_depth: i64 = 0;
pub fn ie_infer(fb: i64) i64 {
    if (fb < 0) { return ti_mk("Unknown"); }
    if (fb < slice_len(g_infer_on) and g_infer_on[fb] == 1) { return ti_mk("Unknown"); }
    g_rec_depth = g_rec_depth + 1;
    if (g_rec_depth == 50000 or g_rec_depth == 100000 or g_rec_depth == 150000
        or g_rec_depth == 200000 or g_rec_depth == 250000) {
        var kd: string = "?";
        if (fb >= 0 and fb < base.node_count()) { kd = base.node_kind((fb as u64)); }
        eprint("REC@ie_infer depth=" + base.i2s(g_rec_depth) + " fb=" + base.i2s(fb) + " kind=" + kd);
    }
    var r2: i64 = infer_expr(fb);
    g_rec_depth = g_rec_depth - 1;
    return r2;
}

pub fn ie_sub(ei: i64, k: i64, fb: i64) i64 {
    if (fb < 0) { return ti_mk("Unknown"); }
    if (ei < 0) { g_hir_edge_noinst = g_hir_edge_noinst + 1; }
    else {
        if (hir.hir_inst_node(hir.hir_arg(ei, k)) == fb) {
            g_hir_edge_hir = g_hir_edge_hir + 1;
            return ie_infer(fb);
        }
        ie_mis(ei, fb);
    }
    g_hir_edge_cst = g_hir_edge_cst + 1;
    return ie_infer(fb);
}

pub fn ie_sub_v(ei: i64, k: i64, fb: i64) void {
    if (fb < 0) { return; }
    if (ei < 0) { g_hir_edge_noinst = g_hir_edge_noinst + 1; }
    else {
        if (hir.hir_inst_node(hir.hir_arg(ei, k)) == fb) {
            g_hir_edge_hir = g_hir_edge_hir + 1;
            ie_infer(fb);
            return;
        }
        ie_mis(ei, fb);
    }
    g_hir_edge_cst = g_hir_edge_cst + 1;
    ie_infer(fb);
}

pub fn ie_sub_in(ei: i64, fb: i64) i64 {
    if (fb < 0) { return ti_mk("Unknown"); }
    if (ei < 0) { g_hir_edge_noinst = g_hir_edge_noinst + 1; }
    else {
        var i2: i64 = 0;
        var na2: i64 = hir.hir_arg_count(ei);
        while (i2 < na2) {
            if (hir.hir_inst_node(hir.hir_arg(ei, i2)) == fb) {
                g_hir_edge_hir = g_hir_edge_hir + 1;
                return ie_infer(fb);
            }
            i2 = i2 + 1;
        }
        ie_mis(ei, fb);
    }
    g_hir_edge_cst = g_hir_edge_cst + 1;
    return ie_infer(fb);
}

pub fn ie_sub_in_v(ei: i64, fb: i64) void {
    if (fb < 0) { return; }
    if (ei < 0) { g_hir_edge_noinst = g_hir_edge_noinst + 1; }
    else {
        var i3: i64 = 0;
        var na3: i64 = hir.hir_arg_count(ei);
        while (i3 < na3) {
            if (hir.hir_inst_node(hir.hir_arg(ei, i3)) == fb) {
                g_hir_edge_hir = g_hir_edge_hir + 1;
                ie_infer(fb);
                return;
            }
            i3 = i3 + 1;
        }
        ie_mis(ei, fb);
    }
    g_hir_edge_cst = g_hir_edge_cst + 1;
    ie_infer(fb);
}

// P1 Stage 1b（everything-is-value）：**多语句值块** `{ s1; ...; sn; e; }` 的类型
// = 尾随表达式 `e` 的类型。
// 块内语句在**新作用域**检查（与语句块 cs_block_node 同构），故块内 var 不外泄到外层。
// 取值由后端发射：tir 取尾随表达式的槽；codegen_c 走 GNU 语句表达式 `({ ...; e; })`。
pub fn infer_block_expr(e: i64) i64 {
    var prev: i64 = cur_scope;
    cur_scope = scope_new_at(prev, e);
    var c: i64 = base.node_la((e as u64));
    var last: i64 = -1;
    var mq_ks5543: []i64 = base.kids_chain_idx(base.node_la((e as u64)));
    var mq_ki5543: i64 = 0;
    while (mq_ki5543 < slice_len(mq_ks5543) as i64) {
        c = mq_ks5543[mq_ki5543];
        var k: Child = base.kids[c];
        last = k.val;
        check_stmt(k.val);
        mq_ki5543 = mq_ki5543 + 1;
        c = -1;
    }
    var t: i64 = -1;
    if (last >= 0 and base.node_kind((last as u64)) == "expr") {
        t = infer_expr(base.node_na((last as u64)));
    }
    cur_scope = prev;
    if (t < 0) {
        // P4：末条语句为终止性语句（return / break / continue / @panic）⇒ 块类型为 Never。
        // 这让 `var r = if (c) { @panic("x"); } else { 2; }` 之外、裸块版本的推断同样正确
        // （块永不「正常落到末尾」，类型即 Never，与 widen_only_lub 的单位元语义一致）。
        if (last >= 0 and stmt_terminates(last)) {
            return ti_mk("Never");
        }
        return ti_mk("Unknown");
    }
    return t;
}

// P4 辅助：末条语句是否为「终止性」——执行到它函数/循环/程序即不可正常落到块末尾。
fn stmt_terminates(s: i64) bool {
    if (s < 0) { return false; }
    var k: string = base.node_kind((s as u64));
    if (k == "return" or k == "break" or k == "continue") { return true; }
    if (k == "expr") {
        var inner: i64 = base.node_na((s as u64));
        if (inner >= 0 and base.node_kind((inner as u64)) == "call" and base.node_sa((inner as u64)) == "panic") {
            return true;
        }
    }
    return false;
}

// ── P3（循环 else / 值循环）：sema 层脱糖 ──
// 把「带 else 子句或含 `break v` 的循环」原地改写成多语句值块 block_expr：
//   { var __loop_delivered: bool = false; var __loop_r: T; <循环(去 else)>; if (!__loop_delivered) { __loop_r = <else值>; }; __loop_r }
// `break v` 脱糖为 { __loop_r = v; __loop_delivered = true; break; }。
// 完全复用既有节点（block_expr/var_decl/assign/if/while/for/break），双后端零改动；
// 与 Stage 1b 一致，改写后调 hir_invalidate 走 block_expr 不透明容器路径。
var g_vl_breaks: []i64 = [];
var g_vl_break_vals: []i64 = [];
// 脱糖产物标记：desugar_value_loop 把值循环改写后的「原样循环体」用 fresh 的
// while/for/for_each 节点重新挂回 block_expr；infer_block_expr 会对这些节点再次
// check_stmt → 把体再走一遍，而嵌套值循环体引用的外层循环变量此时已不在重走作用域链里
// （重走作用域是 desugar 入口作用域的兄弟，而非原循环体作用域），导致「未定义标识符」。
// 故脱糖产出的 fresh 循环节点在此登记，check_stmt 的循环分支见此标记直接跳过体再检查
// （体已在脱糖期原作用域内全量检查过；发射是 codegen 独立遍历，不依赖 sema 重走）。
var g_vl_checked: []i64 = [];
fn vl_is_checked(id: i64) bool {
    var i: i64 = 0;
    while (i < slice_len(g_vl_checked)) {
        if (g_vl_checked[i] == id) { return true; }
        i = i + 1;
    }
    return false;
}

// 取 block_expr 的尾随表达式节点（与 parse.block_trailing_expr 同义）
fn vl_trailing_expr(blk: i64) i64 {
    var c: i64 = base.node_la((blk as u64));
    var last: i64 = -1;
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环
    var ks5541: []i64 = base.kids_chain(c);
    var ki5541: i64 = 0;
    while (ki5541 < slice_len(ks5541) as i64) {
        var kv5541: i64 = ks5541[ki5541];
        last = kv5541;
        ki5541 = ki5541 + 1;
    }
    if (last >= 0 and base.node_kind((last as u64)) == "expr") {
        return base.node_na((last as u64));
    }
    return -1;
}

// 取 else 子句的值表达式节点。P3 改为：while 的 else 存为**语句链表头**（与 if 同构，
// 由 parse_while_stmt 的 parse_block 产出），故此处遍历链表取末条 `expr` 语句的内部
// 表达式节点（block_trailing_expr 返回的是 `expr` 语句节点，.na 才是真正的值）。
fn vl_else_value(lb: i64) i64 {
    if (lb < 0) { return -1; }
    var last: i64 = -1;
    var c: i64 = lb;
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环
    var ks5558: []i64 = base.kids_chain(c);
    var ki5558: i64 = 0;
    while (ki5558 < slice_len(ks5558) as i64) {
        var kv5558: i64 = ks5558[ki5558];
        last = kv5558;
        ki5558 = ki5558 + 1;
    }
    if (last < 0) { return -1; }
    if (base.node_kind((last as u64)) != "expr") { return -1; }
    return base.node_na((last as u64));
}

// 收集本循环体内、且属于本循环的 break 节点（跳过嵌套循环的体）。
fn vl_collect_breaks(la: i64) void {
    var c: i64 = la;
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环
    var ks5570: []i64 = base.kids_chain(c);
    var ki5570: i64 = 0;
    while (ki5570 < slice_len(ks5570) as i64) {
        var kv5570: i64 = ks5570[ki5570];
        if (base.node_kind((kv5570 as u64)) == "break") {
            append(g_vl_breaks, kv5570);
            append(g_vl_break_vals, base.node_na((kv5570 as u64)));
        } else if (base.node_kind((kv5570 as u64)) == "if") {
            vl_collect_breaks(base.node_la((kv5570 as u64)));
            if (base.node_lb((kv5570 as u64)) > -2) { vl_collect_breaks(base.node_lb((kv5570 as u64))); }
        } else if (base.node_kind((kv5570 as u64)) == "block" or base.node_kind((kv5570 as u64)) == "block_expr") {
            vl_collect_breaks(base.node_la((kv5570 as u64)));
        } else if (base.node_kind((kv5570 as u64)) == "match") {
            var ac: i64 = base.node_la((kv5570 as u64));
            // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环
            var ks5581: []i64 = base.kids_chain(ac);
            var ki5581: i64 = 0;
            while (ki5581 < slice_len(ks5581) as i64) {
                var kv5581: i64 = ks5581[ki5581];
                if (base.node_nc((kv5581 as u64)) >= 0) {
                    if (base.node_kind((base.node_nc((kv5581 as u64)) as u64)) == "block_expr") { vl_collect_breaks(base.node_la((base.node_nc((kv5581 as u64)) as u64))); }
                }
                ki5581 = ki5581 + 1;
            }
        }
        // while/for/for_each：嵌套循环，其 break 不属于本循环，不递归
        ki5570 = ki5570 + 1;
    }
}

// 把收集到的 break 节点就地改写为 { __loop_r = v; __loop_delivered = true; break; }
// rname/dname 为本循环脱糖产出的**唯一**变量名（按循环节点 id 生成，绝不重名），
// 否则嵌套值循环里外层 break 会被 LLVM 扁平名表误解析成内层 __loop_r（见 P3 嵌套坑）。
fn vl_rewrite_breaks(la: i64, rname: string, dname: string) void {
    var c: i64 = la;
    while (c >= 0) {
        if (base.node_kind((base.kids[c].val as u64)) == "break") {
            var bval: i64 = base.node_na((base.kids[c].val as u64));
            var h: i64 = -1; var t: i64 = -1;
            if (bval >= 0) {
                var asg: i64 = base.mk_assign("=", base.mk_ident(rname, -1), bval, -1);
                t = base.list_push(h, t, base.mk_expr(asg, -1)); if (h < 0) { h = t; }
            }
            var setd: i64 = base.mk_assign("=", base.mk_ident(dname, -1), base.mk_bool(true, -1), -1);
            t = base.list_push(h, t, base.mk_expr(setd, -1)); if (h < 0) { h = t; }
            t = base.list_push(h, t, base.mk_break(-1, -1)); if (h < 0) { h = t; }
            var blk: i64 = base.mk_block(h, -1);
            var ch: Child = base.kids[c];
            ch.val = blk;
            slice_set(base.kids, c, ch);
        } else if (base.node_kind((base.kids[c].val as u64)) == "if") {
            vl_rewrite_breaks(base.node_la((base.kids[c].val as u64)), rname, dname);
            if (base.node_lb((base.kids[c].val as u64)) > -2) { vl_rewrite_breaks(base.node_lb((base.kids[c].val as u64)), rname, dname); }
        } else if (base.node_kind((base.kids[c].val as u64)) == "block" or base.node_kind((base.kids[c].val as u64)) == "block_expr") {
            vl_rewrite_breaks(base.node_la((base.kids[c].val as u64)), rname, dname);
        } else if (base.node_kind((base.kids[c].val as u64)) == "match") {
            var ac: i64 = base.node_la((base.kids[c].val as u64));
            while (ac >= 0) {
                if (base.node_nc((base.kids[ac].val as u64)) >= 0) {
                    if (base.node_kind((base.node_nc((base.kids[ac].val as u64)) as u64)) == "block_expr") { vl_rewrite_breaks(base.node_la((base.node_nc((base.kids[ac].val as u64)) as u64)), rname, dname); }
                }
                ac = base.kids[ac].next;
            }
        }
        c = base.kids[c].next;
    }
}

// 本循环体是否含 `break v`（用于决定是否需要脱糖为值循环）
fn vl_body_has_break_v(la: i64) bool {
    var c: i64 = la;
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环
    var ks5634: []i64 = base.kids_chain(c);
    var ki5634: i64 = 0;
    while (ki5634 < slice_len(ks5634) as i64) {
        var kv5634: i64 = ks5634[ki5634];
        if (base.node_kind((kv5634 as u64)) == "break") {
            if (base.node_na((kv5634 as u64)) >= 0) { return true; }
        } else if (base.node_kind((kv5634 as u64)) == "if") {
            if (vl_body_has_break_v(base.node_la((kv5634 as u64)))) { return true; }
            if (base.node_lb((kv5634 as u64)) > -2 and vl_body_has_break_v(base.node_lb((kv5634 as u64)))) { return true; }
        } else if (base.node_kind((kv5634 as u64)) == "block" or base.node_kind((kv5634 as u64)) == "block_expr") {
            if (vl_body_has_break_v(base.node_la((kv5634 as u64)))) { return true; }
        } else if (base.node_kind((kv5634 as u64)) == "match") {
            var ac: i64 = base.node_la((kv5634 as u64));
            // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环
            var ks5644: []i64 = base.kids_chain(ac);
            var ki5644: i64 = 0;
            while (ki5644 < slice_len(ks5644) as i64) {
                var kv5644: i64 = ks5644[ki5644];
                if (base.node_nc((kv5644 as u64)) >= 0) {
                    if (base.node_kind((base.node_nc((kv5644 as u64)) as u64)) == "block_expr" and vl_body_has_break_v(base.node_la((base.node_nc((kv5644 as u64)) as u64)))) { return true; }
                }
                ki5644 = ki5644 + 1;
            }
        }
        ki5634 = ki5634 + 1;
    }
    return false;
}

// 把值循环 L 原地脱糖为 block_expr，返回循环值类型 ti。
pub fn desugar_value_loop(L: i64) i64 {
    var kind: string = base.node_kind((L as u64));
    // 本循环脱糖产物的唯一变量名：按循环节点 id 生成，嵌套值循环之间绝不重名，
    // 从根本上避开 LLVM 扁平名表的重名误解析（C 后端靠词法块作用域天然隔离，LLVM 不隔离）。
    var rname: string = "__loop_r_" + base.i2s(L);
    var dname: string = "__loop_delivered_" + base.i2s(L);
    g_vl_breaks = [];
    g_vl_break_vals = [];
    vl_collect_breaks(base.node_la((L as u64)));
    // 递归脱糖会重入本函数并重置 g_vl_breaks/g_vl_break_vals（全局），故先把本层收集到的
    // break 值快照存下，待体检查（期间会触发内层值循环脱糖并覆盖全局）结束后还原，
    // 否则外层会误用内层的 break 值去算自己的循环值类型（并以外层作用域解析 → 未定义标识符）。
    var saved_vl_breaks: []i64 = g_vl_breaks;
    var saved_vl_bvals: []i64 = g_vl_break_vals;
    var has_else: bool = (base.node_lb((L as u64)) >= 0);
    var has_break_v: bool = false;
    var i: i64 = 0;
    while (i < slice_len(g_vl_break_vals)) {
        if (g_vl_break_vals[i] >= 0) { has_break_v = true; }
        i = i + 1;
    }
    if (has_break_v and !has_else and !vl_body_always_delivers(L)) {
        parse.fc_err("T-SEM-E280", "带值 break 必须配合循环 `else` 子句提供「无中断路径」的值（否则无中断时循环无值可产）", L);
    }
    // 值循环里普通 break（无值）无意义：无中断路径下 __loop_r 未赋值
    i = 0;
    while (i < slice_len(g_vl_break_vals)) {
        if (g_vl_break_vals[i] < 0) {
            parse.fc_err("T-SEM-E281", "值循环中的 break 必须带值（break <expr>）；普通 break 仅用于非值循环", L);
        }
        i = i + 1;
    }
    var prev: i64 = cur_scope;
    // else 在外层作用域求值（循环体变量已不可见）
    var T_else: i64 = -1;
    if (has_else) {
        T_else = infer_expr(vl_else_value(base.node_lb((L as u64))));
    }
    // 搭建循环体作用域，预检查体以登记变量并推断 break v 类型
    cur_scope = scope_new_at(prev, L);
    if (kind == "for" and base.node_na((L as u64)) >= 0) { check_stmt(base.node_na((L as u64))); }
    if (kind == "for_each") {
        var itt: i64 = infer_expr(base.node_na((L as u64)));
        var itk: string = tip_kind(itt);
        var et: i64 = -1;
        if (itk == "Slice" or itk == "Array") { et = tis[itt].elem; }
        else if (itk == "BitStr") { et = ti_scalar("u8"); }
        else if (itk == "Map") { et = tis[itt].key; }
        else { et = ti_mk("Unknown"); }
        sym_define(cur_scope, base.node_sa((L as u64)), "var", et, -1);
        if (str_len(base.node_sb((L as u64))) > 0) {
            var vte: i64 = ti_mk("Unknown");
            if (itk == "Map") { vte = tis[itt].val; }
            sym_define(cur_scope, base.node_sb((L as u64)), "var", vte, -1);
        }
    }
    var lvn: string = "";
    if (kind == "for" and base.node_na((L as u64)) >= 0) { lvn = base.node_sa((base.node_na((L as u64)) as u64)); }
    else if (kind == "for_each") { lvn = base.node_sa((L as u64)); }
    var bc: i64 = base.node_la((L as u64));
    var mq_ks5808: []i64 = base.kids_chain_idx(base.node_la((L as u64)));
    var mq_ki5808: i64 = 0;
    while (mq_ki5808 < slice_len(mq_ks5808) as i64) {
        bc = mq_ks5808[mq_ki5808];
        check_stmt(base.kids[bc].val);
        mq_ki5808 = mq_ki5808 + 1;
        bc = -1;
    }
    if (kind == "for" and base.node_nc((L as u64)) >= 0) { check_stmt(base.node_nc((L as u64))); }
    // 还原本层收集到的 break 值（内层脱糖已用全局存了自己的，须还原外层自己的）
    g_vl_breaks = saved_vl_breaks;
    g_vl_break_vals = saved_vl_bvals;
    // 循环值类型 = lub(break v 类型, else 类型)
    var tis_arr: []i64 = [];
    i = 0;
    while (i < slice_len(g_vl_break_vals)) {
        if (g_vl_break_vals[i] >= 0) {
            var bt: i64 = infer_expr(g_vl_break_vals[i]);
            append(tis_arr, bt);
        }
        i = i + 1;
    }
    var T: i64 = -1;
    if (T_else >= 0) { append(tis_arr, T_else); }
    if (slice_len(tis_arr) == 0) { T = ti_mk("Void"); }
    else { T = widen_only_lub(tis_arr); }
    if (T < 0) { T = ti_mk("Void"); }
    // 改写 break
    vl_rewrite_breaks(base.node_la((L as u64)), rname, dname);

    // 构造 block_expr 体
    var h: i64 = -1; var t: i64 = -1;
    var vd: i64 = base.mk_var_decl(dname, false, mk_type_node_from_ti(ti_scalar("bool")), base.mk_bool(false, -1), -1);
    t = base.list_push(h, t, vd); if (h < 0) { h = t; }
    var vr: i64 = base.mk_var_decl(rname, false, mk_type_node_from_ti(T), -1, -1);
    t = base.list_push(h, t, vr); if (h < 0) { h = t; }
    var inner: i64 = -1;
    if (kind == "while") { inner = base.mk_while(base.node_na((L as u64)), base.node_la((L as u64)), -1, -1); }
    else if (kind == "for") { inner = base.mk_for(base.node_na((L as u64)), base.node_nb((L as u64)), base.node_nc((L as u64)), base.node_la((L as u64)), -1, -1); }
    else if (kind == "for_each") { inner = base.mk_for_each(base.node_sa((L as u64)), base.node_sb((L as u64)), base.node_na((L as u64)), base.node_la((L as u64)), -1, -1); }
    append(g_vl_checked, inner);
    t = base.list_push(h, t, inner); if (h < 0) { h = t; }
    if (has_else) {
        var ev: i64 = vl_else_value(base.node_lb((L as u64)));
        var asg2: i64 = base.mk_assign("=", base.mk_ident(rname, -1), ev, -1);
        var th: i64 = -1; var tt: i64 = -1;
        tt = base.list_push(th, tt, base.mk_expr(asg2, -1)); if (th < 0) { th = tt; }
        var cond: i64 = base.mk_unary("!", base.mk_ident(dname, -1), -1);
        var ifn: i64 = base.mk_if(cond, th, -1, -1);
        t = base.list_push(h, t, ifn); if (h < 0) { h = t; }
    }
    t = base.list_push(h, t, base.mk_expr(base.mk_ident(rname, -1), -1)); if (h < 0) { h = t; }
    // 原地改写为 block_expr
    base.node_set_kind((L as u64), "block_expr");
    base.node_set_na((L as u64), -1);   // S4 §0.14.7 SoA：侧表写（原 `n.na = -1`；第十七批）
    base.node_set_nb((L as u64), -1); base.node_set_lb((L as u64), -1); base.node_set_sa((L as u64), ""); base.node_set_sb((L as u64), "");
    base.node_set_nc((L as u64), -1);   // S4 §0.14.7 SoA：侧表写（原 n.nc = -1；第九批）
    base.node_set_la((L as u64), h);
    cur_scope = prev;
    hir.hir_invalidate((L as u64));
    return T;
}

// P4：值循环体是否「恒交付」—— 循环不可能「无中断完成」（即不靠 break 也能走到循环尾 /
// 条件变 false 退出），故省略 else 时循环值仍有确定来源。
// 判定（保守、可证明安全）：
//   - for / for_each：容器可能为空 ⇒ 体一次都不执行 ⇒ 循环可无中断完成 ⇒ 必须 else。
//   - while：仅当条件静态恒为 true（字面 `true`）且体不落到末尾（末条为 break/return/@panic）
//     时，循环不可能「条件为假」退出 ⇒ 恒交付、可省 else；否则（条件可能变 false）存在无中断
//     完成路径 ⇒ 必须 else。
// 注：空容器导致体一次都不执行 ⇒ 循环仍可无中断完成，此时省略 else 属程序员不变量
// （与 Zig 式 for/else 同语义）；门禁用例一律用非空容器保证运行期安全。
fn vl_body_always_delivers(L: i64) bool {
    var kind: string = base.node_kind((L as u64));
    if (kind == "for" or kind == "for_each") { return false; }
    if (kind == "while") {
        var cond: i64 = base.node_na((L as u64));
        if (cond >= 0 and base.node_kind((cond as u64)) == "bool" and base.node_ba((cond as u64))) {
            return !block_list_can_fall_through(base.node_la((L as u64)));
        }
        return false;
    }
    return false;
}

// 语句链表（块体 / if 分支体）是否可能「正常落到末尾」（不被 return/break/@panic 截断）。
fn block_list_can_fall_through(head: i64) bool {
    if (head < 0) { return true; }
    var c: i64 = head;
    var last_s: i64 = -1;
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环
    var ks5803: []i64 = base.kids_chain(c);
    var ki5803: i64 = 0;
    while (ki5803 < slice_len(ks5803) as i64) {
        var kv5803: i64 = ks5803[ki5803];
        last_s = kv5803;
        ki5803 = ki5803 + 1;
    }
    if (last_s < 0) { return true; }
    return stmt_can_fall_through(last_s);
}

// 单条语句是否可能正常落到其后的位置。
fn stmt_can_fall_through(s: i64) bool {
    if (s < 0) { return true; }
    var k: string = base.node_kind((s as u64));
    if (k == "return" or k == "break") { return false; }       // 退出函数 / 带值退出循环（不落到末尾）
    if (k == "continue") { return true; }                       // 重启发迭代，循环仍可能正常结束（非恒交付）
    if (k == "expr") {
        var inner: i64 = base.node_na((s as u64));
        if (inner >= 0 and base.node_kind((inner as u64)) == "call" and base.node_sa((inner as u64)) == "panic") {
            return false;                                       // @panic 终止程序
        }
        return true;
    }
    if (k == "var_decl" or k == "assign") { return true; }
    if (k == "block") { return block_list_can_fall_through(base.node_la((s as u64))); }
    if (k == "if") {
        var then_f: bool = block_list_can_fall_through(base.node_la((s as u64)));
        var else_f: bool = true;
        if (base.node_lb((s as u64)) >= 0) { else_f = block_list_can_fall_through(base.node_lb((s as u64))); }
        // lb == -2 表示无 else 分支 ⇒ 缺失分支必然落到末尾
        return then_f or else_f;
    }
    // while/for/for_each：保守判定可落到末尾（不要求体恒终止）
    if (k == "while" or k == "for" or k == "for_each") { return true; }
    return true;
}

// 模块值别名表：const X = @import("M") 登记 X → 模块 key（last_segment(M)），
// 供成员访问 X.foo 解析成 <key>__<foo>。仅记录名字，不引入「模块类型」。
pub var g_modval_names: []string;
pub var g_modval_keys: []string;
pub fn g_modval_set(name: string, key: string) void {
    append(g_modval_names, name);
    append(g_modval_keys, key);
}
pub fn g_modval_get(name: string) string {
    var i: i64 = 0;
    var n: i64 = slice_len(g_modval_names) as i64;
    while (i < n) {
        if (g_modval_names[i] == name) { return g_modval_keys[i]; }
        i = i + 1;
    }
    return "";
}

// 模块类型名注册表：const X = @import("M") 把 X 与模块 key 都登记为「模块类型名」，
// 供双后端 type_info 合成（c_ti_arm / ll_ti_arm）据类型名识别 Module arm。comptime 路径
// 走 sym 表的 Module ti 判定，不依赖此表；此表仅服务「类型名 → Module」的运行时发射分流。
pub var g_module_type_names: []string;
pub fn is_module_type_name(tn: string) bool {
    var i: i64 = 0;
    var n: i64 = slice_len(g_module_type_names) as i64;
    while (i < n) {
        if (g_module_type_names[i] == tn) { return true; }
        i = i + 1;
    }
    return false;
}
pub fn reg_module_type_name(tn: string) void {
    if (is_module_type_name(tn) == false) { append(g_module_type_names, tn); }
}


// ── match 值匹配优化（审查结论落地：P0/P2/P3 子集）─────────────────────────────
// 仅值类型（整数/浮点/字符串/atom/bool/char/enum 判别子）下常量集闭合、穷尽性可判定，
// 才启用「常量臂全局唯一、重复即硬错」与不可达臂升级 error。
pub fn m_scr_is_value(ti: i64) bool {
    var k: string = tip_kind(ti);
    if (k == "Enum") { return true; }
    if (k == "Scalar") {
        var n: string = tip_name(ti);
        if (n == "bool" or n == "string" or n == "atom" or n == "char"
            or n == "f32" or n == "f64" or n == "isize" or n == "usize") { return true; }
        // 有界整数族 i8..i64 / u8..u64
        if (str_len(n) >= 1) {
            if (starts_with(n, "i") or starts_with(n, "u")) { return true; }
        }
    }
    return false;
}

// 把值匹配臂的模式节点降解为「常量键」；非可判定常量返回 ""。
// int 取数值（不同字面量写法归一到同一键）；bool/str/atom/float 取文本；enum 单元 case 取 case 名。
pub fn m_arm_const_key(pn: i64, scr: i64) string {
    if (pn < 0) { return ""; }
    var kd: string = base.node_kind((pn as u64));
    if (kd == "paren") { return m_arm_const_key(base.node_na((pn as u64)), scr); }
    if (kd == "int") {
        var v: i64 = js_parse_int(base.node_sa((pn as u64)), base.node_ia((pn as u64)));
        return base.sb_cat2("i:", base.i2s(v));
    }
    if (kd == "bool") {
        if (base.node_ba((pn as u64))) { return "b:1"; }
        return "b:0";
    }
    if (kd == "str") { return base.sb_cat2("s:", base.node_sa((pn as u64))); }
    if (kd == "atom") { return base.sb_cat2("a:", base.node_sa((pn as u64))); }
    if (kd == "float") { return base.sb_cat2("f:", base.node_sa((pn as u64))); }
    // enum 单元 case：member(Enum.Case) 或 unit conpat(.Case)
    if (tip_kind(scr) == "Enum") {
        if (kd == "member") { return base.sb_cat2("m:", base.node_sa((pn as u64))); }
        if (kd == "conpat" and base.node_na((pn as u64)) < 0) { return base.sb_cat2("c:", base.node_sa((pn as u64))); }
    }
    return "";
}

pub fn infer_expr(e: i64) i64 {
    // S2b 循环断路器（LLVM 后端安全版，关键修复见 g_infer_on 声明处注释）。
    // 包装层：进入置位标记、调用 body、返回前显式清零。**严禁使用 defer**——
    // t 的 LLVM 后端对递归函数内的 defer 发射错误（清理被提前执行），会导致标记在子递归前
    // 被清零、真环检测失效、self-host 时无限递归栈溢出（exit 127 / 0xC00000FD）。
    if (e < 0) { return ti_mk("Unknown"); }
    // 首入（g_infer_on 尚空）时一次性预扩标记切片（节点池长度 `base.node_count()` + 8M 余量覆盖脱糖新增
    // 节点），之后不再 append/realloc，避免切片底层数据指针重分配造成已置位标记丢失。
    // 注意：用 `== 0` 门控而非每入重查节点池长度——节点池在推理中会随脱糖增长，
    // 若每入重查会触发递归中 realloc，丢失已置位标记。
    if (slice_len(g_infer_on) == 0) {
        var cap: i64 = base.node_count() + 8000000;
        while (slice_len(g_infer_on) < cap) { append(g_infer_on, 0); }
    }
    if (e >= slice_len(g_infer_on)) {
        // 越界（脱糖新增节点超出预扩余量，极罕见）：跳过标记，放弃该点环检测。
        return infer_expr_body(e);
    }
    // 循环断路器（LLVM 后端安全版，关键修复见 g_infer_on 声明处注释）。
    // 清零策略：仅当本调用「首次置位」该节点标记时才负责清零（锁所有权语义），与正确实现的
    // `defer` 等价；但 t 的 LLVM 后端对递归函数内 `defer` 发射错误（清理被提前执行），故用
    // 显式「所有权」模拟。关键不变量：脱糖自重入 `return infer_expr(e)` 复用同一 e（标记已由
    // 外层置位），内层 owned==0 不得清零——否则会抹掉仍在推理中的祖先链标记，使经 `ie_infer`
    // 回指祖先的环检测失效 → 无限递归栈溢出（exit 127 / 0xC00000FD）。
    var owned: i64 = 0;
    if (g_infer_on[e] == 0) {
        g_infer_on[e] = 1;
        owned = 1;
    }
    g_rec_depth = g_rec_depth + 1;
    if (g_rec_depth == 50000 or g_rec_depth == 100000 or g_rec_depth == 150000
        or g_rec_depth == 200000 or g_rec_depth == 250000) {
        var kd: string = "?";
        if (e >= 0 and e < base.node_count()) { kd = base.node_kind((e as u64)); }
        eprint("REC@infer_expr depth=" + base.i2s(g_rec_depth) + " e=" + base.i2s(e) + " kind=" + kd);
    }
    var r: i64 = infer_expr_body(e);
    g_rec_depth = g_rec_depth - 1;
    if (owned == 1) { g_infer_on[e] = 0; }
    return r;
}

pub fn infer_expr_body(e: i64) i64 {
    // ── 一等子句 `@clause(...)`（设计 docs/compiler/first-class-clause.md §4 / §5.1）──
    // 编译期一等值。其 pattern / guard / body 子树**一概不求值**（它们是 AST 位置，不是值
    // 位置）：body 可以引用 pattern 绑定出来的名字，构造时尚无绑定 —— 一旦在此递归进入子树，
    // 那些名字就会被误报「未定义标识符」。求值恒等由 meta_eval_rec 的同名分支保证。
    if (base.node_kind((e as u64)) == "clause") {
        ensure_clause_builtins();
        return g_ti_clause;
    }
    // ── 模块值 / 变体字面量 脱糖（在 hir_tag 派发前，避免新节点 kind 落入默认分支）──
    if (base.node_kind((e as u64)) == "variant_lit") {
        // M5 / P1 补丁：变体字面量构造 `V { .Case }` / `V { .Case(args) }` 的 case 名必须真实存在。
        // 此前 variant_lit 直接脱糖成 `<V>_from_<Case>` 调用而从不校验 Case 是否存在，
        // `Shape { .NotExist(1.0) }` 静默落 Unknown（与 P1 的 `Shape.NotExist(1.0)` 同性质静默错编）。
        // 命中不存在的 case 报 T-SEM-E216（沿用 P1 诊断码，保持对称）。
        if (member_exists_in_type(ti_named("Struct", base.node_sa((e as u64))), base.node_sb((e as u64))) == false) {
            parse.fc_err("T-SEM-E216",
                base.sb_cat4("变体 `", base.node_sa((e as u64)), "` 没有 case `",
                    base.sb_cat2(base.node_sb((e as u64)), "`：请检查拼写")), e);
        }
        // `V { .Case }` / `V { .Case(args) }` → 改写为 `<V>_from_<Case>(args)` 调用，
        // 复用既有变体构造器发射路径（双后端零改动）。幂等：改写后 callee 为 <V>_from_<C>。
        var ctor_name: string = base.sb_cat3(base.node_sa((e as u64)), "_from_", base.node_sb((e as u64)));
        var callee: i64 = base.mk_ident(ctor_name, -1);
        base.node_set_span_id(callee, base.node_span_id(e)); base.node_set_span_id(callee, base.node_span_id(e)); base.node_set_span_id(callee, base.node_span_id(e));
        var call_id: i64 = base.mk_call(callee, base.node_na((e as u64)), -1);
        base.node_set_span_id(call_id, base.node_span_id(e)); base.node_set_span_id(call_id, base.node_span_id(e)); base.node_set_span_id(call_id, base.node_span_id(e));
        // S4 批次 20-B（§0.14.7 收口）：**删除** `base.nodes[e] = cn;`。
        //   Node 的载荷字段已全部外置为侧表 ⇒ 该整体赋值现在**只搬 `id` 一个字段**，
        //   而且是把源节点 call_id 写进 e 槽 ⇒ **破坏 `nodes[i].id == i` 不变量**
        //   （下游 `n.id` 反查会读到错节点）。真正的语义（把 e 改写成 call）
        //   已由下方 `node_set_kind/na/la/sa` 显式同步承载 ⇒ 删除后 id 语义自洽。
        base.node_set_kind((e as u64), base.node_kind((call_id as u64)));
        base.node_set_na((e as u64), base.node_na((call_id as u64)));
        base.node_set_la((e as u64), base.node_la((call_id as u64)));
        base.node_set_sa((e as u64), base.node_sa((call_id as u64)));
        // ⚠ S4 §0.14.7 SoA：**整体 Node 结构体赋值不再搬运已外置字段**。
        //   `nodes[e] = cn` 只搬 Node 里剩下的结构体字段，侧表字段必须显式同步。
        //   · kind（第十八批）：⚠⚠ **本批最关键的一处** —— cn 的 kind 是 `"call"`，而 e 原本
        //     是 variant_lit。漏同步 ⇒ 下面 `return infer_expr(e)` 二次进入仍按 **variant_lit**
        //     分派 ⇒ 再次脱糖 ⇒ **无限递归**（不是丢实参那种局部错误）。
        //   · la（第十六批）：`mk_call(na, la, ti)` 把实参 kids 链放进 call_id 的 la 槽，
        //     漏同步 ⇒ 本节点脱糖出的 call 丢实参（`V { .Case(args) }` → `V_from_C()`）。
        //   · na（第十七批）：`mk_call` 把 **callee** 放进 call_id 的 na 槽；而 e 原本是
        //     variant_lit，其 na 存的是**实参链**（正是上面传给 mk_call 的第二实参）。
        //     漏同步 ⇒ e 变成 call 后 `infer_expr` 把实参链当 callee 解析，ctor 调用错编。
        //   · sa（第十九批）：Node 里**最后一个真实载荷字段**。`mk_call` 不经 sa 形参，
        //     故 cn.sa 恒为 node_new 的默认 **""**；严格等价要求把它同步到 e（与被 statically
        //     analyzed 的 la/na/kind 同处理），否则 sa 外置前后行为差一条。
        return infer_expr(e);
    }
    // 模块值成员访问：`base.foo` / `@import("M").foo` → 改写为 ident(<key>__<foo>)。
    // 仅当接收者为 import_expr 或绑定到 @import 的 const 时触发；否则回落常规字段访问。
    if (base.node_kind((e as u64)) == "member" and base.node_na((e as u64)) >= 0) {
        var mkey: string = "";
        if (base.node_kind((base.node_na((e as u64)) as u64)) == "import_expr") {
            // M2：import_expr.sa 存完整路径（"src.base"），直接作为 mkey（不再取末段）。
            mkey = base.node_sa((base.node_na((e as u64)) as u64));
        } else if (base.node_kind((base.node_na((e as u64)) as u64)) == "ident" and str_len(g_modval_get(base.node_sa((base.node_na((e as u64)) as u64)))) as i64 > 0) {
            mkey = g_modval_get(base.node_sa((base.node_na((e as u64)) as u64)));
        }
        if (str_len(mkey) as i64 > 0) {
            var fname: string = base.node_sa((e as u64));
            var sym: string = mangled_name(mkey, fname);
            var si: i64 = sym_lookup(global_scope, sym);
            if (si < 0) { si = sym_lookup(global_scope, fname); }
            if (si < 0) {
                // 模块值别名（const X = @import("M") / @import("M").foo）的限定访问：与 `:: *`
                // 通配导入语义等价——符号经模块 def 表可达，按同一 export 可见性规则校验。
                // 注意：global_scope 只含入口模块符号与 `:: *` 导入的「裸名」，并不登记
                // `M__foo` 限定名；通配导入靠裸名解析，模块值别名须回查模块 def 表。
                var di: i64 = def_lookup(mkey, fname);
                if (di >= 0 and (lex__g_def_export[di] or mod_has_export(mkey) == false)) {
                    si = 0;
                }
            }
            if (si < 0) {
                parse.fc_err("T-MOD-E552",
                    base.sb_cat5("模块 `", mkey, "` 未导出符号 `", fname, "`"), e);
                return ti_mk("Unknown");
            }
            base.node_set_kind((e as u64), "ident");
            base.node_set_sa((e as u64), sym);
            base.node_set_na((e as u64), -1);
            base.node_set_lb((e as u64), 0);
            hir.hir_invalidate((e as u64));
            return infer_expr(e);
        }
    }
    // P4b：@field_parent_ptr(Parent, child_ptr, "field") —— 运行期 container_of。
    // 由成员指针反推容器指针（Zig 忠实语义 @fieldParentPtr）。脱糖成
    //   cast(*Parent, binary("-", cast(i64, child_ptr), int(@offset_of(Parent, field))))
    // 复用两后端既有 ptrtoint/inttoptr 发射（LLVM 自然发；C 后端 (T)(x) 同构）。
    // ⚠ 必须 hir_invalidate：本节点是源码里的 mbuiltin，建了 HIR 指令，否则重入
    //   hir_tag 仍按旧 mbuiltin 分派 → 命中 E607（与 member 脱糖同一陷阱）。
    if (base.node_kind((e as u64)) == "mbuiltin" and base.node_sa((e as u64)) == "field_parent_ptr") {
        var fpp_a0: i64 = mb_arg_at(e, 0);   // Parent 类型
        var fpp_a1: i64 = mb_arg_at(e, 1);   // child_ptr
        var fpp_a2: i64 = mb_arg_at(e, 2);   // 字段名
        if (fpp_a0 < 0 or fpp_a1 < 0 or fpp_a2 < 0) {
            parse.fc_err("T-SEM-E206", "`@field_parent_ptr` 需要 3 个实参（Parent 类型, 成员指针, 字段名）", e);
            return ti_mk("Unknown");
        }
        var fpp_ptn: i64 = mb_as_type_node(fpp_a0);
        if (fpp_ptn < 0) {
            parse.fc_err("T-MTA-E606", "`@field_parent_ptr` 的 Parent 类型实参不可解析", e);
            return ti_mk("Unknown");
        }
        var fpp_fname: string = mb_read_str_arg(fpp_a2);
        if (fpp_fname == "") {
            parse.fc_err("T-MTA-E606", "`@field_parent_ptr` 的字段名须是编译期字符串", e);
            return ti_mk("Unknown");
        }
        // 取结构体声明与字段偏移（仅支持命名结构体，与 @offset_of 同约束）
        var fpp_sd: i64 = mb_struct_decl_of(fpp_ptn);
        if (fpp_sd < 0) {
            parse.fc_err("T-MTA-E606", "`@field_parent_ptr` 的 Parent 必须是命名结构体", e);
            return ti_mk("Unknown");
        }
        var fpp_off: i64 = mb_struct_field_offset(fpp_sd, fpp_fname);
        if (fpp_off < 0) {
            parse.fc_err("T-SEM-E216",
                base.sb_cat4("`@field_parent_ptr`：结构体 `", base.node_sa((fpp_sd as u64)),
                    "` 没有字段 `", base.sb_cat2(fpp_fname, "`")), e);
            return ti_mk("Unknown");
        }
        // 构造脱糖树：cast(*Parent, (u8*)child_ptr - offset)
        //   —— 字节指针 GEP：provenance 安全，且二进制减法经后端 GEP 按字节缩放（元素 u8），
        //      与 C/LLVM 指针算术语义一致；不依赖 cast(ptr,i64)（那会破坏 slice/array 的指针字段布局）。
        var fpp_byteptr: i64 = base.mk_cast(fpp_a1, base.mk_pointer(base.mk_scalar("u8", -1), -1), -1);
        var fpp_intoff: i64 = base.mk_int(base.i2s(fpp_off), -1, -1);
        var fpp_sub: i64 = base.mk_binary("-", fpp_byteptr, fpp_intoff, -1);
        var fpp_pptr: i64 = base.mk_pointer(fpp_ptn, -1);
        var fpp_root: i64 = base.mk_cast(fpp_sub, fpp_pptr, -1);
        // 把 e 原地改写成 cast 节点（复用 variant_lit / member 脱糖模式）
        base.node_set_kind((e as u64), "cast");
        base.node_set_na((e as u64), base.node_na((fpp_root as u64)));
        base.node_set_nb((e as u64), base.node_nb((fpp_root as u64)));
        base.node_set_la((e as u64), base.node_la((fpp_root as u64)));
        base.node_set_sa((e as u64), base.node_sa((fpp_root as u64)));
        hir.hir_invalidate((e as u64));
        return infer_expr(e);
    }
    var k: string = hir_tag(e);
    var ei: i64 = ie_inst(e);
    // P1 Stage 1b：多语句值块在表达式位置出现（含值 if 的多语句分支、match 的多语句臂）。
    if (base.node_kind((e as u64)) == "block_expr") {
        return infer_block_expr(e);
    }
    // P5：`()` 是 unit 字面量，类型即 unit（void 别名）。
    if (base.node_kind((e as u64)) == "unit_lit") {
        return ti_mk("Void");
    }
    // P3：值循环（带 `else` 完成子句或含 `break v`）出现在表达式位置 → 脱糖为值块。
    // 脱糖恒定产出 block_expr（不透明容器），双后端零改动由构造保证一致；改写后
    // 的节点 kind 已非循环，故后续不会二次触发本钩子。
    if (base.node_kind((e as u64)) == "while" or base.node_kind((e as u64)) == "for" or base.node_kind((e as u64)) == "for_each") {
        if (base.node_lb((e as u64)) >= 0 or vl_body_has_break_v(base.node_la((e as u64)))) {
            desugar_value_loop(e);
            // 脱糖把 L 原地改写为 block_expr；与值 if 同构，必须再用 infer_block_expr
            // 走一次 CST 遍历来真正**取值 + 发射**（desugar_value_loop 已调 hir_invalidate，
            // 改写后的节点不再有 HIR 映射，直接走 CST 分支）。只 return T 会让块被悬空、
            // 循环代码永不发射，且脱糖期临时发射的 HIR 节点也会被孤立 → 后续门禁/运行期错乱。
            return infer_block_expr(e);
        }
        // 非值循环不得出现在表达式位置（无 else 且无 break v 即无值可产）。
        parse.fc_err("T-SEM-E282", "循环出现在表达式位置必须是「值循环」：需带 `else` 完成子句，或体含 `break <值>`", e);
        return ti_mk("Unknown");
    }
    if (is_pipe_kind(k) == true) {
        return lower_pipe(e);
    }
    // 区间走到「取值」这一步，说明它不在 for / 索引 / match / in 这四个已降解的
    // 上下文里 —— 那就只剩物化一条路（`(0..10) |> f`、`var xs: []i64 = 1..5;`）。
    if (k == "range") {
        return materialize_range(e);
    }
    // `x as T`：类型由目标类型定死，GEN:type_infer2 的生成规则因此写成「直接
    // return resolve_ti(n.nb)」—— 操作数**一次都不遍历**。后果不是类型错，而是
    // 整棵子树逃过检查：`zzz_undefined as i64`、`add2(1) as i64` 都零诊断通过，
    // 后端照发代码（静默错编，与 T-SEM-E201/E208 同一类）。range 落地后更致命：
    // `str_len(s[0..5]) as i64` 里的区间下标不被降解，后端当单元素索引发 str_at。
    // 生成区不能手改，故在此前置补一条：先推操作数，再按目标类型收口。
    if (k == "cast") {
        if (base.node_na((e as u64)) >= 0) { ie_sub_v(ei, 0, base.node_na((e as u64))); }
        return resolve_ti(base.node_nb((e as u64)));
    }
    // M-meta Phase D：编译期内建走到 check 说明它没被折掉 —— 一律是错。
    // `@compile_error` 本就只许活在编译期上下文；`@type_*` 折不掉意味着类型实参
    // 在编译期不可解析。两者都不该、也无法降级为运行期代码（第 8 条）。
    if (k == "mbuiltin") {
        if (base.node_sa((e as u64)) == "compile_error") {
            // 语义同 Zig 的 @compileError：**只要被分析到就触发**。CTFE 执行到会触发，
            // 走到 check（说明这段代码真的会被编译）同样触发。死分支已由 mb_prune_if
            // 剪除，故 `if (@type_equal(...)) ... else @compile_error(...)` 不会误报。
            var mmsg: string = "编译期终止";
            if (base.node_la((e as u64)) >= 0) {
                if (base.node_kind((base.kids[base.node_la((e as u64))].val as u64)) == "string") { mmsg = base.node_sa((base.kids[base.node_la((e as u64))].val as u64)); }
            }
            parse.fc_err("T-MTA-E604", mmsg, e);
        } else if (mb_is_ctfe_only(base.node_sa((e as u64))) and g_in_comptime <= 0) {
            // 仅当不在 comptime 上下文（g_in_comptime>0）才报运行期误用：comptime 块 / comptime fn 体
            // 定义期检查会遇到未折叠的 ctfe-only 内建，它们将在调用点 meta_pass 折叠，故豁免；
            // `meta fn`（可运行期调用、g_in_comptime==0）体仍须为合法运行期代码。
            parse.fc_err("T-MTA-E605",
                base.sb_cat3("`@", base.node_sa((e as u64)),
                    "` 只能在纯编译期上下文求值：请放进 `comptime { }` 块，或放进带 `comptime` 形参的 `comptime fn`"), e);
        } else if (mb_is_ctfe_only(base.node_sa((e as u64))) and g_in_comptime > 0) {
            // comptime 上下文内 ctfe-only 内建（@compile_log / @compile_warning / str_from_bytes）合法：
            // 它们将在调用点 meta_pass 折叠执行，此处仅给类型（Void），不报未知内建（否则误报 E607）。
            return ti_mk("Void");
        } else if (mb_is_type_query(base.node_sa((e as u64))) or base.node_sa((e as u64)) == "zeroed") {
            parse.fc_err("T-MTA-E606",
                base.sb_cat3("`@", base.node_sa((e as u64)), "` 的类型实参在编译期不可解析"), e);
        } else if (base.node_sa((e as u64)) == "type_val" or base.node_sa((e as u64)) == "type_of") {
            // P4 类型即值：@type_val("T") / @type_of(e) 还原出的类型节点都是「类型即值」——
            // 静态类型标为 Any（与 `fn() type` 返回标注解析出的 TypeInfo 一致，
            // 见 resolve_ti 对 kind=="type" 的处理），真正的类型节点在 CTFE
            // （meta_eval_mbuiltin 的 type_val / type_of 分支）期产出并流入单态化。
            return ti_mk("Any");
        } else if (base.node_sa((e as u64)) == "as" or base.node_sa((e as u64)) == "bit_cast") {
            // P3：@as(T, v) / @bit_cast(T, v) 的静态类型即目标类型 T。
            // 真正的取值在 CTFE（meta_eval_mbuiltin 的 as / bit_cast 分支）折叠。
            // ⚠ 不可在此以 g_in_comptime<=0 报运行期错误：comptime fn **体**的类型推断跑在
            //   该标志为 0 的趟里（真正求值在随后的 meta_pass），过早报错会把合法的编译期
            //   用法一并打死。运行期误用会以「下发非法 IR → clang 链接失败」的形式
            //   响亮失败（非静默错编），后续拟在 sema 里脱糖成既有 cast 节点以支持运行期。
            var pc0: i64 = base.node_la((e as u64));
            if (pc0 >= 0) {
                var pn0: i64 = base.kids[pc0].next;
                if (pn0 >= 0) { ie_sub_in_v(ei, base.kids[pn0].val); }
                var ptn: i64 = mb_as_type_node(base.kids[pc0].val);
                if (ptn >= 0) { return resolve_ti(ptn); }
            }
            return ti_mk("Unknown");
        } else if (math_mbuiltin(base.node_sa((e as u64)))) {
            // @sin 等数学内建：编译期可折叠常量（见 meta_eval_math），运行期回落 libm / fdlibm
            //（见各后端 ll_call / emit_expr）。此处给实参加类型检查，避免把字符串当浮点发射。
            var mc: i64 = base.node_la((e as u64));
            while (mc >= 0) { ie_sub_in_v(ei, base.kids[mc].val); mc = base.kids[mc].next; }
            if (str_slice(base.node_sa((e as u64)), str_len(base.node_sa((e as u64))) - 1, str_len(base.node_sa((e as u64)))) == "f") { return ti_scalar("f32"); }
            return ti_scalar("f64");
        } else if (test_mbuiltin(base.node_sa((e as u64)))) {
            // @panic(msg) / @assert(cond, msg) / @assert_eq(a, b, msg)
            // ⚠ t 的 string 是独立 kind（"string"，非 Scalar）；bool/float/int 是 Scalar + name。
            if (base.node_sa((e as u64)) == "panic") {
                var tp_pc: i64 = base.node_la((e as u64));
                if (tp_pc < 0) { parse.fc_err("T-SEM-E206", "@panic 需要 1 个字符串实参", e); return ti_mk("Void"); }
                var tp_t: i64 = ie_sub_in(ei, base.kids[tp_pc].val);
                if (tip_kind(tp_t) != "String") { parse.fc_err("T-SEM-E207", "@panic 的实参必须是 string", e); return ti_mk("Void"); }
                // P4：@panic 归 Never（底类型）—— 作补齐单位元，恒有交付路径时循环可省 else。
                return ti_mk("Never");
            }
            if (base.node_sa((e as u64)) == "assert") {
                var tp_ac: i64 = base.node_la((e as u64));
                if (tp_ac < 0) { parse.fc_err("T-SEM-E206", "@assert 需要 2 个实参（条件, 消息）", e); return ti_mk("Void"); }
                var tp_cond: i64 = ie_sub_in(ei, base.kids[tp_ac].val);
                if (tip_kind(tp_cond) != "Scalar" or tip_name(tp_cond) != "bool") { parse.fc_err("T-SEM-E207", "@assert 的第一个实参必须是 bool 条件", e); return ti_mk("Void"); }
                var tp_msg: i64 = base.kids[tp_ac].next;
                if (tp_msg < 0) { parse.fc_err("T-SEM-E206", "@assert 缺少消息实参", e); return ti_mk("Void"); }
                var tp_mt: i64 = ie_sub_in(ei, base.kids[tp_msg].val);
                if (tip_kind(tp_mt) != "String") { parse.fc_err("T-SEM-E207", "@assert 的第二个实参必须是 string", e); return ti_mk("Void"); }
                return ti_mk("Void");
            }
            // assert_eq(a, b, msg)
            var tp_c2: i64 = base.node_la((e as u64));
            var tp_n: i64 = 0; var tp_a: i64 = -1; var tp_b: i64 = -1; var tp_m: i64 = -1;
            var tp_cur: i64 = tp_c2;
            // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环
            var ks6070: []i64 = base.kids_chain(tp_cur);
            var ki6070: i64 = 0;
            while (ki6070 < slice_len(ks6070) as i64) {
                var kv6070: i64 = ks6070[ki6070];
                if (tp_n == 0) { tp_a = kv6070; }
                if (tp_n == 1) { tp_b = kv6070; }
                if (tp_n == 2) { tp_m = kv6070; }
                tp_n = tp_n + 1;
                ki6070 = ki6070 + 1;
            }
            if (tp_n != 3) { parse.fc_err("T-SEM-E206", "@assert_eq 需要 3 个实参（期望, 实际, 消息）", e); return ti_mk("Void"); }
            var tp_ta: i64 = ie_sub_in(ei, tp_a);
            var tp_tb: i64 = ie_sub_in(ei, tp_b);
            var tp_tm: i64 = ie_sub_in(ei, tp_m);
            if (tip_kind(tp_tm) != "String") { parse.fc_err("T-SEM-E207", "@assert_eq 的第三个实参必须是 string", e); return ti_mk("Void"); }
            var tp_ak: string = tip_kind(tp_ta);
            var tp_an: string = tip_name(tp_ta);
            var tp_bk: string = tip_kind(tp_tb);
            var tp_bn: string = tip_name(tp_tb);
            if (tp_ak != tp_bk or tp_an != tp_bn) {
                var tp_al: string = tp_an; if (tp_al == "") { tp_al = tp_ak; }
                var tp_bl: string = tp_bn; if (tp_bl == "") { tp_bl = tp_bk; }
                parse.fc_err("T-SEM-E207", base.sb_cat5("@assert_eq 的两个实参类型必须相同（得到 ", tp_al, " 与 ", tp_bl, "）"), e);
                return ti_mk("Void");
            }
            // 把发射后缀（i64/u64/f64/f32/b/s）存进 n.sb，供后端选 runtime 函数。
            // ⚠ t 的整数字面量默认 i32；有符号整型统一路由到 i64 runtime（发射侧 sext），
            //   无符号整型路由到 u64 runtime（发射侧 zext），故所有位宽都受支持。
            var tp_suf: string = "";
            if (tp_ak == "Scalar") {
                if (tp_an == "i8" or tp_an == "i16" or tp_an == "i32" or tp_an == "i64") { tp_suf = "i64"; }
                else if (tp_an == "u8" or tp_an == "u16" or tp_an == "u32" or tp_an == "u64") { tp_suf = "u64"; }
                else if (tp_an == "f64") { tp_suf = "f64"; }
                else if (tp_an == "f32") { tp_suf = "f32"; }
                else if (tp_an == "bool") { tp_suf = "b"; }
                else { parse.fc_err("T-SEM-E207", base.sb_cat2("@assert_eq 暂不支持该标量类型：", tp_an), e); return ti_mk("Void"); }
            } else if (tp_ak == "String") {
                tp_suf = "s";
            } else {
                parse.fc_err("T-SEM-E207", base.sb_cat2("@assert_eq 暂不支持该类型：", tp_ak), e);
                return ti_mk("Void");
            }
            base.node_set_sb((e as u64), tp_suf);
            return ti_mk("Void");
        } else if (base.node_sa((e as u64)) == "splat" or base.node_sa((e as u64)) == "reduce_add" or base.node_sa((e as u64)) == "reduce_max"
                or base.node_sa((e as u64)) == "reduce_min" or base.node_sa((e as u64)) == "vlen" or base.node_sa((e as u64)) == "cpu_has" or base.node_sa((e as u64)) == "simd_lanes"
                or base.node_sa((e as u64)) == "tsplat" or base.node_sa((e as u64)) == "treduce_sum" or base.node_sa((e as u64)) == "treduce_mul"
                or base.node_sa((e as u64)) == "treduce_min" or base.node_sa((e as u64)) == "treduce_max" or base.node_sa((e as u64)) == "tile_rows"
                or base.node_sa((e as u64)) == "tile_cols" or base.node_sa((e as u64)) == "tile_flavor") {
            // 运行期向量内建：类型检查后返回对应 TI；发射见各后端 mbuiltin 分支。
            if (base.node_sa((e as u64)) == "simd_lanes") {
                // @simd_lanes(T) -> 本机向量寄存器可容纳的 T 的 lane 数（编译期常量值，运行期发射为字面量）
                var c: i64 = base.node_la((e as u64));
                if (c < 0) { parse.fc_err("T-VEC-E926", "`@simd_lanes` 需要 1 个类型实参", e); return ti_mk("Unknown"); }
                var lti: i64 = resolve_ti(base.kids[c].val);
                var lname: string = tip_name(lti);
                var leb: i64 = vec_lane_bytes(lname);
                var lanes: i64 = g_simd_bytes / leb;
                if (lanes < 1) { lanes = 1; }
                return ti_scalar("i64");
            }
            if (base.node_sa((e as u64)) == "cpu_has") {
                var c: i64 = base.node_la((e as u64));
                if (c < 0) { parse.fc_err("T-VEC-E926", "`@cpu_has` 需要 1 个字符串实参（特性名，如 \"avx\"）", e); return ti_mk("Unknown"); }
                if (base.node_kind((base.kids[c].val as u64)) != "string") { parse.fc_err("T-VEC-E926", "`@cpu_has` 的实参必须是特性名字符串字面量", e); return ti_mk("Unknown"); }
                return ti_scalar("bool");
            }
            if (base.node_sa((e as u64)) == "vlen") {
                var c: i64 = base.node_la((e as u64));
                if (c < 0) { parse.fc_err("T-VEC-E926", "`@vlen` 需要 1 个向量实参", e); return ti_mk("Unknown"); }
                var ati: i64 = ie_sub_in(ei, base.kids[c].val);
                if (ti_is_vector(ati) == false) { parse.fc_err("T-VEC-E926", "`@vlen` 的实参必须是向量", e); return ti_mk("Unknown"); }
                return ti_scalar("i64");
            }
            if (base.node_sa((e as u64)) == "reduce_add" or base.node_sa((e as u64)) == "reduce_max" or base.node_sa((e as u64)) == "reduce_min") {
                var c: i64 = base.node_la((e as u64));
                if (c < 0) { parse.fc_err("T-VEC-E926", base.sb_cat2("`", base.node_sa((e as u64))), e); return ti_mk("Unknown"); }
                var ati: i64 = ie_sub_in(ei, base.kids[c].val);
                if (ti_is_vector(ati) == false) { parse.fc_err("T-VEC-E926", base.sb_cat3("`", base.node_sa((e as u64)), "` 的实参必须是向量"), e); return ti_mk("Unknown"); }
                return tis[ati].elem;
            }
            if (base.node_sa((e as u64)) == "tsplat") {
                // @tsplat(scalar, rows, cols) -> @Tile(rows, cols, typeof(scalar), hardware)
                var cnt: i64 = 0; var a0: i64 = -1; var a1: i64 = -1; var a2: i64 = -1;
                var c2: i64 = base.node_la((e as u64));
                // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环
                var ks6152: []i64 = base.kids_chain(c2);
                var ki6152: i64 = 0;
                while (ki6152 < slice_len(ks6152) as i64) {
                    var kv6152: i64 = ks6152[ki6152];
                    if (cnt == 0) { a0 = kv6152; }
                    if (cnt == 1) { a1 = kv6152; }
                    if (cnt == 2) { a2 = kv6152; }
                    cnt = cnt + 1;
                    ki6152 = ki6152 + 1;
                }
