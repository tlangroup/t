            }
            if (si2 >= 0) {
                var s2: Sym = syms[si2];
                if (tip_kind(s2.ti) == "Func") {
                    if (s2.decl >= 0) {
                        if (base.node_kind((s2.decl as u64)) == "FuncDecl") {
                            // #4b：先归一化隐式类型参数（标记 bb + 前置重排），使 func_is_generic 门控生效。
                            // 脱糖期已按 decl_list 扫描跑过一遍（use_scope=false）；此处 use_scope=true 兜底
                            // 处理跨模块 concept 约束（符号表此刻已就绪），幂等（g_generic_resolved 防重入）。
                            generic_normalize_func(s2.decl, true);
