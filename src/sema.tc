                var f: Node = nodes[kids[c].val];
                if (f.nb >= 0) {
                    var found: bool = false;
                    var i: i64 = 0;
                    var pl: i64 = slice_len(present);
                    while (i < pl) {
                        if (present[i] == f.sa) { found = true; break; }
                        i = i + 1;
                    }
                    if (found == false) {
                        var fvid: i64 = mk_FV(f.sa, f.nb, -1);
                        if (n.la < 0) {
                            n.la = list_push(-1, -1, fvid);
                        } else {
                            var tail: i64 = n.la;
                            while (kids[tail].next >= 0) { tail = kids[tail].next; }
                            list_push(n.la, tail, fvid);
                        }
                    }
                }
                c = kids[c].next;
            }
            slice_set(nodes, e, n);
        }
        return ti_named("Struct", n.sa);
    }
    if (n.kind == "cast") {
        return resolve_ti(n.nb);
    }
    if (n.kind == "paren") {
        return infer_expr(n.na);
    }
    if (n.kind == "comptime") {
        return infer_expr(n.na);
    }
// <<< GEN:type_infer2 <<<
    return ti_mk("Unknown");
}

// ── 返回路径分析（复刻 checker.ts:653）────────────────────────

fn all_paths_return(head: i64) bool {
    if (head < 0) {
        return false;
    }
    var last: i64 = list_last_val(head);
    if (last < 0) {
        return false;
    }
    return stmt_returns(last);
}

fn stmt_returns(s: i64) bool {
    var n: Node = nodes[s];
    if (n.kind == "return") {
        return true;
    }
    if (n.kind == "if") {
        if (n.lb != -2) {
            if (all_paths_return(n.la)) {
                return all_paths_return(n.lb);
            }
            return false;
        }
        return false;
    }
    if (n.kind == "block") {
        return all_paths_return(n.la);
    }
    return false;
}

// ── 语句检查 checkStmt（复刻 checker.ts:345）──────────────────

fn check_stmt(s: i64) void {
    var n: Node = nodes[s];
    // 闭包体首的捕获变量重建（M48）：类型来自捕获点的原始声明，直接定义同名局部
    if (n.kind == "closure_capture") {
        if (n.na >= 0) {
            sym_define(cur_scope, n.sa, "var", resolve_ti(n.na), -1);
        }
        return;
    }
    if (n.kind == "var_decl") {
        var vt: i64 = -1;
        // 管道许可上下文之一：初始化器（reference.md §3.15.6）
        if (n.nb >= 0) { pipe_mark(n.nb); }
        if (n.na >= 0) {
            // 显式标注：直接采用（var/const/let 三种局部声明统一路径）
            vt = resolve_ti(n.na);
        } else if (n.nb >= 0) {
            // 局部声明（var/const/let）无标注时由初始化器静态推断（人类编程友好）。
            // 此前仅 `auto`(bb) 走此路；现三关键字统一开放，标注语义改为「可选约束/覆盖」。
            var inf_ti: i64 = infer_expr(n.nb);
            if (inf_ti >= 0 && tip_kind(inf_ti) != "Unknown") {
                vt = inf_ti;
                var tn2: i64 = mk_type_node_from_ti(inf_ti);
                n.na = tn2;
                slice_set(nodes, s, n);
            }
        }
        if (vt < 0) {
            // 既无标注、又无（可推断类型的）初始化器 → 无法定型
            fc_err("T-SEM-E211",
                sb_cat3("局部变量 `", n.sa,
                    "` 必须带类型标注或提供可推断类型的初始化器"), s);
            return;
        }
        if (n.nb >= 0) {
            var it: i64 = infer_expr(n.nb);
            intlit_overflow_warn(n.nb, vt);
            if (tip_kind(it) != "Unknown" && ti_equal(it, vt) == false) {
                var vk: string = tip_kind(vt);
                var int_to_fe: bool = (vk == "Flag" || vk == "Enum") && is_int_ti(it);
                // Sym 字段允许由字符串赋值（自动 intern → id）
                var str_to_sym: bool = vk == "Sym" && tip_kind(it) == "String";
                if (int_to_fe == false && str_to_sym == false && can_cast(it, vt) == false) {
                    err_type_mismatch(n.nb, vt, it);
                }
            }
        }
        sym_define(cur_scope, n.sa, "var", vt, s);
        // const 引用静态常量规则（仅对 const 声明生效；let/var 不受限）
        if (g_const_decl_has(s)) { check_const_ref(s); }
        return;
    }
    if (n.kind == "if") {
        var ct: i64 = infer_expr(n.na);
        if (is_cond_bool(ct) == false) {
            var di: i64 = diag_new("T-SEM-E204", "error",
                sb_cat2("if condition must be bool or explicit comparison, got ", ti_str(ct)),
                "", 1, 1, 1, 5);
            var fx: i64 = fix_one("add explicit comparison", "", 1, 1, 1, 1, "(expr != 0)");
            diag_set_fs(di, fx);
        }
        var prev: i64 = cur_scope;
        cur_scope = scope_new(prev);
        var c: i64 = n.la;
        while (c >= 0) {
            var k: Child = kids[c];
            check_stmt(k.val);
            c = k.next;
        }
        if (n.lb != -2) {
            cur_scope = scope_new(prev);
            var c2: i64 = n.lb;
            while (c2 >= 0) {
                var k2: Child = kids[c2];
                check_stmt(k2.val);
                c2 = k2.next;
            }
        }
        cur_scope = prev;
        return;
    }
    if (n.kind == "for" || n.kind == "while") {
        // 循环头与循环体共用一层作用域。C 式 for 的初始化变量必须**先**入作用域，
        // 条件与步进才解析得到它 —— 原实现在建作用域前就推断条件，`for (var i...; i <= n; ...)`
        // 里的 `i` 解析不到，靠 infer_expr 的 Unknown 兜底才没炸（T_UNDEFINED_IDENT 上线后暴露）。
        var prev2: i64 = cur_scope;
        cur_scope = scope_new(prev2);
        if (n.kind == "for" && n.na >= 0) {
            check_stmt(n.na);
        }
        var cond: i64 = n.na;
        if (n.kind == "for") {
            cond = n.nb;
        }
        if (cond >= 0) {
            var ct2: i64 = infer_expr(cond);
            if (is_cond_bool(ct2) == false) {
                diag_new("T-SEM-E204", "error",
                    sb_cat2("loop condition must be bool, got ", ti_str(ct2)),
                    "", 1, 1, 1, 5);
            }
        }
        var c3: i64 = n.la;
        while (c3 >= 0) {
            var k3: Child = kids[c3];
            check_stmt(k3.val);
            c3 = k3.next;
        }
        // 步进语句此前**完全未被检查**（发射侧照常发射），一并补上。
        if (n.kind == "for" && n.nc >= 0) {
            check_stmt(n.nc);
        }
        cur_scope = prev2;
        return;
    }
    if (n.kind == "for_each") {
        // `for (i in a..b)`：区间不物化，就地改写成计数循环再按 block 走一遍。
        // 必须抢在 infer_expr(n.na) 之前 —— 否则区间会先被当成值物化成 []i64，
        // 白白分配一条 n 长的切片。
        if (is_range_node(n.na)) {
            lower_for_range(s);
            if (nodes[s].kind == "block") {
                check_stmt(s);
            }
            return;
        }
        var itt: i64 = infer_expr(n.na);
        if (tip_kind(itt) == "Array") {
            lower_for_array(s);
            if (nodes[s].kind == "block") {
                check_stmt(s);
            }
            return;
        }
        var prev3: i64 = cur_scope;
        cur_scope = scope_new(prev3);
        var et: i64 = -1;
        var itk: string = tip_kind(itt);
        if (itk == "Slice" || itk == "Array") {
            var t4: TI = tis[itt];
            et = t4.elem;
        } else {
        if (itk == "Map") {
            // map 的 for-in 迭代键（按插入序）
            var t5: TI = tis[itt];
            et = t5.key;
        } else {
            et = ti_mk("Unknown");
        }}
        sym_define(cur_scope, n.sa, "var", et, -1);
        // 双变量形式 `for (k, v in m)`：第二个变量绑定值类型
        if (str_len(n.sb) > 0) {
            var vt5: i64 = ti_mk("Unknown");
            if (itk == "Map") {
                var t6: TI = tis[itt];
                vt5 = t6.val;
            } else {
                diag_new("T-SEM-E202", "error",
                    "for (k, v in x): 双变量迭代仅支持 map",
                    n_file(n.na), n_line(n.na), n_col(n.na), n_line(n.na), n_col(n.na) + 5);
            }
            sym_define(cur_scope, n.sb, "var", vt5, -1);
        }
        var c4: i64 = n.la;
        while (c4 >= 0) {
            var k4: Child = kids[c4];
            check_stmt(k4.val);
            c4 = k4.next;
        }
        cur_scope = prev3;
        return;
    }
    if (n.kind == "return") {
        if (n.na >= 0) {
            // 管道许可上下文之三：return 值
            pipe_mark(n.na);
            var rt: i64 = infer_expr(n.na);
            // 逃逸分析（T-SEM-E764）：返回对局部变量/参数的引用 → 悬垂指针（dangling）
            if (expr_has_local_addr(n.na)) {
                fc_err("T-SEM-E764",
                    "返回对局部变量/参数的引用会产生悬垂指针（dangling）：该引用随函数返回而失效",
                    n.na);
            }
            intlit_overflow_warn(n.na, cur_ret);
            if (tip_kind(rt) != "Unknown" && ti_equal(rt, cur_ret) == false) {
                if (can_cast(rt, cur_ret) == false) {
                    err_type_mismatch(n.na, cur_ret, rt);
                }
            }
            // #2/#3：同 call 路径，return 值处的 Array→Slice / 空数组字面量→Slice 构造
            if (tip_kind(cur_ret) == "Slice" && ti_equal(cur_ret, rt) == false && can_cast(rt, cur_ret)) {
                var rak: string = nodes[n.na].kind;
                if (rak == "array_lit" || tip_kind(rt) == "Array") {
                    n.na = mk_cast(n.na, ti_to_td_base(cur_ret), -1);
                    slice_set(nodes, s, n);
                }
            }
        }
        return;
    }
    if (n.kind == "assignment") {
        var tt: i64 = infer_expr(n.na);
        // 解引用赋值 `*r = v`：仅当 r 为可变绑定（var）时允许，否则即「只读引用被写入」。
        // （原 E762 检查误置于 infer_expr 的 assign 分支，但语句级赋值从不经该分支，
        //  故从未触发；此处才是赋值语句的真实检查点。）
        if (nodes[n.na].kind == "deref") {
            var dop: i64 = nodes[n.na].na;
            if (dop >= 0 && nodes[dop].kind == "ident") {
                var dsi: i64 = sym_lookup(cur_scope, nodes[dop].sa);
                if (dsi < 0) { dsi = sym_lookup(global_scope, nodes[dop].sa); }
                if (dsi >= 0) {
                    var ddecl: i64 = syms[dsi].decl;
                    if (ddecl >= 0 && nodes[ddecl].kind == "var_decl" && nodes[ddecl].ba == true) {
                        fc_err("T-SEM-E762",
                            sb_cat3("不能透过只读引用 `", nodes[dop].sa,
                                "` 写入：它由 `let`/`const` 声明（只读），要用可变引用请改用 `var` 声明"),
                            n.na);
                    }
                }
            }
        }
        // 管道许可上下文之二：赋值右侧
        // （T-SEM-E764 逃逸检查统一放在 infer_expr 的 assign 分支，避免与 compound
        // 赋值节点重复；此处 LHS 为元组，assign_target_escapable 已天然不匹配。）
        pipe_mark(n.nb);
        var vt2: i64 = infer_expr(n.nb);
        intlit_overflow_warn(n.nb, tt);
        if (tip_kind(tt) != "Unknown" && tip_kind(vt2) != "Unknown" && ti_equal(tt, vt2) == false) {
            // Sym 字段允许由字符串赋值（自动 intern）；跨池 Sym→Sym 仍报错
            var str_to_sym2: bool = tip_kind(tt) == "Sym" && tip_kind(vt2) == "String";
            if (str_to_sym2 == false && can_cast(vt2, tt) == false) {
                err_type_mismatch(n.nb, tt, vt2);
            }
            // #2/#3：同 call 路径，赋值 RHS 处的 Array→Slice / 空数组字面量→Slice 构造
            if (tip_kind(tt) == "Slice" && ti_equal(tt, vt2) == false && can_cast(vt2, tt)) {
                var aak: string = nodes[n.nb].kind;
                if (aak == "array_lit" || tip_kind(vt2) == "Array") {
                    n.nb = mk_cast(n.nb, ti_to_td_base(tt), -1);
                    slice_set(nodes, s, n);
                }
            }
        }
        return;
    }
    if (n.kind == "expr") {
        // 管道许可上下文之四：表达式语句。
        // ⚠ 之二（赋值右侧）也多半落在这里：`parse_assign_expr` 已把 `=` 吃成 `assign`
        // 表达式，语句级 `assignment` 节点只剩复合赋值（`+=` 等），故须穿过赋值链
        // （含 `a = b = pipe;`）把许可位置移到最内层右值上。
        var pe: i64 = pipe_mark(n.na);
        var discarded: bool = true;
        var go2: bool = true;
        while (go2 == true) {
            go2 = false;
            if (pe >= 0) {
                if (nodes[pe].kind == "assign") {
                    pe = pipe_mark(nodes[pe].nb);
                    discarded = false;
                    go2 = true;
                }
            }
        }
        var was_pipe: bool = false;
        if (pe >= 0) { was_pipe = is_pipe_kind(nodes[pe].kind); }
        var et: i64 = infer_expr(n.na);
        // 管道 |> 逐元素 + void lambda 降级：lower_pipe 把管道根就地改写成 block
        // （内含 for_each 副作用遍历）。若仍以「表达式语句」发射，会把 block 当
        // 表达式 → `unsupported expr`。这里把它提升为本语句本身，走正常 for_each
        // 检查（注册循环变量、递归 body），再交由后端 emit_stmt 的 block 分支发射。
        if (nodes[n.na].kind == "block") {
            var blk: Node = nodes[n.na];
            n.kind = "block";
            n.sa = "";
            n.sb = "";
            n.na = -1;
            n.nb = -1;
            n.la = blk.la;
            slice_set(nodes, s, n);
            var cb: i64 = n.la;
            while (cb >= 0) {
                var ckb: Child = kids[cb];
                check_stmt(ckb.val);
                cb = ckb.next;
            }
            return;
        }
        // 结果被接收（赋值链）时不告警；只有真正丢弃才报 W868。
        if (discarded == false) { was_pipe = false; }
        if (was_pipe == true) {
            if (tip_kind(et) != "Void" && tip_kind(et) != "Unknown") {
                pipe_warn("T-PIP-W868",
                    sb_cat3("管道结果类型为 `", ti_str(et),
                        "` 但被丢弃：请接收结果，或让末级函数返回 void"), n.na);
            }
        }
        return;
    }
    if (n.kind == "block" || n.kind == "defer" || n.kind == "comptime_block") {
        var prev4: i64 = cur_scope;
        cur_scope = scope_new(prev4);
        var c5: i64 = n.la;
        while (c5 >= 0) {
            var k5: Child = kids[c5];
            check_stmt(k5.val);
            c5 = k5.next;
        }
        cur_scope = prev4;
        return;
    }
}

// ── 声明检查（复刻 checker.ts:178-341）────────────────────────

fn check_func_decl(d: i64) void {
    var n: Node = nodes[d];
    if (n.lc == -2) {
        return;
    }
    // 维护 g_cur_func_decl，供 format 脱糖判断当前是否处于泛型模板体内（见 desugar_format_call）。
    var prev_fd: i64 = g_cur_func_decl;
    g_cur_func_decl = d;

    var prev: i64 = cur_scope;
    cur_scope = scope_new(global_scope);

    // 由 lambda 提升而来的合成函数：函数体已脱离原词法环境，未解析的标识符
    // 即「试图捕获外层局部」，需给出可执行的诊断（见 infer_expr ident 分支）。
    var prev_lam: bool = g_in_lambda;
    g_in_lambda = n.sc == "__lambda__";

    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var p: Node = nodes[k.val];
        sym_define(cur_scope, p.sa, "var", resolve_ti(p.na), -1);
        // T-SEM-E214：简写闭包 `|v|` 参数类型若到检查期仍无上下文回填 → 报错（绝不默认 any）
        if (p.na >= 0 && tip_kind(resolve_ti(p.na)) == "Infer") {
            fc_err("T-SEM-E214",
                sb_cat5("匿名函数参数 `", p.sa,
                    "` 的类型无法推断：请标注目标类型（如 `var g: fn(T)U = |name| ...`），或显式写出 `|",
                    p.sa, ": Type|`"),
                d);
        }
        c = k.next;
    }

    var prev_ret: i64 = cur_ret;
    cur_ret = resolve_ti(n.na);
    // `|v: T| expr` 简写闭包：返回类型占位待推断，在此（函数体检查前）就地推断，
    // 使后续 all_paths_return 等检查基于真实返回类型。既有显式返回类型的函数不受影响。
    if (g_infer_ti >= 0 && tip_kind(cur_ret) == "Infer") {
        cur_ret = infer_lambda_ret_from_decl(d);
    }

    var c2: i64 = n.lc;
    while (c2 >= 0) {
        var k2: Child = kids[c2];
        check_stmt(k2.val);
        c2 = k2.next;
    }

    if (tip_kind(cur_ret) != "Void") {
        if (all_paths_return(n.lc) == false) {
            var anchor: i64 = list_last_val(n.lc);
            var l: i64 = n_line(anchor);
            var cc: i64 = n_col(anchor);
            diag_new("T-PAR-E100", "error",
                sb_cat3("function '", n.sa, "' is missing return on some code paths (all branches must explicitly return)"),
                n_file(anchor), l, cc, l, cc + 10);
        }
    }

    cur_ret = prev_ret;
    cur_scope = prev;
    g_in_lambda = prev_lam;
    g_cur_func_decl = prev_fd;
}

fn check_struct_decl(d: i64) void {
    var n: Node = nodes[d];
    var c: i64 = n.lb;
    var total: i64 = 0;
    var tag_count: i64 = 0;
    // 第一遍：解析字段类型 + 统计显式 tagID 字段数
    while (c >= 0) {
        var k: Child = kids[c];
        var f: Node = nodes[k.val];
        total = total + 1;
        if (f.ib >= 1) { tag_count = tag_count + 1; }
        if (f.ia == -1) {
            resolve_ti(f.na);
        }
        c = k.next;
    }
    // ── 全有 / 全无 规则：struct 内 tagID 要么全显式(@N)，要么全自动，禁止混合 ──
    if (tag_count > 0 && tag_count < total) {
        diag_new("T-SEM-E210", "error",
            sb_cat3("struct '", n.sa, "' 的字段 tagID 必须「全显式 @N」或「全自动」：不能部分字段写 @N、部分不写"),
            n_file(d), n_line(d), n_col(d), n_line(d), n_col(d) + 4);
        return;
    }
    // ── 全显式：去重；全自动：顺序分配 1,2,3…（写入 f.ib 供后续 type_info / 序列化使用）──
    if (total > 0) {
        if (tag_count == total) {
            // 去重：O(n^2) 两两比对（struct 字段数极少）
            var p: i64 = n.lb;
            while (p >= 0) {
                var pf: Node = nodes[kids[p].val];
                var q: i64 = kids[p].next;
                while (q >= 0) {
                    var qf: Node = nodes[kids[q].val];
                    if (pf.ib >= 1 && qf.ib == pf.ib) {
                        var osb: StringBuilder = sb_new();
                        sb_append_str(osb, "struct '");
                        sb_append_str(osb, n.sa);
                        sb_append_str(osb, "': 字段 tagID 重复 @");
                        sb_append_i64(osb, pf.ib);
                        sb_append_str(osb, "（字段 '");
                        sb_append_str(osb, pf.sa);
                        sb_append_str(osb, "' 与 '");
                        sb_append_str(osb, qf.sa);
                        sb_append_str(osb, "'）");
                        diag_new("T-SEM-E209", "error", sb_to_str(osb),
                            n_file(d), n_line(d), n_col(d), n_line(d), n_col(d) + 4);
                    }
                    q = kids[q].next;
                }
                p = kids[p].next;
            }
        } else {
            // 全自动：顺序分配（基值 1）
            var idx: i64 = 1;
            var cc: i64 = n.lb;
            while (cc >= 0) {
                var ff: Node = nodes[kids[cc].val];
                ff.ib = idx;
                slice_set(nodes, kids[cc].val, ff);
                idx = idx + 1;
                cc = kids[cc].next;
            }
        }
    }
    // ── 默认表达式类型检查：f.nb（默认）须可赋给字段类型 f.na ──
    c = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var f: Node = nodes[k.val];
        if (f.nb >= 0) {
            var ft: i64 = resolve_ti(f.na);
            var dt: i64 = infer_expr(f.nb);
            if (tip_kind(dt) != "Unknown" && ti_equal(dt, ft) == false && can_cast(dt, ft) == false) {
                err_type_mismatch(f.nb, ft, dt);
            }
        }
        c = k.next;
    }
}

fn check_enum_decl(d: i64) void {
    var n: Node = nodes[d];
    if (is_int_name(n.sb) == false) {
        var di: i64 = diag_new("T-SEM-E202", "error",
            sb_cat5("enum '", n.sa, "' underlying type must be an integer type, got '", n.sb, "'"),
            "", 1, 1, 1, 10);
        slb_begin();
        slb_add("u8");
        slb_add("u16");
        slb_add("u32");
        slb_add("u64");
        slb_add("i8");
        slb_add("i16");
        slb_add("i32");
        slb_add("i64");
        diag_set_vv(di, slb_head);
    }

    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var v: Node = nodes[k.val];
        if (v.na >= 0) {
            var vt: i64 = infer_expr(v.na);
            if (tip_kind(vt) == "Scalar" && is_int_name(tip_name(vt)) == false) {
                diag_new("T-SEM-E202", "error",
                    sb_cat2("enum variant value must be integer, got ", ti_str(vt)),
                    "", 1, 1, 1, 5);
            }
        }
        c = k.next;
    }
}

// flag decl 检查用的 usedBits 暂存池（append-only，按 base 划分）
var fd_names: []string;
var fd_starts: []i64;
var fd_ends: []i64;

fn check_flag_decl(d: i64) void {
    var n: Node = nodes[d];
    var is_flag: bool = n.kind == "FlagDecl";
    if (is_flag && is_int_name(n.sb) == false) {
        var di: i64 = diag_new("T-SEM-E202", "error",
            sb_cat5("flag '", n.sa, "' underlying type must be an integer type, got '", n.sb, "'"),
            "", 1, 1, 1, 10);
        slb_begin();
        slb_add("u8");
        slb_add("u16");
        slb_add("u32");
        slb_add("u64");
        diag_set_vv(di, slb_head);
    }

    var auto_off: i64 = 0;
    var base: i64 = slice_len(fd_names) as i64;

    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var sl: Node = nodes[k.val];
        var start: i64 = auto_off;
        if (sl.bb) {
            start = sl.ib;
        }
        var end: i64 = start + sl.ia;

        var i: i64 = base;
        var total: i64 = slice_len(fd_names) as i64;
        while (i < total) {
            var us: i64 = fd_starts[i];
            var ue: i64 = fd_ends[i];
            if (start < ue && end > us) {
                var msb: StringBuilder = sb_new();
                sb_append_str(msb, "flag slot '");
                sb_append_str(msb, sl.sa);
                sb_append_str(msb, "' (bits ");
                sb_append_i64(msb, start);
                sb_append_str(msb, "-");
                sb_append_i64(msb, end - 1);
                sb_append_str(msb, ") overlaps with '");
                sb_append_str(msb, fd_names[i]);
                sb_append_str(msb, "' (bits ");
                sb_append_i64(msb, us);
                sb_append_str(msb, "-");
                sb_append_i64(msb, ue - 1);
                sb_append_str(msb, ")");
                diag_new("T-FLG-E850", "error", sb_to_str(msb), "", 1, 1, 1, 10);
            }
            i = i + 1;
        }

        append(fd_names, sl.sa);
        append(fd_starts, start);
        append(fd_ends, end);

        if (is_flag) {
            var tw: i64 = get_bw(n.sb);
            if (tw > 0 && end > tw) {
                var osb: StringBuilder = sb_new();
                sb_append_str(osb, "flag '");
                sb_append_str(osb, n.sa);
                sb_append_str(osb, "' slot '");
                sb_append_str(osb, sl.sa);
                sb_append_str(osb, "' exceeds ");
                sb_append_str(osb, n.sb);
                sb_append_str(osb, " (");
                sb_append_i64(osb, tw);
                sb_append_str(osb, " bits): uses bits ");
                sb_append_i64(osb, start);
                sb_append_str(osb, "-");
                sb_append_i64(osb, end - 1);
                var di2: i64 = diag_new("T-FLG-E851", "error", sb_to_str(osb), "", 1, 1, 1, 10);
                slb_begin();
                slb_add(sb_cat3("0-", i2s(tw - 1), " bits"));
                diag_set_vv(di2, slb_head);
            }
        }

        auto_off = end;
        c = k.next;
    }
}

fn check_decl(d: i64) void {
    var n: Node = nodes[d];
    if (n.kind == "FuncDecl") {
        if (func_is_generic(d)) { return; }
        check_func_decl(d);
        return;
    }
    if (n.kind == "StructDecl") {
        check_struct_decl(d);
        return;
    }
    if (n.kind == "EnumDecl") {
        check_enum_decl(d);
        return;
    }
    if (n.kind == "FlagDecl" || n.kind == "FlagSetDecl") {
        check_flag_decl(d);
        return;
    }
    if (n.kind == "GlobalVarDecl") {
        if (n.nb >= 0) {
            var it: i64 = infer_expr(n.nb);
            var vt: i64 = resolve_ti(n.na);
            if (tip_kind(it) != "Unknown" && ti_equal(it, vt) == false) {
                // Sym 全局变量允许由字符串赋值（自动 intern → id）
                var gss: bool = tip_kind(vt) == "Sym" && tip_kind(it) == "String";
                if (gss == false && can_cast(it, vt) == false) {
                    err_type_mismatch(n.nb, vt, it);
                }
            }
        }
        return;
    }
    if (n.kind == "GlobalConstDecl") {
        if (n.nb >= 0) {
            var it2: i64 = infer_expr(n.nb);
            if (n.na >= 0) {
                var ct: i64 = resolve_ti(n.na);
                if (tip_kind(it2) != "Unknown" && ti_equal(it2, ct) == false) {
                    if (can_cast(it2, ct) == false) {
                        err_type_mismatch(n.nb, ct, it2);
                    }
                }
            }
            // const 引用静态常量规则（仅对 const 声明生效；let 不受限）
            if (g_const_decl_has(d)) { check_const_ref(d); }
        }
        return;
    }
    // 注：ImportModDecl 节点已在 resolve_modules（run_check 入口）内联解析时
    // 被整体移除，故此处不会再遇到；若残留（理论上不会）将由下方通用分支兜底。
}

// ── §7.2 CTFE 导入脱糖（M27）──────────────────────────────────
// 在 register_decl 全部完成后、check_decl 之前执行。
// 检测 var x: []Struct = import_csv("path") / import_json("path") →
// 编译期读文件 → 解析 → 值域校验 → 合成 __import_N 加载函数 → 替换 init。
// 残存调用报 T_IMPORT_CONTEXT。

var g_imp_counter: i64;

// 从切片类型节点提取元素 struct 名。na 指向 slice 节点（na=named），返回 struct 名或 ""。
fn import_elem_struct_name(type_node: i64) string {
    if (type_node < 0) { return ""; }
    var tn: Node = nodes[type_node];
    if (tn.kind != "slice") { return ""; }
    if (tn.na < 0) { return ""; }
    var elem: Node = nodes[tn.na];
    if (elem.kind == "named") { return elem.sa; }
    return "";
}

// 从 struct 名查找 StructDecl，返回其字段链表头（n.lb）或 -1。
fn find_struct_fields(sname: string) i64 {
    var si: i64 = sym_lookup(global_scope, sname);
    if (si < 0) { return -1; }
    var s: Sym = syms[si];
    if (s.decl < 0) { return -1; }
    var dn: Node = nodes[s.decl];
    if (dn.kind != "StructDecl") { return -1; }
    return dn.lb;
}

// 从字段链表收集 (字段名, 标量类型名) 对。结果写入全局 imp_fnames/imp_ftypes。
// 注意：t 的 slice 是值传递，无法用 out 参数，故用全局。
var imp_fnames: []string;
var imp_ftypes: []string;
// 当前正在处理的 import 的字段表起始下标（调用 collect_struct_fields 前记录）
var imp_fbase: i64;
// JSON 解析临时键值表（同样因 slice 值传递限制而用全局）
var jp_keys: []string;
var jp_vals: []string;

// 返回值：字段数。字段写入 imp_fnames/imp_ftypes 的尾部，
// 起始下标由调用方在调用前用 slice_len 记录（同 fr_resolve_flag 的 base 手法）。
fn collect_struct_fields(field_head: i64) i64 {
    var count: i64 = 0;
    var c: i64 = field_head;
    while (c >= 0) {
        var k: Child = kids[c];
        var f: Node = nodes[k.val];
        var fname: string = f.sa;
        var tname: string = "";
        if (f.na >= 0) {
            var ft: Node = nodes[f.na];
            if (ft.kind == "scalar") {
                tname = ft.sa;
            }
        }
        append(imp_fnames, fname);
        append(imp_ftypes, tname);
        count = count + 1;
        c = k.next;
    }
    return count;
}

// 校验单个值是否可赋给标量类型。返回 true=ok。
fn validate_scalar_value(val: string, tname: string, row_idx: i64, col_idx: i64) bool {
    if (tname == "string") { return true; }
    if (tname == "bool") {
        if (val == "true" || val == "false") { return true; }
        return false;
    }
    if (is_int_name(tname)) {
        // 简单检查：首字符可选负号，其余全数字
        var L: u64 = str_len(val);
        if (L == 0) { return false; }
        var start: u64 = 0;
        var c0: u8 = val[0];
        if (c0 == 45) { start = 1; }
        if (start >= L) { return false; }
        var i: u64 = start;
        while (i < L) {
            var ch: u8 = val[i];
            if (ch < 48 || ch > 57) { return false; }
            i = i + 1;
        }
        return true;
    }
    if (is_float_name(tname)) {
        // 简单检查：包含 . 或 e/E，或纯数字
        var L2: u64 = str_len(val);
        if (L2 == 0) { return false; }
        var has_dot: bool = false;
        var has_digit: bool = false;
        var i2: u64 = 0;
        if (val[0] == 45) { i2 = 1; }
        while (i2 < L2) {
            var ch2: u8 = val[i2];
            if (ch2 >= 48 && ch2 <= 57) { has_digit = true; }
            if (ch2 == 46) { has_dot = true; }
            i2 = i2 + 1;
        }
        if (has_digit == false) { return false; }
        return true;
    }
    return false;
}

// 为单个值合成标量字面量 AST 节点（int/float/bool/string + cast）
fn make_value_node(val: string, tname: string) i64 {
    if (tname == "string") {
        return mk_string(val, -1);
    }
    if (tname == "bool") {
        if (val == "true") { return mk_bool(true, -1); }
        return mk_bool(false, -1);
    }
    if (is_int_name(tname)) {
        var inode: i64 = mk_int(val, 10, -1);
        var target: i64 = mk_scalar(tname, -1);
        return mk_cast(inode, target, -1);
    }
    if (is_float_name(tname)) {
        var fnode: i64 = mk_float(val, -1);
        var target2: i64 = mk_scalar(tname, -1);
        return mk_cast(fnode, target2, -1);
    }
    return mk_string(val, -1);
}

// CSV 解析：返回行数组，每行是列数组。简单实现：逗号分隔，双引号转义。
// 输出写入 out_rows（每行用 \x1f 分隔列）。
fn csv_parse(content: string) []string {
    var rows: []string;
    var sb: StringBuilder = sb_new();
    var in_quotes: bool = false;
    var row_buf: StringBuilder = sb_new();
    var col_buf: StringBuilder = sb_new();
    var L: u64 = str_len(content);
    var i: u64 = 0;
    while (i < L) {
        var ch: u8 = content[i];
        if (in_quotes) {
            if (ch == 34) {
                if (i + 1 < L && content[i + 1] == 34) {
                    sb_append_char(col_buf, 34);
                    i = i + 2;
                    continue;
                }
                in_quotes = false;
                i = i + 1;
                continue;
            }
            sb_append_char(col_buf, ch);
            i = i + 1;
            continue;
        }
        if (ch == 34) {
            in_quotes = true;
            i = i + 1;
            continue;
        }
        if (ch == 44) {
            // 逗号 → 列分隔
            sb_append_str(row_buf, sb_to_str(col_buf));
            sb_append_char(row_buf, 31);
            col_buf = sb_new();
            i = i + 1;
            continue;
        }
        if (ch == 10) {
            // 换行 → 行结束
            sb_append_str(row_buf, sb_to_str(col_buf));
            append(rows, sb_to_str(row_buf));
            row_buf = sb_new();
            col_buf = sb_new();
            i = i + 1;
            continue;
        }
        if (ch == 13) {
            // CR → 跳过
            i = i + 1;
            continue;
        }
        sb_append_char(col_buf, ch);
        i = i + 1;
    }
    // 尾行
    if (str_len(sb_to_str(col_buf)) > 0 || str_len(sb_to_str(row_buf)) > 0) {
        sb_append_str(row_buf, sb_to_str(col_buf));
        append(rows, sb_to_str(row_buf));
    }
    return rows;
}

// 从 CSV 行中提取第 col 列的值（\x1f 分隔）
fn csv_col(row: string, col: i64) string {
    var idx: i64 = 0;
    var sb2: StringBuilder = sb_new();
    var L: u64 = str_len(row);
    var i: u64 = 0;
    while (i < L) {
        var ch: u8 = row[i];
        if (ch == 31) {
            if (idx == col) {
                return sb_to_str(sb2);
            }
            idx = idx + 1;
            sb2 = sb_new();
            i = i + 1;
            continue;
        }
        sb_append_char(sb2, ch);
        i = i + 1;
    }
    if (idx == col) {
        return sb_to_str(sb2);
    }
    return "";
}

// JSON 解析：期望顶层是对象数组 [ {..}, {..} ]。
// 按 imp_fnames[imp_fbase .. imp_fbase+num_fields) 的字段序，把每个对象
// 归一化成与 CSV 相同的 \x1f 分隔行，从而复用后续的值域校验与合成逻辑。
// 缺失的键归一化为空串（后续值域校验会报 T_IMPORT_VALUE）。
// 返回行数组；解析失败返回空数组。
fn json_parse(content: string, num_fields: i64) []string {
    var rows: []string;
    var L: u64 = str_len(content);
    var i: u64 = 0;

    // 跳到第一个 '['
    while (i < L && content[i] != 91) { i = i + 1; }
    if (i >= L) { return rows; }
    i = i + 1;

    while (i < L) {
        // 跳空白与逗号
        while (i < L) {
            var c0: u8 = content[i];
            if (c0 == 32 || c0 == 9 || c0 == 10 || c0 == 13 || c0 == 44) {
                i = i + 1;
                continue;
            }
            break;
        }
        if (i >= L) { break; }
        if (content[i] == 93) { break; }
        if (content[i] != 123) { return rows; }
        i = i + 1;

        // 收集本对象的键值对到临时并列表
        var kbase: i64 = slice_len(jp_keys) as i64;
        while (i < L) {
            // 跳空白与逗号
            while (i < L) {
                var c1: u8 = content[i];
                if (c1 == 32 || c1 == 9 || c1 == 10 || c1 == 13 || c1 == 44) {
                    i = i + 1;
                    continue;
                }
                break;
            }
            if (i >= L) { break; }
            if (content[i] == 125) { i = i + 1; break; }
            if (content[i] != 34) { return rows; }

            // 读键
            i = i + 1;
            var kb: StringBuilder = sb_new();
            while (i < L && content[i] != 34) {
                sb_append_char(kb, content[i]);
                i = i + 1;
            }
            i = i + 1;

            // 跳到冒号
            while (i < L && content[i] != 58) { i = i + 1; }
            i = i + 1;
            while (i < L) {
                var c2: u8 = content[i];
                if (c2 == 32 || c2 == 9 || c2 == 10 || c2 == 13) {
                    i = i + 1;
                    continue;
                }
                break;
            }
            if (i >= L) { break; }

            // 读值：字符串带引号，其余读到分隔符
            var vb: StringBuilder = sb_new();
            if (content[i] == 34) {
                i = i + 1;
                while (i < L && content[i] != 34) {
                    if (content[i] == 92 && i + 1 < L) {
                        i = i + 1;
                        var esc: u8 = content[i];
                        if (esc == 110) { sb_append_char(vb, 10); }
                        if (esc == 116) { sb_append_char(vb, 9); }
                        if (esc == 114) { sb_append_char(vb, 13); }
                        if (esc == 34) { sb_append_char(vb, 34); }
                        if (esc == 92) { sb_append_char(vb, 92); }
                        i = i + 1;
                        continue;
                    }
                    sb_append_char(vb, content[i]);
                    i = i + 1;
                }
                i = i + 1;
            } else {
                while (i < L) {
                    var c3: u8 = content[i];
                    if (c3 == 44 || c3 == 125 || c3 == 32 || c3 == 9 || c3 == 10 || c3 == 13) {
                        break;
                    }
                    sb_append_char(vb, c3);
                    i = i + 1;
                }
            }
            append(jp_keys, sb_to_str(kb));
            append(jp_vals, sb_to_str(vb));
        }

        // 按字段序拼成 \x1f 行
        var kn: i64 = slice_len(jp_keys) as i64;
        var rb: StringBuilder = sb_new();
        var fi: i64 = 0;
        while (fi < num_fields) {
            if (fi > 0) { sb_append_char(rb, 31); }
            var want: string = imp_fnames[(imp_fbase + fi) as u64];
            var ki: i64 = kbase;
            while (ki < kn) {
                if (jp_keys[ki as u64] == want) {
                    sb_append_str(rb, jp_vals[ki as u64]);
                    ki = kn;
                    continue;
                }
                ki = ki + 1;
            }
            fi = fi + 1;
        }
        append(rows, sb_to_str(rb));
    }
    return rows;
}

// 合成 __import_N 加载函数并返回其节点索引。
// 形态: __import_N fn() []StructName {
//   var __r: []StructName;
//   var __imp_r0: StructName = StructName{ f1: val1, f2: val2, ... };
//   append(__r, __imp_r0);
//   ...
//   return __r;
// }
fn synthesize_loader(sname: string, rows: []string, header_row: string, num_fields: i64, is_csv: bool) i64 {
    var fn_name: string = sb_cat2("__import_", i2s(g_imp_counter));
    g_imp_counter = g_imp_counter + 1;

    // 返回类型: []StructName
    var elem_named: i64 = mk_named(sname, -1);
    var ret_slice: i64 = mk_slice(elem_named, -1);

    // 函数体语句链表
    var body_head: i64 = -1;
    var body_tail: i64 = -1;

    // var __r: []StructName;
    var r_type: i64 = mk_slice(mk_named(sname, -1), -1);
    var r_decl: i64 = mk_var_decl("__r", false, r_type, -1, -1);
    body_tail = list_push(body_head, body_tail, r_decl);
    if (body_head < 0) { body_head = body_tail; }

    // CSV: header_row 是第一行，用于字段名映射
    // JSON: rows 直接是对象数组，field_names 已固定
    var nrows: i64 = slice_len(rows) as i64;
    var ri: i64 = 0;
    if (is_csv) {
        ri = 1; // 跳过表头
    }
    while (ri < nrows) {
        var row: string = rows[ri];
        // 构建 struct_lit 的字段链表
        var fv_head: i64 = -1;
        var fv_tail: i64 = -1;
        var ci: i64 = 0;
        while (ci < num_fields) {
            var fname: string = imp_fnames[(imp_fbase + ci) as u64];
            var ftype: string = imp_ftypes[(imp_fbase + ci) as u64];
            var col_val: string;
            if (is_csv) {
                // 根据 header_row 中的列名映射
                col_val = csv_col(row, ci);
            } else {
                col_val = csv_col(row, ci);
            }
            var vnode: i64 = make_value_node(col_val, ftype);
            var fv: i64 = mk_FV(fname, vnode, -1);
            fv_tail = list_push(fv_head, fv_tail, fv);
            if (fv_head < 0) { fv_head = fv_tail; }
            ci = ci + 1;
        }
        var lit: i64 = mk_struct_lit(sname, fv_head, -1);
        var tmp_name: string = sb_cat2("__imp_r", i2s(ri));
        var tmp_decl: i64 = mk_var_decl(tmp_name, false, mk_named(sname, -1), lit, -1);
        body_tail = list_push(body_head, body_tail, tmp_decl);
        if (body_head < 0) { body_head = body_tail; }

        // append(__r, __imp_r0);
        var call_args_head: i64 = -1;
        var call_args_tail: i64 = -1;
        call_args_tail = list_push(call_args_head, call_args_tail, mk_ident("__r", -1));
        if (call_args_head < 0) { call_args_head = call_args_tail; }
        call_args_tail = list_push(call_args_head, call_args_tail, mk_ident(tmp_name, -1));
        if (call_args_head < 0) { call_args_head = call_args_tail; }
        var append_call: i64 = mk_call(mk_ident("append", -1), call_args_head, -1);
        var append_stmt: i64 = mk_expr(append_call, -1);
        body_tail = list_push(body_head, body_tail, append_stmt);
        if (body_head < 0) { body_head = body_tail; }

        ri = ri + 1;
    }

    // return __r;
    var ret_stmt: i64 = mk_return(mk_ident("__r", -1), -1);
    body_tail = list_push(body_head, body_tail, ret_stmt);
    if (body_head < 0) { body_head = body_tail; }

    // ba=is_extern 必须为 false，否则 emitter 只发 declare 不发函数体；
    // lb=参数列表用 -2 表示空（-1 会被当作 null 链表头处理）
    var fdecl: i64 = mk_FuncDecl(fn_name, false, false, ret_slice, -1, -1, body_head, -1);
    // 注册符号
    sym_define(global_scope, fn_name, "func", ti_named("Func", fn_name), fdecl);
    // 加入 decl_list，使 emitter 能发射该合成函数。
    // 注意：desugar_imports 在 register 循环之后、check 循环之前运行，
    // check 循环用 slice_len(decl_list) 重新取长度，故新增项也会被检查。
    append(decl_list, fdecl);
    return fdecl;
}

// 检测一个表达式是否是 import_csv/import_json 调用
fn is_import_call(expr_idx: i64) string {
    if (expr_idx < 0) { return ""; }
    var n: Node = nodes[expr_idx];
    if (n.kind != "call") { return ""; }
    if (n.na < 0) { return ""; }
    var callee: Node = nodes[n.na];
    if (callee.kind != "ident") { return ""; }
    if (callee.sa == "import_csv") { return "csv"; }
    if (callee.sa == "import_json") { return "json"; }
    return "";
}

// 从 import call 节点提取路径参数字符串
fn import_path_arg(call_idx: i64) string {
    var n: Node = nodes[call_idx];
    var c: i64 = n.la;
    if (c < 0) { return ""; }
    var k: Child = kids[c];
    var arg: Node = nodes[k.val];
    if (arg.kind == "string") { return arg.sa; }
    return "";
}

// 对单个 var_decl 执行脱糖。成功返回 true。
fn desugar_one(var_idx: i64, file_for_diag: string, ln: i64, cl: i64) bool {
    var vn: Node = nodes[var_idx];
    var imp_kind: string = is_import_call(vn.nb);
    if (imp_kind == "") { return false; }

    // 提取目标类型: []StructName
    var sname: string = import_elem_struct_name(vn.na);
    if (sname == "") {
        diag_new("T-MOD-E555", "error",
            "import_csv/import_json requires target type []StructName",
            file_for_diag, ln, cl, ln, cl + 20);
        return false;
    }

    // 查找 struct 字段
    var field_head: i64 = find_struct_fields(sname);
    if (field_head < 0) {
        diag_new("T-MOD-E555", "error",
            sb_cat3("struct '", sname, "' not found for import"),
            file_for_diag, ln, cl, ln, cl + 20);
        return false;
    }

    imp_fbase = slice_len(imp_fnames) as i64;
    var num_fields: i64 = collect_struct_fields(field_head);

    // 提取路径参数
    var path: string = import_path_arg(vn.nb);
    if (path == "") {
        diag_new("T-MOD-E555", "error",
            "import_csv/import_json requires a string literal path argument",
            file_for_diag, ln, cl, ln, cl + 20);
        return false;
    }

    // 解析路径（相对源文件目录）
    var dir: string = "";
    var slash: i64 = -1;
    var pl: u64 = str_len(g_file);
    var pi: u64 = 0;
    while (pi < pl) {
        var ch: u8 = g_file[pi];
        if (ch == 47 || ch == 92) { slash = pi as i64; }
        pi = pi + 1;
    }
    if (slash >= 0) {
        dir = str_slice(g_file, 0, slash + 1);
    }
    var full_path: string = sb_cat2(dir, path);

    // 存在性检查
    if (file_exists(full_path) == false) {
        diag_new("T-MOD-E552", "error",
            sb_cat3("import: file not found: ", full_path, ""),
            file_for_diag, ln, cl, ln, cl + 20);
        return false;
    }

    // 读文件
    var content: string = file_read_all(full_path);

    // 解析
    var rows: []string;
    var is_csv: bool;
    if (imp_kind == "csv") {
        // CSV 首行是表头，后续按 is_csv 跳过
        is_csv = true;
        rows = csv_parse(content);
    } else {
        // JSON 已按字段序归一化，无表头行
        is_csv = false;
        rows = json_parse(content, num_fields);
    }

    if (slice_len(rows) as i64 == 0) {
        diag_new("T-MOD-E552", "error",
            sb_cat3("import: file is empty: ", full_path, ""),
            file_for_diag, ln, cl, ln, cl + 20);
        return false;
    }

    // CSV: 验证表头
    if (imp_kind == "csv") {
        var header: string = rows[0];
        var hi: i64 = 0;
        while (hi < num_fields) {
            var hval: string = csv_col(header, hi);
            if (hval != imp_fnames[(imp_fbase + hi) as u64]) {
                diag_new("T-MOD-E553", "error",
                    sb_cat5("CSV header column ", i2s(hi), ": expected '", imp_fnames[(imp_fbase + hi) as u64], "'"),
                    file_for_diag, ln, cl, ln, cl + 20);
                return false;
            }
            hi = hi + 1;
        }
    }

    // 值域校验
    var nrows: i64 = slice_len(rows) as i64;
    var ri2: i64 = 0;
    if (is_csv) { ri2 = 1; }
    while (ri2 < nrows) {
        var row2: string = rows[ri2];
        var ci2: i64 = 0;
        while (ci2 < num_fields) {
            var val2: string = csv_col(row2, ci2);
            var ftype2: string = imp_ftypes[(imp_fbase + ci2) as u64];
            if (validate_scalar_value(val2, ftype2, ri2, ci2) == false) {
                diag_new("T-MOD-E554", "error",
                    sb_cat5("import: row ", i2s(ri2), " col ", i2s(ci2), ": invalid value for type"),
                    file_for_diag, ln, cl, ln, cl + 20);
                return false;
            }
            ci2 = ci2 + 1;
        }
        ri2 = ri2 + 1;
    }

    // 合成加载函数
    var loader_fn: i64 = synthesize_loader(sname, rows, rows[0], num_fields, is_csv);

    // 替换原 init 为对加载函数的调用
    var new_call: i64 = mk_call(mk_ident(sb_cat2("__import_", i2s(g_imp_counter - 1)), -1), -1, -1);
    var nn: Node = nodes[var_idx];
    nn.nb = new_call;
    slice_set(nodes, var_idx, nn);

    return true;
}

// 遍历函数体语句链表，检测 import 脱糖点
fn desugar_stmts(stmt_head: i64, file_for_diag: string) void {
    var c: i64 = stmt_head;
    while (c >= 0) {
        var k: Child = kids[c];
        var s: Node = nodes[k.val];
        if (s.kind == "var_decl") {
            desugar_one(k.val, file_for_diag, s.ln, s.cl);
        }
        // 残存的 import 调用（不在 var 初始化位置）→ T_IMPORT_CONTEXT
        if (s.kind == "expr") {
            if (is_import_call(s.na) != "") {
                diag_new("T-MOD-E555", "error",
                    "import_csv/import_json is only allowed as a var initializer",
                    file_for_diag, s.ln, s.cl, s.ln, s.cl + 20);
            }
        }
        // 递归 if/while/for/block 体
        if (s.kind == "if") {
            desugar_stmts(s.la, file_for_diag);
            if (s.lb > -2) { desugar_stmts(s.lb, file_for_diag); }
        }
        if (s.kind == "while" || s.kind == "block") {
            desugar_stmts(s.la, file_for_diag);
        }
        if (s.kind == "for") {
            desugar_stmts(s.la, file_for_diag);
        }
        c = k.next;
    }
}

fn desugar_imports() void {
    g_imp_counter = 0;
    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = decl_list[i];
        var dn: Node = nodes[d];
        if (dn.kind == "FuncDecl" && dn.lc != -2) {
            desugar_stmts(dn.lc, n_file(d));
        }
        i = i + 1;
    }
}

// ── 模块系统：whole-program 内联解析 ──────────────────────────

// 取路径的目录部分（兼容 / 与 \）
fn mod_dir_of(p: string) string {
    var n: u64 = str_len(p);
    var i: u64 = n;
    while (i > 0) {
        i = i - 1;
        var c: u8 = p[i];
        if (c == 47 || c == 92) {
            return str_slice(p, 0, i);
        }
    }
    return ".";
}

// 取父目录（纯字符串，不依赖 _fullpath；盘符根/无分隔符返回 "" 表示已到顶）。
// 兼容 / 与 \；先剥除末尾分隔符，避免 "C:/" 被误判；用于 import 源码根向上遍历，
// 杜绝 _fullpath 把 "C:" 展开为「C 盘当前目录」导致的 C:/ <-> C:/Users/... 震荡 OOM。
fn parent_dir_of(p: string) string {
    var n: u64 = str_len(p);
    if (n == 0) { return ""; }
    var end: u64 = n;
    while (end > 0) {
        var c: u8 = p[end - 1];
        if (c == 47 || c == 92) { end = end - 1; } else { break; }
    }
    if (end == 0) { return ""; }
    var i: u64 = end;
    while (i > 0) {
        i = i - 1;
        var c: u8 = p[i];
        if (c == 47 || c == 92) {
            if (i == 0) { return ""; }   // 形如 /foo 的 unix 绝对路径，无更上层
            return str_slice(p, 0, i);
        }
    }
    return "";   // 无分隔符（如 C: 或裸名）
}

fn in_mod_aliases(sa: string) bool {
    var n: i64 = slice_len(g_mod_aliases) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (g_mod_aliases[i] == sa) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn in_mod_visited(p: string) bool {
    var n: i64 = slice_len(g_mod_visited) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (g_mod_visited[i] == p) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// 环检测：chosen 是否处于「正在加载」的活跃栈中（DFS 回边即循环依赖）。
fn mod_stack_index(p: string) i64 {
    var n: i64 = slice_len(g_mod_stack) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (g_mod_stack[i] == p) { return i; }
        i = i + 1;
    }
    return -1;
}

fn mod_stack_push(p: string, a: string) void {
    append(g_mod_stack, p);
    append(g_mod_stack_alias, a);
}

// 弹出切片最后一个元素（t 无原生 pop；import 深度极小，O(n) 截断可接受）。
fn slice_pop_str(s: []string) []string {
    var n: i64 = slice_len(s) as i64;
    var out: []string;
    var i: i64 = 0;
    while (i < n - 1) {
        append(out, s[i]);
        i = i + 1;
    }
    return out;
}

fn mod_alias_add(nm: string, alias: string) void {
    if (alias == "") {
        if (in_mod_aliases(nm) == false) {
            append(g_mod_aliases, nm);
        }
    } else {
        if (in_mod_aliases(alias) == false) {
            append(g_mod_aliases, alias);
        }
    }
}

// 把模块文件解析为顶层声明，追加进 decl_list。
// 其内嵌的 import 在此就地递归解析（内联），不会以 ImportModDecl 形式残留。
// provenance：解析本模块期间把 g_cur_mod 置为模块别名，使模块内所有节点（含函数体/类型）
// 都记录所属模块，供后续名字重整（mangling）做模块内引用改写；入口模块别名 = ""。
fn load_module_file(path: string, alias: string) void {
    var saved_pos: i64 = pos;                 // 保存调用方的 token 流位置（支持嵌套 import 透明返回）
    var saved_mod: string = g_cur_mod;        // 进入模块前的上下文（入口="" 或外层库别名），用于嵌套 import 正确回溯
    var base: i64 = slice_len(toks) as i64;   // 模块 token 将从此下标开始（tokenize 是 append 语义）
    var msrc: string = file_read_all(path);
    tokenize(msrc);                           // 追加在入口/父模块 token 之后
    pos = base;                               // 从本模块起点解析，而非 0（否则会重解析入口文件）
    g_cur_mod = alias;                        // 进入模块：标记 provenance
    while (cur_t() != "Eof") {
        if (cur_t() == "Semicolon") {
            advance_i();
            continue;
        }
        var d: i64 = parse_declaration();
        if (d < 0) {
            continue;
        }
        if (nodes[d].kind == "ImportModDecl") {
            // 嵌套 import：就地递归解析，不加入 decl_list（统一相对候选源码根/搜索路径）
            handle_one_import(d);
        } else {
            append(decl_list, d);
        }
        // struct 方法脱糖出的自由函数同样要并入模块 decl_list（provenance 已是本模块别名）
        flush_struct_methods();
    }
    g_cur_mod = saved_mod;                    // 离开模块：恢复调用方上下文（支持库内嵌套 import 正确回溯）
    pos = saved_pos;                          // 恢复调用方（入口或父模块）的解析位置
}

// 登记一条 import 声明上挂着的 `::` 选择性导入项（含通配 `*`）。
// owner 取该 import 节点的 provenance —— 入口为 ""，库内嵌套 import 为该库别名，
// 因此选择性绑定严格局限在「写下这条 import 的那个模块」内，不会外泄。
fn sel_register(imp: i64, alias: string) void {
    var owner: string = g_node_mod[imp];
    var c: i64 = nodes[imp].lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var it: Node = nodes[k.val];
        append(g_sel_owner, owner);
        append(g_sel_local, it.sb);
        append(g_sel_mod, alias);
        append(g_sel_orig, it.sa);
        append(g_sel_wild, it.ba);
        append(g_sel_at, k.val);
        c = k.next;
    }
}

// 解析单个 import 声明：定位模块文件 → 去重/环检测 → 内联加载
fn handle_one_import(imp: i64) void {
    var nm: string = nodes[imp].sb;
    var user_alias: string = nodes[imp].sc;
    if (nodes[imp].bc) {
        fc_err("T-MOD-E556", "export 不能修饰 import 声明", imp);
        return;
    }
    // `import(src)` / `import(src.)`：剥离首段后为空路径。
    if (nm == "") {
        fc_err("T-MOD-E559",
            "import 路径为空：`src` 后需给出模块名，如 `import(src.foo);`", imp);
        return;
    }
    // 限定访问前缀 = 模块名最后一段（Go 风格）：import(src.d.e) 以 e.foo() 调用；
    // 用户显式 as 优先。该别名同时是名字重整（mangling）的命名空间。
    var alias: string = user_alias;
    if (alias == "") { alias = last_segment(nm); }
    mod_alias_add(nm, alias);

    // 库导入（路径首段非 src）：走库搜索路径（入口/lib、工程根/lib、out/lib 预编译缓存），
    // 命中 .tc 源码则内联（名字重整后即为命名空间隔离）；若同时命中 .tlib 预编译产物则走外链模式。
    var chosen: string = "";
    if (nodes[imp].bd) {
        chosen = resolve_external_lib(nm);
        if (chosen == "") {
            fc_err("T-MOD-E550",
                sb_cat3("库 '", nm, "' 无法解析：未在本工程 lib/ 或依赖库搜索路径下找到对应 .tc 文件"), imp);
            return;
        }
    } else {
        // `src.` 导入统一相对候选源码根解析；'.' 即路径分隔符：import(src.d.e) => <root>/src/d/e.tc
        var rel: string = dots_to_slashes(nm);
        var i: i64 = 0;
        var nr: i64 = slice_len(g_src_roots) as i64;
        while (i < nr) {
            var cand: string = path_resolve(sb_cat4(g_src_roots[i], "/", rel, ".tc"));
            if (path_exists(cand)) { chosen = cand; break; }
            i = i + 1;
        }
        if (chosen == "") {
            fc_err("T-MOD-E550",
                sb_cat3("模块 'src.", nm, "' 无法解析：未在任何源码根下找到对应 .tc 文件"), imp);
            return;
        }
    }
    // 选择性导入（`:: a, b as c` / `:: *`）登记。必须在钻石去重 return 之前：
    // 同一模块被多处导入时，每个导入点的 `::` 绑定都要生效。
    sel_register(imp, alias);
    // 环检测：chosen 已在活跃加载栈 → 循环依赖（import 不能成环）。
    var ci: i64 = mod_stack_index(chosen);
    if (ci >= 0) {
        var csb: StringBuilder = sb_new();
        var k: i64 = 0;
        var m: i64 = slice_len(g_mod_stack) as i64;
        while (k < m) {
            if (k > 0) { sb_append_str(csb, " -> "); }
            sb_append_str(csb, g_mod_stack_alias[k]);
            k = k + 1;
        }
        sb_append_str(csb, " -> ");
        sb_append_str(csb, alias);
        fc_err("T-MOD-E551",
            sb_cat3("检测到循环依赖：", sb_to_str(csb),
                "（import 不能成环，请抽公共模块或改用运行时依赖注入）"), imp);
        return;
    }
    // 链接模式探测：存在 .tlib 预编译产物且未用 as 别名（归档按规范名构建，as 别名会错配）→ 外链。
    // 库源码仍载入供类型检查，但导出符号改发 declare、私有跳过，归档在链接期并入（真·独立编译+链接）。
    var ar: string = "";
    if (nodes[imp].bd && user_alias == "" && in_mod_visited(chosen) == false) {
        ar = resolve_external_lib_archive(nm);
    }
    // 记录依赖图边（父 -> 子），供 --emit-deps 输出（父 = 当前活跃栈顶）。
    // 放在钻石去重 return 之前：重导入（如菱形共享根）也需记录边，否则依赖图缺失。
    var dep_parent: string = "<entry>";
    var dep_stn: i64 = slice_len(g_mod_stack_alias) as i64;
    if (dep_stn > 0) { dep_parent = g_mod_stack_alias[dep_stn - 1]; }
    append(g_dep_from, dep_parent);
    append(g_dep_to, alias);
    // 钻石依赖：已完整加载过则跳过（不报错，避免重复定义）。
    if (in_mod_visited(chosen)) {
        return;
    }
    append(g_mod_visited, chosen);
    mod_stack_push(chosen, alias);            // 进入：压栈
    load_module_file(chosen, alias);
    g_mod_stack = slice_pop_str(g_mod_stack);          // 离开：弹栈
    g_mod_stack_alias = slice_pop_str(g_mod_stack_alias);
    if (ar != "") {
        append(g_link_libs, alias);
        append(g_ext_link, ar);
    }
}

// 外部库搜索路径解析：返回命中路径（"" = 未找到）。
// 搜索顺序：工程根/lib（逐个祖先含 tote.toml 者）、入口目录自身 lib、~/.tote/libs、编译器/libs。
// 每个搜索目录下的候选：<name>.tc > <name>/index.tc > <name>/lib.tc。
// （.tlib 预编译外链在 Phase2 接入；T_LIB_PATH 环境变量亦在 Phase2 纳入。）
fn resolve_external_lib(nm: string) string {
    var rel: string = dots_to_slashes(nm);
    var dirs: []string = g_lib_dirs;          // compute_lib_dirs 已填充
    var i: i64 = 0;
    var nd: i64 = slice_len(dirs) as i64;
    while (i < nd) {
        var base: string = dirs[i];
        var c_tc: string = path_resolve(sb_cat4(base, "/", rel, ".tc"));
        if (path_exists(c_tc)) { return c_tc; }
        var c_idx: string = path_resolve(sb_cat4(base, "/", rel, "/index.tc"));
        if (path_exists(c_idx)) { return c_idx; }
        var c_lib: string = path_resolve(sb_cat4(base, "/", rel, "/lib.tc"));
        if (path_exists(c_lib)) { return c_lib; }
        i = i + 1;
    }
    return "";
}

// 外部库预编译产物解析（Phase2 真·独立编译+链接）：返回 <libdir>/<rel>.tlib
// （即重命名的 LLVM 归档 .a）路径，未找到返回 ""。命中即走外链模式（不再内联源码定义）。
fn resolve_external_lib_archive(nm: string) string {
    var rel: string = dots_to_slashes(nm);
    var dirs: []string = g_lib_dirs;
    var i: i64 = 0;
    var nd: i64 = slice_len(dirs) as i64;
    while (i < nd) {
        // --debug-libs：优先链接调试态归档 .tlibd（带 -O0 -gcodeview），缺失则回退 .tlib
        if (g_debug_libs) {
            var ar_d: string = path_resolve(sb_cat4(dirs[i], "/", rel, ".tlibd"));
            if (path_exists(ar_d)) { return ar_d; }
        }
        var ar: string = path_resolve(sb_cat4(dirs[i], "/", rel, ".tlib"));
        if (path_exists(ar)) { return ar; }
        i = i + 1;
    }
    return "";
}

// 追加一个「<base>/<sub>」搜索目录（LLVM 后端不支持 sb_cat2..6，故走 StringBuilder）。
fn lib_dir_push(base: string, sub: string) void {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, base);
    sb_append_str(sb, "/");
    sb_append_str(sb, sub);
    append(g_lib_dirs, sb_to_str(sb));
}

// 计算外部库搜索目录（在 compute_src_roots 之后调用，复用祖先工程根信息）。
// 顺序 = 就近优先（与 node_modules 式解析一致）：
//  1) 入口目录/lib、入口目录/libs（单文件与示例就近放库）；
//  2) 各祖先含 tote.toml 的工程根 <root>/lib、<root>/libs（最近祖先优先）。
// 注：g_src_roots[0] 是「入口目录兜底」而非 <root>/src，不能对它取 parent 推工程根，
//     否则会把入口的父目录误当工程根（examples/ → 仓库根）。故从下标 1 起遍历。
// 注：环境变量 T_LIB_PATH 与 ~/.tote/libs 需要 getenv 内建支持，留待 Phase2。
fn compute_lib_dirs() void {
    var entry_dir: string = path_resolve(mod_dir_of(g_file));
    lib_dir_push(entry_dir, "lib");
    lib_dir_push(entry_dir, "libs");
    var i: i64 = 1;                             // 跳过 [0]（入口目录兜底根）
    var n: i64 = slice_len(g_src_roots) as i64;
    while (i < n) {
        var root: string = parent_dir_of(g_src_roots[i]);   // g_src_roots[i] = <root>/src
        lib_dir_push(root, "lib");
        lib_dir_push(root, "libs");
        i = i + 1;
    }
    // 预编译产物缓存目录（build --lib 把 .tlib 落在 out/lib/）：就近优先于一切源码搜索，
    // 命中即走外链模式（真·独立编译+链接）；缺失则回退源码内联（安全网，不破坏既有内联行为）。
    lib_dir_push("out", "lib");
}

// 候选源码根列表（按优先级）：入口目录兜底 + 各祖先工程根/src（最近优先）。
// import 解析时依序尝试每个候选根下的 <rel>.tc，首个命中即采用。
// 这样既满足「工程根/src」约定（用户规范），又不破坏扁平/示例项目（入口目录兜底）。
var g_src_roots: []string;

// 计算候选源码根：
//  1) 入口文件所在目录（兜底，等同旧的「相对导入方」，保证扁平/示例/老项目可用）；
//  2) 从入口目录向上遍历祖先目录，凡是含 tote.toml 者，其 src 子目录即候选源码根
//     （<工程根>/src 约定，最近祖先优先），版本钉由 tote.toml 负责。
// path_exists 现已改用稳健的 file_exists 内建（不再走 sys_run 外 shell，消除 arena OOM），
// 故向上遍历在绝对路径下也安全。
fn compute_src_roots() void {
    var roots: []string;
    // 入口目录兜底（仅此处用一次 path_resolve 规范化，已知安全）。
    var entry_dir: string = path_resolve(mod_dir_of(g_file));
    append(roots, entry_dir);
    // 从入口目录向上遍历祖先，凡是含 tote.toml 者，其 src 子目录即候选源码根。
    // 循环内只用纯字符串 parent_dir_of（不碰 _fullpath），并设硬上限，杜绝震荡 OOM。
    // 拼接走 StringBuilder（LLVM 后端不支持 sb_cat2..6，故不用 sb_cat2）。
    var cur: string = entry_dir;
    var guard: i64 = 0;
    while (guard < 32) {
        guard = guard + 1;
        var parent: string = parent_dir_of(cur);
        if (parent == "" || parent == cur) { break; }
        cur = parent;
        var sb: StringBuilder = sb_new();
        sb_append_str(sb, cur);
        sb_append_str(sb, "/tote.toml");
        var toml: string = sb_to_str(sb);
        if (path_exists(toml)) {
            var sb2: StringBuilder = sb_new();
            sb_append_str(sb2, cur);
            sb_append_str(sb2, "/src");
            append(roots, sb_to_str(sb2));
        }
    }
    g_src_roots = roots;
}



// 取模块名最后一段作为限定访问前缀（Go 风格：import(src.d.e) 以 e.foo() 调用）。
fn last_segment(s: string) string {
    var n: u64 = str_len(s);
    var i: u64 = n;
    while (i > 0) {
        i = i - 1;
        var c: u8 = s[i];
        if (c == 46 || c == 47 || c == 92) {
            return str_slice(s, i + 1, n);
        }
    }
    return s;
}

// 模块名中的 '.' 转为路径分隔符：d.e -> d/e（用于拼接 .tc 路径）。
fn dots_to_slashes(s: string) string {
    var n: u64 = str_len(s);
    var sb: StringBuilder = sb_new();
    var i: u64 = 0;
    while (i < n) {
        var c: u8 = s[i];
        if (c == 46) { sb_append_char(sb, 47); }
        else { sb_append_char(sb, c); }
        i = i + 1;
    }
    return sb_to_str(sb);
}

// 输出模块依赖图（JSON）：每条 import 边（父 -> 子）一行，供 tote deps / 工具消费。
// 环检测已先行；若存在循环依赖，边中会包含回边，可一眼看出环。
fn emit_deps() void {
    var out: StringBuilder = sb_new();
    sb_append_str(out, "{\"entry\":\"");
    json_escape_into(out, g_file);
    sb_append_str(out, "\",\"edges\":[");
    var first: bool = true;
    var ne: i64 = slice_len(g_dep_from) as i64;
    var e: i64 = 0;
    while (e < ne) {
        if (first == false) { sb_append_str(out, ","); }
        first = false;
        sb_append_str(out, "{\"from\":\"");
        json_escape_into(out, g_dep_from[e]);
        sb_append_str(out, "\",\"to\":\"");
        json_escape_into(out, g_dep_to[e]);
        sb_append_char(out, 34);
        sb_append_char(out, 125);
        e = e + 1;
    }
    sb_append_str(out, "]}\n");
    print(sb_to_str(out));
}
// 顶层入口：内联所有 import，并构建模块别名集合。
// ImportModDecl 节点留在 decl_list 中无害（register/emit 均对其忽略）。
fn resolve_modules() void {
    compute_src_roots();
    compute_lib_dirs();
    mod_stack_push(g_file, "<entry>");      // 入口作依赖图根：使「入口↔模块」成环也能被检出
    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = decl_list[i];
        if (nodes[d].kind == "ImportModDecl") {
            handle_one_import(d);
        }
        i = i + 1;
    }
    g_mod_stack = slice_pop_str(g_mod_stack);
    g_mod_stack_alias = slice_pop_str(g_mod_stack_alias);
}

// ── 模块命名空间隔离（名字重整 / mangling）─────────────────────
//
// 目标：两个库各自定义 `foo` 不再相撞。做法是把**被导入模块**（别名 A）的顶层符号
// 统一重整为 `A__foo`；入口模块（别名 ""）永不重整，因此单文件程序的 IR 逐字节不变。
//
//  · 定义处：模块内顶层声明 sa → A__sa；
//  · 模块内引用：provenance 属于 A 的 ident/named/struct_lit/var_decl/P，
//    若名字命中 A 的顶层符号集，一并改写（局部同名变量也一起改，保持自洽）；
//  · 限定访问：`A.sym` → ident `A__sym`；类型位置 `A.T` / 字面量 `A.T{}` 同理，
//    并做 export 可见性校验（模块若含任一 export，则未 export 的符号跨模块不可见）。
//
// 「纯类型声明」节点：注册时只把名字入符号表，不解析任何其它类型 ⇒ 可无序先注册。
// typealias 不算（它要 resolve_ti 目标类型，须等这批入表后再跑）。
fn is_type_decl_node(d: i64) bool {
    if (d < 0) { return false; }
    var k: string = nodes[d].kind;
    if (k == "StructDecl" || k == "EnumDecl" || k == "FlagDecl") { return true; }
    if (k == "FlagSetDecl" || k == "UnionDecl" || k == "VariantDecl") { return true; }
    return false;
}

// 顶层可重整的声明 kind。
fn is_top_decl_kind(k: string) bool {
    if (k == "FuncDecl" || k == "StructDecl" || k == "EnumDecl") { return true; }
    if (k == "FlagDecl" || k == "FlagSetDecl" || k == "UnionDecl") { return true; }
    if (k == "VariantDecl" || k == "GlobalVarDecl") { return true; }
    if (k == "GlobalConstDecl" || k == "TypeAliasDecl") { return true; }
    return false;
}

// 重整名：A + "__" + name（LLVM 后端不支持 sb_cat2..6，故走 StringBuilder）。
fn mangled_name(alias: string, name: string) string {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, alias);
    sb_append_str(sb, "__");
    sb_append_str(sb, name);
    return sb_to_str(sb);
}

// 在符号表 g_def_* 中查 (alias, name)，返回下标，未命中 -1。
fn def_lookup(alias: string, name: string) i64 {
    var n: i64 = slice_len(g_def_orig) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (g_def_alias[i] == alias) {
            if (g_def_orig[i] == name) { return i; }
        }
        i = i + 1;
    }
    return -1;
}

// 该模块是否至少含一个 export 声明（含 → 未 export 者为私有）。
fn mod_has_export(alias: string) bool {
    var n: i64 = slice_len(g_mod_has_export) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (g_mod_has_export[i] == alias) { return true; }
        i = i + 1;
    }
    return false;
}

fn def_add(alias: string, name: string, exported: bool) void {
    if (def_lookup(alias, name) >= 0) { return; }
    append(g_def_orig, name);
    append(g_def_alias, alias);
    append(g_def_export, exported);
}

// Variant 的合成辅助函数（Name_from_C / Name_is_C / Name_as_C）也要进符号集，
// 否则模块内 `V_from_C(...)` 这类裸调用不会被重整，而定义侧却由已重整的 sa 派生。
fn collect_variant_helper_defs(d: i64, alias: string, exported: bool) void {
    var n: Node = nodes[d];
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var vc: Node = nodes[k.val];
        def_add(alias, sb_cat3(n.sa, "_from_", vc.sa), exported);
        def_add(alias, sb_cat3(n.sa, "_is_", vc.sa), exported);
        if (vc.na >= 0) { def_add(alias, sb_cat3(n.sa, "_as_", vc.sa), exported); }
        c = k.next;
    }
}

// 扫描 decl_list，收集所有「来自被导入模块」的顶层符号。
fn collect_module_defs() void {
    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = decl_list[i];
        var a: string = g_node_mod[d];
        if (a != "") {
            var nd: Node = nodes[d];
            if (is_top_decl_kind(nd.kind)) {
                def_add(a, nd.sa, nd.bc);
                if (nd.bc) {
                    if (mod_has_export(a) == false) { append(g_mod_has_export, a); }
                }
                if (nd.kind == "VariantDecl") { collect_variant_helper_defs(d, a, nd.bc); }
            }
        }
        i = i + 1;
    }
}

// 可见性校验：模块 A 含 export 时，未 export 的符号不得跨模块访问。
fn check_mod_visible(alias: string, name: string, di: i64, at: i64) void {
    if (mod_has_export(alias) == false) { return; }
    if (g_def_export[di]) { return; }
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "符号 '");
    sb_append_str(sb, name);
    sb_append_str(sb, "' 是模块 '");
    sb_append_str(sb, alias);
    sb_append_str(sb, "' 的私有符号（未用 export 标记），不可跨模块访问");
    fc_err("T-MOD-E558", sb_to_str(sb), at);
}

// 未知限定符号诊断。
fn err_no_symbol(alias: string, name: string, at: i64) void {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "模块 '");
    sb_append_str(sb, alias);
    sb_append_str(sb, "' 中不存在顶层符号 '");
    sb_append_str(sb, name);
    sb_append_str(sb, "'");
    fc_err("T-MOD-E557", sb_to_str(sb), at);
}

// ── 选择性导入（`::` 列表）绑定 ─────────────────────────────────
// 语义：`import(std.math :: max, min as mn);` 使导入方作用域内的裸名 `max` / `mn`
// 直接等价于 `math.max` / `math.min`，即重整名 `math__max` / `math__min`。
// 实现方式与 Pass 2 同构：按 provenance 就地改写名字，无需引入新的作用域机制。

// 入口模块（provenance ""）是否已有同名顶层声明 —— 选择性导入撞名检测用。
// （g_def_* 只收录 alias != "" 的模块符号，入口符号需单独扫 decl_list。）
fn entry_has_top(name: string) bool {
    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = decl_list[i];
        if (g_node_mod[d] == "") {
            if (is_top_decl_kind(nodes[d].kind)) {
                if (nodes[d].sa == name) { return true; }
            }
        }
        i = i + 1;
    }
    return false;
}

// 把 `:: *` 通配项展开成逐个具名项。模块若含任一 export，则只展开 export 符号；
// 否则展开其全部顶层符号（与 check_mod_visible 的可见性口径一致）。
fn sel_expand_wildcards() void {
    var ns: i64 = slice_len(g_sel_local) as i64;   // 先取长度：展开产生的新项不再参与本轮
    var s: i64 = 0;
    while (s < ns) {
        if (g_sel_wild[s]) {
            var m: string = g_sel_mod[s];
            var only_exp: bool = mod_has_export(m);
            var nd: i64 = slice_len(g_def_orig) as i64;
            var d: i64 = 0;
            while (d < nd) {
                var take: bool = false;
                if (g_def_alias[d] == m) {
                    take = true;
                    if (only_exp) {
                        if (g_def_export[d] == false) { take = false; }
                    }
                }
                if (take) {
                    append(g_sel_owner, g_sel_owner[s]);
                    append(g_sel_local, g_def_orig[d]);
                    append(g_sel_mod, m);
                    append(g_sel_orig, g_def_orig[d]);
                    append(g_sel_wild, false);
                    append(g_sel_at, g_sel_at[s]);
                }
                d = d + 1;
            }
        }
        s = s + 1;
    }
}

// 查 (owner, 本地名) → 选择性导入表下标；未命中 -1。通配占位项不参与查找。
fn sel_lookup(owner: string, name: string) i64 {
    var n: i64 = slice_len(g_sel_local) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (g_sel_wild[i] == false) {
            if (g_sel_owner[i] == owner) {
                if (g_sel_local[i] == name) { return i; }
            }
        }
        i = i + 1;
    }
    return -1;
}

// 撞名诊断：本地名与导入方自身顶层符号、或与另一条选择性导入冲突。
fn err_sel_conflict(local: string, what: string, at: i64) void {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "选择性导入的名字 '");
    sb_append_str(sb, local);
    sb_append_str(sb, "' 与");
    sb_append_str(sb, what);
    sb_append_str(sb, "冲突（请用 `as` 改名，或改用限定访问）");
    fc_err("T-MOD-E560", sb_to_str(sb), at);
}

// 校验每条选择性导入项：源模块中确实存在该符号、可见、且本地名不撞名。
fn sel_validate() void {
    var n: i64 = slice_len(g_sel_local) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (g_sel_wild[i] == false) {
            var di: i64 = def_lookup(g_sel_mod[i], g_sel_orig[i]);
            if (di < 0) {
                err_no_symbol(g_sel_mod[i], g_sel_orig[i], g_sel_at[i]);
            } else {
                check_mod_visible(g_sel_mod[i], g_sel_orig[i], di, g_sel_at[i]);
            }
            var clash: bool = false;
            if (g_sel_owner[i] == "") {
                clash = entry_has_top(g_sel_local[i]);
            } else {
                if (def_lookup(g_sel_owner[i], g_sel_local[i]) >= 0) { clash = true; }
            }
            if (clash) {
                err_sel_conflict(g_sel_local[i], "导入方自身的顶层声明", g_sel_at[i]);
            } else {
                // 同一导入方下，同名但来源不同的两条选择性导入 → 歧义
                var j: i64 = 0;
                while (j < i) {
                    if (g_sel_wild[j] == false && g_sel_owner[j] == g_sel_owner[i]
                        && g_sel_local[j] == g_sel_local[i]) {
                        if (g_sel_mod[j] != g_sel_mod[i] || g_sel_orig[j] != g_sel_orig[i]) {
                            err_sel_conflict(g_sel_local[i], "另一条选择性导入", g_sel_at[i]);
                            j = i;   // 同一项只报一次
                        }
                    }
                    j = j + 1;
                }
            }
        }
        i = i + 1;
    }
}

fn mangle_modules() void {
    collect_module_defs();
    var ndef: i64 = slice_len(g_def_orig) as i64;
    var tot: i64 = slice_len(nodes) as i64;

    // Pass 1：限定访问 `A.sym` / 类型 `A.T` / 字面量 `A.T{}` → 重整名（必须先于 Pass 2，
    // 否则模块内写 `B.T` 会被 Pass 2 当成本模块的 T 误重整）。
    var i: i64 = 0;
    while (i < tot) {
        var nd: Node = nodes[i];
        if (nd.kind == "member" && nd.na >= 0) {
            var ob: Node = nodes[nd.na];
            if (ob.kind == "ident" && in_mod_aliases(ob.sa)) {
                var di: i64 = def_lookup(ob.sa, nd.sa);
                if (di >= 0) {
                    check_mod_visible(ob.sa, nd.sa, di, i);
                    nd.sa = mangled_name(ob.sa, nd.sa);
                    nd.kind = "ident";
                    nd.na = -1;                     // 丢弃对象（模块名）子节点
                    slice_set(nodes, i, nd);
                }
                // 未命中则保持 member 不变：同名局部/字段访问不受影响（由后续检查兜底）
            }
        } else if (nd.kind == "named" && nd.sb != "") {
            var di2: i64 = def_lookup(nd.sb, nd.sa);
            if (di2 >= 0) {
                check_mod_visible(nd.sb, nd.sa, di2, i);
                nd.sa = mangled_name(nd.sb, nd.sa);
            } else {
                err_no_symbol(nd.sb, nd.sa, i);
            }
            nd.sb = "";
            slice_set(nodes, i, nd);
        } else if (nd.kind == "struct_lit" && nd.sb != "") {
            var di3: i64 = def_lookup(nd.sb, nd.sa);
            if (di3 >= 0) {
                check_mod_visible(nd.sb, nd.sa, di3, i);
                nd.sa = mangled_name(nd.sb, nd.sa);
            } else {
                err_no_symbol(nd.sb, nd.sa, i);
            }
            nd.sb = "";
            slice_set(nodes, i, nd);
        }
        i = i + 1;
    }

    // Pass 2：按 provenance 重整模块自身的定义与内部裸引用。
    // ndef == 0（单文件程序，无被导入模块符号）时整趟跳过 ⇒ IR 逐字节不变。
    if (ndef > 0) {
        var j: i64 = 0;
        while (j < tot) {
            var m: string = g_node_mod[j];
            if (m != "") {
                var n2: Node = nodes[j];
                var k: string = n2.kind;
                var hit: bool = false;
                if (k == "ident" || k == "named" || k == "struct_lit") { hit = true; }
                if (k == "var_decl" || k == "P") { hit = true; }
                if (is_top_decl_kind(k)) { hit = true; }
                if (hit) {
                    if (def_lookup(m, n2.sa) >= 0) {
                        n2.sa = mangled_name(m, n2.sa);
                        slice_set(nodes, j, n2);
                    }
                }
            }
            j = j + 1;
        }
    }

    // Pass 3：选择性导入（`::` 列表）。先展开通配、校验，再按 provenance 把导入方
    // 作用域内的裸名改写成 `模块__原名`。顶层声明本身不改（撞名已在 sel_validate 报错）。
    // 注意与 Pass 2 互不重叠：Pass 2 只改「导入方自己定义了该名字」的情形，而那恰是
    // sel_validate 判定的冲突，正常路径下两趟不会碰同一个节点。
    if ((slice_len(g_sel_local) as i64) > 0) {
        sel_expand_wildcards();
        sel_validate();
        var p: i64 = 0;
        while (p < tot) {
            var n3: Node = nodes[p];
            var k3: string = n3.kind;
            var hit3: bool = false;
            if (k3 == "ident" || k3 == "named" || k3 == "struct_lit") { hit3 = true; }
            if (k3 == "var_decl" || k3 == "P") { hit3 = true; }
            if (hit3) {
                var si: i64 = sel_lookup(g_node_mod[p], n3.sa);
                if (si >= 0) {
                    n3.sa = mangled_name(g_sel_mod[si], g_sel_orig[si]);
                    slice_set(nodes, p, n3);
                }
            }
            p = p + 1;
        }
    }
}

// ── check 主流程（复刻 checker.ts:83）─────────────────────────

// ══════════════════════════════════════════════════════════════
// Phase B —— CTFE 编译期求值器（meta）
// 设计：docs/meta_design.md §9 Phase B
//
// 求值结果统一以「字面量节点 id」承载（int / bool / string）：
//   ① 规避结构体按值返回的 Win64 聚合 ABI 坑；
//   ② 「折叠」退化为把字面量内容就地拷回 meta 节点 —— 无需回溯父节点重连指针。
// 支持标量：i64 整数 / bool / string。浮点暂不支持（第 7 条字节级可复现性
// 需先就浮点求值顺序定案，见 docs/meta_design.md §10）。
// ══════════════════════════════════════════════════════════════

var g_menv_name: []string;   // 编译期环境：名字（平栈）
var g_menv_val: []i64;       // 编译期环境：值（字面量节点 id）
var g_menv_ty: []i64;        // 同槽的**类型**绑定（`meta T: type` 用；-1 = 这是值绑定）
var g_menv_top: i64;         // 逻辑栈顶（只增不缩，复用底层容量）
var g_menv_base: i64;        // 当前调用帧底：查找不跨帧（禁止看到调用方局部）
var g_menv_nglobal: i64;     // 全局编译期常量区大小 [0, nglobal)
var g_meta_depth: i64;       // meta 调用深度
var g_meta_steps: i64;       // 步数预算，防不终止的 meta 循环 / 递归
var g_meta_ret: i64;         // return 携带值（字面量节点 id）
var g_meta_err: bool;        // 本轮求值是否已失败（错误已报，避免刷屏）
var g_meta_quiet: bool;      // 静默：泛型模板内求值失败不报错（模板本体不发射）

// 当前正在 register/check 的泛型函数的「类型参数」名字集合（如 comptime/meta T: type）。
// resolve_ti/resolve_type_desc/deser_type_of 借此把泛型类型参数识别为「类型」而非
// 「未定义类型」，避免在模板定义期（T 尚未绑定具体类型）误报 T_UNKNOWN_TYPE。
// 仅作用于泛型模板本体，实例（T 已替换为具体类型）不受影响。
var g_gen_tparams: []string;
fn gen_tparam_has(name: string) bool {
    var i: i64 = 0;
    while (i < slice_len(g_gen_tparams)) {
        if (g_gen_tparams[i] == name) { return true; }
        i = i + 1;
    }
    return false;
}

// ── 值构造 / 读取 ────────────────────────────────────────────
fn mv_int(v: i64) i64 { return mk_int(i2s(v), 10, -1); }
fn mv_bool(b: bool) i64 { return mk_bool(b, -1); }

// 字面量节点 → i64（bool 视作 0/1）
fn mv_get_int(id: i64) i64 {
    var n: Node = nodes[id];
    if (n.kind == "bool") {
        if (n.ba) { return 1; }
        return 0;
    }
    return js_parse_int(n.sa, n.ia);
}

// ── 编译期环境 ──────────────────────────────────────────────
fn menv_push2(name: string, val: i64, ty: i64) void {
    if (g_menv_top < (slice_len(g_menv_name) as i64)) {
        slice_set(g_menv_name, g_menv_top, name);
        slice_set(g_menv_val, g_menv_top, val);
        slice_set(g_menv_ty, g_menv_top, ty);
    } else {
        append(g_menv_name, name);
        append(g_menv_val, val);
        append(g_menv_ty, ty);
    }
    g_menv_top = g_menv_top + 1;
}

fn menv_push(name: string, val: i64) void {
    menv_push2(name, val, -1);
}

// `meta T: type` 形参：槽里存的是**类型节点 id**，不是字面量。
// 取值路径（meta_eval ident）拒绝它；类型查询路径（mb_bound_type）认它。
fn menv_push_type(name: string, tn: i64) void {
    menv_push2(name, -1, tn);
}

// 查找：先当前帧 [g_menv_base, g_menv_top)，再全局常量区 [0, g_menv_nglobal)。
// 中间的调用方局部刻意不可见 —— meta fn 是纯函数，不做动态作用域。
fn menv_find(name: string) i64 {
    var i: i64 = g_menv_top;
    while (i > g_menv_base) {
        i = i - 1;
        if (g_menv_name[i] == name) { return i; }
    }
    var j: i64 = g_menv_nglobal;
    while (j > 0) {
        j = j - 1;
        if (g_menv_name[j] == name) { return j; }
    }
    return -1;
}

// ── 诊断 ────────────────────────────────────────────────────
fn meta_fail(code: string, msg: string, e: i64) i64 {
    if (g_meta_err == false) {
        g_meta_err = true;
        if (g_meta_quiet == false) { fc_err(code, msg, e); }
    }
    return -1;
}

// 整数窄化：按目标标量位宽回绕（编译期与运行期语义一致）
fn meta_int_wrap(v: i64, t: string) i64 {
    var bits: i64 = 0;
    var sgn: bool = false;
    if (t == "i8") { bits = 8; sgn = true; }
    if (t == "u8") { bits = 8; sgn = false; }
    if (t == "i16") { bits = 16; sgn = true; }
    if (t == "u16") { bits = 16; sgn = false; }
    if (t == "i32") { bits = 32; sgn = true; }
    if (t == "u32") { bits = 32; sgn = false; }
    if (t == "rune") { bits = 32; sgn = true; }
    if (bits == 0) { return v; }
    var m: i64 = (1 << bits) - 1;
    var r: i64 = v & m;
    if (sgn) {
        var hi: i64 = 1 << (bits - 1);
        if ((r & hi) != 0) { r = r - (m + 1); }
    }
    return r;
}

fn meta_is_int_type(t: string) bool {
    if (t == "i8" || t == "i16" || t == "i32" || t == "i64") { return true; }
    if (t == "u8" || t == "u16" || t == "u32" || t == "u64") { return true; }
    if (t == "rune") { return true; }
    return false;
}

// ── 表达式求值：返回字面量节点 id，失败返回 -1 ────────────────
fn meta_eval(e: i64) i64 {
    if (e < 0) { return -1; }
    if (g_meta_err) { return -1; }
    g_meta_steps = g_meta_steps - 1;
    if (g_meta_steps <= 0) {
        return meta_fail("T-MTA-E612",
            "编译期求值步数超预算（疑似不终止的 meta 循环或递归）", e);
    }
    var n: Node = nodes[e];
    if (n.kind == "int" || n.kind == "string" || n.kind == "bool") { return e; }
    // P5: 浮点字面量即编译期值——与 int/bool/string 同款，值以 `sa` 文本承载。
    //     变体 f64 载荷因此可直通构造/提取；浮点算术/比较留待 Phase B.2。
    if (n.kind == "float") { return e; }
    if (n.kind == "paren" || n.kind == "comptime") { return meta_eval(n.na); }
    if (n.kind == "ident") {
        var si: i64 = menv_find(n.sa);
        if (si < 0) {
            // P4 类型即值：裸类型名作为编译期值（如 `return i64;` / `return Point;`）。
            if (is_type_name(n.sa)) {
                return type_node_from_ident(n.sa);
            }
        // T-CLO-E781：逃逸 meta fn 自身实体到运行期（如 `meta pure` 取函数本身而非返回值）
        // 应被明确拒绝，而非误报「读运行期变量」。
        var sfn: i64 = sym_lookup(global_scope, n.sa);
        if (sfn >= 0) {
            var syf: Sym = syms[sfn];
            if (syf.decl >= 0 && nodes[syf.decl].kind == "FuncDecl" && nodes[syf.decl].bb == true) {
                return meta_fail("T-CLO-E781",
                    sb_cat3("`", n.sa, "` 是编译期函数，不能作为运行期函数值逃逸（其函数体仅存在于编译期）"), e);
            }
            // P5 无捕获闭包逃逸：裸函数名指代一个被提升的合成 lambda（`sc == "__lambda__"`）
            // 即「无捕获闭包」的运行期值。它本就是顶层 FuncDecl，两个后端都会经 clos_decl_of /
            // llfn_find 把它当函数值处理（&__tclos_x / @t.clos.x），直接把这个 ident 作为运行期
            // 函数值返回即可——无需套 closure_make（那需要 env 结构，而「无捕获」合成函数没有 env，
            // 套上去反而让 LLVM/C 后端生成空 env 结构而崩）。
            if (syf.decl >= 0 && nodes[syf.decl].kind == "FuncDecl" && nodes[syf.decl].sc == "__lambda__") {
                return e;
            }
        }
        return meta_fail("T-MTA-E620",
            sb_cat3("`", n.sa, "` 不是编译期已知实体（meta 上下文禁止读运行期变量）"), e);
        }
        if (g_menv_ty[si] >= 0) {
            return meta_fail("T-MTA-E608",
                sb_cat3("`", n.sa, "` 是类型参数，不能当值用（可用 `@type_name` / `@type_size` 查询）"), e);
        }
        return g_menv_val[si];
    }
    if (n.kind == "unary") { return meta_eval_unary(e); }
    if (n.kind == "binary") { return meta_eval_binary(e); }
    if (n.kind == "cast") {
        var cv: i64 = meta_eval(n.na);
        if (cv < 0) { return -1; }
        var tn0: Node = nodes[n.nb];
        if (tn0.kind != "scalar") {
            return meta_fail("T-MTA-E617", "编译期类型转换仅支持标量目标类型", e);
        }
        var cvn: Node = nodes[cv];
        var tname: string = tn0.sa;
        // 目标：浮点
        if (tname == "f64" || tname == "f32") {
            if (cvn.kind == "float") { return cv; }
            if (cvn.kind == "int" || cvn.kind == "bool") {
                return mk_float(meta_f64_to_str(mv_get_int(cv) as f64), -1);
            }
            return meta_fail("T-MTA-E617",
                "编译期向浮点的转换操作数须为 int / bool / float", e);
        }
        // 目标：bool
        if (tname == "bool") {
            if (cvn.kind != "bool") {
                return meta_fail("T-MTA-E617", "编译期不支持向 bool 的隐式窄化", e);
            }
            return cv;
        }
        // 目标：整数
        if (meta_is_int_type(tname) == false) {
            return meta_fail("T-MTA-E617",
                sb_cat3("编译期类型转换暂不支持目标类型 `", tname, "`"), e);
        }
        if (cvn.kind == "int") { return mv_int(meta_int_wrap(mv_get_int(cv), tname)); }
        if (cvn.kind == "bool") { return mv_int(meta_int_wrap(mv_get_int(cv), tname)); }
        if (cvn.kind == "float") {
            return mv_int(meta_f64_to_int(meta_f64_from_str(cvn.sa)));
        }
        return meta_fail("T-MTA-E617", "编译期整数转换的操作数须为 int / bool / float", e);
    }
    if (n.kind == "call") { return meta_eval_call(e); }
    if (n.kind == "mbuiltin") { return meta_eval_mbuiltin(e); }
    if (n.kind == "closure_make") { return meta_eval_closure_make(e); }
    if (n.kind == "array_lit") { return meta_eval_array_lit(e); }
    if (n.kind == "index") { return meta_eval_index(e); }
    if (n.kind == "struct_lit") { return meta_eval_struct_lit(e); }
    if (n.kind == "match") { return meta_eval_match(e); }
    return meta_fail("T-MTA-E617",
        sb_cat3("表达式 `", n.kind, "` 不可编译期求值"), e);
}

// ── 编译期数组值 ────────────────────────────────────────────
// 表示：一个 array_lit 节点，元素全是字面量节点。**每次求值都新造节点**——
// 同一处 AST 会被循环 / 多次调用反复求值，复用节点会让元素赋值污染模板。

// 链表里第 idx 个 Child 的**下标**（不是 val，赋值要回写 Child）；-1 = 越界
fn meta_kid_at(head: i64, idx: i64) i64 {
    if (idx < 0) { return -1; }
    var c: i64 = head;
    var i: i64 = 0;
    while (c >= 0) {
        if (i == idx) { return c; }
        i = i + 1;
        c = kids[c].next;
    }
    return -1;
}

// 绑定处的值拷贝：t 的数组是**值类型**，`var b = a;` / 传参不能与源共享节点，
// 否则 `b[0] = x` 会顺带改掉 a。标量字面量不可变，原样返回。
fn meta_val_copy(v: i64) i64 {
    if (v < 0) { return -1; }
    var n: Node = nodes[v];
    if (n.kind != "array_lit") { return v; }
    var h: i64 = -1;
    var t: i64 = -1;
    var c: i64 = n.la;
    while (c >= 0) {
        var ev: i64 = meta_val_copy(kids[c].val);
        t = list_push(h, t, ev);
        if (h < 0) { h = t; }
        c = kids[c].next;
    }
    return mk_array_lit(h, -1);
}

fn meta_eval_array_lit(e: i64) i64 {
    var n: Node = nodes[e];
    var h: i64 = -1;
    var t: i64 = -1;
    var c: i64 = n.la;
    while (c >= 0) {
        var ev: i64 = meta_eval(kids[c].val);
        if (ev < 0) { return -1; }
        t = list_push(h, t, ev);
        if (h < 0) { h = t; }
        c = kids[c].next;
    }
    return mk_array_lit(h, -1);
}

// P5（comptime 闭包逃逸）：捕获型闭包在 check 期已被提升成 closure_make 节点
// （sa=合成函数名，sb=环境结构名，la=捕获量 ident 链）。编译期求值时，la 链里的捕获
// ident 在当前 menv 里已是已知编译期值（或其本身又是已物化的 comptime 闭包），
// 故逐一对 la 链里的捕获节点做 meta_eval，把结果（字面量 / 嵌套 closure_make）包进
// closure_capval（sa=环境字段名，na=已物化值），串成新的 la 链；返回一个
// 「捕获量已物化」的 closure_make。sa/sb 沿用被提升的合成函数与环境结构，于是运行时
// 只需按 closure_make 既有路径堆分配 env、拷入捕获量、造 TClosure——捕获值已在编译期落定。
// 嵌套闭包：meta_eval(捕获量) 递归进 meta_eval_closure_make，自然递推展开（见 p60 make_pair）。
fn meta_eval_closure_make(e: i64) i64 {
    var n: Node = nodes[e];
    var h: i64 = -1;
    var t: i64 = -1;
    var c: i64 = n.la;
    while (c >= 0) {
        var capn: Node = nodes[kids[c].val];
        var capname: string = capn.sa;          // 环境字段名（须保留给 emit 写 env->field）
        var cv: i64 = meta_eval(kids[c].val);  // 编译期物化值：字面量 / 嵌套 closure_make
        if (cv < 0) { return -1; }
        var p: i64 = mk_closure_capval(capname, cv, -1);
        t = list_push(h, t, p);
        if (h < 0) { h = t; }
        c = kids[c].next;
    }
    var cm: i64 = mk_closure_make(n.sa, h, -1);
    var cmn: Node = nodes[cm];
    cmn.sb = n.sb;
    slice_set(nodes, cm, cmn);
    return cm;
}

fn meta_eval_index(e: i64) i64 {
    var n: Node = nodes[e];
    var b: i64 = meta_eval(n.na);
    if (b < 0) { return -1; }
    var iv: i64 = meta_eval(n.nb);
    if (iv < 0) { return -1; }
    var idx: i64 = mv_get_int(iv);
    var bn: Node = nodes[b];
    if (bn.kind == "string") {
        if (idx < 0 || idx >= (str_len(bn.sa) as i64)) {
            return meta_fail("T-MTA-E602", "编译期字符串下标越界", e);
        }
        return mv_int(str_at(bn.sa, idx) as i64);
    }
    if (bn.kind != "array_lit") {
        return meta_fail("T-MTA-E617", "编译期下标访问的对象须是数组或字符串", e);
    }
    var ci: i64 = meta_kid_at(bn.la, idx);
    if (ci < 0) {
        return meta_fail("T-MTA-E602", "编译期数组下标越界", e);
    }
    return kids[ci].val;
}

// 编译期结构体字面量：递归求值每个字段（FV 节点：sa=字段名, na=值），
// 重建 struct_lit。类型名 sa 原样保留 —— comptime_fold 在 run_check
// 之后运行，模块限定已解析进 sa（mangled 名），无需处理 sb。
fn meta_eval_struct_lit(e: i64) i64 {
    var n: Node = nodes[e];
    var h: i64 = -1;
    var t: i64 = -1;
    var c: i64 = n.la;
    while (c >= 0) {
        var fv: Node = nodes[kids[c].val];
        if (fv.kind != "FV") {
            return meta_fail("T-MTA-E617", "编译期结构体字面量字段须为 field-value 节点", e);
        }
        var fv_val: i64 = meta_eval(fv.na);
        if (fv_val < 0) { return -1; }
        var nfv: i64 = mk_FV(fv.sa, fv_val, -1);
        t = list_push(h, t, nfv);
        if (h < 0) { h = t; }
        c = kids[c].next;
    }
    return mk_struct_lit(n.sa, h, -1);
}

// 编译期数组 → string（取前 len 字节）。-1 = 失败（已报错）
fn meta_bytes_to_str(e: i64, av: i64, lv: i64) i64 {
    var an: Node = nodes[av];
    if (an.kind == "string") {
        // 允许直接传字符串（等价于截断）
        var cut: i64 = mv_get_int(lv);
        if (cut < 0 || cut > (str_len(an.sa) as i64)) {
            return meta_fail("T-MTA-E602", "编译期字节转字符串的长度越界", e);
        }
        var sbs: StringBuilder = sb_new();
        var q: i64 = 0;
        while (q < cut) {
            sb_append_char(sbs, str_at(an.sa, q));
            q = q + 1;
        }
        return mk_string(sb_to_str(sbs), -1);
    }
    if (an.kind != "array_lit") {
        return meta_fail("T-MTA-E617", "编译期字节缓冲区须是数组值", e);
    }
    var ln: i64 = mv_get_int(lv);
    if (ln < 0) {
        return meta_fail("T-MTA-E602", "编译期字节转字符串的长度为负", e);
    }
    var sb: StringBuilder = sb_new();
    var i: i64 = 0;
    var c: i64 = an.la;
    while (i < ln) {
        if (c < 0) {
            return meta_fail("T-MTA-E602", "编译期字节转字符串的长度超出缓冲区", e);
        }
        var bv: Node = nodes[kids[c].val];
        if (bv.kind != "int" && bv.kind != "bool") {
            return meta_fail("T-MTA-E617", "编译期字节缓冲区的元素须是整数", e);
        }
        sb_append_char(sb, (mv_get_int(kids[c].val) % 256) as u8);
        i = i + 1;
        c = kids[c].next;
    }
    return mk_string(sb_to_str(sb), -1);
}

fn meta_eval_unary(e: i64) i64 {
    var n: Node = nodes[e];
    var v: i64 = meta_eval(n.na);
    if (v < 0) { return -1; }
    var vn: Node = nodes[v];
    if (n.sa == "+") {
        if (vn.kind == "float") { return v; }
        if (vn.kind != "int") { return meta_fail("T-MTA-E617", "一元 `+` 的操作数须为整数或浮点", e); }
        return v;
    }
        if (n.sa == "-") {
            if (vn.kind == "float") {
                // IEEE-754 特殊值：t 无 inf/nan 的数值字面量，统一以文本承载；
                // 取负按位模式翻转（与 codegen_ll 浮点字面量发射器保持一致）。
                if (vn.sa == "inf") { return mk_float("-inf", -1); }
                if (vn.sa == "-inf") { return mk_float("inf", -1); }
                if (vn.sa == "nan") { return mk_float("nan", -1); }
                if (vn.sa == "-nan") { return mk_float("nan", -1); }
                return mk_float(meta_f64_to_str( 0.0 - meta_f64_from_str(vn.sa)), -1);
            }
        if (vn.kind != "int") { return meta_fail("T-MTA-E617", "一元 `-` 的操作数须为整数或浮点", e); }
        return mv_int(0 - mv_get_int(v));
    }
    if (n.sa == "~") {
        if (vn.kind != "int") { return meta_fail("T-MTA-E617", "一元 `~` 的操作数须为整数", e); }
        return mv_int(0 - mv_get_int(v) - 1);
    }
    if (n.sa == "!") {
        if (vn.kind != "bool") { return meta_fail("T-MTA-E617", "一元 `!` 的操作数须为 bool", e); }
        return mv_bool(vn.ba == false);
    }
    return meta_fail("T-MTA-E617", sb_cat3("编译期不支持一元算子 `", n.sa, "`"), e);
}

// ── 编译期浮点辅助（Phase B.2）─────────────────────────────
// string -> f64：覆盖常用十进制字面量（符号 / 整数部 / 小数部 / 指数）。
// 仅用于编译期常量折叠；正常字面量可经 %.17g 精确往返。
fn meta_f64_from_str(s: string) f64 {
    var i: i64 = 0;
    var n: i64 = str_len(s);
    var neg: bool = false;
    if (i < n && (str_at(s, i) as i64) == 45) { neg = true; i = i + 1; }   // '-'
    else if (i < n && (str_at(s, i) as i64) == 43) { i = i + 1; }           // '+'
    var val: f64 = 0.0;
    var frac: bool = false;
    var fscale: f64 = 0.1;
    var exp: i64 = 0;
    var have_exp: bool = false;
    while (i < n) {
        var ci: i64 = str_at(s, i) as i64;
        if (ci == 46) {   // '.'
            if (frac || have_exp) { break; }
            frac = true; i = i + 1; continue;
        }
        if (ci == 101 || ci == 69) {   // 'e' / 'E'
            if (have_exp) { break; }
            have_exp = true; i = i + 1;
            var esign: i64 = 1;
            if (i < n && (str_at(s, i) as i64) == 45) { esign = -1; i = i + 1; }
            else if (i < n && (str_at(s, i) as i64) == 43) { i = i + 1; }
            var ev: i64 = 0;
            while (i < n) {
                var ec: i64 = str_at(s, i) as i64;
                if (ec >= 48 && ec <= 57) { ev = ev * 10 + (ec - 48); i = i + 1; }
                else { break; }
            }
            exp = esign * ev;
            break;
        }
        if (ci >= 48 && ci <= 57) {
            var d: i64 = ci - 48;
            if (frac) { val = val + ((d as f64) * fscale); fscale = fscale * 0.1; }
            else { val = (val * 10.0) + (d as f64); }
            i = i + 1; continue;
        }
        break;
    }
    if (exp > 0) { var k: i64 = 0; while (k < exp) { val = val * 10.0; k = k + 1; } }
    else if (exp < 0) { var k: i64 = 0; while (k > exp) { val = val / 10.0; k = k - 1; } }
    if (neg) { val = 0.0 - val; }
    return val;
}

// f64 -> i64：向零截断（与 C 的 (long long) 语义一致）
fn meta_f64_to_int(x: f64) i64 {
    var neg: bool = (x < 0.0);
    var ax: f64 = x;
    if (neg) { ax = 0.0 - ax; }
    var i: i64 = 0;
    while (((i as f64) + 1.0) <= ax) { i = i + 1; }
    if (neg) { i = 0 - i; }
    return i;
}

// f64 -> 字面量字符串（%.17g，精确保持与运行期一致）。
// 发射期的「无小数点补 .0」由 codegen_ll 浮点字面量发射器兜底（见该文件 11xx 行），
// 故此处直接返回格式化结果即可，无需自行拼接。
fn meta_f64_to_str(v: f64) string {
    return format_float(".17g", v);
}

fn meta_eval_binary(e: i64) i64 {
    var n: Node = nodes[e];
    var op: string = n.sa;
    // 短路算子：右操作数按需求值（与运行期语义一致）
    if (op == "&&" || op == "||") {
        var l0: i64 = meta_eval(n.na);
        if (l0 < 0) { return -1; }
        var l0n: Node = nodes[l0];
        if (l0n.kind != "bool") {
            return meta_fail("T-MTA-E617", "`&&` / `||` 的操作数须为 bool", e);
        }
        if (op == "&&" && l0n.ba == false) { return mv_bool(false); }
        if (op == "||" && l0n.ba) { return mv_bool(true); }
        var r0: i64 = meta_eval(n.nb);
        if (r0 < 0) { return -1; }
        var r0n: Node = nodes[r0];
        if (r0n.kind != "bool") {
            return meta_fail("T-MTA-E617", "`&&` / `||` 的操作数须为 bool", e);
        }
        return mv_bool(r0n.ba);
    }
    var lv: i64 = meta_eval(n.na);
    if (lv < 0) { return -1; }
    var rv: i64 = meta_eval(n.nb);
    if (rv < 0) { return -1; }
    var ln1: Node = nodes[lv];
    var rn1: Node = nodes[rv];
    if (ln1.kind == "string" || rn1.kind == "string") {
        if (ln1.kind != "string" || rn1.kind != "string") {
            return meta_fail("T-MTA-E617", "编译期字符串只能与字符串比较", e);
        }
        if (op == "==") { return mv_bool(ln1.sa == rn1.sa); }
        if (op == "!=") { return mv_bool(ln1.sa != rn1.sa); }
        if (op == "+") {
            var sbs: StringBuilder = sb_new();
            sb_append_str(sbs, ln1.sa);
            sb_append_str(sbs, rn1.sa);
            return mk_string(sb_to_str(sbs), -1);
        }
        return meta_fail("T-MTA-E617",
            sb_cat3("编译期字符串不支持算子 `", op, "`"), e);
    }
    if (ln1.kind == "bool" && rn1.kind == "bool") {
        if (op == "==") { return mv_bool(ln1.ba == rn1.ba); }
        if (op == "!=") { return mv_bool(ln1.ba != rn1.ba); }
        return meta_fail("T-MTA-E617", sb_cat3("bool 不支持编译期算子 `", op, "`"), e);
    }
    // 浮点运算：float×float 或 float×int（int 提升为 float）
    if (ln1.kind == "float" || rn1.kind == "float") {
        if (ln1.kind != "float" && ln1.kind != "int") {
            return meta_fail("T-MTA-E617", "编译期浮点运算的左操作数须为 float 或 int", e);
        }
        if (rn1.kind != "float" && rn1.kind != "int") {
            return meta_fail("T-MTA-E617", "编译期浮点运算的右操作数须为 float 或 int", e);
        }
        var fa: f64 = 0.0;
        var fb: f64 = 0.0;
        // T-MTA-E617：操作数本身已是 inf/nan 文本形态（溢出后经字符串往返得到）→ 硬错误
        if (ln1.kind == "float"
            && (ln1.sa == "inf" || ln1.sa == "-inf" || ln1.sa == "nan" || ln1.sa == "-nan")) {
            return meta_fail("T-MTA-E617", "编译期浮点运算的操作数含 inf/nan", e);
        }
        if (rn1.kind == "float"
            && (rn1.sa == "inf" || rn1.sa == "-inf" || rn1.sa == "nan" || rn1.sa == "-nan")) {
            return meta_fail("T-MTA-E617", "编译期浮点运算的操作数含 inf/nan", e);
        }
        if (ln1.kind == "float") { fa = meta_f64_from_str(ln1.sa); }
        else { fa = mv_get_int(lv) as f64; }
        if (rn1.kind == "float") { fb = meta_f64_from_str(rn1.sa); }
        else { fb = mv_get_int(rv) as f64; }
        // T-MTA-E617：浮点二元运算操作数含 inf/nan 一律硬错误（不得折叠出垃圾值）
        if (fa != fa || fb != fb
            || fa > 1e308 || fa < -1e308 || fb > 1e308 || fb < -1e308) {
            return meta_fail("T-MTA-E617", "编译期浮点运算的操作数含 inf/nan", e);
        }
        if (op == "+") { var r: f64 = fa + fb; if (r != r || r > 1e308 || r < -1e308) { return meta_fail("T-MTA-E617", "编译期浮点运算溢出（结果含 inf/nan）", e); } return mk_float(meta_f64_to_str(r), -1); }
        if (op == "-") { var r: f64 = fa - fb; if (r != r || r > 1e308 || r < -1e308) { return meta_fail("T-MTA-E617", "编译期浮点运算溢出（结果含 inf/nan）", e); } return mk_float(meta_f64_to_str(r), -1); }
        if (op == "*") { var r: f64 = fa * fb; if (r != r || r > 1e308 || r < -1e308) { return meta_fail("T-MTA-E617", "编译期浮点运算溢出（结果含 inf/nan）", e); } return mk_float(meta_f64_to_str(r), -1); }
        if (op == "/") {
            if (fb == 0.0) { return meta_fail("T-MTA-E614", "编译期浮点除零", e); }
            var r: f64 = fa / fb; if (r != r || r > 1e308 || r < -1e308) { return meta_fail("T-MTA-E617", "编译期浮点运算溢出（结果含 inf/nan）", e); } return mk_float(meta_f64_to_str(r), -1);
        }
        if (op == "==") { return mv_bool(fa == fb); }
        if (op == "!=") { return mv_bool(fa != fb); }
        if (op == "<") { return mv_bool(fa < fb); }
        if (op == "<=") { return mv_bool(fa <= fb); }
        if (op == ">") { return mv_bool(fa > fb); }
        if (op == ">=") { return mv_bool(fa >= fb); }
        return meta_fail("T-MTA-E617", sb_cat3("编译期不支持浮点算子 `", op, "`"), e);
    }
    if (ln1.kind != "int" || rn1.kind != "int") {
        return meta_fail("T-MTA-E617", "编译期二元运算的操作数类型不一致", e);
    }
    var a: i64 = mv_get_int(lv);
    var b: i64 = mv_get_int(rv);
    if (op == "+") { return mv_int(a + b); }
    if (op == "-") { return mv_int(a - b); }
    if (op == "*") { return mv_int(a * b); }
    if (op == "/") {
        if (b == 0) { return meta_fail("T-MTA-E614", "编译期除零", e); }
        return mv_int(a / b);
    }
    if (op == "%") {
        if (b == 0) { return meta_fail("T-MTA-E614", "编译期取模除零", e); }
        return mv_int(a % b);
    }
    if (op == "&") { return mv_int(a & b); }
    if (op == "|") { return mv_int(a | b); }
    if (op == "^") { return mv_int(a ^ b); }
    if (op == "<<") { return mv_int(a << b); }
    if (op == ">>") { return mv_int(a >> b); }
    if (op == "==") { return mv_bool(a == b); }
    if (op == "!=") { return mv_bool(a != b); }
    if (op == "<") { return mv_bool(a < b); }
    if (op == "<=") { return mv_bool(a <= b); }
    if (op == ">") { return mv_bool(a > b); }
    if (op == ">=") { return mv_bool(a >= b); }
    return meta_fail("T-MTA-E617", sb_cat3("编译期不支持二元算子 `", op, "`"), e);
}

// 编译期调用：被调方必须是 `meta fn`（第 3 条 —— 编译期执行须显式声明）
// ── 编译期内建 ──────────────────────────────────────────────
// 只开放两类：
//   ① 编译期日志  print / eprint —— 一律写 stderr。
//      stdout 是机器可读通道（check 的 JSON、emit-ll 的 IR），
//      conformance 对 stdout 做跨编译器逐字节对拍，编译期日志绝不能污染它。
//      故 print 与 eprint 在编译期同义，这是有意为之。
//   ② 纯函数    int_to_str / i2s / str_len / str_at
// 触碰运行期世界的内建（file_* / sys_run / args / exit / path_resolve）一律拒绝：
// 宪法第 8 条 —— 编译期不得访问运行期世界；第 7 条 —— 求值必须可复现。
fn meta_builtin_impure(name: string) bool {
    if (name == "file_read_all" || name == "file_write_all" || name == "file_exists") { return true; }
    if (name == "sys_run" || name == "args" || name == "exit") { return true; }
    if (name == "path_resolve") { return true; }
    return false;
}

// 返回 -2 = 非内建（交回具名 meta fn 查找）；-1 = 已报错；>=0 = 结果字面量节点
fn meta_eval_builtin(e: i64, name: string) i64 {
    var isb: bool = false;
    if (name == "print" || name == "eprint") { isb = true; }
    if (name == "int_to_str" || name == "i2s") { isb = true; }
    if (name == "str_len" || name == "str_at") { isb = true; }
    if (name == "sym_intern") { isb = true; }
    if (isb == false) {
        if (meta_builtin_impure(name)) {
            return meta_fail("T-MTA-E615",
                sb_cat3("内建 `", name, "` 会触碰运行期世界，不可编译期求值"), e);
        }
        return -2;
    }
    var n: Node = nodes[e];
    var argv: []i64;
    var ac: i64 = n.la;
    while (ac >= 0) {
        var av: i64 = meta_eval(kids[ac].val);
        if (av < 0) { return -1; }
        append(argv, av);
        ac = kids[ac].next;
    }
    var an: i64 = slice_len(argv) as i64;
    // 编译期符号驻留：CTFE 里「符号」就是它的字符串；落到 `Sym` 槽位时
    // 由既有的 `Sym = "str"` 自动 intern 收口，两个后端零改动。
    if (name == "sym_intern") {
        if (an != 2) {
            return meta_fail("T-MTA-E611", "编译期 `sym_intern` 需要 2 个实参（缓冲区, 长度）", e);
        }
        return meta_bytes_to_str(e, argv[0], argv[1]);
    }
    if (name == "print" || name == "eprint") {
        if (an != 1) {
            return meta_fail("T-MTA-E611", sb_cat3("编译期 `", name, "` 需要 1 个实参"), e);
        }
        var a0: Node = nodes[argv[0]];
        if (a0.kind != "string") {
            return meta_fail("T-MTA-E617",
                sb_cat3("编译期 `", name, "` 的实参须是字符串字面量"), e);
        }
        eprint(a0.sa);
        return mv_int(0);
    }
    if (name == "int_to_str" || name == "i2s") {
        if (an != 1) {
            return meta_fail("T-MTA-E611", sb_cat3("编译期 `", name, "` 需要 1 个实参"), e);
        }
        var b0: Node = nodes[argv[0]];
        if (b0.kind != "int" && b0.kind != "bool") {
            return meta_fail("T-MTA-E617",
                sb_cat3("编译期 `", name, "` 的实参须是整数"), e);
        }
        return mk_string(i2s(mv_get_int(argv[0])), -1);
    }
    if (name == "str_len") {
        if (an != 1) {
            return meta_fail("T-MTA-E611", "编译期 `str_len` 需要 1 个实参", e);
        }
        var c0: Node = nodes[argv[0]];
        if (c0.kind != "string") {
            return meta_fail("T-MTA-E617", "编译期 `str_len` 的实参须是字符串", e);
        }
        return mv_int(str_len(c0.sa) as i64);
    }
    if (an != 2) {
        return meta_fail("T-MTA-E611", "编译期 `str_at` 需要 2 个实参", e);
    }
    var d0: Node = nodes[argv[0]];
    if (d0.kind != "string") {
        return meta_fail("T-MTA-E617", "编译期 `str_at` 的首个实参须是字符串", e);
    }
    var idx: i64 = mv_get_int(argv[1]);
    if (idx < 0 || idx >= (str_len(d0.sa) as i64)) {
        return meta_fail("T-MTA-E602", "编译期 `str_at` 下标越界", e);
    }
    return mv_int(str_at(d0.sa, idx) as i64);
}

// 调用点的类型实参：语法上它是**表达式**（`get_width(u32)` 里 `u32` 走 parse_expr），
// 这里把它翻译回类型节点。若该名字本身是当前帧里的类型参数（`get_width(T)` 转发），
// 直接返回它绑定的类型节点。-1 = 不是类型名。
fn meta_type_arg_node(a: i64) i64 {
    if (a < 0) { return -1; }
    var n: Node = nodes[a];
    if (n.kind == "named" || n.kind == "scalar" || n.kind == "slice"
        || n.kind == "array" || n.kind == "pointer" || n.kind == "optional") {
        return a;
    }
    if (n.kind != "ident") { return -1; }
    var si: i64 = menv_find(n.sa);
    if (si >= 0) {
        if (g_menv_ty[si] >= 0) { return g_menv_ty[si]; }
        return -1;                       // 是个编译期**值**，不能当类型
    }
    return type_node_from_ident(n.sa);
}

// ── 字符串工具（变体辅助函数名解析用）──────────────────────
fn meta_str_find(s: string, sub: string) i64 {
    var n: i64 = str_len(s);
    var m: i64 = str_len(sub);
    if (m <= 0 || m > n) { return -1; }
    var i: i64 = 0;
    while (i + m <= n) {
        var ok: bool = true;
        var j: i64 = 0;
        while (j < m) {
            if (s[i + j] != sub[j]) { ok = false; break; }
            j = j + 1;
        }
        if (ok) { return i; }
        i = i + 1;
    }
    return -1;
}

fn meta_substr(s: string, a: i64, b: i64) string {
    var sb: StringBuilder = sb_new();
    var i: i64 = a;
    while (i < b) {
        sb_append_char(sb, s[i]);
        i = i + 1;
    }
    return sb_to_str(sb);
}

// ── 编译期变体值（enum/variant 加入 comptime）──────────────
// 变体辅助函数（Name_from_Case / Name_is_Case / Name_as_Case[_fK]）在编译期
// 直接求值，无需运行期函数体。必须在普通 meta fn 派发之前拦截。
// 返回 -2 表示「非变体辅助调用」，交给后续普通派发。
fn meta_eval_variant_call(e: i64, name: string) i64 {
    // Name_from_Case(载荷...) → 构造编译期变体值 vval
    var fi: i64 = meta_str_find(name, "_from_");
    if (fi >= 0) {
        var vn: string = meta_substr(name, 0, fi);
        var cn0: string = meta_substr(name, fi + 6, str_len(name));
        var vd: i64 = sym_lookup(global_scope, vn);
        if (vd < 0) { return -2; }
        if (nodes[syms[vd].decl].kind != "VariantDecl") { return -2; }
        var vc: i64 = variant_find_case(syms[vd].decl, cn0);
        if (vc < 0) { return -2; }
        var n: Node = nodes[e];
        var h: i64 = -1;
        var t: i64 = -1;
        var ac: i64 = n.la;
        while (ac >= 0) {
            var pv: i64 = meta_eval(kids[ac].val);
            if (pv < 0) { return -1; }
            t = list_push(h, t, pv);
            if (h < 0) { h = t; }
            ac = kids[ac].next;
        }
        return mk_VVal(vn, nodes[vc].ia, cn0, h, -1);
    }
    // Name_is_Case(self) → bool
    var ii: i64 = meta_str_find(name, "_is_");
    if (ii >= 0) {
        var vn: string = meta_substr(name, 0, ii);
        var cn0: string = meta_substr(name, ii + 4, str_len(name));
        var vd: i64 = sym_lookup(global_scope, vn);
        if (vd < 0) { return -2; }
        if (nodes[syms[vd].decl].kind != "VariantDecl") { return -2; }
        var vc: i64 = variant_find_case(syms[vd].decl, cn0);
        if (vc < 0) { return -2; }
        var n: Node = nodes[e];
        var sv: i64 = -1;
        if (n.la >= 0) { sv = meta_eval(kids[n.la].val); }
        if (sv < 0) { return -1; }
        if (nodes[sv].kind != "vval") {
            return meta_fail("T-MTA-E617", "编译期 `is` 的被匹配值须是编译期变体值", e);
        }
        return mv_bool(nodes[sv].ia == nodes[vc].ia);
    }
    // Name_as_Case(self) / Name_as_Case_fK(self) → 载荷值
    var ai: i64 = meta_str_find(name, "_as_");
    if (ai >= 0) {
        var vn: string = meta_substr(name, 0, ai);
        var rest: string = meta_substr(name, ai + 4, str_len(name));
        var vd: i64 = sym_lookup(global_scope, vn);
        if (vd < 0) { return -2; }
        if (nodes[syms[vd].decl].kind != "VariantDecl") { return -2; }
        var fk: i64 = -1;
        var cn0: string = rest;
        var uf: i64 = meta_str_find(rest, "_f");
        if (uf >= 0) {
            cn0 = meta_substr(rest, 0, uf);
            var k: i64 = uf + 2;
            while (k < str_len(rest)) {
                var ch: i64 = rest[k];
                if (ch >= 48 && ch <= 57) { fk = fk * 10 + (ch - 48); }
                k = k + 1;
            }
        }
        var vc: i64 = variant_find_case(syms[vd].decl, cn0);
        if (vc < 0) { return -2; }
        var n: Node = nodes[e];
        var sv: i64 = -1;
        if (n.la >= 0) { sv = meta_eval(kids[n.la].val); }
        if (sv < 0) { return -1; }
        if (nodes[sv].kind != "vval") {
            return meta_fail("T-MTA-E617", "编译期 `as` 的被匹配值须是编译期变体值", e);
        }
        if (nodes[sv].ia != nodes[vc].ia) {
            return meta_fail("T-MTA-E617",
                sb_cat5("编译期 `as` 类型不匹配：实际是 `", nodes[sv].sb, "` 而非 `", cn0, "`"), e);
        }
        if (fk >= 0) {
            var c: i64 = nodes[sv].la;
            var idx: i64 = 0;
            while (c >= 0) {
                if (idx == fk) { return kids[c].val; }
                idx = idx + 1;
                c = kids[c].next;
            }
            return meta_fail("T-MTA-E617", "编译期 `as` 载荷下标越界", e);
        }
        if (nodes[sv].la >= 0) { return kids[nodes[sv].la].val; }
        return meta_fail("T-MTA-E617", "编译期 `as` 的 case 无载荷可取（单元 case）", e);
    }
    return -2;
}

// 字面量相等（match 字面量模式用）
fn meta_lit_eq(pat: i64, val: i64) bool {
    var pn: Node = nodes[pat];
    var vn: Node = nodes[val];
    if (pn.kind != vn.kind) { return false; }
    if (pn.kind == "int") { return pn.ia == vn.ia; }
    if (pn.kind == "bool") { return pn.ba == vn.ba; }
    if (pn.kind == "string") { return pn.sa == vn.sa; }
    if (pn.kind == "float") { return pn.sa == vn.sa; }   // P5: 浮点字面量按文本相等
    return false;
}

// 把 conpat 子模式链（ident / `_` / 嵌套 conpat）绑定到变体载荷值链
fn meta_bind_conpat(pats: i64, vals: i64) bool {
    var pc: i64 = pats;
    var vc: i64 = vals;
    while (pc >= 0 && vc >= 0) {
        var pn: Node = nodes[kids[pc].val];
        var pv: i64 = kids[vc].val;
        if (pn.kind == "ident") {
            menv_push(pn.sa, pv);
        } else if (pn.kind == "conpat") {
            if (nodes[pv].kind == "vval") {
                if (nodes[pv].sb != pn.sa) { return false; }
                if (meta_bind_conpat(pn.la, nodes[pv].la) == false) { return false; }
            } else { return false; }
        }
        // `_` 通配 / 其他：跳过绑定
        pc = kids[pc].next;
        vc = kids[vc].next;
    }
    return true;
}

// 编译期 match：scrutinee 求值后按 conpat/`_`/字面量/绑定 选择命中臂
fn meta_eval_match(e: i64) i64 {
    var n: Node = nodes[e];
    var scr: i64 = meta_eval(n.na);
    if (scr < 0) { return -1; }
    var mc: i64 = n.la;
    while (mc >= 0) {
        var arm: Node = nodes[kids[mc].val];
        var pat: i64 = arm.na;
        var guard: i64 = arm.nb;
        var body: i64 = arm.nc;
        var sv_base: i64 = g_menv_base;
        var sv_top: i64 = g_menv_top;
        var matched: bool = false;
        if (arm.ba) {
            matched = true;                                  // `_` 通配
        } else if (arm.sa != "" && pat < 0) {
            // 纯绑定臂（`n when ... =>`）：绑定名在 arm.sa，pat 为 -1；
            // 把整个 scrutinee 值绑到该名字，守卫内可引用。
            menv_push(arm.sa, scr);
            matched = true;
        } else if (pat >= 0 && nodes[pat].kind == "conpat") {
            if (nodes[pat].sa == "") {
                // 纯绑定 conpat（罕见）：把 la 里的 ident 绑定到整个 scrutinee
                var bpi: i64 = nodes[pat].la;
                while (bpi >= 0) {
                    var bp: Node = nodes[kids[bpi].val];
                    if (bp.kind == "ident") { menv_push(bp.sa, scr); }
                    bpi = kids[bpi].next;
                }
                matched = true;
            } else if (nodes[scr].kind == "vval") {
                if (nodes[scr].sb == nodes[pat].sa) {
                    matched = meta_bind_conpat(nodes[pat].la, nodes[scr].la);
                }
            }
        } else if (pat >= 0 && nodes[pat].kind == "ident") {
            menv_push(nodes[pat].sa, scr);      // 绑定整个 scrutinee 值
            matched = true;
        } else if (pat >= 0 && (nodes[pat].kind == "int"
                || nodes[pat].kind == "string" || nodes[pat].kind == "bool")) {
            if (meta_lit_eq(pat, scr)) { matched = true; }
        }
        if (matched && guard >= 0) {
            var gv: i64 = meta_eval(guard);
            if (gv < 0) { g_menv_top = sv_top; g_menv_base = sv_base; return -1; }
            var gvn: Node = nodes[gv];
            if (gvn.kind != "bool" || gvn.ba == false) { matched = false; }
        }
        if (matched) {
            var rv: i64 = meta_eval(body);
            g_menv_top = sv_top;
            g_menv_base = sv_base;
            return rv;
        }
        g_menv_top = sv_top;
        g_menv_base = sv_base;
        mc = kids[mc].next;
    }
    return meta_fail("T-MTA-E617", "编译期 match 无可匹配臂（scrutinee 未匹配任何模式）", e);
}

fn meta_eval_call(e: i64) i64 {
    var n: Node = nodes[e];
    if (n.na < 0) {
        return meta_fail("T-MTA-E617", "编译期调用缺少被调方", e);
    }
    var cn: Node = nodes[n.na];
    if (cn.kind != "ident") {
        return meta_fail("T-MTA-E617", "编译期调用的被调方须是具名 meta 函数", e);
    }
    // 变体辅助函数（Name_from_Case / Name_is_Case / Name_as_Case[_fK]）在编译期
    // 直接求值，无需函数体。须在普通 meta fn 派发之前拦截，否则会因「无函数体」失败。
    var vcall: i64 = meta_eval_variant_call(e, cn.sa);
    if (vcall != -2) { return vcall; }
    // 内建优先（与运行期解析顺序一致）；-2 表示非内建，继续查具名 meta fn
    var bir: i64 = meta_eval_builtin(e, cn.sa);
    if (bir != -2) { return bir; }
    var si: i64 = sym_lookup(global_scope, cn.sa);
    if (si < 0) {
        return meta_fail("T-MTA-E617", sb_cat3("未定义的编译期函数 `", cn.sa, "`"), e);
    }
    var sy: Sym = syms[si];
    if (sy.decl < 0) {
        return meta_fail("T-MTA-E617", sb_cat3("`", cn.sa, "` 没有可求值的函数体"), e);
    }
    var fd: Node = nodes[sy.decl];
    if (fd.kind != "FuncDecl") {
        return meta_fail("T-MTA-E617", sb_cat3("`", cn.sa, "` 不是函数"), e);
    }
    if (fd.bb == false) {
        return meta_fail("T-MTA-E618",
            sb_cat3("`", cn.sa, "` 不是编译期函数；comptime 上下文中的调用要求被调方以 `comptime fn` 声明"), e);
    }
    if (fd.lc == -2) {
        return meta_fail("T-MTA-E617", sb_cat3("`", cn.sa, "` 无函数体，不可编译期求值"), e);
    }
    // 形参表先建（要按声明类型分流实参：`meta T: type` 收类型，其余收值）
    var pnames: []string;
    var pistype: []bool;
    var pc: i64 = fd.lb;
    while (pc >= 0) {
        var pn: Node = nodes[kids[pc].val];
        append(pnames, pn.sa);
        append(pistype, meta_param_is_type(kids[pc].val));
        pc = kids[pc].next;
    }
    var np1: i64 = slice_len(pnames) as i64;
    // 实参在调用方环境求值（务必先于建帧）；类型参数不求值，转成类型节点。
    var argv: []i64;
    var argt: []i64;
    var ai: i64 = 0;
    var ac: i64 = n.la;
    while (ac >= 0) {
        if (ai < np1 && pistype[ai]) {
            var atn: i64 = meta_type_arg_node(kids[ac].val);
            if (atn < 0) {
                return meta_fail("T-MTA-E619",
                    sb_cat4("编译期调用 `", cn.sa, "` 的第 ", sb_cat2(i2s(ai + 1), " 个实参须是类型名")), e);
            }
            append(argv, -1);
            append(argt, atn);
        } else {
            var av: i64 = meta_eval(kids[ac].val);
            if (av < 0) { return -1; }
            append(argv, av);
            append(argt, -1);
        }
        ai = ai + 1;
        ac = kids[ac].next;
    }
    var na1: i64 = slice_len(argv) as i64;
    if (na1 != np1) {
        return meta_fail("T-MTA-E611",
            sb_cat3("编译期调用 `", cn.sa, "` 的实参个数与形参不符"), e);
    }
    g_meta_depth = g_meta_depth + 1;
    if (g_meta_depth > 64) {
        g_meta_depth = g_meta_depth - 1;
        return meta_fail("T-MTA-E613",
            sb_cat3("编译期调用递归过深（>64）：`", cn.sa, "`"), e);
    }
    var sv_base: i64 = g_menv_base;
    var sv_top: i64 = g_menv_top;
    var sv_ret: i64 = g_meta_ret;
    g_menv_base = g_menv_top;
    var bi: i64 = 0;
    while (bi < np1) {
        menv_push2(pnames[bi], meta_val_copy(argv[bi]), argt[bi]);
        bi = bi + 1;
    }
    g_meta_ret = -1;
    var st: i64 = meta_exec(fd.lc);
    var rv2: i64 = g_meta_ret;
    g_menv_base = sv_base;
    g_menv_top = sv_top;
    g_meta_ret = sv_ret;
    g_meta_depth = g_meta_depth - 1;
    if (g_meta_err) { return -1; }
    if (st != 1 || rv2 < 0) {
        return meta_fail("T-MTA-E616",
            sb_cat3("编译期函数 `", cn.sa, "` 在本次求值路径上未返回值"), e);
    }
    return rv2;
}

// ── 语句执行：0=顺序结束 1=return 2=break 3=continue ──────────
fn meta_exec(head: i64) i64 {
    var c: i64 = head;
    while (c >= 0) {
        if (g_meta_err) { return 0; }
        g_meta_steps = g_meta_steps - 1;
        if (g_meta_steps <= 0) {
            meta_fail("T-MTA-E612", "编译期求值步数超预算（疑似不终止的 meta 循环）", kids[c].val);
            return 0;
        }
        var k: Child = kids[c];
        var s: Node = nodes[k.val];
        if (s.kind == "var_decl") {
            if (s.nb < 0) {
                meta_fail("T-MTA-E617",
                    sb_cat3("编译期变量 `", s.sa, "` 必须有初值"), k.val);
                return 0;
            }
            var iv: i64 = meta_eval(s.nb);
            if (iv < 0) { return 0; }
            menv_push(s.sa, meta_val_copy(iv));
        } else if (s.kind == "assign") {
            if (meta_do_assign(k.val) == false) { return 0; }
        } else if (s.kind == "expr") {
            var inner: i64 = s.na;
            if (inner < 0) {
                meta_fail("T-MTA-E617", "空表达式语句不可编译期求值", k.val);
                return 0;
            }
            var innn: Node = nodes[inner];
            if (innn.kind == "assign") {
                if (meta_do_assign(inner) == false) { return 0; }
            } else {
                var dv: i64 = meta_eval(inner);
                if (dv < 0) { return 0; }
            }
        } else if (s.kind == "if") {
            var cv: i64 = meta_eval(s.na);
            if (cv < 0) { return 0; }
            var cvn: Node = nodes[cv];
            if (cvn.kind != "bool") {
                meta_fail("T-MTA-E617", "编译期 if 条件须为 bool", k.val);
                return 0;
            }
            var mk1: i64 = g_menv_top;
            var r1: i64 = 0;
            if (cvn.ba) {
                r1 = meta_exec(s.la);
            } else {
                if (s.lb > -2) { r1 = meta_exec(s.lb); }
            }
            g_menv_top = mk1;
            if (g_meta_err) { return 0; }
            if (r1 != 0) { return r1; }
        } else if (s.kind == "while") {
            while (true) {
                g_meta_steps = g_meta_steps - 1;
                if (g_meta_steps <= 0) {
                    meta_fail("T-MTA-E612",
                        "编译期求值步数超预算（疑似不终止的 meta 循环）", k.val);
                    return 0;
                }
                var wc: i64 = meta_eval(s.na);
                if (wc < 0) { return 0; }
                var wcn: Node = nodes[wc];
                if (wcn.kind != "bool") {
                    meta_fail("T-MTA-E617", "编译期 while 条件须为 bool", k.val);
                    return 0;
                }
                if (wcn.ba == false) { break; }
                var mk2: i64 = g_menv_top;
                var r2: i64 = meta_exec(s.la);
                g_menv_top = mk2;
                if (g_meta_err) { return 0; }
                if (r2 == 1) { return 1; }
                if (r2 == 2) { break; }
            }
        } else if (s.kind == "block" || s.kind == "comptime_block") {
            var mk3: i64 = g_menv_top;
            var r3: i64 = meta_exec(s.la);
            g_menv_top = mk3;
            if (g_meta_err) { return 0; }
            if (r3 != 0) { return r3; }
        } else if (s.kind == "return") {
            if (s.na < 0) {
                g_meta_ret = -1;
                return 1;
            }
            var rv3: i64 = meta_eval(s.na);
            if (rv3 < 0) { return 0; }
            g_meta_ret = rv3;
            return 1;
        } else if (s.kind == "break") {
            return 2;
        } else if (s.kind == "continue") {
            return 3;
        } else {
            meta_fail("T-MTA-E617",
                sb_cat3("语句 `", s.kind, "` 不可编译期执行"), k.val);
            return 0;
        }
        c = k.next;
    }
    return 0;
}

fn meta_do_assign(a: i64) bool {
    var an: Node = nodes[a];
    if (an.na < 0) { return false; }
    var tgt: Node = nodes[an.na];
    // `buf[i] = v`：就地改 Child.val —— 编译期数组值就是那个 array_lit 节点本身
    if (tgt.kind == "index") {
        var base: i64 = meta_eval(tgt.na);
        if (base < 0) { return false; }
        var bn2: Node = nodes[base];
        if (bn2.kind != "array_lit") {
            meta_fail("T-MTA-E617", "编译期下标赋值的目标须是数组", a);
            return false;
        }
        var ixv: i64 = meta_eval(tgt.nb);
        if (ixv < 0) { return false; }
        var ci2: i64 = meta_kid_at(bn2.la, mv_get_int(ixv));
        if (ci2 < 0) {
            meta_fail("T-MTA-E602", "编译期数组下标越界", a);
            return false;
        }
        var nv2: i64 = meta_eval(an.nb);
        if (nv2 < 0) { return false; }
        var kc: Child = kids[ci2];
        kc.val = nv2;
        slice_set(kids, ci2, kc);
        return true;
    }
    if (tgt.kind != "ident") {
        meta_fail("T-MTA-E617", "编译期赋值的目标须是 meta 变量名", a);
        return false;
    }
    var si: i64 = menv_find(tgt.sa);
    if (si < 0) {
        meta_fail("T-MTA-E620",
            sb_cat3("`", tgt.sa, "` 不是编译期实体，meta 上下文不可对其赋值"), a);
        return false;
    }
    var v: i64 = meta_eval(an.nb);
    if (v < 0) { return false; }
    slice_set(g_menv_val, si, meta_val_copy(v));
    return true;
}

// ── 折叠 / 执行 ─────────────────────────────────────────────
// `meta <expr>` → 就地变成字面量节点（保留 ln/cl/tv 供诊断定位）
fn meta_fold_expr(e: i64) void {
    g_meta_err = false;
    var v: i64 = meta_eval(e);
    if (v < 0) { return; }
    var src: Node = nodes[v];
    var dst: Node = nodes[e];
    dst.kind = src.kind;
    dst.sa = src.sa;
    dst.sb = src.sb;
    dst.ia = src.ia;
    dst.ba = src.ba;
    dst.na = src.na;
    dst.nb = src.nb;
    dst.nc = src.nc;
    dst.nd = src.nd;
    dst.la = src.la;   // array_lit 的元素链（其余字面量此处均为 -1）
    dst.lb = src.lb;
    dst.lc = src.lc;
    slice_set(nodes, e, dst);
}

// `meta { ... }` → 编译期执行，随后清空语句表（不产生任何运行期代码）
fn meta_run_block(b: i64) void {
    g_meta_err = false;
    var bn: Node = nodes[b];
    var mk4: i64 = g_menv_top;
    var st: i64 = meta_exec(bn.la);
    g_menv_top = mk4;
    if (g_meta_err) { return; }
    if (st == 1) {
        if (g_meta_quiet == false) {
            fc_err("T-MTA-E609", "meta 块内不允许 return", b);
        }
        return;
    }
    var bn2: Node = nodes[b];
    bn2.la = -1;
    slice_set(nodes, b, bn2);
}

// 通用子树遍历：只认 na/nb/nc/nd + la/lb/lc 七个槽（未用槽一律 -1），
// 故无需为每种节点写专门的遍历分支。遇 FuncDecl/lambda 即止（由驱动逐个进入）。
fn meta_walk_list(head: i64) void {
    var c: i64 = head;
    while (c >= 0) {
        var k: Child = kids[c];
        meta_walk(k.val);
        c = k.next;
    }
}

fn meta_walk(e: i64) void {
    if (e < 0) { return; }
    var n: Node = nodes[e];
    if (n.kind == "FuncDecl" || n.kind == "lambda") { return; }
    if (n.kind == "comptime") {
        meta_walk(n.na);          // 先折叠内层，再求值本层
        meta_fold_expr(e);
        return;
    }
    if (n.kind == "comptime_block") {
        meta_run_block(e);
        return;
    }
    meta_walk(n.na);
    meta_walk(n.nb);
    meta_walk(n.nc);
    meta_walk(n.nd);
    meta_walk_list(n.la);
    meta_walk_list(n.lb);
    meta_walk_list(n.lc);
}

// CTFE 主驱动：必须在 check_decl 之前跑（折叠后 checker 看到的是字面量）。
fn meta_pass() void {
    g_menv_top = 0;
    g_menv_base = 0;
    g_menv_nglobal = 0;
    g_meta_depth = 0;
    g_meta_steps = 4000000;
    g_meta_err = false;
    g_meta_quiet = false;
    // ① 顶层编译期常量入全局环境（按声明顺序可见）。
    //    普通 const 天然编译期已知，一并纳入；求值失败的静默跳过（退化为运行期常量）。
    var n1: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n1) {
        var d: i64 = decl_list[i];
        var dn: Node = nodes[d];
        if (dn.kind == "GlobalConstDecl" || (dn.kind == "GlobalVarDecl" && dn.bb)) {
            if (dn.nb >= 0) {
                g_meta_err = false;
                g_meta_quiet = true;
                var gv: i64 = meta_eval(dn.nb);
                g_meta_quiet = false;
                g_meta_err = false;
                if (gv >= 0) { menv_push(dn.sa, gv); }
            }
        }
        i = i + 1;
    }
    g_menv_nglobal = g_menv_top;
    g_menv_base = g_menv_top;
    // ② 逐声明折叠 meta 表达式 / 执行 meta 块
    var n2: i64 = slice_len(decl_list) as i64;
    var j: i64 = 0;
    while (j < n2) {
        var d2: i64 = decl_list[j];
        var dn2: Node = nodes[d2];
        if (dn2.kind == "FuncDecl") {
            // meta fn 本体只在被调用时求值，此处不进入；
            // 泛型模板本体带未绑定类型参数，静默折叠（失败不报错，实例仍走运行期语义）。
            if (dn2.bb == false && dn2.lc != -2) {
                g_menv_top = g_menv_nglobal;
                g_menv_base = g_menv_nglobal;
                g_meta_quiet = func_is_generic(d2);
                meta_walk_list(dn2.lc);
                g_meta_quiet = false;
            }
        } else {
            g_menv_top = g_menv_nglobal;
            g_menv_base = g_menv_nglobal;
            meta_walk(dn2.na);
            meta_walk(dn2.nb);
            meta_walk(dn2.nc);
            meta_walk(dn2.nd);
        }
        j = j + 1;
    }
    g_menv_top = g_menv_nglobal;
    g_menv_base = g_menv_nglobal;
}

// ══════════════════════════════════════════════════════════════
// M-meta Phase D —— 编译期内建 `@xxx`（docs/meta_design.md §5）
//
// 表面：表达式位置的 `@name(args)` → `mbuiltin` 节点（sa = 名字，la = 实参链）。
//
// 两类语义：
//  ① 类型查询 `@type_name` / `@type_size` / `@type_equal`
//     纯编译期折叠 —— mb_pass 在 CTFE 之前就地换成 string / int / bool 字面量。
//     **两个后端都无需任何新支持**：它们看到的只有普通字面量。
//  ② `@compile_error(msg)` 不折叠 —— 只有 CTFE 真正执行到才终止编译；
//     折不掉而漏到 check 的一律 T_META_RUNTIME_CTX（宪法第 8 条：编译期/运行期隔离）。
//
// 泛型模板本体里的类型参数尚未绑定（`@type_size(T)` 查无此类型），此时**刻意不折叠**，
// 留到 instantiate_generic 代换掉 T 之后由实例再走一遍 mb_walk（见 instantiate_generic 末尾）。
// ══════════════════════════════════════════════════════════════

fn mb_is_type_query(name: string) bool {
    if (name == "type_name" || name == "type_size" || name == "type_equal") { return true; }
    return false;
}


// 只能在 CTFE 里求值的内建（实参是编译期值，折叠期无从下手）。
// 漏到 check ⇒ 运行期上下文误用 ⇒ T_META_RUNTIME_CTX。
fn mb_is_ctfe_only(name: string) bool {
    if (name == "str_from_bytes") { return true; }
    return false;
}

fn mb_is_known(name: string) bool {
    if (mb_is_type_query(name)) { return true; }
    if (mb_is_ctfe_only(name)) { return true; }
    if (name == "compile_error" || name == "zeroed") { return true; }
    if (name == "type_val") { return true; }   // P4：类型即值 —— 把类型名字符串还原为类型节点
    if (name == "type_of") { return true; }    // P4：值→类型查询
    return false;
}


// 具名类型的声明节点（struct / enum / flag / union / variant / typealias）；-1 = 未声明
fn mb_type_decl(name: string) i64 {
    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = decl_list[i];
        var dn: Node = nodes[d];
        if (dn.sa == name) {
            var k: string = dn.kind;
            if (k == "StructDecl" || k == "EnumDecl" || k == "TypeAliasDecl") { return d; }
            if (k == "FlagDecl" || k == "FlagSetDecl") { return d; }
            if (k == "UnionDecl" || k == "VariantDecl") { return d; }
        }
        i = i + 1;
    }
    return -1;
}

// 规范类型名（@type_name 的返回值，同时充当 @type_equal 的比较键）。
// typealias 一律展开到底层：t 没有 newtype 语义，`MyInt i64;` 与 `i64` 是同一个类型，
// 按名比较会给出与 checker 相反的答案。
// 返回 "" = 编译期不可解析（多半是未实例化的类型参数）—— 调用方据此放弃折叠。
// `meta T: type` 形参在 CTFE 帧里绑定成类型节点；类型查询遇到 `named{T}` 先换成绑定值。
// mb_pass 阶段环境为空 → 原样返回（模板本体刻意折不掉，留给实例）。
fn mb_bound_type(tn: i64) i64 {
    if (tn < 0) { return -1; }
    var cur: i64 = tn;
    var d: i64 = 0;
    while (d < 16) {
        var n: Node = nodes[cur];
        if (n.kind != "named") { return cur; }
        var si: i64 = menv_find(n.sa);
        if (si < 0) { return cur; }
        var bt: i64 = g_menv_ty[si];
        if (bt < 0) { return cur; }
        cur = bt;
        d = d + 1;
    }
    return cur;
}

fn mb_type_key(tn0: i64, depth: i64) string {
    if (tn0 < 0) { return ""; }
    if (depth > 16) { return ""; }
    var tn: i64 = mb_bound_type(tn0);
    var n: Node = nodes[tn];
    if (n.kind == "any" || n.kind == "type") { return ""; }
    if (n.kind == "named") {
        if (n.sa == "TypeInfo" || n.sa == "FieldInfo") { return n.sa; }
        var d: i64 = mb_type_decl(n.sa);
        if (d < 0) { return ""; }
        var dn: Node = nodes[d];
        if (dn.kind == "TypeAliasDecl") { return mb_type_key(dn.na, depth + 1); }
        return n.sa;
    }
    if (n.kind == "slice") {
        var e1: string = mb_type_key(n.na, depth + 1);
        if (e1 == "") { return ""; }
        return sb_cat2("[]", e1);
    }
    if (n.kind == "array") {
        var e2: string = mb_type_key(n.na, depth + 1);
        if (e2 == "") { return ""; }
        if (n.nb < 0) { return ""; }
        var le: Node = nodes[n.nb];
        if (le.kind != "int") { return ""; }
        return sb_cat4("[", i2s(parse_int_len(le.sa, le.ia)), "]", e2);
    }
    if (n.kind == "pointer") {
        var e3: string = mb_type_key(n.na, depth + 1);
        if (e3 == "") { return ""; }
        return sb_cat2("*", e3);
    }
    if (n.kind == "optional") {
        var e4: string = mb_type_key(n.na, depth + 1);
        if (e4 == "") { return ""; }
        return sb_cat2("?", e4);
    }
    var td: i64 = resolve_type_desc(tn);
    var r: string = td_readable(td);
    if (r == "?" || r == "unknown") { return ""; }
    return r;
}

// 标量字节宽度；-1 = 未知。string / StringBuilder 取运行时表示宽度
// （TStr { ptr, len } = 16；TSb* = 8），与 runtime/t_runtime.h 定义一致。
fn mb_scalar_size(s: string) i64 {
    if (s == "i8" || s == "u8" || s == "bool") { return 1; }
    if (s == "i16" || s == "u16") { return 2; }
    if (s == "i32" || s == "u32" || s == "f32") { return 4; }
    if (s == "rune") { return 4; }
    if (s == "i64" || s == "u64" || s == "f64") { return 8; }
    if (s == "string") { return 16; }
    if (s == "bytes") { return 16; }
    if (s == "StringBuilder") { return 8; }
    if (s == "BytesBuilder") { return 8; }
    return -1;
}

fn mb_round_up(v: i64, a: i64) i64 {
    if (a <= 1) { return v; }
    var r: i64 = v % a;
    if (r == 0) { return v; }
    return v + (a - r);
}

// struct 布局按标准 C ABI 规则算：字段偏移向上取整到字段对齐，整体再取整到
// 最大字段对齐。clang（C 后端）与 LLVM 默认 struct 布局同规则，故两后端一致。
// 空 struct 两后端不一致（C=1 / LLVM=0），一律返回 -1 不给答案。
fn mb_struct_align(d: i64, depth: i64) i64 {
    var dn: Node = nodes[d];
    var maxa: i64 = 0;
    var c: i64 = dn.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var f: Node = nodes[k.val];
        if (f.ia < 0) {
            var fa: i64 = mb_align_of(f.na, depth + 1);
            if (fa < 0) { return -1; }
            if (fa > maxa) { maxa = fa; }
        }
        c = k.next;
    }
    if (maxa == 0) { return -1; }
    return maxa;
}

fn mb_struct_size(d: i64, depth: i64) i64 {
    var dn: Node = nodes[d];
    var off: i64 = 0;
    var maxa: i64 = 0;
    var c: i64 = dn.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var f: Node = nodes[k.val];
        if (f.ia < 0) {
            var fs: i64 = mb_size_of(f.na, depth + 1);
            var fa: i64 = mb_align_of(f.na, depth + 1);
            if (fs < 0) { return -1; }
            if (fa < 0) { return -1; }
            off = mb_round_up(off, fa) + fs;
            if (fa > maxa) { maxa = fa; }
        }
        c = k.next;
    }
    if (maxa == 0) { return -1; }
    return mb_round_up(off, maxa);
}

fn mb_align_of(tn0: i64, depth: i64) i64 {
    if (tn0 < 0) { return -1; }
    if (depth > 16) { return -1; }
    var tn: i64 = mb_bound_type(tn0);
    var n: Node = nodes[tn];
    if (n.kind == "scalar") {
        if (n.sa == "string") { return 8; }
        var z: i64 = mb_scalar_size(n.sa);
        if (z < 0) { return -1; }
        if (z > 8) { return 8; }
        return z;
    }
    if (n.kind == "pointer") { return 8; }
    if (n.kind == "slice") { return 8; }
    if (n.kind == "array") { return mb_align_of(n.na, depth + 1); }
    if (n.kind == "named") {
        var d: i64 = mb_type_decl(n.sa);
        if (d < 0) { return -1; }
        var dn: Node = nodes[d];
        if (dn.kind == "TypeAliasDecl") { return mb_align_of(dn.na, depth + 1); }
        if (dn.kind == "EnumDecl") { return mb_scalar_size(dn.sb); }
        if (dn.kind == "StructDecl") { return mb_struct_align(d, depth + 1); }
        return -1;
    }
    return -1;
}

fn mb_size_of(tn0: i64, depth: i64) i64 {
    if (tn0 < 0) { return -1; }
    if (depth > 16) { return -1; }
    var tn: i64 = mb_bound_type(tn0);
    var n: Node = nodes[tn];
    if (n.kind == "scalar") { return mb_scalar_size(n.sa); }
    if (n.kind == "pointer") { return 8; }
    if (n.kind == "slice") { return 32; }        // TSlice { ptr, len, cap, elem_size }
    if (n.kind == "array") {
        var es: i64 = mb_size_of(n.na, depth + 1);
        var ea: i64 = mb_align_of(n.na, depth + 1);
        if (es < 0) { return -1; }
        if (ea < 0) { return -1; }
        if (n.nb < 0) { return -1; }
        var le: Node = nodes[n.nb];
        if (le.kind != "int") { return -1; }
        return mb_round_up(es, ea) * parse_int_len(le.sa, le.ia);
    }
    if (n.kind == "named") {
        var d: i64 = mb_type_decl(n.sa);
        if (d < 0) { return -1; }
        var dn: Node = nodes[d];
        if (dn.kind == "TypeAliasDecl") { return mb_size_of(dn.na, depth + 1); }
        if (dn.kind == "EnumDecl") { return mb_scalar_size(dn.sb); }
        if (dn.kind == "StructDecl") { return mb_struct_size(d, depth + 1); }
        return -1;
    }
    return -1;
}

// `@zeroed(T)` 的零值：折成普通字面量 / array_lit —— 两个后端零改动。
// 只覆盖整数族 / bool / string / 定长数组（含嵌套）；其余返回 -1 不折。
fn mb_zero_value(tn0: i64, depth: i64) i64 {
    if (tn0 < 0) { return -1; }
    if (depth > 8) { return -1; }
    var tn: i64 = mb_bound_type(tn0);
    var n: Node = nodes[tn];
    if (n.kind == "scalar") {
        if (n.sa == "bool") { return mv_bool(false); }
        if (meta_is_int_type(n.sa)) { return mv_int(0); }
        if (n.sa == "string") { return mk_string("", -1); }
        return -1;
    }
    if (n.kind == "array") {
        if (n.nb < 0) { return -1; }
        var le: Node = nodes[n.nb];
        if (le.kind != "int") { return -1; }
        var cnt: i64 = parse_int_len(le.sa, le.ia);
        if (cnt < 0 || cnt > 65536) { return -1; }
        var h: i64 = -1;
        var t: i64 = -1;
        var i: i64 = 0;
        while (i < cnt) {
            var ev: i64 = mb_zero_value(n.na, depth + 1);
            if (ev < 0) { return -1; }
            t = list_push(h, t, ev);
            if (h < 0) { h = t; }
            i = i + 1;
        }
        return mk_array_lit(h, -1);
    }
    if (n.kind == "named") {
        var d: i64 = mb_type_decl(n.sa);
        if (d < 0) { return -1; }
        var dn: Node = nodes[d];
        if (dn.kind == "TypeAliasDecl") { return mb_zero_value(dn.na, depth + 1); }
        return -1;
    }
    return -1;
}

// 折叠成功 → 字面量节点 id；-1 = 本次折不掉（不报错：可能只是模板尚未实例化）
fn mb_fold(e: i64) i64 {
    var n: Node = nodes[e];
    if (n.sa == "zeroed") {
        if (n.la < 0) { return -1; }
        if (kids[n.la].next >= 0) { return -1; }
        return mb_zero_value(kids[n.la].val, 0);
    }
    if (mb_is_type_query(n.sa) == false) { return -1; }
    var a0: i64 = -1;
    var a1: i64 = -1;
    var cnt: i64 = 0;
    var c: i64 = n.la;
    while (c >= 0) {
        if (cnt == 0) { a0 = kids[c].val; }
        if (cnt == 1) { a1 = kids[c].val; }
        cnt = cnt + 1;
        c = kids[c].next;
    }
    if (n.sa == "type_equal") {
        if (cnt != 2) { return -1; }
        var k1: string = mb_type_key(a0, 0);
        var k2: string = mb_type_key(a1, 0);
        if (k1 == "") { return -1; }
        if (k2 == "") { return -1; }
        return mv_bool(k1 == k2);
    }
    if (cnt != 1) { return -1; }
    if (n.sa == "type_name") {
        var k3: string = mb_type_key(a0, 0);
        if (k3 == "") { return -1; }
        return mk_string(k3, -1);
    }
    var sz: i64 = mb_size_of(a0, 0);
    if (sz < 0) { return -1; }
    return mv_int(sz);
}

// 就地折叠（同 meta_fold_expr：把字面量内容拷回原节点，免去回溯父指针）
fn mb_fold_inplace(e: i64) void {
    var v: i64 = mb_fold(e);
    if (v < 0) { return; }
    var src: Node = nodes[v];
    var dst: Node = nodes[e];
    dst.kind = src.kind;
    dst.sa = src.sa;
    dst.ia = src.ia;
    dst.ba = src.ba;
    dst.na = -1;
    dst.nb = -1;
    dst.nc = -1;
    dst.nd = -1;
    dst.la = src.la;   // @zeroed 折出来的是 array_lit，元素链在 la
    slice_set(nodes, e, dst);
}

// `if (@type_equal(...)) A else B` —— 条件折成 bool 字面量后剪掉未取分支。
// 为什么必须剪：未取分支里的 `@compile_error` 会漏到 check 触发误报，
// docs/meta_design.md §6 的 get_width 模式正依赖此；剪掉后运行期亦零代码。
// **只对「条件原本是 @ 内建」的 if 生效** —— 普通 `if (true)` 分毫不动，零 IR 漂移。
fn mb_prune_if(c: i64, v: i64) void {
    var vn: Node = nodes[v];
    if (vn.na < 0) { return; }
    var cn: Node = nodes[vn.na];
    if (cn.kind != "bool") { return; }
    var take: i64 = vn.lb;
    if (cn.ba) { take = vn.la; }
    if (take < 0) { take = -1; }
    var b: i64 = mk_block(take, -1);
    var k: Child = kids[c];
    k.val = b;
    slice_set(kids, c, k);
}

fn mb_walk_list(head: i64) void {
    var c: i64 = head;
    while (c >= 0) {
        var v: i64 = kids[c].val;
        var pre_mb: bool = false;
        if (v >= 0) {
            var vn: Node = nodes[v];
            if (vn.kind == "if" && vn.na >= 0) {
                if (nodes[vn.na].kind == "mbuiltin") { pre_mb = true; }
            }
        }
        mb_walk(v);
        if (pre_mb) { mb_prune_if(c, v); }
        c = kids[c].next;
    }
}

fn mb_walk(e: i64) void {
    if (e < 0) { return; }
    var n: Node = nodes[e];
    if (n.kind == "mbuiltin") {
        mb_walk_list(n.la);          // 实参里可以再套 `@type_size(...)`
        mb_fold_inplace(e);
        return;
    }
    mb_walk(n.na);
    mb_walk(n.nb);
    mb_walk(n.nc);
    mb_walk(n.nd);
    mb_walk_list(n.la);
    mb_walk_list(n.lb);
    mb_walk_list(n.lc);
}

// 驱动：必须早于 meta_pass —— `meta 8 + @type_size(i64)` 要求内层先成字面量。
// 与 meta_pass 不同，这里连 `meta fn` 体和泛型模板一起走：类型查询是纯查询，
// 不读环境、不产生副作用，提前折叠永远安全；查不动的原样留着即可。
fn mb_pass() void {
    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        mb_walk(decl_list[i]);
        i = i + 1;
    }
}

// CTFE 侧：mb_pass 折不掉的（如 meta fn 体内依赖调用点绑定的类型）在求值时再试一次
// P4 值→类型查询：在 CTFE 期把表达式 e 的静态类型折成类型节点（类型即值）。
// 覆盖 p45 用到的形态：变量 / 浮点 / 字符串 / 结构体 / 结构体字段 / 切片 / 定长数组 /
// 数组元素 / 函数返回值 / 字面量 / cast 表达式。返回类型节点，-1 表示无法确定。
fn meta_type_of_expr(e: i64) i64 {
    if (e < 0) { return -1; }
    var n: Node = nodes[e];
    if (n.kind == "paren" || n.kind == "comptime") { return meta_type_of_expr(n.na); }
    if (n.kind == "int") { return mk_scalar("u8", -1); }       // 字面量按量级推断（小整数 → u8）
    if (n.kind == "float") { return mk_scalar("f64", -1); }
    if (n.kind == "string") { return mk_scalar("string", -1); }
    if (n.kind == "bool") { return mk_scalar("bool", -1); }
    if (n.kind == "cast") { return n.nb; }                      // cast 目标类型节点
    if (n.kind == "ident") {
        var si: i64 = sym_lookup(cur_scope, n.sa);
        if (si < 0) { si = sym_lookup(global_scope, n.sa); }
        if (si < 0) { return -1; }
        var sy: Sym = syms[si];
        // 优先用符号表里已推断出的类型 TI（check 期已填充）；否则回退到声明处类型节点即时 resolve。
        if (sy.ti >= 0) {
            return mk_type_node_from_ti(sy.ti);
        }
        if (sy.decl < 0) { return -1; }
        var dn: Node = nodes[sy.decl];
        var tnn: i64 = -1;
        if (dn.kind == "VarDecl" || dn.kind == "GlobalVarDecl" ||
            dn.kind == "GlobalConstDecl" || dn.kind == "ParamDecl") {
            tnn = dn.na;
        }
        if (tnn < 0) { return -1; }
        var ti: i64 = resolve_ti(tnn);
        if (ti < 0) { return -1; }
        return mk_type_node_from_ti(ti);
    }
    if (n.kind == "member") {
        // 直接用 checker 的中心推断 infer_expr 求成员表达式的静态类型 —— 它本就处理
        // `p.x` 的字段查表（走 StructDecl 字段链 / 方法分派），与运行期取值走同一套
        // 解析，且在校验期（monomorphization 触发点）已经可用，不必依赖
        // find_struct_fields（其 StructDecl.lb 在临近 codegen 才被回填，校验期常为空）。
        // infer_expr 直接返回 TI 下标，mk_type_node_from_ti 接收的也正是 TI 下标。
        var fti: i64 = infer_expr(e);
        if (fti < 0) { return -1; }
        return mk_type_node_from_ti(fti);
    }
    if (n.kind == "index") {
        var bt: i64 = meta_type_of_expr(n.na);
        if (bt < 0) { return -1; }
        var bti: i64 = resolve_ti(bt);
        if (bti < 0) { return -1; }
        var btd: TI = tis[bti];
        // 取元素类型：Array/Slice TI 的 .elem 即元素 TI（与 infer_expr 的 index 分支一致）。
        // ⚠ ti_elem_of(kind, elem) 是「造一个以 elem 为元素的 kind TI」，并非「取 elem」，
        // 用它会把整个数组裹成元素，折出 [0][3]i64 这类畸形类型。
        if (btd.kind == "Array" || btd.kind == "Slice") {
            return mk_type_node_from_ti(btd.elem);
        }
        return -1;
    }
    if (n.kind == "call") {
        if (n.na < 0) { return -1; }
        var cn: Node = nodes[n.na];
        if (cn.kind != "ident") { return -1; }
        var si: i64 = sym_lookup(cur_scope, cn.sa);
        if (si < 0) { si = sym_lookup(global_scope, cn.sa); }
        if (si < 0) { return -1; }
        var sy: Sym = syms[si];
        if (sy.decl < 0) { return -1; }
        var fd: Node = nodes[sy.decl];
        if (fd.kind != "FuncDecl") { return -1; }
        return mk_type_node_from_ti(resolve_ti(fd.na));
    }
    return -1;
}

fn meta_eval_mbuiltin(e: i64) i64 {
    var n: Node = nodes[e];
    // P4 值→类型查询：`@type_of(e)` 在编译期把 e 的静态类型折成类型节点（类型即值）。
    if (n.sa == "type_of") {
        var a0: i64 = -1;
        var c: i64 = n.la;
        if (c >= 0) { a0 = kids[c].val; }
        if (a0 < 0) {
            return meta_fail("T-MTA-E611", "`@type_of` 需要 1 个实参（表达式）", e);
        }
        var tn: i64 = meta_type_of_expr(a0);
        if (tn < 0) {
            return meta_fail("T-MTA-E617", "`@type_of` 无法在编译期确定其实参的静态类型", e);
        }
        return tn;
    }
    // P4 类型即值：@type_val("i64") 把类型名字符串还原为类型节点（编译期值）。
    // 不与 mb_pass 折叠（实参是编译期字符串，非类型查询），只在 CTFE 求值期生效。
    if (n.sa == "type_val") {
        var cnt: i64 = 0;
        var a0: i64 = -1;
        var c: i64 = n.la;
        while (c >= 0) {
            if (cnt == 0) { a0 = kids[c].val; }
            cnt = cnt + 1;
            c = kids[c].next;
        }
        if (cnt != 1) {
            return meta_fail("T-MTA-E611", "`@type_val` 需要 1 个字符串实参（类型名）", e);
        }
        var mv: i64 = meta_eval(a0);
        if (mv < 0) { return -1; }
        var mn: Node = nodes[mv];
        if (mn.kind != "string") {
            return meta_fail("T-MTA-E617", "`@type_val` 的实参须求值为字符串（类型名）", e);
        }
        return type_node_from_ident(mn.sa);
    }
    if (n.sa == "compile_error") {
        var cnt: i64 = 0;
        var a0: i64 = -1;
        var c: i64 = n.la;
        while (c >= 0) {
            if (cnt == 0) { a0 = kids[c].val; }
            cnt = cnt + 1;
            c = kids[c].next;
        }
        if (cnt != 1) {
            return meta_fail("T-MTA-E611", "`@compile_error` 需要 1 个字符串实参", e);
        }
        var mv: i64 = meta_eval(a0);
        if (mv < 0) { return -1; }
        var mn: Node = nodes[mv];
        if (mn.kind != "string") {
            return meta_fail("T-MTA-E601", "`@compile_error` 的实参须求值为字符串", e);
        }
        return meta_fail("T-MTA-E604", mn.sa, e);
    }
    if (mb_is_type_query(n.sa) || n.sa == "zeroed") {
        var v: i64 = mb_fold(e);
        if (v < 0) {
            return meta_fail("T-MTA-E606",
                sb_cat3("`@", n.sa, "` 的类型实参在编译期不可解析"), e);
        }
        return v;
    }
    if (n.sa == "str_from_bytes") {
        var s0: i64 = -1;
        var s1: i64 = -1;
        var sc: i64 = 0;
        var sk: i64 = n.la;
        while (sk >= 0) {
            if (sc == 0) { s0 = kids[sk].val; }
            if (sc == 1) { s1 = kids[sk].val; }
            sc = sc + 1;
            sk = kids[sk].next;
        }
        if (sc != 2) {
            return meta_fail("T-MTA-E611", "`@str_from_bytes` 需要 2 个实参（缓冲区, 长度）", e);
        }
        var bv2: i64 = meta_eval(s0);
        if (bv2 < 0) { return -1; }
        var lv2: i64 = meta_eval(s1);
        if (lv2 < 0) { return -1; }
        return meta_bytes_to_str(e, bv2, lv2);
    }
    return meta_fail("T-MTA-E607",
        sb_cat3("未知的编译期内建 `@", n.sa, "`"), e);
}

fn run_check() void {
    global_scope = scope_new(-1);
    cur_scope = global_scope;
    cur_ret = ti_mk("Void");

    // 模块内联：在注册声明之前把 import 的模块整体并入 decl_list，
    // 再做命名空间重整（`hello.add` → `hello__add`，模块顶层符号加 `别名__` 前缀）。
    // 单文件程序（无 import）零影响：无模块符号 ⇒ 无任何改写。
    resolve_modules();
    mangle_modules();

    // 子句合并 + lambda 提升：必须在 register 之前跑（子句组先并成单一 FuncDecl，
    // 否则同名多条 FuncDecl 会被 register 当成重复定义）。覆盖模块内联后的整张 decl_list。
    desugar_func_clauses();
    desugar_lambdas();

    // 注册分三趟，因为 register_decl 对 FuncDecl **急切解析形参/返回类型**：
    //   A 纯类型声明（struct/enum/flag/flag_set/union/variant）—— 彼此无依赖，只登记名字；
    //   B typealias —— 需要 A 已入表才能 resolve_ti 出目标类型；
    //   C 其余（func / 全局变量 / 全局常量）—— 需要 A、B 齐备。
    // 一趟按声明序注册会让「函数形参类型晚于函数声明」的前向引用误报 T_UNKNOWN_TYPE；
    // import 更是必然踩中 —— load_module_file 把模块声明**追加**在 decl_list 末尾，
    // 入口文件里 `f fn(m: mod.T)` 永远先于 mod 的 StructDecl 被注册。
    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (is_type_decl_node(decl_list[i])) { register_decl(decl_list[i]); }
        i = i + 1;
    }
    var ia: i64 = 0;
    while (ia < n) {
        if (nodes[decl_list[ia]].kind == "TypeAliasDecl") { register_decl(decl_list[ia]); }
        ia = ia + 1;
    }
    var ib: i64 = 0;
    while (ib < n) {
        var dcl: i64 = decl_list[ib];
        if (is_type_decl_node(dcl) == false) {
            if (nodes[dcl].kind != "TypeAliasDecl") { register_decl(dcl); }
        }
        ib = ib + 1;
    }
    desugar_imports();
    mark_call_callees();
    // Phase D：先折 `@type_*` 编译期内建（纯类型查询，无环境依赖），
    // 这样 `meta 8 + @type_size(i64)` 里的内层在 CTFE 看到时已是字面量。
    mb_pass();
    // Phase B：CTFE —— 折叠 `meta <expr>`、执行 `meta { }`。
    // 必须在 check_decl 之前：折叠后 checker 看到的是普通字面量，
    // 双后端也因此无需为 meta 单独发射（见 docs/meta_design.md §9 Phase B）。
    meta_pass();
    // desugar 可能追加合成的 __import_N 函数，重新取长度以便一并检查
    var n2: i64 = slice_len(decl_list) as i64;
    var j: i64 = 0;
    while (j < n2) {
        check_decl(decl_list[j]);
        j = j + 1;
    }
    // 管道降解在 check 期追加的 __pipe_N：上面的长度已冻结，故单独补检。
    // 只补检管道合成函数（而非整段新增尾巴），避免波及 __fmt_N 等既有合成路径的行为。
    var jp: i64 = 0;
    var npd: i64 = slice_len(g_pipe_decls) as i64;
    if (g_pipe_bad == true) { npd = 0; }   // 已有主诊断，别再级联二手噪声
    while (jp < npd) {
        check_decl(g_pipe_decls[jp]);
        jp = jp + 1;
    }
    // P0-2 / P0-3：实例体的补齐检查已落在 instantiate_generic 内部（克隆+代换后即重跑
    // check_func_decl，见 instantiate_generic 末尾注释）——此刻 comptime 形参已具体，
    // 嵌套泛型再单态化与 format/!j 脱糖一并完成，且落在主检查循环/代码生成预处理之前，
    // 脱糖结果直接进入同一趟发射视图。主循环之后不再需要 fixpoint。
    scan_fid_format_atoms();
}

// 标记「作为 call callee 的 member 节点」：`p.clone()`（@derive 生成的方法调用写法）、
// `"t".format(...)` 之类不是字段读，T_UNKNOWN_FIELD 必须放行，否则误报。
// member 节点的 bd 槽在别处未被使用（bd 仅用于 ImportModDecl 的 is_lib_path 标记），故复用。
// 必须在 check 之前跑一遍全节点平坦扫描：infer_expr 拿不到父节点，无法就地判断。
fn mark_call_callees() void {
    var tot: i64 = slice_len(nodes) as i64;
    var i: i64 = 0;
    while (i < tot) {
        var nd: Node = nodes[i];
        if (nd.kind == "call" && nd.na >= 0) {
            var ce: Node = nodes[nd.na];
            if (ce.kind == "member") {
                ce.bd = true;
                slice_set(nodes, nd.na, ce);
            }
        }
        i = i + 1;
    }
}

// fid_format(f) 返回 atom，四个格式名必须进本程序的原子表，且**必须在发射前**入表：
// LLVM 后端的 @t_atom_table 先于函数体发射，发射期再 intern 就漏到表外
// （id ≥ t_atom_count → atom_str 还原成空串）。
// 不能挂在 infer_expr 的 call 分支上——内建调用的实参不会被通用遍历，
// `atom_str(fid_format(f))` 这种嵌套里的内层调用根本不会被 infer 到。
// 故在检查末尾对全节点做一次平坦扫描，两个后端拿到的 id 也因此一致。
fn scan_fid_format_atoms() void {
    var tot: i64 = slice_len(nodes) as i64;
    var i: i64 = 0;
    while (i < tot) {
        var nd: Node = nodes[i];
        if (nd.kind == "call") {
            if (nd.na >= 0) {
                var ce: Node = nodes[nd.na];
                if (ce.kind == "ident" && ce.sa == "fid_format") {
                    fid_intern_fmt_atoms();
                    return;
                }
            }
        }
        i = i + 1;
    }
}

// ── Flag Resolver（复刻 tc0/flag/bitfield.ts resolve）─────────
// 注意：与 checker.checkFlagDecl 不同——overflow 先检、overlap 后检；
// FlagSetDecl 不产生诊断。

var fr_names: []string;
var fr_starts: []i64;
var fr_ends: []i64;

fn fr_resolve_flag(d: i64) void {
    var n: Node = nodes[d];
    var tw: i64 = get_bw(n.sb);
    if (tw < 0) {
        tw = 32;
    }
    var auto_off: i64 = 0;
    var base: i64 = slice_len(fr_names) as i64;

    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var sl: Node = nodes[k.val];
        var start: i64 = auto_off;
        if (sl.bb) {
            start = sl.ib;
        }
        var end: i64 = start + sl.ia;

        if (end > tw) {
            var osb: StringBuilder = sb_new();
            sb_append_str(osb, "flag '");
            sb_append_str(osb, n.sa);
            sb_append_str(osb, "' slot '");
            sb_append_str(osb, sl.sa);
            sb_append_str(osb, "' exceeds ");
            sb_append_str(osb, n.sb);
            sb_append_str(osb, " capacity: uses bits ");
            sb_append_i64(osb, start);
            sb_append_str(osb, "-");
            sb_append_i64(osb, end - 1);
            sb_append_str(osb, ", but ");
            sb_append_str(osb, n.sb);
            sb_append_str(osb, " only has ");
            sb_append_i64(osb, tw);
            sb_append_str(osb, " bits");
            var di: i64 = diag_new("T-FLG-E851", "error", sb_to_str(osb), "", 0, 0, 0, 0);
            slb_begin();
            slb_add(sb_cat2("0-", i2s(tw - 1)));
            diag_set_vv(di, slb_head);
            var fx: i64 = fix_one("reduce bit width or use larger underlying type (u64)", "", 0, 0, 0, 0, "flag[u64]");
            diag_set_fs(di, fx);
        }

        var i: i64 = base;
        var total: i64 = slice_len(fr_names) as i64;
        while (i < total) {
            var us: i64 = fr_starts[i];
            var ue: i64 = fr_ends[i];
            if (start < ue && end > us) {
                var msb: StringBuilder = sb_new();
                sb_append_str(msb, "flag slot '");
                sb_append_str(msb, sl.sa);
                sb_append_str(msb, "' (bits ");
                sb_append_i64(msb, start);
                sb_append_str(msb, "-");
                sb_append_i64(msb, end - 1);
                sb_append_str(msb, ") overlaps with '");
                sb_append_str(msb, fr_names[i]);
                sb_append_str(msb, "' (bits ");
                sb_append_i64(msb, us);
                sb_append_str(msb, "-");
                sb_append_i64(msb, ue - 1);
                sb_append_str(msb, ")");
                diag_new("T-FLG-E850", "error", sb_to_str(msb), "", 0, 0, 0, 0);
            }
            i = i + 1;
        }

        append(fr_names, sl.sa);
        append(fr_starts, start);
        append(fr_ends, end);
        auto_off = end;
        c = k.next;
    }
}

fn flag_pass() void {
    // 复刻 index.ts compilePipeline：每个 FlagDecl 被 resolve 两次——
    // 一次经 typeInfoProvider.registerDecl（内部调 flagResolver.resolve），
    // 一次为管线中的直接 flagResolver.resolve(decl)。诊断因此重复两遍。
    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = decl_list[i];
        var nd: Node = nodes[d];
        if (nd.kind == "FlagDecl") {
            fr_resolve_flag(d);
            fr_resolve_flag(d);
        }
        i = i + 1;
    }
}

// ── 注解注册表（复刻 tc0/annotations/registry.ts）─────────────

struct AnnDef {
    name: string;
    spec: string;       // none/string/ident/ident_list/number/mixed
    targets: string;    // ", " 分隔（照 validTargets.join(", ") 顺序）
    depr: bool;
    repl: string;
}

var anndefs: []AnnDef;

fn ad(name: string, spec: string, targets: string) void {
    var a: AnnDef;
    a.name = name;
    a.spec = spec;
    a.targets = targets;
    a.depr = false;
    a.repl = "";
    append(anndefs, a);
}

