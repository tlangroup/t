fn vv_warnings() void {
    slb_add("unused");
    slb_add("unused_field");
    slb_add("dead_code");
    slb_add("overflow_literal");
    slb_add("implicit_cast");
    slb_add("bitfield_overlap");
    slb_add("deprecated");
}

fn vv_cfg() void {
    slb_add("debug");
    slb_add("release");
    slb_add("windows");
    slb_add("linux");
    slb_add("mac");
    slb_add("android");
    slb_add("web");
}

// derive/allow/warn/deny 的 trait/warning 项遍历校验
fn ann_check_items(ai: i64, is_derive: bool, l: i64, c: i64) void {
    var an: Node = nodes[ai];
    var c1: i64 = an.la;
    while (c1 >= 0) {
        var k: Child = kids[c1];
        var arg: Node = nodes[k.val];
        if (arg.kind == "list") {
            var c2: i64 = arg.la;
            while (c2 >= 0) {
                var k2: Child = kids[c2];
                var m: Node = nodes[k2.val];
                var v: string = "";
                if (m.kind == "ident") {
                    v = m.sa;
                }
                ann_check_item(v, is_derive, l, c);
                c2 = k2.next;
            }
        } else {
            var v2: string = "";
            if (arg.kind == "ident") {
                v2 = arg.sa;
            }
            ann_check_item(v2, is_derive, l, c);
        }
        c1 = k.next;
    }
}

fn ann_check_item(v: string, is_derive: bool, l: i64, c: i64) void {
    if (is_derive) {
        if (is_derive_trait(v) == false) {
            var di: i64 = diag_new("T-DER-E500", "error",
                sb_cat3("unsupported derive trait '", v, "'"),
                g_file, l, c, l, c + 20);
            slb_begin();
            vv_derive_traits();
            diag_set_vv(di, slb_head);
        }
        return;
    }
    if (is_valid_warning(v) == false) {
        var di2: i64 = diag_new("T-ANN-E451", "error",
            sb_cat3("unknown warning item '", v, "'"),
            g_file, l, c, l, c + 20);
        slb_begin();
        vv_warnings();
        diag_set_vv(di2, slb_head);
    }
}

// validate（复刻 registry.ts:168）；ai = A 节点索引
fn ann_validate(ai: i64, target: string) void {
    var an: Node = nodes[ai];
    var name: string = an.sa;
    var l: i64 = an.ln as i64;
    var c: i64 = an.cl as i64;
    var name_len: i64 = str_len(name) as i64;
    var di_: i64 = anndef_find(name);

    if (di_ < 0) {
        var d1: i64 = diag_new("T-ANN-E450", "error",
            sb_cat3("unknown annotation '@", name, "'"),
            g_file, l, c, l, c + name_len + 1);
        slb_begin();
        var n: i64 = slice_len(anndefs) as i64;
        var i: i64 = 0;
        while (i < n) {
            var a: AnnDef = anndefs[i];
            slb_add(sb_cat2("@", a.name));
            i = i + 1;
        }
        diag_set_vv(d1, slb_head);
        return;
    }

    var def: AnnDef = anndefs[di_];

    if (def.depr) {
        var msg: string = sb_cat3("annotation '@", name, "' is deprecated");
        if (str_len(def.repl) > 0) {
            msg = sb_cat4(msg, ", use ", def.repl, " instead");
        }
        diag_new("T-ANN-E450", "warning", msg, g_file, l, c, l, c + name_len + 1);
    }

    if (targets_has(def.targets, target) == false) {
        var d2: i64 = diag_new("T-ANN-E452", "error",
            sb_cat6("annotation '@", name, "' cannot be applied to ", target, ", valid targets: ", def.targets),
            g_file, l, c, l, c + name_len + 1);
        slb_begin();
        targets_push_vv(def.targets);
        diag_set_vv(d2, slb_head);
    }

    // ── validateArgs ──
    var argc: i64 = list_count(an.la);

    if (def.spec == "none") {
        if (argc > 0) {
            diag_new("T-ANN-E451", "error",
                sb_cat3("annotation '@", name, "' takes no arguments"),
                g_file, l, c, l, c + name_len + 1);
        }
        return;
    }
    if (def.spec == "string") {
        var bad: bool = argc != 1;
        if (bad == false) {
            var k0: Child = kids[an.la];
            var a0: Node = nodes[k0.val];
            bad = a0.kind != "string";
        }
        if (bad) {
            var d3: i64 = diag_new("T-ANN-E451", "error",
                sb_cat3("annotation '@", name, "' requires exactly one string argument"),
                g_file, l, c, l, c + name_len + 1);
            slb_begin();
            slb_add("@${annotation.name}(\"text\")");
            diag_set_vv(d3, slb_head);
        }
        return;
    }
    if (def.spec == "ident") {
        var bad2: bool = argc != 1;
        var a0k: string = "";
        var a0v: string = "";
        if (argc >= 1) {
            var k1: Child = kids[an.la];
            var a1: Node = nodes[k1.val];
            a0k = a1.kind;
            a0v = a1.sa;
        }
        if (bad2 == false) {
            bad2 = a0k != "ident" && a0k != "list";
        }
        if (bad2) {
            diag_new("T-ANN-E451", "error",
                sb_cat3("annotation '@", name, "' requires one identifier argument"),
                g_file, l, c, l, c + name_len + 1);
        }
        if (name == "cfg" && a0k == "ident") {
            if (is_cfg_cond(a0v) == false && starts_with(a0v, "feature=") == false) {
                var d4: i64 = diag_new("T-ANN-E451", "error",
                    sb_cat3("invalid @cfg condition '", a0v, "'"),
                    g_file, l, c, l, c + name_len + 1);
                slb_begin();
                vv_cfg();
                diag_set_vv(d4, slb_head);
            }
        }
        return;
    }
    if (def.spec == "ident_list") {
        if (argc < 1) {
            diag_new("T-ANN-E451", "error",
                sb_cat3("annotation '@", name, "' requires at least one argument"),
                g_file, l, c, l, c + name_len + 1);
        }
        if (name == "derive") {
            ann_check_items(ai, true, l, c);
        }
        if (name == "allow" || name == "warn" || name == "deny") {
            ann_check_items(ai, false, l, c);
        }
        return;
    }
    if (def.spec == "number") {
        var bad3: bool = argc != 1;
        if (bad3 == false) {
            var k2: Child = kids[an.la];
            var a2: Node = nodes[k2.val];
            bad3 = a2.kind != "number";
        }
        if (bad3) {
            diag_new("T-ANN-E451", "error",
                sb_cat3("annotation '@", name, "' requires one numeric argument"),
                g_file, l, c, l, c + name_len + 1);
        }
        return;
    }
}

// getDeclTarget（复刻 index.ts:181）
fn decl_target(kind: string) string {
    if (kind == "StructDecl") {
        return "struct";
    }
    if (kind == "EnumDecl") {
        return "enum";
    }
    if (kind == "FlagDecl") {
        return "flag";
    }
    if (kind == "FlagSetDecl") {
        return "flag_set";
    }
    if (kind == "UnionDecl") {
        return "union";
    }
    if (kind == "VariantDecl") {
        return "variant";
    }
    if (kind == "FuncDecl") {
        return "func";
    }
    if (kind == "GlobalVarDecl") {
        return "var";
    }
    if (kind == "GlobalConstDecl") {
        return "const";
    }
    return "global";
}

fn ann_pass() void {
    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = decl_list[i];
        var nd: Node = nodes[d];
        var target: string = decl_target(nd.kind);
        var c: i64 = nd.la;
        while (c >= 0) {
            var k: Child = kids[c];
            ann_validate(k.val, target);
            c = k.next;
        }
        i = i + 1;
    }
}

fn has_errors() bool {
    var n: i64 = slice_len(diags) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: Diag = diags[i];
        if (d.sev == "error") {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn has_warnings() bool {
    var n: i64 = slice_len(diags) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: Diag = diags[i];
        if (d.sev == "warning") {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// 人类可读的 warning 摘要，写到 stdout（与 check 的 JSON 分开）。
// 成功构建时 stdout 本就为空，故放 stdout 不会污染任何机器通道；
// REPL 把 build 的 stderr 单独重定向，于是 build.log 里只会有这些 warning 行。
fn print_warn_summary() void {
    var n: i64 = slice_len(diags) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: Diag = diags[i];
        if (d.sev == "warning") {
            var line1: string = sb_cat6("warning: ", d.msg, " (", d.file, ":", i2s(d.sl));
            var line2: string = sb_cat3(":", i2s(d.sc), ")\n");
            print(sb_cat2(line1, line2));
        }
        i = i + 1;
    }
}



fn atom_intern(name: string) i64 {
    var i: i64 = 0;
    while (i < g_atom_cnt) {
        if (g_atom_names[i] == name) { return i + 1; }
        i = i + 1;
    }
    append(g_atom_names, name);
    g_atom_cnt = g_atom_cnt + 1;
    return g_atom_cnt;
}


// map 读索引助手：t_map_val_ptr 返回存储值字节指针，按 V 类型解引用。
// 注意：key 需是左值（&k），与 append 字面量取址限制一致。
// 取调用节点的第 ix 个实参节点 id（-1 表示不存在）。
fn call_arg_node(cid: i64, ix: i64) i64 {
    if (cid < 0) {
        return -1;
    }
    var cn9: Node = nodes[cid];
    var c9: i64 = cn9.la;
    var j9: i64 = 0;
    while (c9 >= 0) {
        var ck9: Child = kids[c9];
        if (j9 == ix) {
            return ck9.val;
        }
        j9 = j9 + 1;
        c9 = ck9.next;
    }
    return -1;
}


// 读路径 v1 仅支持：标量数值 / bool / atom / string。聚合类型（struct/array/slice/map/pointer）读属 v2。
fn deser_supported(td: i64) bool {
    if (td < 0) { return false; }
    var t: TD = tds[td];
    if (t.cat == "string") { return true; }
    if (t.cat == "scalar") {
        var nm: string = td_sname(td);
        if (nm == "fid") { return false; }     // 不能从文件读 fid 句柄
        return nm == "atom" || nm == "bool" || is_int_name(nm) || is_float_name(nm);
    }
    return false;
}


fn deser_type_of(nb: i64) i64 {
    if (nb < 0) { return td_mk("unknown"); }
    var n: Node = nodes[nb];
    if (n.kind == "scalar") { return resolve_type_desc(nb); }   // 类型位置直接写 i64（少见）
    if (n.kind == "paren")  { return deser_type_of(n.na); }
    if (n.kind == "ident") {
        var nm: string = n.sa;
        if (nm == "string") { return td_mk("string"); }
        if (nm == "bool")   { return td_named_mk("scalar", "bool"); }
        if (nm == "atom")   { return td_named_mk("scalar", "atom"); }
        if (nm == "fid")    { return td_named_mk("scalar", "fid"); }
        if (is_int_name(nm) || is_float_name(nm)) { return td_named_mk("scalar", nm); }
        // 命名类型（struct/enum/flag/variant/typealias）。注意**不能**用 tm_get ——
        // 那是 emitter 的 typeMap，check 阶段尚未填充，会把已声明的类型误判成「不是类型」。
        // check 阶段的权威来源是全局符号表里 kind == "type" 的条目。
        var si: i64 = sym_lookup(global_scope, nm);
        if (si >= 0) {
            if (syms[si].kind == "type") { return td_named_mk("named", nm); }
            return td_mk("unknown");                             // 是个值（变量/函数/常量），不是类型
        }
        var g: i64 = tm_get(nm);                                 // 发射期回退（此时符号表已释放）
        if (g >= 0) { return g; }
        // 既不在符号表也不在发射期类型表 → 未定义名字，报错（不再静默 unknown）
        if (menv_find(nm) >= 0) { return td_mk("unknown"); }    // meta 类型/值参数：实例化期已绑定，留待后续解析
        if (gen_tparam_has(nm)) { return td_mk("unknown"); }    // 泛型类型参数（模板定义期尚未绑定）
        fc_err("T-SEM-E200", sb_cat3("未定义类型 `", nm, "`"), nb);
        return td_mk("unknown");
    }
    return resolve_type_desc(nb);                                // slice/array/map/func_type 等真正类型节点
}


// fid_format(f) 会把这四个名字当返回值交给用户，必须保证它们进了原子表。
// LLVM 后端的 @t_atom_table 先于函数体发射，因此只能在检查期调用本函数。
fn fid_intern_fmt_atoms() void {
    var t0: i64 = atom_intern("text");
    var t1: i64 = atom_intern("json");
    var t2: i64 = atom_intern("rawbin");
    var t3: i64 = atom_intern("protobuf");
}


fn js_parse_int(s: string, radix: i64) i64 {
    var i: u64 = 0;
    var n: u64 = str_len(s);
    var neg: bool = false;
    if (i < n) {
        if (s[i] == 43 || s[i] == 45) {
            if (s[i] == 45) {
                neg = true;
            }
            i = i + 1;
        }
    }
    if (radix == 16 && i + 1 < n) {
        if (s[i] == 48 && (s[i + 1] == 120 || s[i + 1] == 88)) {
            i = i + 2;
        }
    }
    // 八进制字面量文本带 `0o` 前缀（`o` 在按位解析里会被当成非法字符而提前收工，
    // 结果恒为 0）—— 与 radix=16 的 `0x` 一样必须先跳掉。
    if (radix == 8 && i + 1 < n) {
        if (s[i] == 48 && (s[i + 1] == 111 || s[i + 1] == 79)) {
            i = i + 2;
        }
    }
    if (radix == 2 && i + 1 < n) {
        if (s[i] == 48 && (s[i + 1] == 98 || s[i + 1] == 66)) {
            i = i + 2;
        }
    }
    var val: i64 = 0;
    while (i < n) {
        var c: u8 = s[i];
        var d: i64 = -1;
        if (c >= 48 && c <= 57) {
            d = (c - 48) as i64;
        }
        if (c >= 97 && c <= 122) {
            d = (c - 87) as i64;
        }
        if (c >= 65 && c <= 90) {
            d = (c - 55) as i64;
        }
        if (d < 0 || d >= radix) {
            break;
        }
        val = val * radix + d;
        i = i + 1;
    }
    if (neg) {
        return 0 - val;
    }
    return val;
}


// 该节点是否由 parse_cmp 的 tok_type_only 分支（parse_type）产出 —— 即「一望即知是类型、
// 不可能是值」的节点。用于左操作数非 fid 时给出准确诊断。
fn node_type_only(nb: i64) bool {
    if (nb < 0) { return false; }
    var k: string = nodes[nb].kind;
    return k == "scalar" || k == "map";
}


// `fid > X` 反序列化的右操作数是否「一望即知是值」—— 这些节点形态不可能是类型。
// 必须显式拦：resolve_type_desc 对未知 kind 静默兜底成 unknown，调用方又静默 return，
// 于是 `f > 123` 整条表达式零诊断（f43）。ident 需查符号表区分类型名与变量/函数。
fn deser_rhs_is_value(nb: i64) bool {
    if (nb < 0) { return false; }
    var n: Node = nodes[nb];
    var k: string = n.kind;
    if (k == "paren") { return deser_rhs_is_value(n.na); }
    if (k == "int" || k == "float" || k == "string" || k == "bool") { return true; }
    if (k == "null" || k == "number" || k == "flag" || k == "flag_set") { return true; }
    if (k == "call" || k == "binary" || k == "unary" || k == "cast") { return true; }
    if (k == "index" || k == "member") { return true; }
    if (k == "array_lit" || k == "map_lit" || k == "struct_lit") { return true; }
    if (k == "lambda" || k == "closure_make" || k == "match") { return true; }
    if (k == "ident") {
        var nm: string = n.sa;
        // 内建标量/关键字型类型名走 ident 形态到达此处，先排除
        if (nm == "string" || nm == "bool" || nm == "atom" || nm == "fid") { return false; }
        if (is_int_name(nm) || is_float_name(nm)) { return false; }
        var si: i64 = sym_lookup(cur_scope, nm);
        if (si < 0) { si = sym_lookup(global_scope, nm); }
        if (si >= 0) { return syms[si].kind != "type"; }
        return false;              // 未知名字 → 交给 deser_type_of 报 T_UNKNOWN_TYPE
    }
    return false;
}


fn resolve_type_desc(tn: i64) i64 {
    if (tn < 0) {
        return td_mk("unknown");
    }
    var n: Node = nodes[tn];
    if (n.kind == "scalar") {
// >>> GEN:td_scalar (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
        if (n.sa == "string") { return td_mk("string"); }
        if (n.sa == "void") { return td_mk("void"); }
        if (n.sa == "StringBuilder") { return td_named_mk("named", "TSb*"); }
        if (n.sa == "bytes") { return td_mk("bytes"); }
        if (n.sa == "BytesBuilder") { return td_named_mk("named", "TSb*"); }
        return td_named_mk("scalar", n.sa);
// <<< GEN:td_scalar <<<
    }
// >>> GEN:td_rslice (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
    if (n.kind == "slice") {
        return td_elem_mk("slice", resolve_type_desc(n.na));
    }
// <<< GEN:td_rslice <<<
    // 引用类型 `*T`：na=元素类型节点。双后端据此映射到各自指针表示
    // （C 落 long/指针，LLVM 落 ptr）。此前缺失此分支导致 var r1=&a 的
    // 类型描述被 resolve 成 unknown → LLVM alloca 误判为 i64，store 地址时类型冲突。
    if (n.kind == "pointer") {
        return td_elem_mk("pointer", resolve_type_desc(n.na));
    }
    // 定长数组 [N]T：LLVM 后端映射为 [N x T]，C 后端仍走 T[]／T*
    if (n.kind == "array") {
        var ai: i64 = td_elem_mk("array", resolve_type_desc(n.na));
        var alen: i64 = 0;
        if (n.nb >= 0) {
            var le: Node = nodes[n.nb];
            if (le.kind == "int") {
                alen = parse_int_len(le.sa, le.ia);
            }
        }
        var at: TD = tds[ai];
        at.alen = alen;
        slice_set(tds, ai, at);
        return ai;
    }
    if (n.kind == "map") {
        var mi: i64 = td_mk("map");
        var kt: i64 = resolve_type_desc(n.na);
        var vt: i64 = resolve_type_desc(n.nb);
        var t: TD = tds[mi];
        t.key = kt;
        t.val = vt;
        slice_set(tds, mi, t);
        return mi;
    }
    if (n.kind == "sym") {
        var syi: i64 = td_named_mk("sym", n.sa);
        var syt: TD = tds[syi];
        syt.alen = n.ia;
        slice_set(tds, syi, syt);
        return syi;
    }
    // 反射内建类型（M36）：TypeInfo/FieldInfo 为不透明句柄，双后端均落为指针。
    // 必须放在 GEN:td_rnamed 之前——生成区间由 build/ebnf.json 驱动，手改会被覆盖。
    if (n.kind == "named" && n.sa == "TypeInfo") { return td_named_mk("typeinfo", n.sa); }
    if (n.kind == "named" && n.sa == "FieldInfo") { return td_named_mk("fieldinfo", n.sa); }
    // 裸 `Sym` = 默认 32 位池的一级符号句柄（docs/meta_design.md §8）。
    // 用户自己声明过 `Sym` 类型时以用户为准（tc.tc 自身就有一个 Sym struct）。
    if (n.kind == "named" && n.sa == "Sym" && mb_type_decl("Sym") < 0) {
        var bsy: i64 = td_named_mk("sym", "");
        var bst: TD = tds[bsy];
        bst.alen = 32;
        slice_set(tds, bsy, bst);
        return bsy;
    }
// >>> GEN:td_rnamed (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
    if (n.kind == "named") {
        var nm: string = n.sa;
        // 校验名字是已声明类型（check 期符号表）或发射期类型表命中；否则未定义类型，报错。
        // 先查 tm_get：发射期类型表已建则直接返回（避免在「符号表已释放」时调 sym_lookup）。
        // meta 类型参数实例化期已被替换为具体类型，若仍以 named 形态到达则排除 meta 环境绑定。
        if (tm_get(nm) >= 0) { return td_named_mk("named", nm); }
        var si: i64 = sym_lookup(global_scope, nm);
        if (si >= 0 && syms[si].kind == "type") { return td_named_mk("named", nm); }
        if (menv_find(nm) >= 0) { return td_named_mk("named", nm); }
        if (gen_tparam_has(nm)) { return td_named_mk("named", nm); }
        fc_err("T-SEM-E200", sb_cat3("未定义类型 `", nm, "`"), tn);
        return td_mk("unknown");
    }
// <<< GEN:td_rnamed <<<
    if (n.kind == "func_type") {
        // 与 resolve_ti 同理：先收进局部表再整段搬入，保证参数区连续。
        var fret: i64 = resolve_type_desc(n.na);
        var fbuf: []i64;
        var fk: i64 = n.la;
        while (fk >= 0) {
            var fc: Child = kids[fk];
            append(fbuf, resolve_type_desc(fc.val));
            fk = fc.next;
        }
        var fpstart: i64 = slice_len(tdf_params) as i64;
        var fpc: i64 = slice_len(fbuf) as i64;
        var fj: i64 = 0;
        while (fj < fpc) {
            append(tdf_params, fbuf[fj]);
            fj = fj + 1;
        }
        return td_func(fret, fpstart, fpc);
    }
    return td_mk("unknown");
}


// TD → TI（读路径结果类型为裸 T）。
fn ti_from_td(td: i64) i64 {
    if (td < 0) { return ti_mk("Unknown"); }
    var t: TD = tds[td];
    if (t.cat == "string") { return ti_mk("String"); }
    if (t.cat == "bytes") { return ti_mk("Bytes"); }
    if (t.cat == "scalar") { return ti_scalar(td_sname(td)); }
    return ti_mk("Unknown");
}


// 字段类型可读名（用于 TypeInfo 的 type_name 字段，双后端一致）
fn td_readable(td: i64) string {
    if (td < 0) { return "?"; }
    var t: TD = tds[td];
    if (t.cat == "scalar") {
        if (t.name == "") { return "i64"; }
        return t.name;
    }
    if (t.cat == "string") { return "string"; }
    if (t.cat == "bytes") { return "bytes"; }
    if (t.cat == "void") { return "void"; }
    if (t.cat == "unknown") { return "unknown"; }
    if (t.cat == "named") { return t.name; }
    if (t.cat == "typeinfo") { return t.name; }
    if (t.cat == "fieldinfo") { return "FieldInfo"; }
    if (t.cat == "slice") { return sb_cat2("[]", td_readable(t.elem)); }
    if (t.cat == "array") { return sb_cat4("[", i2s(t.alen), "]", td_readable(t.elem)); }
    if (t.cat == "map") { return sb_cat4("map[", td_readable(t.key), "]", td_readable(t.val)); }
    if (t.cat == "sym") { return sb_cat5("Sym", i2s(t.alen), "(\"", t.name, "\")"); }
    if (t.cat == "func") {
        var fb: StringBuilder = sb_new();
        sb_append_str(fb, "fn(");
        var fi: i64 = 0;
        while (fi < tdf_pcount[td]) {
            if (fi > 0) { sb_append_str(fb, ", "); }
            sb_append_str(fb, td_readable(tdf_params[tdf_pstart[td] + fi]));
            fi = fi + 1;
        }
        sb_append_str(fb, ") -> ");
        sb_append_str(fb, td_readable(tdf_ret[td]));
        return sb_to_str(fb);
    }
    return "?";
}


// 探测路径是否存在。直接调用稳健的 file_exists 内建（C fopen 直查 / LLVM @tll_file_exists），
// 取代原先的 sys_run("cmd /c if exist ...") 外 shell 方案——后者在绝对路径下会触发 arena OOM。
fn path_exists(p: string) bool {
    return file_exists(p);
}


var g_atom_cnt: i64 = 0;


// ── Atom 表（M50：Erlang 式原子）──────────────────────────────
// 编译期 intern：名字 → 稳定 i64 id（等价 Erlang 原子表）。
// 同一个名字两次 intern 返回相同 id，故 `:ok == :ok` 恒为真、`match` 按 id 分发。
// 约定 0 为非原子（null 占位），故有效 id 从 1 起。
var g_atom_names: []string;


fn td_elem_mk(cat: string, elem: i64) i64 {
    var i: i64 = td_mk(cat);
    var t: TD = tds[i];
    t.elem = elem;
    slice_set(tds, i, t);
    return i;
}


// 构造函数类型 TD：参数类型须已 append 到 tdf_params[pstart .. pstart+pcount)
fn td_func(ret: i64, pstart: i64, pcount: i64) i64 {
    var i: i64 = td_mk("func");
    tdf_ret[i] = ret;
    tdf_pstart[i] = pstart;
    tdf_pcount[i] = pcount;
    return i;
}


fn td_mk(cat: string) i64 {
    var t: TD;
    t.cat = cat;
    t.name = "";
    t.elem = -1;
    t.key = -1;
    t.val = -1;
    t.alen = -1;
    append(tds, t);
    var idx: i64 = (slice_len(tds) as i64) - 1;
    append(tdf_ret, -1);
    append(tdf_pstart, -1);
    append(tdf_pcount, 0);
    return idx;
}


fn td_named_mk(cat: string, name: string) i64 {
    var i: i64 = td_mk(cat);
    var t: TD = tds[i];
    t.name = name;
    slice_set(tds, i, t);
    return i;
}

// ── TI → TD（sema 侧副本，供 Array→Slice / 空数组字面量构造 cast 使用）──
fn ti_to_td_base(ti: i64) i64 {
    if (ti < 0) {
        return td_mk("unknown");
    }
    var t: TI = tis[ti];
    if (t.kind == "Scalar") { return td_named_mk("scalar", t.name); }
    if (t.kind == "String") { return td_mk("string"); }
    if (t.kind == "StringBuilder") { return td_named_mk("named", "TSb*"); }
    if (t.kind == "Bytes") { return td_mk("bytes"); }
    if (t.kind == "Void") { return td_mk("void"); }
    if (t.kind == "Slice") { return td_elem_mk("slice", ti_to_td_base(t.elem)); }
    if (t.kind == "Array") {
        var r: i64 = td_elem_mk("array", ti_to_td_base(t.elem));
        var at: TD = tds[r];
        at.alen = t.alen;
        slice_set(tds, r, at);
        return r;
    }
    if (t.kind == "Map") {
        var r: i64 = td_mk("map");
        var mt: TD = tds[r];
        mt.key = ti_to_td_base(t.key);
        mt.val = ti_to_td_base(t.val);
        slice_set(tds, r, mt);
        return r;
    }
    if (t.kind == "Sym") {
        var rs: i64 = td_named_mk("sym", t.name);
        var st: TD = tds[rs];
        st.alen = t.bw;
        slice_set(tds, rs, st);
        return rs;
    }
    if (t.kind == "Named") { return td_named_mk("named", t.name); }
    if (t.kind == "Pointer") { return td_elem_mk("pointer", ti_to_td_base(t.elem)); }
    return td_mk("unknown");
}

// TI → 类型 **AST 节点**（cast 的目标类型必须用这个，不能用 ti_to_td_base 的 td 索引）。
// ⚠ 踩过的坑：sema 侧的 tds 池与 codegen 侧的各一份、索引不通用。把 td 索引填进
// cast.nb 后，codegen 的 resolve_type_desc 会把它当**节点号**解析 —— 小整数恰好
// 命中某个标量节点，于是 Array→Slice 的 cast 退化成 `(i64)arr` 硬转，读垃圾长度。
fn ti_to_type_node(ti: i64) i64 {
    if (ti < 0) { return mk_named("unknown", -1); }
    var t: TI = tis[ti];
    if (t.kind == "Scalar") { return mk_scalar(t.name, -1); }
    if (t.kind == "Void") { return mk_scalar("void", -1); }
    if (t.kind == "String") { return mk_scalar("string", -1); }
    if (t.kind == "StringBuilder") { return mk_scalar("StringBuilder", -1); }
    if (t.kind == "Bytes") { return mk_scalar("bytes", -1); }
    if (t.kind == "Slice") { return mk_slice(ti_to_type_node(t.elem), -1); }
    // ⚠ mk_int 的第二参数是 RADIX 不是值：长度必须按十进制写。
    if (t.kind == "Array") {
        return mk_array(ti_to_type_node(t.elem), mk_int(i2s(t.alen), 10, -1), -1);
    }
    if (t.kind == "Map") {
        return mk_map(ti_to_type_node(t.key), ti_to_type_node(t.val), -1);
    }
    if (t.kind == "Pointer") { return mk_pointer(ti_to_type_node(t.elem), -1); }
    if (t.kind == "Optional") { return mk_optional(ti_to_type_node(t.elem), -1); }
    if (t.kind == "Sym") { return mk_sym(t.name, t.bw, -1); }
    return mk_named(t.name, -1);
}


// td 的标量名（"" = 非标量）；enum/flag/alias 归一到底层标量
fn td_sname(td: i64) string {
    if (td < 0) {
        return "i64";
    }
    var t: TD = tds[td];
    if (t.cat == "scalar") {
        if (t.name == "") {
            return "i64";
        }
        return t.name;
    }
    // Sym 底层是无符号 id：Sym16→u16、Sym32→u32（供比较/运算取正确 LLVM 位宽）
    if (t.cat == "sym") {
        if (t.alen == 16) { return "u16"; }
        return "u32";
    }
    if (t.cat == "unknown") {
        return "i64";
    }
    if (t.cat == "named") {
        var i: i64 = llt_find(t.name);
        if (i < 0) {
            return "";
        }
        var k: string = llt_kinds[i];
        if (k == "enum" || k == "flag") {
            return llt_unders[i];
        }
        if (k == "alias") {
            return td_sname(llt_atd[i]);
        }
        return "";
    }
    return "";
}


fn tm_get(name: string) i64 {
    var n: i64 = slice_len(tm_names) as i64;
    var i: i64 = n - 1;
    while (i >= 0) {
        if (tm_names[i] == name) {
            return tm_tds[i];
        }
        i = i - 1;
    }
    return -1;
}


var llt_atd: []i64;        // alias 目标 td（其余 -1）


fn llt_find(name: string) i64 {
    var n: i64 = slice_len(llt_names) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (llt_names[i] == name) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}


var llt_kinds: []string;   // struct | enum | flag | variant | union | alias


var llt_unders: []string;  // enum/flag 底层标量名


var tm_names: []string;   // 全局 typeMap（globals + "fn()" 返回类型）


var tm_tds: []i64;


var llt_names: []string;
