                    var mfa_k: Child = base.kids[mfa_c];
                    mfa_t = base.list_push(mfa_h, mfa_t, mfa_k.val);
                    if (mfa_h < 0) { mfa_h = mfa_t; }
                    mq_ki7099 = mq_ki7099 + 1;
                    mfa_c = -1;
                }
                base.node_set_na((e as u64), base.mk_ident("format", -1));
                base.node_set_la((e as u64), mfa_h);
                return desugar_format_call(e);
            }
            var mfa_rt: i64 = ie_sub_in(ei, mfa_recv);
            if (tip_kind(mfa_rt) == "String") {
