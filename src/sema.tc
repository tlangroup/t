// ── 元函数观察调试器（--trace-comptime）：纯观察，零语义改动 ──────────
// 把编译期求值产生的 meta value（AST 字面量节点）转成可读串。
pub fn meta_val_to_str(mv: i64) string {
    if (mv < 0) { return "?"; }
    if (base.node_kind((mv as u64)) == "int") { return base.node_sa((mv as u64)); }
    if (base.node_kind((mv as u64)) == "float") { return base.node_sa((mv as u64)); }
    if (base.node_kind((mv as u64)) == "bool") {
        if (base.node_ba((mv as u64))) { return "true"; }
        return "false";
    }
    if (base.node_kind((mv as u64)) == "string") { return base__sb_cat3("`", base.node_sa((mv as u64)), "`"); }
    if (base.node_kind((mv as u64)) == "array_lit") { return "<array>"; }
    if (base.node_kind((mv as u64)) == "struct_lit") { return "<struct>"; }
    if (base.node_kind((mv as u64)) == "closure_make") { return "<closure>"; }
    // type 值（标量 / 命名类型）及任何未知节点：优先取 sa（名字），否则回退 kind
    return meta_type_to_str(mv);
}

// 类型值（类型参数 / 裸类型名）转可读串：优先 sa（类型名），否则 kind。
pub fn meta_type_to_str(tn: i64) string {
    if (tn < 0) { return "?"; }
    if (base.node_sa((tn as u64)) != "") { return base.node_sa((tn as u64)); }
    return base.node_kind((tn as u64));
}

// 编译结束（comptime 求值完毕）后由 run_check 末尾调用一次：
// 把累积的 JSONL 落盘到 out/comptime_trace.jsonl，并打 summary 到 stderr。
pub fn meta_trace_flush() void {
    if (g_meta_trace == false) { return; }
    if (g_meta_trace_calls > 0) {
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, "{");
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, g_q);
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, "ev");
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, g_q);
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, ":");
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, g_q);
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, "summary");
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, g_q);
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, ",");
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, g_q);
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, "calls");
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, g_q);
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, ":");
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, base__i2s(g_meta_trace_calls));
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, ",");
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, g_q);
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, "maxdepth");
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, g_q);
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, ":");
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, base__i2s(g_meta_trace_maxdepth));
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, ",");
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, g_q);
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, "root");
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, g_q);
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, ":");
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, g_q);
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, g_meta_trace_root);
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, g_q);
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, "}\n");
        file_write_all("out/comptime_trace.jsonl", g_meta_trace_jsonl);
        eprint(base__sb_cat3("[trace] summary: ", base__i2s(g_meta_trace_calls), " calls, maxdepth="));
        eprint(base__i2s(g_meta_trace_maxdepth));
        eprint(base__sb_cat3(", root=", g_meta_trace_root, "\n"));
    }
}

// ── 语句执行：0=顺序结束 1=return 2=break 3=continue ──────────
// 阶段1 S4（Q1）：inline for 编译期展开。
// 迭代 iterable（须为编译期已知数组值 array_lit），对每个元素克隆体块、把 elem 绑定到元素值、
// 可选 idx 绑定到元素下标（i64 字面量），执行体。break 仅终止本次展开（消费，返回 0），
// continue 跳到下一元素（返回 0），return 向上传播（返回 1）。展开完全在编译期，不产生运行期循环。
pub fn meta_run_inline_for(s: i64) i64 {
    var arr: i64 = -1;
    if (base.node_na((s as u64)) >= 0) {
        g_meta_err = false;
        if (g_meta_steps < 200000) { g_meta_steps = 200000; }
        arr = meta_eval(base.node_na((s as u64)));
    }
    if (arr < 0 or base.node_kind((arr as u64)) != "array_lit") {
        meta_fail("T-MTA-E622",
            "inline for 的 iterable 必须是编译期已知数组（comptime 数组字面量 / @type_info(...).field_types 等）", s);
        return 0;
    }
    var elem_name: string = base.node_sa((s as u64));
    var idx_name: string = base.node_sb((s as u64));
    var ks: []i64 = base.kids_chain_idx(base.node_la((arr as u64)));   // 元素子节点链（各 .val 为元素值节点）
    var ki: i64 = 0;
    while (ki < slice_len(ks) as i64) {
        var ev: i64 = base__kids[ks[ki]].val;
        var mk: i64 = g_menv_top;
        menv_push(elem_name, meta_val_copy(ev));
        if (str_len(idx_name) > 0) { menv_push(idx_name, mv_int(ki)); }
        // 克隆体语句链（避免逐元素执行污染模板），执行其语句链表。
        // 注意：inline_for 的 la 是「语句链 entry 头」（与 for/for_each/comptime_block 同构），
        // 不是单节点，故须用 clone_kids 克隆链，而非 clone_node（后者会把 entry 头当节点 id 误克隆）。
        var body_clone: i64 = clone_kids(base.node_la((s as u64)));
        var r: i64 = meta_exec(body_clone);
        g_menv_top = mk;   // 回弹本元素作用域（含 elem/idx 与体内部 var）
        if (g_meta_err) { return 0; }
        if (r == 1) { return 1; }   // return 向上传播
        if (r == 2) { return 0; }   // break 终止展开（消费）
        // r == 3 (continue) 或 0 → 进入下一元素
        ki = ki + 1;
    }
    return 0;
}

pub fn meta_exec(head: i64) i64 {
    var c: i64 = head;
    var last_expr_val: i64 = -1;
    var mq_ks12256: []i64 = base.kids_chain_idx(head);
    var mq_ki12256: i64 = 0;
    while (mq_ki12256 < slice_len(mq_ks12256) as i64) {
        c = mq_ks12256[mq_ki12256];
        if (g_meta_err) { return 0; }
        g_meta_steps = g_meta_steps - 1;
        if (g_meta_steps <= 0) {
            meta_fail("T-MTA-E612", "编译期求值步数超预算（疑似不终止的 meta 循环）", base__kids[c].val);
            return 0;
        }
        var k: Child = base__kids[c];
        if (base.node_kind((k.val as u64)) == "var_decl") {
            if (base.node_nb((k.val as u64)) < 0) {
                meta_fail("T-MTA-E617",
                    base__sb_cat3("编译期变量 `", base.node_sa((k.val as u64)), "` 必须有初值"), k.val);
                return 0;
            }
            var iv: i64 = meta_eval(base.node_nb((k.val as u64)));
            if (iv < 0) { return 0; }
            menv_push(base.node_sa((k.val as u64)), meta_val_copy(iv));
        } else if (base.node_kind((k.val as u64)) == "assign") {
            if (meta_do_assign(k.val) == false) { return 0; }
        } else if (base.node_kind((k.val as u64)) == "expr") {
            var inner: i64 = base.node_na((k.val as u64));
            if (inner < 0) {
                meta_fail("T-MTA-E617", "空表达式语句不可编译期求值", k.val);
                return 0;
            }
            if (base.node_kind((inner as u64)) == "assign") {
                if (meta_do_assign(inner) == false) { return 0; }
            } else {
                var dv: i64 = meta_eval(inner);
                if (dv < 0) { return 0; }
                last_expr_val = dv;
            }
        } else if (base.node_kind((k.val as u64)) == "if") {
            var cv: i64 = meta_eval(base.node_na((k.val as u64)));
            if (cv < 0) { return 0; }
            if (base.node_kind((cv as u64)) != "bool") {
                meta_fail("T-MTA-E617", "编译期 if 条件须为 bool", k.val);
                return 0;
            }
            var mk1: i64 = g_menv_top;
            var sv_ret_if: i64 = g_meta_ret;
            var r1: i64 = 0;
            if (base.node_ba((cv as u64))) {
                r1 = meta_exec(base.node_la((k.val as u64)));
            } else {
                if (base.node_lb((k.val as u64)) > -2) { r1 = meta_exec(base.node_lb((k.val as u64))); }
            }
            g_menv_top = mk1;
            // 仅在子块未返回/中断时回弹 g_meta_ret；子块内 return/break/continue 已写入的值须保留。
            // 注意：rN != 0 须原样向上传播（return=1 / break=2 / continue=3），
            // 不可收窄成 rN == 1，否则 if/block 内的 break/continue 会被吞掉导致循环不终止。
            if (r1 == 0) { g_meta_ret = sv_ret_if; }
            if (g_meta_err) { return 0; }
            if (r1 != 0) { return r1; }
        } else if (base.node_kind((k.val as u64)) == "while") {
            while (true) {
                g_meta_steps = g_meta_steps - 1;
                if (g_meta_steps <= 0) {
                    meta_fail("T-MTA-E612",
                        "编译期求值步数超预算（疑似不终止的 meta 循环）", k.val);
                    return 0;
                }
                var wc: i64 = meta_eval(base.node_na((k.val as u64)));
                if (wc < 0) { return 0; }
                if (base.node_kind((wc as u64)) != "bool") {
                    meta_fail("T-MTA-E617", "编译期 while 条件须为 bool", k.val);
                    return 0;
                }
                if (base.node_ba((wc as u64)) == false) { break; }
                var mk2: i64 = g_menv_top;
                var sv_ret_wh: i64 = g_meta_ret;
                var r2: i64 = meta_exec(base.node_la((k.val as u64)));
                g_menv_top = mk2;
                if (r2 == 0) { g_meta_ret = sv_ret_wh; }
                if (g_meta_err) { return 0; }
                if (r2 == 1) { return 1; }
                if (r2 == 2) { break; }
            }
        } else if (base.node_kind((k.val as u64)) == "block" or base.node_kind((k.val as u64)) == "comptime_block") {
            var mk3: i64 = g_menv_top;
            var sv_ret_bl: i64 = g_meta_ret;
            var r3: i64 = meta_exec(base.node_la((k.val as u64)));
            g_menv_top = mk3;
            if (r3 == 0) { g_meta_ret = sv_ret_bl; }
            if (g_meta_err) { return 0; }
            if (r3 != 0) { return r3; }
        } else if (base.node_kind((k.val as u64)) == "inline_for") {
            // 阶段1 S4（Q1）：编译期展开。break/continue 由 meta_run_inline_for 消费（返回 0），
            // 仅 return（返回 1）向上传播。
            var sv_ret_ifo: i64 = g_meta_ret;
            var r4: i64 = meta_run_inline_for(k.val);
            if (r4 == 0) { g_meta_ret = sv_ret_ifo; }
            if (g_meta_err) { return 0; }
            if (r4 != 0) { return r4; }
        } else if (base.node_kind((k.val as u64)) == "return") {
            if (base.node_na((k.val as u64)) < 0) {
                g_meta_ret = -1;
                return 1;
            }
            var rv3: i64 = meta_eval(base.node_na((k.val as u64)));
            if (rv3 < 0) { return 0; }
            g_meta_ret = rv3;
            return 1;
        } else if (base.node_kind((k.val as u64)) == "break") {
            return 2;
        } else if (base.node_kind((k.val as u64)) == "continue") {
            return 3;
        } else {
            meta_fail("T-MTA-E617",
                base__sb_cat3("语句 `", base.node_kind((k.val as u64)), "` 不可编译期执行"), k.val);
            return 0;
        }
        mq_ki12256 = mq_ki12256 + 1;
        c = -1;
    }
    if (last_expr_val >= 0) { g_meta_ret = last_expr_val; return last_expr_val; }
    return 0;
}

pub fn meta_do_assign(a: i64) bool {
    if (base__node_na((a as u64)) < 0) { return false; }
    // `buf[i] = v`：就地改 Child.val —— 编译期数组值就是那个 array_lit 节点本身
    if (base.node_kind((base__node_na((a as u64)) as u64)) == "index") {
        var base: i64 = meta_eval(base__node_na((base__node_na((a as u64)) as u64)));
        if (base < 0) { return false; }
        if (base.node_kind((base as u64)) != "array_lit") {
            meta_fail("T-MTA-E617", "编译期下标赋值的目标须是数组", a);
            return false;
        }
        var ixv: i64 = meta_eval(base__node_nb((base__node_na((a as u64)) as u64)));
        if (ixv < 0) { return false; }
        var ci2: i64 = meta_kid_at(base__node_la((base as u64)), mv_get_int(ixv));
        if (ci2 < 0) {
            meta_fail("T-MTA-E602", "编译期数组下标越界", a);
            return false;
        }
        var nv2: i64 = meta_eval(base__node_nb((a as u64)));
        if (nv2 < 0) { return false; }
        var kc: Child = base__kids[ci2];
        kc.val = nv2;
        slice_set(base__kids, ci2, kc);
        return true;
    }
    if (base.node_kind((base__node_na((a as u64)) as u64)) != "ident") {
        meta_fail("T-MTA-E617", "编译期赋值的目标须是 meta 变量名", a);
        return false;
    }
    var si: i64 = menv_find(base.node_sa((base__node_na((a as u64)) as u64)));
    if (si < 0) {
        meta_fail("T-MTA-E620",
            base__sb_cat3("`", base.node_sa((base__node_na((a as u64)) as u64)), "` 不是编译期实体，meta 上下文不可对其赋值"), a);
        return false;
    }
    var v: i64 = meta_eval(base__node_nb((a as u64)));
    if (v < 0) { return false; }
    slice_set(g_menv_val, si, meta_val_copy(v));
    return true;
}

// ── 折叠 / 执行 ─────────────────────────────────────────────
// `meta <expr>` → 就地变成字面量节点（保留 ln/cl/tv 供诊断定位）
pub fn meta_fold_expr(e: i64) void {
    g_meta_err = false;
    var v: i64 = meta_eval(e);
    if (v < 0) { return; }
    // 就地整节点改写（kind 也会变：comptime 表达式折叠成字面量）⇒ 该节点的 HIR
    // 指令（COMPTIME 等）即失效，必须断开映射，否则后续 infer 会按**折叠前**的
    // 语义标签分派（实测：`int -> comptime` → 读 n.na = -1 → 越界崩溃）。
    hir.hir_invalidate((e as u64));
    base.node_set_kind((e as u64), base.node_kind((v as u64)));
    base.node_set_sa((e as u64), base.node_sa((v as u64)));
    base.node_set_sb((e as u64), base.node_sb((v as u64)));
    base.node_set_ia((e as u64), base.node_ia((v as u64)));
    base__node_set_ba((e as u64), base__node_ba((v as u64)));   // S4 §0.14.7 SoA：侧表访问器（原 .ba；第十批）
    base.node_set_na((e as u64), base.node_na((v as u64)));
    base.node_set_nb((e as u64), base.node_nb((v as u64)));
    base__node_set_nc((e as u64), base__node_nc((v as u64)));   // S4 §0.14.7 SoA：侧表访问器（原 .nc；第九批）
    base__node_set_nd((e as u64), base__node_nd((v as u64)));   // S4 §0.14.7 SoA：侧表访问器（原 .nd）
    base.node_set_la((e as u64), base.node_la((v as u64)));   // array_lit 的元素链（其余字面量此处均为 -1）
    base.node_set_lb((e as u64), base.node_lb((v as u64)));
    base__node_set_lc((e as u64), base__node_lc((v as u64)));   // S4 §0.14.7 SoA：侧表访问器（原 .lc；第十一批）
}

// `meta { ... }` → 编译期执行，随后清空语句表（不产生任何运行期代码）
pub fn meta_run_block(b: i64) void {
    g_meta_err = false;
    var mk4: i64 = g_menv_top;
    var st: i64 = meta_exec(base.node_la((b as u64)));
    g_menv_top = mk4;
    if (g_meta_err) { return; }
    if (st == 1) {
        if (g_meta_quiet == false) {
            parse__fc_err("T-MTA-E609", "meta 块内不允许 return", b);
        }
        return;
    }
    base.node_set_la((b as u64), -1);
}

// 通用子树遍历：只认 na/nb/nc/nd + la/lb/lc 七个槽（未用槽一律 -1），
// 故无需为每种节点写专门的遍历分支。遇 FuncDecl/lambda 即止（由驱动逐个进入）。
pub fn meta_walk_list(head: i64) void {
    var c: i64 = head;
    var mq_ks12439: []i64 = base.kids_chain_idx(head);
    var mq_ki12439: i64 = 0;
    while (mq_ki12439 < slice_len(mq_ks12439) as i64) {
        c = mq_ks12439[mq_ki12439];
        var k: Child = base__kids[c];
        meta_walk(k.val);
        mq_ki12439 = mq_ki12439 + 1;
        c = -1;
    }
}

pub fn meta_walk(e: i64) void {
    if (e < 0) { return; }
    if (base.node_kind((e as u64)) == "FuncDecl" or base.node_kind((e as u64)) == "lambda") { return; }
    if (base.node_kind((e as u64)) == "inline_for") { return; }   // 阶段1 S4：体在 meta_exec 展开期才求值，散列/折叠期不递归其体（避免 elem 未绑定时误折叠）
    if (base.node_kind((e as u64)) == "comptime") {
        meta_walk(base.node_na((e as u64)));          // 先折叠内层，再求值本层
        meta_fold_expr(e);
        return;
    }
    if (base.node_kind((e as u64)) == "comptime_block") {
        meta_run_block(e);
        return;
    }
    meta_walk(base.node_na((e as u64)));
    meta_walk(base.node_nb((e as u64)));
    meta_walk(base.node_nc((e as u64)));
    meta_walk(base.node_nd((e as u64)));   // S4 §0.14.7 SoA：侧表访问器（原 .nd）
    meta_walk_list(base.node_la((e as u64)));
    meta_walk_list(base.node_lb((e as u64)));
    meta_walk_list(base.node_lc((e as u64)));
}

// CTFE 主驱动：必须在 check_decl 之前跑（折叠后 checker 看到的是字面量）。
pub fn meta_pass() void {
    g_menv_top = 0;
    g_menv_base = 0;
    g_menv_nglobal = 0;
    g_meta_depth = 0;
    // ⚠ 预算必须小到「在 arena 耗尽之前触发」：CTFE 每步都在 arena（bump 分配、512MB、
    //   全程不回收，见 runtime/t_runtime.c:67）里新建节点，4000000 步 ≈ 1.3M 轮循环
    //   × 每轮数百字节 > 512MB → 不终止的 comptime 循环会先撞 `arena: out of memory`
    //   runtime_fatal（编译器直接 abort、无诊断），而不是报 T-MTA-E612。
    //   500000 步既留足余量（各处补充下限最高 200000，见本文件 216/414/1593/1746/1845），
    //   又保证越预算时 arena 用量 ~1/6，诊断必定先于崩溃发出。
    //   回归夹具：tests/conformance/fail/f66_meta_budget.tc。
    g_meta_steps = 500000;
    g_me_count = 0;
    g_meta_err = false;
    g_meta_quiet = false;
    // ① 顶层编译期常量入全局环境（按声明顺序可见）。
    //    普通 const 天然编译期已知，一并纳入；求值失败的静默跳过（退化为运行期常量）。
    var n1: i64 = slice_len(lex__decl_list) as i64;
    var i: i64 = 0;
    while (i < n1) {
        var d: i64 = lex__decl_list[i];
        if (base.node_kind((d as u64)) == "GlobalConstDecl" or (base.node_kind((d as u64)) == "GlobalVarDecl" and base__node_bb((d as u64)))) {   // S4 §0.14.7 SoA：侧表读（原 dn.bb）
            if (base.node_nb((d as u64)) >= 0) {
                g_meta_err = false;
                g_meta_quiet = true;
                var gv: i64 = meta_eval(base.node_nb((d as u64)));
                g_meta_quiet = false;
                g_meta_err = false;
                if (gv >= 0) { menv_push(base.node_sa((d as u64)), gv); }
            }
        }
        i = i + 1;
    }
    g_menv_nglobal = g_menv_top;
    g_menv_base = g_menv_top;
    // ② 逐声明折叠 meta 表达式 / 执行 meta 块
    var n2: i64 = slice_len(lex__decl_list) as i64;
    var j: i64 = 0;
    while (j < n2) {
        var d2: i64 = lex__decl_list[j];
        if (base.node_kind((d2 as u64)) == "FuncDecl") {
            // meta fn 本体只在被调用时求值，此处不进入；
            // 泛型模板本体带未绑定类型参数，静默折叠（失败不报错，实例仍走运行期语义）。
            if (base__node_bb((d2 as u64)) == false and base.node_lc((d2 as u64)) != -2) {   // S4 §0.14.7 SoA：侧表读（原 dn2.bb）
                g_menv_top = g_menv_nglobal;
                g_menv_base = g_menv_nglobal;
                g_meta_quiet = func_is_generic(d2);   // 模板体内求值失败静默（实例仍走运行期语义）
                var cvn0: i64 = g_cvar_n;   // S3/Q1：保存 cvar 栈深，函数级 cvar 求值后回弹，避免跨函数泄漏
                meta_register_cvars_of_list(base.node_lc((d2 as u64)));   // S3/Q1：预注册函数体内「持有 type 值的局部变量」
                g_meta_err = false;   // S3/Q1：预扫描求值失败不污染后续 comptime 块折叠
                meta_walk_list(base.node_lc((d2 as u64)));
                g_meta_quiet = false;
                g_cvar_n = cvn0;   // S3/Q1：回弹 cvar 栈（预注册项仅服务于本函数 comptime 块求值）
            }
        } else {
            g_menv_top = g_menv_nglobal;
            g_menv_base = g_menv_nglobal;
            meta_walk(base.node_na((d2 as u64)));
            meta_walk(base.node_nb((d2 as u64)));
            meta_walk(base.node_nc((d2 as u64)));
            meta_walk(base__node_nd((d2 as u64)));   // S4 §0.14.7 SoA：侧表访问器（原 .nd）
        }
        j = j + 1;
    }
    g_menv_top = g_menv_nglobal;
    g_menv_base = g_menv_nglobal;
}

// ══════════════════════════════════════════════════════════════
// M-meta Phase D —— 编译期内建 `@xxx`（docs/compiler/meta_design.md §5）
//
// 表面：表达式位置的 `@name(args)` → `mbuiltin` 节点（sa = 名字，la = 实参链）。
//
// 两类语义：
//  ① 类型查询 `@type_name` / `@type_size` / `@type_equal`
//     纯编译期折叠 —— mb_pass 在 CTFE 之前就地换成 string / int / bool 字面量。
//     **两个后端都无需任何新支持**：它们看到的只有普通字面量。
//  ② `@compile_error(msg)` 不折叠 —— 只有 CTFE 真正执行到才终止编译；
//     折不掉而漏到 check 的一律 T_META_RUNTIME_CTX（宪法第 8 条：编译期/运行期隔离）。
//
// 泛型模板本体里的类型参数尚未绑定（`@type_size(T)` 查无此类型），此时**刻意不折叠**，
// 留到 instantiate_generic 代换掉 T 之后由实例再走一遍 mb_walk（见 instantiate_generic 末尾）。
// ══════════════════════════════════════════════════════════════

pub fn mb_is_type_query(name: string) bool {
    if (name == "type_name" or name == "type_size" or name == "type_equal") { return true; }
    // 对齐 Zig 的 @sizeOf / @alignOf / @bitSizeOf（P0 只读内省）。
    // @size_of 与既有 @type_size 同义；@align_of / @bit_size_of 为新增。
    if (name == "size_of" or name == "align_of" or name == "bit_size_of") { return true; }
    // P1 反射：结构体字段查询，第 0 形参是类型。
    if (name == "has_field" or name == "offset_of") { return true; }
    return false;
}


// 只能在 CTFE 里求值的内建（实参是编译期值，折叠期无从下手）。
// 漏到 check ⇒ 运行期上下文误用 ⇒ T_META_RUNTIME_CTX。
pub fn mb_is_ctfe_only(name: string) bool {
    if (name == "str_from_bytes") { return true; }
    // 编译期诊断/日志内建：只能在 CTFE 求值，漏到运行期 ⇒ T-MTA-E605
    if (name == "compile_log" or name == "compile_warning") { return true; }
    return false;
}

pub fn mb_is_known(name: string) bool {
    if (mb_is_type_query(name)) { return true; }
    if (mb_is_ctfe_only(name)) { return true; }
    if (name == "compile_error" or name == "zeroed") { return true; }
    if (name == "compile_log" or name == "compile_warning") { return true; }
    if (name == "type_val") { return true; }   // P4：类型即值 —— 把类型名字符串还原为类型节点
    if (name == "type_of") { return true; }    // P4：值→类型查询
    return false;
}

// ══════════════════════════════════════════════════════════════
// D4：内建签名注册表 —— 每个 `@`-内建的「首类声明」元数据
// （最少/最多实参个数 + 是否不定长）。D3 的 rest 语义以 `mb_variadic` 为真
// 的内建为消费方：末位（此处即全部位置）吸收余参，绑为编译期聚合后逐个求值。
// 返回 -1 表示「不限上界」。
// ══════════════════════════════════════════════════════════════
pub fn mb_variadic(name: string) bool {
    if (name == "compile_log" or name == "compile_warning") { return true; }
    return false;
}

pub fn mb_arity_min(name: string) i64 {
    if (mb_variadic(name)) { return 1; }
    return -1;   // -1 = 未登记（沿用各分支自带的精确元数检查）
}

pub fn mb_arity_max(name: string) i64 {
    if (mb_variadic(name)) { return -1; }   // -1 = 不定长（无上界）
    return -1;
}


// 具名类型的声明节点（struct / enum / flag / union / variant / typealias）；-1 = 未声明
pub fn mb_type_decl(name: string) i64 {
    var n: i64 = slice_len(lex__decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = lex__decl_list[i];
        if (base.node_sa((d as u64)) == name) {
            var k: string = base.node_kind((d as u64));
            if (k == "StructDecl" or k == "EnumDecl" or k == "TypeAliasDecl") { return d; }
            if (k == "UnionDecl" or k == "VariantDecl") { return d; }
        }
        i = i + 1;
    }
    return -1;
}

// 规范类型名（@type_name 的返回值，同时充当 @type_equal 的比较键）。
// typealias 一律展开到底层：t 没有 newtype 语义，`MyInt i64;` 与 `i64` 是同一个类型，
// 按名比较会给出与 checker 相反的答案。
// 返回 "" = 编译期不可解析（多半是未实例化的类型参数）—— 调用方据此放弃折叠。
// `meta T: type` 形参在 CTFE 帧里绑定成类型节点；类型查询遇到 `named{T}` 先换成绑定值。
// mb_pass 阶段环境为空 → 原样返回（模板本体刻意折不掉，留给实例）。
pub fn mb_bound_type(tn: i64) i64 {
    if (tn < 0) { return -1; }
    var cur: i64 = tn;
    var d: i64 = 0;
    while (d < 16) {
        if (base.node_kind((cur as u64)) != "named") { return cur; }
        var si: i64 = menv_find(base.node_sa((cur as u64)));
        if (si < 0) { return cur; }
        var bt: i64 = g_menv_ty[si];
        if (bt < 0) { return cur; }
        cur = bt;
        d = d + 1;
    }
    return cur;
}

pub fn mb_type_key(tn0: i64, depth: i64) string {
    if (tn0 < 0) { return ""; }
    if (depth > 16) { return ""; }
    var tn: i64 = mb_bound_type(tn0);
    if (base.node_kind((tn as u64)) == "any" or base.node_kind((tn as u64)) == "type") { return ""; }
    if (base.node_kind((tn as u64)) == "named") {
        if (base.node_sa((tn as u64)) == "TypeInfo" or base.node_sa((tn as u64)) == "FieldInfo") { return base.node_sa((tn as u64)); }
        var d: i64 = mb_type_decl(base.node_sa((tn as u64)));
        if (d < 0) { return ""; }
        if (base.node_kind((d as u64)) == "TypeAliasDecl") { return mb_type_key(base.node_na((d as u64)), depth + 1); }
        return base.node_sa((tn as u64));
    }
    if (base.node_kind((tn as u64)) == "slice") {
        var e1: string = mb_type_key(base.node_na((tn as u64)), depth + 1);
        if (e1 == "") { return ""; }
        return base__sb_cat2("[]", e1);
    }
    if (base.node_kind((tn as u64)) == "array") {
        var e2: string = mb_type_key(base.node_na((tn as u64)), depth + 1);
        if (e2 == "") { return ""; }
        if (base.node_nb((tn as u64)) < 0) { return ""; }
        if (base.node_kind((base.node_nb((tn as u64)) as u64)) != "int") { return ""; }
        return base__sb_cat4("[", base__i2s(parse_int_len(base.node_sa((base.node_nb((tn as u64)) as u64)), base.node_ia((base.node_nb((tn as u64)) as u64)))), "]", e2);
    }
    if (base.node_kind((tn as u64)) == "pointer") {
        var e3: string = mb_type_key(base.node_na((tn as u64)), depth + 1);
        if (e3 == "") { return ""; }
        return base__sb_cat2("*", e3);
    }
    if (base.node_kind((tn as u64)) == "optional") {
        var e4: string = mb_type_key(base.node_na((tn as u64)), depth + 1);
        if (e4 == "") { return ""; }
        return base__sb_cat2("?", e4);
    }
    if (base.node_kind((tn as u64)) == "func_type") { return "fn"; }
    var td: i64 = resolve_type_desc(tn);
    var r: string = td_readable(td);
    if (r == "?" or r == "unknown") { return ""; }
    return r;
}

// 标量字节宽度；-1 = 未知。string / StringBuilder 取运行时表示宽度
// （TStr { ptr, len } = 16；TSb* = 8），与 runtime/t_runtime.h 定义一致。
pub fn mb_scalar_size(s: string) i64 {
    if (s == "i8" or s == "u8" or s == "bool") { return 1; }
    if (s == "i16" or s == "u16") { return 2; }
    if (s == "i32" or s == "u32" or s == "f32") { return 4; }
    if (s == "rune") { return 4; }
    if (s == "i64" or s == "u64" or s == "f64") { return 8; }
    if (s == "string") { return 16; }
    if (s == "bytes") { return 16; }
    if (s == "StringBuilder") { return 8; }
    if (s == "BytesBuilder") { return 8; }
    return -1;
}

pub fn mb_round_up(v: i64, a: i64) i64 {
    if (a <= 1) { return v; }
    var r: i64 = v % a;
    if (r == 0) { return v; }
    return v + (a - r);
}

// struct 布局按标准 C ABI 规则算：字段偏移向上取整到字段对齐，整体再取整到
// 最大字段对齐。clang（C 后端）与 LLVM 默认 struct 布局同规则，故两后端一致。
// 空 struct 两后端不一致（C=1 / LLVM=0），一律返回 -1 不给答案。
pub fn mb_struct_align(d: i64, depth: i64) i64 {
    var maxa: i64 = 0;
    var c: i64 = base.node_lb((d as u64));
    while (c >= 0) {
        var k: Child = base__kids[c];
        if (base.node_ia((k.val as u64)) < 0) {
            var fa: i64 = mb_align_of(base.node_na((k.val as u64)), depth + 1);
            if (fa < 0) { return -1; }
            if (fa > maxa) { maxa = fa; }
        }
        c = k.next;
    }
    if (maxa == 0) { return -1; }
    return maxa;
}

// ── 开放维度：overload struct/variant + extend struct/variant 合并 ──
// 在 hir_build 之前运行：把 `extend <kind> X`（ia==2）的字段/构造器链追加到同名
// `overload <kind> X`（ia==1）链尾部，再把 ia==2 节点从 decl_list 移除（避免重复类型注册 /
// 重复发射）。跨文件但同编译单元（二者都在 decl_list）同样合并；单独编译（base 不在 decl_list）
// 或 base 非 overload 组 ⇒ T-OVL-E980（复用函数 overload 的报错码）。
// variant 侧额外：合并后按最终顺序对构造器 tag（VC.ia）连续重编号 0..n-1（D2），
// 并对合并后全集做同名构造器检查 T-OVL-E981（D1 边界）。
// ⚠ 合并只搬字段/构造器；struct 内联方法在 parse 期已脱糖为顶层自由函数（flush_struct_methods），
//   与 StructDecl 节点解耦，故无需在此处理。
pub fn mb_struct_extend_merge() void {
    // 收集 extend 追加（ia==2）的 StructDecl / VariantDecl
    var exts: []i64 = [];
    var n: i64 = slice_len(lex__decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = lex__decl_list[i];
        var kk: string = base__node_kind((d as u64));
        if ((kk == "StructDecl" or kk == "VariantDecl") and base__node_ia((d as u64)) == 2) {
            append(exts, d);
        }
        i = i + 1;
    }
    if (slice_len(exts) == 0) { return; }
    // 合并：把 ext 链链接到 base 链尾部
    var ki: i64 = 0;
    while (ki < slice_len(exts) as i64) {
        var ext: i64 = exts[ki];
        var ename: string = base__node_sa((ext as u64));
        var ekind: string = base__node_kind((ext as u64));
        var kword: string = "variant";
        if (ekind == "StructDecl") { kword = "struct"; }
        var base0: i64 = -1;
        var j: i64 = 0;
        while (j < n) {
            var d2: i64 = lex__decl_list[j];
            var kk2: string = base__node_kind((d2 as u64));
            if (kk2 == ekind and base__node_ia((d2 as u64)) == 1) {
                var bsa: string = base__node_sa((d2 as u64));
                var hit: bool = false;
                if (bsa == ename) { hit = true; }
                if (hit == false and str_len(bsa) > str_len(ename)) {
                    if (str_slice(bsa, str_len(bsa) - str_len(ename), str_len(bsa)) == "__" + ename) { hit = true; }
                }
                if (hit) { base0 = d2; break; }
            }
            j = j + 1;
        }
        if (base0 < 0) {
            parse.fc_err("T-OVL-E980",
                base.sb_cat4("extend '", ename, "' has no matching 'overload ", base.sb_cat2(kword, "' group in this file")),
                ext);
        } else {
            var base_head: i64 = base__node_lb((base0 as u64));
            var ext_head: i64 = base__node_lb((ext as u64));
            if (ext_head >= 0) {
                if (base_head >= 0) {
                    var bt: i64 = base.list_last(base_head);
                    base.list_link(bt, ext_head);
                } else {
                    base.node_set_lb((base0 as u64), ext_head);
                }
            }
            // variant 侧：合并后 tag 重编号 + 同名构造器检查
            if (ekind == "VariantDecl") {
                mb_variant_extend_finalize(base0);
            }
        }
        ki = ki + 1;
    }
    // 从 decl_list 移除已合并的 ext 节点
    var kept: []i64 = [];
    var m: i64 = 0;
    while (m < n) {
        var d3: i64 = lex__decl_list[m];
        var is_ext: bool = false;
        var q: i64 = 0;
        while (q < slice_len(exts) as i64) { if (exts[q] == d3) { is_ext = true; break; } q = q + 1; }
        if (is_ext == false) { append(kept, d3); }
        m = m + 1;
    }
    lex.decl_list = kept;
}

// variant 开放维度收尾（open-variant 设计 D2 / D1 边界）：合并后按最终顺序对构造器
// tag（VC.ia）连续重编号 0..n-1；并对合并后全集做同名构造器检查 T-OVL-E981。
// 必须在 mb_struct_extend_merge 把 ext 链链接到 base 链尾部之后调用。
pub fn mb_variant_extend_finalize(d: i64) void {
    var ks: []i64 = base.kids_chain(base.node_lb((d as u64)));
    // 第一遍：合并后连续重编号 tag（base 段在前、ext 段在后 → 0..n-1 紧凑）
    var ksi: i64 = 0;
    var tag: i64 = 0;
    while (ksi < slice_len(ks) as i64) {
        var kv: i64 = ks[ksi];
        base.node_set_ia((kv as u64), tag);
        tag = tag + 1;
        ksi = ksi + 1;
    }
    // 第二遍：同名构造器检查（D1 边界）
    var names: []string = [];
    var ksi2: i64 = 0;
    while (ksi2 < slice_len(ks) as i64) {
        var kv2: i64 = ks[ksi2];
        var cn: string = base.node_sa((kv2 as u64));
        var dup: bool = false;
        var di: i64 = 0;
        while (di < slice_len(names) as i64) {
            if (names[di] == cn) { dup = true; break; }
            di = di + 1;
        }
        if (dup) {
            parse.fc_err("T-OVL-E981",
                base.sb_cat3("variant extend 重复构造器 `", cn, "`：同一 variant 合并后全集中不允许出现同名 case"),
                kv2);
        } else {
            append(names, cn);
        }
        ksi2 = ksi2 + 1;
    }
}

pub fn mb_struct_size(d: i64, depth: i64) i64 {
    // packed struct：位域顺序打包，尺寸 = 容纳总位宽的最小宿主整型（u8/u16/u32/u64）。
    // 直接由字段位宽求和推导，不依赖 check_packed_layout 的 pk_* 扁平池（避免 meta 折叠期
    // 与声明检查期之间的遍历序耦合）；packed_field_bits 从字段类型名（uN/iN）读出位宽。
    if (base.node_sb((d as u64)) == "packed") {
        var total: i64 = 0;
        var ks: []i64 = base.kids_chain_idx(base.node_lb((d as u64)));
        var ki: i64 = 0;
        while (ki < slice_len(ks) as i64) {
            var bw: i64 = packed_field_bits(base__kids[ks[ki]].val);
            if (bw <= 0) { return -1; }
            total = total + bw;
            ki = ki + 1;
        }
        return mb_scalar_size(packed_host_name(packed_host_bits(total)));
    }
    var off: i64 = 0;
    var maxa: i64 = 0;
    var c: i64 = base.node_lb((d as u64));
    var mq_ks12695: []i64 = base.kids_chain_idx(base.node_lb((d as u64)));
    var mq_ki12695: i64 = 0;
    while (mq_ki12695 < slice_len(mq_ks12695) as i64) {
        c = mq_ks12695[mq_ki12695];
        var k: Child = base__kids[c];
        if (base.node_ia((k.val as u64)) < 0) {
            var fs: i64 = mb_size_of(base.node_na((k.val as u64)), depth + 1);
            var fa: i64 = mb_align_of(base.node_na((k.val as u64)), depth + 1);
            if (fs < 0) { return -1; }
            if (fa < 0) { return -1; }
            off = mb_round_up(off, fa) + fs;
            if (fa > maxa) { maxa = fa; }
        }
        mq_ki12695 = mq_ki12695 + 1;
        c = -1;
    }
    if (maxa == 0) { return -1; }
    return mb_round_up(off, maxa);
}

// ── P1 反射：结构体字段查询 ─────────────────────────────────────
// 复用 mb_struct_size 的 C-ABI 布局算法（字段偏移向上取整到字段对齐，整体再取整到
// 最大字段对齐），逐个字段累加偏移，命中字段名即返回当前偏移。这样 @offset_of 与
// 代码实际内存布局、@size_of 三者严格自洽（已用 Point{x:i64,y:i64}=16 ⇒ x@0 / y@8 校验）。

// 从类型节点解出 StructDecl 节点（decl_list 扫描，mb_pass 期可用）；非命名结构体返回 -1。
pub fn mb_struct_decl_of(tn: i64) i64 {
    if (tn < 0) { return -1; }
    var bt: i64 = mb_bound_type(tn);
    if (base.node_kind((bt as u64)) == "named") {
        return mb_type_decl(base.node_sa((bt as u64)));
    }
    return -1;
}

// 取字段名参数：string 字面量直接读 sa；否则尝试 CTFE 求值（comptime 字符串值）。
// 返回 "" = 折叠期无可解析字符串（交后续阶段处理）。
pub fn mb_read_str_arg(a: i64) string {
    if (a < 0) { return ""; }
    if (base.node_kind((a as u64)) == "string") { return base.node_sa((a as u64)); }
    var mv: i64 = meta_eval(a);
    if (mv >= 0 and base.node_kind((mv as u64)) == "string") { return base.node_sa((mv as u64)); }
    return "";
}

// 结构体是否含某字段名（仅统计普通字段，跳过位域等 node_ia>=0 的成员，与布局算法一致）。
pub fn mb_struct_has_field(sdecl: i64, fname: string) bool {
    if (sdecl < 0 or fname == "") { return false; }
    var c: i64 = -1;
    var ks: []i64 = base.kids_chain_idx(base.node_lb((sdecl as u64)));
    var ki: i64 = 0;
    while (ki < slice_len(ks) as i64) {
        c = ks[ki];
        var k: Child = base__kids[c];
        if (base.node_ia((k.val as u64)) < 0) {
            if (base.node_sa((k.val as u64)) == fname) { return true; }
        }
        ki = ki + 1;
        c = -1;
    }
    return false;
}

// 字段在结构体中的字节偏移；未找到或非结构体返回 -1。
pub fn mb_struct_field_offset(sdecl: i64, fname: string) i64 {
    if (sdecl < 0 or fname == "") { return -1; }
    // packed struct：所有字段按位打包进同一个宿主整型，字节偏移统一为 0
    // （位域访问走 shift/mask，不使用字节偏移）；@offset_of 折成 0 而非报错。
    if (base.node_sb((sdecl as u64)) == "packed") { return 0; }
    var off: i64 = 0;
    var c: i64 = -1;
    var ks: []i64 = base.kids_chain_idx(base.node_lb((sdecl as u64)));
    var ki: i64 = 0;
    while (ki < slice_len(ks) as i64) {
        c = ks[ki];
        var k: Child = base__kids[c];
        if (base.node_ia((k.val as u64)) < 0) {
            var fs: i64 = mb_size_of(base.node_na((k.val as u64)), 0);
            var fa: i64 = mb_align_of(base.node_na((k.val as u64)), 0);
            if (fs < 0) { return -1; }
            if (fa < 0) { return -1; }
            var aligned: i64 = mb_round_up(off, fa);
            if (base.node_sa((k.val as u64)) == fname) { return aligned; }
            off = aligned + fs;
        }
        ki = ki + 1;
        c = -1;
    }
    return -1;
}

// ── `.auto` 优化布局重排（§6.4）──
// 对 node_sb == "auto" 的 StructDecl，按字段（对齐↓、尺寸↓、声明序↑）重排其 node_lb 子链，
// 使字段打包、填充最小（标准 struct packing）。单一真相源 node_lb 只改写一次；
// C 后端（按名字访问）与 LLVM 后端（按位置索引）都从同一条重排链读序，故两后端布局必然一致。
// 在 mb_pass 开头调用 —— run_check 已完成类型注册/解析，尚未有任何偏移/尺寸消费。
pub fn mb_struct_layout_pass() void {
    var n: i64 = slice_len(lex__decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = lex__decl_list[i];
        // 默认布局（node_sb=="auto"）不再自动重排：旧 `#auto` 用户重排已废弃（升级为关键字、无重排语义），
        // 故此处仅对显式 "reorder" 标签生效（当前无产生点，等价于禁用用户结构体自动重排；
        // synthetic 结构体仍按 mb_make_struct 内的 layout=="auto" 重排，属内部优化，不受影响）。
        if (base.node_kind((d as u64)) == "StructDecl" and base.node_sb((d as u64)) == "reorder") {
            mb_struct_reorder(d);
        }
        i = i + 1;
    }
}

pub fn mb_struct_reorder(sdecl: i64) void {
    if (sdecl < 0) { return; }
    var ks: []i64 = base.kids_chain_idx(base.node_lb((sdecl as u64)));
    var nf: i64 = slice_len(ks) as i64;
    if (nf <= 1) { return; }
    // 收集每个字段的（F 节点 id、对齐、尺寸），稳定选择排序得出新顺序 order[]。
    var fids: []i64 = [];
    var faln: []i64 = [];
    var fsiz: []i64 = [];
    var ki: i64 = 0;
    while (ki < nf) {
        var fnode: i64 = base__kids[ks[ki]].val;
        var ft: i64 = base.node_na((fnode as u64));
        var fs: i64 = mb_size_of(ft, 0);
        var fa: i64 = mb_align_of(ft, 0);
        if (fs < 0) { fs = 0; }
        if (fa < 0) { fa = 1; }
        append(fids, fnode);
        append(faln, fa);
        append(fsiz, fs);
        ki = ki + 1;
    }
    // 稳定选择排序：对齐大者优先；对齐相同则尺寸大者优先；再相同保持声明序（严格 > 不交换）。
    var order: []i64 = [];
    var oi: i64 = 0;
    while (oi < nf) { append(order, oi); oi = oi + 1; }
    var a: i64 = 0;
    while (a < nf) {
        var best: i64 = a;
        var b: i64 = a + 1;
        while (b < nf) {
            var better: bool = false;
            if (faln[order[b]] > faln[order[a]]) { better = true; }
            else if (faln[order[b]] == faln[order[a]] and fsiz[order[b]] > fsiz[order[a]]) { better = true; }
            if (better) { best = b; }
            b = b + 1;
        }
        if (best != a) {
            var tmp: i64 = order[a];
            order[a] = order[best];
            order[best] = tmp;
        }
        a = a + 1;
    }
    // 按 order 重建 node_lb 子链（复用 F 节点 id，仅改链接顺序）。
    var head: i64 = -1;
    var tail: i64 = -1;
    var x: i64 = 0;
    while (x < nf) {
        tail = base.list_push(head, tail, fids[order[x]]);
        if (head < 0) { head = tail; }
        x = x + 1;
    }
    base.node_set_lb((sdecl as u64), head);
}

pub fn mb_align_of(tn0: i64, depth: i64) i64 {
    if (tn0 < 0) { return -1; }
    if (depth > 16) { return -1; }
    var tn: i64 = mb_bound_type(tn0);
    if (base.node_kind((tn as u64)) == "scalar") {
        if (base.node_sa((tn as u64)) == "string") { return 8; }
        var z: i64 = mb_scalar_size(base.node_sa((tn as u64)));
        if (z < 0) { return -1; }
        if (z > 8) { return 8; }
        return z;
    }
    if (base.node_kind((tn as u64)) == "pointer") { return 8; }
    if (base.node_kind((tn as u64)) == "slice") { return 8; }
    if (base.node_kind((tn as u64)) == "array") { return mb_align_of(base.node_na((tn as u64)), depth + 1); }
    if (base.node_kind((tn as u64)) == "named") {
        var d: i64 = mb_type_decl(base.node_sa((tn as u64)));
        if (d < 0) { return -1; }
        if (base.node_kind((d as u64)) == "TypeAliasDecl") { return mb_align_of(base.node_na((d as u64)), depth + 1); }
        if (base.node_kind((d as u64)) == "EnumDecl") { return mb_scalar_size(base.node_sb((d as u64))); }
        if (base.node_kind((d as u64)) == "StructDecl") { return mb_struct_align(d, depth + 1); }
        return -1;
    }
    return -1;
}

pub fn mb_size_of(tn0: i64, depth: i64) i64 {
    if (tn0 < 0) { return -1; }
    if (depth > 16) { return -1; }
    var tn: i64 = mb_bound_type(tn0);
    if (base.node_kind((tn as u64)) == "scalar") { return mb_scalar_size(base.node_sa((tn as u64))); }
    if (base.node_kind((tn as u64)) == "pointer") { return 8; }
    if (base.node_kind((tn as u64)) == "slice") { return 32; }        // TSlice { ptr, len, cap, elem_size }
    if (base.node_kind((tn as u64)) == "array") {
        // array 类型节点的 nb 直接存长度整数（非 int 节点），见 base.mk_array / parse.tc mangle。
        var es: i64 = mb_size_of(base.node_na((tn as u64)), depth + 1);
        var ea: i64 = mb_align_of(base.node_na((tn as u64)), depth + 1);
        if (es < 0) { return -1; }
        if (ea < 0) { return -1; }
        var n: i64 = base.node_nb((tn as u64));
        if (n <= 0) { return -1; }
        return mb_round_up(es, ea) * n;
    }
    if (base.node_kind((tn as u64)) == "named") {
        var d: i64 = mb_type_decl(base.node_sa((tn as u64)));
        if (d < 0) {
            // 具名标量类型（u8/i64/…）：mb_type_decl 只认聚合类型，scalar 名直接查 scalar 尺寸表。
            var z: i64 = mb_scalar_size(base.node_sa((tn as u64)));
            if (z >= 0) { return z; }
            return -1;
        }
        if (base.node_kind((d as u64)) == "TypeAliasDecl") { return mb_size_of(base.node_na((d as u64)), depth + 1); }
        if (base.node_kind((d as u64)) == "EnumDecl") { return mb_scalar_size(base.node_sb((d as u64))); }
        if (base.node_kind((d as u64)) == "StructDecl") { return mb_struct_size(d, depth + 1); }
        if (base.node_kind((d as u64)) == "VariantDecl") {
            // 变体布局：uint32_t _tag（4B）+ 最大载荷，按 4 字节对齐。
            var tag: i64 = 4;
            var maxpay: i64 = 0;
            var mc: i64 = base.node_lb((d as u64));
            var mks: []i64 = base.kids_chain_idx(mc);
            var mki: i64 = 0;
            while (mki < slice_len(mks) as i64) {
                var vc: i64 = base__kids[mks[mki]].val;
                var psz: i64 = 0;
                if (base.node_na((vc as u64)) >= 0) {
                    var psv: i64 = mb_size_of(base.node_na((vc as u64)), depth + 1);
                    if (psv > 0) { psz = psv; }
                } else if (base.node_lb((vc as u64)) >= 0) {
                    var fk: []i64 = base.kids_chain_idx(base.node_lb((vc as u64)));
                    var fki: i64 = 0;
                    while (fki < slice_len(fk) as i64) {
                        var fsv: i64 = mb_size_of(base__kids[fk[fki]].val, depth + 1);
                        if (fsv > 0) { psz = psz + fsv; }
                        fki = fki + 1;
                    }
                }
                if (psz > maxpay) { maxpay = psz; }
                mki = mki + 1;
            }
            var total: i64 = tag + maxpay;
            var al: i64 = 4;
            if (total % al != 0) { total = (total / al + 1) * al; }
            return total;
        }
        return -1;
    }
    return -1;
}

// `@zeroed(T)` 的零值：折成普通字面量 / array_lit —— 两个后端零改动。
// 只覆盖整数族 / bool / string / 定长数组（含嵌套）；其余返回 -1 不折。
pub fn mb_zero_value(tn0: i64, depth: i64) i64 {
    if (tn0 < 0) { return -1; }
    if (depth > 8) { return -1; }
    var tn: i64 = mb_bound_type(tn0);
    if (base.node_kind((tn as u64)) == "scalar") {
        if (base.node_sa((tn as u64)) == "bool") { return mv_bool(false); }
        if (meta_is_int_type(base.node_sa((tn as u64)))) { return mv_int(0); }
        if (base.node_sa((tn as u64)) == "string") { return base__mk_string("", -1); }
        return -1;
    }
    if (base.node_kind((tn as u64)) == "array") {
        if (base.node_nb((tn as u64)) < 0) { return -1; }
        if (base.node_kind((base.node_nb((tn as u64)) as u64)) != "int") { return -1; }
        var cnt: i64 = parse_int_len(base.node_sa((base.node_nb((tn as u64)) as u64)), base.node_ia((base.node_nb((tn as u64)) as u64)));
        if (cnt < 0 or cnt > 65536) { return -1; }
        var h: i64 = -1;
        var t: i64 = -1;
        var i: i64 = 0;
        while (i < cnt) {
            var ev: i64 = mb_zero_value(base.node_na((tn as u64)), depth + 1);
            if (ev < 0) { return -1; }
            t = base__list_push(h, t, ev);
            if (h < 0) { h = t; }
            i = i + 1;
        }
        return base__mk_array_lit(h, -1);
    }
    if (base.node_kind((tn as u64)) == "named") {
        var d: i64 = mb_type_decl(base.node_sa((tn as u64)));
        if (d < 0) { return -1; }
        if (base.node_kind((d as u64)) == "TypeAliasDecl") { return mb_zero_value(base.node_na((d as u64)), depth + 1); }
        return -1;
    }
    return -1;
}

// 折叠成功 → 字面量节点 id；-1 = 本次折不掉（不报错：可能只是模板尚未实例化）
pub fn mb_fold(e: i64) i64 {
    if (base.node_sa((e as u64)) == "zeroed") {
        if (base.node_la((e as u64)) < 0) { return -1; }
        if (base__kids[base.node_la((e as u64))].next >= 0) { return -1; }
        return mb_zero_value(base__kids[base.node_la((e as u64))].val, 0);
    }
    if (mb_is_type_query(base.node_sa((e as u64))) == false and base.node_sa((e as u64)) != "has_decl") { return -1; }
    var a0: i64 = -1;
    var a1: i64 = -1;
    var cnt: i64 = 0;
    var c: i64 = base.node_la((e as u64));
    var mq_ks12813: []i64 = base.kids_chain_idx(base.node_la((e as u64)));
    var mq_ki12813: i64 = 0;
    while (mq_ki12813 < slice_len(mq_ks12813) as i64) {
        c = mq_ks12813[mq_ki12813];
        if (cnt == 0) { a0 = base__kids[c].val; }
        if (cnt == 1) { a1 = base__kids[c].val; }
        cnt = cnt + 1;
        mq_ki12813 = mq_ki12813 + 1;
        c = -1;
    }
    // P2b：类型实参允许是「持有 type 值的常量 / 裸类型名」（类型即值）；
    // 已是类型节点的原样返回，不影响既有行为。
    a0 = mb_as_type_node(a0);
    if (base.node_sa((e as u64)) == "type_equal") {
        if (cnt != 2) { return -1; }
        a1 = mb_as_type_node(a1);
        var k1: string = mb_type_key(a0, 0);
        var k2: string = mb_type_key(a1, 0);
        if (k1 == "") { return -1; }
        if (k2 == "") { return -1; }
        return mv_bool(k1 == k2);
    }
    // P1 反射：结构体字段查询（第 0 形参类型，第 1 形参字段名 string）。
    if (base.node_sa((e as u64)) == "has_field") {
        if (cnt != 2) { return -1; }
        var sd: i64 = mb_struct_decl_of(a0);
        var fnm: string = mb_read_str_arg(a1);
        if (fnm == "") { return -1; }
        return mv_bool(mb_struct_has_field(sd, fnm));
    }
    if (base.node_sa((e as u64)) == "offset_of") {
        if (cnt != 2) { return -1; }
        var sd: i64 = mb_struct_decl_of(a0);
        var fnm: string = mb_read_str_arg(a1);
        if (fnm == "") { return -1; }
        var off: i64 = mb_struct_field_offset(sd, fnm);
        if (off < 0) { return -1; }
        return mv_int(off);
    }
    if (cnt != 1) { return -1; }
    var nm: string = base.node_sa((e as u64));
    if (nm == "type_name") {
        var k3: string = mb_type_key(a0, 0);
        if (k3 == "") { return -1; }
        return base__mk_string(k3, -1);
    }
    // 对齐 Zig 的 @sizeOf / @alignOf / @bitSizeOf。
    // t 原有 @type_size 与 @size_of 同义；@align_of / @bit_size_of 为新增。
    // 三者均在 CTFE 前折成 int 字面量，两个后端零改动、零 IR 漂移。
    if (nm == "size_of" or nm == "type_size") {
        var sz: i64 = mb_size_of(a0, 0);
        if (sz < 0) { return -1; }
        return mv_int(sz);
    }
    if (nm == "align_of") {
        var al: i64 = mb_align_of(a0, 0);
        if (al < 0) { return -1; }
        return mv_int(al);
    }
    if (nm == "bit_size_of") {
        var tn: i64 = mb_bound_type(a0);
        if (base.node_kind((tn as u64)) == "scalar") {
            if (base.node_sa((tn as u64)) == "bool") { return mv_int(1); }   // Zig: @bitSizeOf(bool) == 1
            var bz: i64 = mb_scalar_size(base.node_sa((tn as u64)));
            if (bz < 0) { return -1; }
            return mv_int(bz * 8);
        }
        // 复合 / 指针 / slice / 数组：位宽 = 8 * 字节尺寸
        var szc: i64 = mb_size_of(a0, 0);
        if (szc < 0) { return -1; }
        return mv_int(szc * 8);
    }
    // P1 反射：@has_decl(name) —— 编译期查询本编译单元顶层是否存在名为 name 的声明
    // （FuncDecl / StructDecl / EnumDecl / UnionDecl / VariantDecl / VarDecl / ConstDecl /
    // TypeAliasDecl）。扫描 decl_list（mb_pass 期即可用），与 @type_size 的解析路径同源。
    if (nm == "has_decl") {
        if (cnt != 1) { return -1; }
        var dn: string = mb_read_str_arg(a0);
        if (dn == "") { return -1; }
        var hit: bool = false;
        var n: i64 = slice_len(lex__decl_list) as i64;
        var i: i64 = 0;
        while (i < n) {
            var d: i64 = lex__decl_list[i];
            if (base.node_sa((d as u64)) == dn) {
                var k: string = base.node_kind((d as u64));
                if (k == "FuncDecl" or k == "StructDecl" or k == "EnumDecl" or k == "UnionDecl" or k == "VariantDecl" or k == "VarDecl" or k == "ConstDecl" or k == "TypeAliasDecl") { hit = true; }
            }
            i = i + 1;
        }
        return mv_bool(hit);
    }
    // 兜底（原 @type_size 行为）：其余 type query 名字按 size_of 折
    var sz: i64 = mb_size_of(a0, 0);
    if (sz < 0) { return -1; }
    return mv_int(sz);
}

// 就地折叠（同 meta_fold_expr：把字面量内容拷回原节点，免去回溯父指针）
pub fn mb_fold_inplace(e: i64) void {
    var v: i64 = mb_fold(e);
    if (v < 0) { return; }
    // 同 meta_fold_expr：就地改写 kind ⇒ 原 HIR 指令（MBUILTIN 等）失效。
    hir.hir_invalidate((e as u64));
    base.node_set_kind((e as u64), base.node_kind((v as u64)));
    base.node_set_sa((e as u64), base.node_sa((v as u64)));
    base.node_set_ia((e as u64), base.node_ia((v as u64)));
    base__node_set_ba((e as u64), base__node_ba((v as u64)));   // S4 §0.14.7 SoA：侧表访问器（原 .ba；第十批）
    base.node_set_na((e as u64), -1);
    base.node_set_nb((e as u64), -1);
    base__node_set_nc((e as u64), -1);   // S4 §0.14.7 SoA：侧表访问器（原 .nc；第九批）
    base__node_set_nd((e as u64), -1);   // S4 §0.14.7 SoA：侧表访问器（原 .nd）
    base.node_set_la((e as u64), base.node_la((v as u64)));   // @zeroed 折出来的是 array_lit，元素链在 la
}

// ═══════════════════════════════════════════════════════════════
// P2b 类型构造元函数（comptime 合成新类型，返回类型值节点）
// ═══════════════════════════════════════════════════════════════
// synthetic 类型计数器（保证 @struct/@enum 每次调用得到唯一名字，不污染命名空间）。
pub var g_synth_counter: i64 = 0;

// 把「类型值实参」规整为类型节点：已是类型节点则原样返回（不影响既有行为）；
// 否则先 meta_eval（覆盖 `const T = @int(...)` 这类持有 type 值的标识符 / 裸类型名），
// 若结果仍是类型节点则返回，否则 -1。
pub fn mb_as_type_node(a: i64) i64 {
    if (a < 0) { return -1; }
    var k: string = base.node_kind((a as u64));
    if (k == "scalar" or k == "pointer" or k == "slice" or k == "array" or
        k == "func_type" or k == "optional" or k == "any" or k == "type") {
        return a;
    }
    if (k == "named") {
        // 真实类型名原样返回（交给 mb_size_of 等按名解析）；
        // 否则（const 持有 type 值 / 未解析的标识符）尝试编译期求值还原出 type 值节点。
        var nn: string = base.node_sa((a as u64));
        if (is_type_name(nn)) { return a; }
        var gci: i64 = sym_lookup(global_scope, nn);
        if (gci >= 0) {
            var gsy: Sym = syms[gci];
            if (gsy.decl >= 0 and base.node_kind((gsy.decl as u64)) == "GlobalConstDecl") {
                var cinit: i64 = base.node_nb((gsy.decl as u64));
                if (cinit >= 0) {
                    var evn: i64 = meta_eval(cinit);
                    if (evn >= 0) { return evn; }
                }
            }
        }
        return a;
    }
    // 标识符：若是已声明的类型（struct/enum/union/variant/typealias），原样返回，
    // 调用方（@has_decl / @has_field / @offset_of / @size_of）按 sa 读取类型名即可；
    // 避免 meta_eval 把它当「运行期值」查而误报 E620，进而让 @has_decl 折不掉 → 漏到
    // check 期误报 E607（P2b 加 mb_as_type_node 到 mb_fold 后暴露的回归）。
    if (is_type_name(base.node_sa((a as u64)))) { return a; }
    var gci2: i64 = sym_lookup(global_scope, base.node_sa((a as u64)));
    if (gci2 >= 0) {
        var gsy2: Sym = syms[gci2];
        if (gsy2.decl >= 0) {
            var dk2: string = base.node_kind((gsy2.decl as u64));
            if (dk2 == "StructDecl" or dk2 == "EnumDecl" or dk2 == "UnionDecl" or dk2 == "VariantDecl" or dk2 == "TypeAliasDecl") {
                return a;
            }
        }
    }
    // 其余：尝试作为「持有 type 值的 const / 局部编译期变量」求值还原类型节点；
    // 求值失败（如确实是未声明名字）保留原节点返回，让上层（mb_size_of 等）按 -1 报清晰错，
    // 而不在此吞掉信息（避免 @has_decl 这类读 sa 的查询被悄悄破坏）。
    // 用 save/restore 包住 meta_eval：这是「投机求值」，失败不得污染 g_meta_err，
    // 否则会让同一次 comptime 求值里后续的合法 metafunction 被连坐报错。
    var mb_vsave: bool = g_meta_err;
    g_meta_err = false;
    var ev: i64 = meta_eval(a);
    g_meta_err = mb_vsave;
    if (ev < 0) { return a; }
    var ek: string = base.node_kind((ev as u64));
    if (ek == "scalar" or ek == "pointer" or ek == "slice" or ek == "array" or
        ek == "named" or ek == "func_type" or ek == "optional" or ek == "any" or ek == "type") {
        return ev;
    }
    return a;
}

// 取 mbuiltin 第 idx 个实参的子节点（未求值）。
pub fn mb_arg_at(e: i64, idx: i64) i64 {
    var c: i64 = base.node_la((e as u64));
    if (c < 0) { return -1; }
    var ks: []i64 = base.kids_chain_idx(c);
    var ki: i64 = 0;
    var cnt: i64 = 0;
    while (ki < slice_len(ks) as i64) {
        if (cnt == idx) { return base__kids[ks[ki]].val; }
        cnt = cnt + 1;
        ki = ki + 1;
    }
    return -1;
}

// 从 array_lit（元素为类型值）抽取类型节点数组。
pub fn mb_type_nodes_from_array(arr: i64) []i64 {
    var out: []i64;
    if (arr < 0 or base.node_kind((arr as u64)) != "array_lit") { return out; }
    var ks: []i64 = base.kids_chain_idx(base.node_la((arr as u64)));
    var ki: i64 = 0;
    while (ki < slice_len(ks) as i64) {
        var tn: i64 = mb_as_type_node(base__kids[ks[ki]].val);
        append(out, tn);
        ki = ki + 1;
    }
    return out;
}

// 从 array_lit（元素为字符串）抽取字符串数组。
pub fn mb_strings_from_array(arr: i64) []string {
    var out: []string;
    if (arr < 0 or base.node_kind((arr as u64)) != "array_lit") { return out; }
    var ks: []i64 = base.kids_chain_idx(base.node_la((arr as u64)));
    var ki: i64 = 0;
    while (ki < slice_len(ks) as i64) {
        var sv: i64 = meta_eval(base__kids[ks[ki]].val);
        if (sv >= 0 and base.node_kind((sv as u64)) == "string") { append(out, base.node_sa((sv as u64))); }
        ki = ki + 1;
    }
    return out;
}

// 读枚举字面量 / 字符串实参的 tag 文本（@enum_literal("auto") 或裸 "auto" 均可）。
pub fn mb_tag_arg(a: i64) string {
    if (a < 0) { return ""; }
    var ev: i64 = meta_eval(a);
    if (ev >= 0 and base.node_kind((ev as u64)) == "string") { return base.node_sa((ev as u64)); }
    return "";
}

// 读整数实参（bits 等）。
pub fn mb_int_arg(a: i64) i64 {
    var ev: i64 = meta_eval(a);
    if (ev >= 0 and base.node_kind((ev as u64)) == "int") { return mv_get_int(ev); }
    return -1;
}

// 从类型节点或字符串读取底层类型名（@enum 的 backing 既可是类型 i32 也可是字符串 "i32"）。
pub fn mb_type_name_of(a: i64) string {
    var ev: i64 = mb_as_type_node(a);
    if (ev < 0) {
        var sv: i64 = meta_eval(a);
        if (sv >= 0 and base.node_kind((sv as u64)) == "string") { return base.node_sa((sv as u64)); }
        return "";
    }
    var k: string = base.node_kind((ev as u64));
    if (k == "scalar" or k == "named") { return base.node_sa((ev as u64)); }
    if (k == "pointer") { return base.sb_cat2("*", mb_type_name_of(base.node_na((ev as u64)))); }
    return "";
}

// 把 (signedness, bits) 映射到既有标量名（仅支持标准位宽；其余返回 ""）。
pub fn mb_int_scalar_name(sign: string, bits: i64) string {
    if (bits == 8) { if (sign == "signed") { return "i8"; } if (sign == "unsigned") { return "u8"; } }
    if (bits == 16) { if (sign == "signed") { return "i16"; } if (sign == "unsigned") { return "u16"; } }
    if (bits == 32) { if (sign == "signed") { return "i32"; } if (sign == "unsigned") { return "u32"; } }
    if (bits == 64) { if (sign == "signed") { return "i64"; } if (sign == "unsigned") { return "u64"; } }
    return "";
}

// 构造具名 synthetic struct 并返回 named 类型节点（layout: "auto"=优化重排，其他=C ABI）。
pub fn mb_make_struct(layout: string, field_names: []string, field_types: []i64) i64 {
    var n: i64 = slice_len(field_names) as i64;
    if (n != slice_len(field_types) as i64) { return -1; }
    g_synth_counter = g_synth_counter + 1;
    var sname: string = base.sb_cat2("__synth_s", base.i2s(g_synth_counter));
    var fh: i64 = -1; var fht: i64 = -1;
    var i: i64 = 0;
    while (i < n) {
        var fid: i64 = base.mk_F(field_names[i], -1, field_types[i], -1, -1);
        fht = base.list_push(fh, fht, fid);
        if (fh < 0) { fh = fht; }
        i = i + 1;
    }
    var sd: i64 = base.mk_StructDecl(sname, layout, "", false, false, -1, fh, -1);
    if (layout == "auto") { mb_struct_reorder(sd); }
    append(lex.decl_list, sd);
    sym_define(global_scope, sname, "type", ti_named("Struct", sname), sd);
    return base.mk_named(sname, -1);
}

// 构造具名 synthetic enum 并返回 named 类型节点。
pub fn mb_make_enum(backing: string, names: []string) i64 {
    var bname: string = backing;
    if (bname == "") { bname = "i32"; }
    g_synth_counter = g_synth_counter + 1;
    var sname: string = base.sb_cat2("__synth_e", base.i2s(g_synth_counter));
    var ed: i64 = base.mk_EnumDecl(sname, bname, -1, -1, -1);
    append(lex.decl_list, ed);
    sym_define(global_scope, sname, "type", ti_named("Enum", sname), ed);
    return base.mk_named(sname, -1);
}

// 构造具名 synthetic variant（和类型）并返回 named 类型节点。
// backing: 判别子类型名（advisory；t 的 tag 固定为 uint32_t，见 emit_variant_decl）。
// names/types: 各 case 的名字与（单）载荷类型；多载荷用 tuple 类型表达。
// 节点布局对齐 parse_variant_decl：VariantDecl.lb = VC 链，VC.ia = tag 下标、VC.na = 载荷类型。
// 把可能是 ident 的类型实参规范化成真正的类型节点（scalar / named）。
// mb_type_nodes_from_array 对标量名返回 ident（mb_as_type_node 原样返回类型名），
// 而 mb_size_of / register_variant_helpers 认的是 scalar/named 类型节点，故须在此归一。
pub fn mb_norm_type_node(tn: i64) i64 {
    if (tn < 0) { return -1; }
    if (base.node_kind((tn as u64)) == "ident") {
        return type_node_from_ident(base.node_sa((tn as u64)));
    }
    return tn;
}

pub fn mb_make_variant(backing: string, names: []string, types: []i64) i64 {
    var n: i64 = slice_len(names) as i64;
    if (n != slice_len(types) as i64) { return -1; }
    if (n == 0) { return -1; }
    g_synth_counter = g_synth_counter + 1;
    var sname: string = base.sb_cat2("__synth_v", base.i2s(g_synth_counter));
    var ch: i64 = -1; var cht: i64 = -1;
    var i: i64 = 0;
    while (i < n) {
        var tn: i64 = mb_norm_type_node(types[i]);
        var vid: i64;
        if (tn >= 0 and base.node_kind((tn as u64)) == "array_lit") {
            // 多载荷 case：把每个元素类型求值后串成 la 链（na 留 -1）。
            var mp: i64 = -1; var mpt: i64 = -1;
            var ks: []i64 = base.kids_chain_idx(base.node_la((tn as u64)));
            var ki: i64 = 0;
            while (ki < slice_len(ks) as i64) {
                var elt: i64 = mb_norm_type_node(base__kids[ks[ki]].val);
                if (elt >= 0) {
                    mpt = base.list_push(mp, mpt, elt);
                    if (mp < 0) { mp = mpt; }
                }
                ki = ki + 1;
            }
            vid = base.mk_VC(names[i], i, -1, mp, -1);
        } else {
            vid = base.mk_VC(names[i], i, tn, -1, -1);
        }
        cht = base.list_push(ch, cht, vid);
        if (ch < 0) { ch = cht; }
        i = i + 1;
    }
    var vd: i64 = base.mk_VariantDecl(sname, -1, ch, -1);
    append(lex.decl_list, vd);
    sym_define(global_scope, sname, "type", ti_named("Variant", sname), vd);
    return base.mk_named(sname, -1);
}

// 构造元组类型（复用 tuple_lit_type_name 的去重 / 注册机制）。
pub fn mb_make_tuple(elem_types: []i64) i64 {
    var tis: []i64;
    var i: i64 = 0;
    while (i < slice_len(elem_types) as i64) {
        append(tis, resolve_ti(elem_types[i]));
        i = i + 1;
    }
    var sname: string = tuple_lit_type_name(tis);
    return base.mk_named(sname, -1);
}

// `if (@type_equal(...)) A else B` —— 条件折成 bool 字面量后剪掉未取分支。
// 为什么必须剪：未取分支里的 `@compile_error` 会漏到 check 触发误报，
// docs/compiler/meta_design.md §6 的 get_width 模式正依赖此；剪掉后运行期亦零代码。
// **只对「条件原本是 @ 内建」的 if 生效** —— 普通 `if (true)` 分毫不动，零 IR 漂移。
pub fn mb_prune_if(c: i64, v: i64) void {
    if (base.node_na((v as u64)) < 0) { return; }
    if (base.node_kind((base.node_na((v as u64)) as u64)) != "bool") { return; }
    var take: i64 = base.node_lb((v as u64));
    if (base.node_ba((base.node_na((v as u64)) as u64))) { take = base.node_la((v as u64)); }
    if (take < 0) { take = -1; }
    var b: i64 = base__mk_block(take, -1);
    var k: Child = base__kids[c];
    k.val = b;
    slice_set(base__kids, c, k);
}

pub fn mb_walk_list(head: i64) void {
    var c: i64 = head;
    var mq_ks12873: []i64 = base.kids_chain_idx(head);
    var mq_ki12873: i64 = 0;
    while (mq_ki12873 < slice_len(mq_ks12873) as i64) {
        c = mq_ks12873[mq_ki12873];
        var v: i64 = base__kids[c].val;
        var pre_mb: bool = false;
        if (v >= 0) {
            if (base.node_kind((v as u64)) == "if" and base.node_na((v as u64)) >= 0) {
                if (base.node_kind((base.node_na((v as u64)) as u64)) == "mbuiltin") { pre_mb = true; }
            }
        }
        mb_walk(v);
        if (pre_mb) { mb_prune_if(c, v); }
        mq_ki12873 = mq_ki12873 + 1;
        c = -1;
    }
}

pub fn mb_walk(e: i64) void {
    if (e < 0) { return; }
    if (base.node_kind((e as u64)) == "mbuiltin") {
        mb_walk_list(base.node_la((e as u64)));          // 实参里可以再套 `@type_size(...)`
        mb_fold_inplace(e);
        return;
    }
    mb_walk(base.node_na((e as u64)));
    mb_walk(base.node_nb((e as u64)));
    mb_walk(base.node_nc((e as u64)));
    mb_walk(base.node_nd((e as u64)));   // S4 §0.14.7 SoA：侧表访问器（原 .nd）
    mb_walk_list(base.node_la((e as u64)));
    mb_walk_list(base.node_lb((e as u64)));
    mb_walk_list(base.node_lc((e as u64)));
}

// 驱动：必须早于 meta_pass —— `meta 8 + @type_size(i64)` 要求内层先成字面量。
// 与 meta_pass 不同，这里连 `meta fn` 体和泛型模板一起走：类型查询是纯查询，
// 不读环境、不产生副作用，提前折叠永远安全；查不动的原样留着即可。
pub fn mb_pass() void {
    mb_struct_layout_pass();   // §6.4：`.auto` 结构体优化重排（run_check 后、折叠/发射前，单一真相源 node_lb 改一次）
    var n: i64 = slice_len(lex__decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        mb_walk(lex__decl_list[i]);
        i = i + 1;
    }
}

// CTFE 侧：mb_pass 折不掉的（如 meta fn 体内依赖调用点绑定的类型）在求值时再试一次
// P4 值→类型查询：在 CTFE 期把表达式 e 的静态类型折成类型节点（类型即值）。
// 覆盖 p45 用到的形态：变量 / 浮点 / 字符串 / 结构体 / 结构体字段 / 切片 / 定长数组 /
// 数组元素 / 函数返回值 / 字面量 / cast 表达式。返回类型节点，-1 表示无法确定。
pub fn meta_type_of_expr(e: i64) i64 {
    if (e < 0) { return -1; }
    if (base.node_kind((e as u64)) == "paren" or base.node_kind((e as u64)) == "comptime") { return meta_type_of_expr(base.node_na((e as u64))); }
    if (base.node_kind((e as u64)) == "int") { return base__mk_scalar("u8", -1); }       // 字面量按量级推断（小整数 → u8）
    if (base.node_kind((e as u64)) == "float") { return base__mk_scalar("f64", -1); }
    if (base.node_kind((e as u64)) == "string") { return base__mk_scalar("string", -1); }
    if (base.node_kind((e as u64)) == "bool") { return base__mk_scalar("bool", -1); }
    if (base.node_kind((e as u64)) == "unit_lit") { return base__mk_scalar("void", -1); }
    if (base.node_kind((e as u64)) == "cast") { return base.node_nb((e as u64)); }                      // cast 目标类型节点
    if (base.node_kind((e as u64)) == "ident") {
        var si: i64 = sym_lookup(cur_scope, base.node_sa((e as u64)));
        if (si < 0) { si = sym_lookup(global_scope, base.node_sa((e as u64))); }
        if (si < 0) { return -1; }
        var sy: Sym = syms[si];
        // 优先用符号表里已推断出的类型 TI（check 期已填充）；否则回退到声明处类型节点即时 resolve。
        if (sy.ti >= 0) {
            return mk_type_node_from_ti(sy.ti);
        }
        if (sy.decl < 0) { return -1; }
        var tnn: i64 = -1;
        if (base.node_kind((sy.decl as u64)) == "VarDecl" or base.node_kind((sy.decl as u64)) == "GlobalVarDecl" or
            base.node_kind((sy.decl as u64)) == "GlobalConstDecl" or base.node_kind((sy.decl as u64)) == "ParamDecl") {
            tnn = base.node_na((sy.decl as u64));
        }
        if (tnn < 0) { return -1; }
        var ti: i64 = resolve_ti(tnn);
        if (ti < 0) { return -1; }
        return mk_type_node_from_ti(ti);
    }
    if (base.node_kind((e as u64)) == "member") {
        // 直接用 checker 的中心推断 infer_expr 求成员表达式的静态类型 —— 它本就处理
        // `p.x` 的字段查表（走 StructDecl 字段链 / 方法分派），与运行期取值走同一套
        // 解析，且在校验期（monomorphization 触发点）已经可用，不必依赖
        // find_struct_fields（其 StructDecl.lb 在临近 codegen 才被回填，校验期常为空）。
        // infer_expr 直接返回 TI 下标，mk_type_node_from_ti 接收的也正是 TI 下标。
        var fti: i64 = infer_expr(e);
        if (fti < 0) { return -1; }
        return mk_type_node_from_ti(fti);
    }
    if (base.node_kind((e as u64)) == "index") {
        var bt: i64 = meta_type_of_expr(base.node_na((e as u64)));
        if (bt < 0) { return -1; }
        var bti: i64 = resolve_ti(bt);
        if (bti < 0) { return -1; }
        var btd: TI = tis[bti];
        if (btd.kind == "Array" or btd.kind == "Slice") { return mk_type_node_from_ti(btd.elem); }
        if (btd.kind == "Map") { return mk_type_node_from_ti(btd.val); }
        return -1;
        // 取元素类型：Array/Slice TI 的 .elem 即元素 TI（与 infer_expr 的 index 分支一致）。
        // ⚠ ti_elem_of(kind, elem) 是「造一个以 elem 为元素的 kind TI」，并非「取 elem」，
        // 用它会把整个数组裹成元素，折出 [0][3]i64 这类畸形类型。
        if (btd.kind == "Array" or btd.kind == "Slice") {
            return mk_type_node_from_ti(btd.elem);
        }
        if (btd.kind == "Map") {
            return mk_type_node_from_ti(btd.val);
        }
        return -1;
    }
    if (base.node_kind((e as u64)) == "call") {
        if (base.node_na((e as u64)) < 0) { return -1; }
        if (base.node_kind((base.node_na((e as u64)) as u64)) != "ident") { return -1; }
        var si: i64 = sym_lookup(cur_scope, base.node_sa((base.node_na((e as u64)) as u64)));
        if (si < 0) { si = sym_lookup(global_scope, base.node_sa((base.node_na((e as u64)) as u64))); }
        if (si < 0) { return -1; }
        var sy: Sym = syms[si];
        if (sy.decl < 0) { return -1; }
        if (base.node_kind((sy.decl as u64)) != "FuncDecl") { return -1; }
        return mk_type_node_from_ti(resolve_ti(base.node_na((sy.decl as u64))));
    }
    return -1;
}

pub fn meta_eval_mbuiltin(e: i64) i64 {
    // P4 值→类型查询：`@type_of(e)` 在编译期把 e 的静态类型折成类型节点（类型即值）。
    if (base.node_sa((e as u64)) == "type_of") {
        var a0: i64 = -1;
        var c: i64 = base.node_la((e as u64));
        if (c >= 0) { a0 = base__kids[c].val; }
        if (a0 < 0) {
            return meta_fail("T-MTA-E611", "`@type_of` 需要 1 个实参（表达式）", e);
        }
        var tn: i64 = meta_type_of_expr(a0);
        if (tn < 0) {
            return meta_fail("T-MTA-E617", "`@type_of` 无法在编译期确定其实参的静态类型", e);
        }
        return tn;
    }
    // P4 类型即值：@type_val("i64") 把类型名字符串还原为类型节点（编译期值）。
    // 不与 mb_pass 折叠（实参是编译期字符串，非类型查询），只在 CTFE 求值期生效。
    if (base.node_sa((e as u64)) == "type_val") {
        var cnt: i64 = 0;
        var a0: i64 = -1;
        var c: i64 = base.node_la((e as u64));
        var mq_ks13013: []i64 = base.kids_chain_idx(base.node_la((e as u64)));
        var mq_ki13013: i64 = 0;
        while (mq_ki13013 < slice_len(mq_ks13013) as i64) {
            c = mq_ks13013[mq_ki13013];
            if (cnt == 0) { a0 = base__kids[c].val; }
            cnt = cnt + 1;
            mq_ki13013 = mq_ki13013 + 1;
            c = -1;
        }
        if (cnt != 1) {
            return meta_fail("T-MTA-E611", "`@type_val` 需要 1 个字符串实参（类型名）", e);
        }
        var mv: i64 = meta_eval(a0);
        if (mv < 0) { return -1; }
        if (base.node_kind((mv as u64)) != "string") {
            return meta_fail("T-MTA-E617", "`@type_val` 的实参须求值为字符串（类型名）", e);
        }
        return type_node_from_ident(base.node_sa((mv as u64)));
    }
    // ── P2b 类型构造元函数（comptime 合成新类型，返回类型值节点）──
    if (base.node_sa((e as u64)) == "int") {
        var sign: string = mb_tag_arg(mb_arg_at(e, 0));
        var bits: i64 = mb_int_arg(mb_arg_at(e, 1));
        var nm: string = mb_int_scalar_name(sign, bits);
        if (nm == "") {
            return meta_fail("T-MTA-E606",
                base.sb_cat3("`@int` 暂不支持该 (signedness, bits) = (", base.sb_cat2(sign, base.i2s(bits)), ")"), e);
        }
        return base.mk_scalar(nm, -1);
    }
    if (base.node_sa((e as u64)) == "pointer") {
        var tn: i64 = mb_as_type_node(mb_arg_at(e, 0));
        if (tn < 0) { return meta_fail("T-MTA-E606", "`@pointer` 的类型实参在编译期不可解析", e); }
        return base.mk_pointer(tn, -1);
    }
    if (base.node_sa((e as u64)) == "tuple") {
        var arr: i64 = meta_eval(mb_arg_at(e, 0));
        var tns: []i64 = mb_type_nodes_from_array(arr);
        if (slice_len(tns) as i64 == 0) { return meta_fail("T-MTA-E606", "`@tuple` 的类型数组为空或不可解析", e); }
        return mb_make_tuple(tns);
    }
    if (base.node_sa((e as u64)) == "struct") {
        var layout: string = mb_tag_arg(mb_arg_at(e, 0));
        var names: []string = mb_strings_from_array(meta_eval(mb_arg_at(e, 2)));
        var types: []i64 = mb_type_nodes_from_array(meta_eval(mb_arg_at(e, 3)));
        if (slice_len(names) as i64 != slice_len(types) as i64) {
            return meta_fail("T-MTA-E606", "`@struct` 字段名数与类型数不一致", e);
        }
        if (slice_len(names) as i64 == 0) {
            return meta_fail("T-MTA-E606", "`@struct` 至少需要 1 个字段", e);
        }
        return mb_make_struct(layout, names, types);
    }
    if (base.node_sa((e as u64)) == "enum") {
        var backing: string = mb_type_name_of(mb_arg_at(e, 0));
        var names: []string = mb_strings_from_array(meta_eval(mb_arg_at(e, 1)));
        return mb_make_enum(backing, names);
    }
    if (base.node_sa((e as u64)) == "fn") {
        var ret: i64 = mb_as_type_node(mb_arg_at(e, 0));
        if (ret < 0) { return meta_fail("T-MTA-E606", "`@fn` 的返回类型不可解析", e); }
        var params: []i64 = mb_type_nodes_from_array(meta_eval(mb_arg_at(e, 1)));
        var phead: i64 = -1; var pt: i64 = -1;
        var pi: i64 = 0;
        while (pi < slice_len(params) as i64) {
            pt = base.list_push(phead, pt, params[pi]);
            if (phead < 0) { phead = pt; }
            pi = pi + 1;
        }
        return base.mk_func_type(ret, phead, -1);
    }
    if (base.node_sa((e as u64)) == "enum_literal") {
        var tag: string = mb_tag_arg(mb_arg_at(e, 0));
        return base__mk_string(tag, -1);
    }
    // P4：@field(v, "name") —— 编译期按名取结构体值的字段值。
    // 编译期结构体值是 struct_lit 节点，字段挂在 la 的 FV 链上（sa=字段名，na=字段值）。
    if (base.node_sa((e as u64)) == "field") {
        var fv0: i64 = meta_eval(mb_arg_at(e, 0));
        if (fv0 < 0) { return -1; }
        var fname: string = mb_read_str_arg(mb_arg_at(e, 1));
        if (fname == "") { return meta_fail("T-MTA-E606", "`@field` 的字段名须是编译期字符串", e); }
        if (base.node_kind((fv0 as u64)) != "struct_lit") {
            return meta_fail("T-MTA-E617", "`@field` 目前只支持编译期结构体值（struct 字面量）", e);
        }
        var fks: []i64 = base.kids_chain_idx(base.node_la((fv0 as u64)));
        var fki: i64 = 0;
        while (fki < slice_len(fks) as i64) {
            var fvnode: i64 = base__kids[fks[fki]].val;
            if (base.node_sa((fvnode as u64)) == fname) {
                return base.node_na((fvnode as u64));
            }
            fki = fki + 1;
        }
        return meta_fail("T-MTA-E617", base.sb_cat3("`@field` 在结构体值里找不到字段 `", fname, "`"), e);
    }
    // P4：@call(f, args...) —— 编译期按值调用函数。第 0 实参是被调函数，其余为实参；
    // 就地造一个 call 节点复用既有 meta_eval_call（含内置 / 用户 comptime fn 两条路径）。
    if (base.node_sa((e as u64)) == "call") {
        var fnnode: i64 = mb_arg_at(e, 0);
        if (fnnode < 0) { return meta_fail("T-MTA-E606", "`@call` 需要 1 个被调函数实参", e); }
        var cks: []i64 = base.kids_chain_idx(base.node_la((e as u64)));
        var cki: i64 = 1;          // 跳过第 0 个（被调函数）
        var cah: i64 = -1; var cat: i64 = -1;
        while (cki < slice_len(cks) as i64) {
            cat = base.list_push(cah, cat, base__kids[cks[cki]].val);
            if (cah < 0) { cah = cat; }
            cki = cki + 1;
        }
        var cl: i64 = base.mk_call(fnnode, cah, -1);
        return meta_eval(cl);
    }
    // P3：@as(T, v) —— 数值强制。语义沿用既有 cast 分支的效率/回绕约定
    // （meta_int_wrap 负责位宽截断 + 符号重解释），故整数族、浮点、bool 三族互转都支持。
    if (base.node_sa((e as u64)) == "as") {
        var atn0: i64 = mb_as_type_node(mb_arg_at(e, 0));
        if (atn0 < 0) { return meta_fail("T-MTA-E606", "`@as` 的目标类型在编译期不可解析", e); }
        var aname: string = mb_type_name_of(atn0);
        var avv: i64 = meta_eval(mb_arg_at(e, 1));
        if (avv < 0) { return -1; }
        var avk: string = base.node_kind((avv as u64));
        if (meta_is_int_type(aname)) {
            if (avk == "int" or avk == "bool") { return mv_int(meta_int_wrap(mv_get_int(avv), aname)); }
            if (avk == "float") {
                return mv_int(meta_int_wrap(meta_f64_to_int(meta_f64_from_str(base.node_sa((avv as u64)))), aname));
            }
            return meta_fail("T-MTA-E617",
                base.sb_cat3("`@as` 暂不支持把 `", avk, "` 值转换为整数类型"), e);
        }
        if (aname == "f64" or aname == "f32") {
            if (avk == "int" or avk == "bool") { return base__mk_float(meta_f64_to_str(mv_get_int(avv) as f64), -1); }
            if (avk == "float") { return avv; }
            return meta_fail("T-MTA-E617",
                base.sb_cat3("`@as` 暂不支持把 `", avk, "` 值转换为浮点类型"), e);
        }
        if (aname == "bool") {
            if (avk == "int") { return mv_bool(mv_get_int(avv) != 0); }
            if (avk == "bool") { return avv; }
            return meta_fail("T-MTA-E617", "`@as` 的 bool 目标只接受整数 / 布尔源值", e);
        }
        return meta_fail("T-MTA-E617", base.sb_cat3("`@as` 暂不支持目标类型 `", aname, "`"), e);
    }
    // P3：@bit_cast(T, v) —— 按位重解释。整数域内即「按目标位宽截断 + 目标符号性重解释」。
    // ⚠ 刻意**不**支持 float ↔ int：那需要 IEEE-754 位级转换原语，当前缺失；宁可明确报错也不静默错编。
    if (base.node_sa((e as u64)) == "bit_cast") {
        var btn0: i64 = mb_as_type_node(mb_arg_at(e, 0));
        if (btn0 < 0) { return meta_fail("T-MTA-E606", "`@bit_cast` 的目标类型在编译期不可解析", e); }
        var bname: string = mb_type_name_of(btn0);
        var bvv: i64 = meta_eval(mb_arg_at(e, 1));
        if (bvv < 0) { return -1; }
        var bvk: string = base.node_kind((bvv as u64));
        if (meta_is_int_type(bname) and (bvk == "int" or bvk == "bool")) {
            return mv_int(meta_int_wrap(mv_get_int(bvv), bname));
        }
        if (bname == "f64" or bname == "f32") {
            return meta_fail("T-MTA-E617",
                "`@bit_cast` 尚不支持浮点目标（缺 IEEE-754 位级原语）；同一的目标请改用 `@as`", e);
        }
        return meta_fail("T-MTA-E617",
            base.sb_cat3("`@bit_cast` 暂不支持重解释为 `", bname, "`"), e);
    }
    if (base.node_sa((e as u64)) == "variant") {
        var backing: string = mb_type_name_of(mb_arg_at(e, 0));
        var names: []string = mb_strings_from_array(meta_eval(mb_arg_at(e, 1)));
        // ⚠ 刻意**不**先 meta_eval 整个类型数组：`meta_eval_array_lit` 会把元素逐个求值，
        // 外层再 meta_eval 一次时嵌套数组（多载荷 `[f64, f64]`）的元素已是类型节点，
        // meta_eval 不认 scalar/named ⇒ 误报 T-MTA-E617「表达式 `scalar` 不可编译期求值」。
        // 直接把原始 array_lit 交给 mb_type_nodes_from_array（内部按元素 mb_as_type_node），
        // 再由 mb_norm_type_node 把 ident 归一成真正的类型节点。
        var types: []i64 = mb_type_nodes_from_array(mb_arg_at(e, 2));
        if (slice_len(names) as i64 != slice_len(types) as i64) {
            return meta_fail("T-MTA-E606", "`@variant` 字段名数与类型数不一致", e);
        }
        if (slice_len(names) as i64 == 0) {
            return meta_fail("T-MTA-E606", "`@variant` 至少需要 1 个 case", e);
        }
        return mb_make_variant(backing, names, types);
    }
    // 编译期常量：`@simd_lanes(T)` = 本机向量寄存器可容纳的 T 的 lane 数 = g_simd_bytes / sizeof(T)。
    // 用于 `@Vector(@simd_lanes(i32), i32)` 这类「按本机宽度自适应」的可移植向量声明。
    if (base.node_sa((e as u64)) == "simd_lanes") {
        var sc: i64 = base.node_la((e as u64));
        if (sc < 0) { return meta_fail("T-VEC-E926", "`@simd_lanes` 需要 1 个类型实参", e); }
        var sargn: i64 = base__kids[sc].val;
        var slti: i64 = resolve_ti(sargn);
        var slname: string = tip_name(slti);
        var sleb: i64 = vec_lane_bytes(slname);
        var slanes: i64 = g_simd_bytes / sleb;
        if (slanes < 1) { slanes = 1; }
        return mv_int(slanes);
    }
    if (base.node_sa((e as u64)) == "compile_error") {
        var cnt: i64 = 0;
        var a0: i64 = -1;
        var c: i64 = base.node_la((e as u64));
        var mq_ks13045: []i64 = base.kids_chain_idx(base.node_la((e as u64)));
        var mq_ki13045: i64 = 0;
        while (mq_ki13045 < slice_len(mq_ks13045) as i64) {
            c = mq_ks13045[mq_ki13045];
            if (cnt == 0) { a0 = base__kids[c].val; }
            cnt = cnt + 1;
            mq_ki13045 = mq_ki13045 + 1;
            c = -1;
        }
        if (cnt != 1) {
            return meta_fail("T-MTA-E611", "`@compile_error` 需要 1 个字符串实参", e);
        }
        var mv: i64 = meta_eval(a0);
        if (mv < 0) { return -1; }
        if (base.node_kind((mv as u64)) != "string") {
            return meta_fail("T-MTA-E601", "`@compile_error` 的实参须求值为字符串", e);
        }
        return meta_fail("T-MTA-E604", base.node_sa((mv as u64)), e);
    }
    if (mb_is_type_query(base.node_sa((e as u64))) or base.node_sa((e as u64)) == "zeroed") {
        var v: i64 = mb_fold(e);
        if (v < 0) {
            return meta_fail("T-MTA-E606",
                base__sb_cat3("`@", base.node_sa((e as u64)), "` 的类型实参在编译期不可解析"), e);
        }
        return v;
    }
    if (base.node_sa((e as u64)) == "str_from_bytes") {
        var s0: i64 = -1;
        var s1: i64 = -1;
        var sc: i64 = 0;
        var sk: i64 = base.node_la((e as u64));
        var mq_ks13073: []i64 = base.kids_chain_idx(base.node_la((e as u64)));
        var mq_ki13073: i64 = 0;
        while (mq_ki13073 < slice_len(mq_ks13073) as i64) {
            sk = mq_ks13073[mq_ki13073];
            if (sc == 0) { s0 = base__kids[sk].val; }
            if (sc == 1) { s1 = base__kids[sk].val; }
            sc = sc + 1;
            mq_ki13073 = mq_ki13073 + 1;
            sk = -1;
        }
        if (sc != 2) {
            return meta_fail("T-MTA-E611", "`@str_from_bytes` 需要 2 个实参（缓冲区, 长度）", e);
        }
        var bv2: i64 = meta_eval(s0);
        if (bv2 < 0) { return -1; }
        var lv2: i64 = meta_eval(s1);
        if (lv2 < 0) { return -1; }
        return meta_bytes_to_str(e, bv2, lv2);
    }
    // 不定长元函数（D3 首个真实消费方）：逐个求值实参并拼成一条消息。
    // 当前不定长集合 = { compile_log, compile_warning }（见 mb_variadic）：
    //   compile_log    → 写 stderr
    //   compile_warning → 发 T-MTA-W621 告警诊断
    // ⚠ 新增不定长内建时**必须在此显式分流**：下面的 else 分支是按「非 log 即 warning」
    //    处理的，直接加进 mb_variadic 而不分流会被误当成 warning 发射。
    // 二者均为编译期副作用内建，返回 unit（静态类型 Void，见 infer_expr）。
    if (mb_variadic(base.node_sa((e as u64)))) {
        var cname: string = base.node_sa((e as u64));
        var msg: string = "";
        var ncnt: i64 = 0;
        var cc: i64 = -1;
        var mq_ks13046: []i64 = base.kids_chain_idx(base.node_la((e as u64)));
        var mq_ki13046: i64 = 0;
        while (mq_ki13046 < slice_len(mq_ks13046) as i64) {
            cc = mq_ks13046[mq_ki13046];
            var cv: i64 = meta_eval(base__kids[cc].val);
            if (cv < 0) { return -1; }
            var ckind: string = base.node_kind((cv as u64));
            if (ckind != "string" and ckind != "int" and ckind != "bool" and ckind != "float") {
                return meta_fail("T-MTA-E601",
                    base.sb_cat5("`@", cname, "` 第 ", base.i2s(ncnt + 1),
                        " 个实参须求值为标量（string / int / bool / float）"), e);
            }
            msg = msg + mv_to_str(cv);
            ncnt = ncnt + 1;
            mq_ki13046 = mq_ki13046 + 1;
            cc = -1;
        }
        // 元数检查走签名注册表（D4）：下界由 mb_arity_min 给出，上界 -1 = 不定长。
        var amin: i64 = mb_arity_min(cname);
        var amax: i64 = mb_arity_max(cname);
        if (ncnt < amin) {
            return meta_fail("T-MTA-E611",
                base.sb_cat5("`@", cname, "` 至少需要 ", base.i2s(amin), " 个实参"), e);
        }
        if (amax >= 0 and ncnt > amax) {
            return meta_fail("T-MTA-E611",
                base.sb_cat5("`@", cname, "` 最多接受 ", base.i2s(amax), " 个实参"), e);
        }
        if (cname == "compile_log") {
            eprint(msg);
        } else {
            var wl: i64 = parse.n_line(e);
            var wc: i64 = parse.n_col(e);
            base.diag_new("T-MTA-W621", "warning", msg,
                parse.n_file(e), wl, wc, wl, wc + 4);
        }
        return mv_int(0);
    }
    return meta_fail("T-MTA-E607",
        base__sb_cat3("未知的编译期内建 `@", base.node_sa((e as u64)), "`"), e);
}

// ═══════════════════════════════════════════════════════════════
// `[_]T` 定长数组长度推断（Rust 风格占位）
// ═══════════════════════════════════════════════════════════════
// 解析侧把 `[_]T` 建成 array 节点且长度节点 nb = -1（见 parse.parse_type_inner）。
// 本 pass 在 register_decl **之前**跑（register_decl 会急切 resolve_ti 形参/返回类型），
// 遍历整张节点池，把声明类型里的 `[_]` 按初始化器回填成具体整数节点。
// 无法回填的残留（struct 字段 / 形参 / 返回类型 / cast …）统一报 T-SEM-E215，
// 并兜底写 0 —— 保证 alen 永不带着 -1 进入后端。
pub fn ali_fix(tn: i64, init: i64, stmt: i64) void {
    if (tn < 0) { return; }
    if (base.node_kind((tn as u64)) != "array") { return; }
    // 先递归元素类型，支持 `[2][_]T`（每行长度由初始化器的首元素字面量推断）。
    var sub_init: i64 = -1;
    if (init >= 0) {
        if (base.node_kind((init as u64)) == "array_lit" and base.node_la((init as u64)) >= 0) {
            var c0: Child = base.kids[base.node_la((init as u64))];
            sub_init = c0.val;
        }
    }
    if (base.node_na((tn as u64)) >= 0 and sub_init >= 0) { ali_fix(base.node_na((tn as u64)), sub_init, stmt); }
    if (base.node_nb((tn as u64)) >= 0) { return; }
    var cnt: i64 = -1;
    if (init >= 0) {
        if (base.node_kind((init as u64)) == "array_lit") { cnt = parse.list_count(base.node_la((init as u64))); }
    }
    if (cnt < 0) {
        parse.fc_err("T-SEM-E215",
            "无法从初始化器推断 `[_]` 数组长度：初始化器必须是数组字面量（形如 `var a: [_]i64 = [1, 2, 3];`）",
            stmt);
        cnt = 0;
    }
    base.node_set_nb((tn as u64), base.mk_int(base.i2s(cnt), 10, -1));
}

pub fn lower_array_len_infer() void {
    var total: i64 = base.node_count();
    var i: i64 = 0;
    while (i < total) {
        if (base.node_kind((i as u64)) == "var_decl" or base.node_kind((i as u64)) == "GlobalVarDecl" or base.node_kind((i as u64)) == "GlobalConstDecl") {
            if (base.node_na((i as u64)) >= 0 and base.node_nb((i as u64)) >= 0) { ali_fix(base.node_na((i as u64)), base.node_nb((i as u64)), i); }
        }
        i = i + 1;
    }
    // 残留扫描：回填阶段没覆盖到的 `[_]`（无初始化器的位置）一律报错 + 兜底。
    var j: i64 = 0;
    while (j < total) {
        if (base.node_kind((j as u64)) == "array" and base.node_nb((j as u64)) < 0) {
            parse.fc_err("T-SEM-E215",
                "`[_]` 数组长度占位只能用在带初始化器的变量/常量声明中（形如 `var a: [_]i64 = [1, 2, 3];`）",
                j);
            base.node_set_nb((j as u64), base.mk_int("0", 10, -1));
        }
        j = j + 1;
    }
}

// ── S6（§4.11.3）：注册式脱糖 Pass 注册表 ────────────────────────────
// 把 run_check 里原先硬编码的「模块级脱糖调用序列」收口为**有序注册表**驱动。
// 当前只收口**模块作用域**的 4 个脱糖入口（func_clauses / lambdas / array_len_infer /
// imports）；其余**逐节点**脱糖（desugar_value_loop / lower_for_range / lower_for_array /
// desugar_format_call / lower_pipe / lower_range_index / lower_in_range）仍在 infer 期
// 就地调用 —— 它们要统一为节点级 `run: fn(NodeRef) NodeRef` 须先有不可变 AST 改写
// 基础设施（当前未就绪），与 §4.11.3 节点级签名目标一并 DEFERRED（同 S4 删 Node 的延期类）。
pub struct DesugarPass {
    name: string;       // 脱糖名（审计 / 门禁对账用）
    order: i64;         // 脱糖顺序：func_clauses(1) < lambdas(2) < array_len_infer(3) < imports(4)
    raw_impact: i64;    // 预估对 HIR_OP_RAW 计数影响（门禁对账用，当前均为 0）
}
pub var g_desugar_passes: []DesugarPass;
pub fn register_desugar(p: DesugarPass) void { append(g_desugar_passes, p); }
// 按 order 升序跑 (lo, hi] 区间内的已注册脱糖 Pass；由调用方切分区间，避免重复跑。
// ⚠ 分派用 `order` 直查，不把 fn 值存进结构体字段：t 的 LLVM 后端不支持「调用存于
// 结构体字段的 fn 值」（TClosure env 在字段取值路径上未正确 setup，自举 gen-1 clang
// 报 "1 error generated"）；节点级 `run: fn(NodeRef) NodeRef` 统一改造一并 DEFERRED。
pub fn desugar_run_range(lo: i64, hi: i64) void {
    var i: i64 = 0;
    while (i < slice_len(g_desugar_passes) as i64) {
        var p: DesugarPass = g_desugar_passes[i];
        if (lo < p.order and p.order <= hi) {
            if (p.order == 0) { generic_normalize_all(); }   // #4b：隐式类型参数归一化（须在 func_clauses 之前）
            else if (p.order == 1) { parse__desugar_func_clauses(); }
            else if (p.order == 2) { parse__desugar_lambdas(); }
            else if (p.order == 3) { lower_array_len_infer(); }
            else if (p.order == 4) { desugar_imports(); }
        }
        i = i + 1;
    }
}
// 注册 4 个模块级脱糖 Pass（与 run_check 原硬编码顺序一致）。
pub fn desugar_init() void {
    g_desugar_passes = [];
    var p0: DesugarPass; p0.name = "generic_params";  p0.order = 0; p0.raw_impact = 0; register_desugar(p0);
    var p1: DesugarPass; p1.name = "func_clauses";    p1.order = 1; p1.raw_impact = 0; register_desugar(p1);
    var p2: DesugarPass; p2.name = "lambdas";         p2.order = 2; p2.raw_impact = 0; register_desugar(p2);
    var p3: DesugarPass; p3.name = "array_len_infer"; p3.order = 3; p3.raw_impact = 0; register_desugar(p3);
    var p4: DesugarPass; p4.name = "imports";         p4.order = 4; p4.raw_impact = 0; register_desugar(p4);
}

// ── S7（§4.12）：管线处理节点（Pass）框架 ────────────────────────────
// 把 run_check 里原先硬编码的「模块级处理节点序列」（mark_call_callees / mb_pass /
// meta_pass）收口为**注册式 PassManager**。当前 step1 仅建立数据模型 + 统一执行入口
// run_passes()（按注册序分发，与原硬编码顺序逐点相同 ⇒ 行为等价）；拓扑排序 / 依赖失效
// 见 §4.12.3，留 step2。
//
// ⚠ 不把 `run: fn() void` 存进结构体字段：t 的 LLVM 后端不支持「调用存于结构体字段的
//   fn 值」（与脱糖注册表同坑）。统一用 `name` 直接分发（run_passes 内 if-else）。
pub const PASS_ANALYSIS:  i64 = 0;   // 只读 IR，产出侧表（类型 / 借用 / 可达性）
pub const PASS_TRANSFORM: i64 = 1;   // 改写 IR（comptime 折叠 / 内联 / DCE）
// stage：HIR=1, MIR=2, TIR=3, TMIR=4
pub struct Pass {
    name: string;        // Pass 名（审计 / 门禁对账用）
    stage: i64;          // 作用 IR 层（HIR=1, MIR=2, TIR=3, TMIR=4）
    kind: i64;           // PASS_ANALYSIS | PASS_TRANSFORM
    requires: []string;  // 依赖的前置 Pass（name）；拓扑校验用。空 = 无依赖。
    auto_run: bool;      // true=由 run_passes() 在 run_check 内自动调度；false=由调用方显式调用。
}
pub var g_passes: []Pass;
pub fn register_pass(p: Pass) void { append(g_passes, p); }
// 按 name 在注册表中查 Pass；未命中返回 name=="" 的零值（供校验用）。
pub fn passes_find(name: string) Pass {
    var i: i64 = 0;
    while (i < slice_len(g_passes) as i64) {
        if (g_passes[i].name == name) { return g_passes[i]; }
        i = i + 1;
    }
    var z: Pass; z.name = ""; return z;
}
pub fn passes_has(name: string) bool { return passes_find(name).name != ""; }
// 注册全部真实处理节点，构成完整管线图（依赖边见各 Pass 的 requires）：
//   run_check 内自动调度（auto_run=true）： mark_call_callees → mb_pass → meta_pass
//   run_check 外由 src/tc.tc 显式调度（auto_run=false）：comptime_fold_pass → ann_pass
// 顺序与 run_check / src/tc.tc 原硬编码逐点相同 ⇒ 行为等价（run_passes 只跑 auto_run 子集）。
pub fn passes_init() void {
    g_passes = [];
    var req0: []string = [];
    var p1: Pass; p1.name = "mark_call_callees"; p1.stage = 1; p1.kind = PASS_ANALYSIS;   p1.requires = req0; p1.auto_run = true;  register_pass(p1);
    var reqA: []string = []; append(reqA, "mark_call_callees");
    var p2: Pass; p2.name = "mb_pass";           p2.stage = 1; p2.kind = PASS_TRANSFORM; p2.requires = reqA; p2.auto_run = true;  register_pass(p2);
    var reqB: []string = []; append(reqB, "mb_pass");
    var p3: Pass; p3.name = "meta_pass";         p3.stage = 1; p3.kind = PASS_TRANSFORM; p3.requires = reqB; p3.auto_run = true;  register_pass(p3);
    var reqC: []string = []; append(reqC, "meta_pass");
    var p4: Pass; p4.name = "comptime_fold_pass"; p4.stage = 1; p4.kind = PASS_TRANSFORM; p4.requires = reqC; p4.auto_run = false; register_pass(p4);
    var reqD: []string = []; append(reqD, "comptime_fold_pass");
    var reqE: []string = []; append(reqE, "comptime_fold_pass");
    var p6: Pass; p6.name = "ann_pass";           p6.stage = 1; p6.kind = PASS_TRANSFORM; p6.requires = reqE; p6.auto_run = false; register_pass(p6);
}
// 统一执行入口：仅调度 auto_run==true 的 Pass（run_check 内三趟），按注册序、name 直查分发（LLVM 安全）。
// 顺序约束（务必保持）：mark_call_callees 先建调用图；mb_pass（Phase D）须在 check_decl 之前；
// meta_pass（Phase B：CTFE）须紧随 mb_pass、且在 check_decl 之前（见 meta_design.md §9 Phase B）。
// ⚠ comptime_fold_pass / ann_pass 由 src/tc.tc 在 run_check 外显式调用（auto_run=false），
//   此处不调度，避免改动顶层管线结构与双后端发射行为。
pub fn run_passes() void {
    var i: i64 = 0;
    while (i < slice_len(g_passes) as i64) {
        var p: Pass = g_passes[i];
        if (!p.auto_run) { i = i + 1; continue; }
        if (p.name == "mark_call_callees") { mark_call_callees(); }
        else if (p.name == "mb_pass") { mb_pass(); }
        else if (p.name == "meta_pass") { meta_pass(); }
        i = i + 1;
    }
}
// 依赖拓扑校验（g_verify_passes=true 时由 run_check 末触发，正常编译零行为）：
//   ① 无重复 name；② 所有 requires 目标已注册；③ 依赖图无环（步数计数器，见下）。
// 返回 true=图健全；false=存在不一致（仅用于诊断告警，不影响编译结果）。
pub fn passes_validate() bool {
    var n: i64 = slice_len(g_passes) as i64;
    var i: i64 = 0;
    while (i < n) {
        var j: i64 = i + 1;
        while (j < n) {
            if (g_passes[i].name == g_passes[j].name) { return false; }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while (i < n) {
        var k: i64 = 0;
        while (k < slice_len(g_passes[i].requires) as i64) {
            if (!passes_has(g_passes[i].requires[k])) { return false; }
            k = k + 1;
        }
        i = i + 1;
    }
    i = 0;
    while (i < n) {
        if (passes_reach_depth(g_passes[i].name, 0) > n) { return false; }
        i = i + 1;
    }
    return true;
}
// 从 name 出发沿 requires 向下的最大深度；若 > n 说明存在环（深度不可能超过节点数）。
pub fn passes_reach_depth(name: string, depth: i64) i64 {
    var d: i64 = depth + 1;
    var p: Pass = passes_find(name);
    if (p.name == "") { return d; }
    var k: i64 = 0;
    while (k < slice_len(p.requires) as i64) {
        var sub: i64 = passes_reach_depth(p.requires[k], d);
        if (sub > d) { d = sub; }
        k = k + 1;
    }
    return d;
}

pub fn run_check() void {
    desugar_init();
    global_scope = scope_new(-1);
    cur_scope = global_scope;
    cur_ret = ti_mk("Void");

    // 模块内联：在注册声明之前把 import 的模块整体并入 decl_list，
    // 再做命名空间重整（`hello.add` → `hello__add`，模块顶层符号加 `别名__` 前缀）。
    // 单文件程序（无 import）零影响：无模块符号 ⇒ 无任何改写。
    resolve_modules();
    if (getenv("T_MEMSTATS") == "1") { eprint("SEMA after_resolve_modules"); dbg_report_mem(); }
    // 开放维度：overload struct + extend struct 合并（struct-modifiers 设计 §2.1/§2.2）。
    // 必须在 mangle_modules（内含 check_entry_redefs 重名检查）之前运行：把 extend 字段并入
    // overload 组、并移除 ext 节点，避免同文件两个同名 StructDecl 被误报 T-NAM-E405；同时保证
    // 跨文件同编译单元（resolve_modules 已把模块声明并入 decl_list）也能在此合并。
    mb_struct_extend_merge();
    mangle_modules();
    if (getenv("T_MEMSTATS") == "1") { eprint("SEMA after_mangle_modules"); dbg_report_mem(); }

    // S6（§4.11.3）：模块级脱糖改由注册表驱动（func_clauses(1)+lambdas(2)+
    // array_len_infer(3)，顺序与原硬编码一致，行为等价）。
    desugar_run_range(-1, 3);
    if (getenv("T_MEMSTATS") == "1") { eprint("SEMA after_desugar"); dbg_report_mem(); }
    g_vl_checked = [];

    // 注册分三趟，因为 register_decl 对 FuncDecl **急切解析形参/返回类型**：
    //   A 纯类型声明（struct/enum/flag/flag_set/union/variant）—— 彼此无依赖，只登记名字；
    //   B typealias —— 需要 A 已入表才能 resolve_ti 出目标类型；
    //   C 其余（func / 全局变量 / 全局常量）—— 需要 A、B 齐备。
    // 一趟按声明序注册会让「函数形参类型晚于函数声明」的前向引用误报 T_UNKNOWN_TYPE；
    // import 更是必然踩中 —— load_module_file 把模块声明**追加**在 decl_list 末尾，
    // 入口文件里 `f fn(m: mod.T)` 永远先于 mod 的 StructDecl 被注册。
    // ── Stage B：AstGen 重建（脱糖 / 名字重整之后）─────────────────
    // parse 期那一份 HIR 是缓存制品（键 = 源哈希）；sema 消费的必须是**脱糖后**
    // 的树 —— 模块内联会追加声明、子句合并会改写节点、名字重整会改 sa。
    // 重建代价 = 一次 AstGen，换来 sema 全程只认 HIR。
    if (getenv("T_MEMSTATS") == "1") { eprint("SEMA before_hirbuild"); dbg_report_mem(); }
    hir.hir_build(hir.g_last_src);
    if (getenv("T_MEMSTATS") == "1") { eprint("SEMA after_hirbuild1"); dbg_report_mem(); }

    // 注册三趟（趟次语义不变），工作集与分类全部取自 HIR decl 指令。
    var n: i64 = slice_len(hir.g_hir.decls) as i64;
    var i: i64 = 0;
    while (i < n) {
        var dai: i64 = hir.g_hir.decls[i];
        if (hir_decl_is_type_op(hir.hir_op_of(dai))) {
            var d0: i64 = hir.hir_inst_node(dai);
            if (d0 >= 0) { register_decl(d0); }
        }
        i = i + 1;
    }
    var ia: i64 = 0;
    while (ia < n) {
        var d1i: i64 = hir.g_hir.decls[ia];
        if (hir.hir_op_of(d1i) == hir.HIR_OP_TYPE_ALIAS_DECL) {
            var d1: i64 = hir.hir_inst_node(d1i);
            if (d1 >= 0) { register_decl(d1); }
        }
        ia = ia + 1;
    }
    var ib: i64 = 0;
    while (ib < n) {
        var d2i: i64 = hir.g_hir.decls[ib];
        if (hir_decl_is_type_op(hir.hir_op_of(d2i)) == false) {
            if (hir.hir_op_of(d2i) != hir.HIR_OP_TYPE_ALIAS_DECL) {
                var d2: i64 = hir.hir_inst_node(d2i);
                if (d2 >= 0) { register_decl(d2); }
            }
        }
        ib = ib + 1;
    }
    desugar_run_range(3, 4);  // S6（§4.11.3）：imports(4)，在 register 之后、mb/meta_pass 之前，行为等价
    if (getenv("T_MEMSTATS") == "1") { eprint("SEMA after_register"); dbg_report_mem(); }
    passes_init();
    run_passes();   // S7（§4.12）：mark_call_callees → mb_pass → meta_pass，按注册序分发，行为等价
    if (getenv("T_MEMSTATS") == "1") { eprint("SEMA after_passes"); dbg_report_mem(); }
    // ⚠ 再重建一次 HIR：mb_pass / meta_pass 会**改结构**（编译期块执行完即清空语句表、
    // `meta <expr>` 就地折叠成字面量）。注册期那一份指令流已与当前 CST 脱节 ——
    // 照它走会把「已被删除的语句」重新检查一遍（实测：`comptime {}` 里的
    // `@str_from_bytes` 被判 T-MTA-E605，因为它本该随块一起消失）。
    hir.hir_build(hir.g_last_src);
    if (getenv("T_MEMSTATS") == "1") { eprint("SEMA after_hirbuild2"); dbg_report_mem(); }
    // 检查循环：走 HIR decl 指令流。检查期会合成新声明（__fmt_N / __pipe_N /
    // __import_N），故每次走到队尾就同步一次 AstGen，让循环自然覆盖（不动点）。
    var j: i64 = 0;
    var rounds: i64 = 0;
    while (j < slice_len(hir.g_hir.decls) as i64) {
        var dji: i64 = hir.g_hir.decls[j];
        var dj: i64 = hir.hir_inst_node(dji);
        if (dj >= 0) {
            if (g_pipe_bad == true) {
                if (pipe_decl_has(dj)) { j = j + 1; continue; }
            }
            check_decl_hir(dji);
        }
        j = j + 1;
        if (j >= slice_len(hir.g_hir.decls) as i64) {
            if (rounds >= 64) { break; }
            var addn: i64 = hir.hir_sync();
            rounds = rounds + 1;
            if (addn == 0) { break; }
        }
    }
    // 管道降解在 check 期追加的 __pipe_N：多数已被上面的同步拾走，这里只兜底
    // 「仍无 HIR 指令」的残留（g_pipe_bad 时主诊断已报，不级联二手噪声）。
    var jp: i64 = 0;
    var npd: i64 = slice_len(g_pipe_decls) as i64;
    if (g_pipe_bad == true) { npd = 0; }
    while (jp < npd) {
        var pd: i64 = g_pipe_decls[jp];
        if (hir.hir_of_node((pd as u64)) < 0) { check_decl(pd); }
        jp = jp + 1;
    }
    // P0-2 / P0-3：实例体的补齐检查已落在 instantiate_generic 内部（克隆+代换后即重跑
    // check_func_decl，见 instantiate_generic 末尾注释）——此刻 comptime 形参已具体，
    // 嵌套泛型再单态化与 format/!j 脱糖一并完成，且落在主检查循环/代码生成预处理之前，
    // 脱糖结果直接进入同一趟发射视图。主循环之后不再需要 fixpoint。
    scan_fid_format_atoms();
    // Stage B-2 观测：`T_HIR_EDGE_STATS=1` 时打印表达式下降边的来源统计。
    // 回落 CST 的次数收敛到 0，就意味着 sema 在表达式层已完全不需要读节点槽位。
    if (str_len(getenv("T_HIR_EDGE_STATS")) > 0) {
        eprint("HIR 下降边: 经 HIR " + base.i2s(g_hir_edge_hir)
            + " 次 / 回落 CST " + base.i2s(g_hir_edge_cst)
            + " 次（无指令 " + base.i2s(g_hir_edge_noinst)
            + " / 操作数不符 " + base.i2s(g_hir_edge_mis) + "）");
    }
    // 工作 B 支柱 1：调试期作用域树一致性校验（默认关闭，零行为影响）。
    if (g_verify_scope_tree) {
        if (verify_scope_tree() == false) { eprint("WARN: scope tree inconsistent"); }
    }
    // S7（§4.12.3）：调试期 Pass 依赖拓扑校验（默认关闭，零行为影响）。
    if (g_verify_passes) {
        if (passes_validate() == false) { eprint("WARN: pass dependency graph inconsistent"); }
    }
}

// g_pipe_decls 是否含该声明（HIR 检查循环用它跳过「管道已报错」的二手噪声）
pub fn pipe_decl_has(d: i64) bool {
    var i: i64 = 0;
    var n: i64 = slice_len(g_pipe_decls) as i64;
    while (i < n) {
        if (g_pipe_decls[i] == d) { return true; }
        i = i + 1;
    }
    return false;
}

// 标记「作为 call callee 的 member 节点」：`p.clone()`（@derive 生成的方法调用写法）、
// `"t".format(...)` 之类不是字段读，T_UNKNOWN_FIELD 必须放行，否则误报。
// member 节点的 bd 槽在别处未被使用（bd 仅用于 ImportModDecl 的 is_lib_path 标记），故复用。
// 必须在 check 之前跑一遍全节点平坦扫描：infer_expr 拿不到父节点，无法就地判断。
pub fn mark_call_callees() void {
    var tot: i64 = base__node_count();
    var i: i64 = 0;
    while (i < tot) {
        if (base.node_kind((i as u64)) == "call" and base.node_na((i as u64)) >= 0) {
            if (base.node_kind((base.node_na((i as u64)) as u64)) == "member") {
                // S4 §0.14.7 SoA：bd 已外置（原 `ce.bd = true` + 整节点回写）。
                // 注意 bd 字段此处是**第二种语义**：member 节点 = 某 call 的 callee。
                base.node_set_bd((base.node_na((i as u64)) as u64), true);
            }
        }
        i = i + 1;
    }
}

// fid_format(f) 返回 atom，四个格式名必须进本程序的原子表，且**必须在发射前**入表：
// LLVM 后端的 @t_atom_table 先于函数体发射，发射期再 intern 就漏到表外
// （id ≥ t_atom_count → atom_str 还原成空串）。
// 不能挂在 infer_expr 的 call 分支上——内建调用的实参不会被通用遍历，
// `atom_str(fid_format(f))` 这种嵌套里的内层调用根本不会被 infer 到。
// 故在检查末尾对全节点做一次平坦扫描，两个后端拿到的 id 也因此一致。
pub fn scan_fid_format_atoms() void {
    var tot: i64 = base__node_count();
    var i: i64 = 0;
    while (i < tot) {
        if (base.node_kind((i as u64)) == "call") {
            if (base.node_na((i as u64)) >= 0) {
                if (base.node_kind((base.node_na((i as u64)) as u64)) == "ident" and base.node_sa((base.node_na((i as u64)) as u64)) == "fid_format") {
                    fid_intern_fmt_atoms();
                    return;
                }
            }
        }
        i = i + 1;
    }
}

