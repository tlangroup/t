    // 中性内建原语：getenv(name) string（未设置返回空串）。
    // 仅作为 OS 原语提供给 t 程序（如 tote 读 T_LIB_PATH / ~/.tote/libs），
    // tc 自身的库搜索逻辑（compute_lib_dirs）不调用它——包搜索策略留 tote。
    if (name == "getenv") {
        return ti_mk("String");
    }
    // 时间格式化（M56）/ 解析与固定时区（M57）：
    // now() / parse_time* / time_invalid() 返回微秒 epoch（i64），format_time* 返回字符串
    if (name == "now" || name == "time_invalid" || name == "parse_time" || name == "parse_time_local") {
        return ti_scalar("i64");
    }
    if (name == "format_time" || name == "format_time_local" || name == "format_time_tz") {
        return ti_mk("String");
    }
    // 格式化（Python 格式规范迷你语言子集）
    if (name == "format_int" || name == "format_uint" || name == "format_float" || name == "format_str" || name == "format_bool" || name == "format_char") {
        return ti_mk("String");
    }
    if (name == "sb_append_fmt_int" || name == "sb_append_fmt_uint" || name == "sb_append_fmt_float" || name == "sb_append_fmt_str" || name == "sb_append_fmt_bool" || name == "sb_append_fmt_char") {
        return ti_mk("Void");
    }
    // 转换字段（!r/!a/!j/!c/!p）专用追加函数：末位多一个模式串实参
    if (name == "sb_append_fmt_str_conv" || name == "sb_append_fmt_int_conv" || name == "sb_append_fmt_uint_conv") {
        return ti_mk("Void");
    }
    return ti_mk("Unknown");
}
// <<< GEN:builtins <<<

// ── match 穷尽性：enum case 覆盖分析 ────────────────────────────
// 裁定（2026-08-02）：scrutinee 为 enum 且**每个**成员都被一条无守卫的
// `X.Case` 臂覆盖时，该 match 视为穷尽，`_` 通配变为可选。
// 这样给 enum 新增成员会让所有旧 match 立刻报错、强制回访 —— 正是穷尽性检查的价值所在；
// 若一律要求 `_`，新成员会静默落进兜底分支，漏处理无从察觉。

// C2 模式消歧（PascalCase 约定）：模式位置的裸标识符，首字母大写即 CaseName，
// 小写才是绑定名。没有这条约定，`Red => ...` 会被当成不可反驳绑定 ——
// 它匹配一切、让后续所有臂不可达，且完全静默，是最难察觉的一类错。
fn starts_upper(name: string) bool {
    if (str_len(name) == 0) {
        return false;
    }
    var c0: u8 = name[0];
    return c0 >= 65 && c0 <= 90;
}

// scrutinee 所属 enum 是否含有名为 cname 的成员。
fn enum_has_case(scr: i64, cname: string) bool {
    if (tip_kind(scr) != "Enum") {
        return false;
    }
    var hsi: i64 = sym_lookup(global_scope, tip_name(scr));
    if (hsi < 0) {
        return false;
    }
    var hsym: Sym = syms[hsi];
    if (hsym.decl < 0) {
        return false;
    }
    var hd: Node = nodes[hsym.decl];
    if (hd.kind != "EnumDecl") {
        return false;
    }
    var hc: i64 = hd.lb;
    while (hc >= 0) {
        var hk: Child = kids[hc];
        var hv: Node = nodes[hk.val];
        if (hv.sa == cname) {
            return true;
        }
        hc = hk.next;
    }
    return false;
}

// 某个 case 名是否被 match 的某条「无守卫」臂以 `X.Case` 形式覆盖。
// 带守卫的臂不算覆盖：守卫可能为假，控制流仍会漏出。
// 只比对 member 模式的字段名而不校验限定符 —— scrutinee 已限定为该 enum，
// 若写成别的 enum 的成员，会先被上面的 arm 模式类型检查拦下。
fn match_covers_case(e: i64, cname: string) bool {
    var mn: Node = nodes[e];
    var mc: i64 = mn.la;
    while (mc >= 0) {
        var mk: Child = kids[mc];
        var arm: Node = nodes[mk.val];
        if (arm.nb < 0 && arm.na >= 0) {
            var pat: Node = nodes[arm.na];
            if (pat.kind == "member" && pat.sa == cname) {
                return true;
            }
        }
        mc = mk.next;
    }
    return false;
}

// scrutinee 类型 scr 若是 enum，判断 match 是否覆盖了它的全部成员。
// 非 enum、查不到声明、或成员表为空 → 一律返回 false（退回「需要 `_`」的旧判据）。
fn enum_all_cases_covered(e: i64, scr: i64) bool {
    if (tip_kind(scr) != "Enum") {
        return false;
    }
    var esi: i64 = sym_lookup(global_scope, tip_name(scr));
    if (esi < 0) {
        return false;
    }
    var esym: Sym = syms[esi];
    if (esym.decl < 0) {
        return false;
    }
    var ednode: Node = nodes[esym.decl];
    if (ednode.kind != "EnumDecl") {
        return false;
    }
    if (ednode.lb < 0) {
        return false;
    }
    var covered: bool = true;
    var vc: i64 = ednode.lb;
    while (vc >= 0) {
        var vk: Child = kids[vc];
        var vnode: Node = nodes[vk.val];
        if (match_covers_case(e, vnode.sa) == false) {
            covered = false;
        }
        vc = vk.next;
    }
    return covered;
}

// 未被覆盖的 enum 成员，形如 `Color.Green, Color.Blue`；非 enum 或已全覆盖时返回空串。
// 供 T_MATCH_NONEXHAUSTIVE 指名道姓地报缺口，而不是只说「加个 `_`」。
fn enum_missing_cases(e: i64, scr: i64) string {
    if (tip_kind(scr) != "Enum") {
        return "";
    }
    var esi: i64 = sym_lookup(global_scope, tip_name(scr));
    if (esi < 0) {
        return "";
    }
    var esym: Sym = syms[esi];
    if (esym.decl < 0) {
        return "";
    }
    var ednode: Node = nodes[esym.decl];
    if (ednode.kind != "EnumDecl") {
        return "";
    }
    var sb: StringBuilder = sb_new();
    var cnt: i64 = 0;
    var vc: i64 = ednode.lb;
    while (vc >= 0) {
        var vk: Child = kids[vc];
        var vnode: Node = nodes[vk.val];
        if (match_covers_case(e, vnode.sa) == false) {
            if (cnt > 0) {
                sb_append_str(sb, ", ");
            }
            sb_append_str(sb, tip_name(scr));
            sb_append_str(sb, ".");
            sb_append_str(sb, vnode.sa);
            cnt = cnt + 1;
        }
        vc = vk.next;
    }
    return sb_to_str(sb);
}

// ── ADT：variant 构造器模式 / 穷尽性（docs/syntax/drafts/adt_variant.md）──────

// scrutinee 类型 scr 若是 variant，返回其 VariantDecl 节点索引；否则 -1。
fn variant_decl_of(scr: i64) i64 {
    if (tip_kind(scr) != "Variant") {
        return -1;
    }
    var vsi: i64 = sym_lookup(global_scope, tip_name(scr));
    if (vsi < 0) {
        return -1;
    }
    var vsym: Sym = syms[vsi];
    if (vsym.decl < 0) {
        return -1;
    }
    if (nodes[vsym.decl].kind != "VariantDecl") {
        return -1;
    }
    return vsym.decl;
}

// 按名字在 VariantDecl 的 case 链上找 VC 节点；找不到 -1。
fn variant_find_case(d: i64, cname: string) i64 {
    if (d < 0) {
        return -1;
    }
    var c: i64 = nodes[d].lb;
    while (c >= 0) {
        var k: Child = kids[c];
        if (nodes[k.val].sa == cname) {
            return k.val;
        }
        c = k.next;
    }
    return -1;
}

// 该 variant 是否为「抽象 / 非穷尽（open）」——声明末位写了 `_`（VariantDecl.ba）。
fn variant_is_abstract(scr: i64) bool {
    var d: i64 = variant_decl_of(scr);
    if (d < 0) {
        return false;
    }
    return nodes[d].ba;
}

// 合法 case 名列表，形如 `Circle, Rect, Empty`（供 T_MATCH_UNKNOWN_CASE 指路）。
fn variant_case_list(d: i64) string {
    var sb: StringBuilder = sb_new();
    var cnt: i64 = 0;
    var c: i64 = nodes[d].lb;
    while (c >= 0) {
        var k: Child = kids[c];
        if (cnt > 0) {
            sb_append_str(sb, ", ");
        }
        sb_append_str(sb, nodes[k.val].sa);
        cnt = cnt + 1;
        c = k.next;
    }
    return sb_to_str(sb);
}

// 某 case 是否被一条**无守卫**的构造器模式臂覆盖（带守卫不计，同 enum 的 match_covers_case）。
fn variant_covers_case(e: i64, cname: string) bool {
    var mn: Node = nodes[e];
    var mc: i64 = mn.la;
    while (mc >= 0) {
        var mk: Child = kids[mc];
        var arm: Node = nodes[mk.val];
        if (arm.nb < 0 && arm.na >= 0) {
            var pat: Node = nodes[arm.na];
            if (pat.kind == "conpat" && pat.sa == cname) {
                return true;
            }
        }
        mc = mk.next;
    }
    return false;
}

// A1 推广：variant 的全部具名 case 是否都被无守卫臂覆盖。
fn variant_all_cases_covered(e: i64, scr: i64) bool {
    var d: i64 = variant_decl_of(scr);
    if (d < 0) {
        return false;
    }
    if (nodes[d].lb < 0) {
        return false;
    }
    var covered: bool = true;
    var vc: i64 = nodes[d].lb;
    while (vc >= 0) {
        var vk: Child = kids[vc];
        if (variant_covers_case(e, nodes[vk.val].sa) == false) {
            covered = false;
        }
        vc = vk.next;
    }
    return covered;
}

// 未覆盖的 case，形如 `Shape.Rect, Shape.Empty`；非 variant 或已全覆盖返回空串。
fn variant_missing_cases(e: i64, scr: i64) string {
    var d: i64 = variant_decl_of(scr);
    if (d < 0) {
        return "";
    }
    var sb: StringBuilder = sb_new();
    var cnt: i64 = 0;
    var vc: i64 = nodes[d].lb;
    while (vc >= 0) {
        var vk: Child = kids[vc];
        var vn: Node = nodes[vk.val];
        if (variant_covers_case(e, vn.sa) == false) {
            if (cnt > 0) {
                sb_append_str(sb, ", ");
            }
            sb_append_str(sb, tip_name(scr));
            sb_append_str(sb, ".");
            sb_append_str(sb, vn.sa);
            cnt = cnt + 1;
        }
        vc = vk.next;
    }
    return sb_to_str(sb);
}

// 构造器模式的语义检查 + 决议（递归，支持嵌套解构）。
//   pat = conpat 节点，scr = 被解构值的静态类型（ti）
// 决议结果回填 conpat：ia = case 下标（tag）、sc = variant 类型名（后端据此拼 `<V>_is_<C>`）。
// 载荷绑定在**当前作用域**（调用方已为该臂开了子作用域）中 sym_define。
fn conpat_check(pat: i64, scr: i64, rep: bool) void {
    var pn: Node = nodes[pat];
    var d: i64 = variant_decl_of(scr);
    if (d < 0) {
        if (rep) {
            fc_err("T-MAT-E740",
                sb_cat3("构造器模式 `", pn.sa,
                    "(...)` 只能用于 variant，被匹配值不是 variant 类型"), pat);
        }
        return;
    }
    var vname: string = tip_name(scr);
    // 限定写法 `Shape.Circle(...)`：限定符必须与 scrutinee 的 variant 同名
    if (str_len(pn.sb) > 0 && pn.sb != vname) {
        if (rep) {
            fc_err("T-MAT-E740",
                sb_cat5("构造器模式限定符 `", pn.sb, "` 与被匹配值类型 ", vname, " 不符"), pat);
        }
        return;
    }
    var vc: i64 = variant_find_case(d, pn.sa);
    if (vc < 0) {
        if (rep) {
            fc_err("T-MAT-E740",
                sb_cat5("variant ", vname, " 没有名为 `", pn.sa,
                    sb_cat3("` 的 case —— 合法 case：", variant_case_list(d), "")), pat);
        }
        return;
    }
    var vcn: Node = nodes[vc];
    // 载荷个数：单元 0、单载荷 1、多载荷 = vcn.ib（>=2，载荷类型链在 vcn.lb）
    var want: i64 = 0;
    if (vcn.lb >= 0) {
        want = vcn.ib;
    } else if (vcn.na >= 0) {
        want = 1;
    }
    var got: i64 = pn.ib;
    if (got != want) {
        if (rep) {
            fc_err("T-MAT-E743",
                sb_cat5("构造器模式 `", pn.sa, "` 载荷个数不符：声明 ",
                    i2s(want), sb_cat3(" 个，模式写了 ", i2s(got), " 个")), pat);
        }
        return;
    }
    // 回填决议结果（供双后端脱糖）
    pn.ia = vcn.ia;
    pn.sc = vname;
    // 载荷字段类型节点（供后端取 C 类型拼 `<V>_as_<C>` 绑定；unit case 为 -1）
    pn.na = vcn.na;
    slice_set(nodes, pat, pn);
    if (want == 0) {
        return;
    }
    // 多载荷载荷类型链；单载荷恒为 vcn.na
    var plist_head: i64 = -1;
    if (vcn.lb >= 0) {
        plist_head = vcn.lb;
    }
    var bi: i64 = 0;
    var sc: i64 = pn.la;
    while (sc >= 0) {
        var sk: Child = kids[sc];
        var spn: Node = nodes[sk.val];
        // 第 bi 个载荷的类型节点
        var ptnode: i64 = vcn.na;
        if (plist_head >= 0) {
            var lt: i64 = plist_head;
            var lk: i64 = 0;
            while (lk < bi) {
                lt = kids[lt].next;
                lk = lk + 1;
            }
            ptnode = kids[lt].val;
        }
        var pti: i64 = resolve_ti(ptnode);
        if (spn.kind == "conpat") {
            // 嵌套解构：以该载荷类型为新的 scrutinee 递归
            conpat_check(sk.val, pti, rep);
        } else if (spn.kind == "ident") {
            // `_` 只占位不绑定；其余名字绑定该载荷（仅在本臂内可见）
            if (spn.sa != "_") {
                sym_define(cur_scope, spn.sa, "var", pti, -1);
                spn.na = ptnode;
                slice_set(nodes, sk.val, spn);
            }
        } else {
            // 字面量子模式：与载荷类型比对（等值匹配语义）
            var lt: i64 = infer_expr(sk.val);
            if (rep && tip_kind(lt) != "Unknown" && tip_kind(pti) != "Unknown") {
                if (ti_equal(lt, pti) == false && can_cast(lt, pti) == false) {
                    err_type_mismatch(sk.val, pti, lt);
                }
            }
        }
        bi = bi + 1;
        sc = sk.next;
    }
}

// ── 文件描述符内建的编译期校验（M51）──────────────────────────

fn fid_atom_allowed(sel: string) string {
    if (sel == "mode") {
        return ":read / :write / :append / :read_binary / :write_binary / :append_binary";
    }
    if (sel == "kind") {
        return ":text / :binary";
    }
    return ":text / :json / :rawbin / :protobuf";
}

fn fid_atom_ok(sel: string, v: string) bool {
    if (sel == "mode") {
        if (v == "read" || v == "write" || v == "append") {
            return true;
        }
        return v == "read_binary" || v == "write_binary" || v == "append_binary";
    }
    if (sel == "kind") {
        return v == "text" || v == "binary";
    }
    return v == "text" || v == "json" || v == "rawbin" || v == "protobuf";
}

// 诊断码分轴：mode 轴（fopen 打开方式）与 format 轴（fmt_register 的类别 / 格式）
// 各自成码 —— 「格式取值非法」却报 BAD_MODE 会误导定位。
fn fid_code_lit(sel: string) string {
    if (sel == "mode") { return "T-FID-E651"; }
    return "T-FID-E662";
}
fn fid_code_bad(sel: string) string {
    if (sel == "mode") { return "T-FID-E652"; }
    return "T-FID-E653";
}

// atom 形参必须是字面量且取值在白名单内 —— 打开方式 / 格式决定字节形态，
// 若允许运行期取值，`<` 的语义就不再是编译期确定的（违反 L-02 / L-03）。
fn check_atom_arg(a: i64, what: string, sel: string, anchor: i64) void {
    if (a < 0) {
        fc_err(fid_code_lit(sel),
            sb_cat3(what, " 缺失；必须是 atom 字面量，取值：", fid_atom_allowed(sel)), anchor);
        return;
    }
    var an: Node = nodes[a];
    if (an.kind != "atom") {
        fc_err(fid_code_lit(sel),
            sb_cat3(what, " 必须是 atom **字面量**（编译期可判定），取值：", fid_atom_allowed(sel)), a);
        return;
    }
    if (fid_atom_ok(sel, an.sa) == false) {
        fc_err(fid_code_bad(sel),
            sb_cat6(what, " 取值非法：`:", an.sa, "`；合法取值：", fid_atom_allowed(sel), ""), a);
    }
}

// 时间格式化 spec 字段码扫描（M56/M57）：编译期校验 format_time / format_time_local /
// format_time_tz 的 spec 字面量。已知字段码：
//   最小集 %Y %y %m %d %H %M %S %f %%
//   扩展集 %a %A %b %B %p %I %j %w %U %W %z %Z
//   locale 集（M57）%c %x %X
// 其余 `%?` 一律报 T_TIME_BAD_SPEC。运行期对非常量 spec 宽容原样保留。
fn check_time_spec(spec: string, d: i64) void {
    var sl: u64 = str_len(spec);
    var i: u64 = 0;
    while (i < sl) {
        var c: i64 = spec[i] as i64;
        if (c != 37) {                 // '%'
            i = i + 1;
            continue;
        }
        if (i + 1 >= sl) {
            fc_err("T-TIM-E700",
                "时间格式串以 `%` 结尾，缺少后续字段码；合法示例：`%Y-%m-%d %H:%M:%S`", d);
            return;
        }
        var x: i64 = spec[i + 1] as i64;
        if (x == 89 || x == 121 || x == 109 || x == 100 || x == 72
            || x == 77 || x == 83 || x == 102 || x == 37
            || x == 97 || x == 65 || x == 98 || x == 66 || x == 112
            || x == 73 || x == 106 || x == 119 || x == 85 || x == 87
            || x == 122 || x == 90
            || x == 99 || x == 120 || x == 88) {
            i = i + 2;                 // Y y m d H M S f % a A b B p I j w U W z Z c x X
            continue;
        }
        fc_err("T-TIM-E700",
            "时间格式串含未知字段码（以 `%` 打头的非法保留序列）；支持 %Y %y %m %d %H %M %S %f %% %a %A %b %B %p %I %j %w %U %W %z %Z %c %x %X",
            d);
        i = i + 2;
    }
}

// 时间**解析** spec 字段码扫描（M57）：parse_time / parse_time_local 的白名单
// 严格小于格式化白名单 —— %w %U %W 是从日期推导出的派生量，反过来定不出唯一时刻；
// %Z 是自由文本时区缩写（"CST" 同时是北京和美中部），无从消歧。四者一律拒绝，
// 而不是运行期静默返回哨兵：让"这个串根本不该用于解析"在编译期就暴露。
fn check_time_parse_spec(spec: string, d: i64) void {
    var sl: u64 = str_len(spec);
    var i: u64 = 0;
    while (i < sl) {
        var c: i64 = spec[i] as i64;
        if (c != 37) {
            i = i + 1;
            continue;
        }
        if (i + 1 >= sl) {
            fc_err("T-TIM-E700",
                "时间解析串以 `%` 结尾，缺少后续字段码；合法示例：`%Y-%m-%d %H:%M:%S`", d);
            return;
        }
        var x: i64 = spec[i + 1] as i64;
        if (x == 89 || x == 121 || x == 109 || x == 100 || x == 72
            || x == 77 || x == 83 || x == 102 || x == 37
            || x == 97 || x == 65 || x == 98 || x == 66 || x == 112
            || x == 73 || x == 106 || x == 122
            || x == 99 || x == 120 || x == 88) {
            i = i + 2;                 // Y y m d H M S f % a A b B p I j z c x X
            continue;
        }
        if (x == 119 || x == 85 || x == 87 || x == 90) {
            fc_err("T-TIM-E701",
                "时间解析不支持该字段码：%w / %U / %W 是日期的派生量（无法反推唯一日期），%Z 是有歧义的时区缩写；请改用 %z 表示数值偏移",
                d);
            i = i + 2;
            continue;
        }
        fc_err("T-TIM-E700",
            "时间解析串含未知字段码（以 `%` 打头的非法保留序列）；解析支持 %Y %y %m %d %H %M %S %f %% %a %A %b %B %p %I %j %z %c %x %X",
            d);
        i = i + 2;
    }
}

// 数字/字符串格式化 spec 文法校验（M54/M55 补充）：编译期校验 format_int / format_uint /
// format_float / format_str / format_bool / format_char 的 spec 字面量。
// 复刻 runtime/t_runtime.c fmt_parse 的外壳剥除（剥 {} 仅当首尾都是；剥到最后一个 ':'），
// 并在文法解析后强制"无残留字符"。因此能拦住 {:z}（非法 type）、{:>10z}（残留）这类
// 运行期会被静默吞掉的笔误。非常量 spec 维持运行期宽松（fmt_parse 贪婪吞尾）。
fn check_fmt_spec(spec: string, d: i64) void {
    var sl: u64 = str_len(spec);
    // 是否像「模板」（含替换字段 {…}）：用户常把 format_int 当成 str.format 用，
    // 写了 "x={0}" 这类带字面量文本的串；此时报错顺手提示改用 format()。
    var g_tmpl_hint: bool = false;
    var gi: u64 = 0;
    while (gi < sl) { if ((spec[gi] as i64) == 123) { g_tmpl_hint = true; } gi = gi + 1; }
    var start: u64 = 0;
    var end: u64 = sl;
    if (sl >= 2 && (spec[0] as i64) == 123 && (spec[sl - 1] as i64) == 125) { start = 1; end = sl - 1; } // 剥 {}
    var j: u64 = start;
    var lc: i64 = -1;
    while (j < end) { if ((spec[j] as i64) == 58) { lc = j as i64; } j = j + 1; }  // 最后一个 ':'
    if (lc >= 0) { start = (lc + 1) as u64; }
    var i: u64 = start;
    // [fill]align
    if (end - i >= 2) {
        var c1: i64 = spec[i] as i64;
        var c2: i64 = spec[i + 1] as i64;
        if (c2 == 60 || c2 == 62 || c2 == 61 || c2 == 94) { i = i + 2; }       // < > = ^
        else if (c1 == 60 || c1 == 62 || c1 == 61 || c1 == 94) { i = i + 1; }
    } else if (end - i >= 1) {
        var c1: i64 = spec[i] as i64;
        if (c1 == 60 || c1 == 62 || c1 == 61 || c1 == 94) { i = i + 1; }
    }
    if (end - i >= 1) { var c: i64 = spec[i] as i64; if (c == 43 || c == 45 || c == 32) { i = i + 1; } } // + - ' '
    if (end - i >= 1) { var c: i64 = spec[i] as i64; if (c == 35) { i = i + 1; } }                     // '#'
    if (end - i >= 1) { var c: i64 = spec[i] as i64; if (c == 48) { i = i + 1; } }                     // '0'
    while (end - i >= 1) { var c: i64 = spec[i] as i64; if (c >= 48 && c <= 57) { i = i + 1; } else { break; } } // width
    if (end - i >= 1) { var c: i64 = spec[i] as i64; if (c == 44 || c == 95) { i = i + 1; } }           // ',' '_'
    if (end - i >= 1) { var c: i64 = spec[i] as i64; if (c == 46) {                                       // '.' precision
        i = i + 1;
        while (end - i >= 1) { var d2: i64 = spec[i] as i64; if (d2 >= 48 && d2 <= 57) { i = i + 1; } else { break; } }
    } }
    var has_type: bool = false;
    var tc: i64 = 0;
    if (end - i >= 1) { has_type = true; tc = spec[i] as i64; i = i + 1; }
    if (has_type) {
        // 允许的类型字符集（与 reference.md §3.10.2 一致）；'!' 是 format_bool 的专属
        // 合法 type（runtime t_format_bool 对未识别 type 一律走 true/false 分支，故 lenient）。
        var ok: bool = (tc == 98 || tc == 99 || tc == 100 || tc == 101 || tc == 69
            || tc == 102 || tc == 70 || tc == 103 || tc == 71 || tc == 110
            || tc == 111 || tc == 115 || tc == 120 || tc == 88 || tc == 37
            || tc == 33); // b c d e E f F g G n o s x X %  + '!'(bool)
        if (!ok) {
            var m1: string = "格式化 spec 含非法类型字符；M54 允许的 type 为 b c d e E f F g G n o s x X %";
            if (g_tmpl_hint) {
                m1 = sb_cat2(m1, "；若需带字面量文本的模板（如 \"x={0}\"），请改用 str.format：format(\"x={0}\", v) 或 \"x={0}\".format(v)");
            }
            fc_err("T-FST-E300", m1, d);
            return;
        }
    }
    if (i < end) {
        var m2: string = "格式化 spec 文法非法（含无法解析的残留字符）；合法示例：\":>10\" \"{:>10.2f}\" \"#x\" \"{:,}\"";
        if (g_tmpl_hint) {
            m2 = sb_cat2(m2, "；若需带字面量文本的模板（如 \"x={0}\"），请改用 str.format：format(\"x={0}\", v) 或 \"x={0}\".format(v)");
        }
        fc_err("T-FST-E300", m2, d);
    }
}

// 序列化右操作数类型白名单（M51 v1）：标量（含 atom / bool / 浮点）与 string。
// 结构体 / slice / map 需走 type_info 反射逐字段展开，留待 v2。
fn check_serializable(e: i64, sti: i64) void {
    var k: string = tip_kind(sti);
    if (k == "Scalar" || k == "String" || k == "Unknown") {
        return;
    }
    fc_err("T-FID-E654",
        sb_cat3("`<` 不支持序列化该类型：", ti_str(sti),
            "；v1 仅支持标量（整数 / 浮点 / bool / atom / fid）与 string，聚合类型请逐字段写出"), e);
}

// ── format 模板替换字段（M55）──────────────────────────────
//
// Python `str.format` 分两层：**替换字段**（`{0}` 选第几个实参）与**格式规范**
// （`:` 之后的 `>10.2f`，M54 已实现）。这里补上层。
//
// t 无变参、无 kwargs、无 Any，做不出运行期模板引擎，故三条硬约束：
//   ① 模板必须是字符串**字面量** —— 编译期解析，运行期零模板开销（L-03 静态优先）
//   ② 只有位置索引 `{0}` 与自动编号 `{}`；`{name}` 无 kwargs 可查，直接报错
//   ③ 脱糖成提升函数 `__fmt_N`，体内 StringBuilder 顺序拼接，实参按值传入
//
// 实参在**调用点**求值一次后传参，故 `"{0} {0}"` 只求值一次 —— 这是提升函数
// 相对宏展开的关键优势（`format("{0}{0}", next())` 不会调用两次 next）。
var g_fmt_counter: i64;
var g_fmt_ak: [64]i64;   // 各值实参的种类码（见 fmt_kind_of）
var g_fmt_at: [64]i64;   // 各值实参对应的形参类型节点
var g_fmt_json_ti: [64]i64;   // A1a：聚合实参的原始 TI（!j 递归编码用）
var g_fmt_json: [64]bool;     // A1a：第 i 个值实参是否为聚合类型（须用 !j 编码）
var g_fmt_jsym: i64;          // A1a：JSON 合成体内部局部变量名计数器
// 当前正在 check 的函数声明 id（check_func_decl 进出时维护）。用于 format 脱糖判据：
// 若正处于「泛型模板」体内（comptime 形参未绑定），此刻脱糖拿不到实参的静态类型，
// 须跳过并把 `format` 节点留给实例（单态化、类型已具体）在 instantiate_generic 里再脱糖。
var g_cur_func_decl: i64 = -1;

// 值类型 → 种类码。-1 表示不可格式化（聚合类型等）。
// ⚠ 整数字面量按最小无符号宽度推断（`42` 是 u8），故必须按名字判有无符号，
//    不能只比 "i64"，否则 `format("{0}", 42)` 会错走有符号通道。
fn fmt_kind_of(t: i64) i64 {
    var k: string = tip_kind(t);
    if (k == "String") { return 3; }
    if (k == "Scalar") {
        var nm: string = tip_name(t);
        if (nm == "bool") { return 4; }
        if (is_float_name(nm)) { return 2; }
        if (nm == "u8" || nm == "u16" || nm == "u32" || nm == "u64") { return 1; }
        if (is_int_name(nm)) { return 0; }
    }
    return -1;
}

fn fmt_append_fn(k: i64) string {
    if (k == 0) { return "sb_append_fmt_int"; }
    if (k == 1) { return "sb_append_fmt_uint"; }
    if (k == 2) { return "sb_append_fmt_float"; }
    if (k == 3) { return "sb_append_fmt_str"; }
    return "sb_append_fmt_bool";
}

// ── 转换字段 `!s|!r|!a|!j|!c|!p`（M-fstr）────────────────────
// 语义（与 CPython 同构：**先转换成字符串，再套格式规范**）：
//   !s  str    —— 默认表示，等价于不写转换字段
//   !r  repr   —— 调试表示：字符串加引号并转义（数值/bool 与 !s 相同）
//   !a  ascii  —— repr 之上再把非 ASCII 字节转义成 \xHH
//   !j  json   —— JSON 编码（字符串加引号 + JSON 转义；数值/bool 本就是合法 JSON）
//   !p  pbtxt  —— protobuf text 编码（字符串加引号 + protobuf 风格转义）
//   !c  csv    —— CSV 单元格编码（仅当含 , " CR/LF 时加引号，内部 " 翻倍）
// 以上六种转换均可作用于任意值类型：字符串统一走 *_str_conv 做格式专属转义；
// 标量（整数/浮点/bool）序列化后本就是裸值，三种格式等价，故直接走原追加函数。
// 返回 "" 表示该「种类 × 转换」组合非法（当前已无非法组合，保留以兜底）。
fn fmt_conv_fn(k: i64, cv: i64) string {
    if (cv == 0 || cv == 115) { return fmt_append_fn(k); }        // 无 / !s
    if (cv == 114 || cv == 97 || cv == 106 || cv == 99 || cv == 112) {
        if (k == 3) { return "sb_append_fmt_str_conv"; }           // 字符串 → 格式专属转义
        return fmt_append_fn(k);                                   // 标量 → 裸值（json/pbtxt/csv 等价）
    }
    return "";
}

fn fmt_conv_name(cv: i64) string {
    if (cv == 114) { return "r"; }
    if (cv == 97) { return "a"; }
    if (cv == 106) { return "j"; }
    if (cv == 99) { return "c"; }
    if (cv == 112) { return "p"; }
    return "s";
}

fn fmt_fn_takes_mode(name: string) bool {
    return name == "sb_append_fmt_str_conv" || name == "sb_append_fmt_int_conv" || name == "sb_append_fmt_uint_conv";
}

// 形参类型节点：复用 mk_type_node_from_ti 覆盖标量/字符串/结构/切片/映射/数组。
fn fmt_type_node(t: i64) i64 {
    return mk_type_node_from_ti(t);
}

// 把一条语句追加进函数体链表。head 为 -1 时同时把它设成表头。
// 返回新的 tail；调用方需自行同步 head（与 synthesize_loader 的定式一致）。
fn fmt_push_stmt(head: i64, tail: i64, stmt: i64) i64 {
    return list_push(head, tail, stmt);
}

// ── A1a：!j 聚合值的编译期 JSON 编码 ──────────────────────────
// t 没有运行期 Any / RTTI，故 JSON 编码在脱糖期按各实参的**静态 TI** 生成内联
// 代码（双后端只编译生成的 t 代码，IR 不受影响）。覆盖标量/字符串/结构/切片/
// 定长数组/映射；枚举/变体/Pointer/Optional 等无 RTTI 的类型降级为 null。
fn fmt_jstmt2(fnm: string, a1: i64, a2: i64) i64 {
    var ah: i64 = -1; var at: i64 = -1;
    at = list_push(ah, at, a1); if (ah < 0) { ah = at; }
    at = list_push(ah, at, a2); if (ah < 0) { ah = at; }
    return mk_expr(mk_call(mk_ident(fnm, -1), ah, -1), -1);
}
fn fmt_jstmt3(fnm: string, a1: i64, a2: i64, a3: i64) i64 {
    var ah: i64 = -1; var at: i64 = -1;
    at = list_push(ah, at, a1); if (ah < 0) { ah = at; }
    at = list_push(ah, at, a2); if (ah < 0) { ah = at; }
    at = list_push(ah, at, a3); if (ah < 0) { ah = at; }
    return mk_expr(mk_call(mk_ident(fnm, -1), ah, -1), -1);
}
fn fmt_jstmt4(fnm: string, a1: i64, a2: i64, a3: i64, a4: i64) i64 {
    var ah: i64 = -1; var at: i64 = -1;
    at = list_push(ah, at, a1); if (ah < 0) { ah = at; }
    at = list_push(ah, at, a2); if (ah < 0) { ah = at; }
    at = list_push(ah, at, a3); if (ah < 0) { ah = at; }
    at = list_push(ah, at, a4); if (ah < 0) { ah = at; }
    return mk_expr(mk_call(mk_ident(fnm, -1), ah, -1), -1);
}
fn fmt_one_block(stmt: i64) i64 {
    // 注：返回的必须是**子节点链表头（kids head）**，与 parse_block() 一致——
    // if/while/for 的分支在 AST 里就是 kids head，发射期与 collect_local_types 均按
    // kids head 遍历（见 codegen_ll emit_if / collect_local_types）。绝不可返回
    // mk_block(h) 的「block 节点 id」，否则 n.la 存成节点 id，kids[la] 越界崩溃
    // （A1a 多载荷结构体第二个字段即触发 t_slice_at index N length M）。
    var h: i64 = -1; var t: i64 = -1;
    t = list_push(h, t, stmt); if (h < 0) { h = t; }
    return h;
}
// 把静态类型为 ti 的值 val（表达式节点）的 JSON 编码追加进 __fmt_N 函数体。
// head 为已非空的体链表头，tail 为当前尾；返回新尾。
fn fmt_gen_json(head: i64, tail: i64, val: i64, ti: i64) i64 {
    var k: string = tip_kind(ti);
    var kind: i64 = fmt_kind_of(ti);
    if (kind >= 0) {
        // 标量 / 字符串叶
        if (kind == 3) {
            return fmt_push_stmt(head, tail,
                fmt_jstmt4("sb_append_fmt_str_conv", mk_ident("__fb", -1), mk_string("", -1), val, mk_string("j", -1)));
        }
        return fmt_push_stmt(head, tail,
            fmt_jstmt3(fmt_append_fn(kind), mk_ident("__fb", -1), mk_string("", -1), val));
    }
    if (k == "Struct") {
        tail = fmt_push_stmt(head, tail, fmt_jstmt2("sb_append_str", mk_ident("__fb", -1), mk_string("{", -1)));
        var m: i64 = g_fmt_jsym; g_fmt_jsym = g_fmt_jsym + 1;
        var ff: string = sb_cat2("__ff", i2s(m));
        tail = fmt_push_stmt(head, tail, mk_var_decl(ff, false, mk_scalar("bool", -1), mk_bool(true, -1), -1));
        var fh: i64 = find_struct_fields(tip_name(ti));
        var f0: i64 = fh;
        while (f0 >= 0) {
            var fnode: Node = nodes[kids[f0].val];
            var fname: string = fnode.sa;
            var fti: i64 = -1;
            if (fnode.na >= 0) { fti = resolve_ti(fnode.na); }
            // if (!ff) { sb_append_str(__fb, ","); }
            tail = fmt_push_stmt(head, tail,
                mk_if(mk_unary("!", mk_ident(ff, -1), -1),
                    fmt_one_block(fmt_jstmt2("sb_append_str", mk_ident("__fb", -1), mk_string(",", -1))), -1, -1));
            tail = fmt_push_stmt(head, tail, mk_assignment("=", mk_ident(ff, -1), mk_bool(false, -1), -1));
            // 字段名作 JSON 对象键：用 sb_append_fmt_str_conv(..., "j") 做引号 + 转义
            tail = fmt_push_stmt(head, tail,
                fmt_jstmt4("sb_append_fmt_str_conv", mk_ident("__fb", -1), mk_string("", -1), mk_string(fname, -1), mk_string("j", -1)));
            tail = fmt_push_stmt(head, tail, fmt_jstmt2("sb_append_str", mk_ident("__fb", -1), mk_string(":", -1)));
            // 注：mk_member 的第 3 参是 token index（node_at 用于定位源码位置），
            // 绝非类型 TI。字段类型信息已用于递归编码 fti，故此处传 -1（不锚定源码）。
            tail = fmt_gen_json(head, tail, mk_member(fname, val, -1), fti);
            f0 = kids[f0].next;
        }
        tail = fmt_push_stmt(head, tail, fmt_jstmt2("sb_append_str", mk_ident("__fb", -1), mk_string("}", -1)));
        return tail;
    }
    if (k == "Slice") {
        tail = fmt_push_stmt(head, tail, fmt_jstmt2("sb_append_str", mk_ident("__fb", -1), mk_string("[", -1)));
        var m: i64 = g_fmt_jsym; g_fmt_jsym = g_fmt_jsym + 1;
        var cnt: string = sb_cat2("__ji", i2s(m));
        var ev: string = sb_cat2("__je", i2s(m));
        tail = fmt_push_stmt(head, tail, mk_var_decl(cnt, false, mk_scalar("i64", -1), rng_lit(0), -1));
        var bh: i64 = -1; var bt: i64 = -1;
        var cond: i64 = mk_binary(">", mk_ident(cnt, -1), rng_lit(0), -1);
        var ifc: i64 = mk_if(cond,
            fmt_one_block(fmt_jstmt2("sb_append_str", mk_ident("__fb", -1), mk_string(",", -1))), -1, -1);
        bt = fmt_push_stmt(bh, bt, ifc); if (bh < 0) { bh = bt; }
        bt = fmt_push_stmt(bh, bt,
            mk_assignment("=", mk_ident(cnt, -1), mk_binary("+", mk_ident(cnt, -1), rng_lit(1), -1), -1));
        if (bh < 0) { bh = bt; }
        bt = fmt_gen_json(bh, bt, mk_ident(ev, -1), tis[ti].elem);
        var loop: i64 = mk_for_each(ev, "", val, bh, -1);
        tail = fmt_push_stmt(head, tail, loop);
        tail = fmt_push_stmt(head, tail, fmt_jstmt2("sb_append_str", mk_ident("__fb", -1), mk_string("]", -1)));
        return tail;
    }
    if (k == "Array") {
        // 定长数组：__fmt_N 形参即 [N]T（非 slice），不能用 for_each（会按 slice 调 tll_slice_len 读垃圾）。
        // 改为按下标 0..alen 索引遍历，复用数组下标（两后端均已支持）。
        tail = fmt_push_stmt(head, tail, fmt_jstmt2("sb_append_str", mk_ident("__fb", -1), mk_string("[", -1)));
        var m: i64 = g_fmt_jsym; g_fmt_jsym = g_fmt_jsym + 1;
        var cnt: string = sb_cat2("__ji", i2s(m));       // 逗号分隔标志
        var ix: string = sb_cat2("__jx", i2s(m));         // 下标变量（即 for 循环变量）
        var alen: i64 = tis[ti].alen;
        tail = fmt_push_stmt(head, tail, mk_var_decl(cnt, false, mk_scalar("i64", -1), rng_lit(0), -1));
        var bh: i64 = -1; var bt: i64 = -1;
        var cond: i64 = mk_binary(">", mk_ident(cnt, -1), rng_lit(0), -1);
        var ifc: i64 = mk_if(cond,
            fmt_one_block(fmt_jstmt2("sb_append_str", mk_ident("__fb", -1), mk_string(",", -1))), -1, -1);
        bt = fmt_push_stmt(bh, bt, ifc); if (bh < 0) { bh = bt; }
        bt = fmt_push_stmt(bh, bt,
            mk_assignment("=", mk_ident(cnt, -1), mk_binary("+", mk_ident(cnt, -1), rng_lit(1), -1), -1));
        if (bh < 0) { bh = bt; }
        var aev: i64 = mk_index(val, mk_ident(ix, -1), -1);
        bt = fmt_gen_json(bh, bt, aev, tis[ti].elem);
        // 注意：mk_int 的 ia 是 RADIX 非值 → 长度须 mk_int(i2s(alen), 10, -1)（radix 10）。
        var loop: i64 = mk_for(rng_i64_decl(ix, rng_lit(0)),
            mk_binary("<", mk_ident(ix, -1), mk_int(i2s(alen), 10, -1), -1), rng_incr(ix), bh, -1);
        tail = fmt_push_stmt(head, tail, loop);
        tail = fmt_push_stmt(head, tail, fmt_jstmt2("sb_append_str", mk_ident("__fb", -1), mk_string("]", -1)));
        return tail;
    }
    if (k == "Map") {
        tail = fmt_push_stmt(head, tail, fmt_jstmt2("sb_append_str", mk_ident("__fb", -1), mk_string("{", -1)));
        var m: i64 = g_fmt_jsym; g_fmt_jsym = g_fmt_jsym + 1;
        var cnt: string = sb_cat2("__ji", i2s(m));
        var kk: string = sb_cat2("__jk", i2s(m));
        var vv: string = sb_cat2("__jv", i2s(m));
        tail = fmt_push_stmt(head, tail, mk_var_decl(cnt, false, mk_scalar("i64", -1), rng_lit(0), -1));
        var bh: i64 = -1; var bt: i64 = -1;
        var cond: i64 = mk_binary(">", mk_ident(cnt, -1), rng_lit(0), -1);
        var ifc: i64 = mk_if(cond,
            fmt_one_block(fmt_jstmt2("sb_append_str", mk_ident("__fb", -1), mk_string(",", -1))), -1, -1);
        bt = fmt_push_stmt(bh, bt, ifc); if (bh < 0) { bh = bt; }
        bt = fmt_push_stmt(bh, bt,
            mk_assignment("=", mk_ident(cnt, -1), mk_binary("+", mk_ident(cnt, -1), rng_lit(1), -1), -1));
        if (bh < 0) { bh = bt; }
        // 键：JSON 对象键须为字符串；仅 string 键完全支持，其余键退化为 "?"
        if (tip_kind(tis[ti].key) == "String") {
            bt = fmt_push_stmt(bh, bt,
                fmt_jstmt4("sb_append_fmt_str_conv", mk_ident("__fb", -1), mk_string("", -1), mk_ident(kk, -1), mk_string("j", -1)));
        } else {
            bt = fmt_push_stmt(bh, bt,
                fmt_jstmt4("sb_append_fmt_str_conv", mk_ident("__fb", -1), mk_string("", -1), mk_string("?", -1), mk_string("j", -1)));
        }
        bt = fmt_push_stmt(bh, bt, fmt_jstmt2("sb_append_str", mk_ident("__fb", -1), mk_string(":", -1)));
        bt = fmt_gen_json(bh, bt, mk_ident(vv, -1), tis[ti].val);
        var loop: i64 = mk_for_each(kk, vv, val, bh, -1);
        tail = fmt_push_stmt(head, tail, loop);
        tail = fmt_push_stmt(head, tail, fmt_jstmt2("sb_append_str", mk_ident("__fb", -1), mk_string("}", -1)));
        return tail;
    }
    // 兜底：无 RTTI 的类型（Enum/Variant/Pointer/Optional 等）输出 null
    return fmt_push_stmt(head, tail, fmt_jstmt2("sb_append_str", mk_ident("__fb", -1), mk_string("null", -1)));
}

// format(tmpl, a, b, ...) 的脱糖入口。
// 成功则**就地改写** e 为 `__fmt_N(a, b, ...)` 并返回 String；失败返回 Unknown。
fn desugar_format_call(e: i64) i64 {
    var n: Node = nodes[e];

    // A1a：每次脱糖前清理聚合实参槽位 / JSON 局部名计数器，避免上一次 format 调用的残留污染本调用。
    // g_fmt_counter（__fmt_N 函数序号）跨调用单调、不可重置；g_fmt_jsym（__ff/__ji/... 局部名后缀）
    // 仅需在单个函数体内唯一，故每次重置为 0——既消除跨调用残留，又让生成名从 0 重新编号。
    var ri: i64 = 0;
    while (ri < 64) {
        g_fmt_json[ri] = false;
        g_fmt_json_ti[ri] = -1;
        ri = ri + 1;
    }
    g_fmt_jsym = 0;

    // ── 0. 泛型模板体内跳过脱糖 ─────────────────────────────
    // 处于泛型模板体内时，comptime 形参（如 `meta T: type`）尚未绑定，value 实参的
    // 静态类型未知（可能是未定型的 T）。此刻脱糖会生成以「未知类型」为编码目标的
    // __fmt_N，且改写后的 __fmt_N 节点无法再被实例恢复 → 发射期 `UNSUPPORTED call format`。
    // 故模板体内leave `format` 节点原样，待实例（instantiate_generic 重跑 check_func_decl，
    // 类型已具体）再脱糖。模板本身永不发射，仅实例发射，故无副作用。
    if (g_cur_func_decl >= 0 && func_is_generic(g_cur_func_decl)) {
        return ti_mk("String");
    }

    // ── 1. 模板必须存在且是字面量 ──────────────────────────
    var tmpl_node: i64 = call_arg_node(e, 0);
    if (tmpl_node < 0) {
        fc_err("T-FST-E303",
            "format 至少需要一个实参：模板字符串字面量，如 format(\"{0} 分\", n)", e);
        return ti_mk("Unknown");
    }
    var tnode: Node = nodes[tmpl_node];
    if (tnode.kind != "string") {
        fc_err("T-FST-E304",
            "format 的模板必须是字符串**字面量**（编译期解析，运行期无模板引擎）；变量模板请改用 StringBuilder 逐段拼接",
            tmpl_node);
        return ti_mk("Unknown");
    }
    var tmpl: string = tnode.sa;

    // ── 2. 收集值实参并推断类型 ────────────────────────────
    var argc: i64 = 0;
    var c0: i64 = n.la;
    if (c0 >= 0) {
        var k0: Child = kids[c0];
        c0 = k0.next;                      // 跳过模板串本身
    }
    while (c0 >= 0) {
        var ck: Child = kids[c0];
        if (argc >= 64) {
            fc_err("T-FST-E305", "format 的值实参不能超过 64 个", e);
            return ti_mk("Unknown");
        }
        var at: i64 = infer_expr(ck.val);
        var kind: i64 = fmt_kind_of(at);
        g_fmt_at[argc] = fmt_type_node(at);
        if (kind < 0) {
            if (tip_kind(at) == "Unknown") {
                // Unknown：已有诊断，按 int 兜底避免级联
                g_fmt_ak[argc] = 0;
                g_fmt_json[argc] = false;
            } else {
                // 聚合类型：标记为需 JSON 编码（!j 分支在 Step 3 处理）
                g_fmt_ak[argc] = -1;
                g_fmt_json[argc] = true;
                g_fmt_json_ti[argc] = at;
            }
        } else {
            g_fmt_ak[argc] = kind;
            g_fmt_json[argc] = false;
        }
        argc = argc + 1;
        c0 = ck.next;
    }

    // ── 3. 解析模板，边解析边生成函数体语句 ────────────────
    var body_head: i64 = -1;
    var body_tail: i64 = -1;

    // var __fb: StringBuilder = sb_new();
    var sbdecl: i64 = mk_var_decl("__fb", false, mk_scalar("StringBuilder", -1),
        mk_call(mk_ident("sb_new", -1), -1, -1), -1);
    body_tail = fmt_push_stmt(body_head, body_tail, sbdecl);
    if (body_head < 0) { body_head = body_tail; }

    var lit: StringBuilder = sb_new();
    var tl: u64 = str_len(tmpl);
    var i: u64 = 0;
    var auto_next: i64 = 0;
    var used_auto: bool = false;
    var used_manual: bool = false;
    var used_idx: i64 = 0;                 // 位掩码不够用，退化为「最大引用下标 + 1」

    while (i < tl) {
        var ch: i64 = tmpl[i] as i64;

        // `}}` → 字面 `}`；单独的 `}` 是笔误
        if (ch == 125) {
            if (i + 1 < tl && (tmpl[i + 1] as i64) == 125) {
                sb_append_char(lit, 125);
                i = i + 2;
                continue;
            }
            fc_err("T-FST-E307",
                "模板里孤立的 `}`；要输出字面右花括号请写 `}}`", tmpl_node);
            return ti_mk("Unknown");
        }

        if (ch != 123) {                   // 普通字符
            sb_append_char(lit, ch);
            i = i + 1;
            continue;
        }

        // `{{` → 字面 `{`
        if (i + 1 < tl && (tmpl[i + 1] as i64) == 123) {
            sb_append_char(lit, 123);
            i = i + 2;
            continue;
        }

        // ── 替换字段 ──
        // 先把攒下的字面段冲刷成一条 sb_append_str
        var seg: string = sb_to_str(lit);
        if (str_len(seg) > 0) {
            var sa_head: i64 = -1;
            var sa_tail: i64 = -1;
            sa_tail = list_push(sa_head, sa_tail, mk_ident("__fb", -1));
            if (sa_head < 0) { sa_head = sa_tail; }
            sa_tail = list_push(sa_head, sa_tail, mk_string(seg, -1));
            if (sa_head < 0) { sa_head = sa_tail; }
            var scall: i64 = mk_call(mk_ident("sb_append_str", -1), sa_head, -1);
            body_tail = fmt_push_stmt(body_head, body_tail, mk_expr(scall, -1));
            if (body_head < 0) { body_head = body_tail; }
        }
        sb_clear(lit);

        i = i + 1;                         // 跳过 '{'

        // 索引：数字串 或 空（自动编号）
        var idx: i64 = -1;
        var has_digit: bool = false;
        while (i < tl) {
            var dc: i64 = tmpl[i] as i64;
            if (dc < 48 || dc > 57) { i = i; break; }
            if (has_digit == false) { idx = 0; has_digit = true; }
            idx = idx * 10 + (dc - 48);
            i = i + 1;
        }

        // 转换字段 `!s|!r|!a|!j|!c|!p`（M-fstr；`format()` 手写模板同样可用）
        var conv: i64 = 0;
        if (i < tl && (tmpl[i] as i64) == 33) {
            var cvv: i64 = 0;
            if (i + 1 < tl) { cvv = tmpl[i + 1] as i64; }
            if (cvv != 115 && cvv != 114 && cvv != 97 && cvv != 106 && cvv != 99 && cvv != 112) {
                fc_err("T-FST-E301",
                    "转换字段只能是 `!s`（str）/ `!r`（repr）/ `!a`（ascii）/ `!j`（json）/ `!c`（csv）/ `!p`（pbtxt）之一",
                    tmpl_node);
                return ti_mk("Unknown");
            }
            conv = cvv;
            i = i + 2;
        }

        // 既没数字，下一个也不是 ':' / '}' ⇒ 命名字段
        if (has_digit == false && conv == 0 && i < tl) {
            var pc: i64 = tmpl[i] as i64;
            if (pc != 58 && pc != 125) {
                fc_err("T-FST-E308",
                    "不支持命名字段 `{name}`（t 没有关键字实参）；请改用位置索引 `{0}` 或自动编号 `{}`",
                    tmpl_node);
                return ti_mk("Unknown");
            }
        }

        if (has_digit) {
            used_manual = true;
        } else {
            used_auto = true;
            idx = auto_next;
            auto_next = auto_next + 1;
        }
        // 与 CPython 一致：自动编号与手动索引不得混用，否则读者要心算下一个是几号
        if (used_auto && used_manual) {
            fc_err("T-FST-E309",
                "同一模板里不能混用自动编号 `{}` 与手动索引 `{0}`；请统一其中一种",
                tmpl_node);
            return ti_mk("Unknown");
        }

        // 格式规范（可选）
        var spec: string = "";
        if (i < tl && (tmpl[i] as i64) == 58) {
            i = i + 1;
            var sp0: u64 = i;
            while (i < tl && (tmpl[i] as i64) != 125) { i = i + 1; }
            spec = str_slice(tmpl, sp0, i);
        }

        if (i >= tl || (tmpl[i] as i64) != 125) {
            fc_err("T-FST-E307",
                "替换字段没有闭合的 `}`；要输出字面左花括号请写 `{{`", tmpl_node);
            return ti_mk("Unknown");
        }
        i = i + 1;                         // 跳过 '}'

        if (idx < 0 || idx >= argc) {
            fc_err("T-FST-E310",
                sb_cat3("模板引用了第 ", i2s(idx),
                    sb_cat3(" 个值实参，但只传入了 ", i2s(argc), " 个")),
                tmpl_node);
            return ti_mk("Unknown");
        }
        if (idx + 1 > used_idx) { used_idx = idx + 1; }

        // A1a：聚合实参（结构体/切片/数组/映射）仅 !j 合法
        if (g_fmt_json[idx]) {
            if (conv != 106) {
                fc_err("T-FST-E306",
                    sb_cat3("format 的第 ", i2s(idx),
                        " 个值实参是聚合类型，只能用 !j 转换字段做 JSON 编码（如 {0!j}）；非 !j 转换字段仅支持标量 / 字符串"),
                    tmpl_node);
                return ti_mk("Unknown");
            }
            body_tail = fmt_gen_json(body_head, body_tail,
                mk_ident(sb_cat2("a", i2s(idx)), -1), g_fmt_json_ti[idx]);
            if (body_head < 0) { body_head = body_tail; }
            continue;
        }

        // sb_append_fmt_X(__fb, "spec", aK[, "conv"]);
        var appfn: string = fmt_conv_fn(g_fmt_ak[idx], conv);
        if (str_len(appfn) == 0) {
            fc_err("T-FST-E311",
                sb_cat3("转换字段 `!", fmt_conv_name(conv),
                    "` 不适用于当前值实参的类型"),
                tmpl_node);
            return ti_mk("Unknown");
        }
        var fa_head: i64 = -1;
        var fa_tail: i64 = -1;
        fa_tail = list_push(fa_head, fa_tail, mk_ident("__fb", -1));
        if (fa_head < 0) { fa_head = fa_tail; }
        fa_tail = list_push(fa_head, fa_tail, mk_string(spec, -1));
        if (fa_head < 0) { fa_head = fa_tail; }
        fa_tail = list_push(fa_head, fa_tail, mk_ident(sb_cat2("a", i2s(idx)), -1));
        if (fa_head < 0) { fa_head = fa_tail; }
        if (fmt_fn_takes_mode(appfn)) {
            fa_tail = list_push(fa_head, fa_tail, mk_string(fmt_conv_name(conv), -1));
            if (fa_head < 0) { fa_head = fa_tail; }
        }
        var fcall: i64 = mk_call(mk_ident(appfn, -1), fa_head, -1);
        body_tail = fmt_push_stmt(body_head, body_tail, mk_expr(fcall, -1));
        if (body_head < 0) { body_head = body_tail; }
    }

    // 收尾字面段
    var tailseg: string = sb_to_str(lit);
    if (str_len(tailseg) > 0) {
        var ta_head: i64 = -1;
        var ta_tail: i64 = -1;
        ta_tail = list_push(ta_head, ta_tail, mk_ident("__fb", -1));
        if (ta_head < 0) { ta_head = ta_tail; }
        ta_tail = list_push(ta_head, ta_tail, mk_string(tailseg, -1));
        if (ta_head < 0) { ta_head = ta_tail; }
        var tcall: i64 = mk_call(mk_ident("sb_append_str", -1), ta_head, -1);
        body_tail = fmt_push_stmt(body_head, body_tail, mk_expr(tcall, -1));
        if (body_head < 0) { body_head = body_tail; }
    }

    // return sb_to_str(__fb);
    var ra_head: i64 = -1;
    var ra_tail: i64 = -1;
    ra_tail = list_push(ra_head, ra_tail, mk_ident("__fb", -1));
    if (ra_head < 0) { ra_head = ra_tail; }
    var rcall: i64 = mk_call(mk_ident("sb_to_str", -1), ra_head, -1);
    body_tail = fmt_push_stmt(body_head, body_tail, mk_return(rcall, -1));
    if (body_head < 0) { body_head = body_tail; }

    // ── 4. 合成形参列表 a0..a(argc-1) ──────────────────────
    var p_head: i64 = -1;
    var p_tail: i64 = -1;
    var pi: i64 = 0;
    while (pi < argc) {
        var pn: i64 = mk_P(sb_cat2("a", i2s(pi)), g_fmt_at[pi], -1, -1);
        p_tail = list_push(p_head, p_tail, pn);
        if (p_head < 0) { p_head = p_tail; }
        pi = pi + 1;
    }

    // ── 5. 提升为顶层函数并注册 ────────────────────────────
    var fn_name: string = sb_cat2("__fmt_", i2s(g_fmt_counter));
    g_fmt_counter = g_fmt_counter + 1;
    var fdecl: i64 = mk_FuncDecl(fn_name, false, false, mk_scalar("string", -1),
        -1, p_head, body_head, -1);
    // 锚点承接：合成函数若在发射期出诊断，得能指回用户写 format 的那一行
    var fdn: Node = nodes[fdecl];
    fdn.ln = n.ln;
    fdn.cl = n.cl;
    fdn.tv = n.tv;
    slice_set(nodes, fdecl, fdn);
    sym_define(global_scope, fn_name, "func", ti_named("Func", fn_name), fdecl);
    append(decl_list, fdecl);

    // ── 6. 就地改写调用点：format(tmpl, a, b) → __fmt_N(a, b) ──
    var nn: Node = nodes[e];
    nn.na = mk_ident(fn_name, -1);
    if (nn.la >= 0) {
        var fk: Child = kids[nn.la];
        nn.la = fk.next;                   // 丢掉模板串实参
    }
    slice_set(nodes, e, nn);
    return ti_mk("String");
}

// 调用实参**不走通用遍历**（见 run_check 尾部关于 scan_fid_format_atoms 的长注释），
// 于是 `show(format(...))` / `sb_append_str(b, format(...))` 里的 format 永远等不到
// infer，发射期只会吐一行 `; UNSUPPORTED call format` 然后生成 `load %TStr, ptr 0`。
// 平坦扫描救不了它 —— 脱糖要实参的静态类型，而类型要作用域，出了 check 就没了。
// 故在 call 分支入口就地补扫实参子树：此刻 cur_scope 正确，命中即交回 infer_expr。
//
// 递归保护用节点池的天然不变式：`node_new` 顺序追加 ⇒ 子节点索引恒小于父节点。
// 只向索引更小处递归，既杜绝成环，也挡住「某 kind 把非节点整数存进 na」的误伤。
// （开关 g_has_format 声明在 parse_post_call 附近，与置位点同处。）

fn fmt_scan_list(h: i64, lim: i64) void {
    var c: i64 = h;
    while (c >= 0) {
        var k: Child = kids[c];
        fmt_scan_subtree(k.val, lim);
        c = k.next;
    }
}

fn fmt_scan_subtree(x: i64, lim: i64) void {
    if (x < 0 || x >= lim) { return; }
    var xn: Node = nodes[x];
    if (xn.kind == "call" && xn.na >= 0) {
        var cee: Node = nodes[xn.na];
        if (cee.sa == "format" && (cee.kind == "ident" || cee.kind == "member")) {
            infer_expr(x);          // 就地改写成 __fmt_N(...)，幂等
            xn = nodes[x];          // 重读：na/la 已被改写
        }
    }
    fmt_scan_subtree(xn.na, lim);
    fmt_scan_subtree(xn.nb, lim);
    fmt_scan_subtree(xn.nc, lim);
    fmt_scan_subtree(xn.nd, lim);
    fmt_scan_list(xn.la, lim);
    fmt_scan_list(xn.lb, lim);
    fmt_scan_list(xn.lc, lim);
}

// ── 管道算子降解（reference.md §3.15）──────────────────────────
//
// 三个管道节点（pipe_map / pipe_filter / pipe_apply）在 infer_expr 入口被**就地**降解，
// 两个后端因此永远看不到 pipe_*。整体思路与 __fmt_N 同构（见 desugar_format_call）：
// 提升出一个顶层合成函数、把原节点改写成对它的调用。
//
//   · 连续的「元素级」阶段（`|->`、`|>?`、以及分派为逐元素的 `|>`）融合进 **一个**
//     合成函数 `__pipe_N(源, f0, f1, ...)` 里的单趟 for 循环 —— 中间序列不落地；
//   · 「整体应用」形态的 `|>` 改写成 `F(E)`，并先把它之前累积的元素级阶段冲刷成一次
//     __pipe_N 调用（即融合边界）。
//
// 右侧函数一律**先绑成实参**再进循环，而不是在循环体里重复求值 —— 这就是规范
// 「右操作数只求值一次」的实现。
//
// 为什么降解必须落在 sema 而不是 parser：`|>` 的整体/逐元素分派是**类型定向**的，
// 解析期拿不到左操作数的类型。

var g_pipe_counter: i64 = 0;
// `|v: T| expr` 简写闭包的「返回类型待推断」标记：resolve_ti 把 infer_ret 占位节点
// 映射到这里（全局唯一的 Infer TI），sema 在用到该 lambda 时才推断真实返回类型。
// 仅简写闭包会触发，既有 `fn (v: T) R {...}` 不受影响。
var g_infer_ti: i64 = -1;
// 许可上下文（reference.md §3.15.6）里那个管道根节点的 id。check_stmt 在四个许可槽位
// 上置位（已剥掉外层括号），infer_expr 的管道分支据此判定 E865：出现在别处的管道
// 一律拒绝。判据用节点 id 而非布尔开关，因为 infer_expr 会向子表达式递归，
// 布尔开关会被子树误继承。
var g_pipe_root: i64 = -1;
// 降解期追加的合成函数：run_check 的主检查循环长度已冻结，故另行补检（见 run_check 尾部）。
var g_pipe_decls: []i64;
// 任一条管道降解出过错。合成函数是从**已经错了**的链拼出来的，再检查它只会
// 级联出二手噪声（谓词返回 i32 → 合成的 if 又报一次隐式布尔），故一旦置位就
// 跳过尾部补检；主诊断已经指在用户写的那个算子上。
var g_pipe_bad: bool = false;

fn is_pipe_kind(k: string) bool {
    if (k == "pipe_map") { return true; }
    if (k == "pipe_filter") { return true; }
    if (k == "pipe_apply") { return true; }
    return false;
}

// ── `|v: T| expr` 简写闭包的返回类型推断 ──────────────────────
// 简写闭包没有显式返回类型（占位 infer_ret → g_infer_ti）。凡用到它（作为值、
// 或进了管道），就在那时就地扫描函数体里的 `return <expr>` 推断真实返回类型，
// 回填到该函数的 tif_ret 与 FuncDecl 的 n.na。仅对带 infer_ret 占位的函数生效，
// 既有 `fn (v: T) R {...}`（始终带显式 R）完全不受影响。
// 递归保护：若本次推断途中又遇到同一函数（递归/互递归），直接沿用 g_infer_ti 占位，
// 不进入死循环；最终由 check_func_decl 的 all_paths_return 等后续检查兜底。

// 在语句链里找第一个「带值的 return」，返回其推断类型；全程无带值 return → 返回 -1（即 void）。
fn infer_scan_return(s: i64) i64 {
    if (s < 0) { return -1; }
    var best: i64 = -1;
    var cur: i64 = s;
    while (cur >= 0) {
        var k: Child = kids[cur];
        var st: i64 = k.val;
        var sn: Node = nodes[st];
        if (sn.kind == "return") {
            if (sn.na >= 0) {
                var rt: i64 = infer_expr(sn.na);
                if (tip_kind(rt) != "Void" && tip_kind(rt) != "Unknown") { return rt; }
            }
        } else if (sn.kind == "block") {
            var r2: i64 = infer_scan_return(sn.la);
            if (r2 >= 0) { return r2; }
        } else if (sn.kind == "if") {
            // if/else 两枝都可能含 return
            if (sn.na >= 0) { var r2: i64 = infer_scan_return(sn.na); if (r2 >= 0) { return r2; } }
            if (sn.nb >= 0) { var r3: i64 = infer_scan_return(sn.nb); if (r3 >= 0) { return r3; } }
        } else if (sn.kind == "for" || sn.kind == "while") {
            var r2: i64 = infer_scan_return(sn.la);
            if (r2 >= 0) { return r2; }
        }
        cur = k.next;
    }
    return best;
}

fn infer_lambda_ret_from_decl(d: i64) i64 {
    var n: Node = nodes[d];
    // 找到该函数对应的 fti（符号表里 kind=="func" 的条目）
    var si: i64 = sym_lookup(global_scope, n.sa);
    if (si < 0) { return g_infer_ti; }
    var fti: i64 = syms[si].ti;
    // 已经推断过了（tif_ret 不再是占位）→ 直接返回，幂等
    if (tif_ret[fti] != g_infer_ti) { return tif_ret[fti]; }
    // 防递归：先把 tif_ret 设成一个非占位值（Void），推断完再纠正
    tif_ret[fti] = ti_mk("Void");
    // 在参数作用域里扫描 return 表达式
    var prev_scope: i64 = cur_scope;
    var prev_ret: i64 = cur_ret;
    cur_scope = scope_new(global_scope);
    var p: i64 = n.lb;
    while (p >= 0) {
        var pk: Child = kids[p];
        var pn: Node = nodes[pk.val];
        sym_define(cur_scope, pn.sa, "var", resolve_ti(pn.na), -1);
        p = pk.next;
    }
    // 提升后的合成闭包函数：体首的 closure_capture 语句把捕获量（如 base）绑定进环境结构，
    // 返回类型推断时这些名字必须可见，否则 `return x + base` 里的 base 会被判为「未定义标识符」。
    // 此处把体首的 closure_capture 也登记进推断作用域（与完整检查时的绑定一致）。
    var cb: i64 = n.lc;
    while (cb >= 0) {
        var cbs: Node = nodes[kids[cb].val];
        if (cbs.kind == "closure_capture") {
            sym_define(cur_scope, cbs.sa, "var", resolve_ti(cbs.na), -1);
        }
        cb = kids[cb].next;
    }
    var inferred: i64 = infer_scan_return(n.lc);
    if (inferred < 0) { inferred = ti_mk("Void"); }
    cur_ret = prev_ret;
    cur_scope = prev_scope;
    // 回填：tif_ret（调用方看到的签名）与 FuncDecl 的 n.na（发射期读的类型节点）
    tif_ret[fti] = inferred;
    n.na = mk_type_node_from_ti(inferred);
    slice_set(nodes, d, n);
    return inferred;
}

// 剥掉外层括号后置位管道根，返回被剥出的节点 id（供调用方判断是否管道）。
fn pipe_mark(x: i64) i64 {
    var y: i64 = x;
    var go: bool = true;
    while (go == true) {
        go = false;
        if (y >= 0) {
            if (nodes[y].kind == "paren") {
                y = nodes[y].na;
                go = true;
            }
        }
    }
    g_pipe_root = y;
    return y;
}

fn pipe_warn(code: string, msg: string, d: i64) void {
    var l: i64 = n_line(d);
    var c: i64 = n_col(d);
    diag_new(code, "warning", msg, n_file(d), l, c, l, c + 4);
}

// 可流入判据：同型或可隐式转型 —— 与调用实参用的是同一套规则（见 check_call_args）。
// Unknown 一律放行：该处多半已有诊断，再报一次只是级联噪声。
fn pipe_flows(from: i64, to: i64) bool {
    if (from < 0) { return true; }
    if (to < 0) { return true; }
    if (tip_kind(from) == "Unknown") { return true; }
    if (tip_kind(to) == "Unknown") { return true; }
    if (ti_equal(from, to) == true) { return true; }
    return can_cast(from, to);
}

// 序列（切片 / 定长数组）的元素类型；非序列返回 -1。
fn pipe_seq_elem(t: i64) i64 {
    var k: string = tip_kind(t);
    if (k == "Slice") {
        var t1: TI = tis[t];
        return t1.elem;
    }
    if (k == "Array") {
        var t2: TI = tis[t];
        return t2.elem;
    }
    return -1;
}

fn pipe_is_bool(t: i64) bool {
    if (tip_kind(t) != "Scalar") { return false; }
    return tip_name(t) == "bool";
}

// 把 [seg0, len) 段的元素级阶段冲刷成一个合成函数，返回对它的调用节点。
//   __pipe_N fn(__ps: <src>, __pf0: <F0>, ...) []<out> {
//       var __po: []<out> = [];
//       for (__pe in __ps) { <阶段链> append(__po, <末级值>); }
//       return __po;
//   }
// 循环体自内向外包裹：filter 包一层 if，map 前置一条 var 声明。
fn pipe_flush(src_e: i64, src_ti: i64, out_elem: i64, seg0: i64,
              pk: []string, pf: []i64, pft: []i64, prt: []i64, anchor: i64) i64 {
    var nst: i64 = (slice_len(pk) as i64) - seg0;

    // ── 形参：源序列 + 每阶段一个函数值 ────────────────────────
    var ph: i64 = -1;
    var pt: i64 = -1;
    pt = list_push(ph, pt, mk_P("__ps", mk_type_node_from_ti(src_ti), -1, -1));
    if (ph < 0) { ph = pt; }
    var j: i64 = 0;
    while (j < nst) {
        var ptn: i64 = mk_type_node_from_ti(pft[seg0 + j]);
        pt = list_push(ph, pt, mk_P(sb_cat2("__pf", i2s(j)), ptn, -1, -1));
        if (ph < 0) { ph = pt; }
        j = j + 1;
    }

    // ── 每阶段的输入变量名：filter 不改变量，map 产出 __pv<j> ──
    var invar: []string;
    var cvn: string = "__pe";
    var j2: i64 = 0;
    while (j2 < nst) {
        append(invar, cvn);
        if (pk[seg0 + j2] == "map") { cvn = sb_cat2("__pv", i2s(j2)); }
        j2 = j2 + 1;
    }

    // ── 最内层：append(__po, <末级变量>) ──────────────────────
    var ah: i64 = -1;
    var at: i64 = -1;
    at = list_push(ah, at, mk_ident("__po", -1));
    if (ah < 0) { ah = at; }
    at = list_push(ah, at, mk_ident(cvn, -1));
    if (ah < 0) { ah = at; }
    var body: i64 = -1;
    var bt: i64 = -1;
    bt = list_push(body, bt, mk_expr(mk_call(mk_ident("append", -1), ah, -1), -1));
    if (body < 0) { body = bt; }

    // ── 自内向外包裹各阶段 ────────────────────────────────────
    var j3: i64 = nst - 1;
    while (j3 >= 0) {
        var ch: i64 = -1;
        var ct: i64 = -1;
        ct = list_push(ch, ct, mk_ident(invar[j3], -1));
        if (ch < 0) { ch = ct; }
        var callf: i64 = mk_call(mk_ident(sb_cat2("__pf", i2s(j3)), -1), ch, -1);
        if (pk[seg0 + j3] == "filter") {
            var nh: i64 = -1;
            var nt: i64 = -1;
            nt = list_push(nh, nt, mk_if(callf, body, -1, -1));
            if (nh < 0) { nh = nt; }
            body = nh;
        } else {
            var vdecl: i64 = mk_var_decl(sb_cat2("__pv", i2s(j3)), false,
                mk_type_node_from_ti(prt[seg0 + j3]), callf, -1);
            var nh2: i64 = -1;
            var nt2: i64 = -1;
            nt2 = list_push(nh2, nt2, vdecl);
            if (nh2 < 0) { nh2 = nt2; }
            var cc: i64 = body;
            while (cc >= 0) {
                var kk: Child = kids[cc];
                nt2 = list_push(nh2, nt2, kk.val);
                if (nh2 < 0) { nh2 = nt2; }
                cc = kk.next;
            }
            body = nh2;
        }
        j3 = j3 - 1;
    }

    // ── 函数体：声明累加器 → 单趟 for → 返回 ──────────────────
    var fh: i64 = -1;
    var ft: i64 = -1;
    ft = list_push(fh, ft, mk_var_decl("__po", false,
        mk_slice(mk_type_node_from_ti(out_elem), -1), mk_array_lit(-1, -1), -1));
    if (fh < 0) { fh = ft; }
    ft = list_push(fh, ft, mk_for_each("__pe", "", mk_ident("__ps", -1), body, -1));
    if (fh < 0) { fh = ft; }
    ft = list_push(fh, ft, mk_return(mk_ident("__po", -1), -1));
    if (fh < 0) { fh = ft; }

    var fname: string = sb_cat2("__pipe_", i2s(g_pipe_counter));
    g_pipe_counter = g_pipe_counter + 1;
    var fdecl: i64 = mk_FuncDecl(fname, false, false,
        mk_slice(mk_type_node_from_ti(out_elem), -1), -1, ph, fh, -1);
    // 锚点承接：合成函数若在发射期出诊断，得能指回用户写管道的那一行
    var fdn: Node = nodes[fdecl];
    var an: Node = nodes[anchor];
    fdn.ln = an.ln;
    fdn.cl = an.cl;
    fdn.tv = an.tv;
    slice_set(nodes, fdecl, fdn);
    register_decl(fdecl);            // 填 tif_* 真实签名并 sym_define
    append(decl_list, fdecl);
    append(g_pipe_decls, fdecl);

    // ── 调用点：__pipe_N(src, f0, f1, ...) ────────────────────
    var ch2: i64 = -1;
    var ct2: i64 = -1;
    ct2 = list_push(ch2, ct2, src_e);
    if (ch2 < 0) { ch2 = ct2; }
    var j4: i64 = 0;
    while (j4 < nst) {
        ct2 = list_push(ch2, ct2, pf[seg0 + j4]);
        if (ch2 < 0) { ch2 = ct2; }
        j4 = j4 + 1;
    }
    return mk_call(mk_ident(fname, -1), ch2, -1);
}

fn lower_pipe(e: i64) i64 {
    if (e != g_pipe_root) {
        fc_err("T-PIP-E865",
            "管道表达式只能出现在四个位置：变量/常量初始化、赋值右侧、return、表达式语句",
            e);
    }

    // ── 1. 摘下左脊：chain = [最外层 … 最内层]，cur 落到基表达式 ──
    var chain: []i64;
    var cur: i64 = e;
    while (is_pipe_kind(nodes[cur].kind) == true) {
        append(chain, cur);
        cur = nodes[cur].na;
    }
    var nchain: i64 = slice_len(chain) as i64;
    var cur_e: i64 = cur;
    var cur_ti: i64 = infer_expr(cur);

    // 待融合的元素级阶段（表只增不清，用 seg0 划出当前融合段）
    var pk: []string;
    var pf: []i64;
    var pft: []i64;
    var prt: []i64;
    var seg0: i64 = 0;
    var in_seg: bool = false;
    var seg_src_e: i64 = -1;
    var seg_src_ti: i64 = -1;
    var seg_elem: i64 = -1;
    var bad: bool = false;

    // ── 2. 按求值序处理各阶段 ────────────────────────────────
    var i: i64 = nchain - 1;
    while (i >= 0) {
        var p: i64 = chain[i];
        var pn: Node = nodes[p];
        var pkind: string = pn.kind;
        var rhs: i64 = pn.nb;
        var fti: i64 = infer_expr(rhs);

        // 逻辑上「当前流动值」的类型与元素类型
        var flow_ti: i64 = cur_ti;
        var flow_elem: i64 = pipe_seq_elem(cur_ti);
        if (in_seg == true) {
            flow_elem = seg_elem;
            flow_ti = ti_elem_of("Slice", seg_elem);
        }
        var is_seq: bool = flow_elem >= 0;

        // ⚠ 定长数组暂不能进管道：降解出的辅助函数以 `[N]T` 接收源，而 `[N]T` 在
        // 双后端都是**裸元素指针**（长度只活在静态类型里），foreach 降解却按
        // TSlice 去读 `t_slice_len/t_slice_at` → 段错误。§3.15.2 规则 4 承诺支持
        // `[N]T`，实现未跟上；在 Array→Slice 构造 lowering 落地前显式拒绝，
        // 不把崩溃留到运行期（宪法 L-02）。
        if (tip_kind(flow_ti) == "Array") {
            fc_err("T-PIP-E863",
                sb_cat3("管道暂不支持定长数组左操作数 `", ti_str(flow_ti),
                    "`：请改用切片 `[]T`（定长数组与切片运行时表示不同，尚无转换 lowering）"), p);
            bad = true;
            i = i - 1;
            continue;
        }

        // 右操作数必须是一元函数值
        if (tip_kind(fti) != "Func") {
            fc_err("T-PIP-E860",
                sb_cat3("管道右操作数必须是函数值，实为 `", ti_str(fti), "`"), rhs);
            bad = true;
            i = i - 1;
            continue;
        }
        if (tif_pcount[fti] != 1) {
            fc_err("T-PIP-E861",
                sb_cat3("管道右侧函数必须恰好接受 1 个形参，实为 ",
                    i2s(tif_pcount[fti]), " 个"), rhs);
            bad = true;
            i = i - 1;
            continue;
        }
        var ppt: i64 = tif_params[tif_pstart[fti]];
        var prt1: i64 = tif_ret[fti];

        if (pkind == "pipe_map" || pkind == "pipe_filter") {
            // 元素级算子：左操作数必须是序列
            if (is_seq == false) {
                fc_err("T-PIP-E863",
                    sb_cat3("`", pipe_op_text(pkind),
                        sb_cat3("` 的左操作数必须是切片或定长数组，实为 `",
                            ti_str(flow_ti), "`")), p);
                bad = true;
                i = i - 1;
                continue;
            }
            if (pipe_flows(flow_elem, ppt) == false) {
                fc_err("T-PIP-E862",
                    sb_cat3("元素类型 `", ti_str(flow_elem),
                        sb_cat3("` 无法流入形参类型 `", ti_str(ppt), "`")), rhs);
                bad = true;
            }
            if (pkind == "pipe_filter") {
                if (pipe_is_bool(prt1) == false) {
                    fc_err("T-PIP-E864",
                        sb_cat3("`|>?` 的谓词必须返回 bool，实为 `", ti_str(prt1), "`"), rhs);
                    bad = true;
                }
            }
            // ⚠ 映射函数返回 void 会产出无意义的 `[]void`，降解出 `var __pv0: void = f(x);`
            // → LLVM `alloca void`（非法 IR，clang 直接拒绝），C 后端同样是坏声明。
            // 管道是**变换**管线，不是副作用遍历（§3.15 明确不含遍历/生成器语义），
            // 副作用请用 `for (x in xs) { ... }`。宪法 L-02：宁可编译期硬错，不产坏 IR。
            if (pkind == "pipe_map") {
                if (tip_kind(prt1) == "Void") {
                    fc_err("T-PIP-E869",
                        "`|->` 的映射函数不能返回 void：管道用于变换，副作用遍历请用 `for (x in xs)`", rhs);
                    bad = true;
                }
            }
            if (in_seg == false) {
                seg0 = slice_len(pk) as i64;
                seg_src_e = cur_e;
                seg_src_ti = cur_ti;
                seg_elem = flow_elem;
                in_seg = true;
            }
            if (pkind == "pipe_filter") {
                append(pk, "filter");
            } else {
                append(pk, "map");
            }
            append(pf, rhs);
            append(pft, fti);
            append(prt, prt1);
            if (pkind == "pipe_map") { seg_elem = prt1; }
            i = i - 1;
            continue;
        }

        // ── `|>` 多态分派（reference.md §3.15.5）─────────────
        // 整体应用优先；两者同时成立给 W866 并取整体应用。
        var whole: bool = pipe_flows(flow_ti, ppt);
        var elemw: bool = false;
        if (is_seq == true) { elemw = pipe_flows(flow_elem, ppt); }
        if (whole == true && elemw == true) {
            pipe_warn("T-PIP-W866",
                sb_cat3("`|>` 的整体应用与逐元素映射同时成立，按规范取整体应用；",
                    "如需逐元素请改写为 `|->`", ""), p);
        }
        if (whole == true) {
            // 冲刷已累积的元素级阶段，再对整段结果做一次调用
            if (in_seg == true) {
                cur_e = pipe_flush(seg_src_e, seg_src_ti, seg_elem, seg0, pk, pf, pft, prt, p);
                cur_ti = ti_elem_of("Slice", seg_elem);
                in_seg = false;
            }
            var wh: i64 = -1;
            var wt: i64 = -1;
            wt = list_push(wh, wt, cur_e);
            if (wh < 0) { wh = wt; }
            cur_e = mk_call(rhs, wh, -1);
            cur_ti = prt1;
            i = i - 1;
            continue;
        }
        if (elemw == true) {
            if (tip_kind(prt1) == "Void") {
                // `|->` / `|>?` 的映射函数返回 void 没有意义（产出 `[]void` → alloca void 非法 IR），
                // 仍按宪法 L-02 硬错；但 `|>` 的逐元素 void 是合法的**副作用遍历**
                // （`(xs) |> |v| print(v)` 等价于 `for (v in xs) { print(v); }`），降级成 for-each。
                if (pkind != "pipe_apply") {
                    fc_err("T-PIP-E869",
                        "`|->` / `|>?` 的函数不能返回 void：管道用于变换，副作用遍历请用 `for (x in xs)` 或 `(xs) |> |v| ...`", rhs);
                    bad = true;
                    i = i - 1;
                    continue;
                }
                // 冲刷已累积的元素级阶段（如有），再对结果做 for-each
                if (in_seg == true) {
                    cur_e = pipe_flush(seg_src_e, seg_src_ti, seg_elem, seg0, pk, pf, pft, prt, p);
                    cur_ti = ti_elem_of("Slice", seg_elem);
                    in_seg = false;
                }
                // 生成：for (var __fe in <seq>) { rhs(__fe); }
                var fevar: string = sb_cat2("__fe", i2s(g_pipe_counter));
                g_pipe_counter = g_pipe_counter + 1;
                var argl: i64 = -1;
                var arglt: i64 = -1;
                arglt = list_push(argl, arglt, mk_ident(fevar, -1));
                if (argl < 0) { argl = arglt; }
                var fecall: i64 = mk_call(rhs, argl, -1);
                var feblk: i64 = -1;
                var feblkt: i64 = -1;
                feblkt = list_push(feblk, feblkt, mk_expr(fecall, -1));
                if (feblk < 0) { feblk = feblkt; }
                var feloop: i64 = mk_for_each(fevar, "", cur_e, feblk, -1);
                cur_e = feloop;
                cur_ti = ti_mk("Void");
                i = i - 1;
                continue;
            }
            if (in_seg == false) {
                seg0 = slice_len(pk) as i64;
                seg_src_e = cur_e;
                seg_src_ti = cur_ti;
                seg_elem = flow_elem;
                in_seg = true;
            }
            append(pk, "map");
            append(pf, rhs);
            append(pft, fti);
            append(prt, prt1);
            seg_elem = prt1;
            i = i - 1;
            continue;
        }
        if (is_seq == true) {
            fc_err("T-PIP-E867",
                sb_cat3("`|>`：右侧函数既不接受整体 `", ti_str(flow_ti),
                    sb_cat3("`，也不接受元素 `", ti_str(flow_elem), "`")), p);
        } else {
            fc_err("T-PIP-E862",
                sb_cat3("值类型 `", ti_str(flow_ti),
                    sb_cat3("` 无法流入形参类型 `", ti_str(ppt), "`")), rhs);
        }
        bad = true;
        i = i - 1;
    }

    // ── 3. 收尾冲刷 ──────────────────────────────────────────
    if (in_seg == true) {
        cur_e = pipe_flush(seg_src_e, seg_src_ti, seg_elem, seg0, pk, pf, pft, prt, e);
        cur_ti = ti_elem_of("Slice", seg_elem);
    }

    // ── 4. 就地改写：管道节点退化成透传 paren，na 指向降解结果 ──
    // 用 paren 而非直接搬运字段：paren 是既有的透传节点，四处（expr_type_desc /
    // ll_etd / emit_expr / emit_lle）都已支持，无需给后端新增分支。
    var on: Node = nodes[e];
    // `|>` 逐元素 + void lambda 降级出的 for-each 循环是语句，不能作为表达式用
    // paren 包裹（那样会走 emit_expr 路径 → 报 unsupported expr）。这里单独把它
    // 包成一个 block 语句块发射。其余情况照旧退化成透传 paren。
    if (nodes[cur_e].kind == "for_each") {
        var bh: i64 = -1;
        var bt: i64 = -1;
        bt = list_push(bh, bt, cur_e);
        if (bh < 0) { bh = bt; }
        on.kind = "block";
        on.na = -1;
        on.nb = -1;
        on.la = bh;
        slice_set(nodes, e, on);
        if (bad == true) {
            g_pipe_bad = true;
            return ti_mk("Unknown");
        }
        return cur_ti;
    }
    on.kind = "paren";
    on.na = cur_e;
    on.nb = -1;
    on.la = -1;
    slice_set(nodes, e, on);
    if (bad == true) {
        g_pipe_bad = true;
        return ti_mk("Unknown");
    }
    return cur_ti;
}

fn pipe_op_text(k: string) string {
    if (k == "pipe_map") { return "|->"; }
    if (k == "pipe_filter") { return "|>?"; }
    return "|>";
}

// ── 区间字面量降解（M-range）──────────────────────────────────
// 设计前提：**区间不是运行期值**。没有 Range 结构体、没有迭代器协议，`range`
// 节点在 sema（个别在 codegen 的 match 脱糖）里按上下文就地降解掉，两个后端
// 永远看不到 `range` —— 故 codegen_c / codegen_ll 对本特性零改动（除新增的
// slice_sub 内建）。
//
//   for (i in a..b)   → block { var _rgN_hi: i64 = b;
//                               for (var i: i64 = a; i < _rgN_hi; i = i+1) { … } }
//   s[a..b]           → str_slice(s, a, b) / slice_sub(s, a, b)
//   x in a..b         → (x >= a && x < b)
//   match { a..b => } → 比较链（codegen 的 match_chain_from，双后端共用）
//   其余值位置        → 物化成 []i64，即 `(0..10) |> f` 走的路
//
// 端点缺省的语义**按上下文定**，而不是给一套统一默认值：
//   迭代必须有起点（`for (i in ..n)` 无从开始 → E870）；
//   取值必须两端俱全（`0..` 是无穷序列，物化会 OOM → E872）；
//   只有索引位允许缺省，缺省端补 0 / 长度（`s[..]` / `s[2..]` / `s[..3]`）。

var g_rng_counter: i64 = 0;
// 物化助手 `__range_fill(lo, hi) []i64` 的函数名；整轮编译只合成一次
var g_range_fn: string = "";

fn is_range_node(e: i64) bool {
    if (e < 0) { return false; }
    return nodes[e].kind == "range";
}

fn rng_lit(v: i64) i64 {
    return mk_int(i2s(v), v, -1);
}

// `var <name>: i64 = <init>;`
// 端点一律落到 i64：`0..n` 里的 `0` 若按字面量量级会被猜成 u8，与 `n: i64`
// 混算会在比较处炸类型；can_cast(int, int) 恒真，故初值宽窄不限。
fn rng_i64_decl(name: string, init: i64) i64 {
    return mk_var_decl(name, false, mk_scalar("i64", -1), init, -1);
}

// `<v> = <v> + 1`
fn rng_incr(v: string) i64 {
    return mk_assign("=", mk_ident(v, -1),
        mk_binary("+", mk_ident(v, -1), rng_lit(1), -1), -1);
}

// 把源节点的锚点（文件/行列）抄给合成节点，让降解后的诊断仍指回用户源码
fn rng_anchor(dst: i64, src: i64) void {
    if (dst < 0) { return; }
    if (src < 0) { return; }
    var d: Node = nodes[dst];
    var s: Node = nodes[src];
    d.ln = s.ln;
    d.cl = s.cl;
    d.tv = s.tv;
    slice_set(nodes, dst, d);
}

// 表达式是否为可寻址的 lvalue（可取址 `&x` 的候选）。ident / member / index / deref 均算。
fn expr_is_lvalue(e: i64) bool {
    if (e < 0) { return false; }
    var n: Node = nodes[e];
    if (n.kind == "ident") { return true; }
    if (n.kind == "member" || n.kind == "index" || n.kind == "deref") { return true; }
    return false;
}

// 取 lvalue 表达式的根绑定名：`x`→"x"；`g.x.y`/`a[i]`/`*p`→沿 na 递归到根 ident。
// 用于 const 引用静态常量规则与逃逸分析。
fn lvalue_root_name(e: i64) string {
    if (e < 0) { return ""; }
    var k: string = nodes[e].kind;
    if (k == "ident") { return nodes[e].sa; }
    if (k == "member" || k == "index" || k == "deref") {
        return lvalue_root_name(nodes[e].na);
    }
    return "";
}

// const 引用静态常量规则（T-SEM-E763）：const 绑定的引用初始化器 `&Y` 必须指向
// 静态常量（顶层 const），不得指向全局 var / 全局 let / 局部绑定。
// 仅在 Y 能在全局作用域解析、却非 const（不在 g_const_decl_ids）时报告，
// 避免对前向 const / 局部引用误报。
fn check_const_ref(s: i64) void {
    if (s < 0) { return; }
    var d: Node = nodes[s];
    if (d.nb < 0) { return; }
    if (nodes[d.nb].kind != "amp") { return; }  // v1：仅直接 &Y
    var root: string = lvalue_root_name(nodes[d.nb].na);
    if (str_len(root) == 0) { return; }
    var gi: i64 = sym_lookup(global_scope, root);
    if (gi < 0) { return; }  // 全局不可见：可能是前向 const 或局部，v1 不误报
    var gdecl: i64 = syms[gi].decl;
    if (gdecl < 0) { return; }
    // 目标必须是静态常量（顶层 const）。var / let / 局部都不行。
    if (g_const_decl_has(gdecl) == false) {
        fc_err("T-SEM-E763",
            sb_cat5("const 引用 `", d.sa, "` 只能指向静态常量（顶层 const），但 `", root,
                "` 不是静态常量（const 才能被 const 引用）"),
            s);
    }
}

// 表达式是否含有「指向局部绑定（函数内变量 / 参数）的取址 `&`」。
// 局部绑定不在全局作用域 → 该引用随函数返回/块结束而失效（悬垂风险）。
fn expr_has_local_addr(e: i64) bool {
    if (e < 0) { return false; }
    var k: string = nodes[e].kind;
    if (k == "amp") {
        var root: string = lvalue_root_name(nodes[e].na);
        if (str_len(root) > 0 && sym_lookup(global_scope, root) < 0) { return true; }
        return false;
    }
    if (expr_has_local_addr(nodes[e].na)) { return true; }
    if (expr_has_local_addr(nodes[e].nb)) { return true; }
    if (expr_has_local_addr(nodes[e].nc)) { return true; }
    if (expr_has_local_addr(nodes[e].nd)) { return true; }
    return false;
}

// 赋值目标是否为「更长寿」目标（全局变量 / 全局结构体字段 / 全局数组元素）。
// 是 → 把 `&局部` 赋给它即逃逸为悬垂指针。
fn assign_target_escapable(e: i64) bool {
    if (e < 0) { return false; }
    var k: string = nodes[e].kind;
    if (k == "ident") {
        return sym_lookup(global_scope, nodes[e].sa) >= 0;
    }
    if (k == "member" || k == "index") {
        var root: string = lvalue_root_name(e);
        if (str_len(root) > 0) { return sym_lookup(global_scope, root) >= 0; }
        return false;
    }
    return false;
}

// 表达式可否安全重复求值。降解会把 subject / 被索引对象在 AST 里再引用一次
// （后端按树发射 = 求值两次），只有纯表达式允许；否则报 E875 让用户先绑变量。
fn rng_pure(e: i64) bool {
    if (e < 0) { return true; }
    var n: Node = nodes[e];
    if (n.kind == "ident") { return true; }
    if (n.kind == "int" || n.kind == "float" || n.kind == "bool") { return true; }
    if (n.kind == "string" || n.kind == "atom" || n.kind == "fidconst") { return true; }
    if (n.kind == "paren" || n.kind == "cast" || n.kind == "unary") { return rng_pure(n.na); }
    if (n.kind == "member") { return rng_pure(n.na); }
    if (n.kind == "index" || n.kind == "binary") {
        if (rng_pure(n.na) == false) { return false; }
        return rng_pure(n.nb);
    }
    return false;
}

// 闭区间 `..=hi` 的**排他**上界：hi + 1。半开区间原样返回。
fn rng_excl_hi(hi: i64, incl: bool) i64 {
    if (incl == false) { return hi; }
    return mk_binary("+", hi, rng_lit(1), -1);
}

// 物化助手（惰性合成，整轮编译共用一份）：
//   __range_fill fn(lo: i64, hi: i64) []i64 {
//       var out: []i64 = [];
//       for (var i: i64 = lo; i < hi; i = i + 1) { append(out, i); }
//       return out;
//   }
// 与 __pipe_N 同一套注入机制：register_decl 填签名 → decl_list 供发射 →
// g_pipe_decls 让 run_check 尾部补检（主检查循环长度已冻结）。
fn rng_make_helper() string {
    if (str_len(g_range_fn) > 0) { return g_range_fn; }
    var name: string = "__range_fill";

    var ph: i64 = -1;
    var pt: i64 = -1;
    pt = list_push(ph, pt, mk_P("lo", mk_scalar("i64", -1), -1, -1));
    if (ph < 0) { ph = pt; }
    pt = list_push(ph, pt, mk_P("hi", mk_scalar("i64", -1), -1, -1));
    if (ph < 0) { ph = pt; }

    var apph: i64 = -1;
    var appt: i64 = -1;
    appt = list_push(apph, appt, mk_ident("out", -1));
    if (apph < 0) { apph = appt; }
    appt = list_push(apph, appt, mk_ident("i", -1));
    if (apph < 0) { apph = appt; }
    var bodyh: i64 = list_push(-1, -1,
        mk_expr(mk_call(mk_ident("append", -1), apph, -1), -1));

    var floop: i64 = mk_for(
        rng_i64_decl("i", mk_ident("lo", -1)),
        mk_binary("<", mk_ident("i", -1), mk_ident("hi", -1), -1),
        rng_incr("i"), bodyh, -1);

    var fh: i64 = -1;
    var ft: i64 = -1;
    ft = list_push(fh, ft, mk_var_decl("out", false,
        mk_slice(mk_scalar("i64", -1), -1), mk_array_lit(-1, -1), -1));
    if (fh < 0) { fh = ft; }
    ft = list_push(fh, ft, floop);
    if (fh < 0) { fh = ft; }
    ft = list_push(fh, ft, mk_return(mk_ident("out", -1), -1));
    if (fh < 0) { fh = ft; }

    var fdecl: i64 = mk_FuncDecl(name, false, false,
        mk_slice(mk_scalar("i64", -1), -1), -1, ph, fh, -1);
    register_decl(fdecl);
    append(decl_list, fdecl);
    append(g_pipe_decls, fdecl);
    g_range_fn = name;
    return name;
}

// 值位置的区间 → []i64。两端必须俱全：`0..` / `..n` / `..` 是无穷或无起点序列。
fn materialize_range(e: i64) i64 {
    var n: Node = nodes[e];
    var out_ti: i64 = ti_elem_of("Slice", ti_scalar("i64"));
    if (n.na < 0 || n.nb < 0) {
        fc_err("T-RNG-E872",
            "开放区间不能当作值：`a..` / `..b` / `..` 只在切片索引里有意义，取值请写成 `a..b`", e);
        return out_ti;
    }
    infer_expr(n.na);
    infer_expr(n.nb);
    var fname: string = rng_make_helper();
    var ah: i64 = -1;
    var at: i64 = -1;
    at = list_push(ah, at, n.na);
    if (ah < 0) { ah = at; }
    at = list_push(ah, at, rng_excl_hi(n.nb, n.ba));
    if (ah < 0) { ah = at; }
    var cl: i64 = mk_call(mk_ident(fname, -1), ah, -1);
    rng_anchor(cl, e);
    // 就地退化成透传 paren（与管道降解同一手法）：paren 在四处 emit/etd 都已支持，
    // 且重复 infer 天然幂等（第二次走的是 paren 分支）。
    var on: Node = nodes[e];
    on.kind = "paren";
    on.na = cl;
    on.nb = -1;
    on.la = -1;
    on.ba = false;
    slice_set(nodes, e, on);
    return out_ti;
}

// `obj[lo..hi]` → str_slice / slice_sub 调用。缺省端补 0 / 长度。
fn lower_range_index(e: i64) i64 {
    var n: Node = nodes[e];
    var ot: i64 = infer_expr(n.na);
    var k: string = tip_kind(ot);
    var r: Node = nodes[n.nb];
    if (r.na >= 0) { infer_expr(r.na); }
    if (r.nb >= 0) { infer_expr(r.nb); }
    if (k == "Unknown") { return ti_mk("Unknown"); }
    if (k == "Array") {
        // 定长数组在 C 后端是裸 T*、在 LLVM 后端是 [N x T]，都不是 TSlice。
        // Array→Slice 的构造 lowering 已落地（cast 节点 → t_slice_from_raw / @tll_slice_from_raw），
        // 这里包一层 cast 把它降级成零拷贝切片视图，随后与 `[]T` 走同一条 slice_sub 路径。
        var ati: TI = tis[ot];
        var asti: i64 = ti_elem_of("Slice", ati.elem);
        n.na = mk_cast(n.na, ti_to_type_node(asti), -1);
        slice_set(nodes, e, n);
        ot = asti;
        k = "Slice";
    }
    if (k != "String" && k != "Slice" && k != "Bytes") {
        fc_err("T-RNG-E871",
            sb_cat3("类型 `", ti_str(ot), "` 不支持区间索引：只有 string 与 []T 可以按区间切片"), e);
        return ti_mk("Unknown");
    }
    var hi: i64 = -1;
    if (r.nb >= 0) {
        hi = rng_excl_hi(r.nb, r.ba);
    } else {
        // 上界省略 → 取长度收尾。被索引对象因此在 AST 里出现两次。
        if (rng_pure(n.na) == false) {
            fc_err("T-RNG-E875",
                "省略上界的区间索引要对被索引对象多求值一次（取长度），但它含调用或副作用：请先绑定到变量再切", e);
            return ti_mk("Unknown");
        }
        var lenf: string = "slice_len";
        if (k == "String") { lenf = "str_len"; }
        if (k == "Bytes") { lenf = "bytes_len"; }
        var lenargs: i64 = list_push(-1, -1, n.na);
        // str_len / slice_len 返回 u64，切片函数吃 i64 —— 显式转掉，别指望隐式收敛
        hi = mk_cast(mk_call(mk_ident(lenf, -1), lenargs, -1), mk_scalar("i64", -1), -1);
    }
    var lo: i64 = r.na;
    if (lo < 0) { lo = rng_lit(0); }
    var fname: string = "slice_sub";
    if (k == "String") { fname = "str_slice"; }
    if (k == "Bytes") { fname = "bytes_slice"; }
    var ah: i64 = -1;
    var at: i64 = -1;
    at = list_push(ah, at, n.na);
    if (ah < 0) { ah = at; }
    at = list_push(ah, at, lo);
    if (ah < 0) { ah = at; }
    at = list_push(ah, at, hi);
    if (ah < 0) { ah = at; }
    var cl: i64 = mk_call(mk_ident(fname, -1), ah, -1);
    rng_anchor(cl, e);
    var on: Node = nodes[e];
    on.kind = "paren";
    on.na = cl;
    on.nb = -1;
    on.la = -1;
    slice_set(nodes, e, on);
    if (k == "String") { return ti_mk("String"); }
    if (k == "Bytes") { return ti_mk("Bytes"); }
    return ot;
}

// `x in lo..hi` → `(x >= lo && x < hi)`。x 出现两次，故要求它可重复求值。
fn lower_in_range(e: i64) i64 {
    var n: Node = nodes[e];
    if (is_range_node(n.nb) == false) {
        fc_err("T-RNG-E877",
            "`in` 的右侧只能是区间字面量（`x in 1..10` / `x in 'a'..='z'`）；容器成员测试请自己写循环", e);
        infer_expr(n.na);
        return ti_scalar("bool");
    }
    var r: Node = nodes[n.nb];
    if (rng_pure(n.na) == false) {
        fc_err("T-RNG-E875",
            "`in` 的左侧要展开成两次比较（求值两次），但它含调用或副作用：请先绑定到变量", e);
        return ti_scalar("bool");
    }
    infer_expr(n.na);
    if (r.na >= 0) { infer_expr(r.na); }
    if (r.nb >= 0) { infer_expr(r.nb); }
    var test: i64 = mk_range_test(n.na, n.na, n.nb);
    rng_anchor(test, e);
    var on: Node = nodes[e];
    on.kind = "paren";
    on.sa = "";
    on.na = test;
    on.nb = -1;
    on.la = -1;
    slice_set(nodes, e, on);
    infer_expr(test);
    return ti_scalar("bool");
}

// `for (v in lo..hi) { body }` → 零分配计数循环。就地把 for_each 改写成 block：
//   { var _rgN_hi: i64 = hi; for (var v: i64 = lo; v < _rgN_hi; v = v+1) { body } }
// 上界先落进临时量，这就是「右端只求值一次」的实现（`for (i in 0..xs.len())`
// 不会每轮重算）。上界省略（`for (i in 0..)`）则不生成条件 = 无限循环，靠 break 收口。
fn lower_for_range(s: i64) void {
    var n: Node = nodes[s];
    var r: Node = nodes[n.na];
    if (r.na < 0) {
        fc_err("T-RNG-E870",
            "区间迭代必须有起点：`..n` / `..` 无从开始，请写成 `0..n`", n.na);
        return;
    }
    if (str_len(n.sb) > 0) {
        fc_err("T-RNG-E870",
            "`for (k, v in ...)` 的双变量形式只用于 map；区间每轮只产出一个整数", n.na);
        return;
    }
    var head: i64 = -1;
    var tail: i64 = -1;
    var cond: i64 = -1;
    if (r.nb >= 0) {
        var hname: string = sb_cat3("_rg", i2s(g_rng_counter), "_hi");
        g_rng_counter = g_rng_counter + 1;
        tail = list_push(head, tail, rng_i64_decl(hname, r.nb));
        if (head < 0) { head = tail; }
        var cop: string = "<";
        if (r.ba == true) { cop = "<="; }
        cond = mk_binary(cop, mk_ident(n.sa, -1), mk_ident(hname, -1), -1);
    }
    var floop: i64 = mk_for(rng_i64_decl(n.sa, r.na), cond, rng_incr(n.sa), n.la, -1);
    rng_anchor(floop, s);
    tail = list_push(head, tail, floop);
    if (head < 0) { head = tail; }

    var on: Node = nodes[s];
    on.kind = "block";
    on.sa = "";
    on.sb = "";
    on.na = -1;
    on.la = head;
    slice_set(nodes, s, on);
}

// `for (v in 定长数组) { body }` → 改写成计数循环，每轮用 `<iter>[i]` 取下标元素
// （与 lower_for_range 同构，避免改动两后端 for_each）。
// 背景：LLVM / C 后端 for_each 只处理 slice 与 map，定长数组会掉进 slice 分支、
// 对数组值调 t_slice_len/t_slice_at 读垃圾 → 运行期段错误。此降级在 sema 层完成，
// 复用数组下标（基础特性，两后端均已支持）。
// 注意：直接对原迭代器表达式下标 `<iter>[i]`，不另绑临时数组 —— 定长数组在 var_decl
// 初始化里不会按元素拷贝（仅 zeroinit），绑临时量会丢失数据。
fn lower_for_array(s: i64) void {
    var n: Node = nodes[s];
    if (str_len(n.sb) > 0) {
        fc_err("T-SEM-E202",
            "for (k, v in x): 双变量迭代仅支持 map", n.na);
        return;
    }
    var itt: i64 = infer_expr(n.na);
    var tt: TI = tis[itt];
    var eti: i64 = tt.elem;
    var alen: i64 = tt.alen;
    if (eti < 0 || alen <= 0) {
        fc_err("T-SEM-E203",
            "for (v in x): 定长数组迭代未能解析元素类型 / 长度", n.na);
        return;
    }
    // 循环计数器
    var iname: string = sb_cat3("_fa", i2s(g_rng_counter), "_i");
    g_rng_counter = g_rng_counter + 1;
    // 长度绑进临时量（与 lower_for_range 的 _rgN_hi 同构：避免「字面量直接作比较右操作数」这一未充分测试的发射路径）
    var lname: string = sb_cat3("_fa", i2s(g_rng_counter), "_len");
    g_rng_counter = g_rng_counter + 1;
    var lendcl: i64 = mk_var_decl(lname, false, mk_scalar("i64", -1), mk_int(i2s(alen), 10, -1), -1);
    // 每轮：var <loopvar>: ElemT = <iter>[i];
    var elidx: i64 = mk_index(n.na, mk_ident(iname, -1), -1);
    var eldecl: i64 = mk_var_decl(n.sa, false, mk_type_node_from_ti(eti), elidx, -1);
    // 新循环体 = 元素声明 + 原 body
    var bhead: i64 = -1; var btail: i64 = -1;
    btail = list_push(bhead, btail, eldecl); if (bhead < 0) { bhead = btail; }
    var bk: i64 = n.la;
    while (bk >= 0) {
        btail = list_push(bhead, btail, kids[bk].val);
        bk = kids[bk].next;
    }
    if (bhead < 0) { bhead = btail; }
    // 计数循环：for (var _faN_i: i64 = 0; _faN_i < _faN_len; _faN_i = _faN_i + 1) { ... }
    var floop: i64 = mk_for(rng_i64_decl(iname, rng_lit(0)),
        mk_binary("<", mk_ident(iname, -1), mk_ident(lname, -1), -1),
        rng_incr(iname), bhead, -1);
    // block 的 la 必须是 kids 链表头：先放长度声明（供循环条件可见），再放循环本身
    var head: i64 = -1; var tail: i64 = -1;
    tail = list_push(head, tail, lendcl); if (head < 0) { head = tail; }
    tail = list_push(head, tail, floop);
    var on: Node = nodes[s];
    on.kind = "block";
    on.sa = "";
    on.sb = "";
    on.na = -1;
    on.la = head;
    slice_set(nodes, s, on);
}

// ── 表达式类型推断 inferExprType（复刻 checker.ts:479）────────

fn infer_expr(e: i64) i64 {
    var n: Node = nodes[e];
    if (is_pipe_kind(n.kind) == true) {
        return lower_pipe(e);
    }
    // 区间走到「取值」这一步，说明它不在 for / 索引 / match / in 这四个已降解的
    // 上下文里 —— 那就只剩物化一条路（`(0..10) |> f`、`var xs: []i64 = 1..5;`）。
    if (n.kind == "range") {
        return materialize_range(e);
    }
    // `x as T`：类型由目标类型定死，GEN:type_infer2 的生成规则因此写成「直接
    // return resolve_ti(n.nb)」—— 操作数**一次都不遍历**。后果不是类型错，而是
    // 整棵子树逃过检查：`zzz_undefined as i64`、`add2(1) as i64` 都零诊断通过，
    // 后端照发代码（静默错编，与 T-SEM-E201/E208 同一类）。range 落地后更致命：
    // `str_len(s[0..5]) as i64` 里的区间下标不被降解，后端当单元素索引发 str_at。
    // 生成区不能手改，故在此前置补一条：先推操作数，再按目标类型收口。
    if (n.kind == "cast") {
        if (n.na >= 0) { infer_expr(n.na); }
        return resolve_ti(n.nb);
    }
    // M-meta Phase D：编译期内建走到 check 说明它没被折掉 —— 一律是错。
    // `@compile_error` 本就只许活在编译期上下文；`@type_*` 折不掉意味着类型实参
    // 在编译期不可解析。两者都不该、也无法降级为运行期代码（第 8 条）。
    if (n.kind == "mbuiltin") {
        if (n.sa == "compile_error") {
            // 语义同 Zig 的 @compileError：**只要被分析到就触发**。CTFE 执行到会触发，
            // 走到 check（说明这段代码真的会被编译）同样触发。死分支已由 mb_prune_if
            // 剪除，故 `if (@type_equal(...)) ... else @compile_error(...)` 不会误报。
            var mmsg: string = "编译期终止";
            if (n.la >= 0) {
                var man: Node = nodes[kids[n.la].val];
                if (man.kind == "string") { mmsg = man.sa; }
            }
            fc_err("T-MTA-E604", mmsg, e);
        } else if (mb_is_ctfe_only(n.sa)) {
            // 不带 meta 形参的 `meta fn` 同时可运行期调用，故其函数体必须是合法运行期代码。
            fc_err("T-MTA-E605",
                sb_cat3("`@", n.sa,
                    "` 只能在纯编译期上下文求值：请放进 `comptime { }` 块，或放进带 `comptime` 形参的 `comptime fn`"), e);
        } else if (mb_is_type_query(n.sa) || n.sa == "zeroed") {
            fc_err("T-MTA-E606",
                sb_cat3("`@", n.sa, "` 的类型实参在编译期不可解析"), e);
        } else if (n.sa == "type_val" || n.sa == "type_of") {
            // P4 类型即值：@type_val("T") / @type_of(e) 还原出的类型节点都是「类型即值」——
            // 静态类型标为 Any（与 `fn() type` 返回标注解析出的 TypeInfo 一致，
            // 见 resolve_ti 对 kind=="type" 的处理），真正的类型节点在 CTFE
            // （meta_eval_mbuiltin 的 type_val / type_of 分支）期产出并流入单态化。
            return ti_mk("Any");
        } else {
            fc_err("T-MTA-E607",
                sb_cat3("未知的编译期内建 `@", n.sa, "`"), e);
        }
        return ti_mk("Unknown");
    }
    if (n.kind == "int") {
        // 带位宽后缀的字面量：类型由后缀直接定死，不再按量级猜。
        // 这正是 `-255i32` 能得到 -255（而裸 `-255` 因 255 被猜成 u8 而得到 1）
        // 的原因，见 reference.md §2.4。
        if (str_len(n.sb) > 0) {
            return ti_scalar(n.sb);
        }
        var v: u64 = lit_u64(n.sa);
        if (v <= 255) {
            return ti_scalar("u8");
        }
        if (v <= 65535) {
            return ti_scalar("u16");
        }
        if (v <= 4294967295) {
            return ti_scalar("u32");
        }
        return ti_scalar("u64");
    }
    // Erlang 式原子字面量：类型 = 64 位标量 "atom"，值 = 编译期 intern 的稳定 i64 id
    if (n.kind == "atom") {
        n.ia = atom_intern(n.sa);
        slice_set(nodes, e, n);
        return ti_scalar("atom");
    }
    // 内建文件描述符常量（M51）：stdin/stdout/stderr → 64 位标量 "fid"
    if (n.kind == "fidconst") {
        return ti_scalar("fid");
    }
    // 序列化操作符（M51）：`f < v` 的值即目标 fid 本身，故左结合可链式
    if (n.kind == "serialize") {
        infer_expr(n.na);
        infer_expr(n.nb);
        return ti_scalar("fid");
    }
    // 反序列化操作符（M52 读路径）：`f > Type` 的值是裸 Type；右操作数是类型表达式，不调 infer_expr
    if (n.kind == "deserialize") {
        infer_expr(n.na);
        return ti_from_td(deser_type_of(n.nb));
    }
// >>> GEN:type_infer1 (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
    if (n.kind == "float") {
        return ti_scalar("f64");
    }
    if (n.kind == "string") {
        return ti_mk("String");
    }
    if (n.kind == "bool") {
        return ti_scalar("bool");
    }
    if (n.kind == "null") {
        return ti_mk("Unknown");
    }
    // 取址 `&x`：操作数须为可寻址 lvalue，结果类型为 pointer(pointee)。
    if (n.kind == "amp") {
        var opti: i64 = infer_expr(n.na);
        if (expr_is_lvalue(n.na) == false) {
            fc_err("T-SEM-E760",
                "取址 `&x` 的操作数必须是可寻址的左值（变量 / 结构体字段 / 下标），不能对临时值取址",
                e);
            return ti_mk("Unknown");
        }
        return ti_elem_of("Pointer", opti);
    }
    // 解引用 `*r`：操作数须为引用/指针类型，结果类型为其指向的元素类型。
    if (n.kind == "deref") {
        var opti: i64 = infer_expr(n.na);
        if (tip_kind(opti) != "Pointer") {
            fc_err("T-SEM-E761",
                sb_cat3("解引用 `*r` 的操作数必须是引用/指针类型，但得到 `", ti_str(opti), "`"),
                e);
            return ti_mk("Unknown");
        }
        var det: i64 = tis[opti].elem;
        if (det < 0) { return ti_mk("Unknown"); }
        return det;
    }
// <<< GEN:type_infer1 <<<
    if (n.kind == "typeinfo") {
        return ti_mk("TypeInfo");
    }
    // 闭包构造点（M48）：值类型 = 合成函数的函数类型（env 首参对用户不可见）
    if (n.kind == "closure_make") {
        var cmi: i64 = sym_lookup(global_scope, n.sa);
        if (cmi >= 0) {
            var cms: Sym = syms[cmi];
            // 简写闭包返回类型占位待推断：作为值用到它（闭包构造点）时就地推断一次
            // （幂等：推断完 tif_ret 不再是占位）。与 ident 分支同款处理，否则拿到的是占位返回类型。
            if (g_infer_ti >= 0 && tif_ret[cms.ti] == g_infer_ti) {
                infer_lambda_ret_from_decl(cms.decl);
            }
            return cms.ti;
        }
        return ti_mk("Unknown");
    }
    if (n.kind == "ident") {
        var si: i64 = sym_lookup(cur_scope, n.sa);
        if (si >= 0) {
            var s: Sym = syms[si];
            // 记录该标识符解析到的声明节点，供后端按声明唯一化命名（同作用域重名 shadowing）。
            idecl_set(e, s.decl);
            // `|v: T| expr` 简写闭包：返回类型占位待推断。凡作为值用到它，就地推断一次
            // （幂等：推断完 tif_ret 不再是占位）。仅影响带 infer_ret 占位的函数。
            if (s.kind == "func" && g_infer_ti >= 0 && tif_ret[s.ti] == g_infer_ti) {
                infer_lambda_ret_from_decl(s.decl);
            }
            return s.ti;
        }
        if (n.sa == "true" || n.sa == "false") {
            return ti_scalar("bool");
        }
        // 未解析的标识符。静默退化成 Unknown 属**静默错编**：C 后端会一路漏到
        // 生成的 .c 里才报「未声明标识符」，LLVM 后端更糟——直接产出读 0 的垃圾值。
        // （本诊断即由此坑倒逼补上：parse_lambda_expr 误写 `cur_i`，检查期 0 errors、
        //  LLVM 自举照常通过，直到 C 后端自举才在 tc.c:8610 炸出来。）
        // bb 标志保证 infer_expr 重入时只报一次。
        if (n.bb == false) {
            var lcap: Node = nodes[e];
            lcap.bb = true;
            slice_set(nodes, e, lcap);
            if (g_in_lambda) {
                // 合成函数体里的未解析名：捕获分析已在提升期扫过外层作用域，
                // 走到这里说明外层同样没有该名字（拼写错 / 声明晚于字面量）。
                fc_err("T-SEM-E201",
                    sb_cat3("匿名函数体内未定义的标识符 `", n.sa,
                        "`：外层作用域也没有该名字（按值捕获只认字面量之前已声明的局部/参数），请检查拼写或调整声明位置"), e);
            } else {
                fc_err("T-SEM-E201",
                    sb_cat3("未定义的标识符 `", n.sa,
                        "`：请检查拼写，或先声明对应的变量/常量/函数"), e);
            }
        }
        return ti_mk("Unknown");
    }
    // match 表达式（L-15）：分支结果类型统一 + when 守卫布尔显式 + 穷尽性
    if (n.kind == "match") {
        var m_scr: i64 = infer_expr(n.na);
        var m_res: i64 = -1;
        var m_irref: bool = false;
        var m_rep: bool = n.bb == false;   // 诊断只报一次（infer_expr 可能被重入）
        if (m_rep) {
            var m_self: Node = nodes[e];
            m_self.bb = true;
            slice_set(nodes, e, m_self);
        }
        var m_c: i64 = n.la;
        while (m_c >= 0) {
            var m_k: Child = kids[m_c];
            var m_an: Node = nodes[m_k.val];
            // C2 模式消歧：裸标识符首字母大写 → CaseName，改写为等价的 member 模式
            // （`Case` ⇒ `Enum.Case`），让 checker 与 C/LLVM 双后端复用既有 member 路径。
            // 改写后 sa 清空，故对 infer_expr 的重入天然幂等。
            if (str_len(m_an.sa) > 0 && m_an.na < 0 && m_an.ba == false && starts_upper(m_an.sa)) {
                var cs_vd: i64 = variant_decl_of(m_scr);
                if (cs_vd >= 0) {
                    // ADT：variant 的裸大写名 = **单元 case** 构造器模式（`Empty` ⇔ `Empty()`）。
                    // 统一改写成 conpat，让覆盖分析与双后端脱糖只认一种形态（L-04）。
                    // 名字拼错不在此处报错——交给 conpat_check 报 T_MATCH_UNKNOWN_CASE 并列出合法 case。
                    var cs_cp: i64 = mk_conpat(m_an.sa, "", -1, 0, -1);
                    var cs_cpn: Node = nodes[cs_cp];
                    cs_cpn.ln = m_an.ln;
                    cs_cpn.cl = m_an.cl;
                    cs_cpn.tv = m_an.tv;
                    slice_set(nodes, cs_cp, cs_cpn);
                    m_an.na = cs_cp;
                    m_an.sa = "";
                    slice_set(nodes, m_k.val, m_an);
                } else if (enum_has_case(m_scr, m_an.sa)) {
                    var cs_base: i64 = mk_ident(tip_name(m_scr), -1);
                    var cs_bn: Node = nodes[cs_base];
                    cs_bn.ln = m_an.ln;
                    cs_bn.cl = m_an.cl;
                    cs_bn.tv = m_an.tv;
                    slice_set(nodes, cs_base, cs_bn);
                    var cs_mem: i64 = mk_member(m_an.sa, cs_base, -1);
                    var cs_mn: Node = nodes[cs_mem];
                    cs_mn.ln = m_an.ln;
                    cs_mn.cl = m_an.cl;
                    cs_mn.tv = m_an.tv;
                    slice_set(nodes, cs_mem, cs_mn);
                    m_an.na = cs_mem;
                    m_an.sa = "";
                    slice_set(nodes, m_k.val, m_an);
                } else {
                    if (m_rep) {
                        var cs_l: i64 = n_line(m_k.val);
                        var cs_c: i64 = n_col(m_k.val);
                        var cs_msg: string = sb_cat3(
                            "pattern `", m_an.sa,
                            "` starts with an uppercase letter, so it is read as a case name, not a binding");
                        if (tip_kind(m_scr) == "Enum") {
                            cs_msg = sb_cat5("unknown case `", m_an.sa, "` for enum ", tip_name(m_scr),
                                " — check the spelling, or use a lowercase name to bind instead");
                        }
                        var cs_di: i64 = diag_new("T-MAT-E740", "error", cs_msg,
                            n_file(m_k.val), cs_l, cs_c, cs_l, cs_c + (str_len(m_an.sa) as i64));
                        var cs_fx: i64 = fix_one("use a lowercase binding name",
                            n_file(m_k.val), cs_l, cs_c, cs_l, cs_c + (str_len(m_an.sa) as i64),
                            "<lowercase_name>");
                        diag_set_fs(cs_di, cs_fx);
                    }
                }
            }
            var m_prev: i64 = cur_scope;
            cur_scope = scope_new(m_prev);
            if (str_len(m_an.sa) > 0) {
                sym_define(cur_scope, m_an.sa, "var", m_scr, -1);
            }
            if (m_an.na >= 0 && nodes[m_an.na].kind == "conpat") {
                // ADT：variant 构造器解构。此刻 cur_scope 已是本臂子作用域，
                // 载荷绑定直接 define 进去（仅本臂可见，遮蔽外层同名）。
                conpat_check(m_an.na, m_scr, m_rep);
            } else if (m_an.na >= 0) {
                // 范围模式（`1..5` / `1..=5` / `1..` / `..5`）**不能**整体 infer——
                // infer_expr 见到 range 会走 materialize_range，把它物化成 []i64：
                // 既误报「[]i64 vs i64」类型不符，又把节点退化成 paren，
                // 让 codegen 的 match_chain_from 认不出 `kind == "range"`。
                // 这里只逐端点校验类型，range 节点原样留给后端合成比较链。
                if (is_range_node(m_an.na)) {
                    var m_rp: Node = nodes[m_an.na];
                    if (m_rp.na >= 0) {
                        var m_rlo: i64 = infer_expr(m_rp.na);
                        if (m_rep && tip_kind(m_rlo) != "Unknown" && tip_kind(m_scr) != "Unknown") {
                            if (ti_equal(m_rlo, m_scr) == false && can_cast(m_rlo, m_scr) == false) {
                                err_type_mismatch(m_rp.na, m_scr, m_rlo);
                            }
                        }
                    }
                    if (m_rp.nb >= 0) {
                        var m_rhi: i64 = infer_expr(m_rp.nb);
                        if (m_rep && tip_kind(m_rhi) != "Unknown" && tip_kind(m_scr) != "Unknown") {
                            if (ti_equal(m_rhi, m_scr) == false && can_cast(m_rhi, m_scr) == false) {
                                err_type_mismatch(m_rp.nb, m_scr, m_rhi);
                            }
                        }
                    }
                    // `..` 全通配等价于 `_`：两端都省的范围臂必然命中，算穷尽。
                    if (m_rp.na < 0 && m_rp.nb < 0) {
                        m_an.ba = true;
                        slice_set(nodes, m_k.val, m_an);
                    }
                } else {
                    var m_pt: i64 = infer_expr(m_an.na);
                    if (m_rep && tip_kind(m_pt) != "Unknown" && tip_kind(m_scr) != "Unknown") {
                        if (ti_equal(m_pt, m_scr) == false && can_cast(m_pt, m_scr) == false) {
                            err_type_mismatch(m_an.na, m_scr, m_pt);
                        }
                    }
                }
            }
            if (m_an.nb >= 0) {
                var m_gt: i64 = infer_expr(m_an.nb);
                if (m_rep && is_cond_bool(m_gt) == false) {
                    var m_gl: i64 = n_line(m_an.nb);
                    var m_gc: i64 = n_col(m_an.nb);
                    diag_new("T-SEM-E204", "error",
                        sb_cat2("match `when` guard must be bool, got ", ti_str(m_gt)),
                        n_file(m_an.nb), m_gl, m_gc, m_gl, m_gc + 4);
                }
            }
            var m_bt: i64 = infer_expr(m_an.nc);
            cur_scope = m_prev;
            if (m_res < 0) {
                m_res = m_bt;
            } else {
                if (m_rep && tip_kind(m_bt) != "Unknown" && tip_kind(m_res) != "Unknown") {
                    if (ti_equal(m_bt, m_res) == false && can_cast(m_bt, m_res) == false) {
                        var m_bl: i64 = n_line(m_an.nc);
                        var m_bc: i64 = n_col(m_an.nc);
                        diag_new("T-MAT-E741", "error",
                            sb_cat4("match arms have different types: ", ti_str(m_res), " vs ", ti_str(m_bt)),
                            n_file(m_an.nc), m_bl, m_bc, m_bl, m_bc + 4);
                    }
                }
            }
            if (m_an.nb < 0 && (m_an.ba || str_len(m_an.sa) > 0)) {
                m_irref = true;
            }
            m_c = m_k.next;
        }
        // enum scrutinee 的全 case 覆盖同样构成穷尽，此时 `_` 不再必需。
        if (m_irref == false && enum_all_cases_covered(e, m_scr)) {
            m_irref = true;
        }
        // ADT：variant 的全 case 覆盖同理（A1 推广到 variant）。
        if (m_irref == false && variant_all_cases_covered(e, m_scr)) {
            m_irref = true;
        }
        // 抽象 variant（声明末位 `_`）= 开放和类型：**豁免**穷尽性。
        // 未覆盖的 case 与未知 tag 由 `_` 臂吸收，无 `_` 臂则运行期落确定性 t_panic（L-09 零 UB）。
        if (m_irref == false && variant_is_abstract(m_scr)) {
            m_irref = true;
        }
        if (m_rep && m_irref == false) {
            var m_l: i64 = n_line(e);
            var m_col: i64 = n_col(e);
            var m_miss: string = enum_missing_cases(e, m_scr);
            if (str_len(m_miss) == 0) {
                m_miss = variant_missing_cases(e, m_scr);
            }
            var m_msg: string = "match is not exhaustive: add a `_` wildcard arm or a binding arm without guard";
            if (str_len(m_miss) > 0) {
                m_msg = sb_cat3("match is not exhaustive: unhandled case(s) ", m_miss,
                    " — cover them all, or add a `_` wildcard arm");
            }
            var m_di: i64 = diag_new("T-MAT-E742", "error", m_msg,
                n_file(e), m_l, m_col, m_l, m_col + 5);
            var m_fx: i64 = fix_one("add wildcard arm", n_file(e), m_l, m_col, m_l, m_col, "_ => <default>");
            diag_set_fs(m_di, m_fx);
        }
        if (m_res < 0) {
            return ti_mk("Unknown");
        }
        return m_res;
    }
    if (n.kind == "binary") {
        var op: string = n.sa;
        // 成员测试 `x in lo..hi`：右操作数是区间，整体降解成比较合取
        if (op == "in") {
            return lower_in_range(e);
        }
        // ── 序列化/反序列化操作符脱糖（M51 `<` 写；M52 读路径 `>` 读）────────
        // 语义由**左操作数静态类型**唯一判定：fid ⇒ 序列化/反序列化，否则 ⇒ 普通比较。
        // fid 无序，故 `<`/`>` 作比较时不存在二义（L-04）；`>` 作反序列化时右操作数是「类型」而非值。
        var lt: i64 = infer_expr(n.na);
        var lfid: bool = tip_kind(lt) == "Scalar" && tip_name(lt) == "fid";
        if (lfid && op == "<") {
            var rt: i64 = infer_expr(n.nb);
            check_serializable(n.nb, rt);
            n.kind = "serialize";
            slice_set(nodes, e, n);
            return ti_scalar("fid");
        }
        if (lfid && op == ">") {
            // 右操作数是「类型」，不是值：按类型解析，不调 infer_expr(n.nb)
            if (deser_rhs_is_value(n.nb)) {
                fc_err("T-FID-E655",
                    "`fid > X` 是反序列化，右操作数必须是**类型**（如 `f > i64`、`f > string`），不能是值；fid 无序，比较大小请改用 `==` / `!=`", e);
                return ti_mk("Unknown");
            }
            var rtd: i64 = deser_type_of(n.nb);
            // 未定义类型已由 deser_type_of 报 T_UNKNOWN_TYPE（rtd 为 unknown 但 >= 0）
            if (tds[rtd].cat == "unknown") {
                return ti_mk("Unknown");
            }
            if (deser_supported(rtd) == false) {
                fc_err("T-FID-E656",
                    "反序列化暂仅支持标量（i8..i64 / u8..u64 / f32 / f64 / bool / atom）与 string；聚合类型（struct / array / slice / map / pointer）读属 v2", e);
                return ti_mk("Unknown");
            }
            n.kind = "deserialize";
            slice_set(nodes, e, n);
            return ti_from_td(rtd);          // Option B：结果类型为裸 T，EOF 由 fid_eof 探针表达
        }
        // parse 期把 `> string` / `> map[K]V` 等关键字型类型收成了类型节点；若左操作数
        // 并非 fid，这就不是反序列化，而是把类型当值比较 —— 须给出定位准确的诊断，
        // 否则 infer_expr 会在类型节点上得到 Unknown，报出与病因无关的错误。
        if (op == ">" && node_type_only(n.nb)) {
            fc_err("T-FID-E657",
                "`>` 的右操作数写成了类型 —— 只有左操作数是 fid 时 `>` 才是反序列化；普通比较的两侧都必须是值", e);
            return ti_mk("Unknown");
        }
        // 其余：正常推断右操作数，再按既有规则处理比较/有序错误
        var rt: i64 = infer_expr(n.nb);
        var rfid: bool = tip_kind(rt) == "Scalar" && tip_name(rt) == "fid";
        if (lfid || rfid) {
            if (op == "<" || op == ">" || op == "<=" || op == ">=") {
                fc_err("T-FID-E658",
                    sb_cat3("fid 是无序句柄，不支持 `", op,
                        "` 比较；写出用 `目标fid < 值`（序列化），读入用 `源fid > 类型`（反序列化），判等用 `==` / `!=`"), e);
                return ti_scalar("bool");
            }
        }
        if (op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=") {
            return ti_scalar("bool");
        }
        if (op == "&&" || op == "||") {
            return ti_scalar("bool");
        }
        if (tip_kind(lt) == "Scalar" && tip_kind(rt) == "Scalar") {
            if (ti_equal(lt, rt)) {
                return lt;
            }
            var ln2: Node = nodes[n.na];
            var rn2: Node = nodes[n.nb];
            var llit: bool = ln2.kind == "int";
            var rlit: bool = rn2.kind == "int";
            if (llit && rlit == false) {
                return rt;
            }
            if (rlit && llit == false) {
                return lt;
            }
            if (llit && rlit) {
                return lt;
            }
            var di: i64 = diag_new("T-SEM-E203", "error",
                sb_cat6("binary operator '", op, "' requires same types, got ", ti_str(lt), " and ", ti_str(rt)),
                "", 1, 1, 1, 5);
            slb_begin();
            slb_add("use explicit cast: `expr as Type`");
            diag_set_nt(di, slb_head);
        }
        if (tip_kind(lt) != "Unknown") {
            return lt;
        }
        return rt;
    }
    if (n.kind == "unary") {
        var ot: i64 = infer_expr(n.na);
        if (n.sa == "!") {
            return ti_scalar("bool");
        }
        return ot;
    }
    if (n.kind == "assign") {
        var atl: i64 = infer_expr(n.na);
        var atr: i64 = infer_expr(n.nb);
        // 解引用赋值 `*r = v`：仅当 r 为可变绑定（var）时允许，否则就是只读引用。
        if (nodes[n.na].kind == "deref") {
            var dop: i64 = nodes[n.na].na;
            if (dop >= 0 && nodes[dop].kind == "ident") {
                var dsi: i64 = sym_lookup(cur_scope, nodes[dop].sa);
                if (dsi < 0) { dsi = sym_lookup(global_scope, nodes[dop].sa); }
                if (dsi >= 0) {
                    var ddecl: i64 = syms[dsi].decl;
                    if (ddecl >= 0 && nodes[ddecl].kind == "var_decl" && nodes[ddecl].ba == true) {
                        fc_err("T-SEM-E762",
                            sb_cat3("不能透过只读引用 `", nodes[dop].sa,
                                "` 写入：它由 `let`/`const` 声明（只读），要用可变引用请改用 `var` 声明"),
                            n.na);
                    }
                }
            }
        }
        // 逃逸分析（T-SEM-E764）：把对局部变量/参数的引用 `&局部` 赋给更长寿的目标
        // （全局变量 / 全局字段 / 全局元素）会悬垂（dangling）。`g = &a` 中 g 为全局、
        // &a 指向局部 → 该引用在函数返回后失效，写入全局即逃逸。
        // 注：普通 `a = b` 语句实际是 assign 节点（见 mk_assign），statement 级 assignment
        // 节点仅用于复合赋值（a, b = ...），故检查点放在此处而非 assignment 分支。
        if (expr_has_local_addr(n.nb) && assign_target_escapable(n.na)) {
            fc_err("T-SEM-E764",
                "把对局部变量/参数的引用存入更长寿的目标（全局）会产生悬垂指针（dangling）",
                n.nb);
        }
        // Sym 赋值：LHS 为 Sym 时，仅允许 string（自动 intern）或同池同类型 Sym；
        // 跨池 Sym→Sym（不同 tag）或其它类型赋值均为 T_TYPE_MISMATCH。
        if (tip_kind(atl) == "Sym" && ti_equal(atl, atr) == false) {
            if (tip_kind(atr) != "String" && tip_kind(atr) != "Unknown") {
                err_type_mismatch(n.nb, atl, atr);
            }
        }
        return atl;
    }
    if (n.kind == "call") {
        // 实参不走通用遍历，嵌套其中的 format 只能在这里补扫（详见 fmt_scan_subtree）
        if (g_has_format) { fmt_scan_list(n.la, e); }
        var cn: Node = nodes[n.na];
        // 方法式 `"tmpl".format(a, b)`（M57）：与函数式 `format("tmpl", a, b)` 完全同义。
        // 实现取「归一化」而非「另起一套」——就地把 receiver 挪成第 0 个实参、callee 换成
        // 裸 `format`，随后交给同一个 desugar_format_call。两种写法因此共享同一份模板文法、
        // 同一组诊断码，永远不会各自漂移。
        if (cn.kind == "member" && cn.sa == "format") {
            var mfa_recv: i64 = cn.na;
            var mfa_rn: Node = nodes[mfa_recv];
            if (mfa_rn.kind == "string") {
                var mfa_h: i64 = -1;
                var mfa_t: i64 = -1;
                mfa_t = list_push(mfa_h, mfa_t, mfa_recv);
                if (mfa_h < 0) { mfa_h = mfa_t; }
                var mfa_c: i64 = n.la;
                while (mfa_c >= 0) {
                    var mfa_k: Child = kids[mfa_c];
                    mfa_t = list_push(mfa_h, mfa_t, mfa_k.val);
                    if (mfa_h < 0) { mfa_h = mfa_t; }
                    mfa_c = mfa_k.next;
                }
                var mfa_n: Node = nodes[e];
                mfa_n.na = mk_ident("format", -1);
                mfa_n.la = mfa_h;
                slice_set(nodes, e, mfa_n);
                return desugar_format_call(e);
            }
            var mfa_rt: i64 = infer_expr(mfa_recv);
            if (tip_kind(mfa_rt) == "String") {
                fc_err("T-FST-E304",
                    "`.format(...)` 的接收者必须是字符串**字面量**（编译期解析，运行期无模板引擎）；变量模板请改用 StringBuilder 逐段拼接",
                    mfa_recv);
                return ti_mk("Unknown");
            }
        }
        if (cn.kind == "ident") {
            var fname: string = cn.sa;
            var si2: i64 = sym_lookup(global_scope, fname);
            if (si2 < 0) { si2 = sym_lookup(cur_scope, fname); }
            if (si2 >= 0) {
                var s2: Sym = syms[si2];
                if (tip_kind(s2.ti) == "Func") {
                    if (s2.decl >= 0) {
                        var fd: Node = nodes[s2.decl];
                        if (fd.kind == "FuncDecl") {
                            // comptime 泛型：调用点按类型实参单态化（func_is_generic 门控，
                            // 仅对含 comptime 参数的函数触发；普通函数零影响）。
                            if (func_is_generic(s2.decl) && nodes[e].bb == false) {
                                var inst: i64 = instantiate_generic(s2.decl, e);
                                if (inst >= 0) {
                                    return infer_expr(e);
                                }
                            }
                            // 直接调用同样要校验实参：这里以前直接 return 返回类型，
                            // 少传/多传/类型不符全部静默放行 → 运行期未初始化读。
                            check_call_args(e, s2.ti, fname);
                            return resolve_ti(fd.na);
                        }
                    }
                    // 函数类型变量 / 参数：校验实参后返回签名的返回类型。
