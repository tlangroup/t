        atest_only.depr = true;
        atest_only.repl = "@only";
        slice_set(anndefs, ditest_only, atest_only);
    }
    var diexpect_fail: i64 = anndef_find("expect_fail");
    if (diexpect_fail >= 0) {
        var aexpect_fail: AnnDef = anndefs[diexpect_fail];
        aexpect_fail.depr = true;
        aexpect_fail.repl = "@should_fail";
        slice_set(anndefs, diexpect_fail, aexpect_fail);
    }
    var ditest_group: i64 = anndef_find("test_group");
    if (ditest_group >= 0) {
        var atest_group: AnnDef = anndefs[ditest_group];
        atest_group.depr = true;
        atest_group.repl = "a `\"name\" suite { ... }` block";
        slice_set(anndefs, ditest_group, atest_group);
