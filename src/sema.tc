    base__slb_add("unused");
    base__slb_add("unused_field");
    base__slb_add("dead_code");
    base__slb_add("overflow_literal");
    base__slb_add("implicit_cast");
    base__slb_add("bitfield_overlap");
    base__slb_add("deprecated");
}

pub fn vv_cfg() void {
    base__slb_add("debug");
    base__slb_add("release");
    base__slb_add("windows");
    base__slb_add("linux");
    base__slb_add("mac");
    base__slb_add("android");
    base__slb_add("web");
}

// derive/allow/warn/deny 的 trait/warning 项遍历校验
pub fn ann_check_items(ai: i64, is_derive: bool, l: i64, c: i64) void {
    var c1: i64 = base.node_la((ai as u64));
    var mq_ks13733: []i64 = base.kids_chain_idx(base.node_la((ai as u64)));
    var mq_ki13733: i64 = 0;
    while (mq_ki13733 < slice_len(mq_ks13733) as i64) {
        c1 = mq_ks13733[mq_ki13733];
        var k: Child = base__kids[c1];
        if (base.node_kind((k.val as u64)) == "list") {
            var c2: i64 = base.node_la((k.val as u64));
            var mq_ks13737: []i64 = base.kids_chain_idx(base.node_la((k.val as u64)));
            var mq_ki13737: i64 = 0;
            while (mq_ki13737 < slice_len(mq_ks13737) as i64) {
                c2 = mq_ks13737[mq_ki13737];
                var k2: Child = base__kids[c2];
                var v: string = "";
                if (base.node_kind((k2.val as u64)) == "ident") {
                    v = base.node_sa((k2.val as u64));
                }
                ann_check_item(v, is_derive, l, c);
                mq_ki13737 = mq_ki13737 + 1;
                c2 = -1;
            }
        } else {
            var v2: string = "";
            if (base.node_kind((k.val as u64)) == "ident") {
                v2 = base.node_sa((k.val as u64));
            }
            ann_check_item(v2, is_derive, l, c);
        }
        mq_ki13733 = mq_ki13733 + 1;
        c1 = -1;
    }
}

pub fn ann_check_item(v: string, is_derive: bool, l: i64, c: i64) void {
    if (is_derive) {
        if (is_derive_trait(v) == false) {
            var di: i64 = base__diag_new("T-DER-E500", "error",
                base__sb_cat3("unsupported derive trait '", v, "'"),
                base__g_file, l, c, l, c + 20);
            base__slb_begin();
            vv_derive_traits();
            base__diag_set_vv(di, base__slb_head);
        }
        return;
    }
    if (is_valid_warning(v) == false) {
        var di2: i64 = base__diag_new("T-ANN-E451", "error",
            base__sb_cat3("unknown warning item '", v, "'"),
            base__g_file, l, c, l, c + 20);
        base__slb_begin();
        vv_warnings();
        base__diag_set_vv(di2, base__slb_head);
    }
}

// validate（复刻 registry.ts:168）；ai = A 节点索引
pub fn ann_validate(ai: i64, target: string) void {
    var name: string = base.node_sa((ai as u64));
    var l: i64 = base.node_span_id(ai).line as i64;
    var c: i64 = base.node_span_id(ai).col as i64;
    var name_len: i64 = str_len(name) as i64;
    var di_: i64 = anndef_find(name);

    if (di_ < 0) {
        var d1: i64 = base__diag_new("T-ANN-E450", "error",
            base__sb_cat3("unknown annotation '@", name, "'"),
            base__g_file, l, c, l, c + name_len + 1);
        base__slb_begin();
        var n: i64 = g_ad_count;
        var i: i64 = 0;
        while (i < n) {
            var a: AnnDef;
            a.name = g_ad_name[i];
            base__slb_add(base__sb_cat2("@", a.name));
            i = i + 1;
        }
        base__diag_set_vv(d1, base__slb_head);
        return;
    }

    var def: AnnDef;
    def.name = g_ad_name[di_];
    def.spec = g_ad_spec[di_];
    def.targets = g_ad_targets[di_];
    def.depr = g_ad_depr[di_];
    def.repl = g_ad_repl[di_];

    if (def.depr) {
        var msg: string = base__sb_cat3("annotation '@", name, "' is deprecated");
        if (str_len(def.repl) > 0) {
            msg = base__sb_cat4(msg, ", use ", def.repl, " instead");
        }
        base__diag_new("T-ANN-E450", "warning", msg, base__g_file, l, c, l, c + name_len + 1);
    }

    if (targets_has(def.targets, target) == false) {
        var d2: i64 = base__diag_new("T-ANN-E452", "error",
            base__sb_cat6("annotation '@", name, "' cannot be applied to ", target, ", valid targets: ", def.targets),
            base__g_file, l, c, l, c + name_len + 1);
        base__slb_begin();
        targets_push_vv(def.targets);
        base__diag_set_vv(d2, base__slb_head);
    }

    // ── validateArgs ──
    var argc: i64 = parse__list_count(base.node_la((ai as u64)));

    if (def.spec == "none") {
        if (argc > 0) {
            base__diag_new("T-ANN-E451", "error",
                base__sb_cat3("annotation '@", name, "' takes no arguments"),
                base__g_file, l, c, l, c + name_len + 1);
        }
        return;
    }
    if (def.spec == "string") {
        var bad: bool = argc != 1;
        if (bad == false) {
            var k0: Child = base__kids[base.node_la((ai as u64))];
            bad = base.node_kind((k0.val as u64)) != "string";
        }
        if (bad) {
            var d3: i64 = base__diag_new("T-ANN-E451", "error",
                base__sb_cat3("annotation '@", name, "' requires exactly one string argument"),
                base__g_file, l, c, l, c + name_len + 1);
            base__slb_begin();
            base__slb_add("@${annotation.name}(\"text\")");
            base__diag_set_vv(d3, base__slb_head);
        }
        return;
    }
    if (def.spec == "ident") {
        var bad2: bool = argc != 1;
        var a0k: string = "";
        var a0v: string = "";
        if (argc >= 1) {
            var k1: Child = base__kids[base.node_la((ai as u64))];
            a0k = base.node_kind((k1.val as u64));
            a0v = base.node_sa((k1.val as u64));
        }
        if (bad2 == false) {
            bad2 = a0k != "ident" and a0k != "list";
        }
        if (bad2) {
            base__diag_new("T-ANN-E451", "error",
                base__sb_cat3("annotation '@", name, "' requires one identifier argument"),
                base__g_file, l, c, l, c + name_len + 1);
        }
        if (name == "cfg" and a0k == "ident") {
            if (is_cfg_cond(a0v) == false and starts_with(a0v, "feature=") == false) {
                var d4: i64 = base__diag_new("T-ANN-E451", "error",
                    base__sb_cat3("invalid @cfg condition '", a0v, "'"),
                    base__g_file, l, c, l, c + name_len + 1);
                base__slb_begin();
                vv_cfg();
                base__diag_set_vv(d4, base__slb_head);
            }
        }
        return;
    }
    if (def.spec == "ident_list") {
        if (argc < 1) {
            base__diag_new("T-ANN-E451", "error",
                base__sb_cat3("annotation '@", name, "' requires at least one argument"),
                base__g_file, l, c, l, c + name_len + 1);
        }
        if (name == "derive") {
            ann_check_items(ai, true, l, c);
        }
        if (name == "allow" or name == "warn" or name == "deny") {
            ann_check_items(ai, false, l, c);
        }
        return;
    }
    if (def.spec == "number") {
        var bad3: bool = argc != 1;
        if (bad3 == false) {
            var k2: Child = base__kids[base.node_la((ai as u64))];
            bad3 = base.node_kind((k2.val as u64)) != "number";
        }
        if (bad3) {
            base.diag_new("T-ANN-E451", "error",
                base.sb_cat3("annotation '@", name, "' requires one numeric argument"),
                base.g_file, l, c, l, c + name_len + 1);
        }
        return;
    }
}

// getDeclTarget（复刻 index.ts:181）
pub fn decl_target(kind: string) string {
    if (kind == "StructDecl") {
        return "struct";
    }
    if (kind == "EnumDecl") {
        return "enum";
    }
    if (kind == "UnionDecl") {
        return "union";
    }
    if (kind == "VariantDecl") {
        return "variant";
    }
    if (kind == "FuncDecl") {
        return "func";
    }
    if (kind == "GlobalVarDecl") {
        return "var";
    }
    if (kind == "GlobalConstDecl") {
        return "const";
    }
    return "global";
}

pub fn ann_pass() void {
    var n: i64 = slice_len(lex__decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = lex__decl_list[i];
        var target: string = decl_target(base.node_kind((d as u64)));
        var c: i64 = base.node_la((d as u64));
        var mq_ks13952: []i64 = base.kids_chain_idx(base.node_la((d as u64)));
        var mq_ki13952: i64 = 0;
        while (mq_ki13952 < slice_len(mq_ks13952) as i64) {
            c = mq_ks13952[mq_ki13952];
            var k: Child = base__kids[c];
            ann_validate(k.val, target);
            mq_ki13952 = mq_ki13952 + 1;
            c = -1;
        }
        // 字段级注解校验（修复设计文档"风险一"）：原 ann_pass 仅校验声明级注解，
        // 字段级注解（struct/union 字段 node_la）被静默忽略，拼错即 0 error 退化。
        // 此处遍历字段链，对每个字段的注解按 target="field" 复用 ann_validate，
        // 未知字段注解将报 T-ANN-E450（与声明级一致）。
        // node_la 默认 -1（node_new 锁步），kids_chain_idx(-1) 返回空链，故无注解字段安全跳过。
        if (target == "struct" or target == "union") {
            // 字段级注解校验（修复设计文档"风险一"）：原 ann_pass 仅校验声明级注解，
            // 字段级注解（struct/union 字段 node_la）被静默忽略，拼错即 0 error 退化。
            // 此处遍历字段链，对每个字段的注解按 target="field" 复用 ann_validate，
            // 未知字段注解将报 T-ANN-E450（与声明级一致）。
            // ⚠ 关键：kids_chain_idx 返回的是 kids 池「entry 索引」，其 .val 才是节点 id。
            //   node_la 接收「节点 id」，故必须先用 base__kids[f].val 取出字段节点 id，
            //   再把该 id 传入 node_la —— 与上方声明级循环（base__kids[c].val）完全一致。
            //   若直接把 entry 索引当节点 id 传入 node_la，会误读 g_node_la[entry] 拿到
            //   无关链头，沿 .next 跨函数体误校验（曾触发 84× T-ANN-E450）。
            // node_la 默认 -1（node_new 锁步），kids_chain_idx(-1) 返回空链，无注解字段安全跳过。
            var mq_fc: i64 = base.node_lb((d as u64));
            var mq_fks: []i64 = base.kids_chain_idx(mq_fc);
            var mq_fki: i64 = 0;
            while (mq_fki < slice_len(mq_fks) as i64) {
                var f: i64 = mq_fks[mq_fki];
                var f_id: i64 = base__kids[f].val;
                var mq_fla: i64 = base.node_la((f_id as u64));
                var mq_fks2: []i64 = base.kids_chain_idx(mq_fla);
                var mq_fki2: i64 = 0;
                while (mq_fki2 < slice_len(mq_fks2) as i64) {
                    var fk: i64 = mq_fks2[mq_fki2];
                    ann_validate(base__kids[fk].val, "field");
                    mq_fki2 = mq_fki2 + 1;
                }
                mq_fki = mq_fki + 1;
            }
        }
        i = i + 1;
    }
}

pub fn has_errors() bool {
    var n: i64 = slice_len(base__diags) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: Diag = base__diags[i];
        if (d.sev == "error") {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn has_warnings() bool {
    var n: i64 = slice_len(base__diags) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: Diag = base__diags[i];
        if (d.sev == "warning") {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// 人类可读的 warning 摘要，写到 stderr（与 check 的 JSON / 程序 stdout 分开）。
// ⚠ 必须走 stderr 而非 stdout：tc run 的程序输出也在 stdout，warning 落 stdout 会污染
// 程序输出、破坏「LLVM vs tmir-c 双后端实跑比对」的 golden 判定（examples/tile_demo.tc
// 的 @Tile 降级 warning 含机器相关字节数，跨机器不恒定，更不应进 stdout 比对通道）。
// 诊断走 stderr 是标准编译器行为；REPL / 构建日志单独重定向 stderr 即可收集这些 warning。
pub fn print_warn_summary() void {
    var n: i64 = slice_len(base__diags) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: Diag = base__diags[i];
        if (d.sev == "warning") {
            var line1: string = base__sb_cat6("warning: ", d.msg, " (", d.file, ":", base__i2s(d.sl));
            var line2: string = base__sb_cat3(":", base__i2s(d.sc), ")\n");
            eprint(base__sb_cat2(line1, line2));
        }
        i = i + 1;
    }
}



pub fn atom_intern(name: string) i64 {
    var i: i64 = 0;
    while (i < g_atom_cnt) {
        if (g_atom_names[i] == name) { return i + 1; }
        i = i + 1;
    }
    append(g_atom_names, name);
    g_atom_cnt = g_atom_cnt + 1;
    return g_atom_cnt;
}


// map 读索引助手：t_map_val_ptr 返回存储值字节指针，按 V 类型解引用。
// 注意：key 需是左值（&k），与 append 字面量取址限制一致。
// 取调用节点的第 ix 个实参节点 id（-1 表示不存在）。
pub fn call_arg_node(cid: i64, ix: i64) i64 {
    if (cid < 0) {
        return -1;
    }
    var c9: i64 = base.node_la((cid as u64));
    var j9: i64 = 0;
    var mq_ks14027: []i64 = base.kids_chain_idx(base.node_la((cid as u64)));
    var mq_ki14027: i64 = 0;
    while (mq_ki14027 < slice_len(mq_ks14027) as i64) {
        c9 = mq_ks14027[mq_ki14027];
        var ck9: Child = base__kids[c9];
        if (j9 == ix) {
            return ck9.val;
        }
        j9 = j9 + 1;
        mq_ki14027 = mq_ki14027 + 1;
        c9 = -1;
    }
    return -1;
}


// 读路径 v1 仅支持：标量数值 / bool / atom / string。聚合类型（struct/array/slice/map/pointer）读属 v2。
pub fn deser_supported(td: i64) bool {
    if (td < 0) { return false; }
    var t: TD = tds[td];
    if (t.cat == "string") { return true; }
    if (t.cat == "scalar") {
        var nm: string = td_sname(td);
        if (nm == "fid") { return false; }     // 不能从文件读 fid 句柄
        return nm == "atom" or nm == "bool" or is_int_name(nm) or is_float_name(nm);
    }
    return false;
}


pub fn deser_type_of(nb: i64) i64 {
    if (nb < 0) { return td_mk("unknown"); }
    if (base.node_kind((nb as u64)) == "scalar") { return resolve_type_desc(nb); }   // 类型位置直接写 i64（少见）
    if (base.node_kind((nb as u64)) == "paren")  { return deser_type_of(base.node_na((nb as u64))); }
    if (base.node_kind((nb as u64)) == "ident") {
        var nm: string = base.node_sa((nb as u64));
        if (nm == "string") { return td_mk("string"); }
        if (nm == "bool")   { return td_named_mk("scalar", "bool"); }
        if (nm == "atom")   { return td_named_mk("scalar", "atom"); }
        if (nm == "fid")    { return td_named_mk("scalar", "fid"); }
        if (is_int_name(nm) or is_float_name(nm)) { return td_named_mk("scalar", nm); }
        // 命名类型（struct/enum/flag/variant/typealias）。注意**不能**用 tm_get ——
        // 那是 emitter 的 typeMap，check 阶段尚未填充，会把已声明的类型误判成「不是类型」。
        // check 阶段的权威来源是全局符号表里 kind == "type" 的条目。
        var si: i64 = sym_lookup(global_scope, nm);
        if (si >= 0) {
            if (syms[si].kind == "type") { return td_named_mk("named", nm); }
            return td_mk("unknown");                             // 是个值（变量/函数/常量），不是类型
        }
        var g: i64 = tm_get(nm);                                 // 发射期回退（此时符号表已释放）
        if (g >= 0) { return g; }
        // 既不在符号表也不在发射期类型表 → 未定义名字，报错（不再静默 unknown）
        if (menv_find(nm) >= 0) { return td_mk("unknown"); }    // meta 类型/值参数：实例化期已绑定，留待后续解析
        if (gen_tparam_has(nm)) { return td_mk("unknown"); }    // 泛型类型参数（模板定义期尚未绑定）
        parse__fc_err("T-SEM-E200", base__sb_cat3("未定义类型 `", nm, "`"), nb);
        return td_mk("unknown");
    }
    return resolve_type_desc(nb);                                // slice/array/map/func_type 等真正类型节点
}


// fid_format(f) 会把这四个名字当返回值交给用户，必须保证它们进了原子表。
// LLVM 后端的 @t_atom_table 先于函数体发射，因此只能在检查期调用本函数。
pub fn fid_intern_fmt_atoms() void {
    var t0: i64 = atom_intern("text");
    var t1: i64 = atom_intern("json");
    var t2: i64 = atom_intern("rawbin");
    var t3: i64 = atom_intern("protobuf");
}


pub fn js_parse_int(s: string, radix: i64) i64 {
    var i: u64 = 0;
    var n: u64 = str_len(s);
    var neg: bool = false;
    if (i < n) {
        if (s[i] == 43 or s[i] == 45) {
            if (s[i] == 45) {
                neg = true;
            }
            i = i + 1;
        }
    }
    if (radix == 16 and i + 1 < n) {
        if (s[i] == 48 and (s[i + 1] == 120 or s[i + 1] == 88)) {
            i = i + 2;
        }
    }
    // 八进制字面量文本带 `0o` 前缀（`o` 在按位解析里会被当成非法字符而提前收工，
    // 结果恒为 0）—— 与 radix=16 的 `0x` 一样必须先跳掉。
    if (radix == 8 and i + 1 < n) {
        if (s[i] == 48 and (s[i + 1] == 111 or s[i + 1] == 79)) {
            i = i + 2;
        }
    }
    if (radix == 2 and i + 1 < n) {
        if (s[i] == 48 and (s[i + 1] == 98 or s[i + 1] == 66)) {
            i = i + 2;
        }
    }
    var val: i64 = 0;
    while (i < n) {
        var c: u8 = s[i];
        var d: i64 = -1;
        if (c >= 48 and c <= 57) {
            d = (c - 48) as i64;
        }
        if (c >= 97 and c <= 122) {
            d = (c - 87) as i64;
        }
        if (c >= 65 and c <= 90) {
            d = (c - 55) as i64;
        }
        if (d < 0 or d >= radix) {
            break;
        }
        val = val * radix + d;
        i = i + 1;
    }
    if (neg) {
        return 0 - val;
    }
    return val;
}


// 该节点是否由 parse_cmp 的 tok_type_only 分支（parse_type）产出 —— 即「一望即知是类型、
// 不可能是值」的节点。用于左操作数非 fid 时给出准确诊断。
pub fn node_type_only(nb: i64) bool {
    if (nb < 0) { return false; }
    var k: string = base.node_kind((nb as u64));
    return k == "scalar" or k == "map";
}


// `fid > X` 反序列化的右操作数是否「一望即知是值」—— 这些节点形态不可能是类型。
// 必须显式拦：resolve_type_desc 对未知 kind 静默兜底成 unknown，调用方又静默 return，
// 于是 `f > 123` 整条表达式零诊断（f43）。ident 需查符号表区分类型名与变量/函数。
pub fn deser_rhs_is_value(nb: i64) bool {
    if (nb < 0) { return false; }
    var k: string = base.node_kind((nb as u64));
    if (k == "paren") { return deser_rhs_is_value(base.node_na((nb as u64))); }
    if (k == "int" or k == "float" or k == "string" or k == "bool") { return true; }
    if (k == "null" or k == "number") { return true; }
    if (k == "call" or k == "binary" or k == "unary" or k == "cast") { return true; }
    if (k == "index" or k == "member") { return true; }
    if (k == "array_lit" or k == "map_lit" or k == "struct_lit") { return true; }
    if (k == "lambda" or k == "closure_make" or k == "match") { return true; }
    if (k == "ident") {
        var nm: string = base.node_sa((nb as u64));
        // 内建标量/关键字型类型名走 ident 形态到达此处，先排除
        if (nm == "string" or nm == "bool" or nm == "atom" or nm == "fid") { return false; }
        if (is_int_name(nm) or is_float_name(nm)) { return false; }
        var si: i64 = sym_lookup(cur_scope, nm);
        if (si < 0) { si = sym_lookup(global_scope, nm); }
        if (si >= 0) { return syms[si].kind != "type"; }
        return false;              // 未知名字 → 交给 deser_type_of 报 T_UNKNOWN_TYPE
    }
    return false;
}


pub fn resolve_type_desc(tn: i64) i64 {
    if (tn < 0) {
        return td_mk("unknown");
    }
    if (tn >= base__node_count()) { return td_mk("unknown"); }
    if (base.node_kind((tn as u64)) == "scalar") {
// >>> GEN:td_scalar (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
        if (base.node_sa((tn as u64)) == "string") { return td_mk("string"); }
        if (base.node_sa((tn as u64)) == "void") { return td_mk("void"); }
        if (base.node_sa((tn as u64)) == "StringBuilder") { return td_named_mk("named", "TSb*"); }
        if (base.node_sa((tn as u64)) == "bytes") { return td_mk("bytes"); }
        if (base.node_sa((tn as u64)) == "BytesBuilder") { return td_named_mk("named", "TSb*"); }
        return td_named_mk("scalar", base.node_sa((tn as u64)));
// <<< GEN:td_scalar <<<
    }
// >>> GEN:td_rslice (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
    if (base.node_kind((tn as u64)) == "slice") {
        return td_elem_mk("slice", resolve_type_desc(base.node_na((tn as u64))));
    }
// <<< GEN:td_rslice <<<
    // 引用类型 `*T`：na=元素类型节点。双后端据此映射到各自指针表示
    // （C 落 long/指针，LLVM 落 ptr）。此前缺失此分支导致 var r1=&a 的
    // 类型描述被 resolve 成 unknown → LLVM alloca 误判为 i64，store 地址时类型冲突。
    if (base.node_kind((tn as u64)) == "pointer") {
        // 地址空间透传：dev_ptr[T]/shared[T]/local[T] 解析出的 pointer 节点带 n.memspace（as=1/3/5），
        // 普通 *T 为 0。统一经 td_ptr_mk 落 TD.memspace，供 ll_td 发 `ptr addrspace(N)`。
        // S4 §0.14.7 SoA：memspace 已外置（原 `n.memspace`；n = base.nodes[tn]）
        return td_ptr_mk(resolve_type_desc(base.node_na((tn as u64))), base.node_memspace((tn as u64)));
    }
    // 可选类型 ?T：双后端统一落「指向元素的指针」（none = 空指针）。
    // 缺失此分支时 ?T 会被 resolve 成 unknown → LLVM 把 ?i64 的函数返回类型
    // 误判为 i64（`ret i64 %t`，而 some(x) 实际产出 ptr），clang 报类型冲突。
    if (base.node_kind((tn as u64)) == "optional") {
        return td_elem_mk("optional", resolve_type_desc(base.node_na((tn as u64))));
    }
    // 硬件 SIMD 向量 `@Vector(len, T)`：lane 数取自 ia（sema resolve 期已折叠并校验）
    if (base.node_kind((tn as u64)) == "vector") {
        var vtd: i64 = td_elem_mk("vector", resolve_type_desc(base.node_na((tn as u64))));
        var vln2: i64 = base.node_ia((tn as u64));
        if (vln2 < 1) { vln2 = vec_fold_len(tn); }
        if (vln2 < 1) { vln2 = 1; }
        var vtd2: TD = tds[vtd];
        vtd2.alen = vln2;
        slice_set(tds, vtd, vtd2);
        return vtd;
    }
    // 二维 SIMD 瓦片 `@Tile(rows, cols, T, flavor)`：内层 row 数组 [cols x T] 承载列，
    // 外层 alen 承载行，val 承载 flavor 码（0=hardware,1=simulate）。
    if (base.node_kind((tn as u64)) == "tile") {
        var trows: i64 = base.node_ia((tn as u64));
        var tcols: i64 = base__node_ib((tn as u64));   // S4 §0.14.7 SoA：侧表读（原 n.ib）
        var tfl: i64 = base.node_la((tn as u64));
        if (trows < 1) { trows = tile_fold_child(base.node_nb((tn as u64))); }
        if (tcols < 1) { tcols = tile_fold_child(base.node_nc((tn as u64))); }
        if (trows < 1) { trows = 1; }
        if (tcols < 1) { tcols = 1; }
        var etd: i64 = resolve_type_desc(base.node_na((tn as u64)));
        var rowtd: i64 = td_elem_mk("array", etd);
        var rt: TD = tds[rowtd];
        rt.alen = tcols;
        slice_set(tds, rowtd, rt);
        var ttd: i64 = td_elem_mk("tile", rowtd);
        var tt: TD = tds[ttd];
        tt.alen = trows;
        tt.val = tfl;
        slice_set(tds, ttd, tt);
        return ttd;
    }
    // 定长数组 [N]T：LLVM 后端映射为 [N x T]，C 后端仍走 T[]／T*
    if (base.node_kind((tn as u64)) == "array") {
        var ai: i64 = td_elem_mk("array", resolve_type_desc(base.node_na((tn as u64))));
        var alen: i64 = 0;
        if (base.node_nb((tn as u64)) >= 0) {
            if (base.node_kind((base.node_nb((tn as u64)) as u64)) == "int") {
                alen = parse_int_len(base.node_sa((base.node_nb((tn as u64)) as u64)), base.node_ia((base.node_nb((tn as u64)) as u64)));
            }
        }
        var at: TD = tds[ai];
        at.alen = alen;
        slice_set(tds, ai, at);
        return ai;
    }
    if (base.node_kind((tn as u64)) == "map") {
        var mi: i64 = td_mk("map");
        var kt: i64 = resolve_type_desc(base.node_na((tn as u64)));
        var vt: i64 = resolve_type_desc(base.node_nb((tn as u64)));
        var t: TD = tds[mi];
        t.key = kt;
        t.val = vt;
        slice_set(tds, mi, t);
        return mi;
    }
    if (base.node_kind((tn as u64)) == "sym") {
        var syi: i64 = td_named_mk("sym", base.node_sa((tn as u64)));
        var syt: TD = tds[syi];
        syt.alen = base.node_ia((tn as u64));
        slice_set(tds, syi, syt);
        return syi;
    }
    // 反射类型 TypeInfo / FieldInfo 现在由 base.tc 声明为真正的 t variant / struct，
    // 故按普通具名类型经 mb_type_decl 解析（不再走魔法 typeinfo/fieldinfo cat）。
    // 裸 `Sym` = 默认 32 位池的一级符号句柄（docs/compiler/meta_design.md §8）。
    // 用户自己声明过 `Sym` 类型时以用户为准（tc.tc 自身就有一个 Sym struct）。
    if (base.node_kind((tn as u64)) == "named" and base.node_sa((tn as u64)) == "Sym" and mb_type_decl("Sym") < 0) {
        var bsy: i64 = td_named_mk("sym", "");
        var bst: TD = tds[bsy];
        bst.alen = 32;
        slice_set(tds, bsy, bst);
        return bsy;
    }
    // 位串基元类型 `bitstr`（§15）：值级 (ptr u8, bit_len, cap)，与 []u8 同构。
    if (base.node_kind((tn as u64)) == "named" and base.node_sa((tn as u64)) == "bitstr") { return td_mk("bitstr"); }
// >>> GEN:td_rnamed (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
    if (base.node_kind((tn as u64)) == "named") {
        var nm: string = base.node_sa((tn as u64));
        // ⚠ 反射内建类型（A-fix）：FieldInfo / TypeInfo 是编译器内建类型，无需 import base
        // 即可裸名作类型标注。base.tc 虽声明了同构 struct/variant，但用户程序不 import 时
        // 普通具名查找落空 → 回落 T-SEM-E200 未定义类型 → td_mk("unknown") → tir_st_of_td 回落
        // i64 → `var f: FieldInfo` 分配 8B 槽，而 ti_field 写入 64B %FieldInfo → 写穿栈帧（tagid_typeinfo 实锤）。
        // 故在此显式解析为具名类型：FieldInfo → %FieldInfo(64B) 双后端一致；TypeInfo → %TypeInfo
        // （C 后端落 base__TypeInfo 变体 by-value；LLVM 后端 variant 以 ptr 形态流转，16B 槽容下 8B ptr 无溢出）。
        if (nm == "FieldInfo") { return td_named_mk("named", "FieldInfo"); }
        if (nm == "TypeInfo") { return td_named_mk("named", "TypeInfo"); }
        // 校验名字是已声明类型（check 期符号表）或发射期类型表命中；否则未定义类型，报错。
        // 先查 tm_get：发射期类型表已建则直接返回（避免在「符号表已释放」时调 sym_lookup）。
        // meta 类型参数实例化期已被替换为具体类型，若仍以 named 形态到达则排除 meta 环境绑定。
        if (tm_get(nm) >= 0) { return td_named_mk("named", nm); }
        var si: i64 = sym_lookup(global_scope, nm);
        if (si >= 0 and syms[si].kind == "type") { return td_named_mk("named", nm); }
        if (menv_find(nm) >= 0) { return td_named_mk("named", nm); }
        if (gen_tparam_has(nm)) { return td_named_mk("named", nm); }
        parse__fc_err("T-SEM-E200", base__sb_cat3("未定义类型 `", nm, "`"), tn);
        return td_mk("unknown");
    }
// <<< GEN:td_rnamed <<<
    if (base.node_kind((tn as u64)) == "func_type") {
        // 与 resolve_ti 同理：先收进局部表再整段搬入，保证参数区连续。
        var fret: i64 = resolve_type_desc(base.node_na((tn as u64)));
        var fbuf: []i64;
        var fk: i64 = base.node_la((tn as u64));
        var mq_ks14319: []i64 = base.kids_chain_idx(base.node_la((tn as u64)));
        var mq_ki14319: i64 = 0;
        while (mq_ki14319 < slice_len(mq_ks14319) as i64) {
            fk = mq_ks14319[mq_ki14319];
            var fc: Child = base__kids[fk];
            append(fbuf, resolve_type_desc(fc.val));
            mq_ki14319 = mq_ki14319 + 1;
            fk = -1;
        }
        var fpstart: i64 = slice_len(tdf_params) as i64;
        var fpc: i64 = slice_len(fbuf) as i64;
        var fj: i64 = 0;
        if (base.g_relowering) { arena_use_default(); }
        while (fj < fpc) {
            append(tdf_params, fbuf[fj]);
            fj = fj + 1;
        }
        if (base.g_relowering) {
            if (base.g_relowering_scratch_func) { arena_use_func(); } else { arena_use_default(); }
        } else { arena_use_default(); }
        return td_func(fret, fpstart, fpc);
    }
    return td_mk("unknown");
}


// T1 cut2：结构体「字段类型单一解析源」。给定 StructDecl 的字段链首（node.lb），
// 按声明顺序返回各字段解析后的 TD。-1 表示字段无类型描述（如位段），调用方据此降级为 i64。
// 此前 LLVM 后端（tir_add_struct_tt）与 C 后端（emit_struct_decl→emit_ctype）各自解析同一
// 字段节点的类型，两条解析路径独立演进易漂移；本函数把「节点→TD」收口到 resolve_type_desc
// 一处，双后端只负责把同一个 TD 印刷成各自语法（tir_st_of_td / desc_to_c）。
pub fn struct_field_tds(lb: i64) []i64 {
    var out: []i64 = [];
    var c: i64 = lb;
    var mq_ks14345: []i64 = base.kids_chain_idx(lb);
    var mq_ki14345: i64 = 0;
    while (mq_ki14345 < slice_len(mq_ks14345) as i64) {
        c = mq_ks14345[mq_ki14345];
        var td: i64 = -1;
        if (base.node_na((base.kids[c].val as u64)) >= 0) { td = resolve_type_desc(base.node_na((base.kids[c].val as u64))); }
        append(out, td);
        mq_ki14345 = mq_ki14345 + 1;
        c = -1;
    }
    return out;
}


// TD → TI（读路径结果类型为裸 T）。
pub fn ti_from_td(td: i64) i64 {
    if (td < 0) { return ti_mk("Unknown"); }
    var t: TD = tds[td];
    if (t.cat == "string") { return ti_mk("String"); }
    if (t.cat == "bytes") { return ti_mk("Bytes"); }
    if (t.cat == "bitstr") { return ti_mk("BitStr"); }
    if (t.cat == "scalar") { return ti_scalar(td_sname(td)); }
    return ti_mk("Unknown");
}


// 字段类型可读名（用于 TypeInfo 的 type_name 字段，双后端一致）
pub fn td_readable(td: i64) string {
    if (td < 0) { return "?"; }
    var t: TD = tds[td];
    if (t.cat == "scalar") {
        if (t.name == "") { return "i64"; }
        return t.name;
    }
    if (t.cat == "string") { return "string"; }
    if (t.cat == "bytes") { return "bytes"; }
    if (t.cat == "bitstr") { return "bitstr"; }
    if (t.cat == "void") { return "void"; }
    if (t.cat == "unknown") { return "unknown"; }
    if (t.cat == "named") { return t.name; }
    if (t.cat == "typeinfo") { return t.name; }
    if (t.cat == "fieldinfo") { return "FieldInfo"; }
    if (t.cat == "slice") { return base__sb_cat2("[]", td_readable(t.elem)); }
    if (t.cat == "array") { return base__sb_cat4("[", base__i2s(t.alen), "]", td_readable(t.elem)); }
    if (t.cat == "map") { return base__sb_cat4("map[", td_readable(t.key), "]", td_readable(t.val)); }
    if (t.cat == "sym") { return base__sb_cat5("Sym", base__i2s(t.alen), "(\"", t.name, "\")"); }
    if (t.cat == "func") {
        var fb: StringBuilder = sb_new();
        sb_append_str(fb, "fn(");
        var fi: i64 = 0;
        while (fi < tdf_pcount[td]) {
            if (fi > 0) { sb_append_str(fb, ", "); }
            sb_append_str(fb, td_readable(tdf_params[tdf_pstart[td] + fi]));
            fi = fi + 1;
        }
        sb_append_str(fb, ") -> ");
        sb_append_str(fb, td_readable(tdf_ret[td]));
        return sb_to_str(fb);
    }
    return "?";
}


// 探测路径是否存在。直接调用稳健的 file_exists 内建（C fopen 直查 / LLVM @tll_file_exists），
// 取代原先的 sys_run("cmd /c if exist ...") 外 shell 方案——后者在绝对路径下会触发 arena OOM。
pub fn path_exists(p: string) bool {
    return file_exists(p);
}


pub var g_atom_cnt: i64 = 0;


// ── Atom 表（M50：Erlang 式原子）──────────────────────────────
// 编译期 intern：名字 → 稳定 i64 id（等价 Erlang 原子表）。
// 同一个名字两次 intern 返回相同 id，故 `:ok == :ok` 恒为真、`match` 按 id 分发。
// 约定 0 为非原子（null 占位），故有效 id 从 1 起。
pub var g_atom_names: []string;


pub fn td_elem_mk(cat: string, elem: i64) i64 {
    var i: i64 = td_mk(cat);
    var t: TD = tds[i];
    t.elem = elem;
    slice_set(tds, i, t);
    return i;
}

// 设备指针类型 TD：cat=="pointer" 且携带地址空间 as（0=host；1/3/5=global/shared/local）。
// host 普通 *T 走 td_elem_mk("pointer", elem)（as 默认 0），故本函数专供 dev_ptr/shared/local。
pub fn td_ptr_mk(elem: i64, aspace: i64) i64 {
    var i: i64 = td_mk("pointer");
    var t: TD = tds[i];
    t.elem = elem;
    t.memspace = aspace;
    slice_set(tds, i, t);
    return i;
}


// 构造函数类型 TD：参数类型须已 append 到 tdf_params[pstart .. pstart+pcount)
pub fn td_func(ret: i64, pstart: i64, pcount: i64) i64 {
    var i: i64 = td_mk("func");
    tdf_ret[i] = ret;
    tdf_pstart[i] = pstart;
    tdf_pcount[i] = pcount;
    return i;
}


pub fn td_mk(cat: string) i64 {
    var t: TD;
    // ⚠ 代际分配器（2026-10-22）：类型描述表 tds 是跨函数持久池，必须常驻 g_arena。
    // 重降级期 g_cur==g_func，append 增长会把 backing 落 g_func → 被 arena_reset_func
    // 回收（仅 used=0、无 decommit）→ 旧表项（含 lower_unit 期建的 tds[48]=i64）被覆盖
    // → 后续 tir_size_bytes 读 tds[td].name 命中悬垂/覆盖内存 → emit-ll 段错误（Crash #3）。
    // 故重降级期固定切 g_arena 再 append，并把字符串字段逃逸提升到 g_arena；写完按上下文还原。
    if (base.g_relowering) { arena_use_default(); }
    if (base.g_relowering) { t.cat = base.str_persist(cat); } else { t.cat = cat; }
    t.name = "";
    t.elem = -1;
    t.key = -1;
    t.val = -1;
    t.alen = -1;
    t.memspace = 0;
    append(tds, t);
    append(tdf_ret, -1);
    append(tdf_pstart, -1);
    append(tdf_pcount, 0);
    if (base.g_relowering) {
        if (base.g_relowering_scratch_func) { arena_use_func(); } else { arena_use_default(); }
    } else { arena_use_default(); }
    return (slice_len(tds) as i64) - 1;
}


pub fn td_named_mk(cat: string, name: string) i64 {
    var i: i64 = td_mk(cat);
    var t: TD = tds[i];
    // ⚠ 代际分配器（2026-10-22）：name 可能是重降级期在 g_func 计算的字符串，
    // 须逃逸提升到 g_arena 防止 arena_reset_func 回收后悬垂（见 td_mk 注释）。
    if (base.g_relowering) {
        t.name = base.str_persist(name);
        if (base.g_relowering_scratch_func) { arena_use_func(); }
    } else { t.name = name; }
    slice_set(tds, i, t);
    return i;
}

// ── TI → TD（sema 侧副本，供 Array→Slice / 空数组字面量构造 cast 使用）──
pub fn ti_to_td_base(ti: i64) i64 {
    if (ti < 0) {
        return td_mk("unknown");
    }
    var t: TI = tis[ti];
    if (t.kind == "Scalar") { return td_named_mk("scalar", t.name); }
    if (t.kind == "String") { return td_mk("string"); }
    if (t.kind == "StringBuilder") { return td_named_mk("named", "TSb*"); }
    if (t.kind == "Bytes") { return td_mk("bytes"); }
    if (t.kind == "BitStr") { return td_mk("bitstr"); }
    if (t.kind == "Void") { return td_mk("void"); }
    if (t.kind == "Slice") { return td_elem_mk("slice", ti_to_td_base(t.elem)); }
    if (t.kind == "Array") {
        var r: i64 = td_elem_mk("array", ti_to_td_base(t.elem));
        var at: TD = tds[r];
        at.alen = t.alen;
        slice_set(tds, r, at);
        return r;
    }
    if (t.kind == "Map") {
        var r: i64 = td_mk("map");
        var mt: TD = tds[r];
        mt.key = ti_to_td_base(t.key);
        mt.val = ti_to_td_base(t.val);
        slice_set(tds, r, mt);
        return r;
    }
    if (t.kind == "Sym") {
        var rs: i64 = td_named_mk("sym", t.name);
        var st: TD = tds[rs];
        st.alen = t.bw;
        slice_set(tds, rs, st);
        return rs;
    }
    if (t.kind == "Named") { return td_named_mk("named", t.name); }
    // 反射内建类型（A-fix）：用户代码里 TypeInfo/FieldInfo/TypeMeta 经 resolve_ti 解析为
    // ti_named("Variant"/"Struct", name)，按名字回退到具名 TD（与 resolve_type_desc 的
    // named 分支一致的布局），避免落入 unknown。
    if (t.kind == "Variant" and t.name == "TypeInfo") { return td_named_mk("named", "TypeInfo"); }
    if (t.kind == "Struct" and t.name == "FieldInfo") { return td_named_mk("named", "FieldInfo"); }
    if (t.kind == "Struct" and t.name == "TypeMeta") { return td_named_mk("named", "TypeMeta"); }
    if (t.kind == "Pointer") { return td_elem_mk("pointer", ti_to_td_base(t.elem)); }
    if (t.kind == "Optional") { return td_elem_mk("optional", ti_to_td_base(t.elem)); }
    // 向量：LLVM 侧 `<N x T>`，C 侧 `vector_size` typedef。宽度存 alen。
    if (t.kind == "Vector") {
        var vt: i64 = td_elem_mk("vector", ti_to_td_base(t.elem));
        var vtd: TD = tds[vt];
        vtd.alen = t.alen;
        slice_set(tds, vt, vtd);
        return vt;
    }
    // 瓦片：内层 elem 是「行数组 TI」([cols x T])，t.alen 是行数。
    // 复用 Array 的 TI→TD 构造得到行类型，再包一层 tile（alen=行数）。
    if (t.kind == "Tile") {
        var rowtd_t: i64 = ti_to_td_base(t.elem);   // [cols x T], alen=cols
        var tilt: i64 = td_elem_mk("tile", rowtd_t);
        var tild: TD = tds[tilt];
        tild.alen = t.alen;   // rows
        slice_set(tds, tilt, tild);
        return tilt;
    }
    return td_mk("unknown");
}

// TI → 类型 **AST 节点**（cast 的目标类型必须用这个，不能用 ti_to_td_base 的 td 索引）。
// ⚠ 踩过的坑：sema 侧的 tds 池与 codegen 侧的各一份、索引不通用。把 td 索引填进
// cast.nb 后，codegen 的 resolve_type_desc 会把它当**节点号**解析 —— 小整数恰好
// 命中某个标量节点，于是 Array→Slice 的 cast 退化成 `(i64)arr` 硬转，读垃圾长度。
pub fn ti_to_type_node(ti: i64) i64 {
    if (ti < 0) { return base__mk_named("unknown", -1); }
    var t: TI = tis[ti];
    if (t.kind == "Scalar") { return base__mk_scalar(t.name, -1); }
    if (t.kind == "Void") { return base__mk_scalar("void", -1); }
    if (t.kind == "String") { return base__mk_scalar("string", -1); }
    if (t.kind == "StringBuilder") { return base__mk_scalar("StringBuilder", -1); }
    if (t.kind == "Bytes") { return base__mk_scalar("bytes", -1); }
    if (t.kind == "BitStr") { return base__mk_named("bitstr", -1); }
    if (t.kind == "Slice") { return base__mk_slice(ti_to_type_node(t.elem), -1); }
    // ⚠ mk_int 的第二参数是 RADIX 不是值：长度必须按十进制写。
    if (t.kind == "Array") {
        return base__mk_array(ti_to_type_node(t.elem), base__mk_int(base__i2s(t.alen), 10, -1), -1);
    }
    if (t.kind == "Map") {
        return base__mk_map(ti_to_type_node(t.key), ti_to_type_node(t.val), -1);
    }
    if (t.kind == "Pointer") { return base__mk_pointer(ti_to_type_node(t.elem), -1); }
    if (t.kind == "Optional") { return base__mk_optional(ti_to_type_node(t.elem), -1); }
    if (t.kind == "Vector") {
        var vtn: i64 = base__mk_vector(ti_to_type_node(t.elem), base__mk_int(base__i2s(t.alen), 10, -1), -1);
        base.node_set_ia((vtn as u64), t.alen);
        return vtn;
    }
    if (t.kind == "Sym") { return base__mk_sym(t.name, t.bw, -1); }
    return base__mk_named(t.name, -1);
}


// td 的标量名（"" = 非标量）；enum/flag/alias 归一到底层标量
pub fn td_sname(td: i64) string {
    if (td < 0) {
        return "i64";
    }
    var t: TD = tds[td];
    if (t.cat == "scalar") {
        if (t.name == "") {
            return "i64";
        }
        return t.name;
    }
    // Sym 底层是无符号 id：Sym16→u16、Sym32→u32、Sym64→u64（供比较/运算取正确 LLVM 位宽）
    if (t.cat == "sym") {
        if (t.alen == 16) { return "u16"; }
        if (t.alen == 64) { return "u64"; }
        return "u32";
    }
    if (t.cat == "unknown") {
        return "i64";
    }
    if (t.cat == "named") {
        var i: i64 = llt_find(t.name);
        if (i < 0) {
            return "";
        }
        var k: string = llt_kinds[i];
        if (k == "enum") {
            return llt_unders[i];
        }
        if (k == "alias") {
            return td_sname(llt_atd[i]);
        }
        return "";
    }
    return "";
}


pub fn tm_get(name: string) i64 {
    var n: i64 = slice_len(tm_names) as i64;
    var i: i64 = n - 1;
    while (i >= 0) {
        if (tm_names[i] == name) {
            return tm_tds[i];
        }
        i = i - 1;
    }
    return -1;
}


pub var llt_atd: []i64;        // alias 目标 td（其余 -1）


pub fn llt_find(name: string) i64 {
    var n: i64 = slice_len(llt_names) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (llt_names[i] == name) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}


pub var llt_kinds: []string;   // struct | enum | flag | variant | union | alias


pub var llt_unders: []string;  // enum/flag 底层标量名


pub var tm_names: []string;   // 全局 typeMap（globals + "fn()" 返回类型）


pub var tm_tds: []i64;


pub var llt_names: []string;
