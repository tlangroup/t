        // struct 类型名，回填 n.sa 并清零 ia，使下方「具名 struct_lit」逻辑接管。
        // ⚠ 标记槽只能用标量槽（ia）。la/lb/lc 是 kids 链表头，mb_walk / meta_walk
        //    等通用遍历会把它当链表递归展开；拿它存标量 1 会遍历到任意链表并无限递归
        //    （表现为编译器 STATUS_STACK_OVERFLOW / 退出码 127）。
        if (base.node_ia((e as u64)) == 1) {
            // 元组字面量 `.{e1, e2, ...}`：逐个推断元素值类型（fv.na 存的是值节点 id，
            // 而非 TI），收集 TI 列表后合成（或复用）位置字段具名 struct 类型名。
            // ⚠ infer_expr 用局部 ei=ie_inst(node)，递归调用不会破坏外层环境，安全。
            var etis: []i64;
            var p: i64 = base.node_la((e as u64));
            var mq_ks7795: []i64 = base.kids_chain_idx(base.node_la((e as u64)));
            var mq_ki7795: i64 = 0;
            while (mq_ki7795 < slice_len(mq_ks7795) as i64) {
                p = mq_ks7795[mq_ki7795];
                var kv: i64 = base.kids[p].val;
                var eti: i64 = infer_expr(base.node_na((kv as u64)));
                append(etis, eti);
                mq_ki7795 = mq_ki7795 + 1;
                p = -1;
            }
            var tsname: string = tuple_lit_type_name(etis);
            base.node_set_sa((e as u64), tsname);
            base.node_set_ia((e as u64), 0);
        }
        // 前导点 `.{...}`：省略类型名，类型由上下文（g_lead_expect）提供的具名结构体推断。
        // 接受 Struct 与 Named 两种 TI 种类——具名结构体注解经 resolve_ti 可能落为 Named，
        // 故统一按「期望类型名解析到 StructDecl」判定，避免漏判。
        if (base.node_ib((e as u64)) == 1 and base.node_sa((e as u64)) == "") {   // S4 §0.14.7 SoA：侧表读（原 n.ib）
            var ok: bool = false;
            if (g_lead_expect >= 0) {
                var exp_name: string = tip_name(g_lead_expect);
                var si_exp: i64 = sym_lookup(global_scope, exp_name);
                if (si_exp >= 0) {
                    var s_exp: Sym = syms[si_exp];
                    if (s_exp.decl >= 0) {
                        if (base.node_kind((s_exp.decl as u64)) == "StructDecl") {
                            base.node_set_sa((e as u64), exp_name);
                            ok = true;
                        }
                    }
                }
            }
            if (ok == false) {
                parse.fc_err("T-DOT-E101",
                    "`.{...}` 需由上下文（变量注解 / 返回值 / 实参 / 赋值左值）推断出具名结构体类型", e);
                return ti_mk("Unknown");
            }
        }
        // 默认填充：struct 字段有默认值(expr)但未在字面量中给出 → 合成 FV 追加进 n.la。
        // 后端以「指定符初始化器」按名映射，故追加在尾部与顺序无关，天然幂等。
        var sname: string = base.node_sa((e as u64));
        var fh: i64 = find_struct_fields(sname);
        if (fh >= 0) {
            var present: []string;
            var p: i64 = base.node_la((e as u64));
            // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环
            var ks7719: []i64 = base.kids_chain(p);
            var ki7719: i64 = 0;
            while (ki7719 < slice_len(ks7719) as i64) {
                var kv7719: i64 = ks7719[ki7719];
                append(present, base.node_sa((kv7719 as u64)));
                ki7719 = ki7719 + 1;
            }
            var c: i64 = fh;
            var mq_ks7845: []i64 = base.kids_chain_idx(fh);
            var mq_ki7845: i64 = 0;
            while (mq_ki7845 < slice_len(mq_ks7845) as i64) {
                c = mq_ks7845[mq_ki7845];
                if (base.node_nb((base.kids[c].val as u64)) >= 0) {
                    var found: bool = false;
                    var i: i64 = 0;
                    var pl: i64 = slice_len(present);
                    while (i < pl) {
                        if (present[i] == base.node_sa((base.kids[c].val as u64))) { found = true; break; }
                        i = i + 1;
                    }
                    if (found == false) {
                        var fvid: i64 = base.mk_FV(base.node_sa((base.kids[c].val as u64)), base.node_nb((base.kids[c].val as u64)), -1);
                        if (base.node_la((e as u64)) < 0) {
                            base.node_set_la((e as u64), base.list_push(-1, -1, fvid));
                        } else {
                            var tail: i64 = base.node_la((e as u64));
                            while (base.kids[tail].next >= 0) { tail = base.kids[tail].next; }
                            base.list_push(base.node_la((e as u64)), tail, fvid);
                        }
                    }
                }
                mq_ki7845 = mq_ki7845 + 1;
                c = -1;
            }
        }
        // 前导点嵌套：仅对「字段值是结构体字面量（struct_lit）」的字段，按字段类型回填
        // g_lead_expect 后就地推断，使嵌套 `.{...}` 拿到正确的结构体上下文（标量/标识符字段
        // 交由后端在发射期推断即可，避免重复推断）。
        if (base.node_ib((e as u64)) == 1 and fh >= 0) {   // S4 §0.14.7 SoA：侧表读（原 n.ib）
            var c2: i64 = base.node_la((e as u64));
            var mq_ks7873: []i64 = base.kids_chain_idx(base.node_la((e as u64)));
            var mq_ki7873: i64 = 0;
            while (mq_ki7873 < slice_len(mq_ks7873) as i64) {
                c2 = mq_ks7873[mq_ki7873];
                var fvna: i64 = base.node_na((base.kids[c2].val as u64));
                var fvsa: string = base.node_sa((base.kids[c2].val as u64));
                if (base.node_kind((fvna as u64)) == "struct_lit") {
                    var fti: i64 = struct_field_ti(sname, fvsa);
                    if (fti >= 0) {
                        var saved_le: i64 = g_lead_expect;
                        g_lead_expect = fti;
                        ie_sub_in_v(ei, fvna);
                        g_lead_expect = saved_le;
                    }
                }
                mq_ki7873 = mq_ki7873 + 1;
                c2 = -1;
            }
        }
        // ⚠ 兜底：对结构体字面量「所有字段值」递归收集其中标识符并补调 infer_expr，
        // 使其进入 idecl 表（记录该标识符解析到的声明节点），供 C 后端按声明唯一化命名
        // （shadowing）。否则 TirEmitRes{name: z} / {name: d} 等字段内的标识符、以及
        // TirEmitRes{ st: tir_st_from_str(st) } 这类「标识符嵌套在调用实参中」的现场不会进
        // idecl 表 → C 后端发射改名时 idecl_get 查不到 → 报 undeclared identifier。
        // 仅对 ident 调 infer_expr，不重写 IR、不改变广义类型推断，对 LLVM 后端无碍、幂等。
        // 嵌套 struct_lit 字段值由上方 g_lead_expect 上下文块处理，此处递归会自动覆盖其
        // 内部标识符（其自身 struct_lit 分支会再补调本兜底，故不漏）。
        // 注意：fv3.na 才是字段「值节点」；fv3（FV 节点）本身无子节点可遍历，必须传 .na。
        var c3: i64 = base.node_la((e as u64));
        // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环
        var ks7777: []i64 = base.kids_chain(c3);
        var ki7777: i64 = 0;
        while (ki7777 < slice_len(ks7777) as i64) {
            var kv7777: i64 = ks7777[ki7777];
            if (base.node_na((kv7777 as u64)) >= 0) { sema_idecl_infer_idents(base.node_na((kv7777 as u64))); }
            ki7777 = ki7777 + 1;
        }
        // ⚠ P2 修复：union 字面量与 struct 字面量共享 struct_lit 节点（同语法 `U{ .a = 1 }`），
        // 但类型身份须按声明种类返回——UnionDecl → Union TI，否则 Struct TI。否则
        // `var u: U = U{ .a = 1 }` 会因「同名但 kind 不同」触发 T-SEM-E202（expected U but got U）。
        var sname_lit: string = base.node_sa((e as u64));
        var lit_kind: string = "";
        var si_lit: i64 = sym_lookup(global_scope, sname_lit);
        if (si_lit >= 0) {
            var s_lit: Sym = syms[si_lit];
            if (s_lit.decl >= 0 and base.node_kind((s_lit.decl as u64)) == "UnionDecl") {
                lit_kind = "Union";
            }
        }
        if (lit_kind == "Union") { return ti_named("Union", sname_lit); }
        return ti_named("Struct", sname_lit);
    }
    if (k == "cast") {
        return resolve_ti(base.node_nb((e as u64)));
    }
    if (k == "paren") {
        return ie_sub(ei, 0, base.node_na((e as u64)));
    }
    if (k == "comptime") {
        return ie_sub(ei, 0, base.node_na((e as u64)));
    }
// <<< GEN:type_infer2 <<<
    return ti_mk("Unknown");
}

// ── 返回路径分析（复刻 checker.ts:653）────────────────────────

pub fn all_paths_return(head: i64) bool {
    if (head < 0) {
        return false;
    }
    var last: i64 = list_last_val(head);
    if (last < 0) {
        return false;
    }
    // P1 fix：值块（block_expr）以 `return` 收尾时，parse_block_expr 会额外追加一个
    // `unit_lit` 占位作「尾随表达式值」，致使 list_last_val 落到占位符而非真正的 return。
    // 此时回落到倒数第二条语句（真正的 return）判定全路径返回。
    if (base.node_kind((last as u64)) == "expr" and base.node_kind((base.node_na((last as u64)) as u64)) == "unit_lit") {
        var pv: i64 = list_prev_val(head, last);
        if (pv >= 0) { last = pv; }
    }
    return stmt_returns(last);
}

pub fn stmt_returns(s: i64) bool {
    if (base.node_kind((s as u64)) == "return") {
        return true;
    }
    if (base.node_kind((s as u64)) == "expr") {
        // 末条语句是表达式语句（如 `match (...) {...}` 落在 expr 语句里）⇒ 拆到内部表达式再判。
        return stmt_returns(base.node_na((s as u64)));
    }
    if (base.node_kind((s as u64)) == "if") {
        if (base.node_lb((s as u64)) != -2) {
            if (all_paths_return(base.node_la((s as u64)))) {
                return all_paths_return(base.node_lb((s as u64)));
            }
            return false;
        }
        return false;
    }
    if (base.node_kind((s as u64)) == "block" or base.node_kind((s as u64)) == "block_expr") {
        return all_paths_return(base.node_la((s as u64)));
    }
    if (base.node_kind((s as u64)) == "match") {
        // match 全臂返回 ⇒ 整体返回（comptime fn 体末条为 match 且各臂 return 的情形）。
        var mc: i64 = base.node_la((s as u64));
        var mq_ks: []i64 = base.kids_chain_idx(base.node_la((s as u64)));
        var ki: i64 = 0;
        while (ki < slice_len(mq_ks) as i64) {
            mc = mq_ks[ki];
            if (stmt_returns(base.node_nc((base__kids[mc].val as u64))) == false) { return false; }
            ki = ki + 1;
        }
        return true;
    }
    return false;
}

// ═══ Stage B：语句检查的 HIR 分派层 ═════════════════════════════
// check_stmt 是 sema 唯一的语句入口：节点有对应 HIR 指令 → 走 HIR 指令流
// （递归一律经 hir_arg，不再读 kids 链）；没有（脱糖合成的块）→ 回落 CST 树。
// 两条路径共用下面这一组 cs_* 语义动作，行为不因入口而分叉。

// 子表达式推断入口：一律先经 HIR 指令（inst → 源节点），无 HIR 时以 fb 兜底。
pub fn infer_expr_hir(inst: i64, fb: i64) i64 {
    if (inst >= 0) {
        var e2: i64 = hir.hir_inst_node(inst);
        if (e2 >= 0) { return infer_expr(e2); }
    }
    if (fb >= 0) { return ie_infer(fb); }
    return ti_mk("Unknown");
}

pub fn check_stmt(s: i64) void {
    // P3：值循环（带 `else` 或含 `break v`）出现在语句位置 → 脱糖为值块后回落 CST。
    // 脱糖已调 hir_invalidate，故 hir_of_node 归 -1，直接走 check_stmt_cst 的 block_expr 分支。
    if ((base.node_kind((s as u64)) == "while" or base.node_kind((s as u64)) == "for" or base.node_kind((s as u64)) == "for_each") and (base.node_lb((s as u64)) >= 0 or vl_body_has_break_v(base.node_la((s as u64))))) {
        desugar_value_loop(s);
        check_stmt_cst(s);
        return;
    }
    var si: i64 = hir.hir_of_node((s as u64));
    if (si >= 0) { check_stmt_hir(si); return; }
    check_stmt_cst(s);
}

// HIR BLOCK 指令内的语句序列（递归）
pub fn cs_stmts_hir(bi: i64) void {
    if (bi < 0) { return; }
    var cnt: i64 = hir.hir_arg_count(bi);
    var i: i64 = 0;
    while (i < cnt) {
        var st: i64 = hir.hir_arg(bi, i);
        if (st >= 0) { check_stmt_hir(st); }
        i = i + 1;
    }
}

// 块作用域 + HIR 语句序列
pub fn cs_block_inst(bi: i64) void {
    var prev4: i64 = cur_scope;
    cur_scope = scope_new_at(prev4, hir.hir_inst_node(bi));
    cs_stmts_hir(bi);
    cur_scope = prev4;
}

// 已被脱糖就地改写成 block 的语句（无 HIR 指令）：走 CST kids 链
pub fn cs_block_node(s: i64) void {
    var prev: i64 = cur_scope;
    cur_scope = scope_new_at(prev, s);
    var c: i64 = base.node_la((s as u64));
    var mq_ks8006: []i64 = base.kids_chain_idx(base.node_la((s as u64)));
    var mq_ki8006: i64 = 0;
    while (mq_ki8006 < slice_len(mq_ks8006) as i64) {
        c = mq_ks8006[mq_ki8006];
        var k: Child = base.kids[c];
        check_stmt(k.val);
        mq_ki8006 = mq_ki8006 + 1;
        c = -1;
    }
    cur_scope = prev;
}

// 局部变量声明（var/const/let 统一路径）
pub fn cs_var_decl(s: i64, init_i: i64) void {
    // S3/Q1：持有 type 值的局部变量（var x: type = ...）→ 编译期绑定，代码期擦除（无运行期槽位）。
    // 初始化器须是编译期已知的类型值（裸类型名 / @type_val(...) 等）；变量本身登记进 g_cvar 表，
    // 供 comptime 上下文引用时由 meta_eval 解析为 type 值节点；双后端在 emit 时跳过其槽位分配。
    if (base.node_na((s as u64)) >= 0 and base.node_kind((base.node_na((s as u64)) as u64)) == "type") {
        var civ: i64 = -1;
        if (base.node_nb((s as u64)) >= 0) {
            g_meta_err = false;
            if (g_meta_steps < 200000) { g_meta_steps = 200000; }
            civ = meta_eval(base.node_nb((s as u64)));
        }
        if (civ < 0 or meta_node_is_type(civ) == false) {
            parse.fc_err("T-MTA-E617",
                base__sb_cat3("持有 type 值的变量 `", base.node_sa((s as u64)),
                    "` 的初始化器必须是编译期已知的类型（如 `i64` / `Point`）"), s);
            return;
        }
        cvar_push(base.node_sa((s as u64)), civ);
        append(g_skip_var, s);
        g_skip_n = g_skip_n + 1;
        sym_define(cur_scope, base.node_sa((s as u64)), "var", ti_mk("Any"), s);
        if (base.node_const(s) != 0) { check_const_ref(s); }
        return;
    }
    // 一等子句是**编译期一等值**（设计 §4）：它没有运行期表示，故不得占用 var 槽位。
    // 与上方 `var x: type` 相反 —— 那种是编译期绑定并令后端跳过槽位；clause 一律越界即错，
    // 声明请用 `const`。这是 T-CLA-E724 的第一道闸门（局部）。
    if (base.node_na((s as u64)) >= 0) {
        var ct0: i64 = resolve_ti(base.node_na((s as u64)));
        if (clause_ti_involves(ct0)) {
            parse.fc_err("T-CLA-E724",
                base.sb_cat3("clause 值不能声明为运行期变量 `", base.node_sa((s as u64)),
                    "`；clause 只活在编译期，请改用 const"), s);
            return;
        }
    }
    var vt: i64 = -1;
    // 管道许可上下文之一：初始化器（reference.md §3.15.6）
    if (base.node_nb((s as u64)) >= 0) { pipe_mark(base.node_nb((s as u64))); }
    if (base.node_na((s as u64)) >= 0) {
        vt = resolve_ti(base.node_na((s as u64)));
    } else if (base.node_nb((s as u64)) >= 0) {
        var inf_ti: i64 = infer_expr_hir(init_i, base.node_nb((s as u64)));
        if (inf_ti >= 0 and tip_kind(inf_ti) != "Unknown") {
            vt = inf_ti;
            var tn2: i64 = mk_type_node_from_ti(inf_ti);
            base.node_set_na((s as u64), tn2);
        }
    }
    if (vt < 0) {
        parse.fc_err("T-SEM-E211",
            base.sb_cat3("局部变量 `", base.node_sa((s as u64)),
                "` 必须带类型标注或提供可推断类型的初始化器"), s);
        return;
    }
    if (base.node_nb((s as u64)) >= 0) {
        var saved_ve2: i64 = g_vec_expect;
        var saved_te2: i64 = g_tile_expect;
        var saved_le2: i64 = g_lead_expect;
        if (ti_is_vector(vt)) { g_vec_expect = vt; g_tile_expect = -1; }
        else if (ti_is_tile(vt)) { g_tile_expect = vt; g_vec_expect = -1; }
        else { g_vec_expect = -1; g_tile_expect = -1; }
        g_lead_expect = vt;
        var it: i64 = infer_expr_hir(init_i, base.node_nb((s as u64)));
        g_vec_expect = saved_ve2;
        g_tile_expect = saved_te2;
        g_lead_expect = saved_le2;
        intlit_overflow_warn(base.node_nb((s as u64)), vt);
        if (tip_kind(it) != "Unknown" and ti_equal(it, vt) == false) {
            var vk: string = tip_kind(vt);
            // P3：位域 TI kind 已归 `Struct`，按 `tip_is_flag`（und 非空）判别。
            var int_to_fe: bool = (tip_is_flag(vt) or vk == "Enum") and is_int_ti(it);
            var str_to_sym: bool = vk == "Sym" and tip_kind(it) == "String";
            if (int_to_fe == false and str_to_sym == false and can_cast(it, vt) == false) {
                err_type_mismatch(base.node_nb((s as u64)), vt, it);
            }
        }
    }
    sym_define(cur_scope, base.node_sa((s as u64)), "var", vt, s);
    if (base.node_const(s) != 0) { check_const_ref(s); }
}

// if 语句
pub fn cs_if(s: i64, cond_i: i64, then_i: i64, else_i: i64) void {
    var ct: i64 = infer_expr_hir(cond_i, base.node_na((s as u64)));
    if (is_cond_bool(ct) == false) {
        var di: i64 = base.diag_new("T-SEM-E204", "error",
            base.sb_cat2("if condition must be bool or explicit comparison, got ", ti_str(ct)),
            "", 1, 1, 1, 5);
        var fx: i64 = base.fix_one("add explicit comparison", "", 1, 1, 1, 1, "(expr != 0)");
        base.diag_set_fs(di, fx);
    }
    var prev: i64 = cur_scope;
    cur_scope = scope_new_at(prev, s);
    cs_stmts_hir(then_i);
    if (else_i >= 0) {
        cur_scope = scope_new_at(prev, s);
        cs_stmts_hir(else_i);
    }
    cur_scope = prev;
}

// while / C 式 for 共用：init/upd 为 -1 即 while
pub fn cs_loop(s: i64, init_i: i64, cond_i: i64, upd_i: i64, body_i: i64) void {
    // 循环头与循环体共用一层作用域。C 式 for 的初始化变量必须**先**入作用域，
    // 条件与步进才解析得到它。
    var prev2: i64 = cur_scope;
    cur_scope = scope_new_at(prev2, s);
    if (init_i >= 0) { check_stmt_hir(init_i); }
    if (cond_i >= 0) {
        var ct2: i64 = infer_expr_hir(cond_i, hir.hir_inst_node(cond_i));
        if (is_cond_bool(ct2) == false) {
            base.diag_new("T-SEM-E204", "error",
                base.sb_cat2("loop condition must be bool, got ", ti_str(ct2)),
                "", 1, 1, 1, 5);
        }
    }
    cs_stmts_hir(body_i);
    // 步进语句（C 式 for）一并检查
    if (upd_i >= 0) { check_stmt_hir(upd_i); }
    cur_scope = prev2;
}

// for-in 迭代
pub fn cs_forin(s: i64, iter_i: i64, body_i: i64) void {
    // 已被 lower_for_range / lower_for_array 就地改写为 block
    if (base.node_kind((s as u64)) == "block") { cs_block_node(s); return; }
    if (is_range_node(base.node_na((s as u64)))) {
        lower_for_range(s);
        if (base.node_kind((s as u64)) == "block") { cs_block_node(s); }
        return;
    }
    var itt: i64 = infer_expr_hir(iter_i, base.node_na((s as u64)));
    if (tip_kind(itt) == "Array") {
        lower_for_array(s);
        if (base.node_kind((s as u64)) == "block") { cs_block_node(s); }
        return;
    }
    var prev3: i64 = cur_scope;
    cur_scope = scope_new_at(prev3, s);
    var et: i64 = -1;
    var itk: string = tip_kind(itt);
    if (itk == "Slice" or itk == "Array") {
        var t4: TI = tis[itt];
        et = t4.elem;
    } else {
    if (itk == "Map") {
        var t5: TI = tis[itt];
        et = t5.key;
    } else {
        et = ti_mk("Unknown");
    }}
    sym_define(cur_scope, base.node_sa((s as u64)), "var", et, -1);
    // 双变量形式 `for (k, v in m)`：第二个变量绑定值类型
    if (str_len(base.node_sb((s as u64))) > 0) {
        var vt5: i64 = ti_mk("Unknown");
        if (itk == "Map") {
            var t6: TI = tis[itt];
            vt5 = t6.val;
        } else {
            base.diag_new("T-SEM-E202", "error",
                "for (k, v in x): 双变量迭代仅支持 map",
                parse.n_file(base.node_na((s as u64))), parse.n_line(base.node_na((s as u64))), parse.n_col(base.node_na((s as u64))), parse.n_line(base.node_na((s as u64))), parse.n_col(base.node_na((s as u64))) + 5);
        }
        sym_define(cur_scope, base.node_sb((s as u64)), "var", vt5, -1);
    }
    cs_stmts_hir(body_i);
    cur_scope = prev3;
}

// return 语句
pub fn cs_return(s: i64, val_i: i64) void {
    if (base.node_na((s as u64)) >= 0) {
        // 管道许可上下文之三：return 值
        pipe_mark(base.node_na((s as u64)));
        var saved_ve3: i64 = g_vec_expect;
        var saved_te3: i64 = g_tile_expect;
        var saved_le3: i64 = g_lead_expect;
        if (ti_is_vector(cur_ret)) { g_vec_expect = cur_ret; g_tile_expect = -1; }
        else if (ti_is_tile(cur_ret)) { g_tile_expect = cur_ret; g_vec_expect = -1; }
        else { g_vec_expect = -1; g_tile_expect = -1; }
        g_lead_expect = cur_ret;
        var rt: i64 = infer_expr_hir(val_i, base.node_na((s as u64)));
        g_vec_expect = saved_ve3;
        g_tile_expect = saved_te3;
        g_lead_expect = saved_le3;
        // 逃逸分析（T-SEM-E764）：返回对局部变量/参数的引用 → 悬垂指针
        if (expr_has_local_addr(base.node_na((s as u64)))) {
            parse.fc_err("T-SEM-E764",
                "返回对局部变量/参数的引用会产生悬垂指针（dangling）：该引用随函数返回而失效",
                base.node_na((s as u64)));
        }
        intlit_overflow_warn(base.node_na((s as u64)), cur_ret);
        if (tip_kind(rt) != "Unknown" and ti_equal(rt, cur_ret) == false) {
            if (can_cast(rt, cur_ret) == false) {
                err_type_mismatch(base.node_na((s as u64)), cur_ret, rt);
            }
        }
        // 同 call 路径，return 值处的 Array→Slice / 空数组字面量→Slice 构造
        if (tip_kind(cur_ret) == "Slice" and ti_equal(cur_ret, rt) == false and can_cast(rt, cur_ret)) {
            var rak: string = base.node_kind((base.node_na((s as u64)) as u64));
            if (rak == "array_lit" or tip_kind(rt) == "Array") {
                base.node_set_na((s as u64), base.mk_cast(base.node_na((s as u64)), ti_to_td_base(cur_ret), -1));
            }
        }
    }
}

// 赋值语句（含复合赋值 `*r = v` 的只读引用写入检查）
pub fn cs_assignment(s: i64, ai: i64) void {
    var lhs_i: i64 = hir.hir_arg(ai, 0);
    var rhs_i: i64 = hir.hir_arg(ai, 1);
    var tt: i64 = infer_expr_hir(lhs_i, base.node_na((s as u64)));
    if (base.node_kind((base.node_na((s as u64)) as u64)) == "deref") {
            var dop: i64 = base.node_na((base.node_na((s as u64)) as u64));
        if (dop >= 0 and base.node_kind((dop as u64)) == "ident") {
            var dsi: i64 = sym_lookup(cur_scope, base.node_sa((dop as u64)));
            if (dsi < 0) { dsi = sym_lookup(global_scope, base.node_sa((dop as u64))); }
            if (dsi >= 0) {
                var ddecl: i64 = syms[dsi].decl;
                if (ddecl >= 0 and base.node_kind((ddecl as u64)) == "var_decl" and base.node_ba((ddecl as u64)) == true) {
                    parse.fc_err("T-SEM-E762",
                        base.sb_cat3("不能透过只读引用 `", base.node_sa((dop as u64)),
                            "` 写入：它由 `let`/`const` 声明（只读），要用可变引用请改用 `var` 声明"),
                        base.node_na((s as u64)));
                }
            }
        }
    }
    // 管道许可上下文之二：赋值右侧
    pipe_mark(base.node_nb((s as u64)));
    var saved_ve1: i64 = g_vec_expect;
    var saved_te1: i64 = g_tile_expect;
    var saved_le1: i64 = g_lead_expect;
    if (ti_is_vector(tt)) { g_vec_expect = tt; g_tile_expect = -1; }
    else if (ti_is_tile(tt)) { g_tile_expect = tt; g_vec_expect = -1; }
    else { g_vec_expect = -1; g_tile_expect = -1; }
    g_lead_expect = tt;
    var vt2: i64 = infer_expr_hir(rhs_i, base.node_nb((s as u64)));
    g_vec_expect = saved_ve1;
    g_tile_expect = saved_te1;
    g_lead_expect = saved_le1;
    intlit_overflow_warn(base.node_nb((s as u64)), tt);
    if (tip_kind(tt) != "Unknown" and tip_kind(vt2) != "Unknown" and ti_equal(tt, vt2) == false) {
        var str_to_sym2: bool = tip_kind(tt) == "Sym" and tip_kind(vt2) == "String";
        if (str_to_sym2 == false and can_cast(vt2, tt) == false) {
            err_type_mismatch(base.node_nb((s as u64)), tt, vt2);
        }
        if (tip_kind(tt) == "Slice" and ti_equal(tt, vt2) == false and can_cast(vt2, tt)) {
            var aak: string = base.node_kind((base.node_nb((s as u64)) as u64));
            if (aak == "array_lit" or tip_kind(vt2) == "Array") {
                base.node_set_nb((s as u64), base.mk_cast(base.node_nb((s as u64)), ti_to_td_base(tt), -1));
            }
        }
    }
}

// 表达式语句
pub fn cs_expr_stmt(s: i64, ei: i64) void {
    // 管道许可上下文之四：表达式语句（穿过赋值链移到最内层右值）
    var pe: i64 = pipe_mark(base.node_na((s as u64)));
    var discarded: bool = true;
    var go2: bool = true;
    while (go2 == true) {
        go2 = false;
        if (pe >= 0) {
            if (base.node_kind((pe as u64)) == "assign") {
                pe = pipe_mark(base.node_nb((pe as u64)));
                discarded = false;
                go2 = true;
            }
        }
    }
    var was_pipe: bool = false;
    if (pe >= 0) { was_pipe = is_pipe_kind(base.node_kind((pe as u64))); }
    var et: i64 = infer_expr_hir(ei, base.node_na((s as u64)));
    // 管道 `|>` 逐元素 + void lambda 降级：lower_pipe 把管道根就地改写成 block
    if (base.node_kind((base.node_na((s as u64)) as u64)) == "block") {
        hir.hir_invalidate((s as u64));
        base.node_set_kind((s as u64), "block");
        base.node_set_sa((s as u64), "");
        base.node_set_sb((s as u64), "");
        base.node_set_na((s as u64), -1);
        base.node_set_nb((s as u64), -1);
        base.node_set_la((s as u64), base.node_la((base.node_na((s as u64)) as u64)));
        cs_block_node(s);
        return;
    }
    if (discarded == false) { was_pipe = false; }
    if (was_pipe == true) {
        if (tip_kind(et) != "Void" and tip_kind(et) != "Unknown") {
            pipe_warn("T-PIP-W868",
                base.sb_cat3("管道结果类型为 `", ti_str(et),
                    "` 但被丢弃：请接收结果，或让末级函数返回 void"), base.node_na((s as u64)));
        }
    }
}

// 语句指令分派（HIR 驱动）
pub fn check_stmt_hir(si: i64) void {
    var op: i64 = hir.hir_op_of(si);
    // BLOCK 可能由语句列表头合成（无源节点），须先于节点解析处理
    if (op == hir.HIR_OP_BLOCK) { cs_block_inst(si); return; }
    var s: i64 = hir.hir_inst_node(si);
    if (s < 0) { return; }
    if (op == hir.HIR_OP_CAPTURE) {
        if (base.node_na((s as u64)) >= 0) { sym_define(cur_scope, base.node_sa((s as u64)), "var", resolve_ti(base.node_na((s as u64))), -1); }
        return;
    }
    if (op == hir.HIR_OP_LOCAL_DECL) { cs_var_decl(s, hir.hir_arg(si, 0)); return; }
    if (op == hir.HIR_OP_IF) { cs_if(s, hir.hir_arg(si, 0), hir.hir_arg(si, 1), hir.hir_arg(si, 2)); return; }
    if (op == hir.HIR_OP_LOOP) { cs_loop(s, -1, hir.hir_arg(si, 0), -1, hir.hir_arg(si, 1)); return; }
    if (op == hir.HIR_OP_FOR) { cs_loop(s, hir.hir_arg(si, 0), hir.hir_arg(si, 1), hir.hir_arg(si, 2), hir.hir_arg(si, 3)); return; }
    if (op == hir.HIR_OP_FORIN) { cs_forin(s, hir.hir_arg(si, 0), hir.hir_arg(si, 1)); return; }
    if (op == hir.HIR_OP_INLINE_FOR) { check_stmt_cst(s); return; }   // 阶段1 S4：回落 CST，与原 RAW 路径行为一致
    if (op == hir.HIR_OP_RETURN) { cs_return(s, hir.hir_arg(si, 0)); return; }
    if (op == hir.HIR_OP_ASSIGN) {
        // 只有复合赋值（`+=` 等，kind=="assignment"）是语句；普通赋值表达式
        // 在语句位置无动作（与原 check_stmt 行为一致）
        if (base.node_kind((s as u64)) == "assignment") { cs_assignment(s, si); }
        return;
    }
    if (op == hir.HIR_OP_EXPR_STMT) { cs_expr_stmt(s, hir.hir_arg(si, 0)); return; }
    if (op == hir.HIR_OP_DEFER) {
        var prevd: i64 = cur_scope;
        cur_scope = scope_new_at(prevd, s);
        cs_stmts_hir(hir.hir_arg(si, 0));
        cur_scope = prevd;
        return;
    }
    if (op == hir.HIR_OP_COMPTIME) {
        if (base.node_kind((s as u64)) == "comptime_block") {
            var prevc: i64 = cur_scope;
            cur_scope = scope_new_at(prevc, s);
            g_in_comptime = g_in_comptime + 1;
            cs_stmts_hir(hir.hir_arg(si, 0));
            g_in_comptime = g_in_comptime - 1;
            cur_scope = prevc;
        }
        return;
    }
    if (op == hir.HIR_OP_BREAK) { return; }
    if (op == hir.HIR_OP_CONTINUE) { return; }
    if (op == hir.HIR_OP_RAW) { check_stmt_cst(s); return; }
    // 其余指令（FIELD_SET / INDEX_SET / CALL / …）在语句层无动作：
    // 它们只作为表达式出现在 EXPR_STMT 之下，由 infer 侧处理。
}

// ── 语句检查（CST 回落路径；复刻 checker.ts:345）────────────────
// 仅用于「没有 HIR 指令的节点」（脱糖合成 / 就地改写后的块）。

pub fn check_stmt_cst(s: i64) void {
    // 闭包体首的捕获变量重建（M48）：类型来自捕获点的原始声明，直接定义同名局部
    if (base.node_kind((s as u64)) == "closure_capture") {
        if (base.node_na((s as u64)) >= 0) {
            sym_define(cur_scope, base.node_sa((s as u64)), "var", resolve_ti(base.node_na((s as u64))), -1);
        }
        return;
    }
    if (base.node_kind((s as u64)) == "var_decl") {
        var vt: i64 = -1;
        // 管道许可上下文之一：初始化器（reference.md §3.15.6）
        if (base.node_nb((s as u64)) >= 0) { pipe_mark(base.node_nb((s as u64))); }
        if (base.node_na((s as u64)) >= 0) {
            // 显式标注：直接采用（var/const/let 三种局部声明统一路径）
            vt = resolve_ti(base.node_na((s as u64)));
        } else if (base.node_nb((s as u64)) >= 0) {
            // 局部声明（var/const/let）无标注时由初始化器静态推断（人类编程友好）。
            // 此前仅 `auto`(bb) 走此路；现三关键字统一开放，标注语义改为「可选约束/覆盖」。
            var inf_ti: i64 = infer_expr(base.node_nb((s as u64)));
            if (inf_ti >= 0 and tip_kind(inf_ti) != "Unknown") {
                vt = inf_ti;
                var tn2: i64 = mk_type_node_from_ti(inf_ti);
                base.node_set_na((s as u64), tn2);
            }
        }
        if (vt < 0) {
            // 既无标注、又无（可推断类型的）初始化器 → 无法定型
            parse.fc_err("T-SEM-E211",
                base.sb_cat3("局部变量 `", base.node_sa((s as u64)),
                    "` 必须带类型标注或提供可推断类型的初始化器"), s);
            return;
        }
        if (base.node_nb((s as u64)) >= 0) {
            var saved_ve2: i64 = g_vec_expect;
            var saved_te2: i64 = g_tile_expect;
            var saved_le2: i64 = g_lead_expect;
            if (ti_is_vector(vt)) { g_vec_expect = vt; g_tile_expect = -1; }
            else if (ti_is_tile(vt)) { g_tile_expect = vt; g_vec_expect = -1; }
            else { g_vec_expect = -1; g_tile_expect = -1; }
            g_lead_expect = vt;
            var it: i64 = infer_expr(base.node_nb((s as u64)));
            g_vec_expect = saved_ve2;
            g_tile_expect = saved_te2;
            g_lead_expect = saved_le2;
            intlit_overflow_warn(base.node_nb((s as u64)), vt);
            if (tip_kind(it) != "Unknown" and ti_equal(it, vt) == false) {
                var vk: string = tip_kind(vt);
                // P3：同上，位域按 `tip_is_flag` 判别（见 8422 处注释）。
                var int_to_fe: bool = (tip_is_flag(vt) or vk == "Enum") and is_int_ti(it);
                // Sym 字段允许由字符串赋值（自动 intern → id）
                var str_to_sym: bool = vk == "Sym" and tip_kind(it) == "String";
                if (int_to_fe == false and str_to_sym == false and can_cast(it, vt) == false) {
                    err_type_mismatch(base.node_nb((s as u64)), vt, it);
                }
            }
        }
        sym_define(cur_scope, base.node_sa((s as u64)), "var", vt, s);
        // const 引用静态常量规则（仅对 const 声明生效；let/var 不受限）
        if (base.node_const(s) != 0) { check_const_ref(s); }
        return;
    }
    if (base.node_kind((s as u64)) == "if") {
        var ct: i64 = infer_expr(base.node_na((s as u64)));
        if (is_cond_bool(ct) == false) {
            var di: i64 = base.diag_new("T-SEM-E204", "error",
                base.sb_cat2("if condition must be bool or explicit comparison, got ", ti_str(ct)),
                "", 1, 1, 1, 5);
            var fx: i64 = base.fix_one("add explicit comparison", "", 1, 1, 1, 1, "(expr != 0)");
            base.diag_set_fs(di, fx);
        }
        var prev: i64 = cur_scope;
        cur_scope = scope_new_at(prev, s);
        var c: i64 = base.node_la((s as u64));
        var mq_ks8399: []i64 = base.kids_chain_idx(base.node_la((s as u64)));
        var mq_ki8399: i64 = 0;
        while (mq_ki8399 < slice_len(mq_ks8399) as i64) {
            c = mq_ks8399[mq_ki8399];
            var k: Child = base.kids[c];
            check_stmt(k.val);
            mq_ki8399 = mq_ki8399 + 1;
            c = -1;
        }
        if (base.node_lb((s as u64)) != -2) {
            cur_scope = scope_new_at(prev, s);
            var c2: i64 = base.node_lb((s as u64));
            var mq_ks8407: []i64 = base.kids_chain_idx(base.node_lb((s as u64)));
            var mq_ki8407: i64 = 0;
            while (mq_ki8407 < slice_len(mq_ks8407) as i64) {
                c2 = mq_ks8407[mq_ki8407];
                var k2: Child = base.kids[c2];
                check_stmt(k2.val);
                mq_ki8407 = mq_ki8407 + 1;
                c2 = -1;
            }
        }
        cur_scope = prev;
        return;
    }
    if (base.node_kind((s as u64)) == "for" or base.node_kind((s as u64)) == "while") {
        // 脱糖产出的 fresh 循环节点：体已在脱糖期原作用域全检，重走会破坏嵌套值循环的
        // 外层循环变量可见性 → 直接跳过体再检查（发射由 codegen 独立遍历负责）。
        if (vl_is_checked(s)) { return; }
        // 循环头与循环体共用一层作用域。C 式 for 的初始化变量必须**先**入作用域，
        // 条件与步进才解析得到它 —— 原实现在建作用域前就推断条件，`for (var i...; i <= n; ...)`
        // 里的 `i` 解析不到，靠 infer_expr 的 Unknown 兜底才没炸（T_UNDEFINED_IDENT 上线后暴露）。
        var prev2: i64 = cur_scope;
        cur_scope = scope_new_at(prev2, s);
        if (base.node_kind((s as u64)) == "for" and base.node_na((s as u64)) >= 0) {
            check_stmt(base.node_na((s as u64)));
        }
        var cond: i64 = base.node_na((s as u64));
        if (base.node_kind((s as u64)) == "for") {
            cond = base.node_nb((s as u64));
        }
        if (cond >= 0) {
            var ct2: i64 = infer_expr(cond);
            if (is_cond_bool(ct2) == false) {
                base.diag_new("T-SEM-E204", "error",
                    base.sb_cat2("loop condition must be bool, got ", ti_str(ct2)),
                    "", 1, 1, 1, 5);
            }
        }
        var c3: i64 = base.node_la((s as u64));
        var mq_ks8441: []i64 = base.kids_chain_idx(base.node_la((s as u64)));
        var mq_ki8441: i64 = 0;
        while (mq_ki8441 < slice_len(mq_ks8441) as i64) {
            c3 = mq_ks8441[mq_ki8441];
            var k3: Child = base.kids[c3];
            check_stmt(k3.val);
            mq_ki8441 = mq_ki8441 + 1;
            c3 = -1;
        }
        // 步进语句此前**完全未被检查**（发射侧照常发射），一并补上。
        if (base.node_kind((s as u64)) == "for" and base.node_nc((s as u64)) >= 0) {
            check_stmt(base.node_nc((s as u64)));
        }
        cur_scope = prev2;
        return;
    }
    if (base.node_kind((s as u64)) == "for_each") {
        if (vl_is_checked(s)) { return; }
        // `for (i in a..b)`：区间不物化，就地改写成计数循环再按 block 走一遍。
        // 必须抢在 infer_expr(n.na) 之前 —— 否则区间会先被当成值物化成 []i64，
        // 白白分配一条 n 长的切片。
        if (is_range_node(base.node_na((s as u64)))) {
            lower_for_range(s);
            if (base.node_kind((s as u64)) == "block") {
                check_stmt(s);
            }
            return;
        }
        var itt: i64 = infer_expr(base.node_na((s as u64)));
        if (tip_kind(itt) == "Array") {
            lower_for_array(s);
            if (base.node_kind((s as u64)) == "block") {
                check_stmt(s);
            }
            return;
        }
        var prev3: i64 = cur_scope;
        cur_scope = scope_new_at(prev3, s);
        var et: i64 = -1;
        var itk: string = tip_kind(itt);
        if (itk == "Slice" or itk == "Array") {
            var t4: TI = tis[itt];
            et = t4.elem;
        } else {
        if (itk == "Map") {
            // map 的 for-in 迭代键（按插入序）
            var t5: TI = tis[itt];
            et = t5.key;
        } else {
            et = ti_mk("Unknown");
        }}
        sym_define(cur_scope, base.node_sa((s as u64)), "var", et, -1);
        // 双变量形式 `for (k, v in m)`：第二个变量绑定值类型
        if (str_len(base.node_sb((s as u64))) > 0) {
            var vt5: i64 = ti_mk("Unknown");
            if (itk == "Map") {
                var t6: TI = tis[itt];
                vt5 = t6.val;
            } else {
                base.diag_new("T-SEM-E202", "error",
                    "for (k, v in x): 双变量迭代仅支持 map",
                    parse.n_file(base.node_na((s as u64))), parse.n_line(base.node_na((s as u64))), parse.n_col(base.node_na((s as u64))), parse.n_line(base.node_na((s as u64))), parse.n_col(base.node_na((s as u64))) + 5);
            }
            sym_define(cur_scope, base.node_sb((s as u64)), "var", vt5, -1);
        }
        var c4: i64 = base.node_la((s as u64));
        var mq_ks8503: []i64 = base.kids_chain_idx(base.node_la((s as u64)));
        var mq_ki8503: i64 = 0;
        while (mq_ki8503 < slice_len(mq_ks8503) as i64) {
            c4 = mq_ks8503[mq_ki8503];
            var k4: Child = base.kids[c4];
            check_stmt(k4.val);
            mq_ki8503 = mq_ki8503 + 1;
            c4 = -1;
        }
        cur_scope = prev3;
        return;
    }
    if (base.node_kind((s as u64)) == "return") {
        if (base.node_na((s as u64)) >= 0) {
            // 管道许可上下文之三：return 值
            pipe_mark(base.node_na((s as u64)));
            var saved_ve3: i64 = g_vec_expect;
            var saved_te3: i64 = g_tile_expect;
            var saved_le3: i64 = g_lead_expect;
            if (ti_is_vector(cur_ret)) { g_vec_expect = cur_ret; g_tile_expect = -1; }
            else if (ti_is_tile(cur_ret)) { g_tile_expect = cur_ret; g_vec_expect = -1; }
            else { g_vec_expect = -1; g_tile_expect = -1; }
            g_lead_expect = cur_ret;
            var rt: i64 = infer_expr(base.node_na((s as u64)));
            g_vec_expect = saved_ve3;
            g_tile_expect = saved_te3;
            g_lead_expect = saved_le3;
            // 逃逸分析（T-SEM-E764）：返回对局部变量/参数的引用 → 悬垂指针（dangling）
            if (expr_has_local_addr(base.node_na((s as u64)))) {
                parse.fc_err("T-SEM-E764",
                    "返回对局部变量/参数的引用会产生悬垂指针（dangling）：该引用随函数返回而失效",
                    base.node_na((s as u64)));
            }
            intlit_overflow_warn(base.node_na((s as u64)), cur_ret);
            if (tip_kind(rt) != "Unknown" and ti_equal(rt, cur_ret) == false) {
                if (can_cast(rt, cur_ret) == false) {
                    err_type_mismatch(base.node_na((s as u64)), cur_ret, rt);
                }
            }
            // #2/#3：同 call 路径，return 值处的 Array→Slice / 空数组字面量→Slice 构造
            if (tip_kind(cur_ret) == "Slice" and ti_equal(cur_ret, rt) == false and can_cast(rt, cur_ret)) {
                var rak: string = base.node_kind((base.node_na((s as u64)) as u64));
                if (rak == "array_lit" or tip_kind(rt) == "Array") {
                    base.node_set_na((s as u64), base.mk_cast(base.node_na((s as u64)), ti_to_td_base(cur_ret), -1));
                }
            }
        }
        return;
    }
    if (base.node_kind((s as u64)) == "assignment") {
        var tt: i64 = infer_expr(base.node_na((s as u64)));
        // 解引用赋值 `*r = v`：仅当 r 为可变绑定（var）时允许，否则即「只读引用被写入」。
        // （原 E762 检查误置于 infer_expr 的 assign 分支，但语句级赋值从不经该分支，
        //  故从未触发；此处才是赋值语句的真实检查点。）
        if (base.node_kind((base.node_na((s as u64)) as u64)) == "deref") {
            var dop: i64 = base.node_na((base.node_na((s as u64)) as u64));
            if (dop >= 0 and base.node_kind((dop as u64)) == "ident") {
                var dsi: i64 = sym_lookup(cur_scope, base.node_sa((dop as u64)));
                if (dsi < 0) { dsi = sym_lookup(global_scope, base.node_sa((dop as u64))); }
                if (dsi >= 0) {
                    var ddecl: i64 = syms[dsi].decl;
                    if (ddecl >= 0 and base.node_kind((ddecl as u64)) == "var_decl" and base.node_ba((ddecl as u64)) == true) {
                        parse.fc_err("T-SEM-E762",
                            base.sb_cat3("不能透过只读引用 `", base.node_sa((dop as u64)),
                                "` 写入：它由 `let`/`const` 声明（只读），要用可变引用请改用 `var` 声明"),
                            base.node_na((s as u64)));
                    }
                }
            }
        }
        // 管道许可上下文之二：赋值右侧
        // （T-SEM-E764 逃逸检查统一放在 infer_expr 的 assign 分支，避免与 compound
        // 赋值节点重复；此处 LHS 为元组，assign_target_escapable 已天然不匹配。）
        pipe_mark(base.node_nb((s as u64)));
        var saved_ve1: i64 = g_vec_expect;
        var saved_te1: i64 = g_tile_expect;
        var saved_le1: i64 = g_lead_expect;
        if (ti_is_vector(tt)) { g_vec_expect = tt; g_tile_expect = -1; }
        else if (ti_is_tile(tt)) { g_tile_expect = tt; g_vec_expect = -1; }
        else { g_vec_expect = -1; g_tile_expect = -1; }
        g_lead_expect = tt;
        var vt2: i64 = infer_expr(base.node_nb((s as u64)));
        g_vec_expect = saved_ve1;
        g_tile_expect = saved_te1;
        g_lead_expect = saved_le1;
        intlit_overflow_warn(base.node_nb((s as u64)), tt);
        if (tip_kind(tt) != "Unknown" and tip_kind(vt2) != "Unknown" and ti_equal(tt, vt2) == false) {
            // Sym 字段允许由字符串赋值（自动 intern）；跨池 Sym→Sym 仍报错
            var str_to_sym2: bool = tip_kind(tt) == "Sym" and tip_kind(vt2) == "String";
            if (str_to_sym2 == false and can_cast(vt2, tt) == false) {
                err_type_mismatch(base.node_nb((s as u64)), tt, vt2);
            }
            // #2/#3：同 call 路径，赋值 RHS 处的 Array→Slice / 空数组字面量→Slice 构造
            if (tip_kind(tt) == "Slice" and ti_equal(tt, vt2) == false and can_cast(vt2, tt)) {
                var aak: string = base.node_kind((base.node_nb((s as u64)) as u64));
                if (aak == "array_lit" or tip_kind(vt2) == "Array") {
                    base.node_set_nb((s as u64), base.mk_cast(base.node_nb((s as u64)), ti_to_td_base(tt), -1));
                }
            }
        }
        return;
    }
    if (base.node_kind((s as u64)) == "expr") {
        // 管道许可上下文之四：表达式语句。
        // ⚠ 之二（赋值右侧）也多半落在这里：`parse_assign_expr` 已把 `=` 吃成 `assign`
        // 表达式，语句级 `assignment` 节点只剩复合赋值（`+=` 等），故须穿过赋值链
        // （含 `a = b = pipe;`）把许可位置移到最内层右值上。
        var pe: i64 = pipe_mark(base.node_na((s as u64)));
        var discarded: bool = true;
        var go2: bool = true;
        while (go2 == true) {
            go2 = false;
            if (pe >= 0) {
                if (base.node_kind((pe as u64)) == "assign") {
                    pe = pipe_mark(base.node_nb((pe as u64)));
                    discarded = false;
                    go2 = true;
                }
            }
        }
        var was_pipe: bool = false;
        if (pe >= 0) { was_pipe = is_pipe_kind(base.node_kind((pe as u64))); }
        var et: i64 = infer_expr(base.node_na((s as u64)));
        // 管道 |> 逐元素 + void lambda 降级：lower_pipe 把管道根就地改写成 block
        // （内含 for_each 副作用遍历）。若仍以「表达式语句」发射，会把 block 当
        // 表达式 → `unsupported expr`。这里把它提升为本语句本身，走正常 for_each
        // 检查（注册循环变量、递归 body），再交由后端 emit_stmt 的 block 分支发射。
        if (base.node_kind((base.node_na((s as u64)) as u64)) == "block") {
            hir.hir_invalidate((s as u64));
            base.node_set_kind((s as u64), "block");
            base.node_set_sa((s as u64), "");
            base.node_set_sb((s as u64), "");
            base.node_set_na((s as u64), -1);
            base.node_set_nb((s as u64), -1);
            base.node_set_la((s as u64), base.node_la((base.node_na((s as u64)) as u64)));
            var cb: i64 = base.node_la((s as u64));
            while (cb >= 0) {
                var ckb: Child = base.kids[cb];
                check_stmt(ckb.val);
                cb = ckb.next;
            }
            return;
        }
        // 结果被接收（赋值链）时不告警；只有真正丢弃才报 W868。
        if (discarded == false) { was_pipe = false; }
        if (was_pipe == true) {
            if (tip_kind(et) != "Void" and tip_kind(et) != "Unknown") {
                pipe_warn("T-PIP-W868",
                    base.sb_cat3("管道结果类型为 `", ti_str(et),
                        "` 但被丢弃：请接收结果，或让末级函数返回 void"), base.node_na((s as u64)));
            }
        }
        return;
    }
    if (base.node_kind((s as u64)) == "block" or base.node_kind((s as u64)) == "block_expr" or base.node_kind((s as u64)) == "defer" or base.node_kind((s as u64)) == "comptime_block") {
        var prev4: i64 = cur_scope;
        cur_scope = scope_new_at(prev4, s);
        g_in_comptime = g_in_comptime + 1;
        var c5: i64 = base.node_la((s as u64));
        var mq_ks8657: []i64 = base.kids_chain_idx(base.node_la((s as u64)));
        var mq_ki8657: i64 = 0;
        while (mq_ki8657 < slice_len(mq_ks8657) as i64) {
            c5 = mq_ks8657[mq_ki8657];
            var k5: Child = base.kids[c5];
            check_stmt(k5.val);
            mq_ki8657 = mq_ki8657 + 1;
            c5 = -1;
        }
        cur_scope = prev4;
        g_in_comptime = g_in_comptime - 1;
        return;
    }
}

// ── 声明检查（复刻 checker.ts:178-341）────────────────────────

// CST 入口（泛型实例克隆体等没有 HIR 指令的声明）
pub fn check_func_decl(d: i64) void {
    check_func_decl_ex(d, -1);
}

// 判断 comptime fn 是否为「编译期专用」（只能编译期调用）：存在任一 comptime/type 形参即视为专用。
// 专用 comptime fn 体只会在调用点（comptime 上下文）折叠，故其体可按 comptime 上下文检查、
// ctfe-only 内建豁免 T-MTA-E605；非专用 comptime fn（无 comptime 形参）仍可运行期调用，其体
// 须为合法运行期代码，必须按运行期上下文检查（ctfe-only 内建误用须报 T-MTA-E605）。
pub fn comptime_fn_has_ct_param(d: i64) bool {
    var ps: i64 = base.node_lb((d as u64));
    var ks: []i64 = base.kids_chain_idx(ps);
    var ki: i64 = 0;
    while (ki < slice_len(ks) as i64) {
        var p: i64 = base__kids[ks[ki]].val;
        if (base.node_bb((p as u64))) { return true; }
        ki = ki + 1;
    }
    return false;
}

// HIR 入口：形参取 PARAM_DECL 指令、函数体取末位 BLOCK 指令
pub fn check_func_decl_hir(di: i64) void {
    check_func_decl_ex(hir.hir_inst_node(di), di);
}

pub fn check_func_decl_ex(d: i64, di: i64) void {
    if (base.node_lc((d as u64)) == -2) {
        return;
    }
    // 维护 g_cur_func_decl，供 format 脱糖判断当前是否处于泛型模板体内（见 desugar_format_call）。
    var prev_fd: i64 = g_cur_func_decl;
    g_cur_func_decl = d;

    var prev: i64 = cur_scope;
    cur_scope = scope_new_at(global_scope, d);

    // 由 lambda 提升而来的合成函数：函数体已脱离原词法环境，未解析的标识符
    // 即「试图捕获外层局部」，需给出可执行的诊断（见 infer_expr ident 分支）。
    var prev_lam: bool = lex.g_in_lambda;
    lex.g_in_lambda = base.node_sc((d as u64)) == "__lambda__";   // S4 §0.14.7 SoA：侧表读（原 n.sc）

    if (di >= 0) {
        // HIR 路径：FN_DECL 的 args = [PARAM_DECL..., body]
        var pc: i64 = hir.hir_arg_count(di);
        var pi: i64 = 0;
        while (pi < pc - 1) {
            var p_inst: i64 = hir.hir_arg(di, pi);
            var pid2: i64 = hir.hir_inst_node(p_inst);
            if (pid2 >= 0) {
                sym_define(cur_scope, base.node_sa((pid2 as u64)), "var", resolve_ti(base.node_na((pid2 as u64))), -1);
                // T-SEM-E214：简写闭包 `|v|` 参数类型若到检查期仍无上下文回填 → 报错（绝不默认 any）
                if (base.node_na((pid2 as u64)) >= 0 and tip_kind(resolve_ti(base.node_na((pid2 as u64)))) == "Infer") {
                    parse.fc_err("T-SEM-E214",
                        base.sb_cat5("匿名函数参数 `", base.node_sa((pid2 as u64)),
                            "` 的类型无法推断：请标注目标类型（如 `var g: fn(T)U = |name| ...`），或显式写出 `|",
                            base.node_sa((pid2 as u64)), ": Type|`"),
                        d);
                }
            }
            pi = pi + 1;
        }
    } else {
        var c: i64 = base.node_lb((d as u64));
        var mq_ks8717: []i64 = base.kids_chain_idx(base.node_lb((d as u64)));
        var mq_ki8717: i64 = 0;
        while (mq_ki8717 < slice_len(mq_ks8717) as i64) {
            c = mq_ks8717[mq_ki8717];
            var k: Child = base.kids[c];
            sym_define(cur_scope, base.node_sa((k.val as u64)), "var", resolve_ti(base.node_na((k.val as u64))), -1);
            if (base.node_na((k.val as u64)) >= 0 and tip_kind(resolve_ti(base.node_na((k.val as u64)))) == "Infer") {
                parse.fc_err("T-SEM-E214",
                    base.sb_cat5("匿名函数参数 `", base.node_sa((k.val as u64)),
                        "` 的类型无法推断：请标注目标类型（如 `var g: fn(T)U = |name| ...`），或显式写出 `|",
                        base.node_sa((k.val as u64)), ": Type|`"),
                    d);
            }
            mq_ki8717 = mq_ki8717 + 1;
            c = -1;
        }
    }

    var prev_ret: i64 = cur_ret;
    cur_ret = resolve_ti(base.node_na((d as u64)));
    // `|v: T| expr` 简写闭包：返回类型占位待推断，在此（函数体检查前）就地推断，
    // 使后续 all_paths_return 等检查基于真实返回类型。既有显式返回类型的函数不受影响。
    if (g_infer_ti >= 0 and tip_kind(cur_ret) == "Infer") {
        cur_ret = infer_lambda_ret_from_decl(d);
    }

    // S8：comptime fn 体纳入 comptime 上下文（g_in_comptime），使裸类型名即 type 值、
    // @type_info 等编译期能力在 comptime fn 体内可用（与 comptime { } 块一致）。
    // 用 save/restore 而非裸 +1/-1，避免嵌套 comptime 上下文被破坏。
    var saved_in_ct: i64 = g_in_comptime;
    // 仅对「编译期专用」comptime fn（带 comptime/type 形参、只能编译期调用）进入 comptime 上下文；
    // 不带 comptime 形参的 comptime fn 仍可运行期调用，其体须为合法运行期代码，故按运行期上下文
    // 检查（ctfe-only 内建误用须报 T-MTA-E605，而非被 comptime 豁免吞掉）——修复 f75 回归。
    if (base.node_bb((d as u64)) and comptime_fn_has_ct_param(d)) { g_in_comptime = g_in_comptime + 1; }
    if (di >= 0) {
        var bi: i64 = hir.hir_arg(di, hir.hir_arg_count(di) - 1);
        if (bi >= 0) { check_stmt_hir(bi); }
    } else {
        var c2: i64 = base.node_lc((d as u64));
        var mq_ks8744: []i64 = base.kids_chain_idx(base.node_lc((d as u64)));
        var mq_ki8744: i64 = 0;
        while (mq_ki8744 < slice_len(mq_ks8744) as i64) {
            c2 = mq_ks8744[mq_ki8744];
            var k2: Child = base.kids[c2];
            check_stmt(k2.val);
            mq_ki8744 = mq_ki8744 + 1;
            c2 = -1;
        }
    }
    g_in_comptime = saved_in_ct;

    if (tip_kind(cur_ret) != "Void") {
        if (all_paths_return(base.node_lc((d as u64))) == false) {
            var anchor: i64 = list_last_val(base.node_lc((d as u64)));
            var l: i64 = parse.n_line(anchor);
            var cc: i64 = parse.n_col(anchor);
            base.diag_new("T-PAR-E100", "error",
                base.sb_cat3("function '", base.node_sa((d as u64)), "' is missing return on some code paths (all branches must explicitly return)"),
                parse.n_file(anchor), l, cc, l, cc + 10);
        }
    }

    cur_ret = prev_ret;
    cur_scope = prev;
    lex.g_in_lambda = prev_lam;
    g_cur_func_decl = prev_fd;
}

pub fn check_struct_decl(d: i64) void {
    // 积类型统一 P4：`packed struct` 走位域布局（顺序打包 + 成员只能是整型）。
    // P4 只算布局发诊断，不改后端发射 ⇒ 此后仍照普通 struct 流程走完 TypeID 校验。
    if (base.node_sb((d as u64)) == "packed") {
        check_packed_layout(d);
    }
    var c: i64 = base.node_lb((d as u64));
    var total: i64 = 0;
    var tag_count: i64 = 0;
    // 第一遍：解析字段类型 + 统计显式 tagID 字段数
    var mq_ks8773: []i64 = base.kids_chain_idx(base.node_lb((d as u64)));
    var mq_ki8773: i64 = 0;
    while (mq_ki8773 < slice_len(mq_ks8773) as i64) {
        c = mq_ks8773[mq_ki8773];
        var k: Child = base.kids[c];
        total = total + 1;
        if (base.node_ib((k.val as u64)) >= 1) { tag_count = tag_count + 1; }   // S4 §0.14.7 SoA：侧表读（原 f.ib）
        if (base.node_ia((k.val as u64)) == -1) {
            resolve_ti(base.node_na((k.val as u64)));
        }
        mq_ki8773 = mq_ki8773 + 1;
        c = -1;
    }
    // ── 全有 / 全无 规则：struct 内 tagID 要么全显式(@N)，要么全自动，禁止混合 ──
    if (tag_count > 0 and tag_count < total) {
        base.diag_new("T-SEM-E210", "error",
            base.sb_cat3("struct '", base.node_sa((d as u64)), "' 的字段 tagID 必须「全显式 @N」或「全自动」：不能部分字段写 @N、部分不写"),
            parse.n_file(d), parse.n_line(d), parse.n_col(d), parse.n_line(d), parse.n_col(d) + 4);
        return;
    }
    // ── 全显式：去重；全自动：顺序分配 1,2,3…（写入 f.ib 供后续 type_info / 序列化使用）──
    if (total > 0) {
        if (tag_count == total) {
            // 去重：O(n^2) 两两比对（struct 字段数极少）
            var p: i64 = base.node_lb((d as u64));
            var mq_ks8794: []i64 = base.kids_chain_idx(base.node_lb((d as u64)));
            var mq_ki8794: i64 = 0;
            while (mq_ki8794 < slice_len(mq_ks8794) as i64) {
                p = mq_ks8794[mq_ki8794];
                var q: i64 = base.kids[p].next;
                // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环
                var ks8671: []i64 = base.kids_chain(q);
                var ki8671: i64 = 0;
                while (ki8671 < slice_len(ks8671) as i64) {
                    var kv8671: i64 = ks8671[ki8671];
                    var pf_ib: i64 = base__node_ib((base.kids[p].val as u64));   // S4 §0.14.7 SoA：侧表读（原 pf.ib）
    if (pf_ib >= 1 and base__node_ib((kv8671 as u64)) == pf_ib) {
                        var osb: StringBuilder = sb_new();
                        sb_append_str(osb, "struct '");
                        sb_append_str(osb, base.node_sa((d as u64)));
                        sb_append_str(osb, "': 字段 tagID 重复 @");
                        sb_append_i64(osb, pf_ib);
                        sb_append_str(osb, "（字段 '");
                        sb_append_str(osb, base.node_sa((base.kids[p].val as u64)));
                        sb_append_str(osb, "' 与 '");
                        sb_append_str(osb, base.node_sa((kv8671 as u64)));
                        sb_append_str(osb, "'）");
                        base.diag_new("T-SEM-E209", "error", sb_to_str(osb),
                            parse.n_file(d), parse.n_line(d), parse.n_col(d), parse.n_line(d), parse.n_col(d) + 4);
                    }
                    ki8671 = ki8671 + 1;
                }
                mq_ki8794 = mq_ki8794 + 1;
                p = -1;
            }
        } else {
            // 全自动：顺序分配（基值 1）
            var idx: i64 = 1;
            var cc: i64 = base.node_lb((d as u64));
            // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环
            var ks8695: []i64 = base.kids_chain(cc);
            var ki8695: i64 = 0;
            while (ki8695 < slice_len(ks8695) as i64) {
                var kv8695: i64 = ks8695[ki8695];
                base.node_set_ib((kv8695 as u64), idx);   // S4 §0.14.7 SoA：取代 `ff.ib`（下方 slice_set 回写生效）
                idx = idx + 1;
                ki8695 = ki8695 + 1;
            }
        }
    }
    // ── 默认表达式类型检查：f.nb（默认）须可赋给字段类型 f.na ──
    c = base.node_lb((d as u64));
    while (c >= 0) {
        var k: Child = base.kids[c];
        if (base.node_nb((k.val as u64)) >= 0) {
            var ft: i64 = resolve_ti(base.node_na((k.val as u64)));
            var dt: i64 = infer_expr(base.node_nb((k.val as u64)));
            if (tip_kind(dt) != "Unknown" and ti_equal(dt, ft) == false and can_cast(dt, ft) == false) {
                err_type_mismatch(base.node_nb((k.val as u64)), ft, dt);
            }
        }
        c = k.next;
    }
}

// ── P5：packed struct 布局消费辅助（发射器按名查布局）─────────────
// 与 P4 的 `check_packed_layout` 配对：P4 算布局进扁平池，P5 的 C/LLVM 发射器按名取值。
pub fn pk_find_struct(name: string) i64 {
    var i: i64 = 0;
    var n: i64 = slice_len(pk_struct_names) as i64;
    while (i < n) {
        if (pk_struct_names[i] == name) { return i; }
        i = i + 1;
    }
    return -1;
}

// 底层整型名（u8/u16/u32/u64）→ LLVM 标量 ST（i8/i16/i32/i64）。
// ⚠ 用 iN 而非 uN：位运算（and/or/shl/lshr）在 iN 与 uN 上逐位相同，
// 且 lshr 是无符号（零填充）右移，正合位域抽取语义。
pub fn pk_host_st(under: string) string {
    if (under == "u8") { return "i8"; }
    if (under == "u16") { return "i16"; }
    if (under == "u32") { return "i32"; }
    return "i64";
}

// 取 (owner, field) 在扁平槽池中的索引；未命中返回 -1。
pub fn pk_find_slot(owner: string, field: string) i64 {
    var i: i64 = 0;
    var n: i64 = slice_len(pk_slot_owner) as i64;
    while (i < n) {
        if (pk_slot_owner[i] == owner and pk_slot_names[i] == field) { return i; }
        i = i + 1;
    }
    return -1;
}

// ── packed struct 位域布局（积类型统一 P4）─────────────────────
//
// `packed struct X { a: u1; b: u4; c: u12; }`：字段沿比特流**顺序打包**，
// 每个字段的位宽 = 其整型类型的数字后缀（`readable: u1` = 1 位），
// 与旧 `flag X[u32] { a: 1; b: 4; }` 逐位同构 —— flag 用「槽名: 位宽」，
// packed struct 把位宽挪进了字段类型（`u1` 本身就说自己是 1 位）。
//
// P4 只算布局并校验，**不改写任何后端发射**（后端改造在 P5）。
// ⇒ 本步零行为变更：packed struct 此刻仍按普通 struct 布局发射，
//    新引入的只有诊断 + 一张待消费的布局表。
//
// 上限 64 位的理由不是语言设计洁癖，而是**双后端一致的前提**：位集合要
// 落在单个宿主整型里，两个后端才能用同一套 shift/mask 语义实现读写。
// 超过 64 位就得铺开成多字/数组，那是另一套布局，另行设计（本轮直接诊断拒绝）。
//
// 布局落在扁平池里按 struct 名查（同 fd_ / fl_ 模式），P5 的发射器按名取值。
pub var pk_struct_names: []string;   // 每个 packed struct 一条：类型名
pub var pk_struct_under: []string;   // 推导出的底层整型名（u8/u16/u32/u64）
pub var pk_struct_total: []i64;      // 总位宽
pub var pk_slot_owner: []string;     // 每个槽一条：所属 packed struct 名
pub var pk_slot_names: []string;     // 槽字段名
pub var pk_slot_starts: []i64;       // 起始位
pub var pk_slot_lens: []i64;         // 位宽

// 总位宽向上取整到最小可容纳的宿主整型宽度（8 / 16 / 32 / 64）。
pub fn packed_host_bits(total: i64) i64 {
    if (total <= 8) { return 8; }
    if (total <= 16) { return 16; }
    if (total <= 32) { return 32; }
    return 64;
}

pub fn packed_host_name(bits: i64) string {
    if (bits == 8) { return "u8"; }
    if (bits == 16) { return "u16"; }
    if (bits == 32) { return "u32"; }
    return "u64";
}

// 字段类型的名字（仅用于诊断消息；解析不到给占位，不影响错字之外的行为）。
pub fn packed_field_tyname(f: i64) string {
    var tn: i64 = base.node_na((f as u64));
    if (tn < 0) { return "<unknown>"; }
    var ti: i64 = resolve_ti(tn);
    if (ti < 0) { return "<unknown>"; }
    return tip_name(ti);
}

// 字段在 packed struct 中的位宽；非整型（或类型无法解析）返回 -1。
// bool 取 1 位 —— 位集合里布尔就是单比特，且 get_bw("bool") 本来就给 1。
pub fn packed_field_bits(f: i64) i64 {
    var tn: i64 = base.node_na((f as u64));
    if (tn < 0) { return -1; }
    var ti: i64 = resolve_ti(tn);
    if (ti < 0) { return -1; }
    if (tip_kind(ti) != "Scalar") { return -1; }
    var nm: string = tip_name(ti);
    if (nm == "bool") { return 1; }
    if (is_int_name(nm) == false) { return -1; }
    return get_bw(nm);
}

// `packed struct` 的位布局：顺序打包 + 两项校验。
// ⚠ 幂等：同一 decl 会被 check 多遍（前置声明/递归引用），池里已有同名则直接返回，
// 否则重复 append 会无限增长，且同一错误报 N 次。
pub fn check_packed_layout(d: i64) void {
    var sname: string = base.node_sa((d as u64));
    var ei: i64 = 0;
    var etot: i64 = slice_len(pk_struct_names) as i64;
    while (ei < etot) {
        if (pk_struct_names[ei] == sname) { return; }
        ei = ei + 1;
    }
    var total: i64 = 0;
    var c: i64 = base.node_lb((d as u64));
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环
    var ks9230: []i64 = base.kids_chain_idx(c);
    var ki9230: i64 = 0;
    while (ki9230 < slice_len(ks9230) as i64) {
        var kv9230: i64 = ks9230[ki9230];
        var fv: i64 = base.kids[kv9230].val;
        var bw: i64 = packed_field_bits(fv);
        if (bw <= 0) {
            base.diag_new("T-SEM-E217", "error",
                base.sb_cat5("packed struct '", sname, "' 的字段 '",
                    base.sb_cat2(base.node_sa((fv as u64)), "' 必须是整型（bool 或 uN/iN，N 即位宽），实际是 '"),
                    base.sb_cat2(packed_field_tyname(fv), "'")),
                parse.n_file(fv), parse.n_line(fv), parse.n_col(fv), parse.n_line(fv), parse.n_col(fv) + 1);
        } else {
            append(pk_slot_owner, sname);
            append(pk_slot_names, base.node_sa((fv as u64)));
            append(pk_slot_starts, total);
            append(pk_slot_lens, bw);
            total = total + bw;
        }
        ki9230 = ki9230 + 1;
    }
    if (total > 64) {
        var wsb: StringBuilder = sb_new();
        sb_append_str(wsb, "packed struct '");
        sb_append_str(wsb, sname);
        sb_append_str(wsb, "' 总位宽 ");
        sb_append_i64(wsb, total);
        sb_append_str(wsb, " 超过底层整型上限 64 位，无法打包进单个整型：请拆分");
        base.diag_new("T-SEM-E218", "error", sb_to_str(wsb),
            parse.n_file(d), parse.n_line(d), parse.n_col(d), parse.n_line(d), parse.n_col(d) + 4);
    }
    append(pk_struct_names, sname);
    append(pk_struct_under, packed_host_name(packed_host_bits(total)));
    append(pk_struct_total, total);
}

pub fn check_enum_decl(d: i64) void {
    if (is_int_name(base.node_sb((d as u64))) == false) {
        var di: i64 = base.diag_new("T-SEM-E202", "error",
            base.sb_cat5("enum '", base.node_sa((d as u64)), "' underlying type must be an integer type, got '", base.node_sb((d as u64)), "'"),
            "", 1, 1, 1, 10);
        base.slb_begin();
        base.slb_add("u8");
        base.slb_add("u16");
        base.slb_add("u32");
        base.slb_add("u64");
        base.slb_add("i8");
        base.slb_add("i16");
        base.slb_add("i32");
        base.slb_add("i64");
        base.diag_set_vv(di, base.slb_head);
    }

    var c: i64 = base.node_lb((d as u64));
    var mq_ks8868: []i64 = base.kids_chain_idx(base.node_lb((d as u64)));
    var mq_ki8868: i64 = 0;
    while (mq_ki8868 < slice_len(mq_ks8868) as i64) {
        c = mq_ks8868[mq_ki8868];
        var k: Child = base.kids[c];
        if (base.node_na((k.val as u64)) >= 0) {
            var vt: i64 = infer_expr(base.node_na((k.val as u64)));
            if (tip_kind(vt) == "Scalar" and is_int_name(tip_name(vt)) == false) {
                base.diag_new("T-SEM-E202", "error",
                    base.sb_cat2("enum variant value must be integer, got ", ti_str(vt)),
                    "", 1, 1, 1, 5);
            }
        }
        mq_ki8868 = mq_ki8868 + 1;
        c = -1;
    }
}

pub fn check_decl(d: i64) void {
    if (base.node_kind((d as u64)) == "FuncDecl") {
        // Device 入口 `kernel fn`：设备体不在 host 阶段做类型检查（设备安全子集属 M4 未来工作，
        // 见 docs/compiler/device-design.md §8）；host 双后端跳过发射、codegen_dev 直接消费 AST。
        if (base.node_bf((d as u64)) == true) { return; }   // S4 §0.14.7 SoA：原 `n.bf`
        if (func_is_generic(d)) { return; }
        check_func_decl(d);
        return;
    }
    if (base.node_kind((d as u64)) == "StructDecl") {
        check_struct_decl(d);
        return;
    }
    if (base.node_kind((d as u64)) == "EnumDecl") {
        check_enum_decl(d);
        return;
    }
    if (base.node_kind((d as u64)) == "GlobalVarDecl") {
        check_global_var_decl(d);
        return;
    }
    if (base.node_kind((d as u64)) == "GlobalConstDecl") {
        check_global_const_decl(d);
        return;
    }
    // 注：ImportModDecl 节点已在 resolve_modules（run_check 入口）内联解析时
    // 被整体移除，故此处不会再遇到；若残留（理论上不会）将由下方通用分支兜底。
}

// 模块级全局变量（HIR 消费路径与 CST 路径共用）
pub fn check_global_var_decl(d: i64) void {
    // T-CLA-E724 的第二道闸门（全局）：clause 只活在编译期，不得占全局 var 存储。
    if (base.node_na((d as u64)) >= 0) {
        var gt0: i64 = resolve_ti(base.node_na((d as u64)));
        if (clause_ti_involves(gt0)) {
            parse.fc_err("T-CLA-E724",
                base.sb_cat3("clause 值不能声明为全局运行期变量 `", base.node_sa((d as u64)),
                    "`；clause 只活在编译期，请改用 const"), d);
            return;
        }
    }
    if (base.node_nb((d as u64)) >= 0) {
        // 模块级全局的向量字面量构造：`var g: @Vector(4,i32) = [1,2,3,4];`
        // 与局部 var_decl 同一机制，注入期望类型后由 array_lit 分支升格。
        var saved_ve6: i64 = g_vec_expect;
        var saved_te6: i64 = g_tile_expect;
        var gvt0: i64 = resolve_ti(base.node_na((d as u64)));
        if (ti_is_vector(gvt0)) { g_vec_expect = gvt0; g_tile_expect = -1; }
        else if (ti_is_tile(gvt0)) { g_tile_expect = gvt0; g_vec_expect = -1; }
        else { g_vec_expect = -1; g_tile_expect = -1; }
        var it: i64 = infer_expr(base.node_nb((d as u64)));
        g_vec_expect = saved_ve6;
        g_tile_expect = saved_te6;
        // 无类型标注的全局变量：decl 类型节点是 void/Unknown 占位（parse 阶段预填 void，
        // 并非 -1），从 RHS 推断类型并回填类型节点（与局部 var 对称）。register 阶段把
        // 符号 s.ti 固化为 void 占位，故后续引用需回退到 resolve_ti(decl.na) 取得真实类型。
        var vt: i64 = -1;
        var decl_ti: i64 = -1;
        if (base.node_na((d as u64)) >= 0) { decl_ti = resolve_ti(base.node_na((d as u64))); }
        if (base.node_na((d as u64)) < 0 or tip_kind(decl_ti) == "Void" or tip_kind(decl_ti) == "Unknown") {
            // 无标注：用 RHS 推断类型回填（若 RHS 也无类型则保持 void 占位，不误报）
            if (tip_kind(it) != "Unknown") {
                vt = it;
                var tn2: i64 = mk_type_node_from_ti(it);
                base.node_set_na((d as u64), tn2);
            } else {
                vt = decl_ti;
            }
        } else {
            vt = decl_ti; // 有标注：用声明的类型
        }
        // 同步符号表：register 阶段把未标注全局 var 的 s.ti 固化为 void 占位，
        // 此处回填真实类型，使后续引用（含 `b = a + 1`）与代码生成都拿到正确类型。
        if (vt >= 0 and tip_kind(vt) != "Unknown" and tip_kind(vt) != "Void") {
            var si3: i64 = sym_lookup(global_scope, base.node_sa((d as u64)));
            if (si3 >= 0) {
                var s3: Sym = syms[si3];
                if (s3.ti != vt) {
                    s3.ti = vt;
                    syms[si3] = s3;
                }
            }
        }
        if (tip_kind(it) != "Unknown" and tip_kind(vt) != "Unknown" and ti_equal(it, vt) == false) {
            // Sym 全局变量允许由字符串赋值（自动 intern → id）
            var gss: bool = tip_kind(vt) == "Sym" and tip_kind(it) == "String";
            if (gss == false and can_cast(it, vt) == false) {
                err_type_mismatch(base.node_nb((d as u64)), vt, it);
            }
        }
    }
}

// 模块级全局常量（HIR 消费路径与 CST 路径共用）
pub fn check_global_const_decl(d: i64) void {
    // 模块值别名：const x = @import("M") —— 登记 x → 模块 key，不按普通值做类型检查
    // （模块值不是可运算的值，只在 `.field` 接收者位被 sema 解析成 <key>__<field>）。
    if (base.node_nb((d as u64)) >= 0 and base.node_kind((base.node_nb((d as u64)) as u64)) == "import_expr") {
        // M2：const 名 → 模块完整路径身份（import_expr.sa 已是 "src.d.e"，不再取末段）。
        var mkey: string = base.node_sa((base.node_nb((d as u64)) as u64));
        g_modval_set(base.node_sa((d as u64)), mkey);
        // (A) 模块类型绑定：const X = @import("M") 同时把 X 登记为 Module(mkey) 类型，
        // 使 type_info(X) 反射 / 当 comptime 参数传成立（Zig 忠实版：@import 返回一等类型）。
        // 保留 g_modval：成员访问 X.foo 仍走 <key>__<field> 改写，与类型绑定互不冲突。
        reg_module_type_name(base.node_sa((d as u64)));
        reg_module_type_name(mkey);
        sym_define(global_scope, base.node_sa((d as u64)), "type", ti_named("Module", mkey), base.node_nb((d as u64)));
        return;
    }
    if (base.node_nb((d as u64)) >= 0) {
        // 模块级 const 的向量字面量构造（同 GlobalVarDecl）
        var saved_ve7: i64 = g_vec_expect;
        var saved_te7: i64 = g_tile_expect;
        if (base.node_na((d as u64)) >= 0) {
            var gct0: i64 = resolve_ti(base.node_na((d as u64)));
            if (ti_is_vector(gct0)) { g_vec_expect = gct0; g_tile_expect = -1; }
            else if (ti_is_tile(gct0)) { g_tile_expect = gct0; g_vec_expect = -1; }
            else { g_vec_expect = -1; g_tile_expect = -1; }
        }
        var it2: i64 = infer_expr(base.node_nb((d as u64)));
        g_vec_expect = saved_ve7;
        g_tile_expect = saved_te7;
        if (base.node_na((d as u64)) >= 0) {
            var ct: i64 = resolve_ti(base.node_na((d as u64)));
            if (tip_kind(it2) != "Unknown" and ti_equal(it2, ct) == false) {
                if (can_cast(it2, ct) == false) {
                    err_type_mismatch(base.node_nb((d as u64)), ct, it2);
                }
            }
        }
        // const 引用静态常量规则（仅对 const 声明生效；let 不受限）
        if (base.node_const(d) != 0) { check_const_ref(d); }
        // ── clause 一致性回填 ────────────────────────────────────────────
        // 未标注的全局 const 在 register 期把 s.ti 固化成 void 占位，且本函数（不像
        // check_global_var_decl）不做 RHS 回填 ⇒ 后续引用拿到 Unknown。这对 clause 的
        // 后果很具体：`const C = @clause(...)` 之后 `C` 的类型丢失，`[C, C]` 与
        // `G ++ [C]` 全部退化成 <unknown>，于是 `const C = ...` 与 `const C: clause = ...`
        // 两种写法行为不一致。
        // ⚠ 刻意**只**对 clause 回填：那个「未标注 const 不回填」是 t 既有的通用行为
        //   （`const A = [1,2]; const B: i64 = A;` 同样静默放行），泛化修复会波及全仓
        //   既有 const，代价与风险都不成比例。这里只消掉本特性遇到的不一致。
        var cd_ti: i64 = -1;
        if (base.node_na((d as u64)) >= 0) { cd_ti = resolve_ti(base.node_na((d as u64))); }
        if ((base.node_na((d as u64)) < 0 or tip_kind(cd_ti) == "Void" or tip_kind(cd_ti) == "Unknown")
            and clause_ti_involves(it2)) {
            base.node_set_na((d as u64), mk_type_node_from_ti(it2));
            var csi: i64 = sym_lookup(global_scope, base.node_sa((d as u64)));
            if (csi >= 0) {
                var csy: Sym = syms[csi];
                csy.ti = it2;
                slice_set(syms, csi, csy);
            }
        }
    }
}

// ── Stage B：按 HIR 指令分派的声明检查 ──────────────────────────
// 入口是 HIR decl 指令（而非 CST 节点 kind）：decl 工作集、检查顺序全部由
// g_hir.decls 决定；语义动作仍落到源节点（hir_inst_node）。
pub fn check_decl_hir(di: i64) void {
    var d: i64 = hir.hir_inst_node(di);
    if (d < 0) { return; }
    var op: i64 = hir.hir_op_of(di);
    if (op == hir.HIR_OP_RAW) { check_decl(d); return; }
    if (op == hir.HIR_OP_FN_DECL) {
        // Device 入口 `kernel fn`：设备体不在 host 阶段做类型检查。
        if (base.node_bf((d as u64)) == true) { return; }   // S4 §0.14.7 SoA：原 `n.bf`
        if (func_is_generic(d)) { return; }
        check_func_decl_hir(di);
        return;
    }
    if (op == hir.HIR_OP_STRUCT_DECL) { check_struct_decl(d); return; }
    if (op == hir.HIR_OP_ENUM_DECL) { check_enum_decl(d); return; }
    if (op == hir.HIR_OP_GLOBAL_DECL) {
        var k: string = base.node_kind((d as u64));
        if (k == "GlobalVarDecl") { check_global_var_decl(d); return; }
        if (k == "GlobalConstDecl") { check_global_const_decl(d); return; }
        return;
    }
    // 其余（import / module / type_alias / union / variant / const_decl）：
    // 与 check_decl 的兜底一致 —— 声明期无动作。
}

// HIR decl 指令是否属于「纯类型声明」第一趟（彼此无依赖，可先登记名字）。
pub fn hir_decl_is_type_op(op: i64) bool {
    if (op == hir.HIR_OP_STRUCT_DECL) { return true; }
    if (op == hir.HIR_OP_ENUM_DECL) { return true; }
    if (op == hir.HIR_OP_UNION_DECL) { return true; }
    if (op == hir.HIR_OP_VARIANT_DECL) { return true; }
    return false;
}

// ── §7.2 CTFE 导入脱糖（M27）──────────────────────────────────
// 在 register_decl 全部完成后、check_decl 之前执行。
// 检测 var x: []Struct = import_csv("path") / import_json("path") →
// 编译期读文件 → 解析 → 值域校验 → 合成 __import_N 加载函数 → 替换 init。
// 残存调用报 T_IMPORT_CONTEXT。

pub var g_imp_counter: i64;

// 从切片类型节点提取元素 struct 名。na 指向 slice 节点（na=named），返回 struct 名或 ""。
pub fn import_elem_struct_name(type_node: i64) string {
    if (type_node < 0) { return ""; }
    if (base.node_kind((type_node as u64)) != "slice") { return ""; }
    if (base.node_na((type_node as u64)) < 0) { return ""; }
    if (base.node_kind((base.node_na((type_node as u64)) as u64)) == "named") { return base.node_sa((base.node_na((type_node as u64)) as u64)); }
    return "";
}

// 从 struct 名查找 StructDecl，返回其字段链表头（n.lb）或 -1。
pub fn find_struct_fields(sname: string) i64 {
    var si: i64 = sym_lookup(global_scope, sname);
    if (si < 0) { return -1; }
    var s: Sym = syms[si];
    if (s.decl < 0) { return -1; }
    if (base.node_kind((s.decl as u64)) != "StructDecl") { return -1; }
    return base.node_lb((s.decl as u64));
}

// 取 struct 第 idx 个字段名（0-based）；越界返回 ""。供位置式模式 `.{a,b}` 按列表下标解构（#4 §8.2）。
pub fn struct_field_name_at(sname: string, idx: i64) string {
    var fh: i64 = sema.find_struct_fields(sname);
    if (fh < 0) { return ""; }
    var c: i64 = fh;
    var i: i64 = 0;
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环
    var ks9033: []i64 = base.kids_chain(c);
    var ki9033: i64 = 0;
    while (ki9033 < slice_len(ks9033) as i64) {
        var kv9033: i64 = ks9033[ki9033];
        if (i == idx) { return base.node_sa((kv9033 as u64)); }
        i = i + 1;
        ki9033 = ki9033 + 1;
    }
    return "";
}

// 从字段链表收集 (字段名, 标量类型名) 对。结果写入全局 imp_fnames/imp_ftypes。
// 注意：t 的 slice 是值传递，无法用 out 参数，故用全局。
pub var imp_fnames: []string;
pub var imp_ftypes: []string;
// 当前正在处理的 import 的字段表起始下标（调用 collect_struct_fields 前记录）
pub var imp_fbase: i64;
// JSON 解析临时键值表（同样因 slice 值传递限制而用全局）
pub var jp_keys: []string;
pub var jp_vals: []string;

// 返回值：字段数。字段写入 imp_fnames/imp_ftypes 的尾部，
// 起始下标由调用方在调用前用 slice_len 记录（同 fr_resolve_flag 的 base 手法）。
pub fn collect_struct_fields(field_head: i64) i64 {
    var count: i64 = 0;
    var c: i64 = field_head;
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环
    var ks9056: []i64 = base.kids_chain(c);
    var ki9056: i64 = 0;
    while (ki9056 < slice_len(ks9056) as i64) {
        var kv9056: i64 = ks9056[ki9056];
        var fname: string = base.node_sa((kv9056 as u64));
        var tname: string = "";
        if (base.node_na((kv9056 as u64)) >= 0) {
            if (base.node_kind((base.node_na((kv9056 as u64)) as u64)) == "scalar") {
                tname = base.node_sa((base.node_na((kv9056 as u64)) as u64));
            }
        }
        append(imp_fnames, fname);
        append(imp_ftypes, tname);
        count = count + 1;
        ki9056 = ki9056 + 1;
    }
    return count;
}

// 校验单个值是否可赋给标量类型。返回 true=ok。
pub fn validate_scalar_value(val: string, tname: string, row_idx: i64, col_idx: i64) bool {
    if (tname == "string") { return true; }
    if (tname == "bool") {
        if (val == "true" or val == "false") { return true; }
        return false;
    }
    if (is_int_name(tname)) {
        // 简单检查：首字符可选负号，其余全数字
        var L: u64 = str_len(val);
        if (L == 0) { return false; }
        var start: u64 = 0;
        var c0: u8 = val[0];
        if (c0 == 45) { start = 1; }
        if (start >= L) { return false; }
        var i: u64 = start;
        while (i < L) {
            var ch: u8 = val[i];
            if (ch < 48 or ch > 57) { return false; }
            i = i + 1;
        }
        return true;
    }
    if (is_float_name(tname)) {
        // 简单检查：包含 . 或 e/E，或纯数字
        var L2: u64 = str_len(val);
        if (L2 == 0) { return false; }
        var has_dot: bool = false;
        var has_digit: bool = false;
        var i2: u64 = 0;
        if (val[0] == 45) { i2 = 1; }
        while (i2 < L2) {
            var ch2: u8 = val[i2];
            if (ch2 >= 48 and ch2 <= 57) { has_digit = true; }
            if (ch2 == 46) { has_dot = true; }
            i2 = i2 + 1;
        }
        if (has_digit == false) { return false; }
        return true;
    }
    return false;
}

// 为单个值合成标量字面量 AST 节点（int/float/bool/string + cast）
pub fn make_value_node(val: string, tname: string) i64 {
    if (tname == "string") {
        return base.mk_string(val, -1);
    }
    if (tname == "bool") {
        if (val == "true") { return base.mk_bool(true, -1); }
        return base.mk_bool(false, -1);
    }
    if (is_int_name(tname)) {
        var inode: i64 = base.mk_int(val, 10, -1);
        var target: i64 = base.mk_scalar(tname, -1);
        return base.mk_cast(inode, target, -1);
    }
    if (is_float_name(tname)) {
        var fnode: i64 = base.mk_float(val, -1);
        var target2: i64 = base.mk_scalar(tname, -1);
        return base.mk_cast(fnode, target2, -1);
    }
    return base.mk_string(val, -1);
}

// CSV 解析：返回行数组，每行是列数组。简单实现：逗号分隔，双引号转义。
// 输出写入 out_rows（每行用 \x1f 分隔列）。
pub fn csv_parse(content: string) []string {
    var rows: []string;
    var sb: StringBuilder = sb_new();
    var in_quotes: bool = false;
    var row_buf: StringBuilder = sb_new();
    var col_buf: StringBuilder = sb_new();
    var L: u64 = str_len(content);
    var i: u64 = 0;
    while (i < L) {
        var ch: u8 = content[i];
        if (in_quotes) {
            if (ch == 34) {
                if (i + 1 < L and content[i + 1] == 34) {
                    sb_append_char(col_buf, 34);
                    i = i + 2;
                    continue;
                }
                in_quotes = false;
                i = i + 1;
                continue;
            }
            sb_append_char(col_buf, ch);
            i = i + 1;
            continue;
        }
        if (ch == 34) {
            in_quotes = true;
            i = i + 1;
            continue;
        }
        if (ch == 44) {
            // 逗号 → 列分隔
            sb_append_str(row_buf, sb_to_str(col_buf));
            sb_append_char(row_buf, 31);
            col_buf = sb_new();
            i = i + 1;
            continue;
        }
        if (ch == 10) {
            // 换行 → 行结束
            sb_append_str(row_buf, sb_to_str(col_buf));
            append(rows, sb_to_str(row_buf));
            row_buf = sb_new();
            col_buf = sb_new();
            i = i + 1;
            continue;
        }
        if (ch == 13) {
            // CR → 跳过
            i = i + 1;
            continue;
        }
        sb_append_char(col_buf, ch);
        i = i + 1;
    }
    // 尾行
    if (str_len(sb_to_str(col_buf)) > 0 or str_len(sb_to_str(row_buf)) > 0) {
        sb_append_str(row_buf, sb_to_str(col_buf));
        append(rows, sb_to_str(row_buf));
    }
    return rows;
}

// 从 CSV 行中提取第 col 列的值（\x1f 分隔）
pub fn csv_col(row: string, col: i64) string {
    var idx: i64 = 0;
    var sb2: StringBuilder = sb_new();
    var L: u64 = str_len(row);
    var i: u64 = 0;
    while (i < L) {
        var ch: u8 = row[i];
        if (ch == 31) {
            if (idx == col) {
                return sb_to_str(sb2);
            }
            idx = idx + 1;
            sb2 = sb_new();
            i = i + 1;
            continue;
        }
        sb_append_char(sb2, ch);
        i = i + 1;
    }
    if (idx == col) {
        return sb_to_str(sb2);
    }
    return "";
}

// JSON 解析：期望顶层是对象数组 [ {..}, {..} ]。
// 按 imp_fnames[imp_fbase .. imp_fbase+num_fields) 的字段序，把每个对象
// 归一化成与 CSV 相同的 \x1f 分隔行，从而复用后续的值域校验与合成逻辑。
// 缺失的键归一化为空串（后续值域校验会报 T_IMPORT_VALUE）。
// 返回行数组；解析失败返回空数组。
pub fn json_parse(content: string, num_fields: i64) []string {
    var rows: []string;
    var L: u64 = str_len(content);
    var i: u64 = 0;

    // 跳到第一个 '['
    while (i < L and content[i] != 91) { i = i + 1; }
    if (i >= L) { return rows; }
    i = i + 1;

    while (i < L) {
        // 跳空白与逗号
        while (i < L) {
            var c0: u8 = content[i];
            if (c0 == 32 or c0 == 9 or c0 == 10 or c0 == 13 or c0 == 44) {
                i = i + 1;
                continue;
            }
            break;
        }
        if (i >= L) { break; }
        if (content[i] == 93) { break; }
        if (content[i] != 123) { return rows; }
        i = i + 1;

        // 收集本对象的键值对到临时并列表
        var kbase: i64 = slice_len(jp_keys) as i64;
        while (i < L) {
            // 跳空白与逗号
            while (i < L) {
                var c1: u8 = content[i];
                if (c1 == 32 or c1 == 9 or c1 == 10 or c1 == 13 or c1 == 44) {
                    i = i + 1;
                    continue;
                }
                break;
            }
            if (i >= L) { break; }
            if (content[i] == 125) { i = i + 1; break; }
            if (content[i] != 34) { return rows; }

            // 读键
            i = i + 1;
            var kb: StringBuilder = sb_new();
            while (i < L and content[i] != 34) {
                sb_append_char(kb, content[i]);
                i = i + 1;
            }
            i = i + 1;

            // 跳到冒号
            while (i < L and content[i] != 58) { i = i + 1; }
            i = i + 1;
            while (i < L) {
                var c2: u8 = content[i];
                if (c2 == 32 or c2 == 9 or c2 == 10 or c2 == 13) {
                    i = i + 1;
                    continue;
                }
                break;
            }
            if (i >= L) { break; }

            // 读值：字符串带引号，其余读到分隔符
            var vb: StringBuilder = sb_new();
            if (content[i] == 34) {
                i = i + 1;
                while (i < L and content[i] != 34) {
                    if (content[i] == 92 and i + 1 < L) {
                        i = i + 1;
                        var esc: u8 = content[i];
                        if (esc == 110) { sb_append_char(vb, 10); }
                        if (esc == 116) { sb_append_char(vb, 9); }
                        if (esc == 114) { sb_append_char(vb, 13); }
                        if (esc == 34) { sb_append_char(vb, 34); }
                        if (esc == 92) { sb_append_char(vb, 92); }
                        i = i + 1;
                        continue;
                    }
                    sb_append_char(vb, content[i]);
                    i = i + 1;
                }
                i = i + 1;
            } else {
                while (i < L) {
                    var c3: u8 = content[i];
                    if (c3 == 44 or c3 == 125 or c3 == 32 or c3 == 9 or c3 == 10 or c3 == 13) {
                        break;
                    }
                    sb_append_char(vb, c3);
                    i = i + 1;
                }
            }
            append(jp_keys, sb_to_str(kb));
            append(jp_vals, sb_to_str(vb));
        }

        // 按字段序拼成 \x1f 行
        var kn: i64 = slice_len(jp_keys) as i64;
        var rb: StringBuilder = sb_new();
        var fi: i64 = 0;
        while (fi < num_fields) {
            if (fi > 0) { sb_append_char(rb, 31); }
            var want: string = imp_fnames[(imp_fbase + fi) as u64];
            var ki: i64 = kbase;
            while (ki < kn) {
                if (jp_keys[ki as u64] == want) {
                    sb_append_str(rb, jp_vals[ki as u64]);
                    ki = kn;
                    continue;
                }
                ki = ki + 1;
            }
            fi = fi + 1;
        }
        append(rows, sb_to_str(rb));
    }
    return rows;
}

// 合成 __import_N 加载函数并返回其节点索引。
// 形态: __import_N fn() []StructName {
//   var __r: []StructName;
//   var __imp_r0: StructName = StructName{ f1: val1, f2: val2, ... };
//   append(__r, __imp_r0);
//   ...
//   return __r;
// }
pub fn synthesize_loader(sname: string, rows: []string, header_row: string, num_fields: i64, is_csv: bool) i64 {
    var fn_name: string = base.sb_cat2("__import_", base.i2s(g_imp_counter));
    g_imp_counter = g_imp_counter + 1;

    // 返回类型: []StructName
    var elem_named: i64 = base.mk_named(sname, -1);
    var ret_slice: i64 = base.mk_slice(elem_named, -1);

    // 函数体语句链表
    var body_head: i64 = -1;
    var body_tail: i64 = -1;

    // var __r: []StructName;
    var r_type: i64 = base.mk_slice(base.mk_named(sname, -1), -1);
    var r_decl: i64 = base.mk_var_decl("__r", false, r_type, -1, -1);
    body_tail = base.list_push(body_head, body_tail, r_decl);
    if (body_head < 0) { body_head = body_tail; }

    // CSV: header_row 是第一行，用于字段名映射
    // JSON: rows 直接是对象数组，field_names 已固定
    var nrows: i64 = slice_len(rows) as i64;
    var ri: i64 = 0;
    if (is_csv) {
        ri = 1; // 跳过表头
    }
    while (ri < nrows) {
        var row: string = rows[ri];
        // 构建 struct_lit 的字段链表
        var fv_head: i64 = -1;
        var fv_tail: i64 = -1;
        var ci: i64 = 0;
        while (ci < num_fields) {
            var fname: string = imp_fnames[(imp_fbase + ci) as u64];
            var ftype: string = imp_ftypes[(imp_fbase + ci) as u64];
            var col_val: string;
            if (is_csv) {
                // 根据 header_row 中的列名映射
                col_val = csv_col(row, ci);
            } else {
                col_val = csv_col(row, ci);
            }
            var vnode: i64 = make_value_node(col_val, ftype);
            var fv: i64 = base.mk_FV(fname, vnode, -1);
            fv_tail = base.list_push(fv_head, fv_tail, fv);
            if (fv_head < 0) { fv_head = fv_tail; }
            ci = ci + 1;
        }
        var lit: i64 = base.mk_struct_lit(sname, fv_head, -1);
        var tmp_name: string = base.sb_cat2("__imp_r", base.i2s(ri));
        var tmp_decl: i64 = base.mk_var_decl(tmp_name, false, base.mk_named(sname, -1), lit, -1);
        body_tail = base.list_push(body_head, body_tail, tmp_decl);
        if (body_head < 0) { body_head = body_tail; }

        // append(__r, __imp_r0);
        var call_args_head: i64 = -1;
        var call_args_tail: i64 = -1;
        call_args_tail = base.list_push(call_args_head, call_args_tail, base.mk_ident("__r", -1));
        if (call_args_head < 0) { call_args_head = call_args_tail; }
        call_args_tail = base.list_push(call_args_head, call_args_tail, base.mk_ident(tmp_name, -1));
        if (call_args_head < 0) { call_args_head = call_args_tail; }
        var append_call: i64 = base.mk_call(base.mk_ident("append", -1), call_args_head, -1);
        var append_stmt: i64 = base.mk_expr(append_call, -1);
        body_tail = base.list_push(body_head, body_tail, append_stmt);
        if (body_head < 0) { body_head = body_tail; }

        ri = ri + 1;
    }

    // return __r;
    var ret_stmt: i64 = base.mk_return(base.mk_ident("__r", -1), -1);
    body_tail = base.list_push(body_head, body_tail, ret_stmt);
    if (body_head < 0) { body_head = body_tail; }

    // ba=is_extern 必须为 false，否则 emitter 只发 declare 不发函数体；
    // lb=参数列表用 -2 表示空（-1 会被当作 null 链表头处理）
    var fdecl: i64 = base.mk_FuncDecl(fn_name, false, false, ret_slice, -1, -1, body_head, -1);
    // 注册符号
    sym_define(global_scope, fn_name, "func", ti_named("Func", fn_name), fdecl);
    // 加入 decl_list，使 emitter 能发射该合成函数。
    // 注意：desugar_imports 在 register 循环之后、check 循环之前运行，
    // check 循环用 slice_len(decl_list) 重新取长度，故新增项也会被检查。
    append(lex.decl_list, fdecl);
    return fdecl;
}

// 检测一个表达式是否是 import_csv/import_json 调用
pub fn is_import_call(expr_idx: i64) string {
    if (expr_idx < 0) { return ""; }
    if (base.node_kind((expr_idx as u64)) != "call") { return ""; }
    if (base.node_na((expr_idx as u64)) < 0) { return ""; }
    if (base.node_kind((base.node_na((expr_idx as u64)) as u64)) != "ident") { return ""; }
    if (base.node_sa((base.node_na((expr_idx as u64)) as u64)) == "import_csv") { return "csv"; }
    if (base.node_sa((base.node_na((expr_idx as u64)) as u64)) == "import_json") { return "json"; }
    return "";
}

// 从 import call 节点提取路径参数字符串
pub fn import_path_arg(call_idx: i64) string {
    var c: i64 = base.node_la((call_idx as u64));
    if (c < 0) { return ""; }
    var k: Child = base.kids[c];
    if (base.node_kind((k.val as u64)) == "string") { return base.node_sa((k.val as u64)); }
    return "";
}

// 对单个 var_decl 执行脱糖。成功返回 true。
pub fn desugar_one(var_idx: i64, file_for_diag: string, ln: i64, cl: i64) bool {
    var imp_kind: string = is_import_call(base.node_nb((var_idx as u64)));
    if (imp_kind == "") { return false; }

    // 提取目标类型: []StructName
    var sname: string = import_elem_struct_name(base.node_na((var_idx as u64)));
    if (sname == "") {
        base.diag_new("T-MOD-E555", "error",
            "import_csv/import_json requires target type []StructName",
            file_for_diag, ln, cl, ln, cl + 20);
        return false;
    }

    // 查找 struct 字段
    var field_head: i64 = find_struct_fields(sname);
    if (field_head < 0) {
        base.diag_new("T-MOD-E555", "error",
            base.sb_cat3("struct '", sname, "' not found for import"),
            file_for_diag, ln, cl, ln, cl + 20);
        return false;
    }

    imp_fbase = slice_len(imp_fnames) as i64;
    var num_fields: i64 = collect_struct_fields(field_head);

    // 提取路径参数
    var path: string = import_path_arg(base.node_nb((var_idx as u64)));
    if (path == "") {
        base.diag_new("T-MOD-E555", "error",
            "import_csv/import_json requires a string literal path argument",
            file_for_diag, ln, cl, ln, cl + 20);
        return false;
    }

    // 解析路径（相对源文件目录）
    var dir: string = "";
    var slash: i64 = -1;
    var pl: u64 = str_len(base.g_file);
    var pi: u64 = 0;
    while (pi < pl) {
        var ch: u8 = base.g_file[pi];
        if (ch == 47 or ch == 92) { slash = pi as i64; }
        pi = pi + 1;
    }
    if (slash >= 0) {
        dir = str_slice(base.g_file, 0, slash + 1);
    }
    var full_path: string = base.sb_cat2(dir, path);

    // 存在性检查
    if (file_exists(full_path) == false) {
        base.diag_new("T-MOD-E552", "error",
            base.sb_cat3("import: file not found: ", full_path, ""),
            file_for_diag, ln, cl, ln, cl + 20);
        return false;
    }

    // 读文件
    var content: string = file_read_all(full_path);

    // 解析
    var rows: []string;
    var is_csv: bool;
    if (imp_kind == "csv") {
        // CSV 首行是表头，后续按 is_csv 跳过
        is_csv = true;
        rows = csv_parse(content);
    } else {
        // JSON 已按字段序归一化，无表头行
        is_csv = false;
        rows = json_parse(content, num_fields);
    }

    if (slice_len(rows) as i64 == 0) {
        base.diag_new("T-MOD-E552", "error",
            base.sb_cat3("import: file is empty: ", full_path, ""),
            file_for_diag, ln, cl, ln, cl + 20);
        return false;
    }

    // CSV: 验证表头
    if (imp_kind == "csv") {
        var header: string = rows[0];
        var hi: i64 = 0;
        while (hi < num_fields) {
            var hval: string = csv_col(header, hi);
            if (hval != imp_fnames[(imp_fbase + hi) as u64]) {
                base.diag_new("T-MOD-E553", "error",
                    base.sb_cat5("CSV header column ", base.i2s(hi), ": expected '", imp_fnames[(imp_fbase + hi) as u64], "'"),
                    file_for_diag, ln, cl, ln, cl + 20);
                return false;
            }
            hi = hi + 1;
        }
    }

    // 值域校验
    var nrows: i64 = slice_len(rows) as i64;
    var ri2: i64 = 0;
    if (is_csv) { ri2 = 1; }
    while (ri2 < nrows) {
        var row2: string = rows[ri2];
        var ci2: i64 = 0;
        while (ci2 < num_fields) {
            var val2: string = csv_col(row2, ci2);
            var ftype2: string = imp_ftypes[(imp_fbase + ci2) as u64];
            if (validate_scalar_value(val2, ftype2, ri2, ci2) == false) {
                base.diag_new("T-MOD-E554", "error",
                    base.sb_cat5("import: row ", base.i2s(ri2), " col ", base.i2s(ci2), ": invalid value for type"),
                    file_for_diag, ln, cl, ln, cl + 20);
                return false;
            }
            ci2 = ci2 + 1;
        }
        ri2 = ri2 + 1;
    }

    // 合成加载函数
    var loader_fn: i64 = synthesize_loader(sname, rows, rows[0], num_fields, is_csv);

    // 替换原 init 为对加载函数的调用
    var new_call: i64 = base.mk_call(base.mk_ident(base.sb_cat2("__import_", base.i2s(g_imp_counter - 1)), -1), -1, -1);
    base.node_set_nb((var_idx as u64), new_call);

    return true;
}

// 遍历函数体语句链表，检测 import 脱糖点
pub fn desugar_stmts(stmt_head: i64, file_for_diag: string) void {
    var c: i64 = stmt_head;
    var mq_ks9737: []i64 = base.kids_chain_idx(stmt_head);
    var mq_ki9737: i64 = 0;
    while (mq_ki9737 < slice_len(mq_ks9737) as i64) {
        c = mq_ks9737[mq_ki9737];
        var k: Child = base.kids[c];
        if (base.node_kind((k.val as u64)) == "var_decl") {
            desugar_one(k.val, file_for_diag, base.node_span_id(k.val).line, base.node_span_id(k.val).col);
        }
        // 残存的 import 调用（不在 var 初始化位置）→ T_IMPORT_CONTEXT
        if (base.node_kind((k.val as u64)) == "expr") {
            if (is_import_call(base.node_na((k.val as u64))) != "") {
                base.diag_new("T-MOD-E555", "error",
                    "import_csv/import_json is only allowed as a var initializer",
                    file_for_diag, base.node_span_id(k.val).line, base.node_span_id(k.val).col, base.node_span_id(k.val).line, base.node_span_id(k.val).col + 20);
            }
        }
        // 递归 if/while/for/block 体
        if (base.node_kind((k.val as u64)) == "if") {
            desugar_stmts(base.node_la((k.val as u64)), file_for_diag);
            if (base.node_lb((k.val as u64)) > -2) { desugar_stmts(base.node_lb((k.val as u64)), file_for_diag); }
        }
        if (base.node_kind((k.val as u64)) == "while" or base.node_kind((k.val as u64)) == "block") {
            desugar_stmts(base.node_la((k.val as u64)), file_for_diag);
        }
        if (base.node_kind((k.val as u64)) == "for") {
            desugar_stmts(base.node_la((k.val as u64)), file_for_diag);
        }
        mq_ki9737 = mq_ki9737 + 1;
        c = -1;
    }
}

pub fn desugar_imports() void {
    g_imp_counter = 0;
    var n: i64 = slice_len(lex.decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = lex.decl_list[i];
        if (base.node_kind((d as u64)) == "FuncDecl" and base.node_lc((d as u64)) != -2) {
            desugar_stmts(base.node_lc((d as u64)), parse.n_file(d));
        }
        i = i + 1;
    }
}

// ── 模块系统：whole-program 内联解析 ──────────────────────────

// 取路径的目录部分（兼容 / 与 \）
pub fn mod_dir_of(p: string) string {
    var n: u64 = str_len(p);
    var i: u64 = n;
    while (i > 0) {
        i = i - 1;
        var c: u8 = p[i];
        if (c == 47 or c == 92) {
            return str_slice(p, 0, i);
        }
    }
    return ".";
}

// 取父目录（纯字符串，不依赖 _fullpath；盘符根/无分隔符返回 "" 表示已到顶）。
// 兼容 / 与 \；先剥除末尾分隔符，避免 "C:/" 被误判；用于 import 源码根向上遍历，
// 杜绝 _fullpath 把 "C:" 展开为「C 盘当前目录」导致的 C:/ <-> C:/Users/... 震荡 OOM。
pub fn parent_dir_of(p: string) string {
    var n: u64 = str_len(p);
    if (n == 0) { return ""; }
    var end: u64 = n;
    while (end > 0) {
        var c: u8 = p[end - 1];
        if (c == 47 or c == 92) { end = end - 1; } else { break; }
    }
    if (end == 0) { return ""; }
    var i: u64 = end;
    while (i > 0) {
        i = i - 1;
        var c: u8 = p[i];
        if (c == 47 or c == 92) {
            if (i == 0) { return ""; }   // 形如 /foo 的 unix 绝对路径，无更上层
            return str_slice(p, 0, i);
        }
    }
    return "";   // 无分隔符（如 C: 或裸名）
}

pub fn in_mod_aliases(sa: string) bool {
    var n: i64 = slice_len(lex.g_mod_aliases) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (lex.g_mod_aliases[i] == sa) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn in_mod_visited(p: string) bool {
    var n: i64 = slice_len(lex__g_mod_visited) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (lex__g_mod_visited[i] == p) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// 环检测：chosen 是否处于「正在加载」的活跃栈中（DFS 回边即循环依赖）。
pub fn mod_stack_index(p: string) i64 {
    var n: i64 = slice_len(lex__g_mod_stack) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (lex__g_mod_stack[i] == p) { return i; }
        i = i + 1;
    }
    return -1;
}

pub fn mod_stack_push(p: string, a: string) void {
    append(lex__g_mod_stack, p);
    append(lex__g_mod_stack_alias, a);
}

// 弹出切片最后一个元素（t 无原生 pop；import 深度极小，O(n) 截断可接受）。
pub fn slice_pop_str(s: []string) []string {
    var n: i64 = slice_len(s) as i64;
    var out: []string;
    var i: i64 = 0;
    while (i < n - 1) {
        append(out, s[i]);
        i = i + 1;
    }
    return out;
}

// 登记 (模块完整路径 idn → 模块路径 nm)。M2：模块身份取完整路径，末段同名模块
// （src.d.e / src.x.e）符号已天然区分（d_e__DEEP vs x_e__DEEP），不再静默合并。
// M3.3：注册表键由末段 alias 改为完整路径 idn ⇒ 末段同名模块自然不撞；
// 调用点 handle_one_import 改传 idn（见下）。
pub fn imp_alias_register(idn: string, nm: string, at: i64) void {
    var i: i64 = 0;
    var n: i64 = slice_len(g_imp_alias) as i64;
    while (i < n) {
        if (g_imp_alias[i] == idn) {
            return;   // 同完整路径（菱形同路径）只登记一次
        }
        i = i + 1;
    }
    append(g_imp_alias, idn);
    append(g_imp_path, nm);
}

pub fn mod_alias_add(nm: string, alias: string) void {
    if (alias == "") {
        if (in_mod_aliases(nm) == false) {
            append(lex__g_mod_aliases, nm);
        }
    } else {
        if (in_mod_aliases(alias) == false) {
            append(lex__g_mod_aliases, alias);
        }
    }
}

// 把模块文件解析为顶层声明，追加进 decl_list。
// 其内嵌的 import 在此就地递归解析（内联），不会以 ImportModDecl 形式残留。
// provenance：解析本模块期间把 g_cur_mod 置为模块别名，使模块内所有节点（含函数体/类型）
// 都记录所属模块，供后续名字重整（mangling）做模块内引用改写；入口模块别名 = ""。
pub fn load_module_file(path: string, alias: string) void {
    var saved_pos: i64 = lex__pos;                 // 保存调用方的 token 流位置（支持嵌套 import 透明返回）
    var saved_mod: string = base__g_cur_mod;        // 进入模块前的上下文（入口="" 或外层库别名），用于嵌套 import 正确回溯
    var saved_file: string = base.g_file;      // 进入模块前的源文件（provenance 定位用），用于正确回溯
    var base: i64 = slice_len(base__toks) as i64;   // 模块 token 将从此下标开始（tokenize 是 append 语义）
    var msrc: string = file_read_all(path);
    if (getenv("T_MEMSTATS") == "1") { eprint("LM read " + path + " sz=" + base.i2s(str_len(msrc))); dbg_report_mem(); }
    lex__tokenize(msrc);                           // 追加在入口/父模块 token 之后
    if (getenv("T_MEMSTATS") == "1") { eprint("LM tok " + path); dbg_report_mem(); }
    lex__pos = base;                               // 从本模块起点解析，而非 0（否则会重解析入口文件）
    base__g_cur_mod = alias;                        // 进入模块：标记 provenance
    base.g_file = path;                        // 切到模块源文件，使节点分配时记录正确的 g_node_file
    while (lex__cur_t() != "Eof") {
        if (lex__cur_t() == "Semicolon") {
            lex__advance_i();
            continue;
        }
        var d: i64 = parse__parse_declaration();
        if (d < 0) {
            continue;
        }
        if (base.node_kind((d as u64)) == "ImportModDecl") {
            // 嵌套 import：就地递归解析，不加入 decl_list（统一相对候选源码根/搜索路径）
            handle_one_import(d, d);
        } else if (is_modval_import_decl(d)) {
            // 嵌套模块值别名（const x = @import("M")）：与嵌套 ImportModDecl 等价，
            // 就地递归加载模块 M，使 M 的符号进入 global_scope（维持旧式 :: * 的传递性）。
            modval_load(modval_module_path(d), d);
        } else {
            append(lex__decl_list, d);
        }
        // struct 方法脱糖出的自由函数同样要并入模块 decl_list（provenance 已是本模块别名）
        parse__flush_struct_methods();
    }
    base__g_cur_mod = saved_mod;                    // 离开模块：恢复调用方上下文（支持库内嵌套 import 正确回溯）
    base.g_file = saved_file;                  // 恢复调用方源文件
    lex__pos = saved_pos;                          // 恢复调用方（入口或父模块）的解析位置
    if (getenv("T_MEMSTATS") == "1") { eprint("LM done " + path); dbg_report_mem(); }
}

// 登记一条 import 声明上挂着的 `::` 选择性导入项（含通配 `*`）。
// owner 取该 import 节点的 provenance —— 入口为 ""，库内嵌套 import 为该库别名，
// 因此选择性绑定严格局限在「写下这条 import 的那个模块」内，不会外泄。
pub fn sel_register(imp: i64, alias: string) void {
    var owner: string = base.node_mod(imp);
    var c: i64 = base.node_lb((imp as u64));
    var mq_ks9929: []i64 = base.kids_chain_idx(base.node_lb((imp as u64)));
    var mq_ki9929: i64 = 0;
    while (mq_ki9929 < slice_len(mq_ks9929) as i64) {
        c = mq_ks9929[mq_ki9929];
        var k: Child = base__kids[c];
        append(lex__g_sel_owner, owner);
        append(lex__g_sel_local, base.node_sb((k.val as u64)));
        append(lex__g_sel_mod, alias);
        append(lex__g_sel_orig, base.node_sa((k.val as u64)));
        append(lex__g_sel_wild, base.node_ba((k.val as u64)));
        append(lex__g_sel_at, k.val);
        // M2：通配项（node_ba=true，如 `:: *` / `const X = @import("M")` 的兼容通配）记 from_wild。
        append(lex__g_sel_from_wild, base.node_ba((k.val as u64)));
        mq_ki9929 = mq_ki9929 + 1;
        c = -1;
    }
}

// 解析单个 import 声明：定位模块文件 → 去重/环检测 → 内联加载
pub fn handle_one_import(imp: i64, at: i64) void {
    var nm: string = base.node_sb((imp as u64));
    var user_alias: string = base__node_sc((imp as u64));   // S4 §0.14.7 SoA：侧表读（原 nodes[imp].sc）
    // 模块重导出（M-Reexport）：`pub @import(...)` / `export import(...)` 允许 import 声明
    // 带导出修饰——被导入模块的 pub 符号在本模块再导出（见 collect_module_defs）。
    // 旧 `export import` 不再报错；`export` 修饰局部/嵌套变量仍报 T-MOD-E556（parse.tc）。
    // `import(src)` / `import(src.)`：剥离首段后为空路径。
    if (nm == "") {
        parse__fc_err("T-MOD-E559",
            "import 路径为空：`src` 后需给出模块名，如 `import(src.foo);`", imp);
        return;
    }
    // 限定访问前缀 = 模块名最后一段（Go 风格）：import(src.d.e) 以 e.foo() 调用；
    // 用户显式 as 优先。该别名同时是名字重整（mangling）的命名空间。
    var alias: string = user_alias;
    if (alias == "") { alias = last_segment(nm); }
    // M2：模块身份（g_cur_mod / 重整命名空间 / def 表键）取**完整路径**。
    // 解析器对 src 导入剥离了首段 "src."（ImportModDecl.sb=rest），故此处重建：
    // src 导入 idn = "src." + rest；库导入（bd=true）nm 已是完整路径（"repl"/"std.math"）。
    var idn: string = nm;
    if (base.node_bd((imp as u64)) == false) { idn = "src." + nm; }
    // M2 碰撞感知重整：登记已加载模块完整路径（去重），供 mangled_name 判同末段冲突。
    var mfp_seen: bool = false;
    var mfp_n: i64 = slice_len(g_mod_fullpaths) as i64;
    var mfp_i: i64 = 0;
    while (mfp_i < mfp_n) {
        if (g_mod_fullpaths[mfp_i] == idn) { mfp_seen = true; mfp_i = mfp_n; }
        else { mfp_i = mfp_i + 1; }
    }
    if (mfp_seen == false) { append(g_mod_fullpaths, idn); }
    mod_alias_add(nm, alias);
    alias_full_register(alias, idn);
    // M1.2：同一别名已被**另一个**模块路径占用 ⇒ 静默合并，明确报错（详见 g_imp_alias 注释）。
    // M3.3：注册表键改为完整路径 idn ⇒ 末段同名模块（src.d.e / src.x.e）自然不撞。
    imp_alias_register(idn, nm, at);
    // 模块重导出（M-Reexport）：`pub @import(...)` / `export import(...)` 把被导入模块 M 的
    // pub 符号在本模块（g_cur_mod）再导出。登记到 g_reexport_*，待 collect_module_defs
    // 把所有模块符号收齐后，把 M 的 pub 符号并入本模块符号集，使下游 `本模块.符号` 可达。
    // g_cur_mod 在 load_module_file 进入模块时已置为该库别名，入口模块为 ""。
    if (base__node_bc((imp as u64))) {   // S4 §0.14.7 SoA：侧表读（原 nodes[imp].bc）
        append(lex__g_reexport_owner, base__g_cur_mod);
        append(lex__g_reexport_imp, idn);
    }

    // 库导入（路径首段非 src）：走库搜索路径（入口/lib、工程根/lib、out/lib 预编译缓存），
    // 命中 .tc 源码则内联（名字重整后即为命名空间隔离）；若同时命中 .tlib 预编译产物则走外链模式。
    var chosen: string = "";
    // 阶段 B/C（§5.3 多进程 bootstrap，2026-10-24）：rel = nm 的路径形式（"base" / "std/rc/cst"）；
    // tint_dir = T_TINT_DIR 环境变量；loaded_tint 标记本依赖是否经接口文件（.tint）外链加载。
    var rel: string = dots_to_slashes(nm);
    var tint_dir: string = getenv("T_TINT_DIR");
    var loaded_tint: bool = false;
    if (base.node_bd((imp as u64))) {   // S4 §0.14.7 SoA：原 `base__nodes[imp].bd`
        chosen = resolve_external_lib(nm);
        if (chosen == "") {
            parse__fc_err("T-MOD-E550",
                base__sb_cat3("库 '", nm, "' 无法解析：未在本工程 lib/ 或依赖库搜索路径下找到对应 .tc 文件"), imp);
            return;
        }
    } else {
        // `src.` 导入统一相对候选源码根解析；'.' 即路径分隔符：import(src.d.e) => <root>/src/d/e.tc
        // 阶段 B 接口文件外链：若 T_TINT_DIR 已设且 <dir>/<rel>.tint 存在，则按「接口文件」加载
        // （仅 pub 签名+类型定义，不含实现），使导入方进程不再建被依赖模块的语义图 → 自举峰值有界。
        // 默认（未设 T_TINT_DIR）= 走原 .tc 源码，行为与旧版逐字节一致；故对既有单进程自举零影响。
        if (str_len(tint_dir) > 0) {
            var tcand: string = path_resolve(base__sb_cat4(tint_dir, "/", rel, ".tint"));
            if (path_exists(tcand)) { chosen = tcand; loaded_tint = true; }
        }
        // T_TINT_DIR 已设且接口文件命中 → 优先用接口文件（不回退 .tc）；
        // 否则回退到 .tc 源码供类型检查（兼容无接口文件的模块）。
        if (chosen == "") {
            var i: i64 = 0;
            var nr: i64 = slice_len(g_src_roots) as i64;
            while (i < nr) {
                var cand: string = path_resolve(base__sb_cat4(g_src_roots[i], "/", rel, ".tc"));
                if (path_exists(cand)) { chosen = cand; break; }
                i = i + 1;
            }
        }
        if (chosen == "") {
            parse__fc_err("T-MOD-E550",
                base__sb_cat3("模块 'src.", nm, "' 无法解析：未在本工程 lib/ 或依赖库搜索路径下找到对应 .tc 文件"), imp);
            return;
        }
    }
    // 选择性导入（`:: a, b as c` / `:: *`）登记。必须在钻石去重 return 之前：
    // 同一模块被多处导入时，每个导入点的 `::` 绑定都要生效。
    // M2：g_sel_mod 记完整路径身份（供 Pass 3 mangled_name / def_lookup / reexport 一致）。
    sel_register(imp, idn);
    // 把模块别名登记为「模块值」，使 `X.sym` 限定成员访问（见 infer_expr 的模块值分支）
    // 在声明式 import（含选择性 `:: sel`）下也能解析到 `<X>__<sym>`。const 形式的模块值
    // 在 resolve 处已 g_modval_set；此处补齐声明式路径，二者幂等（g_modval_get 取首个）。
    // M2：g_modval 键须为完整路径身份 idn（源码写末段别名 X，infer 经 g_modval_get 得 idn）。
    if (str_len(g_modval_get(alias)) as i64 == 0) { g_modval_set(alias, idn); }
    // 环检测：chosen 已在活跃加载栈 → 循环依赖（import 不能成环）。
    var ci: i64 = mod_stack_index(chosen);
    if (ci >= 0) {
        var csb: StringBuilder = sb_new();
        var k: i64 = 0;
        var m: i64 = slice_len(lex__g_mod_stack) as i64;
        while (k < m) {
            if (k > 0) { sb_append_str(csb, " -> "); }
            sb_append_str(csb, lex__g_mod_stack_alias[k]);
            k = k + 1;
        }
        sb_append_str(csb, " -> ");
        sb_append_str(csb, alias);
        parse__fc_err("T-MOD-E551",
            base__sb_cat3("检测到循环依赖：", sb_to_str(csb),
                "（import 不能成环，请抽公共模块或改用运行时依赖注入）"), imp);
        return;
    }
    // 链接模式探测：存在 .tlib 预编译产物且未用 as 别名（归档按规范名构建，as 别名会错配）→ 外链。
    // 库源码仍载入供类型检查，但导出符号改发 declare、私有跳过，归档在链接期并入（真·独立编译+链接）。
    var ar: string = "";
    if (user_alias == "" and in_mod_visited(chosen) == false) {
        if (base.node_bd((imp as u64))) {
            ar = resolve_external_lib_archive(nm);
        } else if (loaded_tint) {
            // 内部模块经接口文件（.tint）外链加载：若同目录存在预编译 .tlib（编排层逐模块 build --lib 产出），
            // 则走链接模式——本模块 codegen 该依赖发 declare，真实定义在 .tlib，链接期并入（§5.3 多进程 bootstrap）。
            ar = resolve_internal_lib_archive(rel, tint_dir);
        }
    }
    // 记录依赖图边（父 -> 子），供 --emit-deps 输出（父 = 当前活跃栈顶）。
    // 放在钻石去重 return 之前：重导入（如菱形共享根）也需记录边，否则依赖图缺失。
    var dep_parent: string = "<entry>";
    var dep_stn: i64 = slice_len(lex__g_mod_stack_alias) as i64;
    if (dep_stn > 0) { dep_parent = lex__g_mod_stack_alias[dep_stn - 1]; }
    append(lex__g_dep_from, dep_parent);
    append(lex__g_dep_to, alias);
    // 钻石依赖：已完整加载过则跳过（不报错，避免重复定义）。
    if (in_mod_visited(chosen)) {
        return;
    }
    append(lex__g_mod_visited, chosen);
    mod_stack_push(chosen, alias);            // 进入：压栈（alias 仅作环显示用）
    mod_attr_add(idn, base.node_bd((imp as u64)));       // 登记：bd=true ⇒ 来自库（跨包）；键用完整路径身份 idn
    load_module_file(chosen, idn);            // g_cur_mod = idn（完整路径身份）
    lex__g_mod_stack = slice_pop_str(lex__g_mod_stack);          // 离开：弹栈
    lex__g_mod_stack_alias = slice_pop_str(lex__g_mod_stack_alias);
    if (ar != "") {
        // 存完整路径身份 idn（如 "src.base"）：与 in_link_libs(base.node_mod(d))（节点 provenance = idn）匹配，
        // 使本模块 codegen 对该依赖的声明/全局发 declare、跳过内联。外部库 idn==alias（单段名）故等价。
        append(lex__g_link_libs, idn);
        append(lex__g_ext_link, ar);
    }
}

// 外部库搜索路径解析：返回命中路径（"" = 未找到）。
// 搜索顺序：工程根/lib（逐个祖先含 tote.toml 者）、入口目录自身 lib、~/.tote/libs、编译器/libs。
// 每个搜索目录下的候选：<name>.tc > <name>/index.tc > <name>/lib.tc。
// （.tlib 预编译外链在 Phase2 接入；T_LIB_PATH 环境变量亦在 Phase2 纳入。）
pub fn resolve_external_lib(nm: string) string {
    var rel: string = dots_to_slashes(nm);
    var dirs: []string = lex__g_lib_dirs;          // compute_lib_dirs 已填充
    var i: i64 = 0;
    var nd: i64 = slice_len(dirs) as i64;
    while (i < nd) {
        var base: string = dirs[i];
        var c_tc: string = path_resolve(base__sb_cat4(base, "/", rel, ".tc"));
        if (path_exists(c_tc)) { return c_tc; }
        var c_idx: string = path_resolve(base__sb_cat4(base, "/", rel, "/index.tc"));
        if (path_exists(c_idx)) { return c_idx; }
        var c_lib: string = path_resolve(base__sb_cat4(base, "/", rel, "/lib.tc"));
        if (path_exists(c_lib)) { return c_lib; }
        i = i + 1;
    }
    return "";
}

// 外部库预编译产物解析（Phase2 真·独立编译+链接）：返回 <libdir>/<rel>.tlib
// （即重命名的 LLVM 归档 .a）路径，未找到返回 ""。命中即走外链模式（不再内联源码定义）。
pub fn resolve_external_lib_archive(nm: string) string {
    var rel: string = dots_to_slashes(nm);
    var dirs: []string = lex__g_lib_dirs;
    var i: i64 = 0;
    var nd: i64 = slice_len(dirs) as i64;
    while (i < nd) {
        // --debug-libs：优先链接调试态归档 .tlibd（带 -O0 -gcodeview），缺失则回退 .tlib
        if (lex__g_debug_libs) {
            var ar_d: string = path_resolve(base__sb_cat4(dirs[i], "/", rel, ".tlibd"));
            if (path_exists(ar_d)) { return ar_d; }
        }
        var ar: string = path_resolve(base__sb_cat4(dirs[i], "/", rel, ".tlib"));
        if (path_exists(ar)) { return ar; }
        i = i + 1;
    }
    return "";
}

// 内部模块预编译产物解析（§5.3 多进程 bootstrap）：返回 <tint_dir>/<rel>.tlib（重命名 LLVM 归档 .a）
// 路径，未找到返回 ""。命中即走链接模式（内部模块 codegen 发 declare；真实定义在 .tlib，链接期并入）。
// 与 resolve_external_lib_archive 平行：外部库搜 g_lib_dirs，内部模块搜 T_TINT_DIR 同级（编排层把 .tlib 落在
// 接口文件同目录 out/mod/<rel>.tlib）。
pub fn resolve_internal_lib_archive(rel: string, tint_dir: string) string {
    if (str_len(tint_dir) == 0) { return ""; }
    if (lex__g_debug_libs) {
        var ar_d: string = path_resolve(base__sb_cat4(tint_dir, "/", rel, ".tlibd"));
        if (path_exists(ar_d)) { return ar_d; }
    }
    var ar: string = path_resolve(base__sb_cat4(tint_dir, "/", rel, ".tlib"));
    if (path_exists(ar)) { return ar; }
    return "";
}

// 追加一个「<base>/<sub>」搜索目录（LLVM 后端不支持 sb_cat2..6，故走 StringBuilder）。
pub fn lib_dir_push(base: string, sub: string) void {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, base);
    sb_append_str(sb, "/");
    sb_append_str(sb, sub);
    append(lex__g_lib_dirs, sb_to_str(sb));
}

// 计算外部库搜索目录（在 compute_src_roots 之后调用，复用祖先工程根信息）。
// 顺序 = 就近优先（与 node_modules 式解析一致）：
//  1) 入口目录/lib、入口目录/libs（单文件与示例就近放库）；
//  2) 各祖先含 tote.toml 的工程根 <root>/lib、<root>/libs（最近祖先优先）。
// 注：g_src_roots[0] 是「入口目录兜底」而非 <root>/src，不能对它取 parent 推工程根，
//     否则会把入口的父目录误当工程根（examples/ → 仓库根）。故从下标 1 起遍历。
// 注：环境变量 T_LIB_PATH 与 ~/.tote/libs 需要 getenv 内建支持，留待 Phase2。
pub fn compute_lib_dirs() void {
    var entry_dir: string = path_resolve(mod_dir_of(base__g_file));
    lib_dir_push(entry_dir, "lib");
    lib_dir_push(entry_dir, "libs");
    var i: i64 = 1;                             // 跳过 [0]（入口目录兜底根）
    var n: i64 = slice_len(g_src_roots) as i64;
    while (i < n) {
        var root: string = parent_dir_of(g_src_roots[i]);   // g_src_roots[i] = <root>/src
        lib_dir_push(root, "lib");
        lib_dir_push(root, "libs");
        i = i + 1;
    }
    // 预编译产物缓存目录（build --lib 把 .tlib 落在 out/lib/）：就近优先于一切源码搜索，
    // 命中即走外链模式（真·独立编译+链接）；缺失则回退源码内联（安全网，不破坏既有内联行为）。
    lib_dir_push("out", "lib");
}

// 候选源码根列表（按优先级）：入口目录兜底 + 各祖先工程根/src（最近优先）。
// import 解析时依序尝试每个候选根下的 <rel>.tc，首个命中即采用。
// 这样既满足「工程根/src」约定（用户规范），又不破坏扁平/示例项目（入口目录兜底）。
pub var g_src_roots: []string;

// ── 模块别名 → 模块路径登记表（M1.2 撞名检出）────────────────────────────
// 模块身份（= 限定前缀 = 名字重整命名空间）当前取**路径末段**，故两个末段同名的模块
// （如 `src.d.e` 与 `src.x.e`）会映射到同一个别名 `e`：符号表 def_lookup 返回先登记者，
// 后登记者永久不可达；同名符号则直接撞成 `@e__X` 重复定义（clang duplicate symbol）。
// 实测三类后果且都不是好诊断：① const/var → 链接期 duplicate symbol（0 条 t 诊断）；
// ② fn → 误导性的 T-FUN-E811「子句元数」；③ 类型 → 静默取先登记者。
// 根治在 M2（完整路径身份）；此处先把它变成**明确的错误**，不再静默。
// ⦁ 同一路径被多处导入（菱形依赖）不算撞名：alias 相同且 path 相同 ⇒ 不报错。
pub var g_imp_alias: []string;
pub var g_imp_path: []string;

// M2：别名(末段) → 完整路径身份 映射表（如 "base" -> "src.base" / "math" -> "std.math"）。
// 声明式 `base.foo` / 类型 `base.T` 的 receiver 在源码层是末段别名，mangling 与 def 查表
// 须用完整路径身份，故 Pass 1 经 alias_full 把末段别名解析成完整路径。
pub var g_alias_full: []string;
pub var g_alias_full_idn: []string;
pub fn alias_full_register(a: string, idn: string) void {
    var i: i64 = 0;
    var n: i64 = slice_len(g_alias_full) as i64;
    while (i < n) {
        if (g_alias_full[i] == a) { return; }
        i = i + 1;
    }
    append(g_alias_full, a);
    append(g_alias_full_idn, idn);
}
pub fn alias_full(a: string) string {
    var i: i64 = 0;
    var n: i64 = slice_len(g_alias_full) as i64;
    while (i < n) {
        if (g_alias_full[i] == a) { return g_alias_full_idn[i]; }
        i = i + 1;
    }
    return a;   // 已是完整路径 / 入口 ""：原样返回
}

// 计算候选源码根：
//  1) 入口文件所在目录（兜底，等同旧的「相对导入方」，保证扁平/示例/老项目可用）；
//  2) 从入口目录向上遍历祖先目录，凡是含 tote.toml 者，其 src 子目录即候选源码根
//     （<工程根>/src 约定，最近祖先优先），版本钉由 tote.toml 负责。
// path_exists 现已改用稳健的 file_exists 内建（不再走 sys_run 外 shell，消除 arena OOM），
// 故向上遍历在绝对路径下也安全。
pub fn compute_src_roots() void {
    var roots: []string;
    // 入口目录兜底（仅此处用一次 path_resolve 规范化，已知安全）。
    var entry_dir: string = path_resolve(mod_dir_of(base__g_file));
    append(roots, entry_dir);
    // 从入口目录向上遍历祖先，凡是含 tote.toml 者，其 src 子目录即候选源码根。
    // 循环内只用纯字符串 parent_dir_of（不碰 _fullpath），并设硬上限，杜绝震荡 OOM。
    // 拼接走 StringBuilder（LLVM 后端不支持 sb_cat2..6，故不用 sb_cat2）。
    var cur: string = entry_dir;
    var guard: i64 = 0;
    while (guard < 32) {
        guard = guard + 1;
        var parent: string = parent_dir_of(cur);
        if (parent == "" or parent == cur) { break; }
        cur = parent;
        var sb: StringBuilder = sb_new();
        sb_append_str(sb, cur);
        sb_append_str(sb, "/tote.toml");
        var toml: string = sb_to_str(sb);
        if (path_exists(toml)) {
            var sb2: StringBuilder = sb_new();
            sb_append_str(sb2, cur);
            sb_append_str(sb2, "/src");
            append(roots, sb_to_str(sb2));
        }
    }
    g_src_roots = roots;
}



// 取模块名最后一段作为限定访问前缀（Go 风格：import(src.d.e) 以 e.foo() 调用）。
pub fn last_segment(s: string) string {
    var n: u64 = str_len(s);
    var i: u64 = n;
    while (i > 0) {
        i = i - 1;
        var c: u8 = s[i];
        if (c == 46 or c == 47 or c == 92) {
            return str_slice(s, i + 1, n);
        }
    }
    return s;
}

// 模块名中的 '.' 转为路径分隔符：d.e -> d/e（用于拼接 .tc 路径）。
pub fn dots_to_slashes(s: string) string {
    var n: u64 = str_len(s);
    var sb: StringBuilder = sb_new();
    var i: u64 = 0;
    while (i < n) {
        var c: u8 = s[i];
        if (c == 46) { sb_append_char(sb, 47); }
        else { sb_append_char(sb, c); }
        i = i + 1;
    }
    return sb_to_str(sb);
}

// 模块名中的 '.' 转为 '_'：src.base -> src_base（C 后端标识符仅 [A-Za-z0-9_]，
// 点号非法；LLVM 后端虽接受点号，但双后端须统一，故一律扁平化供 mangled_name）。
pub fn dots_to_underscores(s: string) string {
    var n: u64 = str_len(s);
    var sb: StringBuilder = sb_new();
    var i: u64 = 0;
    while (i < n) {
        var c: u8 = s[i];
        if (c == 46) { sb_append_char(sb, 95); }
        else { sb_append_char(sb, c); }
        i = i + 1;
    }
    return sb_to_str(sb);
}

// 输出模块依赖图（JSON）：每条 import 边（父 -> 子）一行，供 tote deps / 工具消费。
// 环检测已先行；若存在循环依赖，边中会包含回边，可一眼看出环。
//
// ── extend 边（REQ-EXT-1，供 tote 增量缓存）────────────────────────────
// 除 import 边（kind:"import"）外，额外输出 kind:"extend" 的边：
//   ia==2 = `extend fn`（扩展者）；ia==1 = `overload fn` 组（被扩展者）。
//   两者 node_file 不同 ⇒ 该 extend 跨单元 ⇒ {from: 扩展者单元, to: 被扩展单元, kind:"extend"}。
// 单元名取源文件名 stem（base_no_tc），与 import 边用模块别名的口径一致，tote 据此
// 把「被扩展单元 + 扩展闭包」拼成同一编译单元（跨单元 extend 必须同单元，否则 T-OVL-E980）。
// ⚠ 边是在 desugar_func_clauses【子句合并之前】登记的，不是这里扫 decl_list 得到的：
//   fc_merge 会把首个子句节点整体替换（slice_set），ia==2 标记随即丢失，事后扫不到。
//
// ⚠ 只输出「结构事实」，不要求 extend 语义已解析成功：跨单元 extend 在未拼装时会报
//   T-OVL-E980，但 emit_deps 位于 run_check 之后、且早于「有错则返回」分支，JSON 照常
//   输出（tote 侧 sys_capture 忽略退出码、只读 stdout）。
pub fn emit_deps() void {
    var out: StringBuilder = sb_new();
    sb_append_str(out, "{\"entry\":\"");
    base__json_escape_into(out, base__g_file);
    sb_append_str(out, "\",\"edges\":[");
    var first: bool = true;
    var ne: i64 = slice_len(lex__g_dep_from) as i64;
    var e: i64 = 0;
    while (e < ne) {
        if (first == false) { sb_append_str(out, ","); }
        first = false;
        sb_append_str(out, "{\"from\":\"");
        base__json_escape_into(out, lex__g_dep_from[e]);
        sb_append_str(out, "\",\"to\":\"");
        base__json_escape_into(out, lex__g_dep_to[e]);
        sb_append_str(out, "\",\"kind\":\"import\"");
        sb_append_char(out, 125);
        e = e + 1;
    }
    // extend 边：desugar 期登记的「扩展意图」在此解析归属。
    // 此刻 desugar_imports（order 4，模块加载）已跑完，被扩展组的 decl 已在 decl_list 中。
    // ⚠ 名称匹配的两条实证约束（--emit-deps dump 实测，勿凭直觉改）：
    //   ① 扩展者侧 sa 是裸名（"op"），且 desugar 之后其 ia 已被重置（不再是 2）
    //      —— 所以只能靠 desugar 期登记的「意图」，事后扫 ia==2 找不到；
    //   ② 被扩展者若来自别的模块，其 sa 会被重整为 "<模块>__<名>"（如 "foo__op"），ia 也不是 1。
    //   故判定用「裸名相等 或 以 "__<名>" 结尾」，单元归属一律取 node_file 的 stem。
    var dl: i64 = slice_len(lex__decl_list) as i64;
    var seen: []string;
    var nx: i64 = slice_len(lex__g_extend_name) as i64;
    var x: i64 = 0;
    while (x < nx) {
        var nm: string = lex__g_extend_name[x];
        var ef: string = lex__g_extend_file[x];
        var suff: string = "__" + nm;
        var j: i64 = 0;
        var done: bool = false;
        while (j < dl and done == false) {
            var g2: i64 = lex__decl_list[j];
            // REQ-EXT-1：FuncDecl（extend fn）、StructDecl 与 VariantDecl（overload 组，ia==1）
            // 都可作为被扩展者，按裸名或 "<模块>__<名>" 后缀匹配。
            if (base__node_kind((g2 as u64)) == "FuncDecl"
                or ((base__node_kind((g2 as u64)) == "StructDecl" or base__node_kind((g2 as u64)) == "VariantDecl")
                    and base__node_ia((g2 as u64)) == 1)) {
                var sa2: string = base__node_sa((g2 as u64));
                var hit: bool = false;
                if (sa2 == nm) { hit = true; }
                if (hit == false and str_len(sa2) > str_len(suff)) {
                    if (str_slice(sa2, str_len(sa2) - str_len(suff), str_len(sa2)) == suff) { hit = true; }
                }
                if (hit) {
                    var et: string = base__base_no_tc(base__node_file((g2 as u64)));
                    // 命中扩展者自己那条（同单元）不算边，继续找跨单元的归属
                    if (str_len(ef) > 0 and str_len(et) > 0 and ef != et) {
                        var key: string = ef + ">" + et;
                    var dup: bool = false;
                    var si: u64 = 0;
                    while (si < slice_len(seen)) {
                        if (seen[si] == key) { dup = true; break; }
                        si = si + 1;
                    }
                    if (dup == false) {
                        append(seen, key);
                        if (first == false) { sb_append_str(out, ","); }
                        first = false;
                        sb_append_str(out, "{\"from\":\"");
                        base__json_escape_into(out, ef);
                        sb_append_str(out, "\",\"to\":\"");
                        base__json_escape_into(out, et);
                        sb_append_str(out, "\",\"kind\":\"extend\"");
                        sb_append_char(out, 125);
                    }
                }
            }
            }
            j = j + 1;
        }
        x = x + 1;
    }
    sb_append_str(out, "]}\n");
    print(sb_to_str(out));
}
// 顶层入口：内联所有 import，并构建模块别名集合。
// ImportModDecl 节点留在 decl_list 中无害（register/emit 均对其忽略）。
pub fn resolve_modules() void {
    compute_src_roots();
    compute_lib_dirs();
    mod_stack_push(base__g_file, "<entry>");      // 入口作依赖图根：使「入口↔模块」成环也能被检出
    // 注意：不再注入 base 前导（prelude）。TypeInfo / FieldInfo 是**编译期内建类型**，
    // 由 resolve_ti 的 named 分支直接映射为 ti_mk("TypeInfo") / ti_mk("FieldInfo")
    // （见 ~1474），与 @type_info(T) 的返回类型（ti_mk("TypeInfo")）同源、同一 TI 表示；
    // ti_*/fi_* 也是编译期内建（builtin_ret + ll_emit_builtin / codegen_c 内建发射），
    // 无需 import base 即可裸名调用。注入 base 前导反而会把 base__TypeInfo / base__FieldInfo
    // 引入作用域，与内建 TypeInfo 形成两套冲突类型，导致裸 ti_name 解析到 base__ti_name 而报
    // T-SEM-E202（expected Variant but got）。
    var n: i64 = slice_len(lex__decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = lex__decl_list[i];
        if (base.node_kind((d as u64)) == "ImportModDecl") {
            handle_one_import(d, d);
        } else if (is_modval_import_decl(d)) {
            // 模块值别名 `const x = @import("M")` / `const x = @import("M").foo`：
            // 与 ImportModDecl 等价地内联加载模块 M，使 `x.foo` 经 sema 脱糖为
            // `<M的限定前缀>__foo` 时该符号已存在于 global_scope。
            // 钻石去重由 handle_one_import 的 in_mod_visited 保证（与旧式 @import 声明共用一套）。
            modval_load(modval_module_path(d), d);
        }
        i = i + 1;
    }
    lex__g_mod_stack = slice_pop_str(lex__g_mod_stack);
    lex__g_mod_stack_alias = slice_pop_str(lex__g_mod_stack_alias);
}

// 判定「模块值别名」声明：顶层 Global(Const|Var)Decl，且其值（nb）为 import_expr 节点，
// 或为「import_expr 接收者的成员访问」（`const x = @import("M").foo` 形式）。
pub fn is_modval_import_decl(d: i64) bool {
    var k: string = base.node_kind((d as u64));
    if (k != "GlobalConstDecl" and k != "GlobalVarDecl") { return false; }
    if (base.node_nb((d as u64)) < 0) { return false; }
    if (base.node_kind((base.node_nb((d as u64)) as u64)) == "import_expr") { return true; }
    if (base.node_kind((base.node_nb((d as u64)) as u64)) == "member" and base.node_na((base.node_nb((d as u64)) as u64)) >= 0 and base.node_kind((base.node_na((base.node_nb((d as u64)) as u64)) as u64)) == "import_expr") { return true; }
    return false;
}

// 取模块值别名声明所指向的模块路径（兼容 `const x = @import("M")` 与 `const x = @import("M").foo`）。
pub fn modval_module_path(d: i64) string {
    if (base.node_kind((base.node_nb((d as u64)) as u64)) == "import_expr") { return base.node_sa((base.node_nb((d as u64)) as u64)); }
    return base.node_sa((base.node_na((base.node_nb((d as u64)) as u64)) as u64));   // member 接收者为 import_expr
}

// 为模块值别名构造等价的 ImportModDecl（通配 `:: *`）并内联加载，使模块符号进入 global_scope。
// 关键：模块路径必须与顶层 `@import("src.M")` 声明采用同一约定——`ImportModDecl.sb` 存的是
// **剥离首段 `src.` 之后**的模块名（见 parse_at_import_decl：first_segment(mname)=="src" 时
// rest = drop_first_segment(mname)），因为 g_src_roots 已经指向 <root>/src，handle_one_import
// 再对 nm 做 dots_to_slashes 拼出 <root>/src/<rest>.tc。若原样传入 `src.base` 会变成
// <root>/src/src/base.tc（双 src），触发 T-MOD-E550。故此处照搬解析器的剥离逻辑。
pub fn modval_load(mname: string, at: i64) void {
    var is_lib: bool = true;
    var rest: string = mname;
    if (str_len(mname) >= 4 and str_slice(mname, 0, 4) == "src.") {
        is_lib = false;
        rest = str_slice(mname, 4, str_len(mname));
    }
    // M3.1：从 `const/var X = @import("M" :: a,b)` 声明取出表达式位的 `::` 选择性导入项。
    // 兼容 `const X = @import("M").foo`（member 包裹 import_expr）与无 `::` 两种情形。
    var items: i64 = -1;
    if (base.node_kind((at as u64)) == "GlobalConstDecl" or base.node_kind((at as u64)) == "GlobalVarDecl") {
        var ie: i64 = base.node_nb((at as u64));
        if (ie >= 0) {
            if (base.node_kind((ie as u64)) == "member") { ie = base.node_na((ie as u64)); }
            if (base.node_kind((ie as u64)) == "import_expr") { items = base.node_lb((ie as u64)); }
        }
    }
    var imp: i64 = base.mk_ImportModDecl(rest, "", false, is_lib, -1, -1);
    base.node_set_lb((imp as u64), items);   // M3.1：携带选择性项 → handle_one_import 经 sel_register 登记；空则跳过
    handle_one_import(imp, at);
    // (A) 模块类型绑定：const X = @import("M") / import X from "M" 把别名与模块 key 登记为
    // Module 类型名，使 @type_info(X) 反射 / 当 comptime 参数传成立（Zig 忠实版：@import 返回一等类型）。
    // 注意：登记须放此处（modval_load），因模块预加载在 check_top_decl 之前完成，
    // check_global_const_decl 的 import_expr 分支对示例顶层 const 不会被命中。
    var m_alias: string = last_segment(rest);
    var m_idn: string = rest;
    if (is_lib == false) { m_idn = "src." + rest; }
    reg_module_type_name(m_alias);
    reg_module_type_name(m_idn);
    var msi: i64 = sym_lookup(global_scope, m_alias);
    if (msi >= 0) {
        var msym: Sym = syms[msi];
        msym.ti = ti_named("Module", m_idn);
        syms[msi] = msym;
    } else {
        sym_define(global_scope, m_alias, "type", ti_named("Module", m_idn), at);
    }
    // 仅当未写 `::` 时退化通配：把模块按 `:: *` 登记，使本模块内对 M 符号的裸引用在
    // mangle_modules Pass 3 被改写为 `M__sym`（与 `:: *` 等价），并触发 T-MOD-E561 提示改用 `M.sym`。
    // 写了 `:: a,b` 则只登记这些项（选择性可见，裸引用其它符号不再可见）。
    if (items < 0) {
        var alias: string = last_segment(rest);
        // M2：g_sel_mod 记完整路径身份（src 导入 "src." + rest；库导入 rest 已完整）。
        var idn: string = rest;
        if (is_lib == false) { idn = "src." + rest; }
        // ⚠ owner 必须用「写下这条 const/var 导入声明的那一层模块」的 provenance（at 节点的 node_mod），
        // 而非 base__g_cur_mod：build --lib 在 run_check 前会把 g_cur_mod 重置为 ""（见 tc.tc line ~1016），
        // 但本模块自身的顶层声明 node_mod 已是完整 idn（如 "src.lex"）。Pass 3 的 sel_lookup 以
        // 裸引用节点的 node_mod（="src.lex"）反查 owner，若此处记 "" 会漏配 → 裸名（如 base.Tok 的兼容
        // 通配导入）无法改写成 base__Tok，type mismatch 报 <unknown>。入口（非 lib）at.node_mod 为 ""，
        // 与入口声明 node_mod 一致；故统一用 at.node_mod 即正确。
        append(lex__g_sel_owner, base.node_mod(at));
        append(lex__g_sel_local, "");
        append(lex__g_sel_mod, idn);
        append(lex__g_sel_orig, "");
        append(lex__g_sel_wild, true);
        append(lex__g_sel_at, -1);
        append(lex__g_sel_from_wild, true);   // M2：modval_load 的兼容通配，记 from_wild
    }
}

// ── 模块命名空间隔离（名字重整 / mangling）─────────────────────
//
// 目标：两个库各自定义 `foo` 不再相撞。做法是把**被导入模块**（别名 A）的顶层符号
// 统一重整为 `A__foo`；入口模块（别名 ""）永不重整，因此单文件程序的 IR 逐字节不变。
//
//  · 定义处：模块内顶层声明 sa → A__sa；
//  · 模块内引用：provenance 属于 A 的 ident/named/struct_lit/var_decl/P，
//    若名字命中 A 的顶层符号集，一并改写（局部同名变量也一起改，保持自洽）；
//  · 限定访问：`A.sym` → ident `A__sym`；类型位置 `A.T` / 字面量 `A.T{}` 同理，
//    并做 export 可见性校验（模块若含任一 export，则未 export 的符号跨模块不可见）。
//
// 「纯类型声明」节点：注册时只把名字入符号表，不解析任何其它类型 ⇒ 可无序先注册。
// typealias 不算（它要 resolve_ti 目标类型，须等这批入表后再跑）。
pub fn is_type_decl_node(d: i64) bool {
    if (d < 0) { return false; }
    var k: string = base.node_kind((d as u64));
    if (k == "StructDecl" or k == "EnumDecl") { return true; }
    if (k == "UnionDecl" or k == "VariantDecl") { return true; }
    return false;
}

// 顶层可重整的声明 kind。
pub fn is_top_decl_kind(k: string) bool {
    if (k == "FuncDecl" or k == "StructDecl" or k == "EnumDecl") { return true; }
    if (k == "UnionDecl") { return true; }
    if (k == "VariantDecl" or k == "GlobalVarDecl") { return true; }
    if (k == "GlobalConstDecl" or k == "TypeAliasDecl") { return true; }
    return false;
}

// 重整名：A + "__" + name（LLVM 后端不支持 sb_cat2..6，故走 StringBuilder）。
// M2：alias 为完整路径身份（如 "src.base"），须扁平化（'.' -> '_'）使 C 后端符号合法。
// M2 自举兼容：已加载模块的「完整路径」清单（handle_one_import 期登记，含传递依赖）。
// 供 mangled_name 判定某末段别名是否全局不唯一（同末段多模块），仅此时升完整路径。
// 入口模块（""）不入表。
pub var g_mod_fullpaths: []string;

// 末段别名 s 在全部已加载模块中出现的次数（用于碰撞感知重整）。
pub fn mod_lastseg_count(s: string) i64 {
    var n: i64 = slice_len(g_mod_fullpaths) as i64;
    var c: i64 = 0;
    var i: i64 = 0;
    while (i < n) {
        if (last_segment(g_mod_fullpaths[i]) == s) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

pub fn mangled_name(alias: string, name: string) string {
    // M2 碰撞感知：模块末段别名全局唯一 ⇒ 用末段（与旧编译器符号名一致，保证自举不动点：
    // 编译器自身 9 模块末段均唯一 ⇒ 仍发 base__kids，旧种子可编译新源码）；
    // 仅当同末段多模块冲突（如 src.d.e / src.x.e 都末段 e）才升完整路径 src_d_e__DEEP，
    // 使冲突模块的符号可消歧（f152/f153）。入口模块（alias=""）保持空前缀（顶层符号）。
    var emit: string = alias;
    if (alias != "") {
        if (mod_lastseg_count(last_segment(alias)) > 1) { emit = alias; }
        else { emit = last_segment(alias); }
    }
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, dots_to_underscores(emit));
    sb_append_str(sb, "__");
    sb_append_str(sb, name);
    return sb_to_str(sb);
}

// 在符号表 g_def_* 中查 (alias, name)，返回下标，未命中 -1。
pub fn def_lookup(alias: string, name: string) i64 {
    var n: i64 = slice_len(lex__g_def_orig) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (lex__g_def_alias[i] == alias) {
            if (lex__g_def_orig[i] == name) { return i; }
        }
        i = i + 1;
    }
    return -1;
}

// 判断某模块别名是否属于「强制路径访问」的治理范围（编译器自举 9 模块 + 入口）。
// lib 模块（repl / std 等）不在范围内，其裸跨模块名不被本诊断约束。
pub fn is_src_mod(a: string) bool {
    if (a == "") { return true; }        // 入口模块（tc.tc）属 src
    // M4.1：去掉硬编码 9 模块白名单。src 包内模块路径均以 "src." 开头
    // （根目录 src/ 下各模块：base/lex/parse/hir/sema/tir/mir/...），据此判定治理范围，
    // 无白名单/黑名单概念（见用户裁定：当前 package 里的文件都是 src 开头）。
    return starts_with(a, "src.");
}

// 模块重导出回退（M-Reexport）：模块 X 经 `pub @import(M)` 重导出了 M 的 pub 符号时，
// 下游 `X.name` 应等价于 `M.name`（重定向到 M 的真实定义 M__name，而非凭空造 X__name）。
// 仅命中 M 的导出符号（g_def_export 为真）；未命中返回 -1。
pub fn reexport_lookup(owner: string, name: string) i64 {
    var rx: i64 = 0;
    var rnx: i64 = slice_len(lex__g_reexport_owner) as i64;
    while (rx < rnx) {
        if (lex__g_reexport_owner[rx] == owner) {
            var imp: string = lex__g_reexport_imp[rx];
            var di: i64 = def_lookup(imp, name);
            if (di >= 0 and lex__g_def_export[di]) { return di; }
        }
        rx = rx + 1;
    }
    return -1;
}

// ── 模块属性（文件即模块 / @module(pub|internal)）──────────────
// 登记点在 handle_one_import（别名 + 是否跨包），attr 由 collect_module_defs
// 从 ModuleDecl 节点回填。

// 登记模块别名与「是否跨包」（幂等：已存在则不覆盖）。
pub fn mod_attr_add(alias: string, is_lib: bool) void {
    var n: i64 = slice_len(lex__g_mod_attr_alias) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (lex__g_mod_attr_alias[i] == alias) { return; }
        i = i + 1;
    }
    append(lex__g_mod_attr_alias, alias);
    append(lex__g_mod_attr, "");
    append(lex__g_mod_attr_lib, is_lib);
}

// 回填 @module(...) 的属性串（ModuleDecl 节点解析后调用）。
pub fn mod_attr_set(alias: string, attrs: string) void {
    var n: i64 = slice_len(lex__g_mod_attr_alias) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (lex__g_mod_attr_alias[i] == alias) {
            lex__g_mod_attr[i] = attrs;
            return;
        }
        i = i + 1;
    }
    append(lex__g_mod_attr_alias, alias);
    append(lex__g_mod_attr, attrs);
    append(lex__g_mod_attr_lib, false);
}

// 该模块是否声明了 @module(pub)。未写 @module 视为 internal（L-02 显式原则）。
pub fn mod_attr_is_pub(alias: string) bool {
    var n: i64 = slice_len(lex__g_mod_attr_alias) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (lex__g_mod_attr_alias[i] == alias) { return lex__g_mod_attr[i] == "pub"; }
        i = i + 1;
    }
    return false;
}

// 该模块是否来自库搜索路径（true = 跨包访问；false = src 源码根，同包）。
pub fn mod_is_lib(alias: string) bool {
    var n: i64 = slice_len(lex__g_mod_attr_alias) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (lex__g_mod_attr_alias[i] == alias) { return lex__g_mod_attr_lib[i]; }
        i = i + 1;
    }
    return false;
}

// 该模块是否至少含一个 export 声明（含 → 未 export 者为私有）。
// ⚠ 旧判据，已被 check_mod_visible 的「模块 attr ∧ 声明 pub」合取规则取代，
// 仅 collect_module_defs 内部的通配展开仍引用。
pub fn mod_has_export(alias: string) bool {
    var n: i64 = slice_len(lex__g_mod_has_export) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (lex__g_mod_has_export[i] == alias) { return true; }
        i = i + 1;
    }
    return false;
}

pub fn def_add(alias: string, name: string, exported: bool) void {
    if (def_lookup(alias, name) >= 0) { return; }
    append(lex__g_def_orig, name);
    append(lex__g_def_alias, alias);
    append(lex__g_def_export, exported);
}

// Variant 的合成辅助函数（Name_from_C / Name_is_C / Name_as_C）也要进符号集，
// 否则模块内 `V_from_C(...)` 这类裸调用不会被重整，而定义侧却由已重整的 sa 派生。
pub fn collect_variant_helper_defs(d: i64, alias: string, exported: bool) void {
    var c: i64 = base.node_lb((d as u64));
    while (c >= 0) {
        var k: Child = base__kids[c];
        def_add(alias, base__sb_cat3(base.node_sa((d as u64)), "_from_", base.node_sa((k.val as u64))), exported);
        def_add(alias, base__sb_cat3(base.node_sa((d as u64)), "_is_", base.node_sa((k.val as u64))), exported);
        if (base.node_na((k.val as u64)) >= 0) { def_add(alias, base__sb_cat3(base.node_sa((d as u64)), "_as_", base.node_sa((k.val as u64))), exported); }
        c = k.next;
    }
}

// 扫描 decl_list，收集所有「来自被导入模块」的顶层符号。
pub fn collect_module_defs() void {
    var n: i64 = slice_len(lex__decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = lex__decl_list[i];
        var a: string = base.node_mod(d);
        if (a != "") {
            // ⚠ ModuleDecl 不是「可重整的顶层声明」（不进符号表），必须单独分支，
            // 否则 @module(pub) 的属性永远读不到、跨包可见性恒为 internal。
            if (base.node_kind((d as u64)) == "ModuleDecl") {
                mod_attr_set(a, base.node_sa((d as u64)));
            } else {
                if (is_top_decl_kind(base.node_kind((d as u64)))) {
                    // S4 §0.14.7 SoA：bc 侧表读（原 nd.bc）
                    def_add(a, base.node_sa((d as u64)), base__node_bc((d as u64)));
                    if (base__node_bc((d as u64))) {
                        if (mod_has_export(a) == false) { append(lex__g_mod_has_export, a); }
                    }
                    if (base.node_kind((d as u64)) == "VariantDecl") { collect_variant_helper_defs(d, a, base__node_bc((d as u64))); }
                }
            }
        }
        i = i + 1;
    }
}

// 可见性校验（文件即模块）：三级合取规则。
//   ① 声明无 pub          ⇒ 模块私有，任何跨模块访问都报 T-MOD-E558；
//   ② 声明 pub + 同包     ⇒ 放行（src 源码根下的模块彼此同包）；
//   ③ 声明 pub + 跨包     ⇒ 还要求被导入模块的文件头写了 @module(pub)，否则 T-MOD-E558。
// 取代旧判据「模块含任一 export 时，未 export 者私有」——旧判据下「零 export 的模块
// 全部符号裸奔可见」，编译器自身的 9 个模块正是靠这条裸名互访，与「避免跨模块污染」相悖。
pub fn check_mod_visible(alias: string, name: string, di: i64, at: i64) void {
    if (lex__g_def_export[di] == false) {
        var sb: StringBuilder = sb_new();
        sb_append_str(sb, "符号 '");
        sb_append_str(sb, name);
        sb_append_str(sb, "' 是模块 '");
        sb_append_str(sb, alias);
        sb_append_str(sb, "' 的私有符号（未用 pub 标记），不可跨模块访问");
        parse__fc_err("T-MOD-E558", sb_to_str(sb), at);
        return;
    }
    // 跨包（来自库搜索路径）还要求模块自身声明 @module(pub)。
    if (mod_is_lib(alias)) {
        if (mod_attr_is_pub(alias) == false) {
            var sb2: StringBuilder = sb_new();
            sb_append_str(sb2, "符号 '");
            sb_append_str(sb2, name);
            sb_append_str(sb2, "' 所在模块 '");
            sb_append_str(sb2, alias);
            sb_append_str(sb2, "' 未声明 @module(pub)，不可跨包访问（同包内仍可见）");
            parse__fc_err("T-MOD-E558", sb_to_str(sb2), at);
            return;
        }
    }
}

// 未知限定符号诊断。
pub fn err_no_symbol(alias: string, name: string, at: i64) void {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "模块 '");
    sb_append_str(sb, alias);
    sb_append_str(sb, "' 中不存在顶层符号 '");
    sb_append_str(sb, name);
    sb_append_str(sb, "'");
    parse__fc_err("T-MOD-E557", sb_to_str(sb), at);
}

// ── 选择性导入（`::` 列表）绑定 ─────────────────────────────────
// 语义：`import(std.math :: max, min as mn);` 使导入方作用域内的裸名 `max` / `mn`
// 直接等价于 `math.max` / `math.min`，即重整名 `math__max` / `math__min`。
// 实现方式与 Pass 2 同构：按 provenance 就地改写名字，无需引入新的作用域机制。

// 入口模块（provenance ""）是否已有同名顶层声明 —— 选择性导入撞名检测用。
// （g_def_* 只收录 alias != "" 的模块符号，入口符号需单独扫 decl_list。）
pub fn entry_has_top(name: string) bool {
    var n: i64 = slice_len(lex__decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = lex__decl_list[i];
        if (base.node_mod(d) == "") {
            if (is_top_decl_kind(base.node_kind((d as u64)))) {
                if (base.node_sa((d as u64)) == name) { return true; }
            }
        }
        i = i + 1;
    }
    return false;
}

// 入口模块顶层符号重定义诊断。
pub fn err_dup_top_def(name: string, at: i64) void {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "顶层符号 '");
    sb_append_str(sb, name);
    sb_append_str(sb, "' 在本模块中重复定义（fn 的 clause 与重载不算重复）");
    parse__fc_err("T-NAM-E405", sb_to_str(sb), at);
}

// 入口模块（provenance ""）的顶层符号重定义检查。
//
// ⚠ fn 必须豁免：clause（fn f(0) / fn f(_) / fn f(n when n > 0)）与重载都以**多个同名
// FuncDecl 节点**存在于 decl_list，是合法形态（见 parse.tc 的 function clause group 校验）。
//
// 历史背景：本检查此前完全缺失，实测后果分三类且互不一致 ——
//   ① 重复 const / var  → 0 error，链接期 `duplicate symbol`；
//   ② 重复 struct / enum → 0 error，静默取**先**声明者；
//   ③ 重复 fn（同签名）  → 0 error，静默取**先**声明者。
// 全仓 521 个 .tc 文件实测：非 fn 顶层同名 = **0** ⇒ 本检查零存量误报。
//
// ⦁ 范围：仅入口模块（node_mod == ""）。被导入模块的符号走 def_add 去重（另一条路径，见 M1.2）。
pub fn check_entry_redefs() void {
    var n: i64 = slice_len(lex__decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var di: i64 = lex__decl_list[i];
        if (base.node_mod(di) == "") {
            var ki: string = base.node_kind((di as u64));
            if (ki != "FuncDecl") {
                if (is_top_decl_kind(ki)) {
                    var nm: string = base.node_sa((di as u64));
                    var j: i64 = i + 1;
                    while (j < n) {
                        var dj: i64 = lex__decl_list[j];
                        if (base.node_mod(dj) == "") {
                            var kj: string = base.node_kind((dj as u64));
                            if (kj != "FuncDecl") {
                                if (is_top_decl_kind(kj)) {
                                    if (base.node_sa((dj as u64)) == nm) {
                                        err_dup_top_def(nm, dj);
                                    }
                                }
                            }
                        }
                        j = j + 1;
                    }
                }
            }
        }
        i = i + 1;
    }
}

// 把 `:: *` 通配项展开成逐个具名项。模块若含任一 export，则只展开 export 符号；
// 否则展开其全部顶层符号（与 check_mod_visible 的可见性口径一致）。
pub fn sel_expand_wildcards() void {
    var ns: i64 = slice_len(lex__g_sel_local) as i64;   // 先取长度：展开产生的新项不再参与本轮
    var s: i64 = 0;
    while (s < ns) {
        if (lex__g_sel_wild[s]) {
            var m: string = lex__g_sel_mod[s];
            var only_exp: bool = mod_has_export(m);
            var nd: i64 = slice_len(lex__g_def_orig) as i64;
            var d: i64 = 0;
            while (d < nd) {
                var take: bool = false;
                if (lex__g_def_alias[d] == m) {
                    take = true;
                    if (only_exp) {
                        if (lex__g_def_export[d] == false) { take = false; }
                    }
                }
                if (take) {
                    append(lex__g_sel_owner, lex__g_sel_owner[s]);
                    append(lex__g_sel_local, lex__g_def_orig[d]);
                    append(lex__g_sel_mod, m);
                    append(lex__g_sel_orig, lex__g_def_orig[d]);
                    append(lex__g_sel_wild, false);
                    append(lex__g_sel_at, lex__g_sel_at[s]);
                    append(lex__g_sel_from_wild, true);   // M2：通配展开项，记 from_wild
                }
                d = d + 1;
            }
        }
        s = s + 1;
    }
}

// 查 (owner, 本地名) → 选择性导入表下标；未命中 -1。通配占位项不参与查找。
pub fn sel_lookup(owner: string, name: string) i64 {
    var n: i64 = slice_len(lex__g_sel_local) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (lex__g_sel_wild[i] == false) {
            if (lex__g_sel_owner[i] == owner) {
                if (lex__g_sel_local[i] == name) { return i; }
            }
        }
        i = i + 1;
    }
    return -1;
}

// 撞名诊断：本地名与导入方自身顶层符号、或与另一条选择性导入冲突。
pub fn err_sel_conflict(local: string, what: string, at: i64) void {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "选择性导入的名字 '");
    sb_append_str(sb, local);
    sb_append_str(sb, "' 与");
    sb_append_str(sb, what);
    sb_append_str(sb, "冲突（请用 `as` 改名，或改用限定访问）");
    parse__fc_err("T-MOD-E560", sb_to_str(sb), at);
}

// 校验每条选择性导入项：源模块中确实存在该符号、可见、且本地名不撞名。
pub fn sel_validate() void {
    var n: i64 = slice_len(lex__g_sel_local) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (lex__g_sel_wild[i] == false) {
            var di: i64 = def_lookup(lex__g_sel_mod[i], lex__g_sel_orig[i]);
            if (di < 0) {
                err_no_symbol(lex__g_sel_mod[i], lex__g_sel_orig[i], lex__g_sel_at[i]);
            } else {
                check_mod_visible(lex__g_sel_mod[i], lex__g_sel_orig[i], di, lex__g_sel_at[i]);
            }
            var clash: bool = false;
            if (lex__g_sel_owner[i] == "") {
                clash = entry_has_top(lex__g_sel_local[i]);
            } else {
                if (def_lookup(lex__g_sel_owner[i], lex__g_sel_local[i]) >= 0) { clash = true; }
            }
            if (clash) {
                err_sel_conflict(lex__g_sel_local[i], "导入方自身的顶层声明", lex__g_sel_at[i]);
            } else {
                // 同一导入方下，同名但来源不同的两条选择性导入 → 歧义
                var j: i64 = 0;
                while (j < i) {
                    if (lex__g_sel_wild[j] == false and lex__g_sel_owner[j] == lex__g_sel_owner[i]
                        and lex__g_sel_local[j] == lex__g_sel_local[i]) {
                        if (lex__g_sel_mod[j] != lex__g_sel_mod[i] or lex__g_sel_orig[j] != lex__g_sel_orig[i]) {
                            // M2：两条都源自 `:: *` 通配（含 const X = @import("M") 的兼容通配）
                            // 且分属不同模块 ⇒ 不报撞名。通配同名经限定访问（X.DEEP）消歧或裸名
                            // 取首匹配（T-MOD-E561 已提示改限定名），非真歧义（见 f153）。
                            if (lex__g_sel_from_wild[j] == false or lex__g_sel_from_wild[i] == false) {
                                err_sel_conflict(lex__g_sel_local[i], "另一条选择性导入", lex__g_sel_at[i]);
                                j = i;   // 同一项只报一次
                            }
                        }
                    }
                    j = j + 1;
                }
            }
        }
        i = i + 1;
    }
}

// ── W561 修复（M4.2 前置）：排除「指向本函数局部变量/形参的裸名」误报 ──
// 背景：W561 旨在提示「跨模块裸名须改模块限定名」。但函数内局部变量/形参与被导入的
// 跨模块名可能重名（如 sema.tc:4811 的局部 `pos` 与 `lex.pos`）。在 mangle_modules 阶段
// （早于 hir_build/infer_expr：node_resolve 尚未填充、AST 无父指针侧表）无法靠符号表区分。
// 故在此构建一次性父指针侧表，向上找到所有包含该 ident 的函数/闭包，扫描其局部变量与形参；
// 若任一作用域存在同名局部/形参 ⇒ 该裸名指向局部（非跨模块引用）⇒ 跳过 W561。
pub var g_w561_parent: []i64;   // 与节点池等长：节点 → 父节点 id（默认 -1）

// AST 子节点分布在多槽（na/nb 单槽 + la/lb/lc 链表），须全部纳入父指针侧表，否则
// 父链断裂导致向上找不到包含函数、子树扫描漏掉局部声明。
pub fn w561_build_parents() void {
    var tot: i64 = base__node_count();
    g_w561_parent = [];
    var i: i64 = 0;
    while (i < tot) {
        append(g_w561_parent, -1);
        i = i + 1;
    }
    i = 0;
    while (i < tot) {
        if (base.node_na((i as u64)) >= 0) { var ch: i64 = base.node_na((i as u64)); if (ch < tot) { slice_set(g_w561_parent, ch, i); } }
        if (base.node_nb((i as u64)) >= 0) { var ch: i64 = base.node_nb((i as u64)); if (ch < tot) { slice_set(g_w561_parent, ch, i); } }
        var c: i64 = base.node_la((i as u64));
        while (c >= 0) { var ch: i64 = base__kids[c].val; if (ch < tot) { slice_set(g_w561_parent, ch, i); } c = base__kids[c].next; }
        c = base.node_lb((i as u64));
        while (c >= 0) { var ch: i64 = base__kids[c].val; if (ch < tot) { slice_set(g_w561_parent, ch, i); } c = base__kids[c].next; }
        c = base.node_lc((i as u64));
        while (c >= 0) { var ch: i64 = base__kids[c].val; if (ch < tot) { slice_set(g_w561_parent, ch, i); } c = base__kids[c].next; }
        i = i + 1;
    }
}

pub fn w561_parent(n: i64) i64 {
    var tot: i64 = base__node_count();
    if (n < 0 or n >= tot) { return -1; }
    return g_w561_parent[n];
}

// 名字是否已含 `__`（模块限定分隔符）⇒ 已是模块限定形式，非裸跨模块引用。
pub fn w561_is_qualified(name: string) bool {
    var i: i64 = 0;
    var n: i64 = str_len(name);
    while (i + 1 < n) {
        if (name[i] == '_' and name[i + 1] == '_') { return true; }
        i = i + 1;
    }
    return false;
}

// 该 ident 是否指向某个包含它的函数/闭包作用域内的局部变量或形参（⇒ 不是跨模块裸名）。
pub fn w561_is_local_ref(p: i64, name: string) bool {
    var r: bool = false;
    var cur: i64 = w561_parent(p);
    var fns: i64 = 0;
    while (cur >= 0) {
        var k: string = base.node_kind((cur as u64));
        if (k == "FuncDecl" or k == "lambda") {
            fns = fns + 1;
            // 扫描该函数/闭包体直接子节点（不下钻嵌套函数体），命中同名局部/形参即视为局部引用。
            if (w561_func_has_local(cur, name)) { r = true; break; }
        }
        cur = w561_parent(cur);
    }
    return r;
}

// 扫描函数/闭包节点 func 的直接子节点，逐个调用 w561_has_local_in_subtree（后者遇嵌套 FuncDecl/lambda 即停，不下钻）。
// 仅作为 w561_is_local_ref 的入口；根 func 自身不判局部，避免 w561_has_local_in_subtree 对 FuncDecl 直接 return false 而漏扫函数体。
pub fn w561_func_has_local(func: i64, name: string) bool {
    if (base.node_na((func as u64)) >= 0) { if (w561_has_local_in_subtree(base.node_na((func as u64)), name)) { return true; } }
    if (base.node_nb((func as u64)) >= 0) { if (w561_has_local_in_subtree(base.node_nb((func as u64)), name)) { return true; } }
    var c: i64 = base.node_la((func as u64));
    while (c >= 0) { if (w561_has_local_in_subtree(base__kids[c].val, name)) { return true; } c = base__kids[c].next; }
    c = base.node_lb((func as u64));
    while (c >= 0) { if (w561_has_local_in_subtree(base__kids[c].val, name)) { return true; } c = base__kids[c].next; }
    c = base.node_lc((func as u64));
    while (c >= 0) { if (w561_has_local_in_subtree(base__kids[c].val, name)) { return true; } c = base__kids[c].next; }
    return false;
}

// 扫描 n 子树中的局部变量(var_decl)/形参(P)；不进入嵌套函数/闭包体（其局部属独立作用域，
// 不绑定外层 p）。命中同名即返回 true。递归遍历全部子槽（na/nb/la/lb/lc）。
// 注意：n 自身若为 FuncDecl/lambda（嵌套函数边界）直接返回 false，不下钻。根函数由 w561_func_has_local 单独扫描直接子节点。
pub fn w561_has_local_in_subtree(n: i64, name: string) bool {
    var k: string = base.node_kind((n as u64));
    if (k == "var_decl" or k == "P") {
        if (base.node_sa((n as u64)) == name) { return true; }
    }
    if (k == "FuncDecl" or k == "lambda") { return false; }   // 不进入嵌套函数体
    if (base.node_na((n as u64)) >= 0) { if (w561_has_local_in_subtree(base.node_na((n as u64)), name)) { return true; } }
    if (base.node_nb((n as u64)) >= 0) { if (w561_has_local_in_subtree(base.node_nb((n as u64)), name)) { return true; } }
    var c: i64 = base.node_la((n as u64));
    while (c >= 0) { if (w561_has_local_in_subtree(base__kids[c].val, name)) { return true; } c = base__kids[c].next; }
    c = base.node_lb((n as u64));
    while (c >= 0) { if (w561_has_local_in_subtree(base__kids[c].val, name)) { return true; } c = base__kids[c].next; }
    c = base.node_lc((n as u64));
    while (c >= 0) { if (w561_has_local_in_subtree(base__kids[c].val, name)) { return true; } c = base__kids[c].next; }
    return false;
}

pub fn mangle_modules() void {
    collect_module_defs();
    check_entry_redefs();
    var ndef: i64 = slice_len(lex__g_def_orig) as i64;
    var tot: i64 = base__node_count();

    // Pass 1：限定访问 `A.sym` / 类型 `A.T` / 字面量 `A.T{}` → 重整名（必须先于 Pass 2，
    // 否则模块内写 `B.T` 会被 Pass 2 当成本模块的 T 误重整）。
    var i: i64 = 0;
    while (i < tot) {
        if (base.node_kind((i as u64)) == "member" and base.node_na((i as u64)) >= 0) {
            if (base.node_kind((base.node_na((i as u64)) as u64)) == "ident" and in_mod_aliases(base.node_sa((base.node_na((i as u64)) as u64)))) {
                // M2：receiver 是末段别名，经 alias_full 解析成完整路径身份再查 def 表。
                var rcv: string = alias_full(base.node_sa((base.node_na((i as u64)) as u64)));
                var di: i64 = def_lookup(rcv, base.node_sa((i as u64)));
                // 模块重导出（M-Reexport）：X 重导出了 M 时，`X.name` 回退到 `M.name`
                // （重定向到 M 的真实定义 M__name）。仅命中 M 的导出符号。
                if (di < 0) { di = reexport_lookup(rcv, base.node_sa((i as u64))); }
                if (di >= 0) {
                    // 真实归属模块 = g_def_alias[di]（重导出时为被重导出的 M，并非 X 本身）
                    var real_alias: string = lex__g_def_alias[di];
                    check_mod_visible(real_alias, base.node_sa((i as u64)), di, i);
                    base.node_set_sa((i as u64), mangled_name(real_alias, base.node_sa((i as u64))));
                    base.node_set_kind((i as u64), "ident");
                    base.node_set_na((i as u64), -1);   // 丢弃对象（模块名）子节点
                }
                // 未命中则保持 member 不变：同名局部/字段访问不受影响（由后续检查兜底）
            }
        } else if (base.node_kind((i as u64)) == "named" and base.node_sb((i as u64)) != "") {
            var rcv2: string = alias_full(base.node_sb((i as u64)));
            var di2: i64 = def_lookup(rcv2, base.node_sa((i as u64)));
            if (di2 < 0) { di2 = reexport_lookup(rcv2, base.node_sa((i as u64))); }
            if (di2 >= 0) {
                var real_alias2: string = lex__g_def_alias[di2];
                check_mod_visible(real_alias2, base.node_sa((i as u64)), di2, i);
                base.node_set_sa((i as u64), mangled_name(real_alias2, base.node_sa((i as u64))));
            } else {
                err_no_symbol(base.node_sb((i as u64)), base.node_sa((i as u64)), i);
            }
            base.node_set_sb((i as u64), "");
        } else if (base.node_kind((i as u64)) == "struct_lit" and base.node_sb((i as u64)) != "") {
            var rcv3: string = alias_full(base.node_sb((i as u64)));
            var di3: i64 = def_lookup(rcv3, base.node_sa((i as u64)));
            if (di3 < 0) { di3 = reexport_lookup(rcv3, base.node_sa((i as u64))); }
            if (di3 >= 0) {
                var real_alias3: string = lex__g_def_alias[di3];
                check_mod_visible(real_alias3, base.node_sa((i as u64)), di3, i);
                base.node_set_sa((i as u64), mangled_name(real_alias3, base.node_sa((i as u64))));
            } else {
                err_no_symbol(base.node_sb((i as u64)), base.node_sa((i as u64)), i);
            }
            base.node_set_sb((i as u64), "");
        }
        i = i + 1;
    }

    // Pass 2：按 provenance 重整模块自身的定义与内部裸引用。
    // ndef == 0（单文件程序，无被导入模块符号）时整趟跳过 ⇒ IR 逐字节不变。
    if (ndef > 0) {
        var j: i64 = 0;
        while (j < tot) {
            var m: string = base.node_mod(j);
            if (m != "") {
                var k: string = base.node_kind((j as u64));
                var hit: bool = false;
                if (k == "ident" or k == "named" or k == "struct_lit") { hit = true; }
                if (k == "var_decl" or k == "P") { hit = true; }
                if (is_top_decl_kind(k)) { hit = true; }
                if (hit) {
                    if (def_lookup(m, base.node_sa((j as u64))) >= 0) {
                        base.node_set_sa((j as u64), mangled_name(m, base.node_sa((j as u64))));
                    }
                }
            }
            j = j + 1;
        }
    }

    // Pass 3：选择性导入（`::` 列表）。先展开通配、校验，再按 provenance 把导入方
    // 作用域内的裸名改写成 `模块__原名`。顶层声明本身不改（撞名已在 sel_validate 报错）。
    // 注意与 Pass 2 互不重叠：Pass 2 只改「导入方自己定义了该名字」的情形，而那恰是
    // sel_validate 判定的冲突，正常路径下两趟不会碰同一个节点。
    if ((slice_len(lex__g_sel_local) as i64) > 0) {
        w561_build_parents();
        sel_expand_wildcards();
        sel_validate();
        var p: i64 = 0;
    while (p < tot) {
        var k3: string = base.node_kind((p as u64));
        var hit3: bool = false;
            if (k3 == "ident" or k3 == "named" or k3 == "struct_lit") { hit3 = true; }
            // 注意：var_decl / P（局部变量声明、形参）不属于「跨模块引用」，不在 Pass 3 改写。
            // 它们若撞名导入方，由 Pass 2（自身定义 def_lookup>=0）或 sel_validate 处理；
            // 函数内局部绑定更绝不可改写成 `模块__原名`，否则局部变量被误改名（W561 根因）。
            if (hit3) {
                var si: i64 = sel_lookup(base.node_mod(p), base.node_sa((p as u64)));
                if (si >= 0) {
                    // 强制路径访问（Task A 落地）：裸跨模块引用必须改为模块限定名。
                    // 仅对 src 治理范围内、真实 anchor 的标识符/命名类型/结构体字面量生效；
                    // 合成节点（ln==0，误归因到行 1 的 phantom）一律跳过，避免噪声。
                var owner: string = lex__g_sel_mod[si];
                var w561_name: string = base.node_sa((p as u64));
                if (base.node_span_id(p).line > 0
                    and (k3 == "ident" or k3 == "named" or k3 == "struct_lit")
                    and is_src_mod(base.node_mod(p))
                    and owner != base.node_mod(p)
                    and def_lookup(base.node_mod(p), w561_name) < 0
                    // 已含 `__` 的限定名（tir__TIR_OP_NE 等）本就是模块限定形式 ⇒ 非裸引用，跳过。
                    and !w561_is_qualified(w561_name)
                    // M4.2 前置修复：局部变量/形参与跨模块名重名时，裸名指向局部 ⇒ 非跨模块引用，跳过。
                    and (k3 != "ident" or !w561_is_local_ref(p, w561_name))) {
                        var repl: string = mangled_name(owner, base.node_sa((p as u64)));
                        var sl: i64 = parse.n_line(p);
                        var sc: i64 = parse.n_col(p);
                        var ec: i64 = sc + ((base.node_span_id(p).end_col - base.node_span_id(p).col) as i64);
                        var di: i64 = base__diag_new("T-MOD-E561", "error",
                            "跨模块访问必须使用模块限定名 " + repl + "，不能用裸名 " + base.node_sa((p as u64)),
                            parse.n_file(p), sl, sc, sl, ec);
                        var fx: i64 = base__fix_one("改用 " + repl,
                            parse.n_file(p), sl, sc, sl, ec, repl);
                        base__diag_set_fs(di, fx);
                    }
                    // 修复（W561 根因）：仅对真正的跨模块引用改写。已限定名 / 指向局部绑定的 ident 用法
                    // （局部变量/形参与导入名重名）一律不改写，否则函数内局部 `var pos` 会被误
                    // 改名为 `lex__pos`，与同作用域用法错位；声明侧已由 hit3 排除。
                    if (!w561_is_qualified(w561_name) and !(k3 == "ident" and w561_is_local_ref(p, w561_name))) {
                        base.node_set_sa((p as u64), mangled_name(lex__g_sel_mod[si], lex__g_sel_orig[si]));
                    }
                }
            }
            p = p + 1;
        }
    }
}

// ── check 主流程（复刻 checker.ts:83）─────────────────────────

// ══════════════════════════════════════════════════════════════
// Phase B —— CTFE 编译期求值器（meta）
// 设计：docs/compiler/meta_design.md §9 Phase B
//
// 求值结果统一以「字面量节点 id」承载（int / bool / string）：
//   ① 规避结构体按值返回的 Win64 聚合 ABI 坑；
//   ② 「折叠」退化为把字面量内容就地拷回 meta 节点 —— 无需回溯父节点重连指针。
// 支持标量：i64 整数 / bool / string。浮点暂不支持（第 7 条字节级可复现性
// 需先就浮点求值顺序定案，见 docs/compiler/meta_design.md §10）。
// ══════════════════════════════════════════════════════════════

pub var g_menv_name: []string;   // 编译期环境：名字（平栈）
pub var g_menv_val: []i64;       // 编译期环境：值（字面量节点 id）
pub var g_menv_ty: []i64;        // 同槽的**类型**绑定（`meta T: type` 用；-1 = 这是值绑定）
pub var g_menv_top: i64;         // 逻辑栈顶（只增不缩，复用底层容量）
pub var g_menv_base: i64;        // 当前调用帧底：查找不跨帧（禁止看到调用方局部）
pub var g_menv_nglobal: i64;     // 全局编译期常量区大小 [0, nglobal)
pub var g_meta_depth: i64;       // meta 调用深度
pub var g_in_comptime: i64;       // S1/Q1：当前处于 comptime 上下文的嵌套层数（comptime 块/函数体），>0 时裸类型名即 type 值
pub var g_meta_steps: i64;       // 步数预算，防不终止的 meta 循环 / 递归
pub var g_me_count: i64;         // P2b 调试：meta_eval 累计调用数
pub var g_me_depth: i64;         // meta_eval 递归深度，用于最外层调用补充预算（避免共享预算在语义期耗尽导致误报 E612）
// S3/Q1：持有 type 值的局部变量（var x: type = ...）→ 编译期绑定，代码期擦除（无运行期槽位）
pub var g_cvar_name: []string;   // 名字（平栈，最近作用域在末尾）
pub var g_cvar_val:  []i64;      // 对应的 type 值节点 id（scalar / named 类型描述符）
pub var g_cvar_n:    i64;        // g_cvar_name/val 的当前长度（避免 len() 依赖 t_len）
pub var g_skip_var:  []i64;      // 需在双后端跳过槽位分配的 var_decl 节点 id
pub var g_skip_n:    i64;        // g_skip_var 的当前长度
pub var g_meta_ret: i64;         // return 携带值（字面量节点 id）
pub var g_meta_err: bool;        // 本轮求值是否已失败（错误已报，避免刷屏）
pub var g_meta_quiet: bool;      // 静默：泛型模板内求值失败不报错（模板本体不发射）
pub var g_meta_trace: bool = false;     // 元函数观察调试器开关（--trace-comptime）
pub var g_meta_trace_calls: i64 = 0;   // 本次编译被追踪的 comptime fn 调用次数
pub var g_meta_trace_maxdepth: i64 = 0; // 本次编译 comptime fn 调用最大深度
pub var g_meta_trace_jsonl: string = "";  // 元函数观察调试器：JSONL 累积缓冲
pub var g_meta_trace_root: string = "";   // 本次编译首个被追踪的根函数名
pub var g_q: string = "\"";               // 双引号字符常量（构造标准 JSON 用）

// 当前正在 register/check 的泛型函数的「类型参数」名字集合（如 comptime/meta T: type）。
// resolve_ti/resolve_type_desc/deser_type_of 借此把泛型类型参数识别为「类型」而非
// 「未定义类型」，避免在模板定义期（T 尚未绑定具体类型）误报 T_UNKNOWN_TYPE。
// 仅作用于泛型模板本体，实例（T 已替换为具体类型）不受影响。
pub var g_gen_tparams: []string;
pub fn gen_tparam_has(name: string) bool {
    var i: i64 = 0;
    while (i < slice_len(g_gen_tparams)) {
        if (g_gen_tparams[i] == name) { return true; }
        i = i + 1;
    }
    return false;
}

// ── 值构造 / 读取 ────────────────────────────────────────────
pub fn mv_int(v: i64) i64 { return base__mk_int(base__i2s(v), 10, -1); }
pub fn mv_bool(b: bool) i64 { return base__mk_bool(b, -1); }

// 编译期值 → 显示字符串（`@compile_log` / `@compile_warning` 拼消息用）。
// 对齐 docs/compiler/meta_design.md §2.2 的用法 `@compile_log("meta k = ", k)`
// （该内建本身列于同文件 §5）：实参可以是任意**标量**编译期值
// （string / int / float / bool），非标量由调用方报 T-MTA-E601。
pub fn mv_to_str(v: i64) string {
    var k: string = base.node_kind((v as u64));
    if (k == "string" or k == "int" or k == "float") { return base.node_sa((v as u64)); }
    if (k == "bool") {
        if (base.node_ba((v as u64))) { return "true"; }
        return "false";
    }
    return "";
}

// 字面量节点 → i64（bool 视作 0/1）
pub fn mv_get_int(id: i64) i64 {
    if (base.node_kind((id as u64)) == "bool") {
        if (base.node_ba((id as u64))) { return 1; }
        return 0;
    }
    return js_parse_int(base.node_sa((id as u64)), base.node_ia((id as u64)));
}

// ── 编译期环境 ──────────────────────────────────────────────
pub fn menv_push2(name: string, val: i64, ty: i64) void {
    if (g_menv_top < (slice_len(g_menv_name) as i64)) {
        slice_set(g_menv_name, g_menv_top, name);
        slice_set(g_menv_val, g_menv_top, val);
        slice_set(g_menv_ty, g_menv_top, ty);
    } else {
        append(g_menv_name, name);
        append(g_menv_val, val);
        append(g_menv_ty, ty);
    }
    g_menv_top = g_menv_top + 1;
}

pub fn menv_push(name: string, val: i64) void {
    menv_push2(name, val, -1);
}

// `meta T: type` 形参：槽里存的是**类型节点 id**，不是字面量。
// 取值路径（meta_eval ident）拒绝它；类型查询路径（mb_bound_type）认它。
pub fn menv_push_type(name: string, tn: i64) void {
    menv_push2(name, -1, tn);
}

// 查找：先当前帧 [g_menv_base, g_menv_top)，再全局常量区 [0, g_menv_nglobal)。
// 中间的调用方局部刻意不可见 —— meta fn 是纯函数，不做动态作用域。
pub fn menv_find(name: string) i64 {
    var i: i64 = g_menv_top;
    while (i > g_menv_base) {
        i = i - 1;
        if (g_menv_name[i] == name) { return i; }
    }
    var j: i64 = g_menv_nglobal;
    while (j > 0) {
        j = j - 1;
        if (g_menv_name[j] == name) { return j; }
    }
    return -1;
}

// S3/Q1：查找「持有 type 值的局部变量」绑定（最近作用域优先）
pub fn cvar_find(name: string) i64 {
    var i: i64 = g_cvar_n - 1;
    while (i >= 0) {
        if (g_cvar_name[i] == name) { return i; }
        i = i - 1;
    }
    return -1;
}
pub fn cvar_push(name: string, node: i64) void {
    append(g_cvar_name, name);
    append(g_cvar_val, node);
    g_cvar_n = g_cvar_n + 1;
}
pub fn skip_var_has(s: i64) bool {
    var i: i64 = 0;
    while (i < g_skip_n) { if (g_skip_var[i] == s) { return true; } i = i + 1; }
    return false;
}

// S3/Q1：预扫描函数体，把「持有 type 值的局部变量」（var x: type = ...）登记进 g_cvar 表。
// 根因：meta_pass 执行 comptime 块的时机早于 check 阶段的语句遍历（cs_var_decl 注册 var x: type）。
// 若 comptime 块引用了函数运行期作用域的 `var x: type`，需在 comptime 块求值前让 cvar 表就绪，
// 否则 meta_eval 解析不到该 type 值（T-MTA-E620）。本函数在 meta_pass 进入 meta_walk_list 前调用，
// 与 cs_var_decl 同款求值逻辑（g_meta_err 复位 + 步数预算），登记项挂在 g_cvar 平栈上；调用方负责
// 在函数求值结束后回弹 g_cvar_n，避免跨函数泄漏。
// 遍历同 meta_walk：单子用 node_na/nb/nc/nd（节点 id），语句/实参链表用 node_la/lb/lc（kids 池 entry
// 头索引），经 base__kids[c].next 链表推进——绝不可把节点 id 当 kids 池下标喂给 kids_chain_idx。
pub fn meta_register_cvars_of_list(head: i64) void {
    var c: i64 = head;
    while (c >= 0) {
        var ch: Child = base__kids[c];
        meta_register_cvars_of(ch.val);
        c = base__kids[c].next;
    }
}
pub fn meta_register_cvars_of(e: i64) void {
    if (e < 0) { return; }
    var k: string = base.node_kind((e as u64));
    if (k == "var_decl" and base.node_na((e as u64)) >= 0 and base.node_kind((base.node_na((e as u64)) as u64)) == "type") {
        var civ: i64 = -1;
        if (base.node_nb((e as u64)) >= 0) {
            g_meta_err = false;
            if (g_meta_steps < 200000) { g_meta_steps = 200000; }
            civ = meta_eval(base.node_nb((e as u64)));
        }
        if (civ >= 0 and meta_node_is_type(civ)) {
            cvar_push(base.node_sa((e as u64)), civ);
        }
    }
    meta_register_cvars_of(base.node_na((e as u64)));
    meta_register_cvars_of(base.node_nb((e as u64)));
    meta_register_cvars_of(base.node_nc((e as u64)));
    meta_register_cvars_of(base.node_nd((e as u64)));
    meta_register_cvars_of_list(base.node_la((e as u64)));
    meta_register_cvars_of_list(base.node_lb((e as u64)));
    meta_register_cvars_of_list(base.node_lc((e as u64)));
}

// ── 诊断 ────────────────────────────────────────────────────
pub fn meta_fail(code: string, msg: string, e: i64) i64 {
    if (g_meta_err == false) {
        g_meta_err = true;
        if (g_meta_quiet == false) { parse__fc_err(code, msg, e); }
    }
    return -1;
}

// 整数窄化：按目标标量位宽回绕（编译期与运行期语义一致）
pub fn meta_int_wrap(v: i64, t: string) i64 {
    var bits: i64 = 0;
    var sgn: bool = false;
    if (t == "i8") { bits = 8; sgn = true; }
    if (t == "u8") { bits = 8; sgn = false; }
    if (t == "i16") { bits = 16; sgn = true; }
    if (t == "u16") { bits = 16; sgn = false; }
    if (t == "i32") { bits = 32; sgn = true; }
    if (t == "u32") { bits = 32; sgn = false; }
    if (t == "rune") { bits = 32; sgn = true; }
    // 任意位宽整数 `i<N>` / `u<N>`：位宽即名字尾数。N ≥ 64 时宿主 i64 装不下，
    // 沿用「原样返回」——编译期折叠只对能装进 i64 的宽度做回绕。
    var ab: i64 = base.awi_bits(t);
    if (ab > 0 and ab < 64) {
        bits = ab;
        sgn = t[0] == 105;                       // 'i' == 105
    }
    if (bits == 0) { return v; }
    var m: i64 = (1 << bits) - 1;
    var r: i64 = v & m;
    if (sgn) {
        var hi: i64 = 1 << (bits - 1);
        if ((r & hi) != 0) { r = r - (m + 1); }
    }
    return r;
}

pub fn meta_is_int_type(t: string) bool {
    if (t == "i8" or t == "i16" or t == "i32" or t == "i64") { return true; }
    if (t == "u8" or t == "u16" or t == "u32" or t == "u64") { return true; }
    if (t == "rune") { return true; }
    return base.is_awi_name(t);
}

// ── 表达式求值：返回字面量节点 id，失败返回 -1 ────────────────
// ── 枚举成员编译期值注册表（供常数枚举成员间引用）──────────────────
// fold_enum_values 把每个枚举成员折出的整型值登记于此，key = "Enum.Member"；
// meta_eval_member 据此解析 `Enum.Member` 为编译期整型字面量。单轮编译
// comptime_fold_pass 只跑一次，注册表随进程新生，无需显式清空。
pub var g_enum_cn: []string;   // "Enum.Member"
pub var g_enum_cvi: []i64;     // 整型值

pub fn enum_const_lookup(ename: string, mname: string) i64 {
    var key: string = base__sb_cat2(ename, base__sb_cat2(".", mname));
    var i: i64 = 0;
    var n: i64 = slice_len(g_enum_cn) as i64;
    while (i < n) {
        if (g_enum_cn[i] == key) { return base.mk_int(base.i2s(g_enum_cvi[i]), 10, -1); }
        i = i + 1;
    }
    return -1;
}

pub fn enum_const_set(ename: string, mname: string, val: i64) void {
    var key: string = base__sb_cat2(ename, base__sb_cat2(".", mname));
    var i: i64 = 0;
    var n: i64 = slice_len(g_enum_cn) as i64;
    while (i < n) {
        if (g_enum_cn[i] == key) { g_enum_cvi[i] = val; return; }
        i = i + 1;
    }
    append(g_enum_cn, key);
    append(g_enum_cvi, val);
}

// 编译期解析 `Enum.Member`：对象须是枚举类型，且成员已折出编译期整型值。
pub fn meta_eval_member(e: i64) i64 {
    var obj_e: i64 = base.node_na((e as u64));
    if (obj_e < 0) {
        return meta_fail("T-MTA-E617", "编译期成员访问缺少对象", e);
    }
    // 通用 comptime 值：先试 struct_lit（结构体值）/ ct_variant（变体值）
    var obj: i64 = meta_eval(obj_e);
    if (obj < 0) { return -1; }
    var ok: string = base.node_kind((obj as u64));
    if (ok == "struct_lit") {
        // 字段查找：在 FV 链按 sa 匹配
        var fnm: string = base.node_sa((e as u64));
        var ks: []i64 = base.kids_chain_idx(base.node_la((obj as u64)));
        var ki: i64 = 0;
        while (ki < slice_len(ks) as i64) {
            var fv: i64 = base__kids[ks[ki]].val;
            if (base.node_kind((fv as u64)) == "FV" and base.node_sa((fv as u64)) == fnm) {
                return base.node_na((fv as u64));   // 字段值
            }
            ki = ki + 1;
        }
        return meta_fail("T-MTA-E617", base__sb_cat3("编译期结构体无此字段 `", fnm, "`"), e);
    }
    if (ok == "ct_variant") {
        // 变体 case 提取：e.sa 须等于 variant tag（sb）
        if (base.node_sa((e as u64)) == base.node_sb((obj as u64))) {
            return base.node_na((obj as u64));   // 载荷
        }
        return meta_fail("T-MTA-E617",
            base__sb_cat5("编译期变体 case 不匹配：期望 `", base.node_sb((obj as u64)),
                "`，得到 `", base.node_sa((e as u64)), "`"), e);
    }
    // 退回：Enum.Member（原有逻辑）
    if (base.node_kind((obj_e as u64)) != "ident") {
        return meta_fail("T-MTA-E617", "编译期成员访问的对象须是具名类型", e);
    }
    var si: i64 = sym_lookup(global_scope, base.node_sa((obj_e as u64)));
    if (si < 0) {
        return meta_fail("T-MTA-E617", base__sb_cat3("未定义的类型 `", base.node_sa((obj_e as u64)), "`"), e);
    }
    var sy: Sym = syms[si];
    if (sy.decl < 0 or base.node_kind((sy.decl as u64)) != "EnumDecl") {
        return meta_fail("T-MTA-E617",
            base__sb_cat3("编译期成员访问仅支持枚举常量（`", base.node_sa((obj_e as u64)), "` 不是枚举）"), e);
    }
    var cv: i64 = enum_const_lookup(base.node_sa((obj_e as u64)), base.node_sa((e as u64)));
    if (cv < 0) {
        return meta_fail("T-MTA-E617",
            base__sb_cat5("枚举 `", base.node_sa((obj_e as u64)), "` 的成员 `", base.node_sa((e as u64)),
                "` 尚无编译期值（成员须先定义，且为编译期常量）"), e);
    }
    return cv;
}

// 深度守卫包装层：递归调用仍走 `meta_eval`（自动累加深度），仅最外层（depth==1）
// 且预算已耗尽时补充 500000，避免共享预算在语义分析期（早于 meta_pass 的 500000 重置）
// 直接归零、导致合法 const 求值误报 T-MTA-E612。递归链不补预算，故不终止的 comptime
// 循环（tests/conformance/fail/f66_meta_budget.tc）仍会被 500000 步预算截断。
pub fn meta_eval(e: i64) i64 {
    g_me_depth = g_me_depth + 1;
    if (g_me_depth == 1 and g_meta_steps <= 0) { g_meta_steps = 500000; g_me_count = 0; }
    var r: i64 = meta_eval_rec(e);
    g_me_depth = g_me_depth - 1;
    return r;
}

pub fn meta_eval_rec(e: i64) i64 {
    if (e < 0) { return -1; }
    if (g_meta_err) { return -1; }
    g_meta_steps = g_meta_steps - 1;
    if (g_meta_steps <= 0) {
        return meta_fail("T-MTA-E612",
            "编译期求值步数超预算（疑似不终止的 meta 循环或递归）", e);
    }
    if (base.node_kind((e as u64)) == "int" or base.node_kind((e as u64)) == "string" or base.node_kind((e as u64)) == "bool") { return e; }
    // 一等子句 `@clause(...)`：编译期求值**恒等** —— 返回节点自身，绝不递归进入
    // pattern / guard / body 子树（那是 AST 位置，见 parse.parse_clause_lit 注释）。
    // 这是「求值」与「展开」的分界：求值到此为止，展开是 §5.4 的事。
    if (base.node_kind((e as u64)) == "clause") { return e; }
    // P5: 浮点字面量即编译期值——与 int/bool/string 同款，值以 `sa` 文本承载。
    //     变体 f64 载荷因此可直通构造/提取；浮点算术/比较留待 Phase B.2。
    if (base.node_kind((e as u64)) == "float") { return e; }
    if (base.node_kind((e as u64)) == "paren" or base.node_kind((e as u64)) == "comptime") { return meta_eval(base.node_na((e as u64))); }
    if (base.node_kind((e as u64)) == "ident") {
        var si: i64 = menv_find(base.node_sa((e as u64)));
        if (si < 0) {
            // P4 类型即值：裸类型名作为编译期值（如 `return i64;` / `return Point;`）。
            if (is_type_name(base.node_sa((e as u64)))) {
                return type_node_from_ident(base.node_sa((e as u64)));
            }
        // S3/Q1：引用「持有 type 值的局部变量」（var x: type = ...）→ 返回其编译期 type 值节点
        var cvi2: i64 = cvar_find(base.node_sa((e as u64)));
        if (cvi2 >= 0) { return g_cvar_val[cvi2]; }
        // P2b：引用「持有 type 值的全局 const」（const I = @int(...)）→ 在编译期求值其初始化器，
        // 还原出 type 值节点（Zig 式 type-as-value：const 类型值在类型位置可直接当类型用）。
        // 仅在 menv/cvar/裸类型名都查不到时回退，且由 g_meta_steps 预算防自引用死循环。
        // const 只求值一次：结果缓存回节点的 la 字段（GlobalConstDecl 的 la 未被占用），
        // 避免同一 const 被多处引用时反复构造 synthetic 类型、耗尽 g_meta_steps 预算。
        var gci: i64 = sym_lookup(global_scope, base.node_sa((e as u64)));
        if (gci >= 0) {
            var gsy: Sym = syms[gci];
            if (gsy.decl >= 0 and base.node_kind((gsy.decl as u64)) == "GlobalConstDecl") {
                var cached: i64 = base.node_la((gsy.decl as u64));
                if (cached >= 0) { return cached; }
                var cinit: i64 = base.node_nb((gsy.decl as u64));
                if (cinit >= 0) {
                    var cv: i64 = meta_eval(cinit);
                    if (cv >= 0) { base.node_set_la((gsy.decl as u64), cv); return cv; }
                }
            }
        }
    // T-CLO-E781：逃逸 meta fn 自身实体到运行期（如 `meta pure` 取函数本身而非返回值）
        // 应被明确拒绝，而非误报「读运行期变量」。
        var sfn: i64 = sym_lookup(global_scope, base.node_sa((e as u64)));
        if (sfn >= 0) {
            var syf: Sym = syms[sfn];
            if (syf.decl >= 0 and base.node_kind((syf.decl as u64)) == "FuncDecl" and base__node_bb((syf.decl as u64)) == true) {
                return meta_fail("T-CLO-E781",
                    base__sb_cat3("`", base.node_sa((e as u64)), "` 是编译期函数，不能作为运行期函数值逃逸（其函数体仅存在于编译期）"), e);
            }
            // P5 无捕获闭包逃逸：裸函数名指代一个被提升的合成 lambda（`sc == "__lambda__"`）
            // 即「无捕获闭包」的运行期值。它本就是顶层 FuncDecl，两个后端都会经 clos_decl_of /
            // llfn_find 把它当函数值处理（&__tclos_x / @t.clos.x），直接把这个 ident 作为运行期
            // 函数值返回即可——无需套 closure_make（那需要 env 结构，而「无捕获」合成函数没有 env，
            // 套上去反而让 LLVM/C 后端生成空 env 结构而崩）。
            if (syf.decl >= 0 and base.node_kind((syf.decl as u64)) == "FuncDecl" and base__node_sc((syf.decl as u64)) == "__lambda__") {
                return e;
            }
        }
        return meta_fail("T-MTA-E620",
            base__sb_cat3("`", base.node_sa((e as u64)), "` 不是编译期已知实体（meta 上下文禁止读运行期变量）"), e);
        }
        if (g_menv_ty[si] >= 0) {
            return meta_fail("T-MTA-E608",
                base__sb_cat3("`", base.node_sa((e as u64)), "` 是类型参数，不能当值用（可用 `@type_name` / `@type_size` 查询）"), e);
        }
        return g_menv_val[si];
    }
    if (base.node_kind((e as u64)) == "unary") { return meta_eval_unary(e); }
    if (base.node_kind((e as u64)) == "binary") { return meta_eval_binary(e); }
    if (base.node_kind((e as u64)) == "cast") {
        var cv: i64 = meta_eval(base.node_na((e as u64)));
        if (cv < 0) { return -1; }
        if (base.node_kind((base.node_nb((e as u64)) as u64)) != "scalar") {
            return meta_fail("T-MTA-E617", "编译期类型转换仅支持标量目标类型", e);
        }
        var tname: string = base.node_sa((base.node_nb((e as u64)) as u64));
        // 目标：浮点
        if (tname == "f64" or tname == "f32") {
            if (base.node_kind((cv as u64)) == "float") { return cv; }
            if (base.node_kind((cv as u64)) == "int" or base.node_kind((cv as u64)) == "bool") {
                return base__mk_float(meta_f64_to_str(mv_get_int(cv) as f64), -1);
            }
            return meta_fail("T-MTA-E617",
                "编译期向浮点的转换操作数须为 int / bool / float", e);
        }
        // 目标：bool
        if (tname == "bool") {
            if (base.node_kind((cv as u64)) != "bool") {
                return meta_fail("T-MTA-E617", "编译期不支持向 bool 的隐式窄化", e);
            }
            return cv;
        }
        // 目标：整数
        if (meta_is_int_type(tname) == false) {
            return meta_fail("T-MTA-E617",
                base__sb_cat3("编译期类型转换暂不支持目标类型 `", tname, "`"), e);
        }
        if (base.node_kind((cv as u64)) == "int") { return mv_int(meta_int_wrap(mv_get_int(cv), tname)); }
        if (base.node_kind((cv as u64)) == "bool") { return mv_int(meta_int_wrap(mv_get_int(cv), tname)); }
        if (base.node_kind((cv as u64)) == "float") {
            return mv_int(meta_f64_to_int(meta_f64_from_str(base.node_sa((cv as u64)))));
        }
        return meta_fail("T-MTA-E617", "编译期整数转换的操作数须为 int / bool / float", e);
    }
    if (base.node_kind((e as u64)) == "call") { return meta_eval_call(e); }
    if (base.node_kind((e as u64)) == "mbuiltin") { return meta_eval_mbuiltin(e); }
    if (base.node_kind((e as u64)) == "closure_make") { return meta_eval_closure_make(e); }
    if (base.node_kind((e as u64)) == "member") { return meta_eval_member(e); }
    if (base.node_kind((e as u64)) == "array_lit") { return meta_eval_array_lit(e); }
    if (base.node_kind((e as u64)) == "index") { return meta_eval_index(e); }
    if (base.node_kind((e as u64)) == "struct_lit") { return meta_eval_struct_lit(e); }
    if (base.node_kind((e as u64)) == "match") { return meta_eval_match(e); }
    if (base.node_kind((e as u64)) == "typeinfo") {
        // @type_info(T) / type_info(T) 在编译期返回 TypeInfo variant 值（通用 comptime 值模型，阶段1 S5）。
        // typeinfo 节点的 sa 即类型名；构造 ct_variant{ "TypeInfo", <arm>, payload }，
        // payload 为 TypeMeta 结构体值（含 field_types: []type），使
        // `@type_info(Point).Struct.field_types[0] == i64` 与 `inline for (...field_types) |F|` 成立。
        // 与运行时 TIR_OP_TYPEINFO 发射路径互不干扰（meta_eval 只在 comptime 上下文被调用）。
        // 优先用 parser 存于 na 的完整类型节点（覆盖 pointer/slice/array/func/optional 等
        // 合成类型，其 sa 为空无法仅凭名字分类）；na 缺失时回落 sa → type_node_from_ident。
        var tnode: i64 = base.node_na((e as u64));
        if (tnode < 0) {
            var tname: string = base.node_sa((e as u64));
            tnode = type_node_from_ident(tname);
        }
        var arm: string = ti_arm_of(tnode);
        ensure_reflection_builtins();
        var payload: i64 = build_typemeta_value(tnode, arm);
        var r: i64 = base.mk_ct_variant("TypeInfo", arm, payload);
        base.node_set_type(r, g_ti_TypeInfo_ti);
        return r;
    }
    return meta_fail("T-MTA-E617",
        base__sb_cat3("表达式 `", base.node_kind((e as u64)), "` 不可编译期求值"), e);
}

// ── 编译期数组值 ────────────────────────────────────────────
// 表示：一个 array_lit 节点，元素全是字面量节点。**每次求值都新造节点**——
// 同一处 AST 会被循环 / 多次调用反复求值，复用节点会让元素赋值污染模板。

// 链表里第 idx 个 Child 的**下标**（不是 val，赋值要回写 Child）；-1 = 越界
pub fn meta_kid_at(head: i64, idx: i64) i64 {
    if (idx < 0) { return -1; }
    var c: i64 = head;
    var i: i64 = 0;
    var mq_ks11071: []i64 = base.kids_chain_idx(head);
    var mq_ki11071: i64 = 0;
    while (mq_ki11071 < slice_len(mq_ks11071) as i64) {
        c = mq_ks11071[mq_ki11071];
        if (i == idx) { return c; }
        i = i + 1;
        mq_ki11071 = mq_ki11071 + 1;
        c = -1;
    }
    return -1;
}

// 绑定处的值拷贝：t 的数组是**值类型**，`var b = a;` / 传参不能与源共享节点，
// 否则 `b[0] = x` 会顺带改掉 a。标量字面量不可变，原样返回。
pub fn meta_val_copy(v: i64) i64 {
    if (v < 0) { return -1; }
    var k: string = base.node_kind((v as u64));
    if (k == "struct_lit") {
        // 递归拷贝字段值（FV 链）
        var h: i64 = -1;
        var t: i64 = -1;
        var ks: []i64 = base.kids_chain_idx(base.node_la((v as u64)));
        var ki: i64 = 0;
        while (ki < slice_len(ks) as i64) {
            var fv: i64 = base__kids[ks[ki]].val;
            var cv: i64 = base__mk_FV(base.node_sa((fv as u64)), meta_val_copy(base.node_na((fv as u64))), -1);
            t = base__list_push(h, t, cv);
            if (h < 0) { h = t; }
            ki = ki + 1;
        }
        return base__mk_struct_lit(base.node_sa((v as u64)), h, -1);
    }
    if (k == "ct_variant") {
        var pl: i64 = -1;
        if (base.node_na((v as u64)) >= 0) { pl = meta_val_copy(base.node_na((v as u64))); }
        return base.mk_ct_variant(base.node_sa((v as u64)), base.node_sb((v as u64)), pl);
    }
    if (k != "array_lit") { return v; }
    var h: i64 = -1;
    var t: i64 = -1;
    var c: i64 = base.node_la((v as u64));
    var mq_ks11087: []i64 = base.kids_chain_idx(base.node_la((v as u64)));
    var mq_ki11087: i64 = 0;
    while (mq_ki11087 < slice_len(mq_ks11087) as i64) {
        c = mq_ks11087[mq_ki11087];
        var ev: i64 = meta_val_copy(base__kids[c].val);
        t = base__list_push(h, t, ev);
        if (h < 0) { h = t; }
        mq_ki11087 = mq_ki11087 + 1;
        c = -1;
    }
    return base__mk_array_lit(h, -1);
}

pub fn meta_eval_array_lit(e: i64) i64 {
    var h: i64 = -1;
    var t: i64 = -1;
    var c: i64 = base.node_la((e as u64));
    var mq_ks11100: []i64 = base.kids_chain_idx(base.node_la((e as u64)));
    var mq_ki11100: i64 = 0;
    while (mq_ki11100 < slice_len(mq_ks11100) as i64) {
        c = mq_ks11100[mq_ki11100];
        var ev: i64 = meta_eval(base__kids[c].val);
        if (ev < 0) { return -1; }
        t = base__list_push(h, t, ev);
        if (h < 0) { h = t; }
        mq_ki11100 = mq_ki11100 + 1;
        c = -1;
    }
    return base__mk_array_lit(h, -1);
}

// P5（comptime 闭包逃逸）：捕获型闭包在 check 期已被提升成 closure_make 节点
// （sa=合成函数名，sb=环境结构名，la=捕获量 ident 链）。编译期求值时，la 链里的捕获
// ident 在当前 menv 里已是已知编译期值（或其本身又是已物化的 comptime 闭包），
// 故逐一对 la 链里的捕获节点做 meta_eval，把结果（字面量 / 嵌套 closure_make）包进
// closure_capval（sa=环境字段名，na=已物化值），串成新的 la 链；返回一个
// 「捕获量已物化」的 closure_make。sa/sb 沿用被提升的合成函数与环境结构，于是运行时
// 只需按 closure_make 既有路径堆分配 env、拷入捕获量、造 TClosure——捕获值已在编译期落定。
// 嵌套闭包：meta_eval(捕获量) 递归进 meta_eval_closure_make，自然递推展开（见 p60 make_pair）。
pub fn meta_eval_closure_make(e: i64) i64 {
    var h: i64 = -1;
    var t: i64 = -1;
    var c: i64 = base.node_la((e as u64));
    var mq_ks11122: []i64 = base.kids_chain_idx(base.node_la((e as u64)));
    var mq_ki11122: i64 = 0;
    while (mq_ki11122 < slice_len(mq_ks11122) as i64) {
        c = mq_ks11122[mq_ki11122];
        var capname: string = base.node_sa((base__kids[c].val as u64));          // 环境字段名（须保留给 emit 写 env->field）
        var cv: i64 = meta_eval(base__kids[c].val);  // 编译期物化值：字面量 / 嵌套 closure_make
        if (cv < 0) { return -1; }
        var p: i64 = base__mk_closure_capval(capname, cv, -1);
        t = base__list_push(h, t, p);
        if (h < 0) { h = t; }
        mq_ki11122 = mq_ki11122 + 1;
        c = -1;
    }
    var cm: i64 = base__mk_closure_make(base.node_sa((e as u64)), h, -1);
    base.node_set_sb((cm as u64), base.node_sb((e as u64)));
    return cm;
}

pub fn meta_eval_index(e: i64) i64 {
    var b: i64 = meta_eval(base.node_na((e as u64)));
    if (b < 0) { return -1; }
    var iv: i64 = meta_eval(base.node_nb((e as u64)));
    if (iv < 0) { return -1; }
    var idx: i64 = mv_get_int(iv);
    if (base.node_kind((b as u64)) == "string") {
        if (idx < 0 or idx >= (str_len(base.node_sa((b as u64))) as i64)) {
            return meta_fail("T-MTA-E602", "编译期字符串下标越界", e);
        }
        return mv_int(str_at(base.node_sa((b as u64)), idx) as i64);
    }
    if (base.node_kind((b as u64)) != "array_lit") {
        return meta_fail("T-MTA-E617", "编译期下标访问的对象须是数组或字符串", e);
    }
    var ci: i64 = meta_kid_at(base.node_la((b as u64)), idx);
    if (ci < 0) {
        return meta_fail("T-MTA-E602", "编译期数组下标越界", e);
    }
    return base__kids[ci].val;
}

// 编译期结构体字面量：递归求值每个字段（FV 节点：sa=字段名, na=值），
// 重建 struct_lit。类型名 sa 原样保留 —— comptime_fold 在 run_check
// 之后运行，模块限定已解析进 sa（mangled 名），无需处理 sb。
pub fn meta_eval_struct_lit(e: i64) i64 {
    var h: i64 = -1;
    var t: i64 = -1;
    var c: i64 = base.node_la((e as u64));
    var mq_ks11165: []i64 = base.kids_chain_idx(base.node_la((e as u64)));
    var mq_ki11165: i64 = 0;
    while (mq_ki11165 < slice_len(mq_ks11165) as i64) {
        c = mq_ks11165[mq_ki11165];
        if (base.node_kind((base__kids[c].val as u64)) != "FV") {
            return meta_fail("T-MTA-E617", "编译期结构体字面量字段须为 field-value 节点", e);
        }
        var fv_val: i64 = meta_eval(base.node_na((base__kids[c].val as u64)));
        if (fv_val < 0) { return -1; }
        var nfv: i64 = base__mk_FV(base.node_sa((base__kids[c].val as u64)), fv_val, -1);
        t = base__list_push(h, t, nfv);
        if (h < 0) { h = t; }
        mq_ki11165 = mq_ki11165 + 1;
        c = -1;
    }
    var lit: i64 = base__mk_struct_lit(base.node_sa((e as u64)), h, -1);
    return lit;
}

// 编译期数组 → string（取前 len 字节）。-1 = 失败（已报错）
pub fn meta_bytes_to_str(e: i64, av: i64, lv: i64) i64 {
    if (base.node_kind((av as u64)) == "string") {
        // 允许直接传字符串（等价于截断）
        var cut: i64 = mv_get_int(lv);
        if (cut < 0 or cut > (str_len(base.node_sa((av as u64))) as i64)) {
            return meta_fail("T-MTA-E602", "编译期字节转字符串的长度越界", e);
        }
        var sbs: StringBuilder = sb_new();
        var q: i64 = 0;
        while (q < cut) {
            sb_append_char(sbs, str_at(base.node_sa((av as u64)), q));
            q = q + 1;
        }
        return base__mk_string(sb_to_str(sbs), -1);
    }
    if (base.node_kind((av as u64)) != "array_lit") {
        return meta_fail("T-MTA-E617", "编译期字节缓冲区须是数组值", e);
    }
    var ln: i64 = mv_get_int(lv);
    if (ln < 0) {
        return meta_fail("T-MTA-E602", "编译期字节转字符串的长度为负", e);
    }
    var sb: StringBuilder = sb_new();
    var i: i64 = 0;
    var c: i64 = base.node_la((av as u64));
    while (i < ln) {
        if (c < 0) {
            return meta_fail("T-MTA-E602", "编译期字节转字符串的长度超出缓冲区", e);
        }
        if (base.node_kind((base__kids[c].val as u64)) != "int" and base.node_kind((base__kids[c].val as u64)) != "bool") {
            return meta_fail("T-MTA-E617", "编译期字节缓冲区的元素须是整数", e);
        }
        sb_append_char(sb, (mv_get_int(base__kids[c].val) % 256) as u8);
        i = i + 1;
        c = base__kids[c].next;
    }
    return base__mk_string(sb_to_str(sb), -1);
}

pub fn meta_eval_unary(e: i64) i64 {
    var v: i64 = meta_eval(base.node_na((e as u64)));
    if (v < 0) { return -1; }
    if (base.node_sa((e as u64)) == "+") {
        if (base.node_kind((v as u64)) == "float") { return v; }
        if (base.node_kind((v as u64)) != "int") { return meta_fail("T-MTA-E617", "一元 `+` 的操作数须为整数或浮点", e); }
        return v;
    }
        if (base.node_sa((e as u64)) == "-") {
            if (base.node_kind((v as u64)) == "float") {
                // IEEE-754 特殊值：t 无 inf/nan 的数值字面量，统一以文本承载；
                // 取负按位模式翻转（与 codegen_ll 浮点字面量发射器保持一致）。
                if (base.node_sa((v as u64)) == "inf") { return base__mk_float("-inf", -1); }
                if (base.node_sa((v as u64)) == "-inf") { return base__mk_float("inf", -1); }
                if (base.node_sa((v as u64)) == "nan") { return base__mk_float("nan", -1); }
                if (base.node_sa((v as u64)) == "-nan") { return base__mk_float("nan", -1); }
                return base__mk_float(meta_f64_to_str( 0.0 - meta_f64_from_str(base.node_sa((v as u64)))), -1);
            }
        if (base.node_kind((v as u64)) != "int") { return meta_fail("T-MTA-E617", "一元 `-` 的操作数须为整数或浮点", e); }
        return mv_int(0 - mv_get_int(v));
    }
    if (base.node_sa((e as u64)) == "~") {
        if (base.node_kind((v as u64)) != "int") { return meta_fail("T-MTA-E617", "一元 `~` 的操作数须为整数", e); }
        return mv_int(0 - mv_get_int(v) - 1);
    }
    if (base.node_sa((e as u64)) == "!") {
        if (base.node_kind((v as u64)) != "bool") { return meta_fail("T-MTA-E617", "一元 `!` 的操作数须为 bool", e); }
        return mv_bool(base.node_ba((v as u64)) == false);
    }
    return meta_fail("T-MTA-E617", base__sb_cat3("编译期不支持一元算子 `", base.node_sa((e as u64)), "`"), e);
}

// ── 编译期浮点辅助（Phase B.2）─────────────────────────────
// string -> f64：覆盖常用十进制字面量（符号 / 整数部 / 小数部 / 指数）。
// 仅用于编译期常量折叠；正常字面量可经 %.17g 精确往返。
pub fn meta_f64_from_str(s: string) f64 {
    var i: i64 = 0;
    var n: i64 = str_len(s);
    var neg: bool = false;
    if (i < n and (str_at(s, i) as i64) == 45) { neg = true; i = i + 1; }   // '-'
    else if (i < n and (str_at(s, i) as i64) == 43) { i = i + 1; }           // '+'
    var val: f64 = 0.0;
    var frac: bool = false;
    var fscale: f64 = 0.1;
    var exp: i64 = 0;
    var have_exp: bool = false;
    while (i < n) {
        var ci: i64 = str_at(s, i) as i64;
        if (ci == 46) {   // '.'
            if (frac or have_exp) { break; }
            frac = true; i = i + 1; continue;
        }
        if (ci == 101 or ci == 69) {   // 'e' / 'E'
            if (have_exp) { break; }
            have_exp = true; i = i + 1;
            var esign: i64 = 1;
            if (i < n and (str_at(s, i) as i64) == 45) { esign = -1; i = i + 1; }
            else if (i < n and (str_at(s, i) as i64) == 43) { i = i + 1; }
            var ev: i64 = 0;
            while (i < n) {
                var ec: i64 = str_at(s, i) as i64;
                if (ec >= 48 and ec <= 57) { ev = ev * 10 + (ec - 48); i = i + 1; }
                else { break; }
            }
            exp = esign * ev;
            break;
        }
        if (ci >= 48 and ci <= 57) {
            var d: i64 = ci - 48;
            if (frac) { val = val + ((d as f64) * fscale); fscale = fscale * 0.1; }
            else { val = (val * 10.0) + (d as f64); }
            i = i + 1; continue;
        }
        break;
    }
    if (exp > 0) { var k: i64 = 0; while (k < exp) { val = val * 10.0; k = k + 1; } }
    else if (exp < 0) { var k: i64 = 0; while (k > exp) { val = val / 10.0; k = k - 1; } }
    if (neg) { val = 0.0 - val; }
    return val;
}

// f64 -> i64：向零截断（与 C 的 (long long) 语义一致）
pub fn meta_f64_to_int(x: f64) i64 {
    var neg: bool = (x < 0.0);
    var ax: f64 = x;
    if (neg) { ax = 0.0 - ax; }
    var i: i64 = 0;
    while (((i as f64) + 1.0) <= ax) { i = i + 1; }
    if (neg) { i = 0 - i; }
    return i;
}

// f64 -> 字面量字符串（%.17g，精确保持与运行期一致）。
// 发射期的「无小数点补 .0」由 codegen_ll 浮点字面量发射器兜底（见该文件 11xx 行），
// 故此处直接返回格式化结果即可，无需自行拼接。
pub fn meta_f64_to_str(v: f64) string {
    return format_float(".17g", v);
}

// S1/Q1：meta 值节点是否表示一个「类型值」（scalar/named 且名字是已声明类型）。
// 仅 type_node_from_ident 产出的 scalar/named 节点满足；其它 named 值（如 struct/enum 实值）不会误判。
pub fn meta_node_is_type(e: i64) bool {
    if (e < 0) { return false; }
    var k: string = base.node_kind((e as u64));
    if (k != "scalar" and k != "named") { return false; }
    return is_type_name(base.node_sa((e as u64)));
}

pub fn meta_eval_binary(e: i64) i64 {
    var op: string = base.node_sa((e as u64));
    // bool 逻辑（§set-ops 改名）：`and` / `or` 短路
    if (op == "and" or op == "or") {
        var l0: i64 = meta_eval(base.node_na((e as u64)));
        if (l0 < 0) { return -1; }
        if (base.node_kind((l0 as u64)) != "bool") {
            return meta_fail("T-MTA-E617", "`and` / `or` 的操作数须为 bool", e);
        }
        if (op == "and" and base.node_ba((l0 as u64)) == false) { return mv_bool(false); }
        if (op == "or" and base.node_ba((l0 as u64))) { return mv_bool(true); }
        var r0: i64 = meta_eval(base.node_nb((e as u64)));
        if (r0 < 0) { return -1; }
        if (base.node_kind((r0 as u64)) != "bool") {
            return meta_fail("T-MTA-E617", "`and` / `or` 的操作数须为 bool", e);
        }
        return mv_bool(base.node_ba((r0 as u64)));
    }
    // 集合代数 `&&` / `||`（§set-ops）：bitstr/flag 交集/并集，第一批为运行期语义，
    // comptime 不折叠（返回 -1，交运行期求值；与 `++` 同策略）。
    if (op == "&&" or op == "||") { return -1; }
    var lv: i64 = meta_eval(base.node_na((e as u64)));
    if (lv < 0) { return -1; }
    var rv: i64 = meta_eval(base.node_nb((e as u64)));
    if (rv < 0) { return -1; }
    if (base.node_kind((lv as u64)) == "string" or base.node_kind((rv as u64)) == "string") {
        if (base.node_kind((lv as u64)) != "string" or base.node_kind((rv as u64)) != "string") {
            return meta_fail("T-MTA-E617", "编译期字符串只能与字符串比较", e);
        }
        if (op == "==") { return mv_bool(base.node_sa((lv as u64)) == base.node_sa((rv as u64))); }
        if (op == "!=") { return mv_bool(base.node_sa((lv as u64)) != base.node_sa((rv as u64))); }
        if (op == "+") {
            var sbs: StringBuilder = sb_new();
            sb_append_str(sbs, base.node_sa((lv as u64)));
            sb_append_str(sbs, base.node_sa((rv as u64)));
            return base__mk_string(sb_to_str(sbs), -1);
        }
        return meta_fail("T-MTA-E617",
            base__sb_cat3("编译期字符串不支持算子 `", op, "`"), e);
    }
    if (base.node_kind((lv as u64)) == "bool" and base.node_kind((rv as u64)) == "bool") {
        if (op == "==") { return mv_bool(base.node_ba((lv as u64)) == base.node_ba((rv as u64))); }
        if (op == "!=") { return mv_bool(base.node_ba((lv as u64)) != base.node_ba((rv as u64))); }
        return meta_fail("T-MTA-E617", base__sb_cat3("bool 不支持编译期算子 `", op, "`"), e);
    }
    // 浮点运算：float×float 或 float×int（int 提升为 float）
    if (base.node_kind((lv as u64)) == "float" or base.node_kind((rv as u64)) == "float") {
        if (base.node_kind((lv as u64)) != "float" and base.node_kind((lv as u64)) != "int") {
            return meta_fail("T-MTA-E617", "编译期浮点运算的左操作数须为 float 或 int", e);
        }
        if (base.node_kind((rv as u64)) != "float" and base.node_kind((rv as u64)) != "int") {
            return meta_fail("T-MTA-E617", "编译期浮点运算的右操作数须为 float 或 int", e);
        }
        var fa: f64 = 0.0;
        var fb: f64 = 0.0;
        // T-MTA-E617：操作数本身已是 inf/nan 文本形态（溢出后经字符串往返得到）→ 硬错误
        if (base.node_kind((lv as u64)) == "float"
            and (base.node_sa((lv as u64)) == "inf" or base.node_sa((lv as u64)) == "-inf" or base.node_sa((lv as u64)) == "nan" or base.node_sa((lv as u64)) == "-nan")) {
            return meta_fail("T-MTA-E617", "编译期浮点运算的操作数含 inf/nan", e);
        }
        if (base.node_kind((rv as u64)) == "float"
            and (base.node_sa((rv as u64)) == "inf" or base.node_sa((rv as u64)) == "-inf" or base.node_sa((rv as u64)) == "nan" or base.node_sa((rv as u64)) == "-nan")) {
            return meta_fail("T-MTA-E617", "编译期浮点运算的操作数含 inf/nan", e);
        }
        if (base.node_kind((lv as u64)) == "float") { fa = meta_f64_from_str(base.node_sa((lv as u64))); }
        else { fa = mv_get_int(lv) as f64; }
        if (base.node_kind((rv as u64)) == "float") { fb = meta_f64_from_str(base.node_sa((rv as u64))); }
        else { fb = mv_get_int(rv) as f64; }
        // T-MTA-E617：浮点二元运算操作数含 inf/nan 一律硬错误（不得折叠出垃圾值）
        if (fa != fa or fb != fb
            or fa > 1e308 or fa < -1e308 or fb > 1e308 or fb < -1e308) {
            return meta_fail("T-MTA-E617", "编译期浮点运算的操作数含 inf/nan", e);
        }
        if (op == "+") { var r: f64 = fa + fb; if (r != r or r > 1e308 or r < -1e308) { return meta_fail("T-MTA-E617", "编译期浮点运算溢出（结果含 inf/nan）", e); } return base__mk_float(meta_f64_to_str(r), -1); }
        if (op == "-") { var r: f64 = fa - fb; if (r != r or r > 1e308 or r < -1e308) { return meta_fail("T-MTA-E617", "编译期浮点运算溢出（结果含 inf/nan）", e); } return base__mk_float(meta_f64_to_str(r), -1); }
        if (op == "*") { var r: f64 = fa * fb; if (r != r or r > 1e308 or r < -1e308) { return meta_fail("T-MTA-E617", "编译期浮点运算溢出（结果含 inf/nan）", e); } return base__mk_float(meta_f64_to_str(r), -1); }
        if (op == "/") {
            if (fb == 0.0) { return meta_fail("T-MTA-E614", "编译期浮点除零", e); }
            var r: f64 = fa / fb; if (r != r or r > 1e308 or r < -1e308) { return meta_fail("T-MTA-E617", "编译期浮点运算溢出（结果含 inf/nan）", e); } return base__mk_float(meta_f64_to_str(r), -1);
        }
        if (op == "==") { return mv_bool(fa == fb); }
        if (op == "!=") { return mv_bool(fa != fb); }
        if (op == "<") { return mv_bool(fa < fb); }
        if (op == "<=") { return mv_bool(fa <= fb); }
        if (op == ">") { return mv_bool(fa > fb); }
        if (op == ">=") { return mv_bool(fa >= fb); }
        return meta_fail("T-MTA-E617", base__sb_cat3("编译期不支持浮点算子 `", op, "`"), e);
    }
    // S1/Q1：type 值间 == / != 按规范名比较（Zig 式 type 一等值）。
    // 须排在最后的 int 兜底之前：两操作数均为 type 值节点时走此分支，互不干扰既有标量/字符串/浮点规则。
    if (meta_node_is_type(lv) and meta_node_is_type(rv)) {
        if (op == "==") { return mv_bool(base.node_sa((lv as u64)) == base.node_sa((rv as u64))); }
        if (op == "!=") { return mv_bool(base.node_sa((lv as u64)) != base.node_sa((rv as u64))); }
        return meta_fail("T-MTA-E617", base__sb_cat3("type 值不支持编译期算子 `", op, "`"), e);
    }
    if (base.node_kind((lv as u64)) != "int" or base.node_kind((rv as u64)) != "int") {
        return meta_fail("T-MTA-E617", "编译期二元运算的操作数类型不一致", e);
    }
    var a: i64 = mv_get_int(lv);
    var b: i64 = mv_get_int(rv);
    if (op == "+") { return mv_int(a + b); }
    if (op == "-") { return mv_int(a - b); }
    if (op == "*") { return mv_int(a * b); }
    if (op == "/") {
        if (b == 0) { return meta_fail("T-MTA-E614", "编译期除零", e); }
        return mv_int(a / b);
    }
    if (op == "%") {
        if (b == 0) { return meta_fail("T-MTA-E614", "编译期取模除零", e); }
        return mv_int(a % b);
    }
    if (op == "&") { return mv_int(a & b); }
    if (op == "|") { return mv_int(a | b); }
    if (op == "^") { return mv_int(a ^ b); }
    if (op == "<<") { return mv_int(a << b); }
    if (op == ">>") { return mv_int(a >> b); }
    if (op == "==") { return mv_bool(a == b); }
    if (op == "!=") { return mv_bool(a != b); }
    if (op == "<") { return mv_bool(a < b); }
    if (op == "<=") { return mv_bool(a <= b); }
    if (op == ">") { return mv_bool(a > b); }
    if (op == ">=") { return mv_bool(a >= b); }
    return meta_fail("T-MTA-E617", base__sb_cat3("编译期不支持二元算子 `", op, "`"), e);
}

// 编译期调用：被调方必须是 `meta fn`（第 3 条 —— 编译期执行须显式声明）
// ── 编译期内建 ──────────────────────────────────────────────
// 只开放两类：
//   ① 编译期日志  print / eprint —— 一律写 stderr。
//      stdout 是机器可读通道（check 的 JSON、emit-ll 的 IR），
//      conformance 对 stdout 做跨编译器逐字节对拍，编译期日志绝不能污染它。
//      故 print 与 eprint 在编译期同义，这是有意为之。
//   ② 纯函数    int_to_str / i2s / str_len / str_at
// 触碰运行期世界的内建（file_* / sys_run / args / exit / path_resolve）一律拒绝：
// 宪法第 8 条 —— 编译期不得访问运行期世界；第 7 条 —— 求值必须可复现。
pub fn meta_builtin_impure(name: string) bool {
    if (name == "file_read_all" or name == "file_write_all" or name == "file_exists") { return true; }
    if (name == "sys_run" or name == "args" or name == "exit") { return true; }
    if (name == "path_resolve") { return true; }
    return false;
}

// ── 编译期数学内建（@sin / @sinf / ...）── 纯 t 实现，供 meta_eval 折叠常数实参 ──
pub fn math_mbuiltin(name: string) bool {
    if (name == "sin" or name == "sinf" or name == "cos" or name == "cosf" or name == "tan" or name == "tanf"
        or name == "atan" or name == "atanf" or name == "atan2" or name == "atan2f" or name == "acos" or name == "acosf"
        or name == "asin" or name == "asinf" or name == "exp" or name == "expf" or name == "log" or name == "logf"
        or name == "log10" or name == "log10f" or name == "pow" or name == "powf" or name == "sinh" or name == "sinhf"
        or name == "cosh" or name == "coshf" or name == "tanh" or name == "tanhf" or name == "sqrt" or name == "sqrtf"
        or name == "fmod" or name == "fmodf" or name == "fabs" or name == "fabsf" or name == "floor" or name == "floorf"
        or name == "ceil" or name == "ceilf" or name == "trunc" or name == "truncf" or name == "round" or name == "roundf"
        or name == "exp2" or name == "exp2f" or name == "log2" or name == "log2f" or name == "log1p" or name == "log1pf"
        or name == "expm1" or name == "expm1f" or name == "hypot" or name == "hypotf" or name == "cbrt" or name == "cbrtf") {
        return true;
    }
    return false;
}

// ── 测试内建（@panic / @assert / @assert_eq）── 运行期内建，交各后端发射 runtime 调用。
pub fn test_mbuiltin(name: string) bool {
    if (name == "panic" or name == "assert" or name == "assert_eq") {
        return true;
    }
    return false;
}

pub fn ct_fabs(x: f64) f64 { if (x < 0.0) { return 0.0 - x; } return x; }

pub fn ct_floor(x: f64) f64 {
    var i: i64 = x as i64;
    if (x < 0.0 and (i as f64) != x) { i = i - 1; }
    return i as f64;
}

pub fn ct_ceil(x: f64) f64 { return 0.0 - ct_floor(0.0 - x); }

pub fn ct_trunc(x: f64) f64 {
    var f: f64 = ct_fabs(x);
    var i: i64 = f as i64;
    if (x < 0.0) { return 0.0 - (i as f64); }
    return i as f64;
}

pub fn ct_round(x: f64) f64 { return ct_floor(x + 0.5); }

pub fn ct_sqrt(x: f64) f64 {
    if (x <= 0.0) { return 0.0; }
    var g: f64 = x * 0.5;
    if (g <= 0.0) { g = x; }
    var i: i64 = 0;
    while (i < 48) { g = (g + x / g) * 0.5; i = i + 1; }
    return g;
}

pub fn ct_exp(x: f64) f64 {
    var ln2: f64 = 0.6931471805599453;
    var n: f64 = ct_floor(x / ln2 + 0.5);
    var r: f64 = x - n * ln2;
    var term: f64 = 1.0;
    var sum: f64 = 1.0;
    var i: i64 = 1;
    while (i < 60) { term = term * r / (i as f64); sum = sum + term; i = i + 1; }
    var p: f64 = 1.0;
    var k: i64 = 0;
    var nn: i64 = ct_fabs(n) as i64;
    while (k < nn) { if (n >= 0.0) { p = p * 2.0; } else { p = p * 0.5; } k = k + 1; }
    return sum * p;
}

pub fn ct_log(x: f64) f64 {
    if (x <= 0.0) { return 0.0 / 0.0; }   // log 定义域外：返回 NaN
    var ln2: f64 = 0.6931471805599453;
    var f: f64 = x;
    var m: i64 = 0;
    if (f > 1.0) { while (f >= 2.0) { f = f * 0.5; m = m + 1; } }
    else { while (f < 1.0) { f = f * 2.0; m = m - 1; } }
    var y: f64 = (f - 1.0) / (f + 1.0);
    var y2: f64 = y * y;
    var sum: f64 = y;
    var yp: f64 = y;
    var denom: f64 = 1.0;
    var k: i64 = 1;
    while (k < 80) {
        yp = yp * y2;
        denom = denom + 2.0;
        sum = sum + yp / denom;
        k = k + 1;
    }
    return (2.0 * sum) + (m as f64) * ln2;
}

pub fn ctsin(x: f64) f64 {
    var pi: f64 = 3.14159265358979323846;
    var twopi: f64 = 2.0 * pi;
    var xx: f64 = x;
    var q: f64 = ct_floor(xx / twopi + 0.5);
    xx = xx - q * twopi;
    var sign: f64 = 1.0;
    if (xx < 0.0) { xx = 0.0 - xx; sign = -1.0; }
    if (xx > pi * 0.5) { xx = pi - xx; }
    var xx2: f64 = xx * xx;
    var term: f64 = xx;
    var sum: f64 = xx;
    var i: i64 = 0;
    while (i < 24) {
        term = -term * xx2 / (((2 * i + 2) as f64) * ((2 * i + 3) as f64));
        sum = sum + term;
        i = i + 1;
    }
    return sum * sign;
}

pub fn ctcos(x: f64) f64 { return ctsin(1.57079632679489661923 - x); }

pub fn ctatan(x: f64) f64 {
    var pi: f64 = 3.14159265358979323846;
    var neg: bool = false;
    var xx: f64 = x;
    if (xx < 0.0) { xx = 0.0 - xx; neg = true; }
    var comp: bool = false;
    if (xx > 1.0) { xx = 1.0 / xx; comp = true; }
    var x2: f64 = xx * xx;
    var term: f64 = xx;
    var sum: f64 = xx;
    var i: i64 = 0;
    while (i < 40) {
        term = -term * x2 * ((2 * i + 1) as f64) / ((2 * i + 3) as f64);
        sum = sum + term;
        i = i + 1;
    }
    if (comp) { sum = pi * 0.5 - sum; }
    if (neg) { sum = 0.0 - sum; }
    return sum;
}

pub fn cttan(x: f64) f64 { return ctsin(x) / ctcos(x); }
pub fn ctasin(x: f64) f64 { return ctatan(x / ct_sqrt(1.0 - x * x)); }
pub fn ctacos(x: f64) f64 { return 1.57079632679489661923 - ctasin(x); }

pub fn ctatan2(y: f64, x: f64) f64 {
    var pi: f64 = 3.14159265358979323846;
    if (x > 0.0) { return ctatan(y / x); }
    if (x < 0.0) {
        if (y >= 0.0) { return ctatan(y / x) + pi; }
        return ctatan(y / x) - pi;
    }
    if (y > 0.0) { return pi * 0.5; }
    if (y < 0.0) { return 0.0 - pi * 0.5; }
    return 0.0;
}

pub fn ctsinh(x: f64) f64 { return (ct_exp(x) - ct_exp(0.0 - x)) * 0.5; }
pub fn ctcosh(x: f64) f64 { return (ct_exp(x) + ct_exp(0.0 - x)) * 0.5; }
pub fn cttanh(x: f64) f64 { return ctsinh(x) / ctcosh(x); }
pub fn ctpow(a: f64, b: f64) f64 { return ct_exp(b * ct_log(a)); }
pub fn ctlog10(x: f64) f64 { return ct_log(x) / ct_log(10.0); }
pub fn ctlog2(x: f64) f64 { return ct_log(x) / ct_log(2.0); }
pub fn ctexp2(x: f64) f64 { return ct_exp(ct_log(2.0) * x); }
pub fn ctlog1p(x: f64) f64 { return ct_log(1.0 + x); }
pub fn ctexpm1(x: f64) f64 { return ct_exp(x) - 1.0; }
pub fn cthypot(x: f64, y: f64) f64 { return ct_sqrt(x * x + y * y); }
pub fn ctcbrt(x: f64) f64 {
    var s: f64 = 1.0;
    var ax: f64 = x;
    if (x < 0.0) { s = -1.0; ax = 0.0 - x; }
    return s * ctpow(ax, 0.3333333333333333);
}
pub fn ctfmod(x: f64, y: f64) f64 { return x - ct_trunc(x / y) * y; }

pub fn ct_dispatch(op: string, a: f64, b: f64) f64 {
    if (op == "sin") { return ctsin(a); }
    if (op == "cos") { return ctcos(a); }
    if (op == "tan") { return cttan(a); }
    if (op == "atan") { return ctatan(a); }
    if (op == "atan2") { return ctatan2(a, b); }
    if (op == "acos") { return ctacos(a); }
    if (op == "asin") { return ctasin(a); }
    if (op == "exp") { return ct_exp(a); }
    if (op == "log") { return ct_log(a); }
    if (op == "log10") { return ctlog10(a); }
    if (op == "pow") { return ctpow(a, b); }
    if (op == "sinh") { return ctsinh(a); }
    if (op == "cosh") { return ctcosh(a); }
    if (op == "tanh") { return cttanh(a); }
    if (op == "sqrt") { return ct_sqrt(a); }
    if (op == "fmod") { return ctfmod(a, b); }
    if (op == "fabs") { return ct_fabs(a); }
    if (op == "floor") { return ct_floor(a); }
    if (op == "ceil") { return ct_ceil(a); }
    if (op == "trunc") { return ct_trunc(a); }
    if (op == "round") { return ct_round(a); }
    if (op == "exp2") { return ctexp2(a); }
    if (op == "log2") { return ctlog2(a); }
    if (op == "log1p") { return ctlog1p(a); }
    if (op == "expm1") { return ctexpm1(a); }
    if (op == "hypot") { return cthypot(a, b); }
    if (op == "cbrt") { return ctcbrt(a); }
    return 0.0;
}

// 编译期数学内建求值：实参须为浮点常量，折叠为字面量节点
pub fn meta_eval_math(e: i64, name: string) i64 {
    var argv: []i64;
    var ac: i64 = base.node_la((e as u64));
    while (ac >= 0) {
        var av: i64 = meta_eval(base__kids[ac].val);
        if (av < 0) { return -1; }
        append(argv, av);
        ac = base__kids[ac].next;
    }
    var an: i64 = slice_len(argv) as i64;
    var v0: f64 = 0.0;
    var v1: f64 = 0.0;
    var i: i64 = 0;
    while (i < an) {
        if (base.node_kind((argv[i] as u64)) != "float") {
            return meta_fail("T-MTA-E620",
                base.sb_cat3("编译期 `", name, "` 的实参必须是浮点常量"), e);
        }
        if (i == 0) { v0 = meta_f64_from_str(base.node_sa((argv[i] as u64))); }
        if (i == 1) { v1 = meta_f64_from_str(base.node_sa((argv[i] as u64))); }
        i = i + 1;
    }
    var isf: bool = (str_slice(name, str_len(name) - 1, str_len(name)) == "f");
    var op: string = name;
    if (isf) { op = str_slice(name, 0, str_len(name) - 1); }
    var need: i64 = 1;
    if (op == "atan2" or op == "pow" or op == "fmod" or op == "hypot") { need = 2; }
    if (an != need) {
        return meta_fail("T-MTA-E621",
            base.sb_cat5("编译期 `", name, "` 需要 ", base.i2s(need), " 个实参"), e);
    }
    var r: f64 = ct_dispatch(op, v0, v1);
    return base.mk_float(meta_f64_to_str(r), -1);
}

// ── @type_info 的 comptime 值构造（阶段1 S5，通用 comptime 值模型）─────────────
// arm 名 → TypeInfo variant tag code（与 codegen_c.c_ti_arm_code 对齐；sema 不能反向依赖 codegen_c，故内联）。
pub fn ti_arm_code(arm: string) i64 {
    if (arm == "Int") { return 0; }
    if (arm == "Float") { return 1; }
    if (arm == "Bool") { return 2; }
    if (arm == "Ptr") { return 3; }
    if (arm == "Slice") { return 4; }
    if (arm == "Array") { return 5; }
    if (arm == "Fn") { return 6; }
    if (arm == "Struct") { return 7; }
    if (arm == "Enum") { return 8; }
    if (arm == "Trait") { return 9; }
    if (arm == "Union") { return 10; }
    if (arm == "Module") { return 11; }
    return 7;
}

// 类型节点 → 可读类型名（递归，供 TypeMeta.name 字段；comptime 路径不进运行时布局）。
pub fn ti_type_name(tn: i64) string {
    if (tn < 0) { return "?"; }
    var k: string = base.node_kind((tn as u64));
    if (k == "scalar" or k == "named") { return base.node_sa((tn as u64)); }
    if (k == "pointer") { return base__sb_cat2(ti_type_name(base.node_na((tn as u64))), "*"); }
    if (k == "slice") { return base__sb_cat2("[]", ti_type_name(base.node_na((tn as u64)))); }
    if (k == "optional") { return base__sb_cat2("?", ti_type_name(base.node_na((tn as u64)))); }
    if (k == "array") {
        // array 类型节点的 nb 直接存长度整数（见 base.mk_array / parse.tc type_node_mangle），
        // 不是 int 节点，故直接用 i2s(node_nb)；切勿把整数当节点 id 解引用。
        var len: string = base.i2s(base.node_nb((tn as u64)));
        return base__sb_cat2(base__sb_cat3("[", len, "]"), ti_type_name(base.node_na((tn as u64))));
    }
    if (k == "fn") { return "fn"; }
    return k;
}

// 类型节点 → TypeInfo variant arm 名（阶段1 S5+，通用 comptime 值模型）。
// 优先按节点 kind 分类合成类型（pointer/slice/array/fn/optional），再按名字判定
// 标量与具名类型；与 codegen_c.c_ti_arm 的 arm 词表（Int/Float/Bool/Ptr/Slice/Array/
// Fn/Struct/Enum/Trait/Union）保持一致。无对应 arm 的类型（string/void 等）回落 Struct
// 以与运行时 c_ti_arm 默认行为对齐（comptime 与 runtime 为两条独立路径，互不干扰）。
pub fn ti_arm_of(tnode: i64) string {
    var k: string = base.node_kind((tnode as u64));
    if (k == "pointer") { return "Ptr"; }
    if (k == "slice") { return "Slice"; }
    if (k == "array") { return "Array"; }
    if (k == "fn" or k == "func_type") { return "Fn"; }
    if (k == "trait") { return "Trait"; }
    if (k == "scalar") {
        var sn: string = base.node_sa((tnode as u64));
        if (sn == "bool") { return "Bool"; }
        if (sn == "f32" or sn == "f64") { return "Float"; }
        if (parse.is_scalar_name(sn)) { return "Int"; }
        return "Struct";   // string / void / StringBuilder 等无对应 arm
    }
    if (k == "named") {
        var tname: string = base.node_sa((tnode as u64));
        // (A) 模块类型：const X = @import("M") 把 X 与模块 key 登记为模块类型名；
        // 优先用注册表判定（不依赖 sym.ti 是否被同名预定义覆盖，sym_define 对同名不重写）。
        if (is_module_type_name(tname)) { return "Module"; }
        var si: i64 = sym_lookup(global_scope, tname);
        if (si >= 0 and syms[si].decl >= 0) {
            var dk: string = base.node_kind((syms[si].decl as u64));
            if (dk == "StructDecl") { return "Struct"; }
            if (dk == "UnionDecl") { return "Union"; }
            if (dk == "EnumDecl") { return "Enum"; }
            if (dk == "VariantDecl") { return "Union"; }
            if (tis[syms[si].ti].kind == "Module") { return "Module"; }
        }
        return "Struct";
    }
    return "Struct";
}

// 构造 comptime TypeMeta 结构体值（struct_lit）：name/size/kind/field_count/fields/field_types。
// Struct 类型填充 field_types: []type（各元素为真实 comptime type 值），其余 kind 留空数组。
// 所有 kind 均填充 name（可读类型名）/ size（mb_size_of 编译期尺寸）/ kind（arm code），
// 使 @type_info(T) 对任意类型在编译期可用（按 arm 分派 + 读 name/size）。
pub fn build_typemeta_value(tnode: i64, arm: string) i64 {
    var tname: string = ti_type_name(tnode);
    var fh: i64 = -1;
    var ft: i64 = -1;
    var f_name: i64 = base__mk_FV("name", base.mk_string(tname, -1), -1);
    ft = base__list_push(fh, ft, f_name); if (fh < 0) { fh = ft; }
    var sz: i64 = mb_size_of(tnode, 0);
    if (sz < 0) { sz = 0; }
    var f_size: i64 = base__mk_FV("size", mv_int(sz), -1);
    ft = base__list_push(fh, ft, f_size);
    var f_kind: i64 = base__mk_FV("kind", mv_int(ti_arm_code(arm)), -1);
    ft = base__list_push(fh, ft, f_kind);
    // field_types：Struct 类型由各字段类型合成 type 值数组
    var fth: i64 = -1;
    var ftt: i64 = -1;
    var nfields: i64 = 0;
    if (arm == "Struct") {
        var fld: i64 = find_struct_fields(tname);
        if (fld >= 0) {
            var ks: []i64 = base.kids_chain(fld);
            var ki: i64 = 0;
            while (ki < slice_len(ks) as i64) {
                var fv_node: i64 = ks[ki];
                var ftype: i64 = base.node_na((fv_node as u64));
                var ftname: string = meta_type_to_str(ftype);
                var tyval: i64 = type_node_from_ident(ftname);   // 真实 comptime type 值
                ftt = base__list_push(fth, ftt, tyval);
                if (fth < 0) { fth = ftt; }
                nfields = nfields + 1;
                ki = ki + 1;
            }
        }
    }
    var arr: i64 = base.mk_array_lit(fth, -1);
    var f_fc: i64 = base__mk_FV("field_count", mv_int(nfields), -1);
    ft = base__list_push(fh, ft, f_fc);
    var f_fields: i64 = base__mk_FV("fields", base.mk_array_lit(-1, -1), -1);   // 占位空数组
    ft = base__list_push(fh, ft, f_fields);
    var f_ft: i64 = base__mk_FV("field_types", arr, -1);
    ft = base__list_push(fh, ft, f_ft);
    return base__mk_struct_lit("TypeMeta", fh, -1);
}

// 返回 -2 = 非内建（交回具名 meta fn 查找）；-1 = 已报错；>=0 = 结果字面量节点
pub fn meta_eval_builtin(e: i64, name: string) i64 {
    // 数学内建：编译期折叠（常数实参 → 字面量）
    if (math_mbuiltin(name)) { return meta_eval_math(e, name); }
    var isb: bool = false;
    // ⚠ print / eprint / println **不是**编译期内建（用户裁定：print 系列为运行期函数）。
    // 故此处不再登记；编译期上下文里出现它们会落到下面的 impure / -2 分支而报错，
    // 编译期输出请改用 `@compile_log(...)`。
    if (name == "int_to_str" or name == "i2s") { isb = true; }
    if (name == "str_len" or name == "str_at") { isb = true; }
    if (name == "sym_intern") { isb = true; }
    if (isb == false) {
        if (meta_builtin_impure(name)) {
            return meta_fail("T-MTA-E615",
                base__sb_cat3("内建 `", name, "` 会触碰运行期世界，不可编译期求值"), e);
        }
        return -2;
    }
    var argv: []i64;
    var ac: i64 = base.node_la((e as u64));
    var mq_ks11703: []i64 = base.kids_chain_idx(base.node_la((e as u64)));
    var mq_ki11703: i64 = 0;
    while (mq_ki11703 < slice_len(mq_ks11703) as i64) {
        ac = mq_ks11703[mq_ki11703];
        var av: i64 = meta_eval(base__kids[ac].val);
        if (av < 0) { return -1; }
        append(argv, av);
        mq_ki11703 = mq_ki11703 + 1;
        ac = -1;
    }
    var an: i64 = slice_len(argv) as i64;
    // 编译期符号驻留：CTFE 里「符号」就是它的字符串；落到 `Sym` 槽位时
    // 由既有的 `Sym = "str"` 自动 intern 收口，两个后端零改动。
    if (name == "sym_intern") {
        if (an != 2) {
            return meta_fail("T-MTA-E611", "编译期 `sym_intern` 需要 2 个实参（缓冲区, 长度）", e);
        }
        return meta_bytes_to_str(e, argv[0], argv[1]);
    }
    if (name == "int_to_str" or name == "i2s") {
        if (an != 1) {
            return meta_fail("T-MTA-E611", base__sb_cat3("编译期 `", name, "` 需要 1 个实参"), e);
        }
        if (base.node_kind((argv[0] as u64)) != "int" and base.node_kind((argv[0] as u64)) != "bool") {
            return meta_fail("T-MTA-E617",
                base__sb_cat3("编译期 `", name, "` 的实参须是整数"), e);
        }
        return base__mk_string(base__i2s(mv_get_int(argv[0])), -1);
    }
    if (name == "str_len") {
        if (an != 1) {
            return meta_fail("T-MTA-E611", "编译期 `str_len` 需要 1 个实参", e);
        }
        if (base.node_kind((argv[0] as u64)) != "string") {
            return meta_fail("T-MTA-E617", "编译期 `str_len` 的实参须是字符串", e);
        }
        return mv_int(str_len(base.node_sa((argv[0] as u64))) as i64);
    }
    if (an != 2) {
        return meta_fail("T-MTA-E611", "编译期 `str_at` 需要 2 个实参", e);
    }
    if (base.node_kind((argv[0] as u64)) != "string") {
        return meta_fail("T-MTA-E617", "编译期 `str_at` 的首个实参须是字符串", e);
    }
    var idx: i64 = mv_get_int(argv[1]);
    if (idx < 0 or idx >= (str_len(base.node_sa((argv[0] as u64))) as i64)) {
        return meta_fail("T-MTA-E602", "编译期 `str_at` 下标越界", e);
    }
    return mv_int(str_at(base.node_sa((argv[0] as u64)), idx) as i64);
}

// 调用点的类型实参：语法上它是**表达式**（`get_width(u32)` 里 `u32` 走 parse_expr），
// 这里把它翻译回类型节点。若该名字本身是当前帧里的类型参数（`get_width(T)` 转发），
// 直接返回它绑定的类型节点。-1 = 不是类型名。
pub fn meta_type_arg_node(a: i64) i64 {
    if (a < 0) { return -1; }
    if (base.node_kind((a as u64)) == "named" or base.node_kind((a as u64)) == "scalar" or base.node_kind((a as u64)) == "slice"
        or base.node_kind((a as u64)) == "array" or base.node_kind((a as u64)) == "pointer" or base.node_kind((a as u64)) == "optional"
        or base.node_kind((a as u64)) == "vector") {
        return a;
    }
    if (base.node_kind((a as u64)) != "ident") { return -1; }
    var si: i64 = menv_find(base.node_sa((a as u64)));
    if (si >= 0) {
        if (g_menv_ty[si] >= 0) { return g_menv_ty[si]; }
        return -1;                       // 是个编译期**值**，不能当类型
    }
    return type_node_from_ident(base.node_sa((a as u64)));
}

// ── 字符串工具（变体辅助函数名解析用）──────────────────────
pub fn meta_str_find(s: string, sub: string) i64 {
    var n: i64 = str_len(s);
    var m: i64 = str_len(sub);
    if (m <= 0 or m > n) { return -1; }
    var i: i64 = 0;
    while (i + m <= n) {
        var ok: bool = true;
        var j: i64 = 0;
        while (j < m) {
            if (s[i + j] != sub[j]) { ok = false; break; }
            j = j + 1;
        }
        if (ok) { return i; }
        i = i + 1;
    }
    return -1;
}

pub fn meta_substr(s: string, a: i64, b: i64) string {
    var sb: StringBuilder = sb_new();
    var i: i64 = a;
    while (i < b) {
        sb_append_char(sb, s[i]);
        i = i + 1;
    }
    return sb_to_str(sb);
}

// ── 编译期变体值（enum/variant 加入 comptime）──────────────
// 变体辅助函数（Name_from_Case / Name_is_Case / Name_as_Case[_fK]）在编译期
// 直接求值，无需运行期函数体。必须在普通 meta fn 派发之前拦截。
// 返回 -2 表示「非变体辅助调用」，交给后续普通派发。
pub fn meta_eval_variant_call(e: i64, name: string) i64 {
    // Name_from_Case(载荷...) → 构造编译期变体值 vval
    var fi: i64 = meta_str_find(name, "_from_");
    if (fi >= 0) {
        var vn: string = meta_substr(name, 0, fi);
        var cn0: string = meta_substr(name, fi + 6, str_len(name));
        var vd: i64 = sym_lookup(global_scope, vn);
        if (vd < 0) { return -2; }
        if (base.node_kind((syms[vd].decl as u64)) != "VariantDecl") { return -2; }
        var vc: i64 = variant_find_case(syms[vd].decl, cn0);
        if (vc < 0) { return -2; }
        var h: i64 = -1;
        var t: i64 = -1;
        var ac: i64 = base.node_la((e as u64));
        while (ac >= 0) {
            var pv: i64 = meta_eval(base__kids[ac].val);
            if (pv < 0) { return -1; }
            t = base__list_push(h, t, pv);
            if (h < 0) { h = t; }
            ac = base__kids[ac].next;
        }
        return base__mk_VVal(vn, base.node_ia((vc as u64)), cn0, h, -1);
    }
    // Name_is_Case(self) → bool
    var ii: i64 = meta_str_find(name, "_is_");
    if (ii >= 0) {
        var vn: string = meta_substr(name, 0, ii);
        var cn0: string = meta_substr(name, ii + 4, str_len(name));
        var vd: i64 = sym_lookup(global_scope, vn);
        if (vd < 0) { return -2; }
        if (base.node_kind((syms[vd].decl as u64)) != "VariantDecl") { return -2; }
        var vc: i64 = variant_find_case(syms[vd].decl, cn0);
        if (vc < 0) { return -2; }
        var sv: i64 = -1;
        if (base.node_la((e as u64)) >= 0) { sv = meta_eval(base__kids[base.node_la((e as u64))].val); }
        if (sv < 0) { return -1; }
        if (base.node_kind((sv as u64)) != "vval") {
            return meta_fail("T-MTA-E617", "编译期 `is` 的被匹配值须是编译期变体值", e);
        }
        return mv_bool(base.node_ia((sv as u64)) == base.node_ia((vc as u64)));
    }
    // Name_as_Case(self) / Name_as_Case_fK(self) → 载荷值
    var ai: i64 = meta_str_find(name, "_as_");
    if (ai >= 0) {
        var vn: string = meta_substr(name, 0, ai);
        var rest: string = meta_substr(name, ai + 4, str_len(name));
        var vd: i64 = sym_lookup(global_scope, vn);
        if (vd < 0) { return -2; }
        if (base.node_kind((syms[vd].decl as u64)) != "VariantDecl") { return -2; }
        var fk: i64 = -1;
        var cn0: string = rest;
        var uf: i64 = meta_str_find(rest, "_f");
        if (uf >= 0) {
            cn0 = meta_substr(rest, 0, uf);
            var k: i64 = uf + 2;
            while (k < str_len(rest)) {
                var ch: i64 = rest[k];
                if (ch >= 48 and ch <= 57) { fk = fk * 10 + (ch - 48); }
                k = k + 1;
            }
        }
        var vc: i64 = variant_find_case(syms[vd].decl, cn0);
        if (vc < 0) { return -2; }
        var sv: i64 = -1;
        if (base.node_la((e as u64)) >= 0) { sv = meta_eval(base__kids[base.node_la((e as u64))].val); }
        if (sv < 0) { return -1; }
        if (base.node_kind((sv as u64)) != "vval") {
            return meta_fail("T-MTA-E617", "编译期 `as` 的被匹配值须是编译期变体值", e);
        }
        if (base.node_ia((sv as u64)) != base.node_ia((vc as u64))) {
            return meta_fail("T-MTA-E617",
                base__sb_cat5("编译期 `as` 类型不匹配：实际是 `", base.node_sb((sv as u64)), "` 而非 `", cn0, "`"), e);
        }
        if (fk >= 0) {
            var c: i64 = base.node_la((sv as u64));
            var idx: i64 = 0;
            while (c >= 0) {
                if (idx == fk) { return base__kids[c].val; }
                idx = idx + 1;
                c = base__kids[c].next;
            }
            return meta_fail("T-MTA-E617", "编译期 `as` 载荷下标越界", e);
        }
        if (base.node_la((sv as u64)) >= 0) { return base__kids[base.node_la((sv as u64))].val; }
        return meta_fail("T-MTA-E617", "编译期 `as` 的 case 无载荷可取（单元 case）", e);
    }
    return -2;
}

// 字面量相等（match 字面量模式用）
pub fn meta_lit_eq(pat: i64, val: i64) bool {
    if (base.node_kind((pat as u64)) != base.node_kind((val as u64))) { return false; }
    if (base.node_kind((pat as u64)) == "int") { return base.node_ia((pat as u64)) == base.node_ia((val as u64)); }
    if (base.node_kind((pat as u64)) == "bool") { return base.node_ba((pat as u64)) == base.node_ba((val as u64)); }
    if (base.node_kind((pat as u64)) == "string") { return base.node_sa((pat as u64)) == base.node_sa((val as u64)); }
    if (base.node_kind((pat as u64)) == "float") { return base.node_sa((pat as u64)) == base.node_sa((val as u64)); }   // P5: 浮点字面量按文本相等
    return false;
}

// 把 conpat 子模式链（ident / `_` / 嵌套 conpat）绑定到变体载荷值链
pub fn meta_bind_conpat(pats: i64, vals: i64) bool {
    var pc: i64 = pats;
    var vc: i64 = vals;
    while (pc >= 0 and vc >= 0) {
        var pv: i64 = base__kids[vc].val;
        if (base.node_kind((base__kids[pc].val as u64)) == "ident") {
            menv_push(base.node_sa((base__kids[pc].val as u64)), pv);
        } else if (base.node_kind((base__kids[pc].val as u64)) == "conpat") {
            if (base.node_kind((pv as u64)) == "vval") {
                if (base.node_sb((pv as u64)) != base.node_sa((base__kids[pc].val as u64))) { return false; }
                if (meta_bind_conpat(base.node_la((base__kids[pc].val as u64)), base.node_la((pv as u64))) == false) { return false; }
            } else { return false; }
        }
        // `_` 通配 / 其他：跳过绑定
        pc = base__kids[pc].next;
        vc = base__kids[vc].next;
    }
    return true;
}

// 编译期 match：scrutinee 求值后按 conpat/`_`/字面量/绑定 选择命中臂
pub fn meta_eval_match(e: i64) i64 {
    var scr: i64 = meta_eval(base.node_na((e as u64)));
    if (scr < 0) { return -1; }
    var mc: i64 = base.node_la((e as u64));
    var mq_ks11938: []i64 = base.kids_chain_idx(base.node_la((e as u64)));
    var mq_ki11938: i64 = 0;
    while (mq_ki11938 < slice_len(mq_ks11938) as i64) {
        mc = mq_ks11938[mq_ki11938];
        var pat: i64 = base.node_na((base__kids[mc].val as u64));
        var guard: i64 = base.node_nb((base__kids[mc].val as u64));
        var body: i64 = base.node_nc((base__kids[mc].val as u64));
        var sv_base: i64 = g_menv_base;
        var sv_top: i64 = g_menv_top;
        var matched: bool = false;
        if (base.node_ba((base__kids[mc].val as u64))) {
            matched = true;                                  // `_` 通配
        } else if (base.node_sa((base__kids[mc].val as u64)) != "" and pat < 0) {
            // 纯绑定臂（`n when ... =>`）：绑定名在 arm.sa，pat 为 -1；
            // 把整个 scrutinee 值绑到该名字，守卫内可引用。
            menv_push(base.node_sa((base__kids[mc].val as u64)), scr);
            matched = true;
        } else if (pat >= 0 and base.node_kind((pat as u64)) == "conpat") {
            if (base.node_sa((pat as u64)) == "") {
                // 纯绑定 conpat（罕见）：把 la 里的 ident 绑定到整个 scrutinee
                var bpi: i64 = base.node_la((pat as u64));
                while (bpi >= 0) {
                    if (base.node_kind((base__kids[bpi].val as u64)) == "ident") { menv_push(base.node_sa((base__kids[bpi].val as u64)), scr); }
                    bpi = base__kids[bpi].next;
                }
                matched = true;
            } else if (base.node_kind((scr as u64)) == "vval") {
                if (base.node_sb((scr as u64)) == base.node_sa((pat as u64))) {
                    matched = meta_bind_conpat(base.node_la((pat as u64)), base.node_la((scr as u64)));
                }
            } else if (base.node_kind((scr as u64)) == "ct_variant") {
                // (A) 编译期变体值（@type_info 等 mk_ct_variant 产物）：payload 存于 na；
                // 单载荷变体 .Arm(x) 把 x 绑定到整个 payload 节点（与 vval 取 la 不同）。
                if (base.node_sb((scr as u64)) == base.node_sa((pat as u64))) {
                    var cph: i64 = base.node_la((pat as u64));
                    if (cph >= 0 and base.node_kind((base__kids[cph].val as u64)) == "ident") {
                        menv_push(base.node_sa((base__kids[cph].val as u64)), base.node_na((scr as u64)));
                        matched = true;
                    }
