                // 故 target 必须用 pascal_to_snake(afstruct) 而非原文（"Point"→"point"），否则大小写不符找不到符号。
                var aftarget: string = base.sb_cat3(parse.pascal_to_snake(afstruct), "_", afname);
                var afi: i64 = sym_lookup(global_scope, aftarget);
                if (afi < 0) { afi = sym_lookup(cur_scope, aftarget); }
                if (afi >= 0 and tip_kind(syms[afi].ti) == "Func") {
                    // 方法 vs 关联函数：按 receiver 性质判定（不依赖参数名，避免 self 脱糖 / 节点 id 漂移干扰）。
                    // receiver 是「类型名」（ident 且解析为 type 声明）→ 类型级关联函数，不前置 receiver；
                    // 否则 receiver 是「值」（变量 / 字段 / 调用结果 …）→ 值级方法，前置 receiver 为实参 0。
                    var af_is_method: bool = true;
