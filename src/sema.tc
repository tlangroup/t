pub fn anndef_find(name: string) i64 {
    var n: i64 = g_ad_count;
    var i: i64 = 0;
    while (i < n) {
        var a: AnnDef;
        if (g_ad_name[i] == name) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// ", " 分隔的 targets 中精确匹配
pub fn targets_has(ts: string, t: string) bool {
    var n: i64 = str_len(ts) as i64;
    var start: i64 = 0;
    var i: i64 = 0;
    while (i <= n) {
        var hit: bool = i == n;
        if (hit == false) {
            hit = ts[i] == 44;
        }
        if (hit) {
            var seg: string = str_slice(ts, start, i);
            if (seg == t) {
                return true;
            }
            start = i + 2;
            i = i + 1;
        }
        i = i + 1;
    }
    return false;
}

// 把 targets 逐段加入 slb（validValues）
pub fn targets_push_vv(ts: string) void {
    var n: i64 = str_len(ts) as i64;
    var start: i64 = 0;
    var i: i64 = 0;
    while (i <= n) {
        var hit: bool = i == n;
        if (hit == false) {
            hit = ts[i] == 44;
        }
        if (hit) {
            base__slb_add(str_slice(ts, start, i));
            start = i + 2;
            i = i + 1;
        }
        i = i + 1;
    }
}

pub fn starts_with(s: string, p: string) bool {
    var np: u64 = str_len(p);
    if (str_len(s) < np) {
        return false;
    }
    var i: u64 = 0;
    while (i < np) {
        if (s[i] != p[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn is_cfg_cond(v: string) bool {
    if (v == "debug" or v == "release" or v == "windows" or v == "linux") {
        return true;
    }
    return v == "mac" or v == "android" or v == "web";
}

pub fn is_derive_trait(v: string) bool {
    if (v == "ToString" or v == "FromString" or v == "Clone" or v == "Copy") {
        return true;
    }
    if (v == "DebugPrint" or v == "BinarySerde" or v == "Eq") {
        return true;
    }
    return v == "PartialEq" or v == "Hash";
}

pub fn is_valid_warning(v: string) bool {
    if (v == "unused" or v == "unused_field" or v == "dead_code") {
        return true;
    }
    if (v == "overflow_literal" or v == "implicit_cast") {
        return true;
    }
    return v == "bitfield_overlap" or v == "deprecated";
}

// >>> GEN:derives (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
pub fn vv_derive_traits() void {
    base__slb_add("ToString");
    base__slb_add("FromString");
    base__slb_add("Clone");
    base__slb_add("Copy");
    base__slb_add("DebugPrint");
    base__slb_add("BinarySerde");
    base__slb_add("Eq");
    base__slb_add("PartialEq");
    base__slb_add("Hash");
}
