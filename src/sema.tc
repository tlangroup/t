                            if (func_is_generic(s2.decl) and base.node_bb((e as u64)) == false) {   // S4 §0.14.7 SoA：侧表读
                                if (generic_prepend_inferred_types(s2.decl, e) == false) { return ti_mk("Unknown"); }
                                var inst: i64 = instantiate_generic(s2.decl, e);
                                if (inst >= 0) {
                                    return infer_expr(e);
                                }
                            }
                            // 直接调用同样要校验实参：这里以前直接 return 返回类型，
                            // 少传/多传/类型不符全部静默放行 → 运行期未初始化读。
                            check_call_args(e, s2.ti, fname);
                            return resolve_ti(base.node_na((s2.decl as u64)));
                        }
                    }
                    // 函数类型变量 / 参数：校验实参后返回签名的返回类型。
                    // 这里必须校验——间接调用没有 C 原型兜底，元数不符会一路漏到
                    // clang 报错或生成语义错误的 IR。
                    check_indirect_call(e, s2.ti);
                    return tif_ret[s2.ti];
                }
                // 对非函数的值做调用：给出明确诊断，别让它退化成「未知内建」
                if (s2.kind == "var" and tip_kind(s2.ti) != "Unknown") {
                    parse.fc_err("T-SEM-E205",
                        base.sb_cat4("`", fname, "` 不是函数，不能调用；它的类型是 ", ti_str(s2.ti)), e);
                    return ti_mk("Unknown");
                }
            }
            // 已移除的死内建：明确报错并指引到 std.testing，而非静默 no-op / 被当未知标识符放行。
            // 这些名字曾登记在 builtin_ret 里，但 LLVM 后端是 no-op、C 后端缺实现，属死桩，
            // 已在编译器侧移除（见 src/sema.tc builtin_ret 的 GEN 块）。
            if (fname == "assert_eq" or fname == "assert_true" or fname == "assert_false" or fname == "assert_panic") {
                parse.fc_err("T-SEM-E201",
                    base.sb_cat2(fname, " 内建断言已移除（LLVM 后端曾是 no-op、C 后端缺实现）。请改用 std.testing.assert_*（如 testing.assert_eq）"), e);
                return ti_mk("Unknown");
            }
            // format(tmpl, ...) 的替换字段脱糖（M55）。必须挂在这里而非 parse 期：
            // 选 sb_append_fmt_int 还是 _float 取决于实参的**静态类型**，只有
            // infer 之后才知道。脱糖会就地把本节点改写成 __fmt_N(...) 调用，
            // callee 名随之改变，故重复 infer 天然幂等。
            if (fname == "format") {
                return desugar_format_call(e);
            }
            // slice_sub(s, lo, hi) 的返回类型 = 首个实参的切片类型本身（子切片同型）。
            // 它是区间索引降解出来的内部内建，也允许直接写。
            if (fname == "slice_sub" and base.node_la((e as u64)) >= 0) {
                var ssn: i64 = base.kids[base.node_la((e as u64))].val;
                var sst: i64 = ie_sub_in(ei, ssn);
                var ssc: i64 = base.kids[base.node_la((e as u64))].next;
                while (ssc >= 0) {
                    ie_sub_in_v(ei, base.kids[ssc].val);
                    ssc = base.kids[ssc].next;
                }
                if (tip_kind(sst) == "Slice") {
                    return sst;
                }
                parse.fc_err("T-RNG-E871",
                    base.sb_cat2("slice_sub 的第 1 个实参必须是 `[]T`；当前收到: ", ti_str(sst)), e);
                return ti_mk("Unknown");
            }
            // map_get(m, k) 的返回类型 = 映射的 V（需从首个实参的 map 类型反查）
            if (fname == "map_get" and base.node_la((e as u64)) >= 0) {
                var mgn: i64 = base.kids[base.node_la((e as u64))].val;
                var mgt: i64 = ie_sub_in(ei, mgn);
                if (tip_kind(mgt) == "Map") {
                    var mgti: TI = tis[mgt];
                    if (mgti.val >= 0) {
                        return mgti.val;
                    }
                }
                return ti_mk("Unknown");
            }
            // 可选类型内建：some(x)→Optional(实参类型)；unwrap(x)→Optional 元素类型；is_some/is_none(x)→bool。
            if ((fname == "some" or fname == "unwrap" or fname == "is_some" or fname == "is_none") and base.node_la((e as u64)) >= 0) {
                var oan: i64 = call_arg_node(e, 0);
                var oat: i64 = ie_sub_in(ei, oan);
                if (fname == "some") {
                    // 实参是**元素值**（非可选），结果为 Optional(该实参类型)。
                    return ti_elem_of("Optional", oat);
                }
                if (tip_kind(oat) == "Optional") {
                    if (fname == "is_some" or fname == "is_none") {
                        return ti_scalar("bool");
                    }
                    // unwrap：返回 Optional 的元素类型
                    var oati: TI = tis[oat];
                    return oati.elem;
                }
                parse.fc_err("T-SEM-E790",
                    base.sb_cat3(fname, " 的实参必须是可选类型 `?T`（当前收到: ", ti_str(oat)),
                    e);
                return ti_mk("Unknown");
            }
            // print / println / eprint 的实参必须是字符串。若不校验，LLVM 后端会把标量
            // 当做 ptr 传给 @tll_print，导致 IR 校验失败（'i64' but expected 'ptr'）并使
            // `clang link failed`。这里在检查阶段给出清晰的类型错误。
            if (fname == "print" or fname == "println" or fname == "eprint") {
                if (base.node_la((e as u64)) >= 0) {
                    var pan: i64 = base.kids[base.node_la((e as u64))].val;
                    var pat: i64 = ie_sub_in(ei, pan);
                    if (tip_kind(pat) != "String" and tip_kind(pat) != "Unknown") {
                        base.diag_new("T-SEM-E202", "error",
                            base.sb_cat3(fname, " 的实参必须是字符串（String）；标量请先用 int_to_str / to_string / StringBuilder 拼接。当前收到: ", ti_str(pat)),
                            parse.n_file(e), parse.n_line(e), parse.n_col(e), parse.n_line(e), parse.n_col(e) + 5);
                    }
                }
            }
            // 文件描述符内建（M51）：atom 形参必须是**字面量** —— 打开方式与格式
            // 决定后续每一次 `<` 的字节形态，必须编译期可判定（L-02 显式 / L-03 静态）。
            if (fname == "fopen") {
                check_atom_arg(call_arg_node(e, 1), "fopen 的第 2 个实参（打开方式）", "mode", e);
            }
            if (fname == "fmt_register") {
                check_atom_arg(call_arg_node(e, 0), "fmt_register 的第 1 个实参（打开方式类别）", "kind", e);
                check_atom_arg(call_arg_node(e, 2), "fmt_register 的第 3 个实参（格式）", "fmt", e);
            }
            // fid_error 的实参必须是 fid（与 serialize 脱糖的 fid 判定同款：kind==Scalar && name==fid）。
            // 传非 fid（如 i64）应报 T_FID_ERROR_ARG，而非退化成「未知内建」或静默按 i64 传递。
            if (fname == "fid_error") {
                if (base.node_la((e as u64)) >= 0) {
                    var fean: i64 = base.kids[base.node_la((e as u64))].val;
                    var feat: i64 = ie_sub_in(ei, fean);
                    var feok: bool = (tip_kind(feat) == "Scalar" and tip_name(feat) == "fid") or tip_kind(feat) == "Unknown";
                    if (!feok) {
                        base.diag_new("T-FID-E659", "error",
                            base.sb_cat2("fid_error 的实参必须是 fid；当前收到: ", ti_str(feat)),
                            parse.n_file(e), parse.n_line(e), parse.n_col(e), parse.n_line(e), parse.n_col(e) + 5);
                    }
                }
            }
            // fid_eof 同理：探针只对句柄有意义，传 i64 必须拦下而不是让运行时兜底。
            if (fname == "fid_eof") {
                if (base.node_la((e as u64)) >= 0) {
                    var feon: i64 = base.kids[base.node_la((e as u64))].val;
                    var feot: i64 = ie_sub_in(ei, feon);
                    var feook: bool = (tip_kind(feot) == "Scalar" and tip_name(feot) == "fid") or tip_kind(feot) == "Unknown";
                    if (!feook) {
                        base.diag_new("T-FID-E660", "error",
                            base.sb_cat2("fid_eof 的实参必须是 fid；当前收到: ", ti_str(feot)),
                            parse.n_file(e), parse.n_line(e), parse.n_col(e), parse.n_line(e), parse.n_col(e) + 5);
                    }
                }
            }
            // fseek/ftell 的首个实参必须是 fid；fseek 的偏移必须是整型标量。
            // fid 与 i64 不隐式互转，写反参数顺序（fseek(0, f)）必须在检查期就拦下。
            if (fname == "fseek" or fname == "ftell") {
                if (base.node_la((e as u64)) >= 0) {
                    var skn: i64 = base.kids[base.node_la((e as u64))].val;
                    var skt: i64 = ie_sub_in(ei, skn);
                    var skok: bool = (tip_kind(skt) == "Scalar" and tip_name(skt) == "fid") or tip_kind(skt) == "Unknown";
                    if (!skok) {
                        base.diag_new("T-FID-E661", "error",
                            base.sb_cat3(fname, " 的第 1 个实参必须是 fid；当前收到: ", ti_str(skt)),
                            parse.n_file(e), parse.n_line(e), parse.n_col(e), parse.n_line(e), parse.n_col(e) + 5);
                    }
                }
                if (fname == "fseek") {
                    var skon: i64 = call_arg_node(e, 1);
                    if (skon >= 0) {
                        var skot: i64 = ie_sub_in(ei, skon);
                        var skoname: string = tip_name(skot);
                        var skoint: bool = tip_kind(skot) == "Scalar" and skoname != "fid" and skoname != "atom"
                            and skoname != "bool" and skoname != "f32" and skoname != "f64";
                        if (!skoint and tip_kind(skot) != "Unknown") {
                            base.diag_new("T-FID-E661", "error",
                                base.sb_cat2("fseek 的第 2 个实参（偏移）必须是整型标量；当前收到: ", ti_str(skot)),
                                parse.n_file(e), parse.n_line(e), parse.n_col(e), parse.n_line(e), parse.n_col(e) + 5);
                        }
                    }
                }
            }
            // 时间格式化（M56）：spec 字面量扫描字段码；实参类型校验
            if (fname == "format_time" or fname == "format_time_local" or fname == "format_time_tz") {
                var ftn: i64 = call_arg_node(e, 0);
                if (ftn >= 0) {
                    if (base.node_kind((ftn as u64)) == "string") {
                        check_time_spec(base.node_sa((ftn as u64)), ftn);
                    } else {
                        var ftt: i64 = ie_sub_in(ei, ftn);
                        if (tip_kind(ftt) != "String" and tip_kind(ftt) != "Unknown") {
                            base.diag_new("T-TIM-E702", "error",
                                base.sb_cat3(fname, " 的第 1 个实参（格式串）必须是字符串；当前收到: ", ti_str(ftt)),
                                parse.n_file(e), parse.n_line(e), parse.n_col(e), parse.n_line(e), parse.n_col(e) + 5);
                        }
                    }
                }
                var ftmn: i64 = call_arg_node(e, 1);
                if (ftmn >= 0) {
                    var ftmt: i64 = ie_sub_in(ei, ftmn);
                    var ftmname: string = tip_name(ftmt);
                    var ftmint: bool = tip_kind(ftmt) == "Scalar" and ftmname != "fid" and ftmname != "atom"
                        and ftmname != "bool" and ftmname != "f32" and ftmname != "f64";
                    if (!ftmint and tip_kind(ftmt) != "Unknown") {
                        base.diag_new("T-TIM-E703", "error",
                            base.sb_cat3(fname, " 的第 2 个实参（时间微秒 epoch）必须是整型（i64）；当前收到: ", ti_str(ftmt)),
                            parse.n_file(e), parse.n_line(e), parse.n_col(e), parse.n_line(e), parse.n_col(e) + 5);
                    }
                }
                // format_time_tz 的第 3 参：时区偏移分钟数（东为正），须整型
                if (fname == "format_time_tz") {
                    var tzn: i64 = call_arg_node(e, 2);
                    if (tzn < 0) {
                        parse.fc_err("T-SEM-E206",
                            "format_time_tz(spec, t, tz_minutes) 需要 3 个实参：格式串、微秒 epoch、时区偏移分钟数（东为正，如东八区 480）", e);
                    } else {
                        var tzt: i64 = ie_sub_in(ei, tzn);
                        var tzname: string = tip_name(tzt);
                        var tzint: bool = tip_kind(tzt) == "Scalar" and tzname != "fid" and tzname != "atom"
                            and tzname != "bool" and tzname != "f32" and tzname != "f64";
                        if (!tzint and tip_kind(tzt) != "Unknown") {
                            base.diag_new("T-TIM-E703", "error",
                                base.sb_cat2("format_time_tz 的第 3 个实参（时区偏移分钟数）必须是整型；当前收到: ", ti_str(tzt)),
                                parse.n_file(e), parse.n_line(e), parse.n_col(e), parse.n_line(e), parse.n_col(e) + 5);
                        }
                    }
                }
            }
            // 时间解析（M57）：spec 走更严的解析白名单；第 2 参必须是字符串
            if (fname == "parse_time" or fname == "parse_time_local") {
                var ptn: i64 = call_arg_node(e, 0);
                if (ptn < 0) {
                    parse.fc_err("T-SEM-E206",
                        base.sb_cat3(fname, "(spec, s) 需要 2 个实参：格式串与待解析字符串；失败返回 time_invalid()", ""), e);
                }
                if (ptn >= 0) {
                    if (base.node_kind((ptn as u64)) == "string") {
                        check_time_parse_spec(base.node_sa((ptn as u64)), ptn);
                    } else {
                        var ptt2: i64 = ie_sub_in(ei, ptn);
                        if (tip_kind(ptt2) != "String" and tip_kind(ptt2) != "Unknown") {
                            base.diag_new("T-TIM-E702", "error",
                                base.sb_cat3(fname, " 的第 1 个实参（格式串）必须是字符串；当前收到: ", ti_str(ptt2)),
                                parse.n_file(e), parse.n_line(e), parse.n_col(e), parse.n_line(e), parse.n_col(e) + 5);
                        }
                    }
                    var psn: i64 = call_arg_node(e, 1);
                    if (psn < 0) {
                        parse.fc_err("T-SEM-E206",
                            base.sb_cat3(fname, "(spec, s) 缺少第 2 个实参（待解析字符串）", ""), e);
                    } else {
                        var pst: i64 = ie_sub_in(ei, psn);
                        if (tip_kind(pst) != "String" and tip_kind(pst) != "Unknown") {
                            base.diag_new("T-TIM-E703", "error",
                                base.sb_cat3(fname, " 的第 2 个实参（待解析文本）必须是字符串；当前收到: ", ti_str(pst)),
                                parse.n_file(e), parse.n_line(e), parse.n_col(e), parse.n_line(e), parse.n_col(e) + 5);
                        }
                    }
                }
            }
            if (fname == "time_invalid") {
                if (call_arg_node(e, 0) >= 0) {
                    parse.fc_err("T-SEM-E206", "time_invalid() 不接受任何实参（返回解析失败哨兵：i64 最小值）", e);
                }
            }
            // 数字/字符串格式化（M54）：spec 字面量文法校验；实参类型校验
            if (fname == "format_int" or fname == "format_uint" or fname == "format_float"
                or fname == "format_str" or fname == "format_bool" or fname == "format_char") {
                var fspecn: i64 = call_arg_node(e, 0);
                if (fspecn >= 0) {
                    if (base.node_kind((fspecn as u64)) == "string") {
                        check_fmt_spec(base.node_sa((fspecn as u64)), fspecn);
                    } else {
                        var fst: i64 = ie_sub_in(ei, fspecn);
                        if (tip_kind(fst) != "String" and tip_kind(fst) != "Unknown") {
                            base.diag_new("T-FST-E312", "error",
                                base.sb_cat3(fname, " 的第 1 个实参（格式串 spec）必须是字符串；当前收到: ", ti_str(fst)),
                                parse.n_file(e), parse.n_line(e), parse.n_col(e), parse.n_line(e), parse.n_col(e) + 5);
                        }
                    }
                }
            }
            // now() 不接受任何实参
            if (fname == "now") {
                if (call_arg_node(e, 0) >= 0) {
                    parse.fc_err("T-SEM-E206", "now() 不接受任何实参（返回当前微秒 epoch）", e);
                }
            }
            // getenv(name: string) string：1 个字符串实参；未设置返回空串。
            if (fname == "getenv") {
                var ge0: i64 = call_arg_node(e, 0);
                if (ge0 < 0) {
                    parse.fc_err("T-SEM-E206", "getenv(name) 需要 1 个实参：环境变量名（字符串）；未设置返回错误，请传入形如 \"PATH\" 的名称", e);
                } else {
                    var get0: i64 = ie_sub_in(ei, ge0);
                    if (tip_kind(get0) != "String" and tip_kind(get0) != "Unknown") {
                        base.diag_new("T-SEM-E207", "error",
                            base.sb_cat2("getenv 的第 1 个实参（环境变量名）必须是字符串；当前收到: ", ti_str(get0)),
                            parse.n_file(e), parse.n_line(e), parse.n_col(e), parse.n_line(e), parse.n_col(e) + 5);
                    }
                }
            }
            // 兜底补扫：把上面任一分支没显式推导过的实参也推一遍。
            // 内建的实参校验是「按需」的——只有关心实参类型的内建才会 infer，
            // 于是**嵌套在内建实参里的用户函数调用**会整个逃过检查：
            // `println(int_to_str(add3(1, 2)))` 里的少参调用曾静默通过。
            // 重复推导由 diag_new 的去重兜住，不会产生成对报错。
            var bsc: i64 = base.node_la((e as u64));
            var mq_ks7459: []i64 = base.kids_chain_idx(base.node_la((e as u64)));
            var mq_ki7459: i64 = 0;
            while (mq_ki7459 < slice_len(mq_ks7459) as i64) {
                bsc = mq_ks7459[mq_ki7459];
                var bsk: Child = base.kids[bsc];
                ie_sub_in_v(ei, bsk.val);
                mq_ki7459 = mq_ki7459 + 1;
                bsc = -1;
            }
            return builtin_ret(fname);
        }
        // callee 是任意表达式（结构体字段 / 数组元素 / 调用结果…）：若其类型是函数类型，
        // 与 ident 路径同样校验实参并返回签名的返回类型。
        var xcti: i64 = ie_sub_in(ei, base.node_na((e as u64)));
        if (tip_kind(xcti) == "Func") {
            check_indirect_call(e, xcti);
            return tif_ret[xcti];
        }
        return ti_mk("Unknown");
    }
    if (k == "member") {
        // 前导点成员引用 `.a`：无接收者（na<0），依上下文解析。
        if (base.node_lb((e as u64)) == 1 and base.node_na((e as u64)) < 0) {
            var msa: string = base.node_sa((e as u64));
            // 1) 方法体内的结构体字段：隐式 self → 改写为 `self.a`（常规 receiver member），
            //    使下游类型推断与双后端发射都走既有 `obj.field` 路径。
            var si_self: i64 = sym_lookup(cur_scope, "self");
            if (si_self >= 0) {
                var sti: i64 = syms[si_self].ti;
                var stk: string = tip_kind(sti);
                // P3：同上，位域（`tip_is_flag`）此前 kind 不是 Struct，不进本分支；
                // 统一后须显式排除，否则 `.readable` 前导点会被当成结构体字段解析。
                if ((stk == "Struct" or stk == "Named") and tip_is_flag(sti) == false) {
                    var ft: i64 = struct_field_ti(tip_name(sti), msa);
                    if (ft >= 0) {
                        var self_id: i64 = base.mk_ident("self", -1);
                        base.node_set_na((e as u64), self_id);
                        base.node_set_lb((e as u64), 0);
                        return ft;
                    }
                }
            }
            // 2) 枚举 / 联合体 / 变体：期望类型为 enum/union/variant 时，`.Variant` 即该类型的值。
            if (g_lead_expect >= 0) {
                var ek: string = tip_kind(g_lead_expect);
                if (ek == "Enum" or ek == "Union") {
                    var recv_id: i64 = base.mk_ident(tip_name(g_lead_expect), -1);
                    base.node_set_na((e as u64), recv_id);
                    base.node_set_lb((e as u64), 0);
                    return g_lead_expect;
                }
                if (ek == "Variant") {
                    // 前导点变体值 `.Empty`（无 payload）→ Shape_from_Empty()（构造器调用）。
                    // 把节点改写回 call 形，复用 call 分支既有构造器发射路径。幂等：改写后
                    // callee 为 <Variant>_from_<Case>，不再含前导点，二次进入不会重复改写。
                    var vname: string = variant_name_of_case(msa);
                    if (str_len(vname) as i64 > 0) {
                        var ctor_id: i64 = base.mk_ident(base.sb_cat3(vname, "_from_", msa), -1);
                        base.node_set_span_id(ctor_id, base.node_span_id(e)); base.node_set_span_id(ctor_id, base.node_span_id(e)); base.node_set_span_id(ctor_id, base.node_span_id(e));
                        var call_id: i64 = base.mk_call(ctor_id, -1, -1);
