}

// ── 列表助手 ───────────────────────────────────────────────────

pub fn list_last_val(head: i64) i64 {
    var c: i64 = head;
    var last: i64 = -1;
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环
    var ks2458: []i64 = base.kids_chain(c);
    var ki2458: i64 = 0;
    while (ki2458 < slice_len(ks2458) as i64) {
        var kv2458: i64 = ks2458[ki2458];
        last = kv2458;
        ki2458 = ki2458 + 1;
    }
    return last;
}

// 返回链中 `last` 的前驱节点 id（-1 表示无前驱）。供 all_paths_return 在值块占位符
// 场景下回落到真正的末条语句。
pub fn list_prev_val(head: i64, last: i64) i64 {
    if (head < 0 or last < 0) { return -1; }
    var prev: i64 = -1;
    var ks: []i64 = base.kids_chain(head);
    var ki: i64 = 0;
    while (ki < slice_len(ks) as i64) {
        var kv: i64 = ks[ki];
        if (kv == last) { break; }
        prev = kv;
        ki = ki + 1;
    }
    return prev;
}


