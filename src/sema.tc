// ══════════════════════════════════════════════════════════════════
// src/sema.tc — 编译步骤 3：语义分析
//
// 内容：类型检查器（TypeInfo 池）、comptime/meta 泛型单态化、CTFE 求值器、
//       编译期内建，以及供两个后端消费的 TypeDesc（TD）池。
// 依赖：base, lex, parse, hir。
//
// Stage B（HIR 消费）：sema 的**遍历与分派**一律以 HIR 指令为输入 ——
// 顶层声明工作集取自 hir.g_hir.decls，函数体/语句走 HIR BLOCK 指令流，
// 表达式经 HIR inst 进入。语义规则体仍作用于 CST 节点（每条 HIR 指令携带
// 源节点 id `nd`，经 hir_inst_node 回桥），因为脱糖（format / 管道 / 区间）
// 与后端都还在 CST 上工作。无 HIR 的节点（脱糖合成）回落 CST 路径。
// ══════════════════════════════════════════════════════════════════

const base = @import("src.base");
const lex = @import("src.lex");
const parse = @import("src.parse");
const hir = @import("src.hir");

// ── TypeDesc 池（复刻 TypeDesc interface）──────────────────────
// 类型描述库由语义分析阶段产出（构建 TD 索引），供两个代码生成后端消费，
// 故定义置于本模块（step 3），codegen_c / codegen_ll 通过 import 读取。
// cat: "string" | "slice" | "map" | "named" | "scalar" | "unknown" | "void"

pub struct TD {
    cat: string;
    name: string;
    elem: i64;   // TD 索引，-1 = 无
    key: i64;
    val: i64;
    alen: i64;   // cat == "array" 时的定长长度，其余为 -1
    memspace: i64;  // Device：指针地址空间（0=host；1=global/dev_ptr；3=shared；5=local）。仅 cat=="pointer" 有效
}

pub var tds: []TD;

// 函数类型（cat == "func"）签名侧池：索引与 tds 对齐
pub var tdf_ret: []i64;      // 返回类型 TD 索引
pub var tdf_pstart: []i64;   // 参数区起点（tdf_params 下标）
pub var tdf_pcount: []i64;   // 参数个数
pub var tdf_params: []i64;   // 参数类型 TD 索引扁平区

// ═══════════════════════════════════════════════════════════════
// M7-2: 类型检查器（移植 tc0/types/checker.ts + types.ts）
// ═══════════════════════════════════════════════════════════════

// ── TypeInfo 扁平池（复刻 types.ts TypeInfo）──────────────────
// kind: Scalar/Void/String/StringBuilder/Array/Slice/Map/Pointer/
//       Optional/Struct/Enum/Union/Variant/Func/Named/Unknown
//
// ⚠ P3（积类型统一 epic，2026-10-09）：`Flag` / `FlagSet` 两个 kind **已废除**，
// 位域在 TI 层就是 `Struct`，身份由 `und`（底层整型名，非空 = 位域）承载 —— 见 `tip_is_flag`。
// 不得再新增按 `kind == "Flag"` 派发的分支；判别一律走 `tip_is_flag()`。

pub struct TI {
    kind: string;
    name: string;   // Scalar/Struct/Enum/Union/Func/Named
    und: string;    // Enum underlying / 位域（flag）底层整型 —— 位域身份的判别属性
    bw: i64;        // Scalar bitWidth
    elem: i64;      // Array/Slice/Pointer/Optional 子类型（TI 索引）
    key: i64;       // Map key
    val: i64;       // Map value
    alen: i64;      // Array length
}

pub var tis: []TI;

// 函数类型（Func）签名侧池：索引与 tis 对齐（ti_mk 每次同步追加）
pub var tif_ret: []i64;     // 返回类型 TI 索引
pub var tif_pstart: []i64;  // 参数 TI 扁平池起点
pub var tif_pcount: []i64;  // 参数个数
pub var tif_params: []i64;  // 参数 TI 扁平池

pub fn ti_mk(kind: string) i64 {
    var t: TI;
    // ⚠ 代际分配器（2026-10-22）：TI 表 tis 同为跨函数持久池，须常驻 g_arena，
    // 与 td_mk 同口径（见其注释）。重降级期切 g_arena 再 append + 逃逸提升字符串字段。
    if (base.g_relowering) { arena_use_default(); }
    if (base.g_relowering) { t.kind = base.str_persist(kind); } else { t.kind = kind; }
    t.name = "";
    t.und = "";
    t.bw = 0;
    t.elem = -1;
    t.key = -1;
    t.val = -1;
    t.alen = 0;
    append(tis, t);
    append(tif_ret, -1);
    append(tif_pstart, -1);
    append(tif_pcount, 0);
    if (base.g_relowering) {
        if (base.g_relowering_scratch_func) { arena_use_func(); } else { arena_use_default(); }
    } else { arena_use_default(); }
    return (slice_len(tis) as i64) - 1;
}

pub fn ti_named(kind: string, name: string) i64 {
    var i: i64 = ti_mk(kind);
    var t: TI = tis[i];
    // ⚠ 代际分配器（2026-10-22）：name 可能重降级期在 g_func 计算，须逃逸提升到 g_arena。
    if (base.g_relowering) {
        t.name = base.str_persist(name);
        if (base.g_relowering_scratch_func) { arena_use_func(); }
    } else { t.name = name; }
    slice_set(tis, i, t);
    return i;
}

pub fn ti_with_und(kind: string, name: string, und: string) i64 {
    var i: i64 = ti_named(kind, name);
    var t: TI = tis[i];
    // ⚠ 代际分配器（2026-10-22）：und 可能重降级期在 g_func 计算，须逃逸提升到 g_arena。
    if (base.g_relowering) {
        t.und = base.str_persist(und);
        if (base.g_relowering_scratch_func) { arena_use_func(); }
    } else { t.und = und; }
    slice_set(tis, i, t);
    return i;
}

pub fn ti_elem_of(kind: string, elem: i64) i64 {
    var i: i64 = ti_mk(kind);
    var t: TI = tis[i];
    t.elem = elem;
    slice_set(tis, i, t);
    return i;
}

// 函数类型：ret = 返回类型 TI，参数 TI 存于扁平池 tif_params[pstart .. pstart+pcount)
pub fn ti_func(ret: i64, pstart: i64, pcount: i64) i64 {
    var i: i64 = ti_mk("Func");
    tif_ret[i] = ret;
    tif_pstart[i] = pstart;
    tif_pcount[i] = pcount;
    return i;
}

// ── 硬件 SIMD 向量类型（`@Vector(len, T)`）────────────────────
// 目标本机向量寄存器宽度（字节）。x86-64 基线 = SSE2 的 16B；aarch64 NEON 同为 16B。
// 可用 `--simd-bytes 32|64` 提升到 AVX/AVX-512 档。它只影响诊断与 `@simd_lanes`
// 的取值，**不影响正确性**：更宽的向量由后端自动合法化成多条指令。
pub var g_simd_bytes: i64 = 16;

// 可作为向量 lane 的标量类型：定宽数值（含 bool，按 i8 参与运算）。
pub fn vec_lane_ok(name: string) bool {
    if (name == "i8" or name == "i16" or name == "i32" or name == "i64") { return true; }
    if (name == "u8" or name == "u16" or name == "u32" or name == "u64") { return true; }
    if (name == "f32" or name == "f64") { return true; }
    return name == "bool";
}

// lane 类型的字节宽度（bool 按 1 字节，与 C/LLVM 侧的 i8 表示一致）
pub fn vec_lane_bytes(name: string) i64 {
    if (name == "i8" or name == "u8" or name == "bool") { return 1; }
    if (name == "i16" or name == "u16") { return 2; }
    if (name == "i32" or name == "u32" or name == "f32") { return 4; }
    return 8;
}

// 构造向量 TI：kind="Vector"，elem=lane 类型 TI，alen=lane 数。
pub fn ti_vector(elem: i64, len: i64) i64 {
    var i: i64 = ti_elem_of("Vector", elem);
    var t: TI = tis[i];
    t.alen = len;
    slice_set(tis, i, t);
    return i;
}

pub fn ti_is_vector(ti: i64) bool {
    if (ti < 0) { return false; }
    return tis[ti].kind == "Vector";
}

// 向量的 lane 数（-1 = 非向量）
pub fn ti_vlen(ti: i64) i64 {
    if (ti < 0) { return -1; }
    if (tis[ti].kind != "Vector") { return -1; }
    return tis[ti].alen;
}

// 向量字面量构造的「期望类型」：当数组字面量 `[a,b,c,d]` 作为向量类型的 RHS 时，
// 由赋值 / 变量声明 / return 等父节点注入此全局，infer_expr 据此把字面量推断为向量，
// 并把向量 TD 标记到节点 `ib`（>=0 即表示「此字面量构造向量」），供 codegen 发射成
// `(VTY){...}`（C）/ `<N x T>`（LLVM）。普通数组字面量的 ib 恒为 -1，不会误命中。
//
// ⚠ 必须用 `ib` 而非 `ia`：`ia` 在 array_lit 节点上会被后续管线（comptime 折叠写回 /
// 数组长度回填等）覆写成 -1，实测拿不到标记；`ib` 未被 array_lit 占用，可安全传递。
pub var g_vec_expect: i64 = -1;

// 瓦片字面量构造期望类型（与 g_vec_expect 同机制）：var/let/assign/return/call-arg/全局
// 的期望类型为 @Tile(rows,cols,T,flavor) 时，嵌套数组字面量 `[[a,b],[c,d]]` 被升格为瓦片
// 构造（标记到节点 ib，供 codegen 发射成 `[rows x [cols x T]]`）。同样是全局、递归中需显式清除。
pub var g_tile_expect: i64 = -1;

// 前导点语法的上下文期望类型（`.{...}` / `.a` 用）：var/let/const 注解、return、赋值左值、
// 函数实参等处的「已知具名类型」会注入此处，供 `.{...}` 推断结构体名、`.a` 解析枚举·联合体变体。
// 同样是全局、递归中需显式 save/restore（仿 g_vec_expect）。仅当注入类型为 Struct/Enum/Union
// 时消费者才真正使用，否则忽略（不会误伤）。
pub var g_lead_expect: i64 = -1;

pub fn vec_is_pow2(x: i64) bool {
    if (x <= 0) { return false; }
    return (x & (x - 1)) == 0;
}

// lane 数常量折叠：字面量 → const 声明 → 编译期求值（meta_eval）。
// -1 = 无法在编译期定出宽度（会由 vec_resolve 报 T-VEC-E920）。
pub fn vec_fold_len(tn: i64) i64 {
    if (base.node_ia((tn as u64)) >= 0) { return base.node_ia((tn as u64)); }          // 已折叠过（同一类型节点会被 resolve 多次）
    if (base.node_nb((tn as u64)) < 0) { return -1; }
    if (base.node_kind((base.node_nb((tn as u64)) as u64)) == "int") { return parse_int_len(base.node_sa((base.node_nb((tn as u64)) as u64)), base.node_ia((base.node_nb((tn as u64)) as u64))); }
    if (base.node_kind((base.node_nb((tn as u64)) as u64)) == "paren" or base.node_kind((base.node_nb((tn as u64)) as u64)) == "comptime") {
        // 透传包装：直接看内层（不修改 AST，避免污染其它阶段）
        if (base.node_kind((base.node_na((base.node_nb((tn as u64)) as u64)) as u64)) == "int") { return parse_int_len(base.node_sa((base.node_na((base.node_nb((tn as u64)) as u64)) as u64)), base.node_ia((base.node_na((base.node_nb((tn as u64)) as u64)) as u64))); }
    }
    if (base.node_kind((base.node_nb((tn as u64)) as u64)) == "ident") {
        var vsi: i64 = sym_lookup(global_scope, base.node_sa((base.node_nb((tn as u64)) as u64)));
        if (vsi < 0) { vsi = sym_lookup(cur_scope, base.node_sa((base.node_nb((tn as u64)) as u64))); }
        // ⚠ 只认 `const`：`var n: i64 = 4` 也有 int 初始化器，若一并接受就会把
        //   运行期可变量当成编译期宽度（`n = 8` 之后向量宽度不会跟着变），
        //   等于静默产出错误代码。非 const 一律落到下面的 meta_eval 兜底，
        //   由它判定不可折叠 → 返回 -1 → vec_resolve 报 T-VEC-E920。
        if (vsi >= 0 and syms[vsi].kind == "const") {
            var vsd: i64 = syms[vsi].decl;
            if (vsd >= 0) {
                if (base.node_nb((vsd as u64)) >= 0) {
                    if (base.node_kind((base.node_nb((vsd as u64)) as u64)) == "int") { return parse_int_len(base.node_sa((base.node_nb((vsd as u64)) as u64)), base.node_ia((base.node_nb((vsd as u64)) as u64))); }
                }
            }
        }
    }
    // 兜底：常量算术（`4 * 2`）走编译期求值器。求值失败一律返回 -1，不产生副作用。
    // 静音是必须的：失败路径上 meta_eval 会登记 T-MTA-E620（「meta 上下文禁止读运行
    // 期变量」）这类实现细节诊断，把真正该报给用户的 T-VEC-E920 埋掉。
    if (g_meta_steps < 100000) { g_meta_steps = 100000; }
    var vsave: bool = g_meta_err;
    var dmsave: bool = base.g_diag_mute;
    g_meta_err = false;
    base.g_diag_mute = true;
    var vmv: i64 = meta_eval(base.node_nb((tn as u64)));
    base.g_diag_mute = dmsave;
    var vok: bool = (vmv >= 0) and (g_meta_err == false);
    g_meta_err = vsave;
    if (vok == false) { return -1; }
    if (base.node_kind((vmv as u64)) != "int" and base.node_kind((vmv as u64)) != "bool") { return -1; }
    return mv_get_int(vmv);
}

// 已校验过的向量类型节点（同一节点只报错一次，避免 resolve_ti 多次重入刷屏）
pub var g_vec_checked: []i64;
pub fn vec_checked_has(d: i64) bool {
    var i: i64 = (slice_len(g_vec_checked) as i64) - 1;
    while (i >= 0) {
        if (g_vec_checked[i] == d) { return true; }
        i = i - 1;
    }
    return false;
}

// 已校验过的瓦片类型节点（同 g_vec_checked 意图）
pub var g_tile_checked: []i64;
pub fn tile_checked_has(d: i64) bool {
    var i: i64 = (slice_len(g_tile_checked) as i64) - 1;
    while (i >= 0) {
        if (g_tile_checked[i] == d) { return true; }
        i = i - 1;
    }
    return false;
}

// `@Vector(len, T)` 的解析 + 校验。返回 Vector 的 TI（错误情形下给一个合法的退化
// 宽度，保证后续阶段不崩——诊断已登记，编译会在 emit 前中止）。
pub fn vec_resolve(tn: i64) i64 {
    var velem: i64 = resolve_ti(base.node_na((tn as u64)));
    var vlen: i64 = vec_fold_len(tn);
    var first: bool = vec_checked_has(tn) == false;
    if (first) { append(g_vec_checked, tn); }
    if (vlen < 0) {
        if (first) {
            parse.fc_err("T-VEC-E920",
                "@Vector 的 lane 数必须是编译期常量（整数字面量、`const` 声明的常量或常量算术）；运行期值无法确定向量宽度",
                tn);
        }
        vlen = 1;
    }
    if (tip_kind(velem) != "Scalar" or vec_lane_ok(tip_name(velem)) == false) {
        if (first) {
            parse.fc_err("T-VEC-E921",
                base.sb_cat3("@Vector 的 lane 类型必须是定宽数值标量（i8..i64 / u8..u64 / f32 / f64 / bool）；当前收到: ",
                    ti_str(velem), "。聚合类型请先用 `[]T` / `[N]T` 承载，再逐段装入向量"),
                tn);
        }
        return ti_mk("Unknown");
    }
    var leb: i64 = vec_lane_bytes(tip_name(velem));
    if (vlen < 1) {
        if (first) {
            parse.fc_err("T-VEC-E922",
                base.sb_cat2("@Vector 的 lane 数必须 >= 1；当前为: ", base.i2s(vlen)), tn);
        }
        vlen = 1;
    }
    var vbytes: i64 = vlen * leb;
    if (vbytes < 2 or vec_is_pow2(vbytes) == false) {
        var fixb: i64 = 2;
        while (fixb < vbytes) { fixb = fixb * 2; }
        var fixl: i64 = fixb / leb;
        if (fixl < 1) { fixl = 1; }
        if (first) {
            var sbv: StringBuilder = sb_new();
            sb_append_str(sbv, "@Vector(");
            sb_append_i64(sbv, vlen);
            sb_append_str(sbv, ", ");
            sb_append_str(sbv, tip_name(velem));
            sb_append_str(sbv, ") 的总字节数为 ");
            sb_append_i64(sbv, vbytes);
            sb_append_str(sbv, "（");
            sb_append_i64(sbv, vlen);
            sb_append_str(sbv, " x ");
            sb_append_i64(sbv, leb);
            sb_append_str(sbv, "）——向量寄存器的宽度必须是 2 的幂，建议改用 @Vector(");
            sb_append_i64(sbv, fixl);
            sb_append_str(sbv, ", ");
            sb_append_str(sbv, tip_name(velem));
            sb_append_str(sbv, ")");
            parse.fc_err("T-VEC-E923", sb_to_str(sbv), tn);
        }
        vlen = fixl;
        vbytes = vlen * leb;
    }
    // 超宽告警：这是「CPU 不支持」三层方案中的第二层提示。语义仍然正确——
    // 后端会把宽向量合法化成多条原生向量指令（或纯标量序列），只是不再是单条指令。
    if (first and vbytes > g_simd_bytes) {
        var nl: i64 = g_simd_bytes / leb;
        if (nl < 1) { nl = 1; }
        var sbw: StringBuilder = sb_new();
        sb_append_str(sbw, "@Vector(");
        sb_append_i64(sbw, vlen);
        sb_append_str(sbw, ", ");
        sb_append_str(sbw, tip_name(velem));
        sb_append_str(sbw, ") 占 ");
        sb_append_i64(sbw, vbytes);
        sb_append_str(sbw, " 字节，宽于本机向量寄存器（");
        sb_append_i64(sbw, g_simd_bytes);
        sb_append_str(sbw, " 字节）——将被后端拆分为 ");
        sb_append_i64(sbw, vbytes / g_simd_bytes);
        sb_append_str(sbw, " 条指令执行（结果正确，但不再单指令）。追求单指令请用 @Vector(");
        sb_append_i64(sbw, nl);
        sb_append_str(sbw, ", ");
        sb_append_str(sbw, tip_name(velem));
        sb_append_str(sbw, ")；本机宽度可用 `@simd_lanes(");
        sb_append_str(sbw, tip_name(velem));
        sb_append_str(sbw, ")` 查询");
        base.diag_new("T-VEC-W927", "warning", sb_to_str(sbw),
            parse.n_file(tn), parse.n_line(tn), parse.n_col(tn),
            parse.n_line(tn), parse.n_col(tn) + 8);
    }
    // 回填 lane 数：后端（C typedef / LLVM `<N x T>`）直接读 ia，无需再折叠。
    base.node_set_ia((tn as u64), vlen);
    return ti_vector(velem, vlen);
}

// ── 二维 SIMD 瓦片类型（`@Tile(rows, cols, T, flavor)`）──────────────
// 构造瓦片 TI：kind="Tile"，elem=内层 row 数组 TI([cols x T])，alen=行数，val=flavor 码。
pub fn ti_tile(elem: i64, rows: i64, cols: i64, flavor: i64) i64 {
    var rowti: i64 = ti_elem_of("Array", elem);
    var rt: TI = tis[rowti];
    rt.alen = cols;
    slice_set(tis, rowti, rt);
    var i: i64 = ti_elem_of("Tile", rowti);
    var t: TI = tis[i];
    t.alen = rows;
    t.val = flavor;
    slice_set(tis, i, t);
    return i;
}

pub fn ti_is_tile(ti: i64) bool {
    if (ti < 0) { return false; }
    return tis[ti].kind == "Tile";
}

pub fn ti_trows(ti: i64) i64 {
    if (ti < 0) { return -1; }
    if (tis[ti].kind != "Tile") { return -1; }
    return tis[ti].alen;
}

pub fn ti_tcols(ti: i64) i64 {
    if (ti < 0) { return -1; }
    if (tis[ti].kind != "Tile") { return -1; }
    var e: i64 = tis[ti].elem;
    if (e < 0) { return -1; }
    return tis[e].alen;
}

pub fn ti_tflavor(ti: i64) i64 {
    if (ti < 0) { return -1; }
    if (tis[ti].kind != "Tile") { return -1; }
    return tis[ti].val;
}

// 折叠一个子表达式节点为编译期整数（-1 = 不可折叠）。
// 识别硬件/模拟内建名、const、字面量、常量算术；与 vec_fold_len 同构。
pub fn tile_fold_child(en: i64) i64 {
    if (en < 0) { return -1; }
    if (base.node_kind((en as u64)) == "int") { return parse_int_len(base.node_sa((en as u64)), base.node_ia((en as u64))); }
    if (base.node_kind((en as u64)) == "paren" or base.node_kind((en as u64)) == "comptime") {
        if (base.node_kind((base.node_na((en as u64)) as u64)) == "int") { return parse_int_len(base.node_sa((base.node_na((en as u64)) as u64)), base.node_ia((base.node_na((en as u64)) as u64))); }
    }
    if (base.node_kind((en as u64)) == "ident") {
        if (base.node_sa((en as u64)) == "hardware") { return 0; }
        if (base.node_sa((en as u64)) == "simulate") { return 1; }
        var vsi: i64 = sym_lookup(global_scope, base.node_sa((en as u64)));
        if (vsi < 0) { vsi = sym_lookup(cur_scope, base.node_sa((en as u64))); }
        if (vsi >= 0 and syms[vsi].kind == "const") {
            var vsd: i64 = syms[vsi].decl;
            if (vsd >= 0) {
                if (base.node_nb((vsd as u64)) >= 0) {
                    if (base.node_kind((base.node_nb((vsd as u64)) as u64)) == "int") { return parse_int_len(base.node_sa((base.node_nb((vsd as u64)) as u64)), base.node_ia((base.node_nb((vsd as u64)) as u64))); }
                }
            }
        }
    }
    if (g_meta_steps < 100000) { g_meta_steps = 100000; }
    var vsave: bool = g_meta_err;
    var dmsave: bool = base.g_diag_mute;
    g_meta_err = false;
    base.g_diag_mute = true;
    var vmv: i64 = meta_eval(en);
    base.g_diag_mute = dmsave;
    var vok: bool = (vmv >= 0) and (g_meta_err == false);
    g_meta_err = vsave;
    if (vok == false) { return -1; }
    if (base.node_kind((vmv as u64)) != "int" and base.node_kind((vmv as u64)) != "bool") { return -1; }
    return mv_get_int(vmv);
}

// `@Tile(rows, cols, T, flavor)` 的解析 + 校验。返回 Tile 的 TI。
pub fn tile_resolve(tn: i64) i64 {
    var telem: i64 = resolve_ti(base.node_na((tn as u64)));
    // 已折叠且已校验：直接重建 TI（resolve_ti 可能多次进入同一节点）
    var n_ib: i64 = base.node_ib((tn as u64));   // S4 §0.14.7 SoA：侧表读（原 n.ib）
    if (base.node_ia((tn as u64)) >= 1 and n_ib >= 1 and base.node_la((tn as u64)) >= 0) {
        return ti_tile(telem, base.node_ia((tn as u64)), n_ib, base.node_la((tn as u64)));
    }
    var first: bool = tile_checked_has(tn) == false;
    if (first) { append(g_tile_checked, tn); }
    var rows: i64 = tile_fold_child(base.node_nb((tn as u64)));
    var cols: i64 = tile_fold_child(base.node_nc((tn as u64)));
    var flavor: i64 = tile_fold_child(base.node_nd((tn as u64)));   // S4 §0.14.7 SoA：侧表访问器（原 .nd）
    if (rows < 0) {
        if (first) { parse.fc_err("T-VEC-E940", "@Tile 的行数必须是编译期常量（整数字面量、`const` 声明或常量算术）；运行期值无法确定瓦片形状", tn); }
        rows = 1;
    }
    if (cols < 0) {
        if (first) { parse.fc_err("T-VEC-E941", "@Tile 的列数必须是编译期常量（整数字面量、`const` 声明或常量算术）；运行期值无法确定瓦片形状", tn); }
        cols = 1;
    }
    if (tip_kind(telem) != "Scalar" or vec_lane_ok(tip_name(telem)) == false) {
        if (first) {
            parse.fc_err("T-VEC-E942",
                base.sb_cat3("@Tile 的元素类型必须是定宽数值标量（i8..i64 / u8..u64 / f32 / f64 / bool）；当前收到: ",
                    ti_str(telem), "。聚合类型请先用 `[]T` / `[N]T` 承载，再逐段装入瓦片"), tn);
        }
        return ti_mk("Unknown");
    }
    if (rows < 1) {
        if (first) { parse.fc_err("T-VEC-E943", base.sb_cat2("@Tile 的行数必须 >= 1；当前为: ", base.i2s(rows)), tn); }
        rows = 1;
    }
    if (cols < 1) {
        if (first) { parse.fc_err("T-VEC-E943", base.sb_cat2("@Tile 的列数必须 >= 1；当前为: ", base.i2s(cols)), tn); }
        cols = 1;
    }
    if (flavor < 0 or flavor > 1) {
        if (first) { parse.fc_err("T-VEC-E944", "@Tile 的 flavor 必须是 `hardware` 或 `simulate`（编译期内建枚举值）", tn); }
        flavor = 0;
    }
    // 硬件瓦片：总字节数须为本机向量寄存器宽度的整数倍，否则退化为标量循环（仍正确）
    if (first and flavor == 0) {
        var eb: i64 = vec_lane_bytes(tip_name(telem));
        var total: i64 = rows * cols * eb;
        if (total > 0 and (total % g_simd_bytes) != 0) {
            var sbw: StringBuilder = sb_new();
            sb_append_str(sbw, "@Tile(");
            sb_append_i64(sbw, rows);
            sb_append_str(sbw, ", ");
            sb_append_i64(sbw, cols);
            sb_append_str(sbw, ", ");
            sb_append_str(sbw, tip_name(telem));
            sb_append_str(sbw, ") 占 ");
            sb_append_i64(sbw, total);
            sb_append_str(sbw, " 字节，不是本机向量寄存器（");
            sb_append_i64(sbw, g_simd_bytes);
            sb_append_str(sbw, " 字节）的整数倍——将退化为标量循环（结果正确）");
            base.diag_new("T-VEC-W947", "warning", sb_to_str(sbw),
                parse.n_file(tn), parse.n_line(tn), parse.n_col(tn), parse.n_line(tn), parse.n_col(tn) + 8);
        }
    }
    base.node_set_ia((tn as u64), rows);
    base.node_set_ib((tn as u64), cols);   // S4 §0.14.7 SoA：取代 `tn2.ib`（下方 slice_set 回写生效）
    base.node_set_la((tn as u64), flavor);
    return ti_tile(telem, rows, cols, flavor);
}

// ── 标量类型工具（复刻 types.ts）───────────────────────────────

// >>> GEN:scalar_bits (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
pub fn is_int_name(name: string) bool {
    if (name == "u8" or name == "u16" or name == "u32" or name == "u64") {
        return true;
    }
    if (name == "rune") {
        return true;
    }
    if (name == "i8" or name == "i16" or name == "i32" or name == "i64") {
        return true;
    }
    // 任意位宽整数 `u<N>`（N ∈ [1, 65535]）/`i<N>`（N ∈ [2, 65535]）
    return base.is_awi_name(name);
}

pub fn is_float_name(name: string) bool {
    return name == "f16" or name == "f32" or name == "f64";
}

pub fn get_bw(name: string) i64 {
    if (name == "u8" or name == "i8") {
        return 8;
    }
    if (name == "u16" or name == "i16" or name == "f16") {
        return 16;
    }
    if (name == "u32" or name == "i32" or name == "f32") {
        return 32;
    }
    if (name == "rune") {
        return 32;
    }
    if (name == "u64" or name == "i64" or name == "f64") {
        return 64;
    }
    if (name == "bool") {
        return 1;
    }
    if (name == "atom" or name == "fid") {
        return 64;
    }
    // 任意位宽整数 `i<N>` / `u<N>`：位宽即名字尾数。放在 8/16/32/64 分支之后
    // 仅为可读性 —— awi_bits 对它们给出同样结果，行为不依赖先后顺序。
    var ab: i64 = base.awi_bits(name);
    if (ab > 0) {
        return ab;
    }
    return -1;
}
// <<< GEN:scalar_bits <<<

pub fn ti_scalar(name: string) i64 {
    var i: i64 = ti_named("Scalar", name);
    var t: TI = tis[i];
    t.bw = get_bw(name);
    slice_set(tis, i, t);
    return i;
}

pub fn tip_kind(i: i64) string {
    if (i < 0) {
        return "Unknown";
    }
    var t: TI = tis[i];
    return t.kind;
}

pub fn tip_name(i: i64) string {
    var t: TI = tis[i];
    return t.name;
}

pub fn tip_und(i: i64) string {
    var t: TI = tis[i];
    return t.und;
}

// ══════════════════════════════════════════════════════════════════
// 位域（flag）类型身份判别 —— 积类型统一 epic P3
//
// TI 层已不再有 `Flag` / `FlagSet` 两个 kind：所有积类型统一为 `Struct`，
// 位域身份改由**属性**承载 —— `und`（底层整型名）非空即表示「该 struct 是
// 以整数为底层存储的位域」。
//
// 为什么用 `und` 而不是新增字段：
//   · `und` 原本就是给 Enum/Flag 存底层整型的字段，语义天然契合；
//   · 它此前是**只写不读**的死数据，复用它零成本、不新增 TI 字段（不必
//     改动 ti_mk 与所有 TI 构造点）；
//   · `ti_with_und("Struct", ...)` 只在本文件的 flag 声明/类型位两处产生，
//     不会与普通 struct 混淆 —— 普通 struct 一律走 `ti_named`，`und` 恒空。
//
// ⚠ 判别式必须连带 `kind == "Struct"`：Enum 也有 `und`，但它是 Enum 语义
// （成员是枚举常量而非位槽），不能混为一谈。
// ══════════════════════════════════════════════════════════════════
pub fn tip_is_flag(i: i64) bool {
    if (i < 0) { return false; }
    var t: TI = tis[i];
    return t.kind == "Struct" and t.und != "";
}

// 位域（packed struct）判别。
// ⚠ 不能复用 `tip_is_flag`：它判的是 `und` 非空，而 `und` 目前只有 **Enum** 声明会写
//   （`flag` 关键字在 P7 已移除，packed struct 走 `ti_named`，`und` 恒空）⇒ 该判据恒假。
// ⚠ 也不用 `pk_find_struct`（布局池）：它在 `check_struct_decl` 时才填充，sema 期遇到
//   「函数在前、packed 声明在后」的次序会漏判。`lex__decl_list` 是词法期全量收集，无次序问题。
pub fn tip_is_packed(i: i64) bool {
    if (i < 0) { return false; }
    // 廉价前置过滤：只有 Struct 才可能是位域（标量/枚举/概念名不必去扫 decl_list）。
    if (tip_kind(i) != "Struct") { return false; }
    var sd: i64 = mb_type_decl(tip_name(i));
    if (sd < 0) { return false; }
    if (base.node_kind((sd as u64)) != "StructDecl") { return false; }
    return base.node_sb((sd as u64)) == "packed";
}

// 条件位置（if / while / for 的条件，match 的 `when` 守卫）只接受 bool。
// Unknown 一律放行：该表达式多半已有诊断，再报一次只会级联噪声。
//
// ⚠ 判据不可写成 `tip_kind(i) == "Scalar" && tip_name(i) != "bool"`。
// 那样只拦住标量，String / Slice / Struct / Enum / Func 全部静默漏过 ——
// `if ("hello")`、`while (some_slice)` 曾零诊断通过（2026-08-02 实测）。
// 正确的形状是白名单：唯有 Scalar/bool 合法，其余皆拒。
pub fn is_cond_bool(i: i64) bool {
    var ck: string = tip_kind(i);
    if (ck == "Unknown") {
        return true;
    }
    if (ck == "Scalar" and tip_name(i) == "bool") {
        return true;
    }
    return false;
}

pub fn is_int_ti(i: i64) bool {
    var t: TI = tis[i];
    if (t.kind != "Scalar") {
        return false;
    }
    return is_int_name(t.name);
}

pub fn is_float_ti(i: i64) bool {
    var t: TI = tis[i];
    if (t.kind != "Scalar") {
        return false;
    }
    return is_float_name(t.name);
}

// typesEqual（递归）
// 用户具名类型（struct / enum / flag / union / variant）的已解析种类
// P3：`Flag` / `FlagSet` 已并入 `Struct`，故列表里不再出现这两个 kind ——
// 位域（FlagDecl）与 flag_set（FlagSetDecl）都产出 `Struct`，由本谓词覆盖。
pub fn is_user_named_kind(k: string) bool {
    if (k == "Struct" or k == "Enum") {
        return true;
    }
    return k == "Union" or k == "Variant";
}

pub fn ti_equal(ai: i64, bi: i64) bool {
    var a: TI = tis[ai];
    var b: TI = tis[bi];
    if (a.kind != b.kind) {
        // 「Named」是对用户具名类型的**未解析引用**（resolve_ti 在类型注册前产出）。
        // 与已解析的具名类型（Struct/Enum/...）按名字判等，否则同一类型会因解析时机不同被误判为不等。
        if (a.kind == "Named" and is_user_named_kind(b.kind)) {
            return a.name == b.name;
        }
        if (b.kind == "Named" and is_user_named_kind(a.kind)) {
            return a.name == b.name;
        }
        return false;
    }
    if (a.kind == "Scalar") {
        return a.name == b.name;
    }
    if (a.kind == "Bytes") { return a.name == b.name; }
    if (a.kind == "Void" or a.kind == "String" or a.kind == "StringBuilder") {
        return true;
    }
    // 一等子句（编译期一等值）：同种类即相等。独立种类而非 "Named"，见 ensure_clause_builtins 注释。
    if (a.kind == "Clause") { return true; }
    if (a.kind == "BitStr") { return true; }
    if (a.kind == "Variant" or a.kind == "Unknown") {
        return true;
    }
    if (a.kind == "Array") {
        if (a.alen != b.alen) {
            return false;
        }
        return ti_equal(a.elem, b.elem);
    }
    // 向量：lane 数与 lane 类型都必须一致（SIMD 无隐式提升）
    if (a.kind == "Vector") {
        if (a.alen != b.alen) {
            return false;
        }
        return ti_equal(a.elem, b.elem);
    }
    // 瓦片：行数 + 内层数组（列数 × 元素类型）一致即同类型；flavor 是编译期优化提示，不参与类型判等
    if (a.kind == "Tile") {
        if (a.alen != b.alen) {
            return false;
        }
        return ti_equal(a.elem, b.elem);
    }
    if (a.kind == "Slice" or a.kind == "Pointer" or a.kind == "Optional") {
        return ti_equal(a.elem, b.elem);
    }
    if (a.kind == "Map" and b.kind == "Map") {
        // 任一侧 key/val 为 Unknown（如 map_new 返回值）即放行，支持 map_new() map[K]V 赋值
        var okk: bool = (a.key < 0 or b.key < 0 or ti_equal(a.key, b.key));
        var okv: bool = (a.val < 0 or b.val < 0 or ti_equal(a.val, b.val));
        return okk and okv;
    }
    if (a.kind == "Sym") {
        // 同类型 Sym：同 tag 且同位宽；跨池即不同类型（禁止互赋）
        return a.name == b.name and a.bw == b.bw;
    }
    if (a.kind == "Func") {
        if (tif_pcount[ai] != tif_pcount[bi]) { return false; }
        if (ti_equal(tif_ret[ai], tif_ret[bi]) == false) { return false; }
        var fj: i64 = 0;
        while (fj < tif_pcount[ai]) {
            if (ti_equal(tif_params[tif_pstart[ai] + fj], tif_params[tif_pstart[bi] + fj]) == false) {
                return false;
            }
            fj = fj + 1;
        }
        return true;
    }
    return a.name == b.name;
}

// canExplicitCast
pub fn can_cast(fi: i64, ti2: i64) bool {
    if (ti_equal(fi, ti2)) {
        return true;
    }
    // 数组 ↔ 切片：元素可转型即可（目标为定长数组时要求长度一致）
    var fk: string = tip_kind(fi);
    var tk: string = tip_kind(ti2);
    if ((fk == "Array" or fk == "Slice") and (tk == "Array" or tk == "Slice")) {
        var f: TI = tis[fi];
        var t: TI = tis[ti2];
        if (fk == "Array" and tk == "Array" and f.alen != t.alen) {
            return false;
        }
        // ⚠ 已知缺陷（未修）：Array 与 Slice 的**运行时表示不同** —— `[N]T` 编译成
        // 裸元素指针（长度只活在静态类型里），`[]T` 是 TSlice{ptr,len,esz}。数组
        // *字面量* 初始化切片有就地构造 lowering（正常），但把一个已有的 `[N]T`
        // **变量**传给 `[]T` 形参没有任何转换，后端会把元素字节当 TSlice 头读，
        // 静默返回垃圾长度。这里不能靠 can_cast 一刀切拒绝（它只看类型、不看表达式
        // 来源，会连字面量初始化一起误伤）；正解是在 Array→Slice 处插入
        // t_slice_from_raw(ptr, N, esz) 构造。管道路径已在 pipe 检查里显式拦截。
        if (tip_kind(f.elem) == "Unknown" or tip_kind(t.elem) == "Unknown") {
            return true;
        }
        return can_cast(f.elem, t.elem);
    }
    if (is_int_ti(fi) and is_int_ti(ti2)) {
        return true;
    }
    if (is_float_ti(fi) and is_float_ti(ti2)) {
        return true;
    }
    if (is_int_ti(fi) and is_float_ti(ti2)) {
        return true;
    }
    if (is_float_ti(fi) and is_int_ti(ti2)) {
        return true;
    }
    var f: TI = tis[fi];
    var t: TI = tis[ti2];
    if (f.kind == "Scalar" and f.name == "bool" and is_int_ti(ti2)) {
        return true;
    }
    if (is_int_ti(fi) and t.kind == "Scalar" and t.name == "bool") {
        return true;
    }
    return false;
}

// ── P2（everything-is-value 补齐）：对称 widen-only 最小上界 ──────────
// 与书写顺序无关；只许加宽，禁止窄化或跨「无公共类型」的提升。
// 返回唯一最小上界 TI 索引；候选间无公共可表示类型（如 i16+u16、bool+int）→ -2（报错哨兵）；
// 候选全为 Unknown/Never（被跳过）→ -1。

// 整数类型名是否无符号（'u' 前缀；rune 等有符号不在内）
fn int_is_uns(name: string) bool {
    return name[0] == 117;   // 'u' == 117
}

// 整数类型名的位宽（任意位宽 i<N>/u<N> 走 awi_bits，标准宽度走 get_bw 兜底）
fn int_bits(name: string) i64 {
    var b: i64 = base.awi_bits(name);
    if (b <= 0) {
        b = get_bw(name);
    }
    return b;
}

// 整数 (a_uns, a_bits) 的范围是否包含 (b_uns, b_bits) 的全部值
fn int_contains(au: bool, ab: i64, bu: bool, bb: i64) bool {
    if (au) {
        if (bu) {
            return ab >= bb;        // 无符号 ⊇ 无符号：位宽够
        }
        return false;               // 无符号不能含负数
    }
    // a 有符号
    if (bu) {
        return bb <= ab - 1;        // 有符号 ⊇ 无符号：无符号上界 2^bb-1 <= 有符号上界 2^(ab-1)-1
    }
    return ab >= bb;                // 有符号 ⊇ 有符号：位宽够
}

// 浮点有效尾数位数（含隐式位）：f16=11, f32=24, f64=53
fn float_mant(name: string) i64 {
    if (name == "f16") {
        return 11;
    }
    if (name == "f32") {
        return 24;
    }
    return 53;                      // f64
}

// 整数能否被某浮点（有效尾数 fm）精确表示
fn int_exact_in_float(name: string, fm: i64) bool {
    var iu: bool = int_is_uns(name);
    var ib: i64 = int_bits(name);
    if (iu) {
        return ib <= fm;            // 无符号：2^ib-1 <= 2^fm  ⇔ ib <= fm
    }
    return ib <= fm + 1;            // 有符号：2^(ib-1)-1 <= 2^fm  ⇔ ib-1 <= fm
}

// 一组整数求唯一最小上界；不可比（多极大 / 无极大）→ -2
fn lub_ints(ints: []i64) i64 {
    var best: i64 = -1;
    var k: i64 = 0;
    while (k < slice_len(ints)) {
        var a: i64 = ints[k];
        var au: bool = int_is_uns(tip_name(a));
        var ab: i64 = int_bits(tip_name(a));
        var contains_all: bool = true;
        var j: i64 = 0;
        while (j < slice_len(ints)) {
            if (j == k) {
                j = j + 1;
                continue;
            }
            var bu: bool = int_is_uns(tip_name(ints[j]));
            var bb: i64 = int_bits(tip_name(ints[j]));
            if (int_contains(au, ab, bu, bb) == false) {
                contains_all = false;
                break;
            }
            j = j + 1;
        }
        if (contains_all) {
            if (best >= 0 and ti_equal(a, best) == false) {
                return -2;           // 两个不同极大 → 不可比
            }
            best = a;
        }
        k = k + 1;
    }
    return best;
}

// 对称 widen-only 最小上界（P2 主入口）。ts = 若干分支类型 TI 索引。
pub fn widen_only_lub(ts: []i64) i64 {
    var cs: []i64 = [];
    var k: i64 = 0;
    while (k < slice_len(ts)) {
        var t: i64 = ts[k];
        if (t >= 0 and tip_kind(t) != "Never") {
            append(cs, t);
        }
        k = k + 1;
    }
    if (slice_len(cs) == 0) {
        return -1;
    }
    if (slice_len(cs) == 1) {
        return cs[0];
    }
    var ints: []i64 = [];
    var floats: []i64 = [];
    var saw_bool: bool = false;
    var saw_str: bool = false;
    var saw_other: bool = false;
    k = 0;
    while (k < slice_len(cs)) {
        var t: i64 = cs[k];
        if (tip_kind(t) == "Scalar") {
            var nm: string = tip_name(t);
            if (is_int_name(nm)) {
                append(ints, t);
            } else if (is_float_name(nm)) {
                append(floats, t);
            } else if (nm == "bool") {
                saw_bool = true;
                saw_other = true;
            } else {
                saw_str = true;
                saw_other = true;
            }
        } else {
            saw_other = true;
        }
        k = k + 1;
    }
    // bool / str 与数值混用 → 不可比
    if (saw_bool and (slice_len(ints) > 0 or slice_len(floats) > 0)) {
        return -2;
    }
    if (saw_str and (slice_len(ints) > 0 or slice_len(floats) > 0 or saw_bool)) {
        return -2;
    }
    // 数值与 String / 非标量混用 → 不可比（String 的 kind 是 "String" 非 "Scalar"，归 saw_other）
    if (saw_other and (slice_len(ints) > 0 or slice_len(floats) > 0)) {
        return -2;
    }
    // 纯数值（整型 ± 浮点）
    if (slice_len(ints) > 0 or slice_len(floats) > 0) {
        var f_mant: i64 = -1;
        var f_ti: i64 = -1;
        var ki: i64 = 0;
        while (ki < slice_len(floats)) {
            var fm: i64 = float_mant(tip_name(floats[ki]));
            if (fm > f_mant) {
                f_mant = fm;
                f_ti = floats[ki];
            }
            ki = ki + 1;
        }
        var int_lub: i64 = -1;
        if (slice_len(ints) > 0) {
            int_lub = lub_ints(ints);
            if (int_lub < 0) {
                return -2;
            }
        }
        if (f_ti < 0) {
            return int_lub;
        }
        if (int_lub >= 0 and int_exact_in_float(tip_name(int_lub), f_mant) == false) {
            return -2;
        }
        return f_ti;
    }
    // 纯 bool
    if (saw_bool) {
        var kk: i64 = 0;
        while (kk < slice_len(cs)) {
            if (tip_kind(cs[kk]) != "Scalar" or tip_name(cs[kk]) != "bool") {
                return -2;
            }
            kk = kk + 1;
        }
        return cs[0];
    }
    // 纯 str
    if (saw_str) {
        var kk: i64 = 0;
        while (kk < slice_len(cs)) {
            if (tip_kind(cs[kk]) != "String") {
                return -2;
            }
            kk = kk + 1;
        }
        return cs[0];
    }
    // 非标量（struct/enum/slice/pointer/optional/array/map/func/vector）：须全同类型
    var kk: i64 = 0;
    while (kk < slice_len(cs)) {
        if (ti_equal(cs[kk], cs[0]) == false) {
            return -2;
        }
        kk = kk + 1;
    }
    return cs[0];
}

// 2^bits 的无符号幂（bits ≤ 64；bits == 64 时按 u64 回绕为 0，正好对应 u64 上界 2^64-1）。
pub fn u64_pow2(bits: i64) u64 {
    var r: u64 = 1;
    var i: i64 = 0;
    while (i < bits) {
        r = r * 2;
        i = i + 1;
    }
    return r;
}

// 整数字面量溢出告警。
// 当一个整数字面量（或被一元负号 `-` 包裹的字面量）的实际值，超出目标「有界整数」
// 类型的表示范围时，发出 `overflow_literal` 警告。这是设计本就规划、但此前从未接线的
// 诊断：can_cast 对整数之间一律返回 true（见上），导致 `var x: i8 = 258` 静默按模截断
// 而无任何提示。选 warning 而非 error：截断在运行期是良定义行为（按模回绕），与硬错误
// 不同；若 `@deny(overflow_literal)` 注解管线生效，可提升为错误。
pub fn intlit_overflow_warn(e: i64, target: i64) void {
    if (tip_kind(target) != "Scalar") { return; }
    var tname: string = tip_name(target);
    if (tname == "bool") { return; }                  // bool 走独立标量语义，不算有界整数窄化
    if (is_int_name(tname) == false) { return; }
    var lit_id: i64 = e;
    if (base.node_kind((e as u64)) == "paren") {                         // 透传括号
        var inner: i64 = base.node_na((e as u64));
        lit_id = inner;
    }
    var neg: bool = false;
    if (base.node_kind((e as u64)) == "unary" and base.node_sa((e as u64)) == "-") {         // -257 → unary("-", int 257)
        var opid: i64 = base.node_na((e as u64));
        if (base.node_kind((opid as u64)) == "int") {
            neg = true;
            lit_id = opid;
        } else {
            return;                                    // -x 不是字面量，无法静态定界
        }
    }
    if (base.node_kind((e as u64)) != "int") { return; }
    var v: u64 = lit_u64(base.node_sa((e as u64)));
    var bits: i64 = get_bw(tname);
    // ≥ 64 位时 `u64_pow2` 会绕回 0，算出的 `lim - 1` 反而等于 u64 上界，
    // 等价于「永不告警」—— 这正是既有 i64/u64 的实际行为，此处显式化并早退，
    // 顺带让 N > 64 的任意位宽整数不会因绕回产生假阳性告警。
    if (bits <= 0 or bits >= 64) { return; }
    var is_uns: bool = tname[0] == 117;               // 'u' == 117（不叫 unsigned：C 关键字）
    var lim: u64;
    if (is_uns) {
        lim = u64_pow2(bits);                          // 无符号上界 = 2^bits
    } else {
        lim = u64_pow2(bits - 1);                      // 有符号上界绝对值 = 2^(bits-1)
    }
    var overflow: bool = false;
    if (neg) {
        if (is_uns) {
            overflow = true;                           // 无符号类型不接受任何负值
        } else {
            if (v > lim) { overflow = true; }           // 有符号：|值| 超过下界绝对值
        }
    } else {
        if (v > lim - 1) { overflow = true; }           // 正值：超过上界
    }
    if (overflow) {
        var lit_txt: string = base.node_sa((e as u64));
        if (neg) { lit_txt = base.sb_cat2("-", base.node_sa((e as u64))); }
        var msg: string = base.sb_cat4("整数字面量 `", lit_txt, "` 超出目标类型 `", tname);
        msg = base.sb_cat2(msg, "` 的表示范围，将发生静默截断");
        base.diag_new("T-SEM-W212", "warning", msg,
            parse.n_file(lit_id), parse.n_line(lit_id), parse.n_col(lit_id),
            parse.n_line(lit_id), parse.n_col(lit_id) + (str_len(lit_txt) as i64));
    }
}

// typeToString（递归）
pub fn ti_str(i: i64) string {
    var t: TI = tis[i];
    if (t.kind == "Scalar") {
        return t.name;
    }
    if (t.kind == "Void") {
        return "void";
    }
    if (t.kind == "String") {
        return "string";
    }
    if (t.kind == "StringBuilder") {
        return "StringBuilder";
    }
    if (t.kind == "Array") {
        return base.sb_cat4("[", base.i2s(t.alen), "]", ti_str(t.elem));
    }
    if (t.kind == "Slice") {
        return base.sb_cat2("[]", ti_str(t.elem));
    }
    if (t.kind == "Map") {
        return base.sb_cat4("map[", ti_str(t.key), "]", ti_str(t.val));
    }
    if (t.kind == "Sym") {
        return base.sb_cat5("Sym", base.i2s(t.bw), "(\"", t.name, "\")");
    }
    // 一等子句（编译期一等值）
    if (t.kind == "Clause") { return "clause"; }
    if (t.kind == "Pointer") {
        return base.sb_cat2("*", ti_str(t.elem));
    }
    if (t.kind == "Optional") {
        return base.sb_cat2("?", ti_str(t.elem));
    }
    if (t.kind == "Vector") {
        return base.sb_cat5("@Vector(", base.i2s(t.alen), ", ", ti_str(t.elem), ")");
    }
    if (t.kind == "Tile") {
        var tcols: i64 = 0;
        var telem: i64 = -1;
        if (t.elem >= 0) {
            tcols = tis[t.elem].alen;
            telem = tis[t.elem].elem;
        }
        var tfl: string = "hardware";
        if (t.val == 1) { tfl = "simulate"; }
        var sb: StringBuilder = sb_new();
        sb_append_str(sb, "@Tile(");
        sb_append_i64(sb, t.alen);
        sb_append_str(sb, ", ");
        sb_append_i64(sb, tcols);
        sb_append_str(sb, ", ");
        sb_append_str(sb, ti_str(telem));
        sb_append_str(sb, ", ");
        sb_append_str(sb, tfl);
        sb_append_str(sb, ")");
        return sb_to_str(sb);
    }
    if (t.kind == "Variant") {
        return "Variant";
    }
    if (t.kind == "Func") {
        var s: StringBuilder = sb_new();
        sb_append_str(s, "fn(");
        var fj2: i64 = 0;
        while (fj2 < tif_pcount[i]) {
            if (fj2 > 0) { sb_append_str(s, ", "); }
            sb_append_str(s, ti_str(tif_params[tif_pstart[i] + fj2]));
            fj2 = fj2 + 1;
        }
        sb_append_str(s, ") -> ");
        sb_append_str(s, ti_str(tif_ret[i]));
        return sb_to_str(s);
    }
    if (t.kind == "Unknown") {
        return "<unknown>";
    }
    return t.name;
}

// ── 符号表（扁平池 + scope 链）─────────────────────────────────

pub struct Sym {
    name: string;
    kind: string;   // type/var/func/const
    ti: i64;        // TI 索引
    decl: i64;      // Node 索引（decl），-1 = 无
    scope: i64;
}

pub var syms: []Sym;
pub var scope_parents: []i64;
pub var scope_owner: []i64;   // 工作 B 支柱 1：scope 索引 → 归属节点 id（统一词法树锚点；-1 = 未锚定）

pub fn scope_new(parent: i64) i64 {
    append(scope_parents, parent);
    append(scope_owner, -1);
    return (slice_len(scope_parents) as i64) - 1;
}

// 工作 B 支柱 1：建 scope 并锚定到归属节点（node_scope 侧表）。
// 迁移 cur_scope = scope_new(prev) 站点时改用本函数传入归属节点，使语义作用域树与
// AST 节点树对齐；node_set_scope 把 节点→scope 也写进侧表，IDE/增量可双向查。
// 首增量阶段仍用 scope_new（owner=-1），本函数留待后续逐簇迁移调用点。
pub fn scope_new_at(parent: i64, owner: i64) i64 {
    append(scope_parents, parent);
    append(scope_owner, owner);
    if (owner >= 0) { base.node_set_scope((owner as u64), (slice_len(scope_parents) as i64) - 1); }
    return (slice_len(scope_parents) as i64) - 1;
}

// 工作 B 支柱 1：一致性校验（仅 g_verify_scope_tree=true 时调用，正常编译零行为）。
// 验证：① 每个已锚定 scope 的 owner 节点经 node_scope 反向查回自身（round-trip 一致）；
//       ② scope_parents 链无环、最终收敛到 -1（合法树）。
pub var g_verify_scope_tree: bool = false;

// S7（§4.12.3）：Pass 依赖拓扑校验开关（仅 g_verify_passes=true 时由 run_check 末触发，正常编译零行为）。
pub var g_verify_passes: bool = false;

pub fn verify_scope_tree() bool {
    var n: i64 = slice_len(scope_parents) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (scope_owner[i] >= 0) {
            var back: i64 = base.node_scope((scope_owner[i] as u64));
            if (back != i) { return false; }
        }
        var p: i64 = scope_parents[i];
        var steps: i64 = 0;
        while (p >= 0 and steps <= n) {
            p = scope_parents[p];
            steps = steps + 1;
        }
        if (steps > n) { return false; }   // 有环
        i = i + 1;
    }
    return true;
}

// 仅在指定 scope 内查找（不上溯）。返回**最后**一个匹配，使同作用域内后声明的
// 局部变量 shadow 先声明的（主流语言语义：Rust/JS 同块重定义后者生效）。
// 非 var 种类在 sym_define 处已做去重（最多一个），故 last==first，无副作用。
pub fn sym_find_in(scope: i64, name: string) i64 {
    var n: i64 = slice_len(syms) as i64;
    var i: i64 = n - 1;
    while (i >= 0) {
        var s: Sym = syms[i];
        if (s.scope == scope and s.name == name) {
            return i;
        }
        i = i - 1;
    }
    return -1;
}

// Map.set 语义：var 允许同作用域重定义（shadowing，后声明覆盖先声明）；
// 其余种类（函数 / 类型 / 参数）去重，已存在则忽略（首定义保留）。
pub fn sym_define(scope: i64, name: string, kind: string, ti2: i64, decl: i64) void {
    // 保留标识符（M51）：stdin/stdout/stderr 在表达式位置恒为内建 fid 常量，
    // 若允许同名声明，引用点仍会解析成常量 → 静默错编。故声明位置直接拒绝。
    if (lex.fid_const_of(name) >= 0) {
        parse.fc_err("T-FID-E650",
            base.sb_cat3("`", name, "` 是内建文件描述符常量（保留标识符），不可用作变量 / 参数 / 函数 / 类型名；请改用其他名字"),
            decl);
        return;
    }
    if (kind != "var") {
        if (sym_find_in(scope, name) >= 0) {
            return;
        }
    }
    var s: Sym;
    s.name = name;
    s.kind = kind;
    s.ti = ti2;
    s.decl = decl;
    s.scope = scope;
    append(syms, s);
}

// 沿 scope 链上溯查找
pub fn sym_lookup(scope: i64, name: string) i64 {
    var sc: i64 = scope;
    while (sc >= 0) {
        var f: i64 = sym_find_in(sc, name);
        if (f >= 0) {
            return f;
        }
        sc = scope_parents[sc];
    }
    return -1;
}

pub var global_scope: i64;
pub var cur_scope: i64;
pub var cur_ret: i64;   // 当前函数返回类型（TI 索引）

// ── 诊断定位助手（复刻 tok?.file ?? "" 等）────────────────────




// errorTypeMismatch（复刻 checker.ts:678）
// 间接调用（通过函数类型变量）的实参校验：元数 + 逐位类型
// 调用实参校验（直接调用具名函数 / 经函数类型变量间接调用共用同一份实现）。
// `fname` 为空表示间接调用（无名可报）。
//
// ⚠ 这条校验是内存安全的第一道闸：t 的代码生成对少传的形参**不做任何兜底**，
// 被调方会读到未初始化的栈槽——若那是 string/slice 的 len 字段，就是一个随机
// 天文数字，随后的循环会把 512MB arena 瞬间耗尽（`arena: out of memory`），
// 且现场离真正的错误调用点十万八千里。曾因此排查数小时（tote 的
// `str_concat3(hd, "/.tote/libs")` 少传一参）。宁可误报，绝不放行。
pub fn check_call_args(e: i64, fti: i64, fname: string) void {
    var pstart: i64 = tif_pstart[fti];
    if (pstart < 0) {
        // 签名未记录（如 variant 合成的 Name_from_Case / Name_is_Case 助手：
        // 它们直接 sym_define 了裸 Func tip，没走 register_decl 填 tif_*）。
        // 无签名可比，只能放行——绝不能拿 -1 去索引 tif_params。
        return;
    }
    var want: i64 = tif_pcount[fti];
    var got: i64 = 0;
    var c: i64 = base.node_la((e as u64));
    var mq_ks1227: []i64 = base.kids_chain_idx(base.node_la((e as u64)));
    var mq_ki1227: i64 = 0;
    while (mq_ki1227 < slice_len(mq_ks1227) as i64) {
        c = mq_ks1227[mq_ki1227];
        var k: Child = base.kids[c];
        if (got < want) {
            // 实参位置的向量字面量：形参是 @Vector(N,T) 时注入期望类型，让 `[a,b,c,d]`
            // 按向量构造而非退化成 `[4]i64`（与 assign/var_decl/return 同一机制）。
            //
            // ⚠ 形参**非**向量时必须主动清除（不能只是「不设置」）：g_vec_expect 是全局且
            // 在递归中不自动清除，外层 `var v: @Vector(4,i32) = <expr>` 的期望会一路透传进
            // 深层子表达式。若此处不清，`v = f([1,2,3,4]) + w`（f 形参为数组/切片）里的
            // `[1,2,3,4]` 会被误判成向量 → 无谓的 T-VEC-E924 / 类型不匹配误报。
            var saved_ve4: i64 = g_vec_expect;
            var saved_te4: i64 = g_tile_expect;
            var saved_le4: i64 = g_lead_expect;
            var pt0: i64 = tif_params[pstart + got];
            if (ti_is_vector(pt0)) { g_vec_expect = pt0; g_tile_expect = -1; }
            else if (ti_is_tile(pt0)) { g_tile_expect = pt0; g_vec_expect = -1; }
            else { g_vec_expect = -1; g_tile_expect = -1; }
            g_lead_expect = pt0;
            var at: i64 = infer_expr(k.val);
            g_vec_expect = saved_ve4;
            g_tile_expect = saved_te4;
            g_lead_expect = saved_le4;
            var pt: i64 = tif_params[pstart + got];
            intlit_overflow_warn(k.val, pt);
            if (tip_kind(at) != "Unknown" and ti_equal(pt, at) == false and can_cast(at, pt) == false) {
                err_type_mismatch(k.val, pt, at);
            }
            // #2/#3：Array→Slice / 空数组字面量→Slice 构造。源是 array_lit 或 Array、目标是
            // Slice 且 can_cast 放行时，包裹 cast 节点让后端构造成 TSlice（零拷贝视图或空切片），
            // 替代原先的静默段错误（can_cast 放行但无实际转换）。
            if (tip_kind(pt) == "Slice" and ti_equal(pt, at) == false and can_cast(at, pt)) {
                var sak: string = base.node_kind((k.val as u64));
                if (sak == "array_lit" or tip_kind(at) == "Array") {
                    var ck2: Child = base.kids[c];
                    ck2.val = base.mk_cast(ck2.val, ti_to_type_node(pt), -1);
                    slice_set(base.kids, c, ck2);
                }
            }
        }
        got = got + 1;
        mq_ki1227 = mq_ki1227 + 1;
        c = -1;
    }
    if (got != want) {
        var who: string = "间接调用";
        if (str_len(fname) > 0) { who = base.sb_cat3("调用 `", fname, "`"); }
        parse.fc_err("T-SEM-E206",
            base.sb_cat6(who, " 实参个数不符：", ti_str(fti), " 需要 ", base.i2s(want),
                base.sb_cat3(" 个实参，实际给了 ", base.i2s(got), " 个")), e);
    }
}

pub fn check_indirect_call(e: i64, fti: i64) void {
    check_call_args(e, fti, "");
}

pub fn err_type_mismatch(eni: i64, exp: i64, act: i64) void {
    var es: string = ti_str(exp);
    var fs2: string = ti_str(act);
    var l: i64 = parse.n_line(eni);
    var c: i64 = parse.n_col(eni);
    var di: i64 = base.diag_new("T-SEM-E202", "error",
        base.sb_cat4("type mismatch: expected ", es, " but got ", fs2),
        parse.n_file(eni), l, c, l, c + 5);
    base.slb_begin();
    base.slb_add(base.sb_cat2("expected: ", es));
    base.slb_add(base.sb_cat2("found:    ", fs2));
    base.diag_set_nt(di, base.slb_head);
}

// ── 整数字面量解析（复刻 BigInt(value) 与 parseInt(value,radix)）──

// BigInt 语义：识别 0x/0X、0b/0B、0o/0O 前缀。
// 实现集中在 base.tc 的 `lit_val_u64`（带 u64 溢出检测），此处只做转发 ——
// 词法/语法/语义三层必须对同一串字面量折算出同一个值。
pub fn lit_u64(v: string) u64 {
    return base.lit_val_u64(v);
}

// parseInt(value, radix) 语义：radix=16 接受 0x 前缀；其余按位解析，
// 遇非法字符停止
pub fn parse_int_len(v: string, radix: i64) i64 {
    var n: u64 = str_len(v);
    var r: i64 = 0;
    if (radix == 16) {
        var i: u64 = 0;
        if (n >= 2 and v[0] == 48 and (v[1] == 120 or v[1] == 88)) {
            i = 2;
        }
        while (i < n) {
            var c: u8 = v[i];
            var d: i64 = -1;
            if (c >= 48 and c <= 57) {
                d = (c - 48) as i64;
            }
            if (c >= 97 and c <= 102) {
                d = (c - 87) as i64;
            }
            if (c >= 65 and c <= 70) {
                d = (c - 55) as i64;
            }
            if (d < 0) {
                return r;
            }
            r = r * 16 + d;
            i = i + 1;
        }
        return r;
    }
    if (radix == 2) {
        var j: u64 = 0;
        while (j < n) {
            var c2: u8 = v[j];
            if (c2 != 48 and c2 != 49) {
                return r;
            }
            r = r * 2 + ((c2 - 48) as i64);
            j = j + 1;
        }
        return r;
    }
    var k: u64 = 0;
    while (k < n) {
        var c3: u8 = v[k];
        if (c3 < 48 or c3 > 57) {
            return r;
        }
        r = r * 10 + ((c3 - 48) as i64);
        k = k + 1;
    }
    return r;
}

// ── 类型解析 resolveType（复刻 checker.ts:134）────────────────

// ── 反射内建类型（TypeInfo / TypeMeta / FieldInfo）在用户代码里的可 match 化 ──
// 背景：base.tc 将三者声明为 t-native variant/struct，但用户/示例编译单元不导入 base.tc，
// 故 `TypeInfo` 经 resolve_ti 解析为合成描述符（kind="TypeInfo"），匹配器不认作 variant。
// 此处惰性构造「合成声明」并 sym_define 进 global_scope，使 TypeInfo 在用户代码里成为可
// match 的 variant（与 base.tc 内部一致；后端 desugar / 布局知识已就绪，无需改动）。
// 仅当用户代码未自行声明这些名字时（即非编译 base.tc 自身）才注入，避免与真实声明冲突。
pub var g_refl_builtins_done: bool = false;
pub var g_ti_TypeInfo_ti: i64 = -1;
pub var g_ti_TypeMeta_ti: i64 = -1;
pub var g_ti_FieldInfo_ti: i64 = -1;

pub fn ensure_reflection_builtins() void {
    if (g_refl_builtins_done) { return; }
    g_refl_builtins_done = true;

    // TypeMeta：name:string, size:i64, kind:i64, field_count:i64, fields:[]FieldInfo
    // 字段顺序须与后端硬编码布局（c_ti_emit_support / tir_to_ll 的 @__ti_<T>_meta）严格一致。
    var tmf: i64 = -1; var tmt: i64 = -1;
    tmt = base.list_push(tmf, tmt, base.mk_member("name", base.mk_scalar("string", -1), -1)); if (tmf < 0) { tmf = tmt; }
    tmt = base.list_push(tmf, tmt, base.mk_member("size", base.mk_scalar("i64", -1), -1)); if (tmf < 0) { tmf = tmt; }
    tmt = base.list_push(tmf, tmt, base.mk_member("kind", base.mk_scalar("i64", -1), -1)); if (tmf < 0) { tmf = tmt; }
    tmt = base.list_push(tmf, tmt, base.mk_member("field_count", base.mk_scalar("i64", -1), -1)); if (tmf < 0) { tmf = tmt; }
    tmt = base.list_push(tmf, tmt, base.mk_member("fields", base.mk_slice(base.mk_named("FieldInfo", -1), -1), -1)); if (tmf < 0) { tmf = tmt; }
    // 阶段1 S5：field_types: []type（comptime 合成的 type 值数组，与运行时 field_type_names 字符串数组区分）。
    tmt = base.list_push(tmf, tmt, base.mk_member("field_types", base.mk_slice(base.mk_named("type", -1), -1), -1)); if (tmf < 0) { tmf = tmt; }
    if (sym_lookup(global_scope, "TypeMeta") < 0) {
        var tm_decl: i64 = base.mk_StructDecl("TypeMeta", "", "", false, false, -1, tmf, -1);
        g_ti_TypeMeta_ti = ti_named("Struct", "TypeMeta");
        sym_define(global_scope, "TypeMeta", "type", g_ti_TypeMeta_ti, tm_decl);
        // ⚠ string 字段**必须**用 mk_scalar("string")（scalar kind），不可用 mk_named。
        //   否则 resolve_type_desc 对该节点落 unknown ⇒ tir_field_st 回落 "i64" ⇒
        //   `m.fields[i].name` 的 LOAD 只取前 8 字节（TStr 的 ptr），len 恒 0 ⇒ **静默读出空串**
        //   （不报错，最危险的失败形态）。scalar 分支则正确得 td_mk("string") → %TStr。
        // ⚠ 刻意**不**把 TypeMeta/FieldInfo 加进 decl_list：一旦进 decl_list，sema 的结构
        //   字段检查轮会把这些合成字段按具名类型解析 → T-SEM-E200 UNKNOWN_TYPE `string`。
        //   二者靠 global_scope 的 sym 已足够：
        // find_struct_fields 正是按 global_scope 查 SymbolDecl 取字段链（已验证可用）。
        // 真正需要 decl_list 的只有 variant 检测，见下方 TypeInfo。
    }

    // FieldInfo：name:string, offset:i64, type_name:string, type_size:i64, is_ptr:bool, tag:i64
    var fif: i64 = -1; var fit: i64 = -1;
    fit = base.list_push(fif, fit, base.mk_member("name", base.mk_scalar("string", -1), -1)); if (fif < 0) { fif = fit; }
    fit = base.list_push(fif, fit, base.mk_member("offset", base.mk_scalar("i64", -1), -1)); if (fif < 0) { fif = fit; }
    fit = base.list_push(fif, fit, base.mk_member("type_name", base.mk_scalar("string", -1), -1)); if (fif < 0) { fif = fit; }
    fit = base.list_push(fif, fit, base.mk_member("type_size", base.mk_scalar("i64", -1), -1)); if (fif < 0) { fif = fit; }
    fit = base.list_push(fif, fit, base.mk_member("is_ptr", base.mk_scalar("bool", -1), -1)); if (fif < 0) { fif = fit; }
    fit = base.list_push(fif, fit, base.mk_member("tag", base.mk_scalar("i64", -1), -1)); if (fif < 0) { fif = fit; }
    if (sym_lookup(global_scope, "FieldInfo") < 0) {
        var fi_decl: i64 = base.mk_StructDecl("FieldInfo", "", "", false, false, -1, fif, -1);
        g_ti_FieldInfo_ti = ti_named("Struct", "FieldInfo");
        sym_define(global_scope, "FieldInfo", "type", g_ti_FieldInfo_ti, fi_decl);
    }

    // TypeInfo variant arms：Int=0 … Union=10，Module=11（顺序对齐 base.tc:5606），单载荷 *TypeMeta（Bool 无载荷）
    var ptr_tm: i64 = base.mk_pointer(base.mk_named("TypeMeta", -1), -1);
    var vcs: i64 = -1; var vct: i64 = -1;
    vct = base.list_push(vcs, vct, base.mk_VC("Int", 0, ptr_tm, -1, -1)); if (vcs < 0) { vcs = vct; }
    vct = base.list_push(vcs, vct, base.mk_VC("Float", 1, ptr_tm, -1, -1)); if (vcs < 0) { vcs = vct; }
    vct = base.list_push(vcs, vct, base.mk_VC("Bool", 2, -1, -1, -1)); if (vcs < 0) { vcs = vct; }
    vct = base.list_push(vcs, vct, base.mk_VC("Ptr", 3, ptr_tm, -1, -1)); if (vcs < 0) { vcs = vct; }
    vct = base.list_push(vcs, vct, base.mk_VC("Slice", 4, ptr_tm, -1, -1)); if (vcs < 0) { vcs = vct; }
    vct = base.list_push(vcs, vct, base.mk_VC("Array", 5, ptr_tm, -1, -1)); if (vcs < 0) { vcs = vct; }
    vct = base.list_push(vcs, vct, base.mk_VC("Fn", 6, ptr_tm, -1, -1)); if (vcs < 0) { vcs = vct; }
    vct = base.list_push(vcs, vct, base.mk_VC("Struct", 7, ptr_tm, -1, -1)); if (vcs < 0) { vcs = vct; }
    vct = base.list_push(vcs, vct, base.mk_VC("Enum", 8, ptr_tm, -1, -1)); if (vcs < 0) { vcs = vct; }
    vct = base.list_push(vcs, vct, base.mk_VC("Trait", 9, ptr_tm, -1, -1)); if (vcs < 0) { vcs = vct; }
    vct = base.list_push(vcs, vct, base.mk_VC("Union", 10, ptr_tm, -1, -1)); if (vcs < 0) { vcs = vct; }
    // Module arm（=11）：@import("M") 绑定的模块类型；单载荷 *TypeMeta，与 Struct/Enum 同构。
    vct = base.list_push(vcs, vct, base.mk_VC("Module", 11, ptr_tm, -1, -1)); if (vcs < 0) { vcs = vct; }
    if (sym_lookup(global_scope, "TypeInfo") < 0) {
        var ti_decl: i64 = base.mk_VariantDecl("TypeInfo", -1, vcs, -1);
        g_ti_TypeInfo_ti = ti_named("Variant", "TypeInfo");
        sym_define(global_scope, "TypeInfo", "type", g_ti_TypeInfo_ti, ti_decl);
        // ⚠ 刻意**不**进 decl_list：TypeInfo 一旦进 decl_list，generic variant emitter 会
        // 按 `{ i64, [N x i8] }` 再发一份 `%TypeInfo`，与反射支持硬编码的 `%TypeInfo = type
        // { i64, ptr }`（tir_to_ll.tc:5216）重复定义 → clang `redefinition of type`。
        // 变体判定改由 tir.tc 的 tir_is_reflection_variant / t_variant_decl_of_name_ex
        // 回退按 global_scope 的 sym decl 识别（见其注释）。
    }
}

// ══════════════════════════════════════════════════════════════
// 一等子句的合成内建（惰性注入，与 ensure_reflection_builtins 同规格）：
//   · `ClauseKind` —— 子句类别枚举，当前成员仅 `pattern`；后续子功能追加成员即可，
//     `@clause` 的语法与展开通通不变（设计 §5.1.1）。
//   · `clause`     —— 编译期一等值的类型（设计 §4）。刻意注册为普通 named 类型，
//     使 `[N]clause` 直接复用既有数组设施（字面量、下标、`++` 的 `[N+M]` 规则）。
// ⚠ 两者都在用户已自行声明同名类型时让位（sym 查找优先），与 TypeInfo 的处理同款。
// ══════════════════════════════════════════════════════════════
pub var g_clause_builtins_done: bool = false;
pub var g_ti_clause: i64 = -1;
pub var g_ti_ClauseKind_ti: i64 = -1;

// 类型（或类型的元素，递归）是否涉及 clause —— T-CLA-E724 的越界判据。
// 覆盖 `clause` 本身与 `[N]clause` / `[N][M]clause` 等聚合形态。
// 求值结果是否是一个子句组（clause 单体 / array_lit 且元素皆 clause）。
// 用于 N14 的 clause 值形参：实参求值后必须真是子句组，否则无从展开。
pub fn meta_node_is_clause_group(n: i64) bool {
    if (n < 0) { return false; }
    var k: string = base.node_kind((n as u64));
    if (k == "clause") { return true; }
    if (k == "array_lit") {
        var ks: []i64 = base.kids_chain(base.node_la((n as u64)));
        if (slice_len(ks) == 0) { return false; }
        var i: i64 = 0;
        while (i < slice_len(ks) as i64) {
            if (base.node_kind((ks[i] as u64)) != "clause") { return false; }
            i = i + 1;
        }
        return true;
    }
    return false;
}

// N14 单态 key：按**实参的源码位置**区分实例。
// ⚠ 不能用 meta_val_key（它回落去哈希 node.sa，而子句组节点的 sa 为空 ⇒
//   两个不同的 group 会算出同一个 key ⇒ 共用同一实例 ⇒ **静默得到错结果**）。
//   用 span（line/col）作 key：不同实参位置必不同；同一实参重复求值仍命中缓存（幂等）。
pub fn clause_group_key(a: i64) string {
    var sp: Span = base.node_span_id(a);
    return base.sb_cat3("g", base.i2s(sp.line as i64), base.sb_cat2("_", base.i2s(sp.col as i64)));
}

pub fn clause_ti_involves(ti: i64) bool {
    if (ti < 0) { return false; }
    var k: string = tip_kind(ti);
    if (k == "Clause") { return true; }
    if (k == "Array" or k == "Slice") {
        if (tis[ti].elem >= 0) { return clause_ti_involves(tis[ti].elem); }
    }
    return false;
}

pub fn ensure_clause_builtins() void {
    if (g_clause_builtins_done) { return; }
    g_clause_builtins_done = true;
    if (sym_lookup(global_scope, "ClauseKind") < 0) {
        var ch: i64 = -1;
        var ct: i64 = -1;
        ct = base.list_push(ch, ct, base.mk_V("pattern", -1, -1, -1));
        if (ch < 0) { ch = ct; }
        var ck_decl: i64 = base.mk_EnumDecl("ClauseKind", "u8", -1, ch, -1);
        g_ti_ClauseKind_ti = ti_named("Enum", "ClauseKind");
        sym_define(global_scope, "ClauseKind", "type", g_ti_ClauseKind_ti, ck_decl);
    }
    if (sym_lookup(global_scope, "clause") < 0) {
        // ⚠ 刻意用**独立的 TI 种类 "Clause"**，而不是 ti_named("Named", ...)：
        // "Named" 是对用户具名类型的**未解析引用**，语义上等同 Unknown —— 实测
        // `fn f() i64 { return a; }`（a 是 clause）会 0 error 静默放行，属静默错编。
        // 独立种类让 ti_equal / ti_str 有明确分支，也让「漏到运行期」可硬拦（T-CLA-E724）。
        g_ti_clause = ti_mk("Clause");
        var cti: TI = tis[g_ti_clause];
        cti.name = "clause";
        slice_set(tis, g_ti_clause, cti);
        sym_define(global_scope, "clause", "type", g_ti_clause, -1);
    }
}

pub fn resolve_ti(tn: i64) i64 {
    if (tn < 0) {
        return ti_mk("Unknown");
    }
    if (base.node_kind((tn as u64)) == "any") {
        return ti_mk("Any");
    }
    if (base.node_kind((tn as u64)) == "infer_ret") {
        if (g_infer_ti < 0) { g_infer_ti = ti_mk("Infer"); }
        return g_infer_ti;
    }
    if (base.node_kind((tn as u64)) == "type") {
        return ti_mk("Any");
    }
    if (base.node_kind((tn as u64)) == "scalar") {
        // 特名优先于 is_scalar_name：bytes / BytesBuilder 虽被 is_scalar_name 命中，
        // 但须解析为独立的 Bytes / StringBuilder 种类（而非笼统 Scalar），否则与
        // bsb_* 内建返回类型永远对不上。string / StringBuilder 亦在此显式分流。
        if (base.node_sa((tn as u64)) == "void") {
            return ti_mk("Void");
        }
        if (base.node_sa((tn as u64)) == "string") {
            return ti_mk("String");
        }
        if (base.node_sa((tn as u64)) == "StringBuilder") {
            return ti_mk("StringBuilder");
        }
        if (base.node_sa((tn as u64)) == "bytes") {
            return ti_mk("Bytes");
        }
        if (base.node_sa((tn as u64)) == "BytesBuilder") {
            return ti_mk("StringBuilder");
        }
        if (parse.is_scalar_name(base.node_sa((tn as u64)))) {
            return ti_scalar(base.node_sa((tn as u64)));
        }
        return ti_named("Named", base.node_sa((tn as u64)));
    }
    if (base.node_kind((tn as u64)) == "array") {
        var elem: i64 = resolve_ti(base.node_na((tn as u64)));
        var length: i64 = 0;
        if (base.node_nb((tn as u64)) >= 0) {
            if (base.node_kind((base.node_nb((tn as u64)) as u64)) == "int") {
                length = parse_int_len(base.node_sa((base.node_nb((tn as u64)) as u64)), base.node_ia((base.node_nb((tn as u64)) as u64)));
            }
        }
        var ai: i64 = ti_elem_of("Array", elem);
        var at: TI = tis[ai];
        at.alen = length;
        slice_set(tis, ai, at);
        return ai;
    }
// >>> GEN:type_slice (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
    if (base.node_kind((tn as u64)) == "slice") {
        return ti_elem_of("Slice", resolve_ti(base.node_na((tn as u64))));
    }
// <<< GEN:type_slice <<<
    if (base.node_kind((tn as u64)) == "map") {
        var kt: i64 = resolve_ti(base.node_na((tn as u64)));
        var vt: i64 = resolve_ti(base.node_nb((tn as u64)));
        var mi: i64 = ti_mk("Map");
        var mt: TI = tis[mi];
        mt.key = kt;
        mt.val = vt;
        slice_set(tis, mi, mt);
        return mi;
    }
    if (base.node_kind((tn as u64)) == "sym") {
        var syi: i64 = ti_named("Sym", base.node_sa((tn as u64)));
        var syt: TI = tis[syi];
        syt.bw = base.node_ia((tn as u64));
        syt.alen = base.node_ia((tn as u64));   // Sym 位宽同时记入 alen，供 td_sname/tir_st_of_td/c_type/前端 bits 统一读取
        slice_set(tis, syi, syt);
        return syi;
    }
    if (base.node_kind((tn as u64)) == "named") {
        var rnm: string = base.node_sa((tn as u64));
        // 一等子句的合成类型（设计 §4 / §5.1.1）：用户自行声明了同名类型则以用户的为准。
        if (rnm == "clause" or rnm == "ClauseKind") {
            var csi: i64 = sym_lookup(global_scope, rnm);
            if (csi >= 0 and syms[csi].decl >= 0) { return syms[csi].ti; }
            ensure_clause_builtins();
            if (rnm == "clause") { return g_ti_clause; }
            return g_ti_ClauseKind_ti;
        }
        // 反射内建类型：若用户已自行声明（如编译 base.tc 自身）则走真实声明，
        // 否则惰性注入合成 VariantDecl/StructDecl，使 TypeInfo 在用户代码里可 match。
        if (rnm == "TypeInfo" or rnm == "TypeMeta" or rnm == "FieldInfo") {
            var rsi: i64 = sym_lookup(global_scope, rnm);
            if (rsi >= 0 and syms[rsi].decl >= 0) { return syms[rsi].ti; }
            ensure_reflection_builtins();
            if (rnm == "TypeInfo") { return g_ti_TypeInfo_ti; }
            if (rnm == "TypeMeta") { return g_ti_TypeMeta_ti; }
            return g_ti_FieldInfo_ti;
        }
        // 位串基元类型 `bitstr`（§15）：值级 (ptr u8, bit_len, cap)，与 []u8 同构。
        if (rnm == "bitstr") { return ti_mk("BitStr"); }
        var si: i64 = sym_lookup(global_scope, base.node_sa((tn as u64)));
        if (si < 0) { si = sym_lookup(cur_scope, base.node_sa((tn as u64))); }
        if (si >= 0) {
            var s: Sym = syms[si];
            // concept 约束类型不可实例化：在值类型位置引用即报错（泛型边界除外，由 #4b 处理）。
            if (s.kind == "concept") {
                parse.fc_err("T-CON-E100",
                    base.sb_cat3("concept '", base.node_sa((tn as u64)), "' cannot be instantiated (it is a constraint, not a type)"), tn);
                return ti_named("Struct", base.node_sa((tn as u64)));
            }
            return s.ti;
        }
        // 裸 `Sym` = 默认 32 位池的一级符号句柄（docs/compiler/meta_design.md §8）。
        // 刻意放在用户查找**之后**：谁自己声明了 `Sym` 类型谁说了算（tc.tc 自身就有）。
        if (base.node_sa((tn as u64)) == "Sym") {
            var syd: i64 = ti_named("Sym", "");
            var syt2: TI = tis[syd];
            syt2.bw = 32;
            syt2.alen = 32;
            slice_set(tis, syd, syt2);
            return syd;
        }
        // 未定义命名类型：报错（不再静默 Named）。meta 类型参数实例化期已被替换为
        // 具体类型，若仍以 named 形态到达此处，排除 meta 环境已绑定的名字。
        if (menv_find(base.node_sa((tn as u64))) >= 0) { return ti_named("Named", base.node_sa((tn as u64))); }
        if (gen_tparam_has(base.node_sa((tn as u64)))) { return ti_named("Named", base.node_sa((tn as u64))); }
        parse.fc_err("T-SEM-E200", base.sb_cat3("未定义类型 `", base.node_sa((tn as u64)), "`"), tn);
        return ti_mk("Unknown");
    }
// >>> GEN:type_resolve (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
    if (base.node_kind((tn as u64)) == "variant") {
        return ti_mk("Variant");
    }
    // P3：位域在 TI 层即 `Struct`，底层整型落在 `und`（`tip_is_flag` 的判别依据）。
    if (base.node_kind((tn as u64)) == "pointer") {
        return ti_elem_of("Pointer", resolve_ti(base.node_na((tn as u64))));
    }
    if (base.node_kind((tn as u64)) == "optional") {
        return ti_elem_of("Optional", resolve_ti(base.node_na((tn as u64))));
    }
// <<< GEN:type_resolve <<<
    // 硬件 SIMD 向量类型 `@Vector(len, T)`：解析元素类型 + 折叠 lane 数，并做三档校验
    // （lane 类型定宽数值 / lane 数 >=1 / 总字节数为 2 的幂）。超本机宽度只告警不报错：
    // 后端会把宽向量合法化为多条指令，语义始终正确——这正是「CPU 不支持」的兜底层。
    if (base.node_kind((tn as u64)) == "vector") {
        return vec_resolve(tn);
    }
    if (base.node_kind((tn as u64)) == "tile") {
        return tile_resolve(tn);
    }
    if (base.node_kind((tn as u64)) == "func_type") {
        // 先把参数类型解析到局部表，再整段搬进 tif_params——
        // 嵌套函数类型会在递归里自行 append，直接边解析边 append 会打断本层参数区的连续性。
        var fret: i64 = resolve_ti(base.node_na((tn as u64)));
        var fbuf: []i64;
        var fk: i64 = base.node_la((tn as u64));
        var mq_ks1496: []i64 = base.kids_chain_idx(base.node_la((tn as u64)));
        var mq_ki1496: i64 = 0;
        while (mq_ki1496 < slice_len(mq_ks1496) as i64) {
            fk = mq_ks1496[mq_ki1496];
            var fc: Child = base.kids[fk];
            append(fbuf, resolve_ti(fc.val));
            mq_ki1496 = mq_ki1496 + 1;
            fk = -1;
        }
        var fpstart: i64 = slice_len(tif_params) as i64;
        var fpc: i64 = slice_len(fbuf) as i64;
        var fj0: i64 = 0;
        if (base.g_relowering) { arena_use_default(); }
        while (fj0 < fpc) {
            append(tif_params, fbuf[fj0]);
            fj0 = fj0 + 1;
        }
        if (base.g_relowering) {
            if (base.g_relowering_scratch_func) { arena_use_func(); } else { arena_use_default(); }
        } else { arena_use_default(); }
        return ti_func(fret, fpstart, fpc);
    }
    return ti_mk("Unknown");
}

// TI → 类型节点（resolve_ti 的反函数）。用于局部类型推断后回填 var_decl.n.na，
// 使发射侧 emit_ctype(n.na) 拿到真实类型。仅覆盖推断常见类型；其余退化为 named 节点
// （resolve_ti 仍能查回），足够 v1 推断使用。
pub fn mk_type_node_from_ti(ti: i64) u64 {
    if (ti < 0) { return -1; }
    var t: TI = tis[ti];
    var k: string = t.kind;
    if (k == "Scalar") { return base.mk_scalar(t.name, -1); }
    if (k == "Void") { return base.mk_scalar("void", -1); }
    if (k == "String") { return base.mk_scalar("string", -1); }
    if (k == "StringBuilder") { return base.mk_scalar("StringBuilder", -1); }
    if (k == "Bytes") { return base.mk_scalar("bytes", -1); }
    if (k == "BitStr") { return base.mk_named("bitstr", -1); }
    if (k == "Named") { return base.mk_named(t.name, -1); }
    if (k == "Slice") { return base.mk_slice(mk_type_node_from_ti(t.elem), -1); }
    // ⚠ 曾漏掉 Array 分支：定长数组落到末尾兜底的 base.mk_named(k) → 合成出类型节点
    // `Array`，resolve 时报 T-SEM-E200「未定义类型 `Array`」。管道降解
    // （pipe_flush 用本函数回填辅助函数形参）对 `[N]T` 左操作数因此全线不可用，
    // 违背 §3.15.2 规则 4。array 类型节点 = base.mk_array(元素类型节点, 长度 int 节点)。
    if (k == "Array") {
        return base.mk_array(mk_type_node_from_ti(t.elem), base.mk_int(base.i2s(t.alen), 10, -1), -1);
    }
    if (k == "Pointer") { return base.mk_pointer(mk_type_node_from_ti(t.elem), -1); }
    if (k == "Optional") { return base.mk_optional(mk_type_node_from_ti(t.elem), -1); }
    if (k == "Vector") {
        var vln: i64 = base.mk_int(base.i2s(t.alen), 10, -1);
        var vid: i64 = base.mk_vector(mk_type_node_from_ti(t.elem), vln, -1);
        base.node_set_ia((vid as u64), t.alen);
        return vid;
    }
    if (k == "Map") { return base.mk_map(mk_type_node_from_ti(t.key), mk_type_node_from_ti(t.val), -1); }
    if (k == "Func") {
        var fret: i64 = mk_type_node_from_ti(tif_ret[ti]);
        var ph: i64 = -1;
        var pt: i64 = -1;
        var pstart: i64 = tif_pstart[ti];
        var pc: i64 = tif_pcount[ti];
        var jj: i64 = 0;
        while (jj < pc) {
            // ⚠ func_type.la 是**裸类型节点**链，不是 P 节点链（见 parse_type 的
            // KwFunc 分支、resolve_ti / resolve_type_desc 的 func_type 分支）。
            // 早先这里错包了一层 mk_P，导致回填出的函数类型形参一律解析成 <unknown>。
            pt = base.list_push(ph, pt, mk_type_node_from_ti(tif_params[pstart + jj]));
            if (ph < 0) { ph = pt; }
            jj = jj + 1;
        }
        return base.mk_func_type(fret, ph, -1);
    }
    // Flag / FlagSet / Enum / Union / Variant / Sym / TypeInfo / FieldInfo / Unknown：
    // 退化为 named 节点，resolve_ti 仍能查回（推断分支少见）。
    var nm: string = t.name;
    if (nm == "") { nm = k; }
    return base.mk_named(nm, -1);
}

// ═══════════════════════════════════════════════════════════
// comptime 类型模板参数 `any`（Zig 式 anytype / 编译期泛型）：
//   foo fn(comptime T: any) T { ... }      // T 在编译期承载「任意类型」
//   foo(i64)                               // 调用点按实参类型单态化
// 调用点检测 → 深克隆 FuncDecl → 类型替换（T → 具体类型）→ 去掉 comptime
// 参数 → 改名 foo__i64 → 追加 decl_list 参与检查/发射。整个机制仅对「含
// comptime 参数」的函数触发（func_is_generic 门控），普通函数零影响。
// ═══════════════════════════════════════════════════════════

pub fn func_is_generic(d: i64) bool {
    if (base.node_kind((d as u64)) != "FuncDecl") { return false; }
    var p: i64 = base.node_lb((d as u64));
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环
    var ks1580: []i64 = base.kids_chain(p);
    var ki1580: i64 = 0;
    while (ki1580 < slice_len(ks1580) as i64) {
        var kv1580: i64 = ks1580[ki1580];
        if (base.node_bb((kv1580 as u64)) == true) { return true; }   // S4 §0.14.7 SoA：侧表读
        ki1580 = ki1580 + 1;
    }
    return false;
}

// 从类型名标识符造类型节点（复用 parse_type 的标识符分支语义）
pub fn type_node_from_ident(name: string) i64 {
    if (parse.is_scalar_name(name)) { return base.mk_scalar(name, -1); }
    if (name == "void") { return base.mk_scalar("void", -1); }
    if (name == "string") { return base.mk_scalar("string", -1); }
    if (name == "StringBuilder") { return base.mk_scalar("StringBuilder", -1); }
    return base.mk_named(name, -1);
}

// 名字是否为已声明的类型（struct/enum/flag/variant/typealias 等；标量由 is_scalar_name 覆盖）。
// check 阶段以全局符号表中 kind == "type" 为权威判据（与 resolve_ti 同款逻辑）。
pub fn is_type_name(name: string) bool {
    if (parse.is_scalar_name(name)) { return true; }
    // P2b：内建复合类型（string / StringBuilder / bytes / BytesBuilder）也视作类型名，
    // 使 meta_eval 在 comptime 把裸 `string` 等解析为类型值节点（与 type_node_from_ident 同口径）。
    if (name == "string" or name == "StringBuilder" or name == "bytes" or name == "BytesBuilder") { return true; }
    var si: i64 = sym_lookup(global_scope, name);
    if (si < 0) { return false; }
    return syms[si].kind == "type";
}

pub fn clone_kids(src: i64) i64 {
    if (src < 0) { return -1; }
    var h: i64 = -1;
    var t: i64 = -1;
    var c: i64 = src;
    var mq_ks1614: []i64 = base.kids_chain_idx(src);
    var mq_ki1614: i64 = 0;
    while (mq_ki1614 < slice_len(mq_ks1614) as i64) {
        c = mq_ks1614[mq_ki1614];
        var cv: i64 = clone_node(base.kids[c].val);
        t = base.list_push(h, t, cv);
        if (h < 0) { h = t; }
        mq_ki1614 = mq_ki1614 + 1;
        c = -1;
    }
    return h;
}

pub fn clone_node(src: i64) i64 {
    if (src < 0) { return -1; }
    var id: i64 = base.node_new(base.node_kind((src as u64)));
    base.node_set_sa((id as u64), base.node_sa((src as u64)));
    // S4 §0.14.7 SoA：sb 已外置，跨节点传播走侧表访问器（取代 `nn.sb = sn.sb`；第十二批）
    base.node_set_sb((id as u64), base.node_sb((src as u64)));
    // S4 §0.14.7 SoA：has_* 已外置，跨节点传播走侧表访问器（取代 `nn.has_X = sn.has_X`）
    // S4 §0.14.7 SoA：sc 已外置，跨节点传播走侧表访问器（取代 `nn.sc = sn.sc`）
    base.node_set_sc((id as u64), base.node_sc((src as u64)));
    base.node_set_has_sa((id as u64), base.node_has_sa((src as u64)));
    base.node_set_has_sb((id as u64), base.node_has_sb((src as u64)));
    base.node_set_has_sc((id as u64), base.node_has_sc((src as u64)));
    base.node_set_ia((id as u64), base.node_ia((src as u64)));
    base.node_set_ib((id as u64), base.node_ib((src as u64)));   // S4 §0.14.7 SoA：取代 `nn.ib = sn.ib`
    base.node_set_ba((id as u64), base.node_ba((src as u64)));   // S4 §0.14.7 SoA：取代 `base.node_ba((nn.id as u64)) = base.node_ba((sn.id as u64))`（第十批）
    // S4 §0.14.7 SoA：bb/bc 已外置，跨节点传播走侧表访问器（取代 `nn.bb = sn.bb; nn.bc = sn.bc;`）
    base.node_set_bb((id as u64), base.node_bb((src as u64)));
    base.node_set_bc((id as u64), base.node_bc((src as u64)));
    // S4 §0.14.7 SoA：bd 已外置，跨节点传播走侧表访问器（取代 `nn.bd = sn.bd`）
    base.node_set_bd((id as u64), base.node_bd((src as u64)));
    base.node_set_na((id as u64), clone_node(base.node_na((src as u64))));
    base.node_set_nb((id as u64), clone_node(base.node_nb((src as u64))));
    base.node_set_nc((id as u64), clone_node(base.node_nc((src as u64))));   // S4 §0.14.7 SoA：侧表访问器（原 .nc；第九批）
    base.node_set_nd((id as u64), clone_node(base.node_nd((src as u64))));   // S4 §0.14.7 SoA：侧表访问器（原 .nd）
    base.node_set_la((id as u64), clone_kids(base.node_la((src as u64))));
    base.node_set_lb((id as u64), clone_kids(base.node_lb((src as u64))));
    base.node_set_lc((id as u64), clone_kids(base.node_lc((src as u64))));   // S4 §0.14.7 SoA：取代 `base.node_lc((nn.id as u64)) = clone_kids(base.node_lc((sn.id as u64)))`（第十一批）
    base.node_set_span_id(id, base.node_span_id(src)); base.node_set_span_id(id, base.node_span_id(src)); base.node_set_span_id(id, base.node_span_id(src));
    return id;
}

// 把子树里所有 `named{sa == name}` 类型节点替换为 concrete 的深克隆
pub fn subst_type_in_kids(src: i64, name: string, concrete: i64) i64 {
    if (src < 0) { return -1; }
    var h: i64 = -1;
    var t: i64 = -1;
    var c: i64 = src;
    var mq_ks1660: []i64 = base.kids_chain_idx(src);
    var mq_ki1660: i64 = 0;
    while (mq_ki1660 < slice_len(mq_ks1660) as i64) {
        c = mq_ks1660[mq_ki1660];
        var nv: i64 = subst_type_in_node(base.kids[c].val, name, concrete);
        t = base.list_push(h, t, nv);
        if (h < 0) { h = t; }
        mq_ki1660 = mq_ki1660 + 1;
        c = -1;
    }
    return h;
}

pub fn subst_type_in_node(nd_id: i64, name: string, concrete: i64) i64 {
    if (nd_id < 0) { return -1; }
    if (base.node_kind((nd_id as u64)) == "named" and base.node_sa((nd_id as u64)) == name) {
        return clone_node(concrete);
    }
    // S4 §0.14.7 SoA：na 已外置为侧表 g_node_na（第十七批）。原单行
    //   `if (n.na >= 0) { n.na = subst_type_in_node(n.na, name, concrete); }`
    //   —— 同行既有读又有写且带花括号 ⇒ 自动迁移器的「写点独占整条语句」护栏判
    //   multi-stmt 拦截，此处**手工**迁移（同第十五批 nb / 第九批 nc 的句式）：
    //   显式抽出一次侧表读，避免两次读取之间被递归改写。
    var n_na: i64 = base.node_na((nd_id as u64));
    if (n_na >= 0) { base.node_set_na((nd_id as u64), subst_type_in_node(n_na, name, concrete)); }
    // S4 §0.14.7 SoA：原单行 `if (n.nb >= 0) { n.nb = subst_type_in_node(n.nb, ...); }` ——
    //   自动迁移器的「写点独占整条语句」护栏判 multi-stmt 拦截，此处**手工**迁移（第十五批）：
    //   同行既有读又有写且带花括号，必须显式抽出一次侧表读，避免两次读取之间被递归改写。
    var n_nb: i64 = base.node_nb((nd_id as u64));
    if (n_nb >= 0) { base.node_set_nb((nd_id as u64), subst_type_in_node(n_nb, name, concrete)); }
    var n_nc: i64 = base.node_nc((nd_id as u64));   // S4 §0.14.7 SoA：侧表读写（原 n.nc；第九批）
    if (n_nc >= 0) { base.node_set_nc((nd_id as u64), subst_type_in_node(n_nc, name, concrete)); }
    var n_nd: i64 = base.node_nd((nd_id as u64));
    if (n_nd >= 0) { base.node_set_nd((nd_id as u64), subst_type_in_node(n_nd, name, concrete)); }   // S4 §0.14.7 SoA：侧表访问器（原 .nd）
    // S4 §0.14.7 SoA：原单行 `if (n.la >= 0) { n.la = subst_type_in_kids(n.la, ...); }` ——
    //   同行读写 + 花括号 ⇒ 自动迁移器 guard 拦截（第十六批，形态与第十五批 nb 一致）；
    //   ⚠ 脚本对该行的处理是**半吊子**（只换了条件与 rhs 的读点，留下写点），此处手工收尾。
    if (base.node_la((nd_id as u64)) >= 0) { base.node_set_la((nd_id as u64), subst_type_in_kids(base.node_la((nd_id as u64)), name, concrete)); }
    if (base.node_lb((nd_id as u64)) >= 0) { base.node_set_lb((nd_id as u64), subst_type_in_kids(base.node_lb((nd_id as u64)), name, concrete)); }
    var n_lc: i64 = base.node_lc((nd_id as u64));   // S4 §0.14.7 SoA：侧表读写（原 base.node_lc((n.id as u64))；第十一批）
    if (n_lc >= 0) { base.node_set_lc((nd_id as u64), subst_type_in_kids(n_lc, name, concrete)); }
    return nd_id;
}

// ══════════════════════════════════════════════════════════════
// M-meta Phase C：值参数单态化
// comptime 形参按**声明类型**分流：
//   `meta T: type` / `comptime T: any` → 类型参数（Phase A 路径，实参须是类型名）
//   `meta N: i64` / `meta S: string`   → 值参数：实参在调用点 CTFE 求值成字面量，
//                                        既进单态化键，也整体代入实例体与类型位。
// 为什么代入字面量而不是在实例体首插一条 const：`[N]T` 的长度位要求 kind == "int"
// 的字面量节点（见 resolve_ti 的 array 分支），常量名过不去那一关。
// ══════════════════════════════════════════════════════════════
pub fn meta_param_is_type(p: i64) bool {
    if (base.node_na((p as u64)) < 0) { return true; }          // 无标注：保守当类型参数
    if (base.node_kind((base.node_na((p as u64)) as u64)) == "any") { return true; }
    if (base.node_kind((base.node_na((p as u64)) as u64)) == "type") { return true; }
    // 概念约束形参（T:HasName）：na 是 named{concept} —— 视作类型参数。
    // 符号表在单态化（调用点）时已就绪，可直接查 concept 身份。
    if (base.node_kind((base.node_na((p as u64)) as u64)) == "named") {
        var rn: string = base.node_sa((base.node_na((p as u64)) as u64));
        var rsi: i64 = sym_lookup(global_scope, rn);
        if (rsi >= 0 and syms[rsi].kind == "concept") { return true; }
    }
    return false;
}

// 把子树里所有 `ident{sa == name}` **表达式**节点替换为字面量深克隆。
// 类型位置的 `named{sa == name}` 归 subst_type_in_node 管，两者互不干扰。
pub fn meta_subst_val_kids(src: i64, name: string, lit: i64) i64 {
    if (src < 0) { return -1; }
    var h: i64 = -1;
    var t: i64 = -1;
    var c: i64 = src;
    var mq_ks1723: []i64 = base.kids_chain_idx(src);
    var mq_ki1723: i64 = 0;
    while (mq_ki1723 < slice_len(mq_ks1723) as i64) {
        c = mq_ks1723[mq_ki1723];
        var nv: i64 = meta_subst_val_node(base.kids[c].val, name, lit);
        t = base.list_push(h, t, nv);
        if (h < 0) { h = t; }
        mq_ki1723 = mq_ki1723 + 1;
        c = -1;
    }
    return h;
}

pub fn meta_subst_val_node(nd_id: i64, name: string, lit: i64) i64 {
    if (nd_id < 0) { return -1; }
    if (base.node_kind((nd_id as u64)) == "ident" and base.node_sa((nd_id as u64)) == name) {
        return clone_node(lit);
    }
    // S4 §0.14.7 SoA：同上，原单行 `if (n.na >= 0) { n.na = meta_subst_val_node(n.na, name, lit); }`
    //   —— 同行读写 + 花括号 ⇒ 自动迁移器 guard 拦截，手工迁移（第十七批）。
    var n_na: i64 = base.node_na((nd_id as u64));
    if (n_na >= 0) { base.node_set_na((nd_id as u64), meta_subst_val_node(n_na, name, lit)); }
    // S4 §0.14.7 SoA：同上，原单行 `if (n.nb >= 0) { n.nb = meta_subst_val_node(n.nb, ...); }`
    //   —— 同行读写 + 花括号 ⇒ 自动迁移器 guard 拦截，手工迁移（第十五批）。
    var n_nb: i64 = base.node_nb((nd_id as u64));
    if (n_nb >= 0) { base.node_set_nb((nd_id as u64), meta_subst_val_node(n_nb, name, lit)); }
    var n_nc: i64 = base.node_nc((nd_id as u64));   // S4 §0.14.7 SoA：侧表读写（原 n.nc；第九批）
    if (n_nc >= 0) { base.node_set_nc((nd_id as u64), meta_subst_val_node(n_nc, name, lit)); }
    var n_nd: i64 = base.node_nd((nd_id as u64));
    if (n_nd >= 0) { base.node_set_nd((nd_id as u64), meta_subst_val_node(n_nd, name, lit)); }   // S4 §0.14.7 SoA：侧表访问器（原 .nd）
    // S4 §0.14.7 SoA：同上，原单行 `if (n.la >= 0) { n.la = meta_subst_val_kids(n.la, ...); }`；
    //   自动迁移器只换了读点（留下写点），此处手工收尾（第十六批）。
    if (base.node_la((nd_id as u64)) >= 0) { base.node_set_la((nd_id as u64), meta_subst_val_kids(base.node_la((nd_id as u64)), name, lit)); }
    if (base.node_lb((nd_id as u64)) >= 0) { base.node_set_lb((nd_id as u64), meta_subst_val_kids(base.node_lb((nd_id as u64)), name, lit)); }
    var n_lc: i64 = base.node_lc((nd_id as u64));   // S4 §0.14.7 SoA：侧表读写（原 base.node_lc((n.id as u64))；第十一批）
    if (n_lc >= 0) { base.node_set_lc((nd_id as u64), meta_subst_val_kids(n_lc, name, lit)); }
    return nd_id;
}

// 类型参数单态化：除 named{U}（类型位置）外，还要替换表达式位置里的 ident{U}
// （如把类型当作 comptime 实参传递：`map_id(U, x)` 里的 U）。模板本体里这种引用在
// 检查期不可解（U 未绑定），须随实例一并代换成具体类型，否则嵌套泛型再单态化时读到
// 未绑定 U → T-SEM-E200。仅用于 instantiate_generic 的实例体（comptime 形参已被剥离，
// 残余 ident{U} 必是待代换的形参引用，无歧义）。
pub fn subst_type_ident_kids(src: i64, name: string, concrete: i64) i64 {
    if (src < 0) { return -1; }
    var h: i64 = -1;
    var t: i64 = -1;
    var c: i64 = src;
    var mq_ks1768: []i64 = base.kids_chain_idx(src);
    var mq_ki1768: i64 = 0;
    while (mq_ki1768 < slice_len(mq_ks1768) as i64) {
        c = mq_ks1768[mq_ki1768];
        var nv: i64 = subst_type_ident_node(base.kids[c].val, name, concrete);
        t = base.list_push(h, t, nv);
        if (h < 0) { h = t; }
        mq_ki1768 = mq_ki1768 + 1;
        c = -1;
    }
    return h;
}

pub fn subst_type_ident_node(nd_id: i64, name: string, concrete: i64) i64 {
    if (nd_id < 0) { return -1; }
    if ((base.node_kind((nd_id as u64)) == "named" or base.node_kind((nd_id as u64)) == "ident") and base.node_sa((nd_id as u64)) == name) {
        return clone_node(concrete);
    }
    // S4 §0.14.7 SoA：na 已外置为侧表 g_node_na（第十七批）。原单行
    //   `if (n.na >= 0) { n.na = subst_type_ident_node(n.na, name, concrete); }` ——
    //   同行读写 + 花括号 ⇒ 自动迁移器 guard:multi-stmt 拦截，手工迁移
    //   （同第十五批 nb 的句式）：先抽出一次侧表读，避免两次读取之间被递归改写。
    var n_na: i64 = base.node_na((nd_id as u64));
    if (n_na >= 0) { base.node_set_na((nd_id as u64), subst_type_ident_node(n_na, name, concrete)); }
    // S4 §0.14.7 SoA：同上，原单行 `if (n.nb >= 0) { n.nb = subst_type_ident_node(n.nb, ...); }`
    //   —— 同行读写 + 花括号 ⇒ 自动迁移器 guard 拦截，手工迁移（第十五批）。
    var n_nb: i64 = base.node_nb((nd_id as u64));
    if (n_nb >= 0) { base.node_set_nb((nd_id as u64), subst_type_ident_node(n_nb, name, concrete)); }
    var n_nc: i64 = base.node_nc((nd_id as u64));   // S4 §0.14.7 SoA：侧表读写（原 n.nc；第九批）
    if (n_nc >= 0) { base.node_set_nc((nd_id as u64), subst_type_ident_node(n_nc, name, concrete)); }
    var n_nd: i64 = base.node_nd((nd_id as u64));
    if (n_nd >= 0) { base.node_set_nd((nd_id as u64), subst_type_ident_node(n_nd, name, concrete)); }   // S4 §0.14.7 SoA：侧表访问器（原 .nd）
    // S4 §0.14.7 SoA：同上，原单行 `if (n.la >= 0) { n.la = subst_type_ident_kids(n.la, ...); }`；
    //   自动迁移器只换了读点（留下写点），此处手工收尾（第十六批）。
    if (base.node_la((nd_id as u64)) >= 0) { base.node_set_la((nd_id as u64), subst_type_ident_kids(base.node_la((nd_id as u64)), name, concrete)); }
    if (base.node_lb((nd_id as u64)) >= 0) { base.node_set_lb((nd_id as u64), subst_type_ident_kids(base.node_lb((nd_id as u64)), name, concrete)); }
    var n_lc: i64 = base.node_lc((nd_id as u64));   // S4 §0.14.7 SoA：侧表读写（原 base.node_lc((n.id as u64))；第十一批）
    if (n_lc >= 0) { base.node_set_lc((nd_id as u64), subst_type_ident_kids(n_lc, name, concrete)); }
    return nd_id;
}

// 字面量 → 标识符安全的单态化键片段。
// 字符串走「长度 + 前 12 个可读字符 + FNV-1a(32)」：可读且不撞
// —— 只做字符净化的话 `"a-b"` 与 `"a_b"` 会塌成同一个实例。
pub fn meta_val_key(lit: i64) string {
    if (base.node_kind((lit as u64)) == "bool") {
        if (base.node_ba((lit as u64))) { return "true"; }
        return "false";
    }
    if (base.node_kind((lit as u64)) == "int") {
        var v: i64 = js_parse_int(base.node_sa((lit as u64)), base.node_ia((lit as u64)));
        if (v < 0) { return base.sb_cat2("n", base.i2s(0 - v)); }
        return base.i2s(v);
    }
    var s: string = base.node_sa((lit as u64));
    var ln: i64 = str_len(s) as i64;
    var h: i64 = 2166136261;
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "s");
    sb_append_str(sb, base.i2s(ln));
    sb_append_str(sb, "_");
    var i: i64 = 0;
    while (i < ln) {
        var c: i64 = str_at(s, i) as i64;
        h = (h ^ c);
        h = (h * 16777619) & 4294967295;
        if (i < 12) {
            var ok: bool = false;
            if (c >= 48 and c <= 57) { ok = true; }
            if (c >= 65 and c <= 90) { ok = true; }
            if (c >= 97 and c <= 122) { ok = true; }
            if (ok) { sb_append_str(sb, str_slice(s, i, i + 1)); }
            else { sb_append_str(sb, "_"); }
        }
        i = i + 1;
    }
    sb_append_str(sb, "_");
    sb_append_str(sb, base.i2s(h));
    return sb_to_str(sb);
}

// 值实参：CTFE 求值 + 按形参声明类型校验。返回字面量节点 id，失败 -1（已报错）。
pub fn meta_eval_value_arg(p: i64, a: i64) i64 {
    // N14：clause / [N]clause 值形参 —— 子句组是编译期一等值，其「值」就是子句组 AST
    //   本身，**不需要也不应**被折成字面量。求值后按形态校验即可（见下方 clause 分支）。
    if (parse.type_node_is_clause(base.node_na((p as u64)))) {
        var sv_top0: i64 = g_menv_top;
        var sv_base0: i64 = g_menv_base;
        var sv_q0: bool = g_meta_quiet;
        g_menv_top = g_menv_nglobal;
        g_menv_base = g_menv_nglobal;
        g_meta_quiet = false;
        g_meta_err = false;
        if (g_meta_steps < 200000) { g_meta_steps = 200000; }
        var gv: i64 = meta_eval(a);
        g_menv_top = sv_top0;
        g_menv_base = sv_base0;
        g_meta_quiet = sv_q0;
        var ge0: bool = g_meta_err;
        g_meta_err = false;
        if (gv < 0 or ge0) {
            parse.fc_err("T-CLA-E726",
                base.sb_cat3("clause 形参 `", base.node_sa((p as u64)),
                    "` 的实参必须是编译期常量（子句组须在编译期展开）"), a);
            return -1;
        }
        if (meta_node_is_clause_group(gv) == false) {
            // 把**实际**算出来的节点种类写进诊断：否则用户（和我）都无从判断是
            // 「实参写错了」还是「求值器折错了」—— 这正是本项目最忌讳的盲诊断。
            parse.fc_err("T-CLA-E723",
                base.sb_cat5("clause 形参 `", base.node_sa((p as u64)),
                    "` 的实参求值结果不是子句组（clause / [N]clause）；实际得到 ",
                    base.node_kind((gv as u64)),
                    "，元素形态见源码"), a);
            return -1;
        }
        return gv;
    }
    // 先卡**声明类型**再求值：否则 `meta X: f64` 会先被求值器以 T_META_NOT_CONST
    // 拒掉，诊断指向实参而非那个根本不该存在的形参类型，误导排查方向。
    var tname: string = base.node_sa((base.node_na((p as u64)) as u64));
    var tok: bool = false;
    if (base.node_kind((base.node_na((p as u64)) as u64)) == "scalar") {
        if (tname == "string" or tname == "bool") { tok = true; }
        if (meta_is_int_type(tname)) { tok = true; }
    }
    if (tok == false) {
        parse.fc_err("T-MTA-E600",
            base.sb_cat3("meta 值参数 `", base.node_sa((p as u64)), "` 的类型暂不支持：仅整数族 / bool / string"), a);
        return -1;
    }
    // 借全局编译期常量区求值；调用方的求值状态原样保存恢复。
    var sv_top: i64 = g_menv_top;
    var sv_base: i64 = g_menv_base;
    var sv_quiet: bool = g_meta_quiet;
    g_menv_top = g_menv_nglobal;
    g_menv_base = g_menv_nglobal;
    g_meta_quiet = false;
    g_meta_err = false;
    if (g_meta_steps < 200000) { g_meta_steps = 200000; }
    var lit: i64 = meta_eval(a);
    g_menv_top = sv_top;
    g_menv_base = sv_base;
    g_meta_quiet = sv_quiet;
    g_meta_err = false;
    if (lit < 0) { return -1; }
    var lk: string = base.node_kind((lit as u64));
    if (tname == "string") {
        if (lk != "string") {
            parse.fc_err("T-MTA-E601",
                base.sb_cat3("meta 值参数 `", base.node_sa((p as u64)), "` 需要字符串字面量"), a);
            return -1;
        }
        return lit;
    }
    if (tname == "bool") {
        if (lk != "bool") {
            parse.fc_err("T-MTA-E601",
                base.sb_cat3("meta 值参数 `", base.node_sa((p as u64)), "` 需要 bool（不做隐式转换）"), a);
            return -1;
        }
        return lit;
    }
    if (meta_is_int_type(tname)) {
        if (lk != "int") {
            parse.fc_err("T-MTA-E601",
                base.sb_cat4("meta 值参数 `", base.node_sa((p as u64)), "` 需要整数，收到 ", lk), a);
            return -1;
        }
        var v2: i64 = js_parse_int(base.node_sa((lit as u64)), base.node_ia((lit as u64)));
        if (meta_int_wrap(v2, tname) != v2) {
            parse.fc_err("T-MTA-E602",
                base.sb_cat4("meta 值参数 `", base.node_sa((p as u64)), "` 超出 ", tname), a);
            return -1;
        }
        return lit;
    }
    parse.fc_err("T-MTA-E600",
        base.sb_cat3("meta 值参数 `", base.node_sa((p as u64)), "` 的类型暂不支持：仅整数族 / bool / string"), a);
    return -1;
}

// 改写调用点：callee → 实例名，移除前 k 个 comptime 实参，打上防重入标记。
// 新建实例与命中缓存两条路径都必须走这里 —— 少一次 `bb = true` 就会让
// infer_expr 反复重入 instantiate_generic。
// 按 comptime 形参的**实际位置**摘除实参（见下方 pos 版注释）。
// 保留原签名：位置即 0..k-1，与旧行为逐字节相同 ⇒ 既有调用点零影响。
pub fn rewrite_generic_callsite(e: i64, iname: string, k: i64) void {
    var pos0: []i64 = [];
    var pi: i64 = 0;
    while (pi < k) { append(pos0, pi); pi = pi + 1; }
    rewrite_generic_callsite_pos(e, iname, pos0);
}

// ⚠ 原实现摘的是「**前 k 个**实参」，隐含假设 comptime 形参都排在最前。
//   一旦 comptime 形参不在首位（N14 的 clause 形参就是第二位：`fn f(x: T, G: [N]clause)`），
//   这条假设就崩了 —— 实测把 `x`（=0，一个 int）当成子句组实参，
//   报「实参求值结果不是子句组；实际得到 int」，而真正的问题却藏在别处。
//   ⇒ 改为按形参的实际位置摘除；对「comptime 形参在前」的既有形态完全等价。
pub fn rewrite_generic_callsite_pos(e: i64, iname: string, cpos: []i64) void {
    base.node_set_sa((base.node_na((e as u64)) as u64), iname);
    var nh: i64 = -1;
    var nt: i64 = -1;
    var mq_ks1920: []i64 = base.kids_chain_idx(base.node_la((e as u64)));
    var mq_ki1920: i64 = 0;
    while (mq_ki1920 < slice_len(mq_ks1920) as i64) {
        var at_pos: bool = false;
        var qi: i64 = 0;
        while (qi < slice_len(cpos) as i64) {
            if (cpos[qi] == mq_ki1920) { at_pos = true; }
            qi = qi + 1;
        }
        if (at_pos == false) {
            nt = base.list_push(nh, nt, base.kids[mq_ks1920[mq_ki1920]].val);
            if (nh < 0) { nh = nt; }
        }
        mq_ki1920 = mq_ki1920 + 1;
    }
    base.node_set_la((e as u64), nh);
    base.node_set_bb((e as u64), true);   // S4 §0.14.7 SoA：侧表写（原 en.bb = true）
}

// 单态化：返回实例 FuncDecl id（已 append decl_list + register）。
// 把泛型实例名里的 LLVM/C 非法符号字符（[] * ? < > ( ) , 等）替换成安全字符，
// 使实例既作缓存 key 又作符号名时都是合法标识符。仅影响符号拼写，不影响语义；
// 与 mb_type_key（@type_name 的可读输出）解耦 —— 后者保持 `[]i64` 原样。
pub fn sanitize_sym(s: string) string {
    var n: u64 = str_len(s);
    var sb: StringBuilder = sb_new();
    var i: u64 = 0;
    while (i < n) {
        var c: u8 = s[i];
        if ((c >= 65 and c <= 90) or (c >= 97 and c <= 122) or
            (c >= 48 and c <= 57) or c == 95) {
            sb_append_char(sb, c);
        } else if (c == 91) { sb_append_char(sb, 76); }   // '[' -> 'L'
        else if (c == 93) { sb_append_char(sb, 82); }    // ']' -> 'R'
        else if (c == 42) { sb_append_char(sb, 80); }    // '*' -> 'P'
        else if (c == 63) { sb_append_char(sb, 79); }    // '?' -> 'O'
        else if (c == 60) { sb_append_char(sb, 76); }    // '<' -> 'L'
        else if (c == 62) { sb_append_char(sb, 71); }    // '>' -> 'G'
        else if (c == 40) { sb_append_char(sb, 80); }    // '(' -> 'P'
        else if (c == 41) { sb_append_char(sb, 81); }    // ')' -> 'Q'
        else if (c == 44) { sb_append_char(sb, 67); }    // ',' -> 'C'
        else { sb_append_char(sb, 95); }                 // 其余 -> '_'
        i = i + 1;
    }
    return sb_to_str(sb);
}

pub fn instantiate_generic(tmpl: i64, e: i64) i64 {
    // 收集 comptime 形参（按参数顺序）：名字 / 形参节点 / 是否类型参数
    var cnames: []string;
    var cnodes: []i64;
    var cistype: []bool;
    var has_clause: bool = false;   // N14：模板是否含 clause 形参（⇒ 实例体要补跑子句组展开）
    var cpos: []i64;                // N14：comptime 形参在形参表中的实际位置
    var cp: i64 = base.node_lb((tmpl as u64));
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环
    var ks1962: []i64 = base.kids_chain(cp);
    var ki1962: i64 = 0;
    while (ki1962 < slice_len(ks1962) as i64) {
        var kv1962: i64 = ks1962[ki1962];
        var cpv: i64 = kv1962;
        if (base.node_bb((cpv as u64)) == true) {   // S4 §0.14.7 SoA：侧表读（原 cpn.bb）
            if (parse.type_node_is_clause(base.node_na((cpv as u64)))) { has_clause = true; }
            append(cpos, ki1962);   // N14：记下 comptime 形参的**实际位置**
            append(cnames, base.node_sa((cpv as u64)));
            append(cnodes, cpv);
            append(cistype, meta_param_is_type(cpv));
        }
        ki1962 = ki1962 + 1;
    }
    var k: i64 = slice_len(cnames) as i64;
    // 从调用点读取实参 —— ⚠ 按 comptime 形参的**实际位置**取，而非「前 k 个」
    //   （N14：clause 形参常常不在首位。旧写法会把位置错开 ⇒ 拿错实参，见
    //   rewrite_generic_callsite_pos 的注释）。
    var allargs: []i64;
    var ac0: i64 = base.node_la((e as u64));
    while (ac0 >= 0) {
        append(allargs, base.kids[ac0].val);
        ac0 = base.kids[ac0].next;
    }
    var cargs: []i64;
    var i: i64 = 0;
    while (i < k) {
        var ap: i64 = cpos[i];
        if (ap >= 0 and ap < (slice_len(allargs) as i64)) { append(cargs, allargs[ap]); }
        i = i + 1;
    }
    if (slice_len(cargs) != k) { return -1; }
    // 构造单态化签名 + 具体量列表（类型参数 → 类型节点；值参数 → 字面量节点）
    var sig: string = "";
    var concretes: []i64;
    var j: i64 = 0;
    while (j < k) {
        var cv2: i64 = -1;
        var keyp: string = "";
        if (cistype[j]) {
            // P0-2：嵌套泛型再单态化时，comptime 类型实参已是具体类型节点
            // （由 subst_type_ident 把表达式位置的 ident{U} 代换成具体类型节点）。
            // 直接采用，勿走 meta_eval（类型节点不可作常量求值）。
            if (base.node_kind((cargs[j] as u64)) == "named" or base.node_kind((cargs[j] as u64)) == "scalar" or base.node_kind((cargs[j] as u64)) == "slice"
                    or base.node_kind((cargs[j] as u64)) == "array" or base.node_kind((cargs[j] as u64)) == "pointer" or base.node_kind((cargs[j] as u64)) == "optional"
                    or base.node_kind((cargs[j] as u64)) == "vector") {
                cv2 = cargs[j];
                keyp = mb_type_key(cargs[j], 0);
                if (keyp == "") {
                    parse.fc_err("T-MTA-E603",
                        "编译期类型表达式求值结果无法规约为类型名", cargs[j]);
                    return -1;
                }
            } else if (base.node_kind((cargs[j] as u64)) == "ident") {
                cv2 = type_node_from_ident(base.node_sa((cargs[j] as u64)));
                keyp = base.node_sa((cargs[j] as u64));
            } else {
                // P4 类型即值：允许「编译期可求值为类型节点」的表达式作为类型实参
                // （@type_val("i64")、comptime fn 返回的 type 等）。keyp 取规范类型名，
                // 与字面量类型名路径共用同一单态实例，避免重复生成。
                if (g_meta_steps < 200000) { g_meta_steps = 200000; }
                g_meta_err = false;
                var tv: i64 = meta_eval(cargs[j]);
                if (tv < 0 or g_meta_err) {
                    parse.fc_err("T-MTA-E603",
                        "comptime 类型参数必须是类型名或编译期可求值的类型表达式", cargs[j]);
                    return -1;
                }
                cv2 = tv;
                keyp = mb_type_key(tv, 0);
                if (keyp == "") {
                    parse.fc_err("T-MTA-E603",
                        "编译期类型表达式求值结果无法规约为类型名", cargs[j]);
                    return -1;
                }
            }
        } else {
            // N15：clause 形参的实参必须是**编译期常量**（子句组要在编译期展开，
            //   运行期值无从展开）。先自查再交给通用求值，避免两条诊断叠在一起。
            if (clause_ti_involves(resolve_ti(base.node_na((cnodes[j] as u64))))) {
                var sq0: bool = g_meta_quiet;
                g_meta_quiet = true;
                g_meta_err = false;
                var cv_pre: i64 = meta_eval(cargs[j]);
                g_meta_quiet = sq0;
                var me0: bool = g_meta_err;
                g_meta_err = false;
                if (cv_pre < 0 or me0) {
                    parse.fc_err("T-CLA-E726",
                        base.sb_cat3("clause 形参 `", cnames[j],
                            "` 的实参必须是编译期常量（子句组须在编译期展开）"), cargs[j]);
                    return -1;
                }
            }
            cv2 = meta_eval_value_arg(cnodes[j], cargs[j]);
            if (cv2 < 0) { return -1; }
            if (clause_ti_involves(resolve_ti(base.node_na((cnodes[j] as u64))))) {
                keyp = clause_group_key(cargs[j]);   // ⚠ 见 clause_group_key 的注释
            } else {
                keyp = meta_val_key(cv2);
            }
        }
        append(concretes, cv2);
        if (j > 0) { sig = base.sb_cat2(sig, "_"); }
        sig = base.sb_cat2(sig, keyp);
        j = j + 1;
    }
    // 实例 key：templ_name + __ + sig；去重。sig 可能含 [] * ? 等非法符号字符，
    // 先 sanitize 成合法标识符（同时用作缓存 key 与后端符号名）。
    var iname: string = sanitize_sym(base.sb_cat3(base.node_sa((tmpl as u64)), "__", sig));
    var si0: i64 = sym_lookup(global_scope, iname);
    if (si0 >= 0) {
        // ⚠ 命中缓存也**必须**改写调用点。Phase A 这里直接 return，callee 仍是模板名、
        // comptime 实参也还在 → 回到 infer_expr 后 `base.node_bb(e) == false` 依旧成立，
        // 于是再次 instantiate → 再次命中 → 无限递归，编译器直接崩（exit 127）。
        // Phase A 的示例每个泛型每种实参只调一次，恰好绕过了这条路径。
        rewrite_generic_callsite_pos(e, iname, cpos);
        return syms[si0].decl;
    }
    // 深克隆模板
    var inst: i64 = clone_node(tmpl);
    base.node_set_sa((inst as u64), iname);
    // N14：模板因含 clause 形参而被自动置为编译期（bb = true，见 parse_func_decl），
    //   但**实例必须清掉这个标记** —— 单态实例是普通运行期函数，否则后端按
    //   「comptime fn 函数体仅存在于编译期」跳过发射 ⇒ 链接期 undefined symbol
    //   （实测 `lld-link: undefined symbol: t_fmt_with__g22_36`）。
    if (has_clause) { base.node_set_bb((inst as u64), false); }
    // 逐对替换 comptime 参数名 → 具体量（返回类型 + 函数体 + 各参数类型）。
    // ⚠ FuncDecl.lc 是**语句链表头**（kids 下标），不是节点 id —— 必须走 *_kids
    // 版本。Phase A 这里误传给了 subst_type_in_node：既漏替换体内类型位，又会去
    // 改写一棵与该下标同号的无关节点子树。症状是实例体里 `var z: T;` 保持
    // `named{T}` → 退化成 i64 alloca，而返回类型已是具体类型 → clang 报
    // "defined with type 'i64' but expected 'double'"。
    var m: i64 = 0;
    while (m < k) {
        var cnm: string = cnames[m];
        var conc: i64 = concretes[m];
        if (cistype[m]) {
            base.node_set_na((inst as u64), subst_type_in_node(base.node_na((inst as u64)), cnm, conc));
            base.node_set_lc((inst as u64), subst_type_in_kids(base.node_lc((inst as u64)), cnm, conc));   // S4 §0.14.7 SoA：取代 `base.node_lc((inn.id as u64)) = …`
            // 表达式位置里的 ident{U}（把类型当 comptime 实参传递）→ 具体类型节点
            base.node_set_lc((inst as u64), subst_type_ident_kids(base.node_lc((inst as u64)), cnm, conc));
        } else {
            base.node_set_na((inst as u64), meta_subst_val_node(base.node_na((inst as u64)), cnm, conc));
            base.node_set_lc((inst as u64), meta_subst_val_kids(base.node_lc((inst as u64)), cnm, conc));
        }
        var pp2: i64 = base.node_lb((inst as u64));
        var mq_ks2079: []i64 = base.kids_chain_idx(base.node_lb((inst as u64)));
        var mq_ki2079: i64 = 0;
        while (mq_ki2079 < slice_len(mq_ks2079) as i64) {
            pp2 = mq_ks2079[mq_ki2079];
            if (cistype[m]) { base.node_set_na((base.kids[pp2].val as u64), subst_type_in_node(base.node_na((base.kids[pp2].val as u64)), cnm, conc)); }
            else { base.node_set_na((base.kids[pp2].val as u64), meta_subst_val_node(base.node_na((base.kids[pp2].val as u64)), cnm, conc)); }
            mq_ki2079 = mq_ki2079 + 1;
            pp2 = -1;
        }
        m = m + 1;
    }
    // 去掉 comptime 参数，保留其余（已替换类型的）参数
    var newp_head: i64 = -1;
    var newp_tail: i64 = -1;
    var pp3: i64 = base.node_lb((inst as u64));
    var mq_ks2090: []i64 = base.kids_chain_idx(base.node_lb((inst as u64)));
    var mq_ki2090: i64 = 0;
    while (mq_ki2090 < slice_len(mq_ks2090) as i64) {
        pp3 = mq_ks2090[mq_ki2090];
        if (base.node_bb((base.kids[pp3].val as u64)) == false) {   // S4 §0.14.7 SoA：侧表读（原 ppn2.bb）
            newp_tail = base.list_push(newp_head, newp_tail, base.kids[pp3].val);
            if (newp_head < 0) { newp_head = newp_tail; }
        }
        mq_ki2090 = mq_ki2090 + 1;
        pp3 = -1;
    }
    base.node_set_lb((inst as u64), newp_head);
    rewrite_generic_callsite_pos(e, iname, cpos);
    // 注册实例 + 追加 decl_list（check/emit 循环会重取长度，自动覆盖）
    append(lex.decl_list, inst);
    register_decl(inst);
    // 实例体内的 `meta` 折叠：meta_pass 早已跑完（它在 check 之前），而实例是
    // check 期才生成的，不补这一刀的话模板里的 `meta` 表达式会一路漏成运行期代码。
    // 此刻值参数已代入具体字面量，折叠能拿到真值。
    var sq: bool = g_meta_quiet;
    var st2: i64 = g_menv_top;
    var sb2: i64 = g_menv_base;
    g_meta_quiet = false;
    g_meta_err = false;
    g_menv_top = g_menv_nglobal;
    g_menv_base = g_menv_nglobal;
    if (g_meta_steps < 200000) { g_meta_steps = 200000; }
    // Phase D：类型参数此刻已代换成具体类型，`@type_*` 现在能折了（mb_pass 时还不能），
    // 且 `if (@type_equal(T, u32))` 的死分支要在 check 看到之前剪掉。必须早于 meta_walk。
    mb_walk_list(base.node_lc((inst as u64)));
    meta_walk_list(base.node_lc((inst as u64)));
    // N14：模板含 clause 形参时，实例体里的 `match (x) { G }` 此刻 G 才被换成具体子句组，
    // 必须**在这里**补跑展开 —— 与上方 mb_walk/meta_walk 同一个道理（实例是 check 期才
    // 生成的，parse_unit 末尾那趟脱糖当时还看不到它）。晚了 HIR 就会收到未展开的拼接位。
    if (has_clause) { parse.desugar_clause_splices(); }
    g_meta_quiet = sq;
    g_meta_err = false;
    g_menv_top = st2;
    g_menv_base = sb2;
    // 实例体补齐检查（P0-2 + P0-3）：此刻 comptime 形参已代换成具体类型，故在 body 上
    // 重跑 check_func_decl（= 走 infer_expr）即可同时完成——
    //   · 嵌套泛型调用点的再单态化（infer_expr @ line 4590，bb 守卫保证幂等）；
    //   · 体内 format / !j 脱糖（infer_expr @ line 4619）。
    // 必须落在实例化这一步（而非 run_check 主循环之后），因为实例是在主检查循环长度冻结后
    // 才追加的，代码生成的预处理在 run_check 结束后才跑——落在实例化里保证脱糖结果进入
    // 同一趟检查/发射视图，不再出现「脱糖了却没进 IR」的滞后。
    // 实例是 FuncDecl 且非泛型（comptime 形参已剥离），check_func_decl 安全幂等；其体内
    // 的嵌套泛型再单态化会递归触发 instantiate_generic → 同样回到这里自检，直至不动点。
    if (base.node_lc((inst as u64)) != -2) {
        check_func_decl(inst);
    }
    return inst;
}

// ══════════════════════════════════════════════════════════════
// #4b 泛型函数语法：`fn f(T:HasName, x: T)` / `fn f(T, x: T)`
// 隐式类型参数（调用点不传类型实参，按值实参类型推断 T）+ 结构化满足检查。
// 复用既有 instantiate_generic（comptime 单态化）后端：把隐式类型参数
// 归一为「前置的 comptime 形参」（bb=true, bc=true 标记），并在调用点
// 推断出 T 后前置注入为 comptime 实参，其余逻辑不变。
// ══════════════════════════════════════════════════════════════
var g_generic_resolved: []i64;   // 已归一化的泛型 FuncDecl id（防重入）
// 类型参数 → 约束 concept 名（并行数组，按参数节点 id 索引）。na 已被置 type 占位，
// 约束不能放 nb/nc（parse.pp_is_pattern 查 nb/nc，会把类型参数误判为模式参数 → 触发
// 子句组合并 / T-MAT-E742），故用侧表。
var g_gpc_pid: []i64;
var g_gpc_names: [][]string;   // 每 pid 对应 concept 名列表（多约束；单约束时为单元素）

// 查类型参数 pid 的约束 concept 名列表（无约束返回空列表）
pub fn generic_param_constraint(pid: i64) []string {
    var i: i64 = 0;
    while (i < slice_len(g_gpc_pid) as i64) {
        if (g_gpc_pid[i] == pid) {
            var r: []string = g_gpc_names[i];
            return r;
        }
        i = i + 1;
    }
    return [];
}

// 从约束类型节点收集 concept 名列表（§set-ops 岔路 B：多约束连词 `&&`）。
//   named(concept)      → [name]
//   binary("&&", L, R)  → collect(L) ++ collect(R)
//   optional(X)         → collect(X)（容错：约束非 optional，但允许裸 `?` 包裹）
//   其它（非 concept 名 / 非连词）→ 跳过；仅当 use_scope=true（符号表已就绪，
//   脱糖后兜底遍）时对「named 但非 concept」报错，捕捉跨模块拼写错误。
pub fn collect_concept_constraints(tn: i64, use_scope: bool) []string {
    var out: []string;
    if (tn < 0) { return out; }
    var k: string = base.node_kind((tn as u64));
    if (k == "binary" and base.node_sa((tn as u64)) == "&&") {
        var ls: []string = collect_concept_constraints(base.node_na((tn as u64)), use_scope);
        var rs: []string = collect_concept_constraints(base.node_nb((tn as u64)), use_scope);
        var i: i64 = 0;
        while (i < slice_len(ls) as i64) { append(out, ls[i]); i = i + 1; }
        i = 0;
        while (i < slice_len(rs) as i64) { append(out, rs[i]); i = i + 1; }
        return out;
    }
    if (k == "optional") {
        return collect_concept_constraints(base.node_na((tn as u64)), use_scope);
    }
    if (k == "named") {
        var rn: string = base.node_sa((tn as u64));
        if (is_concept_name(rn, use_scope)) {
            append(out, rn);
        } else if (use_scope) {
            parse.fc_err("T-CON-E103",
                base.sb_cat3("约束位置的类型 `", rn, "` 不是已注册的 concept：多约束连词 `&&` 只能连接 concept 名"), tn);
        }
        return out;
    }
    // 其它类型节点（如 map / 整数字面量）：不是 concept 约束，跳过（use_scope=true 时
    // 已在 named 分支覆盖报错路径；非 named 的非法约束位节点不在此报错，交由上层类型解析）。
    return out;
}

// 类型节点是否引用名为 name 的类型参数（递归 descend na/nb/nc/nd）
pub fn generic_tn_refs_name(tn: i64, name: string) bool {
    if (tn < 0) { return false; }
    var k: string = base.node_kind((tn as u64));
    if (k == "named" and base.node_sa((tn as u64)) == name) { return true; }
    if (generic_tn_refs_name(base.node_na((tn as u64)), name)) { return true; }
    if (generic_tn_refs_name(base.node_nb((tn as u64)), name)) { return true; }
    if (generic_tn_refs_name(base.node_nc((tn as u64)), name)) { return true; }
    if (generic_tn_refs_name(base.node_nd((tn as u64)), name)) { return true; }
    return false;
}

// 名字是否为 concept：use_scope=true 走全局符号表（脱糖后，符号已注册），
// 否则扫描同模块 decl_list（StructDecl && node_sb=="concept"）——脱糖期符号表尚未就绪。
pub fn is_concept_name(name: string, use_scope: bool) bool {
    if (use_scope) {
        var si: i64 = sym_lookup(global_scope, name);
        if (si >= 0 and syms[si].kind == "concept") { return true; }
        return false;
    }
    var n: i64 = slice_len(lex.decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = lex.decl_list[i];
        if (base.node_kind((d as u64)) == "StructDecl" and base.node_sb((d as u64)) == "concept"
                and base.node_sa((d as u64)) == name) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// 收集函数签名里「被当成类型引用」的名字集合（各形参类型节点 + 返回类型节点中的
// named 名字）：用于判定裸标识符形参是否「被当作类型使用」→ 隐式（无约束）类型参数。
pub fn generic_signature_type_names(d: i64) []string {
    var out: []string;
    var ks: []i64 = base.kids_chain(base.node_lb((d as u64)));
    var ki: i64 = 0;
    while (ki < slice_len(ks) as i64) {
        var pv: i64 = ks[ki];
        var pna: i64 = base.node_na((pv as u64));
        if (pna >= 0 and base.node_kind((pna as u64)) == "named") {
            append(out, base.node_sa((pna as u64)));
        }
        ki = ki + 1;
    }
    var rna: i64 = base.node_na((d as u64));
    if (rna >= 0 and base.node_kind((rna as u64)) == "named") {
        append(out, base.node_sa((rna as u64)));
    }
    return out;
}

// 一次性归一化：把隐式类型参数标记为 comptime 形参（bb=true, bc=true）并排到最前；
// 裸标识符补 na=type 节点（避免被当作模式参数触发子句组合并 / func_clauses 误判）。
// use_scope：是否可走全局符号表判 concept（脱糖期 false，脱糖后 true）。
// ⚠ 须在 desugar_func_clauses（子句组合并）之前跑——裸标识符一旦被当作模式参数即报
// T-FUN-E812；也须在 check_decl 之前跑——泛型模板体须被 func_is_generic 跳过。
pub fn generic_normalize_func(d: i64, use_scope: bool) void {
    if (base.node_kind((d as u64)) != "FuncDecl") { return; }
    var ri: i64 = 0;
    while (ri < slice_len(g_generic_resolved) as i64) {
        if (g_generic_resolved[ri] == d) { return; }
        ri = ri + 1;
    }
    append(g_generic_resolved, d);
    var tnames: []string = generic_signature_type_names(d);
    var tps: []i64;   // 隐式类型参数（裸 / concept-约束两类）
    var rest: []i64;  // 其余形参（保留原顺序）
    var ks: []i64 = base.kids_chain(base.node_lb((d as u64)));
    var ki: i64 = 0;
    while (ki < slice_len(ks) as i64) {
        var pv: i64 = ks[ki];
        var is_tp: bool = false;
        if (base.node_bb((pv as u64)) == true) {
            append(rest, pv);   // 显式 comptime 形参：保留原语义，置后
            ki = ki + 1;
            continue;
        }
        if (base.node_na((pv as u64)) < 0) {
            // 裸标识符：仅当「名字被当成类型使用」才算隐式类型参数
            var nm: string = base.node_sa((pv as u64));
            var ti2: i64 = 0;
            while (ti2 < slice_len(tnames) as i64) {
                if (tnames[ti2] == nm) { is_tp = true; }
                ti2 = ti2 + 1;
            }
        } else {
            // 约束类型节点：named(concept) 单约束，或 binary("&&", ...) 多约束连词（§set-ops 岔路 B）。
            // 约束名存侧表 g_gpc_*（不能用 nb/nc：pp_is_pattern 查 nb/nc 会把类型参数误判为模式参数 →
            // 触发子句组合并 / T-MAT-E742）；na 置 type 占位，避免 resolve_ti 把 concept 当值类型实例化 → T-CON-E100。
            var na_node: i64 = base.node_na((pv as u64));
            var nak: string = base.node_kind((na_node as u64));
            if (nak == "named") {
                // 单约束（现有行为）：named 且是 concept → 受约束类型参数；否则常规参数（无约束）。
                var rn: string = base.node_sa((na_node as u64));
                if (is_concept_name(rn, use_scope)) {
                    base.node_set_na((pv as u64), base.node_new("type"));
                    append(g_gpc_pid, pv);
                    append(g_gpc_names, [rn]);
                    is_tp = true;
                }
            } else if (nak == "binary" and base.node_sa((na_node as u64)) == "&&") {
                // 多约束（§set-ops 岔路 B）：`T: A && B`。拆解所有 concept 叶子，纳为约束列表。
                var cnames: []string = collect_concept_constraints(na_node, use_scope);
                if (slice_len(cnames) as i64 > 0) {
                    base.node_set_na((pv as u64), base.node_new("type"));
                    append(g_gpc_pid, pv);
                    append(g_gpc_names, cnames);
                    is_tp = true;
                }
            }
        }
        if (is_tp) {
            base.node_set_bb((pv as u64), true);
            base.node_set_bc((pv as u64), true);
            if (base.node_na((pv as u64)) < 0) { base.node_set_na((pv as u64), base.node_new("type")); }
            append(tps, pv);
        } else {
            append(rest, pv);
        }
        ki = ki + 1;
    }
    if (slice_len(tps) as i64 == 0) { return; }
    // 重排：类型参数排到最前（instantiate_generic 按位置取前 k 个 comptime 形参）
    var nh: i64 = -1;
    var nt: i64 = -1;
    var mi: i64 = 0;
    while (mi < slice_len(tps) as i64) {
        nt = base.list_push(nh, nt, tps[mi]);
        if (nh < 0) { nh = nt; }
        mi = mi + 1;
    }
    mi = 0;
    while (mi < slice_len(rest) as i64) {
        nt = base.list_push(nh, nt, rest[mi]);
        if (nh < 0) { nh = nt; }
        mi = mi + 1;
    }
    base.node_set_lb((d as u64), nh);
}

// 全模块归一化（脱糖 pass：func_clauses 之前跑，防止裸标识符被当作模式参数）
pub fn generic_normalize_all() void {
    var n: i64 = slice_len(lex.decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        generic_normalize_func(lex.decl_list[i], false);
        i = i + 1;
    }
}

// 概念 cname 对类型 ati 的结构化满足检查（字段 + 方法 + 返回类型）；不满足则报错返回 false。
pub fn concept_satisfied(cname: string, ati: i64, loc: i64) bool {
    var si: i64 = sym_lookup(global_scope, cname);
    if (si < 0) { return false; }
    var cd: i64 = syms[si].decl;
    if (cd < 0) { return false; }
    if (is_user_named_kind(tip_kind(ati)) == false) {
        parse.fc_err("T-CON-E101",
            base.sb_cat6("类型 `", ti_str(ati), "` 不满足概念 `", cname, "`：不是具名类型", ""), loc);
        return false;
    }
    var tname: string = tip_name(ati);
    var tsi: i64 = sym_lookup(global_scope, tname);
    var tsd: i64 = -1;
    if (tsi >= 0) { tsd = syms[tsi].decl; }
    // 字段约束：概念 node.lb（字段链）
    var cfs: []i64 = base.kids_chain(base.node_lb((cd as u64)));
    var cfi: i64 = 0;
    while (cfi < slice_len(cfs) as i64) {
        var cfv: i64 = cfs[cfi];
        var fnm: string = base.node_sa((cfv as u64));
        var cft: i64 = resolve_ti(base.node_na((cfv as u64)));
        var found: bool = false;
        if (tsd >= 0) {
            var tfs: []i64 = base.kids_chain(base.node_lb((tsd as u64)));
            var tfi: i64 = 0;
            while (tfi < slice_len(tfs) as i64) {
                var tfv: i64 = tfs[tfi];
                if (base.node_sa((tfv as u64)) == fnm) {
                    var tft: i64 = resolve_ti(base.node_na((tfv as u64)));
                    if (ti_equal(cft, tft)) { found = true; }
                    tfi = slice_len(tfs) as i64;
                }
                tfi = tfi + 1;
            }
        }
        if (found == false) {
            parse.fc_err("T-CON-E101",
                base.sb_cat6("类型 `", tname, "` 不满足概念 `", cname, "`：缺少字段 `", fnm), loc);
            return false;
        }
        cfi = cfi + 1;
    }
    // 方法约束：全局表 g_concept_method_names/heads 中属于 cname 的（方法声明链）
    var mi2: i64 = 0;
    while (mi2 < slice_len(lex.g_concept_method_names) as i64) {
        if (lex.g_concept_method_names[mi2] == cname) {
            var ms: []i64 = base.kids_chain(lex.g_concept_method_heads[mi2]);
            var msi: i64 = 0;
            while (msi < slice_len(ms) as i64) {
                var mv: i64 = ms[msi];
                // 概念方法名已按 concept 名 mangle（如 has_name_name）；概念方法约束在
                // parse 期用逻辑名（name），故 mnm 已是逻辑方法名。实现结构体方法按
                // pascal_to_snake(tname) 前缀拼回（person_name），才能与符号表对齐。
                var mnm: string = base.node_sa((mv as u64));
                var full: string = base.sb_cat3(parse.pascal_to_snake(tname), "_", mnm);
                var msi2: i64 = sym_lookup(global_scope, full);
                if (msi2 < 0) {
                    parse.fc_err("T-CON-E101",
                        base.sb_cat6("类型 `", tname, "` 不满足概念 `", cname, "`：缺少方法 `", mnm), loc);
                    return false;
                }
                // 返回类型一致性（精确签名匹配为后续增强）
                var mdecl: i64 = syms[msi2].decl;
                if (mdecl >= 0) {
                    var cret: i64 = resolve_ti(base.node_na((mv as u64)));
                    var mret: i64 = resolve_ti(base.node_na((mdecl as u64)));
                    if (ti_equal(cret, mret) == false) {
                        parse.fc_err("T-CON-E101",
                            base.sb_cat8("类型 `", tname, "` 不满足概念 `", cname,
                                "`：方法 `", mnm, "` 返回类型不匹配", ""), loc);
                        return false;
                    }
                }
                msi = msi + 1;
            }
        }
        mi2 = mi2 + 1;
    }
    return true;
}

// 调用点：推断出隐式类型参数并前置注入为 comptime 实参；返回 false 表示推断/满足检查失败。
pub fn generic_prepend_inferred_types(tmpl: i64, e: i64) bool {
    var ks: []i64 = base.kids_chain(base.node_lb((tmpl as u64)));
    // 隐式类型参数（bb && bc，按形参表顺序）
    var tps: []i64;
    var vps: []i64;
    var ki: i64 = 0;
    while (ki < slice_len(ks) as i64) {
        var pv: i64 = ks[ki];
        if (base.node_bb((pv as u64)) == true and base.node_bc((pv as u64)) == true) {
            append(tps, pv);
        } else if (base.node_bb((pv as u64)) == false) {
            append(vps, pv);
        }
        ki = ki + 1;
    }
    var n: i64 = slice_len(tps) as i64;
    if (n == 0) { return true; }   // 无隐式类型参数（纯显式 comptime）：不注入
    var num_value: i64 = slice_len(vps) as i64;
    var total_args: i64 = 0;
    var argcnt: i64 = base.node_la((e as u64));
    while (argcnt >= 0) { total_args = total_args + 1; argcnt = base.kids[argcnt].next; }
    var inferred: []i64;
    var ti_idx: i64 = 0;
    while (ti_idx < n) {
        var tpn: string = base.node_sa((tps[ti_idx] as u64));
        var src: i64 = -1;
        var vpi: i64 = 0;
        while (vpi < num_value) {
            var vpv: i64 = vps[vpi];
            if (base.node_na((vpv as u64)) >= 0 and generic_tn_refs_name(base.node_na((vpv as u64)), tpn)) {
                src = vpi;
                vpi = num_value;
            }
            vpi = vpi + 1;
        }
        if (src < 0) {
            parse.fc_err("T-CON-E102",
                base.sb_cat3("无法推断类型参数 `", tpn, "`：没有值形参引用它"), e);
            return false;
        }
        // 值形参 src 对应调用实参（值实参是调用实参的最后 num_value 个）
        var aidx: i64 = total_args - num_value + src;
        var argn: i64 = base.node_la((e as u64));
        var ai: i64 = 0;
        while (ai < aidx and argn >= 0) {
            argn = base.kids[argn].next;
            ai = ai + 1;
        }
        if (argn < 0) {
            parse.fc_err("T-CON-E102",
                base.sb_cat3("无法推断类型参数 `", tpn, "`：调用实参不足"), e);
            return false;
        }
        var ati: i64 = infer_expr(base.kids[argn].val);
        // 约束检查：约束存侧表 g_gpc_*（na 已是 type 占位，不能放 nb/nc）。
        // 多约束：逐个 concept 都满足才算通过（§set-ops 岔路 B）。
        var cnames: []string = generic_param_constraint(tps[ti_idx]);
        var cci: i64 = 0;
        while (cci < slice_len(cnames) as i64) {
            var cnm: string = cnames[cci];
            var csi: i64 = sym_lookup(global_scope, cnm);
            if (csi >= 0 and syms[csi].kind == "concept") {
                if (concept_satisfied(cnm, ati, e) == false) { return false; }
            }
            cci = cci + 1;
        }
        append(inferred, mk_type_node_from_ti(ati));
        ti_idx = ti_idx + 1;
    }
    // 前置注入：新实参链 = inferred ++ 原实参
    var nh: i64 = -1;
    var nt: i64 = -1;
    var ii: i64 = 0;
    while (ii < n) {
        nt = base.list_push(nh, nt, inferred[ii]);
        if (nh < 0) { nh = nt; }
        ii = ii + 1;
    }
    var old: i64 = base.node_la((e as u64));
    while (old >= 0) {
        nt = base.list_push(nh, nt, base.kids[old].val);
        if (nh < 0) { nh = nt; }
        old = base.kids[old].next;
    }
    base.node_set_la((e as u64), nh);
    return true;
}

// ── R3 类型组分派（类别格静态分派）──────────────────────────────
// 调用点按首实参静态类型在类型组里选最具体覆盖子句：具体类型精确匹配（specificity -1）
// > 类别（按 ovl_path_of_name 路径长度，integralkind > scalarkind > anykind 等）。
// 类别子句按需单态化（克隆 + 把类别名替换为具体类型），与 comptime 泛型单态化同构。
pub fn ovl_arg_typename(ti: i64) string {
    // 把 t 的内部 TI kind 归一为类别格用的「类型名」：
    //   Scalar  → 其名（i64 / u8 / f64 / bool …）
    //   String  → "string"（TI 的 name 字段为空，须显式映射；见 sema.tc:5863 string 是独立 kind）
    //   Bytes   → "bytes"
    //   Named   → 其名（struct / enum）
    // 其余（Slice / Map / Func / Unknown …）→ "" 表示无法静态分派。
    var k: string = tip_kind(ti);
    if (k == "Scalar") { return tip_name(ti); }
    if (k == "String") { return "string"; }
    if (k == "Bytes") { return "bytes"; }
    if (k == "Named") { return tip_name(ti); }
    return "";
}

pub fn ovl_dispatch_call(e: i64, gi: i64) i64 {
    var arg0: i64 = -1;
    if (base.node_la((e as u64)) >= 0) { arg0 = base.kids[base.node_la((e as u64))].val; }
    if (arg0 < 0) {
        parse.fc_err("T-OVL-E903",
            base.sb_cat3("type-group '", parse.g_ovl_tg_names[gi], "' 至少需要一个实参用于静态分派"), e);
        return ti_mk("Unknown");
    }
    var ei: i64 = ie_inst(e);
    var at0: i64 = ie_sub_in(ei, arg0);
    var a: string = ovl_arg_typename(at0);
    var m: i64 = parse.ovl_group_count(gi);
    var best: i64 = -1;
    var bestspec: i64 = 1000000000;
    var ambiguous: bool = false;
    var k: i64 = 0;
    while (k < m) {
        var c: string = parse.ovl_group_cat_at(gi, k);
        var spec: i64 = parse.ovl_specificity(a, c);
        // spec == -2：不覆盖；spec == -1：具体类型精确匹配（最具体）；spec >= 0：类别匹配（值越小越具体）。
        // ⚠ 旧实现只接受 spec >= 0，把最具体的精确匹配（-1）也误判为「不覆盖」→ 全部子句漏选 → E903。
        if (spec == -2) { k = k + 1; continue; }
        if (spec < bestspec) { bestspec = spec; best = k; ambiguous = false; }
        else if (spec == bestspec) { ambiguous = true; }
        k = k + 1;
    }
    if (best < 0) {
        parse.fc_err("T-OVL-E903",
            base.sb_cat5("type-group '", parse.g_ovl_tg_names[gi],
                "': 没有子句覆盖静态类型 '", a, "'"), e);
        return ti_mk("Unknown");
    }
    if (ambiguous) {
        parse.fc_err("T-OVL-E902",
            base.sb_cat3("type-group '", parse.g_ovl_tg_names[gi],
                "': 多个子句同样匹配（静态分派歧义）"), e);
        return ti_mk("Unknown");
    }
    var target: string = parse.ovl_group_func_at(gi, best);
    var tmpl: i64 = parse.ovl_tmpl_at(gi, best);
    if (tmpl >= 0) {
        target = ovl_instantiate(gi, best, a);
        if (str_len(target) == 0) { return ti_mk("Unknown"); }
    }
    base.node_set_sa((base.node_na((e as u64)) as u64), target);
    return infer_expr(e);
}

pub fn ovl_instantiate(gi: i64, best: i64, a: string) string {
    var tmplname: string = parse.ovl_group_func_at(gi, best);
    var iname: string = sanitize_sym(base.sb_cat3(tmplname, "__", a));
    var si: i64 = sym_lookup(global_scope, iname);
    if (si >= 0) {
        return iname;
    }
    var tmpl: i64 = parse.ovl_tmpl_at(gi, best);
    var catname: string = parse.ovl_group_cat_at(gi, best);
    var tnode: i64 = type_node_from_ident(a);
    var inst: i64 = clone_node(tmpl);
    base.node_set_sa((inst as u64), iname);
    base.node_set_kind((inst as u64), "FuncDecl");
    base.node_set_ia((inst as u64), 0);
    base.node_set_na((inst as u64), subst_type_in_node(base.node_na((inst as u64)), catname, tnode));
    var pp: i64 = base.node_lb((inst as u64));
    var mq_ks2219: []i64 = base.kids_chain_idx(base.node_lb((inst as u64)));
    var mq_ki2219: i64 = 0;
    while (mq_ki2219 < slice_len(mq_ks2219) as i64) {
        pp = mq_ks2219[mq_ki2219];
        base.node_set_na((base.kids[pp].val as u64), subst_type_in_node(base.node_na((base.kids[pp].val as u64)), catname, tnode));
        mq_ki2219 = mq_ki2219 + 1;
        pp = -1;
    }
    base.node_set_lc((inst as u64), subst_type_in_kids(base.node_lc((inst as u64)), catname, tnode));   // S4 §0.14.7 SoA：取代 `base.node_lc((inn.id as u64)) = …`
    base.node_set_lc((inst as u64), subst_type_ident_kids(base.node_lc((inst as u64)), catname, tnode));
    append(lex.decl_list, inst);
    register_decl(inst);
    var sq: bool = g_meta_quiet;
    var st2: i64 = g_menv_top;
    var sb2: i64 = g_menv_base;
    g_meta_quiet = false;
    g_meta_err = false;
    g_menv_top = g_menv_nglobal;
    g_menv_base = g_menv_nglobal;
    if (g_meta_steps < 200000) { g_meta_steps = 200000; }
    mb_walk_list(base.node_lc((inst as u64)));
    meta_walk_list(base.node_lc((inst as u64)));
    g_meta_quiet = sq;
    g_meta_err = false;
    g_menv_top = st2;
    g_menv_base = sb2;
    if (base.node_lc((inst as u64)) != -2) {
        // comptime fn 的泛型实例体须处于 comptime 上下文检查：
        // 体内 @compile_log / @type_info 等仅 CTFE 内建属合法（与 comptime { } 块一致），
        // 否则会误报 T-MTA-E605（运行期回退）。
        var saved_ct_ovl: i64 = g_in_comptime;
        if (base.node_bb((tmpl as u64))) { g_in_comptime = g_in_comptime + 1; }
        check_func_decl(inst);
        g_in_comptime = saved_ct_ovl;
    }
    return iname;
}

// ── P0-2 + P0-3：实例体补齐检查的落点 ──────────────────────────
// 实例体的补齐检查（嵌套泛型再单态化 + 体内 format/!j 脱糖）落在 `instantiate_generic`
// 末尾：克隆+代换后即重跑 check_func_decl（见该函数末尾注释）。理由是该步处于主检查循环
// 之内、代码生成预处理之前，脱糖结果能进入同一趟发射视图——这也是非泛型函数体被脱糖的
// 同一时机。故这里不再保留独立的 fixpoint。

// ── 声明注册 registerDecl（复刻 checker.ts:97）────────────────

// >>> GEN:type_declreg (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
pub fn register_decl(d: i64) void {
    if (base.node_kind((d as u64)) == "StructDecl") {
        if (base.node_sb((d as u64)) == "concept") {
            // 约束类型（不可实例化）：注册为 kind="concept"，与 "type" 区分，使 resolve_ti
            // 在值类型位置拒绝其实例化；泛型边界 `T:HasName` 由 Task #4b 处理。
            sym_define(global_scope, base.node_sa((d as u64)), "concept", ti_named("Struct", base.node_sa((d as u64))), d);
        } else {
            sym_define(global_scope, base.node_sa((d as u64)), "type", ti_named("Struct", base.node_sa((d as u64))), d);
        }
        return;
    }
    if (base.node_kind((d as u64)) == "EnumDecl") {
        sym_define(global_scope, base.node_sa((d as u64)), "type", ti_with_und("Enum", base.node_sa((d as u64)), base.node_sb((d as u64))), d);
        return;
    }
    if (base.node_kind((d as u64)) == "UnionDecl") {
        sym_define(global_scope, base.node_sa((d as u64)), "type", ti_named("Union", base.node_sa((d as u64))), d);
        return;
    }
    if (base.node_kind((d as u64)) == "VariantDecl") {
        sym_define(global_scope, base.node_sa((d as u64)), "type", ti_named("Variant", base.node_sa((d as u64))), d);
        register_variant_helpers(d);
        return;
    }
    if (base.node_kind((d as u64)) == "FuncDecl") {
        var fti: i64 = ti_named("Func", base.node_sa((d as u64)));
        // 泛型模板：把 comptime/meta 类型参数名临时登记，供下方 resolve_ti 识别为
        // 「类型参数」而非未定义类型（模板本体定义期不展开，T 尚未绑定到具体类型）。
        // 普通函数 / 实例（T 已替换为具体类型）不受影响。结束后还原，避免跨函数泄漏。
        var saved_gt: []string = g_gen_tparams;
        if (func_is_generic(d)) {
            var gt: []string;
            var gp: i64 = base.node_lb((d as u64));
            // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环
            var ks2281: []i64 = base.kids_chain(gp);
            var ki2281: i64 = 0;
            while (ki2281 < slice_len(ks2281) as i64) {
                var kv2281: i64 = ks2281[ki2281];
                var gpn: i64 = kv2281;
                if (base.node_bb((gpn as u64)) == true and meta_param_is_type(gpn)) {   // S4 §0.14.7 SoA：侧表读
                    append(gt, base.node_sa((gpn as u64)));
                }
                ki2281 = ki2281 + 1;
            }
            g_gen_tparams = gt;
        }
        // 记录具名函数的真实签名，供「函数作为值」可赋值性 / 间接调用使用
        var fret2: i64 = resolve_ti(base.node_na((d as u64)));
        var fbuf2: []i64;
        var fp: i64 = base.node_lb((d as u64));
        var mq_ks2306: []i64 = base.kids_chain_idx(base.node_lb((d as u64)));
        var mq_ki2306: i64 = 0;
        while (mq_ki2306 < slice_len(mq_ks2306) as i64) {
            fp = mq_ks2306[mq_ki2306];
            var fpid: i64 = base.kids[fp].val;
            append(fbuf2, resolve_ti(base.node_na((fpid as u64))));
            mq_ki2306 = mq_ki2306 + 1;
            fp = -1;
        }
        g_gen_tparams = saved_gt;
        var fpstart2: i64 = slice_len(tif_params) as i64;
        var fpc2: i64 = slice_len(fbuf2) as i64;
        var fj1: i64 = 0;
        if (base.g_relowering) { arena_use_default(); }
        while (fj1 < fpc2) {
            append(tif_params, fbuf2[fj1]);
            fj1 = fj1 + 1;
        }
        if (base.g_relowering) {
            if (base.g_relowering_scratch_func) { arena_use_func(); } else { arena_use_default(); }
        } else { arena_use_default(); }
        tif_ret[fti] = fret2;
        tif_pstart[fti] = fpstart2;
        tif_pcount[fti] = fpc2;
        sym_define(global_scope, base.node_sa((d as u64)), "func", fti, d);
        return;
    }
    if (base.node_kind((d as u64)) == "GlobalVarDecl") {
        sym_define(global_scope, base.node_sa((d as u64)), "var", resolve_ti(base.node_na((d as u64))), d);
        return;
    }
    if (base.node_kind((d as u64)) == "GlobalConstDecl") {
        var cti: i64 = -1;
        if (base.node_na((d as u64)) >= 0) {
            cti = resolve_ti(base.node_na((d as u64)));
        } else {
            cti = ti_mk("Unknown");
        }
        sym_define(global_scope, base.node_sa((d as u64)), "const", cti, d);
        return;
    }
    if (base.node_kind((d as u64)) == "TypeAliasDecl") {
        sym_define(global_scope, base.node_sa((d as u64)), "type", resolve_ti(base.node_na((d as u64))), d);
        return;
    }
}
// <<< GEN:type_declreg <<<

// 递归 variant 守卫：载荷以**值形态**自引用 ⇒ 类型大小无限，双后端都会发射非法 C/IR。
// 指针形态 `*Self` 合法（前向引用按名字解析）；切片 `[]Self` / map 也合法（都是间接）。
// 只有裸 `Self` 与定长数组 `[N]Self` 是真正的值形态自引用 —— 显式报错，绝不静默错编（L-09）。
pub fn variant_payload_recursive_value(tn: i64, vname: string) bool {
    if (tn < 0) {
        return false;
    }
    if (base.node_kind((tn as u64)) == "named") {
        return base.node_sa((tn as u64)) == vname;
    }
    if (base.node_kind((tn as u64)) == "array") {
        // 定长数组按值内联，故 `[N]Self` 同样无限大
        return variant_payload_recursive_value(base.node_na((tn as u64)), vname);
    }
    return false;
}

pub fn variant_check_recursion(d: i64) void {
    var c: i64 = base.node_lb((d as u64));
    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环
    var ks2353: []i64 = base.kids_chain(c);
    var ki2353: i64 = 0;
    while (ki2353 < slice_len(ks2353) as i64) {
        var kv2353: i64 = ks2353[ki2353];
        // 多载荷走 lb 类型链；单载荷只有 na
        if (base.node_lb((kv2353 as u64)) >= 0) {
            var mp: i64 = base.node_lb((kv2353 as u64));
            // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环
            var ks2358: []i64 = base.kids_chain(mp);
            var ki2358: i64 = 0;
            while (ki2358 < slice_len(ks2358) as i64) {
                var kv2358: i64 = ks2358[ki2358];
                if (variant_payload_recursive_value(kv2358, base.node_sa((d as u64)))) {
                    parse.fc_err("T-SEM-E213",
                        base.sb_cat5("variant `", base.node_sa((d as u64)), "` 的 case `", base.node_sa((kv2353 as u64)),
                            base.sb_cat3("` 载荷以值形态自引用 `", base.node_sa((d as u64)), "`：请改用指针 `*Self`")),
                        kv2358);
                }
                ki2358 = ki2358 + 1;
            }
        } else if (variant_payload_recursive_value(base.node_na((kv2353 as u64)), base.node_sa((d as u64)))) {
            parse.fc_err("T-SEM-E213",
                base.sb_cat5("variant `", base.node_sa((d as u64)), "` 的 case `", base.node_sa((kv2353 as u64)),
                    base.sb_cat3("` 载荷以值形态自引用 `", base.node_sa((d as u64)), "`：请改用指针 `*Self`")),
                base.node_na((kv2353 as u64)));
        }
        ki2353 = ki2353 + 1;
    }
}

// 为 Variant 的每个 case 注册合成函数符号（构造器/判别器/取载荷），
// 指向合成 FuncDecl 节点但不在 decl_list 中，故仅作类型检查可见、不被 emitter 重复发射。
pub fn register_variant_helpers(d: i64) void {
    variant_check_recursion(d);
    var c: i64 = base.node_lb((d as u64));
    var mq_ks2401: []i64 = base.kids_chain_idx(base.node_lb((d as u64)));
    var mq_ki2401: i64 = 0;
    while (mq_ki2401 < slice_len(mq_ks2401) as i64) {
        c = mq_ks2401[mq_ki2401];
        var k: Child = base.kids[c];
        var cname: string = base.node_sa((k.val as u64));
        // 构造器 Name_from_Case(载荷?) Name
        var ffrom: string = base.sb_cat3(base.node_sa((d as u64)), "_from_", cname);
        var retNode: i64 = base.mk_named(base.node_sa((d as u64)), -1);
        var plist: i64 = -1;
        var ptail: i64 = -1;
        if (base.node_lb((k.val as u64)) >= 0) {
            // 多载荷：v0: T0, v1: T1, ...
            var mp: i64 = base.node_lb((k.val as u64));
            var mk_idx: i64 = 0;
            var mq_ks2413: []i64 = base.kids_chain_idx(base.node_lb((k.val as u64)));
            var mq_ki2413: i64 = 0;
            while (mq_ki2413 < slice_len(mq_ks2413) as i64) {
                mp = mq_ks2413[mq_ki2413];
                var mpt: i64 = base.kids[mp].val;
                var mpn: string = base.sb_cat2("v", base.i2s(mk_idx));
                var pid: i64 = base.mk_P(mpn, mpt, -1, -1);
                ptail = base.list_push(plist, ptail, pid);
                if (plist < 0) {
                    plist = ptail;
                }
                mq_ki2413 = mq_ki2413 + 1;
                mk_idx = mk_idx + 1;
                mp = -1;
            }
        } else if (base.node_na((k.val as u64)) >= 0) {
            var pid: i64 = base.mk_P("v", base.node_na((k.val as u64)), -1, -1);
            ptail = base.list_push(plist, ptail, pid);
            if (plist < 0) {
                plist = ptail;
            }
        }
