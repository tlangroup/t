        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, ",");
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, g_q);
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, "fn");
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, g_q);
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, ":");
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, g_q);
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, base.node_sa((base.node_na((e as u64)) as u64)));
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, g_q);
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, ",");
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, g_q);
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, "depth");
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, g_q);
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, ":");
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, base__i2s(g_meta_depth));
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, ",");
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, g_q);
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, "args");
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, g_q);
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, ":");
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, g_q);
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, args_str);
        g_meta_trace_jsonl = base__sb_cat2(g_meta_trace_jsonl, g_q);
