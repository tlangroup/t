                    // S4 批次 20-B：删除 `base.nodes[base.node_na((e as u64))] = cn;`
                    //   —— `cn` 就是 `base.nodes[na(e)]` 自身（见上方赋值），**恒等赋值** ⇒ 零风险。
                    si2 = sym_lookup(global_scope, ctor_name);
                    if (si2 < 0) { si2 = sym_lookup(cur_scope, ctor_name); }
