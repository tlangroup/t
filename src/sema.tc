            var mk_idx: i64 = 0;
            // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环
            var ks2436: []i64 = base.kids_chain(mp);
            var ki2436: i64 = 0;
            while (ki2436 < slice_len(ks2436) as i64) {
                var kv2436: i64 = ks2436[ki2436];
                var mpt: i64 = kv2436;
                var fas: string = base.sb_cat5(base.node_sa((d as u64)), "_as_", cname, "_f", base.i2s(mk_idx));
                var fdecl3: i64 = base.mk_FuncDecl(fas, true, false, mpt, -1, plist2, -2, -1);
                sym_define(global_scope, fas, "func", ti_named("Func", fas), fdecl3);
