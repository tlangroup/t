            }
        } else if (pat >= 0 and base.node_kind((pat as u64)) == "call") {
            // 变体构造器模式（如 .Module(m) 解析为 call 节点：sa 为空，被调方名在 na 的 ident；
            // la=绑定实参链表）。scr 为 ct_variant / vval 变体值时按 tag 匹配，把首个 ident 绑定到 payload 节点。
            var pcallee: string = "";
            if (base.node_na((pat as u64)) >= 0) { pcallee = base.node_sa((base.node_na((pat as u64)) as u64)); }
            if (pcallee == base.node_sb((scr as u64))) {
                var cph: i64 = base.node_la((pat as u64));
                if (cph >= 0 and base.node_kind((base__kids[cph].val as u64)) == "ident") {
                    var pl: i64 = -1;
                    if (base.node_kind((scr as u64)) == "ct_variant") { pl = base.node_na((scr as u64)); }
                    else if (base.node_kind((scr as u64)) == "vval") { pl = base.node_la((scr as u64)); }
                    if (pl >= 0) { menv_push(base.node_sa((base__kids[cph].val as u64)), pl); matched = true; }
                }
            }
        } else if (pat >= 0 and base.node_kind((pat as u64)) == "ident") {
            menv_push(base.node_sa((pat as u64)), scr);      // 绑定整个 scrutinee 值
            matched = true;
        } else if (pat >= 0 and (base.node_kind((pat as u64)) == "int"
                or base.node_kind((pat as u64)) == "string" or base.node_kind((pat as u64)) == "bool")) {
            if (meta_lit_eq(pat, scr)) { matched = true; }
        }
        if (matched and guard >= 0) {
            var gv: i64 = meta_eval(guard);
            if (gv < 0) { g_menv_top = sv_top; g_menv_base = sv_base; return -1; }
            if (base.node_kind((gv as u64)) != "bool" or base.node_ba((gv as u64)) == false) { matched = false; }
        }
        if (matched) {
            // 臂体为 block_expr（多语句臂，如 `{ @compile_log(...); return v; }`）时，
            // 不能走 meta_eval（其不处理 block_expr 节点 → 误报 T-MTA-E617「运行期回退」），
            // 须改用 meta_exec 执行语句列表；return 的值落在 g_meta_ret（meta_exec 返回 1）。
            // 单表达式臂（裸 expr，无大括号）仍走 meta_eval。
            var rv: i64 = -1;
            if (base.node_kind((body as u64)) == "block_expr") {
                var rblk: i64 = meta_exec(base.node_la((body as u64)));
                if (rblk == 1) { rv = g_meta_ret; }
                else { rv = 0; }
            } else {
                rv = meta_eval(body);
            }
            g_menv_top = sv_top;
            g_menv_base = sv_base;
            return rv;
        }
        g_menv_top = sv_top;
        g_menv_base = sv_base;
        mq_ki11938 = mq_ki11938 + 1;
        mc = -1;
    }
    return meta_fail("T-MTA-E617", "编译期 match 无可匹配臂（scrutinee 未匹配任何模式）", e);
}

