        // 裸 `format`，随后交给同一个 desugar_format_call。两种写法因此共享同一份模板文法、
        // 同一组诊断码，永远不会各自漂移。
        if (base.node_kind((base.node_na((e as u64)) as u64)) == "member" and base.node_na((base.node_na((e as u64)) as u64)) >= 0 and base.node_sa((base.node_na((e as u64)) as u64)) == "format") {
            var mfa_recv: i64 = base.node_na((base.node_na((e as u64)) as u64));
            if (base.node_kind((mfa_recv as u64)) == "string") {
                var mfa_h: i64 = -1;
                var mfa_t: i64 = -1;
                mfa_t = base.list_push(mfa_h, mfa_t, mfa_recv);
                if (mfa_h < 0) { mfa_h = mfa_t; }
                var mfa_c: i64 = base.node_la((e as u64));
                var mq_ks7099: []i64 = base.kids_chain_idx(base.node_la((e as u64)));
                var mq_ki7099: i64 = 0;
                while (mq_ki7099 < slice_len(mq_ks7099) as i64) {
