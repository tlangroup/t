fn builtin_ret(name: string) i64 {
    if (name == "assert_eq" || name == "assert_true" || name == "assert_false") {
        return ti_mk("Void");
    }
    if (name == "assert_panic" || name == "flag_set" || name == "print") {
        return ti_mk("Void");
    }
    if (name == "println" || name == "append" || name == "slice_set") {
        return ti_mk("Void");
    }
    if (name == "exit" || name == "eprint" || name == "sb_append_str") {
        return ti_mk("Void");
    }
    if (name == "sb_append_char" || name == "sb_append_u64" || name == "sb_append_i64") {
        return ti_mk("Void");
    }
    if (name == "sb_clear") {
        return ti_mk("Void");
    }
    if (name == "flag_get") {
        return ti_scalar("u32");
    }
    if (name == "sys_run") {
        return ti_scalar("i32");
    }
    if (name == "str_len" || name == "slice_len") {
        return ti_scalar("u64");
    }
    if (name == "str_at") {
        return ti_scalar("u8");
    }
    if (name == "file_read_all" || name == "path_resolve" || name == "str_slice") {
        return ti_mk("String");
    }
    // bytes / BytesBuilder 内建：复用 t_str_*/t_sb_* 运行时（布局与 string/StringBuilder 一致）
    if (name == "bytes_len") { return ti_scalar("u64"); }
    if (name == "bytes_at") { return ti_scalar("u8"); }
    if (name == "bytes_slice") { return ti_mk("Bytes"); }
    if (name == "bsb_new") { return ti_mk("StringBuilder"); }
    if (name == "bsb_append_u8" || name == "bsb_append_bytes") { return ti_mk("Void"); }
    if (name == "bsb_to_bytes") { return ti_mk("Bytes"); }
    // slice_sub(s, lo, hi)：真实返回类型 = 首实参类型，在 infer_expr 的调用分支里
    // 反查（与 map_get 同一手法）；这里只是无实参可查时的兜底。
    if (name == "slice_sub") {
        return ti_elem_of("Slice", ti_mk("Unknown"));
    }
    if (name == "sb_to_str" || name == "to_string") {
        return ti_mk("String");
    }
    if (name == "int_to_str" || name == "i2s") {
        return ti_mk("String");
    }
    if (name == "file_write_all" || name == "file_exists") {
        return ti_scalar("bool");
    }
    if (name == "args") {
        return ti_elem_of("Slice", ti_mk("String"));
    }
    // REPL 交互输入（M-REPL）
    if (name == "read_line") {
        return ti_mk("String");
    }
    if (name == "stdin_eof") {
        return ti_scalar("bool");
    }
    if (name == "sb_new") {
        return ti_mk("StringBuilder");
    }
    if (name == "map_new") {
        return ti_mk("Map");
    }
    if (name == "map_set") {
        return ti_mk("Void");
    }
    if (name == "map_has" || name == "map_del") {
        return ti_scalar("bool");
    }
    if (name == "map_len") {
        return ti_scalar("i64");
    }
    if (name == "map_get") {
        return ti_mk("Unknown");
    }
    if (name == "ti_name" || name == "fi_name" || name == "fi_type_name") {
        return ti_mk("String");
    }
    if (name == "ti_size" || name == "ti_kind" || name == "ti_field_count" || name == "fi_offset" || name == "fi_type_size" || name == "fi_tag") {
        return ti_scalar("i64");
    }
    if (name == "ti_field") {
        return ti_mk("FieldInfo");
    }
    if (name == "fi_is_ptr") {
        return ti_scalar("bool");
    }
    if (name == "sym_str") {
        return ti_mk("String");
    }
    if (name == "sym_release" || name == "sym_release_all") {
        return ti_mk("Void");
    }
    if (name == "atom_str") {
        return ti_mk("String");
    }
    // 文件描述符内建（M51）
    if (name == "fopen") {
        return ti_scalar("fid");
    }
    if (name == "fclose" || name == "fflush" || name == "fmt_register") {
        return ti_mk("Void");
