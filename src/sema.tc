        // 已注册 Func（flush_struct_methods 已把 `fn Point.origin` 重命名为 `point_origin`），
        // 则改写 callee 为裸 ident 并（方法首参 self）前置 receiver 为第 0 实参，随后走下方
        // ident 分支正常解析（含实参校验 / 返回类型）。类型级 `Point.create()` 与值级 `p.origin()`
        // 同构处理。幂等：改写后 callee 是 ident，二次进入不再走本分支。
        // P3b 结构体方法脱糖：仅当 receiver 是「值 / 类型名」（struct/union/named），
        // 不是模块值。若 receiver 是模块值（如 base.sb_cat5 的 base），跳过本分支，
        // 落到下方 6814 模块值成员访问（按 <key>__<field> 改写）——否则 receiver 被当普通值
        // infer_expr → T-SEM-E201（模块值非可运算值；单进程下 import 语句经 modval_load 把
        // 模块名登记为 Module 类型符号故不报错，但 lib 独立编译入口模块不会自我 import）。
        if (base.node_kind((base.node_na((e as u64)) as u64)) == "member" and base.node_na((base.node_na((e as u64)) as u64)) >= 0) {
            var afm: i64 = base.node_na((e as u64));
            var afrecv: i64 = base.node_na((afm as u64));
            // 模块值接收者（base.sb_cat5 的 base）不是结构体：跳过 P3b 方法脱糖，
            // 落到下方 6814 模块值成员访问（按 <key>__<field> 改写）。否则 receiver 被当普通值
            // infer_expr → T-SEM-E201（模块值非可运算值；单进程下 import 语句经 modval_load 把
            // 模块名登记为 Module 类型符号故不报错，但 lib 独立编译入口模块不会自我 import）。
            var af_is_modval: bool = (base.node_kind((afrecv as u64)) == "ident" and str_len(g_modval_get(base.node_sa((afrecv as u64)))) as i64 > 0);
            if (af_is_modval == false) {
