        // device.alloc_bytes / free / h2d / d2h / launch。callee = parse.member(device, fn)。
        // 全部以 i64 句柄（CUdeviceptr）交换设备指针，调用点用 `as dev_ptr[T]` 还原类型。
        if (base.node_kind((base.node_na((e as u64)) as u64)) == "member" and base.node_na((base.node_na((e as u64)) as u64)) >= 0) {
            if (base.node_kind((base.node_na((base.node_na((e as u64)) as u64)) as u64)) == "ident" and base.node_sa((base.node_na((base.node_na((e as u64)) as u64)) as u64)) == "device") {
                return infer_device_call(e, base.node_sa((base.node_na((e as u64)) as u64)));
            }
        }
        // 前导点变体构造器：`.Circle(7)` → Shape_from_Circle(7)。callee 是 parse.member(.Circle, lb=1, na=-1)，
        // 查它是否为某 variant 的 case 名；是则把 callee 改写成 ident(<Variant>_from_<Case>)，
        // 随后走下方 ident 分支正常解析。幂等（改写后不含 case 名）。
        if (base.node_kind((base.node_na((e as u64)) as u64)) == "member" and base.node_lb((base.node_na((e as u64)) as u64)) == 1 and base.node_na((base.node_na((e as u64)) as u64)) < 0) {
            var vname: string = variant_name_of_case(base.node_sa((base.node_na((e as u64)) as u64)));
            if (str_len(vname) as i64 > 0) {
                var ctor_name: string = base.sb_cat3(vname, "_from_", base.node_sa((base.node_na((e as u64)) as u64)));
                var ctor_id: i64 = base.mk_ident(ctor_name, -1);
                base.node_set_span_id(ctor_id, base.node_span_id(cn_id)); base.node_set_span_id(ctor_id, base.node_span_id(cn_id)); base.node_set_span_id(ctor_id, base.node_span_id(cn_id));
                base.node_set_na((e as u64), ctor_id);
