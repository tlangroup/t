                    // 不在此报错；否则是「不存在的关联函数/方法」，明确报错，避免静默错编。
                    var affld: i64 = struct_field_ti(afstruct, afname);
                    if (affld < 0) {
                        parse.fc_err("T-SEM-E208",
                            base.sb_cat4("类型 ", afstruct, " 没有关联函数/方法 ", afname), e);
                    }
                }
            }
            }
        }
        if (base.node_kind((base.node_na((e as u64)) as u64)) == "ident") {
            var fname: string = base.node_sa((base.node_na((e as u64)) as u64));
            var si2: i64 = sym_lookup(global_scope, fname);
            if (si2 < 0) { si2 = sym_lookup(cur_scope, fname); }
