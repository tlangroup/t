// ══════════════════════════════════════════════════════════════════
// src/sema.tc — 编译步骤 3：语义分析
//
// 内容：类型检查器（TypeInfo 池）、comptime/meta 泛型单态化、CTFE 求值器、
//       编译期内建，以及供两个后端消费的 TypeDesc（TD）池。
// 依赖：base, lex, parse。
// ══════════════════════════════════════════════════════════════════

import(src.base :: *);
import(src.lex :: *);
import(src.parse :: *);

// ── TypeDesc 池（复刻 TypeDesc interface）──────────────────────
// 类型描述库由语义分析阶段产出（构建 TD 索引），供两个代码生成后端消费，
// 故定义置于本模块（step 3），codegen_c / codegen_ll 通过 import 读取。
// cat: "string" | "slice" | "map" | "named" | "scalar" | "unknown" | "void"

struct TD {
    cat: string;
    name: string;
    elem: i64;   // TD 索引，-1 = 无
    key: i64;
    val: i64;
    alen: i64;   // cat == "array" 时的定长长度，其余为 -1
}

var tds: []TD;

// 函数类型（cat == "func"）签名侧池：索引与 tds 对齐
var tdf_ret: []i64;      // 返回类型 TD 索引
var tdf_pstart: []i64;   // 参数区起点（tdf_params 下标）
var tdf_pcount: []i64;   // 参数个数
var tdf_params: []i64;   // 参数类型 TD 索引扁平区

// ═══════════════════════════════════════════════════════════════
// M7-2: 类型检查器（移植 tc0/types/checker.ts + types.ts）
// ═══════════════════════════════════════════════════════════════

// ── TypeInfo 扁平池（复刻 types.ts TypeInfo）──────────────────
// kind: Scalar/Void/String/StringBuilder/Array/Slice/Map/Pointer/
//       Optional/Struct/Enum/Flag/FlagSet/Union/Variant/Func/Named/Unknown

struct TI {
    kind: string;
    name: string;   // Scalar/Struct/Enum/Flag/FlagSet/Union/Func/Named
    und: string;    // Enum/Flag underlying
    bw: i64;        // Scalar bitWidth
    elem: i64;      // Array/Slice/Pointer/Optional 子类型（TI 索引）
    key: i64;       // Map key
    val: i64;       // Map value
    alen: i64;      // Array length
}

var tis: []TI;

// 函数类型（Func）签名侧池：索引与 tis 对齐（ti_mk 每次同步追加）
var tif_ret: []i64;     // 返回类型 TI 索引
var tif_pstart: []i64;  // 参数 TI 扁平池起点
var tif_pcount: []i64;  // 参数个数
var tif_params: []i64;  // 参数 TI 扁平池

fn ti_mk(kind: string) i64 {
    var t: TI;
    t.kind = kind;
    t.name = "";
    t.und = "";
    t.bw = 0;
    t.elem = -1;
    t.key = -1;
    t.val = -1;
    t.alen = 0;
    append(tis, t);
    var i: i64 = (slice_len(tis) as i64) - 1;
    append(tif_ret, -1);
    append(tif_pstart, -1);
    append(tif_pcount, 0);
    return i;
}

fn ti_named(kind: string, name: string) i64 {
    var i: i64 = ti_mk(kind);
    var t: TI = tis[i];
    t.name = name;
    slice_set(tis, i, t);
    return i;
}

fn ti_with_und(kind: string, name: string, und: string) i64 {
    var i: i64 = ti_named(kind, name);
    var t: TI = tis[i];
    t.und = und;
    slice_set(tis, i, t);
    return i;
}

fn ti_elem_of(kind: string, elem: i64) i64 {
    var i: i64 = ti_mk(kind);
    var t: TI = tis[i];
    t.elem = elem;
    slice_set(tis, i, t);
    return i;
}

// 函数类型：ret = 返回类型 TI，参数 TI 存于扁平池 tif_params[pstart .. pstart+pcount)
fn ti_func(ret: i64, pstart: i64, pcount: i64) i64 {
    var i: i64 = ti_mk("Func");
    tif_ret[i] = ret;
    tif_pstart[i] = pstart;
    tif_pcount[i] = pcount;
    return i;
}

// ── 标量类型工具（复刻 types.ts）───────────────────────────────

// >>> GEN:scalar_bits (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
fn is_int_name(name: string) bool {
    if (name == "u8" || name == "u16" || name == "u32" || name == "u64") {
        return true;
    }
    if (name == "rune") {
        return true;
    }
    return name == "i8" || name == "i16" || name == "i32" || name == "i64";
}

fn is_float_name(name: string) bool {
    return name == "f16" || name == "f32" || name == "f64";
}

fn get_bw(name: string) i64 {
    if (name == "u8" || name == "i8") {
        return 8;
    }
    if (name == "u16" || name == "i16" || name == "f16") {
        return 16;
    }
    if (name == "u32" || name == "i32" || name == "f32") {
        return 32;
    }
    if (name == "rune") {
        return 32;
    }
    if (name == "u64" || name == "i64" || name == "f64") {
        return 64;
    }
    if (name == "bool") {
        return 1;
    }
    if (name == "atom" || name == "fid") {
        return 64;
    }
    return -1;
}
// <<< GEN:scalar_bits <<<

fn ti_scalar(name: string) i64 {
    var i: i64 = ti_named("Scalar", name);
    var t: TI = tis[i];
    t.bw = get_bw(name);
    slice_set(tis, i, t);
    return i;
}

fn tip_kind(i: i64) string {
    if (i < 0) {
        return "Unknown";
    }
    var t: TI = tis[i];
    return t.kind;
}

fn tip_name(i: i64) string {
    var t: TI = tis[i];
    return t.name;
}

// 条件位置（if / while / for 的条件，match 的 `when` 守卫）只接受 bool。
// Unknown 一律放行：该表达式多半已有诊断，再报一次只会级联噪声。
//
// ⚠ 判据不可写成 `tip_kind(i) == "Scalar" && tip_name(i) != "bool"`。
// 那样只拦住标量，String / Slice / Struct / Enum / Func 全部静默漏过 ——
// `if ("hello")`、`while (some_slice)` 曾零诊断通过（2026-08-02 实测）。
// 正确的形状是白名单：唯有 Scalar/bool 合法，其余皆拒。
fn is_cond_bool(i: i64) bool {
    var ck: string = tip_kind(i);
    if (ck == "Unknown") {
        return true;
    }
    if (ck == "Scalar" && tip_name(i) == "bool") {
        return true;
    }
    return false;
}

fn is_int_ti(i: i64) bool {
    var t: TI = tis[i];
    if (t.kind != "Scalar") {
        return false;
    }
    return is_int_name(t.name);
}

fn is_float_ti(i: i64) bool {
    var t: TI = tis[i];
    if (t.kind != "Scalar") {
        return false;
    }
    return is_float_name(t.name);
}

// typesEqual（递归）
// 用户具名类型（struct / enum / flag / union / variant）的已解析种类
fn is_user_named_kind(k: string) bool {
    if (k == "Struct" || k == "Enum" || k == "Flag") {
        return true;
    }
    return k == "FlagSet" || k == "Union" || k == "Variant";
}

fn ti_equal(ai: i64, bi: i64) bool {
    var a: TI = tis[ai];
    var b: TI = tis[bi];
    if (a.kind != b.kind) {
        // 「Named」是对用户具名类型的**未解析引用**（resolve_ti 在类型注册前产出）。
        // 与已解析的具名类型（Struct/Enum/...）按名字判等，否则同一类型会因解析时机不同被误判为不等。
        if (a.kind == "Named" && is_user_named_kind(b.kind)) {
            return a.name == b.name;
        }
        if (b.kind == "Named" && is_user_named_kind(a.kind)) {
            return a.name == b.name;
        }
        return false;
    }
    if (a.kind == "Scalar") {
        return a.name == b.name;
    }
    if (a.kind == "Bytes") { return a.name == b.name; }
    if (a.kind == "Void" || a.kind == "String" || a.kind == "StringBuilder") {
        return true;
    }
    if (a.kind == "Variant" || a.kind == "Unknown") {
        return true;
    }
    if (a.kind == "Array") {
        if (a.alen != b.alen) {
            return false;
        }
        return ti_equal(a.elem, b.elem);
    }
    if (a.kind == "Slice" || a.kind == "Pointer" || a.kind == "Optional") {
        return ti_equal(a.elem, b.elem);
    }
    if (a.kind == "Map" && b.kind == "Map") {
        // 任一侧 key/val 为 Unknown（如 map_new 返回值）即放行，支持 map_new() map[K]V 赋值
        var okk: bool = (a.key < 0 || b.key < 0 || ti_equal(a.key, b.key));
        var okv: bool = (a.val < 0 || b.val < 0 || ti_equal(a.val, b.val));
        return okk && okv;
    }
    if (a.kind == "Sym") {
        // 同类型 Sym：同 tag 且同位宽；跨池即不同类型（禁止互赋）
        return a.name == b.name && a.bw == b.bw;
    }
    if (a.kind == "Func") {
        if (tif_pcount[ai] != tif_pcount[bi]) { return false; }
        if (ti_equal(tif_ret[ai], tif_ret[bi]) == false) { return false; }
        var fj: i64 = 0;
        while (fj < tif_pcount[ai]) {
            if (ti_equal(tif_params[tif_pstart[ai] + fj], tif_params[tif_pstart[bi] + fj]) == false) {
                return false;
            }
            fj = fj + 1;
        }
        return true;
    }
    return a.name == b.name;
}

// canExplicitCast
fn can_cast(fi: i64, ti2: i64) bool {
    if (ti_equal(fi, ti2)) {
        return true;
    }
    // 数组 ↔ 切片：元素可转型即可（目标为定长数组时要求长度一致）
    var fk: string = tip_kind(fi);
    var tk: string = tip_kind(ti2);
    if ((fk == "Array" || fk == "Slice") && (tk == "Array" || tk == "Slice")) {
        var f: TI = tis[fi];
        var t: TI = tis[ti2];
        if (fk == "Array" && tk == "Array" && f.alen != t.alen) {
            return false;
        }
        // ⚠ 已知缺陷（未修）：Array 与 Slice 的**运行时表示不同** —— `[N]T` 编译成
        // 裸元素指针（长度只活在静态类型里），`[]T` 是 TSlice{ptr,len,esz}。数组
        // *字面量* 初始化切片有就地构造 lowering（正常），但把一个已有的 `[N]T`
        // **变量**传给 `[]T` 形参没有任何转换，后端会把元素字节当 TSlice 头读，
        // 静默返回垃圾长度。这里不能靠 can_cast 一刀切拒绝（它只看类型、不看表达式
        // 来源，会连字面量初始化一起误伤）；正解是在 Array→Slice 处插入
        // t_slice_from_raw(ptr, N, esz) 构造。管道路径已在 pipe 检查里显式拦截。
        if (tip_kind(f.elem) == "Unknown" || tip_kind(t.elem) == "Unknown") {
            return true;
        }
        return can_cast(f.elem, t.elem);
    }
    if (is_int_ti(fi) && is_int_ti(ti2)) {
        return true;
    }
    if (is_float_ti(fi) && is_float_ti(ti2)) {
        return true;
    }
    if (is_int_ti(fi) && is_float_ti(ti2)) {
        return true;
    }
    if (is_float_ti(fi) && is_int_ti(ti2)) {
        return true;
    }
    var f: TI = tis[fi];
    var t: TI = tis[ti2];
    if (f.kind == "Scalar" && f.name == "bool" && is_int_ti(ti2)) {
        return true;
    }
    if (is_int_ti(fi) && t.kind == "Scalar" && t.name == "bool") {
        return true;
    }
    return false;
}

// 2^bits 的无符号幂（bits ≤ 64；bits == 64 时按 u64 回绕为 0，正好对应 u64 上界 2^64-1）。
fn u64_pow2(bits: i64) u64 {
    var r: u64 = 1;
    var i: i64 = 0;
    while (i < bits) {
        r = r * 2;
        i = i + 1;
    }
    return r;
}

// 整数字面量溢出告警。
// 当一个整数字面量（或被一元负号 `-` 包裹的字面量）的实际值，超出目标「有界整数」
// 类型的表示范围时，发出 `overflow_literal` 警告。这是设计本就规划、但此前从未接线的
// 诊断：can_cast 对整数之间一律返回 true（见上），导致 `var x: i8 = 258` 静默按模截断
// 而无任何提示。选 warning 而非 error：截断在运行期是良定义行为（按模回绕），与硬错误
// 不同；若 `@deny(overflow_literal)` 注解管线生效，可提升为错误。
fn intlit_overflow_warn(e: i64, target: i64) void {
    if (tip_kind(target) != "Scalar") { return; }
    var tname: string = tip_name(target);
    if (tname == "bool") { return; }                  // bool 走独立标量语义，不算有界整数窄化
    if (is_int_name(tname) == false) { return; }
    var lit_id: i64 = e;
    var nn: Node = nodes[e];
    if (nn.kind == "paren") {                         // 透传括号
        var inner: i64 = nn.na;
        nn = nodes[inner];
        lit_id = inner;
    }
    var neg: bool = false;
    if (nn.kind == "unary" && nn.sa == "-") {         // -257 → unary("-", int 257)
        var opid: i64 = nn.na;
        var op: Node = nodes[opid];
        if (op.kind == "int") {
            neg = true;
            nn = op;
            lit_id = opid;
        } else {
            return;                                    // -x 不是字面量，无法静态定界
        }
    }
    if (nn.kind != "int") { return; }
    var v: u64 = lit_u64(nn.sa);
    var bits: i64 = get_bw(tname);
    var is_uns: bool = tname[0] == 117;               // 'u' == 117（不叫 unsigned：C 关键字）
    var lim: u64;
    if (is_uns) {
        lim = u64_pow2(bits);                          // 无符号上界 = 2^bits
    } else {
        lim = u64_pow2(bits - 1);                      // 有符号上界绝对值 = 2^(bits-1)
    }
    var overflow: bool = false;
    if (neg) {
        if (is_uns) {
            overflow = true;                           // 无符号类型不接受任何负值
        } else {
            if (v > lim) { overflow = true; }           // 有符号：|值| 超过下界绝对值
        }
    } else {
        if (v > lim - 1) { overflow = true; }           // 正值：超过上界
    }
    if (overflow) {
        var lit_txt: string = nn.sa;
        if (neg) { lit_txt = sb_cat2("-", nn.sa); }
        var msg: string = sb_cat4("整数字面量 `", lit_txt, "` 超出目标类型 `", tname);
        msg = sb_cat2(msg, "` 的表示范围，将发生静默截断");
        diag_new("T-SEM-W212", "warning", msg,
            n_file(lit_id), n_line(lit_id), n_col(lit_id),
            n_line(lit_id), n_col(lit_id) + (str_len(lit_txt) as i64));
    }
}

// typeToString（递归）
fn ti_str(i: i64) string {
    var t: TI = tis[i];
    if (t.kind == "Scalar") {
        return t.name;
    }
    if (t.kind == "Void") {
        return "void";
    }
    if (t.kind == "String") {
        return "string";
    }
    if (t.kind == "StringBuilder") {
        return "StringBuilder";
    }
    if (t.kind == "Array") {
        return sb_cat4("[", i2s(t.alen), "]", ti_str(t.elem));
    }
    if (t.kind == "Slice") {
        return sb_cat2("[]", ti_str(t.elem));
    }
    if (t.kind == "Map") {
        return sb_cat4("map[", ti_str(t.key), "]", ti_str(t.val));
    }
    if (t.kind == "Sym") {
        return sb_cat5("Sym", i2s(t.bw), "(\"", t.name, "\")");
    }
    if (t.kind == "Pointer") {
        return sb_cat2("*", ti_str(t.elem));
    }
    if (t.kind == "Optional") {
        return sb_cat2("?", ti_str(t.elem));
    }
    if (t.kind == "Variant") {
        return "Variant";
    }
    if (t.kind == "Func") {
        var s: StringBuilder = sb_new();
        sb_append_str(s, "fn(");
        var fj2: i64 = 0;
        while (fj2 < tif_pcount[i]) {
            if (fj2 > 0) { sb_append_str(s, ", "); }
            sb_append_str(s, ti_str(tif_params[tif_pstart[i] + fj2]));
            fj2 = fj2 + 1;
        }
        sb_append_str(s, ") -> ");
        sb_append_str(s, ti_str(tif_ret[i]));
        return sb_to_str(s);
    }
    if (t.kind == "Unknown") {
        return "<unknown>";
    }
    return t.name;
}

// ── 符号表（扁平池 + scope 链）─────────────────────────────────

struct Sym {
    name: string;
    kind: string;   // type/var/func/const
    ti: i64;        // TI 索引
    decl: i64;      // Node 索引（decl），-1 = 无
    scope: i64;
}

var syms: []Sym;
var scope_parents: []i64;

fn scope_new(parent: i64) i64 {
    append(scope_parents, parent);
    return (slice_len(scope_parents) as i64) - 1;
}

// 仅在指定 scope 内查找（不上溯）。返回**最后**一个匹配，使同作用域内后声明的
// 局部变量 shadow 先声明的（主流语言语义：Rust/JS 同块重定义后者生效）。
// 非 var 种类在 sym_define 处已做去重（最多一个），故 last==first，无副作用。
fn sym_find_in(scope: i64, name: string) i64 {
    var n: i64 = slice_len(syms) as i64;
    var i: i64 = n - 1;
    while (i >= 0) {
        var s: Sym = syms[i];
        if (s.scope == scope && s.name == name) {
            return i;
        }
        i = i - 1;
    }
    return -1;
}

// Map.set 语义：var 允许同作用域重定义（shadowing，后声明覆盖先声明）；
// 其余种类（函数 / 类型 / 参数）去重，已存在则忽略（首定义保留）。
fn sym_define(scope: i64, name: string, kind: string, ti2: i64, decl: i64) void {
    // 保留标识符（M51）：stdin/stdout/stderr 在表达式位置恒为内建 fid 常量，
    // 若允许同名声明，引用点仍会解析成常量 → 静默错编。故声明位置直接拒绝。
    if (fid_const_of(name) >= 0) {
        fc_err("T-FID-E650",
            sb_cat3("`", name, "` 是内建文件描述符常量（保留标识符），不可用作变量 / 参数 / 函数 / 类型名；请改用其他名字"),
            decl);
        return;
    }
    if (kind != "var") {
        if (sym_find_in(scope, name) >= 0) {
            return;
        }
    }
    var s: Sym;
    s.name = name;
    s.kind = kind;
    s.ti = ti2;
    s.decl = decl;
    s.scope = scope;
    append(syms, s);
}

// 沿 scope 链上溯查找
fn sym_lookup(scope: i64, name: string) i64 {
    var sc: i64 = scope;
    while (sc >= 0) {
        var f: i64 = sym_find_in(sc, name);
        if (f >= 0) {
            return f;
        }
        sc = scope_parents[sc];
    }
    return -1;
}

var global_scope: i64;
var cur_scope: i64;
var cur_ret: i64;   // 当前函数返回类型（TI 索引）

// ── 诊断定位助手（复刻 tok?.file ?? "" 等）────────────────────




// errorTypeMismatch（复刻 checker.ts:678）
// 间接调用（通过函数类型变量）的实参校验：元数 + 逐位类型
// 调用实参校验（直接调用具名函数 / 经函数类型变量间接调用共用同一份实现）。
// `fname` 为空表示间接调用（无名可报）。
//
// ⚠ 这条校验是内存安全的第一道闸：t 的代码生成对少传的形参**不做任何兜底**，
// 被调方会读到未初始化的栈槽——若那是 string/slice 的 len 字段，就是一个随机
// 天文数字，随后的循环会把 512MB arena 瞬间耗尽（`arena: out of memory`），
// 且现场离真正的错误调用点十万八千里。曾因此排查数小时（tote 的
// `str_concat3(hd, "/.tote/libs")` 少传一参）。宁可误报，绝不放行。
fn check_call_args(e: i64, fti: i64, fname: string) void {
    var n: Node = nodes[e];
    var pstart: i64 = tif_pstart[fti];
    if (pstart < 0) {
        // 签名未记录（如 variant 合成的 Name_from_Case / Name_is_Case 助手：
        // 它们直接 sym_define 了裸 Func tip，没走 register_decl 填 tif_*）。
        // 无签名可比，只能放行——绝不能拿 -1 去索引 tif_params。
        return;
    }
    var want: i64 = tif_pcount[fti];
    var got: i64 = 0;
    var c: i64 = n.la;
    while (c >= 0) {
        var k: Child = kids[c];
        if (got < want) {
            var at: i64 = infer_expr(k.val);
            var pt: i64 = tif_params[pstart + got];
            intlit_overflow_warn(k.val, pt);
            if (tip_kind(at) != "Unknown" && ti_equal(pt, at) == false && can_cast(at, pt) == false) {
                err_type_mismatch(k.val, pt, at);
            }
            // #2/#3：Array→Slice / 空数组字面量→Slice 构造。源是 array_lit 或 Array、目标是
            // Slice 且 can_cast 放行时，包裹 cast 节点让后端构造成 TSlice（零拷贝视图或空切片），
            // 替代原先的静默段错误（can_cast 放行但无实际转换）。
            if (tip_kind(pt) == "Slice" && ti_equal(pt, at) == false && can_cast(at, pt)) {
                var sak: string = nodes[k.val].kind;
                if (sak == "array_lit" || tip_kind(at) == "Array") {
                    var ck2: Child = kids[c];
                    ck2.val = mk_cast(ck2.val, ti_to_type_node(pt), -1);
                    slice_set(kids, c, ck2);
                }
            }
        }
        got = got + 1;
        c = k.next;
    }
    if (got != want) {
        var who: string = "间接调用";
        if (str_len(fname) > 0) { who = sb_cat3("调用 `", fname, "`"); }
        fc_err("T-SEM-E206",
            sb_cat6(who, " 实参个数不符：", ti_str(fti), " 需要 ", i2s(want),
                sb_cat3(" 个实参，实际给了 ", i2s(got), " 个")), e);
    }
}

fn check_indirect_call(e: i64, fti: i64) void {
    check_call_args(e, fti, "");
}

fn err_type_mismatch(eni: i64, exp: i64, act: i64) void {
    var es: string = ti_str(exp);
    var fs2: string = ti_str(act);
    var l: i64 = n_line(eni);
    var c: i64 = n_col(eni);
    var di: i64 = diag_new("T-SEM-E202", "error",
        sb_cat4("type mismatch: expected ", es, " but got ", fs2),
        n_file(eni), l, c, l, c + 5);
    slb_begin();
    slb_add(sb_cat2("expected: ", es));
    slb_add(sb_cat2("found:    ", fs2));
    diag_set_nt(di, slb_head);
}

// ── 整数字面量解析（复刻 BigInt(value) 与 parseInt(value,radix)）──

// BigInt 语义：识别 0x/0X、0b/0B、0o/0O 前缀。
// 实现集中在 base.tc 的 `lit_val_u64`（带 u64 溢出检测），此处只做转发 ——
// 词法/语法/语义三层必须对同一串字面量折算出同一个值。
fn lit_u64(v: string) u64 {
    return lit_val_u64(v);
}

// parseInt(value, radix) 语义：radix=16 接受 0x 前缀；其余按位解析，
// 遇非法字符停止
fn parse_int_len(v: string, radix: i64) i64 {
    var n: u64 = str_len(v);
    var r: i64 = 0;
    if (radix == 16) {
        var i: u64 = 0;
        if (n >= 2 && v[0] == 48 && (v[1] == 120 || v[1] == 88)) {
            i = 2;
        }
        while (i < n) {
            var c: u8 = v[i];
            var d: i64 = -1;
            if (c >= 48 && c <= 57) {
                d = (c - 48) as i64;
            }
            if (c >= 97 && c <= 102) {
                d = (c - 87) as i64;
            }
            if (c >= 65 && c <= 70) {
                d = (c - 55) as i64;
            }
            if (d < 0) {
                return r;
            }
            r = r * 16 + d;
            i = i + 1;
        }
        return r;
    }
    if (radix == 2) {
        var j: u64 = 0;
        while (j < n) {
            var c2: u8 = v[j];
            if (c2 != 48 && c2 != 49) {
                return r;
            }
            r = r * 2 + ((c2 - 48) as i64);
            j = j + 1;
        }
        return r;
    }
    var k: u64 = 0;
    while (k < n) {
        var c3: u8 = v[k];
        if (c3 < 48 || c3 > 57) {
            return r;
        }
        r = r * 10 + ((c3 - 48) as i64);
        k = k + 1;
    }
    return r;
}

// ── 类型解析 resolveType（复刻 checker.ts:134）────────────────

fn resolve_ti(tn: i64) i64 {
    if (tn < 0) {
        return ti_mk("Unknown");
    }
    var n: Node = nodes[tn];
    if (n.kind == "any") {
        return ti_mk("Any");
    }
    if (n.kind == "infer_ret") {
        if (g_infer_ti < 0) { g_infer_ti = ti_mk("Infer"); }
        return g_infer_ti;
    }
    if (n.kind == "type") {
        return ti_mk("Any");
    }
    if (n.kind == "scalar") {
        // 特名优先于 is_scalar_name：bytes / BytesBuilder 虽被 is_scalar_name 命中，
        // 但须解析为独立的 Bytes / StringBuilder 种类（而非笼统 Scalar），否则与
        // bsb_* 内建返回类型永远对不上。string / StringBuilder 亦在此显式分流。
        if (n.sa == "void") {
            return ti_mk("Void");
        }
        if (n.sa == "string") {
            return ti_mk("String");
        }
        if (n.sa == "StringBuilder") {
            return ti_mk("StringBuilder");
        }
        if (n.sa == "bytes") {
            return ti_mk("Bytes");
        }
        if (n.sa == "BytesBuilder") {
            return ti_mk("StringBuilder");
        }
        if (is_scalar_name(n.sa)) {
            return ti_scalar(n.sa);
        }
        return ti_named("Named", n.sa);
    }
    if (n.kind == "array") {
        var elem: i64 = resolve_ti(n.na);
        var length: i64 = 0;
        if (n.nb >= 0) {
            var le: Node = nodes[n.nb];
            if (le.kind == "int") {
                length = parse_int_len(le.sa, le.ia);
            }
        }
        var ai: i64 = ti_elem_of("Array", elem);
        var at: TI = tis[ai];
        at.alen = length;
        slice_set(tis, ai, at);
        return ai;
    }
// >>> GEN:type_slice (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
    if (n.kind == "slice") {
        return ti_elem_of("Slice", resolve_ti(n.na));
    }
// <<< GEN:type_slice <<<
    if (n.kind == "map") {
        var kt: i64 = resolve_ti(n.na);
        var vt: i64 = resolve_ti(n.nb);
        var mi: i64 = ti_mk("Map");
        var mt: TI = tis[mi];
        mt.key = kt;
        mt.val = vt;
        slice_set(tis, mi, mt);
        return mi;
    }
    if (n.kind == "sym") {
        var syi: i64 = ti_named("Sym", n.sa);
        var syt: TI = tis[syi];
        syt.bw = n.ia;
        slice_set(tis, syi, syt);
        return syi;
    }
    if (n.kind == "named") {
        if (n.sa == "TypeInfo") { return ti_mk("TypeInfo"); }
        if (n.sa == "FieldInfo") { return ti_mk("FieldInfo"); }
        var si: i64 = sym_lookup(global_scope, n.sa);
        if (si < 0) { si = sym_lookup(cur_scope, n.sa); }
        if (si >= 0) {
            var s: Sym = syms[si];
            return s.ti;
        }
        // 裸 `Sym` = 默认 32 位池的一级符号句柄（docs/meta_design.md §8）。
        // 刻意放在用户查找**之后**：谁自己声明了 `Sym` 类型谁说了算（tc.tc 自身就有）。
        if (n.sa == "Sym") {
            var syd: i64 = ti_named("Sym", "");
            var syt2: TI = tis[syd];
            syt2.bw = 32;
            slice_set(tis, syd, syt2);
            return syd;
        }
        // 未定义命名类型：报错（不再静默 Named）。meta 类型参数实例化期已被替换为
        // 具体类型，若仍以 named 形态到达此处，排除 meta 环境已绑定的名字。
        if (menv_find(n.sa) >= 0) { return ti_named("Named", n.sa); }
        if (gen_tparam_has(n.sa)) { return ti_named("Named", n.sa); }
        fc_err("T-SEM-E200", sb_cat3("未定义类型 `", n.sa, "`"), tn);
        return ti_mk("Unknown");
    }
// >>> GEN:type_resolve (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
    if (n.kind == "variant") {
        return ti_mk("Variant");
    }
    if (n.kind == "flag") {
        return ti_with_und("Flag", "<anonymous>", n.sa);
    }
    if (n.kind == "flag_set") {
        return ti_named("FlagSet", "<anonymous>");
    }
    if (n.kind == "pointer") {
        return ti_elem_of("Pointer", resolve_ti(n.na));
    }
    if (n.kind == "optional") {
        return ti_elem_of("Optional", resolve_ti(n.na));
    }
// <<< GEN:type_resolve <<<
    if (n.kind == "func_type") {
        // 先把参数类型解析到局部表，再整段搬进 tif_params——
        // 嵌套函数类型会在递归里自行 append，直接边解析边 append 会打断本层参数区的连续性。
        var fret: i64 = resolve_ti(n.na);
        var fbuf: []i64;
        var fk: i64 = n.la;
        while (fk >= 0) {
            var fc: Child = kids[fk];
            append(fbuf, resolve_ti(fc.val));
            fk = fc.next;
        }
        var fpstart: i64 = slice_len(tif_params) as i64;
        var fpc: i64 = slice_len(fbuf) as i64;
        var fj0: i64 = 0;
        while (fj0 < fpc) {
            append(tif_params, fbuf[fj0]);
            fj0 = fj0 + 1;
        }
        return ti_func(fret, fpstart, fpc);
    }
    return ti_mk("Unknown");
}

// TI → 类型节点（resolve_ti 的反函数）。用于局部类型推断后回填 var_decl.n.na，
// 使发射侧 emit_ctype(n.na) 拿到真实类型。仅覆盖推断常见类型；其余退化为 named 节点
// （resolve_ti 仍能查回），足够 v1 推断使用。
fn mk_type_node_from_ti(ti: i64) i64 {
    if (ti < 0) { return -1; }
    var t: TI = tis[ti];
    var k: string = t.kind;
    if (k == "Scalar") { return mk_scalar(t.name, -1); }
    if (k == "Void") { return mk_scalar("void", -1); }
    if (k == "String") { return mk_scalar("string", -1); }
    if (k == "StringBuilder") { return mk_scalar("StringBuilder", -1); }
    if (k == "Bytes") { return mk_scalar("bytes", -1); }
    if (k == "Named") { return mk_named(t.name, -1); }
    if (k == "Slice") { return mk_slice(mk_type_node_from_ti(t.elem), -1); }
    // ⚠ 曾漏掉 Array 分支：定长数组落到末尾兜底的 mk_named(k) → 合成出类型节点
    // `Array`，resolve 时报 T-SEM-E200「未定义类型 `Array`」。管道降解
    // （pipe_flush 用本函数回填辅助函数形参）对 `[N]T` 左操作数因此全线不可用，
    // 违背 §3.15.2 规则 4。array 类型节点 = mk_array(元素类型节点, 长度 int 节点)。
    if (k == "Array") {
        return mk_array(mk_type_node_from_ti(t.elem), mk_int(i2s(t.alen), 10, -1), -1);
    }
    if (k == "Pointer") { return mk_pointer(mk_type_node_from_ti(t.elem), -1); }
    if (k == "Optional") { return mk_optional(mk_type_node_from_ti(t.elem), -1); }
    if (k == "Map") { return mk_map(mk_type_node_from_ti(t.key), mk_type_node_from_ti(t.val), -1); }
    if (k == "Func") {
        var fret: i64 = mk_type_node_from_ti(tif_ret[ti]);
        var ph: i64 = -1;
        var pt: i64 = -1;
        var pstart: i64 = tif_pstart[ti];
        var pc: i64 = tif_pcount[ti];
        var jj: i64 = 0;
        while (jj < pc) {
            // ⚠ func_type.la 是**裸类型节点**链，不是 P 节点链（见 parse_type 的
            // KwFunc 分支、resolve_ti / resolve_type_desc 的 func_type 分支）。
            // 早先这里错包了一层 mk_P，导致回填出的函数类型形参一律解析成 <unknown>。
            pt = list_push(ph, pt, mk_type_node_from_ti(tif_params[pstart + jj]));
            if (ph < 0) { ph = pt; }
            jj = jj + 1;
        }
        return mk_func_type(fret, ph, -1);
    }
    // Flag / FlagSet / Enum / Union / Variant / Sym / TypeInfo / FieldInfo / Unknown：
    // 退化为 named 节点，resolve_ti 仍能查回（推断分支少见）。
    var nm: string = t.name;
    if (nm == "") { nm = k; }
    return mk_named(nm, -1);
}

// ═══════════════════════════════════════════════════════════
// comptime 类型模板参数 `any`（Zig 式 anytype / 编译期泛型）：
//   foo fn(comptime T: any) T { ... }      // T 在编译期承载「任意类型」
//   foo(i64)                               // 调用点按实参类型单态化
// 调用点检测 → 深克隆 FuncDecl → 类型替换（T → 具体类型）→ 去掉 comptime
// 参数 → 改名 foo__i64 → 追加 decl_list 参与检查/发射。整个机制仅对「含
// comptime 参数」的函数触发（func_is_generic 门控），普通函数零影响。
// ═══════════════════════════════════════════════════════════

fn func_is_generic(d: i64) bool {
    var n: Node = nodes[d];
    if (n.kind != "FuncDecl") { return false; }
    var p: i64 = n.lb;
    while (p >= 0) {
        if (nodes[kids[p].val].bb == true) { return true; }
        p = kids[p].next;
    }
    return false;
}

// 从类型名标识符造类型节点（复用 parse_type 的标识符分支语义）
fn type_node_from_ident(name: string) i64 {
    if (is_scalar_name(name)) { return mk_scalar(name, -1); }
    if (name == "void") { return mk_scalar("void", -1); }
    if (name == "string") { return mk_scalar("string", -1); }
    if (name == "StringBuilder") { return mk_scalar("StringBuilder", -1); }
    return mk_named(name, -1);
}

// 名字是否为已声明的类型（struct/enum/flag/variant/typealias 等；标量由 is_scalar_name 覆盖）。
// check 阶段以全局符号表中 kind == "type" 为权威判据（与 resolve_ti 同款逻辑）。
fn is_type_name(name: string) bool {
    if (is_scalar_name(name)) { return true; }
    var si: i64 = sym_lookup(global_scope, name);
    if (si < 0) { return false; }
    return syms[si].kind == "type";
}

fn clone_kids(src: i64) i64 {
    if (src < 0) { return -1; }
    var h: i64 = -1;
    var t: i64 = -1;
    var c: i64 = src;
    while (c >= 0) {
        var cv: i64 = clone_node(kids[c].val);
        t = list_push(h, t, cv);
        if (h < 0) { h = t; }
        c = kids[c].next;
    }
    return h;
}

fn clone_node(src: i64) i64 {
    if (src < 0) { return -1; }
    var sn: Node = nodes[src];
    var id: i64 = node_new(sn.kind);
    var nn: Node = nodes[id];
    nn.sa = sn.sa; nn.sb = sn.sb; nn.sc = sn.sc;
    nn.has_sa = sn.has_sa; nn.has_sb = sn.has_sb; nn.has_sc = sn.has_sc;
    nn.ia = sn.ia; nn.ib = sn.ib;
    nn.ba = sn.ba; nn.bb = sn.bb; nn.bc = sn.bc; nn.bd = sn.bd;
    nn.na = clone_node(sn.na);
    nn.nb = clone_node(sn.nb);
    nn.nc = clone_node(sn.nc);
    nn.nd = clone_node(sn.nd);
    nn.la = clone_kids(sn.la);
    nn.lb = clone_kids(sn.lb);
    nn.lc = clone_kids(sn.lc);
    nn.ln = sn.ln; nn.cl = sn.cl; nn.tv = sn.tv;
    slice_set(nodes, id, nn);
    return id;
}

// 把子树里所有 `named{sa == name}` 类型节点替换为 concrete 的深克隆
fn subst_type_in_kids(src: i64, name: string, concrete: i64) i64 {
    if (src < 0) { return -1; }
    var h: i64 = -1;
    var t: i64 = -1;
    var c: i64 = src;
    while (c >= 0) {
        var nv: i64 = subst_type_in_node(kids[c].val, name, concrete);
        t = list_push(h, t, nv);
        if (h < 0) { h = t; }
        c = kids[c].next;
    }
    return h;
}

fn subst_type_in_node(nd_id: i64, name: string, concrete: i64) i64 {
    if (nd_id < 0) { return -1; }
    var n: Node = nodes[nd_id];
    if (n.kind == "named" && n.sa == name) {
        return clone_node(concrete);
    }
    if (n.na >= 0) { n.na = subst_type_in_node(n.na, name, concrete); }
    if (n.nb >= 0) { n.nb = subst_type_in_node(n.nb, name, concrete); }
    if (n.nc >= 0) { n.nc = subst_type_in_node(n.nc, name, concrete); }
    if (n.nd >= 0) { n.nd = subst_type_in_node(n.nd, name, concrete); }
    if (n.la >= 0) { n.la = subst_type_in_kids(n.la, name, concrete); }
    if (n.lb >= 0) { n.lb = subst_type_in_kids(n.lb, name, concrete); }
    if (n.lc >= 0) { n.lc = subst_type_in_kids(n.lc, name, concrete); }
    slice_set(nodes, nd_id, n);
    return nd_id;
}

// ══════════════════════════════════════════════════════════════
// M-meta Phase C：值参数单态化
// comptime 形参按**声明类型**分流：
//   `meta T: type` / `comptime T: any` → 类型参数（Phase A 路径，实参须是类型名）
//   `meta N: i64` / `meta S: string`   → 值参数：实参在调用点 CTFE 求值成字面量，
//                                        既进单态化键，也整体代入实例体与类型位。
// 为什么代入字面量而不是在实例体首插一条 const：`[N]T` 的长度位要求 kind == "int"
// 的字面量节点（见 resolve_ti 的 array 分支），常量名过不去那一关。
// ══════════════════════════════════════════════════════════════
fn meta_param_is_type(p: i64) bool {
    var pn: Node = nodes[p];
    if (pn.na < 0) { return true; }          // 无标注：保守当类型参数
    var tn: Node = nodes[pn.na];
    if (tn.kind == "any") { return true; }
    if (tn.kind == "type") { return true; }
    return false;
}

// 把子树里所有 `ident{sa == name}` **表达式**节点替换为字面量深克隆。
// 类型位置的 `named{sa == name}` 归 subst_type_in_node 管，两者互不干扰。
fn meta_subst_val_kids(src: i64, name: string, lit: i64) i64 {
    if (src < 0) { return -1; }
    var h: i64 = -1;
    var t: i64 = -1;
    var c: i64 = src;
    while (c >= 0) {
        var nv: i64 = meta_subst_val_node(kids[c].val, name, lit);
        t = list_push(h, t, nv);
        if (h < 0) { h = t; }
        c = kids[c].next;
    }
    return h;
}

fn meta_subst_val_node(nd_id: i64, name: string, lit: i64) i64 {
    if (nd_id < 0) { return -1; }
    var n: Node = nodes[nd_id];
    if (n.kind == "ident" && n.sa == name) {
        return clone_node(lit);
    }
    if (n.na >= 0) { n.na = meta_subst_val_node(n.na, name, lit); }
    if (n.nb >= 0) { n.nb = meta_subst_val_node(n.nb, name, lit); }
    if (n.nc >= 0) { n.nc = meta_subst_val_node(n.nc, name, lit); }
    if (n.nd >= 0) { n.nd = meta_subst_val_node(n.nd, name, lit); }
    if (n.la >= 0) { n.la = meta_subst_val_kids(n.la, name, lit); }
    if (n.lb >= 0) { n.lb = meta_subst_val_kids(n.lb, name, lit); }
    if (n.lc >= 0) { n.lc = meta_subst_val_kids(n.lc, name, lit); }
    slice_set(nodes, nd_id, n);
    return nd_id;
}

// 类型参数单态化：除 named{U}（类型位置）外，还要替换表达式位置里的 ident{U}
// （如把类型当作 comptime 实参传递：`map_id(U, x)` 里的 U）。模板本体里这种引用在
// 检查期不可解（U 未绑定），须随实例一并代换成具体类型，否则嵌套泛型再单态化时读到
// 未绑定 U → T-SEM-E200。仅用于 instantiate_generic 的实例体（comptime 形参已被剥离，
// 残余 ident{U} 必是待代换的形参引用，无歧义）。
fn subst_type_ident_kids(src: i64, name: string, concrete: i64) i64 {
    if (src < 0) { return -1; }
    var h: i64 = -1;
    var t: i64 = -1;
    var c: i64 = src;
    while (c >= 0) {
        var nv: i64 = subst_type_ident_node(kids[c].val, name, concrete);
        t = list_push(h, t, nv);
        if (h < 0) { h = t; }
        c = kids[c].next;
    }
    return h;
}

fn subst_type_ident_node(nd_id: i64, name: string, concrete: i64) i64 {
    if (nd_id < 0) { return -1; }
    var n: Node = nodes[nd_id];
    if ((n.kind == "named" || n.kind == "ident") && n.sa == name) {
        return clone_node(concrete);
    }
    if (n.na >= 0) { n.na = subst_type_ident_node(n.na, name, concrete); }
    if (n.nb >= 0) { n.nb = subst_type_ident_node(n.nb, name, concrete); }
    if (n.nc >= 0) { n.nc = subst_type_ident_node(n.nc, name, concrete); }
    if (n.nd >= 0) { n.nd = subst_type_ident_node(n.nd, name, concrete); }
    if (n.la >= 0) { n.la = subst_type_ident_kids(n.la, name, concrete); }
    if (n.lb >= 0) { n.lb = subst_type_ident_kids(n.lb, name, concrete); }
    if (n.lc >= 0) { n.lc = subst_type_ident_kids(n.lc, name, concrete); }
    slice_set(nodes, nd_id, n);
    return nd_id;
}

// 字面量 → 标识符安全的单态化键片段。
// 字符串走「长度 + 前 12 个可读字符 + FNV-1a(32)」：可读且不撞
// —— 只做字符净化的话 `"a-b"` 与 `"a_b"` 会塌成同一个实例。
fn meta_val_key(lit: i64) string {
    var n: Node = nodes[lit];
    if (n.kind == "bool") {
        if (n.ba) { return "true"; }
        return "false";
    }
    if (n.kind == "int") {
        var v: i64 = js_parse_int(n.sa, n.ia);
        if (v < 0) { return sb_cat2("n", i2s(0 - v)); }
        return i2s(v);
    }
    var s: string = n.sa;
    var ln: i64 = str_len(s) as i64;
    var h: i64 = 2166136261;
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "s");
    sb_append_str(sb, i2s(ln));
    sb_append_str(sb, "_");
    var i: i64 = 0;
    while (i < ln) {
        var c: i64 = str_at(s, i) as i64;
        h = (h ^ c);
        h = (h * 16777619) & 4294967295;
        if (i < 12) {
            var ok: bool = false;
            if (c >= 48 && c <= 57) { ok = true; }
            if (c >= 65 && c <= 90) { ok = true; }
            if (c >= 97 && c <= 122) { ok = true; }
            if (ok) { sb_append_str(sb, str_slice(s, i, i + 1)); }
            else { sb_append_str(sb, "_"); }
        }
        i = i + 1;
    }
    sb_append_str(sb, "_");
    sb_append_str(sb, i2s(h));
    return sb_to_str(sb);
}

// 值实参：CTFE 求值 + 按形参声明类型校验。返回字面量节点 id，失败 -1（已报错）。
fn meta_eval_value_arg(p: i64, a: i64) i64 {
    var pn: Node = nodes[p];
    var tn: Node = nodes[pn.na];
    // 先卡**声明类型**再求值：否则 `meta X: f64` 会先被求值器以 T_META_NOT_CONST
    // 拒掉，诊断指向实参而非那个根本不该存在的形参类型，误导排查方向。
    var tname: string = tn.sa;
    var tok: bool = false;
    if (tn.kind == "scalar") {
        if (tname == "string" || tname == "bool") { tok = true; }
        if (meta_is_int_type(tname)) { tok = true; }
    }
    if (tok == false) {
        fc_err("T-MTA-E600",
            sb_cat3("meta 值参数 `", pn.sa, "` 的类型暂不支持：仅整数族 / bool / string"), a);
        return -1;
    }
    // 借全局编译期常量区求值；调用方的求值状态原样保存恢复。
    var sv_top: i64 = g_menv_top;
    var sv_base: i64 = g_menv_base;
    var sv_quiet: bool = g_meta_quiet;
    g_menv_top = g_menv_nglobal;
    g_menv_base = g_menv_nglobal;
    g_meta_quiet = false;
    g_meta_err = false;
    if (g_meta_steps < 200000) { g_meta_steps = 200000; }
    var lit: i64 = meta_eval(a);
    g_menv_top = sv_top;
    g_menv_base = sv_base;
    g_meta_quiet = sv_quiet;
    g_meta_err = false;
    if (lit < 0) { return -1; }
    var lk: string = nodes[lit].kind;
    if (tname == "string") {
        if (lk != "string") {
            fc_err("T-MTA-E601",
                sb_cat3("meta 值参数 `", pn.sa, "` 需要字符串字面量"), a);
            return -1;
        }
        return lit;
    }
    if (tname == "bool") {
        if (lk != "bool") {
            fc_err("T-MTA-E601",
                sb_cat3("meta 值参数 `", pn.sa, "` 需要 bool（不做隐式转换）"), a);
            return -1;
        }
        return lit;
    }
    if (meta_is_int_type(tname)) {
        if (lk != "int") {
            fc_err("T-MTA-E601",
                sb_cat4("meta 值参数 `", pn.sa, "` 需要整数，收到 ", lk), a);
            return -1;
        }
        var v2: i64 = js_parse_int(nodes[lit].sa, nodes[lit].ia);
        if (meta_int_wrap(v2, tname) != v2) {
            fc_err("T-MTA-E602",
                sb_cat4("meta 值参数 `", pn.sa, "` 超出 ", tname), a);
            return -1;
        }
        return lit;
    }
    fc_err("T-MTA-E600",
        sb_cat3("meta 值参数 `", pn.sa, "` 的类型暂不支持：仅整数族 / bool / string"), a);
    return -1;
}

// 改写调用点：callee → 实例名，移除前 k 个 comptime 实参，打上防重入标记。
// 新建实例与命中缓存两条路径都必须走这里 —— 少一次 `bb = true` 就会让
// infer_expr 反复重入 instantiate_generic。
fn rewrite_generic_callsite(e: i64, iname: string, k: i64) void {
    var cal: Node = nodes[nodes[e].na];
    cal.sa = iname;
    slice_set(nodes, nodes[e].na, cal);
    var nh: i64 = -1;
    var nt: i64 = -1;
    var ac2: i64 = nodes[e].la;
    var skip: i64 = 0;
    while (ac2 >= 0) {
        if (skip < k) { skip = skip + 1; }
        else {
            nt = list_push(nh, nt, kids[ac2].val);
            if (nh < 0) { nh = nt; }
        }
        ac2 = kids[ac2].next;
    }
    var en: Node = nodes[e];
    en.la = nh;
    en.bb = true;
    slice_set(nodes, e, en);
}

// 单态化：返回实例 FuncDecl id（已 append decl_list + register）。
// 把泛型实例名里的 LLVM/C 非法符号字符（[] * ? < > ( ) , 等）替换成安全字符，
// 使实例既作缓存 key 又作符号名时都是合法标识符。仅影响符号拼写，不影响语义；
// 与 mb_type_key（@type_name 的可读输出）解耦 —— 后者保持 `[]i64` 原样。
fn sanitize_sym(s: string) string {
    var n: u64 = str_len(s);
    var sb: StringBuilder = sb_new();
    var i: u64 = 0;
    while (i < n) {
        var c: u8 = s[i];
        if ((c >= 65 && c <= 90) || (c >= 97 && c <= 122) ||
            (c >= 48 && c <= 57) || c == 95) {
            sb_append_char(sb, c);
        } else if (c == 91) { sb_append_char(sb, 76); }   // '[' -> 'L'
        else if (c == 93) { sb_append_char(sb, 82); }    // ']' -> 'R'
        else if (c == 42) { sb_append_char(sb, 80); }    // '*' -> 'P'
        else if (c == 63) { sb_append_char(sb, 79); }    // '?' -> 'O'
        else if (c == 60) { sb_append_char(sb, 76); }    // '<' -> 'L'
        else if (c == 62) { sb_append_char(sb, 71); }    // '>' -> 'G'
        else if (c == 40) { sb_append_char(sb, 80); }    // '(' -> 'P'
        else if (c == 41) { sb_append_char(sb, 81); }    // ')' -> 'Q'
        else if (c == 44) { sb_append_char(sb, 67); }    // ',' -> 'C'
        else { sb_append_char(sb, 95); }                 // 其余 -> '_'
        i = i + 1;
    }
    return sb_to_str(sb);
}

fn instantiate_generic(tmpl: i64, e: i64) i64 {
    var tn: Node = nodes[tmpl];
    // 收集 comptime 形参（按参数顺序）：名字 / 形参节点 / 是否类型参数
    var cnames: []string;
    var cnodes: []i64;
    var cistype: []bool;
    var cp: i64 = tn.lb;
    while (cp >= 0) {
        var cpv: i64 = kids[cp].val;
        var cpn: Node = nodes[cpv];
        if (cpn.bb == true) {
            append(cnames, cpn.sa);
            append(cnodes, cpv);
            append(cistype, meta_param_is_type(cpv));
        }
        cp = kids[cp].next;
    }
    var k: i64 = slice_len(cnames) as i64;
    // 从调用点读取前 k 个实参
    var cargs: []i64;
    var ac0: i64 = nodes[e].la;
    var i: i64 = 0;
    while (ac0 >= 0 && i < k) {
        append(cargs, kids[ac0].val);
        i = i + 1;
        ac0 = kids[ac0].next;
    }
    if (i != k) { return -1; }
    // 构造单态化签名 + 具体量列表（类型参数 → 类型节点；值参数 → 字面量节点）
    var sig: string = "";
    var concretes: []i64;
    var j: i64 = 0;
    while (j < k) {
        var cv2: i64 = -1;
        var keyp: string = "";
        if (cistype[j]) {
            var an: Node = nodes[cargs[j]];
            // P0-2：嵌套泛型再单态化时，comptime 类型实参已是具体类型节点
            // （由 subst_type_ident 把表达式位置的 ident{U} 代换成具体类型节点）。
            // 直接采用，勿走 meta_eval（类型节点不可作常量求值）。
            if (an.kind == "named" || an.kind == "scalar" || an.kind == "slice"
                    || an.kind == "array" || an.kind == "pointer" || an.kind == "optional") {
                cv2 = cargs[j];
                keyp = mb_type_key(cargs[j], 0);
                if (keyp == "") {
                    fc_err("T-MTA-E603",
                        "编译期类型表达式求值结果无法规约为类型名", cargs[j]);
                    return -1;
                }
            } else if (an.kind == "ident") {
                cv2 = type_node_from_ident(an.sa);
                keyp = an.sa;
            } else {
                // P4 类型即值：允许「编译期可求值为类型节点」的表达式作为类型实参
                // （@type_val("i64")、comptime fn 返回的 type 等）。keyp 取规范类型名，
                // 与字面量类型名路径共用同一单态实例，避免重复生成。
                if (g_meta_steps < 200000) { g_meta_steps = 200000; }
                g_meta_err = false;
                var tv: i64 = meta_eval(cargs[j]);
                if (tv < 0 || g_meta_err) {
                    fc_err("T-MTA-E603",
                        "comptime 类型参数必须是类型名或编译期可求值的类型表达式", cargs[j]);
                    return -1;
                }
                cv2 = tv;
                keyp = mb_type_key(tv, 0);
                if (keyp == "") {
                    fc_err("T-MTA-E603",
                        "编译期类型表达式求值结果无法规约为类型名", cargs[j]);
                    return -1;
                }
            }
        } else {
            cv2 = meta_eval_value_arg(cnodes[j], cargs[j]);
            if (cv2 < 0) { return -1; }
            keyp = meta_val_key(cv2);
        }
        append(concretes, cv2);
        if (j > 0) { sig = sb_cat2(sig, "_"); }
        sig = sb_cat2(sig, keyp);
        j = j + 1;
    }
    // 实例 key：templ_name + __ + sig；去重。sig 可能含 [] * ? 等非法符号字符，
    // 先 sanitize 成合法标识符（同时用作缓存 key 与后端符号名）。
    var iname: string = sanitize_sym(sb_cat3(tn.sa, "__", sig));
    var si0: i64 = sym_lookup(global_scope, iname);
    if (si0 >= 0) {
        // ⚠ 命中缓存也**必须**改写调用点。Phase A 这里直接 return，callee 仍是模板名、
        // comptime 实参也还在 → 回到 infer_expr 后 `nodes[e].bb == false` 依旧成立，
        // 于是再次 instantiate → 再次命中 → 无限递归，编译器直接崩（exit 127）。
        // Phase A 的示例每个泛型每种实参只调一次，恰好绕过了这条路径。
        rewrite_generic_callsite(e, iname, k);
        return syms[si0].decl;
    }
    // 深克隆模板
    var inst: i64 = clone_node(tmpl);
    var inn: Node = nodes[inst];
    inn.sa = iname;
    // 逐对替换 comptime 参数名 → 具体量（返回类型 + 函数体 + 各参数类型）。
    // ⚠ FuncDecl.lc 是**语句链表头**（kids 下标），不是节点 id —— 必须走 *_kids
    // 版本。Phase A 这里误传给了 subst_type_in_node：既漏替换体内类型位，又会去
    // 改写一棵与该下标同号的无关节点子树。症状是实例体里 `var z: T;` 保持
    // `named{T}` → 退化成 i64 alloca，而返回类型已是具体类型 → clang 报
    // "defined with type 'i64' but expected 'double'"。
    var m: i64 = 0;
    while (m < k) {
        var cnm: string = cnames[m];
        var conc: i64 = concretes[m];
        if (cistype[m]) {
            inn.na = subst_type_in_node(inn.na, cnm, conc);
            inn.lc = subst_type_in_kids(inn.lc, cnm, conc);
            // 表达式位置里的 ident{U}（把类型当 comptime 实参传递）→ 具体类型节点
            inn.lc = subst_type_ident_kids(inn.lc, cnm, conc);
        } else {
            inn.na = meta_subst_val_node(inn.na, cnm, conc);
            inn.lc = meta_subst_val_kids(inn.lc, cnm, conc);
        }
        var pp2: i64 = inn.lb;
        while (pp2 >= 0) {
            var ppn: Node = nodes[kids[pp2].val];
            if (cistype[m]) { ppn.na = subst_type_in_node(ppn.na, cnm, conc); }
            else { ppn.na = meta_subst_val_node(ppn.na, cnm, conc); }
            slice_set(nodes, kids[pp2].val, ppn);
            pp2 = kids[pp2].next;
        }
        m = m + 1;
    }
    // 去掉 comptime 参数，保留其余（已替换类型的）参数
    var newp_head: i64 = -1;
    var newp_tail: i64 = -1;
    var pp3: i64 = inn.lb;
    while (pp3 >= 0) {
        var ppn2: Node = nodes[kids[pp3].val];
        if (ppn2.bb == false) {
            newp_tail = list_push(newp_head, newp_tail, kids[pp3].val);
            if (newp_head < 0) { newp_head = newp_tail; }
        }
        pp3 = kids[pp3].next;
    }
    inn.lb = newp_head;
    slice_set(nodes, inst, inn);
    rewrite_generic_callsite(e, iname, k);
    // 注册实例 + 追加 decl_list（check/emit 循环会重取长度，自动覆盖）
    append(decl_list, inst);
    register_decl(inst);
    // 实例体内的 `meta` 折叠：meta_pass 早已跑完（它在 check 之前），而实例是
    // check 期才生成的，不补这一刀的话模板里的 `meta` 表达式会一路漏成运行期代码。
    // 此刻值参数已代入具体字面量，折叠能拿到真值。
    var sq: bool = g_meta_quiet;
    var st2: i64 = g_menv_top;
    var sb2: i64 = g_menv_base;
    g_meta_quiet = false;
    g_meta_err = false;
    g_menv_top = g_menv_nglobal;
    g_menv_base = g_menv_nglobal;
    if (g_meta_steps < 200000) { g_meta_steps = 200000; }
    // Phase D：类型参数此刻已代换成具体类型，`@type_*` 现在能折了（mb_pass 时还不能），
    // 且 `if (@type_equal(T, u32))` 的死分支要在 check 看到之前剪掉。必须早于 meta_walk。
    mb_walk_list(nodes[inst].lc);
    meta_walk_list(nodes[inst].lc);
    g_meta_quiet = sq;
    g_meta_err = false;
    g_menv_top = st2;
    g_menv_base = sb2;
    // 实例体补齐检查（P0-2 + P0-3）：此刻 comptime 形参已代换成具体类型，故在 body 上
    // 重跑 check_func_decl（= 走 infer_expr）即可同时完成——
    //   · 嵌套泛型调用点的再单态化（infer_expr @ line 4590，bb 守卫保证幂等）；
    //   · 体内 format / !j 脱糖（infer_expr @ line 4619）。
    // 必须落在实例化这一步（而非 run_check 主循环之后），因为实例是在主检查循环长度冻结后
    // 才追加的，代码生成的预处理在 run_check 结束后才跑——落在实例化里保证脱糖结果进入
    // 同一趟检查/发射视图，不再出现「脱糖了却没进 IR」的滞后。
    // 实例是 FuncDecl 且非泛型（comptime 形参已剥离），check_func_decl 安全幂等；其体内
    // 的嵌套泛型再单态化会递归触发 instantiate_generic → 同样回到这里自检，直至不动点。
    if (nodes[inst].lc != -2) {
        check_func_decl(inst);
    }
    return inst;
}

// ── P0-2 + P0-3：实例体补齐检查的落点 ──────────────────────────
// 实例体的补齐检查（嵌套泛型再单态化 + 体内 format/!j 脱糖）落在 `instantiate_generic`
// 末尾：克隆+代换后即重跑 check_func_decl（见该函数末尾注释）。理由是该步处于主检查循环
// 之内、代码生成预处理之前，脱糖结果能进入同一趟发射视图——这也是非泛型函数体被脱糖的
// 同一时机。故这里不再保留独立的 fixpoint。

// ── 声明注册 registerDecl（复刻 checker.ts:97）────────────────

// >>> GEN:type_declreg (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
fn register_decl(d: i64) void {
    var n: Node = nodes[d];
    if (n.kind == "StructDecl") {
        sym_define(global_scope, n.sa, "type", ti_named("Struct", n.sa), d);
        return;
    }
    if (n.kind == "EnumDecl") {
        sym_define(global_scope, n.sa, "type", ti_with_und("Enum", n.sa, n.sb), d);
        return;
    }
    if (n.kind == "FlagDecl") {
        sym_define(global_scope, n.sa, "type", ti_with_und("Flag", n.sa, n.sb), d);
        return;
    }
    if (n.kind == "FlagSetDecl") {
        sym_define(global_scope, n.sa, "type", ti_named("FlagSet", n.sa), d);
        return;
    }
    if (n.kind == "UnionDecl") {
        sym_define(global_scope, n.sa, "type", ti_named("Union", n.sa), d);
        return;
    }
    if (n.kind == "VariantDecl") {
        sym_define(global_scope, n.sa, "type", ti_named("Variant", n.sa), d);
        register_variant_helpers(d);
        return;
    }
    if (n.kind == "FuncDecl") {
        var fti: i64 = ti_named("Func", n.sa);
        // 泛型模板：把 comptime/meta 类型参数名临时登记，供下方 resolve_ti 识别为
        // 「类型参数」而非未定义类型（模板本体定义期不展开，T 尚未绑定到具体类型）。
        // 普通函数 / 实例（T 已替换为具体类型）不受影响。结束后还原，避免跨函数泄漏。
        var saved_gt: []string = g_gen_tparams;
        if (func_is_generic(d)) {
            var gt: []string;
            var gp: i64 = n.lb;
            while (gp >= 0) {
                var gpn: i64 = kids[gp].val;
                if (nodes[gpn].bb == true && meta_param_is_type(gpn)) {
                    append(gt, nodes[gpn].sa);
                }
                gp = kids[gp].next;
            }
            g_gen_tparams = gt;
        }
        // 记录具名函数的真实签名，供「函数作为值」可赋值性 / 间接调用使用
        var fret2: i64 = resolve_ti(n.na);
        var fbuf2: []i64;
        var fp: i64 = n.lb;
        while (fp >= 0) {
            var fpid: i64 = kids[fp].val;
            var fpn: Node = nodes[fpid];
            append(fbuf2, resolve_ti(fpn.na));
            fp = kids[fp].next;
        }
        g_gen_tparams = saved_gt;
        var fpstart2: i64 = slice_len(tif_params) as i64;
        var fpc2: i64 = slice_len(fbuf2) as i64;
        var fj1: i64 = 0;
        while (fj1 < fpc2) {
            append(tif_params, fbuf2[fj1]);
            fj1 = fj1 + 1;
        }
        tif_ret[fti] = fret2;
        tif_pstart[fti] = fpstart2;
        tif_pcount[fti] = fpc2;
        sym_define(global_scope, n.sa, "func", fti, d);
        return;
    }
    if (n.kind == "GlobalVarDecl") {
        sym_define(global_scope, n.sa, "var", resolve_ti(n.na), d);
        return;
    }
    if (n.kind == "GlobalConstDecl") {
        var cti: i64 = -1;
        if (n.na >= 0) {
            cti = resolve_ti(n.na);
        } else {
            cti = ti_mk("Unknown");
        }
        sym_define(global_scope, n.sa, "const", cti, d);
        return;
    }
    if (n.kind == "TypeAliasDecl") {
        sym_define(global_scope, n.sa, "type", resolve_ti(n.na), d);
        return;
    }
}
// <<< GEN:type_declreg <<<

// 递归 variant 守卫：载荷以**值形态**自引用 ⇒ 类型大小无限，双后端都会发射非法 C/IR。
// 指针形态 `*Self` 合法（前向引用按名字解析）；切片 `[]Self` / map 也合法（都是间接）。
// 只有裸 `Self` 与定长数组 `[N]Self` 是真正的值形态自引用 —— 显式报错，绝不静默错编（L-09）。
fn variant_payload_recursive_value(tn: i64, vname: string) bool {
    if (tn < 0) {
        return false;
    }
    var t: Node = nodes[tn];
    if (t.kind == "named") {
        return t.sa == vname;
    }
    if (t.kind == "array") {
        // 定长数组按值内联，故 `[N]Self` 同样无限大
        return variant_payload_recursive_value(t.na, vname);
    }
    return false;
}

fn variant_check_recursion(d: i64) void {
    var n: Node = nodes[d];
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var vc: Node = nodes[k.val];
        // 多载荷走 lb 类型链；单载荷只有 na
        if (vc.lb >= 0) {
            var mp: i64 = vc.lb;
            while (mp >= 0) {
                if (variant_payload_recursive_value(kids[mp].val, n.sa)) {
                    fc_err("T-SEM-E213",
                        sb_cat5("variant `", n.sa, "` 的 case `", vc.sa,
                            sb_cat3("` 载荷以值形态自引用 `", n.sa, "`：请改用指针 `*Self`")),
                        kids[mp].val);
                }
                mp = kids[mp].next;
            }
        } else if (variant_payload_recursive_value(vc.na, n.sa)) {
            fc_err("T-SEM-E213",
                sb_cat5("variant `", n.sa, "` 的 case `", vc.sa,
                    sb_cat3("` 载荷以值形态自引用 `", n.sa, "`：请改用指针 `*Self`")),
                vc.na);
        }
        c = k.next;
    }
}

// 为 Variant 的每个 case 注册合成函数符号（构造器/判别器/取载荷），
// 指向合成 FuncDecl 节点但不在 decl_list 中，故仅作类型检查可见、不被 emitter 重复发射。
fn register_variant_helpers(d: i64) void {
    var n: Node = nodes[d];
    variant_check_recursion(d);
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var vc: Node = nodes[k.val];
        var cname: string = vc.sa;
        // 构造器 Name_from_Case(载荷?) Name
        var ffrom: string = sb_cat3(n.sa, "_from_", cname);
        var retNode: i64 = mk_named(n.sa, -1);
        var plist: i64 = -1;
        var ptail: i64 = -1;
        if (vc.lb >= 0) {
            // 多载荷：v0: T0, v1: T1, ...
            var mp: i64 = vc.lb;
            var mk_idx: i64 = 0;
            while (mp >= 0) {
                var mpt: i64 = kids[mp].val;
                var mpn: string = sb_cat2("v", i2s(mk_idx));
                var pid: i64 = mk_P(mpn, mpt, -1, -1);
                ptail = list_push(plist, ptail, pid);
                if (plist < 0) {
                    plist = ptail;
                }
                mp = kids[mp].next;
                mk_idx = mk_idx + 1;
            }
        } else if (vc.na >= 0) {
            var pid: i64 = mk_P("v", vc.na, -1, -1);
            ptail = list_push(plist, ptail, pid);
            if (plist < 0) {
                plist = ptail;
            }
        }
        var fdecl1: i64 = mk_FuncDecl(ffrom, true, false, retNode, -1, plist, -2, -1);
        sym_define(global_scope, ffrom, "func", ti_named("Func", ffrom), fdecl1);

        // 判别器 Name_is_Case(self: Name) bool
        var fis: string = sb_cat3(n.sa, "_is_", cname);
        var retBool: i64 = mk_scalar("bool", -1);
        var pid2: i64 = node_new("P");
        var pn2: Node = nodes[pid2];
        pn2.sa = "self";
        var selfTn: i64 = mk_named(n.sa, -1);
        pn2.na = selfTn;
        slice_set(nodes, pid2, pn2);
        var plist2: i64 = -1;
        var ptail2: i64 = -1;
        ptail2 = list_push(plist2, ptail2, pid2);
        if (plist2 < 0) {
            plist2 = ptail2;
        }
        var fdecl2: i64 = mk_FuncDecl(fis, true, false, retBool, -1, plist2, -2, -1);
        sym_define(global_scope, fis, "func", ti_named("Func", fis), fdecl2);

        // 取载荷：多载荷逐字段访问器 Name_as_Case_f0 / _f1 / ...；
        // 单载荷 Name_as_Case(self: Name) 载荷（仅当携带载荷）
        if (vc.lb >= 0) {
            var mp: i64 = vc.lb;
            var mk_idx: i64 = 0;
            while (mp >= 0) {
                var mpt: i64 = kids[mp].val;
                var fas: string = sb_cat5(n.sa, "_as_", cname, "_f", i2s(mk_idx));
                var fdecl3: i64 = mk_FuncDecl(fas, true, false, mpt, -1, plist2, -2, -1);
                sym_define(global_scope, fas, "func", ti_named("Func", fas), fdecl3);
                mp = kids[mp].next;
                mk_idx = mk_idx + 1;
            }
        } else if (vc.na >= 0) {
            var fas: string = sb_cat3(n.sa, "_as_", cname);
            var fdecl3: i64 = mk_FuncDecl(fas, true, false, vc.na, -1, plist2, -2, -1);
            sym_define(global_scope, fas, "func", ti_named("Func", fas), fdecl3);
        }
        c = k.next;
    }
}

// ── 列表助手 ───────────────────────────────────────────────────

fn list_last_val(head: i64) i64 {
    var c: i64 = head;
    var last: i64 = -1;
    while (c >= 0) {
        var k: Child = kids[c];
        last = k.val;
        c = k.next;
    }
    return last;
}


