        // 跨池 Sym→Sym（不同 tag）或其它类型赋值均为 T_TYPE_MISMATCH。
        if (tip_kind(atl) == "Sym" and ti_equal(atl, atr) == false) {
            if (tip_kind(atr) != "String" and tip_kind(atr) != "Unknown") {
                err_type_mismatch(base.node_nb((e as u64)), atl, atr);
            }
        }
        return atl;
    }
    if (k == "call") {
        // 实参不走通用遍历，嵌套其中的 format 只能在这里补扫（详见 fmt_scan_subtree）
        if (parse.g_has_format) { fmt_scan_list(base.node_la((e as u64)), e); }
        var cn_id: i64 = base.node_na((e as u64));   // S4 批次 20-D：Node 局部量 → 裸索引局部量
        // R3 类别格静态分派：若 callee 是类型组入口，按首实参静态类型选最具体子句改写 callee。
        // 改写后目标名（`__name__cK` 或单态实例名）不在类型组表里，重入 infer_expr 不会再分派，自然收敛。
        if (base.node_kind((base.node_na((e as u64)) as u64)) == "ident") {
            var gi0: i64 = parse.ovl_find_group(base.node_sa((base.node_na((e as u64)) as u64)));
