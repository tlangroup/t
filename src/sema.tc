                    // 仍改写成 conpat 让覆盖分析不崩溃（错误已记录，构建因 error 失败）。
                    var cs_l: i64 = parse.n_line(m_k.val);
                    var cs_c: i64 = parse.n_col(m_k.val);
                    var cs_sa: string = base.node_sa((m_k.val as u64));
                    var cs_msg: string = "bare variant pattern `" + cs_sa + "` is deprecated; use leading-dot form `." + cs_sa + "`";
                    base.diag_new("T-MAT-E751", "error", cs_msg,
                        parse.n_file(m_k.val), cs_l, cs_c, cs_l, cs_c + (str_len(cs_sa) as i64));
                    // ADT：variant 的裸大写名 = **单元 case** 构造器模式（`Empty` ⇔ `Empty()`）。
                    // 统一改写成 conpat，让覆盖分析与双后端脱糖只认一种形态（L-04）。
                    // 名字拼错不在此处报错——交给 conpat_check 报 T_MATCH_UNKNOWN_CASE 并列出合法 case。
                    var cs_cp: i64 = base.mk_conpat(cs_sa, "", -1, 0, -1);
                    base.node_set_span_id(cs_cp, base.node_span_id(m_k.val));
                    base.node_set_span_id(cs_cp, base.node_span_id(m_k.val));
                    base.node_set_span_id(cs_cp, base.node_span_id(m_k.val));
                    base.node_set_na((m_k.val as u64), cs_cp);
                    base.node_set_sa((m_k.val as u64), "");
                } else if (enum_has_case(m_scr, base.node_sa((m_k.val as u64)))) {
                    var cs_base: i64 = base.mk_ident(tip_name(m_scr), -1);
                    base.node_set_span_id(cs_base, base.node_span_id(m_k.val));
                    base.node_set_span_id(cs_base, base.node_span_id(m_k.val));
                    base.node_set_span_id(cs_base, base.node_span_id(m_k.val));
                    var cs_mem: i64 = base.mk_member(base.node_sa((m_k.val as u64)), cs_base, -1);
                    base.node_set_span_id(cs_mem, base.node_span_id(m_k.val));
                    base.node_set_span_id(cs_mem, base.node_span_id(m_k.val));
                    base.node_set_span_id(cs_mem, base.node_span_id(m_k.val));
                    base.node_set_na((m_k.val as u64), cs_mem);
                    base.node_set_sa((m_k.val as u64), "");
                } else {
                    if (m_rep) {
                        var cs_l: i64 = parse.n_line(m_k.val);
                        var cs_c: i64 = parse.n_col(m_k.val);
                        var cs_msg: string = base.sb_cat3(
                            "pattern `", base.node_sa((m_k.val as u64)),
                            "` starts with an uppercase letter, so it is read as a case name, not a binding");
                        if (tip_kind(m_scr) == "Enum") {
                            cs_msg = base.sb_cat5("unknown case `", base.node_sa((m_k.val as u64)), "` for enum ", tip_name(m_scr),
                                " — check the spelling, or use a lowercase name to bind instead");
                        }
                        var cs_di: i64 = base.diag_new("T-MAT-E740", "error", cs_msg,
                            parse.n_file(m_k.val), cs_l, cs_c, cs_l, cs_c + (str_len(base.node_sa((m_k.val as u64))) as i64));
                        var cs_fx: i64 = base.fix_one("use a lowercase binding name",
                            parse.n_file(m_k.val), cs_l, cs_c, cs_l, cs_c + (str_len(base.node_sa((m_k.val as u64))) as i64),
                            "<lowercase_name>");
                        base.diag_set_fs(cs_di, cs_fx);
                    }
                }
            }
            // 前导点变体模式：`.Empty` / `.Circle(r)` 改写成等价 conpat（与 `Shape.Circle(r)` 同一条
            // conpat_check 解构路径）。仅当 scrutinee 是 Variant 且模式为「前导点 member/call」时触发；
            // 裸大写名（已被上方 C2 改写）或 enum 模式不受影响。
            // 仅当本臂确有模式节点（na>=0）时才尝试前导点变体改写；
            // `_` 通配臂与裸单元 case（na=-1）无模式节点，按索引 -1 读侧表会越界。
            if (base.node_na((m_k.val as u64)) >= 0 and tip_kind(m_scr) == "Variant") {
                var ld_cp: i64 = leading_dot_to_conpat(base.node_na((m_k.val as u64)), m_scr);
                if (ld_cp >= 0) {
                    // as-模式 `x @ .Pat`：arm.sa 存整体绑定 x，必须保留；不得清空。
                    // 仅当本臂无 as-绑定（arm.sa 已为 ""）时无需动作。
                    var ld_had_as: bool = str_len(base.node_sa((m_k.val as u64))) > 0;
                    base.node_set_na((m_k.val as u64), ld_cp);
                    if (ld_had_as == false) {
                        base.node_set_sa((m_k.val as u64), "");
                    }
                }
            }
            // ── P2：值匹配「常量臂全局唯一、重复即硬错」（审查结论，sema 期检测）──
            // 守卫臂（when 守卫）不参与唯一性侧表：守卫不穷尽该常量，故与同常量无守卫臂
            // 构成合法「守卫细化」，不可判为重复（审查结论：守卫臂不可判定，保守跳过）。
            if (m_rep and m_scr_is_value(m_scr) and base.node_nb((m_k.val as u64)) < 0) {
                var m_pn: i64 = base.node_na((m_k.val as u64));
                var m_ck: string = m_arm_const_key(m_pn, m_scr);
                if (str_len(m_ck) > 0) {
                    var m_pn2: i64 = m_pn;
                    while (m_pn2 >= 0 and base.node_kind((m_pn2 as u64)) == "paren") { m_pn2 = base.node_na((m_pn2 as u64)); }
                    var m_cv: i64 = -2;
                    if (m_pn2 >= 0 and base.node_kind((m_pn2 as u64)) == "int") {
                        m_cv = js_parse_int(base.node_sa((m_pn2 as u64)), base.node_ia((m_pn2 as u64)));
                    }
                    var m_j: i64 = 0;
                    var m_hit: bool = false;
                    // 重复常量（规范化键相同）→ 硬错
                    while (m_j < slice_len(m_seen_ckey) as i64) {
                        if (m_seen_ckey[m_j] == m_ck) {
                            var m_msg: string = base.sb_cat5("match arm covers a value already handled by an earlier arm at line ",
                                base.i2s(m_seen_cln[m_j]), ": duplicate constant ", m_ck, "");
                            base.diag_new("T-MAT-E760", "error", m_msg,
                                parse.n_file(m_k.val), parse.n_line(m_k.val), parse.n_col(m_k.val), parse.n_line(m_k.val), parse.n_col(m_k.val) + 1);
                            m_hit = true;
                            break;
                        }
                        m_j = m_j + 1;
                    }
                    // 常量落在更早的区间臂内 → 硬错
                    if (m_hit == false and m_cv != -2) {
                        m_j = 0;
                        while (m_j < slice_len(m_seen_rlo) as i64) {
                            var rlo: i64 = m_seen_rlo[m_j];
                            var rhi: i64 = m_seen_rhi[m_j];
                            var lo_ok: bool = false;
                            if (rlo != -2) { if (rlo == -1 or rlo <= m_cv) { lo_ok = true; } }
                            var hi_ok: bool = false;
                            if (rhi != -2) {
                                if (rhi == -1) { hi_ok = true; }
                                else {
                                    var rhi_eff: i64 = rhi;
                                    if (m_seen_rinc[m_j] == false) { rhi_eff = rhi - 1; }  // 半开区间上界排他
                                    if (m_cv <= rhi_eff) { hi_ok = true; }
                                }
                            }
                            if (lo_ok and hi_ok) {
                                base.diag_new("T-MAT-E760", "error",
                                    "match arm constant is already covered by an earlier range arm",
                                    parse.n_file(m_k.val), parse.n_line(m_k.val), parse.n_col(m_k.val), parse.n_line(m_k.val), parse.n_col(m_k.val) + 1);
                                m_hit = true;
                                break;
                            }
                            m_j = m_j + 1;
                        }
                    }
                    if (m_hit == false) {
                        append(m_seen_ckey, m_ck);
                        append(m_seen_cint, m_cv);
                        append(m_seen_cln, parse.n_line(m_k.val));
                        // float NaN 脚枪（Wnan）：float 主体 + float 字面量臂
                        if ((tip_name(m_scr) == "f32" or tip_name(m_scr) == "f64") and base.node_kind((m_pn2 as u64)) == "float") {
                            base.diag_new("T-MAT-W761", "warning",
                                "matching a float literal is unsafe: NaN never equals any value, so it silently falls through to a wildcard or default arm",
                                parse.n_file(m_k.val), parse.n_line(m_k.val), parse.n_col(m_k.val), parse.n_line(m_k.val), parse.n_col(m_k.val) + 1);
                        }
                    }
                }
            }
            var m_prev: i64 = cur_scope;
            cur_scope = scope_new_at(m_prev, m_k.val);
            if (str_len(base.node_sa((m_k.val as u64))) > 0) {
                sym_define(cur_scope, base.node_sa((m_k.val as u64)), "var", m_scr, -1);
            }
            if (base.node_na((m_k.val as u64)) >= 0 and base.node_kind((base.node_na((m_k.val as u64)) as u64)) == "conpat") {
                // ADT：variant 构造器解构。此刻 cur_scope 已是本臂子作用域，
                // 载荷绑定直接 define 进去（仅本臂可见，遮蔽外层同名）。
                conpat_check(base.node_na((m_k.val as u64)), m_scr, m_rep);
            } else if (base.node_na((m_k.val as u64)) >= 0 and base.node_kind((base.node_na((m_k.val as u64)) as u64)) == "struct_lit") {
                // struct / 具名元组 字面量模式：逐字段类型校验 + ident 绑定（§8.2）。
                // 须先于下方「前导点变体」else 分支，避免被当成表达式整体 infer 而把
                // 绑定标识符误判为未定义（T-SEM-E201）。
                struct_lit_pat_check(base.node_na((m_k.val as u64)), m_scr, m_rep);
            } else if (base.node_na((m_k.val as u64)) >= 0) {
                // 切片模式（S6）：children 由 validate_slice_pat 校验 + 声明元素绑定，
                // 本身不整体 infer（与 range 同处理，避免被当成普通表达式求值）。
                if (is_slice_pat(base.node_na((m_k.val as u64)))) {
                    validate_slice_pat(base.node_na((m_k.val as u64)), m_scr, m_rep);
                    // `[..]` 全通配（仅 rest、无其它元素、无守卫）等价于 `_`：必然命中，
                    // 算穷尽（令 m_irref=true）且令后续臂不可达（m_dead=true，触发 S4 W744）。
                    // 切片长度无有限穷尽集，故只有 `[..]`/`_` 能收尾；精确长度臂组合不行。
                    if (base.node_nb((m_k.val as u64)) < 0 and base.node_na((base.node_na((m_k.val as u64)) as u64)) >= 0 and base.node_nb((base.node_na((m_k.val as u64)) as u64)) == 1) {
                        base.node_set_ba((m_k.val as u64), true);   // S4 §0.14.7 SoA：侧表写（原 m_an.ba = true）
                        m_irref = true;
                        m_dead = true;
                    }
                } else if (is_range_node(base.node_na((m_k.val as u64)))) {
                // infer_expr 见到 range 会走 materialize_range，把它物化成 []i64：
                // 既误报「[]i64 vs i64」类型不符，又把节点退化成 paren，
                // 让 codegen 的 match_chain_from 认不出 `kind == "range"`。
                // 这里只逐端点校验类型，range 节点原样留给后端合成比较链。
                    if (base.node_na((base.node_na((m_k.val as u64)) as u64)) >= 0) {
                        var m_rlo: i64 = ie_sub_in(ie_inst(base.node_na((m_k.val as u64))), base.node_na((base.node_na((m_k.val as u64)) as u64)));
                        if (m_rep and tip_kind(m_rlo) != "Unknown" and tip_kind(m_scr) != "Unknown") {
                            if (ti_equal(m_rlo, m_scr) == false and can_cast(m_rlo, m_scr) == false) {
                                err_type_mismatch(base.node_na((base.node_na((m_k.val as u64)) as u64)), m_scr, m_rlo);
                            }
                        }
                    }
                    if (base.node_nb((base.node_na((m_k.val as u64)) as u64)) >= 0) {
                        var m_rhi: i64 = ie_sub_in(ie_inst(base.node_na((m_k.val as u64))), base.node_nb((base.node_na((m_k.val as u64)) as u64)));
                        if (m_rep and tip_kind(m_rhi) != "Unknown" and tip_kind(m_scr) != "Unknown") {
                            if (ti_equal(m_rhi, m_scr) == false and can_cast(m_rhi, m_scr) == false) {
                                err_type_mismatch(base.node_nb((base.node_na((m_k.val as u64)) as u64)), m_scr, m_rhi);
                            }
                        }
                    }
                    // ── P2：区间臂唯一性（值匹配）──
                    // 守卫区间臂同样跳过（与常量臂同理由：守卫不穷尽，保守不判重叠/覆盖）。
                    if (m_rep and m_scr_is_value(m_scr) and base.node_nb((m_k.val as u64)) < 0) {
                        var m_rnode: i64 = base.node_na((m_k.val as u64));
                        var cur_incl: bool = base.node_ba((m_rnode as u64));  // true = ..= 闭合，否则 .. 半开
                        var m_lon: i64 = base.node_na((m_rnode as u64));
                        var m_hin: i64 = base.node_nb((m_rnode as u64));
                        var rlo: i64 = -2;
                        var rhi: i64 = -2;
                        if (m_lon >= 0 and base.node_kind((m_lon as u64)) == "int") { rlo = js_parse_int(base.node_sa((m_lon as u64)), base.node_ia((m_lon as u64))); }
                        if (m_hin >= 0 and base.node_kind((m_hin as u64)) == "int") { rhi = js_parse_int(base.node_sa((m_hin as u64)), base.node_ia((m_hin as u64))); }
                        var m_j: i64 = 0;
                        var m_hit: bool = false;
                        // 区间含更早的整型常量 → 硬错
                        while (m_j < slice_len(m_seen_cint) as i64) {
                            var cv: i64 = m_seen_cint[m_j];
                            if (cv != -2) {
                                var lo_ok: bool = false;
                                if (rlo != -2) { if (rlo == -1 or rlo <= cv) { lo_ok = true; } }
                            var hi_ok: bool = false;
                            if (rhi != -2) {
                                if (rhi == -1) { hi_ok = true; }
                                else {
                                    var rhi_eff: i64 = rhi;
                                    if (cur_incl == false) { rhi_eff = rhi - 1; }  // 半开区间上界排他
                                    if (cv <= rhi_eff) { hi_ok = true; }
                                }
                            }
                                if (lo_ok and hi_ok) {
                                    base.diag_new("T-MAT-E760", "error",
                                        "match range arm already covers an earlier constant arm",
                                        parse.n_file(m_k.val), parse.n_line(m_k.val), parse.n_col(m_k.val), parse.n_line(m_k.val), parse.n_col(m_k.val) + 1);
                                    m_hit = true;
                                    break;
                                }
                            }
                            m_j = m_j + 1;
                        }
                        // 区间与更早区间重叠 → 硬错（当前 `..` 通配无意义，由 m_dead 处理后续臂）
                        if (m_hit == false) {
                            if (rlo == -1 and rhi == -1) { m_hit = true; }
                            else {
                                m_j = 0;
                                while (m_j < slice_len(m_seen_rlo) as i64) {
                                    var slo: i64 = m_seen_rlo[m_j];
                                    var shi: i64 = m_seen_rhi[m_j];
                                    var sinc: bool = m_seen_rinc[m_j];
                                    // 仅整型区间可比；开闭性经有效上界处理（开放=无界、半开=hi-1）
                                    if (slo != -2 and shi != -2 and rlo != -2 and rhi != -2) {
                                        var a_lo: i64 = rlo;   if (rlo == -1) { a_lo = -1; }       // 开放下界：下界侧交叠由对方决定
                                        var a_hi_eff: i64 = rhi; if (rhi == -1) { a_hi_eff = -2; } else if (cur_incl == false) { a_hi_eff = rhi - 1; }
                                        var b_lo: i64 = slo;   if (slo == -1) { b_lo = -1; }
                                        var b_hi_eff: i64 = shi; if (shi == -1) { b_hi_eff = -2; } else if (sinc == false) { b_hi_eff = shi - 1; }
                                        var ov: bool = true;
                                        if (a_lo != -1 and b_hi_eff != -2) { if (a_lo > b_hi_eff) { ov = false; } }
                                        if (b_lo != -1 and a_hi_eff != -2) { if (b_lo > a_hi_eff) { ov = false; } }
                                        if (ov) {
                                            base.diag_new("T-MAT-E760", "error",
                                                "match range arms overlap: an earlier range already covers part of this range",
                                                parse.n_file(m_k.val), parse.n_line(m_k.val), parse.n_col(m_k.val), parse.n_line(m_k.val), parse.n_col(m_k.val) + 1);
                                            m_hit = true;
                                            break;
                                        }
                                    }
                                    m_j = m_j + 1;
                                }
                            }
                        }
                        if (m_hit == false) {
                            append(m_seen_rlo, rlo);
                            append(m_seen_rhi, rhi);
                            append(m_seen_rln, parse.n_line(m_k.val));
                            append(m_seen_rinc, cur_incl);
                            // float NaN 脚枪（Wnan）：float 主体 + float 区间臂
                            if ((tip_name(m_scr) == "f32" or tip_name(m_scr) == "f64")
                                and ((m_lon >= 0 and base.node_kind((m_lon as u64)) == "float") or (m_hin >= 0 and base.node_kind((m_hin as u64)) == "float"))) {
                                base.diag_new("T-MAT-W761", "warning",
                                    "matching a float range is unsafe: NaN never falls inside any range, so it silently falls through to a wildcard or default arm",
                                    parse.n_file(m_k.val), parse.n_line(m_k.val), parse.n_col(m_k.val), parse.n_line(m_k.val), parse.n_col(m_k.val) + 1);
                            }
                        }
                    }
                    // `..` 全通配等价于 `_`：两端都省的范围臂必然命中，算穷尽。
                    // 直接置 m_irref/m_dead（不可走 line 5581 的 `m_an.na<0` 分支，range 节点 na>=0）。
                    if (base.node_na((base.node_na((m_k.val as u64)) as u64)) < 0 and base.node_nb((base.node_na((m_k.val as u64)) as u64)) < 0) {
                        base.node_set_ba((m_k.val as u64), true);   // S4 §0.14.7 SoA：侧表写（原 m_an.ba = true）
                        m_irref = true;
                        m_dead = true;
                    }
                } else if (base.node_kind((base.node_na((m_k.val as u64)) as u64)) == "bitstr_pat") {
                // 位串模式解构（§6）：段内 ident 绑定 + 运行时位解包。
                // 校验 scrutinee 为 BitStr；按段登记绑定（定长段 → i64，/bitstr 尾段 → BitStr）。
                    if (m_rep and tip_kind(m_scr) != "BitStr") {
                        parse.fc_err("T-BIT-E517",
                            base.sb_cat3("位串模式 `<<...>>` 只能匹配 bitstr 类型，被匹配值是 `", tip_name(m_scr), "`"),
                            base.node_na((m_k.val as u64)));
                    }
                    var bseg: i64 = base.node_la((base.node_na((m_k.val as u64)) as u64));
                    var saw_rest: bool = false;
                    // S4 §4.6 Phase 3：链先物化再遍历 —— 纯读取循环
                    var ks6541: []i64 = base.kids_chain(bseg);
                    var ki6541: i64 = 0;
                    while (ki6541 < slice_len(ks6541) as i64) {
                        var kv6541: i64 = ks6541[ki6541];
                        if (base.node_na((kv6541 as u64)) >= 0 and base.node_kind((base.node_na((kv6541 as u64)) as u64)) == "ident" and base.node_sa((base.node_na((kv6541 as u64)) as u64)) != "_") {
                            if (base.node_ba((kv6541 as u64))) {
                                saw_rest = true;
                                sym_define(cur_scope, base.node_sa((base.node_na((kv6541 as u64)) as u64)), "var", ti_mk("BitStr"), -1);
                            } else {
                                sym_define(cur_scope, base.node_sa((base.node_na((kv6541 as u64)) as u64)), "var", ti_mk("i64"), -1);
                            }
                        }
                        ki6541 = ki6541 + 1;
                    }
                    // 含 /bitstr 尾段（或全通配）的位串模式必然命中 → 算穷尽 + 后续臂不可达。
                    if (base.node_nb((m_k.val as u64)) < 0 and (saw_rest or base.node_la((base.node_na((m_k.val as u64)) as u64)) < 0)) {
                        m_irref = true;
                        m_dead = true;
                    }
                } else {
                    // 前导点变体臂 `.Red`：模式是 leading-dot member（na<0, lb==1），
                    // 须把枚举/联合「期望类型」注入 g_lead_expect，使其改写成 `Enum.Red`
                    // （与既有的 `Color.Red` 臂走同一条 member 路径），需配对还原。
                    var m_sav_exp: i64 = g_lead_expect;
                    if (tip_kind(m_scr) == "Enum" or tip_kind(m_scr) == "Union") {
                        g_lead_expect = m_scr;
                    }
                    var m_pt: i64 = ie_sub_in(ie_inst(m_k.val), base.node_na((m_k.val as u64)));
                    g_lead_expect = m_sav_exp;
                    if (m_rep and tip_kind(m_pt) != "Unknown" and tip_kind(m_scr) != "Unknown") {
                        if (ti_equal(m_pt, m_scr) == false and can_cast(m_pt, m_scr) == false) {
                            err_type_mismatch(base.node_na((m_k.val as u64)), m_scr, m_pt);
                        }
                    }
                }
            }
            if (base.node_nb((m_k.val as u64)) >= 0) {
                var m_gt: i64 = ie_sub_in(ie_inst(m_k.val), base.node_nb((m_k.val as u64)));
                if (m_rep and is_cond_bool(m_gt) == false) {
                    var m_gl: i64 = parse.n_line(base.node_nb((m_k.val as u64)));
                    var m_gc: i64 = parse.n_col(base.node_nb((m_k.val as u64)));
                    base.diag_new("T-SEM-E204", "error",
                        base.sb_cat2("match `when` guard must be bool, got ", ti_str(m_gt)),
                        parse.n_file(base.node_nb((m_k.val as u64))), m_gl, m_gc, m_gl, m_gc + 4);
                }
            }
            var m_bt: i64 = ie_sub_in(ie_inst(m_k.val), base.node_nc((m_k.val as u64)));
            cur_scope = m_prev;
            if (m_res < 0) {
                m_res = m_bt;
            } else {
                if (m_rep and tip_kind(m_bt) != "Unknown" and tip_kind(m_res) != "Unknown") {
                    // P2（everything-is-value 补齐）：对称 widen-only lub，取代方向性 can_cast。
                    // 与书写顺序无关；无公共可表示类型（如 i16+u16、bool+int）→ T-MAT-E741。
                    var m_pair: []i64 = [];
                    append(m_pair, m_res);
                    append(m_pair, m_bt);
                    var m_lub: i64 = widen_only_lub(m_pair);
                    if (m_lub < 0) {
                        var m_bl: i64 = parse.n_line(base.node_nc((m_k.val as u64)));
                        var m_bc: i64 = parse.n_col(base.node_nc((m_k.val as u64)));
                        base.diag_new("T-MAT-E741", "error",
                            base.sb_cat4("match arms have different types: ", ti_str(m_res), " vs ", ti_str(m_bt)),
                            parse.n_file(base.node_nc((m_k.val as u64))), m_bl, m_bc, m_bl, m_bc + 4);
                    } else {
                        m_res = m_lub;
                    }
                }
            }
            // 不可反驳 = 无守卫 且 无子模式（通配 `_` 或裸绑定 `x`）。
            // 注意 `x @ pat`（S3，na>=0）是**可反驳**的，不算不可反驳臂。
            if (base.node_nb((m_k.val as u64)) < 0 and base.node_na((m_k.val as u64)) < 0 and (base.node_ba((m_k.val as u64)) or str_len(base.node_sa((m_k.val as u64))) > 0)) {
                m_irref = true;
                m_dead = true;
            }
            mq_ki6520 = mq_ki6520 + 1;
            m_c = -1;
        }
        // enum scrutinee 的全 case 覆盖同样构成穷尽，此时 `_` 不再必需。
        if (m_irref == false and enum_all_cases_covered(e, m_scr)) {
            m_irref = true;
        }
        // bool 值域全集 = {true, false}：两臂齐备即穷尽，无需 `_` 兜底。
        if (m_irref == false and bool_all_cases_covered(e, m_scr)) {
            m_irref = true;
        }
        // ADT：variant 的全 case 覆盖同理（A1 推广到 variant）。
        if (m_irref == false and variant_all_cases_covered(e, m_scr)) {
            m_irref = true;
        }
        // 抽象 variant（声明末位 `_`）= 开放和类型：**豁免**穷尽性。
        // 未覆盖的 case 与未知 tag 由 `_` 臂吸收，无 `_` 臂则运行期落确定性 t_panic（L-09 零 UB）。
        if (m_irref == false and variant_is_abstract(m_scr)) {
            m_irref = true;
        }
        if (m_rep and m_irref == false) {
            var m_l: i64 = parse.n_line(e);
            var m_col: i64 = parse.n_col(e);
            var m_miss: string = enum_missing_cases(e, m_scr);
            if (str_len(m_miss) == 0) {
                m_miss = variant_missing_cases(e, m_scr);
            }
            var m_msg: string = "match is not exhaustive: add a `_` wildcard arm or a binding arm without guard";
            if (str_len(m_miss) > 0) {
                m_msg = base.sb_cat3("match is not exhaustive: unhandled case(s) ", m_miss,
                    " — cover them all, or add a `_` wildcard arm");
            }
            var m_di: i64 = base.diag_new("T-MAT-E742", "error", m_msg,
                parse.n_file(e), m_l, m_col, m_l, m_col + 5);
            var m_fx: i64 = base.fix_one("add wildcard arm", parse.n_file(e), m_l, m_col, m_l, m_col, "_ => <default>");
            base.diag_set_fs(m_di, m_fx);
        }
        // 把 match 的统一结果类型回填到 match 节点 .td：供 codegen（tir_expr_st / est）取到真实结果类型。
        // 否则运行期 scrutinee 时 meta_eval_match 直接 return -1，tir_expr_st(match) 退化为 i64，
        // 导致返回 string/struct 的 match 的 __mres 槽宽度不足（如 S3 as-模式 `v @ range => str`）。
        // 只在该节点 .td 尚未回填时设置（若被重入/重置则下次推断再填），避免反复调 ti_to_td_base 撑大 tds。
        if (m_res < 0) {
            return ti_mk("Unknown");
        }
        return m_res;
    }
    if (k == "binary") {
        var op: string = base.node_sa((e as u64));
        // 成员测试 `x in lo..hi`：右操作数是区间，整体降解成比较合取
        if (op == "in") {
            return lower_in_range(e);
        }
        // ── 序列化/反序列化操作符脱糖（M51 `<` 写；M52 读路径 `>` 读）────────
        // 语义由**左操作数静态类型**唯一判定：fid ⇒ 序列化/反序列化，否则 ⇒ 普通比较。
        // fid 无序，故 `<`/`>` 作比较时不存在二义（L-04）；`>` 作反序列化时右操作数是「类型」而非值。
        var lt: i64 = ie_sub(ei, 0, base.node_na((e as u64)));
        var lfid: bool = tip_kind(lt) == "Scalar" and tip_name(lt) == "fid";
        if (lfid and op == "<") {
            var rt: i64 = ie_sub(ei, 1, base.node_nb((e as u64)));
            check_serializable(base.node_nb((e as u64)), rt);
            base.node_set_kind((e as u64), "serialize");
            hir.hir_invalidate((e as u64));
            return ti_scalar("fid");
        }
        if (lfid and op == ">") {
            // 右操作数是「类型」，不是值：按类型解析，不调 infer_expr(n.nb)
            if (deser_rhs_is_value(base.node_nb((e as u64)))) {
                parse.fc_err("T-FID-E655",
                    "`fid > X` 是反序列化，右操作数必须是**类型**（如 `f > i64`、`f > string`），不能是值；fid 无序，比较大小请改用 `==` / `!=`", e);
                return ti_mk("Unknown");
            }
            var rtd: i64 = deser_type_of(base.node_nb((e as u64)));
            // 未定义类型已由 deser_type_of 报 T_UNKNOWN_TYPE（rtd 为 unknown 但 >= 0）
            if (tds[rtd].cat == "unknown") {
                return ti_mk("Unknown");
            }
            if (deser_supported(rtd) == false) {
                parse.fc_err("T-FID-E656",
                    "反序列化暂仅支持标量（i8..i64 / u8..u64 / f32 / f64 / bool / atom）与 string；聚合类型（struct / array / slice / map / pointer）读属 v2", e);
                return ti_mk("Unknown");
            }
            base.node_set_kind((e as u64), "deserialize");
            hir.hir_invalidate((e as u64));
            return ti_from_td(rtd);          // Option B：结果类型为裸 T，EOF 由 fid_eof 探针表达
        }
        // parse 期把 `> string` / `> map[K]V` 等关键字型类型收成了类型节点；若左操作数
        // 并非 fid，这就不是反序列化，而是把类型当值比较 —— 须给出定位准确的诊断，
        // 否则 infer_expr 会在类型节点上得到 Unknown，报出与病因无关的错误。
        if (op == ">" and node_type_only(base.node_nb((e as u64)))) {
            parse.fc_err("T-FID-E657",
                "`>` 的右操作数写成了类型 —— 只有左操作数是 fid 时 `>` 才是反序列化；普通比较的两侧都必须是值", e);
            return ti_mk("Unknown");
        }
        // 其余：正常推断右操作数，再按既有规则处理比较/有序错误
        var rt: i64 = ie_sub(ei, 1, base.node_nb((e as u64)));
        var rfid: bool = tip_kind(rt) == "Scalar" and tip_name(rt) == "fid";
        if (lfid or rfid) {
            if (op == "<" or op == ">" or op == "<=" or op == ">=") {
                parse.fc_err("T-FID-E658",
                    base.sb_cat3("fid 是无序句柄，不支持 `", op,
                        "` 比较；写出用 `目标fid < 值`（序列化），读入用 `源fid > 类型`（反序列化），判等用 `==` / `!=`"), e);
                return ti_scalar("bool");
            }
        }
        // ── 向量逐元素运算（T-VEC-E924 / E925）─────────────────────────────
        // 必须排在比较/逻辑运算之前：`va == vb` 若落到下面的通用分支会静默返回 bool，
        // 而后端并不发射向量比较掩码 —— 会编出取首 lane 的错代码。宁可在此硬报错。
        if (ti_is_vector(lt) or ti_is_vector(rt)) {
            var vew: bool = op == "+" or op == "-" or op == "*" or op == "/" or op == "%"
                or op == "&" or op == "|" or op == "^" or op == "<<" or op == ">>";
            if (vew == false) {
                var sb25: StringBuilder = sb_new();
                sb_append_str(sb25, "运算符 `");
                sb_append_str(sb25, op);
                sb_append_str(sb25, "` 不支持向量操作数；可用的逐元素运算为 `+ - * / % & | ^ << >>`。");
                sb_append_str(sb25, "判等/比较请先归约（`@reduce_add` / `@reduce_max` / `@reduce_min`），或按 lane 下标逐个比较");
                parse.fc_err("T-VEC-E925", sb_to_str(sb25), e);
                return ti_mk("Unknown");
            }
            var sb24: StringBuilder = sb_new();
            sb_append_str(sb24, "向量逐元素 `");
            sb_append_str(sb24, op);
            if (ti_is_vector(lt) == false or ti_is_vector(rt) == false) {
                sb_append_str(sb24, "` 的两侧都必须是向量，当前为 ");
                sb_append_str(sb24, ti_str(lt));
                sb_append_str(sb24, " 与 ");
                sb_append_str(sb24, ti_str(rt));
                sb_append_str(sb24, "；标量请先用 `@splat(标量, lane 数)` 广播成同宽向量");
                parse.fc_err("T-VEC-E924", sb_to_str(sb24), e);
                return ti_mk("Unknown");
            }
            if (ti_vlen(lt) != ti_vlen(rt)) {
                sb_append_str(sb24, "` 要求两侧 lane 数一致，当前为 ");
                sb_append_i64(sb24, ti_vlen(lt));
                sb_append_str(sb24, " 与 ");
                sb_append_i64(sb24, ti_vlen(rt));
                parse.fc_err("T-VEC-E924", sb_to_str(sb24), e);
                return ti_mk("Unknown");
            }
            if (ti_equal(tis[lt].elem, tis[rt].elem) == false) {
                sb_append_str(sb24, "` 要求两侧 lane 类型一致，当前为 ");
                sb_append_str(sb24, ti_str(tis[lt].elem));
                sb_append_str(sb24, " 与 ");
                sb_append_str(sb24, ti_str(tis[rt].elem));
                sb_append_str(sb24, "；向量之间没有隐式提升，请显式构造同 lane 类型的向量");
                parse.fc_err("T-VEC-E924", sb_to_str(sb24), e);
                return ti_mk("Unknown");
            }
            return lt;
        }
        // ── 瓦片逐元素运算（T-VEC-E945 / E946）─────────────────────────────
        // 与向量同构：须排在比较/逻辑运算之前，否则 `ta == tb` 会静默返回 bool，
        // 而后端并不发射瓦片比较掩码。非逐元素运算符（含比较）一律硬报错。
        if (ti_is_tile(lt) or ti_is_tile(rt)) {
            var tew: bool = op == "+" or op == "-" or op == "*" or op == "/" or op == "%"
                or op == "&" or op == "|" or op == "^" or op == "<<" or op == ">>";
            if (tew == false) {
                var sb26: StringBuilder = sb_new();
                sb_append_str(sb26, "运算符 `");
                sb_append_str(sb26, op);
                sb_append_str(sb26, "` 不支持瓦片操作数；可用的逐元素运算为 `+ - * / % & | ^ << >>`。");
                sb_append_str(sb26, "判等/比较请先归约（`@tile_reduce_*`），或按 `t[i][j]` 逐个比较");
                parse.fc_err("T-VEC-E946", sb_to_str(sb26), e);
                return ti_mk("Unknown");
            }
            if (ti_is_tile(lt) == false or ti_is_tile(rt) == false) {
                var sb27: StringBuilder = sb_new();
                sb_append_str(sb27, "瓦片逐元素 `");
                sb_append_str(sb27, op);
                sb_append_str(sb27, "` 的两侧都必须是瓦片，当前为 ");
                sb_append_str(sb27, ti_str(lt));
                sb_append_str(sb27, " 与 ");
                sb_append_str(sb27, ti_str(rt));
                sb_append_str(sb27, "；标量请先用 `@tsplat(标量, 行, 列)` 广播成同形瓦片");
                parse.fc_err("T-VEC-E945", sb_to_str(sb27), e);
                return ti_mk("Unknown");
            }
            if (ti_trows(lt) != ti_trows(rt) or ti_tcols(lt) != ti_tcols(rt)) {
                var sb28: StringBuilder = sb_new();
                sb_append_str(sb28, "瓦片逐元素 `");
                sb_append_str(sb28, op);
                sb_append_str(sb28, "` 要求两侧形状一致（行×列），当前为 ");
                sb_append_i64(sb28, ti_trows(lt));
                sb_append_str(sb28, "×");
                sb_append_i64(sb28, ti_tcols(lt));
                sb_append_str(sb28, " 与 ");
                sb_append_i64(sb28, ti_trows(rt));
                sb_append_str(sb28, "×");
                sb_append_i64(sb28, ti_tcols(rt));
                parse.fc_err("T-VEC-E945", sb_to_str(sb28), e);
                return ti_mk("Unknown");
            }
            if (ti_equal(tis[lt].elem, tis[rt].elem) == false) {
                var sb29: StringBuilder = sb_new();
                sb_append_str(sb29, "瓦片逐元素 `");
                sb_append_str(sb29, op);
                sb_append_str(sb29, "` 要求两侧元素类型一致，当前为 ");
                sb_append_str(sb29, ti_str(tis[lt].elem));
                sb_append_str(sb29, " 与 ");
                sb_append_str(sb29, ti_str(tis[rt].elem));
                sb_append_str(sb29, "；瓦片之间没有隐式提升，请显式构造同元素类型的瓦片");
                parse.fc_err("T-VEC-E945", sb_to_str(sb29), e);
                return ti_mk("Unknown");
            }
            return lt;
        }
        // 集合合并 `++`（§15.6）：bitstr / String / Slice 合并；Map 合并为后续逐步推广项。
        if (op == "Concat") {
            var calk: string = tip_kind(lt);
            var cark: string = tip_kind(rt);
            if (calk == "BitStr" and cark == "BitStr") {
                return ti_mk("BitStr");
            }
            if (calk == "String" and cark == "String") {
                return ti_mk("String");
            }
            if (calk == "Slice" and cark == "Slice") {
                // 元素类型必须一致（与瓦片逐元素算术同款严格性）。用 ti_equal 语义比较，
                // 避免「两处 i64 落入不同 TI 索引」导致的误报（§15.6）。
                if (ti_equal(tis[lt].elem, tis[rt].elem)) {
                    return lt;
                }
                parse.fc_err("T-BIT-E515",
                    base.sb_cat5("`++` 两侧切片元素类型不同：", ti_str(lt), " 与 ", ti_str(rt),
                        "；请构造同元素类型的切片"), e);
                return ti_mk("Unknown");
            }
            if (calk == "Array" and cark == "Array") {
                // [N]T ++ [M]T ⇒ [N+M]T：定长数组合并后长度相加，元素类型须一致（与切片同款严格性）。
                if (ti_equal(tis[lt].elem, tis[rt].elem)) {
                    var cai: i64 = ti_elem_of("Array", tis[lt].elem);
                    var cat: TI = tis[cai];
                    cat.alen = tis[lt].alen + tis[rt].alen;
                    slice_set(tis, cai, cat);
                    return cai;
                }
                parse.fc_err("T-BIT-E515",
                    base.sb_cat5("`++` 两侧数组元素类型不同：", ti_str(lt), " 与 ", ti_str(rt),
                        "；请构造同元素类型的数组"), e);
                return ti_mk("Unknown");
            }
            if (calk == "Map" and cark == "Map") {
                // map[K]V ++ map[K]V ⇒ map[K]V：key/val 类型须一致（语义比较，避免 TI 索引漂移误报）。
                if (ti_equal(tis[lt].key, tis[rt].key) and ti_equal(tis[lt].val, tis[rt].val)) {
                    return lt;
                }
                parse.fc_err("T-BIT-E515",
                    base.sb_cat5("`++` 两侧 map 的 key/val 类型不同：", ti_str(lt), " 与 ", ti_str(rt),
                        "；请构造同 key/val 类型的 map"), e);
                return ti_mk("Unknown");
            }
            parse.fc_err("T-BIT-E515",
                base.sb_cat5("`++` 仅支持 bitstr / String / Slice / Array / Map 合并，得到 ", ti_str(lt), " 与 ", ti_str(rt),
                    "；其余类型暂不支持 ++"), e);
            return ti_mk("Unknown");
        }
        // §set-ops Step 2：值级 `&&` / `||` = 集合交 / 并。内建实现覆盖 bitstr 与位域（packed struct）；
        // `&` / `|` 对这两类与集合运算同义（同一条位运算通路），顺带补齐此前
        // 「类型检查放行、后端产出非法 IR」的静默错编缺口（实测 `and %TBitStr` / `and %Perm`）。
        // 其余类型一律结构化报错并指向扩展点 concept（Intersect / Union，见 §4）。
        if (op == "&&" or op == "||" or op == "&" or op == "|") {
            if (tip_kind(lt) == "BitStr" and tip_kind(rt) == "BitStr") {
                return ti_mk("BitStr");
            }
            // 位域（packed struct）交 / 并 = 宿主整型 AND / OR。两侧须是**同一个**位域类型：
            // 位域是名义类型、位宽由布局定死，没有 bitstr 那种「取 max + 零扩展」的依据，
            // 跨位域类型的交 / 并没有良定义的位对应关系（谁的第 3 位对应谁的哪一位？）。
            if (tip_is_packed(lt) and tip_is_packed(rt)) {
                if (ti_equal(lt, rt)) {
                    return lt;
                }
                var sbf: StringBuilder = sb_new();
                sb_append_str(sbf, "集合运算符 `");
                sb_append_str(sbf, op);
                sb_append_str(sbf, "` 两侧位域类型不同：");
                sb_append_str(sbf, ti_str(lt));
                sb_append_str(sbf, " 与 ");
                sb_append_str(sbf, ti_str(rt));
                sb_append_str(sbf, "；位域是名义类型且位宽由布局定死，不支持跨位域类型的交 / 并");
                parse.fc_err("T-SET-E104", sb_to_str(sbf), e);
                return ti_mk("Unknown");
            }
            // 仅一侧是位域：`&&` / `||` 本就报错；`&` / `|` 此前静默放行并在后端产出
            // 非法 IR（`and %Perm`），此处一并收口为结构化报错。
            if (op == "&&" or op == "||" or tip_is_packed(lt) or tip_is_packed(rt)) {
                var sbset: StringBuilder = sb_new();
                var setname: string = "交集";
                var setcode: string = "T-SET-E101";
                if (op == "||") {
                    setname = "并集";
                    setcode = "T-SET-E102";
                }
                sb_append_str(sbset, "集合运算符 `");
                sb_append_str(sbset, op);
                sb_append_str(sbset, "`（");
                sb_append_str(sbset, setname);
                sb_append_str(sbset, "）不支持当前类型：");
                sb_append_str(sbset, ti_str(lt));
                sb_append_str(sbset, " 与 ");
                sb_append_str(sbset, ti_str(rt));
                // ⚠ 文案不指向 `Intersect` / `Union` concept：那套扩展机制目前**只有设计、没有实装**
                //   （src/lib 里查无此 concept），指向它等于承诺一个用户根本无法实现的扩展点 ——
                //   与 §12.2 的 `^^` 同款缺陷。同理不再写"只覆盖 bitstr"（位域亦已支持）。
                sb_append_str(sbset, "；内建实现目前只覆盖 bitstr 与位域（packed struct）");
                sb_append_str(sbset, "（布尔逻辑请用 `and` / `or`）");
                parse.fc_err(setcode, sb_to_str(sbset), e);
                return ti_mk("Unknown");
            }
        }
        // `^` 对集合类型（bitstr / 位域）：差集与对称差的运算符**留待后续批次设计**，当前一律
        // 不支持 —— 不能沿用「返回左操作数类型」的兜底，那会让后端产出非法 IR
        // （实测 `Perm ^ i64` → 0 error，却在 LLVM 校验期炸 `xor %Perm %a, %b`）。
        // ⚠ 判定用「任一侧」而非「两侧」：`&` / `|` 的单侧缺口已收口，`^` 曾漏掉单侧
        //   （`Perm ^ i64` / `i64 ^ bitstr` 均 0 error + 后端非法 IR），此处按同一口径补上。
        // ⚠ 文案**不指名**尚未设计的符号（如 `^^`）—— 那等于对未定项做承诺，
        //   用户撞到报错会被指向一个根本不存在、也没定义过拼写的运算符。
        if (op == "^") {
            if (tip_kind(lt) == "BitStr" or tip_kind(rt) == "BitStr") {
                parse.fc_err("T-SET-E103",
                    "位串不支持 `^`：集合代数当前只提供 `&&`（交）与 `||`（并）；差集 / 对称差的运算符留待后续批次设计", e);
                return ti_mk("Unknown");
            }
            if (tip_is_packed(lt) and tip_is_packed(rt) and ti_equal(lt, rt) == false) {
                // 两侧位域但类型不同：与 `&&` / `||` 同口径报 E104 —— 位域是名义类型、
                // 位宽由布局定死，跨位域类型没有良定义的位对应关系（比"`^` 不支持"更根本）。
                var sbx: StringBuilder = sb_new();
                sb_append_str(sbx, "集合运算符 `^` 两侧位域类型不同：");
                sb_append_str(sbx, ti_str(lt));
                sb_append_str(sbx, " 与 ");
                sb_append_str(sbx, ti_str(rt));
                sb_append_str(sbx, "；位域是名义类型且位宽由布局定死，不支持跨位域类型的集合运算");
                parse.fc_err("T-SET-E104", sb_to_str(sbx), e);
                return ti_mk("Unknown");
            }
            if (tip_is_packed(lt) or tip_is_packed(rt)) {
                parse.fc_err("T-SET-E105",
                    "位域不支持 `^`：集合代数当前只提供 `&&`（交）与 `||`（并）；差集 / 对称差的运算符留待后续批次设计", e);
                return ti_mk("Unknown");
            }
        }
        if (op == "==" or op == "!=" or op == "<" or op == ">" or op == "<=" or op == ">=") {
            return ti_scalar("bool");
        }
        // bool 逻辑（§set-ops step1）：`and` / `or` 与 `&&` / `||` 同为布尔逻辑与/或
        if (op == "and" or op == "or") {
            return ti_scalar("bool");
        }
        // §set-ops step1：值级 `&&`/`||` 在第一步仍作布尔（与 `and`/`or` 同义，见上方分支），
        // 集合交集/并集语义推迟到第二步；此处不再为值级 "&&"/"||" 派发集合错误（T-SET-E101/E102）。
        if (tip_kind(lt) == "Scalar" and tip_kind(rt) == "Scalar") {
            if (ti_equal(lt, rt)) {
                return lt;
            }
            var llit: bool = base.node_kind((base.node_na((e as u64)) as u64)) == "int";
            var rlit: bool = base.node_kind((base.node_nb((e as u64)) as u64)) == "int";
            if (llit and rlit == false) {
                return rt;
            }
            if (rlit and llit == false) {
                return lt;
            }
            if (llit and rlit) {
                return lt;
            }
            var di: i64 = base.diag_new("T-SEM-E203", "error",
                base.sb_cat6("binary operator '", op, "' requires same types, got ", ti_str(lt), " and ", ti_str(rt)),
                "", 1, 1, 1, 5);
            base.slb_begin();
            base.slb_add("use explicit cast: `expr as Type`");
            base.diag_set_nt(di, base.slb_head);
        }
        if (tip_kind(lt) != "Unknown") {
            return lt;
        }
        return rt;
    }
    if (k == "unary") {
        var ot: i64 = ie_sub(ei, 0, base.node_na((e as u64)));
        if (base.node_sa((e as u64)) == "!") {
            return ti_scalar("bool");
        }
        return ot;
    }
    if (k == "assign") {
        var atl: i64 = ie_sub(ei, 0, base.node_na((e as u64)));
        var saved_ve0: i64 = g_vec_expect;
        var saved_te0: i64 = g_tile_expect;
        var saved_le0: i64 = g_lead_expect;
        if (ti_is_vector(atl)) { g_vec_expect = atl; g_tile_expect = -1; }
        else if (ti_is_tile(atl)) { g_tile_expect = atl; g_vec_expect = -1; }
        else { g_vec_expect = -1; g_tile_expect = -1; }
        // 前导点 `.{...}` 右侧：按 LHS 类型注入上下文（与 var_decl/return/assignment 一致）
        g_lead_expect = atl;
        var atr: i64 = ie_sub(ei, 1, base.node_nb((e as u64)));
        g_vec_expect = saved_ve0;
        g_tile_expect = saved_te0;
        g_lead_expect = saved_le0;
        // 解引用赋值 `*r = v`：仅当 r 为可变绑定（var）时允许，否则就是只读引用。
        if (base.node_kind((base.node_na((e as u64)) as u64)) == "deref") {
            var dop: i64 = base.node_na((base.node_na((e as u64)) as u64));
            if (dop >= 0 and base.node_kind((dop as u64)) == "ident") {
                var dsi: i64 = sym_lookup(cur_scope, base.node_sa((dop as u64)));
                if (dsi < 0) { dsi = sym_lookup(global_scope, base.node_sa((dop as u64))); }
                if (dsi >= 0) {
                    var ddecl: i64 = syms[dsi].decl;
                    if (ddecl >= 0 and base.node_kind((ddecl as u64)) == "var_decl" and base.node_ba((ddecl as u64)) == true) {
                        parse.fc_err("T-SEM-E762",
                            base.sb_cat3("不能透过只读引用 `", base.node_sa((dop as u64)),
                                "` 写入：它由 `let`/`const` 声明（只读），要用可变引用请改用 `var` 声明"),
                            base.node_na((e as u64)));
                    }
                }
            }
        }
        // 逃逸分析（T-SEM-E764）：把对局部变量/参数的引用 `&局部` 赋给更长寿的目标
        // （全局变量 / 全局字段 / 全局元素）会悬垂（dangling）。`g = &a` 中 g 为全局、
        // &a 指向局部 → 该引用在函数返回后失效，写入全局即逃逸。
        // 注：普通 `a = b` 语句实际是 assign 节点（见 mk_assign），statement 级 assignment
        // 节点仅用于复合赋值（a, b = ...），故检查点放在此处而非 assignment 分支。
        if (expr_has_local_addr(base.node_nb((e as u64))) and assign_target_escapable(base.node_na((e as u64)))) {
            parse.fc_err("T-SEM-E764",
                "把对局部变量/参数的引用存入更长寿的目标（全局）会产生悬垂指针（dangling）",
                base.node_nb((e as u64)));
        }
