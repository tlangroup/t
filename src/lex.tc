// ══════════════════════════════════════════════════════════════════
// src/lex.tc — 编译步骤 1：词法分析
//
// 内容：字符分类、关键字表、tokenize()、token 流访问器（cur_t / advance_i / tk_v）。
// 依赖：base。
// ══════════════════════════════════════════════════════════════════

const base = @import("src.base");

pub fn is_ident_start(cp: i64) bool {
    if (cp == 95) { return true; }
    return base.is_xid_start(cp);
}

// 标识符续字符：XID_Continue + 下划线 + 数字（数字本就在 XID_Continue 内，显式列出无害）。
pub fn is_ident_cont(cp: i64) bool {
    if (cp == 95) { return true; }
    if (cp >= 48 && cp <= 57) { return true; }
    return base.is_xid_cont(cp);
}

pub fn is_hex_digit(c: u8) bool {
    if (c >= 48 && c <= 57) { return true; }
    if (c >= 97 && c <= 102) { return true; }
    return c >= 65 && c <= 70;
}

pub fn is_bin_digit(c: u8) bool {
    return c == 48 || c == 49;
}

// >>> GEN:kw_lookup (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
pub struct KwEntry {
    text: string;
    kind: string;
}

pub var keywords_tbl: []KwEntry;

pub fn kw_reg(t: string, k: string) void {
    var e: KwEntry;
    e.text = t;
    e.kind = k;
    append(keywords_tbl, e);
}

pub fn init_keywords() void {
    kw_reg("fn", "KwFunc");
    kw_reg("struct", "KwStruct");
    kw_reg("enum", "KwEnum");
    kw_reg("flag", "KwFlag");
    kw_reg("union", "KwUnion");
    kw_reg("variant", "KwVariant");
    kw_reg("agent", "KwAgent");
    kw_reg("var", "KwVar");
    kw_reg("const", "KwConst");
    kw_reg("let", "KwLet");   // 动态常量：运行期绑定一次后不可变（三关键字模型；宪法「人类编程友好」）
    kw_reg("comptime", "KwComptime");   // 编译期关键字：编译期求值 / 泛型类型参数 / 编译期声明（原 meta 别名已撤销）
    kw_reg("meta", "KwMeta");           // 保留关键字：当前无语义，留作他用（编译期功能已由 comptime 统一承载）；禁止用户用作标识符
    kw_reg("type", "KwType");        // comptime T: type 的「类型之类型」占位关键字（与 any 同语义）
    kw_reg("if", "KwIf");
    kw_reg("else", "KwElse");
    kw_reg("match", "KwMatch");
    kw_reg("when", "KwWhen");
    kw_reg("for", "KwFor");
    kw_reg("while", "KwWhile");
    kw_reg("break", "KwBreak");
    kw_reg("continue", "KwContinue");
    kw_reg("return", "KwReturn");
    kw_reg("true", "KwTrue");
    kw_reg("false", "KwFalse");
    kw_reg("null", "KwNull");
    kw_reg("map", "KwMap");
    kw_reg("import", "KwImport");
    // `export` 关键字已删除（模块可见性由 `pub` 声明 + `@module(pub)` 共同决定，见 §3.13）。旧 `import(X)`/`export` 语法统一移除。
    kw_reg("pub", "KwPub");         // 声明级可见性：`pub fn` / `pub struct` …；跨包可访问还要求所在文件 `@module(pub)`
    kw_reg("as", "KwAs");
    kw_reg("in", "KwIn");
    kw_reg("defer", "KwDefer");
    kw_reg("void", "KwVoid");
    kw_reg("unit", "KwUnit");
    kw_reg("string", "KwString");
    kw_reg("StringBuilder", "KwStringBuilder");
    kw_reg("auto", "KwAuto");
    kw_reg("any", "KwAny");
    kw_reg("kernel", "KwKernel");   // Device 子系统：设备入口限定符 `kernel fn`（host 双后端跳过，codegen_dev 处理；见 docs/compiler/device-design.md §2 L2）
    kw_reg("overload", "KwOverload"); // overload 上下文关键词（Route 1）：标记同名函数子句声明组；待 L-15 可降级为上下文关键词
    kw_reg("extend", "KwExtend");     // `extend overload fn name(...)`：向已存在声明组追加子句（当前为保留关键字）
}

pub fn kw_lookup(text: string) string {
    var i: i64 = 0;
    while (i < (slice_len(keywords_tbl) as i64)) {
        if (keywords_tbl[i].text == text) { return keywords_tbl[i].kind; }
        i = i + 1;
    }
    return "";
}
// <<< GEN:kw_lookup <<<


pub fn op2_name(a: u8, b: u8) string {
    if (a == 45 && b == 62) { return "Arrow"; }
    if (a == 61 && b == 62) { return "FatArrow"; }
    if (a == 58 && b == 58) { return "DoubleColon"; }
    if (a == 61 && b == 61) { return "Eq"; }
    if (a == 33 && b == 61) { return "NotEq"; }
    if (a == 60 && b == 61) { return "LtEq"; }
    if (a == 62 && b == 61) { return "GtEq"; }
    if (a == 38 && b == 38) { return "And"; }
    if (a == 124 && b == 124) { return "Or"; }
    if (a == 60 && b == 60) { return "ShiftLeft"; }
    if (a == 62 && b == 62) { return "ShiftRight"; }
    // 区间字面量（M-range）：`..` 半开、`..=` 闭合（三字符形态在扫描主循环先行匹配）。
    // 与浮点/成员访问零冲突：数字扫描要求 `.` 后紧跟数字才吃小数点，故 `0..10`
    // 天然切成 `0` / `..` / `10`；`a.b` 的单点仍走 op1_name 的 Dot。
    if (a == 46 && b == 46) { return "DotDot"; }
    // 集合合并符 `++`（bitstr/Slice/String/... 合并，与数值 `+` 解耦；§15.6）。
    // 不与 `+=`(43,61) 冲突；`+++` 按最大匹配切成 `++` + `+`。
    if (a == 43 && b == 43) { return "PlusPlus"; }
    if (a == 43 && b == 61) { return "PlusAssign"; }
    if (a == 45 && b == 61) { return "MinusAssign"; }
    if (a == 42 && b == 61) { return "StarAssign"; }
    if (a == 47 && b == 61) { return "SlashAssign"; }
    if (a == 37 && b == 61) { return "PercentAssign"; }
    if (a == 38 && b == 61) { return "BitAndAssign"; }
    if (a == 124 && b == 61) { return "BitOrAssign"; }
    // 管道算子（最低二元级 L0）：`|>` 多态管道。三字符 `|->` / `|>?` 在扫描主循环
    // 的三字符段先行匹配，故此处只需处理两字符形态，最大匹配顺序天然正确。
    if (a == 124 && b == 62) { return "PipeApply"; }
    if (a == 94 && b == 61) { return "BitXorAssign"; }
    return "";
}

pub fn op1_name(c: u8) string {
    if (c == 43) { return "Plus"; }
    if (c == 45) { return "Minus"; }
    if (c == 42) { return "Star"; }
    if (c == 47) { return "Slash"; }
    if (c == 37) { return "Percent"; }
    if (c == 61) { return "Assign"; }
    if (c == 60) { return "Lt"; }
    if (c == 62) { return "Gt"; }
    if (c == 33) { return "Not"; }
    if (c == 38) { return "BitAnd"; }
    if (c == 124) { return "BitOr"; }
    if (c == 94) { return "BitXor"; }
    if (c == 126) { return "BitNot"; }
    if (c == 58) { return "Colon"; }
    if (c == 46) { return "Dot"; }
    if (c == 63) { return "Question"; }
    if (c == 40) { return "LParen"; }
    if (c == 41) { return "RParen"; }
    if (c == 123) { return "LBrace"; }
    if (c == 125) { return "RBrace"; }
    if (c == 91) { return "LBracket"; }
    if (c == 93) { return "RBracket"; }
    if (c == 44) { return "Comma"; }
    if (c == 59) { return "Semicolon"; }
    return "";
}

// ── 字面量扫描辅助（reference.md §2.4）────────────────────────
//
// 数字位串：从 s0 起按 radix 吃数字位，`_` 是**纯视觉分隔符**、被剥除，
// 规范化后的数字追加到 out；返回停止处的下标。`_` 必须夹在两个同段数字位
// 之间，否则报 T-LEX-E004 并停在该 `_` 上（数字段内不含换行，故列号可由
// 下标差直接推出）。
pub fn lex_digit_run(src: string, s0: u64, radix: i64, out: StringBuilder, dl: u64, dc: u64) u64 {
    var n: u64 = str_len(src);
    var j: u64 = s0;
    var prev_digit: bool = false;
    while (j < n) {
        var ch: u8 = src[j];
        if (ch == 95) {
            var rnext: bool = false;
            if (j + 1 < n) { rnext = base.radix_digit_val(src[j + 1], radix) >= 0; }
            if (prev_digit == false || rnext == false) {
                var ec: i64 = (dc + (j - s0)) as i64;
                base.diag_new("T-LEX-E004", "error",
                    "数字分隔符 `_` 必须夹在两个数字位之间（例：`1_000_000` / `0xFF_FF`）",
                    base.g_file, dl as i64, ec, dl as i64, ec + 1);
                return j;
            }
            j = j + 1;
            continue;
        }
        if (base.radix_digit_val(ch, radix) < 0) { break; }
        sb_append_char(out, ch);
        prev_digit = true;
        j = j + 1;
    }
    return j;
}

// ── token 入池 ─────────────────────────────────────────────────

pub fn push_tok(tname: string, value: string, line: u64, col: u64) void {
    var tk: Tok;
    tk.t = tname;
    tk.v = value;
    tk.line = line;
    tk.col = col;
    append(base.toks, tk);
}

// ── lexer：源码 → token 池（逻辑照抄 lexer.tc）─────────────────

pub fn tokenize(src: string) void {
    var tmp: StringBuilder = sb_new();
    var i: u64 = 0;
    var n: u64 = str_len(src);
    var line: u64 = 1;
    var col: u64 = 1;

    while (i < n) {
        var c: u8 = src[i];

        if (c == 32 || c == 9 || c == 13) {
            i = i + 1;
            col = col + 1;
            continue;
        }
        if (c == 10) {
            i = i + 1;
            line = line + 1;
            col = 1;
            continue;
        }

        if (c == 47 && i + 1 < n && src[i + 1] == 47) {
            while (i < n && src[i] != 10) {
                i = i + 1;
                col = col + 1;
            }
            continue;
        }

        if (c == 47 && i + 1 < n && src[i + 1] == 42) {
            i = i + 2;
            col = col + 2;
            var closed: bool = false;
            while (i < n) {
                if (src[i] == 42 && i + 1 < n && src[i + 1] == 47) {
                    i = i + 2;
                    col = col + 2;
                    closed = true;
                    break;
                }
                if (src[i] == 10) {
                    line = line + 1;
                    col = 1;
                } else {
                    col = col + 1;
                }
                i = i + 1;
            }
            if (closed == false) {
                eprint("error: unterminated block comment\n");
                exit(1);
            }
            continue;
        }

        // ── 数字字面量（reference.md §2.4）───────────────────────
        // token 文本已**规范化**：剥除 `_`，浮点尾数补足小数点（`1e9` → `1.0e9`，
        // 因为 LLVM 的 FP 常量语法要求尾数含 `.`），位宽后缀原样留在末尾交给
        // parser 用 `lit_suffix_of` / `lit_body_of` 切分。
        if (base.is_digit(c)) {
            var tl: u64 = line;
            var tcol: u64 = col;
            sb_clear(tmp);
            var nradix: i64 = 10;

            if (c == 48 && i + 1 < n && (src[i + 1] == 120 || src[i + 1] == 88)) {
                nradix = 16; sb_append_str(tmp, "0x"); i = i + 2; col = col + 2;
            } else if (c == 48 && i + 1 < n && (src[i + 1] == 98 || src[i + 1] == 66)) {
                nradix = 2;  sb_append_str(tmp, "0b"); i = i + 2; col = col + 2;
            } else if (c == 48 && i + 1 < n && (src[i + 1] == 111 || src[i + 1] == 79)) {
                nradix = 8;  sb_append_str(tmp, "0o"); i = i + 2; col = col + 2;
            }

            var d0: u64 = i;
            var di: u64 = lex_digit_run(src, i, nradix, tmp, line, col);
            col = col + (di - i);
            i = di;
            if (i == d0) {
                base.diag_new("T-LEX-E004", "error",
                    "进制前缀 `0x` / `0b` / `0o` 之后必须至少有一位该进制的数字",
                    base.g_file, tl as i64, tcol as i64, tl as i64, (tcol + 2) as i64);
            }

            var is_float: bool = false;
            if (nradix == 10) {
                // 小数部分：`.` 之后必须紧跟数字。`1.` 与 `.5` 不是合法字面量
                // （既保住 `1.method` 的成员访问，也避免与区间语法争抢 `..`）。
                if (i < n && src[i] == 46 && i + 1 < n && base.is_digit(src[i + 1])) {
                    is_float = true;
                    sb_append_char(tmp, 46);
                    i = i + 1;
                    col = col + 1;
                    var fi: u64 = lex_digit_run(src, i, 10, tmp, line, col);
                    col = col + (fi - i);
                    i = fi;
                }
                // 指数部分：`e` / `E` 之后可选符号 + 至少一位十进制数字。
                if (i < n && (src[i] == 101 || src[i] == 69)) {
                    var esign: u64 = 0;
                    if (i + 1 < n && (src[i + 1] == 43 || src[i + 1] == 45)) { esign = 1; }
                    var edigit: bool = false;
                    if (i + 1 + esign < n) { edigit = base.is_digit(src[i + 1 + esign]); }
                    if (edigit == false) {
                        base.diag_new("T-LEX-E004", "error",
                            "指数标记 `e` / `E` 之后必须跟（可选 `+` / `-` 加）至少一位数字",
                            base.g_file, line as i64, col as i64, line as i64, (col + 1) as i64);
                    } else {
                        if (is_float == false) { sb_append_str(tmp, ".0"); is_float = true; }
                        sb_append_char(tmp, 101);
                        i = i + 1;
                        col = col + 1;
                        if (esign == 1) {
                            sb_append_char(tmp, src[i]);
                            i = i + 1;
                            col = col + 1;
                        }
                        var xi: u64 = lex_digit_run(src, i, 10, tmp, line, col);
                        col = col + (xi - i);
                        i = xi;
                    }
                }
            }

            // 位宽后缀：仅当 `u`/`i`/`f` 紧跟数字时才按后缀读，否则退回标识符
            // （`1if` 仍是 `1` + `if`，`10s` 仍是 `10` + `s`）。
            var nsfx: string = "";
            if (i < n && (src[i] == 117 || src[i] == 105 || src[i] == 102)
                && i + 1 < n && base.is_digit(src[i + 1])) {
                var sfx0: u64 = i;
                var wcol: u64 = col;
                while (i < n && base.is_ascii_word(src[i])) {
                    i = i + 1;
                    col = col + 1;
                }
                nsfx = str_slice(src, sfx0, i);
                if (base.num_suffix_bits(nsfx) < 0) {
                    base.diag_new("T-LEX-E005", "error",
                        base.sb_cat3("非法位宽后缀 `", nsfx,
                            "`；合法集：u8 u16 u32 u64 i8 i16 i32 i64 f32 f64"),
                        base.g_file, tl as i64, wcol as i64, tl as i64, col as i64);
                    nsfx = "";
                } else if (base.num_suffix_is_float(nsfx)) {
                    if (nradix != 10) {
                        base.diag_new("T-LEX-E005", "error",
                            base.sb_cat3("非十进制字面量不能带浮点后缀 `", nsfx,
                                "`（`0x` / `0b` / `0o` 只接受整数后缀）"),
                            base.g_file, tl as i64, wcol as i64, tl as i64, col as i64);
                        nsfx = "";
                    } else if (is_float == false) {
                        sb_append_str(tmp, ".0");
                        is_float = true;
                    }
                } else if (is_float) {
                    base.diag_new("T-LEX-E005", "error",
                        base.sb_cat3("浮点字面量不能带整数后缀 `", nsfx,
                            "`（改用 f32 / f64，或去掉小数点与指数）"),
                        base.g_file, tl as i64, wcol as i64, tl as i64, col as i64);
                    nsfx = "";
                }
            }
            if (str_len(nsfx) > 0) { sb_append_str(tmp, nsfx); }

            if (is_float) {
                push_tok("Float", sb_to_str(tmp), tl, tcol);
            } else {
                push_tok("Integer", sb_to_str(tmp), tl, tcol);
            }
            continue;
        }

        // ── 字节字符字面量 `'A'`（reference.md §2.4）──────────────
        // 语义 = 一个 0..255 的字节，直接以整数 token 入池（无独立节点种类）。
        if (c == 39) {
            var cl0: u64 = line;
            var ccol0: u64 = col;
            sb_clear(tmp);
            var ci: u64 = i + 1;
            var ccol: u64 = col + 1;
            var cclosed: bool = false;
            while (ci < n) {
                if (src[ci] == 39) { cclosed = true; break; }
                if (src[ci] == 10) { break; }
                if (src[ci] == 92) {
                    var ce: u64 = base.esc_decode(src, ci + 1, tmp, cl0 as i64, ccol as i64);
                    ccol = ccol + (ce - ci);
                    ci = ce;
                    continue;
                }
                sb_append_char(tmp, src[ci]);
                ci = ci + 1;
                ccol = ccol + 1;
            }
            var cbody: string = sb_to_str(tmp);
            if (cclosed == false) {
                base.diag_new("T-LEX-E007", "error",
                    "字节字符字面量未终结（缺少收尾的 `'`）",
                    base.g_file, cl0 as i64, ccol0 as i64, cl0 as i64, (ccol0 + 1) as i64);
                i = ci;
                col = ccol;
                push_tok("Integer", "0", cl0, ccol0);
                continue;
            }
            i = ci + 1;
            col = ccol + 1;
            if (str_len(cbody) == 0) {
                base.diag_new("T-LEX-E007", "error",
                    "字节字符字面量不能为空",
                    base.g_file, cl0 as i64, ccol0 as i64, cl0 as i64, col as i64);
                push_tok("Integer", "0", cl0, ccol0);
                continue;
            }
            if (str_len(cbody) == 1) {
                // 单字节 → u8 字节字面量（与既有行为一致，不破坏现有 'A' 用法）
                push_tok("Integer", base.i2s(cbody[0] as i64), cl0, ccol0);
                continue;
            }
            // 多字节 UTF-8 → rune 字面量（Unicode 码点，内部 i32）；
            // `'中'` 因此成为合法的 rune 字面量（见 docs/reference.md §2.4 rune）。
            // 但整段必须恰好是「一个」合法 UTF-8 码点：前导字节决定应有的字节数，
            // 正文长度须严丝合缝，续字节须落在 0x80..0xBF；否则（如 'ab' 两个 ASCII
            // 字节、'中x' 多出尾字节、续字节非法）一律报 BAD_CHAR_LITERAL，绝不静默降级。
            var rb0: i64 = cbody[0] as i64;
            var ulen: i64 = 0;
            var rcp: i64 = 0;
            var okc: bool = true;
            if (rb0 >= 0xC2 && rb0 <= 0xDF) {
                ulen = 2;
                rcp = ((rb0 & 0x1F) << 6) | (cbody[1] as i64 & 0x3F);
            } else if ((rb0 & 0xF0) == 0xE0) {
                ulen = 3;
                rcp = ((rb0 & 0x0F) << 12) | ((cbody[1] as i64 & 0x3F) << 6) | (cbody[2] as i64 & 0x3F);
            } else if ((rb0 & 0xF8) == 0xF0) {
                ulen = 4;
                rcp = ((rb0 & 0x07) << 18) | ((cbody[1] as i64 & 0x3F) << 12) | ((cbody[2] as i64 & 0x3F) << 6) | (cbody[3] as i64 & 0x3F);
            } else {
                okc = false;   // ASCII 前导字节（长度>1 却非单字节）或非法/过长短前导字节
            }
            if (okc == true && str_len(cbody) == ulen) {
                // 续字节须落在 0x80..0xBF（剔除过长/非法序列）
                var vci: i64 = 1;
                while (vci < ulen) {
                    var cb: i64 = cbody[vci] as i64;
                    if ((cb & 0xC0) != 0x80) { okc = false; }
                    vci = vci + 1;
                }
            } else {
                okc = false;
            }
            if (okc == false) {
                base.diag_new("T-LEX-E007", "error",
                    "字符字面量非法：`'...'` 必须恰好一个字节（byte/u8）或一个合法 UTF-8 码点（rune），不能拼多个字节或含非法续字节",
                    base.g_file, cl0 as i64, ccol0 as i64, cl0 as i64, col as i64);
                push_tok("Integer", "0", cl0, ccol0);
                continue;
            }
            push_tok("Integer", base.i2s(rcp), cl0, ccol0);
            continue;
        }

        // ── 原始字符串 `r"..."` / `r"""..."""`（reference.md §2.4）──
        // 反斜杠零特权：内容逐字节原样入串。触发条件与 f-string 同构 —— 前一个
        // 字符不能是标识符续字符或 `.`，否则 `var r = ...; r"x"` 这类会被误判。
        if (c == 114 && i + 1 < n && src[i + 1] == 34) {
            var rPrevOk: bool = true;
            if (i > 0) {
                var rpc: u8 = src[i - 1];
                if (rpc == 46 || is_ident_cont(rpc as i64)) { rPrevOk = false; }
            }
            if (rPrevOk) {
                var rl: u64 = line;
                var rcol: u64 = col;
                var rLong: bool = (i + 3 < n && src[i + 2] == 34 && src[i + 3] == 34);
                var rk: u64 = i + 2;
                col = col + 2;
                if (rLong) { rk = i + 4; col = col + 2; }
                sb_clear(tmp);
                var rClosed: bool = false;
                while (rk < n) {
                    if (rLong) {
                        if (src[rk] == 34 && rk + 2 < n && src[rk + 1] == 34 && src[rk + 2] == 34) {
                            rk = rk + 3;
                            col = col + 3;
                            rClosed = true;
                            break;
                        }
                    } else if (src[rk] == 34) {
                        rk = rk + 1;
                        col = col + 1;
                        rClosed = true;
                        break;
                    }
                    if (src[rk] == 10) {
                        if (rLong == false) {
                            // 就地收尾：不吞掉后续源码，避免一个漏引号污染整个文件。
                            base.diag_new("T-LEX-E003", "error",
                                "单引号形态的原始字符串内不得出现裸换行；改用 `r\"\"\"...\"\"\"`",
                                base.g_file, line as i64, col as i64, line as i64, (col + 1) as i64);
                            rClosed = true;
                            break;
                        }
                        line = line + 1;
                        col = 1;
                    } else {
                        col = col + 1;
                    }
                    sb_append_char(tmp, src[rk]);
                    rk = rk + 1;
                }
                if (rClosed == false) {
                    base.diag_new("T-LEX-E008", "error",
                        "原始字符串未终结",
                        base.g_file, rl as i64, rcol as i64, rl as i64, (rcol + 2) as i64);
                }
                i = rk;
                push_tok("String", sb_to_str(tmp), rl, rcol);
                continue;
            }
        }

        // ── 字符串字面量：`"..."` 单行形态 / `"""..."""` 长字符串 ──
        // 两者都做转义解码（原始语义请用 `r` 前缀）；区别只在于长字符串允许裸
        // 换行。单行形态遇裸换行是硬错误 T-LEX-E003：历史实现放行，与 §2.4
        // 「不得跨行」矛盾，属实现漂移。
        if (c == 34) {
            var sl: u64 = line;
            var scol: u64 = col;
            var sLong: bool = (i + 2 < n && src[i + 1] == 34 && src[i + 2] == 34);
            i = i + 1;
            col = col + 1;
            if (sLong) {
                i = i + 2;
                col = col + 2;
            }
            sb_clear(tmp);
            var sClosed: bool = false;
            while (i < n) {
                if (sLong) {
                    if (src[i] == 34 && i + 2 < n && src[i + 1] == 34 && src[i + 2] == 34) {
                        i = i + 3;
                        col = col + 3;
                        sClosed = true;
                        break;
                    }
                } else if (src[i] == 34) {
                    i = i + 1;
                    col = col + 1;
                    sClosed = true;
                    break;
                }
                if (src[i] == 92) {
                    var se: u64 = base.esc_decode(src, i + 1, tmp, line as i64, col as i64);
                    col = col + (se - i);
                    i = se;
                    continue;
                }
                if (src[i] == 10) {
                    if (sLong == false) {
                        // 就地收尾：不吞掉后续源码，避免一个漏引号污染整个文件。
                        base.diag_new("T-LEX-E003", "error",
                            "单行字符串内不得出现裸换行；改写成 `\\n` 或改用 `\"\"\"...\"\"\"` 长字符串",
                            base.g_file, line as i64, col as i64, line as i64, (col + 1) as i64);
                        sClosed = true;
                        break;
                    }
                    line = line + 1;
                    col = 1;
                } else {
                    col = col + 1;
                }
                sb_append_char(tmp, src[i]);
                i = i + 1;
            }
            if (sClosed == false) {
                if (sLong) {
                    base.diag_new("T-LEX-E008", "error",
                        "长字符串未终结（缺少收尾的 `\"\"\"`）",
                        base.g_file, sl as i64, scol as i64, sl as i64, (scol + 3) as i64);
                } else {
                    base.diag_new("T-LEX-E000", "error",
                        "字符串字面量未终结",
                        base.g_file, sl as i64, scol as i64, sl as i64, (scol + 1) as i64);
                }
            }
            push_tok("String", sb_to_str(tmp), sl, scol);
            continue;
        }

        // ── f-string 字面量（M-fstr）：`f"..."` / `f"""..."""` ──
        // 仅当 'f' 紧跟 `"` 且不是标识符/成员访问的一部分时触发（避免 `obj.f"..."`
        // 或 `xf"..."` 被误判）。插值 `{Expr}` 内的字符串/括号在扫描期被跳过，
        // 以保证能正确找到终结引号；原始文本（含 `f"`/`f"""` 与闭合引号）整体入池。
        if (c == 102 && i + 1 < n && src[i + 1] == 34) {
            var prevOk: bool = true;
            if (i > 0) {
                var pc2: u8 = src[i - 1];
                if (pc2 == 46 || is_ident_cont(pc2 as i64)) { prevOk = false; }
            }
            if (prevOk) {
                var fl: u64 = line;
                var fcol: u64 = col;
                var isLong: bool = (i + 3 < n && src[i + 1] == 34 && src[i + 2] == 34 && src[i + 3] == 34);
                sb_clear(tmp);
                sb_append_char(tmp, 102);             // 'f'
                sb_append_char(tmp, 34);              // 起始引号
                var fsi: u64 = i + 2;
                var fscol: u64 = col + 2;
                if (isLong) {
                    sb_append_char(tmp, 34);
                    sb_append_char(tmp, 34);
                    fsi = i + 4;
                    fscol = col + 4;
                }
                var fdepth: i64 = 0;
                var closed: bool = false;
                while (fsi < n) {
                    var fch: u8 = src[fsi];
                    if (fdepth == 0) {
                        if (isLong) {
                            if (fch == 34 && fsi + 2 < n && src[fsi + 1] == 34 && src[fsi + 2] == 34) {
                                closed = true;
                                break;
                            }
                        } else {
                            if (fch == 34) {
                                closed = true;
                                break;
                            }
                        }
                        if (fch == 123) {             // '{'
                            if (fsi + 1 < n && src[fsi + 1] == 123) {   // '{{'
                                sb_append_char(tmp, 123);
                                sb_append_char(tmp, 123);
                                fsi = fsi + 2;
                                fscol = fscol + 2;
                                continue;
                            }
                            fdepth = fdepth + 1;
                            sb_append_char(tmp, 123);
                            fsi = fsi + 1;
                            fscol = fscol + 1;
                            continue;
                        }
                        if (fch == 125) {             // '}'
                            if (fsi + 1 < n && src[fsi + 1] == 125) {   // '}}'
                                sb_append_char(tmp, 125);
                                sb_append_char(tmp, 125);
                                fsi = fsi + 2;
                                fscol = fscol + 2;
                                continue;
                            }
                            eprint("error: unmatched '}' in f-string literal\n");
                            exit(1);
                        }
                        if (fch == 92) {              // 反斜杠转义：原样保留
                            sb_append_char(tmp, 92);
                            fsi = fsi + 1;
                            fscol = fscol + 1;
                            if (fsi >= n) { break; }
                            var fe2: u8 = src[fsi];
                            sb_append_char(tmp, fe2);
                            if (fe2 == 10) { line = line + 1; fscol = 1; }
                            else { fscol = fscol + 1; }
                            fsi = fsi + 1;
                            // ⚠ `\u{...}` 的 `{` 若落回主循环会被当成插值起点，
                            // 于是 `f"\u{4e2d}"` 会被拆成一个不存在的表达式。
                            // 这里把整段码点原样吞进模板，交给 parse 的 esc_decode。
                            if (fe2 == 117 && fsi < n && src[fsi] == 123) {
                                while (fsi < n && src[fsi] != 125) {
                                    sb_append_char(tmp, src[fsi]);
                                    fsi = fsi + 1;
                                    fscol = fscol + 1;
                                }
                                if (fsi < n) {
                                    sb_append_char(tmp, 125);
                                    fsi = fsi + 1;
                                    fscol = fscol + 1;
                                }
                            }
                            continue;
                        }
                        sb_append_char(tmp, fch);
                        if (fch == 10) { line = line + 1; fscol = 1; }
                        else { fscol = fscol + 1; }
                        fsi = fsi + 1;
                        continue;
                    }
                    // fdepth > 0：插值表达式内部，需跳过其中的字符串字面量与配对括号
                    if (fch == 34) {                  // 表达式内的字符串字面量
                        var fsLong2: bool = (fsi + 2 < n && src[fsi + 1] == 34 && src[fsi + 2] == 34);
                        sb_append_char(tmp, 34);
                        fsi = fsi + 1;
                        fscol = fscol + 1;
                        if (fsLong2) {
                            sb_append_char(tmp, 34);
                            sb_append_char(tmp, 34);
                            fsi = fsi + 2;
                            fscol = fscol + 2;
                        }
                        while (fsi < n) {
                            var fsc: u8 = src[fsi];
                            if (fsc == 92) {
                                sb_append_char(tmp, 92);
                                fsi = fsi + 1; fscol = fscol + 1;
                                if (fsi >= n) { break; }
                                sb_append_char(tmp, src[fsi]);
                                if (src[fsi] == 10) { line = line + 1; fscol = 1; } else { fscol = fscol + 1; }
                                fsi = fsi + 1;
                                continue;
                            }
                            if (fsLong2) {
                                if (fsc == 34 && fsi + 2 < n && src[fsi + 1] == 34 && src[fsi + 2] == 34) {
                                    sb_append_char(tmp, 34); sb_append_char(tmp, 34); sb_append_char(tmp, 34);
                                    fsi = fsi + 3; fscol = fscol + 3;
                                    break;
                                }
                            } else {
                                if (fsc == 34) {
                                    sb_append_char(tmp, 34);
                                    fsi = fsi + 1; fscol = fscol + 1;
                                    break;
                                }
                            }
                            sb_append_char(tmp, fsc);
                            if (fsc == 10) { line = line + 1; fscol = 1; } else { fscol = fscol + 1; }
                            fsi = fsi + 1;
                        }
                        continue;
                    }
                    if (fch == 123) { fdepth = fdepth + 1; sb_append_char(tmp, 123); fsi = fsi + 1; fscol = fscol + 1; continue; }
                    if (fch == 125) { fdepth = fdepth - 1; sb_append_char(tmp, 125); fsi = fsi + 1; fscol = fscol + 1; continue; }
                    sb_append_char(tmp, fch);
                    if (fch == 10) { line = line + 1; fscol = 1; }
                    else { fscol = fscol + 1; }
                    fsi = fsi + 1;
                }
                if (closed == false) {
                    eprint("error: unterminated f-string literal\n");
                    exit(1);
                }
                if (isLong) {
                    sb_append_char(tmp, 34); sb_append_char(tmp, 34); sb_append_char(tmp, 34);
                    fsi = fsi + 3; fscol = fscol + 3;
                } else {
                    sb_append_char(tmp, 34);
                    fsi = fsi + 1; fscol = fscol + 1;
                }
                i = fsi;
                col = fscol;
                push_tok("FormatString", sb_to_str(tmp), fl, fcol);
                continue;
            }
        }

        if (is_ident_start(base.utf8_cp_at(src, i as i64, n as i64))) {
            var il: u64 = line;
            var icol: u64 = col;
            var is0: u64 = i;
            var w0: i64 = base.utf8_w0(src[i]);
            i = i + w0 as u64;
            col = col + w0 as u64;
            while (i < n) {
                var cpc: i64 = base.utf8_cp_at(src, i as i64, n as i64);
                if (is_ident_cont(cpc) == false) { break; }
                var wc: i64 = base.utf8_w0(src[i]);
                i = i + wc as u64;
                col = col + wc as u64;
            }
            var text: string = str_slice(src, is0, i);
            // `inf` / `nan`：IEEE-754 特殊值字面量（reference.md §2.4）。词法上
            // 直接归为 Float token，故它们**不能**再当标识符用；负无穷写 `-inf`。
            if (text == "inf" || text == "nan") {
                push_tok("Float", text, il, icol);
                continue;
            }
            var tname: string = kw_lookup(text);
            if (str_len(tname) == 0) {
                tname = "Identifier";
            }
            push_tok(tname, text, il, icol);
            continue;
        }

        if (c == 64) {
            push_tok("At", "@", line, col);
            i = i + 1;
            col = col + 1;
            continue;
        }
        if (c == 35) {
            push_tok("Hash", "#", line, col);
            i = i + 1;
            col = col + 1;
            continue;
        }

        // 管道算子三字符形态必须先于两字符 `|>` 与单字符 `|` 匹配（最大匹配）。
        // 零破坏：`| ->` / `| > ?` 在旧文法下从不构成合法序列（reference.md §3.15）。
        if (i + 2 < n && c == 124 && src[i + 1] == 45 && src[i + 2] == 62) {
            push_tok("PipeMap", "|->", line, col);
            i = i + 3;
            col = col + 3;
            continue;
        }
        if (i + 2 < n && c == 124 && src[i + 1] == 62 && src[i + 2] == 63) {
            push_tok("PipeFilter", "|>?", line, col);
            i = i + 3;
            col = col + 3;
            continue;
        }

        // 闭合区间 `..=` 必须先于 `..` 与 `.` 匹配（最大匹配）。
        if (i + 2 < n && c == 46 && src[i + 1] == 46 && src[i + 2] == 61) {
            push_tok("DotDotEq", "..=", line, col);
            i = i + 3;
            col = col + 3;
            continue;
        }

        if (i + 2 < n && c == 60 && src[i + 1] == 60 && src[i + 2] == 61) {
            push_tok("ShlAssign", "<<=", line, col);
            i = i + 3;
            col = col + 3;
            continue;
        }
        if (i + 2 < n && c == 62 && src[i + 1] == 62 && src[i + 2] == 61) {
            push_tok("ShrAssign", ">>=", line, col);
            i = i + 3;
            col = col + 3;
            continue;
        }

        if (i + 1 < n) {
            var two: string = op2_name(c, src[i + 1]);
            if (str_len(two) > 0) {
                push_tok(two, str_slice(src, i, i + 2), line, col);
                i = i + 2;
                col = col + 2;
                continue;
            }
        }

        var one: string = op1_name(c);
        if (str_len(one) > 0) {
            push_tok(one, str_slice(src, i, i + 1), line, col);
            i = i + 1;
            col = col + 1;
            continue;
        }

        // 非法字符：报诊断后跳过该字节继续扫描，让一次编译尽量把问题报全。
        base.diag_new("T-LEX-E001", "error",
            "源文件中出现无法构成任何记号的字符",
            base.g_file, line as i64, col as i64, line as i64, (col + 1) as i64);
        i = i + 1;
        col = col + 1;
    }

    push_tok("Eof", "", line, col);
}

// ── parser 状态与 token 辅助 ──────────────────────────────────

pub var pos: i64;
pub var decl_list: []i64;
pub var g_agent_anchor: i64 = -1;       // agent 声明脱糖时，合成节点锚点统一挂到 agent 名字 token

pub var g_method_head: i64 = -1;
pub var g_method_tail: i64 = -1;
pub var g_struct_exported: bool = false;

// ── 模块系统（M-Module / whole-program 内联）──────────────────
// 内联策略：`import hello` 把 `hello.tc` 的顶层声明整体并入同一编译单元
// （类似 C 的 #include，单一命名空间），再把 `hello.add` 这种限定访问就地
// 改写成裸 `add`。跨模块私有隔离、名字重整（mangling）留待后续里程碑。
pub var g_mod_aliases: []string;        // 已导入模块的「模块名 / 别名」集合（用于识别限定访问前缀）
pub var g_mod_visited: []string;        // 已完整加载的模块绝对路径（钻石依赖去重）
pub var g_mod_stack: []string;         // 当前正在加载的模块路径链（DFS 活跃栈，环检测）
pub var g_mod_stack_alias: []string;   // 与 g_mod_stack 平行的模块别名，用于构造环路径信息
pub var g_dep_from: []string;          // 依赖图边：父模块别名（--emit-deps 输出）
pub var g_dep_to: []string;            // 依赖图边：子模块别名
pub var g_emit_deps: bool = false;     // --emit-deps：打印模块依赖图后退出
pub var g_debug_libs: bool = false;    // --debug-libs：import 优先链接 .tlibd 调试态库
pub var g_lib_debug: bool = false;     // build --lib --debug：产出 .tlibd 调试态归档

// 外部库搜索目录候选（compute_lib_dirs 填充）：工程根/lib、T_LIB_PATH、~/.tote/libs、编译器/libs
pub var g_lib_dirs: []string;

// 名字重整表（mangle_modules 构建）：并行数组，记录每个顶层声明原名/所属模块/是否导出。
pub var g_def_orig: []string;           // 声明原名（重整前）
pub var g_def_alias: []string;          // 所属模块别名（"" = 入口，不重整）
pub var g_def_export: []bool;           // 该声明是否被 export 修饰
pub var g_mod_has_export: []string;     // 至少含一个 export 声明的模块别名集合

// 模块属性表（文件即模块 / @module(pub|internal)）：并行数组。
// handle_one_import 期登记别名与「是否跨包」，collect_module_defs 从 ModuleDecl 回填 attr。
pub var g_mod_attr_alias: []string;     // 模块别名
pub var g_mod_attr: []string;           // @module(...) 属性串："pub" / "internal" / ""（未写 @module）
pub var g_mod_attr_lib: []bool;         // true = 来自库搜索路径（跨包）；false = src 源码根（同包）

// 选择性导入表（`import(p :: a, b as c, *)`）：并行数组，handle_one_import 期登记，
// mangle_modules Pass 3 消费 —— 把「导入方作用域内的裸名」直接绑定到 `模块__原名`。
pub var g_sel_owner: []string;          // 导入方模块别名（"" = 入口）
pub var g_sel_local: []string;          // 导入方看到的本地名（`as` 后的名字；通配项为 "*"）
pub var g_sel_mod: []string;            // 被导入模块别名
pub var g_sel_orig: []string;           // 模块中的原名（通配项为 "*"）
pub var g_sel_wild: []bool;             // 是否 `*` 通配项（展开后置 false 的新项才参与改写）
pub var g_sel_at: []i64;                // 诊断锚点节点
// 模块重导出表（M-Reexport）：`pub @import("M" [:: *])` / `export import(M)` 把 M 的 pub
// 符号在本模块再导出。handle_one_import 期登记（owner=写下该 import 的模块别名，
// imp=被导入模块别名），collect_module_defs 消费，把 M 的 pub 符号并入 owner 的符号集。
pub var g_reexport_owner: []string;      // 执行重导出的模块别名（"" = 入口）
pub var g_reexport_imp: []string;        // 被重导出的模块别名
// 预编译库（.tlib）链接信息（Phase2）：下游 import(Path)（首段非 src）命中 .tlib 时填充，
// 发射期据此外链归档并补 extern 声明，跳过库源码内联。
pub var g_ext_link: []string;           // 待链接的归档/对象文件路径
pub var g_ext_externs: []string;        // 待发射的 extern 声明（C 原型 / LLVM declare）文本
pub var g_link_libs: []string;          // 链接模式导入的库别名集合（Phase2）：其导出符号发 declare、私有跳过，归档进 g_ext_link
pub var g_lib_emit: bool = false;        // 当前是否处于 build --lib 预编译发射：跳过进程级全局（t.__ginit / t_atom_table / t_atom_count），它们由主程序提供

// 该别名是否以「链接模式」（命中 .tlib 预编译产物）导入。
pub fn in_link_libs(alias: string) bool {
    var n: i64 = slice_len(g_link_libs) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (g_link_libs[i] == alias) { return true; }
        i = i + 1;
    }
    return false;
}


// 匿名函数字面量（M46 / FuncType v2）：合成函数名 `__lam_N` 在解析期定名，
// parse_unit 末尾由 desugar_lambdas 统一提升为顶层函数。
pub var g_lam_counter: i64;
// 检查期标记：当前正在检查的 FuncDecl 是由 lambda 提升而来（sc == "__lambda__"），
// 此时未解析的标识符即「试图捕获外层局部」，给出专门诊断而非静默 Unknown。
pub var g_in_lambda: bool;

pub fn tk_t(idx: i64) string {
    var tk: Tok = base.toks[idx];
    return tk.t;
}

pub fn tk_v(idx: i64) string {
    var tk: Tok = base.toks[idx];
    return tk.v;
}

pub fn tk_line(idx: i64) u64 {
    var tk: Tok = base.toks[idx];
    return tk.line;
}

pub fn tk_col(idx: i64) u64 {
    var tk: Tok = base.toks[idx];
    return tk.col;
}

pub fn cur_t() string {
    return tk_t(pos);
}

pub fn cur_v() string {
    return tk_v(pos);
}

// 编译期关键字已统一为 `comptime`（自举阶段 `meta` 曾作为同义别名并下发 W_COMPTIME_ALIAS
// 弃用告警；别名已移除，且 `meta` 现已登记为保留关键字 `KwMeta`——当前无语义、留作他用，
// 同时禁止用户将其用作标识符（见 init_keywords 的 kw_reg("meta","KwMeta")）。

// ── 内建文件描述符常量（M51）────────────────────────────────
// stdin/stdout/stderr 是**保留标识符**（非关键字）：词法上仍是 Identifier，
// 由 parse_primary 在表达式位置降为 fidconst 常量节点，由 sym_define 在声明
// 位置拒绝重定义。返回句柄值，非保留名返回 -1。
pub fn fid_const_of(name: string) i64 {
    if (name == "stdin") { return 0; }
    if (name == "stdout") { return 1; }
    if (name == "stderr") { return 2; }
    return -1;
}

pub fn peek_t(off: i64) string {
    var idx: i64 = pos + off;
    var n: i64 = slice_len(base.toks) as i64;
    if (idx >= n) {
        idx = n - 1;
    }
    return tk_t(idx);
}

// 前进一个 token，返回被消费 token 的下标（Eof 处不动，返回前一个）
pub fn advance_i() i64 {
    if (cur_t() != "Eof") {
        pos = pos + 1;
    }
    return pos - 1;
}

// ── lex 子命令（token 池 → JSON，同 tc0 lex --json）────────────
// 原 codegen_ll.run_lex，迁至 lex（base 不得反向依赖 lex）。
pub fn run_lex(file: string) i32 {
    var src: string = file_read_all(file);
    tokenize(src);
    var out: StringBuilder = sb_new();
    sb_append_char(out, 91);
    var n: i64 = slice_len(base.toks) as i64;
    var i: i64 = 0;
    while (i < n) {
        var t: Tok = base.toks[i];
        if (i > 0) {
            sb_append_char(out, 44);
        }
        sb_append_str(out, "{\"type\":\"");
        sb_append_str(out, t.t);
        sb_append_str(out, "\",\"value\":\"");
        base.json_escape_into(out, t.v);
        sb_append_str(out, "\",\"line\":");
        sb_append_u64(out, t.line);
        sb_append_str(out, ",\"col\":");
        sb_append_u64(out, t.col);
        sb_append_char(out, 125);
        i = i + 1;
    }
    sb_append_char(out, 93);
    print(sb_to_str(out));
    print("\n");
    return 0;
}
