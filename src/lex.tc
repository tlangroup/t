// ══════════════════════════════════════════════════════════════════
// src/lex.tc — 编译步骤 1：词法分析
//
// 内容：字符分类、关键字表、tokenize()、token 流访问器（cur_t / advance_i / tk_v）。
// 依赖：base。
// ══════════════════════════════════════════════════════════════════

import(src.base :: *);

is_ident_start fn(cp: i64) bool {
    if (cp == 95) { return true; }
    return cp_in_ranges(cp, xid_start_lo, xid_start_hi);
}

// 标识符续字符：XID_Continue + 下划线 + 数字（数字本就在 XID_Continue 内，显式列出无害）。
is_ident_cont fn(cp: i64) bool {
    if (cp == 95) { return true; }
    if (cp >= 48 && cp <= 57) { return true; }
    return cp_in_ranges(cp, xid_cont_lo, xid_cont_hi);
}

is_hex_digit fn(c: u8) bool {
    if (c >= 48 && c <= 57) { return true; }
    if (c >= 97 && c <= 102) { return true; }
    return c >= 65 && c <= 70;
}

is_bin_digit fn(c: u8) bool {
    return c == 48 || c == 49;
}

// >>> GEN:kw_lookup (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
KwEntry struct {
    text: string;
    kind: string;
}

var keywords_tbl: []KwEntry;

kw_reg fn(t: string, k: string) void {
    var e: KwEntry;
    e.text = t;
    e.kind = k;
    append(keywords_tbl, e);
}

init_keywords fn() void {
    kw_reg("fn", "KwFunc");
    kw_reg("struct", "KwStruct");
    kw_reg("enum", "KwEnum");
    kw_reg("flag", "KwFlag");
    kw_reg("union", "KwUnion");
    kw_reg("variant", "KwVariant");
    kw_reg("agent", "KwAgent");
    kw_reg("var", "KwVar");
    kw_reg("const", "KwConst");
    kw_reg("comptime", "KwComptime");
    kw_reg("meta", "KwComptime");   // Phase A: meta 元编程关键字，暂以 KwComptime 承载（别名；后续阶段独立语义/节点）
    kw_reg("type", "KwType");        // meta T: type 的「类型之类型」占位关键字（与 any 同语义）
    kw_reg("if", "KwIf");
    kw_reg("else", "KwElse");
    kw_reg("match", "KwMatch");
    kw_reg("when", "KwWhen");
    kw_reg("for", "KwFor");
    kw_reg("while", "KwWhile");
    kw_reg("break", "KwBreak");
    kw_reg("continue", "KwContinue");
    kw_reg("return", "KwReturn");
    kw_reg("true", "KwTrue");
    kw_reg("false", "KwFalse");
    kw_reg("null", "KwNull");
    kw_reg("map", "KwMap");
    kw_reg("import", "KwImport");
    kw_reg("export", "KwExport");
    kw_reg("as", "KwAs");
    kw_reg("in", "KwIn");
    kw_reg("defer", "KwDefer");
    kw_reg("void", "KwVoid");
    kw_reg("string", "KwString");
    kw_reg("StringBuilder", "KwStringBuilder");
    kw_reg("auto", "KwAuto");
    kw_reg("any", "KwAny");
}

kw_lookup fn(text: string) string {
    var i: i64 = 0;
    while (i < (slice_len(keywords_tbl) as i64)) {
        if (keywords_tbl[i].text == text) { return keywords_tbl[i].kind; }
        i = i + 1;
    }
    return "";
}
// <<< GEN:kw_lookup <<<


op2_name fn(a: u8, b: u8) string {
    if (a == 45 && b == 62) { return "Arrow"; }
    if (a == 61 && b == 62) { return "FatArrow"; }
    if (a == 58 && b == 58) { return "DoubleColon"; }
    if (a == 61 && b == 61) { return "Eq"; }
    if (a == 33 && b == 61) { return "NotEq"; }
    if (a == 60 && b == 61) { return "LtEq"; }
    if (a == 62 && b == 61) { return "GtEq"; }
    if (a == 38 && b == 38) { return "And"; }
    if (a == 124 && b == 124) { return "Or"; }
    if (a == 60 && b == 60) { return "ShiftLeft"; }
    if (a == 62 && b == 62) { return "ShiftRight"; }
    if (a == 46 && b == 46) { return "DoubleDot"; }
    if (a == 43 && b == 61) { return "PlusAssign"; }
    if (a == 45 && b == 61) { return "MinusAssign"; }
    if (a == 42 && b == 61) { return "StarAssign"; }
    if (a == 47 && b == 61) { return "SlashAssign"; }
    if (a == 37 && b == 61) { return "PercentAssign"; }
    if (a == 38 && b == 61) { return "BitAndAssign"; }
    if (a == 124 && b == 61) { return "BitOrAssign"; }
    if (a == 94 && b == 61) { return "BitXorAssign"; }
    return "";
}

op1_name fn(c: u8) string {
    if (c == 43) { return "Plus"; }
    if (c == 45) { return "Minus"; }
    if (c == 42) { return "Star"; }
    if (c == 47) { return "Slash"; }
    if (c == 37) { return "Percent"; }
    if (c == 61) { return "Assign"; }
    if (c == 60) { return "Lt"; }
    if (c == 62) { return "Gt"; }
    if (c == 33) { return "Not"; }
    if (c == 38) { return "BitAnd"; }
    if (c == 124) { return "BitOr"; }
    if (c == 94) { return "BitXor"; }
    if (c == 126) { return "BitNot"; }
    if (c == 58) { return "Colon"; }
    if (c == 46) { return "Dot"; }
    if (c == 63) { return "Question"; }
    if (c == 40) { return "LParen"; }
    if (c == 41) { return "RParen"; }
    if (c == 123) { return "LBrace"; }
    if (c == 125) { return "RBrace"; }
    if (c == 91) { return "LBracket"; }
    if (c == 93) { return "RBracket"; }
    if (c == 44) { return "Comma"; }
    if (c == 59) { return "Semicolon"; }
    return "";
}

// ── token 入池 ─────────────────────────────────────────────────

push_tok fn(tname: string, value: string, line: u64, col: u64) void {
    var tk: Tok;
    tk.t = tname;
    tk.v = value;
    tk.line = line;
    tk.col = col;
    append(toks, tk);
}

// ── lexer：源码 → token 池（逻辑照抄 lexer.tc）─────────────────

tokenize fn(src: string) void {
    var tmp: StringBuilder = sb_new();
    var i: u64 = 0;
    var n: u64 = str_len(src);
    var line: u64 = 1;
    var col: u64 = 1;

    while (i < n) {
        var c: u8 = src[i];

        if (c == 32 || c == 9 || c == 13) {
            i = i + 1;
            col = col + 1;
            continue;
        }
        if (c == 10) {
            i = i + 1;
            line = line + 1;
            col = 1;
            continue;
        }

        if (c == 47 && i + 1 < n && src[i + 1] == 47) {
            while (i < n && src[i] != 10) {
                i = i + 1;
                col = col + 1;
            }
            continue;
        }

        if (c == 47 && i + 1 < n && src[i + 1] == 42) {
            i = i + 2;
            col = col + 2;
            var closed: bool = false;
            while (i < n) {
                if (src[i] == 42 && i + 1 < n && src[i + 1] == 47) {
                    i = i + 2;
                    col = col + 2;
                    closed = true;
                    break;
                }
                if (src[i] == 10) {
                    line = line + 1;
                    col = 1;
                } else {
                    col = col + 1;
                }
                i = i + 1;
            }
            if (closed == false) {
                eprint("error: unterminated block comment\n");
                exit(1);
            }
            continue;
        }

        if (is_digit(c)) {
            var tl: u64 = line;
            var tcol: u64 = col;

            if (c == 48 && i + 1 < n && (src[i + 1] == 120 || src[i + 1] == 88)) {
                sb_clear(tmp);
                sb_append_str(tmp, "0x");
                i = i + 2;
                col = col + 2;
                var hexcnt: u64 = 0;
                while (i < n && is_hex_digit(src[i])) {
                    sb_append_char(tmp, src[i]);
                    i = i + 1;
                    col = col + 1;
                    hexcnt = hexcnt + 1;
                }
                if (hexcnt == 0) {
                    eprint("error: hex literal has no digits after 0x\n");
                    exit(1);
                }
                push_tok("Integer", sb_to_str(tmp), tl, tcol);
                continue;
            }

            if (c == 48 && i + 1 < n && (src[i + 1] == 98 || src[i + 1] == 66)) {
                sb_clear(tmp);
                sb_append_str(tmp, "0b");
                i = i + 2;
                col = col + 2;
                var bincnt: u64 = 0;
                while (i < n && is_bin_digit(src[i])) {
                    sb_append_char(tmp, src[i]);
                    i = i + 1;
                    col = col + 1;
                    bincnt = bincnt + 1;
                }
                if (bincnt == 0) {
                    eprint("error: binary literal has no digits after 0b\n");
                    exit(1);
                }
                push_tok("Integer", sb_to_str(tmp), tl, tcol);
                continue;
            }

            var ns: u64 = i;
            while (i < n && is_digit(src[i])) {
                i = i + 1;
                col = col + 1;
            }

            if (i < n && src[i] == 46 && i + 1 < n && is_digit(src[i + 1])) {
                i = i + 1;
                col = col + 1;
                while (i < n && is_digit(src[i])) {
                    i = i + 1;
                    col = col + 1;
                }
                if (i < n && (src[i] == 101 || src[i] == 69)) {
                    i = i + 1;
                    col = col + 1;
                    if (i < n && (src[i] == 43 || src[i] == 45)) {
                        i = i + 1;
                        col = col + 1;
                    }
                    while (i < n && is_digit(src[i])) {
                        i = i + 1;
                        col = col + 1;
                    }
                }
                push_tok("Float", str_slice(src, ns, i), tl, tcol);
                continue;
            }

            push_tok("Integer", str_slice(src, ns, i), tl, tcol);
            continue;
        }

        if (c == 34) {
            var sl: u64 = line;
            var scol: u64 = col;
            i = i + 1;
            col = col + 1;
            sb_clear(tmp);
            while (i < n && src[i] != 34) {
                if (src[i] == 92) {
                    i = i + 1;
                    col = col + 1;
                    if (i >= n) {
                        break;
                    }
                    var e: u8 = src[i];
                    if (src[i] == 10) {
                        line = line + 1;
                        col = 1;
                    } else {
                        col = col + 1;
                    }
                    i = i + 1;
                    if (e == 110) {
                        sb_append_char(tmp, 10);
                    } else {
                    if (e == 116) {
                        sb_append_char(tmp, 9);
                    } else {
                    if (e == 114) {
                        sb_append_char(tmp, 13);
                    } else {
                    if (e == 34) {
                        sb_append_char(tmp, 34);
                    } else {
                    if (e == 92) {
                        sb_append_char(tmp, 92);
                    } else {
                    if (e == 48) {
                        sb_append_char(tmp, 0);
                    } else {
                        sb_append_char(tmp, e);
                    }}}}}}
                } else {
                    if (src[i] == 10) {
                        line = line + 1;
                        col = 1;
                    } else {
                        col = col + 1;
                    }
                    sb_append_char(tmp, src[i]);
                    i = i + 1;
                }
            }
            if (i >= n) {
                eprint("error: unterminated string literal\n");
                exit(1);
            }
            i = i + 1;
            col = col + 1;
            push_tok("String", sb_to_str(tmp), sl, scol);
            continue;
        }

        if (is_ident_start(utf8_cp_at(src, i as i64, n as i64))) {
            var il: u64 = line;
            var icol: u64 = col;
            var is0: u64 = i;
            var w0: i64 = utf8_w0(src[i]);
            i = i + w0 as u64;
            col = col + w0 as u64;
            while (i < n) {
                var cpc: i64 = utf8_cp_at(src, i as i64, n as i64);
                if (is_ident_cont(cpc) == false) { break; }
                var wc: i64 = utf8_w0(src[i]);
                i = i + wc as u64;
                col = col + wc as u64;
            }
            var text: string = str_slice(src, is0, i);
            var tname: string = kw_lookup(text);
            if (str_len(tname) == 0) {
                tname = "Identifier";
            }
            push_tok(tname, text, il, icol);
            continue;
        }

        if (c == 64) {
            push_tok("At", "@", line, col);
            i = i + 1;
            col = col + 1;
            continue;
        }
        if (c == 35) {
            push_tok("Hash", "#", line, col);
            i = i + 1;
            col = col + 1;
            continue;
        }

        if (i + 2 < n && c == 60 && src[i + 1] == 60 && src[i + 2] == 61) {
            push_tok("ShlAssign", "<<=", line, col);
            i = i + 3;
            col = col + 3;
            continue;
        }
        if (i + 2 < n && c == 62 && src[i + 1] == 62 && src[i + 2] == 61) {
            push_tok("ShrAssign", ">>=", line, col);
            i = i + 3;
            col = col + 3;
            continue;
        }

        if (i + 1 < n) {
            var two: string = op2_name(c, src[i + 1]);
            if (str_len(two) > 0) {
                push_tok(two, str_slice(src, i, i + 2), line, col);
                i = i + 2;
                col = col + 2;
                continue;
            }
        }

        var one: string = op1_name(c);
        if (str_len(one) > 0) {
            push_tok(one, str_slice(src, i, i + 1), line, col);
            i = i + 1;
            col = col + 1;
            continue;
        }

        eprint("error: unexpected character\n");
        exit(1);
    }

    push_tok("Eof", "", line, col);
}

// ── parser 状态与 token 辅助 ──────────────────────────────────

var pos: i64;
var decl_list: []i64;
var g_agent_anchor: i64 = -1;       // agent 声明脱糖时，合成节点锚点统一挂到 agent 名字 token

var g_method_head: i64 = -1;
var g_method_tail: i64 = -1;
var g_struct_exported: bool = false;

// ── 模块系统（M-Module / whole-program 内联）──────────────────
// 内联策略：`import hello` 把 `hello.tc` 的顶层声明整体并入同一编译单元
// （类似 C 的 #include，单一命名空间），再把 `hello.add` 这种限定访问就地
// 改写成裸 `add`。跨模块私有隔离、名字重整（mangling）留待后续里程碑。
var g_mod_aliases: []string;        // 已导入模块的「模块名 / 别名」集合（用于识别限定访问前缀）
var g_mod_visited: []string;        // 已完整加载的模块绝对路径（钻石依赖去重）
var g_mod_stack: []string;         // 当前正在加载的模块路径链（DFS 活跃栈，环检测）
var g_mod_stack_alias: []string;   // 与 g_mod_stack 平行的模块别名，用于构造环路径信息
var g_dep_from: []string;          // 依赖图边：父模块别名（--emit-deps 输出）
var g_dep_to: []string;            // 依赖图边：子模块别名
var g_emit_deps: bool = false;     // --emit-deps：打印模块依赖图后退出
var g_debug_libs: bool = false;    // --debug-libs：import 优先链接 .tlibd 调试态库
var g_lib_debug: bool = false;     // build --lib --debug：产出 .tlibd 调试态归档

// 外部库搜索目录候选（compute_lib_dirs 填充）：工程根/lib、T_LIB_PATH、~/.tote/libs、编译器/libs
var g_lib_dirs: []string;

// 名字重整表（mangle_modules 构建）：并行数组，记录每个顶层声明原名/所属模块/是否导出。
var g_def_orig: []string;           // 声明原名（重整前）
var g_def_alias: []string;          // 所属模块别名（"" = 入口，不重整）
var g_def_export: []bool;           // 该声明是否被 export 修饰
var g_mod_has_export: []string;     // 至少含一个 export 声明的模块别名集合

// 选择性导入表（`import(p :: a, b as c, *)`）：并行数组，handle_one_import 期登记，
// mangle_modules Pass 3 消费 —— 把「导入方作用域内的裸名」直接绑定到 `模块__原名`。
var g_sel_owner: []string;          // 导入方模块别名（"" = 入口）
var g_sel_local: []string;          // 导入方看到的本地名（`as` 后的名字；通配项为 "*"）
var g_sel_mod: []string;            // 被导入模块别名
var g_sel_orig: []string;           // 模块中的原名（通配项为 "*"）
var g_sel_wild: []bool;             // 是否 `*` 通配项（展开后置 false 的新项才参与改写）
var g_sel_at: []i64;                // 诊断锚点节点
// 预编译库（.tlib）链接信息（Phase2）：下游 import(Path)（首段非 src）命中 .tlib 时填充，
// 发射期据此外链归档并补 extern 声明，跳过库源码内联。
var g_ext_link: []string;           // 待链接的归档/对象文件路径
var g_ext_externs: []string;        // 待发射的 extern 声明（C 原型 / LLVM declare）文本
var g_link_libs: []string;          // 链接模式导入的库别名集合（Phase2）：其导出符号发 declare、私有跳过，归档进 g_ext_link
var g_lib_emit: bool = false;        // 当前是否处于 build --lib 预编译发射：跳过进程级全局（t.__ginit / t_atom_table / t_atom_count），它们由主程序提供

// 该别名是否以「链接模式」（命中 .tlib 预编译产物）导入。
in_link_libs fn(alias: string) bool {
    var n: i64 = slice_len(g_link_libs) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (g_link_libs[i] == alias) { return true; }
        i = i + 1;
    }
    return false;
}


// 匿名函数字面量（M46 / FuncType v2）：合成函数名 `__lam_N` 在解析期定名，
// parse_unit 末尾由 desugar_lambdas 统一提升为顶层函数。
var g_lam_counter: i64;
// 检查期标记：当前正在检查的 FuncDecl 是由 lambda 提升而来（sc == "__lambda__"），
// 此时未解析的标识符即「试图捕获外层局部」，给出专门诊断而非静默 Unknown。
var g_in_lambda: bool;

tk_t fn(idx: i64) string {
    var tk: Tok = toks[idx];
    return tk.t;
}

tk_v fn(idx: i64) string {
    var tk: Tok = toks[idx];
    return tk.v;
}

cur_t fn() string {
    return tk_t(pos);
}

cur_v fn() string {
    return tk_v(pos);
}

// Phase E（迁移 & 弃用）：`comptime` 是 `meta` 的弃用别名，使用即发 W_COMPTIME_ALIAS 告警，
// 但仍按 `meta` 语义正常编译（保留一个发布周期作为过渡，随后移除关键字）。
// 注意：`meta` 与 `comptime` 同属 KwComptime，故须用 cur_v() 取**原始拼写**，
// 仅当字面 token 确为 `comptime` 时才告警，`meta` 不告警。
warn_comptime_alias fn() void {
    if (cur_v() != "comptime") { return; }
    var tk: Tok = toks[pos];
    diag_new("W_COMPTIME_ALIAS", "warning",
        "`comptime` 已弃用，请改用 `meta`（语义完全等价；`comptime T: any` → `meta T: type`）。将在后续版本移除。",
        g_file, tk.line as i64, tk.col as i64, tk.line as i64, tk.col as i64 + 8);
}

// ── 内建文件描述符常量（M51）────────────────────────────────
// stdin/stdout/stderr 是**保留标识符**（非关键字）：词法上仍是 Identifier，
// 由 parse_primary 在表达式位置降为 fidconst 常量节点，由 sym_define 在声明
// 位置拒绝重定义。返回句柄值，非保留名返回 -1。
fid_const_of fn(name: string) i64 {
    if (name == "stdin") { return 0; }
    if (name == "stdout") { return 1; }
    if (name == "stderr") { return 2; }
    return -1;
}

peek_t fn(off: i64) string {
    var idx: i64 = pos + off;
    var n: i64 = slice_len(toks) as i64;
    if (idx >= n) {
        idx = n - 1;
    }
    return tk_t(idx);
}

// 前进一个 token，返回被消费 token 的下标（Eof 处不动，返回前一个）
advance_i fn() i64 {
    if (cur_t() != "Eof") {
        pos = pos + 1;
    }
    return pos - 1;
}
