// >>> GEN:xid (generated by tools/totter.tc from build/ebnf.json -- DO NOT EDIT) >>>

// XID_Start / XID_Continue 范围表（十进制 [lo,hi] 闭区间，来自 Unicode UCD）
var xid_start_lo: []i64;
var xid_start_hi: []i64;
var xid_cont_lo: []i64;
var xid_cont_hi: []i64;

utf8_w0 :: func(c0: u8) -> i64 {
    if (c0 < 128) { return 1; }
    if (c0 < 224) { return 2; }
    if (c0 < 240) { return 3; }
    return 4;
}

utf8_cp_at :: func(src: string, i: i64, n: i64) -> i64 {
    var c0: u8 = src[i];
    if (c0 < 128) { return c0 as i64; }
    if (c0 < 224) {
        var cp: i64 = (c0 & 31) as i64;
        cp = (cp << 6) | (src[i + 1] & 63) as i64;
        return cp;
    }
    if (c0 < 240) {
        var cp: i64 = (c0 & 15) as i64;
        cp = (cp << 6) | (src[i + 1] & 63) as i64;
        cp = (cp << 6) | (src[i + 2] & 63) as i64;
        return cp;
    }
    var cp: i64 = (c0 & 7) as i64;
    cp = (cp << 6) | (src[i + 1] & 63) as i64;
    cp = (cp << 6) | (src[i + 2] & 63) as i64;
    cp = (cp << 6) | (src[i + 3] & 63) as i64;
    return cp;
}

cp_in_ranges :: func(cp: i64, lo: []i64, hi: []i64) -> bool {
    var lo_i: i64 = 0;
    var hi_i: i64 = (slice_len(lo) as i64) - 1;
    while (lo_i <= hi_i) {
        var mid: i64 = (lo_i + hi_i) / 2;
        if (cp < lo[mid]) { hi_i = mid - 1; }
        else if (cp > hi[mid]) { lo_i = mid + 1; }
        else { return true; }
    }
    return false;
}

