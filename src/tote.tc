// 列表构建：head/tail 由调用方持有；返回新 tail
list_push :: func(head: i64, tail: i64, val: i64) -> i64 {
    var c: Child;
    c.val = val;
    c.next = -1;
    append(kids, c);
    var idx: i64 = (slice_len(kids) as i64) - 1;
    if (tail >= 0) {
        var prev: Child = kids[tail];
        prev.next = idx;
        slice_set(kids, tail, prev);
    }
    return idx;
}

// ── 诊断池（复刻 DiagnosticBag）────────────────────────────────
// vv/fs/nt: -1 = null；vv/nt 指向 sitems 链表头，fs 指向 fixes 链表头

Diag :: struct {
    code: string;
    sev: string;
    msg: string;
    file: string;
    sl: i64;
    sc: i64;
    el: i64;
    ec: i64;
    vv: i64;
    fs: i64;
    nt: i64;
}

var diags: []Diag;

SI :: struct {
    s: string;
    next: i64;
}

var sitems: []SI;

FixS :: struct {
    desc: string;
    file: string;
    sl: i64;
    sc: i64;
    el: i64;
    ec: i64;
    repl: string;
    next: i64;
}

var fixes: []FixS;

var g_file: string;

diag_new :: func(code: string, sev: string, msg: string, file: string, sl: i64, sc: i64, el: i64, ec: i64) -> i64 {
    var d: Diag;
    d.code = code;
    if (sev == "") {
        sev = diag_sev(code);
    }
    d.sev = sev;
    d.msg = msg;
    d.file = file;
    d.sl = sl;
    d.sc = sc;
    d.el = el;
    d.ec = ec;
    d.vv = -1;
    d.fs = -1;
    d.nt = -1;
    append(diags, d);
    return (slice_len(diags) as i64) - 1;
}

// >>> GEN:diagnostics (generated by tools/totter.tc from build/ebnf.json -- DO NOT EDIT) >>>
// 诊断码 → 规范严重度查询。diag_new 在 sev=="" 时以此作为兜底默认值；
// 调用点显式传 sev 时优先（如 T_ANNOTATION_UNKNOWN 的 warning 用例）。
diag_sev :: func(code: string) -> string {
    if (code == "T_TYPE_MISMATCH") { return "error"; }
    if (code == "T_TYPE_IMPLICIT_CAST") { return "error"; }
    if (code == "T_STMT_IMPLICIT_BOOL") { return "error"; }
    if (code == "T_PARSE_INVALID_EXPR") { return "error"; }
    if (code == "T_FLAG_OFFSET_CONFLICT") { return "error"; }
    if (code == "T_FLAG_OVERFLOW") { return "error"; }
    if (code == "T_DERIVE_UNSUPPORTED") { return "error"; }
    if (code == "T_ANNOTATION_INVALID_ARG") { return "error"; }
    if (code == "T_ANNOTATION_UNKNOWN") { return "error"; }
    if (code == "T_ANNOTATION_WRONG_TARGET") { return "error"; }
    return "";
}
// <<< GEN:diagnostics <<<

diag_set_vv :: func(di: i64, head: i64) -> void {
    var d: Diag = diags[di];
    d.vv = head;
    slice_set(diags, di, d);
}

diag_set_fs :: func(di: i64, head: i64) -> void {
    var d: Diag = diags[di];
    d.fs = head;
    slice_set(diags, di, d);
}

diag_set_nt :: func(di: i64, head: i64) -> void {
    var d: Diag = diags[di];
    d.nt = head;
    slice_set(diags, di, d);
}

// 字符串链表构建器（validValues / notes）
var slb_head: i64;
var slb_tail: i64;

slb_begin :: func() -> void {
    slb_head = -1;
    slb_tail = -1;
}

slb_add :: func(s: string) -> void {
    var it: SI;
    it.s = s;
    it.next = -1;
    append(sitems, it);
    var idx: i64 = (slice_len(sitems) as i64) - 1;
    if (slb_tail >= 0) {
        var p: SI = sitems[slb_tail];
        p.next = idx;
        slice_set(sitems, slb_tail, p);
    } else {
        slb_head = idx;
    }
    slb_tail = idx;
}

fix_one :: func(desc: string, file: string, sl: i64, sc: i64, el: i64, ec: i64, repl: string) -> i64 {
    var f: FixS;
    f.desc = desc;
    f.file = file;
    f.sl = sl;
    f.sc = sc;
    f.el = el;
    f.ec = ec;
    f.repl = repl;
    f.next = -1;
    append(fixes, f);
    return (slice_len(fixes) as i64) - 1;
}

// ── 字符串小工具 ───────────────────────────────────────────────

cat2 :: func(a: string, b: string) -> string {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, a);
    sb_append_str(sb, b);
    return sb_to_str(sb);
}

cat3 :: func(a: string, b: string, c: string) -> string {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, a);
    sb_append_str(sb, b);
    sb_append_str(sb, c);
    return sb_to_str(sb);
}

cat4 :: func(a: string, b: string, c: string, d: string) -> string {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, a);
    sb_append_str(sb, b);
    sb_append_str(sb, c);
    sb_append_str(sb, d);
    return sb_to_str(sb);
}

cat5 :: func(a: string, b: string, c: string, d: string, e: string) -> string {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, a);
    sb_append_str(sb, b);
    sb_append_str(sb, c);
    sb_append_str(sb, d);
    sb_append_str(sb, e);
    return sb_to_str(sb);
}

cat6 :: func(a: string, b: string, c: string, d: string, e: string, f: string) -> string {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, a);
    sb_append_str(sb, b);
    sb_append_str(sb, c);
    sb_append_str(sb, d);
    sb_append_str(sb, e);
    sb_append_str(sb, f);
    return sb_to_str(sb);
}

i2s :: func(v: i64) -> string {
    var sb: StringBuilder = sb_new();
    sb_append_i64(sb, v);
    return sb_to_str(sb);
}

// ── 命名规范校验（复刻 parser.ts validate*Name）───────────────

is_lower_snake :: func(name: string) -> bool {
    var n: u64 = str_len(name);
    if (n == 0) {
        return false;
    }
    var c0: u8 = name[0];
    if (c0 < 97 || c0 > 122) {
        return false;
    }
    var i: u64 = 1;
    while (i < n) {
        var c: u8 = name[i];
        var ok: bool = (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95;
        if (ok == false) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

is_upper_snake_name :: func(name: string) -> bool {
    var n: u64 = str_len(name);
    if (n == 0) {
        return false;
    }
    var c0: u8 = name[0];
    if (c0 < 65 || c0 > 90) {
        return false;
    }
    var i: u64 = 1;
    while (i < n) {
        var c: u8 = name[i];
        var ok: bool = (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95;
        if (ok == false) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

is_pascal_rest_ok :: func(name: string) -> bool {
    var n: u64 = str_len(name);
    var i: u64 = 1;
    while (i < n) {
        var c: u8 = name[i];
        var ok: bool = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95;
        if (ok == false) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// 以 token 下标 ti 处的 line/col 报命名告警
warn_name :: func(code: string, msg: string, ti: i64, name_len: i64) -> void {
    var tk: Tok = toks[ti];
    var l: i64 = tk.line as i64;
    var c: i64 = tk.col as i64;
    diag_new(code, "warning", msg, g_file, l, c, l, c + name_len);
}

validate_decl_name :: func(name: string, ti: i64) -> void {
    var n: u64 = str_len(name);
    if (n == 0) {
        return;
    }
    var c0: u8 = name[0];
    if (c0 >= 65 && c0 <= 90) {
        if (is_pascal_rest_ok(name) == false) {
            warn_name("T_NAME_TYPE_CAMEL", cat3("type name '", name, "' should be PascalCase (e.g. EntityState)"), ti, n as i64);
        }
    }
}

validate_var_name :: func(name: string, ti: i64) -> void {
    if (is_lower_snake(name) == false) {
        warn_name("T_NAME_VAR_SNAKE", cat3("variable name '", name, "' should be snake_case (e.g. entity_id)"), ti, str_len(name) as i64);
    }
}

validate_const_name :: func(name: string, ti: i64) -> void {
    if (is_upper_snake_name(name) == false) {
        warn_name("T_NAME_CONST_UPPER", cat3("constant name '", name, "' should be UPPER_SNAKE_CASE (e.g. MAX_RENDER_LAYER)"), ti, str_len(name) as i64);
    }
}

