// tote.tc — t 语言的包管理器与构建系统（driver）
//
// 设计定位：
//   * tc 是更纯粹的编译器（负责 lex/check/compile/emit-ll/build/run 与链接）。
//   * tote 自身不实现编译器，而是把编译/链接工作委托给 tc 工具；
//     自己负责「包」与「构建编排」两件事：
//       - 包清单 tote.toml 的生成（init）与依赖登记（install）
//       - 构建/运行时解析 tote.toml 的 entry，再转发给 tc
//
// 编译功能最终调用 tc 工具：优先取环境变量 TC，否则默认 out/dbg/tc.exe、
// 其次 out/rls/tc.exe，最后回退 PATH 上的 tc。

// ────────────────────────────────────────────────────────────────
// 路径工具（与 tc 编译器同源，保证 Windows 行为一致）
// ────────────────────────────────────────────────────────────────

to_bs fn(s: string) -> string {
    var sb: StringBuilder = sb_new();
    var i: u64 = 0;
    var n: u64 = str_len(s);
    while (i < n) {
        if (s[i] == 47) {
            sb_append_char(sb, 92);
        } else {
            sb_append_char(sb, s[i]);
        }
        i = i + 1;
    }
    return sb_to_str(sb);
}

// str_concat2 / str_concat3 —— 字符串拼接（各实参须为 string）。
// 注：cat2..cat6 语言内建已从 t 移除，这里以普通函数形式基于 StringBuilder 实现，
// 供本包管理器（自宿主 t）内部命令拼接使用；命名避开 catN 以不触发 cat 守卫。
str_concat2 fn(a: string, b: string) -> string {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, a);
    sb_append_str(sb, b);
    return sb_to_str(sb);
}

str_concat3 fn(a: string, b: string, c: string) -> string {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, a);
    sb_append_str(sb, b);
    sb_append_str(sb, c);
    return sb_to_str(sb);
}

path_exists fn(p: string) -> bool {
    var q: string = to_bs(p);
    var rc: i32 = sys_run(str_concat3("cmd /c if exist \"", q, "\" (exit 0) else (exit 1)"));
    if (rc == 0) {
        return true;
    }
    return false;
}

ends_with fn(s: string, suf: string) -> bool {
    var ns: u64 = str_len(s);
    var np: u64 = str_len(suf);
    if (ns < np) {
        return false;
    }
    var i: u64 = 0;
    while (i < np) {
        if (s[ns - np + i] != suf[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// 将 T_LIB_PATH 风格的分隔串拆成目录列表。
// 分隔符用 ';'（与 Windows PATH 一致）。注意：不能按 ':' 切分，否则 Windows 盘符
// 冒号（如 C:/foo）会被误拆。Unix 下若用 ':' 分隔，调用方应自行保证无盘符歧义；
// 本工具链以 Windows 为主，故仅按 ';' 切分。
split_path_list fn(s: string) -> []string {
    var out: []string = [];
    var cur: StringBuilder = sb_new();
    var n: u64 = str_len(s);
    var i: u64 = 0;
    while (i < n) {
        var c: u8 = s[i];
        if (c == 59) {                       // ';' 分隔符
            var seg: string = sb_to_str(cur);
            if (str_len(seg) > 0) {
                append(out, seg);
            }
            cur = sb_new();
        } else {
            sb_append_char(cur, c);
        }
        i = i + 1;
    }
    var last: string = sb_to_str(cur);
    if (str_len(last) > 0) {
        append(out, last);
    }
    return out;
}

// 用户主目录：Windows 取 USERPROFILE 或 HOMEDRIVE+HOMEPATH；Unix 取 HOME；未设置返回 ""
home_dir fn() -> string {
    var up: string = getenv("USERPROFILE");
    if (str_len(up) > 0) {
        return up;
    }
    var hd: string = getenv("HOMEDRIVE");
    var hp: string = getenv("HOMEPATH");
    if (str_len(hd) > 0 && str_len(hp) > 0) {
        return str_concat2(hd, hp);
    }
    return getenv("HOME");
}

// 把解析出的库目录逐个以 --lib-dir 传给 tc。
// 关键：tc 自身不读环境变量，包搜索策略（T_LIB_PATH / ~/.tote/libs）完全留在这里——
// 这正是 tote 作为包管理器/构建驱动的职责；tc 只接受中性输入（类比 cargo 传 -L 给 rustc）。
append_lib_dirs fn(sb: StringBuilder) -> void {
    var tp: string = getenv("T_LIB_PATH");
    var tps: []string = split_path_list(tp);
    var ti: i64 = 0;
    var tn: i64 = slice_len(tps) as i64;
    while (ti < tn) {
        sb_append_char(sb, 32);
        sb_append_str(sb, "--lib-dir");
        sb_append_char(sb, 32);
        sb_append_char(sb, 34);
        sb_append_str(sb, to_bs(tps[ti]));
        sb_append_char(sb, 34);
        ti = ti + 1;
    }
    var hd: string = home_dir();
    if (str_len(hd) > 0) {
        var tl: string = str_concat3(hd, "/.tote/libs", "");
        sb_append_char(sb, 32);
        sb_append_str(sb, "--lib-dir");
        sb_append_char(sb, 32);
        sb_append_char(sb, 34);
        sb_append_str(sb, to_bs(tl));
        sb_append_char(sb, 34);
    }
}

// 定位 tc 编译器二进制
find_tc fn() -> string {
    if (path_exists("out/dbg/tc.exe")) {
        return "out/dbg/tc.exe";
    }
    if (path_exists("out/rls/tc.exe")) {
        return "out/rls/tc.exe";
    }
    return "tc";
}

// ────────────────────────────────────────────────────────────────
// tote.toml 极简解析（仅识别 entry 与 deps 两个字段）
// ────────────────────────────────────────────────────────────────

// 读取 key = "value" 中的 value（行内第一个双引号串）
toml_string_value fn(src: string, key: string) -> string {
    var n: u64 = str_len(src);
    var i: u64 = 0;
    var nk: u64 = str_len(key);
    while (i < n) {
        if (src[i] == key[0]) {
            var k: u64 = 0;
            var ok: bool = true;
            while (k < nk) {
                if (i + k >= n) {
                    ok = false;
                    break;
                }
                if (src[i + k] != key[k]) {
                    ok = false;
                    break;
                }
                k = k + 1;
            }
            if (ok) {
                var j: u64 = i + nk;
                while (j < n) {
                    if (src[j] == 32) { j = j + 1; continue; }
                    if (src[j] == 9) { j = j + 1; continue; }
                    if (src[j] == 61) { j = j + 1; continue; }
                    break;
                }
                if (j < n) {
                    if (src[j] == 34) {
                        var v: StringBuilder = sb_new();
                        j = j + 1;
                        while (j < n) {
                            if (src[j] == 34) {
                                break;
                            }
                            sb_append_char(v, src[j]);
                            j = j + 1;
                        }
                        return sb_to_str(v);
                    }
                }
            }
        }
        i = i + 1;
    }
    return "";
}

// 返回 "deps" 行首字符下标；找不到时返回 str_len(src)（哨兵）
deps_start fn(src: string) -> u64 {
    var n: u64 = str_len(src);
    var i: u64 = 0;
    while (i + 3 < n) {
        if (src[i] == 100) {
            if (src[i + 1] == 101) {
                if (src[i + 2] == 112) {
                    if (src[i + 3] == 115) {
                        return i;
                    }
                }
            }
        }
        i = i + 1;
    }
    return n;
}

// 返回 deps 行的结束位置（下一个 \n 或文末）
deps_end fn(src: string, start: u64) -> u64 {
    var n: u64 = str_len(src);
    var j: u64 = start;
    while (j < n) {
        if (src[j] == 10) {
            break;
        }
        j = j + 1;
    }
    return j;
}

// ────────────────────────────────────────────────────────────────
// 子命令
// ────────────────────────────────────────────────────────────────

print_help fn() -> void {
    println("tote — t 语言包管理器与构建系统");
    println("");
    println("用法:");
    println("  tote init                 在当前目录生成 tote.toml 与 src/main.tc");
    println("  tote build [file.tc]      构建（无 file 时取 tote.toml 的 entry）；委托 tc");
    println("  tote run [file.tc]        构建并运行；委托 tc");
    println("  tote compile <file.tc>    仅生成 C 源码；委托 tc");
    println("  tote check <file.tc>      类型检查；委托 tc");
    println("  tote lex <file.tc>        token 流；委托 tc");
    println("  tote emit-ll <file.tc>    生成 LLVM IR；委托 tc");
    println("  tote deps [file.tc]       打印模块依赖图(JSON)；委托 tc check --emit-deps");
    println("  tote install <pkg>        在 tote.toml 登记一个依赖");
    println("  tote help                 显示本帮助");
    println("");
    println("tote 按序查找 out/dbg/tc.exe、out/rls/tc.exe，最后回退 PATH 上的 tc。");
}

cmd_init fn() -> i32 {
    if (path_exists("tote.toml")) {
        eprint("tote: tote.toml 已存在，init 中止\n");
        return 1;
    }
    var manifest: StringBuilder = sb_new();
    sb_append_str(manifest, "[package]\n");
    sb_append_str(manifest, "name = \"app\"\n");
    sb_append_str(manifest, "entry = \"src/main.tc\"\n");
    sb_append_str(manifest, "deps = []\n");
    sb_append_str(manifest, "\n");
    sb_append_str(manifest, "# 构建/运行将委托 tc 编译器（默认 out/<mode>/tc.exe，或 PATH 上的 tc）\n");
    file_write_all("tote.toml", sb_to_str(manifest));

    if (path_exists("src/main.tc") == false) {
        sys_run("cmd /c if not exist \"src\" mkdir \"src\"");
        var main: StringBuilder = sb_new();
        sb_append_str(main, "// 由 tote init 生成\n");
        sb_append_str(main, "main fn() -> i32 @main {\n");
        sb_append_str(main, "    println(\"hello from tote\");\n");
        sb_append_str(main, "    return 0;\n");
        sb_append_str(main, "}\n");
        file_write_all("src/main.tc", sb_to_str(main));
    }
    println("tote: 已生成 tote.toml 与 src/main.tc（运行 tote build 试试）");
    return 0;
}

cmd_install fn(argv: []string) -> i32 {
    if (slice_len(argv) < 3) {
        eprint("tote: install 需要包名，用法: tote install <pkg>\n");
        return 2;
    }
    var pkg: string = argv[2];
    if (path_exists("tote.toml") == false) {
        eprint("tote: 当前目录没有 tote.toml，请先 tote init\n");
        return 1;
    }
    var src: string = file_read_all("tote.toml");
    var slen: u64 = str_len(src);
    var s: u64 = deps_start(src);
    if (s >= slen) {
        // 没有 deps 行：直接追加
        var appended: string = str_concat3(src, "\ndeps = [\"", str_concat2(pkg, "\"]\n"));
        file_write_all("tote.toml", appended);
        println(str_concat3("tote: 已登记依赖 ", pkg, ""));
        return 0;
    }
    var e: u64 = deps_end(src, s);
    // 行首（上一个 \n 之后）
    var ls: u64 = s;
    while (ls > 0) {
        if (src[ls - 1] == 10) {
            break;
        }
        ls = ls - 1;
    }
    var before: string = str_slice(src, 0, ls);
    var after: string = str_slice(src, e, slen);
    // 扫描 deps 数组内容，收集现有包并查重
    var body: string = str_slice(src, s, e);
    var bn: u64 = str_len(body);
    var bi: u64 = 0;
    var newlist: StringBuilder = sb_new();
    var first: bool = true;
    var found: bool = false;
    while (bi < bn) {
        if (body[bi] == 34) {
            var nm: StringBuilder = sb_new();
            bi = bi + 1;
            while (bi < bn) {
                if (body[bi] == 34) {
                    break;
                }
                sb_append_char(nm, body[bi]);
                bi = bi + 1;
            }
            var pname: string = sb_to_str(nm);
            if (pname == pkg) {
                found = true;
            }
            if (first == false) {
                sb_append_str(newlist, ", ");
            }
            sb_append_char(newlist, 34);
            sb_append_str(newlist, pname);
            sb_append_char(newlist, 34);
            first = false;
        }
        bi = bi + 1;
    }
    if (found) {
        println(str_concat3("tote: 依赖 ", pkg, " 已在 tote.toml 中"));
        return 0;
    }
    if (first == false) {
        sb_append_str(newlist, ", ");
    }
    sb_append_char(newlist, 34);
    sb_append_str(newlist, pkg);
    sb_append_char(newlist, 34);
    var newline: string = str_concat3("deps = [", sb_to_str(newlist), "]");
    var new_src: string = str_concat3(before, newline, after);
    file_write_all("tote.toml", new_src);
    println(str_concat3("tote: 已登记依赖 ", pkg, ""));
    return 0;
}

// 将 compile/check/lex/emit-ll/build/run 转发给 tc
cmd_build_or_run fn(cmd: string, argv: []string) -> i32 {
    var tc: string = find_tc();
    var an: i64 = slice_len(argv) as i64;
    var has_file: bool = false;
    var ai: i64 = 2;
    while (ai < an) {
        if (ends_with(argv[ai], ".tc")) {
            has_file = true;
        }
        ai = ai + 1;
    }
    var entry: string = "";
    var want_entry: bool = false;
    if (cmd == "build") {
        want_entry = true;
    }
    if (cmd == "run") {
        want_entry = true;
    }
    if (has_file == false) {
        if (want_entry) {
            if (path_exists("tote.toml")) {
                entry = toml_string_value(file_read_all("tote.toml"), "entry");
            }
            if (entry == "") {
                entry = "src/main.tc";
            }
        }
    }
    var tc_cmd: string = cmd;
    if (cmd == "deps") { tc_cmd = "check"; }
    var sb: StringBuilder = sb_new();
    sb_append_char(sb, 34);
    sb_append_str(sb, to_bs(tc));
    sb_append_char(sb, 34);
    sb_append_char(sb, 32);
    sb_append_str(sb, tc_cmd);
    if (cmd == "deps") {
        sb_append_char(sb, 32);
        sb_append_str(sb, "--emit-deps");
    }
    if (entry != "") {
        sb_append_char(sb, 32);
        sb_append_char(sb, 34);
        sb_append_str(sb, entry);
        sb_append_char(sb, 34);
    }
    append_lib_dirs(sb);          // 注入 T_LIB_PATH / ~/.tote/libs 解析出的 --lib-dir
    // 调试构建（未显式 --mode rls）时链接调试态库 .tlibd：import 优先 .tlibd，缺失回退 .tlib
    if (cmd == "build" || cmd == "run") {
        var rl: bool = false;
        var ki: i64 = 2;
        while (ki < an) {
            if (argv[ki] == "--mode" && ki + 1 < an && argv[ki + 1] == "rls") { rl = true; }
            ki = ki + 1;
        }
        if (rl == false) {
            sb_append_char(sb, 32);
            sb_append_str(sb, "--debug-libs");
        }
    }
    ai = 2;
    while (ai < an) {
        sb_append_char(sb, 32);
        sb_append_char(sb, 34);
        sb_append_str(sb, argv[ai]);
        sb_append_char(sb, 34);
        ai = ai + 1;
    }
    var run_cmd: string = sb_to_str(sb);
    println(str_concat3("tote: 委托 tc -> ", to_bs(run_cmd), ""));
    var rc: i32 = sys_run(run_cmd);
    return rc;
}

main fn() -> i32 @main {
    var argv: []string = args();
    if (slice_len(argv) < 2) {
        print_help();
        return 2;
    }
    var cmd: string = argv[1];
    if (cmd == "init") {
        return cmd_init();
    }
    if (cmd == "install") {
        return cmd_install(argv);
    }
    if (cmd == "help") {
        print_help();
        return 0;
    }
    if (cmd == "-h") {
        print_help();
        return 0;
    }
    if (cmd == "--help") {
        print_help();
        return 0;
    }
    if (cmd == "--version") {
        println("tote 0.1.0");
        return 0;
    }
    if (cmd == "-v") {
        println("tote 0.1.0");
        return 0;
    }
    var is_fwd: bool = false;
    if (cmd == "build") { is_fwd = true; }
    if (cmd == "run") { is_fwd = true; }
    if (cmd == "compile") { is_fwd = true; }
    if (cmd == "check") { is_fwd = true; }
    if (cmd == "lex") { is_fwd = true; }
    if (cmd == "emit-ll") { is_fwd = true; }
    if (cmd == "deps") { is_fwd = true; }
    if (is_fwd) {
        return cmd_build_or_run(cmd, argv);
    }
    eprint(str_concat3("tote: 未知命令 ", cmd, "\n"));
    print_help();
    return 2;
}
