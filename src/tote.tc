    _xidv = 201552; append(xid_cont_lo, _xidv);
    _xidv = 210041; append(xid_cont_hi, _xidv);
    _xidv = 917760; append(xid_cont_lo, _xidv);
    _xidv = 917999; append(xid_cont_hi, _xidv);
}
// <<< GEN:xid <<<

is_digit :: func(c: u8) -> bool {
    return c >= 48 && c <= 57;
}

// 标识符首字符：XID_Start + 下划线（向后兼容 ASCII 习惯）。
is_ident_start :: func(cp: i64) -> bool {
    if (cp == 95) { return true; }
    return cp_in_ranges(cp, xid_start_lo, xid_start_hi);
}

// 标识符续字符：XID_Continue + 下划线 + 数字（数字本就在 XID_Continue 内，显式列出无害）。
is_ident_cont :: func(cp: i64) -> bool {
    if (cp == 95) { return true; }
    if (cp >= 48 && cp <= 57) { return true; }
    return cp_in_ranges(cp, xid_cont_lo, xid_cont_hi);
}

is_hex_digit :: func(c: u8) -> bool {
    if (c >= 48 && c <= 57) { return true; }
    if (c >= 97 && c <= 102) { return true; }
    return c >= 65 && c <= 70;
}

is_bin_digit :: func(c: u8) -> bool {
    return c == 48 || c == 49;
}

// >>> GEN:kw_lookup (generated by tools/totter.tc from build/ebnf.json -- DO NOT EDIT) >>>
KwEntry :: struct {
    text: string;
    kind: string;
}

var keywords_tbl: []KwEntry;

kw_reg :: func(t: string, k: string) -> void {
    var e: KwEntry;
    e.text = t;
    e.kind = k;
    append(keywords_tbl, e);
}

init_keywords :: func() -> void {
    kw_reg("func", "KwFunc");
    kw_reg("struct", "KwStruct");
    kw_reg("enum", "KwEnum");
    kw_reg("flag", "KwFlag");
    kw_reg("union", "KwUnion");
    kw_reg("variant", "KwVariant");
    kw_reg("var", "KwVar");
    kw_reg("const", "KwConst");
    kw_reg("comptime", "KwComptime");
    kw_reg("if", "KwIf");
    kw_reg("else", "KwElse");
    kw_reg("for", "KwFor");
    kw_reg("while", "KwWhile");
    kw_reg("switch", "KwSwitch");
    kw_reg("case", "KwCase");
    kw_reg("default", "KwDefault");
    kw_reg("break", "KwBreak");
    kw_reg("continue", "KwContinue");
    kw_reg("return", "KwReturn");
    kw_reg("true", "KwTrue");
    kw_reg("false", "KwFalse");
    kw_reg("null", "KwNull");
    kw_reg("map", "KwMap");
    kw_reg("import", "KwImport");
    kw_reg("export", "KwExport");
    kw_reg("as", "KwAs");
    kw_reg("in", "KwIn");
    kw_reg("defer", "KwDefer");
    kw_reg("void", "KwVoid");
    kw_reg("string", "KwString");
    kw_reg("StringBuilder", "KwStringBuilder");
}

kw_lookup :: func(text: string) -> string {
    var i: i64 = 0;
    while (i < (slice_len(keywords_tbl) as i64)) {
        if (keywords_tbl[i].text == text) { return keywords_tbl[i].kind; }
        i = i + 1;
    }
    return "";
}
// <<< GEN:kw_lookup <<<


op2_name :: func(a: u8, b: u8) -> string {
    if (a == 45 && b == 62) { return "Arrow"; }
    if (a == 58 && b == 58) { return "DoubleColon"; }
    if (a == 61 && b == 61) { return "Eq"; }
    if (a == 33 && b == 61) { return "NotEq"; }
    if (a == 60 && b == 61) { return "LtEq"; }
    if (a == 62 && b == 61) { return "GtEq"; }
    if (a == 38 && b == 38) { return "And"; }
    if (a == 124 && b == 124) { return "Or"; }
    if (a == 60 && b == 60) { return "ShiftLeft"; }
    if (a == 62 && b == 62) { return "ShiftRight"; }
    if (a == 46 && b == 46) { return "DoubleDot"; }
    if (a == 43 && b == 61) { return "PlusAssign"; }
    if (a == 45 && b == 61) { return "MinusAssign"; }
    if (a == 42 && b == 61) { return "StarAssign"; }
    if (a == 47 && b == 61) { return "SlashAssign"; }
    if (a == 37 && b == 61) { return "PercentAssign"; }
    if (a == 38 && b == 61) { return "BitAndAssign"; }
    if (a == 124 && b == 61) { return "BitOrAssign"; }
    if (a == 94 && b == 61) { return "BitXorAssign"; }
    return "";
}

op1_name :: func(c: u8) -> string {
    if (c == 43) { return "Plus"; }
    if (c == 45) { return "Minus"; }
    if (c == 42) { return "Star"; }
    if (c == 47) { return "Slash"; }
    if (c == 37) { return "Percent"; }
    if (c == 61) { return "Assign"; }
    if (c == 60) { return "Lt"; }
    if (c == 62) { return "Gt"; }
    if (c == 33) { return "Not"; }
    if (c == 38) { return "BitAnd"; }
    if (c == 124) { return "BitOr"; }
    if (c == 94) { return "BitXor"; }
    if (c == 126) { return "BitNot"; }
    if (c == 58) { return "Colon"; }
    if (c == 46) { return "Dot"; }
    if (c == 63) { return "Question"; }
    if (c == 40) { return "LParen"; }
    if (c == 41) { return "RParen"; }
    if (c == 123) { return "LBrace"; }
    if (c == 125) { return "RBrace"; }
    if (c == 91) { return "LBracket"; }
    if (c == 93) { return "RBracket"; }
    if (c == 44) { return "Comma"; }
    if (c == 59) { return "Semicolon"; }
    return "";
}

// ── token 入池 ─────────────────────────────────────────────────

push_tok :: func(tname: string, value: string, line: u64, col: u64) -> void {
    var tk: Tok;
    tk.t = tname;
    tk.v = value;
    tk.line = line;
    tk.col = col;
    append(toks, tk);
}

// ── lexer：源码 → token 池（逻辑照抄 lexer.tc）─────────────────

tokenize :: func(src: string) -> void {
    var tmp: StringBuilder = sb_new();
    var i: u64 = 0;
    var n: u64 = str_len(src);
    var line: u64 = 1;
    var col: u64 = 1;

    while (i < n) {
        var c: u8 = src[i];

        if (c == 32 || c == 9 || c == 13) {
            i = i + 1;
            col = col + 1;
            continue;
        }
        if (c == 10) {
            i = i + 1;
            line = line + 1;
            col = 1;
            continue;
        }

        if (c == 47 && i + 1 < n && src[i + 1] == 47) {
            while (i < n && src[i] != 10) {
                i = i + 1;
                col = col + 1;
            }
            continue;
        }

        if (c == 47 && i + 1 < n && src[i + 1] == 42) {
            i = i + 2;
            col = col + 2;
            var closed: bool = false;
            while (i < n) {
                if (src[i] == 42 && i + 1 < n && src[i + 1] == 47) {
                    i = i + 2;
                    col = col + 2;
                    closed = true;
                    break;
                }
                if (src[i] == 10) {
                    line = line + 1;
                    col = 1;
                } else {
                    col = col + 1;
                }
                i = i + 1;
            }
            if (closed == false) {
                eprint("error: unterminated block comment\n");
                exit(1);
            }
            continue;
        }

        if (is_digit(c)) {
            var tl: u64 = line;
            var tcol: u64 = col;

            if (c == 48 && i + 1 < n && (src[i + 1] == 120 || src[i + 1] == 88)) {
                sb_clear(tmp);
                sb_append_str(tmp, "0x");
                i = i + 2;
                col = col + 2;
                var hexcnt: u64 = 0;
                while (i < n && is_hex_digit(src[i])) {
                    sb_append_char(tmp, src[i]);
                    i = i + 1;
                    col = col + 1;
                    hexcnt = hexcnt + 1;
                }
                if (hexcnt == 0) {
                    eprint("error: hex literal has no digits after 0x\n");
                    exit(1);
                }
                push_tok("Integer", sb_to_str(tmp), tl, tcol);
                continue;
            }

            if (c == 48 && i + 1 < n && (src[i + 1] == 98 || src[i + 1] == 66)) {
                sb_clear(tmp);
                sb_append_str(tmp, "0b");
                i = i + 2;
                col = col + 2;
                var bincnt: u64 = 0;
                while (i < n && is_bin_digit(src[i])) {
                    sb_append_char(tmp, src[i]);
                    i = i + 1;
                    col = col + 1;
                    bincnt = bincnt + 1;
                }
                if (bincnt == 0) {
                    eprint("error: binary literal has no digits after 0b\n");
                    exit(1);
                }
                push_tok("Integer", sb_to_str(tmp), tl, tcol);
                continue;
            }

            var ns: u64 = i;
            while (i < n && is_digit(src[i])) {
                i = i + 1;
                col = col + 1;
            }

            if (i < n && src[i] == 46 && i + 1 < n && is_digit(src[i + 1])) {
                i = i + 1;
                col = col + 1;
                while (i < n && is_digit(src[i])) {
                    i = i + 1;
                    col = col + 1;
                }
                if (i < n && (src[i] == 101 || src[i] == 69)) {
                    i = i + 1;
                    col = col + 1;
                    if (i < n && (src[i] == 43 || src[i] == 45)) {
                        i = i + 1;
                        col = col + 1;
                    }
                    while (i < n && is_digit(src[i])) {
                        i = i + 1;
                        col = col + 1;
                    }
                }
                push_tok("Float", str_slice(src, ns, i), tl, tcol);
                continue;
            }

            push_tok("Integer", str_slice(src, ns, i), tl, tcol);
            continue;
        }

        if (c == 34) {
            var sl: u64 = line;
            var scol: u64 = col;
            i = i + 1;
            col = col + 1;
            sb_clear(tmp);
            while (i < n && src[i] != 34) {
                if (src[i] == 92) {
                    i = i + 1;
                    col = col + 1;
                    if (i >= n) {
                        break;
                    }
                    var e: u8 = src[i];
                    if (src[i] == 10) {
                        line = line + 1;
                        col = 1;
                    } else {
                        col = col + 1;
                    }
                    i = i + 1;
                    if (e == 110) {
                        sb_append_char(tmp, 10);
                    } else {
                    if (e == 116) {
                        sb_append_char(tmp, 9);
                    } else {
                    if (e == 114) {
                        sb_append_char(tmp, 13);
                    } else {
                    if (e == 34) {
                        sb_append_char(tmp, 34);
                    } else {
                    if (e == 92) {
                        sb_append_char(tmp, 92);
                    } else {
                    if (e == 48) {
                        sb_append_char(tmp, 0);
                    } else {
                        sb_append_char(tmp, e);
                    }}}}}}
                } else {
                    if (src[i] == 10) {
                        line = line + 1;
                        col = 1;
                    } else {
                        col = col + 1;
                    }
                    sb_append_char(tmp, src[i]);
                    i = i + 1;
                }
            }
            if (i >= n) {
                eprint("error: unterminated string literal\n");
                exit(1);
            }
            i = i + 1;
            col = col + 1;
            push_tok("String", sb_to_str(tmp), sl, scol);
            continue;
        }

        if (is_ident_start(utf8_cp_at(src, i as i64, n as i64))) {
            var il: u64 = line;
            var icol: u64 = col;
            var is0: u64 = i;
            var w0: i64 = utf8_w0(src[i]);
            i = i + w0 as u64;
            col = col + w0 as u64;
            while (i < n) {
                var cpc: i64 = utf8_cp_at(src, i as i64, n as i64);
                if (is_ident_cont(cpc) == false) { break; }
                var wc: i64 = utf8_w0(src[i]);
                i = i + wc as u64;
                col = col + wc as u64;
            }
            var text: string = str_slice(src, is0, i);
            var tname: string = kw_lookup(text);
            if (str_len(tname) == 0) {
                tname = "Identifier";
            }
            push_tok(tname, text, il, icol);
            continue;
        }

        if (c == 64) {
            push_tok("At", "@", line, col);
            i = i + 1;
            col = col + 1;
            continue;
        }
        if (c == 35) {
            push_tok("Hash", "#", line, col);
            i = i + 1;
            col = col + 1;
            continue;
        }

        if (i + 2 < n && c == 60 && src[i + 1] == 60 && src[i + 2] == 61) {
            push_tok("ShlAssign", "<<=", line, col);
            i = i + 3;
            col = col + 3;
            continue;
        }
        if (i + 2 < n && c == 62 && src[i + 1] == 62 && src[i + 2] == 61) {
            push_tok("ShrAssign", ">>=", line, col);
            i = i + 3;
            col = col + 3;
            continue;
        }

        if (i + 1 < n) {
            var two: string = op2_name(c, src[i + 1]);
            if (str_len(two) > 0) {
                push_tok(two, str_slice(src, i, i + 2), line, col);
                i = i + 2;
                col = col + 2;
                continue;
            }
        }

        var one: string = op1_name(c);
        if (str_len(one) > 0) {
            push_tok(one, str_slice(src, i, i + 1), line, col);
            i = i + 1;
            col = col + 1;
            continue;
        }

        eprint("error: unexpected character\n");
        exit(1);
    }

    push_tok("Eof", "", line, col);
}

// ── parser 状态与 token 辅助 ──────────────────────────────────

var pos: i64;
var decl_list: []i64;

tk_t :: func(idx: i64) -> string {
    var tk: Tok = toks[idx];
    return tk.t;
}

tk_v :: func(idx: i64) -> string {
    var tk: Tok = toks[idx];
    return tk.v;
}

cur_t :: func() -> string {
    return tk_t(pos);
}

cur_v :: func() -> string {
    return tk_v(pos);
}

peek_t :: func(off: i64) -> string {
    var idx: i64 = pos + off;
    var n: i64 = slice_len(toks) as i64;
    if (idx >= n) {
        idx = n - 1;
    }
    return tk_t(idx);
}

// 前进一个 token，返回被消费 token 的下标（Eof 处不动，返回前一个）
advance_i :: func() -> i64 {
    if (cur_t() != "Eof") {
        pos = pos + 1;
    }
    return pos - 1;
}

expect_tok :: func(t: string) -> string {
    if (cur_t() == t) {
        var idx: i64 = advance_i();
        return tk_v(idx);
    }
    eprint("parse error: expected ");
    eprint(t);
    eprint(" but found ");
    eprint(cur_v());
    eprint("\n");
    exit(1);
    return "";
}

// parseInt(s, 10) 语义：取前导十进制数字
parse_int_str :: func(s: string) -> i64 {
    var r: i64 = 0;
    var i: u64 = 0;
    var n: u64 = str_len(s);
    while (i < n) {
        var c: u8 = s[i];
        if (is_digit(c) == false) {
            break;
        }
        r = r * 10 + ((c as i64) - 48);
        i = i + 1;
    }
    return r;
}

// 拼接两条 Child 链，返回新头
list_concat :: func(a: i64, b: i64) -> i64 {
    if (a < 0) {
        return b;
    }
    if (b < 0) {
        return a;
    }
    var it: i64 = a;
    while (true) {
        var c: Child = kids[it];
        if (c.next < 0) {
            c.next = b;
            slice_set(kids, it, c);
            break;
        }
        it = c.next;
    }
    return a;
}

// ── 注解解析 ───────────────────────────────────────────────────

parse_annotation_args :: func() -> i64 {
    var head: i64 = -1;
    var tail: i64 = -1;
    while (cur_t() != "RParen" && cur_t() != "Eof") {
        var t: string = cur_t();
        var made: i64 = -1;
        if (t == "String") {
            var idx: i64 = advance_i();
            made = mk_string(tk_v(idx), -1);
        } else {
        if (t == "Integer") {
            var idx2: i64 = advance_i();
            made = mk_number(tk_v(idx2), -1);
        } else {
        if (t == "Identifier") {
            var ih: i64 = -1;
            var it: i64 = -1;
            var cnt: i64 = 1;
            var idx3: i64 = advance_i();
            var id1: i64 = mk_ident(tk_v(idx3), -1);
            it = list_push(ih, it, id1);
            ih = it;
            while (cur_t() == "Comma") {
                advance_i();
                var v2: string = expect_tok("Identifier");
                var id2: i64 = mk_ident(v2, -1);
                it = list_push(ih, it, id2);
                cnt = cnt + 1;
            }
            if (cnt == 1) {
                made = id1;
            } else {
                made = mk_list(ih, -1);
            }
        } else {
            eprint("parse error: invalid annotation argument\n");
            exit(1);
        }}}
        tail = list_push(head, tail, made);
        if (head < 0) {
            head = tail;
        }
        if (cur_t() != "RParen") {
            if (cur_t() == "Comma") {
                advance_i();
            }
        }
    }
    return head;
}

parse_annotations :: func() -> i64 {
    var head: i64 = -1;
    var tail: i64 = -1;
    while (cur_t() == "At") {
        advance_i();
        var name: string = "";
        var nti: i64 = pos;
        if (cur_t() == "Identifier" || cur_t() == "KwExport") {
            var idx: i64 = advance_i();
            name = tk_v(idx);
            nti = idx;
        } else {
            name = expect_tok("Identifier");
            nti = pos - 1;
        }
        if (is_lower_snake(name) == false) {
            warn_name("T_NAME_ANNOTATION_LOWER", cat3("annotation name '", name, "' should be lowercase snake_case"), nti, str_len(name) as i64);
        }
        var args_head: i64 = -1;
        if (cur_t() == "LParen") {
            advance_i();
            args_head = parse_annotation_args();
            expect_tok("RParen");
        }
        var id: i64 = mk_A(name, args_head, nti);
        tail = list_push(head, tail, id);
        if (head < 0) {
            head = tail;
        }
    }
    return head;
}

// ── 类型解析 ───────────────────────────────────────────────────

is_scalar_name :: func(name: string) -> bool {
    if (name == "u8" || name == "u16" || name == "u32" || name == "u64") {
        return true;
    }
    if (name == "i8" || name == "i16" || name == "i32" || name == "i64") {
        return true;
    }
    if (name == "f16" || name == "f32" || name == "f64") {
        return true;
    }
    return name == "bool";
}

parse_type :: func() -> i64 {
    var t: string = cur_t();
    if (t == "KwMap") {
        advance_i();
        expect_tok("LBracket");
        var kt: i64 = parse_type();
        expect_tok("RBracket");
        var vt: i64 = parse_type();
        var id: i64 = mk_map(kt, vt, -1);
        return id;
    }
    if (t == "LBracket") {
        advance_i();
        if (cur_t() == "RBracket") {
            advance_i();
            var el: i64 = parse_type();
            var id2: i64 = mk_slice(el, -1);
            return id2;
        }
        var ln: i64 = parse_expr();
        expect_tok("RBracket");
        var el2: i64 = parse_type();
        var id3: i64 = mk_array(el2, ln, -1);
        return id3;
    }
    if (t == "Star") {
        advance_i();
        var el3: i64 = parse_type();
        var id4: i64 = mk_pointer(el3, -1);
        return id4;
    }
    if (t == "Question") {
        advance_i();
        var el4: i64 = parse_type();
        var id5: i64 = mk_optional(el4, -1);
        return id5;
    }
    if (t == "KwVoid") {
        advance_i();
        return mk_scalar("void", -1);
    }
    if (t == "KwString") {
        advance_i();
        return mk_scalar("string", -1);
    }
    if (t == "KwStringBuilder") {
        advance_i();
        return mk_scalar("StringBuilder", -1);
    }
    if (t == "Identifier") {
        var idx: i64 = advance_i();
        var name: string = tk_v(idx);
        if (name == "flag") {
            if (cur_t() == "LBracket") {
                advance_i();
                var ui: i64 = advance_i();
                expect_tok("RBracket");
                var idf: i64 = mk_flag(tk_v(ui), -1);
                return idf;
            }
        }
        if (name == "flag_set") {
            return mk_flag_set(-1);
        }
        if (name == "Variant") {
            return mk_variant(-1);
        }
        if (is_scalar_name(name)) {
            return mk_scalar(name, -1);
        }
        var idn: i64 = mk_named(name, -1);
        return idn;
    }
    eprint("parse error: expected type\n");
    exit(1);
    return -1;
}

// ── 表达式解析（优先级爬升，逐层照抄 tc0）─────────────────────

mk_bin :: func(op: string, left: i64, right: i64, ti: i64) -> i64 {
    var id: i64 = mk_binary(op, left, right, ti);
    return id;
}

parse_expr :: func() -> i64 {
    return parse_assign_expr();
}

parse_assign_expr :: func() -> i64 {
    var left: i64 = parse_or();
    if (cur_t() == "Assign") {
        var ti: i64 = advance_i();
        var right: i64 = parse_assign_expr();
        var id: i64 = mk_assign("=", left, right, ti);
        return id;
    }
    return left;
}


// 语义胶水：前缀一元运算符构造（fold=pre 生成代码调用，tote.tc 手写保持于 GEN:parser_rules 区间外）
mk_un :: func(op: string, operand: i64, ti: i64) -> i64 {
    var id: i64 = mk_unary(op, operand, ti);
    return id;
}

parse_post_member :: func(e: i64, ti: i64) -> i64 {
    var member: string = expect_tok("Identifier");
    var id: i64 = mk_member(member, e, ti);
    return id;
}

parse_post_index :: func(e: i64, ti: i64) -> i64 {
    var index: i64 = parse_expr();
    expect_tok("RBracket");
    var id: i64 = mk_index(e, index, ti);
    return id;
}

parse_post_call :: func(e: i64, ti: i64) -> i64 {
    var head: i64 = -1;
    var tail: i64 = -1;
    while (cur_t() != "RParen" && cur_t() != "Eof") {
        var arg: i64 = parse_expr();
        tail = list_push(head, tail, arg);
        if (head < 0) {
            head = tail;
        }
        if (cur_t() == "Comma") {
            advance_i();
        } else {
            break;
        }
    }
    expect_tok("RParen");
    var id: i64 = mk_call(e, head, ti);
    return id;
}

parse_post_cast :: func(e: i64, ti: i64) -> i64 {
    var tt: i64 = parse_type();
    var id: i64 = mk_cast(e, tt, ti);
    return id;
}

starts_with_0x :: func(s: string) -> bool {
    if (str_len(s) < 2) {
        return false;
    }
    if (s[0] != 48) {
        return false;
    }
    return s[1] == 120 || s[1] == 88;
}

starts_with_0b :: func(s: string) -> bool {
    if (str_len(s) < 2) {
        return false;
    }
    if (s[0] != 48) {
        return false;
    }
    return s[1] == 98 || s[1] == 66;
}

looks_like_struct_lit :: func() -> bool {
    if (peek_t(1) == "RBrace") {
        return true;
    }
    if (peek_t(1) == "Identifier" && peek_t(2) == "Colon") {
        return true;
    }
    return false;
}

parse_struct_lit :: func(type_name: string, ti: i64) -> i64 {
    advance_i();
    var head: i64 = -1;
    var tail: i64 = -1;
    while (cur_t() != "RBrace" && cur_t() != "Eof") {
        var fname: string = expect_tok("Identifier");
        expect_tok("Colon");
        var val: i64 = parse_expr();
        var fid: i64 = mk_FV(fname, val, -1);
        tail = list_push(head, tail, fid);
        if (head < 0) {
            head = tail;
        }
        if (cur_t() == "Comma") {
            advance_i();
        } else {
            break;
        }
    }
    expect_tok("RBrace");
    var id: i64 = mk_struct_lit(type_name, head, ti);
    return id;
}

parse_map_lit :: func(ti: i64) -> i64 {
    var head: i64 = -1;
    var tail: i64 = -1;
    while (cur_t() != "RBracket" && cur_t() != "Eof") {
        var k: i64 = parse_expr();
        expect_tok("Colon");
        var v: i64 = parse_expr();
        var eid: i64 = mk_EN(k, v, -1);
        tail = list_push(head, tail, eid);
        if (head < 0) {
            head = tail;
        }
        if (cur_t() == "Comma") {
            advance_i();
        } else {
            break;
        }
    }
    expect_tok("RBracket");
    var id: i64 = mk_map_lit(head, ti);
    return id;
}

parse_array_lit :: func(ti: i64) -> i64 {
    var is_maplit: bool = cur_t() == "Identifier" || cur_t() == "String" || cur_t() == "Integer";
    if (is_maplit && peek_t(1) == "Colon") {
        return parse_map_lit(ti);
    }
    var head: i64 = -1;
    var tail: i64 = -1;
    while (cur_t() != "RBracket" && cur_t() != "Eof") {
        var e: i64 = parse_expr();
        tail = list_push(head, tail, e);
        if (head < 0) {
            head = tail;
        }
        if (cur_t() == "Comma") {
            advance_i();
        } else {
            break;
        }
    }
    expect_tok("RBracket");
    var id: i64 = mk_array_lit(head, ti);
    return id;
}

// primary 胶水 helper（fold=prim 骨架已消费分发 token，ti 为其下标）
parse_prim_int :: func(ti: i64) -> i64 {
    var val: string = tk_v(ti);
    var radix: i64 = 10;
    if (starts_with_0x(val)) {
        radix = 16;
    } else {
        if (starts_with_0b(val)) {
            radix = 2;
        }
    }
    var id: i64 = mk_int(val, radix, ti);
    return id;
}

parse_prim_float :: func(ti: i64) -> i64 {
    var id: i64 = mk_float(tk_v(ti), ti);
    return id;
}

parse_prim_str :: func(ti: i64) -> i64 {
    var id: i64 = mk_string(tk_v(ti), ti);
    return id;
}

parse_prim_true :: func(ti: i64) -> i64 {
    var id: i64 = mk_bool(true, ti);
    return id;
}

parse_prim_false :: func(ti: i64) -> i64 {
    var id: i64 = mk_bool(false, ti);
    return id;
}

parse_prim_null :: func(ti: i64) -> i64 {
    var id: i64 = mk_null(ti);
    return id;
}

parse_prim_ident :: func(ti: i64) -> i64 {
    var name: string = tk_v(ti);
    if (cur_t() == "LBrace" && looks_like_struct_lit()) {
        return parse_struct_lit(name, ti);
    }
    var id: i64 = mk_ident(name, ti);
    return id;
}

parse_prim_paren :: func(ti: i64) -> i64 {
    var inner: i64 = parse_expr();
    expect_tok("RParen");
    var id: i64 = mk_paren(inner, ti);
    return id;
}

parse_prim_array :: func(ti: i64) -> i64 {
    return parse_array_lit(ti);
}

// ── 语句解析 ───────────────────────────────────────────────────

parse_block :: func() -> i64 {
    expect_tok("LBrace");
    var head: i64 = -1;
    var tail: i64 = -1;
    while (cur_t() != "RBrace" && cur_t() != "Eof") {
        var s: i64 = parse_statement();
        if (s >= 0) {
            tail = list_push(head, tail, s);
            if (head < 0) {
                head = tail;
            }
        }
    }
    expect_tok("RBrace");
    return head;
}

parse_local_var :: func(is_const: bool) -> i64 {
    var ti: i64 = advance_i();
    var name: string = expect_tok("Identifier");
    var nti: i64 = pos - 1;
    var tn: i64 = -1;
    if (cur_t() == "Colon") {
        advance_i();
        tn = parse_type();
    }
    var init: i64 = -1;
    if (cur_t() == "Assign") {
        advance_i();
        init = parse_expr();
    }
    expect_tok("Semicolon");
    if (is_const) {
        validate_const_name(name, nti);
    } else {
        validate_var_name(name, nti);
    }
    var id: i64 = mk_var_decl(name, is_const, tn, init, ti);
    return id;
}

parse_expr_or_assign_stmt :: func() -> i64 {
    var ti: i64 = pos;
    var e: i64 = parse_expr();
    var t: string = cur_t();
    var is_assign: bool = false;
    if (t == "Assign" || t == "PlusAssign" || t == "MinusAssign" || t == "StarAssign") {
        is_assign = true;
    }
    if (t == "SlashAssign" || t == "PercentAssign" || t == "BitAndAssign" || t == "BitOrAssign") {
        is_assign = true;
    }
    if (t == "BitXorAssign" || t == "ShlAssign" || t == "ShrAssign") {
        is_assign = true;
    }
    if (is_assign) {
        var oi: i64 = advance_i();
        var op: string = tk_v(oi);
        var val: i64 = parse_expr();
        expect_tok("Semicolon");
        var id: i64 = mk_assignment(op, e, val, ti);
        return id;
    }
    expect_tok("Semicolon");
    var id2: i64 = mk_expr(e, ti);
    return id2;
}

// ── statement 分发胶水（fold=disp 目标；自行消费引导 token，GEN 区外）──

parse_break_stmt :: func() -> i64 {
    var tb: i64 = advance_i();
    expect_tok("Semicolon");
    var idb: i64 = mk_break(tb);
    return idb;
}

parse_continue_stmt :: func() -> i64 {
    var tc: i64 = advance_i();
    expect_tok("Semicolon");
    var idc: i64 = mk_continue(tc);
    return idc;
}

parse_defer_stmt :: func() -> i64 {
    var td: i64 = advance_i();
    var body: i64 = parse_block();
    var id: i64 = mk_defer(body, td);
    return id;
}

parse_comptime_stmt :: func() -> i64 {
    var tm: i64 = advance_i();
    if (cur_t() == "LBrace") {
        var body2: i64 = parse_block();
        var id2: i64 = mk_comptime_block(body2, tm);
        return id2;
    }
    var e: i64 = parse_expr();
    expect_tok("Semicolon");
    var ce: i64 = mk_comptime(e, tm);
    var id3: i64 = mk_expr(ce, tm);
    return id3;
}

parse_block_stmt :: func() -> i64 {
    var tl: i64 = pos;
    var body3: i64 = parse_block();
    var id4: i64 = mk_block(body3, tl);
    return id4;
}

parse_var_stmt :: func() -> i64 {
    return parse_local_var(false);
}

parse_const_stmt :: func() -> i64 {
    return parse_local_var(true);
}

// parse_statement 已由 GEN:parser_rules 区间生成（fold=disp 守卫式分发）。

// ── 注解查找辅助 ───────────────────────────────────────────────

// 在注解链中查找名为 name 的第一个注解，返回节点下标或 -1
ann_find :: func(head: i64, name: string) -> i64 {
    var it: i64 = head;
    while (it >= 0) {
        var c: Child = kids[it];
        var an: Node = nodes[c.val];
        if (an.sa == name) {
            return c.val;
        }
        it = c.next;
    }
    return -1;
}

// 注解的第一个参数节点下标，无参数返回 -1
ann_first_arg :: func(ann_idx: i64) -> i64 {
    var an: Node = nodes[ann_idx];
    if (an.la < 0) {
        return -1;
    }
    var c: Child = kids[an.la];
    return c.val;
}

// ── 声明解析 ───────────────────────────────────────────────────

// parse_struct_decl / parse_sfield 已由 GEN:parser_rules 区间生成（见下方标记区）。
// 注意语义等价性：手写版按 is_bitpack 状态二分成员形态；生成版用 FIRST 守卫 alt
// （Integer → 位宽成员，其余 → 类型成员），对合法输入等价（类型永不以 Integer 开头）。

parse_enum_decl :: func(name: string, anns: i64) -> i64 {
    advance_i();
    var underlying: string = "u32";
    if (cur_t() == "Colon") {
        advance_i();
        var ti: i64 = advance_i();
        underlying = tk_v(ti);
    }
    var post: i64 = parse_annotations();
    var all: i64 = list_concat(anns, post);

    expect_tok("LBrace");
    var vh: i64 = -1;
    var vt: i64 = -1;
    while (cur_t() != "RBrace" && cur_t() != "Eof") {
        if (cur_t() == "At" || cur_t() != "Identifier") {
            advance_i();
            continue;
        }
        var vname: string = expect_tok("Identifier");
        var val: i64 = -1;
        if (cur_t() == "Assign") {
            advance_i();
            val = parse_expr();
        }
        var vanns: i64 = parse_annotations();
        if (cur_t() == "Comma") {
            advance_i();
        }
        var vid: i64 = mk_V(vname, val, vanns, -1);
        vt = list_push(vh, vt, vid);
        if (vh < 0) {
            vh = vt;
        }
    }
    expect_tok("RBrace");

    var id: i64 = mk_EnumDecl(name, underlying, all, vh, -1);
    return id;
}

// ── flag 语义 helper（供 GEN:parser_rules 生成的 parse_flag_decl/parse_slot 调用）──
// 可选捕获缺省值：s 为空（可选组未命中）时返回 d
str_or :: func(s: string, d: string) -> string {
    if (s == "") {
        return d;
    }
    return s;
}

// 从槽位注解里提取 @offset(n) 的 n；无则 -1
flag_offset_of :: func(sanns: i64) -> i64 {
    var oa: i64 = ann_find(sanns, "offset");
    if (oa >= 0) {
        var arg: i64 = ann_first_arg(oa);
        if (arg >= 0) {
            var argn: Node = nodes[arg];
            if (argn.kind == "number") {
                return parse_int_str(argn.sa);
            }
        }
    }
    return -1;
}

// 槽位是否带合法 @offset(n)
flag_has_offset :: func(sanns: i64) -> bool {
    var oa: i64 = ann_find(sanns, "offset");
    if (oa >= 0) {
        var arg: i64 = ann_first_arg(oa);
        if (arg >= 0) {
            var argn: Node = nodes[arg];
            if (argn.kind == "number") {
                return true;
            }
        }
    }
    return false;
}

// ── struct 语义 helper（供 GEN:parser_rules 生成的 parse_struct_decl/parse_sfield 调用）──
// 在两个注解列表（前置 anns / 后置 anns）里查 @bitpack，避免为检测而重复 list_concat
bp_arg2 :: func(a: i64, b: i64) -> i64 {
    var x: i64 = ann_find(a, "bitpack");
    if (x < 0) {
        x = ann_find(b, "bitpack");
    }
    if (x < 0) {
        return -2;  // 无 @bitpack（-1 留给"有 @bitpack 但无参数"）
    }
    var arg: i64 = ann_first_arg(x);
    return arg;  // >=0 参数节点；-1 无参数
}

// 是否带 @bitpack
bp_is2 :: func(a: i64, b: i64) -> bool {
    if (ann_find(a, "bitpack") >= 0) {
        return true;
    }
    return ann_find(b, "bitpack") >= 0;
}

// @bitpack(T) 的 T 名；无则 ""
bp_type2 :: func(a: i64, b: i64) -> string {
    var arg: i64 = bp_arg2(a, b);
    if (arg >= 0) {
        var argn: Node = nodes[arg];
        if (argn.kind == "ident") {
            return argn.sa;
        }
    }
    return "";
}

// 是否带合法 @bitpack(T)
bp_has_type2 :: func(a: i64, b: i64) -> bool {
    var arg: i64 = bp_arg2(a, b);
    if (arg >= 0) {
        var argn: Node = nodes[arg];
        if (argn.kind == "ident") {
            return true;
        }
    }
    return false;
}

// 成员二分形态选型：@Integer 命中（bitpack 位宽成员）→ mk_scalar("void", -1)；否则用 @type 结果
sfield_na :: func(bits: string, tn: i64) -> i64 {
    if (bits != "") {
        return mk_scalar("void", -1);
    }
    return tn;
}

// 位宽成员的 ia；非位宽成员 -1
sfield_ia :: func(bits: string) -> i64 {
    if (bits == "") {
        return -1;
    }
    return parse_int_str(bits);
}

// parse_union_decl / parse_umember 已由 GEN:parser_rules 区间生成（见下方标记区）

// Variant：带标签的聚合类型（tagged union）。
//   Name :: variant {
//       CaseA(T);     // 携带载荷
//       CaseB;        // 单元 case（无载荷）
//   }
// 编译为 struct { uint32_t _tag; union { T _u0; ... } _u; }，并为每个 case 生成
// 自由函数：`Name_from_Case(...)` 构造、`Name_is_Case(self)` 判别、`Name_as_Case(self)` 取载荷。
// parse_variant_decl / parse_case 已由 GEN:parser 区间生成（见下方标记区）

parse_func_decl :: func(name: string, anns: i64, is_comptime: bool) -> i64 {
    advance_i();
    expect_tok("LParen");
    var ph: i64 = -1;
    var pt: i64 = -1;
    while (cur_t() != "RParen" && cur_t() != "Eof") {
        var pname: string = expect_tok("Identifier");
        expect_tok("Colon");
        var ptn: i64 = parse_type();
        var panns: i64 = parse_annotations();
        var pid: i64 = mk_P(pname, ptn, panns, -1);
        pt = list_push(ph, pt, pid);
        if (ph < 0) {
            ph = pt;
        }
        if (cur_t() == "Comma") {
            advance_i();
        } else {
            break;
        }
    }
    expect_tok("RParen");
    expect_tok("Arrow");
    var rt: i64 = parse_type();
    var post: i64 = parse_annotations();
    var all: i64 = list_concat(anns, post);

    var body: i64 = -2;
    var is_extern: bool = false;
    if (cur_t() == "Semicolon") {
        advance_i();
        is_extern = true;
    } else {
        if (cur_t() == "LBrace") {
            body = parse_block();
        } else {
            eprint("parse error: expected '{' or ';' after function signature\n");
            exit(1);
        }
    }

    var id: i64 = mk_FuncDecl(name, is_extern, is_comptime, rt, all, ph, body, -1);
    return id;
}

parse_global_var :: func(is_const: bool) -> i64 {
    advance_i();
    var name: string = expect_tok("Identifier");
    var nti: i64 = pos - 1;
    var tn: i64 = -1;
    if (cur_t() == "Colon") {
        advance_i();
        tn = parse_type();
    }
    var init: i64 = -1;
    if (cur_t() == "Assign") {
        advance_i();
        init = parse_expr();
    }
    expect_tok("Semicolon");
    if (is_const) {
        validate_const_name(name, nti);
    } else {
        validate_var_name(name, nti);
    }

    if (is_const) {
        if (init < 0) {
            init = mk_null(-1);
        }
        var id: i64 = mk_GlobalConstDecl(name, false, tn, init, -1, nti);
        return id;
    }

    if (tn < 0) {
        tn = mk_scalar("void", -1);
    }
    var id2: i64 = mk_GlobalVarDecl(name, false, tn, init, -1, nti);
    return id2;
}

parse_import_decl :: func(anns: i64) -> i64 {
    advance_i();
    var path: string = expect_tok("String");
    var pti: i64 = pos - 1;
    var alias: string = "";
    var has_alias: bool = false;
    if (cur_t() == "KwAs") {
        advance_i();
        alias = expect_tok("Identifier");
        has_alias = true;
    }
    expect_tok("Semicolon");

    var id: i64 = mk_ImportDecl(path, alias, false, has_alias, anns, pti);
    return id;
}

// parse_type_alias 已由 GEN:parser 区间生成（见下方标记区）

parse_decl_body :: func(name: string, anns: i64, is_comptime: bool) -> i64 {
    var layout: string = "default";
    if (cur_t() == "Hash") {
        advance_i();
        var li: i64 = advance_i();
        if (tk_t(li) == "Identifier") {
            var lv: string = tk_v(li);
            if (lv == "soa") {
                layout = "soa";
            } else {
                if (lv == "aos") {
                    layout = "aos";
                }
            }
        }
    }

    // >>> GEN:parser_dispatch (generated by tools/totter.tc from build/ebnf.json dispatches -- DO NOT EDIT) >>>
    var t: string = cur_t();
    if (t == "KwStruct") {
        return parse_struct_decl(name, anns, layout);
    }
    if (t == "KwEnum") {
        return parse_enum_decl(name, anns);
    }
    if (t == "KwFlag") {
        return parse_flag_decl(name, anns);
    }
    if (t == "KwUnion") {
        return parse_union_decl(name, anns);
    }
    if (t == "KwVariant") {
        return parse_variant_decl(name, anns);
    }
    if (t == "KwFunc") {
        return parse_func_decl(name, anns, is_comptime);
    }
    if (t == "Identifier" && cur_v() == "flag_set") {
        return parse_flag_set_decl(name, anns);
    }
    return parse_type_alias(name, anns);
// <<< GEN:parser_dispatch <<<
}

parse_declaration :: func() -> i64 {
    var anns: i64 = parse_annotations();

    if (cur_t() == "KwVar") {
        return parse_global_var(false);
    }
    if (cur_t() == "KwConst") {
        return parse_global_var(true);
    }
    if (cur_t() == "KwImport") {
        return parse_import_decl(anns);
    }

    var is_comptime: bool = false;
    if (cur_t() == "KwComptime") {
        advance_i();
        is_comptime = true;
    }

    if (cur_t() != "Identifier") {
        eprint("parse error: expected declaration name but found ");
        eprint(cur_v());
        eprint("\n");
        exit(1);
    }
    var ni: i64 = advance_i();
    var name: string = tk_v(ni);
    validate_decl_name(name, ni);

    if (cur_t() != "DoubleColon") {
        eprint("parse error: expected '::' after declaration name\n");
        exit(1);
    }
    advance_i();

    var d: i64 = parse_decl_body(name, anns, is_comptime);
    if (d >= 0) {
        node_at(d, ni);
    }
    return d;
}

parse_unit :: func() -> void {
    while (cur_t() != "Eof") {
        if (cur_t() == "Semicolon") {
            advance_i();
            continue;
        }
        var d: i64 = parse_declaration();
        if (d >= 0) {
            append(decl_list, d);
        }
    }
}


// >>> GEN:parser_rules (generated by tools/totter.tc from build/ebnf.json grammar -- DO NOT EDIT) >>>
parse_switch_stmt :: func() -> i64 {
    var ti: i64 = advance_i();
    expect_tok("LParen");
    var e: i64 = parse_expr();
    expect_tok("RParen");
    expect_tok("LBrace");
    var cases_head: i64 = -1;
    var cases_tail: i64 = -1;
    var default_head: i64 = -2;
    while (cur_t() != "RBrace" && cur_t() != "Eof") {
        if (cur_t() == "KwCase") {
            advance_i();
            var pat: i64 = parse_expr();
            expect_tok("Colon");
            var bh: i64 = -1;
            var bt: i64 = -1;
            while (cur_t() != "KwCase" && cur_t() != "KwDefault" && cur_t() != "RBrace" && cur_t() != "Eof") {
                var s: i64 = parse_statement();
                if (s >= 0) {
                    bt = list_push(bh, bt, s);
                    if (bh < 0) {
                        bh = bt;
                    }
                }
            }
            var cid: i64 = mk_CS(pat, bh, -1);
            cases_tail = list_push(cases_head, cases_tail, cid);
            if (cases_head < 0) {
                cases_head = cases_tail;
            }
        } else {
        if (cur_t() == "KwDefault") {
            advance_i();
            expect_tok("Colon");
            var dh: i64 = -1;
            var dt: i64 = -1;
            while (cur_t() != "KwCase" && cur_t() != "RBrace" && cur_t() != "Eof") {
                var s2: i64 = parse_statement();
                if (s2 >= 0) {
                    dt = list_push(dh, dt, s2);
                    if (dh < 0) {
                        dh = dt;
                    }
                }
            }
            default_head = dh;
        } else {
            eprint("parse error: expected case or default in switch\n");
            exit(1);
        }}
    }
    expect_tok("RBrace");
    var id: i64 = mk_switch(e, cases_head, default_head, ti);
    return id;
}

parse_for_stmt :: func() -> i64 {
    var ti: i64 = advance_i();
    expect_tok("LParen");
    if (cur_t() == "Identifier" && peek_t(1) == "KwIn") {
        var vi: i64 = advance_i();
        var vname: string = tk_v(vi);
        advance_i();
        var iterable: i64 = parse_expr();
        expect_tok("RParen");
        var body: i64 = parse_block();
        var id: i64 = mk_for_each(vname, iterable, body, ti);
        return id;
    }
    var init: i64 = -1;
    if (cur_t() != "Semicolon") {
        if (cur_t() == "KwVar") {
            init = parse_local_var(false);
        } else {
        if (cur_t() == "KwConst") {
            init = parse_local_var(true);
        } else {
            var e: i64 = parse_expr();
            expect_tok("Semicolon");
            init = mk_expr(e, -1);
        }}
    } else {
        advance_i();
    }
    var cond: i64 = -1;
    if (cur_t() != "Semicolon") {
        cond = parse_expr();
    }
    expect_tok("Semicolon");
    var upd: i64 = -1;
    if (cur_t() != "RParen") {
        upd = parse_expr();
    }
    expect_tok("RParen");
    var body2: i64 = parse_block();
    var id2: i64 = mk_for(init, cond, upd, body2, ti);
    return id2;
}

parse_if_stmt :: func() -> i64 {
    var ti: i64 = advance_i();
    expect_tok("LParen");
    var cond: i64 = parse_expr();
    expect_tok("RParen");
    var then_head: i64 = parse_block();
    var else_head: i64 = -2;
    if (cur_t() == "KwElse") {
        advance_i();
        if (cur_t() == "KwIf") {
            var nested: i64 = parse_if_stmt();
            var h: i64 = -1;
            h = list_push(h, -1, nested);
            else_head = h;
        } else {
            else_head = parse_block();
        }
    }
    var id: i64 = mk_if(cond, then_head, else_head, ti);
    return id;
}

parse_return_stmt :: func() -> i64 {
    var ti: i64 = advance_i();
    var val: i64 = -1;
    if (cur_t() != "Semicolon") {
        val = parse_expr();
    }
    expect_tok("Semicolon");
    var id: i64 = mk_return(val, ti);
    return id;
}

parse_while_stmt :: func() -> i64 {
    var ti: i64 = advance_i();
    expect_tok("LParen");
    var cond: i64 = parse_expr();
    expect_tok("RParen");
    var body: i64 = parse_block();
    var id: i64 = mk_while(cond, body, ti);
    return id;
}

parse_statement :: func() -> i64 {
    var t: string = cur_t();
    if (t == "KwIf") {
        return parse_if_stmt();
    }
    if (t == "KwFor") {
        return parse_for_stmt();
    }
    if (t == "KwWhile") {
        return parse_while_stmt();
    }
    if (t == "KwSwitch") {
        return parse_switch_stmt();
    }
    if (t == "KwReturn") {
        return parse_return_stmt();
    }
    if (t == "KwBreak") {
        return parse_break_stmt();
    }
    if (t == "KwContinue") {
        return parse_continue_stmt();
    }
    if (t == "KwDefer") {
        return parse_defer_stmt();
    }
    if (t == "KwComptime") {
        return parse_comptime_stmt();
    }
    if (t == "LBrace") {
        return parse_block_stmt();
    }
    if (t == "KwVar") {
        return parse_var_stmt();
    }
    if (t == "KwConst") {
        return parse_const_stmt();
    }
    return parse_expr_or_assign_stmt();
}

parse_primary :: func() -> i64 {
    var t: string = cur_t();
    if (t == "Integer") {
        var ti_Integer: i64 = advance_i();
        return parse_prim_int(ti_Integer);
    }
    if (t == "Float") {
        var ti_Float: i64 = advance_i();
        return parse_prim_float(ti_Float);
    }
    if (t == "String") {
        var ti_String: i64 = advance_i();
        return parse_prim_str(ti_String);
    }
    if (t == "KwTrue") {
        var ti_KwTrue: i64 = advance_i();
        return parse_prim_true(ti_KwTrue);
    }
    if (t == "KwFalse") {
        var ti_KwFalse: i64 = advance_i();
        return parse_prim_false(ti_KwFalse);
    }
    if (t == "KwNull") {
        var ti_KwNull: i64 = advance_i();
        return parse_prim_null(ti_KwNull);
    }
    if (t == "Identifier") {
        var ti_Identifier: i64 = advance_i();
        return parse_prim_ident(ti_Identifier);
    }
    if (t == "LParen") {
        var ti_LParen: i64 = advance_i();
        return parse_prim_paren(ti_LParen);
    }
    if (t == "LBracket") {
        var ti_LBracket: i64 = advance_i();
        return parse_prim_array(ti_LBracket);
    }
    eprint("parse error: unexpected token in expression: ");
    eprint(cur_v());
    eprint("\n");
    exit(1);
    return -1;
}

parse_postfix :: func() -> i64 {
    var e: i64 = parse_primary();
    while (cur_t() == "Dot" || cur_t() == "LBracket" || cur_t() == "LParen") {
        var t: string = cur_t();
        var ti: i64 = advance_i();
        if (t == "Dot") { e = parse_post_member(e, ti); }
        if (t == "LBracket") { e = parse_post_index(e, ti); }
        if (t == "LParen") { e = parse_post_call(e, ti); }
    }
    if (cur_t() == "KwAs") {
        var ti2: i64 = advance_i();
        e = parse_post_cast(e, ti2);
    }
    return e;
}

parse_unary :: func() -> i64 {
    var t: string = cur_t();
    if (t == "Not" || t == "Minus" || t == "BitNot") {
        var op: string = "!";
        if (t == "Minus") { op = "-"; }
        if (t == "BitNot") { op = "~"; }
        var ti: i64 = advance_i();
        var operand: i64 = parse_unary();
        return mk_un(op, operand, ti);
    }
    return parse_postfix();
}

parse_mul :: func() -> i64 {
    var left: i64 = parse_unary();
    while (cur_t() == "Star" || cur_t() == "Slash" || cur_t() == "Percent") {
        var t: string = cur_t();
        var op: string = "*";
        if (t == "Slash") { op = "/"; }
        if (t == "Percent") { op = "%"; }
        var ti: i64 = advance_i();
        var right: i64 = parse_unary();
        left = mk_bin(op, left, right, ti);
    }
    return left;
}

parse_add :: func() -> i64 {
    var left: i64 = parse_mul();
    while (cur_t() == "Plus" || cur_t() == "Minus") {
        var t: string = cur_t();
        var op: string = "+";
        if (t == "Minus") { op = "-"; }
        var ti: i64 = advance_i();
        var right: i64 = parse_mul();
        left = mk_bin(op, left, right, ti);
    }
    return left;
}

parse_shift :: func() -> i64 {
    var left: i64 = parse_add();
    while (cur_t() == "ShiftLeft" || cur_t() == "ShiftRight") {
        var t: string = cur_t();
        var op: string = "<<";
        if (t == "ShiftRight") { op = ">>"; }
        var ti: i64 = advance_i();
        var right: i64 = parse_add();
        left = mk_bin(op, left, right, ti);
    }
    return left;
}

parse_cmp :: func() -> i64 {
    var left: i64 = parse_shift();
    while (cur_t() == "Lt" || cur_t() == "Gt" || cur_t() == "LtEq" || cur_t() == "GtEq") {
        var t: string = cur_t();
        var op: string = "<";
        if (t == "Gt") { op = ">"; }
        if (t == "LtEq") { op = "<="; }
        if (t == "GtEq") { op = ">="; }
        var ti: i64 = advance_i();
        var right: i64 = parse_shift();
        left = mk_bin(op, left, right, ti);
    }
    return left;
}

parse_eq :: func() -> i64 {
    var left: i64 = parse_cmp();
    while (cur_t() == "Eq" || cur_t() == "NotEq") {
        var t: string = cur_t();
        var op: string = "==";
        if (t == "NotEq") { op = "!="; }
        var ti: i64 = advance_i();
        var right: i64 = parse_cmp();
        left = mk_bin(op, left, right, ti);
    }
    return left;
}

parse_bitand :: func() -> i64 {
    var left: i64 = parse_eq();
    while (cur_t() == "BitAnd") {
        var t: string = cur_t();
        var op: string = "&";
        var ti: i64 = advance_i();
        var right: i64 = parse_eq();
        left = mk_bin(op, left, right, ti);
    }
    return left;
}

parse_bitxor :: func() -> i64 {
    var left: i64 = parse_bitand();
    while (cur_t() == "BitXor") {
        var t: string = cur_t();
        var op: string = "^";
        var ti: i64 = advance_i();
        var right: i64 = parse_bitand();
        left = mk_bin(op, left, right, ti);
    }
    return left;
}

parse_bitor :: func() -> i64 {
    var left: i64 = parse_bitxor();
    while (cur_t() == "BitOr") {
        var t: string = cur_t();
        var op: string = "|";
        var ti: i64 = advance_i();
        var right: i64 = parse_bitxor();
        left = mk_bin(op, left, right, ti);
    }
    return left;
}

parse_and :: func() -> i64 {
    var left: i64 = parse_bitor();
    while (cur_t() == "And") {
        var t: string = cur_t();
        var op: string = "&&";
        var ti: i64 = advance_i();
        var right: i64 = parse_bitor();
        left = mk_bin(op, left, right, ti);
    }
    return left;
}

parse_or :: func() -> i64 {
    var left: i64 = parse_and();
    while (cur_t() == "Or") {
        var t: string = cur_t();
        var op: string = "||";
        var ti: i64 = advance_i();
        var right: i64 = parse_and();
        left = mk_bin(op, left, right, ti);
    }
    return left;
}

parse_sfield :: func() -> i64 {
    var r_Ident: string = expect_tok("Identifier");
    expect_tok("Colon");
    var r_Integer: string = "";
    var r_type: i64 = -1;
    if (cur_t() == "Integer") {
    r_Integer = expect_tok("Integer");
    }    else if (true) {
    r_type = parse_type();
    } else {
        eprint("parse error: unexpected token in alternative\n"); exit(1);
    }
    var r_anns: i64 = parse_annotations();
    expect_tok("Semicolon");
    var __id: i64 = node_new("F");
    var __n: Node = nodes[__id];
    __n.sa = r_Ident;
    __n.na = sfield_na(r_Integer, r_type);
    __n.ia = sfield_ia(r_Integer);
    __n.la = r_anns;
    slice_set(nodes, __id, __n);
    return __id;
}

parse_struct_decl :: func(name: string, anns: i64, layout: string) -> i64 {
    advance_i();
    var r_anns: i64 = parse_annotations();
    expect_tok("LBrace");
    var r_sfield: i64 = -1;
    var r_sfield_t: i64 = -1;
    while (cur_t() == "Identifier" && cur_t() != "Eof") {
        var __it: i64 = parse_sfield();
        r_sfield_t = list_push(r_sfield, r_sfield_t, __it);
        if (r_sfield < 0) { r_sfield = r_sfield_t; }
    }
    expect_tok("RBrace");
    var __id: i64 = mk_StructDecl(name, layout, bp_type2(anns, r_anns), bp_has_type2(anns, r_anns), bp_is2(anns, r_anns), list_concat(anns, r_anns), r_sfield, -1);
    return __id;
}

parse_umember :: func() -> i64 {
    var r_Ident: string = expect_tok("Identifier");
    expect_tok("Colon");
    var r_type: i64 = parse_type();
    var r_anns: i64 = parse_annotations();
    if (cur_t() == "Comma" || cur_t() == "Semicolon") {
    if (cur_t() == "Comma") {
    expect_tok("Comma");
    }    else if (cur_t() == "Semicolon") {
    expect_tok("Semicolon");
    } else {
        eprint("parse error: unexpected token in alternative\n"); exit(1);
    }
    }
    var __id: i64 = mk_M(r_Ident, r_type, r_anns, -1);
    return __id;
}

parse_union_decl :: func(name: string, anns: i64) -> i64 {
    advance_i();
    var r_anns: i64 = parse_annotations();
    expect_tok("LBrace");
    var r_umember: i64 = -1;
    var r_umember_t: i64 = -1;
    while (cur_t() == "Identifier" && cur_t() != "Eof") {
        var __it: i64 = parse_umember();
        r_umember_t = list_push(r_umember, r_umember_t, __it);
        if (r_umember < 0) { r_umember = r_umember_t; }
    }
    expect_tok("RBrace");
    var __id: i64 = mk_UnionDecl(name, list_concat(anns, r_anns), r_umember, -1);
    return __id;
}

parse_setmember :: func() -> i64 {
    var r_Ident: string = expect_tok("Identifier");
    expect_tok("Colon");
    var r_Integer: string = expect_tok("Integer");
    var r_anns: i64 = parse_annotations();
    if (cur_t() == "Comma" || cur_t() == "Semicolon") {
    if (cur_t() == "Comma") {
    expect_tok("Comma");
    }    else if (cur_t() == "Semicolon") {
    expect_tok("Semicolon");
    } else {
        eprint("parse error: unexpected token in alternative\n"); exit(1);
    }
    }
    var __id: i64 = mk_SL(r_Ident, parse_int_str(r_Integer), -1, false, r_anns, -1);
    return __id;
}

parse_flag_set_decl :: func(name: string, anns: i64) -> i64 {
    advance_i();
    var r_anns: i64 = parse_annotations();
    expect_tok("LBrace");
    var r_setmember: i64 = -1;
    var r_setmember_t: i64 = -1;
    while (cur_t() == "Identifier" && cur_t() != "Eof") {
        var __it: i64 = parse_setmember();
        r_setmember_t = list_push(r_setmember, r_setmember_t, __it);
        if (r_setmember < 0) { r_setmember = r_setmember_t; }
    }
    expect_tok("RBrace");
    var __id: i64 = mk_FlagSetDecl(name, list_concat(anns, r_anns), r_setmember, -1);
    return __id;
}

parse_slot :: func() -> i64 {
    var r_Ident: string = expect_tok("Identifier");
    expect_tok("Colon");
    var r_Integer: string = expect_tok("Integer");
    var r_anns: i64 = parse_annotations();
    if (cur_t() == "Comma" || cur_t() == "Semicolon") {
    if (cur_t() == "Comma") {
    expect_tok("Comma");
    }    else if (cur_t() == "Semicolon") {
    expect_tok("Semicolon");
    } else {
        eprint("parse error: unexpected token in alternative\n"); exit(1);
    }
    }
    var __id: i64 = mk_SL(r_Ident, parse_int_str(r_Integer), flag_offset_of(r_anns), flag_has_offset(r_anns), r_anns, -1);
    return __id;
}

parse_flag_decl :: func(name: string, anns: i64) -> i64 {
    advance_i();
    var r_Ident: string = "";
    if (cur_t() == "LBracket") {
    expect_tok("LBracket");
    r_Ident = expect_tok("Identifier");
    expect_tok("RBracket");
    }
    var r_anns: i64 = parse_annotations();
    expect_tok("LBrace");
    var r_slot: i64 = -1;
    var r_slot_t: i64 = -1;
    while (cur_t() == "Identifier" && cur_t() != "Eof") {
        var __it: i64 = parse_slot();
        r_slot_t = list_push(r_slot, r_slot_t, __it);
        if (r_slot < 0) { r_slot = r_slot_t; }
    }
    expect_tok("RBrace");
    var __id: i64 = mk_FlagDecl(name, str_or(r_Ident, "u32"), list_concat(anns, r_anns), r_slot, -1);
    return __id;
}

parse_case :: func(ci: i64) -> i64 {
    var r_Ident: string = expect_tok("Identifier");
    var r_type: i64 = -1;
    if (cur_t() == "LParen") {
    expect_tok("LParen");
    r_type = parse_type();
    expect_tok("RParen");
    }
    var r_anns: i64 = parse_annotations();
    if (cur_t() == "Comma" || cur_t() == "Semicolon") {
    if (cur_t() == "Comma") {
    expect_tok("Comma");
    }    else if (cur_t() == "Semicolon") {
    expect_tok("Semicolon");
    } else {
        eprint("parse error: unexpected token in alternative\n"); exit(1);
    }
    }
    var __id: i64 = mk_VC(r_Ident, ci, r_type, r_anns, -1);
    return __id;
}

parse_variant_decl :: func(name: string, anns: i64) -> i64 {
    advance_i();
    var r_anns: i64 = parse_annotations();
    expect_tok("LBrace");
    var r_case: i64 = -1;
    var r_case_t: i64 = -1;
    var ci: i64 = 0;
    while (cur_t() == "Identifier" && cur_t() != "Eof") {
        var __it: i64 = parse_case(ci);
        r_case_t = list_push(r_case, r_case_t, __it);
        if (r_case < 0) { r_case = r_case_t; }
        ci = ci + 1;
    }
    expect_tok("RBrace");
    var __id: i64 = mk_VariantDecl(name, list_concat(anns, r_anns), r_case, -1);
    return __id;
}

parse_type_alias :: func(name: string, anns: i64) -> i64 {
    var r_type: i64 = parse_type();
    expect_tok("Semicolon");
    var __id: i64 = mk_TypeAliasDecl(name, r_type, anns, -1);
    return __id;
}

// <<< GEN:parser_rules <<<

// ═══════════════════════════════════════════════════════════════
// M7-2: 类型检查器（移植 tc0/types/checker.ts + types.ts）
// ═══════════════════════════════════════════════════════════════

// ── TypeInfo 扁平池（复刻 types.ts TypeInfo）──────────────────
// kind: Scalar/Void/String/StringBuilder/Array/Slice/Map/Pointer/
//       Optional/Struct/Enum/Flag/FlagSet/Union/Variant/Func/Named/Unknown

TI :: struct {
    kind: string;
    name: string;   // Scalar/Struct/Enum/Flag/FlagSet/Union/Func/Named
    und: string;    // Enum/Flag underlying
    bw: i64;        // Scalar bitWidth
    elem: i64;      // Array/Slice/Pointer/Optional 子类型（TI 索引）
    key: i64;       // Map key
    val: i64;       // Map value
    alen: i64;      // Array length
}

var tis: []TI;

ti_mk :: func(kind: string) -> i64 {
    var t: TI;
    t.kind = kind;
    t.name = "";
    t.und = "";
    t.bw = 0;
    t.elem = -1;
    t.key = -1;
    t.val = -1;
    t.alen = 0;
    append(tis, t);
    return (slice_len(tis) as i64) - 1;
}

ti_named :: func(kind: string, name: string) -> i64 {
    var i: i64 = ti_mk(kind);
    var t: TI = tis[i];
    t.name = name;
    slice_set(tis, i, t);
    return i;
}

ti_with_und :: func(kind: string, name: string, und: string) -> i64 {
    var i: i64 = ti_named(kind, name);
    var t: TI = tis[i];
    t.und = und;
    slice_set(tis, i, t);
    return i;
}

ti_elem_of :: func(kind: string, elem: i64) -> i64 {
    var i: i64 = ti_mk(kind);
    var t: TI = tis[i];
    t.elem = elem;
    slice_set(tis, i, t);
    return i;
}

// ── 标量类型工具（复刻 types.ts）───────────────────────────────

is_int_name :: func(name: string) -> bool {
    if (name == "u8" || name == "u16" || name == "u32" || name == "u64") {
        return true;
    }
    return name == "i8" || name == "i16" || name == "i32" || name == "i64";
}

is_float_name :: func(name: string) -> bool {
    return name == "f16" || name == "f32" || name == "f64";
}

get_bw :: func(name: string) -> i64 {
    if (name == "u8" || name == "i8") {
        return 8;
    }
    if (name == "u16" || name == "i16" || name == "f16") {
        return 16;
    }
    if (name == "u32" || name == "i32" || name == "f32") {
        return 32;
    }
    if (name == "u64" || name == "i64" || name == "f64") {
        return 64;
    }
    if (name == "bool") {
        return 1;
    }
    return -1;
}

ti_scalar :: func(name: string) -> i64 {
    var i: i64 = ti_named("Scalar", name);
    var t: TI = tis[i];
    t.bw = get_bw(name);
    slice_set(tis, i, t);
    return i;
}

ti_kind :: func(i: i64) -> string {
    if (i < 0) {
        return "Unknown";
    }
    var t: TI = tis[i];
    return t.kind;
}

ti_name :: func(i: i64) -> string {
    var t: TI = tis[i];
    return t.name;
}

is_int_ti :: func(i: i64) -> bool {
    var t: TI = tis[i];
    if (t.kind != "Scalar") {
        return false;
    }
    return is_int_name(t.name);
}

is_float_ti :: func(i: i64) -> bool {
    var t: TI = tis[i];
    if (t.kind != "Scalar") {
        return false;
    }
    return is_float_name(t.name);
}

// typesEqual（递归）
ti_equal :: func(ai: i64, bi: i64) -> bool {
    var a: TI = tis[ai];
    var b: TI = tis[bi];
    if (a.kind != b.kind) {
        return false;
    }
    if (a.kind == "Scalar") {
        return a.name == b.name;
    }
    if (a.kind == "Void" || a.kind == "String" || a.kind == "StringBuilder") {
        return true;
    }
    if (a.kind == "Variant" || a.kind == "Unknown") {
        return true;
    }
    if (a.kind == "Array") {
        if (a.alen != b.alen) {
            return false;
        }
        return ti_equal(a.elem, b.elem);
    }
    if (a.kind == "Slice" || a.kind == "Pointer" || a.kind == "Optional") {
        return ti_equal(a.elem, b.elem);
    }
    if (a.kind == "Map") {
        if (ti_equal(a.key, b.key) == false) {
            return false;
        }
        return ti_equal(a.val, b.val);
    }
    return a.name == b.name;
}

// canExplicitCast
can_cast :: func(fi: i64, ti2: i64) -> bool {
    if (ti_equal(fi, ti2)) {
        return true;
    }
    if (is_int_ti(fi) && is_int_ti(ti2)) {
        return true;
    }
    if (is_float_ti(fi) && is_float_ti(ti2)) {
        return true;
    }
    if (is_int_ti(fi) && is_float_ti(ti2)) {
        return true;
    }
    if (is_float_ti(fi) && is_int_ti(ti2)) {
        return true;
    }
    var f: TI = tis[fi];
    var t: TI = tis[ti2];
    if (f.kind == "Scalar" && f.name == "bool" && is_int_ti(ti2)) {
        return true;
    }
    if (is_int_ti(fi) && t.kind == "Scalar" && t.name == "bool") {
        return true;
    }
    return false;
}

// typeToString（递归）
ti_str :: func(i: i64) -> string {
    var t: TI = tis[i];
    if (t.kind == "Scalar") {
        return t.name;
    }
    if (t.kind == "Void") {
        return "void";
    }
    if (t.kind == "String") {
        return "string";
    }
    if (t.kind == "StringBuilder") {
        return "StringBuilder";
    }
    if (t.kind == "Array") {
        return cat4("[", i2s(t.alen), "]", ti_str(t.elem));
    }
    if (t.kind == "Slice") {
        return cat2("[]", ti_str(t.elem));
    }
    if (t.kind == "Map") {
        return cat4("map[", ti_str(t.key), "]", ti_str(t.val));
    }
    if (t.kind == "Pointer") {
        return cat2("*", ti_str(t.elem));
    }
    if (t.kind == "Optional") {
        return cat2("?", ti_str(t.elem));
    }
    if (t.kind == "Variant") {
        return "Variant";
    }
    if (t.kind == "Unknown") {
        return "<unknown>";
    }
    return t.name;
}

// ── 符号表（扁平池 + scope 链）─────────────────────────────────

Sym :: struct {
    name: string;
    kind: string;   // type/var/func/const
    ti: i64;        // TI 索引
    decl: i64;      // Node 索引（decl），-1 = 无
    scope: i64;
}

var syms: []Sym;
var scope_parents: []i64;

scope_new :: func(parent: i64) -> i64 {
    append(scope_parents, parent);
    return (slice_len(scope_parents) as i64) - 1;
}

// 仅在指定 scope 内查找（不上溯）
sym_find_in :: func(scope: i64, name: string) -> i64 {
    var n: i64 = slice_len(syms) as i64;
    var i: i64 = 0;
    while (i < n) {
        var s: Sym = syms[i];
        if (s.scope == scope && s.name == name) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// Map.set 语义：已存在则忽略（首定义保留）
sym_define :: func(scope: i64, name: string, kind: string, ti2: i64, decl: i64) -> void {
    if (sym_find_in(scope, name) >= 0) {
        return;
    }
    var s: Sym;
    s.name = name;
    s.kind = kind;
    s.ti = ti2;
    s.decl = decl;
    s.scope = scope;
    append(syms, s);
}

// 沿 scope 链上溯查找
sym_lookup :: func(scope: i64, name: string) -> i64 {
    var sc: i64 = scope;
    while (sc >= 0) {
        var f: i64 = sym_find_in(sc, name);
        if (f >= 0) {
            return f;
        }
        sc = scope_parents[sc];
    }
    return -1;
}

var global_scope: i64;
var cur_scope: i64;
var cur_ret: i64;   // 当前函数返回类型（TI 索引）

// ── 诊断定位助手（复刻 tok?.file ?? "" 等）────────────────────

n_file :: func(ni: i64) -> string {
    if (ni < 0) {
        return "";
    }
    var n: Node = nodes[ni];
    if (n.ln == 0) {
        return "";
    }
    return g_file;
}

n_line :: func(ni: i64) -> i64 {
    if (ni < 0) {
        return 1;
    }
    var n: Node = nodes[ni];
    if (n.ln == 0) {
        return 1;
    }
    return n.ln as i64;
}

n_col :: func(ni: i64) -> i64 {
    if (ni < 0) {
        return 1;
    }
    var n: Node = nodes[ni];
    if (n.ln == 0) {
        return 1;
    }
    return n.cl as i64;
}

// errorTypeMismatch（复刻 checker.ts:678）
err_type_mismatch :: func(eni: i64, exp: i64, act: i64) -> void {
    var es: string = ti_str(exp);
    var fs2: string = ti_str(act);
    var l: i64 = n_line(eni);
    var c: i64 = n_col(eni);
    var di: i64 = diag_new("T_TYPE_MISMATCH", "error",
        cat4("type mismatch: expected ", es, " but got ", fs2),
        n_file(eni), l, c, l, c + 5);
    slb_begin();
    slb_add(cat2("expected: ", es));
    slb_add(cat2("found:    ", fs2));
    diag_set_nt(di, slb_head);
}

// ── 整数字面量解析（复刻 BigInt(value) 与 parseInt(value,radix)）──

// BigInt 语义：识别 0x/0X/0b/0B 前缀
lit_u64 :: func(v: string) -> u64 {
    var n: u64 = str_len(v);
    var r: u64 = 0;
    if (n >= 2 && v[0] == 48 && (v[1] == 120 || v[1] == 88)) {
        var i: u64 = 2;
        while (i < n) {
            var c: u8 = v[i];
            var d: u64 = 0;
            if (c >= 48 && c <= 57) {
                d = (c - 48) as u64;
            } else {
                if (c >= 97 && c <= 102) {
                    d = (c - 87) as u64;
                } else {
                    d = (c - 55) as u64;
                }
            }
            r = r * 16 + d;
            i = i + 1;
        }
        return r;
    }
    if (n >= 2 && v[0] == 48 && (v[1] == 98 || v[1] == 66)) {
        var j: u64 = 2;
        while (j < n) {
            r = r * 2 + ((v[j] - 48) as u64);
            j = j + 1;
        }
        return r;
    }
    var k: u64 = 0;
    while (k < n) {
        r = r * 10 + ((v[k] - 48) as u64);
        k = k + 1;
    }
    return r;
}

// parseInt(value, radix) 语义：radix=16 接受 0x 前缀；其余按位解析，
// 遇非法字符停止
parse_int_len :: func(v: string, radix: i64) -> i64 {
    var n: u64 = str_len(v);
    var r: i64 = 0;
    if (radix == 16) {
        var i: u64 = 0;
        if (n >= 2 && v[0] == 48 && (v[1] == 120 || v[1] == 88)) {
            i = 2;
        }
        while (i < n) {
            var c: u8 = v[i];
            var d: i64 = -1;
            if (c >= 48 && c <= 57) {
                d = (c - 48) as i64;
            }
            if (c >= 97 && c <= 102) {
                d = (c - 87) as i64;
            }
            if (c >= 65 && c <= 70) {
                d = (c - 55) as i64;
            }
            if (d < 0) {
                return r;
            }
            r = r * 16 + d;
            i = i + 1;
        }
        return r;
    }
    if (radix == 2) {
        var j: u64 = 0;
        while (j < n) {
            var c2: u8 = v[j];
            if (c2 != 48 && c2 != 49) {
                return r;
            }
            r = r * 2 + ((c2 - 48) as i64);
            j = j + 1;
        }
        return r;
    }
    var k: u64 = 0;
    while (k < n) {
        var c3: u8 = v[k];
        if (c3 < 48 || c3 > 57) {
            return r;
        }
        r = r * 10 + ((c3 - 48) as i64);
        k = k + 1;
    }
    return r;
}

// ── 类型解析 resolveType（复刻 checker.ts:134）────────────────

resolve_ti :: func(tn: i64) -> i64 {
    if (tn < 0) {
        return ti_mk("Unknown");
    }
    var n: Node = nodes[tn];
    if (n.kind == "scalar") {
        if (is_scalar_name(n.sa)) {
            return ti_scalar(n.sa);
        }
        if (n.sa == "void") {
            return ti_mk("Void");
        }
        if (n.sa == "string") {
            return ti_mk("String");
        }
        if (n.sa == "StringBuilder") {
            return ti_mk("StringBuilder");
        }
        return ti_named("Named", n.sa);
    }
    if (n.kind == "array") {
        var elem: i64 = resolve_ti(n.na);
        var length: i64 = 0;
        if (n.nb >= 0) {
            var le: Node = nodes[n.nb];
            if (le.kind == "int") {
                length = parse_int_len(le.sa, le.ia);
            }
        }
        var ai: i64 = ti_elem_of("Array", elem);
        var at: TI = tis[ai];
        at.alen = length;
        slice_set(tis, ai, at);
        return ai;
    }
    if (n.kind == "slice") {
        return ti_elem_of("Slice", resolve_ti(n.na));
    }
    if (n.kind == "map") {
        var kt: i64 = resolve_ti(n.na);
        var vt: i64 = resolve_ti(n.nb);
        var mi: i64 = ti_mk("Map");
        var mt: TI = tis[mi];
        mt.key = kt;
        mt.val = vt;
        slice_set(tis, mi, mt);
        return mi;
    }
    if (n.kind == "named") {
        var si: i64 = sym_lookup(global_scope, n.sa);
        if (si >= 0) {
            var s: Sym = syms[si];
            return s.ti;
        }
        return ti_named("Named", n.sa);
    }
    if (n.kind == "variant") {
        return ti_mk("Variant");
    }
    if (n.kind == "flag") {
        return ti_with_und("Flag", "<anonymous>", n.sa);
    }
    if (n.kind == "flag_set") {
        return ti_named("FlagSet", "<anonymous>");
    }
    if (n.kind == "pointer") {
        return ti_elem_of("Pointer", resolve_ti(n.na));
    }
    if (n.kind == "optional") {
        return ti_elem_of("Optional", resolve_ti(n.na));
    }
    return ti_mk("Unknown");
}

// ── 声明注册 registerDecl（复刻 checker.ts:97）────────────────

register_decl :: func(d: i64) -> void {
    var n: Node = nodes[d];
    if (n.kind == "StructDecl") {
        sym_define(global_scope, n.sa, "type", ti_named("Struct", n.sa), d);
        return;
    }
    if (n.kind == "EnumDecl") {
        sym_define(global_scope, n.sa, "type", ti_with_und("Enum", n.sa, n.sb), d);
        return;
    }
    if (n.kind == "FlagDecl") {
        sym_define(global_scope, n.sa, "type", ti_with_und("Flag", n.sa, n.sb), d);
        return;
    }
    if (n.kind == "FlagSetDecl") {
        sym_define(global_scope, n.sa, "type", ti_named("FlagSet", n.sa), d);
        return;
    }
    if (n.kind == "UnionDecl") {
        sym_define(global_scope, n.sa, "type", ti_named("Union", n.sa), d);
        return;
    }
    if (n.kind == "VariantDecl") {
        sym_define(global_scope, n.sa, "type", ti_named("Variant", n.sa), d);
        register_variant_helpers(d);
        return;
    }
    if (n.kind == "FuncDecl") {
        sym_define(global_scope, n.sa, "func", ti_named("Func", n.sa), d);
        return;
    }
    if (n.kind == "GlobalVarDecl") {
        sym_define(global_scope, n.sa, "var", resolve_ti(n.na), d);
        return;
    }
    if (n.kind == "GlobalConstDecl") {
        var cti: i64 = -1;
        if (n.na >= 0) {
            cti = resolve_ti(n.na);
        } else {
            cti = ti_mk("Unknown");
        }
        sym_define(global_scope, n.sa, "const", cti, d);
        return;
    }
    if (n.kind == "TypeAliasDecl") {
        sym_define(global_scope, n.sa, "type", resolve_ti(n.na), d);
        return;
    }
}

// 为 Variant 的每个 case 注册合成函数符号（构造器/判别器/取载荷），
// 指向合成 FuncDecl 节点但不在 decl_list 中，故仅作类型检查可见、不被 emitter 重复发射。
register_variant_helpers :: func(d: i64) -> void {
    var n: Node = nodes[d];
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var vc: Node = nodes[k.val];
        var cname: string = vc.sa;
        // 构造器 Name_from_Case(载荷?) -> Name
        var ffrom: string = cat3(n.sa, "_from_", cname);
        var retNode: i64 = mk_named(n.sa, -1);
        var plist: i64 = -1;
        var ptail: i64 = -1;
        if (vc.na >= 0) {
            var pid: i64 = mk_P("v", vc.na, -1, -1);
            ptail = list_push(plist, ptail, pid);
            if (plist < 0) {
                plist = ptail;
            }
        }
        var fdecl1: i64 = mk_FuncDecl(ffrom, true, false, retNode, -1, plist, -2, -1);
        sym_define(global_scope, ffrom, "func", ti_named("Func", ffrom), fdecl1);

        // 判别器 Name_is_Case(self: Name) -> bool
        var fis: string = cat3(n.sa, "_is_", cname);
        var retBool: i64 = mk_scalar("bool", -1);
        var pid2: i64 = node_new("P");
        var pn2: Node = nodes[pid2];
        pn2.sa = "self";
        var selfTn: i64 = mk_named(n.sa, -1);
        pn2.na = selfTn;
        slice_set(nodes, pid2, pn2);
        var plist2: i64 = -1;
        var ptail2: i64 = -1;
        ptail2 = list_push(plist2, ptail2, pid2);
        if (plist2 < 0) {
            plist2 = ptail2;
        }
        var fdecl2: i64 = mk_FuncDecl(fis, true, false, retBool, -1, plist2, -2, -1);
        sym_define(global_scope, fis, "func", ti_named("Func", fis), fdecl2);

        // 取载荷 Name_as_Case(self: Name) -> 载荷（仅当携带载荷）
        if (vc.na >= 0) {
            var fas: string = cat3(n.sa, "_as_", cname);
            var fdecl3: i64 = mk_FuncDecl(fas, true, false, vc.na, -1, plist2, -2, -1);
            sym_define(global_scope, fas, "func", ti_named("Func", fas), fdecl3);
        }
        c = k.next;
    }
}

// ── 列表助手 ───────────────────────────────────────────────────

list_last_val :: func(head: i64) -> i64 {
    var c: i64 = head;
    var last: i64 = -1;
    while (c >= 0) {
        var k: Child = kids[c];
        last = k.val;
        c = k.next;
    }
    return last;
}

list_count :: func(head: i64) -> i64 {
    var c: i64 = head;
    var n: i64 = 0;
    while (c >= 0) {
        var k: Child = kids[c];
        n = n + 1;
        c = k.next;
    }
    return n;
}

// ── 内置函数返回类型（复刻 checker.ts:616）────────────────────

// >>> GEN:builtins (generated by tools/totter.tc from build/ebnf.json -- DO NOT EDIT) >>>
builtin_ret :: func(name: string) -> i64 {
    if (name == "assert_eq" || name == "assert_true" || name == "assert_false") {
        return ti_mk("Void");
    }
    if (name == "assert_panic" || name == "flag_set" || name == "print") {
        return ti_mk("Void");
    }
    if (name == "println" || name == "append" || name == "slice_set") {
        return ti_mk("Void");
    }
    if (name == "exit" || name == "eprint" || name == "sb_append_str") {
        return ti_mk("Void");
    }
    if (name == "sb_append_char" || name == "sb_append_u64" || name == "sb_append_i64") {
        return ti_mk("Void");
    }
    if (name == "sb_clear") {
        return ti_mk("Void");
    }
    if (name == "flag_get") {
        return ti_scalar("u32");
    }
    if (name == "sys_run") {
        return ti_scalar("i32");
    }
    if (name == "str_len" || name == "slice_len") {
        return ti_scalar("u64");
    }
    if (name == "str_at") {
        return ti_scalar("u8");
    }
    if (name == "file_read_all" || name == "path_resolve" || name == "str_slice") {
        return ti_mk("String");
    }
    if (name == "sb_to_str" || name == "to_string") {
        return ti_mk("String");
    }
    if (name == "file_write_all") {
        return ti_scalar("bool");
    }
    if (name == "args") {
        return ti_elem_of("Slice", ti_mk("String"));
    }
    if (name == "sb_new") {
        return ti_mk("StringBuilder");
    }
    return ti_mk("Unknown");
}
// <<< GEN:builtins <<<

// ── 表达式类型推断 inferExprType（复刻 checker.ts:479）────────

infer_expr :: func(e: i64) -> i64 {
    var n: Node = nodes[e];
    if (n.kind == "int") {
        var v: u64 = lit_u64(n.sa);
        if (v <= 255) {
            return ti_scalar("u8");
        }
        if (v <= 65535) {
            return ti_scalar("u16");
        }
        if (v <= 4294967295) {
            return ti_scalar("u32");
        }
        return ti_scalar("u64");
    }
    if (n.kind == "float") {
        return ti_scalar("f64");
    }
    if (n.kind == "string") {
        return ti_mk("String");
    }
    if (n.kind == "bool") {
        return ti_scalar("bool");
    }
    if (n.kind == "null") {
        return ti_mk("Unknown");
    }
    if (n.kind == "ident") {
        var si: i64 = sym_lookup(cur_scope, n.sa);
        if (si >= 0) {
            var s: Sym = syms[si];
            return s.ti;
        }
        if (n.sa == "true" || n.sa == "false") {
            return ti_scalar("bool");
        }
        return ti_mk("Unknown");
    }
    if (n.kind == "binary") {
        var lt: i64 = infer_expr(n.na);
        var rt: i64 = infer_expr(n.nb);
        var op: string = n.sa;
        if (op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=") {
            return ti_scalar("bool");
        }
        if (op == "&&" || op == "||") {
            return ti_scalar("bool");
        }
        if (ti_kind(lt) == "Scalar" && ti_kind(rt) == "Scalar") {
            if (ti_equal(lt, rt)) {
                return lt;
            }
            var ln2: Node = nodes[n.na];
            var rn2: Node = nodes[n.nb];
            var llit: bool = ln2.kind == "int";
            var rlit: bool = rn2.kind == "int";
            if (llit && rlit == false) {
                return rt;
            }
            if (rlit && llit == false) {
                return lt;
            }
            if (llit && rlit) {
                return lt;
            }
            var di: i64 = diag_new("T_TYPE_IMPLICIT_CAST", "error",
                cat6("binary operator '", op, "' requires same types, got ", ti_str(lt), " and ", ti_str(rt)),
                "", 1, 1, 1, 5);
            slb_begin();
            slb_add("use explicit cast: `expr as Type`");
            diag_set_nt(di, slb_head);
        }
        if (ti_kind(lt) != "Unknown") {
            return lt;
        }
        return rt;
    }
    if (n.kind == "unary") {
        var ot: i64 = infer_expr(n.na);
        if (n.sa == "!") {
            return ti_scalar("bool");
        }
        return ot;
    }
    if (n.kind == "assign") {
        infer_expr(n.nb);
        return infer_expr(n.na);
    }
    if (n.kind == "call") {
        var cn: Node = nodes[n.na];
        if (cn.kind == "ident") {
            var fname: string = cn.sa;
            var si2: i64 = sym_lookup(global_scope, fname);
            if (si2 >= 0) {
                var s2: Sym = syms[si2];
                if (ti_kind(s2.ti) == "Func" && s2.decl >= 0) {
                    var fd: Node = nodes[s2.decl];
                    if (fd.kind == "FuncDecl") {
                        return resolve_ti(fd.na);
                    }
                }
            }
            return builtin_ret(fname);
        }
        return ti_mk("Unknown");
    }
    if (n.kind == "member") {
        var obt: i64 = infer_expr(n.na);
        var obk: string = ti_kind(obt);
        if (obk == "Struct" || obk == "Named") {
            var si3: i64 = sym_lookup(global_scope, ti_name(obt));
            if (si3 >= 0) {
                var s3: Sym = syms[si3];
                if (s3.decl >= 0) {
                    var sd: Node = nodes[s3.decl];
                    if (sd.kind == "StructDecl") {
                        var c: i64 = sd.lb;
                        while (c >= 0) {
                            var k: Child = kids[c];
                            var f: Node = nodes[k.val];
                            if (f.sa == n.sa) {
                                return resolve_ti(f.na);
                            }
                            c = k.next;
                        }
                    }
                }
            }
        }
        if (obk == "Enum") {
            return obt;
        }
        return ti_mk("Unknown");
    }
    if (n.kind == "index") {
        var obt2: i64 = infer_expr(n.na);
        var obk2: string = ti_kind(obt2);
        if (obk2 == "Array" || obk2 == "Slice") {
            var t2: TI = tis[obt2];
            return t2.elem;
        }
        if (obk2 == "String") {
            return ti_scalar("u8");
        }
        if (obk2 == "Map") {
            var t3: TI = tis[obt2];
            return t3.val;
        }
        return ti_mk("Unknown");
    }
    if (n.kind == "array_lit") {
        var cnt: i64 = list_count(n.la);
        if (cnt > 0) {
            var k2: Child = kids[n.la];
            var et: i64 = infer_expr(k2.val);
            var ai: i64 = ti_elem_of("Array", et);
            var at: TI = tis[ai];
            at.alen = cnt;
            slice_set(tis, ai, at);
            return ai;
        }
        return ti_elem_of("Array", ti_mk("Unknown"));
    }
    if (n.kind == "map_lit") {
        if (n.la >= 0) {
            var k3: Child = kids[n.la];
            var en: Node = nodes[k3.val];
            var kt: i64 = infer_expr(en.na);
            var vt: i64 = infer_expr(en.nb);
            var mi: i64 = ti_mk("Map");
            var mt: TI = tis[mi];
            mt.key = kt;
            mt.val = vt;
            slice_set(tis, mi, mt);
            return mi;
        }
        var mi2: i64 = ti_mk("Map");
        var ku: i64 = ti_mk("Unknown");
        var vu: i64 = ti_mk("Unknown");
        var mt2: TI = tis[mi2];
        mt2.key = ku;
        mt2.val = vu;
        slice_set(tis, mi2, mt2);
        return mi2;
    }
    if (n.kind == "struct_lit") {
        return ti_named("Struct", n.sa);
    }
    if (n.kind == "cast") {
        return resolve_ti(n.nb);
    }
    if (n.kind == "paren") {
        return infer_expr(n.na);
    }
    if (n.kind == "comptime") {
        return infer_expr(n.na);
    }
    return ti_mk("Unknown");
}

// ── 返回路径分析（复刻 checker.ts:653）────────────────────────

all_paths_return :: func(head: i64) -> bool {
    if (head < 0) {
        return false;
    }
    var last: i64 = list_last_val(head);
    if (last < 0) {
        return false;
    }
    return stmt_returns(last);
}

stmt_returns :: func(s: i64) -> bool {
    var n: Node = nodes[s];
    if (n.kind == "return") {
        return true;
    }
    if (n.kind == "if") {
        if (n.lb != -2) {
            if (all_paths_return(n.la)) {
                return all_paths_return(n.lb);
            }
            return false;
        }
        return false;
    }
    if (n.kind == "block") {
        return all_paths_return(n.la);
    }
    return false;
}

// ── 语句检查 checkStmt（复刻 checker.ts:345）──────────────────

check_stmt :: func(s: i64) -> void {
    var n: Node = nodes[s];
    if (n.kind == "var_decl") {
        var vt: i64 = -1;
        if (n.na >= 0) {
            vt = resolve_ti(n.na);
        }
        if (n.nb >= 0) {
            var it: i64 = infer_expr(n.nb);
            if (vt >= 0 && ti_kind(it) != "Unknown" && ti_equal(it, vt) == false) {
                var vk: string = ti_kind(vt);
                var int_to_fe: bool = (vk == "Flag" || vk == "Enum") && is_int_ti(it);
                if (int_to_fe == false && can_cast(it, vt) == false) {
                    err_type_mismatch(n.nb, vt, it);
                }
            }
            if (vt < 0) {
                sym_define(cur_scope, n.sa, "var", it, -1);
                return;
            }
        }
        if (vt >= 0) {
            sym_define(cur_scope, n.sa, "var", vt, -1);
        }
        return;
    }
    if (n.kind == "if") {
        var ct: i64 = infer_expr(n.na);
        if (ti_kind(ct) == "Scalar" && ti_name(ct) != "bool") {
            var di: i64 = diag_new("T_STMT_IMPLICIT_BOOL", "error",
                cat2("if condition must be bool or explicit comparison, got ", ti_str(ct)),
                "", 1, 1, 1, 5);
            var fx: i64 = fix_one("add explicit comparison", "", 1, 1, 1, 1, "(expr != 0)");
            diag_set_fs(di, fx);
        }
        var prev: i64 = cur_scope;
        cur_scope = scope_new(prev);
        var c: i64 = n.la;
        while (c >= 0) {
            var k: Child = kids[c];
            check_stmt(k.val);
            c = k.next;
        }
        if (n.lb != -2) {
            cur_scope = scope_new(prev);
            var c2: i64 = n.lb;
            while (c2 >= 0) {
                var k2: Child = kids[c2];
                check_stmt(k2.val);
                c2 = k2.next;
            }
        }
        cur_scope = prev;
        return;
    }
    if (n.kind == "for" || n.kind == "while") {
        var cond: i64 = n.na;
        if (n.kind == "for") {
            cond = n.nb;
        }
        if (cond >= 0) {
            var ct2: i64 = infer_expr(cond);
            if (ti_kind(ct2) == "Scalar" && ti_name(ct2) != "bool") {
                diag_new("T_STMT_IMPLICIT_BOOL", "error",
                    cat2("loop condition must be bool, got ", ti_str(ct2)),
                    "", 1, 1, 1, 5);
            }
        }
        var prev2: i64 = cur_scope;
        cur_scope = scope_new(prev2);
        if (n.kind == "for" && n.na >= 0) {
            check_stmt(n.na);
        }
        var c3: i64 = n.la;
        while (c3 >= 0) {
            var k3: Child = kids[c3];
            check_stmt(k3.val);
            c3 = k3.next;
        }
        cur_scope = prev2;
        return;
    }
    if (n.kind == "for_each") {
        var itt: i64 = infer_expr(n.na);
        var prev3: i64 = cur_scope;
        cur_scope = scope_new(prev3);
        var et: i64 = -1;
        var itk: string = ti_kind(itt);
        if (itk == "Slice" || itk == "Array") {
            var t4: TI = tis[itt];
            et = t4.elem;
        } else {
            et = ti_mk("Unknown");
        }
        sym_define(cur_scope, n.sa, "var", et, -1);
        var c4: i64 = n.la;
        while (c4 >= 0) {
            var k4: Child = kids[c4];
            check_stmt(k4.val);
            c4 = k4.next;
        }
        cur_scope = prev3;
        return;
    }
    if (n.kind == "return") {
        if (n.na >= 0) {
            var rt: i64 = infer_expr(n.na);
            if (ti_kind(rt) != "Unknown" && ti_equal(rt, cur_ret) == false) {
                if (can_cast(rt, cur_ret) == false) {
                    err_type_mismatch(n.na, cur_ret, rt);
                }
            }
        }
        return;
    }
    if (n.kind == "assignment") {
        var tt: i64 = infer_expr(n.na);
        var vt2: i64 = infer_expr(n.nb);
        if (ti_kind(tt) != "Unknown" && ti_kind(vt2) != "Unknown" && ti_equal(tt, vt2) == false) {
            if (can_cast(vt2, tt) == false) {
                err_type_mismatch(n.nb, tt, vt2);
            }
        }
        return;
    }
    if (n.kind == "expr") {
        infer_expr(n.na);
        return;
    }
    if (n.kind == "block" || n.kind == "defer" || n.kind == "comptime_block") {
        var prev4: i64 = cur_scope;
        cur_scope = scope_new(prev4);
        var c5: i64 = n.la;
        while (c5 >= 0) {
            var k5: Child = kids[c5];
            check_stmt(k5.val);
            c5 = k5.next;
        }
        cur_scope = prev4;
        return;
    }
    if (n.kind == "switch") {
        infer_expr(n.na);
        var c6: i64 = n.la;
        while (c6 >= 0) {
            var k6: Child = kids[c6];
            var cs: Node = nodes[k6.val];
            infer_expr(cs.na);
            var b: i64 = cs.la;
            while (b >= 0) {
                var kb: Child = kids[b];
                check_stmt(kb.val);
                b = kb.next;
            }
            c6 = k6.next;
        }
        if (n.lb != -2) {
            var c7: i64 = n.lb;
            while (c7 >= 0) {
                var k7: Child = kids[c7];
                check_stmt(k7.val);
                c7 = k7.next;
            }
        }
        return;
    }
}

// ── 声明检查（复刻 checker.ts:178-341）────────────────────────

check_func_decl :: func(d: i64) -> void {
    var n: Node = nodes[d];
    if (n.lc == -2) {
        return;
    }

    var prev: i64 = cur_scope;
    cur_scope = scope_new(global_scope);

    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var p: Node = nodes[k.val];
        sym_define(cur_scope, p.sa, "var", resolve_ti(p.na), -1);
        c = k.next;
    }

    var prev_ret: i64 = cur_ret;
    cur_ret = resolve_ti(n.na);

    var c2: i64 = n.lc;
    while (c2 >= 0) {
        var k2: Child = kids[c2];
        check_stmt(k2.val);
        c2 = k2.next;
    }

    if (ti_kind(cur_ret) != "Void") {
        if (all_paths_return(n.lc) == false) {
            var anchor: i64 = list_last_val(n.lc);
            var l: i64 = n_line(anchor);
            var cc: i64 = n_col(anchor);
            diag_new("T_PARSE_INVALID_EXPR", "error",
                cat3("function '", n.sa, "' is missing return on some code paths (all branches must explicitly return)"),
                n_file(anchor), l, cc, l, cc + 10);
        }
    }

    cur_ret = prev_ret;
    cur_scope = prev;
}

check_struct_decl :: func(d: i64) -> void {
    var n: Node = nodes[d];
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var f: Node = nodes[k.val];
        if (f.ia == -1) {
            resolve_ti(f.na);
        }
        c = k.next;
    }
}

check_enum_decl :: func(d: i64) -> void {
    var n: Node = nodes[d];
    if (is_int_name(n.sb) == false) {
        var di: i64 = diag_new("T_TYPE_MISMATCH", "error",
            cat5("enum '", n.sa, "' underlying type must be an integer type, got '", n.sb, "'"),
            "", 1, 1, 1, 10);
        slb_begin();
        slb_add("u8");
        slb_add("u16");
        slb_add("u32");
        slb_add("u64");
        slb_add("i8");
        slb_add("i16");
        slb_add("i32");
        slb_add("i64");
        diag_set_vv(di, slb_head);
    }

    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var v: Node = nodes[k.val];
        if (v.na >= 0) {
            var vt: i64 = infer_expr(v.na);
            if (ti_kind(vt) == "Scalar" && is_int_name(ti_name(vt)) == false) {
                diag_new("T_TYPE_MISMATCH", "error",
                    cat2("enum variant value must be integer, got ", ti_str(vt)),
                    "", 1, 1, 1, 5);
            }
        }
        c = k.next;
    }
}

// flag decl 检查用的 usedBits 暂存池（append-only，按 base 划分）
var fd_names: []string;
var fd_starts: []i64;
var fd_ends: []i64;

check_flag_decl :: func(d: i64) -> void {
    var n: Node = nodes[d];
    var is_flag: bool = n.kind == "FlagDecl";
    if (is_flag && is_int_name(n.sb) == false) {
        var di: i64 = diag_new("T_TYPE_MISMATCH", "error",
            cat5("flag '", n.sa, "' underlying type must be an integer type, got '", n.sb, "'"),
            "", 1, 1, 1, 10);
        slb_begin();
        slb_add("u8");
        slb_add("u16");
        slb_add("u32");
        slb_add("u64");
        diag_set_vv(di, slb_head);
    }

    var auto_off: i64 = 0;
    var base: i64 = slice_len(fd_names) as i64;

    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var sl: Node = nodes[k.val];
        var start: i64 = auto_off;
        if (sl.bb) {
            start = sl.ib;
        }
        var end: i64 = start + sl.ia;

        var i: i64 = base;
        var total: i64 = slice_len(fd_names) as i64;
        while (i < total) {
            var us: i64 = fd_starts[i];
            var ue: i64 = fd_ends[i];
            if (start < ue && end > us) {
                var msb: StringBuilder = sb_new();
                sb_append_str(msb, "flag slot '");
                sb_append_str(msb, sl.sa);
                sb_append_str(msb, "' (bits ");
                sb_append_i64(msb, start);
                sb_append_str(msb, "-");
                sb_append_i64(msb, end - 1);
                sb_append_str(msb, ") overlaps with '");
                sb_append_str(msb, fd_names[i]);
                sb_append_str(msb, "' (bits ");
                sb_append_i64(msb, us);
                sb_append_str(msb, "-");
                sb_append_i64(msb, ue - 1);
                sb_append_str(msb, ")");
                diag_new("T_FLAG_OFFSET_CONFLICT", "error", sb_to_str(msb), "", 1, 1, 1, 10);
            }
            i = i + 1;
        }

        append(fd_names, sl.sa);
        append(fd_starts, start);
        append(fd_ends, end);

        if (is_flag) {
            var tw: i64 = get_bw(n.sb);
            if (tw > 0 && end > tw) {
                var osb: StringBuilder = sb_new();
                sb_append_str(osb, "flag '");
                sb_append_str(osb, n.sa);
                sb_append_str(osb, "' slot '");
                sb_append_str(osb, sl.sa);
                sb_append_str(osb, "' exceeds ");
                sb_append_str(osb, n.sb);
                sb_append_str(osb, " (");
                sb_append_i64(osb, tw);
                sb_append_str(osb, " bits): uses bits ");
                sb_append_i64(osb, start);
                sb_append_str(osb, "-");
                sb_append_i64(osb, end - 1);
                var di2: i64 = diag_new("T_FLAG_OVERFLOW", "error", sb_to_str(osb), "", 1, 1, 1, 10);
                slb_begin();
                slb_add(cat3("0-", i2s(tw - 1), " bits"));
                diag_set_vv(di2, slb_head);
            }
        }

        auto_off = end;
        c = k.next;
    }
}

check_decl :: func(d: i64) -> void {
    var n: Node = nodes[d];
    if (n.kind == "FuncDecl") {
        check_func_decl(d);
        return;
    }
    if (n.kind == "StructDecl") {
        check_struct_decl(d);
        return;
    }
    if (n.kind == "EnumDecl") {
        check_enum_decl(d);
        return;
    }
    if (n.kind == "FlagDecl" || n.kind == "FlagSetDecl") {
        check_flag_decl(d);
        return;
    }
    if (n.kind == "GlobalVarDecl") {
        if (n.nb >= 0) {
            var it: i64 = infer_expr(n.nb);
            var vt: i64 = resolve_ti(n.na);
            if (ti_kind(it) != "Unknown" && ti_equal(it, vt) == false) {
                if (can_cast(it, vt) == false) {
                    err_type_mismatch(n.nb, vt, it);
                }
            }
        }
        return;
    }
    if (n.kind == "GlobalConstDecl") {
        if (n.nb >= 0) {
            var it2: i64 = infer_expr(n.nb);
            if (n.na >= 0) {
                var ct: i64 = resolve_ti(n.na);
                if (ti_kind(it2) != "Unknown" && ti_equal(it2, ct) == false) {
                    if (can_cast(it2, ct) == false) {
                        err_type_mismatch(n.nb, ct, it2);
                    }
                }
            }
        }
        return;
    }
}

// ── check 主流程（复刻 checker.ts:83）─────────────────────────

run_check :: func() -> void {
    global_scope = scope_new(-1);
    cur_scope = global_scope;
    cur_ret = ti_mk("Void");

    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        register_decl(decl_list[i]);
        i = i + 1;
    }
    var j: i64 = 0;
    while (j < n) {
        check_decl(decl_list[j]);
        j = j + 1;
    }
}

// ── Flag Resolver（复刻 tc0/flag/bitfield.ts resolve）─────────
// 注意：与 checker.checkFlagDecl 不同——overflow 先检、overlap 后检；
// FlagSetDecl 不产生诊断。

var fr_names: []string;
var fr_starts: []i64;
var fr_ends: []i64;

fr_resolve_flag :: func(d: i64) -> void {
    var n: Node = nodes[d];
    var tw: i64 = get_bw(n.sb);
    if (tw < 0) {
        tw = 32;
    }
    var auto_off: i64 = 0;
    var base: i64 = slice_len(fr_names) as i64;

    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var sl: Node = nodes[k.val];
        var start: i64 = auto_off;
        if (sl.bb) {
            start = sl.ib;
        }
        var end: i64 = start + sl.ia;

        if (end > tw) {
            var osb: StringBuilder = sb_new();
            sb_append_str(osb, "flag '");
            sb_append_str(osb, n.sa);
            sb_append_str(osb, "' slot '");
            sb_append_str(osb, sl.sa);
            sb_append_str(osb, "' exceeds ");
            sb_append_str(osb, n.sb);
            sb_append_str(osb, " capacity: uses bits ");
            sb_append_i64(osb, start);
            sb_append_str(osb, "-");
            sb_append_i64(osb, end - 1);
            sb_append_str(osb, ", but ");
            sb_append_str(osb, n.sb);
            sb_append_str(osb, " only has ");
            sb_append_i64(osb, tw);
            sb_append_str(osb, " bits");
            var di: i64 = diag_new("T_FLAG_OVERFLOW", "error", sb_to_str(osb), "", 0, 0, 0, 0);
            slb_begin();
            slb_add(cat2("0-", i2s(tw - 1)));
            diag_set_vv(di, slb_head);
            var fx: i64 = fix_one("reduce bit width or use larger underlying type (u64)", "", 0, 0, 0, 0, "flag[u64]");
            diag_set_fs(di, fx);
        }

        var i: i64 = base;
        var total: i64 = slice_len(fr_names) as i64;
        while (i < total) {
            var us: i64 = fr_starts[i];
            var ue: i64 = fr_ends[i];
            if (start < ue && end > us) {
                var msb: StringBuilder = sb_new();
                sb_append_str(msb, "flag slot '");
                sb_append_str(msb, sl.sa);
                sb_append_str(msb, "' (bits ");
                sb_append_i64(msb, start);
                sb_append_str(msb, "-");
                sb_append_i64(msb, end - 1);
                sb_append_str(msb, ") overlaps with '");
                sb_append_str(msb, fr_names[i]);
                sb_append_str(msb, "' (bits ");
                sb_append_i64(msb, us);
                sb_append_str(msb, "-");
                sb_append_i64(msb, ue - 1);
                sb_append_str(msb, ")");
                diag_new("T_FLAG_OFFSET_CONFLICT", "error", sb_to_str(msb), "", 0, 0, 0, 0);
            }
            i = i + 1;
        }

        append(fr_names, sl.sa);
        append(fr_starts, start);
        append(fr_ends, end);
        auto_off = end;
        c = k.next;
    }
}

flag_pass :: func() -> void {
    // 复刻 index.ts compilePipeline：每个 FlagDecl 被 resolve 两次——
    // 一次经 typeInfoProvider.registerDecl（内部调 flagResolver.resolve），
    // 一次为管线中的直接 flagResolver.resolve(decl)。诊断因此重复两遍。
    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = decl_list[i];
        var nd: Node = nodes[d];
        if (nd.kind == "FlagDecl") {
            fr_resolve_flag(d);
            fr_resolve_flag(d);
        }
        i = i + 1;
    }
}

// ── 注解注册表（复刻 tc0/annotations/registry.ts）─────────────

AnnDef :: struct {
    name: string;
    spec: string;       // none/string/ident/ident_list/number/mixed
    targets: string;    // ", " 分隔（照 validTargets.join(", ") 顺序）
    depr: bool;
    repl: string;
}

var anndefs: []AnnDef;

ad :: func(name: string, spec: string, targets: string) -> void {
    var a: AnnDef;
    a.name = name;
    a.spec = spec;
    a.targets = targets;
    a.depr = false;
    a.repl = "";
    append(anndefs, a);
}

// >>> GEN:annotations (generated by tools/totter.tc from build/ebnf.json -- DO NOT EDIT) >>>
init_anndefs :: func() -> void {
    ad("test", "none", "func");
    ad("test_skip", "none", "func");
    ad("test_only", "none", "func");
    ad("expect_fail", "none", "func");
    ad("test_group", "string", "func");
    ad("derive", "ident_list", "struct, enum, flag, flag_set, union");
    ad("cfg", "ident", "global, func, struct, enum, var, const");
    ad("cfg_attr", "mixed", "global, func, struct, enum");
    ad("allow", "ident_list", "global, func, struct, var, const");
    ad("warn", "ident_list", "global, func, struct, var, const");
    ad("deny", "ident_list", "global, func, struct, var, const");
    ad("deprecated", "string", "global, func, struct, enum, var, const");
    ad("repr", "ident", "struct, enum, union");
    ad("no_padding", "none", "struct, flag");
    ad("align", "number", "struct, union");
    ad("bitpack", "ident", "struct");
    ad("offset", "number", "flag_slot");
    ad("binary_offset", "number", "field");
    ad("binary_skip", "none", "field");
    ad("soa", "none", "struct");
    ad("aos", "none", "struct");
    ad("inline", "none", "func");
    ad("no_inline", "none", "func");
    ad("must_use", "none", "func");
    ad("const_fn", "none", "func");
    ad("unsafe", "none", "func");
    ad("main", "none", "func");
    ad("export_symbol", "string", "func");
    ad("link_name", "string", "func");
    ad("panic_handler", "none", "func");
    ad("doc", "string", "global");
    ad("doc_file", "string", "func, struct, enum");
    ad("export", "mixed", "field, func, var, const");
    ad("auto_convert", "none", "struct, enum");
    // 弃用标记（数据驱动生成）
    var diauto_convert: i64 = anndef_find("auto_convert");
    if (diauto_convert >= 0) {
        var aauto_convert: AnnDef = anndefs[diauto_convert];
        aauto_convert.depr = true;
        aauto_convert.repl = "@derive(FromString)";
        slice_set(anndefs, diauto_convert, aauto_convert);
    }
}
// <<< GEN:annotations <<<

anndef_find :: func(name: string) -> i64 {
    var n: i64 = slice_len(anndefs) as i64;
    var i: i64 = 0;
    while (i < n) {
        var a: AnnDef = anndefs[i];
        if (a.name == name) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// ", " 分隔的 targets 中精确匹配
targets_has :: func(ts: string, t: string) -> bool {
    var n: i64 = str_len(ts) as i64;
    var start: i64 = 0;
    var i: i64 = 0;
    while (i <= n) {
        var hit: bool = i == n;
        if (hit == false) {
            hit = ts[i] == 44;
        }
        if (hit) {
            var seg: string = str_slice(ts, start, i);
            if (seg == t) {
                return true;
            }
            start = i + 2;
            i = i + 1;
        }
        i = i + 1;
    }
    return false;
}

// 把 targets 逐段加入 slb（validValues）
targets_push_vv :: func(ts: string) -> void {
    var n: i64 = str_len(ts) as i64;
    var start: i64 = 0;
    var i: i64 = 0;
    while (i <= n) {
        var hit: bool = i == n;
        if (hit == false) {
            hit = ts[i] == 44;
        }
        if (hit) {
            slb_add(str_slice(ts, start, i));
            start = i + 2;
            i = i + 1;
        }
        i = i + 1;
    }
}

starts_with :: func(s: string, p: string) -> bool {
    var np: u64 = str_len(p);
    if (str_len(s) < np) {
        return false;
    }
    var i: u64 = 0;
    while (i < np) {
        if (s[i] != p[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

is_cfg_cond :: func(v: string) -> bool {
    if (v == "debug" || v == "release" || v == "windows" || v == "linux") {
        return true;
    }
    return v == "mac" || v == "android" || v == "web";
}

is_derive_trait :: func(v: string) -> bool {
    if (v == "ToString" || v == "FromString" || v == "Clone" || v == "Copy") {
        return true;
    }
    if (v == "DebugPrint" || v == "BinarySerde" || v == "Eq") {
        return true;
    }
    return v == "PartialEq" || v == "Hash";
}

is_valid_warning :: func(v: string) -> bool {
    if (v == "unused" || v == "unused_field" || v == "dead_code") {
        return true;
    }
    if (v == "overflow_literal" || v == "implicit_cast") {
        return true;
    }
    return v == "bitfield_overlap" || v == "deprecated";
}

// >>> GEN:derives (generated by tools/totter.tc from build/ebnf.json -- DO NOT EDIT) >>>
vv_derive_traits :: func() -> void {
    slb_add("ToString");
    slb_add("FromString");
    slb_add("Clone");
    slb_add("Copy");
    slb_add("DebugPrint");
    slb_add("BinarySerde");
    slb_add("Eq");
    slb_add("PartialEq");
    slb_add("Hash");
}
// <<< GEN:derives <<<

vv_warnings :: func() -> void {
    slb_add("unused");
    slb_add("unused_field");
    slb_add("dead_code");
    slb_add("overflow_literal");
    slb_add("implicit_cast");
    slb_add("bitfield_overlap");
    slb_add("deprecated");
}

vv_cfg :: func() -> void {
    slb_add("debug");
    slb_add("release");
    slb_add("windows");
    slb_add("linux");
    slb_add("mac");
    slb_add("android");
    slb_add("web");
}

// derive/allow/warn/deny 的 trait/warning 项遍历校验
ann_check_items :: func(ai: i64, is_derive: bool, l: i64, c: i64) -> void {
    var an: Node = nodes[ai];
    var c1: i64 = an.la;
    while (c1 >= 0) {
        var k: Child = kids[c1];
        var arg: Node = nodes[k.val];
        if (arg.kind == "list") {
            var c2: i64 = arg.la;
            while (c2 >= 0) {
                var k2: Child = kids[c2];
                var m: Node = nodes[k2.val];
                var v: string = "";
                if (m.kind == "ident") {
                    v = m.sa;
                }
                ann_check_item(v, is_derive, l, c);
                c2 = k2.next;
            }
        } else {
            var v2: string = "";
            if (arg.kind == "ident") {
                v2 = arg.sa;
            }
            ann_check_item(v2, is_derive, l, c);
        }
        c1 = k.next;
    }
}

ann_check_item :: func(v: string, is_derive: bool, l: i64, c: i64) -> void {
    if (is_derive) {
        if (is_derive_trait(v) == false) {
            var di: i64 = diag_new("T_DERIVE_UNSUPPORTED", "error",
                cat3("unsupported derive trait '", v, "'"),
                g_file, l, c, l, c + 20);
            slb_begin();
            vv_derive_traits();
            diag_set_vv(di, slb_head);
        }
        return;
    }
    if (is_valid_warning(v) == false) {
        var di2: i64 = diag_new("T_ANNOTATION_INVALID_ARG", "error",
            cat3("unknown warning item '", v, "'"),
            g_file, l, c, l, c + 20);
        slb_begin();
        vv_warnings();
        diag_set_vv(di2, slb_head);
    }
}

// validate（复刻 registry.ts:168）；ai = A 节点索引
ann_validate :: func(ai: i64, target: string) -> void {
    var an: Node = nodes[ai];
    var name: string = an.sa;
    var l: i64 = an.ln as i64;
    var c: i64 = an.cl as i64;
    var name_len: i64 = str_len(name) as i64;
    var di_: i64 = anndef_find(name);

    if (di_ < 0) {
        var d1: i64 = diag_new("T_ANNOTATION_UNKNOWN", "error",
            cat3("unknown annotation '@", name, "'"),
            g_file, l, c, l, c + name_len + 1);
        slb_begin();
        var n: i64 = slice_len(anndefs) as i64;
        var i: i64 = 0;
        while (i < n) {
            var a: AnnDef = anndefs[i];
            slb_add(cat2("@", a.name));
            i = i + 1;
        }
        diag_set_vv(d1, slb_head);
        return;
    }

    var def: AnnDef = anndefs[di_];

    if (def.depr) {
        var msg: string = cat3("annotation '@", name, "' is deprecated");
        if (str_len(def.repl) > 0) {
            msg = cat4(msg, ", use ", def.repl, " instead");
        }
        diag_new("T_ANNOTATION_UNKNOWN", "warning", msg, g_file, l, c, l, c + name_len + 1);
    }

    if (targets_has(def.targets, target) == false) {
        var d2: i64 = diag_new("T_ANNOTATION_WRONG_TARGET", "error",
            cat6("annotation '@", name, "' cannot be applied to ", target, ", valid targets: ", def.targets),
            g_file, l, c, l, c + name_len + 1);
        slb_begin();
        targets_push_vv(def.targets);
        diag_set_vv(d2, slb_head);
    }

    // ── validateArgs ──
    var argc: i64 = list_count(an.la);

    if (def.spec == "none") {
        if (argc > 0) {
            diag_new("T_ANNOTATION_INVALID_ARG", "error",
                cat3("annotation '@", name, "' takes no arguments"),
                g_file, l, c, l, c + name_len + 1);
        }
        return;
    }
    if (def.spec == "string") {
        var bad: bool = argc != 1;
        if (bad == false) {
            var k0: Child = kids[an.la];
            var a0: Node = nodes[k0.val];
            bad = a0.kind != "string";
        }
        if (bad) {
            var d3: i64 = diag_new("T_ANNOTATION_INVALID_ARG", "error",
                cat3("annotation '@", name, "' requires exactly one string argument"),
                g_file, l, c, l, c + name_len + 1);
            slb_begin();
            slb_add("@${annotation.name}(\"text\")");
            diag_set_vv(d3, slb_head);
        }
        return;
    }
    if (def.spec == "ident") {
        var bad2: bool = argc != 1;
        var a0k: string = "";
        var a0v: string = "";
        if (argc >= 1) {
            var k1: Child = kids[an.la];
            var a1: Node = nodes[k1.val];
            a0k = a1.kind;
            a0v = a1.sa;
        }
        if (bad2 == false) {
            bad2 = a0k != "ident" && a0k != "list";
        }
        if (bad2) {
            diag_new("T_ANNOTATION_INVALID_ARG", "error",
                cat3("annotation '@", name, "' requires one identifier argument"),
                g_file, l, c, l, c + name_len + 1);
        }
        if (name == "cfg" && a0k == "ident") {
            if (is_cfg_cond(a0v) == false && starts_with(a0v, "feature=") == false) {
                var d4: i64 = diag_new("T_ANNOTATION_INVALID_ARG", "error",
                    cat3("invalid @cfg condition '", a0v, "'"),
                    g_file, l, c, l, c + name_len + 1);
                slb_begin();
                vv_cfg();
                diag_set_vv(d4, slb_head);
            }
        }
        return;
    }
    if (def.spec == "ident_list") {
        if (argc < 1) {
            diag_new("T_ANNOTATION_INVALID_ARG", "error",
                cat3("annotation '@", name, "' requires at least one argument"),
                g_file, l, c, l, c + name_len + 1);
        }
        if (name == "derive") {
            ann_check_items(ai, true, l, c);
        }
        if (name == "allow" || name == "warn" || name == "deny") {
            ann_check_items(ai, false, l, c);
        }
        return;
    }
    if (def.spec == "number") {
        var bad3: bool = argc != 1;
        if (bad3 == false) {
            var k2: Child = kids[an.la];
            var a2: Node = nodes[k2.val];
            bad3 = a2.kind != "number";
        }
        if (bad3) {
            diag_new("T_ANNOTATION_INVALID_ARG", "error",
                cat3("annotation '@", name, "' requires one numeric argument"),
                g_file, l, c, l, c + name_len + 1);
        }
        return;
    }
}

// getDeclTarget（复刻 index.ts:181）
decl_target :: func(kind: string) -> string {
    if (kind == "StructDecl") {
        return "struct";
    }
    if (kind == "EnumDecl") {
        return "enum";
    }
    if (kind == "FlagDecl") {
        return "flag";
    }
    if (kind == "FlagSetDecl") {
        return "flag_set";
    }
    if (kind == "UnionDecl") {
        return "union";
    }
    if (kind == "VariantDecl") {
        return "variant";
    }
    if (kind == "FuncDecl") {
        return "func";
    }
    if (kind == "GlobalVarDecl") {
        return "var";
    }
    if (kind == "GlobalConstDecl") {
        return "const";
    }
    return "global";
}

ann_pass :: func() -> void {
    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = decl_list[i];
        var nd: Node = nodes[d];
        var target: string = decl_target(nd.kind);
        var c: i64 = nd.la;
        while (c >= 0) {
            var k: Child = kids[c];
            ann_validate(k.val, target);
            c = k.next;
        }
        i = i + 1;
    }
}

// ── pretty JSON 输出（复刻 JSON.stringify(x, null, 2)）────────

hex_digit :: func(v: u8) -> u8 {
    if (v < 10) {
        return 48 + v;
    }
    return 97 + (v - 10);
}

json_escape_into :: func(out: StringBuilder, s: string) -> void {
    var i: u64 = 0;
    var n: u64 = str_len(s);
    while (i < n) {
        var b: u8 = s[i];
        if (b == 34) {
            sb_append_char(out, 92);
            sb_append_char(out, 34);
        } else {
        if (b == 92) {
            sb_append_char(out, 92);
            sb_append_char(out, 92);
        } else {
        if (b == 10) {
            sb_append_char(out, 92);
            sb_append_char(out, 110);
        } else {
        if (b == 9) {
            sb_append_char(out, 92);
            sb_append_char(out, 116);
        } else {
        if (b == 13) {
            sb_append_char(out, 92);
            sb_append_char(out, 114);
        } else {
        if (b == 8) {
            sb_append_char(out, 92);
            sb_append_char(out, 98);
        } else {
        if (b == 12) {
            sb_append_char(out, 92);
            sb_append_char(out, 102);
        } else {
        if (b < 32) {
            sb_append_char(out, 92);
            sb_append_char(out, 117);
            sb_append_char(out, 48);
            sb_append_char(out, 48);
            sb_append_char(out, hex_digit(b / 16));
            sb_append_char(out, hex_digit(b % 16));
        } else {
            sb_append_char(out, b);
        }}}}}}}}
        i = i + 1;
    }
}

j_qstr :: func(out: StringBuilder, s: string) -> void {
    sb_append_char(out, 34);
    json_escape_into(out, s);
    sb_append_char(out, 34);
}

// "      \"key\": \"value\",\n" 之类的辅助
jkv_str :: func(out: StringBuilder, ind: string, key: string, val: string, comma: bool) -> void {
    sb_append_str(out, ind);
    sb_append_char(out, 34);
    sb_append_str(out, key);
    sb_append_str(out, "\": ");
    j_qstr(out, val);
    if (comma) {
        sb_append_char(out, 44);
    }
    sb_append_char(out, 10);
}

jkv_num :: func(out: StringBuilder, ind: string, key: string, val: i64, comma: bool) -> void {
    sb_append_str(out, ind);
    sb_append_char(out, 34);
    sb_append_str(out, key);
    sb_append_str(out, "\": ");
    sb_append_i64(out, val);
    if (comma) {
        sb_append_char(out, 44);
    }
    sb_append_char(out, 10);
}

// location/range 对象输出
j_loc :: func(out: StringBuilder, ind: string, ind2: string, key: string, file: string, sl: i64, sc: i64, el: i64, ec: i64, comma: bool) -> void {
    sb_append_str(out, ind);
    sb_append_char(out, 34);
    sb_append_str(out, key);
    sb_append_str(out, "\": {");
    sb_append_char(out, 10);
    jkv_str(out, ind2, "file", file, true);
    jkv_num(out, ind2, "startLine", sl, true);
    jkv_num(out, ind2, "startCol", sc, true);
    jkv_num(out, ind2, "endLine", el, true);
    jkv_num(out, ind2, "endCol", ec, false);
    sb_append_str(out, ind);
    sb_append_char(out, 125);
    if (comma) {
        sb_append_char(out, 44);
    }
    sb_append_char(out, 10);
}

// 字符串链表数组输出（validValues/notes）；head=-1 输出 null
j_str_list :: func(out: StringBuilder, ind: string, ind2: string, key: string, head: i64, comma: bool) -> void {
    sb_append_str(out, ind);
    sb_append_char(out, 34);
    sb_append_str(out, key);
    sb_append_str(out, "\": ");
    if (head < 0) {
        sb_append_str(out, "null");
    } else {
        sb_append_char(out, 91);
        sb_append_char(out, 10);
        var c: i64 = head;
        while (c >= 0) {
            var it: SI = sitems[c];
            sb_append_str(out, ind2);
            j_qstr(out, it.s);
            if (it.next >= 0) {
                sb_append_char(out, 44);
            }
            sb_append_char(out, 10);
            c = it.next;
        }
        sb_append_str(out, ind);
        sb_append_char(out, 93);
    }
    if (comma) {
        sb_append_char(out, 44);
    }
    sb_append_char(out, 10);
}

print_json :: func() -> void {
    var out: StringBuilder = sb_new();
    var nd: i64 = slice_len(diags) as i64;

    sb_append_str(out, "{\n");
    if (nd == 0) {
        sb_append_str(out, "  \"diagnostics\": [],\n");
    } else {
        sb_append_str(out, "  \"diagnostics\": [\n");
        var i: i64 = 0;
        while (i < nd) {
            var d: Diag = diags[i];
            sb_append_str(out, "    {\n");
            jkv_str(out, "      ", "code", d.code, true);
            jkv_str(out, "      ", "severity", d.sev, true);
            jkv_str(out, "      ", "message", d.msg, true);
            j_loc(out, "      ", "        ", "location", d.file, d.sl, d.sc, d.el, d.ec, true);
            j_str_list(out, "      ", "        ", "validValues", d.vv, true);

            // fixSuggestions
            sb_append_str(out, "      \"fixSuggestions\": ");
            if (d.fs < 0) {
                sb_append_str(out, "null");
            } else {
                sb_append_str(out, "[\n");
                var f: i64 = d.fs;
                while (f >= 0) {
                    var fx: FixS = fixes[f];
                    sb_append_str(out, "        {\n");
                    jkv_str(out, "          ", "description", fx.desc, true);
                    j_loc(out, "          ", "            ", "range", fx.file, fx.sl, fx.sc, fx.el, fx.ec, true);
                    jkv_str(out, "          ", "replacement", fx.repl, false);
                    sb_append_str(out, "        }");
                    if (fx.next >= 0) {
                        sb_append_char(out, 44);
                    }
                    sb_append_char(out, 10);
                    f = fx.next;
                }
                sb_append_str(out, "      ]");
            }
            sb_append_str(out, ",\n");

            j_str_list(out, "      ", "        ", "notes", d.nt, false);

            sb_append_str(out, "    }");
            if (i + 1 < nd) {
                sb_append_char(out, 44);
            }
            sb_append_char(out, 10);
            i = i + 1;
        }
        sb_append_str(out, "  ],\n");
    }

    var errs: i64 = 0;
    var warns: i64 = 0;
    var infos: i64 = 0;
    var j: i64 = 0;
    while (j < nd) {
        var d2: Diag = diags[j];
        if (d2.sev == "error") {
            errs = errs + 1;
        }
        if (d2.sev == "warning") {
            warns = warns + 1;
        }
        if (d2.sev == "info") {
            infos = infos + 1;
        }
        j = j + 1;
    }
    sb_append_str(out, "  \"summary\": {\n");
    jkv_num(out, "    ", "total", nd, true);
    jkv_num(out, "    ", "errors", errs, true);
    jkv_num(out, "    ", "warnings", warns, true);
    jkv_num(out, "    ", "infos", infos, false);
    sb_append_str(out, "  }\n");
    sb_append_str(out, "}");

    print(sb_to_str(out));
    print("\n");
}

has_errors :: func() -> bool {
    var n: i64 = slice_len(diags) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: Diag = diags[i];
        if (d.sev == "error") {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// ═══════════════════════════════════════════════════════════════
// M8: C Emitter（复刻 tc0/codegen/emitter.ts）
// ═══════════════════════════════════════════════════════════════

// ── 输出行池 ───────────────────────────────────────────────────

var hlines: []string;   // headerLines
var slines: []string;   // sourceLines

hpush :: func(s: string) -> void {
    append(hlines, s);
}

spush :: func(s: string) -> void {
    append(slines, s);
}

// 向最后一行追加文本（ForStmt 拼接用）
sappend_last :: func(s: string) -> void {
    var n: i64 = slice_len(slines) as i64;
    var last: string = slines[n - 1];
    var joined: string = cat2(last, s);
    slice_set(slines, n - 1, joined);
}

// ── 小工具 ─────────────────────────────────────────────────────

to_upper :: func(s: string) -> string {
    var sb: StringBuilder = sb_new();
    var i: u64 = 0;
    var n: u64 = str_len(s);
    while (i < n) {
        var c: u8 = s[i];
        if (c >= 97 && c <= 122) {
            sb_append_char(sb, c - 32);
        } else {
            sb_append_char(sb, c);
        }
        i = i + 1;
    }
    return sb_to_str(sb);
}

ends_with_star :: func(s: string) -> bool {
    var n: u64 = str_len(s);
    if (n == 0) {
        return false;
    }
    return s[n - 1] == 42;
}

// ── TypeDesc 池（复刻 TypeDesc interface）──────────────────────
// cat: "string" | "slice" | "map" | "named" | "scalar" | "unknown" | "void"

TD :: struct {
    cat: string;
    name: string;
    elem: i64;   // TD 索引，-1 = 无
    key: i64;
    val: i64;
}

var tds: []TD;

td_mk :: func(cat: string) -> i64 {
    var t: TD;
    t.cat = cat;
    t.name = "";
    t.elem = -1;
    t.key = -1;
    t.val = -1;
    append(tds, t);
    return (slice_len(tds) as i64) - 1;
}

td_named_mk :: func(cat: string, name: string) -> i64 {
    var i: i64 = td_mk(cat);
    var t: TD = tds[i];
    t.name = name;
    slice_set(tds, i, t);
    return i;
}

td_elem_mk :: func(cat: string, elem: i64) -> i64 {
    var i: i64 = td_mk(cat);
    var t: TD = tds[i];
    t.elem = elem;
    slice_set(tds, i, t);
    return i;
}

// ── typeMap / fnScopes / structFields（扁平池，last-match-wins）─

var tm_names: []string;   // 全局 typeMap（globals + "fn()" 返回类型）
var tm_tds: []i64;

var fs_fns: []string;     // 函数级 scope：函数名 + 变量名 → td
var fs_vars: []string;
var fs_tds: []i64;

var sf_structs: []string; // struct 字段：struct 名 + 字段名 → td
var sf_fields: []string;
var sf_tds: []i64;

var em_cur_fn: string;    // 当前作用域函数名（"" = 无）
var em_in_fn: bool;

var em_main_fn: string;   // @main 函数的 mangle 名
var em_has_main: bool;

tm_set :: func(name: string, td: i64) -> void {
    append(tm_names, name);
    append(tm_tds, td);
}

tm_get :: func(name: string) -> i64 {
    var n: i64 = slice_len(tm_names) as i64;
    var i: i64 = n - 1;
    while (i >= 0) {
        if (tm_names[i] == name) {
            return tm_tds[i];
        }
        i = i - 1;
    }
    return -1;
}

fs_set :: func(fn_name: string, var_name: string, td: i64) -> void {
    append(fs_fns, fn_name);
    append(fs_vars, var_name);
    append(fs_tds, td);
}

fs_get :: func(fn_name: string, var_name: string) -> i64 {
    var n: i64 = slice_len(fs_fns) as i64;
    var i: i64 = n - 1;
    while (i >= 0) {
        if (fs_fns[i] == fn_name && fs_vars[i] == var_name) {
            return fs_tds[i];
        }
        i = i - 1;
    }
    return -1;
}

sf_set :: func(st: string, fname: string, td: i64) -> void {
    append(sf_structs, st);
    append(sf_fields, fname);
    append(sf_tds, td);
}

sf_get :: func(st: string, fname: string) -> i64 {
    var n: i64 = slice_len(sf_structs) as i64;
    var i: i64 = n - 1;
    while (i >= 0) {
        if (sf_structs[i] == st && sf_fields[i] == fname) {
            return sf_tds[i];
        }
        i = i - 1;
    }
    return -1;
}

// ── scalarToC（复刻 emitter.ts scalarToC + emitType scalar map）─

scalar_to_c :: func(name: string) -> string {
    if (name == "u8") { return "uint8_t"; }
    if (name == "u16") { return "uint16_t"; }
    if (name == "u32") { return "uint32_t"; }
    if (name == "u64") { return "uint64_t"; }
    if (name == "i8") { return "int8_t"; }
    if (name == "i16") { return "int16_t"; }
    if (name == "i32") { return "int32_t"; }
    if (name == "i64") { return "int64_t"; }
    if (name == "f16") { return "_Float16"; }
    if (name == "f32") { return "float"; }
    if (name == "f64") { return "double"; }
    if (name == "bool") { return "bool"; }
    if (name == "void") { return "void"; }
    return name;
}

// ── emitType（复刻 emitter.ts emitType；tn = 类型节点索引）─────

emit_ctype :: func(tn: i64) -> string {
    if (tn < 0) {
        return "void";
    }
    var n: Node = nodes[tn];
    if (n.kind == "scalar") {
        if (n.sa == "string") { return "TStr"; }
        if (n.sa == "StringBuilder") { return "TSb*"; }
        return scalar_to_c(n.sa);
    }
    if (n.kind == "named") {
        return n.sa;
    }
    if (n.kind == "array") {
        return cat2(emit_ctype(n.na), "*");
    }
    if (n.kind == "slice") {
        return "TSlice";
    }
    if (n.kind == "map") {
        return "TMap*";
    }
    if (n.kind == "pointer") {
        return cat2(emit_ctype(n.na), "*");
    }
    if (n.kind == "optional") {
        return emit_ctype(n.na);
    }
    if (n.kind == "flag") {
        return n.sa;
    }
    if (n.kind == "flag_set") {
        return "void*";
    }
    if (n.kind == "variant") {
        return "void*";
    }
    return "void";
}

// ── resolveTypeDesc（复刻 emitter.ts resolveTypeDesc）──────────

resolve_type_desc :: func(tn: i64) -> i64 {
    if (tn < 0) {
        return td_mk("unknown");
    }
    var n: Node = nodes[tn];
    if (n.kind == "scalar") {
        if (n.sa == "string") { return td_mk("string"); }
        if (n.sa == "void") { return td_mk("void"); }
        if (n.sa == "StringBuilder") { return td_named_mk("named", "TSb*"); }
        return td_named_mk("scalar", n.sa);
    }
    if (n.kind == "slice") {
        return td_elem_mk("slice", resolve_type_desc(n.na));
    }
    if (n.kind == "map") {
        var mi: i64 = td_mk("map");
        var kt: i64 = resolve_type_desc(n.na);
        var vt: i64 = resolve_type_desc(n.nb);
        var t: TD = tds[mi];
        t.key = kt;
        t.val = vt;
        slice_set(tds, mi, t);
        return mi;
    }
    if (n.kind == "named") {
        return td_named_mk("named", n.sa);
    }
    return td_mk("unknown");
}

// ── descToC（复刻 emitter.ts descToC）──────────────────────────

desc_to_c :: func(td: i64) -> string {
    if (td < 0) {
        return "void*";
    }
    var t: TD = tds[td];
    if (t.cat == "string") { return "TStr"; }
    if (t.cat == "slice") { return "TSlice"; }
    if (t.cat == "map") { return "TMap*"; }
    if (t.cat == "scalar") {
        if (t.name == "") {
            return scalar_to_c("i64");
        }
        return scalar_to_c(t.name);
    }
    if (t.cat == "named") {
        if (t.name == "") {
            return "void*";
        }
        return t.name;
    }
    if (t.cat == "void") { return "void"; }
    return "void*";
}

// ── exprTypeDesc（复刻 emitter.ts exprTypeDesc）────────────────

expr_type_desc :: func(e: i64) -> i64 {
    if (e < 0) {
        return td_mk("unknown");
    }
    var n: Node = nodes[e];
    if (n.kind == "string") { return td_mk("string"); }
    if (n.kind == "int") { return td_named_mk("scalar", "i64"); }
    if (n.kind == "float") { return td_named_mk("scalar", "f64"); }
    if (n.kind == "bool") { return td_named_mk("scalar", "bool"); }
    if (n.kind == "ident") {
        if (em_in_fn) {
            var f: i64 = fs_get(em_cur_fn, n.sa);
            if (f >= 0) {
                return f;
            }
        }
        var g: i64 = tm_get(n.sa);
        if (g >= 0) {
            return g;
        }
        return td_mk("unknown");
    }
    if (n.kind == "paren") {
        return expr_type_desc(n.na);
    }
    if (n.kind == "cast") {
        return resolve_type_desc(n.nb);
    }
    if (n.kind == "index") {
        var od: i64 = expr_type_desc(n.na);
        var ot: TD = tds[od];
        if (ot.cat == "string") {
            return td_named_mk("scalar", "u8");
        }
        if (ot.cat == "slice") {
            if (ot.elem >= 0) {
                return ot.elem;
            }
            return td_mk("unknown");
        }
        if (ot.cat == "map") {
            if (ot.val >= 0) {
                return ot.val;
            }
            return td_mk("unknown");
        }
        return td_mk("unknown");
    }
    if (n.kind == "call") {
        var cal: Node = nodes[n.na];
        if (cal.kind == "ident") {
            var cn: string = cal.sa;
            if (cn == "file_read_all") { return td_mk("string"); }
            if (cn == "path_resolve") { return td_mk("string"); }
            if (cn == "str_len") { return td_named_mk("scalar", "u64"); }
            if (cn == "slice_len") { return td_named_mk("scalar", "u64"); }
            if (cn == "str_at") { return td_named_mk("scalar", "u8"); }
            if (cn == "args") {
                return td_elem_mk("slice", td_mk("string"));
            }
            if (cn == "file_write_all") { return td_named_mk("scalar", "bool"); }
            if (cn == "str_slice") { return td_mk("string"); }
            if (cn == "sb_to_str") { return td_mk("string"); }
            if (cn == "sb_new") { return td_named_mk("named", "TSb*"); }
            var rt: i64 = tm_get(cat2(cn, "()"));
            if (rt >= 0) {
                return rt;
            }
            return td_mk("unknown");
        }
        return td_mk("unknown");
    }
    if (n.kind == "binary") {
        var op: string = n.sa;
        if (op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=" || op == "&&" || op == "||") {
            return td_named_mk("scalar", "bool");
        }
        return expr_type_desc(n.na);
    }
    if (n.kind == "member") {
        var od2: i64 = expr_type_desc(n.na);
        var ot2: TD = tds[od2];
        if (ot2.cat == "named" && ot2.name != "") {
            var fd: i64 = sf_get(ot2.name, n.sa);
            if (fd >= 0) {
                return fd;
            }
        }
        return td_mk("unknown");
    }
    return td_mk("unknown");
}

// ── collectLocalTypes（复刻 emitter.ts collectLocalTypes）──────

collect_local_types :: func(head: i64) -> void {
    if (head < -1) {
        return;
    }
    var c: i64 = head;
    while (c >= 0) {
        var k: Child = kids[c];
        var n: Node = nodes[k.val];
        if (n.kind == "var_decl") {
            if (n.na >= 0) {
                fs_set(em_cur_fn, n.sa, resolve_type_desc(n.na));
            }
        }
        if (n.kind == "if") {
            collect_local_types(n.la);
            if (n.lb > -2) {
                collect_local_types(n.lb);
            }
        }
        if (n.kind == "while" || n.kind == "block") {
            collect_local_types(n.la);
        }
        if (n.kind == "for") {
            if (n.na >= 0) {
                var ini: Node = nodes[n.na];
                if (ini.kind == "var_decl") {
                    if (ini.na >= 0) {
                        fs_set(em_cur_fn, ini.sa, resolve_type_desc(ini.na));
                    }
                }
            }
            collect_local_types(n.la);
        }
        if (n.kind == "for_each") {
            var it: i64 = expr_type_desc(n.na);
            var itd: TD = tds[it];
            if (itd.cat == "slice" && itd.elem >= 0) {
                fs_set(em_cur_fn, n.sa, itd.elem);
            }
            collect_local_types(n.la);
        }
        if (n.kind == "switch") {
            var cc: i64 = n.la;
            while (cc >= 0) {
                var ck: Child = kids[cc];
                var cs: Node = nodes[ck.val];
                collect_local_types(cs.la);
                cc = ck.next;
            }
            if (n.lb > -2) {
                collect_local_types(n.lb);
            }
        }
        c = k.next;
    }
}

// ── buildTypeMap（复刻 emitter.ts buildTypeMap）────────────────

build_type_map :: func() -> void {
    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = decl_list[i];
        var dn: Node = nodes[d];
        if (dn.kind == "StructDecl") {
            var fc: i64 = dn.lb;
            while (fc >= 0) {
                var fk: Child = kids[fc];
                var f: Node = nodes[fk.val];
                if (f.na >= 0) {
                    sf_set(dn.sa, f.sa, resolve_type_desc(f.na));
                }
                fc = fk.next;
            }
        }
        if (dn.kind == "GlobalVarDecl" || dn.kind == "GlobalConstDecl") {
            if (dn.na >= 0) {
                tm_set(dn.sa, resolve_type_desc(dn.na));
            }
        }
        if (dn.kind == "FuncDecl") {
            if (dn.na >= 0) {
                tm_set(cat2(dn.sa, "()"), resolve_type_desc(dn.na));
            }
            em_cur_fn = dn.sa;
            em_in_fn = true;
            var pc: i64 = dn.lb;
            while (pc >= 0) {
                var pk: Child = kids[pc];
                var p: Node = nodes[pk.val];
                if (p.na >= 0) {
                    fs_set(dn.sa, p.sa, resolve_type_desc(p.na));
                }
                pc = pk.next;
            }
            if (dn.lc > -2) {
                collect_local_types(dn.lc);
            }
            em_in_fn = false;
            em_cur_fn = "";
        }
        i = i + 1;
    }
}

// ── C 字符串转义（复刻 emitter.ts escapeCString）───────────────

esc_c :: func(s: string) -> string {
    var sb: StringBuilder = sb_new();
    var i: u64 = 0;
    var n: u64 = str_len(s);
    while (i < n) {
        var c: u8 = s[i];
        if (c == 92) {
            sb_append_str(sb, "\\\\");
        } else {
        if (c == 34) {
            sb_append_str(sb, "\\\"");
        } else {
        if (c == 10) {
            sb_append_str(sb, "\\n");
        } else {
        if (c == 13) {
            sb_append_str(sb, "\\r");
        } else {
        if (c == 9) {
            sb_append_str(sb, "\\t");
        } else {
        if (c == 0) {
            sb_append_str(sb, "\\0");
        } else {
            sb_append_char(sb, c);
        }}}}}}
        i = i + 1;
    }
    return sb_to_str(sb);
}

// ── 缩进 ───────────────────────────────────────────────────────

mk_pad :: func(indent: i64) -> string {
    var sb: StringBuilder = sb_new();
    var i: i64 = 0;
    while (i < indent) {
        sb_append_str(sb, "    ");
        i = i + 1;
    }
    return sb_to_str(sb);
}

// ── emitExpr（复刻 emitter.ts emitExpr）────────────────────────

emit_expr :: func(e: i64) -> string {
    if (e < 0) {
        return "";
    }
    var n: Node = nodes[e];

    if (n.kind == "int") {
        if (n.ia == 16) {
            return n.sa;
        }
        if (n.ia == 2) {
            // value.replace(/^0b/i, "") 再加 0b 前缀
            var v: string = n.sa;
            var body: string = v;
            if (str_len(v) >= 2) {
                if (v[0] == 48 && (v[1] == 98 || v[1] == 66)) {
                    body = str_slice(v, 2, str_len(v));
                }
            }
            return cat2("0b", body);
        }
        return n.sa;
    }
    if (n.kind == "float") {
        return n.sa;
    }
    if (n.kind == "string") {
        return cat3("TSTR_LIT(\"", esc_c(n.sa), "\")");
    }
    if (n.kind == "bool") {
        if (n.ba) {
            return "true";
        }
        return "false";
    }
    if (n.kind == "null") {
        return "NULL";
    }
    if (n.kind == "ident") {
        return n.sa;
    }
    if (n.kind == "binary") {
        var op: string = n.sa;
        if (op == "==" || op == "!=") {
            var lt: i64 = expr_type_desc(n.na);
            var rt: i64 = expr_type_desc(n.nb);
            var ltc: TD = tds[lt];
            var rtc: TD = tds[rt];
            if (ltc.cat == "string" || rtc.cat == "string") {
                var cmp: string = cat5("t_str_eq(", emit_expr(n.na), ", ", emit_expr(n.nb), ")");
                if (op == "==") {
                    return cmp;
                }
                return cat3("(!", cmp, ")");
            }
        }
        return cat6("(", emit_expr(n.na), " ", op, " ", cat2(emit_expr(n.nb), ")"));
    }
    if (n.kind == "unary") {
        return cat4("(", n.sa, emit_expr(n.na), ")");
    }
    if (n.kind == "assign") {
        return cat6("(", emit_expr(n.na), " ", n.sa, " ", cat2(emit_expr(n.nb), ")"));
    }
    if (n.kind == "call") {
        var cal: Node = nodes[n.na];
        if (cal.kind == "ident") {
            var cn: string = cal.sa;
            // 收集参数
            var av: []string;
            var c: i64 = n.la;
            while (c >= 0) {
                var k: Child = kids[c];
                var one_arg: string = emit_expr(k.val);
                append(av, one_arg);
                c = k.next;
            }
            var argc: i64 = slice_len(av) as i64;
            if (cn == "str_len") { return cat3("t_str_len(", av[0], ")"); }
            if (cn == "str_at") { return cat5("t_str_byte_at(", av[0], ", ", av[1], ")"); }
            if (cn == "slice_len") { return cat3("t_slice_len(", av[0], ")"); }
            if (cn == "append") {
                return cat6("t_slice_append_sized(&", av[0], ", &", av[1], ", (int64_t)sizeof(", cat2(av[1], "))"));
            }
            if (cn == "slice_set") {
                return cat6("t_slice_set(", av[0], ", ", av[1], ", &", cat2(av[2], ")"));
            }
            if (cn == "file_read_all") { return cat3("t_file_read_all(t_cstr(", av[0], "))"); }
            if (cn == "path_resolve") { return cat3("t_path_resolve(t_cstr(", av[0], "))"); }
            if (cn == "file_write_all") {
                return cat6("t_file_write_all(t_cstr(", av[0], "), ", av[1], ")", "");
            }
            if (cn == "args") { return "t_args()"; }
            if (cn == "exit") { return cat3("t_exit(", av[0], ")"); }
            if (cn == "sys_run") { return cat3("sys_run(", av[0], ")"); }
            if (cn == "print") { return cat3("t_print(", av[0], ")"); }
            if (cn == "eprint") { return cat3("t_eprint(", av[0], ")"); }
            if (cn == "str_slice") {
                return cat6("t_str_slice(", av[0], ", ", av[1], ", ", cat2(av[2], ")"));
            }
            if (cn == "sb_new") { return "t_sb_new(t_arena_current())"; }
            if (cn == "sb_append_str") { return cat5("t_sb_append_str(", av[0], ", ", av[1], ")"); }
            if (cn == "sb_append_char") { return cat5("t_sb_append_char(", av[0], ", ", av[1], ")"); }
            if (cn == "sb_append_u64") { return cat5("t_sb_append_u64(", av[0], ", ", av[1], ")"); }
            if (cn == "sb_append_i64") { return cat5("t_sb_append_i64(", av[0], ", ", av[1], ")"); }
            if (cn == "sb_to_str") { return cat3("t_sb_to_str(", av[0], ")"); }
            if (cn == "sb_clear") { return cat3("t_sb_clear(", av[0], ")"); }
            // 普通调用
            var sb: StringBuilder = sb_new();
            sb_append_str(sb, cn);
            sb_append_char(sb, 40);
            var i: i64 = 0;
            while (i < argc) {
                if (i > 0) {
                    sb_append_str(sb, ", ");
                }
                sb_append_str(sb, av[i]);
                i = i + 1;
            }
            sb_append_char(sb, 41);
            return sb_to_str(sb);
        }
        // callee 非 ident
        var sb2: StringBuilder = sb_new();
        sb_append_str(sb2, emit_expr(n.na));
        sb_append_char(sb2, 40);
        var c2: i64 = n.la;
        var first: bool = true;
        while (c2 >= 0) {
            var k2: Child = kids[c2];
            if (!first) {
                sb_append_str(sb2, ", ");
            }
            sb_append_str(sb2, emit_expr(k2.val));
            first = false;
            c2 = k2.next;
        }
        sb_append_char(sb2, 41);
        return sb_to_str(sb2);
    }
    if (n.kind == "member") {
        return cat3(emit_expr(n.na), ".", n.sa);
    }
    if (n.kind == "index") {
        var od: i64 = expr_type_desc(n.na);
        var ot: TD = tds[od];
        var obj: string = emit_expr(n.na);
        var idx: string = emit_expr(n.nb);
        if (ot.cat == "string") {
            return cat5("t_str_byte_at(", obj, ", ", idx, ")");
        }
        if (ot.cat == "slice") {
            var ec: string = desc_to_c(ot.elem);
            return cat6("(*(", ec, "*)t_slice_at(", obj, ", ", cat2(idx, "))"));
        }
        return cat6("(", obj, "[", idx, "]", ")");
    }
    if (n.kind == "array_lit") {
        var sb3: StringBuilder = sb_new();
        sb_append_char(sb3, 123);
        var c3: i64 = n.la;
        var first3: bool = true;
        while (c3 >= 0) {
            var k3: Child = kids[c3];
            if (!first3) {
                sb_append_str(sb3, ", ");
            }
            sb_append_str(sb3, emit_expr(k3.val));
            first3 = false;
            c3 = k3.next;
        }
        sb_append_char(sb3, 125);
        return sb_to_str(sb3);
    }
    if (n.kind == "struct_lit") {
        var sb4: StringBuilder = sb_new();
        sb_append_char(sb4, 40);
        sb_append_str(sb4, n.sa);
        sb_append_str(sb4, "){");
        var c4: i64 = n.la;
        var first4: bool = true;
        while (c4 >= 0) {
            var k4: Child = kids[c4];
            var fv: Node = nodes[k4.val];
            if (!first4) {
                sb_append_str(sb4, ", ");
            }
            sb_append_char(sb4, 46);
            sb_append_str(sb4, fv.sa);
            sb_append_str(sb4, " = ");
            sb_append_str(sb4, emit_expr(fv.na));
            first4 = false;
            c4 = k4.next;
        }
        sb_append_char(sb4, 125);
        return sb_to_str(sb4);
    }
    if (n.kind == "cast") {
        return cat6("((", emit_ctype(n.nb), ")", emit_expr(n.na), ")", "");
    }
    if (n.kind == "paren") {
        return cat3("(", emit_expr(n.na), ")");
    }
    return "/* unsupported expr */";
}

// ── emitStmt（复刻 emitter.ts emitStmt；输出到 slines）─────────

emit_stmt :: func(sid: i64, indent: i64) -> void {
    var pad: string = mk_pad(indent);
    var n: Node = nodes[sid];

    if (n.kind == "expr") {
        spush(cat3(pad, emit_expr(n.na), ";"));
        return;
    }
    if (n.kind == "var_decl") {
        if (n.na >= 0) {
            var td: i64 = resolve_type_desc(n.na);
            var t: TD = tds[td];
            if (t.cat == "slice" && n.nb < 0) {
                spush(cat6(pad, "TSlice ", n.sa, " = t_slice_new(sizeof(", desc_to_c(t.elem), "));"));
                return;
            }
            if (t.cat == "string" && n.nb < 0) {
                spush(cat4(pad, "TStr ", n.sa, " = {0};"));
                return;
            }
            if (t.cat == "named" && n.nb < 0) {
                var cty: string = desc_to_c(td);
                if (ends_with_star(cty)) {
                    spush(cat6(pad, cty, " ", n.sa, " = NULL;", ""));
                } else {
                    spush(cat6(pad, cty, " ", n.sa, " = {0};", ""));
                }
                return;
            }
        }
        var ty: string = "auto";
        if (n.na >= 0) {
            ty = emit_ctype(n.na);
        }
        var init: string = "";
        if (n.nb >= 0) {
            init = cat2(" = ", emit_expr(n.nb));
        }
        spush(cat6(pad, ty, " ", n.sa, init, ";"));
        return;
    }
    if (n.kind == "for_each") {
        var itd: i64 = expr_type_desc(n.na);
        var it: TD = tds[itd];
        var elem_c: string = "void*";
        if (it.cat == "slice" && it.elem >= 0) {
            elem_c = desc_to_c(it.elem);
        }
        var iter: string = emit_expr(n.na);
        spush(cat6(pad, "for (int64_t _fe_i = 0; _fe_i < t_slice_len(", iter, "); _fe_i = _fe_i + 1) {", "", ""));
        spush(cat6(cat2(pad, "    "), elem_c, " ", n.sa, cat6(" = *((", elem_c, "*)t_slice_at(", iter, ", _fe_i));", ""), ""));
        var b: i64 = n.la;
        while (b >= 0) {
            var bk: Child = kids[b];
            emit_stmt(bk.val, indent + 2);
            b = bk.next;
        }
        spush(cat2(pad, "}"));
        return;
    }
    if (n.kind == "if") {
        spush(cat4(pad, "if (", emit_expr(n.na), ") {"));
        var tb: i64 = n.la;
        while (tb >= 0) {
            var tk: Child = kids[tb];
            emit_stmt(tk.val, indent + 1);
            tb = tk.next;
        }
        if (n.lb > -2) {
            spush(cat2(pad, "} else {"));
            var eb: i64 = n.lb;
            while (eb >= 0) {
                var ek: Child = kids[eb];
                emit_stmt(ek.val, indent + 1);
                eb = ek.next;
            }
        }
        spush(cat2(pad, "}"));
        return;
    }
    if (n.kind == "while") {
        spush(cat4(pad, "while (", emit_expr(n.na), ") {"));
        var wb: i64 = n.la;
        while (wb >= 0) {
            var wk: Child = kids[wb];
            emit_stmt(wk.val, indent + 1);
            wb = wk.next;
        }
        spush(cat2(pad, "}"));
        return;
    }
    if (n.kind == "for") {
        spush(cat2(pad, "for ("));
        if (n.na >= 0) {
            var ini: Node = nodes[n.na];
            if (ini.kind == "var_decl") {
                var ity: string = "int";
                if (ini.na >= 0) {
                    ity = emit_ctype(ini.na);
                }
                var iin: string = "";
                if (ini.nb >= 0) {
                    iin = cat2(" = ", emit_expr(ini.nb));
                }
                sappend_last(cat4(ity, " ", ini.sa, iin));
            }
            if (ini.kind == "expr") {
                sappend_last(emit_expr(ini.na));
            }
        }
        var cnd: string = "";
        if (n.nb >= 0) {
            cnd = emit_expr(n.nb);
        }
        var upd: string = "";
        if (n.nc >= 0) {
            upd = emit_expr(n.nc);
        }
        sappend_last(cat6("; ", cnd, "; ", upd, ") {", ""));
        var fb: i64 = n.la;
        while (fb >= 0) {
            var fk: Child = kids[fb];
            emit_stmt(fk.val, indent + 1);
            fb = fk.next;
        }
        spush(cat2(pad, "}"));
        return;
    }
    if (n.kind == "return") {
        if (n.na >= 0) {
            spush(cat4(pad, "return ", emit_expr(n.na), ";"));
        } else {
            spush(cat2(pad, "return;"));
        }
        return;
    }
    if (n.kind == "break") {
        spush(cat2(pad, "break;"));
        return;
    }
    if (n.kind == "continue") {
        spush(cat2(pad, "continue;"));
        return;
    }
    if (n.kind == "assignment") {
        spush(cat6(pad, emit_expr(n.na), " ", n.sa, " ", cat2(emit_expr(n.nb), ";")));
        return;
    }
    if (n.kind == "block") {
        spush(cat2(pad, "{"));
        var bb: i64 = n.la;
        while (bb >= 0) {
            var bk2: Child = kids[bb];
            emit_stmt(bk2.val, indent + 1);
            bb = bk2.next;
        }
        spush(cat2(pad, "}"));
        return;
    }
    if (n.kind == "switch") {
        spush(cat4(pad, "switch (", emit_expr(n.na), ") {"));
        var cc: i64 = n.la;
        while (cc >= 0) {
            var ck: Child = kids[cc];
            var cs: Node = nodes[ck.val];
            spush(cat4(pad, "case ", emit_expr(cs.na), ":"));
            var cb: i64 = cs.la;
            while (cb >= 0) {
                var cbk: Child = kids[cb];
                emit_stmt(cbk.val, indent + 2);
                cb = cbk.next;
            }
            spush(cat2(pad, "    break;"));
            cc = ck.next;
        }
        if (n.lb > -2) {
            spush(cat2(pad, "default:"));
            var db: i64 = n.lb;
            while (db >= 0) {
                var dk: Child = kids[db];
                emit_stmt(dk.val, indent + 2);
                db = dk.next;
            }
            spush(cat2(pad, "    break;"));
        }
        spush(cat2(pad, "}"));
        return;
    }
    // defer / comptime_block 等：TS emitStmt 无对应 case，不输出
}

// ═══════════════════════════════════════════════════════════════
// E3: emit_decl / derive / flag 布局 / emit 编排 / 驱动 main
// ═══════════════════════════════════════════════════════════════

// ── JS parseInt 复刻（enum autoValue 用；radix 16 允许 0x 前缀，
//    radix 2 遇 'b' 停在 "0" → 0，复刻 tc0 quirk）────────────────

js_parse_int :: func(s: string, radix: i64) -> i64 {
    var i: u64 = 0;
    var n: u64 = str_len(s);
    var neg: bool = false;
    if (i < n) {
        if (s[i] == 43 || s[i] == 45) {
            if (s[i] == 45) {
                neg = true;
            }
            i = i + 1;
        }
    }
    if (radix == 16 && i + 1 < n) {
        if (s[i] == 48 && (s[i + 1] == 120 || s[i + 1] == 88)) {
            i = i + 2;
        }
    }
    var val: i64 = 0;
    while (i < n) {
        var c: u8 = s[i];
        var d: i64 = -1;
        if (c >= 48 && c <= 57) {
            d = (c - 48) as i64;
        }
        if (c >= 97 && c <= 122) {
            d = (c - 87) as i64;
        }
        if (c >= 65 && c <= 90) {
            d = (c - 55) as i64;
        }
        if (d < 0 || d >= radix) {
            break;
        }
        val = val * radix + d;
        i = i + 1;
    }
    if (neg) {
        return 0 - val;
    }
    return val;
}

// ── JS (1 << bw) - 1 复刻（int32 回绕；flag slot maxValue）─────

js_max_val :: func(bw: i64) -> i64 {
    var sh: i64 = bw % 32;
    if (sh < 0) {
        sh = sh + 32;
    }
    var v: i64 = 1 << sh;
    if (sh == 31) {
        v = 0 - 2147483648;
    }
    return v - 1;
}

// ── Flag 槽布局池（复刻 bitfield.ts resolve 的布局部分，无诊断；
//    growing pool + base 偏移，同 fr_names 模式）──────────────────

var fl_names: []string;
var fl_starts: []i64;
var fl_lens: []i64;
var fl_ends: []i64;

fr_layout :: func(d: i64) -> i64 {
    var base: i64 = slice_len(fl_names) as i64;
    var n: Node = nodes[d];
    var auto_off: i64 = 0;
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var sl: Node = nodes[k.val];
        var start: i64 = auto_off;
        if (sl.bb) {
            start = sl.ib;
        }
        var end: i64 = start + sl.ia;
        append(fl_names, sl.sa);
        append(fl_starts, start);
        append(fl_lens, sl.ia);
        append(fl_ends, end);
        auto_off = end;
        c = k.next;
    }
    return base;
}

// ── derive traits / fields 收集（growing pool + base 偏移）─────

var dt_traits: []string;

collect_traits :: func(d: i64) -> i64 {
    var base: i64 = slice_len(dt_traits) as i64;
    var n: Node = nodes[d];
    var ai: i64 = ann_find(n.la, "derive");
    if (ai < 0) {
        return base;
    }
    var an: Node = nodes[ai];
    var c: i64 = an.la;
    while (c >= 0) {
        var k: Child = kids[c];
        var arg: Node = nodes[k.val];
        if (arg.kind == "ident") {
            append(dt_traits, arg.sa);
        }
        if (arg.kind == "list") {
            var c2: i64 = arg.la;
            while (c2 >= 0) {
                var k2: Child = kids[c2];
                var v: Node = nodes[k2.val];
                if (v.kind == "ident") {
                    append(dt_traits, v.sa);
                }
                c2 = k2.next;
            }
        }
        c = k.next;
    }
    return base;
}

var df_names: []string;
var df_anns: []i64;

collect_fields :: func(d: i64) -> i64 {
    var base: i64 = slice_len(df_names) as i64;
    var n: Node = nodes[d];
    if (n.kind == "VariantDecl") {
        return base;
    }
    if (n.kind == "StructDecl") {
        var c: i64 = n.lb;
        while (c >= 0) {
            var k: Child = kids[c];
            var f: Node = nodes[k.val];
            if (f.ia < 0) {
                append(df_names, f.sa);
                append(df_anns, f.la);
            }
            c = k.next;
        }
        return base;
    }
    if (n.kind == "EnumDecl" || n.kind == "UnionDecl") {
        var c2: i64 = n.lb;
        while (c2 >= 0) {
            var k2: Child = kids[c2];
            var f2: Node = nodes[k2.val];
            append(df_names, f2.sa);
            append(df_anns, f2.la);
            c2 = k2.next;
        }
    }
    return base;
}

// ── derive 代码生成（复刻 derive.ts；含 [object Object] 与
//    t 语法方法体等 tc0 bug，逐字节一致要求）───────────────────

gen_trait :: func(trait: string, name: string, fb: i64, fe: i64) -> string {
    var sb: StringBuilder = sb_new();

    if (trait == "ToString") {
        sb_append_str(sb, "// @derive(ToString) — auto-generated\nto_string :: func(self: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ") -> string {\n    return \"");
        sb_append_str(sb, name);
        sb_append_str(sb, " { ");
        var i: i64 = fb;
        while (i < fe) {
            if (i > fb) {
                sb_append_str(sb, ", ");
            }
            sb_append_str(sb, df_names[i]);
            sb_append_str(sb, "=$");
            sb_append_str(sb, df_names[i]);
            i = i + 1;
        }
        sb_append_str(sb, " }\";\n}");
        return sb_to_str(sb);
    }

    if (trait == "FromString") {
        sb_append_str(sb, "// @derive(FromString) — auto-generated\nfrom_string :: func(s: string) -> ");
        sb_append_str(sb, name);
        sb_append_str(sb, " {\n    var result: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ";\n    // parse fields: ");
        var i2: i64 = fb;
        while (i2 < fe) {
            if (i2 > fb) {
                sb_append_str(sb, ", ");
            }
            sb_append_str(sb, df_names[i2]);
            i2 = i2 + 1;
        }
        sb_append_str(sb, "\n    return result;\n}");
        return sb_to_str(sb);
    }

    if (trait == "Clone") {
        sb_append_str(sb, "// @derive(Clone) — auto-generated\nclone :: func(self: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ") -> ");
        sb_append_str(sb, name);
        sb_append_str(sb, " {\n    return ");
        sb_append_str(sb, name);
        sb_append_str(sb, " { ");
        var i3: i64 = fb;
        while (i3 < fe) {
            if (i3 > fb) {
                sb_append_str(sb, ", ");
            }
            sb_append_str(sb, df_names[i3]);
            sb_append_str(sb, ": self.");
            sb_append_str(sb, df_names[i3]);
            i3 = i3 + 1;
        }
        sb_append_str(sb, " };\n}");
        return sb_to_str(sb);
    }

    if (trait == "Copy") {
        sb_append_str(sb, "// @derive(Copy) — auto-generated\n// ");
        sb_append_str(sb, name);
        sb_append_str(sb, " is marked as Copy (bitwise copy on assignment)");
        return sb_to_str(sb);
    }

    if (trait == "DebugPrint") {
        sb_append_str(sb, "// @derive(DebugPrint) — auto-generated\ndebug_print :: func(self: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ") -> string {\n    return \"");
        sb_append_str(sb, name);
        sb_append_str(sb, "(");
        var i4: i64 = fb;
        while (i4 < fe) {
            if (i4 > fb) {
                sb_append_str(sb, ", ");
            }
            sb_append_str(sb, df_names[i4]);
            sb_append_str(sb, ": {self.");
            sb_append_str(sb, df_names[i4]);
            sb_append_str(sb, "}");
            i4 = i4 + 1;
        }
        sb_append_str(sb, ")\";\n}");
        return sb_to_str(sb);
    }

    if (trait == "BinarySerde") {
        sb_append_str(sb, "// @derive(BinarySerde) — auto-generated\nserialize :: func(self: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ") -> []u8 {\n");
        // serializeLines: filter 掉 @binary_skip，索引按过滤后数组计
        var cnt: i64 = 0;
        var i5: i64 = fb;
        while (i5 < fe) {
            if (ann_find(df_anns[i5], "binary_skip") < 0) {
                if (cnt > 0) {
                    sb_append_str(sb, "\n");
                }
                sb_append_str(sb, "    // offset ");
                var oa: i64 = ann_find(df_anns[i5], "binary_offset");
                var has_off: bool = false;
                if (oa >= 0) {
                    if (ann_first_arg(oa) >= 0) {
                        has_off = true;
                    }
                }
                if (has_off) {
                    // tc0 bug: 模板串里插入 arg 对象 → "[object Object]"
                    sb_append_str(sb, "[object Object]");
                } else {
                    sb_append_i64(sb, cnt * 4);
                }
                sb_append_str(sb, ": write self.");
                sb_append_str(sb, df_names[i5]);
                cnt = cnt + 1;
            }
            i5 = i5 + 1;
        }
        sb_append_str(sb, "\n    return buffer;\n}\n\ndeserialize :: func(data: []u8) -> ");
        sb_append_str(sb, name);
        sb_append_str(sb, " {\n    var result: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ";\n    // read fields from data at specified offsets\n    return result;\n}");
        return sb_to_str(sb);
    }

    if (trait == "Eq" || trait == "PartialEq") {
        sb_append_str(sb, "// @derive(Eq) — auto-generated\neq :: func(self: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ", other: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ") -> bool {\n    return ");
        if (fb == fe) {
            sb_append_str(sb, "true");
        } else {
            var i6: i64 = fb;
            while (i6 < fe) {
                if (i6 > fb) {
                    sb_append_str(sb, " && ");
                }
                sb_append_str(sb, "self.");
                sb_append_str(sb, df_names[i6]);
                sb_append_str(sb, " == other.");
                sb_append_str(sb, df_names[i6]);
                i6 = i6 + 1;
            }
        }
        sb_append_str(sb, ";\n}");
        return sb_to_str(sb);
    }

    if (trait == "Hash") {
        sb_append_str(sb, "// @derive(Hash) — auto-generated\nhash :: func(self: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ") -> u64 {\n    var hash: u64 = 0;\n");
        var i7: i64 = fb;
        while (i7 < fe) {
            if (i7 > fb) {
                sb_append_str(sb, "\n");
            }
            sb_append_str(sb, "    hash = hash_combine(hash, hash_of(self.");
            sb_append_str(sb, df_names[i7]);
            sb_append_str(sb, "));");
            i7 = i7 + 1;
        }
        sb_append_str(sb, "\n    return hash;\n}");
        return sb_to_str(sb);
    }

    return "";
}

process_derive :: func(d: i64) -> void {
    var n: Node = nodes[d];
    var tb: i64 = collect_traits(d);
    var te: i64 = slice_len(dt_traits) as i64;
    if (tb == te) {
        return;
    }
    var fb: i64 = collect_fields(d);
    var fe: i64 = slice_len(df_names) as i64;
    var i: i64 = tb;
    while (i < te) {
        var code: string = gen_trait(dt_traits[i], n.sa, fb, fe);
        if (code != "") {
            spush(code);
            spush("");
        }
        i = i + 1;
    }
}

// ── emitAttributes（复刻 emitter.ts emitAttributes）────────────

emit_attributes :: func(head: i64) -> string {
    var sb: StringBuilder = sb_new();
    var cnt: i64 = 0;
    var c: i64 = head;
    while (c >= 0) {
        var k: Child = kids[c];
        var a: Node = nodes[k.val];
        var s: string = "";
        var has: bool = false;
        if (a.sa == "inline") {
            s = "__attribute__((always_inline))";
            has = true;
        }
        if (a.sa == "no_inline") {
            s = "__attribute__((noinline))";
            has = true;
        }
        if (a.sa == "deprecated") {
            s = "__attribute__((deprecated))";
            var arg: i64 = ann_first_arg(k.val);
            if (arg >= 0) {
                var an: Node = nodes[arg];
                if (an.kind == "string") {
                    s = cat3("__attribute__((deprecated(\"", an.sa, "\")))");
                }
            }
            has = true;
        }
        if (a.sa == "must_use") {
            s = "__attribute__((warn_unused_result))";
            has = true;
        }
        if (a.sa == "export_symbol") {
            var arg2: i64 = ann_first_arg(k.val);
            if (arg2 >= 0) {
                var an2: Node = nodes[arg2];
                if (an2.kind == "string") {
                    s = "__attribute__((visibility(\"default\")))";
                    has = true;
                }
            }
        }
        if (has) {
            if (cnt > 0) {
                sb_append_str(sb, " ");
            }
            sb_append_str(sb, s);
            cnt = cnt + 1;
        }
        c = k.next;
    }
    return sb_to_str(sb);
}

// ── 各声明 emitter（复刻 emitter.ts emitDecl 系列）─────────────

emit_struct_decl :: func(d: i64) -> void {
    var n: Node = nodes[d];
    var attrs: string = emit_attributes(n.la);

    if (n.ba && n.has_sc) {
        hpush(cat3("// @bitpack(", n.sc, ") struct"));
        if (attrs != "") {
            hpush(attrs);
        }
        hpush(cat3("typedef struct ", n.sa, " {"));
        var c: i64 = n.lb;
        while (c >= 0) {
            var k: Child = kids[c];
            var f: Node = nodes[k.val];
            var fsb: StringBuilder = sb_new();
            sb_append_str(fsb, "    ");
            sb_append_str(fsb, scalar_to_c(n.sc));
            sb_append_str(fsb, " ");
            sb_append_str(fsb, f.sa);
            sb_append_str(fsb, " : ");
            sb_append_i64(fsb, f.ia);
            sb_append_str(fsb, ";");
            hpush(sb_to_str(fsb));
            c = k.next;
        }
        hpush(cat3("} ", n.sa, ";"));
    } else {
        var layout_attr: string = "";
        if (n.sb == "soa") {
            layout_attr = " // #soa layout";
        }
        if (attrs != "") {
            hpush(attrs);
        }
        hpush(cat4("typedef struct ", n.sa, " {", layout_attr));
        var c2: i64 = n.lb;
        while (c2 >= 0) {
            var k2: Child = kids[c2];
            var f2: Node = nodes[k2.val];
            if (f2.ia < 0) {
                var fattrs: string = emit_attributes(f2.la);
                if (fattrs != "") {
                    hpush(cat2("    ", fattrs));
                }
                hpush(cat6("    ", emit_ctype(f2.na), " ", f2.sa, ";", ""));
            }
            c2 = k2.next;
        }
        hpush(cat3("} ", n.sa, ";"));
    }

    process_derive(d);
}

emit_enum_decl :: func(d: i64) -> void {
    var n: Node = nodes[d];
    hpush(cat6("typedef ", scalar_to_c(n.sb), " ", n.sa, ";", ""));
    hpush("");
    var auto_val: i64 = 0;
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var v: Node = nodes[k.val];
        if (v.na >= 0) {
            hpush(cat6("#define ", n.sa, "_", v.sa, " ", emit_expr(v.na)));
            var vn: Node = nodes[v.na];
            if (vn.kind == "int") {
                auto_val = js_parse_int(vn.sa, vn.ia) + 1;
            }
        } else {
            hpush(cat6("#define ", n.sa, "_", v.sa, " ", i2s(auto_val)));
            auto_val = auto_val + 1;
        }
        c = k.next;
    }
}

emit_flag_decl :: func(d: i64) -> void {
    var n: Node = nodes[d];
    hpush(cat4("// flag[", n.sb, "] ", n.sa));
    hpush(cat6("typedef ", scalar_to_c(n.sb), " ", n.sa, ";", ""));
    hpush("");

    var base: i64 = fr_layout(d);
    var total: i64 = slice_len(fl_names) as i64;
    var i: i64 = base;
    while (i < total) {
        if (fl_lens[i] == 1) {
            var ssb: StringBuilder = sb_new();
            sb_append_str(ssb, "#define ");
            sb_append_str(ssb, n.sa);
            sb_append_str(ssb, "_");
            sb_append_str(ssb, fl_names[i]);
            sb_append_str(ssb, " (1u << ");
            sb_append_i64(ssb, fl_starts[i]);
            sb_append_str(ssb, ")");
            hpush(sb_to_str(ssb));
        } else {
            var csb: StringBuilder = sb_new();
            sb_append_str(csb, "// ");
            sb_append_str(csb, fl_names[i]);
            sb_append_str(csb, ": bits ");
            sb_append_i64(csb, fl_starts[i]);
            sb_append_str(csb, "-");
            sb_append_i64(csb, fl_ends[i] - 1);
            sb_append_str(csb, " (");
            sb_append_i64(csb, fl_lens[i]);
            sb_append_str(csb, " bits, max=");
            sb_append_i64(csb, js_max_val(fl_lens[i]));
            sb_append_str(csb, ")");
            hpush(sb_to_str(csb));
            var hsb: StringBuilder = sb_new();
            sb_append_str(hsb, "#define ");
            sb_append_str(hsb, n.sa);
            sb_append_str(hsb, "_");
            sb_append_str(hsb, fl_names[i]);
            sb_append_str(hsb, "_SHIFT ");
            sb_append_i64(hsb, fl_starts[i]);
            hpush(sb_to_str(hsb));
            var msb: StringBuilder = sb_new();
            sb_append_str(msb, "#define ");
            sb_append_str(msb, n.sa);
            sb_append_str(msb, "_");
            sb_append_str(msb, fl_names[i]);
            sb_append_str(msb, "_MASK (((1u << ");
            sb_append_i64(msb, fl_lens[i]);
            sb_append_str(msb, ") - 1) << ");
            sb_append_i64(msb, fl_starts[i]);
            sb_append_str(msb, ")");
            hpush(sb_to_str(msb));
        }
        i = i + 1;
    }
}

emit_flag_set_decl :: func(d: i64) -> void {
    var n: Node = nodes[d];
    hpush(cat3("// flag_set ", n.sa, " (dynamic length bitfield)"));
    hpush(cat3("typedef struct ", n.sa, " {"));
    hpush("    uint8_t* data;");
    hpush("    size_t bit_count;");
    hpush("    size_t byte_count;");
    hpush(cat3("} ", n.sa, ";"));
    hpush("");

    var base: i64 = fr_layout(d);
    var total: i64 = slice_len(fl_names) as i64;
    var i: i64 = base;
    while (i < total) {
        var csb: StringBuilder = sb_new();
        sb_append_str(csb, "// ");
        sb_append_str(csb, fl_names[i]);
        sb_append_str(csb, ": bits ");
        sb_append_i64(csb, fl_starts[i]);
        sb_append_str(csb, "-");
        sb_append_i64(csb, fl_ends[i] - 1);
        sb_append_str(csb, " (");
        sb_append_i64(csb, fl_lens[i]);
        sb_append_str(csb, " bits)");
        hpush(sb_to_str(csb));
        var hsb: StringBuilder = sb_new();
        sb_append_str(hsb, "#define ");
        sb_append_str(hsb, n.sa);
        sb_append_str(hsb, "_");
        sb_append_str(hsb, fl_names[i]);
        sb_append_str(hsb, "_SHIFT ");
        sb_append_i64(hsb, fl_starts[i]);
        hpush(sb_to_str(hsb));
        var msb: StringBuilder = sb_new();
        sb_append_str(msb, "#define ");
        sb_append_str(msb, n.sa);
        sb_append_str(msb, "_");
        sb_append_str(msb, fl_names[i]);
        sb_append_str(msb, "_MASK (((1u << ");
        sb_append_i64(msb, fl_lens[i]);
        sb_append_str(msb, ") - 1) << ");
        sb_append_i64(msb, fl_starts[i]);
        sb_append_str(msb, ")");
        hpush(sb_to_str(msb));
        i = i + 1;
    }
}

emit_union_decl :: func(d: i64) -> void {
    var n: Node = nodes[d];
    hpush(cat3("typedef union ", n.sa, " {"));
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var m: Node = nodes[k.val];
        hpush(cat6("    ", emit_ctype(m.na), " ", m.sa, ";", ""));
        c = k.next;
    }
    hpush(cat3("} ", n.sa, ";"));
}

// Variant：tagged union。发射 struct { uint32_t _tag; union { 载荷 _uN; } _u; } 及各 case 的
// static inline 构造器/判别器/取载荷（直接落头文件，函数体用 StringBuilder 拼 tag 整数）。
emit_variant_decl :: func(d: i64) -> void {
    var n: Node = nodes[d];
    var hsb: StringBuilder = sb_new();
    sb_append_str(hsb, "// variant ");
    sb_append_str(hsb, n.sa);
    hpush(sb_to_str(hsb));
    hpush(cat3("typedef struct ", n.sa, " {"));
    hpush("    uint32_t _tag;");
    hpush("    union {");
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var vc: Node = nodes[k.val];
        if (vc.na >= 0) {
            var us: StringBuilder = sb_new();
            sb_append_str(us, "        ");
            sb_append_str(us, emit_ctype(vc.na));
            sb_append_str(us, " _u");
            sb_append_i64(us, vc.ia);
            sb_append_str(us, ";");
            hpush(sb_to_str(us));
        }
        c = k.next;
    }
    hpush("    } _u;");
    hpush(cat3("} ", n.sa, ";"));
    hpush("");

    c = n.lb;
    while (c >= 0) {
        var k2: Child = kids[c];
        var vc2: Node = nodes[k2.val];
        var cname: string = vc2.sa;
        // 构造器
        var fsb: StringBuilder = sb_new();
        sb_append_str(fsb, "static inline ");
        sb_append_str(fsb, n.sa);
        sb_append_str(fsb, " ");
        sb_append_str(fsb, n.sa);
        sb_append_str(fsb, "_from_");
        sb_append_str(fsb, cname);
        if (vc2.na >= 0) {
            sb_append_str(fsb, "(");
            sb_append_str(fsb, emit_ctype(vc2.na));
            sb_append_str(fsb, " v) {");
        } else {
            sb_append_str(fsb, "(void) {");
        }
        hpush(sb_to_str(fsb));
        hpush(cat3("    ", n.sa, " _s;"));
        var tsb: StringBuilder = sb_new();
        sb_append_str(tsb, "    _s._tag = ");
        sb_append_i64(tsb, vc2.ia);
        sb_append_str(tsb, ";");
        hpush(sb_to_str(tsb));
        if (vc2.na >= 0) {
            var asb: StringBuilder = sb_new();
            sb_append_str(asb, "    _s._u._u");
            sb_append_i64(asb, vc2.ia);
            sb_append_str(asb, " = v;");
            hpush(sb_to_str(asb));
        }
        hpush("    return _s;");
        hpush("}");
        // 判别器
        var isb: StringBuilder = sb_new();
        sb_append_str(isb, "static inline bool ");
        sb_append_str(isb, n.sa);
        sb_append_str(isb, "_is_");
        sb_append_str(isb, cname);
        sb_append_str(isb, "(");
        sb_append_str(isb, n.sa);
        sb_append_str(isb, " self) {");
        hpush(sb_to_str(isb));
        var isb2: StringBuilder = sb_new();
        sb_append_str(isb2, "    return self._tag == ");
        sb_append_i64(isb2, vc2.ia);
        sb_append_str(isb2, ";");
        hpush(sb_to_str(isb2));
        hpush("}");
        // 取载荷
        if (vc2.na >= 0) {
            var asb2: StringBuilder = sb_new();
            sb_append_str(asb2, "static inline ");
            sb_append_str(asb2, emit_ctype(vc2.na));
            sb_append_str(asb2, " ");
            sb_append_str(asb2, n.sa);
            sb_append_str(asb2, "_as_");
            sb_append_str(asb2, cname);
            sb_append_str(asb2, "(");
            sb_append_str(asb2, n.sa);
            sb_append_str(asb2, " self) {");
            hpush(sb_to_str(asb2));
            var asb3: StringBuilder = sb_new();
            sb_append_str(asb3, "    return self._u._u");
            sb_append_i64(asb3, vc2.ia);
            sb_append_str(asb3, ";");
            hpush(sb_to_str(asb3));
            hpush("}");
        }
        c = k2.next;
    }
    hpush("");
}

emit_func_decl :: func(d: i64) -> void {
    var n: Node = nodes[d];
    var emit_name: string = n.sa;
    if (ann_find(n.la, "main") >= 0) {
        emit_name = cat2("t_entry_", n.sa);
        em_main_fn = emit_name;
        em_has_main = true;
    }
    var attrs: string = emit_attributes(n.la);

    var psb: StringBuilder = sb_new();
    var cnt: i64 = 0;
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var p: Node = nodes[k.val];
        if (cnt > 0) {
            sb_append_str(psb, ", ");
        }
        sb_append_str(psb, emit_ctype(p.na));
        sb_append_str(psb, " ");
        sb_append_str(psb, p.sa);
        cnt = cnt + 1;
        c = k.next;
    }
    var param_str: string = "void";
    if (cnt > 0) {
        param_str = sb_to_str(psb);
    }
    var ret: string = emit_ctype(n.na);

    if (n.ba) {
        if (attrs != "") {
            hpush(attrs);
        }
        hpush(cat6(ret, " ", emit_name, "(", param_str, ");"));
        return;
    }

    if (attrs != "") {
        hpush(attrs);
    }
    hpush(cat6(ret, " ", emit_name, "(", param_str, ");"));

    em_cur_fn = n.sa;
    em_in_fn = true;
    spush(cat6(ret, " ", emit_name, "(", param_str, ") {"));
    if (n.lc > -2) {
        var b: i64 = n.lc;
        while (b >= 0) {
            var bk: Child = kids[b];
            emit_stmt(bk.val, 1);
            b = bk.next;
        }
    }
    spush("}");
    em_in_fn = false;
    em_cur_fn = "";
    spush("");
}

emit_global_var :: func(d: i64) -> void {
    var n: Node = nodes[d];
    hpush(cat6("extern ", emit_ctype(n.na), " ", n.sa, ";", ""));
    var init: string = "";
    if (n.nb >= 0) {
        init = cat2(" = ", emit_expr(n.nb));
    }
    spush(cat6(emit_ctype(n.na), " ", n.sa, init, ";", ""));
}

emit_global_const :: func(d: i64) -> void {
    var n: Node = nodes[d];
    hpush(cat6("#define ", n.sa, " (", emit_expr(n.nb), ")", ""));
}

emit_decl :: func(d: i64) -> void {
    var n: Node = nodes[d];
    if (n.kind == "StructDecl") {
        emit_struct_decl(d);
        return;
    }
    if (n.kind == "EnumDecl") {
        emit_enum_decl(d);
        return;
    }
    if (n.kind == "FlagDecl") {
        emit_flag_decl(d);
        return;
    }
    if (n.kind == "FlagSetDecl") {
        emit_flag_set_decl(d);
        return;
    }
    if (n.kind == "UnionDecl") {
        emit_union_decl(d);
        return;
    }
    if (n.kind == "VariantDecl") {
        emit_variant_decl(d);
        return;
    }
    if (n.kind == "FuncDecl") {
        emit_func_decl(d);
        return;
    }
    if (n.kind == "GlobalVarDecl") {
        emit_global_var(d);
        return;
    }
    if (n.kind == "GlobalConstDecl") {
        emit_global_const(d);
        return;
    }
    if (n.kind == "ImportDecl") {
        hpush(cat3("#include \"", n.sb, "\""));
        return;
    }
    if (n.kind == "TypeAliasDecl") {
        hpush(cat6("typedef ", emit_ctype(n.na), " ", n.sa, ";", ""));
        return;
    }
}

// ── Flag 操作宏（复刻 emitFlagMacros）──────────────────────────

emit_flag_macros :: func() -> void {
    hpush("");
    hpush("// ── Flag operations (spec 6.4) ──");
    hpush("// 1-bit: use | & ^ operators, check with (mask & FLAG) != 0");
    hpush("// multi-bit: use flag_set_val/flag_get_val macros");
    hpush("");
    hpush("#define flag_set_val(flags, shift, mask, val) do { (flags) = ((flags) & ~(mask)) | (((val) << (shift)) & (mask)); } while(0)");
    hpush("#define flag_get_val(flags, shift, mask) (((flags) & (mask)) >> (shift))");
    hpush("");
}

// ── emit 编排（复刻 CEmitter.emit）─────────────────────────────

emit_unit :: func(mod: string) -> void {
    var guard: string = cat3("TC_", to_upper(mod), "_H");
    hpush(cat2("#ifndef ", guard));
    hpush(cat2("#define ", guard));
    hpush("");
    hpush("#include <stdint.h>");
    hpush("#include <stdbool.h>");
    hpush("#include <stddef.h>");
    hpush("#include \"t_runtime.h\"");
    hpush("");

    spush(cat3("#include \"", mod, ".h\""));
    spush("#include <stdio.h>");
    spush("#include <stdlib.h>");
    spush("#include <string.h>");
    spush("#include \"t_runtime.h\"");
    spush("");

    build_type_map();

    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        emit_decl(decl_list[i]);
        i = i + 1;
    }

    if (em_has_main) {
        spush("");
        spush("int main(int argc, char** argv) {");
        spush("    t_runtime_init(argc, argv);");
        spush("    t_runtime_set_arena(t_arena_new());");
        spush(cat3("    int32_t _exit_code = ", em_main_fn, "();"));
        spush("    t_runtime_done();");
        spush("    return (int)_exit_code;");
        spush("}");
        spush("");
    }

    emit_flag_macros();

    hpush("");
    hpush(cat2("#endif // ", guard));
}

// ── 输出行拼接（join("\n")，无末尾换行）────────────────────────

h_join :: func() -> string {
    var sb: StringBuilder = sb_new();
    var n: i64 = slice_len(hlines) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (i > 0) {
            sb_append_str(sb, "\n");
        }
        sb_append_str(sb, hlines[i]);
        i = i + 1;
    }
    return sb_to_str(sb);
}

s_join :: func() -> string {
    var sb: StringBuilder = sb_new();
    var n: i64 = slice_len(slines) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (i > 0) {
            sb_append_str(sb, "\n");
        }
        sb_append_str(sb, slines[i]);
        i = i + 1;
    }
    return sb_to_str(sb);
}

// ═══════════════════════════════════════════════════════════════
// M13: LLVM IR Emitter — .tc 直出 .ll，配合 clang 一步到可执行程序
//
// 值模型：
//   * 标量表达式 → SSA 值（bool 统一 i8，仅分支处转 i1）
//   * 聚合表达式（string/slice/struct/variant/union）→ 指向存储的 ptr
//   * 全部 alloca 集中在函数 entry 块（循环内不增长栈）
//   * 与 C runtime 的交互统一经 t_shim_ll.c 的 tll_* 指针化桥接；
//     模块内 t 函数间聚合按值传递（同模块 lowering 一致，无 ABI 风险）
// ═══════════════════════════════════════════════════════════════

var ll_head: []string;    // 模块头：类型定义 + declare
var ll_glob: []string;    // 字符串常量 + 全局变量定义
var ll_body: []string;    // 函数定义
var ll_fal: []string;     // 当前函数 entry 块 alloca 行
var ll_fb: []string;      // 当前函数体指令行
var ll_tmpc: i64;         // SSA 临时值计数（每函数重置）
var ll_lblc: i64;         // 标签计数（每函数重置）
var ll_scc: i64;          // scratch alloca 计数（每函数重置）
var ll_strc: i64;         // 字符串常量计数（模块级）
var ll_term: bool;        // 当前块是否已被终结指令封口
var ll_cur_blk: string;   // 当前基本块标签（phi 前驱用）
var ll_cur_ret: i64;      // 当前函数返回类型 td
var ll_has_main: bool;
var ll_main_fn: string;
var ll_last_sref: string; // 最近一次字符串常量的 @.sN 引用
var ll_last_slen: i64;

llph :: func(s: string) -> void { append(ll_head, s); }
llpg :: func(s: string) -> void { append(ll_glob, s); }
llpb :: func(s: string) -> void { append(ll_body, s); }
llfa :: func(s: string) -> void { append(ll_fal, s); }
llfb :: func(s: string) -> void { append(ll_fb, s); }

// ── 具名类型注册表 ─────────────────────────────────────────────

var llt_names: []string;
var llt_kinds: []string;   // struct | enum | flag | variant | union | alias
var llt_unders: []string;  // enum/flag 底层标量名
var llt_atd: []i64;        // alias 目标 td（其余 -1）

var llsf_st: []string;     // struct 字段：名/字段/序号/td
var llsf_fld: []string;
var llsf_idx: []i64;
var llsf_td: []i64;

var llec_e: []string;      // enum 常量：类型名/成员名/值
var llec_m: []string;
var llec_v: []i64;

var llfl_f: []string;      // flag 槽位：类型名/槽名/start/len
var llfl_s: []string;
var llfl_start: []i64;
var llfl_len: []i64;

var llv_v: []string;       // variant case：类型名/case 名/tag/载荷 td(-1 无)
var llv_c: []string;
var llv_tag: []i64;
var llv_ptd: []i64;

var llu_u: []string;       // union 成员：类型名/成员名/td
var llu_m: []string;
var llu_td: []i64;

var llfn_n: []string;      // 函数签名：名/返回 td/参数池起点/参数数/extern
var llfn_r: []i64;
var llfn_ps: []i64;
var llfn_pc: []i64;
var llfn_x: []bool;
var llfp_td: []i64;        // 参数 td 扁平池

var llgv_n: []string;      // 全局 var：名/td/init 节点(-1 无)
var llgv_td: []i64;
var llgv_init: []i64;

var llcn_n: []string;      // 全局 const：名/表达式节点（使用处内联展开）
var llcn_e: []i64;

var lla_n: []string;       // 当前函数已 alloca 的名字（去重）
var llbrk: []string;       // break/continue 目标栈（top = ll_loopd-1）
var llcnt: []string;
var ll_loopd: i64;

llt_find :: func(name: string) -> i64 {
    var n: i64 = slice_len(llt_names) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (llt_names[i] == name) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

llsf_find :: func(st: string, f: string) -> i64 {
    var n: i64 = slice_len(llsf_st) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (llsf_st[i] == st && llsf_fld[i] == f) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

llec_find :: func(e: string, m: string) -> i64 {
    var n: i64 = slice_len(llec_e) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (llec_e[i] == e && llec_m[i] == m) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

llfl_find :: func(f: string, s: string) -> i64 {
    var n: i64 = slice_len(llfl_f) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (llfl_f[i] == f && llfl_s[i] == s) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

llfn_find :: func(name: string) -> i64 {
    var n: i64 = slice_len(llfn_n) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (llfn_n[i] == name) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

llgv_find :: func(name: string) -> i64 {
    var n: i64 = slice_len(llgv_n) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (llgv_n[i] == name) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

llcn_find :: func(name: string) -> i64 {
    var n: i64 = slice_len(llcn_n) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (llcn_n[i] == name) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

lla_has :: func(name: string) -> bool {
    var n: i64 = slice_len(lla_n) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (lla_n[i] == name) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// variant 辅助函数名匹配：Name_from_Case / Name_is_Case / Name_as_Case
// 命中后设置 ll_vm_kind ("from"/"is"/"as") 与池下标 ll_vm_i
var ll_vm_kind: string;
var ll_vm_i: i64;

llv_match :: func(cn: string) -> bool {
    ll_vm_kind = "";
    ll_vm_i = -1;
    var n: i64 = slice_len(llv_v) as i64;
    var i: i64 = 0;
    while (i < n) {
        var f1: string = cat4(llv_v[i], "_from_", llv_c[i], "");
        if (cn == f1) {
            ll_vm_kind = "from";
            ll_vm_i = i;
            return true;
        }
        var f2: string = cat4(llv_v[i], "_is_", llv_c[i], "");
        if (cn == f2) {
            ll_vm_kind = "is";
            ll_vm_i = i;
            return true;
        }
        var f3: string = cat4(llv_v[i], "_as_", llv_c[i], "");
        if (cn == f3) {
            ll_vm_kind = "as";
            ll_vm_i = i;
            return true;
        }
        i = i + 1;
    }
    return false;
}

// ── 标量 → LLVM 类型 ───────────────────────────────────────────

scalar_to_ll :: func(name: string) -> string {
    if (name == "u8" || name == "i8" || name == "bool") { return "i8"; }
    if (name == "u16" || name == "i16") { return "i16"; }
    if (name == "u32" || name == "i32") { return "i32"; }
    if (name == "f32") { return "float"; }
    if (name == "f64") { return "double"; }
    return "i64";
}

ll_bits :: func(name: string) -> i64 {
    if (name == "u8" || name == "i8" || name == "bool") { return 8; }
    if (name == "u16" || name == "i16") { return 16; }
    if (name == "u32" || name == "i32" || name == "f32") { return 32; }
    return 64;
}

ll_signed :: func(name: string) -> bool {
    if (str_len(name) == 0) {
        return false;
    }
    return name[0] == 105 || name[0] == 102;
}

ll_isf :: func(name: string) -> bool {
    return name == "f32" || name == "f64";
}

// ── td → LLVM 类型 ─────────────────────────────────────────────

ll_named :: func(name: string) -> string {
    if (name == "TSb*") { return "ptr"; }
    var i: i64 = llt_find(name);
    if (i < 0) {
        return "i64";
    }
    var k: string = llt_kinds[i];
    if (k == "struct") { return cat2("%st.", name); }
    if (k == "variant") { return cat2("%vt.", name); }
    if (k == "union") { return cat2("%un.", name); }
    if (k == "enum" || k == "flag") { return scalar_to_ll(llt_unders[i]); }
    if (k == "alias") { return ll_td(llt_atd[i]); }
    return "i64";
}

ll_td :: func(td: i64) -> string {
    if (td < 0) {
        return "i64";
    }
    var t: TD = tds[td];
    if (t.cat == "string") { return "%TStr"; }
    if (t.cat == "slice") { return "%TSlice"; }
    if (t.cat == "map") { return "ptr"; }
    if (t.cat == "void") { return "void"; }
    if (t.cat == "scalar") {
        if (t.name == "") {
            return "i64";
        }
        return scalar_to_ll(t.name);
    }
    if (t.cat == "named") {
        if (t.name == "") {
            return "ptr";
        }
        return ll_named(t.name);
    }
    return "i64";
}

// td 是否聚合（值模型走 ptr）
ll_isagg :: func(td: i64) -> bool {
    if (td < 0) {
        return false;
    }
    var t: TD = tds[td];
    if (t.cat == "string" || t.cat == "slice") {
        return true;
    }
    if (t.cat == "named") {
        if (t.name == "TSb*") {
            return false;
        }
        var i: i64 = llt_find(t.name);
        if (i < 0) {
            return false;
        }
        var k: string = llt_kinds[i];
        if (k == "struct" || k == "variant" || k == "union") {
            return true;
        }
        if (k == "alias") {
            return ll_isagg(llt_atd[i]);
        }
        return false;
    }
    return false;
}

// td 的标量名（"" = 非标量）；enum/flag/alias 归一到底层标量
td_sname :: func(td: i64) -> string {
    if (td < 0) {
        return "i64";
    }
    var t: TD = tds[td];
    if (t.cat == "scalar") {
        if (t.name == "") {
            return "i64";
        }
        return t.name;
    }
    if (t.cat == "unknown") {
        return "i64";
    }
    if (t.cat == "named") {
        var i: i64 = llt_find(t.name);
        if (i < 0) {
            return "";
        }
        var k: string = llt_kinds[i];
        if (k == "enum" || k == "flag") {
            return llt_unders[i];
        }
        if (k == "alias") {
            return td_sname(llt_atd[i]);
        }
        return "";
    }
    return "";
}

ll_sizeof :: func(ty: string) -> string {
    return cat3("ptrtoint (ptr getelementptr (", ty, ", ptr null, i32 1) to i64)");
}

ll_zero :: func(ty: string) -> string {
    if (str_len(ty) > 0) {
        if (ty[0] == 37) {
            return "zeroinitializer";
        }
    }
    if (ty == "float" || ty == "double") {
        return "0.0";
    }
    if (ty == "ptr") {
        return "null";
    }
    return "0";
}

// ── 字符串常量 ─────────────────────────────────────────────────

esc_ll :: func(s: string) -> string {
    var sb: StringBuilder = sb_new();
    var i: u64 = 0;
    var n: u64 = str_len(s);
    while (i < n) {
        var c: u8 = s[i];
        if (c >= 32 && c <= 126 && c != 34 && c != 92) {
            sb_append_char(sb, c);
        } else {
            sb_append_char(sb, 92);
            sb_append_char(sb, hex_digit(c / 16));
            sb_append_char(sb, hex_digit(c % 16));
        }
        i = i + 1;
    }
    return sb_to_str(sb);
}

// 生成字符串常量对（[N x i8] + %TStr），返回 "@.tsN"（聚合 ptr 值）
ll_strlit :: func(s: string) -> string {
    var idx: i64 = ll_strc;
    ll_strc = ll_strc + 1;
    var sn: string = cat2("@.s", i2s(idx));
    var tn: string = cat2("@.ts", i2s(idx));
    var L: i64 = str_len(s) as i64;
    if (L == 0) {
        llpg(cat2(sn, " = private unnamed_addr constant [1 x i8] zeroinitializer"));
    } else {
        var line: StringBuilder = sb_new();
        sb_append_str(line, sn);
        sb_append_str(line, " = private unnamed_addr constant [");
        sb_append_i64(line, L);
        sb_append_str(line, " x i8] c\"");
        sb_append_str(line, esc_ll(s));
        sb_append_str(line, "\"");
        llpg(sb_to_str(line));
    }
    var l2: StringBuilder = sb_new();
    sb_append_str(l2, tn);
    sb_append_str(l2, " = private unnamed_addr constant %TStr { ptr ");
    sb_append_str(l2, sn);
    sb_append_str(l2, ", i64 ");
    sb_append_i64(l2, L);
    sb_append_str(l2, " }");
    llpg(sb_to_str(l2));
    ll_last_sref = sn;
    ll_last_slen = L;
    return tn;
}

// ── 临时值 / 标签 / scratch ────────────────────────────────────

ll_tmp :: func() -> string {
    var v: i64 = ll_tmpc;
    ll_tmpc = v + 1;
    return cat2("%t", i2s(v));
}

ll_lbl :: func(p: string) -> string {
    var v: i64 = ll_lblc;
    ll_lblc = v + 1;
    return cat2(p, i2s(v));
}

ll_label :: func(name: string) -> void {
    llfb(cat2(name, ":"));
    ll_cur_blk = name;
    ll_term = false;
}

ll_open :: func() -> void {
    if (ll_term) {
        var L: string = ll_lbl("dead");
        ll_label(L);
    }
}

// 每个调用点一个 scratch alloca（置于 entry，循环安全）
ll_scratch :: func(ty: string) -> string {
    var v: i64 = ll_scc;
    ll_scc = v + 1;
    var name: string = cat2("%s", i2s(v));
    llfa(cat4("  ", name, " = alloca ", ty));
    return name;
}

// ── 注册表构建 ─────────────────────────────────────────────────

ll_build_reg :: func() -> void {
    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = decl_list[i];
        var dn: Node = nodes[d];
        if (dn.kind == "StructDecl") {
            append(llt_names, dn.sa);
            append(llt_kinds, "struct");
            append(llt_unders, "");
            var neg1: i64 = -1;
            append(llt_atd, neg1);
            var fi: i64 = 0;
            var c: i64 = dn.lb;
            while (c >= 0) {
                var k: Child = kids[c];
                var f: Node = nodes[k.val];
                if (f.ia < 0) {
                    append(llsf_st, dn.sa);
                    append(llsf_fld, f.sa);
                    append(llsf_idx, fi);
                    var ftd: i64 = resolve_type_desc(f.na);
                    append(llsf_td, ftd);
                    fi = fi + 1;
                }
                c = k.next;
            }
        }
        if (dn.kind == "EnumDecl") {
            append(llt_names, dn.sa);
            append(llt_kinds, "enum");
            append(llt_unders, dn.sb);
            var neg2: i64 = -1;
            append(llt_atd, neg2);
            var auto_val: i64 = 0;
            var c2: i64 = dn.lb;
            while (c2 >= 0) {
                var k2: Child = kids[c2];
                var v: Node = nodes[k2.val];
                if (v.na >= 0) {
                    var vn: Node = nodes[v.na];
                    if (vn.kind == "int") {
                        var r: i64 = vn.ia;
                        if (r < 2) {
                            r = 10;
                        }
                        var pv: i64 = js_parse_int(vn.sa, r);
                        append(llec_e, dn.sa);
                        append(llec_m, v.sa);
                        append(llec_v, pv);
                        auto_val = pv + 1;
                    }
                } else {
                    append(llec_e, dn.sa);
                    append(llec_m, v.sa);
                    append(llec_v, auto_val);
                    auto_val = auto_val + 1;
                }
                c2 = k2.next;
            }
        }
        if (dn.kind == "FlagDecl") {
            append(llt_names, dn.sa);
            append(llt_kinds, "flag");
            append(llt_unders, dn.sb);
            var neg3: i64 = -1;
            append(llt_atd, neg3);
            var auto_off: i64 = 0;
            var c3: i64 = dn.lb;
            while (c3 >= 0) {
                var k3: Child = kids[c3];
                var sl: Node = nodes[k3.val];
                var start: i64 = auto_off;
                if (sl.bb) {
                    start = sl.ib;
                }
                append(llfl_f, dn.sa);
                append(llfl_s, sl.sa);
                append(llfl_start, start);
                append(llfl_len, sl.ia);
                auto_off = start + sl.ia;
                c3 = k3.next;
            }
        }
        if (dn.kind == "VariantDecl") {
            append(llt_names, dn.sa);
            append(llt_kinds, "variant");
            append(llt_unders, "");
            var neg4: i64 = -1;
            append(llt_atd, neg4);
            var c4: i64 = dn.lb;
            while (c4 >= 0) {
                var k4: Child = kids[c4];
                var vc: Node = nodes[k4.val];
                append(llv_v, dn.sa);
                append(llv_c, vc.sa);
                append(llv_tag, vc.ia);
                var ptd: i64 = -1;
                if (vc.na >= 0) {
                    ptd = resolve_type_desc(vc.na);
                }
                append(llv_ptd, ptd);
                c4 = k4.next;
            }
        }
        if (dn.kind == "UnionDecl") {
            append(llt_names, dn.sa);
            append(llt_kinds, "union");
            append(llt_unders, "");
            var neg5: i64 = -1;
            append(llt_atd, neg5);
            var c5: i64 = dn.lb;
            while (c5 >= 0) {
                var k5: Child = kids[c5];
                var m: Node = nodes[k5.val];
                append(llu_u, dn.sa);
                append(llu_m, m.sa);
                var mtd: i64 = resolve_type_desc(m.na);
                append(llu_td, mtd);
                c5 = k5.next;
            }
        }
        if (dn.kind == "TypeAliasDecl") {
            append(llt_names, dn.sa);
            append(llt_kinds, "alias");
            append(llt_unders, "");
            var atd: i64 = resolve_type_desc(dn.na);
            append(llt_atd, atd);
        }
        if (dn.kind == "FuncDecl") {
            append(llfn_n, dn.sa);
            var rtd: i64 = resolve_type_desc(dn.na);
            append(llfn_r, rtd);
            var ps: i64 = slice_len(llfp_td) as i64;
            append(llfn_ps, ps);
            var pc: i64 = 0;
            var c6: i64 = dn.lb;
            while (c6 >= 0) {
                var k6: Child = kids[c6];
                var p: Node = nodes[k6.val];
                var ptd2: i64 = resolve_type_desc(p.na);
                append(llfp_td, ptd2);
                pc = pc + 1;
                c6 = k6.next;
            }
            append(llfn_pc, pc);
            append(llfn_x, dn.ba);
        }
        if (dn.kind == "GlobalVarDecl") {
            append(llgv_n, dn.sa);
            var gtd: i64 = resolve_type_desc(dn.na);
            append(llgv_td, gtd);
            append(llgv_init, dn.nb);
        }
        if (dn.kind == "GlobalConstDecl") {
            append(llcn_n, dn.sa);
            append(llcn_e, dn.nb);
        }
        i = i + 1;
    }
}

// ── 表达式类型（expr_type_desc 的 LLVM 补丁包装）───────────────

ll_etd :: func(e: i64) -> i64 {
    if (e < 0) {
        return td_mk("unknown");
    }
    var n: Node = nodes[e];
    if (n.kind == "unary") {
        if (n.sa == "!") {
            return td_named_mk("scalar", "bool");
        }
        return ll_etd(n.na);
    }
    if (n.kind == "struct_lit") {
        return td_named_mk("named", n.sa);
    }
    if (n.kind == "member") {
        var ob: Node = nodes[n.na];
        if (ob.kind == "ident") {
            var ti: i64 = llt_find(ob.sa);
            if (ti >= 0) {
                if (llt_kinds[ti] == "enum") {
                    return td_named_mk("scalar", llt_unders[ti]);
                }
            }
        }
        var od: i64 = expr_type_desc(e);
        var ot: TD = tds[od];
        if (ot.cat != "unknown") {
            return od;
        }
        // union 成员
        var obd: i64 = ll_etd(n.na);
        var obt: TD = tds[obd];
        if (obt.cat == "named") {
            var ui: i64 = llt_find(obt.name);
            if (ui >= 0) {
                if (llt_kinds[ui] == "union") {
                    var un: i64 = slice_len(llu_u) as i64;
                    var uj: i64 = 0;
                    while (uj < un) {
                        if (llu_u[uj] == obt.name && llu_m[uj] == n.sa) {
                            return llu_td[uj];
                        }
                        uj = uj + 1;
                    }
                }
            }
        }
        return od;
    }
    if (n.kind == "paren") {
        return ll_etd(n.na);
    }
    if (n.kind == "binary") {
        var bop9: string = n.sa;
        if (bop9 == "==" || bop9 == "!=" || bop9 == "<" || bop9 == ">") {
            return td_named_mk("scalar", "bool");
        }
        if (bop9 == "<=" || bop9 == ">=" || bop9 == "&&" || bop9 == "||") {
            return td_named_mk("scalar", "bool");
        }
        return ll_bin_td(e);
    }
    if (n.kind == "call") {
        var cal: Node = nodes[n.na];
        if (cal.kind == "ident") {
            var cn: string = cal.sa;
            if (cn == "flag_get") {
                return td_named_mk("scalar", "u32");
            }
            if (cn == "sys_run") {
                return td_named_mk("scalar", "i32");
            }
            if (llv_match(cn)) {
                if (ll_vm_kind == "from") {
                    return td_named_mk("named", llv_v[ll_vm_i]);
                }
                if (ll_vm_kind == "is") {
                    return td_named_mk("scalar", "bool");
                }
                return llv_ptd[ll_vm_i];
            }
        }
        return expr_type_desc(e);
    }
    return expr_type_desc(e);
}

// 二元运算的统一操作数类型：字面量让位于有类型的一侧
ll_bin_td :: func(e: i64) -> i64 {
    var n: Node = nodes[e];
    var ln: Node = nodes[n.na];
    var rn: Node = nodes[n.nb];
    var llit: bool = ln.kind == "int" || ln.kind == "float";
    var rlit: bool = rn.kind == "int" || rn.kind == "float";
    if (llit && rlit == false) {
        return ll_etd(n.nb);
    }
    return ll_etd(n.na);
}

// ── 数值转换 ───────────────────────────────────────────────────

ll_cast_v :: func(v: string, ftd: i64, ttd: i64) -> string {
    var fs: string = td_sname(ftd);
    var ts: string = td_sname(ttd);
    if (fs == "" || ts == "") {
        return v;
    }
    if (str_len(v) == 0) {
        return v;
    }
    if (v[0] != 37) {
        return v;    // 常量文本随目标类型自适应
    }
    var fb2: i64 = ll_bits(fs);
    var tb: i64 = ll_bits(ts);
    var ff: bool = ll_isf(fs);
    var tf: bool = ll_isf(ts);
    var fty: string = scalar_to_ll(fs);
    var tty: string = scalar_to_ll(ts);
    if (ff && tf) {
        if (fb2 == tb) {
            return v;
        }
        var t1: string = ll_tmp();
        if (fb2 < tb) {
            llfb(cat6("  ", t1, " = fpext ", fty, " ", cat4(v, " to ", tty, "")));
        } else {
            llfb(cat6("  ", t1, " = fptrunc ", fty, " ", cat4(v, " to ", tty, "")));
        }
        return t1;
    }
    if (ff && tf == false) {
        var t2: string = ll_tmp();
        if (ll_signed(ts)) {
            llfb(cat6("  ", t2, " = fptosi ", fty, " ", cat4(v, " to ", tty, "")));
        } else {
            llfb(cat6("  ", t2, " = fptoui ", fty, " ", cat4(v, " to ", tty, "")));
        }
        return t2;
    }
    if (ff == false && tf) {
        var t3: string = ll_tmp();
        if (ll_signed(fs)) {
            llfb(cat6("  ", t3, " = sitofp ", fty, " ", cat4(v, " to ", tty, "")));
        } else {
            llfb(cat6("  ", t3, " = uitofp ", fty, " ", cat4(v, " to ", tty, "")));
        }
        return t3;
    }
    if (ts == "bool") {
        if (fs == "bool") {
            return v;
        }
        var t4: string = ll_tmp();
        llfb(cat6("  ", t4, " = icmp ne ", fty, " ", cat3(v, ", ", "0")));
        var t5: string = ll_tmp();
        llfb(cat6("  ", t5, " = zext i1 ", t4, " to i8", ""));
        return t5;
    }
    if (fb2 == tb) {
        return v;
    }
    var t6: string = ll_tmp();
    if (fb2 < tb) {
        if (ll_signed(fs)) {
            llfb(cat6("  ", t6, " = sext ", fty, " ", cat4(v, " to ", tty, "")));
        } else {
            llfb(cat6("  ", t6, " = zext ", fty, " ", cat4(v, " to ", tty, "")));
        }
    } else {
        llfb(cat6("  ", t6, " = trunc ", fty, " ", cat4(v, " to ", tty, "")));
    }
    return t6;
}

// i8 bool 值 → i1（分支条件）
ll_to_i1 :: func(v: string) -> string {
    if (v == "1") {
        return "true";
    }
    if (v == "0") {
        return "false";
    }
    var t: string = ll_tmp();
    llfb(cat4("  ", t, " = icmp ne i8 ", cat2(v, ", 0")));
    return t;
}

// i1 → i8
ll_b8 :: func(v1: string) -> string {
    var t: string = ll_tmp();
    llfb(cat4("  ", t, " = zext i1 ", cat2(v1, " to i8")));
    return t;
}

// 从 ptr 装载
ll_load :: func(ty: string, p: string) -> string {
    var t: string = ll_tmp();
    llfb(cat6("  ", t, " = load ", ty, ", ptr ", p));
    return t;
}

// 聚合复制：src ptr → dst ptr（load/store 按值搬运）
ll_copy :: func(ty: string, src: string, dst: string) -> void {
    var t: string = ll_load(ty, src);
    llfb(cat6("  store ", ty, " ", t, ", ptr ", dst));
}

// ── 左值地址 ───────────────────────────────────────────────────

ll_addr :: func(e: i64) -> string {
    var n: Node = nodes[e];
    if (n.kind == "paren") {
        return ll_addr(n.na);
    }
    if (n.kind == "ident") {
        if (em_in_fn) {
            var f: i64 = fs_get(em_cur_fn, n.sa);
            if (f >= 0) {
                return cat2("%v.", n.sa);
            }
        }
        var g: i64 = llgv_find(n.sa);
        if (g >= 0) {
            return cat2("@", n.sa);
        }
        return "null";
    }
    if (n.kind == "member") {
        var obd: i64 = ll_etd(n.na);
        var obt: TD = tds[obd];
        var op: string = emit_lle(n.na);
        if (obt.cat == "named") {
            var ti: i64 = llt_find(obt.name);
            if (ti >= 0) {
                if (llt_kinds[ti] == "struct") {
                    var fi: i64 = llsf_find(obt.name, n.sa);
                    if (fi >= 0) {
                        var t: string = ll_tmp();
                        var line: StringBuilder = sb_new();
                        sb_append_str(line, "  ");
                        sb_append_str(line, t);
                        sb_append_str(line, " = getelementptr inbounds %st.");
                        sb_append_str(line, obt.name);
                        sb_append_str(line, ", ptr ");
                        sb_append_str(line, op);
                        sb_append_str(line, ", i32 0, i32 ");
                        sb_append_i64(line, llsf_idx[fi]);
                        llfb(sb_to_str(line));
                        return t;
                    }
                }
                if (llt_kinds[ti] == "union") {
                    return op;    // 所有成员共址 offset 0
                }
            }
        }
        return "null";
    }
    if (n.kind == "index") {
        var od: i64 = ll_etd(n.na);
        var ot: TD = tds[od];
        if (ot.cat == "slice") {
            var sp: string = emit_lle(n.na);
            var iv: string = emit_lle(n.nb);
            var t2: string = ll_tmp();
            llfb(cat6("  ", t2, " = call ptr @tll_slice_at(ptr ", sp, ", i64 ", cat2(iv, ")")));
            return t2;
        }
        return "null";
    }
    return "null";
}

// ── 表达式发射 ─────────────────────────────────────────────────

emit_lle :: func(e: i64) -> string {
    if (e < 0) {
        return "0";
    }
    var n: Node = nodes[e];

    if (n.kind == "int") {
        var r: i64 = n.ia;
        if (r < 2) {
            r = 10;
        }
        return i2s(js_parse_int(n.sa, r));
    }
    if (n.kind == "float") {
        // 确保带小数点（LLVM 浮点常量语法）
        var has_dot: bool = false;
        var i: u64 = 0;
        var L: u64 = str_len(n.sa);
        while (i < L) {
            if (n.sa[i] == 46 || n.sa[i] == 101 || n.sa[i] == 69) {
                has_dot = true;
            }
            i = i + 1;
        }
        if (has_dot) {
            return n.sa;
        }
        return cat2(n.sa, ".0");
    }
    if (n.kind == "string") {
        return ll_strlit(n.sa);
    }
    if (n.kind == "bool") {
        if (n.ba) {
            return "1";
        }
        return "0";
    }
    if (n.kind == "null") {
        return "null";
    }
    if (n.kind == "ident") {
        if (em_in_fn) {
            var f: i64 = fs_get(em_cur_fn, n.sa);
            if (f >= 0) {
                if (ll_isagg(f)) {
                    return cat2("%v.", n.sa);
                }
                return ll_load(ll_td(f), cat2("%v.", n.sa));
            }
        }
        var g: i64 = llgv_find(n.sa);
        if (g >= 0) {
            var gtd: i64 = llgv_td[g];
            if (ll_isagg(gtd)) {
                return cat2("@", n.sa);
            }
            return ll_load(ll_td(gtd), cat2("@", n.sa));
        }
        var ci: i64 = llcn_find(n.sa);
        if (ci >= 0) {
            return emit_lle(llcn_e[ci]);
        }
        return "0";
    }
    if (n.kind == "paren") {
        return emit_lle(n.na);
    }
    if (n.kind == "binary") {
        return ll_binary(e);
    }
    if (n.kind == "unary") {
        return ll_unary(e);
    }
    if (n.kind == "assign") {
        var v: string = emit_lle(n.nb);
        var ltd: i64 = ll_etd(n.na);
        var ad: string = ll_addr(n.na);
        if (ll_isagg(ltd)) {
            ll_copy(ll_td(ltd), v, ad);
        } else {
            var cv: string = ll_cast_v(v, ll_etd(n.nb), ltd);
            llfb(cat6("  store ", ll_td(ltd), " ", cv, ", ptr ", ad));
        }
        return v;
    }
    if (n.kind == "call") {
        return ll_call(e);
    }
    if (n.kind == "member") {
        var ob: Node = nodes[n.na];
        if (ob.kind == "ident") {
            var ti: i64 = llt_find(ob.sa);
            if (ti >= 0) {
                if (llt_kinds[ti] == "enum") {
                    var ei: i64 = llec_find(ob.sa, n.sa);
                    if (ei >= 0) {
                        return i2s(llec_v[ei]);
                    }
                    return "0";
                }
            }
        }
        var mtd: i64 = ll_etd(e);
        var p: string = ll_addr(e);
        if (ll_isagg(mtd)) {
            return p;
        }
        return ll_load(ll_td(mtd), p);
    }
    if (n.kind == "index") {
        var od: i64 = ll_etd(n.na);
        var ot: TD = tds[od];
        if (ot.cat == "string") {
            var sp: string = emit_lle(n.na);
            var iv: string = emit_lle(n.nb);
            var iv2: string = ll_widen_idx(iv, n.nb);
            var t: string = ll_tmp();
            llfb(cat6("  ", t, " = call i64 @tll_str_at(ptr ", sp, ", i64 ", cat2(iv2, ")")));
            var t2: string = ll_tmp();
            llfb(cat4("  ", t2, " = trunc i64 ", cat2(t, " to i8")));
            return t2;
        }
        if (ot.cat == "slice") {
            var sp2: string = emit_lle(n.na);
            var iv3: string = emit_lle(n.nb);
            var iv4: string = ll_widen_idx(iv3, n.nb);
            var t3: string = ll_tmp();
            llfb(cat6("  ", t3, " = call ptr @tll_slice_at(ptr ", sp2, ", i64 ", cat2(iv4, ")")));
            if (ot.elem >= 0) {
                if (ll_isagg(ot.elem)) {
                    return t3;
                }
                return ll_load(ll_td(ot.elem), t3);
            }
            return ll_load("i64", t3);
        }
        return "0";
    }
    if (n.kind == "struct_lit") {
        var sty: string = cat2("%st.", n.sa);
        var s: string = ll_scratch(sty);
        llfb(cat4("  store ", sty, " zeroinitializer, ptr ", s));
        var c: i64 = n.la;
        while (c >= 0) {
            var k: Child = kids[c];
            var fv: Node = nodes[k.val];
            var fi2: i64 = llsf_find(n.sa, fv.sa);
            if (fi2 >= 0) {
                var fp: string = ll_tmp();
                var line: StringBuilder = sb_new();
                sb_append_str(line, "  ");
                sb_append_str(line, fp);
                sb_append_str(line, " = getelementptr inbounds ");
                sb_append_str(line, sty);
                sb_append_str(line, ", ptr ");
                sb_append_str(line, s);
                sb_append_str(line, ", i32 0, i32 ");
                sb_append_i64(line, llsf_idx[fi2]);
                llfb(sb_to_str(line));
                var ftd: i64 = llsf_td[fi2];
                var fvv: string = emit_lle(fv.na);
                if (ll_isagg(ftd)) {
                    ll_copy(ll_td(ftd), fvv, fp);
                } else {
                    var cv2: string = ll_cast_v(fvv, ll_etd(fv.na), ftd);
                    llfb(cat6("  store ", ll_td(ftd), " ", cv2, ", ptr ", fp));
                }
            }
            c = k.next;
        }
        return s;
    }
    if (n.kind == "cast") {
        var v2: string = emit_lle(n.na);
        var ttd: i64 = resolve_type_desc(n.nb);
        return ll_cast_v(v2, ll_etd(n.na), ttd);
    }
    llfb("  ; UNSUPPORTED expr");
    return "0";
}

// 索引值统一拓宽为 i64（str_at/slice_at 的下标参数）
ll_widen_idx :: func(v: string, e: i64) -> string {
    var td: i64 = ll_etd(e);
    var i64td: i64 = td_named_mk("scalar", "i64");
    return ll_cast_v(v, td, i64td);
}

// ── 二元 / 一元 ────────────────────────────────────────────────

ll_binary :: func(e: i64) -> string {
    var n: Node = nodes[e];
    var op: string = n.sa;

    if (op == "&&" || op == "||") {
        var lv: string = emit_lle(n.na);
        var l1: string = ll_to_i1(lv);
        var lend: string = ll_cur_blk;
        var rhsL: string = ll_lbl("sc.r");
        var mrgL: string = ll_lbl("sc.m");
        if (op == "&&") {
            llfb(cat6("  br i1 ", l1, ", label %", rhsL, ", label %", mrgL));
        } else {
            llfb(cat6("  br i1 ", l1, ", label %", mrgL, ", label %", rhsL));
        }
        ll_label(rhsL);
        var rv: string = emit_lle(n.nb);
        var r1: string = ll_to_i1(rv);
        var rend: string = ll_cur_blk;
        llfb(cat3("  br label %", mrgL, ""));
        ll_label(mrgL);
        var sc_const: string = "false";
        if (op == "||") {
            sc_const = "true";
        }
        var t: string = ll_tmp();
        llfb(cat6("  ", t, " = phi i1 [ ", sc_const, ", %", cat6(lend, " ], [ ", r1, ", %", rend, " ]")));
        return ll_b8(t);
    }

    // 字符串相等
    if (op == "==" || op == "!=") {
        var lt: i64 = ll_etd(n.na);
        var rt: i64 = ll_etd(n.nb);
        var ltc: TD = tds[lt];
        var rtc: TD = tds[rt];
        if (ltc.cat == "string" || rtc.cat == "string") {
            var lp: string = emit_lle(n.na);
            var rp: string = emit_lle(n.nb);
            var t0: string = ll_tmp();
            llfb(cat6("  ", t0, " = call i32 @tll_str_eq(ptr ", lp, ", ptr ", cat2(rp, ")")));
            var t1: string = ll_tmp();
            if (op == "==") {
                llfb(cat4("  ", t1, " = icmp ne i32 ", cat2(t0, ", 0")));
            } else {
                llfb(cat4("  ", t1, " = icmp eq i32 ", cat2(t0, ", 0")));
            }
            return ll_b8(t1);
        }
    }

    var utd: i64 = ll_bin_td(e);
    var sn: string = td_sname(utd);
    if (sn == "") {
        sn = "i64";
    }
    var ty: string = scalar_to_ll(sn);
    var isf: bool = ll_isf(sn);
    var sg: bool = ll_signed(sn);
    var a: string = emit_lle(n.na);
    a = ll_cast_v(a, ll_etd(n.na), utd);
    var b: string = emit_lle(n.nb);
    b = ll_cast_v(b, ll_etd(n.nb), utd);

    if (op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=") {
        var cc: string = "";
        if (isf) {
            if (op == "==") { cc = "oeq"; }
            if (op == "!=") { cc = "one"; }
            if (op == "<") { cc = "olt"; }
            if (op == ">") { cc = "ogt"; }
            if (op == "<=") { cc = "ole"; }
            if (op == ">=") { cc = "oge"; }
            var tf: string = ll_tmp();
            llfb(cat6("  ", tf, " = fcmp ", cc, " ", cat6(ty, " ", a, ", ", b, "")));
            return ll_b8(tf);
        }
        if (op == "==") { cc = "eq"; }
        if (op == "!=") { cc = "ne"; }
        if (sg) {
            if (op == "<") { cc = "slt"; }
            if (op == ">") { cc = "sgt"; }
            if (op == "<=") { cc = "sle"; }
            if (op == ">=") { cc = "sge"; }
        } else {
            if (op == "<") { cc = "ult"; }
            if (op == ">") { cc = "ugt"; }
            if (op == "<=") { cc = "ule"; }
            if (op == ">=") { cc = "uge"; }
        }
        var ti2: string = ll_tmp();
        llfb(cat6("  ", ti2, " = icmp ", cc, " ", cat6(ty, " ", a, ", ", b, "")));
        return ll_b8(ti2);
    }

    var ins: string = "";
    if (isf) {
        if (op == "+") { ins = "fadd"; }
        if (op == "-") { ins = "fsub"; }
        if (op == "*") { ins = "fmul"; }
        if (op == "/") { ins = "fdiv"; }
        if (op == "%") { ins = "frem"; }
    } else {
        if (op == "+") { ins = "add"; }
        if (op == "-") { ins = "sub"; }
        if (op == "*") { ins = "mul"; }
        if (op == "/") {
            ins = "udiv";
            if (sg) {
                ins = "sdiv";
            }
        }
        if (op == "%") {
            ins = "urem";
            if (sg) {
                ins = "srem";
            }
        }
        if (op == "<<") { ins = "shl"; }
        if (op == ">>") {
            ins = "lshr";
            if (sg) {
                ins = "ashr";
            }
        }
        if (op == "&") { ins = "and"; }
        if (op == "|") { ins = "or"; }
        if (op == "^") { ins = "xor"; }
    }
    if (ins == "") {
        llfb("  ; UNSUPPORTED binop");
        return "0";
    }
    var t3: string = ll_tmp();
    llfb(cat6("  ", t3, " = ", ins, " ", cat6(ty, " ", a, ", ", b, "")));
    return t3;
}

ll_unary :: func(e: i64) -> string {
    var n: Node = nodes[e];
    var op: string = n.sa;
    if (op == "!") {
        var v: string = emit_lle(n.na);
        var t: string = ll_tmp();
        llfb(cat4("  ", t, " = icmp eq i8 ", cat2(v, ", 0")));
        return ll_b8(t);
    }
    var otd: i64 = ll_etd(n.na);
    var sn: string = td_sname(otd);
    if (sn == "") {
        sn = "i64";
    }
    var ty: string = scalar_to_ll(sn);
    var v2: string = emit_lle(n.na);
    if (op == "-") {
        if (str_len(v2) > 0) {
            if (v2[0] != 37) {
                return cat2("-", v2);    // 常量折叠
            }
        }
        if (ll_isf(sn)) {
            var tf: string = ll_tmp();
            llfb(cat6("  ", tf, " = fneg ", ty, " ", v2));
            return tf;
        }
        var t2: string = ll_tmp();
        llfb(cat6("  ", t2, " = sub ", ty, " 0, ", v2));
        return t2;
    }
    if (op == "~") {
        var t3: string = ll_tmp();
        llfb(cat6("  ", t3, " = xor ", ty, " ", cat2(v2, ", -1")));
        return t3;
    }
    return v2;
}

// ── 尺寸计算（union/variant 载荷字节数，保守 8 字节对齐上估）──

ll_round8 :: func(v: i64) -> i64 {
    return ((v + 7) / 8) * 8;
}

ll_size_bytes :: func(td: i64) -> i64 {
    if (td < 0) {
        return 8;
    }
    var t: TD = tds[td];
    if (t.cat == "scalar") {
        if (t.name == "") {
            return 8;
        }
        return ll_bits(t.name) / 8;
    }
    if (t.cat == "string") {
        return 16;
    }
    if (t.cat == "slice") {
        return 32;
    }
    if (t.cat == "map") {
        return 8;
    }
    if (t.cat == "named") {
        if (t.name == "TSb*") {
            return 8;
        }
        var i: i64 = llt_find(t.name);
        if (i < 0) {
            return 8;
        }
        var k: string = llt_kinds[i];
        if (k == "enum" || k == "flag") {
            return ll_bits(llt_unders[i]) / 8;
        }
        if (k == "alias") {
            return ll_size_bytes(llt_atd[i]);
        }
        if (k == "struct") {
            var sum: i64 = 0;
            var n: i64 = slice_len(llsf_st) as i64;
            var j: i64 = 0;
            while (j < n) {
                if (llsf_st[j] == t.name) {
                    sum = sum + ll_round8(ll_size_bytes(llsf_td[j]));
                }
                j = j + 1;
            }
            if (sum == 0) {
                sum = 8;
            }
            return sum;
        }
        if (k == "variant") {
            return 8 + ll_variant_paymax(t.name);
        }
        if (k == "union") {
            return ll_union_max(t.name);
        }
    }
    return 8;
}

ll_variant_paymax :: func(name: string) -> i64 {
    var mx: i64 = 8;
    var n: i64 = slice_len(llv_v) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (llv_v[i] == name && llv_ptd[i] >= 0) {
            var s: i64 = ll_round8(ll_size_bytes(llv_ptd[i]));
            if (s > mx) {
                mx = s;
            }
        }
        i = i + 1;
    }
    return mx;
}

ll_union_max :: func(name: string) -> i64 {
    var mx: i64 = 8;
    var n: i64 = slice_len(llu_u) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (llu_u[i] == name) {
            var s: i64 = ll_round8(ll_size_bytes(llu_td[i]));
            if (s > mx) {
                mx = s;
            }
        }
        i = i + 1;
    }
    return mx;
}

// iN 类型的常量文本：超出有符号范围时按补码回绕成负十进制
ll_iconst :: func(v: i64, bits: i64) -> string {
    if (bits == 8) {
        if (v > 127) {
            return i2s(v - 256);
        }
    }
    if (bits == 16) {
        if (v > 32767) {
            return i2s(v - 65536);
        }
    }
    if (bits == 32) {
        if (v > 2147483647) {
            return i2s(v - 4294967296);
        }
    }
    return i2s(v);
}

// 复合赋值/二元共用的算术指令名
ll_arith_ins :: func(op: string, sn: string) -> string {
    var isf: bool = ll_isf(sn);
    var sg: bool = ll_signed(sn);
    if (isf) {
        if (op == "+") { return "fadd"; }
        if (op == "-") { return "fsub"; }
        if (op == "*") { return "fmul"; }
        if (op == "/") { return "fdiv"; }
        if (op == "%") { return "frem"; }
        return "";
    }
    if (op == "+") { return "add"; }
    if (op == "-") { return "sub"; }
    if (op == "*") { return "mul"; }
    if (op == "/") {
        if (sg) {
            return "sdiv";
        }
        return "udiv";
    }
    if (op == "%") {
        if (sg) {
            return "srem";
        }
        return "urem";
    }
    if (op == "<<") { return "shl"; }
    if (op == ">>") {
        if (sg) {
            return "ashr";
        }
        return "lshr";
    }
    if (op == "&") { return "and"; }
    if (op == "|") { return "or"; }
    if (op == "^") { return "xor"; }
    return "";
}

// ── 调用发射 ───────────────────────────────────────────────────

ll_call :: func(e: i64) -> string {
    var n: Node = nodes[e];
    var cal: Node = nodes[n.na];
    if (cal.kind != "ident") {
        llfb("  ; UNSUPPORTED call target");
        return "0";
    }
    var cn: string = cal.sa;
    var ae: []i64;
    var c: i64 = n.la;
    while (c >= 0) {
        var k: Child = kids[c];
        append(ae, k.val);
        c = k.next;
    }
    var argc: i64 = slice_len(ae) as i64;
    var td_i64: i64 = td_named_mk("scalar", "i64");
    var td_i32: i64 = td_named_mk("scalar", "i32");

    if (cn == "print" || cn == "eprint" || cn == "println") {
        var p: string = emit_lle(ae[0]);
        var fnm: string = "@tll_print";
        if (cn == "eprint") {
            fnm = "@tll_eprint";
        }
        llfb(cat4("  call void ", fnm, "(ptr ", cat2(p, ")")));
        if (cn == "println") {
            var nl: string = ll_strlit("\n");
            llfb(cat3("  call void @tll_print(ptr ", nl, ")"));
        }
        return "0";
    }
    if (cn == "str_len" || cn == "slice_len") {
        var p2: string = emit_lle(ae[0]);
        var fn2: string = "@tll_str_len";
        if (cn == "slice_len") {
            fn2 = "@tll_slice_len";
        }
        var t0: string = ll_tmp();
        llfb(cat6("  ", t0, " = call i64 ", fn2, "(ptr ", cat2(p2, ")")));
        return t0;
    }
    if (cn == "str_at") {
        var sp: string = emit_lle(ae[0]);
        var iv: string = emit_lle(ae[1]);
        iv = ll_cast_v(iv, ll_etd(ae[1]), td_i64);
        var t1: string = ll_tmp();
        llfb(cat6("  ", t1, " = call i64 @tll_str_at(ptr ", sp, ", i64 ", cat2(iv, ")")));
        var t2: string = ll_tmp();
        llfb(cat4("  ", t2, " = trunc i64 ", cat2(t1, " to i8")));
        return t2;
    }
    if (cn == "str_slice") {
        var sp2: string = emit_lle(ae[0]);
        var a1: string = emit_lle(ae[1]);
        a1 = ll_cast_v(a1, ll_etd(ae[1]), td_i64);
        var b1: string = emit_lle(ae[2]);
        b1 = ll_cast_v(b1, ll_etd(ae[2]), td_i64);
        var out0: string = ll_scratch("%TStr");
        var lsb: StringBuilder = sb_new();
        sb_append_str(lsb, "  call void @tll_str_slice(ptr ");
        sb_append_str(lsb, sp2);
        sb_append_str(lsb, ", i64 ");
        sb_append_str(lsb, a1);
        sb_append_str(lsb, ", i64 ");
        sb_append_str(lsb, b1);
        sb_append_str(lsb, ", ptr ");
        sb_append_str(lsb, out0);
        sb_append_str(lsb, ")");
        llfb(sb_to_str(lsb));
        return out0;
    }
    if (cn == "append") {
        var std: i64 = ll_etd(ae[0]);
        var st: TD = tds[std];
        var ety: string = "i64";
        var etd: i64 = -1;
        if (st.cat == "slice") {
            etd = st.elem;
        }
        if (etd >= 0) {
            ety = ll_td(etd);
        }
        var sp3: string = emit_lle(ae[0]);
        var ep: string = "";
        var isagg: bool = false;
        if (etd >= 0) {
            isagg = ll_isagg(etd);
        }
        if (isagg) {
            ep = emit_lle(ae[1]);
        } else {
            var v0: string = emit_lle(ae[1]);
            if (etd >= 0) {
                v0 = ll_cast_v(v0, ll_etd(ae[1]), etd);
            }
            var sc0: string = ll_scratch(ety);
            llfb(cat6("  store ", ety, " ", v0, ", ptr ", sc0));
            ep = sc0;
        }
        var asb: StringBuilder = sb_new();
        sb_append_str(asb, "  call void @tll_slice_append(ptr ");
        sb_append_str(asb, sp3);
        sb_append_str(asb, ", ptr ");
        sb_append_str(asb, ep);
        sb_append_str(asb, ", i64 ");
        sb_append_str(asb, ll_sizeof(ety));
        sb_append_str(asb, ")");
        llfb(sb_to_str(asb));
        return "0";
    }
    if (cn == "slice_set") {
        var std2: i64 = ll_etd(ae[0]);
        var st2: TD = tds[std2];
        var etd2: i64 = -1;
        if (st2.cat == "slice") {
            etd2 = st2.elem;
        }
        var ety2: string = "i64";
        if (etd2 >= 0) {
            ety2 = ll_td(etd2);
        }
        var sp4: string = emit_lle(ae[0]);
        var iv2: string = emit_lle(ae[1]);
        iv2 = ll_cast_v(iv2, ll_etd(ae[1]), td_i64);
        var ep2: string = "";
        var isagg2: bool = false;
        if (etd2 >= 0) {
            isagg2 = ll_isagg(etd2);
        }
        if (isagg2) {
            ep2 = emit_lle(ae[2]);
        } else {
            var v1: string = emit_lle(ae[2]);
            if (etd2 >= 0) {
                v1 = ll_cast_v(v1, ll_etd(ae[2]), etd2);
            }
            var sc1: string = ll_scratch(ety2);
            llfb(cat6("  store ", ety2, " ", v1, ", ptr ", sc1));
            ep2 = sc1;
        }
        var ssb: StringBuilder = sb_new();
        sb_append_str(ssb, "  call void @tll_slice_set(ptr ");
        sb_append_str(ssb, sp4);
        sb_append_str(ssb, ", i64 ");
        sb_append_str(ssb, iv2);
        sb_append_str(ssb, ", ptr ");
        sb_append_str(ssb, ep2);
        sb_append_str(ssb, ")");
        llfb(sb_to_str(ssb));
        return "0";
    }
    if (cn == "file_read_all" || cn == "path_resolve") {
        var pp0: string = emit_lle(ae[0]);
        var fn3: string = "@tll_file_read_all";
        if (cn == "path_resolve") {
            fn3 = "@tll_path_resolve";
        }
        var out1: string = ll_scratch("%TStr");
        llfb(cat6("  call void ", fn3, "(ptr ", pp0, ", ptr ", cat2(out1, ")")));
        return out1;
    }
    if (cn == "file_write_all") {
        var pa: string = emit_lle(ae[0]);
        var pb: string = emit_lle(ae[1]);
        var t3: string = ll_tmp();
        llfb(cat6("  ", t3, " = call i32 @tll_file_write_all(ptr ", pa, ", ptr ", cat2(pb, ")")));
        var t4: string = ll_tmp();
        llfb(cat4("  ", t4, " = trunc i32 ", cat2(t3, " to i8")));
        return t4;
    }
    if (cn == "args") {
        var out2: string = ll_scratch("%TSlice");
        llfb(cat3("  call void @tll_args(ptr ", out2, ")"));
        return out2;
    }
    if (cn == "exit") {
        var cv: string = emit_lle(ae[0]);
        cv = ll_cast_v(cv, ll_etd(ae[0]), td_i32);
        llfb(cat3("  call void @tll_exit(i32 ", cv, ")"));
        return "0";
    }
    if (cn == "sys_run") {
        var cp: string = emit_lle(ae[0]);
        var t5: string = ll_tmp();
        llfb(cat4("  ", t5, " = call i32 @tll_system(ptr ", cat2(cp, ")")));
        return t5;
    }
    if (cn == "sb_new") {
        var t6: string = ll_tmp();
        llfb(cat3("  ", t6, " = call ptr @tll_sb_new()"));
        return t6;
    }
    if (cn == "sb_append_str") {
        var bp: string = emit_lle(ae[0]);
        var sv: string = emit_lle(ae[1]);
        llfb(cat6("  call void @tll_sb_append_str(ptr ", bp, ", ptr ", sv, ")", ""));
        return "0";
    }
    if (cn == "sb_append_char" || cn == "sb_append_u64" || cn == "sb_append_i64") {
        var bp2: string = emit_lle(ae[0]);
        var cv2: string = emit_lle(ae[1]);
        cv2 = ll_cast_v(cv2, ll_etd(ae[1]), td_i64);
        var fn4: string = "@tll_sb_append_char";
        if (cn == "sb_append_u64") {
            fn4 = "@tll_sb_append_u64";
        }
        if (cn == "sb_append_i64") {
            fn4 = "@tll_sb_append_i64";
        }
        llfb(cat6("  call void ", fn4, "(ptr ", bp2, ", i64 ", cat2(cv2, ")")));
        return "0";
    }
    if (cn == "sb_to_str") {
        var bp3: string = emit_lle(ae[0]);
        var out3: string = ll_scratch("%TStr");
        llfb(cat6("  call void @tll_sb_to_str(ptr ", bp3, ", ptr ", out3, ")", ""));
        return out3;
    }
    if (cn == "sb_clear") {
        var bp4: string = emit_lle(ae[0]);
        llfb(cat3("  call void @tll_sb_clear(ptr ", bp4, ")"));
        return "0";
    }
    if (cn == "flag_get" || cn == "flag_set") {
        var mn: Node = nodes[ae[1]];
        var slot: i64 = -1;
        if (mn.kind == "member") {
            var ob: Node = nodes[mn.na];
            if (ob.kind == "ident") {
                slot = llfl_find(ob.sa, mn.sa);
            }
        }
        if (slot < 0) {
            llfb("  ; UNSUPPORTED flag slot");
            return "0";
        }
        var ftd: i64 = ll_etd(ae[0]);
        var un: string = td_sname(ftd);
        if (un == "") {
            un = "u32";
        }
        var fty: string = scalar_to_ll(un);
        var bits: i64 = ll_bits(un);
        var start: i64 = llfl_start[slot];
        var mval: i64 = js_max_val(llfl_len[slot]);
        var m: i64 = mval * pow2_i64(start);
        if (cn == "flag_get") {
            var fv: string = emit_lle(ae[0]);
            var g1: string = ll_tmp();
            llfb(cat6("  ", g1, " = lshr ", fty, " ", cat4(fv, ", ", i2s(start), "")));
            var g2: string = ll_tmp();
            llfb(cat6("  ", g2, " = and ", fty, " ", cat4(g1, ", ", ll_iconst(mval, bits), "")));
            var utd: i64 = td_named_mk("scalar", un);
            var u32td: i64 = td_named_mk("scalar", "u32");
            return ll_cast_v(g2, utd, u32td);
        }
        var ad0: string = ll_addr(ae[0]);
        var old: string = ll_load(fty, ad0);
        var notm: i64 = 0 - m - 1;
        var s1: string = ll_tmp();
        llfb(cat6("  ", s1, " = and ", fty, " ", cat4(old, ", ", i2s(notm), "")));
        var xv: string = emit_lle(ae[2]);
        var utd2: i64 = td_named_mk("scalar", un);
        xv = ll_cast_v(xv, ll_etd(ae[2]), utd2);
        var s2: string = ll_tmp();
        llfb(cat6("  ", s2, " = shl ", fty, " ", cat4(xv, ", ", i2s(start), "")));
        var s3: string = ll_tmp();
        llfb(cat6("  ", s3, " = and ", fty, " ", cat4(s2, ", ", ll_iconst(m, bits), "")));
        var s4: string = ll_tmp();
        llfb(cat6("  ", s4, " = or ", fty, " ", cat4(s1, ", ", s3, "")));
        llfb(cat6("  store ", fty, " ", s4, ", ptr ", ad0));
        return "0";
    }
    if (cn == "assert_eq" || cn == "assert_true" || cn == "assert_false" || cn == "assert_panic") {
        llfb("  ; assert (test-only, no-op in llvm backend)");
        return "0";
    }
    if (llv_match(cn)) {
        var vi: i64 = ll_vm_i;
        var vty: string = cat2("%vt.", llv_v[vi]);
        if (ll_vm_kind == "from") {
            var scv: string = ll_scratch(vty);
            llfb(cat4("  store ", vty, " zeroinitializer, ptr ", scv));
            var tp: string = ll_tmp();
            llfb(cat6("  ", tp, " = getelementptr inbounds ", vty, ", ptr ", cat2(scv, ", i32 0, i32 0")));
            llfb(cat6("  store i64 ", i2s(llv_tag[vi]), ", ptr ", tp, "", ""));
            if (llv_ptd[vi] >= 0 && argc > 0) {
                var ppp: string = ll_tmp();
                llfb(cat6("  ", ppp, " = getelementptr inbounds ", vty, ", ptr ", cat2(scv, ", i32 0, i32 1")));
                var ptd: i64 = llv_ptd[vi];
                var pty: string = ll_td(ptd);
                if (ll_isagg(ptd)) {
                    var pv: string = emit_lle(ae[0]);
                    ll_copy(pty, pv, ppp);
                } else {
                    var pv2: string = emit_lle(ae[0]);
                    pv2 = ll_cast_v(pv2, ll_etd(ae[0]), ptd);
                    llfb(cat6("  store ", pty, " ", pv2, ", ptr ", ppp));
                }
            }
            return scv;
        }
        var vp: string = emit_lle(ae[0]);
        if (ll_vm_kind == "is") {
            var tp2: string = ll_tmp();
            llfb(cat6("  ", tp2, " = getelementptr inbounds ", vty, ", ptr ", cat2(vp, ", i32 0, i32 0")));
            var tv: string = ll_load("i64", tp2);
            var ic: string = ll_tmp();
            llfb(cat6("  ", ic, " = icmp eq i64 ", tv, ", ", i2s(llv_tag[vi])));
            return ll_b8(ic);
        }
        var pp2: string = ll_tmp();
        llfb(cat6("  ", pp2, " = getelementptr inbounds ", vty, ", ptr ", cat2(vp, ", i32 0, i32 1")));
        var ptd2: i64 = llv_ptd[vi];
        if (ptd2 >= 0) {
            if (ll_isagg(ptd2)) {
                return pp2;
            }
            return ll_load(ll_td(ptd2), pp2);
        }
        return "0";
    }
    // 用户函数：模块内按值传递聚合
    var fi: i64 = llfn_find(cn);
    if (fi >= 0) {
        var rtd: i64 = llfn_r[fi];
        var ps: i64 = llfn_ps[fi];
        var pc: i64 = llfn_pc[fi];
        var csb: StringBuilder = sb_new();
        var i: i64 = 0;
        while (i < argc) {
            if (i > 0) {
                sb_append_str(csb, ", ");
            }
            var ptd3: i64 = -1;
            if (i < pc) {
                ptd3 = llfp_td[ps + i];
            }
            var aty: string = ll_td(ptd3);
            var avv: string = emit_lle(ae[i]);
            if (ptd3 >= 0 && ll_isagg(ptd3)) {
                avv = ll_load(aty, avv);
            } else {
                avv = ll_cast_v(avv, ll_etd(ae[i]), ptd3);
            }
            sb_append_str(csb, aty);
            sb_append_str(csb, " ");
            sb_append_str(csb, avv);
            i = i + 1;
        }
        var rty: string = ll_td(rtd);
        var argstr: string = sb_to_str(csb);
        if (rty == "void") {
            llfb(cat6("  call void @t.", cn, "(", argstr, ")", ""));
            return "0";
        }
        var t7: string = ll_tmp();
        var line: StringBuilder = sb_new();
        sb_append_str(line, "  ");
        sb_append_str(line, t7);
        sb_append_str(line, " = call ");
        sb_append_str(line, rty);
        sb_append_str(line, " @t.");
        sb_append_str(line, cn);
        sb_append_str(line, "(");
        sb_append_str(line, argstr);
        sb_append_str(line, ")");
        llfb(sb_to_str(line));
        if (ll_isagg(rtd)) {
            var sc2: string = ll_scratch(rty);
            llfb(cat6("  store ", rty, " ", t7, ", ptr ", sc2));
            return sc2;
        }
        return t7;
    }
    llfb(cat2("  ; UNSUPPORTED call ", cn));
    return "0";
}

// 2^n（flag 掩码用；n < 63）
pow2_i64 :: func(n: i64) -> i64 {
    var r: i64 = 1;
    var i: i64 = 0;
    while (i < n) {
        r = r * 2;
        i = i + 1;
    }
    return r;
}

// ── 循环目标栈（brk/cnt 成对维护）──────────────────────────────

ll_loop_push2 :: func(brk: string, cnt: string) -> void {
    if (ll_loopd < slice_len(llbrk) as i64) {
        slice_set(llbrk, ll_loopd, brk);
        slice_set(llcnt, ll_loopd, cnt);
    } else {
        append(llbrk, brk);
        append(llcnt, cnt);
    }
    ll_loopd = ll_loopd + 1;
}

ll_loop_pop :: func() -> void {
    ll_loopd = ll_loopd - 1;
}

// switch case 常量（按位宽回绕）
ll_case_const :: func(e: i64, bits: i64) -> string {
    var n: Node = nodes[e];
    if (n.kind == "int") {
        var r: i64 = n.ia;
        if (r < 2) {
            r = 10;
        }
        return ll_iconst(js_parse_int(n.sa, r), bits);
    }
    if (n.kind == "member") {
        var ob: Node = nodes[n.na];
        if (ob.kind == "ident") {
            var ei: i64 = llec_find(ob.sa, n.sa);
            if (ei >= 0) {
                return ll_iconst(llec_v[ei], bits);
            }
        }
    }
    if (n.kind == "unary") {
        if (n.sa == "-") {
            var inn: Node = nodes[n.na];
            if (inn.kind == "int") {
                var r2: i64 = inn.ia;
                if (r2 < 2) {
                    r2 = 10;
                }
                return i2s(0 - js_parse_int(inn.sa, r2));
            }
        }
    }
    return emit_lle(e);
}

// ── 局部变量声明（alloca 进 entry，初始化留当前块）─────────────

ll_local_decl :: func(name: string, td: i64, init_e: i64) -> void {
    var ty: string = ll_td(td);
    var vn: string = cat2("%v.", name);
    if (lla_has(name) == false) {
        append(lla_n, name);
        llfa(cat4("  ", vn, " = alloca ", ty));
    }
    if (init_e >= 0) {
        var v: string = emit_lle(init_e);
        if (ll_isagg(td)) {
            ll_copy(ty, v, vn);
        } else {
            v = ll_cast_v(v, ll_etd(init_e), td);
            llfb(cat6("  store ", ty, " ", v, ", ptr ", vn));
        }
        return;
    }
    var t: TD = tds[td];
    if (t.cat == "slice") {
        var ety: string = "i64";
        if (t.elem >= 0) {
            ety = ll_td(t.elem);
        }
        llfb(cat6("  call void @tll_slice_new(i64 ", ll_sizeof(ety), ", ptr ", vn, ")", ""));
        return;
    }
    llfb(cat6("  store ", ty, " ", ll_zero(ty), ", ptr ", vn));
}

// ── 语句发射 ───────────────────────────────────────────────────

emit_llstmt :: func(sid: i64) -> void {
    if (ll_term) {
        ll_open();
    }
    var n: Node = nodes[sid];

    if (n.kind == "expr") {
        var xx: string = emit_lle(n.na);
        xx = "";
        return;
    }
    if (n.kind == "var_decl") {
        if (n.na >= 0) {
            ll_local_decl(n.sa, resolve_type_desc(n.na), n.nb);
        }
        return;
    }
    if (n.kind == "assignment") {
        var op: string = n.sa;
        var ltd: i64 = ll_etd(n.na);
        var lty: string = ll_td(ltd);
        if (op == "=") {
            var v: string = emit_lle(n.nb);
            var ad: string = ll_addr(n.na);
            if (ll_isagg(ltd)) {
                ll_copy(lty, v, ad);
            } else {
                v = ll_cast_v(v, ll_etd(n.nb), ltd);
                llfb(cat6("  store ", lty, " ", v, ", ptr ", ad));
            }
            return;
        }
        // 复合赋值：load-op-store
        var bop: string = str_slice(op, 0, str_len(op) - 1);
        var ad2: string = ll_addr(n.na);
        var old: string = ll_load(lty, ad2);
        var rv: string = emit_lle(n.nb);
        rv = ll_cast_v(rv, ll_etd(n.nb), ltd);
        var sn: string = td_sname(ltd);
        if (sn == "") {
            sn = "i64";
        }
        var ins: string = ll_arith_ins(bop, sn);
        if (ins == "") {
            llfb("  ; UNSUPPORTED compound assign");
            return;
        }
        var t: string = ll_tmp();
        llfb(cat6("  ", t, " = ", ins, " ", cat6(lty, " ", old, ", ", rv, "")));
        llfb(cat6("  store ", lty, " ", t, ", ptr ", ad2));
        return;
    }
    if (n.kind == "if") {
        var cv: string = emit_lle(n.na);
        var c1: string = ll_to_i1(cv);
        var thenL: string = ll_lbl("if.t");
        var endL: string = ll_lbl("if.e");
        var elseL: string = endL;
        var has_else: bool = n.lb > -2;
        if (has_else) {
            elseL = ll_lbl("if.f");
        }
        llfb(cat6("  br i1 ", c1, ", label %", thenL, ", label %", elseL));
        ll_term = true;
        ll_label(thenL);
        var tb: i64 = n.la;
        while (tb >= 0) {
            var tk: Child = kids[tb];
            emit_llstmt(tk.val);
            tb = tk.next;
        }
        if (ll_term == false) {
            llfb(cat2("  br label %", endL));
            ll_term = true;
        }
        if (has_else) {
            ll_label(elseL);
            var eb: i64 = n.lb;
            while (eb >= 0) {
                var ek: Child = kids[eb];
                emit_llstmt(ek.val);
                eb = ek.next;
            }
            if (ll_term == false) {
                llfb(cat2("  br label %", endL));
                ll_term = true;
            }
        }
        ll_label(endL);
        return;
    }
    if (n.kind == "while") {
        var condL: string = ll_lbl("wh.c");
        var bodyL: string = ll_lbl("wh.b");
        var endL2: string = ll_lbl("wh.e");
        llfb(cat2("  br label %", condL));
        ll_label(condL);
        var cv2: string = emit_lle(n.na);
        var c2: string = ll_to_i1(cv2);
        llfb(cat6("  br i1 ", c2, ", label %", bodyL, ", label %", endL2));
        ll_term = true;
        ll_label(bodyL);
        ll_loop_push2(endL2, condL);
        var wb: i64 = n.la;
        while (wb >= 0) {
            var wk: Child = kids[wb];
            emit_llstmt(wk.val);
            wb = wk.next;
        }
        ll_loop_pop();
        if (ll_term == false) {
            llfb(cat2("  br label %", condL));
            ll_term = true;
        }
        ll_label(endL2);
        return;
    }
    if (n.kind == "for") {
        if (n.na >= 0) {
            var ini: Node = nodes[n.na];
            if (ini.kind == "var_decl") {
                if (ini.na >= 0) {
                    ll_local_decl(ini.sa, resolve_type_desc(ini.na), ini.nb);
                }
            }
            if (ini.kind == "expr") {
                var xi: string = emit_lle(ini.na);
                xi = "";
            }
        }
        var condL2: string = ll_lbl("fo.c");
        var bodyL2: string = ll_lbl("fo.b");
        var stepL: string = ll_lbl("fo.s");
        var endL3: string = ll_lbl("fo.e");
        llfb(cat2("  br label %", condL2));
        ll_label(condL2);
        if (n.nb >= 0) {
            var cv3: string = emit_lle(n.nb);
            var c3: string = ll_to_i1(cv3);
            llfb(cat6("  br i1 ", c3, ", label %", bodyL2, ", label %", endL3));
        } else {
            llfb(cat2("  br label %", bodyL2));
        }
        ll_term = true;
        ll_label(bodyL2);
        ll_loop_push2(endL3, stepL);
        var fb2: i64 = n.la;
        while (fb2 >= 0) {
            var fk: Child = kids[fb2];
            emit_llstmt(fk.val);
            fb2 = fk.next;
        }
        ll_loop_pop();
        if (ll_term == false) {
            llfb(cat2("  br label %", stepL));
            ll_term = true;
        }
        ll_label(stepL);
        if (n.nc >= 0) {
            var xu: string = emit_lle(n.nc);
            xu = "";
        }
        llfb(cat2("  br label %", condL2));
        ll_term = true;
        ll_label(endL3);
        return;
    }
    if (n.kind == "for_each") {
        var itd0: i64 = ll_etd(n.na);
        var it0: TD = tds[itd0];
        var etd: i64 = -1;
        if (it0.cat == "slice") {
            etd = it0.elem;
        }
        var ety: string = "i64";
        if (etd >= 0) {
            ety = ll_td(etd);
        }
        var iter: string = emit_lle(n.na);
        var lenv: string = ll_tmp();
        llfb(cat4("  ", lenv, " = call i64 @tll_slice_len(ptr ", cat2(iter, ")")));
        var idx: string = ll_scratch("i64");
        llfb(cat3("  store i64 0, ptr ", idx, ""));
        if (lla_has(n.sa) == false) {
            append(lla_n, n.sa);
            llfa(cat4("  %v.", n.sa, " = alloca ", ety));
        }
        var condL3: string = ll_lbl("fe.c");
        var bodyL3: string = ll_lbl("fe.b");
        var stepL2: string = ll_lbl("fe.s");
        var endL4: string = ll_lbl("fe.e");
        llfb(cat2("  br label %", condL3));
        ll_label(condL3);
        var iv: string = ll_load("i64", idx);
        var cc: string = ll_tmp();
        llfb(cat6("  ", cc, " = icmp slt i64 ", iv, ", ", lenv));
        llfb(cat6("  br i1 ", cc, ", label %", bodyL3, ", label %", endL4));
        ll_term = true;
        ll_label(bodyL3);
        var iv2: string = ll_load("i64", idx);
        var ep: string = ll_tmp();
        llfb(cat6("  ", ep, " = call ptr @tll_slice_at(ptr ", iter, ", i64 ", cat2(iv2, ")")));
        ll_copy(ety, ep, cat2("%v.", n.sa));
        ll_loop_push2(endL4, stepL2);
        var bb: i64 = n.la;
        while (bb >= 0) {
            var bk: Child = kids[bb];
            emit_llstmt(bk.val);
            bb = bk.next;
        }
        ll_loop_pop();
        if (ll_term == false) {
            llfb(cat2("  br label %", stepL2));
            ll_term = true;
        }
        ll_label(stepL2);
        var iv3: string = ll_load("i64", idx);
        var iv4: string = ll_tmp();
        llfb(cat4("  ", iv4, " = add i64 ", cat2(iv3, ", 1")));
        llfb(cat6("  store i64 ", iv4, ", ptr ", idx, "", ""));
        llfb(cat2("  br label %", condL3));
        ll_term = true;
        ll_label(endL4);
        return;
    }
    if (n.kind == "return") {
        var rty: string = ll_td(ll_cur_ret);
        if (n.na < 0 || rty == "void") {
            llfb("  ret void");
            ll_term = true;
            return;
        }
        var rv2: string = emit_lle(n.na);
        if (ll_isagg(ll_cur_ret)) {
            var rl: string = ll_load(rty, rv2);
            llfb(cat4("  ret ", rty, " ", rl));
        } else {
            rv2 = ll_cast_v(rv2, ll_etd(n.na), ll_cur_ret);
            llfb(cat4("  ret ", rty, " ", rv2));
        }
        ll_term = true;
        return;
    }
    if (n.kind == "break") {
        llfb(cat2("  br label %", llbrk[ll_loopd - 1]));
        ll_term = true;
        return;
    }
    if (n.kind == "continue") {
        llfb(cat2("  br label %", llcnt[ll_loopd - 1]));
        ll_term = true;
        return;
    }
    if (n.kind == "block") {
        var bb2: i64 = n.la;
        while (bb2 >= 0) {
            var bk2: Child = kids[bb2];
            emit_llstmt(bk2.val);
            bb2 = bk2.next;
        }
        return;
    }
    if (n.kind == "switch") {
        var std: i64 = ll_etd(n.na);
        var sn2: string = td_sname(std);
        if (sn2 == "") {
            sn2 = "i64";
        }
        var sty: string = scalar_to_ll(sn2);
        var sbits: i64 = ll_bits(sn2);
        var sv: string = emit_lle(n.na);
        var endL5: string = ll_lbl("sw.e");
        var defL: string = endL5;
        if (n.lb > -2) {
            defL = ll_lbl("sw.d");
        }
        // 先分配 case 标签并生成 switch 头
        var case_ls: []string;
        var case_vs: []string;
        var cc2: i64 = n.la;
        while (cc2 >= 0) {
            var ck: Child = kids[cc2];
            var cs: Node = nodes[ck.val];
            var one_lbl: string = ll_lbl("sw.c");
            append(case_ls, one_lbl);
            var cvv: string = ll_case_const(cs.na, sbits);
            append(case_vs, cvv);
            cc2 = ck.next;
        }
        var hsb: StringBuilder = sb_new();
        sb_append_str(hsb, "  switch ");
        sb_append_str(hsb, sty);
        sb_append_str(hsb, " ");
        sb_append_str(hsb, sv);
        sb_append_str(hsb, ", label %");
        sb_append_str(hsb, defL);
        sb_append_str(hsb, " [");
        var nc: i64 = slice_len(case_ls) as i64;
        var ci: i64 = 0;
        while (ci < nc) {
            sb_append_str(hsb, " ");
            sb_append_str(hsb, sty);
            sb_append_str(hsb, " ");
            sb_append_str(hsb, case_vs[ci]);
            sb_append_str(hsb, ", label %");
            sb_append_str(hsb, case_ls[ci]);
            ci = ci + 1;
        }
        sb_append_str(hsb, " ]");
        llfb(sb_to_str(hsb));
        ll_term = true;
        // 逐 case 发射
        var cc3: i64 = n.la;
        var ci2: i64 = 0;
        while (cc3 >= 0) {
            var ck2: Child = kids[cc3];
            var cs2: Node = nodes[ck2.val];
            ll_label(case_ls[ci2]);
            var cb: i64 = cs2.la;
            while (cb >= 0) {
                var cbk: Child = kids[cb];
                emit_llstmt(cbk.val);
                cb = cbk.next;
            }
            if (ll_term == false) {
                llfb(cat2("  br label %", endL5));
                ll_term = true;
            }
            ci2 = ci2 + 1;
            cc3 = ck2.next;
        }
        if (n.lb > -2) {
            ll_label(defL);
            var db: i64 = n.lb;
            while (db >= 0) {
                var dk: Child = kids[db];
                emit_llstmt(dk.val);
                db = dk.next;
            }
            if (ll_term == false) {
                llfb(cat2("  br label %", endL5));
                ll_term = true;
            }
        }
        ll_label(endL5);
        return;
    }
    // defer / comptime_block：LLVM 后端暂不支持
}

// ── 函数发射 ───────────────────────────────────────────────────

ll_reset_fn :: func() -> void {
    var e1: []string;
    ll_fal = e1;
    var e2: []string;
    ll_fb = e2;
    var e3: []string;
    lla_n = e3;
    var e4: []string;
    llbrk = e4;
    var e5: []string;
    llcnt = e5;
    ll_loopd = 0;
    ll_tmpc = 0;
    ll_lblc = 0;
    ll_scc = 0;
    ll_cur_blk = "entry";
    ll_term = false;
}

emit_llfunc :: func(d: i64) -> void {
    var n: Node = nodes[d];
    var fi: i64 = llfn_find(n.sa);
    var rtd: i64 = -1;
    if (fi >= 0) {
        rtd = llfn_r[fi];
    }
    var rty: string = ll_td(rtd);

    // 签名
    var psb: StringBuilder = sb_new();
    var cnt: i64 = 0;
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var p: Node = nodes[k.val];
        if (cnt > 0) {
            sb_append_str(psb, ", ");
        }
        var ptd: i64 = resolve_type_desc(p.na);
        sb_append_str(psb, ll_td(ptd));
        sb_append_str(psb, " %p.");
        sb_append_str(psb, p.sa);
        cnt = cnt + 1;
        c = k.next;
    }
    var params: string = sb_to_str(psb);

    if (n.ba) {
        // extern：绑定 C 符号（无 t. 前缀），参数类型按同规则
        llph(cat6("declare ", rty, " @", n.sa, "(", cat2(params, ")")));
        return;
    }

    if (ann_find(n.la, "main") >= 0) {
        ll_has_main = true;
        ll_main_fn = n.sa;
    }

    ll_reset_fn();
    em_cur_fn = n.sa;
    em_in_fn = true;
    ll_cur_ret = rtd;

    // 参数落地：alloca %v.x + store
    var c2: i64 = n.lb;
    while (c2 >= 0) {
        var k2: Child = kids[c2];
        var p2: Node = nodes[k2.val];
        var ptd2: i64 = resolve_type_desc(p2.na);
        var pty: string = ll_td(ptd2);
        append(lla_n, p2.sa);
        llfa(cat6("  %v.", p2.sa, " = alloca ", pty, "", ""));
        llfb(cat6("  store ", pty, " %p.", p2.sa, ", ptr %v.", p2.sa));
        c2 = k2.next;
    }

    if (n.lc > -2) {
        var b: i64 = n.lc;
        while (b >= 0) {
            var bk: Child = kids[b];
            emit_llstmt(bk.val);
            b = bk.next;
        }
    }
    if (ll_term == false) {
        if (rty == "void") {
            llfb("  ret void");
        } else {
            llfb(cat4("  ret ", rty, " ", ll_zero(rty)));
        }
    }

    // 组装
    llpb(cat6("define ", rty, " @t.", n.sa, "(", cat2(params, ") {")));
    llpb("entry:");
    var na: i64 = slice_len(ll_fal) as i64;
    var i: i64 = 0;
    while (i < na) {
        llpb(ll_fal[i]);
        i = i + 1;
    }
    var nb: i64 = slice_len(ll_fb) as i64;
    var j: i64 = 0;
    while (j < nb) {
        llpb(ll_fb[j]);
        j = j + 1;
    }
    llpb("}");
    llpb("");
    em_in_fn = false;
    em_cur_fn = "";
}

// ── 类型定义 / 全局 / 模块编排 ─────────────────────────────────

emit_lltypes :: func() -> void {
    var n: i64 = slice_len(llt_names) as i64;
    var i: i64 = 0;
    while (i < n) {
        var name: string = llt_names[i];
        var k: string = llt_kinds[i];
        if (k == "struct") {
            var sb: StringBuilder = sb_new();
            sb_append_str(sb, "%st.");
            sb_append_str(sb, name);
            sb_append_str(sb, " = type { ");
            var m: i64 = slice_len(llsf_st) as i64;
            var j: i64 = 0;
            var first: bool = true;
            while (j < m) {
                if (llsf_st[j] == name) {
                    if (first == false) {
                        sb_append_str(sb, ", ");
                    }
                    sb_append_str(sb, ll_td(llsf_td[j]));
                    first = false;
                }
                j = j + 1;
            }
            if (first) {
                sb_append_str(sb, "i8");
            }
            sb_append_str(sb, " }");
            llph(sb_to_str(sb));
        }
        if (k == "variant") {
            var sb2: StringBuilder = sb_new();
            sb_append_str(sb2, "%vt.");
            sb_append_str(sb2, name);
            sb_append_str(sb2, " = type { i64, [");
            sb_append_i64(sb2, ll_variant_paymax(name));
            sb_append_str(sb2, " x i8] }");
            llph(sb_to_str(sb2));
        }
        if (k == "union") {
            var sb3: StringBuilder = sb_new();
            sb_append_str(sb3, "%un.");
            sb_append_str(sb3, name);
            sb_append_str(sb3, " = type { [");
            sb_append_i64(sb3, ll_union_max(name));
            sb_append_str(sb3, " x i8] }");
            llph(sb_to_str(sb3));
        }
        i = i + 1;
    }
}

emit_lldeclares :: func() -> void {
    llph("declare void @tll_print(ptr)");
    llph("declare void @tll_eprint(ptr)");
    llph("declare i64 @tll_str_len(ptr)");
    llph("declare i64 @tll_str_at(ptr, i64)");
    llph("declare i32 @tll_str_eq(ptr, ptr)");
    llph("declare void @tll_str_slice(ptr, i64, i64, ptr)");
    llph("declare ptr @tll_sb_new()");
    llph("declare void @tll_sb_append_str(ptr, ptr)");
    llph("declare void @tll_sb_append_char(ptr, i64)");
    llph("declare void @tll_sb_append_u64(ptr, i64)");
    llph("declare void @tll_sb_append_i64(ptr, i64)");
    llph("declare void @tll_sb_to_str(ptr, ptr)");
    llph("declare void @tll_sb_clear(ptr)");
    llph("declare void @tll_slice_new(i64, ptr)");
    llph("declare void @tll_slice_append(ptr, ptr, i64)");
    llph("declare ptr @tll_slice_at(ptr, i64)");
    llph("declare void @tll_slice_set(ptr, i64, ptr)");
    llph("declare i64 @tll_slice_len(ptr)");
    llph("declare void @tll_file_read_all(ptr, ptr)");
    llph("declare i32 @tll_file_write_all(ptr, ptr)");
    llph("declare void @tll_path_resolve(ptr, ptr)");
    llph("declare void @tll_args(ptr)");
    llph("declare void @tll_exit(i32)");
    llph("declare i32 @tll_system(ptr)");
    llph("declare void @t_runtime_init(i32, ptr)");
    llph("declare ptr @t_arena_new()");
    llph("declare void @t_runtime_set_arena(ptr)");
    llph("declare void @t_runtime_done()");
    llph("");
}

emit_llglobals :: func() -> void {
    var n: i64 = slice_len(llgv_n) as i64;
    var i: i64 = 0;
    while (i < n) {
        var ty: string = ll_td(llgv_td[i]);
        llpg(cat6("@", llgv_n[i], " = global ", ty, " ", ll_zero(ty)));
        i = i + 1;
    }
}

// 全局初始化函数：非常量初始值 + 未初始化 slice 的 elem_size 建立
emit_llginit :: func() -> void {
    ll_reset_fn();
    em_in_fn = false;
    em_cur_fn = "";
    ll_cur_ret = -1;
    var n: i64 = slice_len(llgv_n) as i64;
    var i: i64 = 0;
    while (i < n) {
        var td: i64 = llgv_td[i];
        var ty: string = ll_td(td);
        var gp: string = cat2("@", llgv_n[i]);
        if (llgv_init[i] >= 0) {
            var v: string = emit_lle(llgv_init[i]);
            if (ll_isagg(td)) {
                ll_copy(ty, v, gp);
            } else {
                v = ll_cast_v(v, ll_etd(llgv_init[i]), td);
                llfb(cat6("  store ", ty, " ", v, ", ptr ", gp));
            }
        } else {
            var t: TD = tds[td];
            if (t.cat == "slice") {
                var ety: string = "i64";
                if (t.elem >= 0) {
                    ety = ll_td(t.elem);
                }
                llfb(cat6("  call void @tll_slice_new(i64 ", ll_sizeof(ety), ", ptr ", gp, ")", ""));
            }
        }
        i = i + 1;
    }
    llfb("  ret void");
    llpb("define void @t.__ginit() {");
    llpb("entry:");
    var na: i64 = slice_len(ll_fal) as i64;
    var j: i64 = 0;
    while (j < na) {
        llpb(ll_fal[j]);
        j = j + 1;
    }
    var nb: i64 = slice_len(ll_fb) as i64;
    var j2: i64 = 0;
    while (j2 < nb) {
        llpb(ll_fb[j2]);
        j2 = j2 + 1;
    }
    llpb("}");
    llpb("");
}

emit_llunit :: func(mod: string) -> void {
    build_type_map();
    ll_build_reg();
    llph(cat2("; ModuleID = ", mod));
    llph("%TStr = type { ptr, i64 }");
    llph("%TSlice = type { ptr, i64, i64, i64 }");
    emit_lltypes();
    llph("");
    emit_lldeclares();
    emit_llglobals();
    emit_llginit();

    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var dn: Node = nodes[decl_list[i]];
        if (dn.kind == "FuncDecl") {
            emit_llfunc(decl_list[i]);
        }
        i = i + 1;
    }

    if (ll_has_main) {
        llpb("define i32 @main(i32 %argc, ptr %argv) {");
        llpb("entry:");
        llpb("  call void @t_runtime_init(i32 %argc, ptr %argv)");
        llpb("  %a = call ptr @t_arena_new()");
        llpb("  call void @t_runtime_set_arena(ptr %a)");
        llpb("  call void @t.__ginit()");
        llpb(cat3("  %r = call i32 @t.", ll_main_fn, "()"));
        llpb("  call void @t_runtime_done()");
        llpb("  ret i32 %r");
        llpb("}");
    }
}

ll_join :: func() -> string {
    var sb: StringBuilder = sb_new();
    var n1: i64 = slice_len(ll_head) as i64;
    var i: i64 = 0;
    while (i < n1) {
        sb_append_str(sb, ll_head[i]);
        sb_append_str(sb, "\n");
        i = i + 1;
    }
    var n2: i64 = slice_len(ll_glob) as i64;
    var j: i64 = 0;
    while (j < n2) {
        sb_append_str(sb, ll_glob[j]);
        sb_append_str(sb, "\n");
        j = j + 1;
    }
    sb_append_str(sb, "\n");
    var n3: i64 = slice_len(ll_body) as i64;
    var k: i64 = 0;
    while (k < n3) {
        sb_append_str(sb, ll_body[k]);
        sb_append_str(sb, "\n");
        k = k + 1;
    }
    return sb_to_str(sb);
}

// ── 路径工具 ───────────────────────────────────────────────────

base_no_tc :: func(path: string) -> string {
    var n: u64 = str_len(path);
    var start: u64 = 0;
    var i: u64 = 0;
    while (i < n) {
        if (path[i] == 47 || path[i] == 92) {
            start = i + 1;
        }
        i = i + 1;
    }
    var end: u64 = n;
    if (n >= start + 3) {
        if (path[n - 3] == 46 && path[n - 2] == 116 && path[n - 1] == 99) {
            end = n - 3;
        }
    }
    return str_slice(path, start, end);
}

to_bs :: func(s: string) -> string {
    var sb: StringBuilder = sb_new();
    var i: u64 = 0;
    var n: u64 = str_len(s);
    while (i < n) {
        if (s[i] == 47) {
            sb_append_char(sb, 92);
        } else {
            sb_append_char(sb, s[i]);
        }
        i = i + 1;
    }
    return sb_to_str(sb);
}

// ── lex 子命令（token 池 → JSON，同 tc0 lex --json）────────────

run_lex :: func(file: string) -> i32 {
    var src: string = file_read_all(file);
    tokenize(src);
    var out: StringBuilder = sb_new();
    sb_append_char(out, 91);
    var n: i64 = slice_len(toks) as i64;
    var i: i64 = 0;
    while (i < n) {
        var t: Tok = toks[i];
        if (i > 0) {
            sb_append_char(out, 44);
        }
        sb_append_str(out, "{\"type\":\"");
        sb_append_str(out, t.t);
        sb_append_str(out, "\",\"value\":\"");
        json_escape_into(out, t.v);
        sb_append_str(out, "\",\"line\":");
        sb_append_u64(out, t.line);
        sb_append_str(out, ",\"col\":");
        sb_append_u64(out, t.col);
        sb_append_char(out, 125);
        i = i + 1;
    }
    sb_append_char(out, 93);
    print(sb_to_str(out));
    print("\n");
    return 0;
}

// ── 驱动 main：lex / check / compile 派发 ──────────────────────

main :: func() -> i32 @main {
    var argv: []string = args();
    init_keywords();
    init_node_kinds();
    init_xid();
    if (slice_len(argv) < 3) {
        eprint("usage: tote <lex|check|compile|emit-ll|build|run> <file.tc> [--example <name>] [--output <path>] [--clang <path>] [--runtime <dir>]\n");
        return 2;
    }
    var cmd: string = argv[1];
    var file: string = argv[2];

    if (cmd == "lex") {
        return run_lex(file);
    }

    if (cmd == "check") {
        g_file = path_resolve(file);
        var src: string = file_read_all(file);
        tokenize(src);
        pos = 0;
        init_anndefs();
        parse_unit();
        run_check();
        flag_pass();
        ann_pass();
        print_json();
        if (has_errors()) {
            return 1;
        }
        return 0;
    }

    if (cmd == "compile") {
        var out_dir: string = "";
        var has_out: bool = false;
        var ai: i64 = 3;
        var an: i64 = slice_len(argv) as i64;
        while (ai < an) {
            if (argv[ai] == "--output") {
                if (ai + 1 < an) {
                    out_dir = argv[ai + 1];
                    has_out = true;
                    ai = ai + 2;
                    continue;
                }
            }
            ai = ai + 1;
        }

        g_file = path_resolve(file);
        var src2: string = file_read_all(file);
        tokenize(src2);
        pos = 0;
        init_anndefs();
        parse_unit();
        run_check();
        flag_pass();
        ann_pass();
        if (has_errors()) {
            return 1;
        }

        var mod: string = base_no_tc(file);
        emit_unit(mod);

        if (has_out == false) {
            // dirname(file)：截到最后一个分隔符；无分隔符 → 当前目录
            var nn: u64 = str_len(file);
            var cut: u64 = 0;
            var pi: u64 = 0;
            while (pi < nn) {
                if (file[pi] == 47 || file[pi] == 92) {
                    cut = pi;
                }
                pi = pi + 1;
            }
            if (cut > 0) {
                out_dir = str_slice(file, 0, cut);
            } else {
                out_dir = ".";
            }
        }

        var hp: string = cat4(out_dir, "/", mod, ".h");
        var cp: string = cat4(out_dir, "/", mod, ".c");
        file_write_all(hp, h_join());
        file_write_all(cp, s_join());
        print(cat6("Generated: ", to_bs(hp), ", ", to_bs(cp), "\n", ""));
        return 0;
    }

    if (cmd == "emit-ll" || cmd == "build" || cmd == "run") {
        var out_p: string = "";
        var has_outp: bool = false;
        var rt_dir: string = "runtime";
        var clang_p: string = "clang";
        var src_file: string = "";
        var has_src: bool = false;
        var ex_name: string = "";
        var is_example: bool = false;
        var ai2: i64 = 2;
        var an2: i64 = slice_len(argv) as i64;
        while (ai2 < an2) {
            if (argv[ai2] == "--output") {
                if (ai2 + 1 < an2) {
                    out_p = argv[ai2 + 1];
                    has_outp = true;
                    ai2 = ai2 + 2;
                    continue;
                }
            }
            if (argv[ai2] == "--runtime") {
                if (ai2 + 1 < an2) {
                    rt_dir = argv[ai2 + 1];
                    ai2 = ai2 + 2;
                    continue;
                }
            }
            if (argv[ai2] == "--clang") {
                if (ai2 + 1 < an2) {
                    clang_p = argv[ai2 + 1];
                    ai2 = ai2 + 2;
                    continue;
                }
            }
            if (argv[ai2] == "--example") {
                if (ai2 + 1 < an2) {
                    ex_name = argv[ai2 + 1];
                    is_example = true;
                    ai2 = ai2 + 2;
                    continue;
                }
            }
            // 位置参数：第一个非 flag 即源文件
            if (has_src == false) {
                src_file = argv[ai2];
                has_src = true;
            }
            ai2 = ai2 + 1;
        }

        // cargo 风格 example：源 = examples/<name>.tc，产物 = build/examples/<name>.exe
        if (is_example) {
            var probe: string = cat4("cmd /c if exist \"examples\\", ex_name, ".tc\" (exit 0) else (exit 1)", "");
            var prc: i32 = sys_run(probe);
            if (prc != 0) {
                eprint(cat3("error: no example named `", ex_name, "`\navailable examples:\n"));
                sys_run("cmd /c dir /b examples\\*.tc 2>nul");
                return 2;
            }
            src_file = cat3("examples/", ex_name, ".tc");
            has_src = true;
            if (has_outp == false) {
                sys_run("cmd /c if not exist \"build\\examples\" mkdir \"build\\examples\"");
                out_p = cat2("build/examples/", ex_name);
                has_outp = true;
            }
        }
        if (has_src == false) {
            eprint("usage: tote build|run <file.tc> | --example <name>\n");
            return 2;
        }

        // 缺省 clang：PATH 上没有时探测标准安装路径
        if (clang_p == "clang") {
            var crc: i32 = sys_run("cmd /c if exist \"C:\\Program Files\\LLVM\\bin\\clang.exe\" (exit 0) else (exit 1)");
            if (crc == 0) {
                clang_p = "C:/Program Files/LLVM/bin/clang.exe";
            }
        }

        g_file = path_resolve(src_file);
        var src3: string = file_read_all(src_file);
        tokenize(src3);
        pos = 0;
        init_anndefs();
        parse_unit();
        run_check();
        flag_pass();
        ann_pass();
        if (has_errors()) {
            return 1;
        }

        var mod2: string = base_no_tc(src_file);
        emit_llunit(mod2);

        // 输出目录：--output 指定 exe/目录前缀；缺省用源文件所在目录
        var out_dir2: string = "";
        if (has_outp == false) {
            var nn2: u64 = str_len(src_file);
            var cut2: u64 = 0;
            var pi2: u64 = 0;
            while (pi2 < nn2) {
                if (src_file[pi2] == 47 || src_file[pi2] == 92) {
                    cut2 = pi2;
                }
                pi2 = pi2 + 1;
            }
            if (cut2 > 0) {
                out_dir2 = str_slice(src_file, 0, cut2);
            } else {
                out_dir2 = ".";
            }
            out_p = cat4(out_dir2, "/", mod2, "");
        }

        var llp: string = cat2(out_p, ".ll");
        file_write_all(llp, ll_join());
        print(cat3("Generated: ", to_bs(llp), "\n"));

        if (cmd == "emit-ll") {
            return 0;
        }

        // build：调 clang 一步链接 runtime 出 exe
        var exep: string = cat2(out_p, ".exe");
        var csb2: StringBuilder = sb_new();
        sb_append_str(csb2, "\"");
        sb_append_str(csb2, clang_p);
        sb_append_str(csb2, "\" -O1 -o \"");
        sb_append_str(csb2, exep);
        sb_append_str(csb2, "\" \"");
        sb_append_str(csb2, llp);
        sb_append_str(csb2, "\" \"");
        sb_append_str(csb2, rt_dir);
        sb_append_str(csb2, "/t_runtime.c\" \"");
        sb_append_str(csb2, rt_dir);
        sb_append_str(csb2, "/t_shim_ll.c\" -I \"");
        sb_append_str(csb2, rt_dir);
        sb_append_str(csb2, "\"");
        var rc: i32 = sys_run(sb_to_str(csb2));
        if (rc != 0) {
            eprint("clang link failed\n");
            return 1;
        }
        print(cat3("Built: ", to_bs(exep), "\n"));

        // run：构建成功后立即执行，透传子进程退出码（cargo run 语义）
        if (cmd == "run") {
            var run_cmd: string = cat3("\"", to_bs(exep), "\"");
            var rrc: i32 = sys_run(run_cmd);
            return rrc;
        }
        return 0;
    }

    eprint("unknown command\n");
    return 2;
}
