// Phase C POC library: globals needing runtime init (bool/int/string).
// Function-value globals intentionally omitted — they hit a pre-existing
// tir_emit_ginit codegen bug (store-into-self) unrelated to Phase C, and the
// compiler's internal src modules contain no such globals.
pub var g_flag: bool = true;
pub var g_num: i64 = 42;
pub var g_str: string = "hello";

pub fn read_globals() string {
    var s: string = "num=" + int_to_str(g_num) + " str=" + g_str;
    if (g_flag) { s = s + " flag=1"; }
    return s;
}
