// ═════════════════════════════════════════════════════════════
// src/hir.tc — HIR（ZIR 槽位）：未定型 · 线性 · 可序列化
//
// 由 AstGen 在 sema **之前** 从 CST 降级产出（docs/compiler/hir-design.md）：
//   - 未定型（pre-type）：type_expr 只存「未解析名字引用」文本，绝不存 TD。
//   - 线性（linear）：每个函数体 = 扁平指令数组；表达式降级到显式临时槽。
//   - 可序列化（serializable）：hir_to_text（diff 友好）+ hir_to_bin（缓存）。
//     缓存键 = 源内容哈希（含编译器版本戳），见 hir_hash。
//
// 依赖：base（读 base.nodes / base.kids）+ lex（读 decl_list 作为顶层声明工作集）。
// 无反向引用，DAG 安全。
//
// 逃生舱：任何未被显式降级的节点种类 → HIR_OP_RAW（dst = CST 节点 id，sa = kind）。
// Stage B（sema 消费 HIR）要求 RAW 归零：sema 的遍历与分派**只认 op**，
// 语义体仍可经 `nd`（每条指令携带的源 CST 节点 id）回到节点做变更/诊断。
// ═════════════════════════════════════════════════════════════

const base = @import("src.base");
const lex = @import("src.lex");

// ── 操作码（与 tir.tc 的 TIR_OP_* 同范式：pub const i64）────────
pub const HIR_OP_INVALID: i64 = 0;
pub const HIR_OP_LIT_INT: i64 = 1;
pub const HIR_OP_LIT_FLOAT: i64 = 2;
pub const HIR_OP_LIT_STR: i64 = 3;
pub const HIR_OP_LIT_BOOL: i64 = 4;
pub const HIR_OP_LIT_NULL: i64 = 5;
pub const HIR_OP_LOCAL_DECL: i64 = 6;   // sa=名字, ty=未解析类型, args[0]=初始化 inst(-1=无)
pub const HIR_OP_LOCAL_REF: i64 = 7;    // sa=名字
pub const HIR_OP_PARAM_REF: i64 = 8;    // sa=名字
pub const HIR_OP_CALL: i64 = 9;         // sa=被调名(未解析), args=实参 inst
pub const HIR_OP_METHOD_CALL: i64 = 10; // sa=方法名, args[0]=接收者 inst, args[1..]=实参
pub const HIR_OP_BINOP: i64 = 11;       // sa=运算符, args=[l, r]
pub const HIR_OP_UNOP: i64 = 12;        // sa=运算符, args=[x]
pub const HIR_OP_FIELD_REF: i64 = 13;   // sa=字段名, args[0]=基 inst
pub const HIR_OP_FIELD_SET: i64 = 14;   // sa=字段名, args=[base, val]
pub const HIR_OP_INDEX_REF: i64 = 15;   // args=[base, idx]
pub const HIR_OP_INDEX_SET: i64 = 16;   // args=[base, idx, val]
pub const HIR_OP_CONSTRUCT: i64 = 17;   // ty=类型 expr, sa=字段名 csv, args=值 inst
pub const HIR_OP_IF: i64 = 18;          // args=[cond, then_blk, else_blk(-1=无)]
pub const HIR_OP_BLOCK: i64 = 19;       // args=本块内 inst
pub const HIR_OP_LOOP: i64 = 20;        // while：args=[cond(-1=无限), body_blk]
pub const HIR_OP_RETURN: i64 = 21;      // args[0]=值 inst(-1=void)
pub const HIR_OP_BREAK: i64 = 22;
pub const HIR_OP_CONTINUE: i64 = 23;
pub const HIR_OP_CAST: i64 = 24;        // ty=目标类型, args[0]=值 inst
pub const HIR_OP_RAW: i64 = 25;         // 逃生舱：nd=CST 节点 id, sa=kind
// decl 级
pub const HIR_OP_FN_DECL: i64 = 26;     // sa=名字, ty=返回类型 expr, args=[参数 decl..., body_blk]
pub const HIR_OP_STRUCT_DECL: i64 = 27; // sa=名字, args=字段 decl
pub const HIR_OP_ENUM_DECL: i64 = 28;   // sa=名字, args=变体 decl
pub const HIR_OP_UNION_DECL: i64 = 29;  // sa=名字, args=字段 decl
pub const HIR_OP_CONST_DECL: i64 = 30;  // sa=名字, ty, args[0]=初始化 inst
pub const HIR_OP_GLOBAL_DECL: i64 = 31; // sa=名字, ty, args[0]=初始化 inst, ba=isExtern
pub const HIR_OP_IMPORT_DECL: i64 = 32; // sa=路径/模块名, sb=别名
pub const HIR_OP_TYPE_ALIAS_DECL: i64 = 33; // sa=名字, ty
pub const HIR_OP_FLAG_DECL: i64 = 34;
pub const HIR_OP_FLAGSET_DECL: i64 = 35;
pub const HIR_OP_VARIANT_DECL: i64 = 36; // sa=名字, ia=tag
pub const HIR_OP_PARAM_DECL: i64 = 37;  // sa=名字, ty
pub const HIR_OP_FIELD_DECL: i64 = 38;  // sa=名字, ty
pub const HIR_OP_MODULE_DECL: i64 = 39; // sa=属性串
pub const HIR_OP_CLOSURE_MAKE: i64 = 40; // sa=合成名, args=捕获 inst
pub const HIR_OP_LAMBDA: i64 = 41;      // args=[参数 decl..., body_blk]
pub const HIR_OP_ASSIGN: i64 = 42;      // sa=目标变量名, args=[目标 ref, 值]（普通变量赋值）
pub const HIR_OP_ARRAY: i64 = 43;       // args=元素 inst（数组字面量，pre-type）
// Stage B 新增（RAW 归零：sema 消费所需的表达式/语句种类）
pub const HIR_OP_LIT_ATOM: i64 = 44;    // sa=atom 名（`@name` 里的 name）
pub const HIR_OP_LIT_FID: i64 = 45;     // sa=文件描述符常量名（stdin/stdout/stderr）
pub const HIR_OP_MBUILTIN: i64 = 46;    // sa=@内建名, args=实参 inst（类型实参走 TYPE_REF）
pub const HIR_OP_TYPE_REF: i64 = 47;    // 「类型即值」位置的名字引用（sa=类型文本）
pub const HIR_OP_MATCH: i64 = 48;       // args=[scrutinee, arm...]
pub const HIR_OP_MATCH_ARM: i64 = 49;   // sa=绑定名, ba=通配, args=[pat(-1), guard(-1), body]
pub const HIR_OP_MAP_LIT: i64 = 50;     // args=entry inst
pub const HIR_OP_MAP_ENTRY: i64 = 51;   // args=[key, val]
pub const HIR_OP_ADDR: i64 = 52;        // `&x`：args=[operand]
pub const HIR_OP_DEREF: i64 = 53;       // `*x`：args=[operand]
pub const HIR_OP_RANGE: i64 = 54;       // args=[lo(-1=省略), hi(-1=省略)], ba=是否闭合..=
pub const HIR_OP_OPT_NONE: i64 = 55;    // `?` 可选类型的 none 字面量
pub const HIR_OP_TYPEINFO: i64 = 56;    // `@typeinfo` 一类「类型即值」表达式
pub const HIR_OP_PIPE: i64 = 57;        // sa=map|filter|apply, args=[lhs, rhs]
pub const HIR_OP_DEFER: i64 = 58;       // args=[body_blk]
pub const HIR_OP_COMPTIME: i64 = 59;    // args=[expr 或 body_blk]
pub const HIR_OP_FOR: i64 = 60;         // C 式 for：args=[init(-1), cond(-1), upd(-1), body_blk]
pub const HIR_OP_FORIN: i64 = 61;       // sa=迭代变量, ty=第二变量(双变量 map 迭代), args=[iter, body_blk]
pub const HIR_OP_CAPTURE: i64 = 62;     // 闭包体首的捕获变量重建：sa=名字, ty=类型
pub const HIR_OP_EXPR_STMT: i64 = 63;   // 表达式语句：args=[expr]（与「表达式作为值」区分）
pub const HIR_OP_CONPAT: i64 = 64;      // match 构造器模式：sa=构造器名, ty=限定名, args=子模式
pub const HIR_OP_SLICE_PAT: i64 = 65;   // match 切片/数组模式：args=[rest_pos, count, 元素模式...]（rest 元素不入 args）

// ── 数据结构 ─────────────────────────────────────────────────
pub struct HirInst {
    op: i64;
    dst: i64;       // 结果临时槽（-1=无）
    nd: u64;       // 源 CST 节点引用 NodeRef（sema 桥；合成指令为 hir_nd_none()）
    args: []i64;    // 操作数 inst 索引（-1 = null/空）
    sa: string;     // 名字/运算符/被调名/字段名/未解析类型文本等
    ty: string;     // 未解析类型 expr 文本（pre-type；空 = N/A）
    ba: bool;       // 通用布尔位（GLOBAL_DECL 的 isExtern / RANGE 的闭合 等）
    line: u64;
}

pub struct HirModule {
    insts: []HirInst;
    decls: []i64;        // 顶层 decl inst 索引（顺序保留）
    src_hash: string;    // 缓存键 = 源内容哈希（含编译器版本戳）
    file: string;
    node_to_hir: []i64;  // CST 节点 id → HIR inst 索引（-1 = 未映射），sema 桥
}

pub var g_hir: HirModule;
pub var g_hir_next: i64;        // 临时槽计数器
pub var g_last_src: string = ""; // 最近一次 AstGen 的源文本（sema 期重建 HIR 复用）
pub const HIR_VERSION: string = "hir-v2";
// 合成指令的源节点占位（等价旧 i64 哨兵 -1；nd 已升为 u64 NodeRef）。
// 用函数而非 `pub const`：模块级 u64 常量高位被置位会被发射成 `i64 0xFFFFFFFFFFFFFFFF`（超 i64 有符号上界），clang 拒收；
// `-1 as u64` 实测发射为合法的 `i64 -1`（LLVM 底层 u64==i64，位模式全 1 不变），既绕开发射 bug 又保持序列化逐字节等价。
pub fn hir_nd_none() u64 { return -1 as u64; }

pub fn hir_reset() void {
    g_hir.insts = [];
    g_hir.decls = [];
    g_hir.src_hash = "";
    g_hir.file = "";
    g_hir.node_to_hir = [];
    var n: i64 = slice_len(base.nodes) as i64;
    var i: i64 = 0;
    while (i < n) { append(g_hir.node_to_hir, -1); i = i + 1; }
    g_hir_next = 0;
}

// node_to_hir 与 base.nodes 等长（脱糖期新增节点时由 hir_grow 补齐）。
pub fn hir_grow() void {
    var n: i64 = slice_len(base.nodes) as i64;
    while (slice_len(g_hir.node_to_hir) as i64 < n) { append(g_hir.node_to_hir, -1); }
}

pub fn hir_emit(op: i64, dst: i64, nd: i64, args: []i64, sa: string, ty: string, line: u64) i64 {
    var inst: HirInst;
    inst.op = op;
    inst.dst = dst;
    inst.nd = nd;
    inst.args = args;
    inst.sa = sa;
    inst.ty = ty;
    inst.line = line;
    append(g_hir.insts, inst);
    return (slice_len(g_hir.insts) as i64) - 1;
}

pub fn hir_slot() i64 {
    var s: i64 = g_hir_next;
    g_hir_next = g_hir_next + 1;
    return s;
}

// ── sema 桥 ──────────────────────────────────────────────────
// sema 消费 HIR 的两条必经通道：节点 → inst（进入 HIR）、inst → 节点（回到 CST
// 做变更 / 诊断）。越界一律 -1（合成节点没有 HIR，sema 回落 CST 路径）。
pub fn hir_of_node(n: i64) i64 {
    if (n < 0) { return -1; }
    if (n >= slice_len(g_hir.node_to_hir) as i64) { return -1; }
    return g_hir.node_to_hir[n];
}

// 语义期**就地**改写节点（降解成 paren/block 等）后，该节点对应的 HIR 指令即失效：
// op 反映的是改写前的语法意图。断开映射，让后续分派回落 CST kind —— 否则 sema 会
// 按「改写前」的语义标签再走一遍（区间/管道降解正是靠重复 infer 幂等收口的）。
pub fn hir_invalidate(n: i64) void {
    if (n < 0) { return; }
    if (n >= slice_len(g_hir.node_to_hir) as i64) { return; }
    g_hir.node_to_hir[n] = -1;
}

pub fn hir_inst_node(i: i64) i64 {
    if (i < 0) { return -1; }
    if (i >= slice_len(g_hir.insts) as i64) { return -1; }
    var inst: HirInst = g_hir.insts[i];
    return inst.nd as i64;   // 经 as 收窄回 i64 节点 id：迁移期 NodeRef==裸索引，逐位等价（哨兵 HIR_ND_NONE 收窄回 -1）
}

pub fn hir_op_of(i: i64) i64 {
    if (i < 0) { return HIR_OP_INVALID; }
    if (i >= slice_len(g_hir.insts) as i64) { return HIR_OP_INVALID; }
    var inst: HirInst = g_hir.insts[i];
    return inst.op;
}

// 第 k 个操作数（inst 索引；越界/空 = -1）
pub fn hir_arg(i: i64, k: i64) i64 {
    if (i < 0) { return -1; }
    if (i >= slice_len(g_hir.insts) as i64) { return -1; }
    var inst: HirInst = g_hir.insts[i];
    if (k < 0) { return -1; }
    if (k >= slice_len(inst.args) as i64) { return -1; }
    return inst.args[k];
}

// 第 k 个操作数的源节点 id（-1 = 无）
pub fn hir_arg_node(i: i64, k: i64) i64 {
    return hir_inst_node(hir_arg(i, k));
}

// ── op → 语义标签（sema 的分派键）─────────────────────────────
// Stage B：infer_expr 的分支不再看 `node.kind`，而是看 HIR 指令给出的标签。
// 返回 "" = 本 op 不提供标签（委托节点 / 需按 kind 细分者），sema 回落 CST kind。
pub fn hir_tag_of_op(op: i64) string {
    if (op == HIR_OP_LIT_INT) { return "int"; }
    if (op == HIR_OP_LIT_FLOAT) { return "float"; }
    if (op == HIR_OP_LIT_STR) { return "string"; }
    if (op == HIR_OP_LIT_BOOL) { return "bool"; }
    if (op == HIR_OP_LIT_NULL) { return "null"; }
    if (op == HIR_OP_LIT_ATOM) { return "atom"; }
    if (op == HIR_OP_LIT_FID) { return "fidconst"; }
    if (op == HIR_OP_LOCAL_REF) { return "ident"; }
    if (op == HIR_OP_CALL) { return "call"; }
    if (op == HIR_OP_BINOP) { return "binary"; }
    if (op == HIR_OP_UNOP) { return "unary"; }
    if (op == HIR_OP_FIELD_REF) { return "member"; }
    if (op == HIR_OP_INDEX_REF) { return "index"; }
    if (op == HIR_OP_CONSTRUCT) { return "struct_lit"; }
    if (op == HIR_OP_ARRAY) { return "array_lit"; }
    if (op == HIR_OP_MAP_LIT) { return "map_lit"; }
    if (op == HIR_OP_CAST) { return "cast"; }
    if (op == HIR_OP_RANGE) { return "range"; }
    if (op == HIR_OP_ADDR) { return "amp"; }
    if (op == HIR_OP_DEREF) { return "deref"; }
    if (op == HIR_OP_OPT_NONE) { return "opt_none"; }
    if (op == HIR_OP_TYPEINFO) { return "typeinfo"; }
    if (op == HIR_OP_MBUILTIN) { return "mbuiltin"; }
    if (op == HIR_OP_MATCH) { return "match"; }
    if (op == HIR_OP_CLOSURE_MAKE) { return "closure_make"; }
    if (op == HIR_OP_LAMBDA) { return "lambda"; }
    if (op == HIR_OP_COMPTIME) { return "comptime"; }
    // ASSIGN（assign/assignment 需按 kind 细分）、PIPE（map/filter/apply 按 kind 细分）、
    // TYPE_REF / MAP_ENTRY / 子模式等：一律回落 CST kind。
    return "";
}

pub fn hir_arg_count(i: i64) i64 {
    if (i < 0) { return 0; }
    if (i >= slice_len(g_hir.insts) as i64) { return 0; }
    var inst: HirInst = g_hir.insts[i];
    return slice_len(inst.args) as i64;
}

// 子节点列表（Child 池）展开为 val 索引数组
pub fn hir_list(head: i64) []i64 {
    var out: []i64 = [];
    var c: i64 = head;
    while (c >= 0) {
        var kc: base.Child = base.kids[c];
        append(out, kc.val);
        c = kc.next;
    }
    return out;
}

// 未解析类型 expr 文本（pre-type：只保留语法意图，不解析名字）
pub fn hir_type_text(tn: i64) string {
    if (tn < 0) { return ""; }
    var n: base.Node = base.nodes[tn];
    var k: string = base.node_kind((tn as u64));
    if (k == "scalar" || k == "ident" || k == "named" || k == "atom") { return base.node_sa((tn as u64)); }
    if (k == "sym") { return base.sb_cat2("@", base.node_sa((tn as u64))); }
    if (k == "pointer") { return base.sb_cat3("ptr<", hir_type_text(base.node_na((tn as u64))), ">"); }
    if (k == "slice") { return base.sb_cat3("[]", hir_type_text(base.node_na((tn as u64))), ""); }
    if (k == "array") { return base.sb_cat3(base.sb_cat2("[", base.node_sa((tn as u64))), "]", hir_type_text(base.node_na((tn as u64)))); }
    if (k == "optional") { return base.sb_cat2("?", hir_type_text(base.node_na((tn as u64)))); }
    if (k == "amp") { return base.sb_cat2("&", hir_type_text(base.node_na((tn as u64)))); }
    if (k == "func_type") {
        var ps: []i64 = hir_list(base.node_la((tn as u64)));
        var s: string = "fn(";
        var i: i64 = 0;
        while (i < slice_len(ps) as i64) {
            if (i > 0) { s = base.sb_cat2(s, ","); }
            s = base.sb_cat2(s, hir_type_text(base.node_na((ps[i] as u64))));
            i = i + 1;
        }
        return base.sb_cat3(s, ")", hir_type_text(base.node_na((tn as u64))));
    }
    if (k == "member") { return base.sb_cat3(hir_type_text(base.node_na((tn as u64))), ".", base.node_sa((tn as u64))); }
    // 硬件 SIMD 类型位（@Vector / @Tile）：na=元素类型，nb/nc=长度/行列表达式，nd=flavor。
    // 必须忠实重建源码文本，否则 HIR 把类型名吞成 "<type>"，脱离 CST 缓存后 Sema 无法解析
    // （设计 hir-design.md §4：type_expr = 全部「未解析」引用，HIR 须独立于类型系统）。
    if (k == "vector") { return base.sb_cat3(base.sb_cat3("@Vector(", hir_type_text(base.node_nb((tn as u64))), ", "), hir_type_text(base.node_na((tn as u64))), ")"); }
    // S4 §0.14.7 SoA：@Tile 的 flavor 槽走侧表读（原 n.nd）
    if (k == "tile") { return base.sb_cat3(base.sb_cat3(base.sb_cat3(base.sb_cat3("@Tile(", hir_type_text(base.node_nb((tn as u64))), ", "), hir_type_text(base.node_nc((n.id as u64))), ", "), hir_type_text(base.node_na((tn as u64))), ", "), hir_type_text(base.node_nd((tn as u64))), ")"); }
    if (base.node_sa((tn as u64)) != "") { return base.node_sa((tn as u64)); }
    return "<type>";
}

// ── 顶层入口 ─────────────────────────────────────────────────
pub fn hir_is_decl(k: string) bool {
    if (k == "FuncDecl") { return true; }
    if (k == "StructDecl") { return true; }
    if (k == "EnumDecl") { return true; }
    if (k == "UnionDecl") { return true; }
    if (k == "GlobalConstDecl") { return true; }
    if (k == "GlobalVarDecl") { return true; }
    if (k == "TypeAliasDecl") { return true; }
    if (k == "ImportDecl") { return true; }
    if (k == "ImportModDecl") { return true; }
    if (k == "ModuleDecl") { return true; }
    if (k == "FlagDecl") { return true; }
    if (k == "FlagSetDecl") { return true; }
    if (k == "VariantDecl") { return true; }
    return false;
}

// AstGen：parse 之后、sema 之前调用。src = 当前文件内容（算缓存键）。
//
// ⚠ 顶层声明工作集取自 `lex.decl_list`（而非「全节点扫 decl kind」）：
//   - decl_list 才是 sema 的真实工作集（模块内联/脱糖的新声明都追加在这里）；
//   - 全节点扫描会把**嵌套**的同类节点（如 enum 的变体节点）误当顶层声明，
//     注册进符号表即凭空多出符号、甚至触发重复定义。
pub fn hir_build(src: string) HirModule {
    hir_reset();
    g_hir.src_hash = hir_hash(src);
    g_hir.file = base.g_file;
    g_last_src = src;
    var n: i64 = slice_len(lex__decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = lex__decl_list[i];
        if (g_hir.node_to_hir[d] < 0) {
            var idx: i64 = hir_lower_decl(d);
            if (idx >= 0) { append(g_hir.decls, idx); }
        }
        i = i + 1;
    }
    return g_hir;
}

// 增量补降：脱糖期新增的声明（__fmt_N / __pipe_N / __import_N / 提升的 lambda）
// 在首次 build 之后才进 decl_list，sema 主检查循环靠它把新声明拾进 g_hir.decls。
// 返回本次新增的 decl 数量（0 = 不动点）。
pub fn hir_sync() i64 {
    hir_grow();
    var added: i64 = 0;
    var n: i64 = slice_len(lex__decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = lex__decl_list[i];
        if (d >= 0 && g_hir.node_to_hir[d] < 0) {
            var idx: i64 = hir_lower_decl(d);
            if (idx >= 0) { append(g_hir.decls, idx); added = added + 1; }
        }
        i = i + 1;
    }
    return added;
}

// 管线真实产物：parse 后跑一次，存 g_hir（后续阶段/缓存消费）。
pub fn hir_run(src: string) i64 {
    hir_build(src);
    return 0;
}

// ── decl 降级 ────────────────────────────────────────────────
pub fn hir_lower_decl(d: i64) i64 {
    if (d < 0) { return -1; }
    if (g_hir.node_to_hir[d] >= 0) { return g_hir.node_to_hir[d]; }
    var n: base.Node = base.nodes[d];
    var k: string = base.node_kind((d as u64));
    var idx: i64 = -1;
    if (k == "FuncDecl") {
        idx = hir_lower_funcdecl(d);
    } else if (k == "StructDecl") {
        var fields: []i64 = hir_list(base.node_lb((d as u64)));
        var fargs: []i64 = [];
        var fi: i64 = 0;
        while (fi < slice_len(fields) as i64) {
            var vn: base.Node = base.nodes[fields[fi]];
            var fd: i64 = hir_emit(HIR_OP_FIELD_DECL, -1, fields[fi], [], base.node_sa((fields[fi] as u64)), hir_type_text(base.node_na((fields[fi] as u64))), base.node_span_id(vn.id).line);
            append(fargs, fd);
            fi = fi + 1;
        }
        idx = hir_emit(HIR_OP_STRUCT_DECL, -1, d, fargs, base.node_sa((d as u64)), "", base.node_span_id(n.id).line);
    } else if (k == "EnumDecl") {
        var vs: []i64 = hir_list(base.node_lb((d as u64)));
        var vargs: []i64 = [];
        var vi: i64 = 0;
        while (vi < slice_len(vs) as i64) {
            var vcn: base.Node = base.nodes[vs[vi]];
            var vd: i64 = hir_emit(HIR_OP_VARIANT_DECL, -1, vs[vi], [], base.node_sa((vs[vi] as u64)), "", base.node_span_id(vcn.id).line);
            append(vargs, vd);
            vi = vi + 1;
        }
        idx = hir_emit(HIR_OP_ENUM_DECL, -1, d, vargs, base.node_sa((d as u64)), "", base.node_span_id(n.id).line);
    } else if (k == "UnionDecl") {
        var fields: []i64 = hir_list(base.node_lb((d as u64)));
        var fargs: []i64 = [];
        var fi: i64 = 0;
        while (fi < slice_len(fields) as i64) {
            var vn: base.Node = base.nodes[fields[fi]];
            var fd: i64 = hir_emit(HIR_OP_FIELD_DECL, -1, fields[fi], [], base.node_sa((fields[fi] as u64)), hir_type_text(base.node_na((fields[fi] as u64))), base.node_span_id(vn.id).line);
            append(fargs, fd);
            fi = fi + 1;
        }
        idx = hir_emit(HIR_OP_UNION_DECL, -1, d, fargs, base.node_sa((d as u64)), "", base.node_span_id(n.id).line);
    } else if (k == "GlobalConstDecl" || k == "GlobalVarDecl") {
        // 模块值别名 `const X = @import("src.X")` / `var X = @import("src.X")`：
        // 编译期导入别名，运行期无实体。降级为 IMPORT_DECL（与 ImportModDecl 同款 op），
        // 不产生 RAW 逃生舱。sema 仍据 AST 的 import_expr 节点识别模块值（is_modval_import_decl）。
        if (base.node_nb((d as u64)) >= 0 && base.node_kind((base.node_nb((d as u64)) as u64)) == "import_expr") {
            idx = hir_emit(HIR_OP_IMPORT_DECL, -1, d, [], base.node_sa((base.node_nb((d as u64)) as u64)), base.node_sa((d as u64)), base.node_span_id(n.id).line);
            g_hir.node_to_hir[d] = idx;
            return idx;
        }
        var init: i64 = -1;
        if (base.node_nb((d as u64)) >= 0) { init = hir_lower_expr(base.node_nb((d as u64))); }
        idx = hir_emit(HIR_OP_GLOBAL_DECL, -1, d, [init], base.node_sa((d as u64)), hir_type_text(base.node_na((d as u64))), base.node_span_id(n.id).line);
        if (idx >= 0) { var ii: i64 = slice_len(g_hir.insts) as i64 - 1; g_hir.insts[ii].ba = base.node_bb((d as u64)); }   // S4 §0.14.7 SoA：侧表读（原 n.bb）
    } else if (k == "TypeAliasDecl") {
        idx = hir_emit(HIR_OP_TYPE_ALIAS_DECL, -1, d, [], base.node_sa((d as u64)), hir_type_text(base.node_na((d as u64))), base.node_span_id(n.id).line);
    } else if (k == "ImportDecl") {
        idx = hir_emit(HIR_OP_IMPORT_DECL, -1, d, [], base.node_sb((n.id as u64)), base.node_sc((d as u64)), base.node_span_id(n.id).line);
    } else if (k == "ImportModDecl") {
        idx = hir_emit(HIR_OP_IMPORT_DECL, -1, d, [], base.node_sb((n.id as u64)), base.node_sc((d as u64)), base.node_span_id(n.id).line);
    } else if (k == "ModuleDecl") {
        idx = hir_emit(HIR_OP_MODULE_DECL, -1, d, [], base.node_sa((d as u64)), "", base.node_span_id(n.id).line);
    } else if (k == "FlagDecl") {
        idx = hir_emit(HIR_OP_FLAG_DECL, -1, d, [], base.node_sa((d as u64)), "", base.node_span_id(n.id).line);
    } else if (k == "FlagSetDecl") {
        idx = hir_emit(HIR_OP_FLAGSET_DECL, -1, d, [], base.node_sa((d as u64)), "", base.node_span_id(n.id).line);
    } else if (k == "VariantDecl") {
        idx = hir_emit(HIR_OP_VARIANT_DECL, -1, d, [], base.node_sa((d as u64)), "", base.node_span_id(n.id).line);
    } else {
        idx = hir_emit(HIR_OP_RAW, d, d, [], base.node_kind((d as u64)), "", base.node_span_id(n.id).line);
    }
    if (idx >= 0) { g_hir.node_to_hir[d] = idx; }
    return idx;
}

pub fn hir_lower_funcdecl(d: i64) i64 {
    var n: base.Node = base.nodes[d];
    var params: []i64 = hir_list(base.node_lb((d as u64)));
    var pargs: []i64 = [];
    var pi: i64 = 0;
    while (pi < slice_len(params) as i64) {
        var pn: base.Node = base.nodes[params[pi]];
        var pd: i64 = hir_emit(HIR_OP_PARAM_DECL, -1, params[pi], [], base.node_sa((params[pi] as u64)), hir_type_text(base.node_na((params[pi] as u64))), base.node_span_id(pn.id).line);
        append(pargs, pd);
        pi = pi + 1;
    }
    // n.lc 是语句子列表头（kids 池索引），不是单节点；用 stmt_list 降级为 BLOCK。
    var body: i64 = -1;
    if (base.node_lc((n.id as u64)) >= 0) { body = hir_lower_stmt_list(base.node_lc((n.id as u64))); }
    var all: []i64 = pargs;
    append(all, body);
    var idx: i64 = hir_emit(HIR_OP_FN_DECL, -1, d, all, base.node_sa((d as u64)), hir_type_text(base.node_na((d as u64))), base.node_span_id(n.id).line);
    g_hir.node_to_hir[d] = idx;
    return idx;
}

// ── 语句降级 ────────────────────────────────────────────────
pub fn hir_lower_stmt_list(head: i64) i64 {
    var ss: []i64 = hir_list(head);
    var args: []i64 = [];
    var i: i64 = 0;
    while (i < slice_len(ss) as i64) {
        var st: i64 = hir_lower_stmt(ss[i]);
        if (st >= 0) { append(args, st); }
        i = i + 1;
    }
    return hir_emit(HIR_OP_BLOCK, -1, -1, args, "", "", 0);
}

pub fn hir_lower_stmt(n: i64) i64 {
    if (n < 0) { return -1; }
    var nd: base.Node = base.nodes[n];
    var k: string = base.node_kind((n as u64));
    if (k == "block") {
        var ss: []i64 = hir_list(base.node_la((n as u64)));
        var args: []i64 = [];
        var i: i64 = 0;
        while (i < slice_len(ss) as i64) {
            var st: i64 = hir_lower_stmt(ss[i]);
            if (st >= 0) { append(args, st); }
            i = i + 1;
        }
        return hir_emit(HIR_OP_BLOCK, -1, n, args, "", "", base.node_span_id(nd.id).line);
    }
    // 表达式语句必须自己是一条指令：否则 stmt 节点在 node_to_hir 里没有映射，
    // sema 的语句级分派会整体掉回 CST 路径（而表达式语句恰恰是最常见的语句形态）。
    if (k == "expr") {
        var ev: i64 = hir_lower_expr(base.node_na((n as u64)));
        return hir_emit(HIR_OP_EXPR_STMT, -1, n, [ev], "", "", base.node_span_id(nd.id).line);
    }
    if (k == "var_decl") {
        var init: i64 = -1;
        if (base.node_nb((n as u64)) >= 0) { init = hir_lower_expr(base.node_nb((n as u64))); }
        return hir_emit(HIR_OP_LOCAL_DECL, -1, n, [init], base.node_sa((n as u64)), hir_type_text(base.node_na((n as u64))), base.node_span_id(nd.id).line);
    }
    if (k == "assign" || k == "assignment") {
        return hir_lower_assign(n);
    }
    if (k == "return") {
        var v: i64 = -1;
        if (base.node_na((n as u64)) >= 0) { v = hir_lower_expr(base.node_na((n as u64))); }
        return hir_emit(HIR_OP_RETURN, -1, n, [v], "", "", base.node_span_id(nd.id).line);
    }
    if (k == "if") {
        var cond: i64 = hir_lower_expr(base.node_na((n as u64)));
        // then/else 分支是语句子列表头（kids 池索引），不是单节点
        var then_b: i64 = -1;
        if (base.node_la((n as u64)) >= 0) { then_b = hir_lower_stmt_list(base.node_la((n as u64))); }
        var else_b: i64 = -1;
        if (base.node_lb((n as u64)) >= 0) { else_b = hir_lower_stmt_list(base.node_lb((n as u64))); }
        return hir_emit(HIR_OP_IF, -1, n, [cond, then_b, else_b], "", "", base.node_span_id(nd.id).line);
    }
    if (k == "for") {
        // 固定 4 槽位：[init, cond, upd, body]（缺省填 -1），sema 按槽位取，
        // 不再靠「可变长度 + 追加顺序」猜 —— 那是消费端错位的经典来源。
        var init_i: i64 = -1;
        if (base.node_na((n as u64)) >= 0) { init_i = hir_lower_stmt(base.node_na((n as u64))); }
        var cond_i: i64 = -1;
        if (base.node_nb((n as u64)) >= 0) { cond_i = hir_lower_expr(base.node_nb((n as u64))); }
        var upd_i: i64 = -1;
        if (base.node_nc((nd.id as u64)) >= 0) { upd_i = hir_lower_expr(base.node_nc((nd.id as u64))); }
        var body: i64 = hir_lower_stmt_list(base.node_la((n as u64)));
        return hir_emit(HIR_OP_FOR, -1, n, [init_i, cond_i, upd_i, body], "", "", base.node_span_id(nd.id).line);
    }
    if (k == "while") {
        var cond_i: i64 = -1;
        if (base.node_na((n as u64)) >= 0) { cond_i = hir_lower_expr(base.node_na((n as u64))); }
        var body: i64 = hir_lower_stmt_list(base.node_la((n as u64)));
        return hir_emit(HIR_OP_LOOP, -1, n, [cond_i, body], "", "", base.node_span_id(nd.id).line);
    }
    if (k == "for_each") {
        var iter_i: i64 = -1;
        if (base.node_na((n as u64)) >= 0) { iter_i = hir_lower_expr(base.node_na((n as u64))); }
        var body: i64 = hir_lower_stmt_list(base.node_la((n as u64)));
        return hir_emit(HIR_OP_FORIN, -1, n, [iter_i, body], base.node_sa((n as u64)), base.node_sb((nd.id as u64)), base.node_span_id(nd.id).line);
    }
    if (k == "break") { return hir_emit(HIR_OP_BREAK, -1, n, [], "", "", base.node_span_id(nd.id).line); }
    if (k == "continue") { return hir_emit(HIR_OP_CONTINUE, -1, n, [], "", "", base.node_span_id(nd.id).line); }
    if (k == "defer") {
        var dbody: i64 = hir_lower_stmt_list(base.node_la((n as u64)));
        return hir_emit(HIR_OP_DEFER, -1, n, [dbody], "", "", base.node_span_id(nd.id).line);
    }
    if (k == "comptime") {
        var cv: i64 = -1;
        if (base.node_na((n as u64)) >= 0) { cv = hir_lower_expr(base.node_na((n as u64))); }
        return hir_emit(HIR_OP_COMPTIME, -1, n, [cv], "", "", base.node_span_id(nd.id).line);
    }
    if (k == "comptime_block") {
        var cb: i64 = hir_lower_stmt_list(base.node_la((n as u64)));
        return hir_emit(HIR_OP_COMPTIME, -1, n, [cb], "", "", base.node_span_id(nd.id).line);
    }
    if (k == "closure_capture") {
        return hir_emit(HIR_OP_CAPTURE, -1, n, [], base.node_sa((n as u64)), hir_type_text(base.node_na((n as u64))), base.node_span_id(nd.id).line);
    }
    // 其余语句种类：逃生舱
    return hir_emit(HIR_OP_RAW, n, n, [], base.node_kind((n as u64)), "", base.node_span_id(nd.id).line);
}

// ── 表达式降级（返回产生值的 inst 索引）──────────────────────
pub fn hir_lower_expr(n: i64) i64 {
    if (n < 0) { return -1; }
    var nd: base.Node = base.nodes[n];
    var k: string = base.node_kind((n as u64));
    var slot: i64 = hir_slot();
    var idx: i64 = -1;
    if (k == "int") {
        idx = hir_emit(HIR_OP_LIT_INT, slot, n, [], base.node_sa((n as u64)), "", base.node_span_id(nd.id).line);
    } else if (k == "float") {
        idx = hir_emit(HIR_OP_LIT_FLOAT, slot, n, [], base.node_sa((n as u64)), "", base.node_span_id(nd.id).line);
    } else if (k == "string") {
        idx = hir_emit(HIR_OP_LIT_STR, slot, n, [], base.node_sa((n as u64)), "", base.node_span_id(nd.id).line);
    } else if (k == "bool") {
        var s: string = "false";
        if (base.node_ba((nd.id as u64))) { s = "true"; }
        idx = hir_emit(HIR_OP_LIT_BOOL, slot, n, [], s, "", base.node_span_id(nd.id).line);
    } else if (k == "null") {
        idx = hir_emit(HIR_OP_LIT_NULL, slot, n, [], "", "", base.node_span_id(nd.id).line);
    } else if (k == "ident") {
        idx = hir_emit(HIR_OP_LOCAL_REF, slot, n, [], base.node_sa((n as u64)), "", base.node_span_id(nd.id).line);
    } else if (k == "binary") {
        var l: i64 = hir_lower_expr(base.node_na((n as u64)));
        var r: i64 = hir_lower_expr(base.node_nb((n as u64)));
        idx = hir_emit(HIR_OP_BINOP, slot, n, [l, r], base.node_sa((n as u64)), "", base.node_span_id(nd.id).line);
    } else if (k == "unary") {
        var x: i64 = hir_lower_expr(base.node_na((n as u64)));
        idx = hir_emit(HIR_OP_UNOP, slot, n, [x], base.node_sa((n as u64)), "", base.node_span_id(nd.id).line);
    } else if (k == "call") {
        var callee: string = hir_callee_name(base.node_na((n as u64)));
        var args: []i64 = [];
        var alist: []i64 = hir_list(base.node_la((n as u64)));
        var i: i64 = 0;
        while (i < slice_len(alist) as i64) {
            var ai: i64 = hir_lower_expr(alist[i]);
            if (ai >= 0) { append(args, ai); }
            i = i + 1;
        }
        idx = hir_emit(HIR_OP_CALL, slot, n, args, callee, "", base.node_span_id(nd.id).line);
    } else if (k == "member") {
        var b: i64 = hir_lower_expr(base.node_na((n as u64)));
        // 字段名存于 member 节点自身的 sa（与 FIELD_SET 一致，见 hir_lower_assign）
        idx = hir_emit(HIR_OP_FIELD_REF, slot, n, [b], base.node_sa((n as u64)), "", base.node_span_id(nd.id).line);
    } else if (k == "index") {
        var b: i64 = hir_lower_expr(base.node_na((n as u64)));
        var ix: i64 = hir_lower_expr(base.node_nb((n as u64)));
        idx = hir_emit(HIR_OP_INDEX_REF, slot, n, [b, ix], "", "", base.node_span_id(nd.id).line);
    } else if (k == "struct_lit") {
        idx = hir_lower_struct_lit(n, slot);
    } else if (k == "cast") {
        var v: i64 = hir_lower_expr(base.node_na((n as u64)));
        idx = hir_emit(HIR_OP_CAST, slot, n, [v], "", hir_type_text(base.node_nb((n as u64))), base.node_span_id(nd.id).line);
    } else if (k == "paren" || k == "expr") {
        idx = hir_lower_expr(base.node_na((n as u64)));
    } else if (k == "closure_make") {
        var caps: []i64 = hir_list(base.node_la((n as u64)));
        var cargs: []i64 = [];
        var ci: i64 = 0;
        while (ci < slice_len(caps) as i64) {
            var cexp: i64 = hir_lower_expr(caps[ci]);
            if (cexp >= 0) { append(cargs, cexp); }
            ci = ci + 1;
        }
        idx = hir_emit(HIR_OP_CLOSURE_MAKE, slot, n, cargs, base.node_sa((n as u64)), "", base.node_span_id(nd.id).line);
    } else if (k == "lambda") {
        var params: []i64 = hir_list(base.node_lb((n as u64)));
        var pargs: []i64 = [];
        var pi: i64 = 0;
        while (pi < slice_len(params) as i64) {
            var pn: base.Node = base.nodes[params[pi]];
            var pd: i64 = hir_emit(HIR_OP_PARAM_DECL, -1, params[pi], [], base.node_sa((params[pi] as u64)), hir_type_text(base.node_na((params[pi] as u64))), base.node_span_id(pn.id).line);
            append(pargs, pd);
            pi = pi + 1;
        }
        // ⚠ lambda 的 lc 是**语句子列表头（kids 池索引）**，不是 body 节点
        // （parse_block 返回 list head，与 FuncDecl.lc 同）。当节点 id 用会张冠李戴。
        var body: i64 = -1;
        if (base.node_lc((nd.id as u64)) >= 0) { body = hir_lower_stmt_list(base.node_lc((nd.id as u64))); }
        var all: []i64 = pargs;
        append(all, body);
        idx = hir_emit(HIR_OP_LAMBDA, slot, n, all, base.node_sa((n as u64)), hir_type_text(base.node_na((n as u64))), base.node_span_id(nd.id).line);
    } else if (k == "match") {
        idx = hir_lower_match(n, slot);
    } else if (k == "assign" || k == "assignment") {
        idx = hir_lower_assign(n);
    } else if (k == "array_lit") {
        idx = hir_lower_array_lit(n, slot);
    } else if (k == "map_lit") {
        idx = hir_lower_map_lit(n, slot);
    } else if (k == "atom") {
        idx = hir_emit(HIR_OP_LIT_ATOM, slot, n, [], base.node_sa((n as u64)), "", base.node_span_id(nd.id).line);
    } else if (k == "fidconst") {
        idx = hir_emit(HIR_OP_LIT_FID, slot, n, [], base.node_sa((n as u64)), "", base.node_span_id(nd.id).line);
    } else if (k == "opt_none") {
        idx = hir_emit(HIR_OP_OPT_NONE, slot, n, [], "", "", base.node_span_id(nd.id).line);
    } else if (k == "amp") {
        var ax: i64 = hir_lower_expr(base.node_na((n as u64)));
        idx = hir_emit(HIR_OP_ADDR, slot, n, [ax], "", "", base.node_span_id(nd.id).line);
    } else if (k == "deref") {
        var dx: i64 = hir_lower_expr(base.node_na((n as u64)));
        idx = hir_emit(HIR_OP_DEREF, slot, n, [dx], "", "", base.node_span_id(nd.id).line);
    } else if (k == "range") {
        var rlo: i64 = -1;
        if (base.node_na((n as u64)) >= 0) { rlo = hir_lower_expr(base.node_na((n as u64))); }
        var rhi: i64 = -1;
        if (base.node_nb((n as u64)) >= 0) { rhi = hir_lower_expr(base.node_nb((n as u64))); }
        idx = hir_emit(HIR_OP_RANGE, slot, n, [rlo, rhi], "", "", base.node_span_id(nd.id).line);
        g_hir.insts[idx].ba = base.node_ba((nd.id as u64));
    } else if (k == "mbuiltin") {
        var margs: []i64 = [];
        var ml: []i64 = hir_list(base.node_la((n as u64)));
        var mi: i64 = 0;
        while (mi < slice_len(ml) as i64) {
            var ma: i64 = hir_lower_any(ml[mi]);
            if (ma >= 0) { append(margs, ma); }
            mi = mi + 1;
        }
        idx = hir_emit(HIR_OP_MBUILTIN, slot, n, margs, base.node_sa((n as u64)), "", base.node_span_id(nd.id).line);
    } else if (k == "typeinfo") {
        idx = hir_emit(HIR_OP_TYPEINFO, slot, n, [], base.node_sa((n as u64)), "", base.node_span_id(nd.id).line);
    } else if (k == "conpat") {
        var subs: []i64 = hir_list(base.node_la((n as u64)));
        var sargs: []i64 = [];
        var si2: i64 = 0;
        while (si2 < slice_len(subs) as i64) {
            var sp: i64 = hir_lower_any(subs[si2]);
            if (sp >= 0) { append(sargs, sp); }
            si2 = si2 + 1;
        }
        idx = hir_emit(HIR_OP_CONPAT, slot, n, sargs, base.node_sa((n as u64)), base.node_sb((nd.id as u64)), base.node_span_id(nd.id).line);
    } else if (k == "comptime") {
        var cx: i64 = -1;
        if (base.node_na((n as u64)) >= 0) { cx = hir_lower_expr(base.node_na((n as u64))); }
        idx = hir_emit(HIR_OP_COMPTIME, slot, n, [cx], "", "", base.node_span_id(nd.id).line);
    } else if (k == "pipe_map" || k == "pipe_filter" || k == "pipe_apply") {
        var pl: i64 = hir_lower_expr(base.node_na((n as u64)));
        var pr: i64 = hir_lower_expr(base.node_nb((n as u64)));
        idx = hir_emit(HIR_OP_PIPE, slot, n, [pl, pr], base.node_sa((n as u64)), "", base.node_span_id(nd.id).line);
    } else if (k == "scalar" || k == "named" || k == "sym" || k == "func_type"
            || k == "pointer" || k == "slice" || k == "array" || k == "optional"
            || k == "vector" || k == "tile" || k == "typeinfo_t") {
        // 「类型即值」位置（comptime 类型实参 / @type_* 的实参 / 泛型实参）：
        // 只留未解析类型文本，解析交给 sema。
        idx = hir_emit(HIR_OP_TYPE_REF, slot, n, [], hir_type_text(n), "", base.node_span_id(nd.id).line);
    } else if (k == "slice_pat") {
        // 切片/数组模式 [a,b,..,last]/[]/[x]/[..]：args=[rest_pos, count, 元素模式...]
        // （`rest` 元素不入 args，由 rest_pos+count 还原位置）。各元素模式递归降级，
        // 绑定 ident/字面量/conpat 均为合法 HIR op，不会掉回 RAW 逃生舱（S6）。
        var sp_rest: i64 = base.node_na((n as u64));
        var sp_count: i64 = base.node_nb((n as u64));
        var sp_args: []i64 = [];
        append(sp_args, hir_emit(HIR_OP_LIT_INT, hir_slot(), -1, [], base.i2s(sp_rest), "", base.node_span_id(nd.id).line));
        append(sp_args, hir_emit(HIR_OP_LIT_INT, hir_slot(), -1, [], base.i2s(sp_count), "", base.node_span_id(nd.id).line));
        var sp_e: i64 = base.node_la((n as u64));
        while (sp_e >= 0) {
            var sp_en: base.Node = base.nodes[base.kids[sp_e].val];
            if (base.node_kind((base.kids[sp_e].val as u64)) != "rest") {
                var sp_el: i64 = hir_lower_any(base.kids[sp_e].val);
                if (sp_el >= 0) { append(sp_args, sp_el); }
            }
            sp_e = base.kids[sp_e].next;
        }
        idx = hir_emit(HIR_OP_SLICE_PAT, slot, n, sp_args, "", "", base.node_span_id(nd.id).line);
    } else if (base.lower_policy_of(k) == base.LOWER_OPAQUE) {
        // S6（§4.11.2）：**不透明 BLOCK 承接** —— 由 lower_policy 表驱动，取代原先
        // 6 个硬编码 `k == "..."` 分支。当前表内 LOWER_OPAQUE 共 9 个 kind：
        //   block_expr / while / for / for_each / unit_lit / bitstr / bitstr_pat /
        //   import_expr / variant_lit（清单见 tools/cst_kinds.json 的 lower_policy_opaque）。
        // 今后新增「块式糖」只需在清单里标注，**不再改 hir.tc 代码**。
        // 等价性：原 6 个分支的 return 语句完全相同，且这 9 个 kind 在原链中均只在
        // 此处命中（前置分支无一匹配），故合并为单分支后行为逐字节等价。
        //
        // ⚠ 绝不能在这里递归 lower 子节点 / 给本节点建 node_to_hir 映射
        //   （2026-09-24 实测血的教训，对 block_expr 尤其致命）：
        //   一旦子节点有了 HIR 映射，sema 对它们就改走 **HIR 路径**（ie_inst >= 0），
        //   而 HIR 侧**不做块作用域** ⇒ 尾随表达式引用的块内 var 查不到 ⇒
        //   `T-SEM-E201 未定义的标识符 t`（examples/p1_block_expr.tc 直接编不过）。
        //   建映射还会让 sema 绕过 CST 脱糖：while/for 绕开 infer 期原地脱糖，
        //   variant_lit 绕开 sema.infer_expr 的 `<V>_from_<Case>(...)` 脱糖
        //   ⇒ 变体字面量在 LLVM 轨被直接发射成 tag 整数（静默错编）。
        //   故：不递归、不建映射、直接 return —— sema 全程走 CST，HIR 侧只保证不落 RAW。
        return hir_emit(HIR_OP_BLOCK, -1, n, [], "", "", base.node_span_id(nd.id).line);
    } else {
        // 未覆盖表达式：逃生舱
        idx = hir_emit(HIR_OP_RAW, n, n, [], base.node_kind((n as u64)), "", base.node_span_id(nd.id).line);
    }
    if (idx >= 0) { g_hir.node_to_hir[n] = idx; }
    return idx;
}

// 类型/值两可位置的降级：类型节点 → TYPE_REF，其余按表达式。
pub fn hir_lower_any(n: i64) i64 {
    if (n < 0) { return -1; }
    var nd: base.Node = base.nodes[n];
    var k: string = base.node_kind((n as u64));
    if (k == "scalar" || k == "named" || k == "ident" || k == "sym" || k == "func_type"
            || k == "pointer" || k == "slice" || k == "array" || k == "optional"
            || k == "vector" || k == "tile") {
        var slot2: i64 = hir_slot();
        var ti2: i64 = hir_emit(HIR_OP_TYPE_REF, slot2, n, [], hir_type_text(n), "", base.node_span_id(nd.id).line);
        g_hir.node_to_hir[n] = ti2;
        return ti2;
    }
    return hir_lower_expr(n);
}

pub fn hir_lower_match(n: i64, slot: i64) i64 {
    var nd: base.Node = base.nodes[n];
    var scr: i64 = hir_lower_expr(base.node_na((n as u64)));
    var arms: []i64 = hir_list(base.node_la((n as u64)));
    var args: []i64 = [scr];
    var i: i64 = 0;
    while (i < slice_len(arms) as i64) {
        var arm: base.Node = base.nodes[arms[i]];
        var pat: i64 = -1;
        if (base.node_na((arms[i] as u64)) >= 0) { pat = hir_lower_any(base.node_na((arms[i] as u64))); }
        var guard: i64 = -1;
        if (base.node_nb((arms[i] as u64)) >= 0) { guard = hir_lower_expr(base.node_nb((arms[i] as u64))); }
        var body: i64 = -1;
        if (base.node_nc((arm.id as u64)) >= 0) { body = hir_lower_expr(base.node_nc((arm.id as u64))); }
        var ai: i64 = hir_emit(HIR_OP_MATCH_ARM, -1, arms[i], [pat, guard, body], base.node_sa((arms[i] as u64)), "", base.node_span_id(arm.id).line);
        g_hir.insts[ai].ba = base.node_ba((arm.id as u64));
        append(args, ai);
        i = i + 1;
    }
    return hir_emit(HIR_OP_MATCH, slot, n, args, "", "", base.node_span_id(nd.id).line);
}

// 赋值降级（stmt 与 expr 上下文共用）：字段/索引赋值 → *_SET；普通变量赋值 → 一级 ASSIGN。
// sa 保留目标变量名（或字段名），便于后续 Sema 重写消费。（ZIR 式 HIR·Stage A）
pub fn hir_lower_assign(n: i64) i64 {
    var nd: base.Node = base.nodes[n];
    var l: i64 = hir_lower_expr(base.node_na((n as u64)));
    var r: i64 = hir_lower_expr(base.node_nb((n as u64)));
    var ln: base.Node = base.nodes[base.node_na((n as u64))];
    if (base.node_kind((base.node_na((n as u64)) as u64)) == "member") {
        var base_i: i64 = hir_lower_expr(base.node_na((base.node_na((n as u64)) as u64)));
        return hir_emit(HIR_OP_FIELD_SET, -1, n, [base_i, r], base.node_sa((base.node_na((n as u64)) as u64)), "", base.node_span_id(nd.id).line);
    }
    if (base.node_kind((base.node_na((n as u64)) as u64)) == "index") {
        var base_i: i64 = hir_lower_expr(base.node_na((base.node_na((n as u64)) as u64)));
        var idx_i: i64 = hir_lower_expr(base.node_nb((base.node_na((n as u64)) as u64)));
        return hir_emit(HIR_OP_INDEX_SET, -1, n, [base_i, idx_i, r], "", "", base.node_span_id(nd.id).line);
    }
    return hir_emit(HIR_OP_ASSIGN, -1, n, [l, r], base.node_sa((base.node_na((n as u64)) as u64)), "", base.node_span_id(nd.id).line);
}

pub fn hir_callee_name(callee: i64) string {
    if (callee < 0) { return "<expr>"; }
    var cn: base.Node = base.nodes[callee];
    if (base.node_kind((callee as u64)) == "ident") { return base.node_sa((callee as u64)); }
    if (base.node_kind((callee as u64)) == "member") { return base.node_sa((callee as u64)); }
    if (base.node_kind((callee as u64)) == "sym") { return base.sb_cat2("@", base.node_sa((callee as u64))); }
    return "<expr>";
}

pub fn hir_lower_array_lit(n: i64, slot: i64) i64 {
    var nd: base.Node = base.nodes[n];
    var elems: []i64 = hir_list(base.node_la((n as u64)));
    var args: []i64 = [];
    var i: i64 = 0;
    while (i < slice_len(elems) as i64) {
        var ei: i64 = hir_lower_expr(elems[i]);
        if (ei >= 0) { append(args, ei); }
        i = i + 1;
    }
    return hir_emit(HIR_OP_ARRAY, slot, n, args, "", "", base.node_span_id(nd.id).line);
}

pub fn hir_lower_map_lit(n: i64, slot: i64) i64 {
    var nd: base.Node = base.nodes[n];
    var elems: []i64 = hir_list(base.node_la((n as u64)));
    var args: []i64 = [];
    var i: i64 = 0;
    while (i < slice_len(elems) as i64) {
        var en: base.Node = base.nodes[elems[i]];
        var mk: i64 = -1;
        if (base.node_na((elems[i] as u64)) >= 0) { mk = hir_lower_expr(base.node_na((elems[i] as u64))); }
        var mv: i64 = -1;
        if (base.node_nb((elems[i] as u64)) >= 0) { mv = hir_lower_expr(base.node_nb((elems[i] as u64))); }
        var eid: i64 = hir_emit(HIR_OP_MAP_ENTRY, -1, elems[i], [mk, mv], "", "", base.node_span_id(en.id).line);
        append(args, eid);
        i = i + 1;
    }
    return hir_emit(HIR_OP_MAP_LIT, slot, n, args, "", "", base.node_span_id(nd.id).line);
}

pub fn hir_lower_struct_lit(n: i64, slot: i64) i64 {
    var nd: base.Node = base.nodes[n];
    var fields: []i64 = hir_list(base.node_la((n as u64)));
    var names: []string = [];
    var args: []i64 = [];
    var i: i64 = 0;
    while (i < slice_len(fields) as i64) {
        var f: base.Node = base.nodes[fields[i]];
        var fname: string = "";
        var fval: i64 = -1;
        if (base.node_kind((fields[i] as u64)) == "named") {
            fname = base.node_sa((fields[i] as u64));
            if (base.node_na((fields[i] as u64)) >= 0) { fval = hir_lower_expr(base.node_na((fields[i] as u64))); }
        } else if (base.node_kind((fields[i] as u64)) == "assignment") {
            if (base.node_na((fields[i] as u64)) >= 0) { fname = base.node_sa((base.node_na((fields[i] as u64)) as u64)); }
            if (base.node_nb((fields[i] as u64)) >= 0) { fval = hir_lower_expr(base.node_nb((fields[i] as u64))); }
        } else if (base.node_kind((fields[i] as u64)) == "P") {
            fname = base.node_sa((fields[i] as u64));
            if (base.node_na((fields[i] as u64)) >= 0) { fval = hir_lower_expr(base.node_na((fields[i] as u64))); }
        } else if (base.node_kind((fields[i] as u64)) == "FV") {
            fname = base.node_sa((fields[i] as u64));
            if (base.node_na((fields[i] as u64)) >= 0) { fval = hir_lower_expr(base.node_na((fields[i] as u64))); }
        } else {
            // 未知字段形态：整字段逃生舱（值）
            fval = hir_emit(HIR_OP_RAW, fields[i], fields[i], [], base.node_kind((fields[i] as u64)), "", base.node_span_id(f.id).line);
        }
        append(names, fname);
        append(args, fval);
        i = i + 1;
    }
    var csv: string = "";
    var j: i64 = 0;
    while (j < slice_len(names) as i64) {
        if (j > 0) { csv = base.sb_cat2(csv, ","); }
        csv = base.sb_cat2(csv, names[j]);
        j = j + 1;
    }
    return hir_emit(HIR_OP_CONSTRUCT, slot, n, args, base.node_sa((n as u64)), csv, base.node_span_id(nd.id).line);
}

// ── S8 step3（§0.16.13）：tc lint —— HIR 上的结构化规则 ──────────────────
// G7（§4.13.3）：lint 只消费 HIR（+ 语义侧表），与 fmt 共用 lexer/parser 底层，
// 不各自实现解析与遍历。v1 = 三条**高置信**结构规则，全部只读 HIR、不改 IR、
// 不依赖类型（本步不跑 sema，故无类型信息）：
//   T-LINT-W001 不可达语句：block 内 return/break/continue 之后的语句
//   T-LINT-W002 空块：if 的 then 为空（且无 else 或 else 亦空）；loop/for/forin 体为空
//   T-LINT-W003 无副作用的表达式语句：值被丢弃（**块尾语句除外** —— 它是块的值）
// 语义侧表规则（未使用符号、类型相关）留后续步。
// ⚠ 取舍：宁可漏报（false negative）也不误报（false positive）—— lint 一旦刷屏就没人看。

pub var g_lint_count: i64 = 0;

pub fn lint_reset() void {
    g_lint_count = 0;
}

// 统一输出格式（可 grep / 可入 CI）：<file>:<line>: T-LINT-Wxxx: <msg>
pub fn lint_emit(code: string, line: u64, msg: string) void {
    println(base.sb_cat6(base.g_file, ":", base.i2s(line as i64), ": ", code, base.sb_cat2(": ", msg)));
    g_lint_count = g_lint_count + 1;
}

// 终结指令：它之后的同级语句不可达
pub fn lint_is_terminator(op: i64) bool {
    if (op == HIR_OP_RETURN) { return true; }
    if (op == HIR_OP_BREAK) { return true; }
    if (op == HIR_OP_CONTINUE) { return true; }
    return false;
}

// 无副作用：作为「表达式语句」出现即等于丢弃结果。
// 刻意**不含** CALL / METHOD_CALL / ASSIGN / FIELD_SET / INDEX_SET / DEFER /
// COMPTIME / MATCH / CLOSURE_MAKE —— 它们可能有副作用或本身就是用法。
// ⚠ **BINOP 只放行算术运算符**：`<` 在 t 里既是「小于」又是 **fid 写入操作符**
//   （`stdout < "x"`、`j < 12 < true`，见 examples/fid_demo.tc），有副作用；
//   lint 是 pre-type 的（不跑 sema），**无法凭类型区分二者**，故整类排除。
//   UNOP 同理整类排除（`&` / `*` 语义依赖上下文）。宁可漏报，不可误报。
pub fn lint_is_pure(op: i64, sa: string) bool {
    if (op == HIR_OP_LIT_INT) { return true; }
    if (op == HIR_OP_LIT_FLOAT) { return true; }
    if (op == HIR_OP_LIT_STR) { return true; }
    if (op == HIR_OP_LIT_BOOL) { return true; }
    if (op == HIR_OP_LIT_NULL) { return true; }
    if (op == HIR_OP_LOCAL_REF) { return true; }
    if (op == HIR_OP_PARAM_REF) { return true; }
    if (op == HIR_OP_FIELD_REF) { return true; }
    if (op == HIR_OP_INDEX_REF) { return true; }
    if (op == HIR_OP_CAST) { return true; }
    if (op == HIR_OP_ARRAY) { return true; }
    if (op == HIR_OP_MAP_LIT) { return true; }
    if (op == HIR_OP_RANGE) { return true; }
    if (op == HIR_OP_BINOP) {
        if (sa == "+") { return true; }
        if (sa == "-") { return true; }
        if (sa == "*") { return true; }
        if (sa == "/") { return true; }
        if (sa == "%") { return true; }
        return false;
    }
    return false;
}

// 块是否为空（-1 = 缺席；BLOCK 有 0 个语句 = 空块）
pub fn lint_block_empty(bi: i64) bool {
    if (bi < 0) { return true; }
    if (bi >= slice_len(g_hir.insts) as i64) { return true; }
    var b: HirInst = g_hir.insts[bi];
    if (slice_len(b.args) as i64 == 0) { return true; }
    return false;
}

// 块内语句序列上的规则（W001 / W003）
pub fn lint_block(bi: i64) void {
    if (bi < 0) { return; }
    if (bi >= slice_len(g_hir.insts) as i64) { return; }
    var b: HirInst = g_hir.insts[bi];
    var n: i64 = slice_len(b.args) as i64;
    var k: i64 = 0;
    var dead: bool = false;
    while (k < n) {
        var si: i64 = b.args[k];
        if (si >= 0 && si < slice_len(g_hir.insts) as i64) {
            var s: HirInst = g_hir.insts[si];
            if (dead) {
                // 每条终结指令之后**只报第一条**死语句（避免同一处刷屏）
                if (lint_is_terminator(s.op) == false) {
                    lint_emit("T-LINT-W001", s.line,
                        base.sb_cat3("unreachable statement after return/break/continue (", hir_op_name(s.op), ")"));
                    dead = false;
                }
            } else {
                if (lint_is_terminator(s.op)) { dead = true; }
                // W003：块尾语句是「块的值」（t 的 value-if / value-block），不算丢弃
                if (k + 1 < n && s.op == HIR_OP_EXPR_STMT) {
                    var ei: i64 = hir_arg(si, 0);
                    var eo: i64 = hir_op_of(ei);
                    if (ei >= 0 && ei < slice_len(g_hir.insts) as i64) {
                        var e2: HirInst = g_hir.insts[ei];
                        if (lint_is_pure(eo, e2.sa)) {
                            lint_emit("T-LINT-W003", s.line,
                                base.sb_cat3("expression statement has no effect; result discarded (", hir_op_name(eo), ")"));
                        }
                    }
                }
            }
        }
        k = k + 1;
    }
}

// 全量扫描（不递归：所有 BLOCK / IF / LOOP 指令都在 g_hir.insts 里）
pub fn lint_run() i64 {
    lint_reset();
    var n: i64 = slice_len(g_hir.insts) as i64;
    var i: i64 = 0;
    while (i < n) {
        var it: HirInst = g_hir.insts[i];
        if (it.op == HIR_OP_BLOCK) { lint_block(i); }
        if (it.op == HIR_OP_IF) {
            var tb: i64 = hir_arg(i, 1);
            var eb: i64 = hir_arg(i, 2);
            if (lint_block_empty(tb)) {
                if (eb < 0 || lint_block_empty(eb)) {
                    lint_emit("T-LINT-W002", it.line, "if statement has an empty then-branch and no else-branch");
                }
            }
        }
        if (it.op == HIR_OP_LOOP) {
            if (lint_block_empty(hir_arg(i, 1))) {
                lint_emit("T-LINT-W002", it.line, "loop body is empty (statement has no effect)");
            }
        }
        if (it.op == HIR_OP_FOR) {
            if (lint_block_empty(hir_arg(i, 3))) {
                lint_emit("T-LINT-W002", it.line, "for body is empty (statement has no effect)");
            }
        }
        if (it.op == HIR_OP_FORIN) {
            if (lint_block_empty(hir_arg(i, 1))) {
                lint_emit("T-LINT-W002", it.line, "for-in body is empty (statement has no effect)");
            }
        }
        i = i + 1;
    }
    return g_lint_count;
}

// ── 序列化：文本（diff 友好）─────────────────────────────────
pub fn hir_op_name(op: i64) string {
    if (op == HIR_OP_LIT_INT) { return "lit_int"; }
    if (op == HIR_OP_LIT_FLOAT) { return "lit_float"; }
    if (op == HIR_OP_LIT_STR) { return "lit_str"; }
    if (op == HIR_OP_LIT_BOOL) { return "lit_bool"; }
    if (op == HIR_OP_LIT_NULL) { return "lit_null"; }
    if (op == HIR_OP_LOCAL_DECL) { return "local_decl"; }
    if (op == HIR_OP_LOCAL_REF) { return "local_ref"; }
    if (op == HIR_OP_PARAM_REF) { return "param_ref"; }
    if (op == HIR_OP_CALL) { return "call"; }
    if (op == HIR_OP_METHOD_CALL) { return "method_call"; }
    if (op == HIR_OP_BINOP) { return "binop"; }
    if (op == HIR_OP_UNOP) { return "unop"; }
    if (op == HIR_OP_FIELD_REF) { return "field_ref"; }
    if (op == HIR_OP_FIELD_SET) { return "field_set"; }
    if (op == HIR_OP_INDEX_REF) { return "index_ref"; }
    if (op == HIR_OP_INDEX_SET) { return "index_set"; }
    if (op == HIR_OP_ASSIGN) { return "assign"; }
    if (op == HIR_OP_ARRAY) { return "array"; }
    if (op == HIR_OP_CONSTRUCT) { return "construct"; }
    if (op == HIR_OP_IF) { return "if"; }
    if (op == HIR_OP_BLOCK) { return "block"; }
    if (op == HIR_OP_LOOP) { return "loop"; }
    if (op == HIR_OP_RETURN) { return "return"; }
    if (op == HIR_OP_BREAK) { return "break"; }
    if (op == HIR_OP_CONTINUE) { return "continue"; }
    if (op == HIR_OP_CAST) { return "cast"; }
    if (op == HIR_OP_RAW) { return "raw"; }
    if (op == HIR_OP_FN_DECL) { return "fn_decl"; }
    if (op == HIR_OP_STRUCT_DECL) { return "struct_decl"; }
    if (op == HIR_OP_ENUM_DECL) { return "enum_decl"; }
    if (op == HIR_OP_UNION_DECL) { return "union_decl"; }
    if (op == HIR_OP_CONST_DECL) { return "const_decl"; }
    if (op == HIR_OP_GLOBAL_DECL) { return "global_decl"; }
    if (op == HIR_OP_IMPORT_DECL) { return "import_decl"; }
    if (op == HIR_OP_TYPE_ALIAS_DECL) { return "type_alias_decl"; }
    if (op == HIR_OP_FLAG_DECL) { return "flag_decl"; }
    if (op == HIR_OP_FLAGSET_DECL) { return "flagset_decl"; }
    if (op == HIR_OP_VARIANT_DECL) { return "variant_decl"; }
    if (op == HIR_OP_PARAM_DECL) { return "param_decl"; }
    if (op == HIR_OP_FIELD_DECL) { return "field_decl"; }
    if (op == HIR_OP_MODULE_DECL) { return "module_decl"; }
    if (op == HIR_OP_CLOSURE_MAKE) { return "closure_make"; }
    if (op == HIR_OP_LAMBDA) { return "lambda"; }
    if (op == HIR_OP_LIT_ATOM) { return "lit_atom"; }
    if (op == HIR_OP_LIT_FID) { return "lit_fid"; }
    if (op == HIR_OP_MBUILTIN) { return "mbuiltin"; }
    if (op == HIR_OP_TYPE_REF) { return "type_ref"; }
    if (op == HIR_OP_MATCH) { return "match"; }
    if (op == HIR_OP_MATCH_ARM) { return "arm"; }
    if (op == HIR_OP_MAP_LIT) { return "map_lit"; }
    if (op == HIR_OP_MAP_ENTRY) { return "map_entry"; }
    if (op == HIR_OP_ADDR) { return "addr"; }
    if (op == HIR_OP_DEREF) { return "deref"; }
    if (op == HIR_OP_RANGE) { return "range"; }
    if (op == HIR_OP_OPT_NONE) { return "opt_none"; }
    if (op == HIR_OP_TYPEINFO) { return "typeinfo"; }
    if (op == HIR_OP_PIPE) { return "pipe"; }
    if (op == HIR_OP_DEFER) { return "defer"; }
    if (op == HIR_OP_COMPTIME) { return "comptime"; }
    if (op == HIR_OP_FOR) { return "for"; }
    if (op == HIR_OP_FORIN) { return "forin"; }
    if (op == HIR_OP_CAPTURE) { return "capture"; }
    if (op == HIR_OP_EXPR_STMT) { return "expr_stmt"; }
    if (op == HIR_OP_CONPAT) { return "conpat"; }
    if (op == HIR_OP_SLICE_PAT) { return "slice_pat"; }
    return "invalid";
}

pub fn hir_args_str(args: []i64) string {
    var s: string = "[";
    var i: i64 = 0;
    while (i < slice_len(args) as i64) {
        if (i > 0) { s = base.sb_cat2(s, " "); }
        var v: i64 = args[i];
        if (v < 0) { s = base.sb_cat2(s, "_"); }
        else { s = base.sb_cat2(s, base.i2s(v)); }
        i = i + 1;
    }
    return base.sb_cat2(s, "]");
}

pub fn hir_to_text(m: HirModule) string {
    var out: string = "";
    out = base.sb_cat3(out, "; HIR ", HIR_VERSION);
    out = base.sb_cat3(out, "  src=", m.file);
    out = base.sb_cat3(out, "  hash=", m.src_hash);
    out = base.sb_cat2(out, "\n");
    out = base.sb_cat4(out, "; decls(", base.i2s(slice_len(m.decls) as i64), "): ");
    var di: i64 = 0;
    while (di < slice_len(m.decls) as i64) {
        if (di > 0) { out = base.sb_cat2(out, " "); }
        out = base.sb_cat2(out, base.i2s(m.decls[di]));
        di = di + 1;
    }
    out = base.sb_cat2(out, "\n");
    var i: i64 = 0;
    while (i < slice_len(m.insts) as i64) {
        var inst: HirInst = m.insts[i];
        var line: string = base.sb_cat2(base.i2s(i), ":");
        line = base.sb_cat2(line, hir_op_name(inst.op));
        if (inst.dst >= 0) { line = base.sb_cat3(line, " dst=%", base.i2s(inst.dst)); }
        if (inst.nd != hir_nd_none()) { line = base.sb_cat3(line, " nd=", base.i2s(inst.nd)); }
        if (inst.sa != "") { line = base.sb_cat3(line, " name=", inst.sa); }
        if (inst.ty != "") { line = base.sb_cat3(line, " ty=", inst.ty); }
        line = base.sb_cat3(line, " args=", hir_args_str(inst.args));
        if (inst.line > 0) { line = base.sb_cat3(line, " @", base.i2s(inst.line as i64)); }
        out = base.sb_cat2(out, line);
        out = base.sb_cat2(out, "\n");
        i = i + 1;
    }
    return out;
}

// ── 序列化：二进制（缓存；长度前缀，确定性）──────────────────
// 字节缓冲用 string（而非 []u8）：历史上 LLVM 后端对 []u8 的 append 取元素尺寸时，
// 从「待追加值槽的存储型」反推 elem_size（窄整数在 TIR 整数临时槽按 i64 加宽 ⇒ 步长退化成 8；
// 槽保留 u8 还会误发非法类型令牌 `u8`），导致 []u8 字节缓冲误编。该 bug 已根治
// （append 元素尺寸改由「切片声明元素类型」显式传入，与 C 后端 sizeof(ElemT) 同构，见
// tir.tc/tir_to_ll.tc 的 @append 第三实参 esz），现 []u8 在双后端均正确。
// 此处仍用 string 仅是序列化实现选择（string 底层为 i8，写入/索引/解码均自然合法），与编译期正确性无关。
// 写：StringBuilder 累积；读：全局游标 g_hir_buf(string) + g_hir_cur。

// 把 v 的 8 个低位字节追加到 StringBuilder
pub fn hir_put_u64(sb: StringBuilder, v: i64) void {
    var x: i64 = v;
    var i: i64 = 0;
    while (i < 8) {
        var b: i64 = x & 255;
        sb_append_char(sb, b);
        x = x >> 8;
        i = i + 1;
    }
}

pub fn hir_put_str(sb: StringBuilder, s: string) void {
    var len: i64 = str_len(s) as i64;
    hir_put_u64(sb, len);
    var i: i64 = 0;
    while (i < len) {
        var c: i64 = s[i] as i64;
        if (c < 0) { c = c + 256; }
        sb_append_char(sb, c);
        i = i + 1;
    }
}

pub fn hir_put_i64s(sb: StringBuilder, arr: []i64) void {
    hir_put_u64(sb, slice_len(arr) as i64);
    var i: i64 = 0;
    while (i < slice_len(arr) as i64) {
        hir_put_u64(sb, arr[i]);
        i = i + 1;
    }
}

pub fn hir_to_bin(m: HirModule) string {
    var sb: StringBuilder = sb_new();
    // magic "HIR1"
    sb_append_char(sb, 72);
    sb_append_char(sb, 73);
    sb_append_char(sb, 82);
    sb_append_char(sb, 49);
    hir_put_str(sb, m.src_hash);
    hir_put_str(sb, m.file);
    hir_put_i64s(sb, m.decls);
    hir_put_u64(sb, slice_len(m.insts) as i64);
    var i: i64 = 0;
    while (i < slice_len(m.insts) as i64) {
        var inst: HirInst = m.insts[i];
        hir_put_u64(sb, inst.op);
        hir_put_u64(sb, inst.dst);
        hir_put_u64(sb, inst.nd);
        hir_put_i64s(sb, inst.args);
        hir_put_str(sb, inst.sa);
        hir_put_str(sb, inst.ty);
        hir_put_u64(sb, inst.line as i64);
        i = i + 1;
    }
    return sb_to_str(sb);
}

// 二进制解码用全局游标（t 结构体按值传递，局部游标 pos 不会回写调用方）
pub var g_hir_buf: string = "";
pub var g_hir_cur: i64 = 0;

pub fn hir_get_u64() i64 {
    var v: i64 = 0;
    var i: i64 = 0;
    while (i < 8) {
        var b: i64 = g_hir_buf[g_hir_cur] as i64;
        if (b < 0) { b = b + 256; }   // string 元素为 i8，高位字节需还原为 0..255
        v = v | (b << (8 * i));
        g_hir_cur = g_hir_cur + 1;
        i = i + 1;
    }
    return v;
}

pub fn hir_get_str() string {
    var len: i64 = hir_get_u64();
    var sb: StringBuilder = sb_new();
    var i: i64 = 0;
    while (i < len) {
        var c: i64 = g_hir_buf[g_hir_cur] as i64;
        if (c < 0) { c = c + 256; }
        sb_append_char(sb, c);
        g_hir_cur = g_hir_cur + 1;
        i = i + 1;
    }
    return sb_to_str(sb);
}

pub fn hir_get_i64s() []i64 {
    var n: i64 = hir_get_u64();
    var out: []i64 = [];
    var i: i64 = 0;
    while (i < n) { append(out, hir_get_u64()); i = i + 1; }
    return out;
}

pub fn hir_from_bin(buf: string) HirModule {
    g_hir_buf = buf;
    g_hir_cur = 4; // skip "HIR1" magic
    var m: HirModule;
    m.src_hash = hir_get_str();
    m.file = hir_get_str();
    m.decls = hir_get_i64s();
    var ninst: i64 = hir_get_u64();
    var i: i64 = 0;
    while (i < ninst) {
        var inst: HirInst;
        inst.op = hir_get_u64();
        inst.dst = hir_get_u64();
        inst.nd = hir_get_u64();
        inst.args = hir_get_i64s();
        inst.sa = hir_get_str();
        inst.ty = hir_get_str();
        inst.line = hir_get_u64() as u64;
        append(m.insts, inst);
        i = i + 1;
    }
    return m;
}

// ── 缓存键：源内容 FNV-1a + 编译器版本戳 ─────────────────────
pub fn hir_hash(src: string) string {
    var h: i64 = 0xcbf29ce484222325; // FNV offset basis
    var n: i64 = str_len(src) as i64;
    var i: i64 = 0;
    while (i < n) {
        h = h ^ (src[i] as i64);
        h = h * 1099511628211;
        i = i + 1;
    }
    // 混入版本戳：改动编译器/格式即失效缓存
    var vs: string = HIR_VERSION;
    var vn: i64 = str_len(vs) as i64;
    var j: i64 = 0;
    while (j < vn) {
        h = h ^ (vs[j] as i64);
        h = h * 1099511628211;
        j = j + 1;
    }
    return base.i2s(h);
}
