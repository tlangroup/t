// llname.tc —— LLVM 命名 / 槽分配子系统（飞地规避小模块）
//
// ⚠ 背景：tir_to_ll.tc 是巨型模块，被自举种子错编（寄存器复用 / 非确定性），导致 ll_llname 等
// 命名函数在特定调用上下文把槽名压成函数名 "main"（alloca 成 %main、store 文本却是 %main.s1）。
// 把命名/槽分配子系统抽到本小模块（仅 @import base，种子对小模块 100% 正确编译），打破错编死循环。
// g_ll（IR 缓冲）留 in tir_to_ll.tc；本模块 ll_emit_alloca 返回要追加的字符串，由 wrapper 写入 g_ll。

const base = @import("src.base");

pub var g_ll_names: []string;   // TIR 槽名($x) -> LLVM 类型(ST) 并行数组
pub var g_ll_sts: []string;     // 与 g_ll_names 并行：槽的 ST
pub var g_ll_emitted: []string; // 已发射 alloca 的槽名（去重用；与 g_ll_names 分离以对抗 ll_set_st 预注册未发射）
pub var g_ll_curfn: string;     // 当前函数名前缀：LLVM 寄存器/标签是模块全局，按函数加前缀避免重名
// 模块级全局类型持久表（跨函数不变，不受 ll_reset_slots 影响）。
// g_ll_globals/g_ll_globalsts：发射用裸名表（@ 已剥离，emit 时再 ll_mangle）。
// g_ll_global_keys/g_ll_global_sts：查询用已 mangle 键表，与上面并行；ll_reset_slots 直接回填进 g_ll_names/g_ll_sts。
// ⚠ 旧实现每函数调 ll_reregister_globals 重解析整个模块全局段（F×模块段 = O(n²) arena），自举 tc（约 3.2 万全局）
// 时撑爆 16GB；改为持久表后 O(1) 重置 + 每函数 O(G) 直接回填，彻底消除泄漏且 lookup 仍 O(局部)。
pub var g_ll_globals: []string;
pub var g_ll_globalsts: []string;
pub var g_ll_global_keys: []string;
pub var g_ll_global_sts: []string;

pub fn ll_set_curfn(n: string) void { g_ll_curfn = base.str_persist(n); }

// 登记一个模块级全局（裸名）。同时写入发射表与查询键表（键做 ll_mangle，与 ll_get_st/ll_alloca_st 查询键一致）。
pub fn ll_add_global(name: string, st: string) void {
    // ⚠ 代际分配器（2026-10-22）回归修复：g_ll_globals / g_ll_globalsts / g_ll_global_keys /
    // g_ll_global_sts 是模块级持久表——ll_reset_slots 每个函数都回填一次，模块末尾还要 emit。
    // 其 backing 必须落 g_arena：若在 g_func（逐函数重降级 arena）增长 backing，
    // arena_reset_func 回收后下一函数的 ll_reset_slots 即读到悬垂 backing → 段错误。
    // 本函数在 emit 期（ll_register_global 遇引用未声明全局）同样可达，故无条件切 g_arena。
    arena_use_default();
    append(g_ll_globals, base.str_persist(name));
    append(g_ll_globalsts, base.str_persist(st));
    // 键存 '@'+mangle：与 ll_llname 对裸全局名（及 @name）的输出一致，保证 ll_get_st/ll_alloca_st 查表命中。
    var key: string = "@" + ll_mangle(name);
    append(g_ll_global_keys, base.str_persist(key));
    append(g_ll_global_sts, base.str_persist(st));
}

pub fn ll_reset_slots() void {
    g_ll_names = []; g_ll_sts = []; g_ll_emitted = [];
    // 重新挂回持久全局类型表（直接回填已知键，避免每函数重解析模块全局段 → O(n²) arena）
    var gi: i64 = 0;
    var gn: i64 = slice_len(g_ll_global_keys) as i64;
    while (gi < gn) {
        append(g_ll_names, base.str_persist(g_ll_global_keys[gi]));
        append(g_ll_sts, base.str_persist(g_ll_global_sts[gi]));
        gi = gi + 1;
    }
}

// 最右一次子串出现位置（数组计数分隔符 " x " 须取最右，因元素类型本身可嵌套 arr<... x ...>）
pub fn ll_rfind(s: string, sub: string) i64 {
    var n: i64 = str_len(s);
    var m: i64 = str_len(sub);
    if (m <= 0 or m > n) { return -1; }
    var i: i64 = n - m;
    while (i >= 0) {
        var j: i64 = 0;
        var ok: bool = true;
        while (j < m) {
            if (str_at(s, i + j) != str_at(sub, j)) { ok = false; break; }
            j = j + 1;
        }
        if (ok) { return i; }
        i = i - 1;
    }
    return -1;
}

pub fn ll_strip_suf(n: string) string {
    var L: i64 = str_len(n) as i64;
    var i: i64 = L - 1;
    while (i >= 1) {
        if (n[i] == 115 and n[i - 1] == 46) {
            var suf: string = str_slice(n, i + 1, L);
            var okd: bool = str_len(suf) > 0;
            var j: i64 = 0;
            while (j < str_len(suf)) { if (suf[j] < 48 or suf[j] > 57) { okd = false; } j = j + 1; }
            if (okd) { return str_slice(n, 0, i - 1); }
        }
        i = i - 1;
    }
    return n;
}

pub fn ll_mangle(s: string) string {
    var n: i64 = str_len(s);
    if (n == 0) { return "_"; }
    var sb: StringBuilder = sb_new();
    var i: i64 = 0;
    while (i < n) {
        var c: i64 = str_at(s, i);
        if ((c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95 or c == 46 or c == 36) {
            sb_append_char(sb, c);
        } else {
            sb_append_char(sb, 95);
            sb_append_char(sb, 117);
            sb_append_char(sb, base.hex_digit((c >> 12) & 15) as i64);
            sb_append_char(sb, base.hex_digit((c >> 8) & 15) as i64);
            sb_append_char(sb, base.hex_digit((c >> 4) & 15) as i64);
            sb_append_char(sb, base.hex_digit(c & 15) as i64);
            sb_append_char(sb, 95);
        }
        i = i + 1;
    }
    var r: string = sb_to_str(sb);
    sb_free(sb);
    var fc: i64 = str_at(r, 0);
    if (fc >= 48 and fc <= 57) { r = base.sb_cat2("_", r); }
    return r;
}

pub fn ll_starts(s: string, pre: string) bool {
    var n: i64 = str_len(pre);
    if (str_len(s) < n) { return false; }
    var i: i64 = 0;
    while (i < n) {
        if (str_at(s, i) != str_at(pre, i)) { return false; }
        i = i + 1;
    }
    return true;
}

// TIR ST -> LLVM 类型
pub fn st_to_ll(st: string) string {
    if (st == "void") { return "void"; }
    if (st == "bool") { return "i8"; }
    if (st == "u8") { return "i8"; }
    if (st == "u16") { return "i16"; }
    if (st == "u32") { return "i32"; }
    if (st == "u64") { return "i64"; }
    // 任意位宽整数 > 64（u128 / i128 及更宽）：LLVM 原生 i<N>（对齐 tir_scalar_st 与 C 后端 _BitInt(N)）。
    if (ll_starts(st, "u") or ll_starts(st, "i")) {
        var ab: i64 = base.awi_bits(st);
        if (ab > 64) { return base.sb_cat3("i", base.i2s(ab), ""); }
    }
    if (st == "f32") { return "float"; }
    if (st == "f64") { return "double"; }
    if (ll_starts(st, "ptr<")) {
        return "ptr";
    }
    if (ll_starts(st, "arr<")) {
        var inner: string = str_slice(st, 4, str_len(st) - 1);
        var sp: i64 = ll_rfind(inner, " x ");
        if (sp < 0) { return "ptr"; }
        var elem: string = str_slice(inner, 0, sp);
        var nn: string = str_slice(inner, sp + 3, str_len(inner));
        return base.sb_cat5("[", nn, " x ", st_to_ll(elem), "]");
    }
    if (ll_starts(st, "vec<")) {
        var inner: string = str_slice(st, 4, str_len(st) - 1);
        var sp: i64 = ll_rfind(inner, " x ");
        if (sp < 0) { return "ptr"; }
        var elem: string = str_slice(inner, 0, sp);
        var nn: string = str_slice(inner, sp + 3, str_len(inner));
        return base.sb_cat5("<", nn, " x ", st_to_ll(elem), ">");
    }
    if (ll_starts(st, "fn<")) {
        return "ptr";
    }
    return st;
}

// 判断裸名是否为已知模块级全局（来自 pass-1 全局段与 ll_register_global 兜底登记）。
// 用于让 ll_llname/ll_load/ll_store 对「TIR 中不带 '@' 前缀的跨模块全局引用」补 '@'，与旧轨 codegen_ll 一致。
pub fn ll_is_global(name: string) bool {
    var L: i64 = str_len(name);
    if (L < 1) { return false; }
    var c: i64 = str_at(name, 0);
    if (c >= 48 and c <= 57) { return false; }   // 数字开头 = 字面量，快速跳过 (O(1))
    if (c == 45) { return false; }               // '-' 负数字面量
    if (c == 46) { return false; }               // '.' 浮点字面量
    var n: i64 = slice_len(g_ll_globals) as i64;
    var i: i64 = 0;
    while (i < n) { if (g_ll_globals[i] == name) { return true; } i = i + 1; }
    return false;
}

pub fn ll_llname(tname: string) string {
    // $x -> %curfn.x (值寄存器，按函数加前缀) ; @fn -> fn (全局函数名，去 @)
    if (str_len(tname) < 1) { return tname; }
    // ⚠ 已带 '%' 前缀的名是「已 mangle 的合法 LLVM 名」（如 %main.s2、%main.t12）。
    // 原样返回，禁止再走 ll_strip_suf——否则 %main.s2 的 ".s2" 会被当成 TIR 子索引后缀剥掉，
    // 槽名错压成函数名 "%main"，store/load 文本与 alloca 文本不一致 → 段错误（map_iter 的 s2 变量即此坑）。
    // 调用方（如 ll_store）偶会因飞地错编把 $x 传成 %curfn.x，此处幂等化可自愈。
    if (tname[0] == 37) { return tname; }
    tname = ll_strip_suf(tname);
    if (tname[0] == 36) {
        var s: string = str_slice(tname, 1, str_len(tname));
        return base.sb_cat3("%", g_ll_curfn, base.sb_cat2(".", ll_mangle(s)));
    }
    // ⚠ '@' 分支：全局名（函数或全局变量）一律保留 '@' 前缀返回。
    //   - 全局变量作操作数须内联 '@'（ptr @g），否则成裸引用 → "expected value token"；
    //   - 函数作 callee 时调用方会自己补 '@'（call void @fn），故下方调用方需先剥 '@' 得裸名匹配；
    //   - 此前此处裸返回（ll_mangle 后无 '@'）导致 @全局变量操作数丢失 '@' → 自举 tc.ll 第 67 行裸 lex__decl_list 报错。
    // ⚠ 全局引用同样要剥 TIR 类型后缀 `.sN`：tir_os 会给操作数名附 ".s<ST码>"，
    //   而 ll_register_global 登记全局时已剥过 ⇒ 不剥的话引用会写成 @g.s9 而定义是 @g
    //   ⇒ "use of undefined value" —— 只有带 st 的全局引用路径才触发，故时隐时现。
    //   实测：自举二代 g1 编译 src/tc.tc 时 `load i64, ptr @tir__g_cur_line.s9` 撞此错，
    //   clang 报 1 error ⇒ g2 构建失败 ⇒ 自举不动点/四代/run_examples/rls/tote 连带全红。
    //   已带 '%' 的分支（上方）仍禁止剥：%main.s2 的 ".s2" 是用户槽名，剥了会压成函数名。
    if (tname[0] == 64) {
        var gname: string = ll_strip_suf(str_slice(tname, 1, str_len(tname)));
        return "@" + ll_mangle(gname);
    }                    // '@'
    // 裸全局名（TIR 跨模块全局引用可能不带 '@' 前缀）：按全局符号引用补 '@'，与旧轨 codegen_ll 一致。
    if (ll_is_global(tname)) { return "@" + ll_mangle(tname); }
    return tname;
}

// 指针目的地（store/load 的 ptr 操作数、addr_of 目标）用此变体：@name 全局引用保留 '@' 前缀。
pub fn ll_llname_ptr(tname: string) string {
    if (str_len(tname) >= 1 and tname[0] == 64) {
        // 与 ll_llname 的 '@' 分支同坑：必须剥 TIR 类型后缀 `.sN`，否则 load/store 的
        // ptr 操作数写成 @g.s9 而定义是 @g ⇒ "use of undefined value"。
        var pn: string = ll_strip_suf(str_slice(tname, 1, str_len(tname)));
        return "@" + ll_mangle(pn);
    }
    return ll_llname(tname);
}

pub fn ll_get_st(name: string) string {
    name = ll_llname(name);
    var n: i64 = slice_len(g_ll_names) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (g_ll_names[i] == name) { return g_ll_sts[i]; }
        i = i + 1;
    }
    return "i64";
}

// 返回槽 dn 的真实 alloca 存储类型；未注册返回 ""（调用方 ll_load/ll_call 据此回退到请求类型 st）。
// 与 ll_get_st 同源查找 g_ll_names/g_ll_sts，但缺失时返回空串哨兵而非 "i64"。
pub fn ll_alloca_st(dn: string) string {
    var nm: string = ll_llname(dn);
    var n: i64 = slice_len(g_ll_names) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (g_ll_names[i] == nm) { return g_ll_sts[i]; }
        i = i + 1;
    }
    return "";
}

// 返回槽 name 是否已被发射为 alloca（即 name 是「地址」而非「值寄存器」）。
// 用于切片/字符串下标时区分局部切片变量(地址，可直接传给 tll_slice_at)与
// member 字段读取 / call 返回值(值寄存器，须 alloca+store 物化地址)。
pub fn ll_is_emitted(name: string) bool {
    name = ll_llname(name);
    var n: i64 = slice_len(g_ll_emitted) as i64;
    var i: i64 = 0;
    while (i < n) { if (g_ll_emitted[i] == name) { return true; } i = i + 1; }
    return false;
}

pub fn ll_set_st(name: string, st: string) void {
    name = ll_llname(name);
    var n: i64 = slice_len(g_ll_names) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (g_ll_names[i] == name) { g_ll_sts[i] = st; return; }
        i = i + 1;
    }
    append(g_ll_names, base.str_persist(name));
    append(g_ll_sts, base.str_persist(st));
}

// 发射单个槽的 alloca（含定长数组堆分配与聚合零初始化），返回要写入 g_ll 的字符串。
// 以「是否已发射」(g_ll_emitted) 去重，而非「是否已注册」：ll_set_st 会对 dst 预注册类型但不发射 alloca。
pub fn ll_emit_alloca(tname: string, st: string) string {
    tname = ll_llname(tname);
    var n2: i64 = slice_len(g_ll_emitted) as i64;
    var j: i64 = 0;
    while (j < n2) { if (g_ll_emitted[j] == tname) { return ""; } j = j + 1; }
    var n: i64 = slice_len(g_ll_names) as i64;
    var i: i64 = 0;
    var found: i64 = -1;
    while (i < n) { if (g_ll_names[i] == tname) { found = i; break; } i = i + 1; }
    if (found < 0) { append(g_ll_names, base.str_persist(tname)); append(g_ll_sts, base.str_persist(st)); }
    else { g_ll_sts[found] = st; }
    append(g_ll_emitted, base.str_persist(tname));
    var sb: StringBuilder = sb_new();
    // 定长数组槽：栈 alloca 在地址流入逃逸 TSlice（如 first3 返回切片）时会悬空 → use-after-free。
    // 改为堆分配（tll_alloc）；堆是栈的超集，对所有用例语义安全（数据指针生命周期延长到堆上）。
    if (ll_starts(st, "arr<")) {
        var llt: string = st_to_ll(st);
        sb_append_str(sb, "  ");
        sb_append_str(sb, tname);
        sb_append_str(sb, ".sz = getelementptr ");
        sb_append_str(sb, llt);
        sb_append_str(sb, ", ptr null, i32 1\n");
        sb_append_str(sb, "  ");
        sb_append_str(sb, tname);
        sb_append_str(sb, ".bytes = ptrtoint ptr ");
        sb_append_str(sb, tname);
        sb_append_str(sb, ".sz to i64\n");
        sb_append_str(sb, "  ");
        sb_append_str(sb, tname);
        sb_append_str(sb, " = call ptr @tll_alloc(i64 ");
        sb_append_str(sb, tname);
        sb_append_str(sb, ".bytes)\n");
        // tll_alloc = 裸 malloc，不清零；`var y: [N]T;` 的元素必须显式置零。
        sb_append_str(sb, "  store ");
        sb_append_str(sb, llt);
        sb_append_str(sb, " zeroinitializer, ptr ");
        sb_append_str(sb, tname);
        sb_append_str(sb, "\n");
        var r: string = sb_to_str(sb);
        sb_free(sb);
        return r;
    }
    sb_append_str(sb, "  ");
    sb_append_str(sb, tname);
    sb_append_str(sb, " = alloca ");
    sb_append_str(sb, st_to_ll(st));
    sb_append_str(sb, "\n");
    // ⚠ 聚合槽零初始化：所有 `%` 命名聚合类型（slice/string/结构体/Map/闭包）的无初始化器局部
    // alloca 后若不置零，其内含的指针字段（slice 的 data/len/cap、Map 句柄、闭包 env、结构体里的
    // slice 字段）会被读成垃圾 → t_slice_append / t_str_* / map_* 撑爆 arena 或越界。
    // ⚠ 局部槽零初始化：所有类型（聚合 `%TSlice`/`%TStr`/结构体/Map/闭包 **以及标量**）
    // 的无初始化器局部 alloca 后都必须置零。此前只对 `%` 开头的聚合置零，标量
    // `var x: i64;` 读到的是栈上垃圾 —— 这是「LLVM 后端产物编译编译器自身即行为错乱」
    // 的根因：sema 的各类计数器 / 标志位读出脏值 → -O0 下循环上界失控 → 深递归爆栈
    // （exit 127），-O1/-O2 下优化器把 UB 常量化 → 空诊断 + exit 1 早退。
    // C 后端发 `T x = {0};` 故始终正确，差异只体现在 LLVM 后端上。
    if (str_len(st) > 0) {
        sb_append_str(sb, "  store ");
        sb_append_str(sb, st_to_ll(st));
        sb_append_str(sb, " zeroinitializer, ptr ");
        sb_append_str(sb, tname);
        sb_append_str(sb, "\n");
    }
    var r2: string = sb_to_str(sb);
    sb_free(sb);
    return r2;
}
