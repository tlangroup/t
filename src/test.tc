// ══════════════════════════════════════════════════════════════════
// src/test.tc — `tc test` 测试收集与运行器（docs/syntax/drafts/decl_test.md §5）
//
// 依赖：base（字符串/切片/文件/子进程）、parse（tokenize / parse_unit）、
//       sema（decl_list / ann_find / run_check / emit 系列）、
//       tir（lower_unit / tir_verify_module）/ tir_to_ll（tir_to_ll_emit / g_has_main）。
//
// 实现要点：**单遍 parse + token 追加**。lex.tokenize() 是 append 语义（不清空
// toks），parse.parse_unit() 遇 Eof 即停。因此：
//   ① lex.tokenize(用户源码)  → 记下此刻 slice_len(toks)（= 用户 Eof 之后）
//   ② pos=0; parse.parse_unit() → 收集 decl_list 里 bd==true 的测试元数据
//   ③ 按元数据生成 runner 源码（一个 @main 入口）
//   ④ lex.tokenize(runner)    → 追加到同一 token 池
//   ⑤ pos=<①的标记>; parse.parse_unit() → runner 声明追加进同一 decl_list
//   ⑥ run_check/flag_pass/ann_pass → 用户代码与 runner 走**同一次**完整 sema
//   ⑦ emit_llunit → clang 链接 → sys_run 执行，透传退出码
//
// 这样既无需重置 nodes/decl_list/g_test_seq 等一大票全局（重置易漏、易污染），
// 也让 runner 里的 format/print 走正常 sema 通路（format 的整数分派依赖 infer）。
// ══════════════════════════════════════════════════════════════════

const base = @import("src.base");
const lex = @import("src.lex");
const parse = @import("src.parse");
const sema = @import("src.sema");
const codegen_c = @import("src.codegen_c");
const tir = @import("src.tir");
@import("src.tir_to_ll" :: tir_to_ll_emit, g_has_main);
const comptime_fold = @import("src.comptime_fold");

// 收集到的测试（平行数组；顺序 = decl_list 顺序 = 源码书写顺序）
pub var tt_fn: []string;      // 合成函数名 __test_<k>
pub var tt_name: []string;    // 完整显示名（"suite / 子suite / 用例"）
pub var tt_skip: []bool;      // @skip：不调用，计入 skipped
pub var tt_xfail: []bool;     // @should_fail：返回 false 才算通过

// 把任意字符串安全嵌入生成源码的字符串字面量（转义 \ 与 "）
pub fn tt_esc(s: string) string {
    var sb: StringBuilder = sb_new();
    var i: u64 = 0;
    var n: u64 = str_len(s);
    while (i < n) {
        var ch: string = str_slice(s, i, i + 1);
        if (ch == "\\") {
            sb_append_str(sb, "\\\\");
        } else if (ch == "\"") {
            sb_append_str(sb, "\\\"");
        } else {
            sb_append_str(sb, ch);
        }
        i = i + 1;
    }
    return sb_to_str(sb);
}

// 朴素子串匹配（--filter 用；t 无 str_find 内建）
pub fn tt_has_sub(hay: string, needle: string) bool {
    var hn: u64 = str_len(hay);
    var nn: u64 = str_len(needle);
    if (nn == 0) { return true; }
    if (nn > hn) { return false; }
    var i: u64 = 0;
    while (i + nn <= hn) {
        if (str_slice(hay, i, i + nn) == needle) { return true; }
        i = i + 1;
    }
    return false;
}

// 从声明的注解链上摘掉 `@main`，返回是否摘到。
// 测试文件常常同时是一个可运行程序；`tc test` 要自带入口，两个 @main 会撞车。
// 与其把这类文件一票否决，不如让用户入口在**测试运行**这一趟里退位——
// 函数体照常编译，只是不再是进程入口。
pub fn tt_strip_main(d: i64) bool {
    var nd: Node = base.nodes[d];
    var prev: i64 = -1;
    var c: i64 = nd.la;
    while (c >= 0) {
        var k: Child = base.kids[c];
        if (base.nodes[k.val].sa == "main") {
            if (prev < 0) {
                nd.la = k.next;
                slice_set(base.nodes, d, nd);
            } else {
                var pk: Child = base.kids[prev];
                pk.next = k.next;
                slice_set(base.kids, prev, pk);
            }
            return true;
        }
        prev = c;
        c = k.next;
    }
    return false;
}

// 注解链上是否带 `@tag(x, ...)` 且含 want（实参节点无论 ident 还是 string 都存 sa）
pub fn tt_has_tag(head: i64, want: string) bool {
    var it: i64 = head;
    while (it >= 0) {
        var c: Child = base.kids[it];
        var an: Node = base.nodes[c.val];
        if (an.sa == "tag") {
            var p: i64 = an.la;
            while (p >= 0) {
                var pc: Child = base.kids[p];
                var pn: Node = base.nodes[pc.val];
                if (pn.sa == want) { return true; }
                p = pc.next;
            }
        }
        it = c.next;
    }
    return false;
}

// 生成 runner 源码：一个 `@main` 入口，顺序调用各 __test_k 并汇总
pub fn tt_gen_runner() string {
    var cnt: i64 = slice_len(tt_fn) as i64;
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "\nfn __tc_test_main() i32 @main {\n");
    sb_append_str(sb, "    var __tp: i64 = 0;\n");
    sb_append_str(sb, "    var __tf: i64 = 0;\n");
    sb_append_str(sb, "    var __ts: i64 = 0;\n");
    sb_append_str(sb, "    print(format(\"\\nrunning {} parse.test(s)\\n\\n\", ");
    sb_append_str(sb, base.i2s(cnt));
    sb_append_str(sb, "));\n");
    // 判定行**在测试跑完之后**才打印：expect 的失败详情走 stderr，判定行走 stdout，
    // 于是详情总在对应判定行之上（编译器诊断式「证据在前、结论在后」），
    // 而单独重定向 stdout 时能得到一份纯净可机读的用例清单。
    var i: i64 = 0;
    while (i < cnt) {
        var lead: string = base.sb_cat3("print(\"test ", tt_esc(tt_name[i]), " ... ");
        if (tt_skip[i]) {
            sb_append_str(sb, "    ");
            sb_append_str(sb, lead);
            sb_append_str(sb, "skipped\\n\");\n");
            sb_append_str(sb, "    __ts = __ts + 1;\n");
        } else {
            sb_append_str(sb, "    if (");
            sb_append_str(sb, tt_fn[i]);
            sb_append_str(sb, "()) {\n        ");
            if (tt_xfail[i]) {
                sb_append_str(sb, lead);
                sb_append_str(sb, "FAILED (expected failure, but passed)\\n\");\n");
                sb_append_str(sb, "        __tf = __tf + 1;\n    } else {\n        ");
                sb_append_str(sb, lead);
                sb_append_str(sb, "ok (expected failure)\\n\");\n");
                sb_append_str(sb, "        __tp = __tp + 1;\n    }\n");
            } else {
                sb_append_str(sb, lead);
                sb_append_str(sb, "ok\\n\");\n");
                sb_append_str(sb, "        __tp = __tp + 1;\n    } else {\n        ");
                sb_append_str(sb, lead);
                sb_append_str(sb, "FAILED\\n\");\n");
                sb_append_str(sb, "        __tf = __tf + 1;\n    }\n");
            }
        }
        i = i + 1;
    }
    sb_append_str(sb, "    print(format(\"\\ntest result: {} passed, {} failed, {} skipped\\n\", __tp, __tf, __ts));\n");
    sb_append_str(sb, "    if (__tf > 0) { return 1; }\n");
    sb_append_str(sb, "    return 0;\n}\n");
    return sb_to_str(sb);
}

pub fn run_test_cmd(argv: []string) i32 {
    var mode: string = "dbg";
    var clang_p: string = "clang";
    var rt_dir: string = "runtime";
    var filter: string = "";
    var tag: string = "";
    var src_file: string = "";
    var has_src: bool = false;
    var no_run: bool = false;       // --no-run：只编译不执行（gate/CI 用）
    var ai: i64 = 2;
    var an: i64 = slice_len(argv) as i64;
    while (ai < an) {
        if (argv[ai] == "--mode") {
            if (ai + 1 < an) { mode = argv[ai + 1]; ai = ai + 2; continue; }
        }
        if (argv[ai] == "--clang") {
            if (ai + 1 < an) { clang_p = argv[ai + 1]; ai = ai + 2; continue; }
        }
        if (argv[ai] == "--runtime") {
            if (ai + 1 < an) { rt_dir = argv[ai + 1]; ai = ai + 2; continue; }
        }
        if (argv[ai] == "--filter") {
            if (ai + 1 < an) { filter = argv[ai + 1]; ai = ai + 2; continue; }
        }
        if (argv[ai] == "--tag") {
            if (ai + 1 < an) { tag = argv[ai + 1]; ai = ai + 2; continue; }
        }
        if (argv[ai] == "--lib-dir") {
            if (ai + 1 < an) { append(lex.g_lib_dirs, argv[ai + 1]); ai = ai + 2; continue; }
        }
        if (argv[ai] == "--no-run") { no_run = true; ai = ai + 1; continue; }
        if (has_src == false) { src_file = argv[ai]; has_src = true; }
        ai = ai + 1;
    }
    if (has_src == false) {
        eprint("usage: tc test <file.tc> [--filter <substr>] [--tag <name>] [--mode dbg|rls] [--no-run]\n");
        return 2;
    }
    if (base.valid_mode(mode) == false) {
        eprint(base.sb_cat3("error: unknown --mode `", mode, "` (expected dbg|rls)\n"));
        return 2;
    }
    if (clang_p == "clang") {
        var crc0: i32 = sys_run("cmd /c if exist \"C:\\Program Files\\LLVM\\bin\\clang.exe\" (exit 0) else (exit 1)");
        if (crc0 == 0) { clang_p = "C:/Program Files/LLVM/bin/clang.exe"; }
    }

    // ── ① 用户源码：tokenize + parse ──────────────────────────
    base.g_file = base.rel_path(src_file);
    var src: string = file_read_all(src_file);
    lex.tokenize(src);
    if (sema.has_errors()) { base.emit_diags(); return 1; }
    var tok_mark: i64 = slice_len(base.toks) as i64;   // 用户源码 Eof 之后
    lex.pos = 0;
    sema.init_anndefs();
    parse.parse_unit();

    // ── ② 收集测试；先扫一遍看有没有 @only ────────────────────
    var dn: i64 = slice_len(lex.decl_list) as i64;
    var has_only: bool = false;
    var di: i64 = 0;
    while (di < dn) {
        var d0i: i64 = lex.decl_list[di];
        var d0: Node = base.nodes[d0i];
        if (d0.kind == "FuncDecl") {
            if (d0.bd && parse.ann_find(d0.la, "only") >= 0) { has_only = true; }
            if (d0.bd == false && parse.ann_find(d0.la, "main") >= 0) {
                if (tt_strip_main(d0i)) {
                    eprint(base.sb_cat3("note: `", d0.sa,
                        "` 的 @main 在本次 test 运行中被忽略（测试入口由 tc 合成）\n"));
                }
            }
        }
        di = di + 1;
    }

    var total: i64 = 0;      // 源码里的测试总数（过滤前）
    di = 0;
    while (di < dn) {
        var d: i64 = lex.decl_list[di];
        var nd: Node = base.nodes[d];
        if (nd.kind == "FuncDecl" && nd.bd) {
            total = total + 1;
            var disp: string = nd.sb;
            if (str_len(nd.sc) > 0) { disp = base.sb_cat3(nd.sc, " / ", nd.sb); }
            var keep: bool = true;
            if (has_only && parse.ann_find(nd.la, "only") < 0) { keep = false; }
            if (str_len(filter) > 0 && tt_has_sub(disp, filter) == false) { keep = false; }
            if (str_len(tag) > 0 && tt_has_tag(nd.la, tag) == false) { keep = false; }
            if (keep) {
                append(tt_fn, nd.sa);
                append(tt_name, disp);
                append(tt_skip, parse.ann_find(nd.la, "skip") >= 0);
                append(tt_xfail, parse.ann_find(nd.la, "should_fail") >= 0);
            }
        }
        di = di + 1;
    }
    var sel: i64 = slice_len(tt_fn) as i64;
    if (total == 0) {
        eprint(base.sb_cat3("error: ", base.to_bs(src_file), " 中没有任何测试（`test \"名字\" { ... }`）\n"));
        return 1;
    }
    if (sel == 0) {
        eprint("error: 过滤条件未命中任何测试（检查 --filter / --tag / @only）\n");
        return 1;
    }

    // ── ③④⑤ 生成 runner，追加 token 后接着 parse ────────────
    lex.tokenize(tt_gen_runner());
    lex.pos = tok_mark;
    parse.parse_unit();

    // ── ⑥ 用户代码 + runner 一次性走完整 sema ────────────────
    sema.run_check();
    sema.flag_pass();
    sema.ann_pass();
    if (sema.has_errors()) {
        base.emit_diags();
        return 1;
    }

    // ── ⑦ emit → link → run ──────────────────────────────────
    var mod2: string = base.base_no_tc(src_file);
    tir.lower_unit(mod2, src_file);
    tir.tir_verify_module();
    var lltext: string = tir_to_ll.tir_to_ll_emit(tir.g_mod);
    var out_p: string = base.sb_cat4("out/", mode, "/tests/", mod2);
    var llp: string = base.sb_cat2(out_p, ".ll");
    base.ensure_parent(llp);
    file_write_all(llp, lltext);
    if (tir_to_ll.g_has_main == false) {
        eprint("error: internal: 合成的测试入口未产生 @main\n");
        return 1;
    }

    var exep: string = base.sb_cat2(out_p, ".exe");
    // ⚠ 同 src/tc.tc：2026-09-26 起 t_runtime.c 依赖 vendored 四库，不可从源码直编，
    //   缺失预编译库时直接报可操作诊断（不再回退直编）。
    var deps_lib: string = base.sb_cat3("out/", mode, "/deps/t_runtime.lib");
    var use_lib: bool = sema.path_exists(deps_lib);
    var opt: string = "-O2";
    if (mode == "dbg") { opt = "-O0 -gcodeview"; }
    var csb: StringBuilder = sb_new();
    sb_append_str(csb, "\"");
    sb_append_str(csb, clang_p);
    sb_append_str(csb, "\" ");
    sb_append_str(csb, opt);
    sb_append_str(csb, " -o \"");
    sb_append_str(csb, exep);
    sb_append_str(csb, "\" -Wl,-subsystem:console \"");
    sb_append_str(csb, llp);
    sb_append_str(csb, "\" ");
    if (use_lib) {
        sb_append_str(csb, "\"");
        sb_append_str(csb, deps_lib);
        sb_append_str(csb, "\"");
    } else {
        eprint(base.sb_cat5("error: 运行时静态库缺失：", deps_lib,
            " —— t_runtime.c 已依赖 vendored 的 mimalloc / fdlibm / imath / Ryu，不可从源码直编。",
            "\n  先执行：node tools/build_runtime.mjs", "\n"));
        return 1;
    }
    var elk: i64 = 0;
    var nelk: i64 = slice_len(lex.g_ext_link) as i64;
    while (elk < nelk) {
        sb_append_str(csb, " \"");
        sb_append_str(csb, lex.g_ext_link[elk]);
        sb_append_str(csb, "\"");
        elk = elk + 1;
    }
    var rc: i32 = sys_run(sb_to_str(csb));
    if (rc != 0) {
        eprint("clang link failed\n");
        return 1;
    }
    if (no_run) {
        print(base.sb_cat3("Built: ", base.to_bs(exep), "\n"));
        return 0;
    }
    return sys_run(base.sb_cat3("\"", base.to_bs(exep), "\""));
}
