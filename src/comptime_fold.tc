// ══════════════════════════════════════════════════════════════════
// src/comptime_fold.tc — 全量 comptime（弥漫式折叠）P0+P1 骨架
//
// 设计要点（详见 docs/compiler/comptime-design.md）：
//   • t 已有 CTFE 求值器 meta_eval（sema.tc），本模块「复用」它，不重造。
//   • 「全量 comptime」= 把 meta_eval 的触发范围从「仅 comptime 标记节点」
//     扩大到「任意全 const 可折的普通表达式节点」。
//   • 折叠产物是已原地改写为字面量的 AST；C/LLVM 后端照常发射，
//     comptime 逻辑零后端相关 → 守双后端等价与四代不动点。
//   • 安全护栏：只折「子树不含 ident/call/index/array_lit」的纯字面量
//     算术/布尔/cast/paren，绝不触发 meta_eval 的 meta_fail（否则会向诊断
//     塞伪错误）。运行期内建与运行期变量引用一律跳过。
//
// DAG：依赖 base / sema（吃节点池 + meta_eval）。被 tc.tc 在 sema.run_check()
// 之后调用。当前默认关闭（g_comptime_full=false），以免扰动既有门禁；
// 翻转该全局即可启用 P0+P1 验证。
// ══════════════════════════════════════════════════════════════════

const base = @import("src.base");
const sema = @import("src.sema");

// 总开关：默认关闭，启用即翻转为真并重新构建 tc。
// P0+P1 验证用；长期默认应由 gate 复核后开启。
pub var g_comptime_full: bool = true;

// 候选折叠的表达式节点种类（P0 范围）。
// 不含 cast：cast 节点承载窄化（u8/i16 等），折掉会丢窄类型信息；
// P0+P1 让外层 cast 继续正确窄化，故排除。不含 comptime / comptime_block
// （已由 meta_pass 处理），不含声明节点。
pub fn comptime_is_candidate(k: string) bool {
    if (k == "binary") { return true; }
    if (k == "unary") { return true; }
    if (k == "paren") { return true; }
    if (k == "array_lit") { return true; }
    if (k == "struct_lit") { return true; }
    if (k == "index") { return true; }
    if (k == "match") { return true; }
    return false;
}

// 子树是否含运行期引用（ident/call/index/array_lit）。
// 命中则禁止 meta_eval，避免 meta_fail 塞入伪诊断错误。
pub fn comptime_has_runtime_ref_list(head: i64) bool {
    var c: i64 = head;
    while (c >= 0) {
        if (comptime_has_runtime_ref(base.kids[c].val)) { return true; }
        c = base.kids[c].next;
    }
    return false;
}

// 该 call 是否为变体编译期辅助调用（Name_from_Case / Name_is_Case /
// Name_as_Case[_fK]）。是则放行（仅递归检查实参，不允许整棵被当运行期引用拒掉），
// 让 meta_eval 内部的变体值求值接管；否（普通运行期调用）仍为硬运行期引用。
// S4 §0.14.7 SoA（第十七批·na）：原签名 `comptime_call_is_variant(n: Node)`。
//   唯一调用方 `comptime_has_runtime_ref(e: i64)` 传入的 `n` 与 `base.nodes[e]` **恒等**
//   ⇒ 属「Node 值形参第三类」：**直接删冗余 Node 值形参**、改收索引 e。
//   ⚠ 收索引而非读 `.id`：结构体值传参会丢末尾字段，侧表会读到错误节点。
pub fn comptime_call_is_variant(e: i64) bool {
    var na: i64 = base.node_na((e as u64));
    if (na < 0) { return false; }
    if (base.node_kind((na as u64)) != "ident") { return false; }
    return sema.meta_str_find(base.node_sa((na as u64)), "_from_") >= 0
        || sema.meta_str_find(base.node_sa((na as u64)), "_is_") >= 0
        || sema.meta_str_find(base.node_sa((na as u64)), "_as_") >= 0;
}

pub fn comptime_has_runtime_ref(e: i64) bool {
    if (e < 0) { return false; }
    // 仅 ident/call 是「硬运行期引用」；index/array_lit/struct_lit 是可折
    // 容器，交由 meta_eval 内部递归处理（其子树若含 ident/call 会被下面的
    // 递归检查捕获并阻止）。P2 起不再把它们当运行期引用拒之门外。
    if (base.node_kind((e as u64)) == "ident") { return true; }
    if (base.node_kind((e as u64)) == "conpat") {
        // 纯模式子树：绑定标识符 + 嵌套 conpat，绝不含运行期值引用
        return false;
    }
    if (base.node_kind((e as u64)) == "call") {
        if (comptime_call_is_variant(e)) {
            return comptime_has_runtime_ref_list(base.node_la((e as u64)));
        }
        return true;
    }
    if (comptime_has_runtime_ref(base.node_na((e as u64)))) { return true; }
    if (comptime_has_runtime_ref(base.node_nb((e as u64)))) { return true; }
    if (comptime_has_runtime_ref(base.node_nc((e as u64)))) { return true; }
    if (comptime_has_runtime_ref(base.node_nd((e as u64)))) { return true; }   // S4 §0.14.7 SoA：侧表访问器（原 .nd）
    if (comptime_has_runtime_ref_list(base.node_la((e as u64)))) { return true; }
    if (comptime_has_runtime_ref_list(base.node_lb((e as u64)))) { return true; }
    if (comptime_has_runtime_ref_list(base.node_lc((e as u64)))) { return true; }
    return false;
}

// 把节点 e 原地改写为字面量节点 v（复用 meta_fold_expr 的改写模式，
// 保留 ln/cl/tv 诊断锚点；清零子节点槽，la 仅 array_lit 有元素链）。
pub fn comptime_rewrite_to_literal(e: i64, v: i64) void {
    if (e < 0 || v < 0) { return; }
    base.node_set_kind((e as u64), base.node_kind((v as u64)));
    base.node_set_sa((e as u64), base.node_sa((v as u64)));
    base.node_set_ia((e as u64), base.node_ia((v as u64)));
    base.node_set_ba((e as u64), base.node_ba((v as u64)));   // S4 §0.14.7 SoA：侧表访问器（原 .ba；第十批）
    base.node_set_na((e as u64), -1);   // S4 §0.14.7 SoA：侧表写（原 `dst.na = -1`；第十七批）
    base.node_set_nb((e as u64), -1);
    base.node_set_nc((e as u64), -1);   // S4 §0.14.7 SoA：侧表写（原 dst.nc = -1；第九批）
    base.node_set_nd((e as u64), -1);   // S4 §0.14.7 SoA：侧表访问器（原 .nd）
    base.node_set_la((e as u64), base.node_la((v as u64)));
}

// ── 常数枚举：成员显式赋值（`= expr`）编译期求值 ─────────────────────
// t 的 `enum` 是「常数枚举」：每个成员都是一个具名编译期常量，其值可显式
// 赋值，赋值表达式在编译期求值并原地折为整数字面量，使 C/LLVM 双后端都得到
// 正确的常量（含 `comptime fn` 调用、以及其它枚举成员的引用）。该语义独立于
// 弥漫式折叠开关，始终启用。
//
// 设计要点：
//   • 通过 meta_eval 求值：字面量/算术/cast/comptime fn 调用/枚举成员引用
//     （Enum.Member，含前向引用，靠定点迭代解决）都能折为 int 字面量。
//   • 每个成员折出的值登记到 sema.g_enum_cn/g_enum_cvi，供后续成员（同枚举或
//     其它枚举）引用；自动编号成员也登记（值 = 当前 auto_val），故可被引用。
//   • 定点迭代：显式值成员可能引用尚未折出的成员，多次扫描直至不再变化。
//   • 失败（非编译期常量 / 折叠结果非整数 / 定点后仍不可解）→ 复用 T-SEM-E202。
//   • 求值成功后 comptime_rewrite_to_literal 把 v.na 原地改写为整数字面量，
//     C/LLVM 后端各自只认 `kind == "int"`，故零后端改动即得正确常量与 auto_val 续推。
pub fn fold_enum_values() void {
    var svq: bool = sema.g_meta_quiet;
    var sve: bool = sema.g_meta_err;
    sema.g_meta_steps = 4000000;
    sema.g_meta_err = false;
    sema.g_meta_quiet = true;
    // 定点迭代：最多扫描（成员总数 + 1）轮，确保任意依赖序都能收敛
    var guard: i64 = 0;
    var changed: bool = true;
    while (changed && guard < 100000) {
        changed = false;
        guard = guard + 1;
        var i: i64 = 0;
        var total: i64 = base.node_count();
        while (i < total) {
            if (base.node_kind((i as u64)) == "EnumDecl") {
                if (fold_one_enum(i)) { changed = true; }
            }
            i = i + 1;
        }
    }
    // 定点后仍未折出的显式值成员 = 非编译期常量 → 报错
    var i2: i64 = 0;
    var t2: i64 = base.node_count();
    while (i2 < t2) {
        if (base.node_kind((i2 as u64)) == "EnumDecl") { report_unfolded_enum(i2); }
        i2 = i2 + 1;
    }
    sema.g_meta_quiet = svq;
    sema.g_meta_err = sve;
}

// 折单个枚举：按声明序处理成员，显式值成员尝试编译期求值并原地改写，
// 所有成员（显式折出 / 自动编号）的值登记到注册表供交叉引用。
// 返回本轮是否折出了新成员（驱动定点迭代）。
pub fn fold_one_enum(d: i64) bool {
    var changed: bool = false;
    var auto_val: i64 = 0;
    var c: i64 = base.node_lb((d as u64));
    while (c >= 0) {
        var k: Child = base.kids[c];
        if (base.node_na((k.val as u64)) >= 0) {
            if (base.node_kind((base.node_na((k.val as u64)) as u64)) == "int") {
                // 已是字面量：登记其值（供其它成员引用）并续推 auto_val
                var fv: i64 = sema.js_parse_int(base.node_sa((base.node_na((k.val as u64)) as u64)), base.node_ia((base.node_na((k.val as u64)) as u64)));
                sema.enum_const_set(base.node_sa((d as u64)), base.node_sa((k.val as u64)), fv);
                auto_val = fv + 1;
                c = k.next;
                continue;
            }
            // 未折：尝试编译期求值
            var vv: i64 = sema.meta_eval(base.node_na((k.val as u64)));
            sema.g_meta_err = false; // 复位：避免不可折节点污染后续成员
            if (vv >= 0 && base.node_kind((vv as u64)) == "int") {
                comptime_rewrite_to_literal(base.node_na((k.val as u64)), vv);
                var fv: i64 = sema.js_parse_int(base.node_sa((base.node_na((k.val as u64)) as u64)), base.node_ia((base.node_na((k.val as u64)) as u64)));
                sema.enum_const_set(base.node_sa((d as u64)), base.node_sa((k.val as u64)), fv);
                auto_val = fv + 1;
                changed = true;
            }
            // 否则留待下轮（被引用的成员可能本轮回填）
        } else {
            // 自动编号成员：值 = 当前 auto_val，登记供其它成员引用（不改写 v.na）
            sema.enum_const_set(base.node_sa((d as u64)), base.node_sa((k.val as u64)), auto_val);
            auto_val = auto_val + 1;
        }
        c = k.next;
    }
    return changed;
}

// 定点后仍未折出的显式值成员 → 非编译期常量，复用 T-SEM-E202 报错。
pub fn report_unfolded_enum(d: i64) void {
    var c: i64 = base.node_lb((d as u64));
    while (c >= 0) {
        var k: Child = base.kids[c];
        if (base.node_na((k.val as u64)) >= 0 && base.node_kind((base.node_na((k.val as u64)) as u64)) != "int") {
            var vv: i64 = sema.meta_eval(base.node_na((k.val as u64)));
            sema.g_meta_err = false;
            if (vv < 0) {
                base.diag_new("T-SEM-E202", "error",
                    base.sb_cat6("enum '", base.node_sa((d as u64)), "' 成员 '", base.node_sa((k.val as u64)),
                        "' 的赋值必须是编译期常量（字面量 / 算术 / const / comptime fn / 枚举成员引用），无法在编译期求值", ""),
                    "", 1, 1, 1, 10);
            } else if (base.node_kind((vv as u64)) != "int") {
                base.diag_new("T-SEM-E202", "error",
                    base.sb_cat6("enum '", base.node_sa((d as u64)), "' 成员 '", base.node_sa((k.val as u64)),
                        "' 的编译期值必须是整数，得到 ", base.node_kind((vv as u64))),
                    "", 1, 1, 1, 5);
            }
        }
        c = k.next;
    }
}

// 全量 comptime 折叠 pass：遍历整池节点，对候选表达式尝试 meta_eval，
// 成功（返回字面量节点 id）则原地改写。仅处理 sema.run_check() 之后、类型已检的 AST。
//
// 安全要点：
//   • 复用 meta_eval 的求值上下文（步数预算 + quiet 抑制伪诊断），但每次调用
//     后复位 g_meta_err —— 否则一旦某节点不可折，meta_eval 置位 g_meta_err 会让
//     后续所有调用短路返回 -1，既压低覆盖率又可能把错误态泄漏到 codegen。
//   • 结束前还原 g_meta_quiet / g_meta_err 原值，不影响其他阶段。
pub fn comptime_fold_pass() void {
    // 常数枚举编译期求值：独立于弥漫式折叠开关，先于全量折叠执行。
    fold_enum_values();
    if (g_comptime_full == false) { return; }
    var sv_quiet: bool = sema.g_meta_quiet;
    var sv_err: bool = sema.g_meta_err;
    sema.g_meta_steps = 4000000;
    sema.g_meta_err = false;
    sema.g_meta_quiet = true;
    var i: i64 = 0;
    var n: i64 = base.node_count();
    while (i < n) {
        var k: string = base.node_kind((i as u64));
        // 已由 meta_pass 处理的 comptime 节点跳过，避免重复改写
        if (k == "comptime" || k == "comptime_block") {
            i = i + 1;
            continue;
        }
        if (comptime_is_candidate(k) == false) {
            i = i + 1;
            continue;
        }
        // 安全护栏：含运行期引用则跳过（meta_eval 撞运行期引用会 meta_fail）。
        // match 例外：其 scrutinee/body 引用的「标识符」多为模式绑定（编译期已知），
        // 由 meta_eval_match 内部按 conpat 绑定到 menv 后求值；故直接尝试，失败则放弃。
        if (k != "match" && comptime_has_runtime_ref(i)) {
            i = i + 1;
            continue;
        }
        var v: i64 = sema.meta_eval(i);
        sema.g_meta_err = false; // 复位：允许后续节点继续尝试折叠
        if (v >= 0) {
            comptime_rewrite_to_literal(i, v);
        }
        i = i + 1;
    }
    sema.g_meta_quiet = sv_quiet;
    sema.g_meta_err = sv_err;
}
