// ══════════════════════════════════════════════════════════════════
// src/mir.tc — tmir 机器中间层（compiler-pipeline-route.md §9）
//
// 位置：TIR 之后、各轻量后端（WASM / RISC-V / C）之前。取代 LLVM 作为
// 「一套 tmir、多个薄后端」的通用中间层，使新增目标（wasm / riscv / …）只需
// 写一个薄发射器，而非各自维护一份完整降级。
//
// 设计要点（对齐 §5.6 零 string 语义）：
//   - tmir = TIR 的「显式 CFG + 机器类型」形态：复用 TIR 的操作码（TIR_OP_*）
//     与操作数（TirOperand）与存储类型格（ST_*），不重新发明。
//   - 区别仅在结构：把 TIR 的线性指令按基本块（TMIRBlock）重分组，使每个
//     后端成为薄发射器（遍历 TMIRFunc.blocks，按 TMIRInst.op 分支直译）。
//   - tmir 操作数沿用 TIR 的 slot/全局/立即数命名（"$v3" / "@g" / "5"），
//     后端据此映射到本目标寄存器/局部/栈槽；不做任何文本 round-trip。
//   - tmir_to_text() 仅供调试与快照，是 TMIRModule 的单向派生（§5.6 判据 5）。
// ══════════════════════════════════════════════════════════════════

const base = @import("src.base");
const tir = @import("src.tir");

// ── tmir 内存结构 ───────────────────────────────────────────────
// 指令：复用 TIRInst 的全部字段语义（op/st/dst/args/line/cmt），仅类型改名以
// 标明其处于「机器层」语义域（操作码已是机器 op，无高层构造）。
pub struct TMIRInst {
    op: i64;            // 操作码整数判别（复用 TIR_OP_*）
    st: i64;            // 存储类型（ST_* 编码）
    dst: TirOperand;    // 目标操作数（slot / global）
    args: []TirOperand; // 源操作数列表
    line: u64;          // 源锚点行（诊断用）
    cmt: string;        // 注释（is_comment 时有效）
    is_comment: bool;   // true → 注释（不支持构造的临时兜底）
}

// 基本块：显式 CFG 节点。块以终止指令（br/br_cond/ret/ret_void）结束。
pub struct TMIRBlock {
    name: string;       // 块标签（TIR 的 @LN，如 "@L0"）
    insts: []TMIRInst;   // 块内线性指令（不含跨块跳转的含义，跳转在终止指令 args）
}

pub struct TMIRFunc {
    name: string;       // @name（不含 @）
    params: []string;   // "$p: ST" 文本列表（与 TIR 同构）
    ret_st: string;     // 返回存储类型文本
    blocks: []TMIRBlock; // 基本块列表（顺序即发射顺序；入口块通常 index 0）
    is_extern: bool;
    is_main: bool;      // @main 入口标注
}

pub struct TMIRGlobal {
    name: string;       // 全局变量名（不含 @）
    td: i64;            // 类型描述符
    init: i64;          // 初始化表达式节点（-1 表示无）
    is_link: i64;       // 0=本模块, 1/2=链接库
}

pub struct TMIRModule {
    mod: string;        // 来源模块名
    source: string;     // 源文件路径
    types: []TIRType;   // TT 类型表（复用 TIR 的 TT 表示）
    strings: []string;  // 字符串表
    globals: []TMIRGlobal;
    funcs: []TMIRFunc;
}

pub var g_tmir: TMIRModule;

// ── ST → 目标存储类映射帮手（供各后端复用）────────────────────
// WASM 只有 i32/i64/f32/f64 四种数值类型；窄整数与指针一律提升到 i32（WASM32 地址）。
pub fn tmir_st_wasm(st: i64) string {
    if (st == tir__ST_I1 or st == tir__ST_I8 or st == tir__ST_U8 or st == tir__ST_I16 or st == tir__ST_U16 or
        st == tir__ST_I32 or st == tir__ST_U32 or st == tir__ST_PTR or st == tir__ST_PTR_VOID) { return "i32"; }
    if (st == tir__ST_I64 or st == tir__ST_U64) { return "i64"; }
    if (st == tir__ST_F32) { return "f32"; }
    if (st == tir__ST_F64) { return "f64"; }
    return "i32";
}

// RISC-V（rv64）：整数用 x 寄存器类，浮点用 f/d；ptr 在 rv64 为 64 位。
// 返回 "w"(32 位整数) / "x"(64 位整数或指针) / "f"(f32) / "d"(f64)。
pub fn tmir_st_rv(st: i64) string {
    if (st == tir__ST_I64 or st == tir__ST_U64 or st == tir__ST_PTR or st == tir__ST_PTR_VOID) { return "x"; }
    if (st == tir__ST_F32) { return "f"; }
    if (st == tir__ST_F64) { return "f"; }
    return "w"; // ST_I1/I8/U8/I16/I32/U32 → 32 位
}

// C：直接映射到 <stdint.h> 类型（便携后端，无需 LLVM）。
pub fn tmir_st_c(st: i64) string {
    if (st == tir__ST_I1) { return "int32_t"; }
    if (st == tir__ST_I8) { return "int8_t"; }
    if (st == tir__ST_U8) { return "uint8_t"; }
    if (st == tir__ST_I16) { return "int16_t"; }
    if (st == tir__ST_U16) { return "uint16_t"; }
    if (st == tir__ST_I32) { return "int32_t"; }
    if (st == tir__ST_U32) { return "uint32_t"; }
    if (st == tir__ST_I64) { return "int64_t"; }
    if (st == tir__ST_U64) { return "uint64_t"; }
    if (st == tir__ST_F32) { return "float"; }
    if (st == tir__ST_F64) { return "double"; }
    if (st == tir__ST_PTR or st == tir__ST_PTR_VOID) { return "void*"; }
    // 命名类型（指针 / 聚合 / 数组）：映射到字节缓冲模型的 C 类型，与 c_tystr_c（槽声明）保持一致。
    // 此前对命名类型一律回落 int64_t，导致「临时量 int64_t」与「槽 unsigned char*」错配（int64↔unsigned char* 簇的根因）。
    if (st >= tir__ST_NAMED_BASE) {
        var ts: string = tir.tir_st_to_str(st);
        if (ts == "%TStr") { return "TStr"; }
        if (ts == "%TSlice") { return "TSlice"; }
        if (ts == "%TClosure") { return "TClosure"; }
        if (ts == "%TBitStr") { return "TBitStr"; }
        // 其余命名类型（用户聚合 / 指针 / 数组）→ 字节缓冲模型统一 unsigned char*。
        // 自包含前缀判断（tmir.tc 无 c_starts）。
        var L: i64 = str_len(ts) as i64;
        if (L >= 1 and ts[0] == 37) { return "unsigned char*"; }       // '%' 命名聚合
        if (L >= 4 and ts[0] == 112 and ts[1] == 116 and ts[2] == 114 and ts[3] == 60) { return "unsigned char*"; } // "ptr<"
        if (L >= 1 and ts[0] == 91) { return "unsigned char*"; }       // '[' 数组
        return "int64_t";
    }
    return "int64_t";
}

// 操作数是否带符号（用于 CMP 选择 signed/unsigned 变体）。
pub fn tmir_st_signed(st: i64) bool {
    if (st == tir__ST_U8 or st == tir__ST_U16 or st == tir__ST_U32 or st == tir__ST_U64 or st == tir__ST_PTR or st == tir__ST_PTR_VOID) { return false; }
    return true;
}

// ── 指令构造帮手 ───────────────────────────────────────────────
pub fn mir_a0() []TirOperand { var z: []TirOperand = []; return z; }
pub fn mir_a1(n1: string) []TirOperand { var z: []TirOperand = []; append(z, tir.tir_op(n1)); return z; }
pub fn mir_a2(n1: string, n2: string) []TirOperand { var z: []TirOperand = []; append(z, tir.tir_op(n1)); append(z, tir.tir_op(n2)); return z; }
pub fn mir_a3(n1: string, n2: string, n3: string) []TirOperand { var z: []TirOperand = []; append(z, tir.tir_op(n1)); append(z, tir.tir_op(n2)); append(z, tir.tir_op(n3)); return z; }

pub fn tmir_copy_inst(ins: TIRInst) TMIRInst {
    var m: TMIRInst;
    m.op = ins.op;
    m.st = ins.st;
    m.dst = ins.dst;
    m.line = ins.line;
    m.cmt = ins.cmt;
    m.is_comment = ins.is_comment;
    var na: i64 = slice_len(ins.args) as i64;
    var i: i64 = 0;
    while (i < na) { append(m.args, ins.args[i]); i = i + 1; }
    return m;
}

// ── TIR → tmir 降级（核心：线性指令按基本块重分组）──────────────
// TIR 已是线性序列 + 显式块标签（TIR_OP_BLOCK，dst.name=标签）与终止指令
// （br/br_cond/ret/ret_void）。tmir 仅把这些重新分组为 []TMIRBlock，语义不变。
pub fn tir_to_tmir_lower(m: TIRModule) TMIRModule {
    var mm: TMIRModule;
    mm.mod = m.mod;
    mm.source = m.source;
    mm.types = m.types;
    mm.strings = m.strings;
    var ng: i64 = slice_len(m.globals) as i64;
    var i: i64 = 0;
    while (i < ng) {
        var g: TIRGlobal = m.globals[i];
        append(mm.globals, TMIRGlobal{ name: g.name, td: g.td, init: g.init, is_link: g.is_link });
        i = i + 1;
    }
    var nf: i64 = slice_len(m.funcs) as i64;
    var j: i64 = 0;
    while (j < nf) {
        append(mm.funcs, tmir_lower_func(m.funcs[j]));
        j = j + 1;
    }
    return mm;
}

pub fn tmir_lower_func(f: TIRFunc) TMIRFunc {
    var mf: TMIRFunc;
    mf.name = f.name;
    mf.params = f.params;
    mf.ret_st = f.ret_st;
    mf.is_extern = f.is_extern;
    mf.is_main = f.is_main;

    var cur: TMIRBlock;
    cur.name = "@entry";
    var started: bool = false;
    var nb: i64 = slice_len(f.body) as i64;
    var k: i64 = 0;
    while (k < nb) {
        var ins: TIRInst = f.body[k];
        if (ins.op == tir__TIR_OP_BLOCK) {
            // 新基本块开始：先压入当前块（若有内容），再以块标签起新块。
            if (started) { append(mf.blocks, cur); }
            cur = TMIRBlock{};
            cur.name = ins.dst.name;
            started = true;
            k = k + 1;
            continue;
        }
        if (ins.op == tir__TIR_OP_BR or ins.op == tir__TIR_OP_BR_COND or
            ins.op == tir__TIR_OP_RET or ins.op == tir__TIR_OP_RET_VOID) {
            // 终止指令：结束当前块。
            append(cur.insts, tmir_copy_inst(ins));
            append(mf.blocks, cur);
            cur = TMIRBlock{};
            started = false;
            k = k + 1;
            continue;
        }
        // 普通指令：确保当前块已起名（首个块默认 @entry）。
        if (started == false) { cur.name = "@entry"; started = true; }
        append(cur.insts, tmir_copy_inst(ins));
        k = k + 1;
    }
    if (started) { append(mf.blocks, cur); }
    return mf;
}

// ── 调试 / 快照：TMIRModule → 文本（单向派生，禁止回喂任何层）──
pub fn tmir_to_text(m: TMIRModule) string {
    var sb: StringBuilder = sb_new();
    var nf: i64 = slice_len(m.funcs) as i64;
    var i: i64 = 0;
    while (i < nf) {
        var f: TMIRFunc = m.funcs[i];
        sb_append_str(sb, "fn @");
        sb_append_str(sb, f.name);
        sb_append_str(sb, " (");
        var np: i64 = slice_len(f.params) as i64;
        var p: i64 = 0;
        while (p < np) {
            if (p > 0) { sb_append_str(sb, ", "); }
            sb_append_str(sb, f.params[p]);
            p = p + 1;
        }
        sb_append_str(sb, ") -> ");
        sb_append_str(sb, f.ret_st);
        sb_append_str(sb, " {\n");
        var nb: i64 = slice_len(f.blocks) as i64;
        var b: i64 = 0;
        while (b < nb) {
            var blk: TMIRBlock = f.blocks[b];
            sb_append_str(sb, "  ");
            sb_append_str(sb, blk.name);
            sb_append_str(sb, ":\n");
            var ni: i64 = slice_len(blk.insts) as i64;
            var k: i64 = 0;
            while (k < ni) {
                var ins: TMIRInst = blk.insts[k];
                if (ins.is_comment) {
                    sb_append_str(sb, "    ; ");
                    sb_append_str(sb, ins.cmt);
                    sb_append_str(sb, "\n");
                    k = k + 1;
                    continue;
                }
                sb_append_str(sb, "    ");
                sb_append_str(sb, tir.tir_op_to_str(ins.op));
                sb_append_str(sb, " ");
                sb_append_str(sb, tir.tir_os(ins.dst.name, ins.dst.st));
                var na: i64 = slice_len(ins.args) as i64;
                var a: i64 = 0;
                while (a < na) {
                    sb_append_str(sb, " ");
                    sb_append_str(sb, tir.tir_os(ins.args[a].name, ins.args[a].st));
                    a = a + 1;
                }
                sb_append_str(sb, "\n");
                k = k + 1;
            }
        }
        sb_append_str(sb, "}\n");
        i = i + 1;
    }
    return sb_to_str(sb);
}
