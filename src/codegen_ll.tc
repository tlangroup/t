    if (n.kind == "deref") {
        var p: string = emit_lle(n.na);
        var otd: i64 = ll_etd(n.na);
        var etd: i64 = -1;
        if (otd >= 0) { etd = sema.tds[otd].elem; }
        if (etd < 0) { etd = ll_etd(e); }
