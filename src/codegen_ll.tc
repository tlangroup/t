    if (n.kind == "match") {
        codegen_c.g_match_cnt = codegen_c.g_match_cnt + 1;
        var mv_no: i64 = codegen_c.g_match_cnt;
        var mv_rn: string = base.sb_cat2("_tmr", base.i2s(mv_no));
        var mv_sn: string = base.sb_cat2("_tms", base.i2s(mv_no));
        var mv_std: i64 = ll_etd(n.na);
        codegen_c.fs_set(codegen_c.em_cur_fn, mv_sn, mv_std);
        ll_local_decl(mv_sn, mv_std, n.na);
        var mv_pushed: i64 = codegen_c.match_bind_push(e, mv_no);
        // ADT conpat 臂：与 C 后端同理（见 codegen_c::match_conpat_binds_register），
        // 先登记载荷绑定类型，否则首臂体引用绑定时 mv_rtd 退化为 unknown，
