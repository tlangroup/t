        // 否则 `store i64 ... , ptr %v.b`（b: i8）是非法 IR。C 后端靠隐式转换，LLVM 不会。
        if (ldsel == "f") {
            var ldft: string = ll_tmp();
            var ldbits: string = base.i2s(sema.get_bw(sema.td_sname(ldtd)));
            llfb(base.sb_cat6("  ", ldft, " = call double @tll_deser_f64(i64 ", ldf,
                ", i32 ", base.sb_cat2(ldbits, ")")));
            return ll_cast_v(ldft, sema.td_named_mk("scalar", "f64"), ldtd);
        }
        var lint: string = ll_tmp();
        var lbits2: string = base.i2s(sema.get_bw(sema.td_sname(ldtd)));
        var lsgn2: string = "0";
        if (base.ll_signed(sema.td_sname(ldtd))) { lsgn2 = "1"; }
        llfb(base.sb_cat6("  ", lint, " = call i64 @tll_deser_int(i64 ", ldf,
            base.sb_cat3(", i32 ", lbits2, ", i32 "), base.sb_cat2(lsgn2, ")")));
