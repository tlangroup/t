            sb_append_str(sb2, "  call void @tll_slice_from_raw(ptr ");
            sb_append_str(sb2, p0);
            sb_append_str(sb2, ", i64 ");
            sb_append_str(sb2, base.i2s(nlen));
            sb_append_str(sb2, ", i64 ");
            sb_append_str(sb2, ll_sizeof(aty));
            sb_append_str(sb2, ", ptr ");
            sb_append_str(sb2, outp);
            sb_append_str(sb2, ")");
            llfb(sb_to_str(sb2));
            // slice 是聚合：LLVM 端的统一约定是「值即地址」（与 ident / append /
            // slice_sub 的返回一致）。这里若 load 成 %TSlice 值，下游
            // `tll_slice_sub(ptr ...)` 会拿值当指针 → clang 校验失败。
            return outp;
        }
        var v2: string = emit_lle(n.na);
        var ttd2: i64 = sema.resolve_type_desc(n.nb);
        return ll_cast_v(v2, ll_etd(n.na), ttd2);
    }
    llfb("  ; UNSUPPORTED expr");
    return "0";
}

// 索引值统一拓宽为 i64（str_at/slice_at 的下标参数）
pub fn ll_widen_idx(v: string, e: i64) string {
    var td: i64 = ll_etd(e);
    var i64td: i64 = sema.td_named_mk("scalar", "i64");
    return ll_cast_v(v, td, i64td);
}

// ── 二元 / 一元 ────────────────────────────────────────────────

pub fn ll_binary(e: i64) string {
    var n: Node = base.nodes[e];
    var op: string = n.sa;

    if (op == "&&" || op == "||") {
        var lv: string = emit_lle(n.na);
        var l1: string = ll_to_i1(lv);
        var lend: string = ll_cur_blk;
        var rhsL: string = ll_lbl("sc.r");
        var mrgL: string = ll_lbl("sc.m");
        if (op == "&&") {
            llfb(base.sb_cat6("  br i1 ", l1, ", label %", rhsL, ", label %", mrgL));
        } else {
            llfb(base.sb_cat6("  br i1 ", l1, ", label %", mrgL, ", label %", rhsL));
        }
        ll_label(rhsL);
        var rv: string = emit_lle(n.nb);
        var r1: string = ll_to_i1(rv);
        var rend: string = ll_cur_blk;
        llfb(base.sb_cat3("  br label %", mrgL, ""));
        ll_label(mrgL);
        var sc_const: string = "false";
        if (op == "||") {
            sc_const = "true";
        }
        var t: string = ll_tmp();
        llfb(base.sb_cat6("  ", t, " = phi i1 [ ", sc_const, ", %", base.sb_cat6(lend, " ], [ ", r1, ", %", rend, " ]")));
        return ll_b8(t);
    }

    // 字符串相等
    if (op == "==" || op == "!=") {
        var lt: i64 = ll_etd(n.na);
        var rt: i64 = ll_etd(n.nb);
        var ltc: TD = sema.tds[lt];
        var rtc: TD = sema.tds[rt];
        if (ltc.cat == "string" || rtc.cat == "string") {
            var lp: string = emit_lle(n.na);
            var rp: string = emit_lle(n.nb);
            var t0: string = ll_tmp();
            llfb(base.sb_cat6("  ", t0, " = call i32 @tll_str_eq(ptr ", lp, ", ptr ", base.sb_cat2(rp, ")")));
            var t1: string = ll_tmp();
            if (op == "==") {
                llfb(base.sb_cat4("  ", t1, " = icmp ne i32 ", base.sb_cat2(t0, ", 0")));
            } else {
                llfb(base.sb_cat4("  ", t1, " = icmp eq i32 ", base.sb_cat2(t0, ", 0")));
            }
            return ll_b8(t1);
        }
    }

    // 字符串拼接：TStr + TStr → tll_str_concat（聚合按指针传，返回聚合走末位 out 指针）
    if (op == "+") {
        var lt: i64 = ll_etd(n.na);
        var rt: i64 = ll_etd(n.nb);
        if (lt >= 0 && rt >= 0) {
            var ltc: TD = sema.tds[lt];
            var rtc: TD = sema.tds[rt];
            if (ltc.cat == "string" && rtc.cat == "string") {
                var lp: string = emit_lle(n.na);
                var rp: string = emit_lle(n.nb);
                var out: string = ll_scratch("%TStr");
                llfb(base.sb_cat6("  call void @tll_str_concat(ptr ", lp, ", ptr ", rp,
                    ", ptr ", base.sb_cat2(out, ")")));
                return out;
            }
        }
    }

    var utd: i64 = ll_bin_td(e);
    var sn: string = sema.td_sname(utd);
    if (sn == "") {
        sn = "i64";
    }
    var ty: string = scalar_to_ll(sn);
    var isf: bool = ll_isf(sn);
    var sg: bool = base.ll_signed(sn);
    var a: string = emit_lle(n.na);
    a = ll_cast_v(a, ll_etd(n.na), utd);
    var b: string = emit_lle(n.nb);
    b = ll_cast_v(b, ll_etd(n.nb), utd);

    if (op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=") {
        var cc: string = "";
        if (isf) {
            if (op == "==") { cc = "oeq"; }
            // `!=` 必须是**无序**比较 `une`：IEEE-754 下 `x != y` 等价于
            // `!(x == y)`，故 `nan != nan` 为真。`one` 会在任一侧为 NaN 时
            // 返回假，与 C 后端（用 `!=`）不一致。其余关系运算保持有序。
            if (op == "!=") { cc = "une"; }
            if (op == "<") { cc = "olt"; }
            if (op == ">") { cc = "ogt"; }
            if (op == "<=") { cc = "ole"; }
            if (op == ">=") { cc = "oge"; }
            var tf: string = ll_tmp();
            llfb(base.sb_cat6("  ", tf, " = fcmp ", cc, " ", base.sb_cat6(ty, " ", a, ", ", b, "")));
            return ll_b8(tf);
        }
        if (op == "==") { cc = "eq"; }
        if (op == "!=") { cc = "ne"; }
        if (sg) {
            if (op == "<") { cc = "slt"; }
            if (op == ">") { cc = "sgt"; }
            if (op == "<=") { cc = "sle"; }
            if (op == ">=") { cc = "sge"; }
        } else {
            if (op == "<") { cc = "ult"; }
            if (op == ">") { cc = "ugt"; }
            if (op == "<=") { cc = "ule"; }
            if (op == ">=") { cc = "uge"; }
        }
        var ti2: string = ll_tmp();
        llfb(base.sb_cat6("  ", ti2, " = icmp ", cc, " ", base.sb_cat6(ty, " ", a, ", ", b, "")));
        return ll_b8(ti2);
    }

    var ins: string = "";
    if (isf) {
        if (op == "+") { ins = "fadd"; }
        if (op == "-") { ins = "fsub"; }
        if (op == "*") { ins = "fmul"; }
        if (op == "/") { ins = "fdiv"; }
        if (op == "%") { ins = "frem"; }
    } else {
        if (op == "+") { ins = "add"; }
        if (op == "-") { ins = "sub"; }
        if (op == "*") { ins = "mul"; }
        if (op == "/") {
            ins = "udiv";
            if (sg) {
                ins = "sdiv";
            }
        }
        if (op == "%") {
            ins = "urem";
            if (sg) {
                ins = "srem";
            }
        }
        if (op == "<<") { ins = "shl"; }
        if (op == ">>") {
            ins = "lshr";
            if (sg) {
                ins = "ashr";
            }
        }
        if (op == "&") { ins = "and"; }
        if (op == "|") { ins = "or"; }
        if (op == "^") { ins = "xor"; }
    }
    if (ins == "") {
        llfb("  ; UNSUPPORTED binop");
        return "0";
    }
    var t3: string = ll_tmp();
    llfb(base.sb_cat6("  ", t3, " = ", ins, " ", base.sb_cat6(ty, " ", a, ", ", b, "")));
    return t3;
}

pub fn ll_unary(e: i64) string {
    var n: Node = base.nodes[e];
    var op: string = n.sa;
    if (op == "!") {
        var v: string = emit_lle(n.na);
        var t: string = ll_tmp();
        llfb(base.sb_cat4("  ", t, " = icmp eq i8 ", base.sb_cat2(v, ", 0")));
        return ll_b8(t);
    }
    var otd: i64 = ll_etd(n.na);
    var sn: string = sema.td_sname(otd);
    if (sn == "") {
        sn = "i64";
    }
    var ty: string = scalar_to_ll(sn);
    var v2: string = emit_lle(n.na);
    if (op == "-") {
        // `-inf` / `-nan`：常量已折成十六进制位模式，前缀 `-` 会被 IR 解析器
        // 判成「整数常量用于浮点类型」，必须直接给出取反后的位模式。
        if (n.na >= 0) {
            var opn: Node = base.nodes[n.na];
            if (opn.kind == "float") {
                if (opn.sa == "inf") { return "0xFFF0000000000000"; }
                if (opn.sa == "nan") { return "0x7FF8000000000000"; }
            }
        }
        if (str_len(v2) > 0) {
            if (v2[0] != 37) {
                return base.sb_cat2("-", v2);    // 常量折叠
            }
        }
        if (ll_isf(sn)) {
            var tf: string = ll_tmp();
            llfb(base.sb_cat6("  ", tf, " = fneg ", ty, " ", v2));
            return tf;
        }
        var t2: string = ll_tmp();
        llfb(base.sb_cat6("  ", t2, " = sub ", ty, " 0, ", v2));
        return t2;
    }
    if (op == "~") {
        var t3: string = ll_tmp();
        llfb(base.sb_cat6("  ", t3, " = xor ", ty, " ", base.sb_cat2(v2, ", -1")));
        return t3;
    }
    return v2;
}

// ── 尺寸计算（union/variant 载荷字节数，保守 8 字节对齐上估）──

pub fn ll_round8(v: i64) i64 {
    return ((v + 7) / 8) * 8;
}

pub fn ll_size_bytes(td: i64) i64 {
    if (td < 0) {
        return 8;
    }
    var t: TD = sema.tds[td];
    if (t.cat == "scalar") {
        if (t.name == "") {
            return 8;
        }
        return base.ll_bits(t.name) / 8;
    }
    if (t.cat == "string" || t.cat == "bytes") {
        return 16;
    }
    if (t.cat == "slice") {
        return 32;
    }
    if (t.cat == "map") {
        return 8;
    }
    if (t.cat == "named") {
        if (t.name == "TSb*") {
            return 8;
        }
        var i: i64 = sema.llt_find(t.name);
        if (i < 0) {
            return 8;
        }
        var k: string = sema.llt_kinds[i];
        if (k == "enum" || k == "flag") {
            return base.ll_bits(sema.llt_unders[i]) / 8;
        }
        if (k == "alias") {
            return ll_size_bytes(sema.llt_atd[i]);
        }
        if (k == "struct") {
            var sum: i64 = 0;
            var n: i64 = slice_len(llsf_st) as i64;
            var j: i64 = 0;
            while (j < n) {
                if (llsf_st[j] == t.name) {
                    sum = sum + ll_round8(ll_size_bytes(llsf_td[j]));
                }
                j = j + 1;
            }
            if (sum == 0) {
                sum = 8;
            }
            return sum;
        }
        if (k == "variant") {
            return 8 + ll_variant_paymax(t.name);
        }
        if (k == "union") {
            return ll_union_max(t.name);
        }
    }
    return 8;
}

pub fn ll_variant_paymax(name: string) i64 {
    var mx: i64 = 8;
    var n: i64 = slice_len(llv_v) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (llv_v[i] == name && (llv_ptd[i] >= 0 || llv_ptdl[i] >= 0)) {
            var s: i64;
            if (llv_ptdl[i] >= 0) {
                // 多载荷：struct {T0,T1,...} 的布局尺寸（按字段对齐累加 + 安全余量）
                var t: i64 = llv_ptdl[i];
                var off: i64 = 0;
                while (t >= 0) {
                    var ft: i64 = sema.resolve_type_desc(base.kids[t].val);
                    off = ll_round8(off);
                    off = off + ll_round8(ll_size_bytes(ft));
                    t = base.kids[t].next;
                }
                s = ll_round8(off) + 8;
            } else {
                s = ll_round8(ll_size_bytes(llv_ptd[i]));
            }
            if (s > mx) {
                mx = s;
            }
        }
        i = i + 1;
    }
    return mx;
}

pub fn ll_union_max(name: string) i64 {
    var mx: i64 = 8;
    var n: i64 = slice_len(llu_u) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (llu_u[i] == name) {
            var s: i64 = ll_round8(ll_size_bytes(llu_td[i]));
            if (s > mx) {
                mx = s;
            }
        }
        i = i + 1;
    }
    return mx;
}

// iN 类型的常量文本：超出有符号范围时按补码回绕成负十进制
pub fn ll_iconst(v: i64, bits: i64) string {
    if (bits == 8) {
        if (v > 127) {
            return base.i2s(v - 256);
        }
    }
    if (bits == 16) {
        if (v > 32767) {
            return base.i2s(v - 65536);
        }
    }
    if (bits == 32) {
        if (v > 2147483647) {
            return base.i2s(v - 4294967296);
        }
    }
    return base.i2s(v);
}

// 复合赋值/二元共用的算术指令名
pub fn ll_arith_ins(op: string, sn: string) string {
    var isf: bool = ll_isf(sn);
    var sg: bool = base.ll_signed(sn);
    if (isf) {
        if (op == "+") { return "fadd"; }
        if (op == "-") { return "fsub"; }
        if (op == "*") { return "fmul"; }
        if (op == "/") { return "fdiv"; }
        if (op == "%") { return "frem"; }
        return "";
    }
    if (op == "+") { return "add"; }
    if (op == "-") { return "sub"; }
    if (op == "*") { return "mul"; }
    if (op == "/") {
        if (sg) {
            return "sdiv";
        }
        return "udiv";
    }
    if (op == "%") {
        if (sg) {
            return "srem";
        }
        return "urem";
    }
    if (op == "<<") { return "shl"; }
    if (op == ">>") {
        if (sg) {
            return "ashr";
        }
        return "lshr";
    }
    if (op == "&") { return "and"; }
    if (op == "|") { return "or"; }
    if (op == "^") { return "xor"; }
    return "";
}

// ── 调用发射 ───────────────────────────────────────────────────

// map 读索引助手（LLVM）：tll_map_val_ptr 返回存储值字节指针，按 V 类型 load。
// map 操作数取指针助手（LLVM）：按 map 声明的 K/V 类型落盘，
// 标量 alloca+store（必要时先转宽），聚合直接取地址。want<0 表示沿用实参自身类型。
// map 键取指针（LLVM 后端）：整型键统一按 i64 存储——runtime 按 int64_t 读键，
// 直接存 i32/u8 会让高位字节是垃圾。string 键是 TStr 聚合，走原路径。
pub fn ll_map_keyptr(kn: i64, keytd: i64) string {
    if (keytd >= 0 && ll_isagg(keytd)) {
        return ll_map_argptr(kn, keytd);
    }
    return ll_map_argptr(kn, sema.td_named_mk("scalar", "i64"));
}

pub fn ll_map_argptr(an: i64, want: i64) string {
    var atd: i64 = ll_etd(an);
    var used: i64 = atd;
    if (want >= 0) {
        used = want;
    }
    if (ll_isagg(used)) {
        return emit_lle(an);
    }
    var aty: string = ll_td(used);
    var av: string = emit_lle(an);
    av = ll_cast_v(av, atd, used);
    var asc: string = ll_scratch(aty);
    llfb(base.sb_cat6("  store ", aty, " ", av, ", ptr ", asc));
    return asc;
}

pub fn ll_map_get(mn: i64, kn: i64) string {
    var mtd: i64 = ll_etd(mn);
    var mt: TD = sema.tds[mtd];
    var valtd: i64 = mt.val;
    var valty: string = ll_td(valtd);
    var mp: string = emit_lle(mn);
    var kp: string = ll_map_keyptr(kn, mt.key);
    var addr: string = ll_tmp();
    llfb(base.sb_cat6("  ", addr, " = call ptr @tll_map_val_ptr(ptr ", mp, ", ptr ", base.sb_cat2(kp, ")")));
    if (ll_isagg(valtd)) {
        return addr;
    }
    var out: string = ll_tmp();
    llfb(base.sb_cat6("  ", out, " = load ", valty, ", ptr ", addr));
    return out;
}

// 闭包解包间接调用（FuncType v2 / M47）：函数值是指向 %TClosure { ptr fn; ptr env }
// 的指针；被调函数统一为 `Ret (ptr env, Args...)`，env 作首参。
// callee 可以是任意表达式（ident / 结构体字段 / 数组元素 / 调用结果…），
// 这里只求值一次再解包，避免重复副作用。
pub fn ll_call_indirect(e: i64, iftd: i64) string {
    var n: Node = base.nodes[e];
    var ae: []i64;
    var c: i64 = n.la;
    while (c >= 0) {
        var k: Child = base.kids[c];
        append(ae, k.val);
        c = k.next;
    }
    var argc: i64 = slice_len(ae) as i64;
    var iclp: string = emit_lle(n.na);
    var ifnp: string = ll_tmp();
    llfb(base.sb_cat6("  ", ifnp, " = getelementptr inbounds %TClosure, ptr ", iclp, ", i32 0, i32 0", ""));
    var fpv: string = ll_load("ptr", ifnp);
    var ienp: string = ll_tmp();
    llfb(base.sb_cat6("  ", ienp, " = getelementptr inbounds %TClosure, ptr ", iclp, ", i32 0, i32 1", ""));
    var ienv: string = ll_load("ptr", ienp);
    var icsb: StringBuilder = sb_new();
    sb_append_str(icsb, "ptr ");
    sb_append_str(icsb, ienv);
    var ii: i64 = 0;
    while (ii < argc) {
        sb_append_str(icsb, ", ");
        var iptd: i64 = -1;
        if (ii < sema.tdf_pcount[iftd]) {
            iptd = sema.tdf_params[sema.tdf_pstart[iftd] + ii];
        }
        var iaty: string = ll_td(iptd);
        var iav: string = emit_lle(ae[ii]);
        if (iptd >= 0 && ll_isagg(iptd)) {
            iav = ll_load(iaty, iav);
        } else {
            iav = ll_cast_v(iav, ll_etd(ae[ii]), iptd);
        }
        sb_append_str(icsb, iaty);
        sb_append_str(icsb, " ");
        sb_append_str(icsb, iav);
        ii = ii + 1;
    }
    var irtd: i64 = sema.tdf_ret[iftd];
    var irty: string = ll_td(irtd);
    var iargs: string = sb_to_str(icsb);
    if (irty == "void") {
        llfb(base.sb_cat5("  call void ", fpv, "(", iargs, ")"));
        return "0";
    }
    var itmp: string = ll_tmp();
    llfb(base.sb_cat6(base.sb_cat3("  ", itmp, " = call "), irty, " ", fpv, base.sb_cat3("(", iargs, ")"), ""));
    if (ll_isagg(irtd)) {
        var isc: string = ll_scratch(irty);
        llfb(base.sb_cat6("  store ", irty, " ", itmp, ", ptr ", isc));
        return isc;
    }
    return itmp;
}

pub fn ll_call(e: i64) string {
    var n: Node = base.nodes[e];
    var cal: Node = base.nodes[n.na];
    if (cal.kind != "ident") {
        // callee 是任意表达式（结构体字段 / 数组元素 / 调用结果…）：只要它的静态类型
        // 是函数类型，就按闭包解包间接调用；否则才是真的不支持。
        var xftd: i64 = ll_etd(n.na);
        if (codegen_c.td_is_func(xftd)) {
            return ll_call_indirect(e, xftd);
        }
        llfb("  ; UNSUPPORTED call target");
        return "0";
    }
    var cn: string = cal.sa;
    var ae: []i64;
    var c: i64 = n.la;
    while (c >= 0) {
        var k: Child = base.kids[c];
        append(ae, k.val);
        c = k.next;
    }
    var argc: i64 = slice_len(ae) as i64;
    var td_i64: i64 = sema.td_named_mk("scalar", "i64");
    var td_i32: i64 = sema.td_named_mk("scalar", "i32");

    if (cn == "print" || cn == "eprint" || cn == "println") {
        var p: string = emit_lle(ae[0]);
        var fnm: string = "@tll_print";
        if (cn == "eprint") {
            fnm = "@tll_eprint";
        }
        if (cn == "println") {
            fnm = "@tll_println";
        }
        llfb(base.sb_cat4("  call void ", fnm, "(ptr ", base.sb_cat2(p, ")")));
        return "0";
    }
    if (cn == "str_len" || cn == "slice_len") {
        var p2: string = emit_lle(ae[0]);
        var fn2: string = "@tll_str_len";
        if (cn == "slice_len") {
            fn2 = "@tll_slice_len";
        }
        var t0: string = ll_tmp();
        llfb(base.sb_cat6("  ", t0, " = call i64 ", fn2, "(ptr ", base.sb_cat2(p2, ")")));
        return t0;
    }
    if (cn == "bytes_len") {
        var bp: string = emit_lle(ae[0]);
        var t0b: string = ll_tmp();
        llfb(base.sb_cat6("  ", t0b, " = call i64 @tll_str_len(ptr ", bp, ")", ""));
        return t0b;
    }
    if (cn == "str_at") {
        var sp: string = emit_lle(ae[0]);
        var iv: string = emit_lle(ae[1]);
        iv = ll_cast_v(iv, ll_etd(ae[1]), td_i64);
        var t1: string = ll_tmp();
