        sb_append_str(line, " = call ");
        sb_append_str(line, rty);
        sb_append_str(line, " @t.");
        sb_append_str(line, cn);
        sb_append_str(line, "(");
        sb_append_str(line, argstr);
        sb_append_str(line, ")");
        llfb(sb_to_str(line));
        if (ll_isagg(rtd)) {
            var sc2: string = ll_scratch(rty);
            llfb(base.sb_cat6("  store ", rty, " ", t7, ", ptr ", sc2));
            return sc2;
        }
        return t7;
    }
    llfb(base.sb_cat2("  ; UNSUPPORTED call ", cn));
    return "0";
}

// 2^n（flag 掩码用；n < 63）
pub fn pow2_i64(n: i64) i64 {
    var r: i64 = 1;
    var i: i64 = 0;
    while (i < n) {
        r = r * 2;
        i = i + 1;
    }
    return r;
}

// ── 循环目标栈（brk/cnt 成对维护）──────────────────────────────

pub fn ll_loop_push2(brk: string, cnt: string) void {
    if (ll_loopd < slice_len(llbrk) as i64) {
        slice_set(llbrk, ll_loopd, brk);
        slice_set(llcnt, ll_loopd, cnt);
    } else {
        append(llbrk, brk);
        append(llcnt, cnt);
    }
    ll_loopd = ll_loopd + 1;
}

pub fn ll_loop_pop() void {
    ll_loopd = ll_loopd - 1;
}

// ── 局部变量声明（alloca 进 entry，初始化留当前块）─────────────

// map 字面量构建：在 mdp 中建 TMap* 并逐项 tll_map_put。keytd/valtd 为 TD 索引。
pub fn ll_build_map_lit(en: i64, mdp: string, keytd: i64, valtd: i64) void {
    var mdkk: i64 = 0;
    if (sema.tds[keytd].cat != "string") { mdkk = 1; }
    var mdvty: string = ll_td(valtd);
    llfb(base.sb_cat5(base.sb_cat4("  ", mdp, " = call ptr @tll_map_new(i64 ", base.i2s(mdkk)), ", i64 ", ll_sizeof(mdvty), ")", ""));
    var mdn: Node = base.nodes[en];
    var mdc: i64 = mdn.la;
    while (mdc >= 0) {
        var mdck: Child = base.kids[mdc];
        var mden: Node = base.nodes[mdck.val];
        var mdkp: string = ll_map_keyptr(mden.na, keytd);
        var mdvp: string = ll_map_argptr(mden.nb, valtd);
        llfb(base.sb_cat5(base.sb_cat4("  call void @tll_map_put(ptr ", mdp, ", ptr ", mdkp), ", ptr ", mdvp, ")", ""));
        mdc = mdck.next;
    }
}

pub fn ll_local_decl(name: string, td: i64, init_e: i64) void {
    var ty: string = ll_td(td);
    var vn: string = base.sb_cat2("%v.", name);
    if (lla_has(name) == false) {
        append(lla_n, name);
        llfa(base.sb_cat4("  ", vn, " = alloca ", ty));
    }
    var t0: TD = sema.tds[td];
    // 定长数组：先整体零初始化，再按 GEP 逐元素 store
    if (t0.cat == "array") {
        llfb(base.sb_cat6("  store ", ty, " ", ll_zero(ty), ", ptr ", vn));
        if (codegen_c.is_array_lit(init_e)) {
            var aety: string = "i64";
            if (t0.elem >= 0) {
                aety = ll_td(t0.elem);
            }
            var an1: Node = base.nodes[init_e];
            var cc1: i64 = an1.la;
            var ix1: i64 = 0;
            while (cc1 >= 0) {
                var ck1: Child = base.kids[cc1];
                var gp1: string = ll_tmp();
                llfb(base.sb_cat6(base.sb_cat4("  ", gp1, " = getelementptr ", ty), ", ptr ", vn, ", i64 0, i64 ", base.i2s(ix1), ""));
                if (ll_isagg(t0.elem)) {
                    ll_copy(aety, emit_lle(ck1.val), gp1);
                } else {
                    var av1: string = emit_lle(ck1.val);
                    if (t0.elem >= 0) {
                        av1 = ll_cast_v(av1, ll_etd(ck1.val), t0.elem);
                    }
                    llfb(base.sb_cat6("  store ", aety, " ", av1, ", ptr ", gp1));
                }
                ix1 = ix1 + 1;
                cc1 = ck1.next;
            }
        }
        return;
    }
    // map：`var m: map[K]V;` 建空表；`= [k: v, ...]` 建表后逐项插入
    if (t0.cat == "map") {
        if (init_e < 0 || codegen_c.is_map_lit(init_e)) {
            var mdp: string = ll_tmp();
            if (init_e < 0) {
                var mdkk2: i64 = 0;
                if (sema.tds[t0.key].cat != "string") { mdkk2 = 1; }
                llfb(base.sb_cat5(base.sb_cat4("  ", mdp, " = call ptr @tll_map_new(i64 ", base.i2s(mdkk2)), ", i64 ", ll_sizeof(ll_td(t0.val)), ")", ""));
            } else {
                ll_build_map_lit(init_e, mdp, t0.key, t0.val);
            }
            llfb(base.sb_cat4("  store ptr ", mdp, ", ptr ", vn));
            return;
        }
    }
    // 切片字面量：`var xs: []T = [a, b, c];` → slice_new + 逐元素 append
    if (t0.cat == "slice" && codegen_c.is_array_lit(init_e)) {
        var ety0: string = "i64";
        if (t0.elem >= 0) {
            ety0 = ll_td(t0.elem);
        }
        llfb(base.sb_cat6("  call void @tll_slice_new(i64 ", ll_sizeof(ety0), ", ptr ", vn, ")", ""));
        var ln0: Node = base.nodes[init_e];
        var cc0: i64 = ln0.la;
        while (cc0 >= 0) {
            var ck0: Child = base.kids[cc0];
            var ep0: string = "";
            if (ll_isagg(t0.elem)) {
                ep0 = emit_lle(ck0.val);
            } else {
                var v0: string = emit_lle(ck0.val);
                if (t0.elem >= 0) {
                    v0 = ll_cast_v(v0, ll_etd(ck0.val), t0.elem);
                }
                var sc0: string = ll_scratch(ety0);
                llfb(base.sb_cat6("  store ", ety0, " ", v0, ", ptr ", sc0));
                ep0 = sc0;
            }
            var asb0: StringBuilder = sb_new();
            sb_append_str(asb0, "  call void @tll_slice_append(ptr ");
            sb_append_str(asb0, vn);
            sb_append_str(asb0, ", ptr ");
            sb_append_str(asb0, ep0);
            sb_append_str(asb0, ", i64 ");
            sb_append_str(asb0, ll_sizeof(ety0));
            sb_append_str(asb0, ")");
            llfb(sb_to_str(asb0));
            cc0 = ck0.next;
        }
        return;
    }
    // Sym = string : 自动 intern（LHS 存 id）。Sym=Sym（同池）/ 无初始化
    // 由下面通用 id 拷贝 / 零值路径处理（td_sname(sym)=="" → ll_cast_v 原样返回）。
    if (t0.cat == "sym" && init_e >= 0) {
        var isymtd: i64 = ll_etd(init_e);
        if (isymtd >= 0 && sema.tds[isymtd].cat == "string") {
            var symtagp: string = ll_strlit(t0.name);
            var symv: string = emit_lle(init_e);
            var symbits: string = base.i2s(t0.alen);
            var symid: string = ll_tmp();
            llfb(base.sb_cat6("  ", symid, " = call i32 @tll_sym_intern(ptr ", symtagp, ", ptr ", base.sb_cat3(symv, ", i64 ", base.sb_cat2(symbits, ")"))));
            var symstored: string = symid;
            if (ty == "i16") {
                symstored = ll_tmp();
                llfb(base.sb_cat4("  ", symstored, " = trunc i32 ", base.sb_cat2(symid, " to i16")));
            }
            llfb(base.sb_cat6("  store ", ty, " ", symstored, ", ptr ", vn));
            return;
        }
    }
    if (init_e >= 0) {
        var itd0: i64 = ll_etd(init_e);
        if (td >= 0 && sema.tds[td].cat == "slice" && itd0 >= 0 && sema.tds[itd0].cat == "array") {
            var av0: string = emit_lle(init_e);
            var aty0: string = ll_td(sema.tds[itd0].elem);
            var nlen0: i64 = sema.tds[itd0].alen;
            var p00: string = ll_tmp();
            var sbg: StringBuilder = sb_new();
            sb_append_str(sbg, "  ");
            sb_append_str(sbg, p00);
            sb_append_str(sbg, " = getelementptr inbounds ");
            sb_append_str(sbg, base.sb_cat3("[", base.i2s(nlen0), " x "));
            sb_append_str(sbg, aty0);
            sb_append_str(sbg, "], ptr ");
            sb_append_str(sbg, av0);
            sb_append_str(sbg, ", i64 0, i64 0");
            llfb(sb_to_str(sbg));
            var sbc: StringBuilder = sb_new();
            sb_append_str(sbc, "  call void @tll_slice_from_raw(ptr ");
            sb_append_str(sbc, p00);
            sb_append_str(sbc, ", i64 ");
            sb_append_str(sbc, base.i2s(nlen0));
            sb_append_str(sbc, ", i64 ");
            sb_append_str(sbc, ll_sizeof(aty0));
            sb_append_str(sbc, ", ptr ");
            sb_append_str(sbc, vn);
            sb_append_str(sbc, ")");
            llfb(sb_to_str(sbc));
            return;
        }
        var v: string = emit_lle(init_e);
        if (ll_isagg(td)) {
            ll_copy(ty, v, vn);
        } else {
            v = ll_cast_v(v, ll_etd(init_e), td);
            llfb(base.sb_cat6("  store ", ty, " ", v, ", ptr ", vn));
        }
        return;
    }
    var t: TD = sema.tds[td];
    if (t.cat == "slice") {
        var ety: string = "i64";
        if (t.elem >= 0) {
            ety = ll_td(t.elem);
        }
        llfb(base.sb_cat6("  call void @tll_slice_new(i64 ", ll_sizeof(ety), ", ptr ", vn, ")", ""));
        return;
    }
    llfb(base.sb_cat6("  store ", ty, " ", ll_zero(ty), ", ptr ", vn));
}

// ── 语句发射 ───────────────────────────────────────────────────

pub fn emit_llstmt(sid: i64) void {
    if (ll_term) {
        ll_open();
    }
    var n: Node = base.nodes[sid];

    // defer：登记到延迟栈，待 return / 函数尾按 LIFO 运行（见 emit_llfunc_decl 收尾）
    if (n.kind == "defer") {
        if (g_defer_ll_n < 1024) {
            g_defer_ll[g_defer_ll_n] = sid;
            g_defer_ll_n = g_defer_ll_n + 1;
        }
        return;
    }
    // comptime_block：无 CTFE，退化为运行期内联块（避免被静默丢弃）
    if (n.kind == "comptime_block") {
        var cb: i64 = n.la;
        while (cb >= 0) {
            var ckb: Child = base.kids[cb];
            emit_llstmt(ckb.val);
            cb = ckb.next;
        }
        return;
    }

    if (n.kind == "expr") {
        var xx: string = emit_lle(n.na);
        xx = "";
        return;
    }
    // 闭包体首（M48）：从环境结构按值拷回捕获变量，成为普通局部
    if (n.kind == "closure_capture") {
        if (n.na >= 0) {
            var cctd: i64 = sema.resolve_type_desc(n.na);
            var ccty: string = ll_td(cctd);
            var ccvn: string = base.sb_cat2("%v.", n.sa);
            if (lla_has(n.sa) == false) {
                append(lla_n, n.sa);
                llfa(base.sb_cat4("  ", ccvn, " = alloca ", ccty));
            }
            var ccgp: string = ll_tmp();
            llfb(base.sb_cat3(base.sb_cat4("  ", ccgp, " = getelementptr inbounds %st.", n.sb),
                ", ptr %__env, i32 0, i32 ", base.i2s(n.ia)));
            ll_copy(ccty, ccgp, ccvn);
        }
        return;
    }
    if (n.kind == "var_decl") {
        // 同函数内重名局部变量（shadowing）：从第二次起唯一化命名，避免 LLVM 局部名碰撞。
        // conpat 载荷绑定（match 构造器解构出的 x）身处各臂独立代码块，不做唯一化重整。
        var lname: string = n.sa;
        if (codegen_c.em_in_fn) {
            var lkey: string = base.sb_cat3(codegen_c.em_cur_fn, "::", n.sa);
            if (base.g_conpat_bind_has(sid) == false && base.g_seen_has(lkey)) {
                lname = base.sb_cat3(n.sa, "__", base.i2s(sid));
                append(base.g_local_decls, sid);
            }
            append(base.g_seen, lkey);
        }
        if (n.na >= 0) {
            ll_local_decl(lname, sema.resolve_type_desc(n.na), n.nb);
        }
        return;
    }
    if (n.kind == "assignment") {
        var op: string = n.sa;
        var ltd: i64 = ll_etd(n.na);
        var lty: string = ll_td(ltd);
        if (op == "=") {
            // m[k] = v : map 索引写须走 tll_map_put（find-or-insert），不能对读值再存回
            if (n.na >= 0) {
                var ln: Node = base.nodes[n.na];
                if (ln.kind == "index") {
                    var lotd: i64 = ll_etd(ln.na);
                    var lott: TD = sema.tds[lotd];
                    if (lott.cat == "map") {
                        var mp: string = emit_lle(ln.na);
                        var kp: string = ll_map_keyptr(ln.nb, lott.key);
                        var vp: string = ll_map_argptr(n.nb, lott.val);
                        llfb(base.sb_cat6("  call void @tll_map_put(ptr ", mp, ", ptr ", kp, ", ptr ", base.sb_cat2(vp, ")")));
                        return;
                    }
                }
            }
            var v: string = emit_lle(n.nb);
            var ad: string = ll_addr(n.na);
            if (ll_isagg(ltd)) {
                ll_copy(lty, v, sema.ad);
            } else {
                v = ll_cast_v(v, ll_etd(n.nb), ltd);
                llfb(base.sb_cat6("  store ", lty, " ", v, ", ptr ", sema.ad));
            }
            return;
        }
        // 复合赋值：load-op-store
        var bop: string = str_slice(op, 0, str_len(op) - 1);
        var ad2: string = ll_addr(n.na);
        var old: string = ll_load(lty, ad2);
        var rv: string = emit_lle(n.nb);
        rv = ll_cast_v(rv, ll_etd(n.nb), ltd);
        var sn: string = sema.td_sname(ltd);
        if (sn == "") {
            sn = "i64";
        }
        var ins: string = ll_arith_ins(bop, sn);
        if (ins == "") {
            llfb("  ; UNSUPPORTED compound assign");
            return;
        }
        var t: string = ll_tmp();
        llfb(base.sb_cat6("  ", t, " = ", ins, " ", base.sb_cat6(lty, " ", old, ", ", rv, "")));
        llfb(base.sb_cat6("  store ", lty, " ", t, ", ptr ", ad2));
        return;
    }
    if (n.kind == "if") {
        var cv: string = emit_lle(n.na);
        var c1: string = ll_to_i1(cv);
        var thenL: string = ll_lbl("if.t");
        var endL: string = ll_lbl("if.e");
        var elseL: string = endL;
        var has_else: bool = n.lb > -2;
        if (has_else) {
            elseL = ll_lbl("if.f");
        }
        llfb(base.sb_cat6("  br i1 ", c1, ", label %", thenL, ", label %", elseL));
        ll_term = true;
        ll_label(thenL);
        var tb: i64 = n.la;
        while (tb >= 0) {
            var tk: Child = base.kids[tb];
            emit_llstmt(tk.val);
            tb = tk.next;
        }
        if (ll_term == false) {
            llfb(base.sb_cat2("  br label %", endL));
            ll_term = true;
        }
        if (has_else) {
            ll_label(elseL);
            var eb: i64 = n.lb;
            while (eb >= 0) {
                var ek: Child = base.kids[eb];
                emit_llstmt(ek.val);
                eb = ek.next;
            }
            if (ll_term == false) {
                llfb(base.sb_cat2("  br label %", endL));
                ll_term = true;
            }
        }
        ll_label(endL);
        return;
    }
    if (n.kind == "while") {
        var condL: string = ll_lbl("wh.c");
        var bodyL: string = ll_lbl("wh.b");
        var endL2: string = ll_lbl("wh.e");
        llfb(base.sb_cat2("  br label %", condL));
        ll_label(condL);
        var cv2: string = emit_lle(n.na);
        var c2: string = ll_to_i1(cv2);
        llfb(base.sb_cat6("  br i1 ", c2, ", label %", bodyL, ", label %", endL2));
        ll_term = true;
        ll_label(bodyL);
        ll_loop_push2(endL2, condL);
        var wb: i64 = n.la;
        while (wb >= 0) {
            var wk: Child = base.kids[wb];
            emit_llstmt(wk.val);
            wb = wk.next;
        }
        ll_loop_pop();
        if (ll_term == false) {
            llfb(base.sb_cat2("  br label %", condL));
            ll_term = true;
        }
        ll_label(endL2);
        return;
    }
    if (n.kind == "for") {
        if (n.na >= 0) {
            var ini: Node = base.nodes[n.na];
            if (ini.kind == "var_decl") {
                if (ini.na >= 0) {
                    ll_local_decl(ini.sa, sema.resolve_type_desc(ini.na), ini.nb);
                }
            }
            if (ini.kind == "expr") {
                var xi: string = emit_lle(ini.na);
                xi = "";
            }
        }
        var condL2: string = ll_lbl("fo.c");
        var bodyL2: string = ll_lbl("fo.b");
        var stepL: string = ll_lbl("fo.s");
        var endL3: string = ll_lbl("fo.e");
        llfb(base.sb_cat2("  br label %", condL2));
        ll_label(condL2);
        if (n.nb >= 0) {
            var cv3: string = emit_lle(n.nb);
            var c3: string = ll_to_i1(cv3);
            llfb(base.sb_cat6("  br i1 ", c3, ", label %", bodyL2, ", label %", endL3));
        } else {
            llfb(base.sb_cat2("  br label %", bodyL2));
        }
        ll_term = true;
        ll_label(bodyL2);
        ll_loop_push2(endL3, stepL);
        var fb2: i64 = n.la;
        while (fb2 >= 0) {
            var fk: Child = base.kids[fb2];
            emit_llstmt(fk.val);
            fb2 = fk.next;
        }
        ll_loop_pop();
        if (ll_term == false) {
            llfb(base.sb_cat2("  br label %", stepL));
            ll_term = true;
        }
        ll_label(stepL);
        if (n.nc >= 0) {
            var xu: string = emit_lle(n.nc);
            xu = "";
        }
        llfb(base.sb_cat2("  br label %", condL2));
        ll_term = true;
        ll_label(endL3);
        return;
    }
    if (n.kind == "for_each") {
        var itd0: i64 = ll_etd(n.na);
        var it0: TD = sema.tds[itd0];
        var etd: i64 = -1;
        if (it0.cat == "slice") {
            etd = it0.elem;
            // 注册循环变量类型，供 emit_lle 的 ident 分支按 `%v.<name>` 取用
            // （与 codegen_c 的 collect_local_types 对称；否则 loop var 落到 "null"）。
            codegen_c.fs_set(codegen_c.em_cur_fn, n.sa, etd);
        }
        // map 的 for-in：按插入序迭代键（tll_map_count + tll_map_key_*_at）
        if (it0.cat == "map") {
            var mfkd: i64 = it0.key;
            var mfkty: string = ll_td(mfkd);
            codegen_c.fs_set(codegen_c.em_cur_fn, n.sa, mfkd);
            if (str_len(n.sb) > 0) {
                codegen_c.fs_set(codegen_c.em_cur_fn, n.sb, it0.val);
            }
            var mfiter: string = emit_lle(n.na);
            var mfcnt: string = ll_tmp();
            llfb(base.sb_cat4("  ", mfcnt, " = call i64 @tll_map_count(ptr ", base.sb_cat2(mfiter, ")")));
            var mfidx: string = ll_scratch("i64");
            llfb(base.sb_cat2("  store i64 0, ptr ", mfidx));
            if (lla_has(n.sa) == false) {
                append(lla_n, n.sa);
                llfa(base.sb_cat4("  %v.", n.sa, " = alloca ", mfkty));
            }
            var mfvn: string = base.sb_cat2("%v.", n.sa);
            var mfcL: string = ll_lbl("fm.c");
            var mfbL: string = ll_lbl("fm.b");
            var mfsL: string = ll_lbl("fm.s");
            var mfeL: string = ll_lbl("fm.e");
            llfb(base.sb_cat2("  br label %", mfcL));
            ll_label(mfcL);
            var mfi: string = ll_load("i64", mfidx);
            var mfcc: string = ll_tmp();
            llfb(base.sb_cat6("  ", mfcc, " = icmp slt i64 ", mfi, ", ", mfcnt));
            llfb(base.sb_cat6("  br i1 ", mfcc, ", label %", mfbL, ", label %", mfeL));
            ll_term = true;
            ll_label(mfbL);
            var mfi2: string = ll_load("i64", mfidx);
            if (sema.tds[mfkd].cat == "string") {
                llfb(base.sb_cat5(base.sb_cat4("  call void @tll_map_key_str_at(ptr ", mfiter, ", i64 ", mfi2), ", ptr ", mfvn, ")", ""));
            } else {
                var mfkv: string = ll_tmp();
                llfb(base.sb_cat5(base.sb_cat4("  ", mfkv, " = call i64 @tll_map_key_int_at(ptr ", mfiter), ", i64 ", mfi2, ")", ""));
                var mfsv: string = mfkv;
                if (mfkty != "i64") {
                    var mftr: string = ll_tmp();
                    llfb(base.sb_cat6("  ", mftr, " = trunc i64 ", mfkv, " to ", mfkty));
                    mfsv = mftr;
                }
                llfb(base.sb_cat6("  store ", mfkty, " ", mfsv, ", ptr ", mfvn));
            }
            // 双变量形式 `for (k, v in m)`：v 由插入序下标直接取值
            if (str_len(n.sb) > 0) {
                var mfvd: i64 = it0.val;
                var mfvty: string = ll_td(mfvd);
                var mfvvn: string = base.sb_cat2("%v.", n.sb);
                if (lla_has(n.sb) == false) {
                    append(lla_n, n.sb);
                    llfa(base.sb_cat4("  ", mfvvn, " = alloca ", mfvty));
                }
                var mfvp: string = ll_tmp();
                llfb(base.sb_cat5(base.sb_cat4("  ", mfvp, " = call ptr @tll_map_val_at(ptr ", mfiter), ", i64 ", mfi2, ")", ""));
                if (ll_isagg(mfvd)) {
                    ll_copy(mfvty, mfvp, mfvvn);
                } else {
                    var mfvv: string = ll_load(mfvty, mfvp);
                    llfb(base.sb_cat6("  store ", mfvty, " ", mfvv, ", ptr ", mfvvn));
                }
            }
            ll_loop_push2(mfeL, mfsL);
            var mfbb: i64 = n.la;
            while (mfbb >= 0) {
                var mfbk2: Child = base.kids[mfbb];
                emit_llstmt(mfbk2.val);
                mfbb = mfbk2.next;
            }
            ll_loop_pop();
            if (ll_term == false) {
                llfb(base.sb_cat2("  br label %", mfsL));
                ll_term = true;
            }
            ll_label(mfsL);
            var mfi3: string = ll_load("i64", mfidx);
            var mfi4: string = ll_tmp();
            llfb(base.sb_cat4("  ", mfi4, " = add i64 ", base.sb_cat2(mfi3, ", 1")));
            llfb(base.sb_cat5("  store i64 ", mfi4, ", ptr ", mfidx, ""));
            llfb(base.sb_cat2("  br label %", mfcL));
            ll_term = true;
            ll_label(mfeL);
            return;
        }
        var ety: string = "i64";
        if (etd >= 0) {
            ety = ll_td(etd);
        }
        var iter: string = emit_lle(n.na);
        var lenv: string = ll_tmp();
        llfb(base.sb_cat4("  ", lenv, " = call i64 @tll_slice_len(ptr ", base.sb_cat2(iter, ")")));
        var idx: string = ll_scratch("i64");
        llfb(base.sb_cat3("  store i64 0, ptr ", idx, ""));
        if (lla_has(n.sa) == false) {
            append(lla_n, n.sa);
            llfa(base.sb_cat4("  %v.", n.sa, " = alloca ", ety));
        }
        var condL3: string = ll_lbl("fe.c");
        var bodyL3: string = ll_lbl("fe.b");
        var stepL2: string = ll_lbl("fe.s");
        var endL4: string = ll_lbl("fe.e");
        llfb(base.sb_cat2("  br label %", condL3));
        ll_label(condL3);
        var iv: string = ll_load("i64", idx);
        var cc: string = ll_tmp();
        llfb(base.sb_cat6("  ", cc, " = icmp slt i64 ", iv, ", ", lenv));
        llfb(base.sb_cat6("  br i1 ", cc, ", label %", bodyL3, ", label %", endL4));
        ll_term = true;
        ll_label(bodyL3);
        var iv2: string = ll_load("i64", idx);
        var ep: string = ll_tmp();
        llfb(base.sb_cat6("  ", ep, " = call ptr @tll_slice_at(ptr ", iter, ", i64 ", base.sb_cat2(iv2, ")")));
        ll_copy(ety, ep, base.sb_cat2("%v.", n.sa));
        ll_loop_push2(endL4, stepL2);
        var bb: i64 = n.la;
        while (bb >= 0) {
            var bk: Child = base.kids[bb];
            emit_llstmt(bk.val);
            bb = bk.next;
        }
        ll_loop_pop();
        if (ll_term == false) {
            llfb(base.sb_cat2("  br label %", stepL2));
            ll_term = true;
        }
        ll_label(stepL2);
        var iv3: string = ll_load("i64", idx);
        var iv4: string = ll_tmp();
        llfb(base.sb_cat4("  ", iv4, " = add i64 ", base.sb_cat2(iv3, ", 1")));
        llfb(base.sb_cat6("  store i64 ", iv4, ", ptr ", idx, "", ""));
        llfb(base.sb_cat2("  br label %", condL3));
        ll_term = true;
        ll_label(endL4);
        return;
    }
    if (n.kind == "return") {
        // 运行延迟语句（defer）LIFO：后登记的先执行
        var di: i64 = g_defer_ll_n - 1;
        while (di >= 0) {
            var dnode: Node = base.nodes[g_defer_ll[di]];
            var dbb: i64 = dnode.la;
            while (dbb >= 0) {
                var dbk: Child = base.kids[dbb];
                emit_llstmt(dbk.val);
                dbb = dbk.next;
            }
            di = di - 1;
        }
        g_defer_ll_n = 0;
        var rty: string = ll_td(ll_cur_ret);
        if (n.na < 0 || rty == "void") {
            // 返回类型为 void 却带表达式（`return f(x);` 写在 void 函数里，或简写闭包
            // `|v| expr` 推断为 void）：先把表达式当语句发射以保留副作用，再 ret void。
            // 否则会静默丢弃副作用（如 `return print(...);` 什么都不做）。
            if (n.na >= 0 && rty == "void") {
                emit_lle(n.na);
            }
            llfb("  ret void");
            ll_term = true;
            return;
        }
        var rv2: string = emit_lle(n.na);
        if (ll_isagg(ll_cur_ret)) {
            var rl: string = ll_load(rty, rv2);
            llfb(base.sb_cat4("  ret ", rty, " ", rl));
        } else {
            rv2 = ll_cast_v(rv2, ll_etd(n.na), ll_cur_ret);
            llfb(base.sb_cat4("  ret ", rty, " ", rv2));
        }
        ll_term = true;
        return;
    }
    if (n.kind == "break") {
        llfb(base.sb_cat2("  br label %", llbrk[ll_loopd - 1]));
        ll_term = true;
        return;
    }
    if (n.kind == "continue") {
        llfb(base.sb_cat2("  br label %", llcnt[ll_loopd - 1]));
        ll_term = true;
        return;
    }
    if (n.kind == "block") {
        var bb2: i64 = n.la;
        while (bb2 >= 0) {
            var bk2: Child = base.kids[bb2];
            emit_llstmt(bk2.val);
            bb2 = bk2.next;
        }
        return;
    }
    // 其余未识别节点：不输出（fallthrough）
}

// ── 函数发射 ───────────────────────────────────────────────────

pub fn ll_reset_fn() void {
    var e1: []string;
    ll_fal = e1;
    var e2: []string;
    ll_fb = e2;
    var e3: []string;
    lla_n = e3;
    var e4: []string;
    llbrk = e4;
    var e5: []string;
    llcnt = e5;
    ll_loopd = 0;
    ll_tmpc = 0;
    ll_lblc = 0;
    ll_scc = 0;
    ll_cur_blk = "entry";
    ll_term = false;
}

pub fn emit_llfunc(d: i64) void {
    var n: Node = base.nodes[d];
    var fi: i64 = llfn_find(n.sa);
    var rtd: i64 = -1;
    if (fi >= 0) {
        rtd = llfn_r[fi];
    }
    var rty: string = ll_td(rtd);

    // 签名
    var psb: StringBuilder = sb_new();
    var cnt: i64 = 0;
    // 闭包合成函数（M48）：sb 记环境结构名 → 前置 env 首参（与 TClosure ABI 一致）。
    // %__env 直接当 ptr 用，无需 alloca；closure_capture 语句会从中拷回捕获量。
    if (str_len(n.sb) > 0) {
        sb_append_str(psb, "ptr %__env");
        cnt = 1;
    }
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = base.kids[c];
        var p: Node = base.nodes[k.val];
        if (cnt > 0) {
            sb_append_str(psb, ", ");
        }
        var ptd: i64 = sema.resolve_type_desc(p.na);
        sb_append_str(psb, ll_td(ptd));
        sb_append_str(psb, " %p.");
        sb_append_str(psb, p.sa);
        cnt = cnt + 1;
        c = k.next;
    }
    var params: string = sb_to_str(psb);

    // 链接模式库函数：导出符号发 declare（真实定义来自 .tlib 归档），私有符号跳过（避免与归档重定义冲突）。
    if (lex.in_link_libs(base.g_node_mod[d])) {
        if (base.nodes[d].bc) {
            llph(base.sb_cat6("declare ", rty, " @t.", n.sa, "(", base.sb_cat2(params, ")")));
        }
        return;
    }

    if (n.ba) {
        // extern：绑定 C 符号（无 t. 前缀），参数类型按同规则
        llph(base.sb_cat6("declare ", rty, " @", n.sa, "(", base.sb_cat2(params, ")")));
        return;
    }

    if (parse.ann_find(n.la, "main") >= 0) {
        ll_has_main = true;
        ll_main_fn = n.sa;
    }

    ll_reset_fn();
    g_defer_ll_n = 0;   // 每个函数独立延迟栈
    codegen_c.em_cur_fn = n.sa;
    codegen_c.em_in_fn = true;
    ll_cur_ret = rtd;

    // 参数落地：alloca %v.x + store
    var c2: i64 = n.lb;
    while (c2 >= 0) {
        var k2: Child = base.kids[c2];
        var p2: Node = base.nodes[k2.val];
        var ptd2: i64 = sema.resolve_type_desc(p2.na);
        var pty: string = ll_td(ptd2);
        append(lla_n, p2.sa);
        llfa(base.sb_cat6("  %v.", p2.sa, " = alloca ", pty, "", ""));
        llfb(base.sb_cat6("  store ", pty, " %p.", p2.sa, ", ptr %v.", p2.sa));
        c2 = k2.next;
    }

    if (n.lc > -2) {
        var b: i64 = n.lc;
        while (b >= 0) {
            var bk: Child = base.kids[b];
            emit_llstmt(bk.val);
            b = bk.next;
        }
    }
    // 函数体结束：运行剩余 defer（无显式 return 的路径）LIFO
    {
        var di: i64 = g_defer_ll_n - 1;
        while (di >= 0) {
            var dnode: Node = base.nodes[g_defer_ll[di]];
            var dbb: i64 = dnode.la;
            while (dbb >= 0) {
                var dbk: Child = base.kids[dbb];
                emit_llstmt(dbk.val);
                dbb = dbk.next;
            }
            di = di - 1;
        }
        g_defer_ll_n = 0;
    }
    if (ll_term == false) {
        if (rty == "void") {
            llfb("  ret void");
        } else {
            llfb(base.sb_cat4("  ret ", rty, " ", ll_zero(rty)));
        }
    }

    // 组装
    llpb(base.sb_cat6("define ", rty, " @t.", n.sa, "(", base.sb_cat2(params, ") {")));
    llpb("entry:");
    var na: i64 = slice_len(ll_fal) as i64;
    var i: i64 = 0;
    while (i < na) {
        llpb(ll_fal[i]);
        i = i + 1;
    }
    var nb: i64 = slice_len(ll_fb) as i64;
    var j: i64 = 0;
    while (j < nb) {
        llpb(ll_fb[j]);
        j = j + 1;
    }
    llpb("}");
    llpb("");
    codegen_c.em_in_fn = false;
    codegen_c.em_cur_fn = "";
}

// ── 类型定义 / 全局 / 模块编排 ─────────────────────────────────

pub fn emit_lltypes() void {
    var n: i64 = slice_len(sema.llt_names) as i64;
    var i: i64 = 0;
    while (i < n) {
        var name: string = sema.llt_names[i];
        var k: string = sema.llt_kinds[i];
        if (k == "struct") {
            var sb: StringBuilder = sb_new();
            sb_append_str(sb, "%st.");
            sb_append_str(sb, name);
            sb_append_str(sb, " = type { ");
            var m: i64 = slice_len(llsf_st) as i64;
            var j: i64 = 0;
            var first: bool = true;
            while (j < m) {
                if (llsf_st[j] == name) {
                    if (first == false) {
                        sb_append_str(sb, ", ");
                    }
                    sb_append_str(sb, ll_td(llsf_td[j]));
                    first = false;
                }
                j = j + 1;
            }
            if (first) {
                sb_append_str(sb, "i8");
            }
            sb_append_str(sb, " }");
            llph(sb_to_str(sb));
        }
        if (k == "variant") {
            var sb2: StringBuilder = sb_new();
            sb_append_str(sb2, "%vt.");
            sb_append_str(sb2, name);
            sb_append_str(sb2, " = type { i64, [");
            sb_append_i64(sb2, ll_variant_paymax(name));
            sb_append_str(sb2, " x i8] }");
            llph(sb_to_str(sb2));
        }
        if (k == "union") {
            var sb3: StringBuilder = sb_new();
            sb_append_str(sb3, "%un.");
            sb_append_str(sb3, name);
            sb_append_str(sb3, " = type { [");
            sb_append_i64(sb3, ll_union_max(name));
            sb_append_str(sb3, " x i8] }");
            llph(sb_to_str(sb3));
        }
        i = i + 1;
    }
}

pub fn emit_lldeclares() void {
    llph("declare void @tll_print(ptr)");
    llph("declare void @tll_eprint(ptr)");
    llph("declare void @tll_println(ptr)");
    llph("declare i64 @tll_str_len(ptr)");
    llph("declare i64 @tll_str_at(ptr, i64)");
    llph("declare i32 @tll_str_eq(ptr, ptr)");
    llph("declare void @tll_str_concat(ptr, ptr, ptr)");
    llph("declare void @tll_str_slice(ptr, i64, i64, ptr)");
    llph("declare ptr @tll_sb_new()");
    llph("declare void @tll_sb_append_str(ptr, ptr)");
    llph("declare void @tll_sb_append_char(ptr, i64)");
    llph("declare void @tll_sb_append_u64(ptr, i64)");
    llph("declare void @tll_sb_append_i64(ptr, i64)");
    llph("declare void @tll_sb_to_str(ptr, ptr)");
    llph("declare void @tll_int_to_str(i64, ptr)");
    // 格式化（Python 格式规范迷你语言子集）
    llph("declare void @tll_format_int(ptr, i64, ptr)");
    llph("declare void @tll_format_time(ptr, i64, i64, ptr)");
    llph("declare void @tll_format_time_tz(ptr, i64, i64, ptr)");
    llph("declare i64 @tll_parse_time(ptr, ptr, i64)");
    llph("declare i64 @tll_now()");
    llph("declare void @tll_format_uint(ptr, i64, ptr)");
    llph("declare void @tll_format_float(ptr, double, ptr)");
    llph("declare void @tll_format_str(ptr, ptr, ptr)");
    llph("declare void @tll_format_bool(ptr, i8, ptr)");
    llph("declare void @tll_format_char(ptr, i64, ptr)");
    llph("declare void @tll_sb_append_fmt_int(ptr, ptr, i64)");
    llph("declare void @tll_sb_append_fmt_uint(ptr, ptr, i64)");
    llph("declare void @tll_sb_append_fmt_float(ptr, ptr, double)");
    llph("declare void @tll_sb_append_fmt_str(ptr, ptr, ptr)");
    llph("declare void @tll_sb_append_fmt_bool(ptr, ptr, i8)");
    llph("declare void @tll_sb_append_fmt_char(ptr, ptr, i64)");
    llph("declare void @tll_sb_append_fmt_str_conv(ptr, ptr, ptr, ptr)");
    llph("declare void @tll_sb_append_fmt_int_conv(ptr, ptr, i64, ptr)");
    llph("declare void @tll_sb_append_fmt_uint_conv(ptr, ptr, i64, ptr)");
    llph("declare void @tll_sb_clear(ptr)");
    llph("declare void @tll_slice_new(i64, ptr)");
    llph("declare void @tll_slice_append(ptr, ptr, i64)");
    llph("declare ptr @tll_slice_at(ptr, i64)");
    llph("declare void @tll_slice_set(ptr, i64, ptr)");
    llph("declare i64 @tll_slice_len(ptr)");
    llph("declare void @tll_slice_sub(ptr, i64, i64, ptr)");
    llph("declare void @tll_slice_from_raw(ptr, i64, i64, ptr)");
    llph("declare ptr @tll_opt_some(ptr, i64)");
    llph("declare ptr @tll_opt_unwrap(ptr)");
    llph("declare ptr @tll_map_new(i64, i64)");
    llph("declare void @tll_map_put(ptr, ptr, ptr)");
    llph("declare ptr @tll_map_val_ptr(ptr, ptr)");
    llph("declare i32 @tll_map_has(ptr, ptr)");
    llph("declare i64 @tll_map_len(ptr)");
    llph("declare i32 @tll_map_del(ptr, ptr)");
    llph("declare i64 @tll_map_count(ptr)");
    llph("declare void @tll_map_key_str_at(ptr, i64, ptr)");
    llph("declare i64 @tll_map_key_int_at(ptr, i64)");
    llph("declare ptr @tll_map_val_at(ptr, i64)");
    llph("declare void @tll_file_read_all(ptr, ptr)");
    llph("declare void @tll_getenv(ptr, ptr)");
    llph("declare i32 @tll_file_write_all(ptr, ptr)");
    llph("declare i32 @tll_file_exists(ptr)");
    // Sym：字符串驻留符号池（M40）
    llph("declare i32 @tll_sym_intern(ptr, ptr, i64)");
    llph("declare void @tll_sym_str(ptr, i32, ptr)");
    llph("declare void @tll_sym_release(ptr)");
    llph("declare void @tll_sym_release_all()");
    // Atom：全局符号表（编译期 intern 的稳定 i64 id → 名字还原）
    llph("declare void @tll_atom_str(i64, ptr)");
    // Fid：文件描述符句柄 + 序列化操作符（M51）。ser_* 一律返回目标 fid 以支持链式。
    llph("declare i64 @tll_fopen(ptr, i32)");
    llph("declare void @tll_fclose(i64)");
    llph("declare void @tll_fflush(i64)");
    llph("declare i32 @tll_fid_is_open(i64)");
    llph("declare void @tll_fid_error(i64, ptr)");
    llph("declare i32 @tll_fid_eof(i64)");
    llph("declare i32 @tll_fseek(i64, i64)");
    llph("declare i64 @tll_ftell(i64)");
    llph("declare i64 @tll_fid_format(i64, i64, i64, i64, i64)");
    llph("declare void @tll_fmt_register(i32, ptr, i32)");
    llph("declare i64 @tll_ser_int(i64, i64, i32, i32)");
    llph("declare i64 @tll_ser_f64(i64, double, i32)");
    llph("declare i64 @tll_ser_bool(i64, i8)");
    llph("declare i64 @tll_ser_atom(i64, i64)");
    llph("declare i64 @tll_ser_str(i64, ptr)");
    llph("declare i64 @tll_deser_int(i64, i32, i32)");
    llph("declare double @tll_deser_f64(i64, i32)");
    llph("declare i8 @tll_deser_bool(i64)");
    llph("declare i64 @tll_deser_atom(i64)");
    llph("declare void @tll_deser_str(i64, ptr)");
    // type_info accessor 内建（M36）
    llph("declare void @tll_ti_name(ptr, ptr)");
    llph("declare i64 @tll_ti_size(ptr)");
    llph("declare i64 @tll_ti_kind(ptr)");
    llph("declare i64 @tll_ti_field_count(ptr)");
    llph("declare ptr @tll_ti_field(ptr, i64)");
    llph("declare void @tll_fi_name(ptr, ptr)");
    llph("declare i64 @tll_fi_offset(ptr)");
    llph("declare i64 @tll_fi_tag(ptr)");
    llph("declare void @tll_fi_type_name(ptr, ptr)");
    llph("declare i64 @tll_fi_type_size(ptr)");
    llph("declare i8 @tll_fi_is_ptr(ptr)");
    llph("declare void @tll_path_resolve(ptr, ptr)");
    llph("declare void @tll_args(ptr)");
    // REPL 交互输入（M-REPL）
    llph("declare void @tll_read_line(ptr)");
    llph("declare i32 @tll_stdin_eof()");
    llph("declare void @tll_exit(i32)");
    llph("declare i32 @tll_system(ptr)");
    // 闭包环境 / TClosure 记录的堆分配（M48）
    llph("declare ptr @t_alloc(i64)");
    llph("declare void @t_runtime_init(i32, ptr)");
    llph("declare ptr @t_arena_new()");
    llph("declare void @t_runtime_set_arena(ptr)");
    llph("declare void @t_runtime_done()");
    llph("");
}

pub fn emit_llglobals() void {
    var n: i64 = slice_len(llgv_n) as i64;
    var i: i64 = 0;
    while (i < n) {
        // 链接模式私有全局：跳过（定义来自 .tlib 归档）；导出全局：发 declare（不分配存储）。
        if (llgv_link[i] == 2) { i = i + 1; continue; }
        if (llgv_link[i] == 1) {
            var ty: string = ll_td(llgv_td[i]);
            llpg(base.sb_cat4("@", llgv_n[i], " = external global ", ty));
            i = i + 1;
            continue;
        }
        var ty: string = ll_td(llgv_td[i]);
        llpg(base.sb_cat6("@", llgv_n[i], " = global ", ty, " ", ll_zero(ty)));
        i = i + 1;
    }
}

// 全局初始化函数：非常量初始值 + 未初始化 slice 的 elem_size 建立
pub fn emit_llginit() void {
    ll_reset_fn();
    codegen_c.em_in_fn = false;
    codegen_c.em_cur_fn = "";
    ll_cur_ret = -1;
    var n: i64 = slice_len(llgv_n) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (llgv_link[i] != 0) { i = i + 1; continue; }   // 链接模式全局：定义/初始化来自 .tlib 归档，跳过
        var td: i64 = llgv_td[i];
        var ty: string = ll_td(td);
        var gp: string = base.sb_cat2("@", llgv_n[i]);
        var t0: TD = sema.tds[td];
        if (t0.cat == "sym") {
            // Sym 全局变量：运行期 intern 字符串 → id，存进 @g（在 t.__ginit 中执行）
            if (llgv_init[i] >= 0) {
                var symtagp: string = ll_strlit(t0.name);
                var symv: string = emit_lle(llgv_init[i]);
                var symbits: string = base.i2s(t0.alen);
                var symid: string = ll_tmp();
                llfb(base.sb_cat6("  ", symid, " = call i32 @tll_sym_intern(ptr ", symtagp, ", ptr ", base.sb_cat3(symv, ", i64 ", base.sb_cat2(symbits, ")"))));
                var symstored: string = symid;
                if (ty == "i16") {
                    symstored = ll_tmp();
                    llfb(base.sb_cat4("  ", symstored, " = trunc i32 ", base.sb_cat2(symid, " to i16")));
                }
                llfb(base.sb_cat6("  store ", ty, " ", symstored, ", ptr ", gp));
            } else {
                llfb(base.sb_cat4("  store ", ty, " 0, ptr ", gp));
            }
        } else if (llgv_init[i] >= 0) {
            var v: string = emit_lle(llgv_init[i]);
            if (ll_isagg(td)) {
                ll_copy(ty, v, gp);
            } else {
                v = ll_cast_v(v, ll_etd(llgv_init[i]), td);
                llfb(base.sb_cat6("  store ", ty, " ", v, ", ptr ", gp));
            }
        } else {
            var t: TD = sema.tds[td];
            if (t.cat == "slice") {
                var ety: string = "i64";
                if (t.elem >= 0) {
                    ety = ll_td(t.elem);
                }
                llfb(base.sb_cat6("  call void @tll_slice_new(i64 ", ll_sizeof(ety), ", ptr ", gp, ")", ""));
            }
        }
        i = i + 1;
    }
    llfb("  ret void");
    llpb("define void @t.__ginit() {");
    llpb("entry:");
    var na: i64 = slice_len(ll_fal) as i64;
    var j: i64 = 0;
    while (j < na) {
        llpb(ll_fal[j]);
        j = j + 1;
    }
    var nb: i64 = slice_len(ll_fb) as i64;
    var j2: i64 = 0;
    while (j2 < nb) {
        llpb(ll_fb[j2]);
        j2 = j2 + 1;
    }
    llpb("}");
    llpb("");
}

// ── 函数值闭包的 LLVM 侧落地（FuncType v2 / M47）────────────────
// 与 C 后端同构：为每个被取值的顶层函数生成 trampoline（吃掉 env 首参后转发）
// 与一个内部闭包全局。函数值在 LLVM 里就是指向该全局的 ptr。
pub fn emit_ll_closures() void {
    var cn: i64 = slice_len(codegen_c.clos_names) as i64;
    if (cn == 0) {
        return;
    }
    var i: i64 = 0;
    while (i < cn) {
        var nm: string = codegen_c.clos_names[i];
        var fi: i64 = llfn_find(nm);
        if (fi >= 0) {
            var rty: string = ll_td(llfn_r[fi]);
            var sym: string = base.sb_cat2("@t.", nm);
            if (llfn_x[fi]) {
                sym = base.sb_cat2("@", nm);
            }
            var psb: StringBuilder = sb_new();
            var asb: StringBuilder = sb_new();
            sb_append_str(psb, "ptr %__env");
            var ps: i64 = llfn_ps[fi];
            var pc: i64 = llfn_pc[fi];
            var pi: i64 = 0;
            while (pi < pc) {
                var pty: string = ll_td(llfp_td[ps + pi]);
                sb_append_str(psb, ", ");
                sb_append_str(psb, pty);
                sb_append_str(psb, " %__a");
                sb_append_str(psb, base.i2s(pi));
                if (pi > 0) {
                    sb_append_str(asb, ", ");
                }
                sb_append_str(asb, pty);
                sb_append_str(asb, " %__a");
                sb_append_str(asb, base.i2s(pi));
                pi = pi + 1;
            }
            llpb(base.sb_cat6("define internal ", rty, " @t.tramp.", nm, "(", base.sb_cat2(sb_to_str(psb), ") {")));
            llpb("entry:");
            if (rty == "void") {
                llpb(base.sb_cat5("  call void ", sym, "(", sb_to_str(asb), ")"));
                llpb("  ret void");
            } else {
                llpb(base.sb_cat6("  %r = call ", rty, " ", sym, "(", base.sb_cat2(sb_to_str(asb), ")")));
                llpb(base.sb_cat3("  ret ", rty, " %r"));
            }
            llpb("}");
            llpb("");
            llpg(base.sb_cat6("@t.clos.", nm, " = internal global %TClosure { ptr @t.tramp.", nm, ", ptr null }", ""));
        }
        i = i + 1;
    }
}

// 全局 atom 名表（LLVM 后端）：@t_atom_table = [M x %TStr]，index 0 占位空串，
// 其后按 g_atom_names 顺序；atom_intern 返回 1-based id → t_atom_table[id] 命中。
// `global`（外部链接）以便 C 运行时 t_atom_str 经 extern 链接此表。无 atom 时也发射最小表。
pub fn emit_ll_atom_table() void {
    var cnt: i64 = sema.g_atom_cnt;
    // 数组常量的元素必须是内联 %TStr 结构常量，不能用 @.tsN（那是指针）。
    // ll_strlit 会把字节常量写进全局区，并把该串的 @.sN / 长度留在 ll_last_*。
    var elems: StringBuilder = sb_new();
    var dummy: string = ll_strlit("");
    sb_append_str(elems, "%TStr { ptr ");
    sb_append_str(elems, ll_last_sref);
    sb_append_str(elems, ", i64 ");
    sb_append_i64(elems, ll_last_slen);
    sb_append_str(elems, " }");
    var i: i64 = 0;
    while (i < cnt) {
        var ts: string = ll_strlit(sema.g_atom_names[i]);
        sb_append_str(elems, ", %TStr { ptr ");
        sb_append_str(elems, ll_last_sref);
        sb_append_str(elems, ", i64 ");
        sb_append_i64(elems, ll_last_slen);
        sb_append_str(elems, " }");
        i = i + 1;
    }
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "@t_atom_table = global [");
    sb_append_i64(sb, cnt + 1);
    sb_append_str(sb, " x %TStr] [ ");
    sb_append_str(sb, sb_to_str(elems));
    sb_append_str(sb, " ]");
    llpg(sb_to_str(sb));
    var sb2: StringBuilder = sb_new();
    sb_append_str(sb2, "@t_atom_count = global i64 ");
    sb_append_i64(sb2, cnt + 1);
    llpg(sb_to_str(sb2));
}

pub fn emit_llunit(mod: string) void {
    codegen_c.build_type_map();
    ll_build_reg();
    llph(base.sb_cat2("; ModuleID = ", mod));
    llph("%TStr = type { ptr, i64 }");
    llph("%TSlice = type { ptr, i64, i64, i64 }");
    // 函数值的统一表示（FuncType v2 / M47）：{ 函数指针, 环境指针 }
    llph("%TClosure = type { ptr, ptr }");
    // type_info(T) 常量结构（M36）
    llph("%TFieldInfo = type { %TStr, i64, %TStr, i64, i8, i64 }");
    llph("%TTypeInfo = type { %TStr, i64, i64, i64, %TSlice }");
    emit_lltypes();
    llph("");
    emit_lldeclares();
    emit_llglobals();
    // 进程级全局（atom 名表 / 全局初始化）只应由主程序定义一份；
    // 预编译库模式跳过，避免链接期与导入方重复定义冲突（库内若有引用将由导入方提供）。
    if (lex.g_lib_emit == false) {
        emit_ll_atom_table();
        emit_llginit();
    }

    var n: i64 = slice_len(lex.decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var di: i64 = lex.decl_list[i];
        var dn: Node = base.nodes[di];
        if (dn.kind == "FuncDecl" && sema.func_is_generic(di) == false) {
            emit_llfunc(di);
        }
        i = i + 1;
    }

    // 函数值闭包：全部函数体发射完毕后统一落地（LLVM 无前向声明顺序约束）
    emit_ll_closures();

    if (ll_has_main) {
        llpb("define i32 @main(i32 %argc, ptr %argv) {");
        llpb("entry:");
        llpb("  call void @t_runtime_init(i32 %argc, ptr %argv)");
        llpb("  %a = call ptr @t_arena_new()");
        llpb("  call void @t_runtime_set_arena(ptr %a)");
        llpb("  call void @t.__ginit()");
        llpb(base.sb_cat3("  %r = call i32 @t.", ll_main_fn, "()"));
        llpb("  call void @t_runtime_done()");
        llpb("  ret i32 %r");
        llpb("}");
    }
}

// 预编译外部库为 .tlib（Phase2 真·独立编译+链接）：把当前已 emit 的 <out>.ll
// 经 clang -c 编为 .o，再用 llvm-ar 打成归档 <out>.tlib（重命名的 .a），并写出
// <out>.exports.json 接口块。库符号已按规范别名重整（json__version），与下游
// import(json) 的重整结果一致，故导入方只需外链该归档 + 发 declare。
pub fn build_tlib(out_p: string, lib_alias: string, clang_p: string) i32 {
    // 调试态：--debug 时产出 .tlibd 归档（clang -O0 -gcodeview），普通时 .tlib（-O2）。
    var lib_ext: string = ".tlib";
    var lib_cflags: string = "-O2";
    if (lex.g_lib_debug) {
        lib_ext = ".tlibd";
        lib_cflags = "-O0 -gcodeview";
    }
    var llp: string = base.sb_cat2(out_p, ".ll");
    var op: string = base.sb_cat2(out_p, ".o");
    var arp: string = base.sb_cat2(out_p, lib_ext);
    // 推导 llvm-ar 路径（与 clang 自动探测同源）
    var ar_p: string = "llvm-ar";
    if (clang_p == "C:/Program Files/LLVM/bin/clang.exe") {
        ar_p = "C:/Program Files/LLVM/bin/llvm-ar.exe";
    }
    // 1) clang -c .ll -> .o
    var csb: StringBuilder = sb_new();
    sb_append_str(csb, "\"");
    sb_append_str(csb, clang_p);
    sb_append_str(csb, base.sb_cat2("\" -c ", lib_cflags));
    sb_append_str(csb, " -o \"");
    sb_append_str(csb, op);
    sb_append_str(csb, "\" \"");
    sb_append_str(csb, llp);
    sb_append_str(csb, "\"");
    var rc: i32 = sys_run(sb_to_str(csb));
    if (rc != 0) {
        eprint("clang -c (lib) failed\n");
        return 1;
    }
    // 2) llvm-ar rcs .tlib .o
    var asb: StringBuilder = sb_new();
    sb_append_str(asb, "\"");
    sb_append_str(asb, ar_p);
    sb_append_str(asb, "\" rcs \"");
    sb_append_str(asb, arp);
    sb_append_str(asb, "\" \"");
    sb_append_str(asb, op);
    sb_append_str(asb, "\"");
    var arc: i32 = sys_run(sb_to_str(asb));
    if (arc != 0) {
        eprint("llvm-ar (lib) failed\n");
        return 1;
    }
    // 3) 写接口块 exports.json（列出导出符号，供下游/工具读取；导入方类型检查仍用内联源码）
    var exp: StringBuilder = sb_new();
    sb_append_str(exp, "[\n");
    var first: bool = true;
    var n: i64 = slice_len(lex.decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = lex.decl_list[i];
        if (base.g_node_mod[d] == lib_alias && base.nodes[d].bc && sema.is_top_decl_kind(base.nodes[d].kind)) {
            if (first == false) { sb_append_str(exp, ",\n"); }
            first = false;
            sb_append_str(exp, "  {\"name\": \"");
            sb_append_str(exp, base.nodes[d].sa);
            sb_append_str(exp, "\", \"kind\": \"");
            sb_append_str(exp, base.nodes[d].kind);
            sb_append_str(exp, "\"}");
        }
        i = i + 1;
    }
    sb_append_str(exp, "\n]\n");
    file_write_all(base.sb_cat2(out_p, base.sb_cat2(lib_ext, ".exports.json")), sb_to_str(exp));
    // 4) 清理中间 .o（.ll 保留作调试产物）
    sys_run(base.sb_cat3("cmd /c del \"", op, "\" >nul 2>nul"));
    print(base.sb_cat3("Built library: ", to_bs(arp), "\n"));
    return 0;
}

pub fn ll_join() string {
    var sb: StringBuilder = sb_new();
    var n1: i64 = slice_len(ll_head) as i64;
    var i: i64 = 0;
    while (i < n1) {
        sb_append_str(sb, ll_head[i]);
        sb_append_str(sb, "\n");
        i = i + 1;
    }
    var n2: i64 = slice_len(ll_glob) as i64;
    var j: i64 = 0;
    while (j < n2) {
        sb_append_str(sb, ll_glob[j]);
        sb_append_str(sb, "\n");
        j = j + 1;
    }
    sb_append_str(sb, "\n");
    var n3: i64 = slice_len(ll_body) as i64;
    var k: i64 = 0;
    while (k < n3) {
        sb_append_str(sb, ll_body[k]);
        sb_append_str(sb, "\n");
        k = k + 1;
    }
    return sb_to_str(sb);
}

// ── 路径工具 ───────────────────────────────────────────────────

pub fn base_no_tc(path: string) string {
    var n: u64 = str_len(path);
    var start: u64 = 0;
    var i: u64 = 0;
    while (i < n) {
        if (path[i] == 47 || path[i] == 92) {
            start = i + 1;
        }
        i = i + 1;
    }
    var end: u64 = n;
    if (n >= start + 3) {
        if (path[n - 3] == 46 && path[n - 2] == 116 && path[n - 1] == 99) {
            end = n - 3;
        }
    }
    return str_slice(path, start, end);
}

// --mode 只接受 dbg|rls（t 默认目录结构：out/dbg 调试、out/rls 发布）
pub fn valid_mode(m: string) bool {
    if (m == "dbg") {
        return true;
    }
    if (m == "rls") {
        return true;
    }
    return false;
}


// 写出文件前确保父目录存在（Windows: cmd /c mkdir，幂等）
pub fn ensure_parent(p: string) void {
    var nn: u64 = str_len(p);
    var cut: u64 = 0;
    var pi: u64 = 0;
    while (pi < nn) {
        if (p[pi] == 47 || p[pi] == 92) { cut = pi; }
        pi = pi + 1;
    }
    if (cut > 0) {
        var d: string = to_bs(str_slice(p, 0, cut));
        sys_run(base.sb_cat5("cmd /c if not exist \"", d, "\" mkdir \"", d, "\""));
    }
}

pub fn to_bs(s: string) string {
    var sb: StringBuilder = sb_new();
    var i: u64 = 0;
    var n: u64 = str_len(s);
    while (i < n) {
        if (s[i] == 47) {
            sb_append_char(sb, 92);
        } else {
            sb_append_char(sb, s[i]);
        }
        i = i + 1;
    }
    return sb_to_str(sb);
}

// ── lex 子命令（token 池 → JSON，同 tc0 lex --json）────────────

pub fn run_lex(file: string) i32 {
    var src: string = file_read_all(file);
    lex.tokenize(src);
    var out: StringBuilder = sb_new();
    sb_append_char(out, 91);
    var n: i64 = slice_len(base.toks) as i64;
    var i: i64 = 0;
    while (i < n) {
        var t: Tok = base.toks[i];
        if (i > 0) {
            sb_append_char(out, 44);
        }
        sb_append_str(out, "{\"type\":\"");
        sb_append_str(out, t.t);
        sb_append_str(out, "\",\"value\":\"");
        base.json_escape_into(out, t.v);
        sb_append_str(out, "\",\"line\":");
        sb_append_u64(out, t.line);
        sb_append_str(out, ",\"col\":");
        sb_append_u64(out, t.col);
        sb_append_char(out, 125);
        i = i + 1;
    }
    sb_append_char(out, 93);
    print(sb_to_str(out));
    print("\n");
    return 0;
}

// ── 驱动 main：lex / check / compile 派发 ──────────────────────

pub fn print_help() void {
    print("tc — 静态类型数据驱动语言(t)编译器\n");
    print("用法:\n");
    print("  tc <lex|check|compile|emit-ll|build|run|test> <file.tc> [选项]\n");
    print("  tc --help | -h | help            显示本帮助并退出 0\n\n");
    print("子命令:\n");
    print("  lex       词法分析，输出 token 流(JSON)\n");
    print("  check     类型/语义检查，输出诊断(JSON)\n");
    print("  compile   产出 C 源码(.c/.h)\n");
    print("  emit-ll   产出 LLVM IR(.ll)\n");
    print("  build     编译并链接为可执行文件(.exe)\n");
    print("  run       build 后立即运行，透传子进程退出码\n");
    print("  test      收集 `\"名字\" test {}` 并运行，汇总 passed/failed/skipped\n\n");
    print("选项:\n");
    print("  --example <name>   编译 examples/<name>.tc\n");
    print("  --filter <substr>  test: 只跑显示名含该子串的用例\n");
    print("  --tag <name>       test: 只跑带 @tag(<name>) 的用例\n");
    print("  --no-run           test: 只编译不执行\n");
    print("  --mode <dbg|rls>   调试/发布(默认 dbg)\n");
    print("  --output <path>    指定输出路径前缀\n");
    print("  --clang <path>     指定 clang 路径\n");
    print("  --runtime <dir>    指定运行时目录(默认 runtime/)\n");
    print("  --debug-libs       链接调试态库 .tlibd（缺少则回退 .tlib）\n");
    print("  --debug            build --lib 时产出调试态归档 .tlibd\n");
    print("  --emit-deps        check 时打印模块依赖图(JSON)后退出\n\n");
    print("退出码: 0=成功, 1=编译/运行错误, 2=命令行用法错误\n");
}


// ── type_info(T) 编译期常量合成（M36）─────────────────────────
// type_info(Point) 在编译期遍历 StructDecl 字段，合成全局常量
// __ti_Point（含字段数组），返回其地址（LLVM: ptr @__ti_Point；C: &__ti_Point）。
// accessor 内建（ti_name/ti_field/fi_*）在运行时读取该常量。




pub fn emit_type_info_ll(tname: string) string {
    var gref: string = base.sb_cat2("@__ti_", tname);
    var di: i64 = 0;
    var dn2: i64 = slice_len(codegen_c.ti_done) as i64;
    while (di < dn2) {
        if (codegen_c.ti_done[di] == tname) { return gref; }
        di = di + 1;
    }
    // 字段元数据取自 ll_build_reg 建好的注册表（emit 期唯一可靠来源）
    var lti: i64 = sema.llt_find(tname);
    if (lti < 0) {
        base.diag_new("T-CDE-E910", "error", base.sb_cat2("type_info: '", base.sb_cat2(tname, "' 不是 struct 类型（当前仅支持 struct）")), "", 1, 1, 1, 10);
        return "null";
    }
    if (sema.llt_kinds[lti] != "struct") {
        base.diag_new("T-CDE-E910", "error", base.sb_cat2("type_info: '", base.sb_cat2(tname, "' 不是 struct 类型（当前仅支持 struct）")), "", 1, 1, 1, 10);
        return "null";
    }
    append(codegen_c.ti_done, tname);
    var sty: string = ll_named(tname);

    var m: i64 = slice_len(llsf_st) as i64;
    var n: i64 = 0;
    var j: i64 = 0;
    while (j < m) {
        if (llsf_st[j] == tname) { n = n + 1; }
        j = j + 1;
    }

    var fsb: StringBuilder = sb_new();
    sb_append_str(fsb, gref);
    sb_append_str(fsb, "_f = internal constant [");
    sb_append_i64(fsb, n);
    sb_append_str(fsb, " x %TFieldInfo] [");
    var i: i64 = 0;
    j = 0;
    while (j < m) {
        if (llsf_st[j] == tname) {
            if (i > 0) { sb_append_str(fsb, ", "); }
            var ftd: i64 = llsf_td[j];
            // ll_strlit 发射 @.sN 字面量并回填 ll_last_sref/ll_last_slen；
            // 常量初始化器要的是内联 %TStr 值，不能用它返回的 @.tsN 指针。
            ll_strlit(llsf_fld[j]);
            var fns: string = base.sb_cat5("%TStr { ptr ", ll_last_sref, ", i64 ", base.i2s(ll_last_slen), " }");
            ll_strlit(sema.td_readable(ftd));
            var tns: string = base.sb_cat5("%TStr { ptr ", ll_last_sref, ", i64 ", base.i2s(ll_last_slen), " }");
            var isp: i64 = 0;
            if (codegen_c.is_ref_type(ftd)) { isp = 1; }
            sb_append_str(fsb, base.sb_cat3("%TFieldInfo { ", fns, ", i64 ptrtoint (ptr getelementptr ("));
            sb_append_str(fsb, sty);
            sb_append_str(fsb, ", ptr null, i32 0, i32 ");
            sb_append_i64(fsb, llsf_idx[j]);
            sb_append_str(fsb, ") to i64), ");
            sb_append_str(fsb, tns);
            sb_append_str(fsb, ", i64 ");
            sb_append_str(fsb, ll_sizeof(ll_td(ftd)));
            sb_append_str(fsb, ", i8 ");
            sb_append_i64(fsb, isp);
            sb_append_str(fsb, ", i64 ");
            sb_append_i64(fsb, llsf_tag[j]);   // 字段 tagID（@N 显式 / 全自动自动分配）
            sb_append_str(fsb, " }");
            i = i + 1;
        }
        j = j + 1;
    }
    sb_append_str(fsb, "]");
    llpg(sb_to_str(fsb));

    ll_strlit(tname);
    var tnm: string = base.sb_cat5("%TStr { ptr ", ll_last_sref, ", i64 ", base.i2s(ll_last_slen), " }");
    var tsb: StringBuilder = sb_new();
    sb_append_str(tsb, gref);
    sb_append_str(tsb, " = internal constant %TTypeInfo { ");
    sb_append_str(tsb, tnm);
    sb_append_str(tsb, ", i64 ");
    sb_append_str(tsb, ll_sizeof(sty));
    sb_append_str(tsb, ", i64 0, i64 ");
    sb_append_i64(tsb, n);
    sb_append_str(tsb, base.sb_cat3(", %TSlice { ptr ", gref, "_f, i64 "));
    sb_append_i64(tsb, n);
    sb_append_str(tsb, ", i64 ");
    sb_append_i64(tsb, n);
    sb_append_str(tsb, ", i64 ");
    sb_append_str(tsb, ll_sizeof("%TFieldInfo"));
    sb_append_str(tsb, " } }");
    llpg(sb_to_str(tsb));
    return gref;
}
