    // （Phase B 落地 CTFE 后此处改为直接发射折叠得到的常量）。
    if (n.kind == "comptime") {
        return emit_lle(n.na);
    }
    if (n.kind == "binary") {
        return ll_binary(e);
    }
    if (n.kind == "unary") {
        return ll_unary(e);
