            // 标量与引用（pointer）：alloca 里存的是值/地址，须 load 成 SSA 值，
            // 否则下游 `add i32 %v.x, 1` 会把 ptr 当 i32 用 → LLVM 校验报错。
            var ltd: i64 = ll_etd(e);
            if (ll_isagg(ltd)) {
                return lname;
            }
            return ll_load(ll_td(ltd), lname);
        }
        var g: i64 = llgv_find(le_idn);
        if (g >= 0) {
            var gtd: i64 = llgv_td[g];
            if (ll_isagg(gtd)) {
                return base.sb_cat2("@", le_idn);
            }
            return ll_load(ll_td(gtd), base.sb_cat2("@", le_idn));
        }
        var ci: i64 = llcn_find(le_idn);
        if (ci >= 0) {
            return emit_lle(llcn_e[ci]);
