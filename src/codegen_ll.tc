// ══════════════════════════════════════════════════════════════════
// src/codegen_ll.tc — 编译步骤 4b：LLVM IR 后端
//
// 内容：M13 LLVM Emitter —— .tc 直出 .ll，配合 clang 一步到可执行程序。
// 依赖：base, lex, parse, sema, codegen_c。
// ══════════════════════════════════════════════════════════════════

@import("src.base" :: *);
@import("src.lex" :: *);
@import("src.parse" :: *);
@import("src.sema" :: *);
@import("src.codegen_c" :: *);

// ═══════════════════════════════════════════════════════════════
// M13: LLVM IR Emitter — .tc 直出 .ll，配合 clang 一步到可执行程序
//
// 值模型：
//   * 标量表达式 → SSA 值（bool 统一 i8，仅分支处转 i1）
//   * 聚合表达式（string/slice/struct/variant/union）→ 指向存储的 ptr
//   * 全部 alloca 集中在函数 entry 块（循环内不增长栈）
//   * 与 C runtime 的交互统一经 t_shim_ll.c 的 tll_* 指针化桥接；
//     模块内 t 函数间聚合按值传递（同模块 lowering 一致，无 ABI 风险）
// ═══════════════════════════════════════════════════════════════

pub var ll_head: []string;    // 模块头：类型定义 + declare
pub var ll_glob: []string;    // 字符串常量 + 全局变量定义
pub var ll_body: []string;    // 函数定义
pub var ll_fal: []string;     // 当前函数 entry 块 alloca 行
pub var ll_fb: []string;      // 当前函数体指令行
pub var g_defer_ll: [1024]i64; // defer 延迟栈（LLVM 后端），与 g_defer 同源语义
pub var g_defer_ll_n: i64 = 0; // g_defer_ll 栈顶计数
pub var ll_tmpc: i64;         // SSA 临时值计数（每函数重置）
pub var ll_lblc: i64;         // 标签计数（每函数重置）
pub var ll_scc: i64;          // scratch alloca 计数（每函数重置）
pub var ll_strc: i64;         // 字符串常量计数（模块级）
pub var ll_term: bool;        // 当前块是否已被终结指令封口
pub var ll_cur_blk: string;   // 当前基本块标签（phi 前驱用）
pub var ll_cur_ret: i64;      // 当前函数返回类型 td
pub var ll_has_main: bool;
pub var ll_main_fn: string;
pub var ll_last_sref: string; // 最近一次字符串常量的 @.sN 引用
pub var ll_last_slen: i64;

pub fn llph(s: string) void { append(ll_head, s); }
pub fn llpg(s: string) void { append(ll_glob, s); }
pub fn llpb(s: string) void { append(ll_body, s); }
pub fn llfa(s: string) void { append(ll_fal, s); }
pub fn llfb(s: string) void { append(ll_fb, s); }

// ── 具名类型注册表 ─────────────────────────────────────────────


pub var llsf_st: []string;     // struct 字段：名/字段/序号/td
pub var llsf_fld: []string;
pub var llsf_idx: []i64;
pub var llsf_td: []i64;
pub var llsf_tag: []i64;       // 字段 tagID（@N 显式 / 全显式时自动分配；解析后 ≥1）

pub var llec_e: []string;      // enum 常量：类型名/成员名/值
pub var llec_m: []string;
pub var llec_v: []i64;

pub var llfl_f: []string;      // flag 槽位：类型名/槽名/start/len
pub var llfl_s: []string;
pub var llfl_start: []i64;
pub var llfl_len: []i64;

pub var llv_v: []string;       // variant case：类型名/case 名/tag/载荷 td(-1 无)
pub var llv_c: []string;
pub var llv_tag: []i64;
pub var llv_ptd: []i64;
pub var llv_ptdl: []i64;       // 多载荷 case：载荷类型链头（kids 下标），-1 表示单载荷/单元

pub var llu_u: []string;       // union 成员：类型名/成员名/td
pub var llu_m: []string;
pub var llu_td: []i64;

pub var llfn_n: []string;      // 函数签名：名/返回 td/参数池起点/参数数/extern
pub var llfn_r: []i64;
pub var llfn_ps: []i64;
pub var llfn_pc: []i64;
pub var llfn_x: []bool;
pub var llfp_td: []i64;        // 参数 td 扁平池

pub var llgv_n: []string;      // 全局 var：名/td/init 节点(-1 无)
pub var llgv_td: []i64;
pub var llgv_init: []i64;
pub var llgv_link: []i64;      // 链接模式标记：0 普通 / 1 导出(发 declare) / 2 私有(跳过)，对应 g_link_libs 库

pub var llcn_n: []string;      // 全局 const：名/表达式节点（使用处内联展开）
pub var llcn_e: []i64;

pub var lla_n: []string;       // 当前函数已 alloca 的名字（去重）
pub var llbrk: []string;       // break/continue 目标栈（top = ll_loopd-1）
pub var llcnt: []string;
pub var ll_loopd: i64;


pub fn llsf_find(st: string, f: string) i64 {
    var n: i64 = slice_len(llsf_st) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (llsf_st[i] == st && llsf_fld[i] == f) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn llec_find(e: string, m: string) i64 {
    var n: i64 = slice_len(llec_e) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (llec_e[i] == e && llec_m[i] == m) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn llfl_find(f: string, s: string) i64 {
    var n: i64 = slice_len(llfl_f) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (llfl_f[i] == f && llfl_s[i] == s) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn llfn_find(name: string) i64 {
    var n: i64 = slice_len(llfn_n) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (llfn_n[i] == name) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn llgv_find(name: string) i64 {
    var n: i64 = slice_len(llgv_n) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (llgv_n[i] == name) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn llcn_find(name: string) i64 {
    var n: i64 = slice_len(llcn_n) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (llcn_n[i] == name) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn lla_has(name: string) bool {
    var n: i64 = slice_len(lla_n) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (lla_n[i] == name) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// variant 辅助函数名匹配：Name_from_Case / Name_is_Case / Name_as_Case
// 命中后设置 ll_vm_kind ("from"/"is"/"as") 与池下标 ll_vm_i
pub var ll_vm_kind: string;
pub var ll_vm_i: i64;
pub var ll_vm_fi: i64;          // 多载荷字段下标；-1 表示单载荷（_as_<C>）

pub fn llv_match(cn: string) bool {
    ll_vm_kind = "";
    ll_vm_i = -1;
    ll_vm_fi = -1;
    var n: i64 = slice_len(llv_v) as i64;
    var i: i64 = 0;
    while (i < n) {
        var f1: string = base.sb_cat4(llv_v[i], "_from_", llv_c[i], "");
        if (cn == f1) {
            ll_vm_kind = "from";
            ll_vm_i = i;
            return true;
        }
        var f2: string = base.sb_cat4(llv_v[i], "_is_", llv_c[i], "");
        if (cn == f2) {
            ll_vm_kind = "is";
            ll_vm_i = i;
            return true;
        }
        var f3: string = base.sb_cat4(llv_v[i], "_as_", llv_c[i], "");
        if (cn == f3) {
            ll_vm_kind = "as";
            ll_vm_i = i;
            ll_vm_fi = -1;
            return true;
        }
        // 多载荷逐字段访问器 _as_<C>_f<k>
        if (llv_ptdl[i] >= 0) {
            var fk: i64 = 0;
            while (fk < 16) {
                var ff: string = base.sb_cat5(llv_v[i], "_as_", llv_c[i], "_f", base.i2s(fk));
                if (cn == ff) {
                    ll_vm_kind = "as";
                    ll_vm_i = i;
                    ll_vm_fi = fk;
                    return true;
                }
                fk = fk + 1;
            }
        }
        i = i + 1;
    }
    return false;
}

// 多载荷 case 的第 fi 个载荷类型描述符；越界或非多载荷时回落到 llv_ptd（单载荷）。
// 缺这一支时 `_as_C_f1` 会被当成首个载荷的类型（通常 i64），
// 让 bool 载荷在 ll_cast_v 里发出 `icmp ne i64 %tN`（%tN 实为 i8）→ LLVM 校验失败。
pub fn ll_variant_fi_td(vi: i64, fi: i64) i64 {
    if (fi < 0) {
        return llv_ptd[vi];
    }
    var t: i64 = llv_ptdl[vi];
    var k: i64 = 0;
    while (t >= 0) {
        if (k == fi) {
            return sema.resolve_type_desc(base.kids[t].val);
        }
        k = k + 1;
        t = base.kids[t].next;
    }
    return llv_ptd[vi];
}

// 多载荷 case 的载荷布局类型串 "{T0,Ti...}"（供 blob bitcast / insertvalue / getelementptr）。
pub fn ll_variant_sty(vi: i64) string {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, "{");
    var t: i64 = llv_ptdl[vi];
    var first: bool = true;
    while (t >= 0) {
        var ft: i64 = sema.resolve_type_desc(base.kids[t].val);
        if (first == false) {
            sb_append_str(sb, ", ");
        }
        sb_append_str(sb, ll_td(ft));
        first = false;
        t = base.kids[t].next;
    }
    sb_append_str(sb, "}");
    return sb_to_str(sb);
}

// ── 标量 → LLVM 类型 ───────────────────────────────────────────

// >>> GEN:scalar_llmap (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
pub fn scalar_to_ll(name: string) string {
    if (name == "u8" || name == "i8" || name == "bool") { return "i8"; }
    if (name == "u16" || name == "i16") { return "i16"; }
    if (name == "u32" || name == "i32" || name == "rune") { return "i32"; }
    if (name == "f32") { return "float"; }
    if (name == "f64") { return "double"; }
    return "i64";
}

// <<< GEN:scalar_llmap <<<


pub fn ll_isf(name: string) bool {
    return name == "f32" || name == "f64";
}

// ── td → LLVM 类型 ─────────────────────────────────────────────

pub fn ll_named(name: string) string {
    if (name == "TSb*") { return "ptr"; }
    var i: i64 = sema.llt_find(name);
    if (i < 0) {
        return "i64";
    }
    var k: string = sema.llt_kinds[i];
    if (k == "struct") { return base.sb_cat2("%st.", name); }
    if (k == "variant") { return base.sb_cat2("%vt.", name); }
    if (k == "union") { return base.sb_cat2("%un.", name); }
    if (k == "enum" || k == "flag") { return scalar_to_ll(sema.llt_unders[i]); }
    if (k == "alias") { return ll_td(sema.llt_atd[i]); }
    return "i64";
}

pub fn ll_td(td: i64) string {
    if (td < 0) {
        return "i64";
    }
    var t: TD = sema.tds[td];
    if (t.cat == "string" || t.cat == "bytes") { return "%TStr"; }
    if (t.cat == "pointer") { return "ptr"; }
    if (t.cat == "slice") { return "%TSlice"; }
    if (t.cat == "array") {
        var an: i64 = t.alen;
        if (an < 0) {
            an = 0;
        }
        return base.sb_cat5("[", base.i2s(an), " x ", ll_td(t.elem), "]");
    }
    if (t.cat == "map") { return "ptr"; }
    if (t.cat == "optional") { return "ptr"; }
    if (t.cat == "sym") {
        if (t.alen == 16) { return "i16"; }
        return "i32";
    }
    if (t.cat == "typeinfo" || t.cat == "fieldinfo") { return "ptr"; }
    // 函数类型在 LLVM 里就是不透明指针（opaque pointer），签名信息在调用点重建
    if (t.cat == "func") { return "ptr"; }
    if (t.cat == "void") { return "void"; }
    if (t.cat == "scalar") {
        if (t.name == "") {
            return "i64";
        }
        return scalar_to_ll(t.name);
    }
    if (t.cat == "named") {
        if (t.name == "") {
            return "ptr";
        }
        return ll_named(t.name);
    }
    return "i64";
}

// td 是否聚合（值模型走 ptr）
pub fn ll_isagg(td: i64) bool {
    if (td < 0) {
        return false;
    }
    var t: TD = sema.tds[td];
    if (t.cat == "string" || t.cat == "bytes" || t.cat == "slice" || t.cat == "array") {
        return true;
    }
    if (t.cat == "named") {
        if (t.name == "TSb*") {
            return false;
        }
        var i: i64 = sema.llt_find(t.name);
        if (i < 0) {
            return false;
        }
        var k: string = sema.llt_kinds[i];
        if (k == "struct" || k == "variant" || k == "union") {
            return true;
        }
        if (k == "alias") {
            return ll_isagg(sema.llt_atd[i]);
        }
        return false;
    }
    return false;
}

// 把（可能多层）类型别名解析到底层具名类型名。
// 成员访问的 GEP 必须基于底层聚合类型名，否则对别名类型会落到 null 指针 → 运行期崩溃
// （变量分配走 resolve 路径用底层类型，而成员 GEP 曾直接用别名名，二者不一致）。
pub fn ll_alias_base_name(name: string) string {
    var cur: string = name;
    var guard: i64 = 0;
    while (guard < 64) {
        var ti: i64 = sema.llt_find(cur);
        if (ti < 0) { break; }
        if (sema.llt_kinds[ti] != "alias") { break; }
        var utd: i64 = sema.llt_atd[ti];
        if (utd < 0) { break; }
        if (sema.tds[utd].cat != "named") { break; }
        cur = sema.tds[utd].name;
        guard = guard + 1;
    }
    return cur;
}


pub fn ll_sizeof(ty: string) string {
    return base.sb_cat3("ptrtoint (ptr getelementptr (", ty, ", ptr null, i32 1) to i64)");
}

pub fn ll_zero(ty: string) string {
    if (str_len(ty) > 0) {
        // 37 = '%'（具名聚合），91 = '['（定长数组 [N x T]）
        if (ty[0] == 37 || ty[0] == 91) {
            return "zeroinitializer";
        }
    }
    if (ty == "float" || ty == "double") {
        return "0.0";
    }
    if (ty == "ptr") {
        return "null";
    }
    return "0";
}

// ── 字符串常量 ─────────────────────────────────────────────────

pub fn esc_ll(s: string) string {
    var sb: StringBuilder = sb_new();
    var i: u64 = 0;
    var n: u64 = str_len(s);
    while (i < n) {
        var c: u8 = s[i];
        if (c >= 32 && c <= 126 && c != 34 && c != 92) {
            sb_append_char(sb, c);
        } else {
            sb_append_char(sb, 92);
            sb_append_char(sb, base.hex_digit(c / 16));
            sb_append_char(sb, base.hex_digit(c % 16));
        }
        i = i + 1;
    }
    return sb_to_str(sb);
}

// 生成字符串常量对（[N x i8] + %TStr），返回 "@.tsN"（聚合 ptr 值）
pub fn ll_strlit(s: string) string {
    var idx: i64 = ll_strc;
    ll_strc = ll_strc + 1;
    var sn: string = base.sb_cat2("@.s", base.i2s(idx));
    var tn: string = base.sb_cat2("@.ts", base.i2s(idx));
    var L: i64 = str_len(s) as i64;
    if (L == 0) {
        llpg(base.sb_cat2(sn, " = private unnamed_addr constant [1 x i8] zeroinitializer"));
    } else {
        var line: StringBuilder = sb_new();
        sb_append_str(line, sn);
        sb_append_str(line, " = private unnamed_addr constant [");
        sb_append_i64(line, L);
        sb_append_str(line, " x i8] c\"");
        sb_append_str(line, esc_ll(s));
        sb_append_str(line, "\"");
        llpg(sb_to_str(line));
    }
    var l2: StringBuilder = sb_new();
    sb_append_str(l2, tn);
    sb_append_str(l2, " = private unnamed_addr constant %TStr { ptr ");
    sb_append_str(l2, sn);
    sb_append_str(l2, ", i64 ");
    sb_append_i64(l2, L);
    sb_append_str(l2, " }");
    llpg(sb_to_str(l2));
    ll_last_sref = sn;
    ll_last_slen = L;
    return tn;
}

// ── 临时值 / 标签 / scratch ────────────────────────────────────

pub fn ll_tmp() string {
    var v: i64 = ll_tmpc;
    ll_tmpc = v + 1;
    return base.sb_cat2("%t", base.i2s(v));
}

pub fn ll_lbl(p: string) string {
    var v: i64 = ll_lblc;
    ll_lblc = v + 1;
    return base.sb_cat2(p, base.i2s(v));
}

pub fn ll_label(name: string) void {
    llfb(base.sb_cat2(name, ":"));
    ll_cur_blk = name;
    ll_term = false;
}

pub fn ll_open() void {
    if (ll_term) {
        var L: string = ll_lbl("dead");
        ll_label(L);
    }
}

// 每个调用点一个 scratch alloca（置于 entry，循环安全）
pub fn ll_scratch(ty: string) string {
    var v: i64 = ll_scc;
    ll_scc = v + 1;
    var name: string = base.sb_cat2("%s", base.i2s(v));
    llfa(base.sb_cat4("  ", name, " = alloca ", ty));
    return name;
}

// ── 注册表构建 ─────────────────────────────────────────────────

pub fn ll_build_reg() void {
    var n: i64 = slice_len(lex.decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = lex.decl_list[i];
        var dn: Node = base.nodes[d];
        if (dn.kind == "StructDecl") {
            append(sema.llt_names, dn.sa);
            append(sema.llt_kinds, "struct");
            append(sema.llt_unders, "");
            var neg1: i64 = -1;
            append(sema.llt_atd, neg1);
            var fi: i64 = 0;
            var c: i64 = dn.lb;
            while (c >= 0) {
                var k: Child = base.kids[c];
                var f: Node = base.nodes[k.val];
                if (f.ia < 0) {
                    append(llsf_st, dn.sa);
                    append(llsf_fld, f.sa);
                    append(llsf_idx, fi);
                    var ftd: i64 = sema.resolve_type_desc(f.na);
                    append(llsf_td, ftd);
                    append(llsf_tag, f.ib);   // 解析后的 tagID（全显式或全自动均已分配）
                    fi = fi + 1;
                }
                c = k.next;
            }
        }
        if (dn.kind == "EnumDecl") {
            append(sema.llt_names, dn.sa);
            append(sema.llt_kinds, "enum");
            append(sema.llt_unders, dn.sb);
            var neg2: i64 = -1;
            append(sema.llt_atd, neg2);
            var auto_val: i64 = 0;
            var c2: i64 = dn.lb;
            while (c2 >= 0) {
                var k2: Child = base.kids[c2];
                var v: Node = base.nodes[k2.val];
                if (v.na >= 0) {
                    var vn: Node = base.nodes[v.na];
                    if (vn.kind == "int") {
                        var r: i64 = vn.ia;
                        if (r < 2) {
                            r = 10;
                        }
                        var pv: i64 = sema.js_parse_int(vn.sa, r);
                        append(llec_e, dn.sa);
                        append(llec_m, v.sa);
                        append(llec_v, pv);
                        auto_val = pv + 1;
                    }
                } else {
                    append(llec_e, dn.sa);
                    append(llec_m, v.sa);
                    append(llec_v, auto_val);
                    auto_val = auto_val + 1;
                }
                c2 = k2.next;
            }
        }
        if (dn.kind == "FlagDecl") {
            append(sema.llt_names, dn.sa);
            append(sema.llt_kinds, "flag");
            append(sema.llt_unders, dn.sb);
            var neg3: i64 = -1;
            append(sema.llt_atd, neg3);
            var auto_off: i64 = 0;
            var c3: i64 = dn.lb;
            while (c3 >= 0) {
                var k3: Child = base.kids[c3];
                var sl: Node = base.nodes[k3.val];
                var start: i64 = auto_off;
                if (sl.bb) {
                    start = sl.ib;
                }
                append(llfl_f, dn.sa);
                append(llfl_s, sl.sa);
                append(llfl_start, start);
                append(llfl_len, sl.ia);
                auto_off = start + sl.ia;
                c3 = k3.next;
            }
        }
        if (dn.kind == "VariantDecl") {
            append(sema.llt_names, dn.sa);
            append(sema.llt_kinds, "variant");
            append(sema.llt_unders, "");
            var neg4: i64 = -1;
            append(sema.llt_atd, neg4);
            var c4: i64 = dn.lb;
            while (c4 >= 0) {
                var k4: Child = base.kids[c4];
                var vc: Node = base.nodes[k4.val];
                append(llv_v, dn.sa);
                append(llv_c, vc.sa);
                append(llv_tag, vc.ia);
                var ptd: i64 = -1;
                if (vc.na >= 0) {
                    ptd = sema.resolve_type_desc(vc.na);
                }
                append(llv_ptd, ptd);
                append(llv_ptdl, vc.lb);
                c4 = k4.next;
            }
        }
        if (dn.kind == "UnionDecl") {
            append(sema.llt_names, dn.sa);
            append(sema.llt_kinds, "union");
            append(sema.llt_unders, "");
            var neg5: i64 = -1;
            append(sema.llt_atd, neg5);
            var c5: i64 = dn.lb;
            while (c5 >= 0) {
                var k5: Child = base.kids[c5];
                var m: Node = base.nodes[k5.val];
                append(llu_u, dn.sa);
                append(llu_m, m.sa);
                var mtd: i64 = sema.resolve_type_desc(m.na);
                append(llu_td, mtd);
                c5 = k5.next;
            }
        }
        if (dn.kind == "TypeAliasDecl") {
            append(sema.llt_names, dn.sa);
            append(sema.llt_kinds, "alias");
            append(sema.llt_unders, "");
            var atd: i64 = sema.resolve_type_desc(dn.na);
            append(sema.llt_atd, atd);
        }
        if (dn.kind == "FuncDecl") {
            append(llfn_n, dn.sa);
            var rtd: i64 = sema.resolve_type_desc(dn.na);
            append(llfn_r, rtd);
            var ps: i64 = slice_len(llfp_td) as i64;
            append(llfn_ps, ps);
            var pc: i64 = 0;
            var c6: i64 = dn.lb;
            while (c6 >= 0) {
                var k6: Child = base.kids[c6];
                var p: Node = base.nodes[k6.val];
                var ptd2: i64 = sema.resolve_type_desc(p.na);
                append(llfp_td, ptd2);
                pc = pc + 1;
                c6 = k6.next;
            }
            append(llfn_pc, pc);
            append(llfn_x, dn.ba);
        }
        if (dn.kind == "GlobalVarDecl") {
            append(llgv_n, dn.sa);
            var gtd: i64 = sema.resolve_type_desc(dn.na);
            append(llgv_td, gtd);
            append(llgv_init, dn.nb);
            if (lex.in_link_libs(base.g_node_mod[d])) {
                if (dn.bc) { append(llgv_link, 1); } else { append(llgv_link, 2); }
            } else {
                append(llgv_link, 0);
            }
        }
        if (dn.kind == "GlobalConstDecl") {
            append(llcn_n, dn.sa);
            append(llcn_e, dn.nb);
        }
        i = i + 1;
    }
}

// ── 表达式类型（expr_type_desc 的 LLVM 补丁包装）───────────────

pub fn ll_etd(e: i64) i64 {
    if (e < 0) {
        return sema.td_mk("unknown");
    }
    var n: Node = base.nodes[e];
    if (n.kind == "unary") {
        if (n.sa == "!") {
            return sema.td_named_mk("scalar", "bool");
        }
        return ll_etd(n.na);
    }
    if (n.kind == "struct_lit") {
        return sema.td_named_mk("named", n.sa);
    }
    if (n.kind == "member") {
        var ob: Node = base.nodes[n.na];
        if (ob.kind == "ident") {
            var ti: i64 = sema.llt_find(ob.sa);
            if (ti >= 0) {
                if (sema.llt_kinds[ti] == "enum" || sema.llt_kinds[ti] == "flag") {
                    return sema.td_named_mk("scalar", sema.llt_unders[ti]);
                }
            }
        }
        var od: i64 = codegen_c.expr_type_desc(e);
        var ot: TD = sema.tds[od];
        if (ot.cat != "unknown") {
            return od;
        }
        // union 成员
        var obd: i64 = ll_etd(n.na);
        var obt: TD = sema.tds[obd];
        if (obt.cat == "named") {
            var ui: i64 = sema.llt_find(obt.name);
            if (ui >= 0) {
                if (sema.llt_kinds[ui] == "union") {
                    var un: i64 = slice_len(llu_u) as i64;
                    var uj: i64 = 0;
                    while (uj < un) {
                        if (llu_u[uj] == obt.name && llu_m[uj] == n.sa) {
                            return llu_td[uj];
                        }
                        uj = uj + 1;
                    }
                }
            }
        }
        return od;
    }
    if (n.kind == "paren") {
        return ll_etd(n.na);
    }
    // comptime 表达式：类型即内层表达式的类型（Phase A 透明降级）
    if (n.kind == "comptime") {
        return ll_etd(n.na);
    }
    // match 表达式：脱糖合成的 match 节点在 sema 之后才产生，自身 .td 未设；
    // 其类型取首个 arm 体的类型（与 emit_lle 中 mv_rtd 一致）。否则落到
    // expr_type_desc 默认 i64，导致 bool 结果在 return 处被当成 i64 真值化 →
    // `icmp ne i64 %t8` 与槽实际 i8 不符，LLVM 校验失败。
    if (n.kind == "match") {
        return ll_etd(codegen_c.match_first_body(e));
    }
    if (n.kind == "binary") {
        var bop9: string = n.sa;
        if (bop9 == "==" || bop9 == "!=" || bop9 == "<" || bop9 == ">") {
            return sema.td_named_mk("scalar", "bool");
        }
        if (bop9 == "<=" || bop9 == ">=" || bop9 == "&&" || bop9 == "||") {
            return sema.td_named_mk("scalar", "bool");
        }
        return ll_bin_td(e);
    }
    if (n.kind == "call") {
        var cal: Node = base.nodes[n.na];
        if (cal.kind == "ident") {
            var cn: string = cal.sa;
            if (cn == "flag_get") {
                return sema.td_named_mk("scalar", "u32");
            }
            if (cn == "sys_run") {
                return sema.td_named_mk("scalar", "i32");
            }
            if (llv_match(cn)) {
                if (ll_vm_kind == "from") {
                    return sema.td_named_mk("named", llv_v[ll_vm_i]);
                }
                if (ll_vm_kind == "is") {
                    return sema.td_named_mk("scalar", "bool");
                }
                return ll_variant_fi_td(ll_vm_i, ll_vm_fi);
            }
        }
        return codegen_c.expr_type_desc(e);
    }
    return codegen_c.expr_type_desc(e);
}

// 二元运算的统一操作数类型：字面量让位于有类型的一侧
pub fn ll_bin_td(e: i64) i64 {
    var n: Node = base.nodes[e];
    var ln: Node = base.nodes[n.na];
    var rn: Node = base.nodes[n.nb];
    var llit: bool = ln.kind == "int" || ln.kind == "float";
    var rlit: bool = rn.kind == "int" || rn.kind == "float";
    if (llit && rlit == false) {
        return ll_etd(n.nb);
    }
    return ll_etd(n.na);
}

// ── 数值转换 ───────────────────────────────────────────────────

pub fn ll_cast_v(v: string, ftd: i64, ttd: i64) string {
    var fs: string = sema.td_sname(ftd);
    var ts: string = sema.td_sname(ttd);
    if (fs == "" || ts == "") {
        return v;
    }
    if (str_len(v) == 0) {
        return v;
    }
    if (ftd >= 0 && ttd >= 0 && sema.tds[ftd].cat == "array" && sema.tds[ttd].cat == "slice") {
        var aty: string = ll_td(sema.tds[ftd].elem);
        var nlen: i64 = sema.tds[ftd].alen;
        var p0: string = ll_tmp();
        var sb1: StringBuilder = sb_new();
        sb_append_str(sb1, "  ");
        sb_append_str(sb1, p0);
        sb_append_str(sb1, " = getelementptr inbounds ");
        sb_append_str(sb1, base.sb_cat3("[", base.i2s(nlen), " x "));
        sb_append_str(sb1, aty);
        sb_append_str(sb1, "], ptr ");
        sb_append_str(sb1, v);
        sb_append_str(sb1, ", i64 0, i64 0");
        llfb(sb_to_str(sb1));
        var outp: string = ll_scratch("%TSlice");
        var sb2: StringBuilder = sb_new();
        sb_append_str(sb2, "  call void @tll_slice_from_raw(ptr ");
        sb_append_str(sb2, p0);
        sb_append_str(sb2, ", i64 ");
        sb_append_str(sb2, base.i2s(nlen));
        sb_append_str(sb2, ", i64 ");
        sb_append_str(sb2, ll_sizeof(aty));
        sb_append_str(sb2, ", ptr ");
        sb_append_str(sb2, outp);
        sb_append_str(sb2, ")");
        llfb(sb_to_str(sb2));
        var r: string = ll_tmp();
        llfb(base.sb_cat4("  ", r, " = load %TSlice, ptr ", outp));
        return r;
    }
    if (v[0] != 37) {
        // 常量文本一般随目标类型自适应；例外处理如下——
        // (1) f64 常量窄化到 float：float 的十进制字面量必须能被 f32 **精确表示**，
        //     `store float 0.016` 会被拒（floating point constant invalid for type）。
        //     降级成一条 fptrunc 指令，由 LLVM 自己做正确舍入。
        if (ll_isf(fs) && ll_isf(ts) && base.ll_bits(fs) > base.ll_bits(ts)) {
            var fcv: string = ll_tmp();
            llfb(base.sb_cat6("  ", fcv, " = fptrunc ", scalar_to_ll(fs), " ",
                base.sb_cat4(v, " to ", scalar_to_ll(ts), "")));
            return fcv;
        }
        // (2) 整型/Bool 常量 → 浮点：LLVM 浮点常量必须带小数点，否则
        //     `double 7` 被判成「整数常量用于浮点类型」而非法。补 ".0"。
        if (ll_isf(ts) && ll_isf(fs) == false) {
            return base.sb_cat2(v, ".0");
        }
        // (3) 浮点常量 → 整型/Bool：LLVM 整数常量不接受小数（`i64 2.9` 非法），
        //     改用 fptosi/fptoui 指令（常量操作数合法，编译期即求值）。
        if (ll_isf(fs) && ll_isf(ts) == false) {
            var tcv: string = ll_tmp();
            if (base.ll_signed(ts)) {
                llfb(base.sb_cat6("  ", tcv, " = fptosi ", scalar_to_ll(fs), " ",
                    base.sb_cat4(v, " to ", scalar_to_ll(ts), "")));
            } else {
                llfb(base.sb_cat6("  ", tcv, " = fptoui ", scalar_to_ll(fs), " ",
                    base.sb_cat4(v, " to ", scalar_to_ll(ts), "")));
            }
            return tcv;
        }
        return v;    // 常量文本随目标类型自适应
    }
    var fb2: i64 = base.ll_bits(fs);
    var tb: i64 = base.ll_bits(ts);
    var ff: bool = ll_isf(fs);
    var tf: bool = ll_isf(ts);
    var fty: string = scalar_to_ll(fs);
    var tty: string = scalar_to_ll(ts);
    if (ff && tf) {
        if (fb2 == tb) {
            return v;
        }
        var t1: string = ll_tmp();
        if (fb2 < tb) {
            llfb(base.sb_cat6("  ", t1, " = fpext ", fty, " ", base.sb_cat4(v, " to ", tty, "")));
        } else {
            llfb(base.sb_cat6("  ", t1, " = fptrunc ", fty, " ", base.sb_cat4(v, " to ", tty, "")));
        }
        return t1;
    }
    if (ff && tf == false) {
        var t2: string = ll_tmp();
        if (base.ll_signed(ts)) {
            llfb(base.sb_cat6("  ", t2, " = fptosi ", fty, " ", base.sb_cat4(v, " to ", tty, "")));
        } else {
            llfb(base.sb_cat6("  ", t2, " = fptoui ", fty, " ", base.sb_cat4(v, " to ", tty, "")));
        }
        return t2;
    }
    if (ff == false && tf) {
        var t3: string = ll_tmp();
        if (base.ll_signed(fs)) {
            llfb(base.sb_cat6("  ", t3, " = sitofp ", fty, " ", base.sb_cat4(v, " to ", tty, "")));
        } else {
            llfb(base.sb_cat6("  ", t3, " = uitofp ", fty, " ", base.sb_cat4(v, " to ", tty, "")));
        }
        return t3;
    }
    if (ts == "bool") {
        if (fs == "bool") {
            return v;
        }
        var t4: string = ll_tmp();
        llfb(base.sb_cat6("  ", t4, " = icmp ne ", fty, " ", base.sb_cat3(v, ", ", "0")));
        var t5: string = ll_tmp();
        llfb(base.sb_cat6("  ", t5, " = zext i1 ", t4, " to i8", ""));
        return t5;
    }
    if (fb2 == tb) {
        return v;
    }
    var t6: string = ll_tmp();
    if (fb2 < tb) {
        if (base.ll_signed(fs)) {
            llfb(base.sb_cat6("  ", t6, " = sext ", fty, " ", base.sb_cat4(v, " to ", tty, "")));
        } else {
            llfb(base.sb_cat6("  ", t6, " = zext ", fty, " ", base.sb_cat4(v, " to ", tty, "")));
        }
    } else {
        llfb(base.sb_cat6("  ", t6, " = trunc ", fty, " ", base.sb_cat4(v, " to ", tty, "")));
    }
    return t6;
}

// i8 bool 值 → i1（分支条件）
pub fn ll_to_i1(v: string) string {
    if (v == "1") {
        return "true";
    }
    if (v == "0") {
        return "false";
    }
    var t: string = ll_tmp();
    llfb(base.sb_cat4("  ", t, " = icmp ne i8 ", base.sb_cat2(v, ", 0")));
    return t;
}

// i1 → i8
pub fn ll_b8(v1: string) string {
    var t: string = ll_tmp();
    llfb(base.sb_cat4("  ", t, " = zext i1 ", base.sb_cat2(v1, " to i8")));
    return t;
}

// 从 ptr 装载
pub fn ll_load(ty: string, p: string) string {
    var t: string = ll_tmp();
    llfb(base.sb_cat6("  ", t, " = load ", ty, ", ptr ", p));
    return t;
}

// 聚合复制：src ptr → dst ptr（load/store 按值搬运）
pub fn ll_copy(ty: string, src: string, dst: string) void {
    var t: string = ll_load(ty, src);
    llfb(base.sb_cat6("  store ", ty, " ", t, ", ptr ", dst));
}

// ── 左值地址 ───────────────────────────────────────────────────

pub fn ll_addr(e: i64) string {
    var n: Node = base.nodes[e];
    if (n.kind == "paren") {
        return ll_addr(n.na);
    }
    // 取址 `&x` 作为左值：地址即操作数地址（ptr）。
    if (n.kind == "amp") {
        return emit_lle(n.na);
    }
    // 解引用 `*r` 作为左值：地址就是引用本身（一个 ptr 值），无需 load。
    if (n.kind == "deref") {
        return emit_lle(n.na);
    }
    if (n.kind == "ident") {
        var la_idn: string = codegen_c.mb_sub(n.sa);
        // 同函数内重名局部（shadowing）：反查该标识符解析到的声明节点，发射唯一化后的名字。
        if (codegen_c.em_in_fn) {
            var vdcl: i64 = base.idecl_get(e);
            if (vdcl >= 0 && base.g_local_has(vdcl)) {
                var vn: Node = base.nodes[vdcl];
                return base.sb_cat2("%v.", base.sb_cat3(vn.sa, "__", base.i2s(vdcl)));
            }
        }
        if (codegen_c.em_in_fn) {
            var f: i64 = codegen_c.fs_get(codegen_c.em_cur_fn, la_idn);
            if (f >= 0) {
                return base.sb_cat2("%v.", la_idn);
            }
        }
        var g: i64 = llgv_find(la_idn);
        if (g >= 0) {
            return base.sb_cat2("@", la_idn);
        }
        return "null";
    }
    if (n.kind == "member") {
        var obd: i64 = ll_etd(n.na);
        var obt: TD = sema.tds[obd];
        var op: string = emit_lle(n.na);
        if (obt.cat == "named") {
            // 类型别名须解析到底层聚合类型名，否则 GEP 落到 null（见 ll_alias_base_name）。
            var base: string = ll_alias_base_name(obt.name);
            var ti: i64 = sema.llt_find(base);
            if (ti >= 0) {
                if (sema.llt_kinds[ti] == "struct") {
                    var fi: i64 = llsf_find(base, n.sa);
                    if (fi >= 0) {
                        var t: string = ll_tmp();
                        var line: StringBuilder = sb_new();
                        sb_append_str(line, "  ");
                        sb_append_str(line, t);
                        sb_append_str(line, " = getelementptr inbounds %st.");
                        sb_append_str(line, base);
                        sb_append_str(line, ", ptr ");
                        sb_append_str(line, op);
                        sb_append_str(line, ", i32 0, i32 ");
                        sb_append_i64(line, llsf_idx[fi]);
                        llfb(sb_to_str(line));
                        return t;
                    }
                }
                if (sema.llt_kinds[ti] == "union") {
                    return op;    // 所有成员共址 offset 0
                }
            }
        }
        return "null";
    }
    if (n.kind == "index") {
        var od: i64 = ll_etd(n.na);
        var ot: TD = sema.tds[od];
        if (ot.cat == "slice") {
            var sp: string = emit_lle(n.na);
            var iv: string = emit_lle(n.nb);
            var t2: string = ll_tmp();
            llfb(base.sb_cat6("  ", t2, " = call ptr @tll_slice_at(ptr ", sp, ", i64 ", base.sb_cat2(iv, ")")));
            return t2;
        }
        if (ot.cat == "array") {
            var ap: string = ll_addr(n.na);
            var av2: string = ll_widen_idx(emit_lle(n.nb), n.nb);
            var t7: string = ll_tmp();
            var gsb: StringBuilder = sb_new();
            sb_append_str(gsb, "  ");
            sb_append_str(gsb, t7);
            sb_append_str(gsb, " = getelementptr ");
            sb_append_str(gsb, ll_td(od));
            sb_append_str(gsb, ", ptr ");
            sb_append_str(gsb, ap);
            sb_append_str(gsb, ", i64 0, i64 ");
            sb_append_str(gsb, av2);
            llfb(sb_to_str(gsb));
            return t7;
        }
        return "null";
    }
    return "null";
}

// ── 表达式发射 ─────────────────────────────────────────────────

pub fn emit_lle(e: i64) string {
    if (e < 0) {
        return "0";
    }
    var n: Node = base.nodes[e];

    if (n.kind == "int") {
        var r: i64 = n.ia;
        if (r < 2) {
            r = 10;
        }
        return base.i2s(sema.js_parse_int(n.sa, r));
    }
    if (n.kind == "atom") {
        if (n.ia <= 0) { n.ia = sema.atom_intern(n.sa); slice_set(base.nodes, e, n); }
        return base.i2s(n.ia);
    }
    // 内建 fid 常量（M51）：编译期常量 0/1/2
    if (n.kind == "fidconst") {
        return base.i2s(n.ia);
    }
    // 序列化操作符（M51）：@tll_ser_* 返回目标 fid（i64），链式即嵌套求值
    if (n.kind == "serialize") {
        var lsf: string = emit_lle(n.na);
        var lstd: i64 = ll_etd(n.nb);
        var lssel: string = codegen_c.ser_sel(lstd);
        var lst: string = ll_tmp();
        if (lssel == "str") {
            var lsp: string = emit_lle(n.nb);
            llfb(base.sb_cat6("  ", lst, " = call i64 @tll_ser_str(i64 ", lsf,
                base.sb_cat3(", ptr ", lsp, ")"), ""));
            return lst;
        }
        if (lssel == "atom") {
            var lsa: string = emit_lle(n.nb);
            llfb(base.sb_cat6("  ", lst, " = call i64 @tll_ser_atom(i64 ", lsf,
                base.sb_cat3(", i64 ", lsa, ")"), ""));
            return lst;
        }
        if (lssel == "bool") {
            var lsb2: string = emit_lle(n.nb);
            llfb(base.sb_cat6("  ", lst, " = call i64 @tll_ser_bool(i64 ", lsf,
                base.sb_cat3(", i8 ", lsb2, ")"), ""));
            return lst;
        }
        var lsbits: string = base.i2s(base.ll_bits(sema.td_sname(lstd)));
        if (lssel == "f") {
            var lsfv: string = ll_cast_v(emit_lle(n.nb), lstd, sema.td_named_mk("scalar", "f64"));
            llfb(base.sb_cat6("  ", lst, " = call i64 @tll_ser_f64(i64 ", lsf,
                base.sb_cat3(", double ", lsfv, ", i32 "), base.sb_cat2(lsbits, ")")));
            return lst;
        }
        var lsiv: string = ll_cast_v(emit_lle(n.nb), lstd, sema.td_named_mk("scalar", "i64"));
        var lssgn: string = "0";
        if (base.ll_signed(sema.td_sname(lstd))) { lssgn = "1"; }
        llfb(base.sb_cat6("  ", lst, " = call i64 @tll_ser_int(i64 ", lsf,
            base.sb_cat3(", i64 ", lsiv, ", i32 "),
            base.sb_cat4(lsbits, ", i32 ", lssgn, ")")));
        return lst;
    }
    // 反序列化（M52 读路径，Option B）：tll_deser_* 返回裸 T 值；string 走 sret（ptr out）
    if (n.kind == "deserialize") {
        var ldf: string = emit_lle(n.na);
        var ldtd: i64 = sema.deser_type_of(n.nb);
        var ldsel: string = codegen_c.ser_sel(ldtd);
        if (ldsel == "str") {
            var lout: string = ll_scratch("%TStr");
            llfb(base.sb_cat5("  call void @tll_deser_str(i64 ", ldf, ", ptr ", lout, ")"));
            return lout;
        }
        if (ldsel == "atom") {
            var lat: string = ll_tmp();
            llfb(base.sb_cat4("  ", lat, " = call i64 @tll_deser_atom(i64 ", base.sb_cat2(ldf, ")")));
            return lat;
        }
        if (ldsel == "bool") {
            var lbt: string = ll_tmp();
            llfb(base.sb_cat4("  ", lbt, " = call i8 @tll_deser_bool(i64 ", base.sb_cat2(ldf, ")")));
            return lbt;
        }
