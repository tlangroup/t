// S4 第七批（§0.14.7）：子节点索引 nd（默认 -1 = 无该子节点；越界读返 -1，与 node_new
// 旧默认值逐点一致）。na/nb/nc/nd 是 Node 的四个「具名子节点槽」，本批先迁量级最低的 nd
// （真站点 22；grep 命中 30 里 8 处是 RecTile.nd / HIRInst.nd 假阳性）。
//   nd 语义：通用第四子节点槽（类型节点的 flavor/第二长度、表达式的第四操作数等）。
// ⚠ 它是 **i64 索引**而非 bool：越界读必须返 -1（不是 0），否则把「无子节点」读成「子节点 0」。
pub fn node_nd(n: u64) i64 {
    sidetable_init();
    var id = nr_idx(n);
    if (id < 0 || id >= slice_len(g_node_nd)) { return -1; }
    return g_node_nd[id];
}
pub fn node_set_nd(n: u64, v: i64) void {
    var id = nr_idx(n);
    if (id < 0 || id >= slice_len(g_node_nd)) { return; }
    slice_set(g_node_nd, id, v);
}
// S4 第八批（§0.14.7）：通用整数槽 ib（默认 -1；越界读返 -1，与 node_new 旧默认值一致）。
// 与 nd 同属「索引型侧表」，复用第七批验证过的 -1 哨兵范式。
// ⚠ ib 按 kind **复用**于 6 种语义（只做等价搬迁，未拆语义）：
//   ① SL（结构体字面量）的位域/flag 显式 offset（配合 bb 标志位使用）
//   ② tile 节点折叠出的列数（ia=行，ib=列，la=flavor）
//   ③ array_lit 被 sema 回填的 TD 下标（>=0 表示此字面量构造向量/瓦片，cat 查 tds[ib]）
//      ⚠ 标记只能挂 ib：array_lit 的 ia 在 sema 之后会被抹回 -1（历史实测）。
//   ④ conpat 的子模式个数 / VC（variant case）的载荷个数（多载荷 >=2）
//   ⑤ F（结构体字段）的 tagID（>=1 显式 @N / 全自动顺序分配 1,2,3… / -1 未分配）
//   ⑥ leading-dot 结构体字面量 `.{...}` 的标记（==1）
// ⚠ 越界读必须返 -1（不是 0）：返 0 会把「无标记」读成「TD 下标 0」或「flag offset 0」，
//   是**静默错误**（不崩不报，只在深层子树上产出错误结构）——索引型侧表独有的失败模式。
pub fn node_ib(n: u64) i64 {
    sidetable_init();
    var id = nr_idx(n);
    if (id < 0 || id >= slice_len(g_node_ib)) { return -1; }
    return g_node_ib[id];
}
pub fn node_set_ib(n: u64, v: i64) void {
    var id = nr_idx(n);
    if (id < 0 || id >= slice_len(g_node_ib)) { return; }
    slice_set(g_node_ib, id, v);
}
// S4 第九批（§0.14.7）：子节点索引 nc（默认 -1 = 无该子节点；越界读返 -1，与 node_new
// 旧默认值逐点一致）。na/nb/nc/nd 四槽里的第三槽，与第七批 nd 同族，直接复用 -1 哨兵范式。
//   nc 语义（按 kind 复用，本批只做等价搬迁、未拆语义）：
//     ① for：增量表达式（continue 块；tir 在 contL 块发射）
//     ② arm（match 臂）：arm 体表达式（na=等值模式，nb=when 守卫）
//     ③ tile：cols 表达式节点（na=元素类型，nb=rows，nd=flavor）
//     ④ P（绑定参数）：when 守卫表达式
//     ⑤ 其余：通用第三子节点槽
// ⚠ 同为 **i64 索引**：越界读必须返 -1（不是 0），否则「无子节点」被读成「子节点 0」——
//   索引型侧表独有的静默失败模式（不崩不报，只在深层子树产出错误结构）。
pub fn node_nc(n: u64) i64 {
    sidetable_init();
    var id = nr_idx(n);
    if (id < 0 || id >= slice_len(g_node_nc)) { return -1; }
    return g_node_nc[id];
}
pub fn node_set_nc(n: u64, v: i64) void {
    var id = nr_idx(n);
    if (id < 0 || id >= slice_len(g_node_nc)) { return; }
    slice_set(g_node_nc, id, v);
}
// S4 第十批（§0.14.7）：通用 bool 载荷 ba（默认 **0 = false**，等价旧 `n.ba = false`）。
// ⚠ 该槽被**多个 kind 复用**于 8 种语义（本批只做等价搬迁，未拆语义——拆语义属独立变更，
//   会让本轮验证指标无法归因）。完整清单：
//   ① `bool`    字面量：布尔真值（`true` = true / `false` = false）——量最大、最热
//   ② `var_decl`：是否 `const`（不可变绑定；sema::cs_assignment / check_stmt_cst 据此报改值错）
//   ③ `arm`     ：是否 `_` 通配模式（match 兜底臂）
//   ④ `P`       ：形参是否 `_` 通配（clause 匹配时任意值皆可）
//   ⑤ `range`   ：是否闭合区间 `..=`（脱糖为 `<=` 而非 `<`）
//   ⑥ `bitstr_seg`：是否变长尾段 `rest/bitstr`
//   ⑦ `ImportItem`：是否通配 `import(*)`
//   ⑧ `StructDecl` / `VariantDecl` / `FuncDecl`：各自的结构性标记
//      （VariantDecl = 抽象/非穷尽变体；FuncDecl = 是否由 clause 脱糖生成的主体）
pub fn node_ba(n: u64) bool {
    sidetable_init();
    var id = nr_idx(n);
    if (id < 0 || id >= slice_len(g_node_ba)) { return false; }
    return g_node_ba[id] != 0;
}
pub fn node_set_ba(n: u64, v: bool) void {
    var id = nr_idx(n);
    if (id < 0 || id >= slice_len(g_node_ba)) { return; }
    if (v) { slice_set(g_node_ba, id, 1); } else { slice_set(g_node_ba, id, 0); }
}
// S4 第十一批（§0.14.7）：kids 链表头 lc（默认 **-1 = 空链**，等价旧 `n.lc = -1`）。
// `la`/`lb`/`lc` 同族，都是「子节点/语句在 kids 池里的链表头下标」而非节点 id
// （⚠ 这是本族最容易搞错的一点：`lc` 必须走 `*_kids` / `*_list` 系列的链表下钻，
//   当成节点 id 用会张冠李戴 —— 见 sema::instantiate_generic、parse::parse_method_decl 的注释）。
// ⚠ **特殊哨兵 `-2`**：`FuncDecl` / `lambda` 等带体节点用 `lc == -2` 表示
//   「本体已由别处消费 / 是外部注入的合成声明」，需跳过常规语句遍历与检查。
//   判据遍布各处：`if (n.lc > -2)`（parse::desugar_lambdas、tir::tir_lower_func、
//   codegen_c::build_type_map / emit_func_decl）、`if (n.lc != -2)`（sema::instantiate_generic、
//   ovl_instantiate、desugar_imports、meta_pass）、`if (n.lc == -2)`（sema::check_func_decl_ex、
//   meta_eval_call）。写入点只有 sema 里 4 个合成 FuncDecl 的构造实参（`mk_FuncDecl(..., -2, ...)`）。
//   ⇒ 侧表默认值必须是 **-1 而非 -2**，且越界读必须返 **-1**（返 -2 会让「越界节点」被
//   误判成「已消费的合成声明」而跳过检查，是静默错误）。
pub fn node_lc(n: u64) i64 {
    sidetable_init();
    var id = nr_idx(n);
    if (id < 0 || id >= slice_len(g_node_lc)) { return -1; }
    return g_node_lc[id];
}
pub fn node_set_lc(n: u64, v: i64) void {
    var id = nr_idx(n);
    if (id < 0 || id >= slice_len(g_node_lc)) { return; }
    slice_set(g_node_lc, id, v);
}
// S4 第六批（§0.14.7）：字符串载荷 sc（默认 ""）。**本批为 sa/sb/sc 字符串整族外置预演**
// ——首个 `[]string` 类型侧表，验证「非标量侧表 + node_new 锁步 append」范式成立。
//   sc 按 kind 复用 4 种语义（本次只做等价搬迁，未拆语义）：
//     ① ImportDecl / ImportModDecl：用户书写别名（`import x as m` 的 m）
//     ② StructDecl：@bitpack 标量成员类型名（`n.has_sc` 为真时有效）
//     ③ FuncDecl：`"__lambda__"` = Lambda 脱糖标记（检查期据此判定捕获失败）
//     ④ FuncDecl：suite 测试路径（`g_suite_path`，由 parse 写入）
//     ⑤ P Param：结构体方法脱糖时暂存的 owner 类型名 vname
//   写点 = mk_ImportDecl / mk_ImportModDecl / mk_StructDecl（形参保留，调用点不变）
//          + parse（lambda 标记、suite 路径）+ sema（P.sc = vname）+ clone_node 传播。
pub fn node_sc(n: u64) string {
    sidetable_init();
    var id = nr_idx(n);
    if (id < 0 || id >= slice_len(g_node_sc)) { return ""; }
    return g_node_sc[id];
}
pub fn node_set_sc(n: u64, v: string) void {
    var id = nr_idx(n);
    if (id < 0 || id >= slice_len(g_node_sc)) { return; }
    slice_set(g_node_sc, id, v);
}

pub struct Child {
    val: i64;
    next: i64;
}

pub var kids: []Child;

// ident 节点 → 其解析到的声明节点（支持同作用域重名 shadowing：后端按声明唯一命名）。
// S3 §4.5：原 g_idecl_n/g_idecl_d 平行数组 + last-write-wins 反向扫描已迁为节点 id
// 键控的 node_resolve[] 侧表（见上方声明 + 上方 node_resolve()/node_set_resolve()）。
// 等价性：idecl_set 的「反向扫描命中即更新」等价于「对 node_resolve[id] 直接 O(1) 覆盖写」——
// 同一 id 的多次写入最终值均为最后一次调用的值，故解析结果与旧实现逐字节一致。
// sema 解析标识符时调 node_set_resolve(id, decl)；后端发射标识符时调 node_resolve(id) 反查。

// 后端：同函数内重名局部变量唯一化命名（shadowing 支持）。
//
// S3 node_scope（§0.13.9 修订版「工作 A」）：把原「扁平 g_seen + 哨兵 + 空操作 pop」
// 的帧机制重写成**作用域帧栈 + 节点侧表**，行为逐字节等价，但彻底规避旧实现的 -O2 自别名红线：
//   · 每进一个块 g_seen_push(owner) 建一帧：记本帧起始下标 g_frame_starts[sp] 与归属节点
//     g_frame_owners[sp]，并把 node_scope[owner]=帧 id 写入第 6 张 S3 侧表。
//   · g_seen_has(key) 只扫描当前帧 [g_frame_starts[sp-1], len(g_frame_keys)) —— 与旧
//     「反向扫遇哨兵即停」覆盖的当前帧 key 集合逐字节一致（兄弟块/嵌套块/不同函数各自独立帧）。
//   · g_frame_sp 为逻辑栈深；g_seen_pop 仅自减此标量 → 绝不对任何全局切片做 slice_sub /
//     元素级写，从根上消除 -O2 优化器对自别名全局切片生成的错误代码（历史 0xC0000005）。
//   · 发射期 mangle 决策仍走 g_frame 栈；node_scope 侧表仅供未来 IDE/增量消费，不改当前行为。
pub var g_frame_keys:   []string;   // 扁平串表：按发射序记录本帧 name-key（func::name）
pub var g_frame_starts: []i64;     // 每帧起始下标（并行于 g_frame_owners）
pub var g_frame_owners: []i64;     // 每帧归属节点 id（块节点）
pub var g_frame_sp:     i64 = 0;   // 逻辑栈深（pop 仅自减此标量）
pub var g_node_scope:   []i64;     // 与 nodes 平行：节点→所属 scope id（默认 -1）  ← S3 侧表
pub var g_local_decls:  []i64;     // 已唯一化重整的声明节点 id（mangle 结果记录）

pub fn node_scope(n: u64) i64 {
    var id = nr_idx(n);
    if (id < 0 || id >= slice_len(g_node_scope)) { return -1; }
    return g_node_scope[id];
}
pub fn node_set_scope(n: u64, s: i64) void {
    var id = nr_idx(n);
    if (id < 0 || id >= slice_len(g_node_scope)) { return; }
    slice_set(g_node_scope, id, s);
}

// g_seen_push(owner)：建新帧。owner = 进入的块节点（函数体/if/while/for/for_each/block/
// comptime_block/match-arm/defer 体）。每帧同时登记 node_scope[owner]=帧 id。
pub fn g_seen_push(owner: i64) void {
    append(g_frame_starts, slice_len(g_frame_keys));
    append(g_frame_owners, owner);
    var fid: i64 = slice_len(g_frame_starts) - 1;
    g_frame_sp = fid + 1;
    node_set_scope(owner, fid);
}
// g_seen_pop：空操作（不回退 g_frame_sp）。等价性关键：旧实现 g_seen_pop 也是空操作，
// 帧隔离靠 has 反向扫遇哨兵即停；此处「当前帧」由 g_frame_starts[g_frame_sp-1] 固定为
// **最近一次** push 的起始下标，与旧「从末尾扫到最近哨兵」逐字节等价。若在此回退 sp，会让
// 嵌套块之后的外层变量误看到块前的同级变量（旧哨兵本应屏蔽之），导致 mangle 漂移
// （实测 string_utils.tc::c 即因此产生非预期差异）。
pub fn g_seen_pop() void {
    // 空操作：不收缩 g_frame_sp（保持为 push 计数），与旧 g_seen 的空操作 pop 一致。
}
// g_seen_has(key)：仅扫当前帧。与旧「反向扫遇哨兵即停」等价（当前帧 key 集合一致）。
pub fn g_seen_has(key: string) bool {
    if (g_frame_sp <= 0) { return false; }
    var start: i64 = g_frame_starts[g_frame_sp - 1];
    var n: i64 = slice_len(g_frame_keys);
    var i: i64 = n - 1;
    while (i >= start) {
        if (g_frame_keys[i] == key) { return true; }
        i = i - 1;
    }
    return false;
}
pub fn g_seen_add(key: string) void {
    append(g_frame_keys, key);
}
pub fn g_local_has(dcl: i64) bool {
    var n: i64 = slice_len(g_local_decls) as i64;
    var i: i64 = n - 1;
    while (i >= 0) {
        if (g_local_decls[i] == dcl) { return true; }
        i = i - 1;
    }
    return false;
}

// conpat 载荷绑定（match 构造器模式解构出的 `x`）由后端发射期现场合成 var_decl。
// 它们身处 match 各臂的**独立代码块**（不同 if 分支），C/LLVM 块作用域天然隔离，
// 名字不会冲突 —— 故禁止对其做唯一化重整（否则合成的声明节点与标识符反查的声明
// 节点不一致，导致「绑定存到 x__N、读取却是裸 x」的静默错编：见 adt_list / adt_status）。
pub var g_conpat_binds: []i64;
pub fn g_conpat_bind_has(d: i64) bool {
    var n: i64 = slice_len(g_conpat_binds) as i64;
    var i: i64 = n - 1;
    while (i >= 0) {
        if (g_conpat_binds[i] == d) { return true; }
        i = i - 1;
    }
    return false;
}

// const 声明成员判定已迁 node_const[] 侧表（见上方 node_const()/node_set_const()）。
// 旧 g_const_decl_ids 平行数组 + g_const_decl_has 线性扫描已删除（§4.5 per-node 标志，O(1)）。

// 新建节点：全部字段置于"空"语义，返回索引
pub fn node_new(kind: string) u64 {
    var n: Node;
    n.kind = kind;
    n.sa = "";
    n.sb = "";
    // S4 第六批（§0.14.7）：sc 已外置为侧表（默认空串，见下方 append）
    // S4 第二批（§0.14.7）：has_sa/has_sb/has_sc 已外置为侧表（默认 1=true，见下方 append）
    n.ia = -1;
    // S4 §0.14.7 SoA：ib 已外置为侧表（默认 -1，见下方 append）
    // S4 第十批（§0.14.7）：ba 已外置为侧表 g_node_ba（默认 0=false，见下方 append）
    // S4 第五批（§0.14.7）：bb/bc 已外置为侧表（默认 0=false，见下方 append）
    // S4 第四批（§0.14.7）：bd 已外置为侧表（默认 0=false，见下方 append）
    // S4 第三批（§0.14.7）：be/bf 已外置为侧表（默认 0=false，见下方 append）
    n.na = -1;
    n.nb = -1;
    // S4 §0.14.7 SoA：nc 已外置为侧表（下方 append(-1) 锁步；第九批）
    // S4 §0.14.7 SoA：nd 已外置为侧表（下方 append(-1) 锁步）
    // S4 第四批（§0.14.7）：memspace 已外置为侧表（默认 0=host，见下方 append）
    n.la = -1;
    n.lb = -1;
    // S4 第十一批（§0.14.7）：lc 已外置为侧表 g_node_lc（默认 -1 = 空链，见下方 append）
    n.id = slice_len(nodes);   // S5 step2：裸索引（append 后恰为该节点下标），供 node_span_id 机械读方迁移
    append(nodes, n);
    append(g_node_mod, g_cur_mod);   // provenance：记录本节点所属模块别名（"" = 入口）
    append(g_node_file, g_file);      // provenance：记录本节点所属源文件（load_module_file 内 g_file 已切到该模块文件）
    append(g_node_td, 0);             // S3 §4.5 node_type 侧表：默认未定型（0），由 sema/tir 经 node_set_type 写入
    append(g_node_resolve, -1);       // S3 §4.5 node_resolve 侧表：默认 -1（未解析到声明）
    append(g_node_const, 0);           // S3 §4.5 node_const 侧表：默认 0（非 const 声明）
    append(g_node_scope, -1);          // S3 §0.13.9 node_scope 侧表：默认 -1（未归属任何作用域帧）
    append(g_node_span, Span{ line: 0, col: 0, end_col: 0 });   // S5 §4.8 node_span 侧表：默认零区间（与 ln/cl/tv 初始化 0 对齐）
    append(g_node_trivia, Trivia{ leading: [], trailing: [] });  // S5 §4.8 trivia 侧表：默认无间隙 trivia（assign_trivia 后填充）
    append(g_node_se, "");                                  // S4 §0.14.6 SoA：se（C ABI 导出符号名）侧表默认空
    append(g_node_has_sa, 1);                               // S4 §0.14.7 SoA：has_sa 默认 **true**（等价旧 `n.has_sa = true`）
    append(g_node_has_sb, 1);                               // S4 §0.14.7 SoA：has_sb 默认 true
    append(g_node_has_sc, 1);                               // S4 §0.14.7 SoA：has_sc 默认 true
    append(g_node_be, 0);                                   // S4 §0.14.7 SoA：be 默认 **false**（等价旧 `n.be = false`）
    append(g_node_bf, 0);                                   // S4 §0.14.7 SoA：bf 默认 false
    append(g_node_memspace, 0);                             // S4 §0.14.7 SoA：memspace 默认 0（host，等价旧 `n.memspace = 0`）
    append(g_node_bd, 0);                                   // S4 §0.14.7 SoA：bd 默认 false
    append(g_node_bb, 0);                                   // S4 §0.14.7 SoA：bb 默认 false
    append(g_node_bc, 0);                                   // S4 §0.14.7 SoA：bc 默认 false（非 pub）
    append(g_node_nd, -1);                                  // S4 §0.14.7 SoA：nd 默认 -1（无子节点）
    append(g_node_ib, -1);                                  // S4 §0.14.7 SoA：ib 默认 -1（无标记）
    append(g_node_sc, "");                                  // S4 §0.14.7 SoA：sc 默认空串（第六批）
    append(g_node_nc, -1);                                  // S4 §0.14.7 SoA：nc 默认 -1（无子节点；第九批）
    append(g_node_ba, 0);                                   // S4 §0.14.7 SoA：ba 默认 false（第十批）
    append(g_node_lc, -1);                                  // S4 §0.14.7 SoA：lc 默认 -1（空 kids 链；第十一批）
    var nref_tag: i64 = nk_of_kind(kind);
    if (nref_tag < 0) { nref_tag = 0; }   // 未注册 kind 暂归 tag=0（g_node_nref 当前无消费方，安全）
    append(g_node_nref, mk_noderef(nref_tag, (slice_len(nodes) as i64) - 1));   // S4：打包 tag|idx 存入侧表（供未来消费方）
    // 注意：此处返回的是**裸索引**（仅静态类型提升为 u64），而非打包后的 NodeRef。
    // 既有代码在 mk_* 体内/调用点大量以 `nodes[nid]` / `slice_set(nodes, nid, ...)` 直接把返回值当
    // 数组下标使用；t 的 u64→i64 收窄在下标处**不会**解包 tag，若返回打包值会越界。tag 仅存于
    // g_node_nref 侧表，访问器经 nr_idx(nid) 取裸索引，与此处返回裸索引逐位一致。
    return (slice_len(nodes) as i64) - 1;
}

// 给节点打 anchor token（诊断定位用），tok 索引 → line/col/text
// S5 step3：ln/cl/tv 字段已删除，此处只写 node_span 侧表（g_node_span[idx]），
// 与 node_new 的零区间 append 对齐；读方经 node_span_id(X.id) 取，诊断行号与删字段前逐字节一致。
pub fn node_at(ni: i64, ti: i64) void {
    var tk: Tok = toks[ti];
    node_set_span((ni as u64), Span{ line: (tk.line as u64), col: (tk.col as u64), end_col: (tk.col as u64) + str_len(tk.v) });
}

// S5 §4.8：读方访问节点间隙 trivia（leading/trailing 的 g_trivia_toks 下标列表）
pub fn node_trivia(n: u64) Trivia {
    var id = nr_idx(n);
    if (id < 0 || id >= slice_len(g_node_trivia)) { var z: Trivia; return z; }
    return g_node_trivia[id];
}

// S5 §4.8：把 g_trivia_toks（按源序）分配到各节点的 leading/trailing 间隙。
// 规则（Roslyn 式，逐 token 独立归属）：找 prev = 位置严格 < T 的最后一节点，
// next = 位置严格 > T 的首节点。若 T 与 prev 同 line（无换行分隔）→ trailing of prev；
// 否则（跨 line，换行分隔）→ leading of next。文件前导 trivia（无 prev）归首节点 leading，
// 文件尾部 trivia（无 next）归末节点 trailing。仅源码锚定节点（span.line>0）参与；
// 合成节点（span 0,0,0）跳过，避免抢走前导 trivia。多行锚定节点以「起始 line」近似。
// 纯工具函数，编译发射路径不调用；仅 dump-ast / S8 fmt 驱动。
pub fn assign_trivia() void {
    var nn = slice_len(nodes);
    if (nn == 0) { return; }
    // 仅纳入源码锚定节点
    var order: []i64 = [];
    var ki: i64 = 0;
    while (ki < nn) {
        if (g_node_span[ki].line > 0) { append(order, ki); }
        ki = ki + 1;
    }
    // 插入排序 by (line, col)
    var mi: i64 = 0;
    while (mi < slice_len(order)) {
        var p = mi;
        while (p > 0) {
            var a = order[p - 1]; var b = order[p];
            var sa = g_node_span[a]; var sb = g_node_span[b];
            var swap = false;
            if (sa.line > sb.line) { swap = true; }
            else if (sa.line == sb.line && sa.col > sb.col) { swap = true; }
            if (swap == false) { break; }
            order[p - 1] = b; order[p] = a;
            p = p - 1;
        }
        mi = mi + 1;
    }
    // 逐 trivia token 独立归属（g_trivia_toks 已按源序，直接索引 tk，无需再排序）。
    // 归属规则（Roslyn 式）：prev = 位置严格 < T 的最后一节点，next = 位置严格 > T 的首节点；
    // T 与 prev 同 line（无换行分隔）→ trailing of prev，否则（跨 line）→ leading of next。
    // 写回用「复制进全新本地数组再赋回」模式，规避 t 空切片共享 backing 的别名陷阱。
    var no = slice_len(order);
    var nt = slice_len(g_trivia_toks);
    var tk: i64 = 0;
    while (tk < nt) {
        var T = g_trivia_toks[tk];
        var pi: i64 = 0;
        while (pi < no) {
            var Ppos = g_node_span[order[pi]];
            if (Ppos.line < T.line) { pi = pi + 1; continue; }
            if (Ppos.line == T.line && Ppos.col < T.col) { pi = pi + 1; continue; }
            break;
        }
        var prev: i64 = -1;   // 必须为 i64：t 会把裸 `-1` 推断成 u8(=255)，slice 下标又符号扩展成 -1，导致 g_node_span[-1] 越界崩溃
        if (pi > 0) { prev = order[pi - 1]; }
        var next: i64 = -1;
        if (pi < no) { next = order[pi]; }
        var attach_lead = false;
        if (prev >= 0 && next >= 0) {
            if (T.line == g_node_span[prev].line) { attach_lead = false; }   // 同 line（无换行）→ trailing of prev
            else { attach_lead = true; }                                    // 跨 line（换行分隔）→ leading of next
        } else if (prev >= 0) {
            attach_lead = false;   // 仅 prev（文件尾部 trivia）→ trailing of prev
        } else if (next >= 0) {
            attach_lead = true;    // 仅 next（文件前导 trivia）→ leading of next
        }
        if (attach_lead && next >= 0) {
            var tr = g_node_trivia[next];
            var ld: []u64 = [];
            var c: i64 = 0;
            while (c < slice_len(tr.leading)) { append(ld, tr.leading[c]); c = c + 1; }
            append(ld, tk);
            tr.leading = ld;
            slice_set(g_node_trivia, next, tr);
        } else if (prev >= 0) {
            var tr = g_node_trivia[prev];
            var tl: []u64 = [];
            var c: i64 = 0;
            while (c < slice_len(tr.trailing)) { append(tl, tr.trailing[c]); c = c + 1; }
            append(tl, tk);
            tr.trailing = tl;
            slice_set(g_node_trivia, prev, tr);
        }
        tk = tk + 1;
    }
}

// ── 节点种类注册表（来自 reference.md §2.9 NodeTable）──
// S1：已迁入库模块 std.rc.cst 的 GEN:kinds 区间（g_nkn_count / node_kind_names /
// init_node_kinds / is_node_kind / NK_* 枚举 / nk_name / nk_of_kind），
// 由文件头 `pub @import("std.rc.cst" :: *)` 重导出，引用点零改动。
// ⚠ 注册表从 86 项扩到 105 项：普查发现原表**漏了 19 个真实 kind**（ClauseDead /
// block_expr / import_expr / variant_lit / deserialize …），见 tools/cst_kinds.json。
//   扩容是安全的：is_node_kind 当前**零消费点**（仅 tc.tc:104 调一次空的 init）。

// ── 节点构造器（槽参数按 Node 字段序，末位 ti；ti < 0 表示不打 anchor）──

pub fn mk_A(sa: string, la: i64, ti: i64) u64 {
    var id: i64 = node_new("A");
    var n: Node = nodes[id];
    n.sa = sa;
    n.la = la;
    slice_set(nodes, id, n);
    if (ti >= 0) { node_at(id, ti); }
        cst_register_RecA(sa, la); // S2 dual-write
    return id;
}

