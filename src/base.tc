fn i2s(v: i64) string {
    var sb: StringBuilder = sb_new();
    sb_append_i64(sb, v);
    return sb_to_str(sb);
}

// ── 命名规范校验（复刻 parser.ts validate*Name）───────────────

fn is_lower_snake(name: string) bool {
    var n: u64 = str_len(name);
    if (n == 0) {
        return false;
    }
    var c0: u8 = name[0];
    if (c0 < 97 || c0 > 122) {
        return false;
    }
    var i: u64 = 1;
    while (i < n) {
        var c: u8 = name[i];
        var ok: bool = (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95;
        if (ok == false) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn is_upper_snake_name(name: string) bool {
    var n: u64 = str_len(name);
    if (n == 0) {
        return false;
    }
    var c0: u8 = name[0];
    if (c0 < 65 || c0 > 90) {
        return false;
    }
    var i: u64 = 1;
    while (i < n) {
        var c: u8 = name[i];
        var ok: bool = (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95;
        if (ok == false) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn is_pascal_rest_ok(name: string) bool {
    var n: u64 = str_len(name);
    var i: u64 = 1;
    while (i < n) {
        var c: u8 = name[i];
        var ok: bool = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95;
        if (ok == false) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// 以 token 下标 ti 处的 line/col 报命名告警
fn warn_name(code: string, msg: string, ti: i64, name_len: i64) void {
    var tk: Tok = toks[ti];
    var l: i64 = tk.line as i64;
    var c: i64 = tk.col as i64;
    diag_new(code, "warning", msg, g_file, l, c, l, c + name_len);
}

// C 后端把 t 标识符**原样**发射成 C 标识符，撞上 C 关键字会产出无法编译的 .c
// （LLVM 后端毫无察觉 ⇒ 静默的单后端坏码）。这里在解析期就报出来，两个后端都能看见。
// 只列「t 里合法、C 里保留」的名字：t 自己的关键字（if/while/struct/enum/return/bool/void…）
// 根本无法作标识符，无需重复。
fn is_c_keyword(name: string) bool {
    if (name == "unsigned" || name == "signed" || name == "static") { return true; }
    if (name == "const" || name == "volatile" || name == "register") { return true; }
    if (name == "extern" || name == "typedef" || name == "inline") { return true; }
    if (name == "restrict" || name == "auto" || name == "goto") { return true; }
    if (name == "switch" || name == "case" || name == "default" || name == "do") { return true; }
    if (name == "union" || name == "short" || name == "long") { return true; }
    if (name == "char" || name == "int" || name == "float" || name == "double") { return true; }
    if (name == "sizeof" || name == "NULL") { return true; }
    return false;
}

fn validate_c_keyword(name: string, ti: i64) void {
    if (is_c_keyword(name)) {
        warn_name("T-NAM-W404",
            sb_cat3("标识符 `", name, "` 与 C 关键字同名：C 后端会原样发射并导致 .c 无法编译，请改名"),
            ti, str_len(name) as i64);
    }
}

fn validate_decl_name(name: string, ti: i64) void {
    validate_c_keyword(name, ti);
    var n: u64 = str_len(name);
    if (n == 0) {
        return;
    }
    var c0: u8 = name[0];
    if (c0 >= 65 && c0 <= 90) {
        if (is_pascal_rest_ok(name) == false) {
            warn_name("T-NAM-W400", sb_cat3("type name '", name, "' should be PascalCase (e.g. EntityState)"), ti, n as i64);
        }
    }
}

fn validate_var_name(name: string, ti: i64) void {
    validate_c_keyword(name, ti);
    if (is_lower_snake(name) == false) {
        warn_name("T-NAM-W401", sb_cat3("variable name '", name, "' should be snake_case (e.g. entity_id)"), ti, str_len(name) as i64);
    }
}

fn validate_const_name(name: string, ti: i64) void {
    validate_c_keyword(name, ti);
    if (is_upper_snake_name(name) == false) {
        warn_name("T-NAM-W402", sb_cat3("constant name '", name, "' should be UPPER_SNAKE_CASE (e.g. MAX_RENDER_LAYER)"), ti, str_len(name) as i64);
    }
}

// ── 字符分类（照抄 lexer.tc）───────────────────────────────────

// >>> GEN:xid (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>

// XID_Start / XID_Continue 范围表（十进制 [lo,hi] 闭区间，来自 Unicode UCD）
var xid_start_lo: []i64;
var xid_start_hi: []i64;
var xid_cont_lo: []i64;
var xid_cont_hi: []i64;

fn utf8_w0(c0: u8) i64 {
    if (c0 < 128) { return 1; }
    if (c0 < 224) { return 2; }
    if (c0 < 240) { return 3; }
    return 4;
}

fn utf8_cp_at(src: string, i: i64, n: i64) i64 {
    var c0: u8 = src[i];
    if (c0 < 128) { return c0 as i64; }
    if (c0 < 224) {
        var cp: i64 = (c0 & 31) as i64;
        cp = (cp << 6) | (src[i + 1] & 63) as i64;
        return cp;
    }
    if (c0 < 240) {
        var cp: i64 = (c0 & 15) as i64;
        cp = (cp << 6) | (src[i + 1] & 63) as i64;
        cp = (cp << 6) | (src[i + 2] & 63) as i64;
        return cp;
    }
    var cp: i64 = (c0 & 7) as i64;
    cp = (cp << 6) | (src[i + 1] & 63) as i64;
    cp = (cp << 6) | (src[i + 2] & 63) as i64;
    cp = (cp << 6) | (src[i + 3] & 63) as i64;
    return cp;
}

fn cp_in_ranges(cp: i64, lo: []i64, hi: []i64) bool {
    var lo_i: i64 = 0;
    var hi_i: i64 = (slice_len(lo) as i64) - 1;
    while (lo_i <= hi_i) {
        var mid: i64 = (lo_i + hi_i) / 2;
        if (cp < lo[mid]) { hi_i = mid - 1; }
        else if (cp > hi[mid]) { lo_i = mid + 1; }
        else { return true; }
    }
    return false;
}

