// 设备指针类型：`dev_ptr[T]`(as=1) / `shared[T]`(as=3) / `local[T]`(as=5)。
// 复刻 mk_pointer，但携带地址空间，供 sema 透传到 TD.memspace、codegen_dev 生成
// `!llvm.ptr<as>`（见 docs/compiler/device-design.md §3.1 / §7）。host 普通 `*T` 仍走 mk_pointer(as=0)。
pub fn mk_dev_ptr(na: i64, aspace: i64, ti: i64) i64 {
    var id: i64 = node_new("pointer");
    var n: Node = nodes[id];
    n.na = na;
    n.memspace = aspace;
    slice_set(nodes, id, n);
    if (ti >= 0) { node_at(id, ti); }
    return id;
}

