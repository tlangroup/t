}

// 编译期闭包逃逸的「捕获子节点」（P5）：sa=环境字段名（emit 读作 env->field），
// na=已物化的编译期值（字面量 / 嵌套 closure_make）。emit 侧当作透明值包装：直接对 na 求值。
// 与 df5 的 closure_capval 同构——用 sa 保留「写哪个环境字段」，用 na 携带「编译期已知的值」，
// 使 closure_make 的既有发射逻辑无需改动即可处理「捕获量在编译期已落定」的情形。
pub fn mk_closure_capval(sa: string, na: i64, ti: i64) i64 {
    var id: i64 = node_new("closure_capval");
    var n: Node = nodes[id];
    n.sa = sa;
    n.na = na;
    slice_set(nodes, id, n);
    if (ti >= 0) { node_at(id, ti); }
    return id;
}

pub fn mk_GlobalConstDecl(sa: string, bb: bool, na: i64, nb: i64, la: i64, ti: i64) i64 {
    var id: i64 = node_new("GlobalConstDecl");
    var n: Node = nodes[id];
    n.sa = sa;
    n.bb = bb;
    n.na = na;
