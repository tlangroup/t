// ═══════════════════════════════════════════════════════════════
// src/base.tc — 第 0 层：编译器公共基础设施
//
// 内容：token 池与扁平 Node 池、源文件/位置信息、诊断（错误码 + 收集器）、
//       字符串 / 切片 / XID 表等纯工具函数。
// 依赖：无（DAG 根）。其余所有模块 import 本模块。
//
// ── 编译器分层（import DAG，靠前者不得引用靠后者的符号）──────────
//   base → lex → parse → sema → codegen_c → codegen_ll → tc
// 校验：node tools/dagcheck.mjs 应报「0 处反向引用」。
// ═══════════════════════════════════════════════════════════════

// ⚠ GEN 区间冻结说明：本文件中所有 `// >>> GEN:xxx >>> … <<< GEN:xxx <<<` 区间
// 原由数据驱动生成器 `tools/totter.tc`（读取 out/ebnf.json）生成。
// totter 自 M38 起**已放弃（abandoned）**，不再运行、不再重跑，故这些区间现已冻结，
// 改为手写维护（如需改动，直接在 src/tc.tc 内编辑，不要等待 totter 重新生成）。
// out/ebnf.json 与 gen/tc.tc 同为冻结快照。

// ── token 池 ───────────────────────────────────────────────────

pub struct Tok {
    t: string;      // token 类型名（同 lex --json 的 type）
    v: string;      // 文本值
    line: u64;
    col: u64;
}

pub var toks: []Tok;

// >>> GEN:ast (generated by tools/totter.tc from out/ebnf.json nodes -- DO NOT EDIT) >>>
// ── AST 节点池（扁平化，索引引用）──────────────────────────────
// 约定：
//   na/nb/nc/nd : 子节点索引，-1 = null
//   la/lb/lc    : 子节点列表头（Child 池索引），-1 = 空列表，-2 = null 列表
//   sa/sb/sc    : 字符串载荷；has_sa=false 表示 sa 语义为 null
//   ia/ib       : 整型载荷（radix / bitWidth / offset），-1 = null
//   ba/bb       : 布尔载荷（isConst/isExtern/isComptime/isBitpack...）

pub struct Node {
    kind: string;
    sa: string;
    sb: string;
    sc: string;
    se: string;   // C 互操作导出：该声明导出的 C ABI 符号名（clean name；"" = 未导出）
    has_sa: bool;
    has_sb: bool;
    has_sc: bool;
    ia: i64;
    ib: i64;
    ba: bool;
    bb: bool;
    bc: bool;   // 模块系统：该声明是否被 `pub` 修饰（顶层可见性）
    bd: bool;   // 模块系统：该 import 是否走库搜索路径（true=lib/依赖库，false=src 源码根；见 parse_at_import_decl / handle_one_import）
    be: bool;   // C 互操作导出：该声明是否标记 `@c_export`（生成 C ABI 平铺入口）
    bf: bool;   // Device 子系统：该声明是否为 `kernel fn`（设备入口；host 双后端跳过，codegen_dev 处理）
    na: i64;
    nb: i64;
    nc: i64;
    nd: i64;
    memspace: i64;  // Device 子系统：指针地址空间（0=host；1=global/dev_ptr；3=shared；5=local）。仅 pointer 类型节点使用
    la: i64;
    lb: i64;
    lc: i64;
    td: i64;    // HIR 类型槽：表达式节点的 TD 索引（sema 一次性填入；0 = 未定型）。v3 §2：消除 ll_etd/expr_type_desc 重推导的根因
    ln: u64;    // anchor token 行（诊断用；0 = 无）
    cl: u64;    // anchor token 列
    tv: string; // anchor token 文本（endCol = col + len(tv)）
}

pub var nodes: []Node;

// ── 命名空间隔离（外部库真正落地）──────────────────────────────
// provenance：每个 AST 节点记录它是在哪个模块（别名）里被解析出来的。
// 入口（main）模块别名 = ""，不参与名字重整（mangling）。
pub var g_cur_mod: string;              // 解析期当前模块别名（load_module_file 内设置）
pub var g_node_mod: []string;           // 与 nodes 平行的数组：nodes[i] 所属模块别名（"" = 入口）
pub var g_node_file: []string;          // 与 nodes 平行的数组：nodes[i] 所属源文件（多模块编译单元下诊断定位用）

pub struct Child {
    val: i64;
    next: i64;
}

pub var kids: []Child;

// ident 节点 → 其解析到的声明节点（支持同作用域重名 shadowing：后端按声明唯一命名）。
// sema 解析标识符时写入；后端发射标识符时反查，得到正确的（被 shadow 的）声明。
pub var g_idecl_n: []i64;
pub var g_idecl_d: []i64;
pub fn idecl_set(idn: i64, decl: i64) void {
    // last-write-wins：同标识符节点在语义分析期可能被多次访问（不同作用域），
    // 须以「最后/最内层作用域」的解析为准——那才是 shadowing 下实际生效的声明。
    // 首次写入版的 bug：节点若在「重声明之前的作用域」被首次访问就定死成旧声明，
    // 导致循环体等位置的引用错误指向未唯一化的旧声明（tc.c 报 undeclared identifier）。
    var n: i64 = slice_len(g_idecl_n) as i64;
    var i: i64 = n - 1;
    while (i >= 0) {
        if (g_idecl_n[i] == idn) { g_idecl_d[i] = decl; return; }
        i = i - 1;
    }
    append(g_idecl_n, idn);
    append(g_idecl_d, decl);
}
pub fn idecl_get(idn: i64) i64 {
    var n: i64 = slice_len(g_idecl_n) as i64;
    var i: i64 = n - 1;
    while (i >= 0) {
        if (g_idecl_n[i] == idn) { return g_idecl_d[i]; }
        i = i - 1;
    }
    return -1;
}

// 后端：同函数内重名局部变量唯一化命名（shadowing 支持）。
//
// 设计（扁平 g_seen + 帧边界哨兵，append-only，绝不 slice_sub 全局切片）：
//   g_seen       扁平 []string，按发射顺序记录所有 name-key（func::name）与帧哨兵。
//               flat append 与原扁平实现同构、经长期验证安全（全局切片头就地更新）。
//   G_SEEN_FRAME 帧边界哨兵串（含 @，绝不可能等于任何 "func::name" 真 key）。
//               g_seen_push 进块时 append 一枚；g_seen_pop 为**空操作**（不截断，
//               见下方 -O2 红线说明）—— 帧隔离完全靠「反向搜索遇哨兵即停」。
//   g_seen_has   **只搜索当前（最深的）那一帧**：从末尾反向扫描，遇到哨兵即停（返回
//               false），否则命中 key 才算 true。
//
// 正确性：C 的块作用域天然隔离「兄弟块」与「嵌套块」里的同名局部，二者都无需 mangle；
// 真正会撞名的是「同一 C 作用域内重复声明」，而 sema 已禁止同作用域重声明。
// 故 g_seen_has 在当前帧内永远搜不到重复 key（当前帧内名字本就唯一）→ mangle 恒为一致的
// 空操作，声明端与引用端（经 idecl 反查 + g_local_has）永远自洽。这从根上消除了此前
// 扁平 g_seen 把独立块内同名局部误 mangle（声明 name__<sid> 而引用端仍 name）的 bug。
//
// ⚠ -O2 红线（踩过两次）：
//   ① 曾用 [][]string 作用域栈，g_seen_add 对「切片元素索引」g_seen[n-1] 做 append 在 t 里
//     是按值拷贝、非可变左值；-O2 编译后端自身时在帧内 realloc 路径误编译 → 0xC0000005。
//   ② 曾用扁平 + g_seen_marks（[]i64 存每帧起始下标），g_seen_pop 用
//     `g_seen_marks = slice_sub(g_seen_marks, 0, m-1)` 把全局切片**重赋值成自身的子视图**
//     （自别名）→ -O2 优化器对自别名全局切片生成错误代码 → 0xC0000005。
//   现改为 append-only + 哨兵 + 空操作 pop，**彻底规避任何对全局切片的 slice_sub/元素级写**，
//   所有写都是已验证安全的 flat append；g_seen_has 反向扫描成本 = 当前块嵌套深度（遇哨兵即停）。
pub var g_seen: []string;
pub var g_local_decls: []i64;
pub const G_SEEN_FRAME: string = "@frame@";
pub fn g_seen_push() void {
    append(g_seen, G_SEEN_FRAME);
}
pub fn g_seen_pop() void {
    // 空操作：不截断 g_seen（截断需 slice_sub 全局切片 → 自别名 -O2 误编译）。
    // 帧隔离由 g_seen_has 反向扫描遇哨兵即停保证；g_seen 只增不减（单次编译内规模有界）。
}
pub fn g_seen_has(key: string) bool {
    var n: i64 = slice_len(g_seen) as i64;
    var i: i64 = n - 1;
    while (i >= 0) {
        if (g_seen[i] == G_SEEN_FRAME) { return false; } // 越过当前帧边界
        if (g_seen[i] == key) { return true; }
        i = i - 1;
    }
    return false;
}
pub fn g_seen_add(key: string) void {
    append(g_seen, key);
}
pub fn g_local_has(dcl: i64) bool {
    var n: i64 = slice_len(g_local_decls) as i64;
    var i: i64 = n - 1;
    while (i >= 0) {
        if (g_local_decls[i] == dcl) { return true; }
        i = i - 1;
    }
    return false;
}

// conpat 载荷绑定（match 构造器模式解构出的 `x`）由后端发射期现场合成 var_decl。
// 它们身处 match 各臂的**独立代码块**（不同 if 分支），C/LLVM 块作用域天然隔离，
// 名字不会冲突 —— 故禁止对其做唯一化重整（否则合成的声明节点与标识符反查的声明
// 节点不一致，导致「绑定存到 x__N、读取却是裸 x」的静默错编：见 adt_list / adt_status）。
pub var g_conpat_binds: []i64;
pub fn g_conpat_bind_has(d: i64) bool {
    var n: i64 = slice_len(g_conpat_binds) as i64;
    var i: i64 = n - 1;
    while (i >= 0) {
        if (g_conpat_binds[i] == d) { return true; }
        i = i - 1;
    }
    return false;
}

// const 声明节点 id 集合：解析期在 KwConst 处登记（区别于 let —— 二者 ba 均为 true，
// 但顶层 const/let 同为 GlobalConstDecl 且 bb 被 comptime 占用，无法靠字段区分）。
// 用于 sema 实施「const 只可引用静态常量」规则（见 sema.tc check_const_ref）。
pub var g_const_decl_ids: []i64;
pub fn g_const_decl_has(d: i64) bool {
    var n: i64 = slice_len(g_const_decl_ids) as i64;
    var i: i64 = n - 1;
    while (i >= 0) {
        if (g_const_decl_ids[i] == d) { return true; }
        i = i - 1;
    }
    return false;
}

// 新建节点：全部字段置于"空"语义，返回索引
pub fn node_new(kind: string) i64 {
    var n: Node;
    n.kind = kind;
    n.sa = "";
    n.sb = "";
    n.sc = "";
    n.se = "";
    n.has_sa = true;
    n.has_sb = true;
    n.has_sc = true;
    n.ia = -1;
    n.ib = -1;
    n.ba = false;
    n.bb = false;
    n.bc = false;
    n.bd = false;
    n.be = false;
    n.bf = false;
    n.na = -1;
    n.nb = -1;
    n.nc = -1;
    n.nd = -1;
    n.memspace = 0;
    n.la = -1;
    n.lb = -1;
    n.lc = -1;
    n.ln = 0;
    n.cl = 0;
    n.tv = "";
    n.td = 0;    // HIR 类型槽：默认未定型，sema 在类型检查期写入
    append(nodes, n);
    append(g_node_mod, g_cur_mod);   // provenance：记录本节点所属模块别名（"" = 入口）
    append(g_node_file, g_file);      // provenance：记录本节点所属源文件（load_module_file 内 g_file 已切到该模块文件）
    return (slice_len(nodes) as i64) - 1;
}

// 给节点打 anchor token（诊断定位用），tok 索引 → line/col/text
pub fn node_at(ni: i64, ti: i64) void {
    var tk: Tok = toks[ti];
    var n: Node = nodes[ni];
    n.ln = tk.line;
    n.cl = tk.col;
    n.tv = tk.v;
    slice_set(nodes, ni, n);
}

// ── 节点种类注册表（来自 reference.md §2.9 NodeTable）──
pub var g_nkn_count: i64 = 86;
pub var node_kind_names: [86]string = ["A", "CS", "EN", "EnumDecl", "F", "FV", "FlagDecl", "FlagSetDecl", "FuncDecl", "func_type", "lambda", "closure_make", "closure_capture", "GlobalConstDecl", "GlobalVarDecl", "ImportDecl", "ImportModDecl", "ModuleDecl", "M", "P", "SL", "StructDecl", "TypeAliasDecl", "UnionDecl", "V", "VC", "VariantDecl", "arm", "array", "array_lit", "assign", "assignment", "binary", "block", "bool", "break", "call", "cast", "comptime", "comptime_block", "continue", "defer", "expr", "flag", "flag_set", "float", "for", "for_each", "ident", "if", "index", "int", "list", "map", "map_lit", "mbuiltin", "match", "member", "named", "null", "number", "optional", "opt_none", "paren", "pipe_apply", "pipe_filter", "pipe_map", "pointer", "amp", "deref", "range", "return", "scalar", "slice", "string", "atom", "fidconst", "serialize", "struct_lit", "unary", "var_decl", "variant", "vector", "tile", "vval", "while"];

pub fn init_node_kinds() void {
    // 静态定长数组 [N]string 已编译期初始化（见 g_nkn_count），无需运行时 append 填充。

}

pub fn is_node_kind(k: string) bool {
    var i: i64 = 0;
    while (i < g_nkn_count) {
        if (node_kind_names[i] == k) { return true; }
        i = i + 1;
    }
    return false;
}

// ── 节点构造器（槽参数按 Node 字段序，末位 ti；ti < 0 表示不打 anchor）──

pub fn mk_A(sa: string, la: i64, ti: i64) i64 {
    var id: i64 = node_new("A");
    var n: Node = nodes[id];
    n.sa = sa;
    n.la = la;
    slice_set(nodes, id, n);
    if (ti >= 0) { node_at(id, ti); }
    return id;
}

pub fn mk_EN(na: i64, nb: i64, ti: i64) i64 {
    var id: i64 = node_new("EN");
    var n: Node = nodes[id];
    n.na = na;
    n.nb = nb;
    slice_set(nodes, id, n);
    if (ti >= 0) { node_at(id, ti); }
    return id;
}

