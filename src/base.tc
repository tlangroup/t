    return id;
}

fn mk_variant(ti: i64) i64 {
    var id: i64 = node_new("variant");
    if (ti >= 0) { node_at(id, ti); }
    return id;
}

fn mk_while(na: i64, la: i64, ti: i64) i64 {
    var id: i64 = node_new("while");
    var n: Node = nodes[id];
    n.na = na;
    n.la = la;
    slice_set(nodes, id, n);
    if (ti >= 0) { node_at(id, ti); }
    return id;
}
// <<< GEN:ast <<<

// 选择性导入项 `import(p :: a, b as c, *)` 的单项节点（GEN 区之外，手写）：
//   sa = 模块中的原名（通配为 "*"），sb = 导入方本地名，ba = 是否通配 `*`。
// 该节点只挂在 ImportModDecl.lb 链上，永不进 decl_list，也不参与任何发射。
fn mk_ImportItem(sa: string, sb: string, wild: bool, ti: i64) i64 {
    var id: i64 = node_new("ImportItem");
    var n: Node = nodes[id];
    n.sa = sa;
    n.sb = sb;
    n.ba = wild;
    slice_set(nodes, id, n);
    if (ti >= 0) { node_at(id, ti); }
    return id;
}

// variant 构造器模式 `Circle(r)` / `Shape.Circle(r)` / `Empty`（ADT，GEN 区之外，手写）：
//   sa = case 名（`Circle`），sb = 限定符（写了 `Shape.Circle` 则为 `Shape`，裸名为 ""），
//   la = 子模式链（每项为 ident 绑定 / `_` 通配 / 嵌套 conpat），-1 = 无括号（单元 case），
//   ia = sema 决议出的 case 下标（tag），ib = 子模式个数，
//   sc = sema 决议出的 variant 类型名（供后端拼 `<V>_is_<C>` / `<V>_as_<C>`）。
// 该节点只出现在 arm.na（模式位），由 match 脱糖消费，永不进 emit_expr。
fn mk_conpat(sa: string, sb: string, la: i64, ib: i64, ti: i64) i64 {
    var id: i64 = node_new("conpat");
    var n: Node = nodes[id];
    n.sa = sa;
    n.sb = sb;
    n.la = la;
    n.ib = ib;
    slice_set(nodes, id, n);
    if (ti >= 0) { node_at(id, ti); }
    return id;
}

// 列表构建：head/tail 由调用方持有；返回新 tail
fn list_push(head: i64, tail: i64, val: i64) i64 {
    var c: Child;
    c.val = val;
    c.next = -1;
    append(kids, c);
    var idx: i64 = (slice_len(kids) as i64) - 1;
    if (tail >= 0) {
        var prev: Child = kids[tail];
        prev.next = idx;
        slice_set(kids, tail, prev);
    }
    return idx;
}

// ── 诊断池（复刻 DiagnosticBag）────────────────────────────────
// vv/fs/nt: -1 = null；vv/nt 指向 sitems 链表头，fs 指向 fixes 链表头

struct Diag {
    code: string;
    sev: string;
    cat: string;
    name: string;
    legacy: string;
    note: string;
    msg: string;
    file: string;
    sl: i64;
    sc: i64;
    el: i64;
    ec: i64;
    vv: i64;
    fs: i64;
    nt: i64;
}

var diags: []Diag;

struct SI {
    s: string;
    next: i64;
}

var sitems: []SI;

struct FixS {
    desc: string;
    file: string;
    sl: i64;
    sc: i64;
    el: i64;
    ec: i64;
    repl: string;
    next: i64;
}

var fixes: []FixS;

var g_file: string;

// 诊断渲染格式：默认 "json"（机器可读，供 tote/CI/对拍解析）；
// REPL 通过 `--diagnostics human` 切换为人类可读文本（见 emit_diags）。
var g_diag_fmt: string = "json";

// 把绝对/相对路径折算为「相对工程根目录（cwd）」的形式：
// src/main.tc 而非 c:/workspace/tlang/src/main.tc。仅用于诊断信息的 file 字段，
// 不影响模块解析（compute_*_dirs 内部仍对 g_file 做 path_resolve 取绝对目录）。
// 分隔符统一规整为 '/'，保证跨平台输出一致（Windows 上 path_resolve 可能给反斜杠）。
fn rel_path(p: string) string {
    var abs: string = norm_sep(path_resolve(p));
    var base: string = norm_sep(path_resolve("."));
    // 去尾斜杠，避免 base 带尾斜杠时前缀匹配失败
    var blen: u64 = str_len(base);
    while (blen > 0) {
        if (str_at(base, blen - 1) == 47) { blen = blen - 1; } else { break; }
    }
    base = str_slice(base, 0, blen);
    var alen: u64 = str_len(abs);
    if (alen > blen && str_slice(abs, 0, blen) == base) {
        if (str_at(abs, blen) == 47) {
            return str_slice(abs, blen + 1, alen);
        }
    }
    // 不在 cwd 下（如外部绝对路径）保持原样（同样规整分隔符）
    return norm_sep(p);
}

// 分隔符规整：反斜杠 -> 正斜杠（供 rel_path 前缀匹配与输出统一使用）。
fn norm_sep(s: string) string {
    var n: u64 = str_len(s);
    var i: u64 = 0;
    var out: StringBuilder = sb_new();
    while (i < n) {
        var c: i64 = str_at(s, i);
        if (c == 92) { sb_append_char(out, 47); } else { sb_append_char(out, c); }
        i = i + 1;
    }
    return sb_to_str(out);
}
























