    var sb: StringBuilder = sb_new();
    sb_append_str(sb, a);
    sb_append_str(sb, b);
    sb_append_str(sb, c);
    sb_append_str(sb, d);
    return sb_to_str(sb);
}

sb_cat5 fn(a: string, b: string, c: string, d: string, e: string) string {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, a);
    sb_append_str(sb, b);
    sb_append_str(sb, c);
    sb_append_str(sb, d);
    sb_append_str(sb, e);
    return sb_to_str(sb);
}

sb_cat6 fn(a: string, b: string, c: string, d: string, e: string, f: string) string {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, a);
    sb_append_str(sb, b);
