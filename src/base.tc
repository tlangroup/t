// 闭包字面量（M46）：na=返回类型节点, lb=参数 P 链, lc=body 语句链；
// sa=合成函数名(脱糖回填), la=捕获 ident 链(检查期填充)。
pub fn mk_lambda(sa: string, na: i64, la: i64, lb: i64, lc: i64, ti: i64) i64 {
    var id: i64 = node_new("lambda");
    var n: Node = nodes[id];
