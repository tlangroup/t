// <<< GEN:node-structs <<<

// ── token 池 ───────────────────────────────────────────────────

pub struct Tok {
    t: string;      // token 类型名（同 lex --json 的 type）
    v: string;      // 文本值
    line: u64;
    col: u64;
}

pub var toks: []Tok;

// >>> GEN:ast (generated by tools/totter.tc from out/ebnf.json nodes -- DO NOT EDIT) >>>
// ── AST 节点池（扁平化，索引引用）──────────────────────────────
// 约定：
//   na/nb/nc/nd : 子节点索引，-1 = null
//   la/lb/lc    : 子节点列表头（Child 池索引），-1 = 空列表，-2 = null 列表
//   sa/sb/sc    : 字符串载荷；has_sa=false 表示 sa 语义为 null
//   ia/ib       : 整型载荷（radix / bitWidth / offset），-1 = null
//   ba/bb       : 布尔载荷（isConst/isExtern/isComptime/isBitpack...）

pub struct Node {
    kind: string;
    sa: string;
    sb: string;
    sc: string;
    se: string;   // C 互操作导出：该声明导出的 C ABI 符号名（clean name；"" = 未导出）
    has_sa: bool;
    has_sb: bool;
    has_sc: bool;
    ia: i64;
    ib: i64;
    ba: bool;
    bb: bool;
    bc: bool;   // 模块系统：该声明是否被 `pub` 修饰（顶层可见性）
    bd: bool;   // 模块系统：该 import 是否走库搜索路径（true=lib/依赖库，false=src 源码根；见 parse_at_import_decl / handle_one_import）
    be: bool;   // C 互操作导出：该声明是否标记 `@c_export`（生成 C ABI 平铺入口）
    bf: bool;   // Device 子系统：该声明是否为 `kernel fn`（设备入口；host 双后端跳过，codegen_dev 处理）
    na: i64;
    nb: i64;
    nc: i64;
    nd: i64;
    memspace: i64;  // Device 子系统：指针地址空间（0=host；1=global/dev_ptr；3=shared；5=local）。仅 pointer 类型节点使用
    la: i64;
    lb: i64;
    lc: i64;
    // S3（§4.5）：原 `td`（HIR 类型槽）已迁出为属性侧表 `g_node_td`，访问面走
    // `node_type()` / `node_set_type()`。语法树不再携带类型——跨切面属性改由侧表
    // 以节点 id 为键持有，降低 Node 布局与下游阶段的耦合（替换前：`td: i64`）。
    ln: u64;    // anchor token 行（诊断用；0 = 无）
    cl: u64;    // anchor token 列
    tv: string; // anchor token 文本（endCol = col + len(tv)）
}

pub var nodes: []Node;

// ── 命名空间隔离（外部库真正落地）──────────────────────────────
// provenance：每个 AST 节点记录它是在哪个模块（别名）里被解析出来的。
// 入口（main）模块别名 = ""，不参与名字重整（mangling）。
pub var g_cur_mod: string;              // 解析期当前模块别名（load_module_file 内设置）
pub var g_node_mod: []string;           // 与 nodes 平行的数组：nodes[i] 所属模块别名（"" = 入口）
pub var g_node_file: []string;          // 与 nodes 平行的数组：nodes[i] 所属源文件（多模块编译单元下诊断定位用）
pub var g_node_td: []i64;               // S3 §4.5 node_type 侧表：nodes[i] 的 HIR 类型槽 TD 索引（0 = 未定型；-1 = 已丢弃）
pub var g_node_resolve: []i64;          // S3 §4.5 node_resolve 侧表：ident 节点 i 解析到的声明节点（替代 g_idecl_* 反向扫描，O(1)）
pub var g_node_const: []i64;             // S3 §4.5 node_const 侧表：nodes[i] 是否为 const 声明（1 = 是；0 = 否；替代 g_const_decl_ids 列表 + 线性扫描）

// ── S3（§4.5）：侧表登记 + provenance 侧表读取面 ──────────────────────────────
// 跨切面属性统一登记 SideTable{name,owner,dirty}，PassManager 据 name 建拓扑与置脏。
// provenance（节点所属模块/文件）是第一个迁过来的跨切面属性：存储仍走上面两个全局平行
// 数组（与 nodes[] 按 id 对齐），读取面改经 node_mod()/node_file() 访问器，便于后续
// 在 S3 后续子步删除原始全局、统一为侧表实例。
pub struct SideTable {
    name: string;
    owner: string;
    dirty: bool;
}
pub var g_sidetables: []SideTable;
pub var g_st_inited: bool = false;
pub fn sidetable_register(name: string, owner: string) i64 {
    append(g_sidetables, SideTable{name: name, owner: owner, dirty: false});
    return slice_len(g_sidetables) - 1;
}
// 惰性登记全部内置侧表（幂等，首次访问任一访问器时触发）：
// PassManager 后续按 SideTable.name 建依赖拓扑与失效（§4.12 owns/requires）。
pub fn sidetable_init() void {
    if (g_st_inited) { return; }
    g_st_inited = true;
    sidetable_register("node_provenance", "S3");
    sidetable_register("node_type", "S3");
    sidetable_register("node_resolve", "S3");
    sidetable_register("node_const", "S3");
    sidetable_register("node_scope", "S3");
}
pub fn node_mod(id: i64) string {
    sidetable_init();
    if (id < 0 || id >= slice_len(g_node_mod)) { return ""; }
    return g_node_mod[id];
}
pub fn node_file(id: i64) string {
    if (id < 0 || id >= slice_len(g_node_file)) { return ""; }
    return g_node_file[id];
}

// ── node_type 侧表（§4.5）：取代已删除的 `Node.td` 字段 ──────────────────────
// 语义与原字段一致：0 = 未定型；> 0 = TD 索引（读取方仍须做上界检查）；
// -1 = 缓存被判定越界并丢弃（回落重推导）。此处为纯搬迁，不改变任何行为。
pub fn node_type(id: i64) i64 {
    sidetable_init();
    if (id < 0 || id >= slice_len(g_node_td)) { return 0; }
    return g_node_td[id];
}
pub fn node_set_type(id: i64, td: i64) void {
    if (id < 0 || id >= slice_len(g_node_td)) { return; }
    slice_set(g_node_td, id, td);
}

// ── node_resolve 侧表（§4.5）：取代 g_idecl_n/g_idecl_d 平行数组 + last-write-wins 反向扫描 ──
// ident 节点 i → 其解析到的声明节点。sema 解析标识符时写 node_set_resolve(i, decl)，
// 后端发射标识符时读 node_resolve(i) 反查（得到被 shadow 的正确声明）。
// 等价性：旧 idecl_set 的「反向扫描命中即更新」==「对 node_resolve[i] 直接 O(1) 覆盖写」——
// 同一 i 的多次写入最终值均为最后一次调用的值，故解析结果与旧实现逐字节一致（用户 IR 不变）。
pub fn node_resolve(id: i64) i64 {
    sidetable_init();
    if (id < 0 || id >= slice_len(g_node_resolve)) { return -1; }
    return g_node_resolve[id];
}
pub fn node_set_resolve(id: i64, decl: i64) void {
    if (id < 0 || id >= slice_len(g_node_resolve)) { return; }
    slice_set(g_node_resolve, id, decl);
}

// ── node_const 侧表（§4.5）：取代 g_const_decl_ids 平行数组 + 线性扫描 ──
// nodes[i] 是否为 const 声明（1 = 是；0 = 否）。parse 在 KwConst 处调 node_set_const(id) 登记；
// sema 经 node_const(id) != 0 判定「该声明是否 const」（实施 const 静态引用规则，见 sema.check_const_ref）。
// 等价性：旧 g_const_decl_ids 为「decl id 列表」，g_const_decl_has(d) 线性扫描判属；
// 新 g_node_const[d] 为 per-node 标志，node_set_const(d) 在原 4 个 append 点置 1，
// 二者成员集合逐字节一致 → 用户 IR 不变。
pub fn node_const(id: i64) i64 {
    sidetable_init();
    if (id < 0 || id >= slice_len(g_node_const)) { return 0; }
    return g_node_const[id];
}
pub fn node_set_const(id: i64) void {
    if (id < 0 || id >= slice_len(g_node_const)) { return; }
    slice_set(g_node_const, id, 1);
}

pub struct Child {
    val: i64;
    next: i64;
}

pub var kids: []Child;

// ident 节点 → 其解析到的声明节点（支持同作用域重名 shadowing：后端按声明唯一命名）。
// S3 §4.5：原 g_idecl_n/g_idecl_d 平行数组 + last-write-wins 反向扫描已迁为节点 id
// 键控的 node_resolve[] 侧表（见上方声明 + 上方 node_resolve()/node_set_resolve()）。
// 等价性：idecl_set 的「反向扫描命中即更新」等价于「对 node_resolve[id] 直接 O(1) 覆盖写」——
// 同一 id 的多次写入最终值均为最后一次调用的值，故解析结果与旧实现逐字节一致。
// sema 解析标识符时调 node_set_resolve(id, decl)；后端发射标识符时调 node_resolve(id) 反查。

// 后端：同函数内重名局部变量唯一化命名（shadowing 支持）。
//
// S3 node_scope（§0.13.9 修订版「工作 A」）：把原「扁平 g_seen + 哨兵 + 空操作 pop」
// 的帧机制重写成**作用域帧栈 + 节点侧表**，行为逐字节等价，但彻底规避旧实现的 -O2 自别名红线：
//   · 每进一个块 g_seen_push(owner) 建一帧：记本帧起始下标 g_frame_starts[sp] 与归属节点
//     g_frame_owners[sp]，并把 node_scope[owner]=帧 id 写入第 6 张 S3 侧表。
//   · g_seen_has(key) 只扫描当前帧 [g_frame_starts[sp-1], len(g_frame_keys)) —— 与旧
//     「反向扫遇哨兵即停」覆盖的当前帧 key 集合逐字节一致（兄弟块/嵌套块/不同函数各自独立帧）。
//   · g_frame_sp 为逻辑栈深；g_seen_pop 仅自减此标量 → 绝不对任何全局切片做 slice_sub /
//     元素级写，从根上消除 -O2 优化器对自别名全局切片生成的错误代码（历史 0xC0000005）。
//   · 发射期 mangle 决策仍走 g_frame 栈；node_scope 侧表仅供未来 IDE/增量消费，不改当前行为。
pub var g_frame_keys:   []string;   // 扁平串表：按发射序记录本帧 name-key（func::name）
pub var g_frame_starts: []i64;     // 每帧起始下标（并行于 g_frame_owners）
pub var g_frame_owners: []i64;     // 每帧归属节点 id（块节点）
pub var g_frame_sp:     i64 = 0;   // 逻辑栈深（pop 仅自减此标量）
pub var g_node_scope:   []i64;     // 与 nodes 平行：节点→所属 scope id（默认 -1）  ← S3 侧表
pub var g_local_decls:  []i64;     // 已唯一化重整的声明节点 id（mangle 结果记录）

pub fn node_scope(id: i64) i64 {
    if (id < 0 || id >= slice_len(g_node_scope)) { return -1; }
    return g_node_scope[id];
}
pub fn node_set_scope(id: i64, s: i64) void {
    if (id < 0 || id >= slice_len(g_node_scope)) { return; }
    slice_set(g_node_scope, id, s);
}

// g_seen_push(owner)：建新帧。owner = 进入的块节点（函数体/if/while/for/for_each/block/
// comptime_block/match-arm/defer 体）。每帧同时登记 node_scope[owner]=帧 id。
pub fn g_seen_push(owner: i64) void {
    append(g_frame_starts, slice_len(g_frame_keys));
    append(g_frame_owners, owner);
    var fid: i64 = slice_len(g_frame_starts) - 1;
    g_frame_sp = fid + 1;
    node_set_scope(owner, fid);
}
// g_seen_pop：空操作（不回退 g_frame_sp）。等价性关键：旧实现 g_seen_pop 也是空操作，
// 帧隔离靠 has 反向扫遇哨兵即停；此处「当前帧」由 g_frame_starts[g_frame_sp-1] 固定为
// **最近一次** push 的起始下标，与旧「从末尾扫到最近哨兵」逐字节等价。若在此回退 sp，会让
// 嵌套块之后的外层变量误看到块前的同级变量（旧哨兵本应屏蔽之），导致 mangle 漂移
// （实测 string_utils.tc::c 即因此产生非预期差异）。
pub fn g_seen_pop() void {
    // 空操作：不收缩 g_frame_sp（保持为 push 计数），与旧 g_seen 的空操作 pop 一致。
}
// g_seen_has(key)：仅扫当前帧。与旧「反向扫遇哨兵即停」等价（当前帧 key 集合一致）。
pub fn g_seen_has(key: string) bool {
    if (g_frame_sp <= 0) { return false; }
    var start: i64 = g_frame_starts[g_frame_sp - 1];
    var n: i64 = slice_len(g_frame_keys);
    var i: i64 = n - 1;
    while (i >= start) {
        if (g_frame_keys[i] == key) { return true; }
        i = i - 1;
    }
    return false;
}
pub fn g_seen_add(key: string) void {
    append(g_frame_keys, key);
}
pub fn g_local_has(dcl: i64) bool {
    var n: i64 = slice_len(g_local_decls) as i64;
    var i: i64 = n - 1;
    while (i >= 0) {
        if (g_local_decls[i] == dcl) { return true; }
        i = i - 1;
    }
    return false;
}

// conpat 载荷绑定（match 构造器模式解构出的 `x`）由后端发射期现场合成 var_decl。
// 它们身处 match 各臂的**独立代码块**（不同 if 分支），C/LLVM 块作用域天然隔离，
// 名字不会冲突 —— 故禁止对其做唯一化重整（否则合成的声明节点与标识符反查的声明
// 节点不一致，导致「绑定存到 x__N、读取却是裸 x」的静默错编：见 adt_list / adt_status）。
pub var g_conpat_binds: []i64;
pub fn g_conpat_bind_has(d: i64) bool {
    var n: i64 = slice_len(g_conpat_binds) as i64;
    var i: i64 = n - 1;
    while (i >= 0) {
        if (g_conpat_binds[i] == d) { return true; }
        i = i - 1;
    }
    return false;
}

// const 声明成员判定已迁 node_const[] 侧表（见上方 node_const()/node_set_const()）。
// 旧 g_const_decl_ids 平行数组 + g_const_decl_has 线性扫描已删除（§4.5 per-node 标志，O(1)）。

// 新建节点：全部字段置于"空"语义，返回索引
pub fn node_new(kind: string) i64 {
    var n: Node;
    n.kind = kind;
    n.sa = "";
    n.sb = "";
    n.sc = "";
    n.se = "";
    n.has_sa = true;
    n.has_sb = true;
    n.has_sc = true;
    n.ia = -1;
    n.ib = -1;
    n.ba = false;
    n.bb = false;
    n.bc = false;
    n.bd = false;
    n.be = false;
    n.bf = false;
    n.na = -1;
    n.nb = -1;
    n.nc = -1;
    n.nd = -1;
    n.memspace = 0;
    n.la = -1;
    n.lb = -1;
    n.lc = -1;
    n.ln = 0;
    n.cl = 0;
    n.tv = "";
    append(nodes, n);
    append(g_node_mod, g_cur_mod);   // provenance：记录本节点所属模块别名（"" = 入口）
    append(g_node_file, g_file);      // provenance：记录本节点所属源文件（load_module_file 内 g_file 已切到该模块文件）
    append(g_node_td, 0);             // S3 §4.5 node_type 侧表：默认未定型（0），由 sema/tir 经 node_set_type 写入
    append(g_node_resolve, -1);       // S3 §4.5 node_resolve 侧表：默认 -1（未解析到声明）
    append(g_node_const, 0);           // S3 §4.5 node_const 侧表：默认 0（非 const 声明）
    append(g_node_scope, -1);          // S3 §0.13.9 node_scope 侧表：默认 -1（未归属任何作用域帧）
    append(g_node_nref, 0);            // S2 双写：与 nodes[] 按 id 对齐的平行 NodeRef 数组（默认 0 = 未登记）
    return (slice_len(nodes) as i64) - 1;
}

// 给节点打 anchor token（诊断定位用），tok 索引 → line/col/text
pub fn node_at(ni: i64, ti: i64) void {
    var tk: Tok = toks[ti];
    var n: Node = nodes[ni];
    n.ln = tk.line;
    n.cl = tk.col;
    n.tv = tk.v;
    slice_set(nodes, ni, n);
}

// ── 节点种类注册表（来自 reference.md §2.9 NodeTable）──
// S1：已迁入库模块 std.rc.cst 的 GEN:kinds 区间（g_nkn_count / node_kind_names /
// init_node_kinds / is_node_kind / NK_* 枚举 / nk_name / nk_of_kind），
// 由文件头 `pub @import("std.rc.cst" :: *)` 重导出，引用点零改动。
// ⚠ 注册表从 86 项扩到 105 项：普查发现原表**漏了 19 个真实 kind**（ClauseDead /
// block_expr / import_expr / variant_lit / deserialize …），见 tools/cst_kinds.json。
//   扩容是安全的：is_node_kind 当前**零消费点**（仅 tc.tc:104 调一次空的 init）。

// ── 节点构造器（槽参数按 Node 字段序，末位 ti；ti < 0 表示不打 anchor）──

pub fn mk_A(sa: string, la: i64, ti: i64) i64 {
    var id: i64 = node_new("A");
    var n: Node = nodes[id];
    n.sa = sa;
    n.la = la;
    slice_set(nodes, id, n);
    if (ti >= 0) { node_at(id, ti); }
        cst_register_RecA(sa, la); // S2 dual-write
    return id;
}

