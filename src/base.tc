// 闭包字面量（M46）：na=返回类型节点, lb=参数 P 链, lc=body 语句链；
// sa=合成函数名(脱糖回填), la=捕获 ident 链(检查期填充)。
pub fn mk_lambda(sa: string, na: i64, la: i64, lb: i64, lc: i64, ti: i64) u64 {
    var id: i64 = node_new("lambda");
    var n: Node = nodes[id];
    n.sa = sa;
    n.na = na;
    n.la = la;
    n.lb = lb;
    node_set_lc((id as u64), lc);   // S4 §0.14.7 SoA：取代 `n.lc = lc`（形参保留，调用点不变；第十一批）
    slice_set(nodes, id, n);
    if (ti >= 0) { node_at(id, ti); }
        cst_register_RecLambda(sa, na, la, lb, lc); // S2 dual-write
    return id;
}

// `|v: T| expr` 简写闭包的「返回类型待推断」占位节点。resolve_ti 把它解析成
// 全局唯一的 g_infer_ti（kind="Infer"），sema 在用到该 lambda 时才扫描其 return
// 表达式推断真实返回类型（见 infer_lambda_ret_from_decl）。仅简写闭包会产此占位，
// 既有 `fn (v: T) R {...}` 一律带显式返回类型，不受影响。
pub fn mk_infer_ret() u64 {
    var id: i64 = node_new("infer_ret");
    slice_set(nodes, id, nodes[id]);
        cst_register_RecInferRet(); // S2 dual-write
    return id;

}

// 闭包构造点（M46）：sa=合成函数名, la=捕获 ident 链。emit 时堆分配记录+环境并返回指针。
pub fn mk_closure_make(sa: string, la: i64, ti: i64) u64 {
    var id: i64 = node_new("closure_make");
    var n: Node = nodes[id];
    n.sa = sa;
    n.la = la;
    slice_set(nodes, id, n);
    if (ti >= 0) { node_at(id, ti); }
        cst_register_RecClosureMake(sa, la); // S2 dual-write
    return id;
}

// 闭包 thunk 顶部重建捕获变量的语句（M46）：sa=捕获变量名, na=类型节点, ia=环境结构字段下标。
pub fn mk_closure_capture(sa: string, na: i64, ia: i64, ti: i64) u64 {
    var id: i64 = node_new("closure_capture");
    var n: Node = nodes[id];
    n.sa = sa;
    n.na = na;
    n.ia = ia;
    slice_set(nodes, id, n);
    if (ti >= 0) { node_at(id, ti); }
        cst_register_RecClosureCapture(sa, na, ia); // S2 dual-write
    return id;
}

// 编译期闭包逃逸的「捕获子节点」（P5）：sa=环境字段名（emit 读作 env->field），
// na=已物化的编译期值（字面量 / 嵌套 closure_make）。emit 侧当作透明值包装：直接对 na 求值。
// 与 df5 的 closure_capval 同构——用 sa 保留「写哪个环境字段」，用 na 携带「编译期已知的值」，
// 使 closure_make 的既有发射逻辑无需改动即可处理「捕获量在编译期已落定」的情形。
pub fn mk_closure_capval(sa: string, na: i64, ti: i64) u64 {
    var id: i64 = node_new("closure_capval");
    var n: Node = nodes[id];
    n.sa = sa;
    n.na = na;
    slice_set(nodes, id, n);
    if (ti >= 0) { node_at(id, ti); }
        cst_register_RecClosureCapval(sa, na); // S2 dual-write
    return id;
}

