// 闭包字面量（M46）：na=返回类型节点, lb=参数 P 链, lc=body 语句链；
// sa=合成函数名(脱糖回填), la=捕获 ident 链(检查期填充)。
mk_lambda fn(sa: string, na: i64, la: i64, lb: i64, lc: i64, ti: i64) i64 {
    var id: i64 = node_new("lambda");
    var n: Node = nodes[id];
    n.sa = sa;
    n.na = na;
    n.la = la;
    n.lb = lb;
    n.lc = lc;
    slice_set(nodes, id, n);
    if (ti >= 0) { node_at(id, ti); }
    return id;
}

// 闭包构造点（M46）：sa=合成函数名, la=捕获 ident 链。emit 时堆分配记录+环境并返回指针。
mk_closure_make fn(sa: string, la: i64, ti: i64) i64 {
    var id: i64 = node_new("closure_make");
    var n: Node = nodes[id];
    n.sa = sa;
    n.la = la;
    slice_set(nodes, id, n);
    if (ti >= 0) { node_at(id, ti); }
    return id;
}

// 闭包 thunk 顶部重建捕获变量的语句（M46）：sa=捕获变量名, na=类型节点, ia=环境结构字段下标。
