fn mk_FuncDecl(sa: string, ba: bool, bb: bool, na: i64, la: i64, lb: i64, lc: i64, ti: i64) i64 {
    var id: i64 = node_new("FuncDecl");
    var n: Node = nodes[id];
    n.sa = sa;
    n.ba = ba;
    n.bb = bb;
    n.na = na;
    n.la = la;
    n.lb = lb;
    n.lc = lc;
    slice_set(nodes, id, n);
    if (ti >= 0) { node_at(id, ti); }
