// 模块导入 `import xxx [as m]`（M-Module）：sb=模块名, sc=别名(可空), has_sc=有别名；
// bc=被 export 修饰（非法，check 期报 T_EXPORT_SCOPE）。
mk_ImportModDecl fn(sb: string, sc: string, has_sc: bool, is_lib_path: bool, la: i64, ti: i64) i64 {
    var id: i64 = node_new("ImportModDecl");
    var n: Node = nodes[id];
    n.sb = sb;
    n.sc = sc;
    n.has_sc = has_sc;
    n.bd = is_lib_path;   // true = 走库搜索路径（lib/依赖库），false = src 源码根
    n.la = la;
    slice_set(nodes, id, n);
    if (ti >= 0) { node_at(id, ti); }
    return id;
}

