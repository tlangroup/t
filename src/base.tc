// 区间的**成员测试**合成：`subj >= lo && subj < hi`（`..=` 用 `<=`）。
// 端点省略就少一个合取项；两端全省（`..`）恒真。
//
// ⚠ subj_a / subj_b 必须是两个**独立**的表达式节点：合成结果里 subject 出现两次，
//   后端按树发射会各求值一次。调用方要么传两个 mk_ident（match 已把被匹配值绑到
//   临时量，天然满足），要么先确认 subject 无副作用（sema 的 `in` 走 rng_pure 判定）。
//
// 放在 base 而不是 sema：`match` 的范围臂在 codegen 的 match_chain_from 里才合成
//   （C / LLVM 双后端共用同一份脱糖），那一层看不见 sema。
pub fn mk_range_test(subj_a: i64, subj_b: i64, r: i64) u64 {
    var rn: Node = nodes[r];
    var lo_t: i64 = -1;
    var hi_t: i64 = -1;
    if (rn.na >= 0) { lo_t = mk_binary(">=", subj_a, rn.na, -1); }
    if (rn.nb >= 0) {
        var hop: string = "<";
        if (node_ba((r as u64)) == true) { hop = "<="; }   // S4 §0.14.7 SoA：侧表读（原 rn.ba；rn = nodes[r]）
        hi_t = mk_binary(hop, subj_b, rn.nb, -1);
    }
    if (lo_t < 0) {
        if (hi_t < 0) { return mk_bool(true, -1); }
        return hi_t;
    }
    if (hi_t < 0) { return lo_t; }
    return mk_binary("&&", lo_t, hi_t, -1);
}

