    return id;
}

// 二维 SIMD 瓦片类型 `@Tile(rows, cols, T, flavor)`（GEN 区之外，手写）。
//   na = 元素类型节点，nb = rows 表达式节点，nc = cols 表达式节点，nd = flavor 表达式节点；
//   ia = resolve 期折叠出的行数，ib = 折叠出的列数，ic = 折叠出的 flavor 码（0=hardware, 1=simulate）。
//   发射期只读 ia/ib/ic，后端无需再求值。
pub fn mk_tile(na: i64, nb: i64, nc: i64, nd: i64, ti: i64) i64 {
    var id: i64 = node_new("tile");
    var n: Node = nodes[id];
    n.na = na;
    n.nb = nb;
    n.nc = nc;
    n.nd = nd;
    n.ia = -1;
    n.ib = -1;
    n.la = -1;
    slice_set(nodes, id, n);
    if (ti >= 0) { node_at(id, ti); }
        cst_register_RecTile(na, nb, nc, nd, -1, -1, -1); // S2 dual-write
    return id;
}

// 选择性导入项 `import(p :: a, b as c, *)` 的单项节点（GEN 区之外，手写）：
//   sa = 模块中的原名（通配为 "*"），sb = 导入方本地名，ba = 是否通配 `*`。
// 该节点只挂在 ImportModDecl.lb 链上，永不进 decl_list，也不参与任何发射。
pub fn mk_ImportItem(sa: string, sb: string, wild: bool, ti: i64) i64 {
    var id: i64 = node_new("ImportItem");
    var n: Node = nodes[id];
    n.sa = sa;
    n.sb = sb;
    n.ba = wild;
    slice_set(nodes, id, n);
    if (ti >= 0) { node_at(id, ti); }
        cst_register_RecImportItem(sa, sb, wild); // S2 dual-write
    return id;
}

// variant 构造器模式 `Circle(r)` / `Shape.Circle(r)` / `Empty`（ADT，GEN 区之外，手写）：
//   sa = case 名（`Circle`），sb = 限定符（写了 `Shape.Circle` 则为 `Shape`，裸名为 ""），
//   la = 子模式链（每项为 ident 绑定 / `_` 通配 / 嵌套 conpat），-1 = 无括号（单元 case），
//   ia = sema 决议出的 case 下标（tag），ib = 子模式个数，
//   sc = sema 决议出的 variant 类型名（供后端拼 `<V>_is_<C>` / `<V>_as_<C>`）。
// 该节点只出现在 arm.na（模式位），由 match 脱糖消费，永不进 emit_expr。
pub fn mk_conpat(sa: string, sb: string, la: i64, ib: i64, ti: i64) i64 {
    var id: i64 = node_new("conpat");
    var n: Node = nodes[id];
    n.sa = sa;
    n.sb = sb;
    n.la = la;
    n.ib = ib;
    slice_set(nodes, id, n);
    if (ti >= 0) { node_at(id, ti); }
        cst_register_RecConpat(sa, sb, la, ib); // S2 dual-write
    return id;
}

// 列表构建：head/tail 由调用方持有；返回新 tail
pub fn list_push(head: i64, tail: i64, val: i64) i64 {
    var c: Child;
    c.val = val;
    c.next = -1;
    append(kids, c);
    var idx: i64 = (slice_len(kids) as i64) - 1;
    if (tail >= 0) {
        var prev: Child = kids[tail];
        prev.next = idx;
        slice_set(kids, tail, prev);
    }
    return idx;
}

// 把 new_head 接到 tail 之后（用于把一组 or-模式臂并入 match 臂链表）
pub fn list_link(tail: i64, new_head: i64) void {
    if (tail >= 0 && new_head >= 0) {
        var prev: Child = kids[tail];
        prev.next = new_head;
        slice_set(kids, tail, prev);
    }
}

// 遍历链表取最后一个节点下标
pub fn list_last(head: i64) i64 {
    var cur: i64 = head;
    if (cur < 0) { return -1; }
    while (kids[cur].next >= 0) { cur = kids[cur].next; }
    return cur;
}

