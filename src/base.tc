pub fn utf8_w0(c0: u8) i64 {
    if (c0 < 128) { return 1; }
    if (c0 < 224) { return 2; }
    if (c0 < 240) { return 3; }
    return 4;
}

pub fn utf8_cp_at(src: string, i: i64, n: i64) i64 {
    var c0: u8 = src[i];
    if (c0 < 128) { return c0 as i64; }
    if (c0 < 224) {
        var cp: i64 = (c0 & 31) as i64;
        cp = (cp << 6) | (src[i + 1] & 63) as i64;
        return cp;
    }
    if (c0 < 240) {
        var cp: i64 = (c0 & 15) as i64;
        cp = (cp << 6) | (src[i + 1] & 63) as i64;
        cp = (cp << 6) | (src[i + 2] & 63) as i64;
        return cp;
    }
    var cp: i64 = (c0 & 7) as i64;
    cp = (cp << 6) | (src[i + 1] & 63) as i64;
    cp = (cp << 6) | (src[i + 2] & 63) as i64;
    cp = (cp << 6) | (src[i + 3] & 63) as i64;
    return cp;
}

pub fn is_xid_start(cp: i64) bool {
    var lo_i: i64 = 0;
    var hi_i: i64 = g_xid_start_count - 1;
    while (lo_i <= hi_i) {
        var mid: i64 = (lo_i + hi_i) / 2;
        if (cp < xid_start_lo[mid]) { hi_i = mid - 1; }
        else if (cp > xid_start_hi[mid]) { lo_i = mid + 1; }
        else { return true; }
    }
    return false;
}

pub fn is_xid_cont(cp: i64) bool {
    var lo_i: i64 = 0;
    var hi_i: i64 = g_xid_cont_count - 1;
    while (lo_i <= hi_i) {
        var mid: i64 = (lo_i + hi_i) / 2;
        if (cp < xid_cont_lo[mid]) { hi_i = mid - 1; }
        else if (cp > xid_cont_hi[mid]) { lo_i = mid + 1; }
        else { return true; }
    }
    return false;
}

pub fn cp_in_ranges(cp: i64, lo: []i64, hi: []i64) bool {
    var lo_i: i64 = 0;
    var hi_i: i64 = (slice_len(lo) as i64) - 1;
    while (lo_i <= hi_i) {
        var mid: i64 = (lo_i + hi_i) / 2;
        if (cp < lo[mid]) { hi_i = mid - 1; }
        else if (cp > hi[mid]) { lo_i = mid + 1; }
        else { return true; }
    }
    return false;
}

pub fn init_xid() void {
    // 静态定长数组 [N]i64 已编译期初始化（见 g_xid_start_count / g_xid_cont_count），无需运行时 append 填充。

}
// <<< GEN:xid <<<

pub fn is_digit(c: u8) bool {
    return c >= 48 && c <= 57;
}

// 标识符首字符：XID_Start + 下划线（向后兼容 ASCII 习惯）。


// ══════════════════════════════════════════════════════════════════
// 任意位宽整数类型名 `i<N>` / `u<N>`（N ∈ [2, 65535]）
//
// 既有的 i8/i16/i32/i64、u8/u16/u32/u64 是这套命名在 N = 8/16/32/64 上的实例，
// 表示与运算路径一律不变 —— 本设施只放宽「哪些 N 合法」。既有 8/16/32/64 的
// 分支全部保留在前，故对自举不动点是中立的。
//
// 为什么放在 base：词法（字面量后缀 `100u7`）与语法（类型位 `i7`）在模块 DAG
// 上都先于 sema，不能引用 sema 的 `get_bw`。与 `num_suffix_bits` 同层是唯一
// 不破坏 DAG 的位置。
// ══════════════════════════════════════════════════════════════════

pub fn awi_min_bits() i64 {
    return 2;
}

pub fn awi_max_bits() i64 {
    return 65535;
}

// 解析 `i<N>` / `u<N>` 的位宽 N；不是该形态、越界或有前导零一律返回 -1。
// 空串 / 单字符亦可安全调用。前导零被拒（`i07` 非法），否则同一个宽度会
// 有两个拼写，类型同一性判定将被绕过。
pub fn awi_bits(name: string) i64 {
    var n: u64 = str_len(name);
    if (n < 2) { return -1; }
    var c0: u8 = name[0];
    if (c0 != 105 && c0 != 117) { return -1; }        // 'i' / 'u'
    var acc: i64 = 0;
    var i: u64 = 1;
    while (i < n) {
        var c: u8 = name[i];
        if (c < 48 || c > 57) { return -1; }
        if (i == 1 && c == 48) { return -1; }         // '0' 前导零
        acc = acc * 10 + ((c as i64) - 48);
        if (acc > 65535) { return -1; }               // 早退，杜绝溢出
        i = i + 1;
    }
    if (acc < awi_min_bits()) { return -1; }
    if (acc > awi_max_bits()) { return -1; }
    return acc;
}

// 是否为合法的任意位宽整数类型名。
pub fn is_awi_name(name: string) bool {
    return awi_bits(name) > 0;
}

pub fn ll_bits(name: string) i64 {
    if (name == "i1") { return 1; }   // LLVM 1-bit 比较结果；须返回 1 而非 64 兜底，
                                      // 否则 tir_to_ll.tc 的 store 宽度换算门禁 ll_bits(dst)!=ll_bits(src)
                                      // 误判 i1 与 i64 等宽 → 跳过 i1→更宽整型的 zext → bool 比较结果存进 i64 槽
                                      // 只写 1 字节，高字节栈垃圾 → load i64 读回含垃圾 → 短路 &&/||、bool 变量赋值错判。
    if (name == "u8" || name == "i8" || name == "bool") { return 8; }
    if (name == "u16" || name == "i16") { return 16; }
    if (name == "u32" || name == "i32" || name == "rune" || name == "f32" || name == "float") { return 32; }
    if (name == "double") { return 64; }
    // 任意位宽整数 `i7` / `u200`：位宽即名字尾数，先于下方 64 兜底判定。
    var ab: i64 = awi_bits(name);
    if (ab > 0) { return ab; }
    return 64;
}


pub fn ll_signed(name: string) bool {
    if (str_len(name) == 0) {
        return false;
    }
    if (name == "rune") { return true; }
    return name[0] == 105 || name[0] == 102;
}

// ══════════════════════════════════════════════════════════════════
// 字面量支撑设施（reference.md §2.4）
//
// 转义解码在此处是**单一真相**：`src/lex.tc` 的字符串扫描与 `src/parse.tc`
// 的 f-string 模板拆解都必须调 `esc_decode`，两处不得各写一份 —— 旧实现正是
// 因为分头维护，才出现「f-string 的 `!a` 能产出 `\uXXXX`，词法却读不回来」
// 的 round-trip 断裂。
// ══════════════════════════════════════════════════════════════════

// 十六进制数字的值；非十六进制返回 -1。
pub fn hex_val(c: u8) i64 {
    if (c >= 48 && c <= 57) { return (c as i64) - 48; }
    if (c >= 97 && c <= 102) { return (c as i64) - 87; }
    if (c >= 65 && c <= 70) { return (c as i64) - 55; }
    return -1;
}

pub fn is_oct_digit(c: u8) bool {
    return c >= 48 && c <= 55;
}

// 按进制取数字位的值；不属于该进制返回 -1。
pub fn radix_digit_val(c: u8, radix: i64) i64 {
    if (radix == 16) { return hex_val(c); }
    if (radix == 2) {
        if (c == 48 || c == 49) { return (c as i64) - 48; }
        return -1;
    }
    if (radix == 8) {
        if (is_oct_digit(c)) { return (c as i64) - 48; }
        return -1;
    }
    if (c >= 48 && c <= 57) { return (c as i64) - 48; }
    return -1;
}

// 2^b（b <= 63）。仅供字面量范围自检使用。
pub fn lit_pow2(b: i64) u64 {
    var r: u64 = 1;
    var k: i64 = 0;
    while (k < b) {
        r = r * 2;
        k = k + 1;
    }
    return r;
}

// ASCII 单词字符（后缀候选串的字符集）。
pub fn is_ascii_word(c: u8) bool {
    if (c >= 48 && c <= 57) { return true; }
    if (c >= 97 && c <= 122) { return true; }
    if (c >= 65 && c <= 90) { return true; }
    return c == 95;
}

// 从**词法已规范化**的数字字面量文本中切出位宽后缀；无后缀返回 ""。
// token 文本形如 `200u8` / `1.5f32` / `0xFFu8` / `1.0e9`。
pub fn lit_suffix_of(v: string) string {
    var L: u64 = str_len(v);
    if (L == 0) { return ""; }
    var k: u64 = L;
    while (k > 0 && is_digit(v[k - 1])) { k = k - 1; }
    if (k == 0 || k == L) { return ""; }          // 全数字 / 末位非数字
    var lead: u8 = v[k - 1];
    if (lead != 117 && lead != 105 && lead != 102) { return ""; }
    var cand: string = str_slice(v, k - 1, L);
    if (num_suffix_bits(cand) < 0) { return ""; }
    // ⚠ 十六进制里的 `f` 是数字位不是后缀标记：`0x1f32` 必须整体当数值读。
    if (L >= 2 && v[0] == 48 && (v[1] == 120 || v[1] == 88)) {
        if (lead == 102) { return ""; }
    }
    return cand;
}

// 去掉位宽后缀后的数值主体。
pub fn lit_body_of(v: string) string {
    var sfx: string = lit_suffix_of(v);
    if (str_len(sfx) == 0) { return v; }
    return str_slice(v, 0, str_len(v) - str_len(sfx));
}

// 整数字面量折算时是否发生了 u64 溢出。`lit_val_u64` 每次调用都会先复位。
// （t 无 out 参数，故用模块级标志回传第二结果。）
pub var g_lit_overflow: bool = false;

// 把整数字面量主体（无后缀、无 `_`；可带 0x/0b/0o 前缀）折算成 u64。
// 溢出时置 g_lit_overflow 并返回已折算的低位值。
pub fn lit_val_u64(v: string) u64 {
    g_lit_overflow = false;
    var n: u64 = str_len(v);
    var radix: i64 = 10;
    var i: u64 = 0;
    if (n >= 2 && v[0] == 48) {
        var p: u8 = v[1];
        if (p == 120 || p == 88) { radix = 16; i = 2; }
        if (p == 98  || p == 66) { radix = 2;  i = 2; }
        if (p == 111 || p == 79) { radix = 8;  i = 2; }
    }
    var lim: u64 = 0xFFFFFFFFFFFFFFFF;
    var ru: u64 = radix as u64;
    var r: u64 = 0;
    while (i < n) {
        var d: i64 = radix_digit_val(v[i], radix);
        if (d < 0) { break; }
        var du: u64 = d as u64;
        if (r > (lim - du) / ru) {
            g_lit_overflow = true;
            return r;
        }
        r = r * ru + du;
        i = i + 1;
    }
    return r;
}

// 位宽后缀允许的**数值主体**上界。
//   uN → 2^N - 1
//   iN → 2^(N-1)   （取到上界仅在紧邻前置 `-` 时合法，见 reference.md §2.4）
pub fn lit_suffix_max(sfx: string) u64 {
    var b: i64 = num_suffix_bits(sfx);
    if (b < 0) { return 0xFFFFFFFFFFFFFFFF; }
    if (num_suffix_is_signed(sfx)) {
        if (b >= 64) { return 0x8000000000000000; }
        return lit_pow2(b - 1);
    }
    if (b >= 64) { return 0xFFFFFFFFFFFFFFFF; }
    return lit_pow2(b) - 1;
}

// 码点 → UTF-8 字节序列。调用方须已保证 cp 在 0..0x10FFFF 且不在代理区。
pub fn utf8_append_cp(out: StringBuilder, cp: i64) void {
    if (cp < 128) {
        sb_append_char(out, cp);
        return;
    }
    if (cp < 2048) {
        sb_append_char(out, 192 + (cp >> 6));
        sb_append_char(out, 128 + (cp & 63));
        return;
    }
    if (cp < 65536) {
        sb_append_char(out, 224 + (cp >> 12));
        sb_append_char(out, 128 + ((cp >> 6) & 63));
        sb_append_char(out, 128 + (cp & 63));
        return;
    }
    sb_append_char(out, 240 + (cp >> 18));
    sb_append_char(out, 128 + ((cp >> 12) & 63));
    sb_append_char(out, 128 + ((cp >> 6) & 63));
    sb_append_char(out, 128 + (cp & 63));
}

// 数字字面量的位宽后缀表。刻意不复用 sema 的 `get_bw`：词法在模块 DAG 上先于
// sema，跨层引用会成环。合法集与 §2.10 ScalarTable 的 int/float 类保持同步 ——
// 新增标量类型时这里与 ScalarTable 一起改。返回位宽；非法后缀返回 -1。
//
// 任意位宽整数后缀（`100u7` / `5i200`）走 `awi_bits`，与类型位 `u7` 共用
// 同一套解析，避免「类型位合法但字面量后缀不合法」的割裂。
pub fn num_suffix_bits(s: string) i64 {
    if (s == "u8" || s == "i8") { return 8; }
    if (s == "u16" || s == "i16") { return 16; }
    if (s == "u32" || s == "i32" || s == "f32") { return 32; }
    if (s == "u64" || s == "i64" || s == "f64") { return 64; }
    // ⚠ 刻意不补 `f16`：既有表里它本来就不合法，放开是独立的行为变更，
    // 会让 `1.0f16` 从「非法后缀」悄悄变成 f16 字面量。不属本次改动范围。
    return awi_bits(s);
}

pub fn num_suffix_is_float(s: string) bool {
    return s == "f32" || s == "f64";
}

pub fn num_suffix_is_signed(s: string) bool {
    if (str_len(s) == 0) { return false; }
    return s[0] == 105;                         // 'i'
}

// 解码 `\` 之后的一个转义序列。
//   s     源文本
//   i0    指向反斜杠**之后**的首字符（调用方已跳过 `\`）
//   out   解码结果追加处
//   dl/dc 诊断定位（反斜杠所在的行 / 列）
// 返回下一个未消费字符的下标。合法转义序列内部不含换行，故调用方可用
// `(ret - i0) + 1` 直接推进 col，无需重新扫行。
pub fn esc_decode(s: string, i0: u64, out: StringBuilder, dl: i64, dc: i64) u64 {
    var n: u64 = str_len(s);
    if (i0 >= n) { return i0; }
    var e: u8 = s[i0];
    if (e == 110) { sb_append_char(out, 10); return i0 + 1; }    // \n
    if (e == 116) { sb_append_char(out, 9);  return i0 + 1; }    // \t
    if (e == 114) { sb_append_char(out, 13); return i0 + 1; }    // \r
    if (e == 48)  { sb_append_char(out, 0);  return i0 + 1; }    // \0
    if (e == 34)  { sb_append_char(out, 34); return i0 + 1; }    // \"
    if (e == 39)  { sb_append_char(out, 39); return i0 + 1; }    // \'
    if (e == 92)  { sb_append_char(out, 92); return i0 + 1; }    // \\

    if (e == 120) {                                              // \xHH
        var h1: i64 = -1;
        var h2: i64 = -1;
        if (i0 + 1 < n) { h1 = hex_val(s[i0 + 1]); }
        if (i0 + 2 < n) { h2 = hex_val(s[i0 + 2]); }
        if (h1 < 0 || h2 < 0) {
            diag_new("T-LEX-E002", "error",
                "转义 `\\x` 后必须恰好跟两位十六进制数字（例：`\\x41`）",
                g_file, dl, dc, dl, dc + 4);
            sb_append_char(out, 120);
            return i0 + 1;
        }
        sb_append_char(out, h1 * 16 + h2);
        return i0 + 3;
    }

    if (e == 117) {                                              // \u{...}
        if (i0 + 1 >= n || s[i0 + 1] != 123) {
            diag_new("T-LEX-E002", "error",
                "转义 `\\u` 必须写成 `\\u{码点}` 形式（例：`\\u{4e2d}`）",
                g_file, dl, dc, dl, dc + 4);
            sb_append_char(out, 117);
            return i0 + 1;
        }
        var j: u64 = i0 + 2;
        var cp: i64 = 0;
        var cnt: i64 = 0;
        var okd: bool = true;
        while (j < n && s[j] != 125) {
            var hv: i64 = hex_val(s[j]);
            if (hv < 0) { okd = false; break; }
            cp = cp * 16 + hv;
            cnt = cnt + 1;
            j = j + 1;
        }
        if (okd == false || j >= n || cnt == 0 || cnt > 6) {
            diag_new("T-LEX-E002", "error",
                "`\\u{...}` 内须为 1..6 位十六进制码点并以 `}` 收尾",
                g_file, dl, dc, dl, dc + 4);
            sb_append_char(out, 117);
            return i0 + 1;
        }
        if (cp > 1114111 || (cp >= 55296 && cp <= 57343)) {
            diag_new("T-LEX-E002", "error",
                "`\\u{...}` 码点越界或落在 UTF-16 代理区（合法：0..10FFFF 且不含 D800..DFFF）",
                g_file, dl, dc, dl, dc + 4);
            return j + 1;
        }
        utf8_append_cp(out, cp);
        return j + 1;
    }

    // 兜底：未知转义。历史实现在此静默丢弃反斜杠 —— `"\x41"` 会变成 `x41`
    // 且零诊断，同时违反宪法 L-02（全行为显式）与 L-04（语义确定）。现改硬错误。
    var badsb: StringBuilder = sb_new();
    sb_append_char(badsb, 92);
    sb_append_char(badsb, e);
    diag_new("T-LEX-E002", "error",
        sb_cat3("未知转义序列 `", sb_to_str(badsb),
            "`；合法集：\\n \\t \\r \\0 \\\" \\' \\\\ \\xHH \\u{...}"),
        g_file, dl, dc, dl, dc + 2);
    sb_append_char(out, e);
    return i0 + 1;
}



// ══════════════════════════════════════════════════════════════════
// 诊断的 JSON 序列化。
// ⚠ 这段原本住在 sema.tc，导致 **parse.tc 无法输出结构化诊断**（模块 DAG
//   base→lex→parse→sema 禁止上游引用下游），于是 36 处语法错误只能裸
//   `eprint` 到 stderr —— IDE / REPL 等只消费 stdout JSON 的通道完全看不见。
//   诊断数据（Diag/diags/FixS/fixes）本就在 base.tc，打印器理应同处；
//   下沉后 parse 层即可走 `parse_fatal` 发结构化诊断。
// ══════════════════════════════════════════════════════════════════
// ── pretty JSON 输出（复刻 JSON.stringify(x, null, 2)）────────

pub fn hex_digit(v: u8) u8 {
    if (v < 10) {
        return 48 + v;
    }
    return 97 + (v - 10);
}

pub fn json_escape_into(out: StringBuilder, s: string) void {
    var i: u64 = 0;
    var n: u64 = str_len(s);
    while (i < n) {
        var b: u8 = s[i];
        if (b == 34) {
            sb_append_char(out, 92);
            sb_append_char(out, 34);
        } else {
        if (b == 92) {
            sb_append_char(out, 92);
            sb_append_char(out, 92);
        } else {
        if (b == 10) {
            sb_append_char(out, 92);
            sb_append_char(out, 110);
        } else {
        if (b == 9) {
            sb_append_char(out, 92);
            sb_append_char(out, 116);
        } else {
        if (b == 13) {
            sb_append_char(out, 92);
            sb_append_char(out, 114);
        } else {
        if (b == 8) {
            sb_append_char(out, 92);
            sb_append_char(out, 98);
        } else {
        if (b == 12) {
            sb_append_char(out, 92);
            sb_append_char(out, 102);
        } else {
        if (b < 32) {
            sb_append_char(out, 92);
            sb_append_char(out, 117);
            sb_append_char(out, 48);
            sb_append_char(out, 48);
            sb_append_char(out, hex_digit(b / 16));
            sb_append_char(out, hex_digit(b % 16));
        } else {
            sb_append_char(out, b);
        }}}}}}}}
        i = i + 1;
    }
}

pub fn j_qstr(out: StringBuilder, s: string) void {
    sb_append_char(out, 34);
    json_escape_into(out, s);
    sb_append_char(out, 34);
}

// "      \"key\": \"value\",\n" 之类的辅助
pub fn jkv_str(out: StringBuilder, ind: string, key: string, val: string, comma: bool) void {
    sb_append_str(out, ind);
    sb_append_char(out, 34);
    sb_append_str(out, key);
    sb_append_str(out, "\": ");
    j_qstr(out, val);
    if (comma) {
        sb_append_char(out, 44);
    }
    sb_append_char(out, 10);
}

pub fn jkv_num(out: StringBuilder, ind: string, key: string, val: i64, comma: bool) void {
    sb_append_str(out, ind);
    sb_append_char(out, 34);
    sb_append_str(out, key);
    sb_append_str(out, "\": ");
    sb_append_i64(out, val);
    if (comma) {
        sb_append_char(out, 44);
    }
    sb_append_char(out, 10);
}

// location/range 对象输出
pub fn j_loc(out: StringBuilder, ind: string, ind2: string, key: string, file: string, sl: i64, sc: i64, el: i64, ec: i64, comma: bool) void {
    sb_append_str(out, ind);
    sb_append_char(out, 34);
    sb_append_str(out, key);
    sb_append_str(out, "\": {");
    sb_append_char(out, 10);
    jkv_str(out, ind2, "file", file, true);
    jkv_num(out, ind2, "startLine", sl, true);
    jkv_num(out, ind2, "startCol", sc, true);
    jkv_num(out, ind2, "endLine", el, true);
    jkv_num(out, ind2, "endCol", ec, false);
    sb_append_str(out, ind);
    sb_append_char(out, 125);
    if (comma) {
        sb_append_char(out, 44);
    }
    sb_append_char(out, 10);
}

// 字符串链表数组输出（validValues/notes）；head=-1 输出 null
pub fn j_str_list(out: StringBuilder, ind: string, ind2: string, key: string, head: i64, comma: bool) void {
    sb_append_str(out, ind);
    sb_append_char(out, 34);
    sb_append_str(out, key);
    sb_append_str(out, "\": ");
    if (head < 0) {
        sb_append_str(out, "null");
    } else {
        sb_append_char(out, 91);
        sb_append_char(out, 10);
        var c: i64 = head;
        while (c >= 0) {
            var it: SI = sitems[c];
            sb_append_str(out, ind2);
            j_qstr(out, it.s);
            if (it.next >= 0) {
                sb_append_char(out, 44);
            }
            sb_append_char(out, 10);
            c = it.next;
        }
        sb_append_str(out, ind);
        sb_append_char(out, 93);
    }
    if (comma) {
        sb_append_char(out, 44);
    }
    sb_append_char(out, 10);
}

pub fn print_json() void {
    var out: StringBuilder = sb_new();
    var nd: i64 = slice_len(diags) as i64;
    // 投机求值期间产生的诊断（sev=="muted"）不对外可见：先数出可见条数，
    // 逗号分隔与 summary 都按可见条数算，否则会输出 `,]` 这种坏 JSON。
    var nvis: i64 = 0;
    var vc: i64 = 0;
    while (vc < nd) {
        if (diags[vc].sev != "muted") { nvis = nvis + 1; }
        vc = vc + 1;
    }
    var emitted: i64 = 0;

    sb_append_str(out, "{\n");
    if (nvis == 0) {
        sb_append_str(out, "  \"diagnostics\": [],\n");
    } else {
        sb_append_str(out, "  \"diagnostics\": [\n");
        var i: i64 = 0;
        while (i < nd) {
            var d: Diag = diags[i];
            if (d.sev == "muted") { i = i + 1; continue; }
            emitted = emitted + 1;
            sb_append_str(out, "    {\n");
            jkv_str(out, "      ", "code", d.code, true);
            jkv_str(out, "      ", "severity", d.sev, true);
            jkv_str(out, "      ", "category", d.cat, true);
            jkv_str(out, "      ", "name", d.name, true);
            jkv_str(out, "      ", "message", d.msg, true);
            jkv_str(out, "      ", "short_note", d.note, true);
            jkv_str(out, "      ", "legacy_code", d.legacy, true);
            j_loc(out, "      ", "        ", "location", d.file, d.sl, d.sc, d.el, d.ec, true);
            j_str_list(out, "      ", "        ", "validValues", d.vv, true);

            // fixSuggestions
            sb_append_str(out, "      \"fixSuggestions\": ");
            if (d.fs < 0) {
                sb_append_str(out, "null");
            } else {
                sb_append_str(out, "[\n");
                var f: i64 = d.fs;
                while (f >= 0) {
                    var fx: FixS = fixes[f];
                    sb_append_str(out, "        {\n");
                    jkv_str(out, "          ", "description", fx.desc, true);
                    j_loc(out, "          ", "            ", "range", fx.file, fx.sl, fx.sc, fx.el, fx.ec, true);
                    jkv_str(out, "          ", "replacement", fx.repl, false);
                    sb_append_str(out, "        }");
                    if (fx.next >= 0) {
                        sb_append_char(out, 44);
                    }
                    sb_append_char(out, 10);
                    f = fx.next;
                }
                sb_append_str(out, "      ]");
            }
            sb_append_str(out, ",\n");

            j_str_list(out, "      ", "        ", "notes", d.nt, false);

            sb_append_str(out, "    }");
            if (emitted < nvis) {
                sb_append_char(out, 44);
            }
            sb_append_char(out, 10);
            i = i + 1;
        }
        sb_append_str(out, "  ],\n");
    }

    var errs: i64 = 0;
    var warns: i64 = 0;
    var infos: i64 = 0;
    var j: i64 = 0;
    while (j < nd) {
        var d2: Diag = diags[j];
        if (d2.sev == "error") {
            errs = errs + 1;
        }
        if (d2.sev == "warning") {
            warns = warns + 1;
        }
        if (d2.sev == "info") {
            infos = infos + 1;
        }
        j = j + 1;
    }
    sb_append_str(out, "  \"summary\": {\n");
    jkv_num(out, "    ", "total", nvis, true);
    jkv_num(out, "    ", "errors", errs, true);
    jkv_num(out, "    ", "warnings", warns, true);
    jkv_num(out, "    ", "infos", infos, false);
    sb_append_str(out, "  }\n");
    sb_append_str(out, "}");

    print(sb_to_str(out));
    print("\n");
}

// 诊断渲染分发：依据 g_diag_fmt 选择 JSON（默认，机器可读）或人类可读文本。
// 所有驱动层原先直接调 print_json() 的报错点统一改调本函数，以免破坏既有 JSON 工具链。
pub fn emit_diags() void {
    if (g_diag_fmt == "human") {
        print_human();
        return;
    }
    print_json();
}

// 人类可读渲染：标准编译器格式 `file:line:col: severity[CODE]: message`，
// 附带 note / 修复建议（hint）/ 附加 notes，末尾给出错误/警告/信息计数摘要。
pub fn print_human() void {
    var nd: i64 = slice_len(diags) as i64;
    var i: i64 = 0;
    while (i < nd) {
        var d: Diag = diags[i];
        // 投机求值期间登记的诊断不对外可见（见 g_diag_mute）
        if (d.sev == "muted") { i = i + 1; continue; }
        var loc: string = d.file;
        if (d.sl > 0 || d.sc > 0) {
            loc = sb_cat5(d.file, ":", i2s(d.sl), ":", i2s(d.sc));
        }
        var tag: string = d.sev;
        if (str_len(d.code) > 0) {
            tag = sb_cat3(d.sev, "[", sb_cat3(d.code, "]", ""));
        }
        print(sb_cat3(loc, ": ", sb_cat3(tag, ": ", d.msg)));
        print("\n");
        if (str_len(d.note) > 0) {
            print(sb_cat3("  note: ", d.note, ""));
            print("\n");
        }
        var f: i64 = d.fs;
        while (f >= 0) {
            var fx: FixS = fixes[f];
            print(sb_cat3("  hint: ", fx.desc, ""));
            print("\n");
            f = fx.next;
        }
        var nt: i64 = d.nt;
        while (nt >= 0) {
            var it: SI = sitems[nt];
            print(sb_cat3("  note: ", it.s, ""));
            print("\n");
            nt = it.next;
        }
        i = i + 1;
    }
    var errs: i64 = 0;
    var warns: i64 = 0;
    var infos: i64 = 0;
    var j: i64 = 0;
    while (j < nd) {
        var d2: Diag = diags[j];
        if (d2.sev == "error") { errs = errs + 1; }
        else if (d2.sev == "warning") { warns = warns + 1; }
        else if (d2.sev == "info") { infos = infos + 1; }
        j = j + 1;
    }
    var sum: StringBuilder = sb_new();
    sb_append_str(sum, i2s(errs));
    sb_append_str(sum, " error(s)");
    if (warns > 0) {
        sb_append_str(sum, ", ");
        sb_append_str(sum, i2s(warns));
        sb_append_str(sum, " warning(s)");
    }
    if (infos > 0) {
        sb_append_str(sum, ", ");
        sb_append_str(sum, i2s(infos));
        sb_append_str(sum, " info(s)");
    }
    print(sb_to_str(sum));
    print("\n");
}

// ── 路径 / 模式工具（原 codegen_ll，迁至 DAG 根 base 以去 legacy 依赖）────

// 去路径 + 去 .tc 后缀，得到模块名（库归档名 / 输出文件 stem）。
pub fn base_no_tc(path: string) string {
    var n: u64 = str_len(path);
    var start: u64 = 0;
    var i: u64 = 0;
    while (i < n) {
        if (path[i] == 47 || path[i] == 92) {
            start = i + 1;
        }
        i = i + 1;
    }
    var end: u64 = n;
    if (n >= start + 3) {
        if (path[n - 3] == 46 && path[n - 2] == 116 && path[n - 1] == 99) {
            end = n - 3;
        }
    }
    return str_slice(path, start, end);
}

// --mode 只接受 dbg|rls（t 默认目录结构：out/dbg 调试、out/rls 发布）
pub fn valid_mode(m: string) bool {
    if (m == "dbg") { return true; }
    if (m == "rls") { return true; }
    return false;
}

// 写出文件前确保父目录存在（Windows: cmd /c mkdir，幂等）
pub fn ensure_parent(p: string) void {
    var nn: u64 = str_len(p);
    var cut: u64 = 0;
    var pi: u64 = 0;
    while (pi < nn) {
        if (p[pi] == 47 || p[pi] == 92) { cut = pi; }
        pi = pi + 1;
    }
    if (cut > 0) {
        var d: string = to_bs(str_slice(p, 0, cut));
        sys_run(base.sb_cat5("cmd /c if not exist \"", d, "\" mkdir \"", d, "\""));
    }
}

// 正斜杠 → 反斜杠（Windows 路径展示用）
pub fn to_bs(s: string) string {
    var sb: StringBuilder = sb_new();
    var i: u64 = 0;
    var n: u64 = str_len(s);
    while (i < n) {
        if (s[i] == 47) {
            sb_append_char(sb, 92);
        } else {
            sb_append_char(sb, s[i]);
        }
        i = i + 1;
    }
    return sb_to_str(sb);
}
