// S4 第二批（§0.14.7）SoA：Node.has_sa / has_sb / has_sc 存在性标志侧表访问面。
// 语义搬迁要点（re 铁律：严循等价）：
//   - 旧默认值 = **true**（node_new 里 `n.has_sa = true`），故 node_new 侧表 append **1**；
//     越界访问返回 1（而非 0）以维持等价 —— 与 node_se 返 "" 同理按「字段默认值」对齐。
//   - 仅 3 个 mk_* 构造器会把它置为传入值（可能 false）；唯一读方是 codegen_c 的 @bitpack 判定；
//     唯一跨节点传播点是 sema::clone_node（原 `nn.has_X = sn.has_X`），已改走本访问器。
pub fn node_has_sa(n: u64) bool {
    sidetable_init();
    var id = nr_idx(n);
    if (id < 0 || id >= slice_len(g_node_has_sa)) { return true; }
    return g_node_has_sa[id] != 0;
}
pub fn node_set_has_sa(n: u64, v: bool) void {
    var id = nr_idx(n);
    if (id < 0 || id >= slice_len(g_node_has_sa)) { return; }
    if (v) { slice_set(g_node_has_sa, id, 1); } else { slice_set(g_node_has_sa, id, 0); }
}
