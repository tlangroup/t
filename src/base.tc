// <<< GEN:node-structs <<<

// ── S4（§4.3）NodeRef：单 u64 打包 kind-tag|node-idx ──────────────
// NodeRef 以单 u64 表示，高 32 位为 kind-tag（NK_* 枚举值），低 32 位为节点索引。
// 单整数比较/哈希最廉价，且可直接对 nr_tag(n) 做 match 走跳转表（取代字符串 kind 比较）。
// ⚠ t 当前无 `type` 别名语法（§4.3 的 `pub type NodeRef = u64` 是目标设计、尚未落地），
//   故此处直接用 u64 作为 NodeRef 的底层表示；mk_noderef/nr_tag/nr_idx 负责打包/解包。
pub fn mk_noderef(tag: i64, idx: i64) u64 {
    var t: u64 = tag as u64;
    var i: u64 = idx as u64;
    return (t << 32) | i;
}
pub fn nr_tag(n: u64) i64 { return (n >> 32) as i64; }
pub fn nr_idx(n: u64) i64 { return ((n << 32) >> 32) as i64; }

// ── token 池 ───────────────────────────────────────────────────

pub struct Tok {
    t: string;      // token 类型名（同 lex --json 的 type）
    v: string;      // 文本值（字符串/字符已去引号、数字已规范化；供 parser 语义消费）
    src: string;    // 逐字节源文本（含引号/转义原文；S8 fmt 归并保真用，默认 == v，仅 String/字符字面量处覆盖为含引号原文）
    line: u64;
    col: u64;
}

pub var toks: []Tok;

// >>> GEN:ast (generated by tools/totter.tc from out/ebnf.json nodes -- DO NOT EDIT) >>>
// ── AST 节点池（扁平化，索引引用）──────────────────────────────
// 约定：
//   na/nb/nc/nd : 子节点索引，-1 = null
//   la/lb/lc    : 子节点列表头（Child 池索引），-1 = 空列表，-2 = null 列表
//   sa/sb/sc    : 字符串载荷；has_sa=false 表示 sa 语义为 null
//   ia/ib       : 整型载荷（radix / bitWidth / offset），-1 = null
//   ba/bb       : 布尔载荷（isConst/isExtern/isComptime/isBitpack...）

pub struct Node {
    kind: string;
    sa: string;
    sb: string;
    // S4 第六批（§0.14.7）：sc 已迁出为属性侧表 g_node_sc，访问面走 node_sc()/node_set_sc()
    // （默认 ""）。⚠ 该字段按 kind **复用**于 5 种语义（详见 node_sc 处注释）：ImportDecl/
    // ImportModDecl 的用户别名、StructDecl 的 @bitpack 标量成员类型名、FuncDecl 的
    // "__lambda__" Lambda 脱糖标记、FuncDecl 的 suite 测试路径、P Param 暂存的 owner 类型名。
    // 本批只做等价搬迁，未拆语义（拆语义属独立变更，会让本轮验证指标无法归因）。
    // S4 第二批（§0.14.7）：has_sa/has_sb/has_sc 已迁出为属性侧表 g_node_has_*，
    // 访问面走 node_has_X() / node_set_has_X()（存在性标志：X 语义是否为 null；默认 true）。
    ia: i64;
    // S4 第八批（§0.14.7）：ib 已迁出为属性侧表 g_node_ib，访问面走 node_ib()/node_set_ib()
    // （默认 **-1** = 无标记；越界读也返 -1）。与第七批 nd 同属索引型侧表，复用 -1 哨兵范式。
    // ⚠ ib 被 6 种 kind 复用（SL offset / tile 列数 / array_lit 的 TD 下标 / conpat·VC 载荷数 /
    //   F 的 tagID / leading-dot 标记），完整清单见 node_ib 处注释。本批只做等价搬迁，未拆语义。
    // S4 第十批（§0.14.7）：ba 已迁出为属性侧表 g_node_ba，访问面走 node_ba()/node_set_ba()
    // （默认 **false**）。⚠ 该槽按 kind 复用 8 种语义（bool 字面量真值 / var_decl const /
    //   arm·P 通配 / range 闭合 `..=` / bitstr_seg 变长尾 / ImportItem 通配 / StructDecl /
    //   VariantDecl 抽象变体），完整清单见 node_ba 处注释。本批只做等价搬迁，未拆语义。
    // S4 第五批（§0.14.7）：bb / bc 已迁出为属性侧表 g_node_bb / g_node_bc，
    // 访问面走 node_bb()/node_set_bb() 与 node_bc()/node_set_bc()（默认 false）。
    //   bb = bool 载荷（按 kind 复用：is_let / 编译期类型参数 / SL 显式 offset / 捕获标记）
    //   bc = 模块系统：该声明是否被 `pub` 修饰（顶层跨模块可见性）
    // S4 第四批（§0.14.7）：bd 已迁出为属性侧表 g_node_bd，访问面走 node_bd()/node_set_bd()
    // （默认 false）。⚠ 该字段被**复用**于两种语义：① import 是否走库搜索路径
    // （true=lib/依赖库，false=src 源码根；见 parse_at_import_decl / handle_one_import）；
    // ② member 节点是否是某个 call 的 callee（sema::mark_call_callees 置位）。
    // S4 第三批（§0.14.7）：be/bf 已迁出为属性侧表 g_node_be / g_node_bf，
    // 访问面走 node_be()/node_set_be() 与 node_bf()/node_set_bf()（默认 false）。
    //   be = C 互操作导出：该声明是否标记 `@c_export`（生成 C ABI 平铺入口）
    //   bf = Device 子系统：该声明是否为 `kernel fn`（host 双后端跳过，codegen_dev 处理）
    na: i64;
    nb: i64;
    // S4 第九批（§0.14.7）：nc 已迁出为属性侧表 g_node_nc，访问面走 node_nc()/node_set_nc()
    // （默认 **-1** = 无该子节点；越界读也返 -1）。与第七批 nd 同族，直接复用 -1 哨兵范式。
    // S4 第七批（§0.14.7）：nd 已迁出为属性侧表 g_node_nd，访问面走 node_nd()/node_set_nd()
    // （默认 **-1** = 无该子节点；越界读也返 -1）。na/nb/nc/nd 四槽里 nd 量级最低（真站点 22），
    // 先迁它以验证「索引型（非 bool / 非 string）侧表」范式，再动 na/nb/nc。
    // S4 第四批（§0.14.7）：memspace 已迁出为属性侧表 g_node_memspace，访问面走
    // node_memspace()/node_set_memspace()（默认 0）。Device 指针地址空间
    // （0=host；1=global/dev_ptr；3=shared；5=local），仅 pointer 类型节点使用。
    la: i64;
    lb: i64;
    // S4 第十一批（§0.14.7）：lc 已迁出为属性侧表 g_node_lc，访问面走 node_lc()/node_set_lc()
    // （默认 **-1** = 空 kids 链；⚠ 另有特殊哨兵 **-2** = 本体已由别处消费的合成声明，
    //   判据遍布 `if (n.lc > -2)` / `if (n.lc != -2)` / `if (n.lc == -2)`，详见 node_lc 处注释）。
    // `la`/`lb`/`lc` 同族：都是 **kids 链表头下标**而非节点 id，务必走 `*_kids`/`*_list` 链表下钻。
    // S3（§4.5）：原 `td`（HIR 类型槽）已迁出为属性侧表 `g_node_td`，访问面走
    // `node_type()` / `node_set_type()`。语法树不再携带类型——跨切面属性改由侧表
    // 以节点 id 为键持有，降低 Node 布局与下游阶段的耦合（替换前：`td: i64`）。
    id: i64;    // S5 step2 过渡：节点裸索引（== nodes 下标），供 X.ln → node_span_id(X.id) 机械迁移读方；
                // 待退役字段，S4 epic 删 base.Node 时一并移除（NodeRef 即句柄，无需自存 id）
}

// S5（§4.10.3 / §4.8）：源码区间 Span（取代 `ln/cl/tv` 三字段的结构化表示）。
// step1 建侧表（node_new 初始化零区间 + node_at 绑定）；step2 读方迁 node_span_id(X.id)；
// step3 删 `Node.ln/cl/tv` 字段，Span 成为唯一源码区间载体（读方经 node_span_id(X.id) 取，
// X.id 由 node_new 写入）。诊断行号与删字段前逐字节一致（与 S3 字段外置范式一致）。
pub struct Span {
    line: u64;     // 起始行（1-based；0 = 无）
    col: u64;      // 起始列（1-based）
    end_col: u64;  // 终止列 = col + len(tv)（独占上界）
}

pub var nodes: []Node;

// ── 命名空间隔离（外部库真正落地）──────────────────────────────
// provenance：每个 AST 节点记录它是在哪个模块（别名）里被解析出来的。
// 入口（main）模块别名 = ""，不参与名字重整（mangling）。
pub var g_cur_mod: string;              // 解析期当前模块别名（load_module_file 内设置）
pub var g_node_mod: []string;           // 与 nodes 平行的数组：nodes[i] 所属模块别名（"" = 入口）
pub var g_node_file: []string;          // 与 nodes 平行的数组：nodes[i] 所属源文件（多模块编译单元下诊断定位用）
pub var g_node_td: []i64;               // S3 §4.5 node_type 侧表：nodes[i] 的 HIR 类型槽 TD 索引（0 = 未定型；-1 = 已丢弃）
pub var g_node_resolve: []i64;          // S3 §4.5 node_resolve 侧表：ident 节点 i 解析到的声明节点（替代 g_idecl_* 反向扫描，O(1)）
pub var g_node_const: []i64;             // S3 §4.5 node_const 侧表：nodes[i] 是否为 const 声明（1 = 是；0 = 否；替代 g_const_decl_ids 列表 + 线性扫描）
pub var g_node_span: []Span;              // S5 §4.8 node_span 側表：nodes[i] 的源码区间 Span（取代 ln/cl/tv 的结构化表示）

// ── S5 §4.8 trivia（span 间隙表示）─────────────────────────────
// trivia = 注释/空白，不作为独立子节点，而是录在「节点之间的间隙」里（leading/trailing 两段）。
// 表征采用 (line,col,text) + kind；§4.8 原写「字节范围指向源文本」，本步用 (line,col,text)
// 等价表征（text 直接来自源，未复制到每个节点），字节范围形式留作 S8 fmt 需要时再升级（§4.8「局部扩展」）。
pub struct TriviaTok {
    kind: string;   // "Ws" / "Newline" / "LineComment" / "BlockComment"
    text: string;   // 源文本片段（指向源，仅存于本列表，不复制到每个节点）
    line: u64;
    col: u64;
}
pub var g_trivia_toks: []TriviaTok;        // lexer 在 tokenize 期逐段保留的 trivia（按源序）；dump-ast / S8 fmt 消费
pub struct Trivia {
    leading: []u64;   // g_trivia_toks 下标列表：本节点前的间隙 trivia
    trailing: []u64;  // 本节点后的间隙 trivia
}
pub var g_node_trivia: []Trivia;           // S5 §4.8 trivia 侧表：nodes[i] 的 leading/trailing 间隙 trivia

// S4（§0.14.6 / §4.10.3）：节点载荷 SoA 化侧表群 —— 逐步把 `Node` 各字段外置为平行侧表，
// 最终删 `pub struct Node` + `nodes[]`。首批：`se`（C 互操作导出 ABI 符号名）。
// 后续字段（sa/sb/sc/ia/ib/na/nb/...）按需逐组外置，每组独立验证自举不动点 + gate 全绿。
pub var g_node_se: []string;               // 与 nodes 平行：nodes[i] 的 C ABI 导出符号名（"" = 未导出）
// S4 第二批（§0.14.7）：存在性标志位组 has_sa/has_sb/has_sc（has_X == 0 表示 X 语义为 null）。
// 沿用 g_node_const 的 []i64 先例（1=是 / 0=否）而非 []bool，与既有侧表切片类型保持一致。
// ⚠ 初值必须与旧 Node 字段默认值一致：node_new 旧代码写 `n.has_sa = true`，故此处默认 **1（true）**。
pub var g_node_has_sa: []i64;              // nodes[i] 的 has_sa（默认 1）
pub var g_node_has_sb: []i64;              // nodes[i] 的 has_sb（默认 1）
pub var g_node_has_sc: []i64;              // nodes[i] 的 has_sc（默认 1）
// S4 第三批（§0.14.7）：声明级 bool 标记组 be / bf。
// ⚠ 与上一批方向相反：旧 node_new 写 `n.be = false; n.bf = false;` ⇒ 此处默认 **0（false）**，
//   访问器越界返回 false（按字段默认值对齐）。搬迁时勿照抄 has_* 的「默认 true」写法。
//   - be：C 互操作导出 —— 该声明是否标记 `@c_export`（生成 C ABI 平铺入口）
//   - bf：Device 子系统 —— 该声明是否为 `kernel fn`（设备入口；host 双后端跳过，codegen_dev 处理）
pub var g_node_be: []i64;                  // nodes[i] 的 be（默认 0 = 非 @c_export）
pub var g_node_bf: []i64;                  // nodes[i] 的 bf（默认 0 = 非 kernel fn）
// S4 第四批（§0.14.7）：Device 地址空间 memspace（i64，值域 0=host / 1=global / 3=shared /
// 5=local；仅 `pointer` 类型节点使用；默认 0）+ 模块系统 import 库路径标志 bd（bool，默认 false）。
// ⚠ 普查提示：`memspace` 的 13 处命中里**多数是同名假阳性** —— `tbl_RecPointer_memspace`
//   （S2 已 SoA 化的 record struct，base.tc:1351-1363）、`sema` 的 `TD.memspace`（类型描述，
//   sema.tc:32）、`tir`/`codegen_c` 的 `t.memspace`（同 TD）。**真实 Node 站点仅 6 处。**
// ⚠ `bd` 字段被**复用**于两种语义：① ImportDecl/ImportModDecl = 是否走库搜索路径；
//   ② member 节点 = 是否是某个 call 的 callee（sema::mark_call_callees 置位，
//   infer_expr_body 据此跳过「字段不存在」误报）。外置只做等价搬迁，勿擅自拆分语义。
pub var g_node_memspace: []i64;            // nodes[i] 的 memspace（默认 0 = host）
pub var g_node_bd: []i64;                  // nodes[i] 的 bd（默认 0 = false）
// S4 第五批（§0.14.7）：bool 载荷组 bb / bc（默认 false，与 be/bf/bd 同向）。
//   - bb：多语义 bool 载荷 —— 按 kind 复用：FuncDecl/GlobalConstDecl/GlobalVarDecl = is_let
//     （动态常量，类型由初始化器推断）；P = 编译期类型参数；SL = 显式 offset 标志；
//     capture/closure 相关 = 捕获标记。**外置只做等价搬迁，禁止顺手拆语义。**
//   - bc：模块系统 —— 该声明是否被 `pub` 修饰（顶层跨模块可见性）。单一语义。
// ⚠ 与 bb 相关的 `mk_FuncDecl/mk_GlobalConstDecl/mk_GlobalVarDecl/mk_SL` 仍保留 `bb` 形参
//   （构造参数不变 ⇒ 15+ 调用点与 cst_register_Rec* S2 dual-write 签名不动），
//   仅函数体内由 `n.bb = bb` 改为 `node_set_bb(id, bb)`。
pub var g_node_bb: []i64;                  // nodes[i] 的 bb（默认 0 = false）
pub var g_node_bc: []i64;                  // nodes[i] 的 bc（默认 0 = 非 pub）
pub var g_node_nd: []i64;                  // nodes[i] 的 nd 子节点索引（默认 -1 = 无）
pub var g_node_ib: []i64;                  // nodes[i] 的 ib 通用整数槽（默认 -1；见 node_ib 处语义清单）
pub var g_node_sc: []string;               // S4 第六批：nodes[i] 的 sc 字符串载荷（默认 ""）
pub var g_node_nc: []i64;                  // S4 第九批：nodes[i] 的 nc 子节点索引（默认 -1 = 无）
pub var g_node_ba: []i64;                  // S4 第十批：nodes[i] 的 ba 通用 bool 载荷（默认 0 = false）
                                           // ⚠ 该槽按 kind **复用**于多种语义（见 node_ba 处注释）
pub var g_node_lc: []i64;                  // S4 第十一批：nodes[i] 的 lc kids 链表头（默认 -1 = 空链）
                                           // ⚠ 另含特殊哨兵 **-2**（见 node_lc 处注释）

// ── S3（§4.5）：侧表登记 + provenance 侧表读取面 ──────────────────────────────
// 跨切面属性统一登记 SideTable{name,owner,dirty}，PassManager 据 name 建拓扑与置脏。
// provenance（节点所属模块/文件）是第一个迁过来的跨切面属性：存储仍走上面两个全局平行
// 数组（与 nodes[] 按 id 对齐），读取面改经 node_mod()/node_file() 访问器，便于后续
// 在 S3 后续子步删除原始全局、统一为侧表实例。
pub struct SideTable {
    name: string;
    owner: string;
    dirty: bool;
}
pub var g_sidetables: []SideTable;
pub var g_st_inited: bool = false;
pub fn sidetable_register(name: string, owner: string) i64 {
    append(g_sidetables, SideTable{name: name, owner: owner, dirty: false});
    return slice_len(g_sidetables) - 1;
}
// 惰性登记全部内置侧表（幂等，首次访问任一访问器时触发）：
// PassManager 后续按 SideTable.name 建依赖拓扑与失效（§4.12 owns/requires）。
pub fn sidetable_init() void {
    if (g_st_inited) { return; }
    g_st_inited = true;
    sidetable_register("node_provenance", "S3");
    sidetable_register("node_type", "S3");
    sidetable_register("node_resolve", "S3");
    sidetable_register("node_const", "S3");
    sidetable_register("node_scope", "S3");
    sidetable_register("node_span", "S5");
    sidetable_register("node_se", "S4");   // SoA：C ABI 导出符号名
    sidetable_register("node_has_sa", "S4");   // SoA：sa 存在性标志（第二批）
    sidetable_register("node_has_sb", "S4");   // SoA：sb 存在性标志（第二批）
    sidetable_register("node_has_sc", "S4");   // SoA：sc 存在性标志（第二批）
    sidetable_register("node_be", "S4");       // SoA：@c_export 标记（第三批）
    sidetable_register("node_bf", "S4");       // SoA：kernel fn 标记（第三批）
    sidetable_register("node_memspace", "S4");  // SoA：Device 指针地址空间（第四批）
    sidetable_register("node_bd", "S4");        // SoA：import 库路径 / member-callee 标记（第四批）
    sidetable_register("node_bb", "S4");        // SoA：bool 载荷 is_let/编译期类型参数/显式 offset（第五批）
    sidetable_register("node_bc", "S4");        // SoA：`pub` 顶层可见性标记（第五批）
    sidetable_register("node_nd", "S4");        // SoA：nd 子节点索引（第七批，默认 -1）
    sidetable_register("node_ib", "S4");        // SoA：ib 通用整数槽（第八批，默认 -1）
    sidetable_register("node_sc", "S4");        // SoA：字符串载荷（别名/bitpack 标量/lambda 标记/suite 路径；第六批）
    sidetable_register("node_nc", "S4");        // SoA：nc 子节点索引（第九批，默认 -1）
    sidetable_register("node_ba", "S4");        // SoA：ba 通用 bool 载荷（第十批，默认 false）
    sidetable_register("node_lc", "S4");        // SoA：lc kids 链表头（第十一批，默认 -1）
}
pub fn node_mod(n: u64) string {
    sidetable_init();
    var id = nr_idx(n);
    if (id < 0 || id >= slice_len(g_node_mod)) { return ""; }
    return g_node_mod[id];
}
pub fn node_file(n: u64) string {
    var id = nr_idx(n);
    if (id < 0 || id >= slice_len(g_node_file)) { return ""; }
    return g_node_file[id];
}

// ── node_span 侧表（§4.8 / S5）：取代 `Node.ln/cl/tv` 三字段的结构化源码区间 ──
// step3 起 `Node.ln/cl/tv` 已删除，本侧表为唯一源码区间载体；node_new 初始化零区间 + node_at 写整段 Span。
pub fn node_span_id(idx: i64) Span {
    sidetable_init();
    if (idx < 0 || idx >= slice_len(g_node_span)) { var z: Span; return z; }
    return g_node_span[idx];
}
pub fn node_set_span_id(idx: i64, s: Span) void {
    sidetable_init();
    if (idx < 0 || idx >= slice_len(g_node_span)) { return; }
    slice_set(g_node_span, idx, s);
}
pub fn node_span(n: u64) Span {
    return node_span_id(nr_idx(n));
}
pub fn node_set_span(n: u64, s: Span) void {
    node_set_span_id(nr_idx(n), s);
}

// ── S5 step4：CST `.ast` 序列化（供 IDE / 增量重编锚点 / `tc --format` 往返）──
// 纯加法：仅遍历 parse 后 CST（nodes + kids 池），不改任何编译行为、不触达任何发射路径。
// 输出 S-表达式风格文本：每行一个节点，`(role:kind id=N L行:列-终列 属性… 子节点…)`；
// 名字子节点（na/nb/nc/nd）以 role 标注，kids 池子节点无 role；模块根由调用方合成 `module`。
// 遍历假定 CST 为树（无共享/环）：na/nb/nc/nd 与 kids 池指向互不相同的子节点，递归安全。
pub var g_cst_sb: StringBuilder;
pub fn cst_indent(depth: i64) void {
    var i: i64 = 0;
    while (i < depth * 2) { sb_append_char(g_cst_sb, 32); i = i + 1; }   // 32 = space
}
// trivia 单条紧凑打印（kind[转义文本]），供 cst_dump 内联展示
pub fn cst_trivia_one(idx: i64) void {
    if (idx < 0 || idx >= slice_len(g_trivia_toks)) { sb_append_str(g_cst_sb, " ??BADTRIV"); return; }
    var tt = g_trivia_toks[idx];
    sb_append_str(g_cst_sb, " ");
    sb_append_str(g_cst_sb, tt.kind);
    sb_append_char(g_cst_sb, 91);  // '['
    var tl = str_len(tt.text);
    var ci: i64 = 0;
    while (ci < tl) {
        var ch = tt.text[ci];
        if (ch == 10) { sb_append_str(g_cst_sb, "\\n"); }
        else if (ch == 9) { sb_append_str(g_cst_sb, "\\t"); }
        else if (ch == 92) { sb_append_str(g_cst_sb, "\\\\"); }
        else if (ch == 34) { sb_append_str(g_cst_sb, "\\\""); }
        else { sb_append_char(g_cst_sb, ch); }
        ci = ci + 1;
    }
    sb_append_char(g_cst_sb, 93);  // ']'
}
pub fn cst_dump(role: string, id: i64, depth: i64) void {
    if (id < 0) { return; }
    sb_append_char(g_cst_sb, 10);            // 10 = '\n'
    cst_indent(depth);
    sb_append_char(g_cst_sb, 40);            // 40 = '('
    if (str_len(role) > 0) {
        sb_append_str(g_cst_sb, role);
        sb_append_char(g_cst_sb, 58);        // 58 = ':'
    }
    var n: Node = nodes[id];
    sb_append_str(g_cst_sb, n.kind);
    sb_append_str(g_cst_sb, " id=");
    sb_append_i64(g_cst_sb, id);
    var sp: Span = node_span_id(id);
    if (sp.line > 0) {
        sb_append_str(g_cst_sb, " L");
        sb_append_i64(g_cst_sb, sp.line);
        sb_append_char(g_cst_sb, 58);        // ':'
        sb_append_i64(g_cst_sb, sp.col);
        sb_append_char(g_cst_sb, 45);        // 45 = '-'
        sb_append_i64(g_cst_sb, sp.end_col);
    }
    if (str_len(n.sa) > 0) { sb_append_str(g_cst_sb, " sa=\""); sb_append_str(g_cst_sb, n.sa); sb_append_char(g_cst_sb, 34); }
    if (str_len(n.sb) > 0) { sb_append_str(g_cst_sb, " sb=\""); sb_append_str(g_cst_sb, n.sb); sb_append_char(g_cst_sb, 34); }
    var n_sc = node_sc((id as u64));
    if (str_len(n_sc) > 0) { sb_append_str(g_cst_sb, " sc=\""); sb_append_str(g_cst_sb, n_sc); sb_append_char(g_cst_sb, 34); }
    var n_se = node_se((id as u64));
    if (str_len(n_se) > 0) { sb_append_str(g_cst_sb, " se=\""); sb_append_str(g_cst_sb, n_se); sb_append_char(g_cst_sb, 34); }
    if (n.ia != -1) { sb_append_str(g_cst_sb, " ia="); sb_append_i64(g_cst_sb, n.ia); }
    var n_ib: i64 = node_ib((id as u64));   // S4 §0.14.7 SoA：侧表读（原 n.ib）
    if (n_ib != -1) { sb_append_str(g_cst_sb, " ib="); sb_append_i64(g_cst_sb, n_ib); }
    if (node_ba((id as u64))) { sb_append_str(g_cst_sb, " ba"); }   // S4 §0.14.7 SoA：侧表读（原 n.ba；第十批）
    if (node_bb((id as u64))) { sb_append_str(g_cst_sb, " bb"); }   // S4 §0.14.7 SoA：侧表读（原 n.bb）
    if (node_bc((id as u64))) { sb_append_str(g_cst_sb, " bc"); }   // S4 §0.14.7 SoA：侧表读（原 n.bc）
    if (node_bd((id as u64))) { sb_append_str(g_cst_sb, " bd"); }   // S4 §0.14.7 SoA：侧表读（原 n.bd）
    if (node_be((id as u64))) { sb_append_str(g_cst_sb, " be"); }   // S4 §0.14.7 SoA：侧表读（原 n.be）
    if (node_bf((id as u64))) { sb_append_str(g_cst_sb, " bf"); }   // S4 §0.14.7 SoA：侧表读（原 n.bf）
    // trivia（S5 §4.8）：#< = leading 间隙 trivia，#> = trailing 间隙 trivia
    var trv = node_trivia((id as u64));
    if (slice_len(trv.leading) > 0) {
        var li: i64 = 0;
        while (li < slice_len(trv.leading)) { sb_append_str(g_cst_sb, " #<"); cst_trivia_one(trv.leading[li]); li = li + 1; }
    }
    if (slice_len(trv.trailing) > 0) {
        var ti: i64 = 0;
        while (ti < slice_len(trv.trailing)) { sb_append_str(g_cst_sb, " #>"); cst_trivia_one(trv.trailing[ti]); ti = ti + 1; }
    }
    // 子节点：先名字子节点（role 标注），再 kids 池（la/lb/lc 三条链，无 role）
    if (n.na >= 0) { cst_dump("na", n.na, depth + 1); }
    if (n.nb >= 0) { cst_dump("nb", n.nb, depth + 1); }
    var n_nc: i64 = node_nc((id as u64));   // S4 §0.14.7 SoA：侧表读（原 n.nc；第九批）
    if (n_nc >= 0) { cst_dump("nc", n_nc, depth + 1); }
    var n_nd: i64 = node_nd((id as u64));   // S4 §0.14.7 SoA：侧表读（原 n.nd）
    if (n_nd >= 0) { cst_dump("nd", n_nd, depth + 1); }
    var c: i64 = n.la; while (c >= 0) { cst_dump("", kids[c].val, depth + 1); c = kids[c].next; }
    c = n.lb; while (c >= 0) { cst_dump("", kids[c].val, depth + 1); c = kids[c].next; }
    c = node_lc((id as u64)); while (c >= 0) { cst_dump("", kids[c].val, depth + 1); c = kids[c].next; }   // S4 §0.14.7 SoA：侧表读（原 n.lc；第十一批）
    sb_append_char(g_cst_sb, 41);            // 41 = ')'
}
pub fn cst_to_ast_str(roots: []i64) string {
    g_cst_sb = sb_new();
    sb_append_char(g_cst_sb, 40);            // '('
    sb_append_str(g_cst_sb, "module");
    var i: i64 = 0;
    var m: i64 = slice_len(roots) as i64;
    while (i < m) { cst_dump("", roots[i], 1); i = i + 1; }
    sb_append_char(g_cst_sb, 41);            // ')'
    sb_append_char(g_cst_sb, 10);
    return sb_to_str(g_cst_sb);
}

// ── S8 step1（§0.16.11）：`tc fmt` 的 trivia 感知再发射基础 ──────────────────
// 把词法 token 流（toks，含源码全部代码 token 的精确文本 v）与 trivia 流
// （g_trivia_toks，空白/换行/注释的精确文本）按 (line,col) 双指针归并，还原出
// 与源逐字符一致的重排文本。这是 fmt 消费 CST+trivia（G7）能力的首步落地：
// 当前为「忠实还原」基础版，后续 step2 叠加基于结构（节点）的规范化重排（缩进/空行/对齐）。
// 归并正确性：toks 与 g_trivia_toks 均由 lexer 按源码左→右顺序 append，各自内部
// 已按 (line,col) 有序；二者在源位置上底互不重叠（trivia 占间隙），故双指针归并即
// 等价于全序列按 (line,col) 排序，连结各 token 的精确文本即得原始源码。
pub fn cst_format_tokens() string {
    var sb: StringBuilder = sb_new();
    var nt: i64 = slice_len(toks) as i64;
    var ntr: i64 = slice_len(g_trivia_toks) as i64;
    var i: i64 = 0;   // toks 游标
    var j: i64 = 0;   // g_trivia_toks 游标
    while (i < nt || j < ntr) {
        var use_tok: bool = false;
        if (i >= nt) {
            use_tok = false;
        } else if (j >= ntr) {
            use_tok = true;
        } else {
            var tk = toks[i];
            var tr = g_trivia_toks[j];
            if (tk.line < tr.line) { use_tok = true; }
            else if (tk.line > tr.line) { use_tok = false; }
            else { if (tk.col <= tr.col) { use_tok = true; } else { use_tok = false; } }
        }
        if (use_tok) {
            sb_append_str(sb, toks[i].src);
            i = i + 1;
        } else {
            sb_append_str(sb, g_trivia_toks[j].text);
            j = j + 1;
        }
    }
    return sb_to_str(sb);
}

// ── S8 step2（§0.16.12）：基于结构的规范化重排 ───────────────────────────────
// step1 的 `cst_format_tokens` 是「忠实还原」（逐字节复现源码，证明归并正确）；
// 本步在此基础上做真正的排版规范化：
//   ① 缩进 = 括号嵌套深度 × wid（默认 4 空格，与 examples 主导风格一致）；
//   ② 行尾空白去除；③ 连续空行折叠为至多 1 个空行；
//   ④ 注释（LineComment / BlockComment）原样保留 —— 注释是用户资产，不重排其内部。
//
// 不变式（格式化正确性的定义）：**只改 trivia，绝不动 token 文本与顺序** ⇒
// token 流（type+value 序列）与源逐项一致。t 是花括号语言、空白无语义，
// 故 token 序列不变 ⇒ 语义必然不变。该不变式由 `tc lex` 序列比对守住（§0.16.12）。
//
// 结构信息来源 = **token 流的括号深度**，而非 CST 节点：`fmt` 不调 `parse_unit`
// （fstr_parse_expr 会把 f-string 插值 token 追加到 toks 尾部，污染 token 流，
// 见 lex.tc 顶部 append-only 契约注释）。括号深度已足够支撑缩进/空行这一层排版。
pub fn cst_spaces(n: i64) string {
    var s: StringBuilder = sb_new();
    var i: i64 = 0;
    while (i < n) { sb_append_char(s, 32); i = i + 1; }   // 32 = space
    return sb_to_str(s);
}

pub fn cst_format_normalized(wid: i64) string {
    var sb: StringBuilder = sb_new();
    var nt: i64 = slice_len(toks) as i64;
    var ntr: i64 = slice_len(g_trivia_toks) as i64;
    var i: i64 = 0;              // toks 游标
    var j: i64 = 0;              // g_trivia_toks 游标
    var depth: i64 = 0;          // 括号嵌套深度
    var at_bol: bool = true;     // 行首（本行尚未写缩进与内容）
    var pend_ws: string = "";    // 行内待决空白（遇换行丢弃 ⇒ 去行尾空白）
    var nl_run: i64 = 0;         // 连续换行计数（用于折叠多空行）
    while (i < nt || j < ntr) {
        var use_tok: bool = false;
        if (i >= nt) {
            use_tok = false;
        } else if (j >= ntr) {
            use_tok = true;
        } else {
            var tk = toks[i];
            var tr = g_trivia_toks[j];
            if (tk.line < tr.line) { use_tok = true; }
            else if (tk.line > tr.line) { use_tok = false; }
            else { if (tk.col <= tr.col) { use_tok = true; } else { use_tok = false; } }
        }
        if (use_tok) {
            var tx: string = toks[i].src;
            var is_open: bool = false;
            var is_close: bool = false;
            if (str_len(tx) == 1) {
                var c0: i64 = tx[0] as i64;
                if (c0 == 123 || c0 == 91 || c0 == 40) { is_open = true; }    // { [ (
                if (c0 == 125 || c0 == 93 || c0 == 41) { is_close = true; }   // } ] )
            }
            var d: i64 = depth;
            if (is_close) { d = depth - 1; }
            if (d < 0) { d = 0; }
            if (at_bol) {
                sb_append_str(sb, cst_spaces(d * wid));
                at_bol = false;
            } else if (str_len(pend_ws) > 0) {
                sb_append_str(sb, pend_ws);
            }
            pend_ws = "";
            sb_append_str(sb, tx);
            if (is_open) { depth = depth + 1; }
            if (is_close) { depth = depth - 1; if (depth < 0) { depth = 0; } }
            nl_run = 0;
            i = i + 1;
        } else {
            var tr2 = g_trivia_toks[j];
            if (tr2.kind == "Newline") {
                pend_ws = "";
                if (nl_run < 2) { sb_append_str(sb, "\n"); }   // 至多保留 1 个空行
                nl_run = nl_run + 1;
                at_bol = true;
            } else if (tr2.kind == "Ws") {
                if (at_bol == false) { pend_ws = tr2.text; }   // 行首空白由缩进统一给出
            } else {
                // LineComment / BlockComment：原样保留
                if (at_bol) {
                    sb_append_str(sb, cst_spaces(depth * wid));
                    at_bol = false;
                } else if (str_len(pend_ws) > 0) {
                    sb_append_str(sb, pend_ws);
                }
                pend_ws = "";
                sb_append_str(sb, tr2.text);
                nl_run = 0;
            }
            j = j + 1;
        }
    }
    return sb_to_str(sb);
}

// ── node_type 侧表（§4.5）：取代已删除的 `Node.td` 字段 ──────────────────────
// 语义与原字段一致：0 = 未定型；> 0 = TD 索引（读取方仍须做上界检查）；
// -1 = 缓存被判定越界并丢弃（回落重推导）。此处为纯搬迁，不改变任何行为。
pub fn node_type(n: u64) i64 {
    sidetable_init();
    var id = nr_idx(n);
    if (id < 0 || id >= slice_len(g_node_td)) { return 0; }
    return g_node_td[id];
}
pub fn node_set_type(n: u64, td: i64) void {
    var id = nr_idx(n);
    if (id < 0 || id >= slice_len(g_node_td)) { return; }
    slice_set(g_node_td, id, td);
}

// ── node_resolve 侧表（§4.5）：取代 g_idecl_n/g_idecl_d 平行数组 + last-write-wins 反向扫描 ──
// ident 节点 i → 其解析到的声明节点。sema 解析标识符时写 node_set_resolve(i, decl)，
// 后端发射标识符时读 node_resolve(i) 反查（得到被 shadow 的正确声明）。
// 等价性：旧 idecl_set 的「反向扫描命中即更新」==「对 node_resolve[i] 直接 O(1) 覆盖写」——
// 同一 i 的多次写入最终值均为最后一次调用的值，故解析结果与旧实现逐字节一致（用户 IR 不变）。
pub fn node_resolve(n: u64) i64 {
    sidetable_init();
    var id = nr_idx(n);
    if (id < 0 || id >= slice_len(g_node_resolve)) { return -1; }
    return g_node_resolve[id];
}
pub fn node_set_resolve(n: u64, decl: i64) void {
    var id = nr_idx(n);
    if (id < 0 || id >= slice_len(g_node_resolve)) { return; }
    slice_set(g_node_resolve, id, decl);
}

// ── node_const 侧表（§4.5）：取代 g_const_decl_ids 平行数组 + 线性扫描 ──
// nodes[i] 是否为 const 声明（1 = 是；0 = 否）。parse 在 KwConst 处调 node_set_const(id) 登记；
// sema 经 node_const(id) != 0 判定「该声明是否 const」（实施 const 静态引用规则，见 sema.check_const_ref）。
// 等价性：旧 g_const_decl_ids 为「decl id 列表」，g_const_decl_has(d) 线性扫描判属；
// 新 g_node_const[d] 为 per-node 标志，node_set_const(d) 在原 4 个 append 点置 1，
// 二者成员集合逐字节一致 → 用户 IR 不变。
pub fn node_const(n: u64) i64 {
    sidetable_init();
    var id = nr_idx(n);
    if (id < 0 || id >= slice_len(g_node_const)) { return 0; }
    return g_node_const[id];
}
pub fn node_set_const(n: u64) void {
    var id = nr_idx(n);
    if (id < 0 || id >= slice_len(g_node_const)) { return; }
    slice_set(g_node_const, id, 1);
}

// S4（§0.14.6 / §4.10.3）SoA：Node.se（C 互操作导出 ABI 符号名，clean name；"" = 未导出）侧表访问面。
