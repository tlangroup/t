// <<< GEN:ast <<<

// 选择性导入项 `import(p :: a, b as c, *)` 的单项节点（GEN 区之外，手写）：
//   sa = 模块中的原名（通配为 "*"），sb = 导入方本地名，ba = 是否通配 `*`。
// 该节点只挂在 ImportModDecl.lb 链上，永不进 decl_list，也不参与任何发射。
mk_ImportItem fn(sa: string, sb: string, wild: bool, ti: i64) i64 {
    var id: i64 = node_new("ImportItem");
    var n: Node = nodes[id];
    n.sa = sa;
    n.sb = sb;
    n.ba = wild;
    slice_set(nodes, id, n);
    if (ti >= 0) { node_at(id, ti); }
    return id;
}

// 列表构建：head/tail 由调用方持有；返回新 tail
list_push fn(head: i64, tail: i64, val: i64) i64 {
    var c: Child;
    c.val = val;
    c.next = -1;
    append(kids, c);
    var idx: i64 = (slice_len(kids) as i64) - 1;
    if (tail >= 0) {
        var prev: Child = kids[tail];
        prev.next = idx;
        slice_set(kids, tail, prev);
    }
    return idx;
}

// ── 诊断池（复刻 DiagnosticBag）────────────────────────────────
// vv/fs/nt: -1 = null；vv/nt 指向 sitems 链表头，fs 指向 fixes 链表头

Diag struct {
    code: string;
    sev: string;
    msg: string;
    file: string;
    sl: i64;
    sc: i64;
    el: i64;
    ec: i64;
    vv: i64;
    fs: i64;
    nt: i64;
}

var diags: []Diag;

SI struct {
    s: string;
    next: i64;
}

var sitems: []SI;

FixS struct {
    desc: string;
    file: string;
    sl: i64;
    sc: i64;
    el: i64;
    ec: i64;
    repl: string;
    next: i64;
}

var fixes: []FixS;

var g_file: string;

diag_new fn(code: string, sev: string, msg: string, file: string, sl: i64, sc: i64, el: i64, ec: i64) i64 {
    var d: Diag;
    d.code = code;
    if (sev == "") {
        sev = diag_sev(code);
    }
    d.sev = sev;
    d.msg = msg;
    d.file = file;
    d.sl = sl;
    d.sc = sc;
    d.el = el;
    d.ec = ec;
    d.vv = -1;
    d.fs = -1;
    d.nt = -1;
    // 幂等去重：同一 (code, file, 位置, 文案) 只保留一条。
    // 检查器对同一子表达式可能推导多次（例如内建实参既被专属分支推、又被
    // 兜底补扫推一遍），若不去重，用户会看到成对的重复报错。诊断数量在正常
    // 编译里是 0~个位数，线性扫描的代价可以忽略。
    var dq: i64 = 0;
    var dqn: i64 = slice_len(diags) as i64;
    while (dq < dqn) {
        var od: Diag = diags[dq];
        if (od.code == code && od.file == file && od.sl == sl && od.sc == sc && od.msg == msg) {
            return dq;
        }
        dq = dq + 1;
    }
    append(diags, d);
    return (slice_len(diags) as i64) - 1;
}

// >>> GEN:diagnostics (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
// 诊断码 → 规范严重度查询。diag_new 在 sev=="" 时以此作为兜底默认值；
// 调用点显式传 sev 时优先（如 T_ANNOTATION_UNKNOWN 的 warning 用例）。
diag_sev fn(code: string) string {
    if (code == "T_TYPE_MISMATCH") { return "error"; }
    if (code == "T_TYPE_IMPLICIT_CAST") { return "error"; }
    if (code == "T_STMT_IMPLICIT_BOOL") { return "error"; }
    if (code == "T_PARSE_INVALID_EXPR") { return "error"; }
    if (code == "T_FLAG_OFFSET_CONFLICT") { return "error"; }
    if (code == "T_FLAG_OVERFLOW") { return "error"; }
    if (code == "T_DERIVE_UNSUPPORTED") { return "error"; }
    if (code == "T_ANNOTATION_INVALID_ARG") { return "error"; }
    if (code == "T_ANNOTATION_UNKNOWN") { return "error"; }
    if (code == "T_ANNOTATION_WRONG_TARGET") { return "error"; }
    if (code == "T_IMPORT_IO") { return "error"; }
    if (code == "T_IMPORT_HEADER") { return "error"; }
    if (code == "T_IMPORT_VALUE") { return "error"; }
    if (code == "T_IMPORT_CONTEXT") { return "error"; }
    if (code == "T_EXPORT_SCOPE") { return "error"; }
    if (code == "T_IMPORT_NOT_FOUND") { return "error"; }
    if (code == "T_IMPORT_CYCLE") { return "error"; }
    if (code == "T_UNKNOWN_FIELD") { return "error"; }
    return "";
}
// <<< GEN:diagnostics <<<

diag_set_vv fn(di: i64, head: i64) void {
    var d: Diag = diags[di];
    d.vv = head;
    slice_set(diags, di, d);
}

diag_set_fs fn(di: i64, head: i64) void {
    var d: Diag = diags[di];
    d.fs = head;
    slice_set(diags, di, d);
}

diag_set_nt fn(di: i64, head: i64) void {
    var d: Diag = diags[di];
    d.nt = head;
    slice_set(diags, di, d);
}

// 字符串链表构建器（validValues / notes）
var slb_head: i64;
var slb_tail: i64;

slb_begin fn() void {
    slb_head = -1;
    slb_tail = -1;
}

slb_add fn(s: string) void {
    var it: SI;
    it.s = s;
    it.next = -1;
    append(sitems, it);
    var idx: i64 = (slice_len(sitems) as i64) - 1;
    if (slb_tail >= 0) {
        var p: SI = sitems[slb_tail];
        p.next = idx;
        slice_set(sitems, slb_tail, p);
    } else {
        slb_head = idx;
    }
    slb_tail = idx;
}

fix_one fn(desc: string, file: string, sl: i64, sc: i64, el: i64, ec: i64, repl: string) i64 {
    var f: FixS;
    f.desc = desc;
    f.file = file;
    f.sl = sl;
    f.sc = sc;
    f.el = el;
    f.ec = ec;
    f.repl = repl;
    f.next = -1;
    append(fixes, f);
    return (slice_len(fixes) as i64) - 1;
}

// ── 字符串小工具 ───────────────────────────────────────────────

sb_cat2 fn(a: string, b: string) string {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, a);
    sb_append_str(sb, b);
    return sb_to_str(sb);
}

sb_cat3 fn(a: string, b: string, c: string) string {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, a);
    sb_append_str(sb, b);
    sb_append_str(sb, c);
    return sb_to_str(sb);
}

