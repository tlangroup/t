pub fn sb_cat9(a: string, b: string, c: string, d: string, e: string, f: string, g: string, h: string, i: string) string {
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, a);
    sb_append_str(sb, b);
    sb_append_str(sb, c);
    sb_append_str(sb, d);
