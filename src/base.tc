pub fn mk_ImportDecl(sb: string, sc: string, has_sa: bool, has_sc: bool, la: i64, ti: i64) u64 {
    var id: i64 = node_new("ImportDecl");
    var n: Node = nodes[id];
    n.sb = sb;
    node_set_sc((id as u64), sc);   // S4 §0.14.7 SoA：取代 `n.sc = sc`（形参保留，调用点不变）
    node_set_has_sa((id as u64), has_sa);   // S4 §0.14.7 SoA：取代 `n.has_sa = has_sa`
    node_set_has_sc((id as u64), has_sc);
    n.la = la;
    slice_set(nodes, id, n);
    if (ti >= 0) { node_at(id, ti); }
        cst_register_RecImportDecl(sb, sc, has_sa, has_sc, la); // S2 dual-write
    return id;
}

// 模块导入 `import xxx [as m]`（M-Module）：sb=模块名, sc=别名(可空), has_sc=有别名；
// bc=被 export 修饰（非法，check 期报 T_EXPORT_SCOPE）。
pub fn mk_ImportModDecl(sb: string, sc: string, has_sc: bool, is_lib_path: bool, la: i64, ti: i64) u64 {
    var id: i64 = node_new("ImportModDecl");
    var n: Node = nodes[id];
    n.sb = sb;
    node_set_sc((id as u64), sc);   // S4 §0.14.7 SoA：取代 `n.sc = sc`（形参保留，调用点不变）
    node_set_has_sc((id as u64), has_sc);   // S4 §0.14.7 SoA：取代 `n.has_sc = has_sc`
    node_set_bd((id as u64), is_lib_path);   // S4 §0.14.7 SoA：取代 `n.bd = is_lib_path`（true = 走库搜索路径）
    n.la = la;
    slice_set(nodes, id, n);
    if (ti >= 0) { node_at(id, ti); }
        cst_register_RecImportModDecl(sb, sc, has_sc, is_lib_path, la); // S2 dual-write
    return id;
}

