// ═══════════════════════════════════════════════════════════════
// src/base.tc — 第 0 层：编译器公共基础设施
//
// 内容：token 池与扁平 Node 池、源文件/位置信息、诊断（错误码 + 收集器）、
//       字符串 / 切片 / XID 表等纯工具函数。
// 依赖：无（DAG 根）。其余所有模块 import 本模块。
//
// ── 编译器分层（import DAG，靠前者不得引用靠后者的符号）──────────
//   base → lex → parse → sema → codegen_c → codegen_ll → tc
// 校验：node tools/dagcheck.mjs 应报「0 处反向引用」。
// ═══════════════════════════════════════════════════════════════

// ⚠ GEN 区间冻结说明：本文件中所有 `// >>> GEN:xxx >>> … <<< GEN:xxx <<<` 区间
// 原由数据驱动生成器 `tools/totter.tc`（读取 out/ebnf.json）生成。
// totter 自 M38 起**已放弃（abandoned）**，不再运行、不再重跑，故这些区间现已冻结，
// 改为手写维护（如需改动，直接在 src/tc.tc 内编辑，不要等待 totter 重新生成）。
// out/ebnf.json 与 gen/tc.tc 同为冻结快照。

// S1：节点种类（kind）注册表 + 数值枚举 `NK_*` + `nk_name()` / `nk_of_kind()`
// 已迁入库模块 std.rc.cst（lib/std/rc/cst.tc 的 GEN:kinds 区间，由 tools/cstgen.mjs 生成）。
// 用 `pub @import(... :: *)` 通配**重导出**，使 `base.init_node_kinds()`（src/tc.tc:104）
// 等既有引用继续解析到 cst 的真实定义（引用点零改动）。
pub @import("std.rc.cst" :: *);

// >>> GEN:node-structs (generated by tools/cstgen.mjs from tools/cst_nodes.json -- DO NOT EDIT) >>>
// ── S2：按 kind 分表（struct-of-arrays）的运行时子集 ──
// 由 tools/cstgen.mjs 依据 tools/cst_nodes.json 生成：每个 kind 一组
// 逐字段独立 typed 全局切片 tbl_<RecK>_<field> + Rec<K> 结构 + cst_register_<RecK> 双写登记
// + cst_get_<RecK> 读取。运行时可变全局刻意落在主程序模块 base.tc（§4.14.7：库模块
// 跳过 t__ginit，可变全局会被静默清零）。旧 nodes[] 仍是真相源，本区为其 SoA 镜像。

// 平行 NodeRef 数组 g_node_nref（默认 0 = 未登记），node_new 双写保证正确。
pub var g_node_nref: []u64;
pub fn cst_nref_of(id: i64) u64 {
    if (id < 0 || id >= slice_len(g_node_nref)) { return 0; }
    return g_node_nref[id];
}

