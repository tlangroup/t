// P1 Stage 1b（everything-is-value）：**多语句值块** `{ s1; ...; sn; e; }`。
// 与语句块（kind=="block"）共用 la 语句链表，但独立 kind，以便 sema/tir/codegen_c
// 在**表达式**分派里单独取值（块值 = 尾随表达式的值）。
// 单语句块 `{ e; }` 不走这里——parse 直接脱糖为该表达式（Stage 1a 快路径，零后端改动）。
pub fn mk_block_expr(la: i64, ti: i64) i64 {
    var id: i64 = node_new("block_expr");
    var n: Node = nodes[id];
    n.la = la;
    slice_set(nodes, id, n);
    if (ti >= 0) { node_at(id, ti); }
    return id;
}

