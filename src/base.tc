// 位串段：`<<v:W, rest/bitstr>>`。nb=-1 表示变长尾段；sa="" 默认大端，可 "/big"/"/little"。
pub fn mk_bitstr_seg(na: i64, nb: i64, sa: string, rest: bool, ti: i64) u64 {
    var id: i64 = node_new("bitstr_seg");
    var n: Node = nodes[id];
    n.na = na;
    n.nb = nb;
    n.sa = sa;
    node_set_ba((id as u64), rest);   // S4 §0.14.7 SoA：取代 `n.ba = rest`
    slice_set(nodes, id, n);
    if (ti >= 0) { node_at(id, ti); }
        cst_register_RecBitstrSeg(na, nb, sa, rest); // S2 dual-write
    return id;
}

