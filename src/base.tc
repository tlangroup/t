// 解引用 `*r`：na=操作数（须为 pointer 类型）。
pub fn mk_deref(na: i64, ti: i64) i64 {
    var id: i64 = node_new("deref");
    var n: Node = nodes[id];
    n.na = na;
    slice_set(nodes, id, n);
    if (ti >= 0) { node_at(id, ti); }
    return id;
}

// 区间字面量：na=起点表达式（-1 = 省略），nb=终点表达式（-1 = 省略），ba=闭合区间（`..=`）
pub fn mk_range(na: i64, nb: i64, ba: bool, ti: i64) i64 {
    var id: i64 = node_new("range");
    var n: Node = nodes[id];
    n.na = na;
    n.nb = nb;
    n.ba = ba;
    slice_set(nodes, id, n);
    if (ti >= 0) { node_at(id, ti); }
    return id;
}

// 切片/数组模式 `[a, b, .., last]`（S6）：children(la) 为各元素模式节点，
// 顺序存放；元素节点可以是 绑定 ident / 字面量 / `_`(ident sa="_") / `rest`(kind=="rest")。
// na = `..` 在 children 中的位置（-1 表示无 rest，精确长度匹配）；nb = children 总数。
pub fn mk_slice_pat(la: i64, rest: i64, count: i64, ti: i64) i64 {
    var id: i64 = node_new("slice_pat");
    var n: Node = nodes[id];
    n.la = la;
    n.na = rest;
    n.nb = count;
    slice_set(nodes, id, n);
    if (ti >= 0) { node_at(id, ti); }
    return id;
}

pub fn mk_rest(ti: i64) i64 {
    var id: i64 = node_new("rest");
    if (ti >= 0) { node_at(id, ti); }
    return id;
}

// 区间的**成员测试**合成：`subj >= lo && subj < hi`（`..=` 用 `<=`）。
// 端点省略就少一个合取项；两端全省（`..`）恒真。
//
// ⚠ subj_a / subj_b 必须是两个**独立**的表达式节点：合成结果里 subject 出现两次，
//   后端按树发射会各求值一次。调用方要么传两个 mk_ident（match 已把被匹配值绑到
//   临时量，天然满足），要么先确认 subject 无副作用（sema 的 `in` 走 rng_pure 判定）。
//
// 放在 base 而不是 sema：`match` 的范围臂在 codegen 的 match_chain_from 里才合成
//   （C / LLVM 双后端共用同一份脱糖），那一层看不见 sema。
pub fn mk_range_test(subj_a: i64, subj_b: i64, r: i64) i64 {
    var rn: Node = nodes[r];
    var lo_t: i64 = -1;
    var hi_t: i64 = -1;
    if (rn.na >= 0) { lo_t = mk_binary(">=", subj_a, rn.na, -1); }
    if (rn.nb >= 0) {
        var hop: string = "<";
        if (rn.ba == true) { hop = "<="; }
        hi_t = mk_binary(hop, subj_b, rn.nb, -1);
    }
    if (lo_t < 0) {
        if (hi_t < 0) { return mk_bool(true, -1); }
        return hi_t;
    }
    if (hi_t < 0) { return lo_t; }
    return mk_binary("&&", lo_t, hi_t, -1);
}

