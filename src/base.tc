// 静态定长数组已编译期初始化，无需运行时填充（保留空函数以维持调用点兼容）。
fn diag_ensure() void {
}

// 机器码/旧语义名 -> 规范化机器码（双标识）。未知码原样返回。
fn diag_norm(id: string) string {
    if (diag_find_idx(id) >= 0) { return id; }
    var i: i64 = 0;
    while (i < g_legcount) {
        if (g_leg_name[i] == id) { return g_dcode[g_leg_idx[i]]; }
        i = i + 1;
    }
    return id;
}

fn diag_find_idx(code: string) i64 {
    var i: i64 = 0;
    while (i < g_dcount) {
        if (g_dcode[i] == code) { return i; }
        i = i + 1;
    }
    return -1;
}

// 兼容旧 diag_sev(code)：返回规范化后的严重度（未知码回退 error）。
fn diag_sev(code: string) string {
    var mc: string = diag_norm(code);
    var idx: i64 = diag_find_idx(mc);
    if (idx >= 0) { return g_dsev[idx]; }
    return "error";
}
// <<< GEN:diagnostics <<<

pub fn diag_new(code: string, sev: string, msg: string, file: string, sl: i64, sc: i64, el: i64, ec: i64) i64 {
    // 归一化：旧语义名 / 机器码 -> 规范化机器码（双标识，见 docs/diagnostics.md §1.2.3）
    // ⚠ g_dcode 现为 [160]string 静态定长数组（编译期已初始化），不得对定长数组调用
    // slice_len（[N]T→[]T 无隐式转换，C 后端会 t_slice_len(TStr*) 类型不符）；改用 g_dcount。
    if (g_dcount == 0) { diag_ensure(); }
    var mc: string = diag_norm(code);
    var idx: i64 = diag_find_idx(mc);
    var rsev: string = sev;
    var rcat: string = "";
    var rname: string = "";
    var rlegacy: string = "";
    var rnote: string = "";
    if (idx >= 0) {
        rcat = g_dcat[idx];
        rname = g_dname[idx];
        rlegacy = g_dlegacy[idx];
        rnote = g_dnote[idx];
        if (rsev == "") { rsev = g_dsev[idx]; }
    } else {
        if (rsev == "") { rsev = "error"; }
    }
    if (g_diag_mute) { rsev = "muted"; }
    var d: Diag;
    d.code = mc;
    d.sev = rsev;
    d.cat = rcat;
    d.name = rname;
    d.legacy = rlegacy;
    d.note = rnote;
    d.msg = msg;
    d.file = file;
    d.sl = sl;
    d.sc = sc;
    d.el = el;
    d.ec = ec;
    d.vv = -1;
    d.fs = -1;
    d.nt = -1;
    // 幂等去重：同一 (code, file, 位置, 文案) 只保留一条。
    // 检查器对同一子表达式可能推导多次（例如内建实参既被专属分支推、又被
    // 兜底补扫推一遍），若不去重，用户会看到成对的重复报错。诊断数量在正常
    // 编译里是 0~个位数，线性扫描的代价可以忽略。
    var dq: i64 = 0;
    var dqn: i64 = slice_len(diags) as i64;
    while (dq < dqn) {
        var od: Diag = diags[dq];
        if (od.code == mc && od.file == file && od.sl == sl && od.sc == sc && od.msg == msg) {
            return dq;
        }
        dq = dq + 1;
    }
    append(diags, d);
    return (slice_len(diags) as i64) - 1;
}



pub fn diag_set_vv(di: i64, head: i64) void {
    var d: Diag = diags[di];
    d.vv = head;
    slice_set(diags, di, d);
}

pub fn diag_set_fs(di: i64, head: i64) void {
    var d: Diag = diags[di];
    d.fs = head;
    slice_set(diags, di, d);
}

pub fn diag_set_nt(di: i64, head: i64) void {
    var d: Diag = diags[di];
    d.nt = head;
    slice_set(diags, di, d);
}

// 字符串链表构建器（validValues / notes）
pub var slb_head: i64;
pub var slb_tail: i64;

pub fn slb_begin() void {
    slb_head = -1;
    slb_tail = -1;
}

pub fn slb_add(s: string) void {
    var it: SI;
    it.s = s;
    it.next = -1;
    append(sitems, it);
    var idx: i64 = (slice_len(sitems) as i64) - 1;
    if (slb_tail >= 0) {
        var p: SI = sitems[slb_tail];
        p.next = idx;
        slice_set(sitems, slb_tail, p);
    } else {
        slb_head = idx;
    }
    slb_tail = idx;
}

pub fn fix_one(desc: string, file: string, sl: i64, sc: i64, el: i64, ec: i64, repl: string) i64 {
    var f: FixS;
    f.desc = desc;
    f.file = file;
    f.sl = sl;
    f.sc = sc;
    f.el = el;
    f.ec = ec;
    f.repl = repl;
    f.next = -1;
    append(fixes, f);
    return (slice_len(fixes) as i64) - 1;
}

