pub fn mk_FuncDecl(sa: string, ba: bool, bb: bool, na: i64, la: i64, lb: i64, lc: i64, ti: i64) u64 {
    var id: i64 = node_new("FuncDecl");
    var n: Node = nodes[id];
    n.sa = sa;
    node_set_ba((id as u64), ba);   // S4 §0.14.7 SoA：取代 `n.ba = ba`（形参保留，调用点不变）
    node_set_bb((id as u64), bb);   // S4 §0.14.7 SoA：取代 `n.bb = bb`（形参保留，调用点不变）
    n.na = na;
    n.la = la;
    n.lb = lb;
    node_set_lc((id as u64), lc);   // S4 §0.14.7 SoA：取代 `n.lc = lc`（形参保留，调用点不变；第十一批）
    slice_set(nodes, id, n);
    if (ti >= 0) { node_at(id, ti); }
        cst_register_RecFuncDecl(sa, ba, bb, na, la, lb, lc); // S2 dual-write
    return id;
}

