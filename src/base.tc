// ═══════════════════════════════════════════════════════════════
// src/base.tc — 第 0 层：编译器公共基础设施
//
// 内容：token 池与扁平 Node 池、源文件/位置信息、诊断（错误码 + 收集器）、
//       字符串 / 切片 / XID 表等纯工具函数。
// 依赖：无（DAG 根）。其余所有模块 import 本模块。
//
// ── 编译器分层（import DAG，靠前者不得引用靠后者的符号）──────────
//   base → lex → parse → sema → codegen_c → codegen_ll → tc
// 校验：node tools/dagcheck.mjs 应报「0 处反向引用」。
// ═══════════════════════════════════════════════════════════════

// ⚠ GEN 区间冻结说明：本文件中所有 `// >>> GEN:xxx >>> … <<< GEN:xxx <<<` 区间
// 原由数据驱动生成器 `tools/totter.tc`（读取 out/ebnf.json）生成。
// totter 自 M38 起**已放弃（abandoned）**，不再运行、不再重跑，故这些区间现已冻结，
// 改为手写维护（如需改动，直接在 src/tc.tc 内编辑，不要等待 totter 重新生成）。
// out/ebnf.json 与 gen/tc.tc 同为冻结快照。

// ── token 池 ───────────────────────────────────────────────────

Tok struct {
    t: string;      // token 类型名（同 lex --json 的 type）
    v: string;      // 文本值
    line: u64;
    col: u64;
}

var toks: []Tok;

// >>> GEN:ast (generated by tools/totter.tc from out/ebnf.json nodes -- DO NOT EDIT) >>>
// ── AST 节点池（扁平化，索引引用）──────────────────────────────
// 约定：
//   na/nb/nc/nd : 子节点索引，-1 = null
//   la/lb/lc    : 子节点列表头（Child 池索引），-1 = 空列表，-2 = null 列表
//   sa/sb/sc    : 字符串载荷；has_sa=false 表示 sa 语义为 null
//   ia/ib       : 整型载荷（radix / bitWidth / offset），-1 = null
//   ba/bb       : 布尔载荷（isConst/isExtern/isComptime/isBitpack...）

Node struct {
    kind: string;
    sa: string;
    sb: string;
    sc: string;
    has_sa: bool;
    has_sb: bool;
    has_sc: bool;
    ia: i64;
    ib: i64;
    ba: bool;
    bb: bool;
    bc: bool;   // 模块系统：该声明是否被 `export` 修饰（顶层可见性）
    bd: bool;   // 模块系统：该 import 是否走库搜索路径（true=lib/依赖库，false=src 源码根；见 parse_import_decl / handle_one_import）
    na: i64;
    nb: i64;
    nc: i64;
    nd: i64;
    la: i64;
    lb: i64;
    lc: i64;
    ln: u64;    // anchor token 行（诊断用；0 = 无）
    cl: u64;    // anchor token 列
    tv: string; // anchor token 文本（endCol = col + len(tv)）
}

var nodes: []Node;

// ── 命名空间隔离（外部库真正落地）──────────────────────────────
// provenance：每个 AST 节点记录它是在哪个模块（别名）里被解析出来的。
// 入口（main）模块别名 = ""，不参与名字重整（mangling）。
var g_cur_mod: string;              // 解析期当前模块别名（load_module_file 内设置）
var g_node_mod: []string;           // 与 nodes 平行的数组：nodes[i] 所属模块别名（"" = 入口）

Child struct {
    val: i64;
    next: i64;
}

var kids: []Child;

// 新建节点：全部字段置于"空"语义，返回索引
node_new fn(kind: string) i64 {
    var n: Node;
    n.kind = kind;
    n.sa = "";
    n.sb = "";
    n.sc = "";
    n.has_sa = true;
    n.has_sb = true;
    n.has_sc = true;
    n.ia = -1;
    n.ib = -1;
    n.ba = false;
    n.bb = false;
    n.bc = false;
    n.bd = false;
    n.na = -1;
    n.nb = -1;
    n.nc = -1;
    n.nd = -1;
    n.la = -1;
    n.lb = -1;
    n.lc = -1;
    n.ln = 0;
    n.cl = 0;
    n.tv = "";
    append(nodes, n);
    append(g_node_mod, g_cur_mod);   // provenance：记录本节点所属模块别名（"" = 入口）
    return (slice_len(nodes) as i64) - 1;
}

// 给节点打 anchor token（诊断定位用），tok 索引 → line/col/text
node_at fn(ni: i64, ti: i64) void {
    var tk: Tok = toks[ti];
    var n: Node = nodes[ni];
    n.ln = tk.line;
    n.cl = tk.col;
    n.tv = tk.v;
    slice_set(nodes, ni, n);
}

// ── 节点种类注册表（来自 reference.md §2.9 NodeTable）──
var node_kind_names: []string;

init_node_kinds fn() void {
    append(node_kind_names, "A");
    append(node_kind_names, "CS");
    append(node_kind_names, "EN");
    append(node_kind_names, "EnumDecl");
    append(node_kind_names, "F");
    append(node_kind_names, "FV");
    append(node_kind_names, "FlagDecl");
    append(node_kind_names, "FlagSetDecl");
    append(node_kind_names, "FuncDecl");
    append(node_kind_names, "func_type");
    append(node_kind_names, "lambda");        // 闭包字面量（M46）：na=返回类型, lb=参数 P 链, lc=body 语句链, sa=合成函数名(脱糖回填), la=捕获 ident 链
    append(node_kind_names, "closure_make");  // 闭包构造点（M48）：sa=合成函数名, sb=环境结构名, la=捕获 ident 链；emit 时堆分配环境+TClosure 并返回指针
    append(node_kind_names, "closure_capture"); // 闭包体首重建捕获变量的语句（M48）：sa=捕获变量名, sb=环境结构名, na=类型节点, ia=环境结构字段下标
    append(node_kind_names, "GlobalConstDecl");
    append(node_kind_names, "GlobalVarDecl");
    append(node_kind_names, "ImportDecl");
    append(node_kind_names, "ImportModDecl");   // 模块导入 `import xxx [as m]`：sb=模块名, sc=别名(可空), has_sc=有别名, bc=被 export 修饰(非法)
    append(node_kind_names, "M");
    append(node_kind_names, "P");
    append(node_kind_names, "SL");
    append(node_kind_names, "StructDecl");
    append(node_kind_names, "TypeAliasDecl");
    append(node_kind_names, "UnionDecl");
    append(node_kind_names, "V");
    append(node_kind_names, "VC");
    append(node_kind_names, "VariantDecl");
    append(node_kind_names, "arm");
    append(node_kind_names, "array");
    append(node_kind_names, "array_lit");
    append(node_kind_names, "assign");
    append(node_kind_names, "assignment");
    append(node_kind_names, "binary");
    append(node_kind_names, "block");
    append(node_kind_names, "bool");
    append(node_kind_names, "break");
    append(node_kind_names, "call");
    append(node_kind_names, "cast");
    append(node_kind_names, "comptime");
    append(node_kind_names, "comptime_block");
    append(node_kind_names, "continue");
    append(node_kind_names, "defer");
    append(node_kind_names, "expr");
    append(node_kind_names, "flag");
    append(node_kind_names, "flag_set");
    append(node_kind_names, "float");
    append(node_kind_names, "for");
    append(node_kind_names, "for_each");
    append(node_kind_names, "ident");
    append(node_kind_names, "if");
    append(node_kind_names, "index");
    append(node_kind_names, "int");
    append(node_kind_names, "list");
    append(node_kind_names, "map");
    append(node_kind_names, "map_lit");
    append(node_kind_names, "mbuiltin");
    append(node_kind_names, "match");
    append(node_kind_names, "member");
    append(node_kind_names, "named");
    append(node_kind_names, "null");
    append(node_kind_names, "number");
    append(node_kind_names, "optional");
    append(node_kind_names, "paren");
    append(node_kind_names, "pointer");
    append(node_kind_names, "return");
    append(node_kind_names, "scalar");
    append(node_kind_names, "slice");
    append(node_kind_names, "string");
    append(node_kind_names, "atom");        // Erlang 式原子字面量（M50）
    append(node_kind_names, "fidconst");    // 内建文件描述符常量 stdin/stdout/stderr（M51）
    append(node_kind_names, "serialize");   // 序列化操作符 `fid < value`（M51，由 binary "<" 脱糖）
    append(node_kind_names, "struct_lit");
    append(node_kind_names, "unary");
    append(node_kind_names, "var_decl");
    append(node_kind_names, "variant");
    append(node_kind_names, "while");
}

is_node_kind fn(k: string) bool {
    var i: i64 = 0;
    while (i < slice_len(node_kind_names) as i64) {
        if (node_kind_names[i] == k) { return true; }
        i = i + 1;
    }
    return false;
}

// ── 节点构造器（槽参数按 Node 字段序，末位 ti；ti < 0 表示不打 anchor）──

mk_A fn(sa: string, la: i64, ti: i64) i64 {
    var id: i64 = node_new("A");
    var n: Node = nodes[id];
    n.sa = sa;
    n.la = la;
    slice_set(nodes, id, n);
    if (ti >= 0) { node_at(id, ti); }
    return id;
}

mk_EN fn(na: i64, nb: i64, ti: i64) i64 {
    var id: i64 = node_new("EN");
    var n: Node = nodes[id];
    n.na = na;
    n.nb = nb;
    slice_set(nodes, id, n);
    if (ti >= 0) { node_at(id, ti); }
    return id;
}

