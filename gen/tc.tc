// <<< GEN:xid <<<

fn is_digit(c: u8) -> bool {
    return c >= 48 && c <= 57;
}

// 标识符首字符：XID_Start + 下划线（向后兼容 ASCII 习惯）。
fn is_ident_start(cp: i64) -> bool {
    if (cp == 95) { return true; }
    return cp_in_ranges(cp, xid_start_lo, xid_start_hi);
}

// 标识符续字符：XID_Continue + 下划线 + 数字（数字本就在 XID_Continue 内，显式列出无害）。
fn is_ident_cont(cp: i64) -> bool {
    if (cp == 95) { return true; }
    if (cp >= 48 && cp <= 57) { return true; }
    return cp_in_ranges(cp, xid_cont_lo, xid_cont_hi);
}

fn is_hex_digit(c: u8) -> bool {
    if (c >= 48 && c <= 57) { return true; }
    if (c >= 97 && c <= 102) { return true; }
    return c >= 65 && c <= 70;
}

fn is_bin_digit(c: u8) -> bool {
    return c == 48 || c == 49;
}

// >>> GEN:kw_lookup (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
KwEntry struct {
    text: string;
    kind: string;
}

var keywords_tbl: []KwEntry;

fn kw_reg(t: string, k: string) -> void {
    var e: KwEntry;
    e.text = t;
    e.kind = k;
    append(keywords_tbl, e);
}

fn init_keywords() -> void {
    kw_reg("func", "KwFunc");
    kw_reg("struct", "KwStruct");
    kw_reg("enum", "KwEnum");
    kw_reg("flag", "KwFlag");
    kw_reg("union", "KwUnion");
    kw_reg("variant", "KwVariant");
    kw_reg("var", "KwVar");
    kw_reg("const", "KwConst");
    kw_reg("comptime", "KwComptime");
    kw_reg("if", "KwIf");
    kw_reg("else", "KwElse");
    kw_reg("for", "KwFor");
    kw_reg("while", "KwWhile");
    kw_reg("switch", "KwSwitch");
    kw_reg("case", "KwCase");
    kw_reg("default", "KwDefault");
    kw_reg("break", "KwBreak");
    kw_reg("continue", "KwContinue");
    kw_reg("return", "KwReturn");
    kw_reg("true", "KwTrue");
    kw_reg("false", "KwFalse");
    kw_reg("null", "KwNull");
    kw_reg("map", "KwMap");
    kw_reg("import", "KwImport");
    kw_reg("export", "KwExport");
    kw_reg("as", "KwAs");
    kw_reg("in", "KwIn");
    kw_reg("defer", "KwDefer");
    kw_reg("void", "KwVoid");
    kw_reg("string", "KwString");
    kw_reg("StringBuilder", "KwStringBuilder");
}

fn kw_lookup(text: string) -> string {
    var i: i64 = 0;
    while (i < (slice_len(keywords_tbl) as i64)) {
        if (keywords_tbl[i].text == text) { return keywords_tbl[i].kind; }
        i = i + 1;
    }
    return "";
}
// <<< GEN:kw_lookup <<<


fn op2_name(a: u8, b: u8) -> string {
    if (a == 45 && b == 62) { return "Arrow"; }
    if (a == 58 && b == 58) { return "DoubleColon"; }
    if (a == 61 && b == 61) { return "Eq"; }
    if (a == 33 && b == 61) { return "NotEq"; }
    if (a == 60 && b == 61) { return "LtEq"; }
    if (a == 62 && b == 61) { return "GtEq"; }
    if (a == 38 && b == 38) { return "And"; }
    if (a == 124 && b == 124) { return "Or"; }
    if (a == 60 && b == 60) { return "ShiftLeft"; }
    if (a == 62 && b == 62) { return "ShiftRight"; }
    if (a == 46 && b == 46) { return "DoubleDot"; }
    if (a == 43 && b == 61) { return "PlusAssign"; }
    if (a == 45 && b == 61) { return "MinusAssign"; }
    if (a == 42 && b == 61) { return "StarAssign"; }
    if (a == 47 && b == 61) { return "SlashAssign"; }
    if (a == 37 && b == 61) { return "PercentAssign"; }
    if (a == 38 && b == 61) { return "BitAndAssign"; }
    if (a == 124 && b == 61) { return "BitOrAssign"; }
    if (a == 94 && b == 61) { return "BitXorAssign"; }
    return "";
}

fn op1_name(c: u8) -> string {
    if (c == 43) { return "Plus"; }
    if (c == 45) { return "Minus"; }
    if (c == 42) { return "Star"; }
    if (c == 47) { return "Slash"; }
    if (c == 37) { return "Percent"; }
    if (c == 61) { return "Assign"; }
    if (c == 60) { return "Lt"; }
    if (c == 62) { return "Gt"; }
    if (c == 33) { return "Not"; }
    if (c == 38) { return "BitAnd"; }
    if (c == 124) { return "BitOr"; }
    if (c == 94) { return "BitXor"; }
    if (c == 126) { return "BitNot"; }
    if (c == 58) { return "Colon"; }
    if (c == 46) { return "Dot"; }
    if (c == 63) { return "Question"; }
    if (c == 40) { return "LParen"; }
    if (c == 41) { return "RParen"; }
    if (c == 123) { return "LBrace"; }
    if (c == 125) { return "RBrace"; }
    if (c == 91) { return "LBracket"; }
    if (c == 93) { return "RBracket"; }
    if (c == 44) { return "Comma"; }
    if (c == 59) { return "Semicolon"; }
    return "";
}

// ── token 入池 ─────────────────────────────────────────────────

fn push_tok(tname: string, value: string, line: u64, col: u64) -> void {
    var tk: Tok;
    tk.t = tname;
    tk.v = value;
    tk.line = line;
    tk.col = col;
    append(toks, tk);
}

// ── lexer：源码 → token 池（逻辑照抄 lexer.tc）─────────────────

fn tokenize(src: string) -> void {
    var tmp: StringBuilder = sb_new();
    var i: u64 = 0;
    var n: u64 = str_len(src);
    var line: u64 = 1;
    var col: u64 = 1;

    while (i < n) {
        var c: u8 = src[i];

        if (c == 32 || c == 9 || c == 13) {
            i = i + 1;
            col = col + 1;
            continue;
        }
        if (c == 10) {
            i = i + 1;
            line = line + 1;
            col = 1;
            continue;
        }

        if (c == 47 && i + 1 < n && src[i + 1] == 47) {
            while (i < n && src[i] != 10) {
                i = i + 1;
                col = col + 1;
            }
            continue;
        }

        if (c == 47 && i + 1 < n && src[i + 1] == 42) {
            i = i + 2;
            col = col + 2;
            var closed: bool = false;
            while (i < n) {
                if (src[i] == 42 && i + 1 < n && src[i + 1] == 47) {
                    i = i + 2;
                    col = col + 2;
                    closed = true;
                    break;
                }
                if (src[i] == 10) {
                    line = line + 1;
                    col = 1;
                } else {
                    col = col + 1;
                }
                i = i + 1;
            }
            if (closed == false) {
                eprint("error: unterminated block comment\n");
                exit(1);
            }
            continue;
        }

        if (is_digit(c)) {
            var tl: u64 = line;
            var tcol: u64 = col;

            if (c == 48 && i + 1 < n && (src[i + 1] == 120 || src[i + 1] == 88)) {
                sb_clear(tmp);
                sb_append_str(tmp, "0x");
                i = i + 2;
                col = col + 2;
                var hexcnt: u64 = 0;
                while (i < n && is_hex_digit(src[i])) {
                    sb_append_char(tmp, src[i]);
                    i = i + 1;
                    col = col + 1;
                    hexcnt = hexcnt + 1;
                }
                if (hexcnt == 0) {
                    eprint("error: hex literal has no digits after 0x\n");
                    exit(1);
                }
                push_tok("Integer", sb_to_str(tmp), tl, tcol);
                continue;
            }

            if (c == 48 && i + 1 < n && (src[i + 1] == 98 || src[i + 1] == 66)) {
                sb_clear(tmp);
                sb_append_str(tmp, "0b");
                i = i + 2;
                col = col + 2;
                var bincnt: u64 = 0;
                while (i < n && is_bin_digit(src[i])) {
                    sb_append_char(tmp, src[i]);
                    i = i + 1;
                    col = col + 1;
                    bincnt = bincnt + 1;
                }
                if (bincnt == 0) {
                    eprint("error: binary literal has no digits after 0b\n");
                    exit(1);
                }
                push_tok("Integer", sb_to_str(tmp), tl, tcol);
                continue;
            }

            var ns: u64 = i;
            while (i < n && is_digit(src[i])) {
                i = i + 1;
                col = col + 1;
            }

            if (i < n && src[i] == 46 && i + 1 < n && is_digit(src[i + 1])) {
                i = i + 1;
                col = col + 1;
                while (i < n && is_digit(src[i])) {
                    i = i + 1;
                    col = col + 1;
                }
                if (i < n && (src[i] == 101 || src[i] == 69)) {
                    i = i + 1;
                    col = col + 1;
                    if (i < n && (src[i] == 43 || src[i] == 45)) {
                        i = i + 1;
                        col = col + 1;
                    }
                    while (i < n && is_digit(src[i])) {
                        i = i + 1;
                        col = col + 1;
                    }
                }
                push_tok("Float", str_slice(src, ns, i), tl, tcol);
                continue;
            }

            push_tok("Integer", str_slice(src, ns, i), tl, tcol);
            continue;
        }

        if (c == 34) {
            var sl: u64 = line;
            var scol: u64 = col;
            i = i + 1;
            col = col + 1;
            sb_clear(tmp);
            while (i < n && src[i] != 34) {
                if (src[i] == 92) {
                    i = i + 1;
                    col = col + 1;
                    if (i >= n) {
                        break;
                    }
                    var e: u8 = src[i];
                    if (src[i] == 10) {
                        line = line + 1;
                        col = 1;
                    } else {
                        col = col + 1;
                    }
                    i = i + 1;
                    if (e == 110) {
                        sb_append_char(tmp, 10);
                    } else {
                    if (e == 116) {
                        sb_append_char(tmp, 9);
                    } else {
                    if (e == 114) {
                        sb_append_char(tmp, 13);
                    } else {
                    if (e == 34) {
                        sb_append_char(tmp, 34);
                    } else {
                    if (e == 92) {
                        sb_append_char(tmp, 92);
                    } else {
                    if (e == 48) {
                        sb_append_char(tmp, 0);
                    } else {
                        sb_append_char(tmp, e);
                    }}}}}}
                } else {
                    if (src[i] == 10) {
                        line = line + 1;
                        col = 1;
                    } else {
                        col = col + 1;
                    }
                    sb_append_char(tmp, src[i]);
                    i = i + 1;
                }
            }
            if (i >= n) {
                eprint("error: unterminated string literal\n");
                exit(1);
            }
            i = i + 1;
            col = col + 1;
            push_tok("String", sb_to_str(tmp), sl, scol);
            continue;
        }

        if (is_ident_start(utf8_cp_at(src, i as i64, n as i64))) {
            var il: u64 = line;
            var icol: u64 = col;
            var is0: u64 = i;
            var w0: i64 = utf8_w0(src[i]);
            i = i + w0 as u64;
            col = col + w0 as u64;
            while (i < n) {
                var cpc: i64 = utf8_cp_at(src, i as i64, n as i64);
                if (is_ident_cont(cpc) == false) { break; }
                var wc: i64 = utf8_w0(src[i]);
                i = i + wc as u64;
                col = col + wc as u64;
            }
            var text: string = str_slice(src, is0, i);
            var tname: string = kw_lookup(text);
            if (str_len(tname) == 0) {
                tname = "Identifier";
            }
            push_tok(tname, text, il, icol);
            continue;
        }

        if (c == 64) {
            push_tok("At", "@", line, col);
            i = i + 1;
            col = col + 1;
            continue;
        }
        if (c == 35) {
            push_tok("Hash", "#", line, col);
            i = i + 1;
            col = col + 1;
            continue;
        }

        if (i + 2 < n && c == 60 && src[i + 1] == 60 && src[i + 2] == 61) {
            push_tok("ShlAssign", "<<=", line, col);
            i = i + 3;
            col = col + 3;
            continue;
        }
        if (i + 2 < n && c == 62 && src[i + 1] == 62 && src[i + 2] == 61) {
            push_tok("ShrAssign", ">>=", line, col);
            i = i + 3;
            col = col + 3;
            continue;
        }

        if (i + 1 < n) {
            var two: string = op2_name(c, src[i + 1]);
            if (str_len(two) > 0) {
                push_tok(two, str_slice(src, i, i + 2), line, col);
                i = i + 2;
                col = col + 2;
                continue;
            }
        }

        var one: string = op1_name(c);
        if (str_len(one) > 0) {
            push_tok(one, str_slice(src, i, i + 1), line, col);
            i = i + 1;
            col = col + 1;
            continue;
        }

        eprint("error: unexpected character\n");
        exit(1);
    }

    push_tok("Eof", "", line, col);
}

// ── parser 状态与 token 辅助 ──────────────────────────────────

var pos: i64;
var decl_list: []i64;

fn tk_t(idx: i64) -> string {
    var tk: Tok = toks[idx];
    return tk.t;
}

fn tk_v(idx: i64) -> string {
    var tk: Tok = toks[idx];
    return tk.v;
}

fn cur_t() -> string {
    return tk_t(pos);
}

fn cur_v() -> string {
    return tk_v(pos);
}

fn peek_t(off: i64) -> string {
    var idx: i64 = pos + off;
    var n: i64 = slice_len(toks) as i64;
    if (idx >= n) {
        idx = n - 1;
    }
    return tk_t(idx);
}

// 前进一个 token，返回被消费 token 的下标（Eof 处不动，返回前一个）
fn advance_i() -> i64 {
    if (cur_t() != "Eof") {
        pos = pos + 1;
    }
    return pos - 1;
}

fn expect_tok(t: string) -> string {
    if (cur_t() == t) {
        var idx: i64 = advance_i();
        return tk_v(idx);
    }
    eprint("parse error: expected ");
    eprint(t);
    eprint(" but found ");
    eprint(cur_v());
    eprint("\n");
    exit(1);
    return "";
}

// parseInt(s, 10) 语义：取前导十进制数字
fn parse_int_str(s: string) -> i64 {
    var r: i64 = 0;
    var i: u64 = 0;
    var n: u64 = str_len(s);
    while (i < n) {
        var c: u8 = s[i];
        if (is_digit(c) == false) {
            break;
        }
        r = r * 10 + ((c as i64) - 48);
        i = i + 1;
    }
    return r;
}

// 拼接两条 Child 链，返回新头
fn list_concat(a: i64, b: i64) -> i64 {
    if (a < 0) {
        return b;
    }
    if (b < 0) {
        return a;
    }
    var it: i64 = a;
    while (true) {
        var c: Child = kids[it];
        if (c.next < 0) {
            c.next = b;
            slice_set(kids, it, c);
            break;
        }
        it = c.next;
    }
    return a;
}

// ── 注解解析 ───────────────────────────────────────────────────

fn parse_annotation_args() -> i64 {
    var head: i64 = -1;
    var tail: i64 = -1;
    while (cur_t() != "RParen" && cur_t() != "Eof") {
        var t: string = cur_t();
        var made: i64 = -1;
        if (t == "String") {
            var idx: i64 = advance_i();
            made = mk_string(tk_v(idx), -1);
        } else {
        if (t == "Integer") {
            var idx2: i64 = advance_i();
            made = mk_number(tk_v(idx2), -1);
        } else {
        if (t == "Identifier") {
            var ih: i64 = -1;
            var it: i64 = -1;
            var cnt: i64 = 1;
            var idx3: i64 = advance_i();
            var id1: i64 = mk_ident(tk_v(idx3), -1);
            it = list_push(ih, it, id1);
            ih = it;
            while (cur_t() == "Comma") {
                advance_i();
                var v2: string = expect_tok("Identifier");
                var id2: i64 = mk_ident(v2, -1);
                it = list_push(ih, it, id2);
                cnt = cnt + 1;
            }
            if (cnt == 1) {
                made = id1;
            } else {
                made = mk_list(ih, -1);
            }
        } else {
            eprint("parse error: invalid annotation argument\n");
            exit(1);
        }}}
        tail = list_push(head, tail, made);
        if (head < 0) {
            head = tail;
        }
        if (cur_t() != "RParen") {
            if (cur_t() == "Comma") {
                advance_i();
            }
        }
    }
    return head;
}

fn parse_annotations() -> i64 {
    var head: i64 = -1;
    var tail: i64 = -1;
    while (cur_t() == "At") {
        advance_i();
        var name: string = "";
        var nti: i64 = pos;
        if (cur_t() == "Identifier" || cur_t() == "KwExport") {
            var idx: i64 = advance_i();
            name = tk_v(idx);
            nti = idx;
        } else {
            name = expect_tok("Identifier");
            nti = pos - 1;
        }
        if (is_lower_snake(name) == false) {
            warn_name("T_NAME_ANNOTATION_LOWER", sb_cat3("annotation name '", name, "' should be lowercase snake_case"), nti, str_len(name) as i64);
        }
        var args_head: i64 = -1;
        if (cur_t() == "LParen") {
            advance_i();
            args_head = parse_annotation_args();
            expect_tok("RParen");
        }
        var id: i64 = mk_A(name, args_head, nti);
        tail = list_push(head, tail, id);
        if (head < 0) {
            head = tail;
        }
    }
    return head;
}

// ── 类型解析 ───────────────────────────────────────────────────

// >>> GEN:scalar_pred (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
fn is_scalar_name(name: string) -> bool {
    if (name == "u8" || name == "u16" || name == "u32" || name == "u64") {
        return true;
    }
    if (name == "i8" || name == "i16" || name == "i32" || name == "i64") {
        return true;
    }
    if (name == "f16" || name == "f32" || name == "f64") {
        return true;
    }
    return name == "bool";
}
// <<< GEN:scalar_pred <<<

fn parse_type() -> i64 {
    var t: string = cur_t();
    if (t == "KwMap") {
        advance_i();
        expect_tok("LBracket");
        var kt: i64 = parse_type();
        expect_tok("RBracket");
        var vt: i64 = parse_type();
        var id: i64 = mk_map(kt, vt, -1);
        return id;
    }
    if (t == "LBracket") {
        advance_i();
        if (cur_t() == "RBracket") {
            advance_i();
            var el: i64 = parse_type();
            var id2: i64 = mk_slice(el, -1);
            return id2;
        }
        var ln: i64 = parse_expr();
        expect_tok("RBracket");
        var el2: i64 = parse_type();
        var id3: i64 = mk_array(el2, ln, -1);
        return id3;
    }
    if (t == "Star") {
        advance_i();
        var el3: i64 = parse_type();
        var id4: i64 = mk_pointer(el3, -1);
        return id4;
    }
    if (t == "Question") {
        advance_i();
        var el4: i64 = parse_type();
        var id5: i64 = mk_optional(el4, -1);
        return id5;
    }
    if (t == "KwVoid") {
        advance_i();
        return mk_scalar("void", -1);
    }
    if (t == "KwString") {
        advance_i();
        return mk_scalar("string", -1);
    }
    if (t == "KwStringBuilder") {
        advance_i();
        return mk_scalar("StringBuilder", -1);
    }
    if (t == "Identifier") {
        var idx: i64 = advance_i();
        var name: string = tk_v(idx);
        if (name == "flag") {
            if (cur_t() == "LBracket") {
                advance_i();
                var ui: i64 = advance_i();
                expect_tok("RBracket");
                var idf: i64 = mk_flag(tk_v(ui), -1);
                return idf;
            }
        }
        if (name == "flag_set") {
            return mk_flag_set(-1);
        }
        if (name == "Sym32" || name == "Sym16") {
            expect_tok("LParen");
            var tagv: string = expect_tok("String");
            expect_tok("RParen");
            var bits: i64 = 32;
            if (name == "Sym16") { bits = 16; }
            var idsym: i64 = mk_sym(tagv, bits, -1);
            return idsym;
        }
        if (name == "Variant") {
            return mk_variant(-1);
        }
        if (is_scalar_name(name)) {
            return mk_scalar(name, -1);
        }
        var idn: i64 = mk_named(name, -1);
        return idn;
    }
    eprint("parse error: expected type\n");
    exit(1);
    return -1;
}

// ── 表达式解析（优先级爬升，逐层照抄 tc0）─────────────────────

fn mk_bin(op: string, left: i64, right: i64, ti: i64) -> i64 {
    var id: i64 = mk_binary(op, left, right, ti);
    return id;
}

fn parse_expr() -> i64 {
    return parse_assign_expr();
}

fn parse_assign_expr() -> i64 {
    var left: i64 = parse_or();
    if (cur_t() == "Assign") {
        var ti: i64 = advance_i();
        var right: i64 = parse_assign_expr();
        var id: i64 = mk_assign("=", left, right, ti);
        return id;
    }
    return left;
}


// 语义胶水：前缀一元运算符构造（fold=pre 生成代码调用，tc.tc 手写保持于 GEN:parser_rules 区间外）
fn mk_un(op: string, operand: i64, ti: i64) -> i64 {
    var id: i64 = mk_unary(op, operand, ti);
    return id;
}

fn parse_post_member(e: i64, ti: i64) -> i64 {
    var member: string = expect_tok("Identifier");
    var id: i64 = mk_member(member, e, ti);
    return id;
}

fn parse_post_index(e: i64, ti: i64) -> i64 {
    var index: i64 = parse_expr();
    expect_tok("RBracket");
    var id: i64 = mk_index(e, index, ti);
    return id;
}

fn parse_post_call(e: i64, ti: i64) -> i64 {
    var head: i64 = -1;
    var tail: i64 = -1;
    while (cur_t() != "RParen" && cur_t() != "Eof") {
        var arg: i64 = parse_expr();
        tail = list_push(head, tail, arg);
        if (head < 0) {
            head = tail;
        }
        if (cur_t() == "Comma") {
            advance_i();
        } else {
            break;
        }
    }
    expect_tok("RParen");
    var id: i64 = mk_call(e, head, ti);
    return id;
}

fn parse_post_cast(e: i64, ti: i64) -> i64 {
    var tt: i64 = parse_type();
    var id: i64 = mk_cast(e, tt, ti);
    return id;
}

fn starts_with_0x(s: string) -> bool {
    if (str_len(s) < 2) {
        return false;
    }
    if (s[0] != 48) {
        return false;
    }
    return s[1] == 120 || s[1] == 88;
}

fn starts_with_0b(s: string) -> bool {
    if (str_len(s) < 2) {
        return false;
    }
    if (s[0] != 48) {
        return false;
    }
    return s[1] == 98 || s[1] == 66;
}

fn looks_like_struct_lit() -> bool {
    if (peek_t(1) == "RBrace") {
        return true;
    }
    if (peek_t(1) == "Identifier" && peek_t(2) == "Colon") {
        return true;
    }
    return false;
}

fn parse_struct_lit(type_name: string, ti: i64) -> i64 {
    advance_i();
    var head: i64 = -1;
    var tail: i64 = -1;
    while (cur_t() != "RBrace" && cur_t() != "Eof") {
        var fname: string = expect_tok("Identifier");
        expect_tok("Colon");
        var val: i64 = parse_expr();
        var fid: i64 = mk_FV(fname, val, -1);
        tail = list_push(head, tail, fid);
        if (head < 0) {
            head = tail;
        }
        if (cur_t() == "Comma") {
            advance_i();
        } else {
            break;
        }
    }
    expect_tok("RBrace");
    var id: i64 = mk_struct_lit(type_name, head, ti);
    return id;
}

fn parse_map_lit(ti: i64) -> i64 {
    var head: i64 = -1;
    var tail: i64 = -1;
    while (cur_t() != "RBracket" && cur_t() != "Eof") {
        var k: i64 = parse_expr();
        expect_tok("Colon");
        var v: i64 = parse_expr();
        var eid: i64 = mk_EN(k, v, -1);
        tail = list_push(head, tail, eid);
        if (head < 0) {
            head = tail;
        }
        if (cur_t() == "Comma") {
            advance_i();
        } else {
            break;
        }
    }
    expect_tok("RBracket");
    var id: i64 = mk_map_lit(head, ti);
    return id;
}

fn parse_array_lit(ti: i64) -> i64 {
    var is_maplit: bool = cur_t() == "Identifier" || cur_t() == "String" || cur_t() == "Integer";
    if (is_maplit && peek_t(1) == "Colon") {
        return parse_map_lit(ti);
    }
    var head: i64 = -1;
    var tail: i64 = -1;
    while (cur_t() != "RBracket" && cur_t() != "Eof") {
        var e: i64 = parse_expr();
        tail = list_push(head, tail, e);
        if (head < 0) {
            head = tail;
        }
        if (cur_t() == "Comma") {
            advance_i();
        } else {
            break;
        }
    }
    expect_tok("RBracket");
    var id: i64 = mk_array_lit(head, ti);
    return id;
}

// primary 胶水 helper（fold=prim 骨架已消费分发 token，ti 为其下标）
fn parse_prim_int(ti: i64) -> i64 {
    var val: string = tk_v(ti);
    var radix: i64 = 10;
    if (starts_with_0x(val)) {
        radix = 16;
    } else {
        if (starts_with_0b(val)) {
            radix = 2;
        }
    }
    var id: i64 = mk_int(val, radix, ti);
    return id;
}

fn parse_prim_float(ti: i64) -> i64 {
    var id: i64 = mk_float(tk_v(ti), ti);
    return id;
}

fn parse_prim_str(ti: i64) -> i64 {
    var id: i64 = mk_string(tk_v(ti), ti);
    return id;
}

fn parse_prim_true(ti: i64) -> i64 {
    var id: i64 = mk_bool(true, ti);
    return id;
}

fn parse_prim_false(ti: i64) -> i64 {
    var id: i64 = mk_bool(false, ti);
    return id;
}

fn parse_prim_null(ti: i64) -> i64 {
    var id: i64 = mk_null(ti);
    return id;
}

fn parse_prim_ident(ti: i64) -> i64 {
    var name: string = tk_v(ti);
    if (name == "type_info" && cur_t() == "LParen") {
        advance_i();
        var tn_tok: string = expect_tok("Identifier");
        expect_tok("RParen");
        var id: i64 = node_new("typeinfo");
        var nn: Node = nodes[id];
        nn.sa = tn_tok;
        slice_set(nodes, id, nn);
        return id;
    }
    if (cur_t() == "LBrace" && looks_like_struct_lit()) {
        return parse_struct_lit(name, ti);
    }
    var id: i64 = mk_ident(name, ti);
    return id;
}

fn parse_prim_paren(ti: i64) -> i64 {
    var inner: i64 = parse_expr();
    expect_tok("RParen");
    var id: i64 = mk_paren(inner, ti);
    return id;
}

fn parse_prim_array(ti: i64) -> i64 {
    return parse_array_lit(ti);
}

// ── 语句解析 ───────────────────────────────────────────────────

fn parse_block() -> i64 {
    expect_tok("LBrace");
    var head: i64 = -1;
    var tail: i64 = -1;
    while (cur_t() != "RBrace" && cur_t() != "Eof") {
        var s: i64 = parse_statement();
        if (s >= 0) {
            tail = list_push(head, tail, s);
            if (head < 0) {
                head = tail;
            }
        }
    }
    expect_tok("RBrace");
    return head;
}

fn parse_local_var(is_const: bool) -> i64 {
    var ti: i64 = advance_i();
    var name: string = expect_tok("Identifier");
    var nti: i64 = pos - 1;
    var tn: i64 = -1;
    if (cur_t() == "Colon") {
        advance_i();
        tn = parse_type();
    }
    var init: i64 = -1;
    if (cur_t() == "Assign") {
        advance_i();
        init = parse_expr();
    }
    expect_tok("Semicolon");
    if (is_const) {
        validate_const_name(name, nti);
    } else {
        validate_var_name(name, nti);
    }
    var id: i64 = mk_var_decl(name, is_const, tn, init, ti);
    return id;
}

fn parse_expr_or_assign_stmt() -> i64 {
    var ti: i64 = pos;
    var e: i64 = parse_expr();
    var t: string = cur_t();
    var is_assign: bool = false;
    if (t == "Assign" || t == "PlusAssign" || t == "MinusAssign" || t == "StarAssign") {
        is_assign = true;
    }
    if (t == "SlashAssign" || t == "PercentAssign" || t == "BitAndAssign" || t == "BitOrAssign") {
        is_assign = true;
    }
    if (t == "BitXorAssign" || t == "ShlAssign" || t == "ShrAssign") {
        is_assign = true;
    }
    if (is_assign) {
        var oi: i64 = advance_i();
        var op: string = tk_v(oi);
        var val: i64 = parse_expr();
        expect_tok("Semicolon");
        var id: i64 = mk_assignment(op, e, val, ti);
        return id;
    }
    expect_tok("Semicolon");
    var id2: i64 = mk_expr(e, ti);
    return id2;
}

// ── statement 分发胶水（fold=disp 目标；自行消费引导 token，GEN 区外）──

fn parse_break_stmt() -> i64 {
    var tb: i64 = advance_i();
    expect_tok("Semicolon");
    var idb: i64 = mk_break(tb);
    return idb;
}

fn parse_continue_stmt() -> i64 {
    var tc: i64 = advance_i();
    expect_tok("Semicolon");
    var idc: i64 = mk_continue(tc);
    return idc;
}

fn parse_defer_stmt() -> i64 {
    var td: i64 = advance_i();
    var body: i64 = parse_block();
    var id: i64 = mk_defer(body, td);
    return id;
}

fn parse_comptime_stmt() -> i64 {
    var tm: i64 = advance_i();
    if (cur_t() == "LBrace") {
        var body2: i64 = parse_block();
        var id2: i64 = mk_comptime_block(body2, tm);
        return id2;
    }
    var e: i64 = parse_expr();
    expect_tok("Semicolon");
    var ce: i64 = mk_comptime(e, tm);
    var id3: i64 = mk_expr(ce, tm);
    return id3;
}

fn parse_block_stmt() -> i64 {
    var tl: i64 = pos;
    var body3: i64 = parse_block();
    var id4: i64 = mk_block(body3, tl);
    return id4;
}

fn parse_var_stmt() -> i64 {
    return parse_local_var(false);
}

fn parse_const_stmt() -> i64 {
    return parse_local_var(true);
}

// parse_statement 已由 GEN:parser_rules 区间生成（fold=disp 守卫式分发）。

// ── 注解查找辅助 ───────────────────────────────────────────────

// 在注解链中查找名为 name 的第一个注解，返回节点下标或 -1
fn ann_find(head: i64, name: string) -> i64 {
    var it: i64 = head;
    while (it >= 0) {
        var c: Child = kids[it];
        var an: Node = nodes[c.val];
        if (an.sa == name) {
            return c.val;
        }
        it = c.next;
    }
    return -1;
}

// 注解的第一个参数节点下标，无参数返回 -1
fn ann_first_arg(ann_idx: i64) -> i64 {
    var an: Node = nodes[ann_idx];
    if (an.la < 0) {
        return -1;
    }
    var c: Child = kids[an.la];
    return c.val;
}

// ── 声明解析 ───────────────────────────────────────────────────

// parse_struct_decl / parse_sfield 已由 GEN:parser_rules 区间生成（见下方标记区）。
// 注意语义等价性：手写版按 is_bitpack 状态二分成员形态；生成版用 FIRST 守卫 alt
// （Integer → 位宽成员，其余 → 类型成员），对合法输入等价（类型永不以 Integer 开头）。

fn parse_enum_decl(name: string, anns: i64) -> i64 {
    advance_i();
    var underlying: string = "u32";
    if (cur_t() == "Colon") {
        advance_i();
        var ti: i64 = advance_i();
        underlying = tk_v(ti);
    }
    var post: i64 = parse_annotations();
    var all: i64 = list_concat(anns, post);

    expect_tok("LBrace");
    var vh: i64 = -1;
    var vt: i64 = -1;
    while (cur_t() != "RBrace" && cur_t() != "Eof") {
        if (cur_t() == "At" || cur_t() != "Identifier") {
            advance_i();
            continue;
        }
        var vname: string = expect_tok("Identifier");
        var val: i64 = -1;
        if (cur_t() == "Assign") {
            advance_i();
            val = parse_expr();
        }
        var vanns: i64 = parse_annotations();
        if (cur_t() == "Comma") {
            advance_i();
        }
        var vid: i64 = mk_V(vname, val, vanns, -1);
        vt = list_push(vh, vt, vid);
        if (vh < 0) {
            vh = vt;
        }
    }
    expect_tok("RBrace");

    var id: i64 = mk_EnumDecl(name, underlying, all, vh, -1);
    return id;
}

// ── flag 语义 helper（供 GEN:parser_rules 生成的 parse_flag_decl/parse_slot 调用）──
// 可选捕获缺省值：s 为空（可选组未命中）时返回 d
fn str_or(s: string, d: string) -> string {
    if (s == "") {
        return d;
    }
    return s;
}

// 从槽位注解里提取 @offset(n) 的 n；无则 -1
fn flag_offset_of(sanns: i64) -> i64 {
    var oa: i64 = ann_find(sanns, "offset");
    if (oa >= 0) {
        var arg: i64 = ann_first_arg(oa);
        if (arg >= 0) {
            var argn: Node = nodes[arg];
            if (argn.kind == "number") {
                return parse_int_str(argn.sa);
            }
        }
    }
    return -1;
}

// 槽位是否带合法 @offset(n)
fn flag_has_offset(sanns: i64) -> bool {
    var oa: i64 = ann_find(sanns, "offset");
    if (oa >= 0) {
        var arg: i64 = ann_first_arg(oa);
        if (arg >= 0) {
            var argn: Node = nodes[arg];
            if (argn.kind == "number") {
                return true;
            }
        }
    }
    return false;
}

// ── struct 语义 helper（供 GEN:parser_rules 生成的 parse_struct_decl/parse_sfield 调用）──
// 在两个注解列表（前置 anns / 后置 anns）里查 @bitpack，避免为检测而重复 list_concat
fn bp_arg2(a: i64, b: i64) -> i64 {
    var x: i64 = ann_find(a, "bitpack");
    if (x < 0) {
        x = ann_find(b, "bitpack");
    }
    if (x < 0) {
        return -2;  // 无 @bitpack（-1 留给"有 @bitpack 但无参数"）
    }
    var arg: i64 = ann_first_arg(x);
    return arg;  // >=0 参数节点；-1 无参数
}

// 是否带 @bitpack
fn bp_is2(a: i64, b: i64) -> bool {
    if (ann_find(a, "bitpack") >= 0) {
        return true;
    }
    return ann_find(b, "bitpack") >= 0;
}

// @bitpack(T) 的 T 名；无则 ""
fn bp_type2(a: i64, b: i64) -> string {
    var arg: i64 = bp_arg2(a, b);
    if (arg >= 0) {
        var argn: Node = nodes[arg];
        if (argn.kind == "ident") {
            return argn.sa;
        }
    }
    return "";
}

// 是否带合法 @bitpack(T)
fn bp_has_type2(a: i64, b: i64) -> bool {
    var arg: i64 = bp_arg2(a, b);
    if (arg >= 0) {
        var argn: Node = nodes[arg];
        if (argn.kind == "ident") {
            return true;
        }
    }
    return false;
}

// 成员二分形态选型：@Integer 命中（bitpack 位宽成员）→ mk_scalar("void", -1)；否则用 @type 结果
fn sfield_na(bits: string, tn: i64) -> i64 {
    if (bits != "") {
        return mk_scalar("void", -1);
    }
    return tn;
}

// 位宽成员的 ia；非位宽成员 -1
fn sfield_ia(bits: string) -> i64 {
    if (bits == "") {
        return -1;
    }
    return parse_int_str(bits);
}

// parse_union_decl / parse_umember 已由 GEN:parser_rules 区间生成（见下方标记区）

// Variant：带标签的聚合类型（tagged union）。
//   Name variant {
//       CaseA(T);     // 携带载荷
//       CaseB;        // 单元 case（无载荷）
//   }
// 编译为 struct { uint32_t _tag; union { T _u0; ... } _u; }，并为每个 case 生成
// 自由函数：`Name_from_Case(...)` 构造、`Name_is_Case(self)` 判别、`Name_as_Case(self)` 取载荷。
// parse_variant_decl / parse_case 已由 GEN:parser 区间生成（见下方标记区）

fn parse_func_decl(name: string, anns: i64, is_comptime: bool) -> i64 {
    advance_i();
    expect_tok("LParen");
    var ph: i64 = -1;
    var pt: i64 = -1;
    while (cur_t() != "RParen" && cur_t() != "Eof") {
        var pname: string = expect_tok("Identifier");
        expect_tok("Colon");
        var ptn: i64 = parse_type();
        var panns: i64 = parse_annotations();
        var pid: i64 = mk_P(pname, ptn, panns, -1);
        pt = list_push(ph, pt, pid);
        if (ph < 0) {
            ph = pt;
        }
        if (cur_t() == "Comma") {
            advance_i();
        } else {
            break;
        }
    }
    expect_tok("RParen");
    expect_tok("Arrow");
    var rt: i64 = parse_type();
    var post: i64 = parse_annotations();
    var all: i64 = list_concat(anns, post);

    var body: i64 = -2;
    var is_extern: bool = false;
    if (cur_t() == "Semicolon") {
        advance_i();
        is_extern = true;
    } else {
        if (cur_t() == "LBrace") {
            body = parse_block();
        } else {
            eprint("parse error: expected '{' or ';' after function signature\n");
            exit(1);
        }
    }

    var id: i64 = mk_FuncDecl(name, is_extern, is_comptime, rt, all, ph, body, -1);
    return id;
}

fn parse_global_var(is_const: bool) -> i64 {
    advance_i();
    var name: string = expect_tok("Identifier");
    var nti: i64 = pos - 1;
    var tn: i64 = -1;
    if (cur_t() == "Colon") {
        advance_i();
        tn = parse_type();
    }
    var init: i64 = -1;
    if (cur_t() == "Assign") {
        advance_i();
        init = parse_expr();
    }
    expect_tok("Semicolon");
    if (is_const) {
        validate_const_name(name, nti);
    } else {
        validate_var_name(name, nti);
    }

    if (is_const) {
        if (init < 0) {
            init = mk_null(-1);
        }
        var id: i64 = mk_GlobalConstDecl(name, false, tn, init, -1, nti);
        return id;
    }

    if (tn < 0) {
        tn = mk_scalar("void", -1);
    }
    var id2: i64 = mk_GlobalVarDecl(name, false, tn, init, -1, nti);
    return id2;
}

fn parse_import_decl(anns: i64) -> i64 {
    advance_i();
    var path: string = expect_tok("String");
    var pti: i64 = pos - 1;
    var alias: string = "";
    var has_alias: bool = false;
    if (cur_t() == "KwAs") {
        advance_i();
        alias = expect_tok("Identifier");
        has_alias = true;
    }
    expect_tok("Semicolon");

    var id: i64 = mk_ImportDecl(path, alias, false, has_alias, anns, pti);
    return id;
}

// parse_type_alias 已由 GEN:parser 区间生成（见下方标记区）

fn parse_decl_body(name: string, anns: i64, is_comptime: bool) -> i64 {
    var layout: string = "default";
    if (cur_t() == "Hash") {
        advance_i();
        var li: i64 = advance_i();
        if (tk_t(li) == "Identifier") {
            var lv: string = tk_v(li);
            if (lv == "soa") {
                layout = "soa";
            } else {
                if (lv == "aos") {
                    layout = "aos";
                }
            }
        }
    }

    // >>> GEN:parser_dispatch (generated by tools/totter.tc from out/ebnf.json dispatches -- DO NOT EDIT) >>>
    var t: string = cur_t();
    if (t == "KwStruct") {
        return parse_struct_decl(name, anns, layout);
    }
    if (t == "KwEnum") {
        return parse_enum_decl(name, anns);
    }
    if (t == "KwFlag") {
        return parse_flag_decl(name, anns);
    }
    if (t == "KwUnion") {
        return parse_union_decl(name, anns);
    }
    if (t == "KwVariant") {
        return parse_variant_decl(name, anns);
    }
    if (t == "KwFunc") {
        return parse_func_decl(name, anns, is_comptime);
    }
    if (t == "Identifier" && cur_v() == "flag_set") {
        return parse_flag_set_decl(name, anns);
    }
    return parse_type_alias(name, anns);
// <<< GEN:parser_dispatch <<<
}

fn parse_declaration() -> i64 {
    var anns: i64 = parse_annotations();

    if (cur_t() == "KwVar") {
        return parse_global_var(false);
    }
    if (cur_t() == "KwConst") {
        return parse_global_var(true);
    }
    if (cur_t() == "KwImport") {
        return parse_import_decl(anns);
    }

    var is_comptime: bool = false;
    if (cur_t() == "KwComptime") {
        advance_i();
        is_comptime = true;
    }

    if (cur_t() != "Identifier") {
        eprint("parse error: expected declaration name but found ");
        eprint(cur_v());
        eprint("\n");
        exit(1);
    }
    var ni: i64 = advance_i();
    var name: string = tk_v(ni);
    validate_decl_name(name, ni);

    if (cur_t() != "DoubleColon") {
        eprint("parse error: expected '::' after declaration name\n");
        exit(1);
