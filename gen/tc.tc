// >>> GEN:scalar_bits (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
fn is_int_name(name: string) -> bool {
    if (name == "u8" || name == "u16" || name == "u32" || name == "u64") {
        return true;
    }
    return name == "i8" || name == "i16" || name == "i32" || name == "i64";
}

fn is_float_name(name: string) -> bool {
    return name == "f16" || name == "f32" || name == "f64";
}

fn get_bw(name: string) -> i64 {
    if (name == "u8" || name == "i8") {
        return 8;
    }
    if (name == "u16" || name == "i16" || name == "f16") {
        return 16;
    }
    if (name == "u32" || name == "i32" || name == "f32") {
        return 32;
    }
    if (name == "u64" || name == "i64" || name == "f64") {
        return 64;
    }
    if (name == "bool") {
        return 1;
    }
    return -1;
}
// <<< GEN:scalar_bits <<<

fn ti_scalar(name: string) -> i64 {
    var i: i64 = ti_named("Scalar", name);
    var t: TI = tis[i];
    t.bw = get_bw(name);
    slice_set(tis, i, t);
    return i;
}

fn tip_kind(i: i64) -> string {
    if (i < 0) {
        return "Unknown";
    }
    var t: TI = tis[i];
    return t.kind;
}

fn tip_name(i: i64) -> string {
    var t: TI = tis[i];
    return t.name;
}

fn is_int_ti(i: i64) -> bool {
    var t: TI = tis[i];
    if (t.kind != "Scalar") {
        return false;
    }
    return is_int_name(t.name);
}

fn is_float_ti(i: i64) -> bool {
    var t: TI = tis[i];
    if (t.kind != "Scalar") {
        return false;
    }
    return is_float_name(t.name);
}

// typesEqual（递归）
fn ti_equal(ai: i64, bi: i64) -> bool {
    var a: TI = tis[ai];
    var b: TI = tis[bi];
    if (a.kind != b.kind) {
        return false;
    }
    if (a.kind == "Scalar") {
        return a.name == b.name;
    }
    if (a.kind == "Void" || a.kind == "String" || a.kind == "StringBuilder") {
        return true;
    }
    if (a.kind == "Variant" || a.kind == "Unknown") {
        return true;
    }
    if (a.kind == "Array") {
        if (a.alen != b.alen) {
            return false;
        }
        return ti_equal(a.elem, b.elem);
    }
    if (a.kind == "Slice" || a.kind == "Pointer" || a.kind == "Optional") {
        return ti_equal(a.elem, b.elem);
    }
    if (a.kind == "Map" && b.kind == "Map") {
        // 任一侧 key/val 为 Unknown（如 map_new 返回值）即放行，支持 map_new() -> map[K]V 赋值
        var okk: bool = (a.key < 0 || b.key < 0 || ti_equal(a.key, b.key));
        var okv: bool = (a.val < 0 || b.val < 0 || ti_equal(a.val, b.val));
        return okk && okv;
    }
    if (a.kind == "Sym") {
        // 同类型 Sym：同 tag 且同位宽；跨池即不同类型（禁止互赋）
        return a.name == b.name && a.bw == b.bw;
    }
    return a.name == b.name;
}

// canExplicitCast
fn can_cast(fi: i64, ti2: i64) -> bool {
    if (ti_equal(fi, ti2)) {
        return true;
    }
    // 数组 ↔ 切片：元素可转型即可（目标为定长数组时要求长度一致）
    var fk: string = tip_kind(fi);
    var tk: string = tip_kind(ti2);
    if ((fk == "Array" || fk == "Slice") && (tk == "Array" || tk == "Slice")) {
        var f: TI = tis[fi];
        var t: TI = tis[ti2];
        if (fk == "Array" && tk == "Array" && f.alen != t.alen) {
            return false;
        }
        if (tip_kind(f.elem) == "Unknown" || tip_kind(t.elem) == "Unknown") {
            return true;
        }
        return can_cast(f.elem, t.elem);
    }
    if (is_int_ti(fi) && is_int_ti(ti2)) {
        return true;
    }
    if (is_float_ti(fi) && is_float_ti(ti2)) {
        return true;
    }
    if (is_int_ti(fi) && is_float_ti(ti2)) {
        return true;
    }
    if (is_float_ti(fi) && is_int_ti(ti2)) {
        return true;
    }
    var f: TI = tis[fi];
    var t: TI = tis[ti2];
    if (f.kind == "Scalar" && f.name == "bool" && is_int_ti(ti2)) {
        return true;
    }
    if (is_int_ti(fi) && t.kind == "Scalar" && t.name == "bool") {
        return true;
    }
    return false;
}

// typeToString（递归）
fn ti_str(i: i64) -> string {
    var t: TI = tis[i];
    if (t.kind == "Scalar") {
        return t.name;
    }
    if (t.kind == "Void") {
        return "void";
    }
    if (t.kind == "String") {
        return "string";
    }
    if (t.kind == "StringBuilder") {
        return "StringBuilder";
    }
    if (t.kind == "Array") {
        return sb_cat4("[", i2s(t.alen), "]", ti_str(t.elem));
    }
    if (t.kind == "Slice") {
        return sb_cat2("[]", ti_str(t.elem));
    }
    if (t.kind == "Map") {
        return sb_cat4("map[", ti_str(t.key), "]", ti_str(t.val));
    }
    if (t.kind == "Sym") {
        return sb_cat5("Sym", i2s(t.bw), "(\"", t.name, "\")");
    }
    if (t.kind == "Pointer") {
        return sb_cat2("*", ti_str(t.elem));
    }
    if (t.kind == "Optional") {
        return sb_cat2("?", ti_str(t.elem));
    }
    if (t.kind == "Variant") {
        return "Variant";
    }
    if (t.kind == "Unknown") {
        return "<unknown>";
    }
    return t.name;
}

// ── 符号表（扁平池 + scope 链）─────────────────────────────────

Sym struct {
    name: string;
    kind: string;   // type/var/func/const
    ti: i64;        // TI 索引
    decl: i64;      // Node 索引（decl），-1 = 无
    scope: i64;
}

var syms: []Sym;
var scope_parents: []i64;

fn scope_new(parent: i64) -> i64 {
    append(scope_parents, parent);
    return (slice_len(scope_parents) as i64) - 1;
}

// 仅在指定 scope 内查找（不上溯）
fn sym_find_in(scope: i64, name: string) -> i64 {
    var n: i64 = slice_len(syms) as i64;
    var i: i64 = 0;
    while (i < n) {
        var s: Sym = syms[i];
        if (s.scope == scope && s.name == name) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// Map.set 语义：已存在则忽略（首定义保留）
fn sym_define(scope: i64, name: string, kind: string, ti2: i64, decl: i64) -> void {
    if (sym_find_in(scope, name) >= 0) {
        return;
    }
    var s: Sym;
    s.name = name;
    s.kind = kind;
    s.ti = ti2;
    s.decl = decl;
    s.scope = scope;
    append(syms, s);
}

// 沿 scope 链上溯查找
fn sym_lookup(scope: i64, name: string) -> i64 {
    var sc: i64 = scope;
    while (sc >= 0) {
        var f: i64 = sym_find_in(sc, name);
        if (f >= 0) {
            return f;
        }
        sc = scope_parents[sc];
    }
    return -1;
}

var global_scope: i64;
var cur_scope: i64;
var cur_ret: i64;   // 当前函数返回类型（TI 索引）

// ── 诊断定位助手（复刻 tok?.file ?? "" 等）────────────────────

fn n_file(ni: i64) -> string {
    if (ni < 0) {
        return "";
    }
    var n: Node = nodes[ni];
    if (n.ln == 0) {
        return "";
    }
    return g_file;
}

fn n_line(ni: i64) -> i64 {
    if (ni < 0) {
        return 1;
    }
    var n: Node = nodes[ni];
    if (n.ln == 0) {
        return 1;
    }
    return n.ln as i64;
}

fn n_col(ni: i64) -> i64 {
    if (ni < 0) {
        return 1;
    }
    var n: Node = nodes[ni];
    if (n.ln == 0) {
        return 1;
    }
    return n.cl as i64;
}

// errorTypeMismatch（复刻 checker.ts:678）
fn err_type_mismatch(eni: i64, exp: i64, act: i64) -> void {
    var es: string = ti_str(exp);
    var fs2: string = ti_str(act);
    var l: i64 = n_line(eni);
    var c: i64 = n_col(eni);
    var di: i64 = diag_new("T_TYPE_MISMATCH", "error",
        sb_cat4("type mismatch: expected ", es, " but got ", fs2),
        n_file(eni), l, c, l, c + 5);
    slb_begin();
    slb_add(sb_cat2("expected: ", es));
    slb_add(sb_cat2("found:    ", fs2));
    diag_set_nt(di, slb_head);
}

// ── 整数字面量解析（复刻 BigInt(value) 与 parseInt(value,radix)）──

// BigInt 语义：识别 0x/0X/0b/0B 前缀
fn lit_u64(v: string) -> u64 {
    var n: u64 = str_len(v);
    var r: u64 = 0;
    if (n >= 2 && v[0] == 48 && (v[1] == 120 || v[1] == 88)) {
        var i: u64 = 2;
        while (i < n) {
            var c: u8 = v[i];
            var d: u64 = 0;
            if (c >= 48 && c <= 57) {
                d = (c - 48) as u64;
            } else {
                if (c >= 97 && c <= 102) {
                    d = (c - 87) as u64;
                } else {
                    d = (c - 55) as u64;
                }
            }
            r = r * 16 + d;
            i = i + 1;
        }
        return r;
    }
    if (n >= 2 && v[0] == 48 && (v[1] == 98 || v[1] == 66)) {
        var j: u64 = 2;
        while (j < n) {
            r = r * 2 + ((v[j] - 48) as u64);
            j = j + 1;
        }
        return r;
    }
    var k: u64 = 0;
    while (k < n) {
        r = r * 10 + ((v[k] - 48) as u64);
        k = k + 1;
    }
    return r;
}

// parseInt(value, radix) 语义：radix=16 接受 0x 前缀；其余按位解析，
// 遇非法字符停止
fn parse_int_len(v: string, radix: i64) -> i64 {
    var n: u64 = str_len(v);
    var r: i64 = 0;
    if (radix == 16) {
        var i: u64 = 0;
        if (n >= 2 && v[0] == 48 && (v[1] == 120 || v[1] == 88)) {
            i = 2;
        }
        while (i < n) {
            var c: u8 = v[i];
            var d: i64 = -1;
            if (c >= 48 && c <= 57) {
                d = (c - 48) as i64;
            }
            if (c >= 97 && c <= 102) {
                d = (c - 87) as i64;
            }
            if (c >= 65 && c <= 70) {
                d = (c - 55) as i64;
            }
            if (d < 0) {
                return r;
            }
            r = r * 16 + d;
            i = i + 1;
        }
        return r;
    }
    if (radix == 2) {
        var j: u64 = 0;
        while (j < n) {
            var c2: u8 = v[j];
            if (c2 != 48 && c2 != 49) {
                return r;
            }
            r = r * 2 + ((c2 - 48) as i64);
            j = j + 1;
        }
        return r;
    }
    var k: u64 = 0;
    while (k < n) {
        var c3: u8 = v[k];
        if (c3 < 48 || c3 > 57) {
            return r;
        }
        r = r * 10 + ((c3 - 48) as i64);
        k = k + 1;
    }
    return r;
}

// ── 类型解析 resolveType（复刻 checker.ts:134）────────────────

fn resolve_ti(tn: i64) -> i64 {
    if (tn < 0) {
        return ti_mk("Unknown");
    }
    var n: Node = nodes[tn];
    if (n.kind == "scalar") {
        if (is_scalar_name(n.sa)) {
            return ti_scalar(n.sa);
        }
        if (n.sa == "void") {
            return ti_mk("Void");
        }
        if (n.sa == "string") {
            return ti_mk("String");
        }
        if (n.sa == "StringBuilder") {
            return ti_mk("StringBuilder");
        }
        return ti_named("Named", n.sa);
    }
    if (n.kind == "array") {
        var elem: i64 = resolve_ti(n.na);
        var length: i64 = 0;
        if (n.nb >= 0) {
            var le: Node = nodes[n.nb];
            if (le.kind == "int") {
                length = parse_int_len(le.sa, le.ia);
            }
        }
        var ai: i64 = ti_elem_of("Array", elem);
        var at: TI = tis[ai];
        at.alen = length;
        slice_set(tis, ai, at);
        return ai;
    }
// >>> GEN:type_slice (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
    if (n.kind == "slice") {
        return ti_elem_of("Slice", resolve_ti(n.na));
    }
// <<< GEN:type_slice <<<
    if (n.kind == "map") {
        var kt: i64 = resolve_ti(n.na);
        var vt: i64 = resolve_ti(n.nb);
        var mi: i64 = ti_mk("Map");
        var mt: TI = tis[mi];
        mt.key = kt;
        mt.val = vt;
        slice_set(tis, mi, mt);
        return mi;
    }
    if (n.kind == "sym") {
        var syi: i64 = ti_named("Sym", n.sa);
        var syt: TI = tis[syi];
        syt.bw = n.ia;
        slice_set(tis, syi, syt);
        return syi;
    }
    if (n.kind == "named") {
        if (n.sa == "TypeInfo") { return ti_mk("TypeInfo"); }
        if (n.sa == "FieldInfo") { return ti_mk("FieldInfo"); }
        var si: i64 = sym_lookup(global_scope, n.sa);
        if (si >= 0) {
            var s: Sym = syms[si];
            return s.ti;
        }
        return ti_named("Named", n.sa);
    }
// >>> GEN:type_resolve (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
    if (n.kind == "variant") {
        return ti_mk("Variant");
    }
    if (n.kind == "flag") {
        return ti_with_und("Flag", "<anonymous>", n.sa);
    }
    if (n.kind == "flag_set") {
        return ti_named("FlagSet", "<anonymous>");
    }
    if (n.kind == "pointer") {
        return ti_elem_of("Pointer", resolve_ti(n.na));
    }
    if (n.kind == "optional") {
        return ti_elem_of("Optional", resolve_ti(n.na));
    }
// <<< GEN:type_resolve <<<
    return ti_mk("Unknown");
}

// ── 声明注册 registerDecl（复刻 checker.ts:97）────────────────

// >>> GEN:type_declreg (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
fn register_decl(d: i64) -> void {
    var n: Node = nodes[d];
    if (n.kind == "StructDecl") {
        sym_define(global_scope, n.sa, "type", ti_named("Struct", n.sa), d);
        return;
    }
    if (n.kind == "EnumDecl") {
        sym_define(global_scope, n.sa, "type", ti_with_und("Enum", n.sa, n.sb), d);
        return;
    }
    if (n.kind == "FlagDecl") {
        sym_define(global_scope, n.sa, "type", ti_with_und("Flag", n.sa, n.sb), d);
        return;
    }
    if (n.kind == "FlagSetDecl") {
        sym_define(global_scope, n.sa, "type", ti_named("FlagSet", n.sa), d);
        return;
    }
    if (n.kind == "UnionDecl") {
        sym_define(global_scope, n.sa, "type", ti_named("Union", n.sa), d);
        return;
    }
    if (n.kind == "VariantDecl") {
        sym_define(global_scope, n.sa, "type", ti_named("Variant", n.sa), d);
        register_variant_helpers(d);
        return;
    }
    if (n.kind == "FuncDecl") {
        sym_define(global_scope, n.sa, "func", ti_named("Func", n.sa), d);
        return;
    }
    if (n.kind == "GlobalVarDecl") {
        sym_define(global_scope, n.sa, "var", resolve_ti(n.na), d);
        return;
    }
    if (n.kind == "GlobalConstDecl") {
        var cti: i64 = -1;
        if (n.na >= 0) {
            cti = resolve_ti(n.na);
        } else {
            cti = ti_mk("Unknown");
        }
        sym_define(global_scope, n.sa, "const", cti, d);
        return;
    }
    if (n.kind == "TypeAliasDecl") {
        sym_define(global_scope, n.sa, "type", resolve_ti(n.na), d);
        return;
    }
}
// <<< GEN:type_declreg <<<

// 为 Variant 的每个 case 注册合成函数符号（构造器/判别器/取载荷），
// 指向合成 FuncDecl 节点但不在 decl_list 中，故仅作类型检查可见、不被 emitter 重复发射。
fn register_variant_helpers(d: i64) -> void {
    var n: Node = nodes[d];
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var vc: Node = nodes[k.val];
        var cname: string = vc.sa;
        // 构造器 Name_from_Case(载荷?) -> Name
        var ffrom: string = sb_cat3(n.sa, "_from_", cname);
        var retNode: i64 = mk_named(n.sa, -1);
        var plist: i64 = -1;
        var ptail: i64 = -1;
        if (vc.na >= 0) {
            var pid: i64 = mk_P("v", vc.na, -1, -1);
            ptail = list_push(plist, ptail, pid);
            if (plist < 0) {
                plist = ptail;
            }
        }
        var fdecl1: i64 = mk_FuncDecl(ffrom, true, false, retNode, -1, plist, -2, -1);
        sym_define(global_scope, ffrom, "func", ti_named("Func", ffrom), fdecl1);

        // 判别器 Name_is_Case(self: Name) -> bool
        var fis: string = sb_cat3(n.sa, "_is_", cname);
        var retBool: i64 = mk_scalar("bool", -1);
        var pid2: i64 = node_new("P");
        var pn2: Node = nodes[pid2];
        pn2.sa = "self";
        var selfTn: i64 = mk_named(n.sa, -1);
        pn2.na = selfTn;
        slice_set(nodes, pid2, pn2);
        var plist2: i64 = -1;
        var ptail2: i64 = -1;
        ptail2 = list_push(plist2, ptail2, pid2);
        if (plist2 < 0) {
            plist2 = ptail2;
        }
        var fdecl2: i64 = mk_FuncDecl(fis, true, false, retBool, -1, plist2, -2, -1);
        sym_define(global_scope, fis, "func", ti_named("Func", fis), fdecl2);

        // 取载荷 Name_as_Case(self: Name) -> 载荷（仅当携带载荷）
        if (vc.na >= 0) {
            var fas: string = sb_cat3(n.sa, "_as_", cname);
            var fdecl3: i64 = mk_FuncDecl(fas, true, false, vc.na, -1, plist2, -2, -1);
            sym_define(global_scope, fas, "func", ti_named("Func", fas), fdecl3);
        }
        c = k.next;
    }
}

// ── 列表助手 ───────────────────────────────────────────────────

fn list_last_val(head: i64) -> i64 {
    var c: i64 = head;
    var last: i64 = -1;
    while (c >= 0) {
        var k: Child = kids[c];
        last = k.val;
        c = k.next;
    }
    return last;
}

fn list_count(head: i64) -> i64 {
    var c: i64 = head;
    var n: i64 = 0;
    while (c >= 0) {
        var k: Child = kids[c];
        n = n + 1;
        c = k.next;
    }
    return n;
}

// ── 内置函数返回类型（复刻 checker.ts:616）────────────────────

// >>> GEN:builtins (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
fn builtin_ret(name: string) -> i64 {
    if (name == "assert_eq" || name == "assert_true" || name == "assert_false") {
        return ti_mk("Void");
    }
    if (name == "assert_panic" || name == "flag_set" || name == "print") {
        return ti_mk("Void");
    }
    if (name == "println" || name == "append" || name == "slice_set") {
        return ti_mk("Void");
    }
    if (name == "exit" || name == "eprint" || name == "sb_append_str") {
        return ti_mk("Void");
    }
    if (name == "sb_append_char" || name == "sb_append_u64" || name == "sb_append_i64") {
        return ti_mk("Void");
    }
    if (name == "sb_clear") {
        return ti_mk("Void");
    }
    if (name == "flag_get") {
        return ti_scalar("u32");
    }
    if (name == "sys_run") {
        return ti_scalar("i32");
    }
    if (name == "str_len" || name == "slice_len") {
        return ti_scalar("u64");
    }
    if (name == "str_at") {
        return ti_scalar("u8");
    }
    if (name == "file_read_all" || name == "path_resolve" || name == "str_slice") {
        return ti_mk("String");
    }
    if (name == "sb_to_str" || name == "to_string") {
        return ti_mk("String");
    }
    if (name == "int_to_str") {
        return ti_mk("String");
    }
    if (name == "file_write_all" || name == "file_exists") {
        return ti_scalar("bool");
    }
    if (name == "args") {
        return ti_elem_of("Slice", ti_mk("String"));
    }
    if (name == "sb_new") {
        return ti_mk("StringBuilder");
    }
    if (name == "map_new") {
        return ti_mk("Map");
    }
    if (name == "map_set") {
        return ti_mk("Void");
    }
    if (name == "map_has" || name == "map_del") {
        return ti_scalar("bool");
    }
    if (name == "map_len") {
        return ti_scalar("i64");
    }
    if (name == "map_get") {
        return ti_mk("Unknown");
    }
    if (name == "ti_name" || name == "fi_name" || name == "fi_type_name") {
        return ti_mk("String");
    }
    if (name == "ti_size" || name == "ti_kind" || name == "ti_field_count" || name == "fi_offset" || name == "fi_type_size") {
        return ti_scalar("i64");
    }
    if (name == "ti_field") {
        return ti_mk("FieldInfo");
    }
    if (name == "fi_is_ptr") {
        return ti_scalar("bool");
    }
    if (name == "sym_str") {
        return ti_mk("String");
    }
    if (name == "sym_release" || name == "sym_release_all") {
        return ti_mk("Void");
    }
    return ti_mk("Unknown");
}
// <<< GEN:builtins <<<

// ── 表达式类型推断 inferExprType（复刻 checker.ts:479）────────

fn infer_expr(e: i64) -> i64 {
    var n: Node = nodes[e];
    if (n.kind == "int") {
        var v: u64 = lit_u64(n.sa);
        if (v <= 255) {
            return ti_scalar("u8");
        }
        if (v <= 65535) {
            return ti_scalar("u16");
        }
        if (v <= 4294967295) {
            return ti_scalar("u32");
        }
        return ti_scalar("u64");
    }
// >>> GEN:type_infer1 (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
    if (n.kind == "float") {
        return ti_scalar("f64");
    }
    if (n.kind == "string") {
        return ti_mk("String");
    }
    if (n.kind == "bool") {
        return ti_scalar("bool");
    }
    if (n.kind == "null") {
        return ti_mk("Unknown");
    }
// <<< GEN:type_infer1 <<<
    if (n.kind == "typeinfo") {
        return ti_mk("TypeInfo");
    }
    if (n.kind == "ident") {
        var si: i64 = sym_lookup(cur_scope, n.sa);
        if (si >= 0) {
            var s: Sym = syms[si];
            return s.ti;
        }
        if (n.sa == "true" || n.sa == "false") {
            return ti_scalar("bool");
        }
        return ti_mk("Unknown");
    }
    if (n.kind == "binary") {
        var lt: i64 = infer_expr(n.na);
        var rt: i64 = infer_expr(n.nb);
        var op: string = n.sa;
        if (op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=") {
            return ti_scalar("bool");
        }
        if (op == "&&" || op == "||") {
            return ti_scalar("bool");
        }
        if (tip_kind(lt) == "Scalar" && tip_kind(rt) == "Scalar") {
            if (ti_equal(lt, rt)) {
                return lt;
            }
            var ln2: Node = nodes[n.na];
            var rn2: Node = nodes[n.nb];
            var llit: bool = ln2.kind == "int";
            var rlit: bool = rn2.kind == "int";
            if (llit && rlit == false) {
                return rt;
            }
            if (rlit && llit == false) {
                return lt;
            }
            if (llit && rlit) {
                return lt;
            }
            var di: i64 = diag_new("T_TYPE_IMPLICIT_CAST", "error",
                sb_cat6("binary operator '", op, "' requires same types, got ", ti_str(lt), " and ", ti_str(rt)),
                "", 1, 1, 1, 5);
            slb_begin();
            slb_add("use explicit cast: `expr as Type`");
            diag_set_nt(di, slb_head);
        }
        if (tip_kind(lt) != "Unknown") {
            return lt;
        }
        return rt;
    }
    if (n.kind == "unary") {
        var ot: i64 = infer_expr(n.na);
        if (n.sa == "!") {
            return ti_scalar("bool");
        }
        return ot;
    }
    if (n.kind == "assign") {
        var atl: i64 = infer_expr(n.na);
        var atr: i64 = infer_expr(n.nb);
        // Sym 赋值：LHS 为 Sym 时，仅允许 string（自动 intern）或同池同类型 Sym；
        // 跨池 Sym→Sym（不同 tag）或其它类型赋值均为 T_TYPE_MISMATCH。
        if (tip_kind(atl) == "Sym" && ti_equal(atl, atr) == false) {
            if (tip_kind(atr) != "String" && tip_kind(atr) != "Unknown") {
                err_type_mismatch(n.nb, atl, atr);
            }
        }
        return atl;
    }
    if (n.kind == "call") {
        var cn: Node = nodes[n.na];
        if (cn.kind == "ident") {
            var fname: string = cn.sa;
            var si2: i64 = sym_lookup(global_scope, fname);
            if (si2 >= 0) {
                var s2: Sym = syms[si2];
                if (tip_kind(s2.ti) == "Func" && s2.decl >= 0) {
                    var fd: Node = nodes[s2.decl];
                    if (fd.kind == "FuncDecl") {
                        return resolve_ti(fd.na);
                    }
                }
            }
            // map_get(m, k) 的返回类型 = 映射的 V（需从首个实参的 map 类型反查）
            if (fname == "map_get" && n.la >= 0) {
                var mgn: i64 = kids[n.la].val;
                var mgt: i64 = infer_expr(mgn);
                if (tip_kind(mgt) == "Map") {
                    var mgti: TI = tis[mgt];
                    if (mgti.val >= 0) {
                        return mgti.val;
