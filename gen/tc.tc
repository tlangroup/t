    if (n.kind == "struct_lit") {
        return ti_named("Struct", n.sa);
    }
    if (n.kind == "cast") {
        return resolve_ti(n.nb);
    }
    if (n.kind == "paren") {
        return infer_expr(n.na);
    }
    if (n.kind == "comptime") {
        return infer_expr(n.na);
    }
// <<< GEN:type_infer2 <<<
    return ti_mk("Unknown");
}

// ── 返回路径分析（复刻 checker.ts:653）────────────────────────

fn all_paths_return(head: i64) -> bool {
    if (head < 0) {
        return false;
    }
    var last: i64 = list_last_val(head);
    if (last < 0) {
        return false;
    }
    return stmt_returns(last);
}

fn stmt_returns(s: i64) -> bool {
    var n: Node = nodes[s];
    if (n.kind == "return") {
        return true;
    }
    if (n.kind == "if") {
        if (n.lb != -2) {
            if (all_paths_return(n.la)) {
                return all_paths_return(n.lb);
            }
            return false;
        }
        return false;
    }
    if (n.kind == "block") {
        return all_paths_return(n.la);
    }
    return false;
}

// ── 语句检查 checkStmt（复刻 checker.ts:345）──────────────────

fn check_stmt(s: i64) -> void {
    var n: Node = nodes[s];
    if (n.kind == "var_decl") {
        var vt: i64 = -1;
        if (n.na >= 0) {
            vt = resolve_ti(n.na);
        }
        if (n.nb >= 0) {
            var it: i64 = infer_expr(n.nb);
            if (vt >= 0 && tip_kind(it) != "Unknown" && ti_equal(it, vt) == false) {
                var vk: string = tip_kind(vt);
                var int_to_fe: bool = (vk == "Flag" || vk == "Enum") && is_int_ti(it);
                // Sym 字段允许由字符串赋值（自动 intern → id）
                var str_to_sym: bool = vk == "Sym" && tip_kind(it) == "String";
                if (int_to_fe == false && str_to_sym == false && can_cast(it, vt) == false) {
                    err_type_mismatch(n.nb, vt, it);
                }
            }
            if (vt < 0) {
                sym_define(cur_scope, n.sa, "var", it, -1);
                return;
            }
        }
        if (vt >= 0) {
            sym_define(cur_scope, n.sa, "var", vt, -1);
        }
        return;
    }
    if (n.kind == "if") {
        var ct: i64 = infer_expr(n.na);
        if (tip_kind(ct) == "Scalar" && tip_name(ct) != "bool") {
            var di: i64 = diag_new("T_STMT_IMPLICIT_BOOL", "error",
                sb_cat2("if condition must be bool or explicit comparison, got ", ti_str(ct)),
                "", 1, 1, 1, 5);
            var fx: i64 = fix_one("add explicit comparison", "", 1, 1, 1, 1, "(expr != 0)");
            diag_set_fs(di, fx);
        }
        var prev: i64 = cur_scope;
        cur_scope = scope_new(prev);
        var c: i64 = n.la;
        while (c >= 0) {
            var k: Child = kids[c];
            check_stmt(k.val);
            c = k.next;
        }
        if (n.lb != -2) {
            cur_scope = scope_new(prev);
            var c2: i64 = n.lb;
            while (c2 >= 0) {
                var k2: Child = kids[c2];
                check_stmt(k2.val);
                c2 = k2.next;
            }
        }
        cur_scope = prev;
        return;
    }
    if (n.kind == "for" || n.kind == "while") {
        var cond: i64 = n.na;
        if (n.kind == "for") {
            cond = n.nb;
        }
        if (cond >= 0) {
            var ct2: i64 = infer_expr(cond);
            if (tip_kind(ct2) == "Scalar" && tip_name(ct2) != "bool") {
                diag_new("T_STMT_IMPLICIT_BOOL", "error",
                    sb_cat2("loop condition must be bool, got ", ti_str(ct2)),
                    "", 1, 1, 1, 5);
            }
        }
        var prev2: i64 = cur_scope;
        cur_scope = scope_new(prev2);
        if (n.kind == "for" && n.na >= 0) {
            check_stmt(n.na);
        }
        var c3: i64 = n.la;
        while (c3 >= 0) {
            var k3: Child = kids[c3];
            check_stmt(k3.val);
            c3 = k3.next;
        }
        cur_scope = prev2;
        return;
    }
    if (n.kind == "for_each") {
        var itt: i64 = infer_expr(n.na);
        var prev3: i64 = cur_scope;
        cur_scope = scope_new(prev3);
        var et: i64 = -1;
        var itk: string = tip_kind(itt);
        if (itk == "Slice" || itk == "Array") {
            var t4: TI = tis[itt];
            et = t4.elem;
        } else {
        if (itk == "Map") {
            // map 的 for-in 迭代键（按插入序）
            var t5: TI = tis[itt];
            et = t5.key;
        } else {
            et = ti_mk("Unknown");
        }}
        sym_define(cur_scope, n.sa, "var", et, -1);
        // 双变量形式 `for (k, v in m)`：第二个变量绑定值类型
        if (str_len(n.sb) > 0) {
            var vt5: i64 = ti_mk("Unknown");
            if (itk == "Map") {
                var t6: TI = tis[itt];
                vt5 = t6.val;
            } else {
                diag_new("T_TYPE_MISMATCH", "error",
                    "for (k, v in x): 双变量迭代仅支持 map",
                    n_file(n.na), n_line(n.na), n_col(n.na), n_line(n.na), n_col(n.na) + 5);
            }
            sym_define(cur_scope, n.sb, "var", vt5, -1);
        }
        var c4: i64 = n.la;
        while (c4 >= 0) {
            var k4: Child = kids[c4];
            check_stmt(k4.val);
            c4 = k4.next;
        }
        cur_scope = prev3;
        return;
    }
    if (n.kind == "return") {
        if (n.na >= 0) {
            var rt: i64 = infer_expr(n.na);
            if (tip_kind(rt) != "Unknown" && ti_equal(rt, cur_ret) == false) {
                if (can_cast(rt, cur_ret) == false) {
                    err_type_mismatch(n.na, cur_ret, rt);
                }
            }
        }
        return;
    }
    if (n.kind == "assignment") {
        var tt: i64 = infer_expr(n.na);
        var vt2: i64 = infer_expr(n.nb);
        if (tip_kind(tt) != "Unknown" && tip_kind(vt2) != "Unknown" && ti_equal(tt, vt2) == false) {
            // Sym 字段允许由字符串赋值（自动 intern）；跨池 Sym→Sym 仍报错
            var str_to_sym2: bool = tip_kind(tt) == "Sym" && tip_kind(vt2) == "String";
            if (str_to_sym2 == false && can_cast(vt2, tt) == false) {
                err_type_mismatch(n.nb, tt, vt2);
            }
        }
        return;
    }
    if (n.kind == "expr") {
        infer_expr(n.na);
        return;
    }
    if (n.kind == "block" || n.kind == "defer" || n.kind == "comptime_block") {
        var prev4: i64 = cur_scope;
        cur_scope = scope_new(prev4);
        var c5: i64 = n.la;
        while (c5 >= 0) {
            var k5: Child = kids[c5];
            check_stmt(k5.val);
            c5 = k5.next;
        }
        cur_scope = prev4;
        return;
    }
    if (n.kind == "switch") {
        infer_expr(n.na);
        var c6: i64 = n.la;
        while (c6 >= 0) {
            var k6: Child = kids[c6];
            var cs: Node = nodes[k6.val];
            infer_expr(cs.na);
            var b: i64 = cs.la;
            while (b >= 0) {
                var kb: Child = kids[b];
                check_stmt(kb.val);
                b = kb.next;
            }
            c6 = k6.next;
        }
        if (n.lb != -2) {
            var c7: i64 = n.lb;
            while (c7 >= 0) {
                var k7: Child = kids[c7];
                check_stmt(k7.val);
                c7 = k7.next;
            }
        }
        return;
    }
}

// ── 声明检查（复刻 checker.ts:178-341）────────────────────────

fn check_func_decl(d: i64) -> void {
    var n: Node = nodes[d];
    if (n.lc == -2) {
        return;
    }

    var prev: i64 = cur_scope;
    cur_scope = scope_new(global_scope);

    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var p: Node = nodes[k.val];
        sym_define(cur_scope, p.sa, "var", resolve_ti(p.na), -1);
        c = k.next;
    }

    var prev_ret: i64 = cur_ret;
    cur_ret = resolve_ti(n.na);

    var c2: i64 = n.lc;
    while (c2 >= 0) {
        var k2: Child = kids[c2];
        check_stmt(k2.val);
        c2 = k2.next;
    }

    if (tip_kind(cur_ret) != "Void") {
        if (all_paths_return(n.lc) == false) {
            var anchor: i64 = list_last_val(n.lc);
            var l: i64 = n_line(anchor);
            var cc: i64 = n_col(anchor);
            diag_new("T_PARSE_INVALID_EXPR", "error",
                sb_cat3("function '", n.sa, "' is missing return on some code paths (all branches must explicitly return)"),
                n_file(anchor), l, cc, l, cc + 10);
        }
    }

    cur_ret = prev_ret;
    cur_scope = prev;
}

fn check_struct_decl(d: i64) -> void {
    var n: Node = nodes[d];
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var f: Node = nodes[k.val];
        if (f.ia == -1) {
            resolve_ti(f.na);
        }
        c = k.next;
    }
}

fn check_enum_decl(d: i64) -> void {
    var n: Node = nodes[d];
    if (is_int_name(n.sb) == false) {
        var di: i64 = diag_new("T_TYPE_MISMATCH", "error",
            sb_cat5("enum '", n.sa, "' underlying type must be an integer type, got '", n.sb, "'"),
            "", 1, 1, 1, 10);
        slb_begin();
        slb_add("u8");
        slb_add("u16");
        slb_add("u32");
        slb_add("u64");
        slb_add("i8");
        slb_add("i16");
        slb_add("i32");
        slb_add("i64");
        diag_set_vv(di, slb_head);
    }

    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var v: Node = nodes[k.val];
        if (v.na >= 0) {
            var vt: i64 = infer_expr(v.na);
            if (tip_kind(vt) == "Scalar" && is_int_name(tip_name(vt)) == false) {
                diag_new("T_TYPE_MISMATCH", "error",
                    sb_cat2("enum variant value must be integer, got ", ti_str(vt)),
                    "", 1, 1, 1, 5);
            }
        }
        c = k.next;
    }
}

// flag decl 检查用的 usedBits 暂存池（append-only，按 base 划分）
var fd_names: []string;
var fd_starts: []i64;
var fd_ends: []i64;

fn check_flag_decl(d: i64) -> void {
    var n: Node = nodes[d];
    var is_flag: bool = n.kind == "FlagDecl";
    if (is_flag && is_int_name(n.sb) == false) {
        var di: i64 = diag_new("T_TYPE_MISMATCH", "error",
            sb_cat5("flag '", n.sa, "' underlying type must be an integer type, got '", n.sb, "'"),
            "", 1, 1, 1, 10);
        slb_begin();
        slb_add("u8");
        slb_add("u16");
        slb_add("u32");
        slb_add("u64");
        diag_set_vv(di, slb_head);
    }

    var auto_off: i64 = 0;
    var base: i64 = slice_len(fd_names) as i64;

    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var sl: Node = nodes[k.val];
        var start: i64 = auto_off;
        if (sl.bb) {
            start = sl.ib;
        }
        var end: i64 = start + sl.ia;

        var i: i64 = base;
        var total: i64 = slice_len(fd_names) as i64;
        while (i < total) {
            var us: i64 = fd_starts[i];
            var ue: i64 = fd_ends[i];
            if (start < ue && end > us) {
                var msb: StringBuilder = sb_new();
                sb_append_str(msb, "flag slot '");
                sb_append_str(msb, sl.sa);
                sb_append_str(msb, "' (bits ");
                sb_append_i64(msb, start);
                sb_append_str(msb, "-");
                sb_append_i64(msb, end - 1);
                sb_append_str(msb, ") overlaps with '");
                sb_append_str(msb, fd_names[i]);
                sb_append_str(msb, "' (bits ");
                sb_append_i64(msb, us);
                sb_append_str(msb, "-");
                sb_append_i64(msb, ue - 1);
                sb_append_str(msb, ")");
                diag_new("T_FLAG_OFFSET_CONFLICT", "error", sb_to_str(msb), "", 1, 1, 1, 10);
            }
            i = i + 1;
        }

        append(fd_names, sl.sa);
        append(fd_starts, start);
        append(fd_ends, end);

        if (is_flag) {
            var tw: i64 = get_bw(n.sb);
            if (tw > 0 && end > tw) {
                var osb: StringBuilder = sb_new();
                sb_append_str(osb, "flag '");
                sb_append_str(osb, n.sa);
                sb_append_str(osb, "' slot '");
                sb_append_str(osb, sl.sa);
                sb_append_str(osb, "' exceeds ");
                sb_append_str(osb, n.sb);
                sb_append_str(osb, " (");
                sb_append_i64(osb, tw);
                sb_append_str(osb, " bits): uses bits ");
                sb_append_i64(osb, start);
                sb_append_str(osb, "-");
                sb_append_i64(osb, end - 1);
                var di2: i64 = diag_new("T_FLAG_OVERFLOW", "error", sb_to_str(osb), "", 1, 1, 1, 10);
                slb_begin();
                slb_add(sb_cat3("0-", i2s(tw - 1), " bits"));
                diag_set_vv(di2, slb_head);
            }
        }

        auto_off = end;
        c = k.next;
    }
}

fn check_decl(d: i64) -> void {
    var n: Node = nodes[d];
    if (n.kind == "FuncDecl") {
        check_func_decl(d);
        return;
    }
    if (n.kind == "StructDecl") {
        check_struct_decl(d);
        return;
    }
    if (n.kind == "EnumDecl") {
        check_enum_decl(d);
        return;
    }
    if (n.kind == "FlagDecl" || n.kind == "FlagSetDecl") {
        check_flag_decl(d);
        return;
    }
    if (n.kind == "GlobalVarDecl") {
        if (n.nb >= 0) {
            var it: i64 = infer_expr(n.nb);
            var vt: i64 = resolve_ti(n.na);
            if (tip_kind(it) != "Unknown" && ti_equal(it, vt) == false) {
                // Sym 全局变量允许由字符串赋值（自动 intern → id）
                var gss: bool = tip_kind(vt) == "Sym" && tip_kind(it) == "String";
                if (gss == false && can_cast(it, vt) == false) {
                    err_type_mismatch(n.nb, vt, it);
                }
            }
        }
        return;
    }
    if (n.kind == "GlobalConstDecl") {
        if (n.nb >= 0) {
            var it2: i64 = infer_expr(n.nb);
            if (n.na >= 0) {
                var ct: i64 = resolve_ti(n.na);
                if (tip_kind(it2) != "Unknown" && ti_equal(it2, ct) == false) {
                    if (can_cast(it2, ct) == false) {
                        err_type_mismatch(n.nb, ct, it2);
                    }
                }
            }
        }
        return;
    }
}

// ── §7.2 CTFE 导入脱糖（M27）──────────────────────────────────
// 在 register_decl 全部完成后、check_decl 之前执行。
// 检测 var x: []Struct = import_csv("path") / import_json("path") →
// 编译期读文件 → 解析 → 值域校验 → 合成 __import_N 加载函数 → 替换 init。
// 残存调用报 T_IMPORT_CONTEXT。

var g_imp_counter: i64;

// 从切片类型节点提取元素 struct 名。na 指向 slice 节点（na=named），返回 struct 名或 ""。
fn import_elem_struct_name(type_node: i64) -> string {
    if (type_node < 0) { return ""; }
    var tn: Node = nodes[type_node];
    if (tn.kind != "slice") { return ""; }
    if (tn.na < 0) { return ""; }
    var elem: Node = nodes[tn.na];
    if (elem.kind == "named") { return elem.sa; }
    return "";
}

// 从 struct 名查找 StructDecl，返回其字段链表头（n.lb）或 -1。
fn find_struct_fields(sname: string) -> i64 {
    var si: i64 = sym_lookup(global_scope, sname);
    if (si < 0) { return -1; }
    var s: Sym = syms[si];
    if (s.decl < 0) { return -1; }
    var dn: Node = nodes[s.decl];
    if (dn.kind != "StructDecl") { return -1; }
    return dn.lb;
}

// 从字段链表收集 (字段名, 标量类型名) 对。结果写入全局 imp_fnames/imp_ftypes。
// 注意：t 的 slice 是值传递，无法用 out 参数，故用全局。
var imp_fnames: []string;
var imp_ftypes: []string;
// 当前正在处理的 import 的字段表起始下标（调用 collect_struct_fields 前记录）
var imp_fbase: i64;
// JSON 解析临时键值表（同样因 slice 值传递限制而用全局）
var jp_keys: []string;
var jp_vals: []string;

// 返回值：字段数。字段写入 imp_fnames/imp_ftypes 的尾部，
// 起始下标由调用方在调用前用 slice_len 记录（同 fr_resolve_flag 的 base 手法）。
fn collect_struct_fields(field_head: i64) -> i64 {
    var count: i64 = 0;
    var c: i64 = field_head;
    while (c >= 0) {
        var k: Child = kids[c];
        var f: Node = nodes[k.val];
        var fname: string = f.sa;
        var tname: string = "";
        if (f.na >= 0) {
            var ft: Node = nodes[f.na];
            if (ft.kind == "scalar") {
                tname = ft.sa;
            }
        }
        append(imp_fnames, fname);
        append(imp_ftypes, tname);
        count = count + 1;
        c = k.next;
    }
    return count;
}

// 校验单个值是否可赋给标量类型。返回 true=ok。
fn validate_scalar_value(val: string, tname: string, row_idx: i64, col_idx: i64) -> bool {
    if (tname == "string") { return true; }
    if (tname == "bool") {
        if (val == "true" || val == "false") { return true; }
        return false;
    }
    if (is_int_name(tname)) {
        // 简单检查：首字符可选负号，其余全数字
        var L: u64 = str_len(val);
        if (L == 0) { return false; }
        var start: u64 = 0;
        var c0: u8 = val[0];
        if (c0 == 45) { start = 1; }
        if (start >= L) { return false; }
        var i: u64 = start;
        while (i < L) {
            var ch: u8 = val[i];
            if (ch < 48 || ch > 57) { return false; }
            i = i + 1;
        }
        return true;
    }
    if (is_float_name(tname)) {
        // 简单检查：包含 . 或 e/E，或纯数字
        var L2: u64 = str_len(val);
        if (L2 == 0) { return false; }
        var has_dot: bool = false;
        var has_digit: bool = false;
        var i2: u64 = 0;
        if (val[0] == 45) { i2 = 1; }
        while (i2 < L2) {
            var ch2: u8 = val[i2];
            if (ch2 >= 48 && ch2 <= 57) { has_digit = true; }
            if (ch2 == 46) { has_dot = true; }
            i2 = i2 + 1;
        }
        if (has_digit == false) { return false; }
        return true;
    }
    return false;
}

// 为单个值合成标量字面量 AST 节点（int/float/bool/string + cast）
fn make_value_node(val: string, tname: string) -> i64 {
    if (tname == "string") {
        return mk_string(val, -1);
    }
    if (tname == "bool") {
        if (val == "true") { return mk_bool(true, -1); }
        return mk_bool(false, -1);
    }
    if (is_int_name(tname)) {
        var inode: i64 = mk_int(val, 10, -1);
        var target: i64 = mk_scalar(tname, -1);
        return mk_cast(inode, target, -1);
    }
    if (is_float_name(tname)) {
        var fnode: i64 = mk_float(val, -1);
        var target2: i64 = mk_scalar(tname, -1);
        return mk_cast(fnode, target2, -1);
    }
    return mk_string(val, -1);
}

// CSV 解析：返回行数组，每行是列数组。简单实现：逗号分隔，双引号转义。
// 输出写入 out_rows（每行用 \x1f 分隔列）。
fn csv_parse(content: string) -> []string {
    var rows: []string;
    var sb: StringBuilder = sb_new();
    var in_quotes: bool = false;
    var row_buf: StringBuilder = sb_new();
    var col_buf: StringBuilder = sb_new();
    var L: u64 = str_len(content);
    var i: u64 = 0;
    while (i < L) {
        var ch: u8 = content[i];
        if (in_quotes) {
            if (ch == 34) {
                if (i + 1 < L && content[i + 1] == 34) {
                    sb_append_char(col_buf, 34);
                    i = i + 2;
                    continue;
                }
                in_quotes = false;
                i = i + 1;
                continue;
            }
            sb_append_char(col_buf, ch);
            i = i + 1;
            continue;
        }
        if (ch == 34) {
            in_quotes = true;
            i = i + 1;
            continue;
        }
        if (ch == 44) {
            // 逗号 → 列分隔
            sb_append_str(row_buf, sb_to_str(col_buf));
            sb_append_char(row_buf, 31);
            col_buf = sb_new();
            i = i + 1;
            continue;
        }
        if (ch == 10) {
            // 换行 → 行结束
            sb_append_str(row_buf, sb_to_str(col_buf));
            append(rows, sb_to_str(row_buf));
            row_buf = sb_new();
            col_buf = sb_new();
            i = i + 1;
            continue;
        }
        if (ch == 13) {
            // CR → 跳过
            i = i + 1;
            continue;
        }
        sb_append_char(col_buf, ch);
        i = i + 1;
    }
    // 尾行
    if (str_len(sb_to_str(col_buf)) > 0 || str_len(sb_to_str(row_buf)) > 0) {
        sb_append_str(row_buf, sb_to_str(col_buf));
        append(rows, sb_to_str(row_buf));
    }
    return rows;
}

// 从 CSV 行中提取第 col 列的值（\x1f 分隔）
fn csv_col(row: string, col: i64) -> string {
    var idx: i64 = 0;
    var sb2: StringBuilder = sb_new();
    var L: u64 = str_len(row);
    var i: u64 = 0;
    while (i < L) {
        var ch: u8 = row[i];
        if (ch == 31) {
            if (idx == col) {
                return sb_to_str(sb2);
            }
            idx = idx + 1;
            sb2 = sb_new();
            i = i + 1;
            continue;
        }
        sb_append_char(sb2, ch);
        i = i + 1;
    }
    if (idx == col) {
        return sb_to_str(sb2);
    }
    return "";
}

// JSON 解析：期望顶层是对象数组 [ {..}, {..} ]。
// 按 imp_fnames[imp_fbase .. imp_fbase+num_fields) 的字段序，把每个对象
// 归一化成与 CSV 相同的 \x1f 分隔行，从而复用后续的值域校验与合成逻辑。
// 缺失的键归一化为空串（后续值域校验会报 T_IMPORT_VALUE）。
// 返回行数组；解析失败返回空数组。
fn json_parse(content: string, num_fields: i64) -> []string {
    var rows: []string;
    var L: u64 = str_len(content);
    var i: u64 = 0;

    // 跳到第一个 '['
    while (i < L && content[i] != 91) { i = i + 1; }
    if (i >= L) { return rows; }
    i = i + 1;

    while (i < L) {
        // 跳空白与逗号
        while (i < L) {
            var c0: u8 = content[i];
            if (c0 == 32 || c0 == 9 || c0 == 10 || c0 == 13 || c0 == 44) {
                i = i + 1;
                continue;
            }
            break;
        }
        if (i >= L) { break; }
        if (content[i] == 93) { break; }
        if (content[i] != 123) { return rows; }
        i = i + 1;

        // 收集本对象的键值对到临时并列表
        var kbase: i64 = slice_len(jp_keys) as i64;
        while (i < L) {
            // 跳空白与逗号
            while (i < L) {
                var c1: u8 = content[i];
                if (c1 == 32 || c1 == 9 || c1 == 10 || c1 == 13 || c1 == 44) {
                    i = i + 1;
                    continue;
                }
                break;
            }
            if (i >= L) { break; }
            if (content[i] == 125) { i = i + 1; break; }
            if (content[i] != 34) { return rows; }

            // 读键
            i = i + 1;
            var kb: StringBuilder = sb_new();
            while (i < L && content[i] != 34) {
                sb_append_char(kb, content[i]);
                i = i + 1;
            }
            i = i + 1;

            // 跳到冒号
            while (i < L && content[i] != 58) { i = i + 1; }
            i = i + 1;
            while (i < L) {
                var c2: u8 = content[i];
                if (c2 == 32 || c2 == 9 || c2 == 10 || c2 == 13) {
                    i = i + 1;
                    continue;
                }
                break;
            }
            if (i >= L) { break; }

            // 读值：字符串带引号，其余读到分隔符
            var vb: StringBuilder = sb_new();
            if (content[i] == 34) {
                i = i + 1;
                while (i < L && content[i] != 34) {
                    if (content[i] == 92 && i + 1 < L) {
                        i = i + 1;
                        var esc: u8 = content[i];
                        if (esc == 110) { sb_append_char(vb, 10); }
                        if (esc == 116) { sb_append_char(vb, 9); }
                        if (esc == 114) { sb_append_char(vb, 13); }
                        if (esc == 34) { sb_append_char(vb, 34); }
                        if (esc == 92) { sb_append_char(vb, 92); }
                        i = i + 1;
                        continue;
                    }
                    sb_append_char(vb, content[i]);
                    i = i + 1;
                }
                i = i + 1;
            } else {
                while (i < L) {
                    var c3: u8 = content[i];
                    if (c3 == 44 || c3 == 125 || c3 == 32 || c3 == 9 || c3 == 10 || c3 == 13) {
                        break;
                    }
                    sb_append_char(vb, c3);
                    i = i + 1;
                }
            }
            append(jp_keys, sb_to_str(kb));
            append(jp_vals, sb_to_str(vb));
        }

        // 按字段序拼成 \x1f 行
        var kn: i64 = slice_len(jp_keys) as i64;
        var rb: StringBuilder = sb_new();
        var fi: i64 = 0;
        while (fi < num_fields) {
            if (fi > 0) { sb_append_char(rb, 31); }
            var want: string = imp_fnames[(imp_fbase + fi) as u64];
            var ki: i64 = kbase;
            while (ki < kn) {
                if (jp_keys[ki as u64] == want) {
                    sb_append_str(rb, jp_vals[ki as u64]);
                    ki = kn;
                    continue;
                }
                ki = ki + 1;
            }
            fi = fi + 1;
        }
        append(rows, sb_to_str(rb));
    }
    return rows;
}

// 合成 __import_N 加载函数并返回其节点索引。
// 形态: __import_N fn() -> []StructName {
//   var __r: []StructName;
//   var __imp_r0: StructName = StructName{ f1: val1, f2: val2, ... };
//   append(__r, __imp_r0);
//   ...
//   return __r;
// }
fn synthesize_loader(sname: string, rows: []string, header_row: string, num_fields: i64, is_csv: bool) -> i64 {
    var fn_name: string = sb_cat2("__import_", i2s(g_imp_counter));
    g_imp_counter = g_imp_counter + 1;

    // 返回类型: []StructName
    var elem_named: i64 = mk_named(sname, -1);
    var ret_slice: i64 = mk_slice(elem_named, -1);

    // 函数体语句链表
    var body_head: i64 = -1;
    var body_tail: i64 = -1;

    // var __r: []StructName;
    var r_type: i64 = mk_slice(mk_named(sname, -1), -1);
    var r_decl: i64 = mk_var_decl("__r", false, r_type, -1, -1);
    body_tail = list_push(body_head, body_tail, r_decl);
    if (body_head < 0) { body_head = body_tail; }

    // CSV: header_row 是第一行，用于字段名映射
    // JSON: rows 直接是对象数组，field_names 已固定
    var nrows: i64 = slice_len(rows) as i64;
    var ri: i64 = 0;
    if (is_csv) {
        ri = 1; // 跳过表头
    }
    while (ri < nrows) {
        var row: string = rows[ri];
        // 构建 struct_lit 的字段链表
        var fv_head: i64 = -1;
        var fv_tail: i64 = -1;
        var ci: i64 = 0;
        while (ci < num_fields) {
            var fname: string = imp_fnames[(imp_fbase + ci) as u64];
            var ftype: string = imp_ftypes[(imp_fbase + ci) as u64];
            var col_val: string;
            if (is_csv) {
                // 根据 header_row 中的列名映射
                col_val = csv_col(row, ci);
            } else {
                col_val = csv_col(row, ci);
            }
            var vnode: i64 = make_value_node(col_val, ftype);
            var fv: i64 = mk_FV(fname, vnode, -1);
            fv_tail = list_push(fv_head, fv_tail, fv);
            if (fv_head < 0) { fv_head = fv_tail; }
            ci = ci + 1;
        }
        var lit: i64 = mk_struct_lit(sname, fv_head, -1);
        var tmp_name: string = sb_cat2("__imp_r", i2s(ri));
        var tmp_decl: i64 = mk_var_decl(tmp_name, false, mk_named(sname, -1), lit, -1);
        body_tail = list_push(body_head, body_tail, tmp_decl);
        if (body_head < 0) { body_head = body_tail; }

        // append(__r, __imp_r0);
        var call_args_head: i64 = -1;
        var call_args_tail: i64 = -1;
        call_args_tail = list_push(call_args_head, call_args_tail, mk_ident("__r", -1));
        if (call_args_head < 0) { call_args_head = call_args_tail; }
        call_args_tail = list_push(call_args_head, call_args_tail, mk_ident(tmp_name, -1));
        if (call_args_head < 0) { call_args_head = call_args_tail; }
        var append_call: i64 = mk_call(mk_ident("append", -1), call_args_head, -1);
        var append_stmt: i64 = mk_expr(append_call, -1);
        body_tail = list_push(body_head, body_tail, append_stmt);
        if (body_head < 0) { body_head = body_tail; }

        ri = ri + 1;
    }

    // return __r;
    var ret_stmt: i64 = mk_return(mk_ident("__r", -1), -1);
    body_tail = list_push(body_head, body_tail, ret_stmt);
    if (body_head < 0) { body_head = body_tail; }

    // ba=is_extern 必须为 false，否则 emitter 只发 declare 不发函数体；
    // lb=参数列表用 -2 表示空（-1 会被当作 null 链表头处理）
    var fdecl: i64 = mk_FuncDecl(fn_name, false, false, ret_slice, -1, -1, body_head, -1);
    // 注册符号
    sym_define(global_scope, fn_name, "func", ti_named("Func", fn_name), fdecl);
    // 加入 decl_list，使 emitter 能发射该合成函数。
    // 注意：desugar_imports 在 register 循环之后、check 循环之前运行，
    // check 循环用 slice_len(decl_list) 重新取长度，故新增项也会被检查。
    append(decl_list, fdecl);
    return fdecl;
}

// 检测一个表达式是否是 import_csv/import_json 调用
fn is_import_call(expr_idx: i64) -> string {
    if (expr_idx < 0) { return ""; }
    var n: Node = nodes[expr_idx];
    if (n.kind != "call") { return ""; }
    if (n.na < 0) { return ""; }
    var callee: Node = nodes[n.na];
    if (callee.kind != "ident") { return ""; }
    if (callee.sa == "import_csv") { return "csv"; }
    if (callee.sa == "import_json") { return "json"; }
    return "";
}

// 从 import call 节点提取路径参数字符串
fn import_path_arg(call_idx: i64) -> string {
    var n: Node = nodes[call_idx];
    var c: i64 = n.la;
    if (c < 0) { return ""; }
    var k: Child = kids[c];
    var arg: Node = nodes[k.val];
    if (arg.kind == "string") { return arg.sa; }
    return "";
}

// 对单个 var_decl 执行脱糖。成功返回 true。
fn desugar_one(var_idx: i64, file_for_diag: string, ln: i64, cl: i64) -> bool {
    var vn: Node = nodes[var_idx];
    var imp_kind: string = is_import_call(vn.nb);
    if (imp_kind == "") { return false; }

    // 提取目标类型: []StructName
    var sname: string = import_elem_struct_name(vn.na);
    if (sname == "") {
        diag_new("T_IMPORT_CONTEXT", "error",
            "import_csv/import_json requires target type []StructName",
            file_for_diag, ln, cl, ln, cl + 20);
        return false;
    }

    // 查找 struct 字段
    var field_head: i64 = find_struct_fields(sname);
    if (field_head < 0) {
        diag_new("T_IMPORT_CONTEXT", "error",
            sb_cat3("struct '", sname, "' not found for import"),
            file_for_diag, ln, cl, ln, cl + 20);
        return false;
    }

    imp_fbase = slice_len(imp_fnames) as i64;
    var num_fields: i64 = collect_struct_fields(field_head);

    // 提取路径参数
    var path: string = import_path_arg(vn.nb);
    if (path == "") {
        diag_new("T_IMPORT_CONTEXT", "error",
            "import_csv/import_json requires a string literal path argument",
            file_for_diag, ln, cl, ln, cl + 20);
        return false;
    }

    // 解析路径（相对源文件目录）
    var dir: string = "";
    var slash: i64 = -1;
    var pl: u64 = str_len(g_file);
    var pi: u64 = 0;
    while (pi < pl) {
        var ch: u8 = g_file[pi];
        if (ch == 47 || ch == 92) { slash = pi as i64; }
        pi = pi + 1;
    }
    if (slash >= 0) {
        dir = str_slice(g_file, 0, slash + 1);
    }
    var full_path: string = sb_cat2(dir, path);

    // 存在性检查
    if (file_exists(full_path) == false) {
        diag_new("T_IMPORT_IO", "error",
            sb_cat3("import: file not found: ", full_path, ""),
            file_for_diag, ln, cl, ln, cl + 20);
        return false;
    }

    // 读文件
    var content: string = file_read_all(full_path);

    // 解析
    var rows: []string;
    var is_csv: bool;
    if (imp_kind == "csv") {
        // CSV 首行是表头，后续按 is_csv 跳过
        is_csv = true;
        rows = csv_parse(content);
    } else {
        // JSON 已按字段序归一化，无表头行
        is_csv = false;
        rows = json_parse(content, num_fields);
    }

    if (slice_len(rows) as i64 == 0) {
        diag_new("T_IMPORT_IO", "error",
            sb_cat3("import: file is empty: ", full_path, ""),
            file_for_diag, ln, cl, ln, cl + 20);
        return false;
    }

    // CSV: 验证表头
    if (imp_kind == "csv") {
        var header: string = rows[0];
        var hi: i64 = 0;
        while (hi < num_fields) {
            var hval: string = csv_col(header, hi);
            if (hval != imp_fnames[(imp_fbase + hi) as u64]) {
                diag_new("T_IMPORT_HEADER", "error",
                    sb_cat5("CSV header column ", i2s(hi), ": expected '", imp_fnames[(imp_fbase + hi) as u64], "'"),
                    file_for_diag, ln, cl, ln, cl + 20);
                return false;
            }
            hi = hi + 1;
        }
    }

    // 值域校验
    var nrows: i64 = slice_len(rows) as i64;
    var ri2: i64 = 0;
    if (is_csv) { ri2 = 1; }
    while (ri2 < nrows) {
        var row2: string = rows[ri2];
        var ci2: i64 = 0;
        while (ci2 < num_fields) {
            var val2: string = csv_col(row2, ci2);
            var ftype2: string = imp_ftypes[(imp_fbase + ci2) as u64];
            if (validate_scalar_value(val2, ftype2, ri2, ci2) == false) {
                diag_new("T_IMPORT_VALUE", "error",
                    sb_cat5("import: row ", i2s(ri2), " col ", i2s(ci2), ": invalid value for type"),
                    file_for_diag, ln, cl, ln, cl + 20);
                return false;
            }
            ci2 = ci2 + 1;
        }
        ri2 = ri2 + 1;
    }

    // 合成加载函数
    var loader_fn: i64 = synthesize_loader(sname, rows, rows[0], num_fields, is_csv);

    // 替换原 init 为对加载函数的调用
    var new_call: i64 = mk_call(mk_ident(sb_cat2("__import_", i2s(g_imp_counter - 1)), -1), -1, -1);
    var nn: Node = nodes[var_idx];
    nn.nb = new_call;
    slice_set(nodes, var_idx, nn);

    return true;
}

// 遍历函数体语句链表，检测 import 脱糖点
fn desugar_stmts(stmt_head: i64, file_for_diag: string) -> void {
    var c: i64 = stmt_head;
    while (c >= 0) {
        var k: Child = kids[c];
        var s: Node = nodes[k.val];
        if (s.kind == "var_decl") {
            desugar_one(k.val, file_for_diag, s.ln, s.cl);
        }
        // 残存的 import 调用（不在 var 初始化位置）→ T_IMPORT_CONTEXT
        if (s.kind == "expr") {
            if (is_import_call(s.na) != "") {
                diag_new("T_IMPORT_CONTEXT", "error",
                    "import_csv/import_json is only allowed as a var initializer",
                    file_for_diag, s.ln, s.cl, s.ln, s.cl + 20);
            }
        }
        // 递归 if/while/for/block 体
        if (s.kind == "if") {
            desugar_stmts(s.la, file_for_diag);
            if (s.lb > -2) { desugar_stmts(s.lb, file_for_diag); }
        }
        if (s.kind == "while" || s.kind == "block") {
            desugar_stmts(s.la, file_for_diag);
        }
        if (s.kind == "for") {
            desugar_stmts(s.la, file_for_diag);
        }
        c = k.next;
    }
}

fn desugar_imports() -> void {
    g_imp_counter = 0;
    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = decl_list[i];
        var dn: Node = nodes[d];
        if (dn.kind == "FuncDecl" && dn.lc != -2) {
            desugar_stmts(dn.lc, n_file(d));
        }
        i = i + 1;
    }
}

// ── check 主流程（复刻 checker.ts:83）─────────────────────────

fn run_check() -> void {
    global_scope = scope_new(-1);
    cur_scope = global_scope;
    cur_ret = ti_mk("Void");

    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        register_decl(decl_list[i]);
        i = i + 1;
    }
    desugar_imports();
    // desugar 可能追加合成的 __import_N 函数，重新取长度以便一并检查
    var n2: i64 = slice_len(decl_list) as i64;
    var j: i64 = 0;
    while (j < n2) {
        check_decl(decl_list[j]);
        j = j + 1;
    }
}

// ── Flag Resolver（复刻 tc0/flag/bitfield.ts resolve）─────────
// 注意：与 checker.checkFlagDecl 不同——overflow 先检、overlap 后检；
// FlagSetDecl 不产生诊断。

var fr_names: []string;
var fr_starts: []i64;
var fr_ends: []i64;

fn fr_resolve_flag(d: i64) -> void {
    var n: Node = nodes[d];
    var tw: i64 = get_bw(n.sb);
    if (tw < 0) {
        tw = 32;
    }
    var auto_off: i64 = 0;
    var base: i64 = slice_len(fr_names) as i64;

    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var sl: Node = nodes[k.val];
        var start: i64 = auto_off;
        if (sl.bb) {
            start = sl.ib;
        }
        var end: i64 = start + sl.ia;

        if (end > tw) {
            var osb: StringBuilder = sb_new();
            sb_append_str(osb, "flag '");
            sb_append_str(osb, n.sa);
            sb_append_str(osb, "' slot '");
            sb_append_str(osb, sl.sa);
            sb_append_str(osb, "' exceeds ");
            sb_append_str(osb, n.sb);
            sb_append_str(osb, " capacity: uses bits ");
            sb_append_i64(osb, start);
            sb_append_str(osb, "-");
            sb_append_i64(osb, end - 1);
            sb_append_str(osb, ", but ");
            sb_append_str(osb, n.sb);
            sb_append_str(osb, " only has ");
            sb_append_i64(osb, tw);
            sb_append_str(osb, " bits");
            var di: i64 = diag_new("T_FLAG_OVERFLOW", "error", sb_to_str(osb), "", 0, 0, 0, 0);
            slb_begin();
            slb_add(sb_cat2("0-", i2s(tw - 1)));
            diag_set_vv(di, slb_head);
            var fx: i64 = fix_one("reduce bit width or use larger underlying type (u64)", "", 0, 0, 0, 0, "flag[u64]");
            diag_set_fs(di, fx);
        }

        var i: i64 = base;
        var total: i64 = slice_len(fr_names) as i64;
        while (i < total) {
            var us: i64 = fr_starts[i];
            var ue: i64 = fr_ends[i];
            if (start < ue && end > us) {
                var msb: StringBuilder = sb_new();
                sb_append_str(msb, "flag slot '");
                sb_append_str(msb, sl.sa);
                sb_append_str(msb, "' (bits ");
                sb_append_i64(msb, start);
                sb_append_str(msb, "-");
                sb_append_i64(msb, end - 1);
                sb_append_str(msb, ") overlaps with '");
                sb_append_str(msb, fr_names[i]);
                sb_append_str(msb, "' (bits ");
                sb_append_i64(msb, us);
                sb_append_str(msb, "-");
                sb_append_i64(msb, ue - 1);
                sb_append_str(msb, ")");
                diag_new("T_FLAG_OFFSET_CONFLICT", "error", sb_to_str(msb), "", 0, 0, 0, 0);
            }
            i = i + 1;
        }

        append(fr_names, sl.sa);
        append(fr_starts, start);
        append(fr_ends, end);
        auto_off = end;
        c = k.next;
    }
}

fn flag_pass() -> void {
    // 复刻 index.ts compilePipeline：每个 FlagDecl 被 resolve 两次——
    // 一次经 typeInfoProvider.registerDecl（内部调 flagResolver.resolve），
    // 一次为管线中的直接 flagResolver.resolve(decl)。诊断因此重复两遍。
    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = decl_list[i];
        var nd: Node = nodes[d];
        if (nd.kind == "FlagDecl") {
            fr_resolve_flag(d);
            fr_resolve_flag(d);
        }
        i = i + 1;
    }
}

// ── 注解注册表（复刻 tc0/annotations/registry.ts）─────────────

AnnDef struct {
    name: string;
    spec: string;       // none/string/ident/ident_list/number/mixed
    targets: string;    // ", " 分隔（照 validTargets.join(", ") 顺序）
    depr: bool;
    repl: string;
}

var anndefs: []AnnDef;

fn ad(name: string, spec: string, targets: string) -> void {
    var a: AnnDef;
    a.name = name;
    a.spec = spec;
    a.targets = targets;
    a.depr = false;
    a.repl = "";
    append(anndefs, a);
}

// >>> GEN:annotations (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
fn init_anndefs() -> void {
    ad("test", "none", "func");
    ad("test_skip", "none", "func");
    ad("test_only", "none", "func");
    ad("expect_fail", "none", "func");
    ad("test_group", "string", "func");
    ad("derive", "ident_list", "struct, enum, flag, flag_set, union");
    ad("cfg", "ident", "global, func, struct, enum, var, const");
    ad("cfg_attr", "mixed", "global, func, struct, enum");
    ad("allow", "ident_list", "global, func, struct, var, const");
    ad("warn", "ident_list", "global, func, struct, var, const");
    ad("deny", "ident_list", "global, func, struct, var, const");
    ad("deprecated", "string", "global, func, struct, enum, var, const");
    ad("repr", "ident", "struct, enum, union");
    ad("no_padding", "none", "struct, flag");
    ad("align", "number", "struct, union");
    ad("bitpack", "ident", "struct");
    ad("offset", "number", "flag_slot");
    ad("binary_offset", "number", "field");
    ad("binary_skip", "none", "field");
    ad("soa", "none", "struct");
    ad("aos", "none", "struct");
    ad("inline", "none", "func");
    ad("no_inline", "none", "func");
    ad("must_use", "none", "func");
    ad("const_fn", "none", "func");
    ad("unsafe", "none", "func");
    ad("main", "none", "func");
    ad("export_symbol", "string", "func");
    ad("link_name", "string", "func");
    ad("panic_handler", "none", "func");
    ad("doc", "string", "global");
    ad("doc_file", "string", "func, struct, enum");
    ad("export", "mixed", "field, func, var, const");
    ad("auto_convert", "none", "struct, enum");
    // 弃用标记（数据驱动生成）
    var diauto_convert: i64 = anndef_find("auto_convert");
    if (diauto_convert >= 0) {
        var aauto_convert: AnnDef = anndefs[diauto_convert];
        aauto_convert.depr = true;
        aauto_convert.repl = "@derive(FromString)";
        slice_set(anndefs, diauto_convert, aauto_convert);
    }
}
// <<< GEN:annotations <<<

fn anndef_find(name: string) -> i64 {
    var n: i64 = slice_len(anndefs) as i64;
    var i: i64 = 0;
    while (i < n) {
        var a: AnnDef = anndefs[i];
        if (a.name == name) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// ", " 分隔的 targets 中精确匹配
fn targets_has(ts: string, t: string) -> bool {
    var n: i64 = str_len(ts) as i64;
    var start: i64 = 0;
    var i: i64 = 0;
    while (i <= n) {
        var hit: bool = i == n;
        if (hit == false) {
            hit = ts[i] == 44;
        }
        if (hit) {
            var seg: string = str_slice(ts, start, i);
            if (seg == t) {
                return true;
            }
            start = i + 2;
            i = i + 1;
        }
        i = i + 1;
    }
    return false;
}

// 把 targets 逐段加入 slb（validValues）
fn targets_push_vv(ts: string) -> void {
    var n: i64 = str_len(ts) as i64;
    var start: i64 = 0;
    var i: i64 = 0;
    while (i <= n) {
        var hit: bool = i == n;
        if (hit == false) {
            hit = ts[i] == 44;
        }
        if (hit) {
            slb_add(str_slice(ts, start, i));
            start = i + 2;
            i = i + 1;
        }
        i = i + 1;
    }
}

fn starts_with(s: string, p: string) -> bool {
    var np: u64 = str_len(p);
    if (str_len(s) < np) {
        return false;
    }
    var i: u64 = 0;
    while (i < np) {
        if (s[i] != p[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn is_cfg_cond(v: string) -> bool {
    if (v == "debug" || v == "release" || v == "windows" || v == "linux") {
        return true;
    }
    return v == "mac" || v == "android" || v == "web";
}

fn is_derive_trait(v: string) -> bool {
    if (v == "ToString" || v == "FromString" || v == "Clone" || v == "Copy") {
        return true;
    }
    if (v == "DebugPrint" || v == "BinarySerde" || v == "Eq") {
        return true;
    }
    return v == "PartialEq" || v == "Hash";
}

fn is_valid_warning(v: string) -> bool {
    if (v == "unused" || v == "unused_field" || v == "dead_code") {
        return true;
    }
    if (v == "overflow_literal" || v == "implicit_cast") {
        return true;
    }
    return v == "bitfield_overlap" || v == "deprecated";
}

// >>> GEN:derives (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
fn vv_derive_traits() -> void {
    slb_add("ToString");
    slb_add("FromString");
    slb_add("Clone");
    slb_add("Copy");
    slb_add("DebugPrint");
    slb_add("BinarySerde");
    slb_add("Eq");
    slb_add("PartialEq");
    slb_add("Hash");
}
// <<< GEN:derives <<<

fn vv_warnings() -> void {
    slb_add("unused");
    slb_add("unused_field");
    slb_add("dead_code");
    slb_add("overflow_literal");
    slb_add("implicit_cast");
    slb_add("bitfield_overlap");
    slb_add("deprecated");
}

fn vv_cfg() -> void {
    slb_add("debug");
    slb_add("release");
    slb_add("windows");
    slb_add("linux");
    slb_add("mac");
    slb_add("android");
    slb_add("web");
}

// derive/allow/warn/deny 的 trait/warning 项遍历校验
fn ann_check_items(ai: i64, is_derive: bool, l: i64, c: i64) -> void {
    var an: Node = nodes[ai];
    var c1: i64 = an.la;
    while (c1 >= 0) {
        var k: Child = kids[c1];
        var arg: Node = nodes[k.val];
        if (arg.kind == "list") {
            var c2: i64 = arg.la;
            while (c2 >= 0) {
                var k2: Child = kids[c2];
                var m: Node = nodes[k2.val];
                var v: string = "";
                if (m.kind == "ident") {
                    v = m.sa;
                }
                ann_check_item(v, is_derive, l, c);
                c2 = k2.next;
            }
        } else {
            var v2: string = "";
            if (arg.kind == "ident") {
                v2 = arg.sa;
            }
            ann_check_item(v2, is_derive, l, c);
        }
        c1 = k.next;
    }
}

fn ann_check_item(v: string, is_derive: bool, l: i64, c: i64) -> void {
    if (is_derive) {
        if (is_derive_trait(v) == false) {
            var di: i64 = diag_new("T_DERIVE_UNSUPPORTED", "error",
                sb_cat3("unsupported derive trait '", v, "'"),
                g_file, l, c, l, c + 20);
            slb_begin();
            vv_derive_traits();
            diag_set_vv(di, slb_head);
        }
        return;
    }
    if (is_valid_warning(v) == false) {
        var di2: i64 = diag_new("T_ANNOTATION_INVALID_ARG", "error",
            sb_cat3("unknown warning item '", v, "'"),
            g_file, l, c, l, c + 20);
        slb_begin();
        vv_warnings();
        diag_set_vv(di2, slb_head);
    }
}

// validate（复刻 registry.ts:168）；ai = A 节点索引
fn ann_validate(ai: i64, target: string) -> void {
    var an: Node = nodes[ai];
    var name: string = an.sa;
    var l: i64 = an.ln as i64;
    var c: i64 = an.cl as i64;
    var name_len: i64 = str_len(name) as i64;
    var di_: i64 = anndef_find(name);

    if (di_ < 0) {
        var d1: i64 = diag_new("T_ANNOTATION_UNKNOWN", "error",
            sb_cat3("unknown annotation '@", name, "'"),
            g_file, l, c, l, c + name_len + 1);
        slb_begin();
        var n: i64 = slice_len(anndefs) as i64;
        var i: i64 = 0;
        while (i < n) {
            var a: AnnDef = anndefs[i];
            slb_add(sb_cat2("@", a.name));
            i = i + 1;
        }
        diag_set_vv(d1, slb_head);
        return;
    }

    var def: AnnDef = anndefs[di_];

    if (def.depr) {
        var msg: string = sb_cat3("annotation '@", name, "' is deprecated");
        if (str_len(def.repl) > 0) {
            msg = sb_cat4(msg, ", use ", def.repl, " instead");
        }
        diag_new("T_ANNOTATION_UNKNOWN", "warning", msg, g_file, l, c, l, c + name_len + 1);
    }

    if (targets_has(def.targets, target) == false) {
        var d2: i64 = diag_new("T_ANNOTATION_WRONG_TARGET", "error",
            sb_cat6("annotation '@", name, "' cannot be applied to ", target, ", valid targets: ", def.targets),
            g_file, l, c, l, c + name_len + 1);
        slb_begin();
        targets_push_vv(def.targets);
        diag_set_vv(d2, slb_head);
    }

    // ── validateArgs ──
    var argc: i64 = list_count(an.la);

    if (def.spec == "none") {
        if (argc > 0) {
            diag_new("T_ANNOTATION_INVALID_ARG", "error",
                sb_cat3("annotation '@", name, "' takes no arguments"),
                g_file, l, c, l, c + name_len + 1);
        }
        return;
    }
    if (def.spec == "string") {
        var bad: bool = argc != 1;
        if (bad == false) {
            var k0: Child = kids[an.la];
            var a0: Node = nodes[k0.val];
            bad = a0.kind != "string";
        }
        if (bad) {
            var d3: i64 = diag_new("T_ANNOTATION_INVALID_ARG", "error",
                sb_cat3("annotation '@", name, "' requires exactly one string argument"),
                g_file, l, c, l, c + name_len + 1);
            slb_begin();
            slb_add("@${annotation.name}(\"text\")");
            diag_set_vv(d3, slb_head);
        }
        return;
    }
    if (def.spec == "ident") {
        var bad2: bool = argc != 1;
        var a0k: string = "";
        var a0v: string = "";
        if (argc >= 1) {
            var k1: Child = kids[an.la];
            var a1: Node = nodes[k1.val];
            a0k = a1.kind;
            a0v = a1.sa;
        }
        if (bad2 == false) {
            bad2 = a0k != "ident" && a0k != "list";
        }
        if (bad2) {
            diag_new("T_ANNOTATION_INVALID_ARG", "error",
                sb_cat3("annotation '@", name, "' requires one identifier argument"),
                g_file, l, c, l, c + name_len + 1);
        }
        if (name == "cfg" && a0k == "ident") {
            if (is_cfg_cond(a0v) == false && starts_with(a0v, "feature=") == false) {
                var d4: i64 = diag_new("T_ANNOTATION_INVALID_ARG", "error",
                    sb_cat3("invalid @cfg condition '", a0v, "'"),
                    g_file, l, c, l, c + name_len + 1);
                slb_begin();
                vv_cfg();
                diag_set_vv(d4, slb_head);
            }
        }
        return;
    }
    if (def.spec == "ident_list") {
        if (argc < 1) {
            diag_new("T_ANNOTATION_INVALID_ARG", "error",
                sb_cat3("annotation '@", name, "' requires at least one argument"),
                g_file, l, c, l, c + name_len + 1);
        }
        if (name == "derive") {
            ann_check_items(ai, true, l, c);
        }
        if (name == "allow" || name == "warn" || name == "deny") {
            ann_check_items(ai, false, l, c);
        }
        return;
    }
    if (def.spec == "number") {
        var bad3: bool = argc != 1;
        if (bad3 == false) {
            var k2: Child = kids[an.la];
            var a2: Node = nodes[k2.val];
            bad3 = a2.kind != "number";
        }
        if (bad3) {
            diag_new("T_ANNOTATION_INVALID_ARG", "error",
                sb_cat3("annotation '@", name, "' requires one numeric argument"),
                g_file, l, c, l, c + name_len + 1);
        }
        return;
    }
}

// getDeclTarget（复刻 index.ts:181）
fn decl_target(kind: string) -> string {
    if (kind == "StructDecl") {
        return "struct";
    }
    if (kind == "EnumDecl") {
        return "enum";
    }
    if (kind == "FlagDecl") {
        return "flag";
    }
    if (kind == "FlagSetDecl") {
        return "flag_set";
    }
    if (kind == "UnionDecl") {
        return "union";
    }
    if (kind == "VariantDecl") {
        return "variant";
    }
    if (kind == "FuncDecl") {
        return "func";
    }
    if (kind == "GlobalVarDecl") {
        return "var";
    }
    if (kind == "GlobalConstDecl") {
        return "const";
    }
    return "global";
}

fn ann_pass() -> void {
    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = decl_list[i];
        var nd: Node = nodes[d];
        var target: string = decl_target(nd.kind);
        var c: i64 = nd.la;
        while (c >= 0) {
            var k: Child = kids[c];
            ann_validate(k.val, target);
            c = k.next;
        }
        i = i + 1;
    }
}

// ── pretty JSON 输出（复刻 JSON.stringify(x, null, 2)）────────

fn hex_digit(v: u8) -> u8 {
    if (v < 10) {
        return 48 + v;
    }
    return 97 + (v - 10);
}

fn json_escape_into(out: StringBuilder, s: string) -> void {
    var i: u64 = 0;
    var n: u64 = str_len(s);
    while (i < n) {
        var b: u8 = s[i];
        if (b == 34) {
            sb_append_char(out, 92);
            sb_append_char(out, 34);
        } else {
        if (b == 92) {
            sb_append_char(out, 92);
            sb_append_char(out, 92);
        } else {
        if (b == 10) {
            sb_append_char(out, 92);
            sb_append_char(out, 110);
        } else {
        if (b == 9) {
            sb_append_char(out, 92);
            sb_append_char(out, 116);
        } else {
        if (b == 13) {
            sb_append_char(out, 92);
            sb_append_char(out, 114);
        } else {
        if (b == 8) {
            sb_append_char(out, 92);
            sb_append_char(out, 98);
        } else {
        if (b == 12) {
            sb_append_char(out, 92);
            sb_append_char(out, 102);
        } else {
        if (b < 32) {
            sb_append_char(out, 92);
            sb_append_char(out, 117);
            sb_append_char(out, 48);
            sb_append_char(out, 48);
            sb_append_char(out, hex_digit(b / 16));
            sb_append_char(out, hex_digit(b % 16));
        } else {
            sb_append_char(out, b);
        }}}}}}}}
        i = i + 1;
    }
}

fn j_qstr(out: StringBuilder, s: string) -> void {
    sb_append_char(out, 34);
    json_escape_into(out, s);
    sb_append_char(out, 34);
}

// "      \"key\": \"value\",\n" 之类的辅助
fn jkv_str(out: StringBuilder, ind: string, key: string, val: string, comma: bool) -> void {
    sb_append_str(out, ind);
    sb_append_char(out, 34);
    sb_append_str(out, key);
    sb_append_str(out, "\": ");
    j_qstr(out, val);
    if (comma) {
        sb_append_char(out, 44);
    }
    sb_append_char(out, 10);
}

fn jkv_num(out: StringBuilder, ind: string, key: string, val: i64, comma: bool) -> void {
    sb_append_str(out, ind);
    sb_append_char(out, 34);
    sb_append_str(out, key);
    sb_append_str(out, "\": ");
    sb_append_i64(out, val);
    if (comma) {
        sb_append_char(out, 44);
    }
    sb_append_char(out, 10);
}

// location/range 对象输出
fn j_loc(out: StringBuilder, ind: string, ind2: string, key: string, file: string, sl: i64, sc: i64, el: i64, ec: i64, comma: bool) -> void {
    sb_append_str(out, ind);
    sb_append_char(out, 34);
    sb_append_str(out, key);
    sb_append_str(out, "\": {");
    sb_append_char(out, 10);
    jkv_str(out, ind2, "file", file, true);
    jkv_num(out, ind2, "startLine", sl, true);
    jkv_num(out, ind2, "startCol", sc, true);
    jkv_num(out, ind2, "endLine", el, true);
    jkv_num(out, ind2, "endCol", ec, false);
    sb_append_str(out, ind);
    sb_append_char(out, 125);
    if (comma) {
        sb_append_char(out, 44);
    }
    sb_append_char(out, 10);
}

// 字符串链表数组输出（validValues/notes）；head=-1 输出 null
fn j_str_list(out: StringBuilder, ind: string, ind2: string, key: string, head: i64, comma: bool) -> void {
    sb_append_str(out, ind);
    sb_append_char(out, 34);
    sb_append_str(out, key);
    sb_append_str(out, "\": ");
    if (head < 0) {
        sb_append_str(out, "null");
    } else {
        sb_append_char(out, 91);
        sb_append_char(out, 10);
        var c: i64 = head;
        while (c >= 0) {
            var it: SI = sitems[c];
            sb_append_str(out, ind2);
            j_qstr(out, it.s);
            if (it.next >= 0) {
                sb_append_char(out, 44);
            }
            sb_append_char(out, 10);
            c = it.next;
        }
        sb_append_str(out, ind);
        sb_append_char(out, 93);
    }
    if (comma) {
        sb_append_char(out, 44);
    }
    sb_append_char(out, 10);
}

fn print_json() -> void {
    var out: StringBuilder = sb_new();
    var nd: i64 = slice_len(diags) as i64;

    sb_append_str(out, "{\n");
    if (nd == 0) {
        sb_append_str(out, "  \"diagnostics\": [],\n");
    } else {
        sb_append_str(out, "  \"diagnostics\": [\n");
        var i: i64 = 0;
        while (i < nd) {
            var d: Diag = diags[i];
            sb_append_str(out, "    {\n");
            jkv_str(out, "      ", "code", d.code, true);
            jkv_str(out, "      ", "severity", d.sev, true);
            jkv_str(out, "      ", "message", d.msg, true);
            j_loc(out, "      ", "        ", "location", d.file, d.sl, d.sc, d.el, d.ec, true);
            j_str_list(out, "      ", "        ", "validValues", d.vv, true);

            // fixSuggestions
            sb_append_str(out, "      \"fixSuggestions\": ");
            if (d.fs < 0) {
                sb_append_str(out, "null");
            } else {
                sb_append_str(out, "[\n");
                var f: i64 = d.fs;
                while (f >= 0) {
                    var fx: FixS = fixes[f];
                    sb_append_str(out, "        {\n");
                    jkv_str(out, "          ", "description", fx.desc, true);
                    j_loc(out, "          ", "            ", "range", fx.file, fx.sl, fx.sc, fx.el, fx.ec, true);
                    jkv_str(out, "          ", "replacement", fx.repl, false);
                    sb_append_str(out, "        }");
                    if (fx.next >= 0) {
                        sb_append_char(out, 44);
                    }
                    sb_append_char(out, 10);
                    f = fx.next;
                }
                sb_append_str(out, "      ]");
            }
            sb_append_str(out, ",\n");

            j_str_list(out, "      ", "        ", "notes", d.nt, false);

            sb_append_str(out, "    }");
            if (i + 1 < nd) {
                sb_append_char(out, 44);
            }
            sb_append_char(out, 10);
            i = i + 1;
        }
        sb_append_str(out, "  ],\n");
    }

    var errs: i64 = 0;
    var warns: i64 = 0;
    var infos: i64 = 0;
    var j: i64 = 0;
    while (j < nd) {
        var d2: Diag = diags[j];
        if (d2.sev == "error") {
            errs = errs + 1;
        }
        if (d2.sev == "warning") {
            warns = warns + 1;
        }
        if (d2.sev == "info") {
            infos = infos + 1;
        }
        j = j + 1;
    }
    sb_append_str(out, "  \"summary\": {\n");
    jkv_num(out, "    ", "total", nd, true);
    jkv_num(out, "    ", "errors", errs, true);
    jkv_num(out, "    ", "warnings", warns, true);
    jkv_num(out, "    ", "infos", infos, false);
    sb_append_str(out, "  }\n");
    sb_append_str(out, "}");

    print(sb_to_str(out));
    print("\n");
}

fn has_errors() -> bool {
    var n: i64 = slice_len(diags) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: Diag = diags[i];
        if (d.sev == "error") {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// ═══════════════════════════════════════════════════════════════
// M8: C Emitter（复刻 tc0/codegen/emitter.ts）
// ═══════════════════════════════════════════════════════════════

// ── 输出行池 ───────────────────────────────────────────────────

var hlines: []string;   // headerLines
var slines: []string;   // sourceLines
var glines: []string;   // 全局初始化函数体（t__ginit）
// 重定向开关：为 true 时 spush 写入 glines（全局 var 初始化器需运行期构建，
// 如 map 字面量在 C 中不是编译期常量，必须搬进 t__ginit）。
var g_spush_to_ginit: bool = false;
// type_info(T) 编译期常量合成（M36）：去重表 + 模块级常量定义缓冲
var ti_lines: []string;
var ti_done: []string;

fn hpush(s: string) -> void {
    append(hlines, s);
}

fn spush(s: string) -> void {
    if (g_spush_to_ginit) {
        append(glines, s);
        return;
    }
    append(slines, s);
}

// 向最后一行追加文本（ForStmt 拼接用）
fn sappend_last(s: string) -> void {
    var n: i64 = slice_len(slines) as i64;
    var last: string = slines[n - 1];
    var joined: string = sb_cat2(last, s);
    slice_set(slines, n - 1, joined);
}

// ── 小工具 ─────────────────────────────────────────────────────

fn to_upper(s: string) -> string {
    var sb: StringBuilder = sb_new();
    var i: u64 = 0;
    var n: u64 = str_len(s);
    while (i < n) {
        var c: u8 = s[i];
        if (c >= 97 && c <= 122) {
            sb_append_char(sb, c - 32);
        } else {
            sb_append_char(sb, c);
        }
        i = i + 1;
    }
    return sb_to_str(sb);
}

fn ends_with_star(s: string) -> bool {
    var n: u64 = str_len(s);
    if (n == 0) {
        return false;
    }
    return s[n - 1] == 42;
}

// ── TypeDesc 池（复刻 TypeDesc interface）──────────────────────
// cat: "string" | "slice" | "map" | "named" | "scalar" | "unknown" | "void"

TD struct {
    cat: string;
    name: string;
    elem: i64;   // TD 索引，-1 = 无
    key: i64;
    val: i64;
    alen: i64;   // cat == "array" 时的定长长度，其余为 -1
}

var tds: []TD;

// 字段类型可读名（用于 TypeInfo 的 type_name 字段，双后端一致）
fn td_readable(td: i64) -> string {
    if (td < 0) { return "?"; }
    var t: TD = tds[td];
    if (t.cat == "scalar") {
        if (t.name == "") { return "i64"; }
        return t.name;
    }
    if (t.cat == "string") { return "string"; }
    if (t.cat == "void") { return "void"; }
    if (t.cat == "unknown") { return "unknown"; }
    if (t.cat == "named") { return t.name; }
    if (t.cat == "typeinfo") { return t.name; }
    if (t.cat == "fieldinfo") { return "FieldInfo"; }
    if (t.cat == "slice") { return sb_cat2("[]", td_readable(t.elem)); }
    if (t.cat == "array") { return sb_cat4("[", i2s(t.alen), "]", td_readable(t.elem)); }
    if (t.cat == "map") { return sb_cat4("map[", td_readable(t.key), "]", td_readable(t.val)); }
    if (t.cat == "sym") { return sb_cat5("Sym", i2s(t.alen), "(\"", t.name, "\")"); }
    return "?";
}

// 字段是否引用类型（指针/聚合，is_ptr=1）；标量/void 为 false
fn is_ref_type(td: i64) -> bool {
    if (td < 0) { return false; }
    var t: TD = tds[td];
    if (t.cat == "scalar" || t.cat == "void" || t.cat == "unknown") { return false; }
    return true;
}

fn td_mk(cat: string) -> i64 {
    var t: TD;
    t.cat = cat;
    t.name = "";
    t.elem = -1;
    t.key = -1;
    t.val = -1;
    t.alen = -1;
    append(tds, t);
    return (slice_len(tds) as i64) - 1;
}

fn td_named_mk(cat: string, name: string) -> i64 {
    var i: i64 = td_mk(cat);
    var t: TD = tds[i];
    t.name = name;
    slice_set(tds, i, t);
    return i;
}

fn td_elem_mk(cat: string, elem: i64) -> i64 {
    var i: i64 = td_mk(cat);
    var t: TD = tds[i];
    t.elem = elem;
    slice_set(tds, i, t);
    return i;
}

// ── typeMap / fnScopes / structFields（扁平池，last-match-wins）─

var tm_names: []string;   // 全局 typeMap（globals + "fn()" 返回类型）
var tm_tds: []i64;

var fs_fns: []string;     // 函数级 scope：函数名 + 变量名 → td
var fs_vars: []string;
var fs_tds: []i64;

var sf_structs: []string; // struct 字段：struct 名 + 字段名 → td
var sf_fields: []string;
var sf_tds: []i64;

var em_cur_fn: string;    // 当前作用域函数名（"" = 无）
var em_in_fn: bool;

var em_main_fn: string;   // @main 函数的 mangle 名
var em_has_main: bool;

fn tm_set(name: string, td: i64) -> void {
    append(tm_names, name);
    append(tm_tds, td);
}

fn tm_get(name: string) -> i64 {
    var n: i64 = slice_len(tm_names) as i64;
    var i: i64 = n - 1;
    while (i >= 0) {
        if (tm_names[i] == name) {
            return tm_tds[i];
        }
        i = i - 1;
    }
    return -1;
}

fn fs_set(fn_name: string, var_name: string, td: i64) -> void {
    append(fs_fns, fn_name);
    append(fs_vars, var_name);
    append(fs_tds, td);
}

fn fs_get(fn_name: string, var_name: string) -> i64 {
    var n: i64 = slice_len(fs_fns) as i64;
    var i: i64 = n - 1;
    while (i >= 0) {
        if (fs_fns[i] == fn_name && fs_vars[i] == var_name) {
            return fs_tds[i];
        }
        i = i - 1;
    }
    return -1;
}

fn sf_set(st: string, fname: string, td: i64) -> void {
    append(sf_structs, st);
    append(sf_fields, fname);
    append(sf_tds, td);
}

fn sf_get(st: string, fname: string) -> i64 {
    var n: i64 = slice_len(sf_structs) as i64;
    var i: i64 = n - 1;
    while (i >= 0) {
        if (sf_structs[i] == st && sf_fields[i] == fname) {
            return sf_tds[i];
        }
        i = i - 1;
    }
    return -1;
}

// ── scalarToC（复刻 emitter.ts scalarToC + emitType scalar map）─

// >>> GEN:scalar_ctype (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
fn scalar_to_c(name: string) -> string {
    if (name == "u8") { return "uint8_t"; }
    if (name == "u16") { return "uint16_t"; }
    if (name == "u32") { return "uint32_t"; }
    if (name == "u64") { return "uint64_t"; }
    if (name == "i8") { return "int8_t"; }
    if (name == "i16") { return "int16_t"; }
    if (name == "i32") { return "int32_t"; }
    if (name == "i64") { return "int64_t"; }
    if (name == "f16") { return "_Float16"; }
    if (name == "f32") { return "float"; }
    if (name == "f64") { return "double"; }
    if (name == "bool") { return "bool"; }
    if (name == "void") { return "void"; }
    return name;
}
// <<< GEN:scalar_ctype <<<

// ── emitType（复刻 emitter.ts emitType；tn = 类型节点索引）─────

fn emit_ctype(tn: i64) -> string {
    if (tn < 0) {
        return "void";
    }
    var n: Node = nodes[tn];
    if (n.kind == "scalar") {
        if (n.sa == "string") { return "TStr"; }
        if (n.sa == "StringBuilder") { return "TSb*"; }
        return scalar_to_c(n.sa);
    }
    if (n.kind == "named") {
        // type_info 自省类型：C 后端一律按指针（与 LLVM 后端的 ptr 一致），
        // 因为运行时 t_ti_*/t_fi_* 接收 TTypeInfo*/TFieldInfo*。
        if (n.sa == "TypeInfo") { return "TTypeInfo*"; }
        if (n.sa == "FieldInfo") { return "TFieldInfo*"; }
        return n.sa;
    }
    if (n.kind == "array") {
        return sb_cat2(emit_ctype(n.na), "*");
    }
    if (n.kind == "slice") {
        return "TSlice";
    }
    if (n.kind == "map") {
        return "TMap*";
    }
    if (n.kind == "sym") {
        if (n.ia == 16) { return "uint16_t"; }
        return "uint32_t";
    }
    if (n.kind == "pointer") {
        return sb_cat2(emit_ctype(n.na), "*");
    }
    if (n.kind == "optional") {
        return emit_ctype(n.na);
    }
    if (n.kind == "flag") {
        return n.sa;
    }
    if (n.kind == "flag_set") {
        return "void*";
    }
    if (n.kind == "variant") {
        return "void*";
    }
    return "void";
}

// ── resolveTypeDesc（复刻 emitter.ts resolveTypeDesc）──────────

fn resolve_type_desc(tn: i64) -> i64 {
    if (tn < 0) {
        return td_mk("unknown");
    }
    var n: Node = nodes[tn];
    if (n.kind == "scalar") {
// >>> GEN:td_scalar (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
        if (n.sa == "string") { return td_mk("string"); }
        if (n.sa == "void") { return td_mk("void"); }
        if (n.sa == "StringBuilder") { return td_named_mk("named", "TSb*"); }
        return td_named_mk("scalar", n.sa);
// <<< GEN:td_scalar <<<
    }
// >>> GEN:td_rslice (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
    if (n.kind == "slice") {
        return td_elem_mk("slice", resolve_type_desc(n.na));
    }
// <<< GEN:td_rslice <<<
    // 定长数组 [N]T：LLVM 后端映射为 [N x T]，C 后端仍走 T[]／T*
    if (n.kind == "array") {
        var ai: i64 = td_elem_mk("array", resolve_type_desc(n.na));
        var alen: i64 = 0;
        if (n.nb >= 0) {
            var le: Node = nodes[n.nb];
            if (le.kind == "int") {
                alen = parse_int_len(le.sa, le.ia);
            }
        }
        var at: TD = tds[ai];
        at.alen = alen;
        slice_set(tds, ai, at);
        return ai;
    }
    if (n.kind == "map") {
        var mi: i64 = td_mk("map");
        var kt: i64 = resolve_type_desc(n.na);
        var vt: i64 = resolve_type_desc(n.nb);
        var t: TD = tds[mi];
        t.key = kt;
        t.val = vt;
        slice_set(tds, mi, t);
        return mi;
    }
    if (n.kind == "sym") {
        var syi: i64 = td_named_mk("sym", n.sa);
        var syt: TD = tds[syi];
        syt.alen = n.ia;
        slice_set(tds, syi, syt);
        return syi;
    }
    // 反射内建类型（M36）：TypeInfo/FieldInfo 为不透明句柄，双后端均落为指针。
    // 必须放在 GEN:td_rnamed 之前——生成区间由 build/ebnf.json 驱动，手改会被覆盖。
    if (n.kind == "named" && n.sa == "TypeInfo") { return td_named_mk("typeinfo", n.sa); }
    if (n.kind == "named" && n.sa == "FieldInfo") { return td_named_mk("fieldinfo", n.sa); }
// >>> GEN:td_rnamed (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
    if (n.kind == "named") {
        return td_named_mk("named", n.sa);
    }
// <<< GEN:td_rnamed <<<
    return td_mk("unknown");
}

// ── tiToTd：TI → TD 转换（map 字面量作为表达式时需从推断类型取元素 TD）──
fn ti_to_td(ti: i64) -> i64 {
    if (ti < 0) {
        return td_mk("unknown");
    }
    var t: TI = tis[ti];
    if (t.kind == "Scalar") { return td_named_mk("scalar", t.name); }
    if (t.kind == "String") { return td_mk("string"); }
    if (t.kind == "StringBuilder") { return td_named_mk("named", "TSb*"); }
    if (t.kind == "Void") { return td_mk("void"); }
    if (t.kind == "Slice") { return td_elem_mk("slice", ti_to_td(t.elem)); }
    if (t.kind == "Array") {
        var r: i64 = td_elem_mk("array", ti_to_td(t.elem));
        var at: TD = tds[r];
        at.alen = t.alen;
        slice_set(tds, r, at);
        return r;
    }
    if (t.kind == "Map") {
        var r: i64 = td_mk("map");
        var mt: TD = tds[r];
        mt.key = ti_to_td(t.key);
        mt.val = ti_to_td(t.val);
        slice_set(tds, r, mt);
        return r;
    }
    if (t.kind == "Sym") {
        var rs: i64 = td_named_mk("sym", t.name);
        var st: TD = tds[rs];
        st.alen = t.bw;
        slice_set(tds, rs, st);
        return rs;
    }
    if (t.kind == "Named") { return td_named_mk("named", t.name); }
    return td_mk("unknown");
}


// ── descToC（复刻 emitter.ts descToC）──────────────────────────

fn desc_to_c(td: i64) -> string {
    if (td < 0) {
        return "void*";
    }
    var t: TD = tds[td];
    if (t.cat == "string") { return "TStr"; }
    if (t.cat == "typeinfo") { return "TTypeInfo*"; }
    if (t.cat == "fieldinfo") { return "TFieldInfo*"; }
    if (t.cat == "slice") { return "TSlice"; }
    if (t.cat == "array") { return sb_cat2(desc_to_c(t.elem), "*"); }
    if (t.cat == "map") { return "TMap*"; }
    if (t.cat == "sym") {
        if (t.alen == 16) { return "uint16_t"; }
        return "uint32_t";
    }
    if (t.cat == "scalar") {
        if (t.name == "") {
            return scalar_to_c("i64");
        }
        return scalar_to_c(t.name);
    }
    if (t.cat == "named") {
        if (t.name == "") {
            return "void*";
        }
        return t.name;
    }
    if (t.cat == "void") { return "void"; }
    return "void*";
}

// ── exprTypeDesc（复刻 emitter.ts exprTypeDesc）────────────────

fn expr_type_desc(e: i64) -> i64 {
    if (e < 0) {
        return td_mk("unknown");
    }
    var n: Node = nodes[e];
// >>> GEN:td_expr1 (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
    if (n.kind == "string") { return td_mk("string"); }
    if (n.kind == "int") { return td_named_mk("scalar", "i64"); }
    if (n.kind == "float") { return td_named_mk("scalar", "f64"); }
    if (n.kind == "bool") { return td_named_mk("scalar", "bool"); }
// <<< GEN:td_expr1 <<<
    if (n.kind == "typeinfo") {
        return td_named_mk("typeinfo", n.sa);
    }
    if (n.kind == "ident") {
        if (em_in_fn) {
            var f: i64 = fs_get(em_cur_fn, n.sa);
            if (f >= 0) {
                return f;
            }
        }
        var g: i64 = tm_get(n.sa);
        if (g >= 0) {
            return g;
        }
        return td_mk("unknown");
    }
// >>> GEN:td_expr2 (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
    if (n.kind == "paren") {
        return expr_type_desc(n.na);
    }
    if (n.kind == "cast") {
        return resolve_type_desc(n.nb);
    }
// <<< GEN:td_expr2 <<<
    if (n.kind == "index") {
        var od: i64 = expr_type_desc(n.na);
        var ot: TD = tds[od];
        if (ot.cat == "string") {
            return td_named_mk("scalar", "u8");
        }
        if (ot.cat == "slice" || ot.cat == "array") {
            if (ot.elem >= 0) {
                return ot.elem;
            }
            return td_mk("unknown");
        }
        if (ot.cat == "map") {
            if (ot.val >= 0) {
                return ot.val;
            }
            return td_mk("unknown");
        }
        return td_mk("unknown");
    }
    if (n.kind == "call") {
        var cal: Node = nodes[n.na];
        if (cal.kind == "ident") {
            var cn: string = cal.sa;
// >>> GEN:td_calls (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
            if (cn == "file_read_all") { return td_mk("string"); }
            if (cn == "path_resolve") { return td_mk("string"); }
            if (cn == "str_len") { return td_named_mk("scalar", "u64"); }
            if (cn == "slice_len") { return td_named_mk("scalar", "u64"); }
            if (cn == "str_at") { return td_named_mk("scalar", "u8"); }
            if (cn == "args") {
                return td_elem_mk("slice", td_mk("string"));
            }
            if (cn == "file_write_all") { return td_named_mk("scalar", "bool"); }
            if (cn == "file_exists") { return td_named_mk("scalar", "bool"); }
            if (cn == "str_slice") { return td_mk("string"); }
            if (cn == "sb_to_str") { return td_mk("string"); }
            if (cn == "int_to_str") { return td_mk("string"); }
            if (cn == "sb_new") { return td_named_mk("named", "TSb*"); }
            if (cn == "map_has") { return td_named_mk("scalar", "bool"); }
            if (cn == "map_del") { return td_named_mk("scalar", "bool"); }
            if (cn == "map_len") { return td_named_mk("scalar", "i64"); }
            if (cn == "map_set") { return td_mk("void"); }
            if (cn == "map_new") { return td_mk("map"); }
            if (cn == "ti_name") { return td_mk("string"); }
            if (cn == "fi_name") { return td_mk("string"); }
            if (cn == "fi_type_name") { return td_mk("string"); }
            if (cn == "ti_size") { return td_named_mk("scalar", "i64"); }
            if (cn == "ti_kind") { return td_named_mk("scalar", "i64"); }
            if (cn == "ti_field_count") { return td_named_mk("scalar", "i64"); }
            if (cn == "fi_offset") { return td_named_mk("scalar", "i64"); }
            if (cn == "fi_type_size") { return td_named_mk("scalar", "i64"); }
            if (cn == "ti_field") { return td_named_mk("fieldinfo", "FieldInfo"); }
            if (cn == "fi_is_ptr") { return td_named_mk("scalar", "bool"); }
            if (cn == "sym_str") { return td_mk("string"); }
            if (cn == "sym_release") { return td_mk("void"); }
            if (cn == "sym_release_all") { return td_mk("void"); }
// <<< GEN:td_calls <<<
            // map_get(m, k) 的返回类型 = 映射的 V（从首个实参的 map 类型反查）
            if (cn == "map_get" && n.la >= 0) {
                var mn: i64 = kids[n.la].val;
                var mtd: i64 = expr_type_desc(mn);
                if (mtd >= 0) {
                    var mt: TD = tds[mtd];
                    if (mt.cat == "map" && mt.val >= 0) {
                        return mt.val;
                    }
                }
                return td_mk("unknown");
            }
            var rt: i64 = tm_get(sb_cat2(cn, "()"));
            if (rt >= 0) {
                return rt;
            }
            return td_mk("unknown");
        }
        return td_mk("unknown");
    }
    if (n.kind == "binary") {
        var op: string = n.sa;
        if (op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=" || op == "&&" || op == "||") {
            return td_named_mk("scalar", "bool");
        }
        return expr_type_desc(n.na);
    }
    if (n.kind == "member") {
        var od2: i64 = expr_type_desc(n.na);
        var ot2: TD = tds[od2];
        if (ot2.cat == "named" && ot2.name != "") {
            var fd: i64 = sf_get(ot2.name, n.sa);
            if (fd >= 0) {
                return fd;
            }
        }
        return td_mk("unknown");
    }
    return td_mk("unknown");
}

// ── collectLocalTypes（复刻 emitter.ts collectLocalTypes）──────

fn collect_local_types(head: i64) -> void {
    if (head < -1) {
        return;
    }
    var c: i64 = head;
    while (c >= 0) {
        var k: Child = kids[c];
        var n: Node = nodes[k.val];
        if (n.kind == "var_decl") {
            if (n.na >= 0) {
                fs_set(em_cur_fn, n.sa, resolve_type_desc(n.na));
            }
        }
        if (n.kind == "if") {
            collect_local_types(n.la);
            if (n.lb > -2) {
                collect_local_types(n.lb);
            }
        }
        if (n.kind == "while" || n.kind == "block") {
            collect_local_types(n.la);
        }
        if (n.kind == "for") {
            if (n.na >= 0) {
                var ini: Node = nodes[n.na];
                if (ini.kind == "var_decl") {
                    if (ini.na >= 0) {
                        fs_set(em_cur_fn, ini.sa, resolve_type_desc(ini.na));
                    }
                }
            }
            collect_local_types(n.la);
        }
        if (n.kind == "for_each") {
            var it: i64 = expr_type_desc(n.na);
            var itd: TD = tds[it];
            if (itd.cat == "slice" && itd.elem >= 0) {
                fs_set(em_cur_fn, n.sa, itd.elem);
            }
            if (itd.cat == "map" && itd.key >= 0) {
                fs_set(em_cur_fn, n.sa, itd.key);
                if (str_len(n.sb) > 0 && itd.val >= 0) {
                    fs_set(em_cur_fn, n.sb, itd.val);
                }
            }
            collect_local_types(n.la);
        }
        if (n.kind == "switch") {
            var cc: i64 = n.la;
            while (cc >= 0) {
                var ck: Child = kids[cc];
                var cs: Node = nodes[ck.val];
                collect_local_types(cs.la);
                cc = ck.next;
            }
            if (n.lb > -2) {
                collect_local_types(n.lb);
            }
        }
        c = k.next;
    }
}

// ── buildTypeMap（复刻 emitter.ts buildTypeMap）────────────────

fn build_type_map() -> void {
    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = decl_list[i];
        var dn: Node = nodes[d];
        if (dn.kind == "StructDecl") {
            var fc: i64 = dn.lb;
            while (fc >= 0) {
                var fk: Child = kids[fc];
                var f: Node = nodes[fk.val];
                if (f.na >= 0) {
                    sf_set(dn.sa, f.sa, resolve_type_desc(f.na));
                }
                fc = fk.next;
            }
        }
        if (dn.kind == "GlobalVarDecl" || dn.kind == "GlobalConstDecl") {
            if (dn.na >= 0) {
                tm_set(dn.sa, resolve_type_desc(dn.na));
            }
        }
        if (dn.kind == "FuncDecl") {
            if (dn.na >= 0) {
                tm_set(sb_cat2(dn.sa, "()"), resolve_type_desc(dn.na));
            }
            em_cur_fn = dn.sa;
            em_in_fn = true;
            var pc: i64 = dn.lb;
            while (pc >= 0) {
                var pk: Child = kids[pc];
                var p: Node = nodes[pk.val];
                if (p.na >= 0) {
                    fs_set(dn.sa, p.sa, resolve_type_desc(p.na));
                }
                pc = pk.next;
            }
            if (dn.lc > -2) {
                collect_local_types(dn.lc);
            }
            em_in_fn = false;
            em_cur_fn = "";
        }
        i = i + 1;
    }
}

// ── C 字符串转义（复刻 emitter.ts escapeCString）───────────────

fn esc_c(s: string) -> string {
    var sb: StringBuilder = sb_new();
    var i: u64 = 0;
    var n: u64 = str_len(s);
    while (i < n) {
        var c: u8 = s[i];
        if (c == 92) {
            sb_append_str(sb, "\\\\");
        } else {
        if (c == 34) {
            sb_append_str(sb, "\\\"");
        } else {
        if (c == 10) {
            sb_append_str(sb, "\\n");
        } else {
        if (c == 13) {
            sb_append_str(sb, "\\r");
        } else {
        if (c == 9) {
            sb_append_str(sb, "\\t");
        } else {
        if (c == 0) {
            sb_append_str(sb, "\\0");
        } else {
            sb_append_char(sb, c);
        }}}}}}
        i = i + 1;
    }
    return sb_to_str(sb);
}

// ── 缩进 ───────────────────────────────────────────────────────

fn mk_pad(indent: i64) -> string {
    var sb: StringBuilder = sb_new();
    var i: i64 = 0;
    while (i < indent) {
        sb_append_str(sb, "    ");
        i = i + 1;
    }
    return sb_to_str(sb);
}

// ── emitExpr（复刻 emitter.ts emitExpr）────────────────────────

// map 读索引助手：t_map_val_ptr 返回存储值字节指针，按 V 类型解引用。
// 注意：key 需是左值（&k），与 append 字面量取址限制一致。
// 取调用节点的第 ix 个实参节点 id（-1 表示不存在）。
fn call_arg_node(cid: i64, ix: i64) -> i64 {
    if (cid < 0) {
        return -1;
    }
    var cn9: Node = nodes[cid];
    var c9: i64 = cn9.la;
    var j9: i64 = 0;
    while (c9 >= 0) {
        var ck9: Child = kids[c9];
        if (j9 == ix) {
            return ck9.val;
        }
        j9 = j9 + 1;
        c9 = ck9.next;
    }
    return -1;
}

// map 键取地址（C 后端）：整型键统一提升为 int64_t 存储——runtime 按 int64_t 读键，
// 直接对 i32/u8 变量取址会让高位字节变成垃圾（M30 前的静默失配）。用 C99 复合字面量，
// 顺带允许键写成字面量或表达式。string 键是 TStr 聚合，仍取原表达式地址。
fn c_map_keyp(mn: i64, kn: i64) -> string {
    var ktd9: i64 = -1;
    var mtd9: i64 = expr_type_desc(mn);
    if (mtd9 >= 0) {
        var mt9: TD = tds[mtd9];
        ktd9 = mt9.key;
    }
    if (ktd9 >= 0 && tds[ktd9].cat != "scalar") {
        return sb_cat2("&", emit_expr(kn));
    }
    return sb_cat3("&(int64_t){(int64_t)(", emit_expr(kn), ")}");
}

// map 值取地址（C 后端）：标量值按声明的 V 落进复合字面量（宽度对齐 val_size，
// 且允许值写成字面量）；聚合值取原表达式地址。
fn c_map_valp(mn: i64, vn: i64) -> string {
    var vtd8: i64 = -1;
    var mtd8: i64 = expr_type_desc(mn);
    if (mtd8 >= 0) {
        var mt8: TD = tds[mtd8];
        vtd8 = mt8.val;
    }
    if (vtd8 < 0 || tds[vtd8].cat != "scalar") {
        return sb_cat2("&", emit_expr(vn));
    }
    var vc8: string = desc_to_c(vtd8);
    return sb_cat6("&(", vc8, "){(", vc8, ")(", sb_cat2(emit_expr(vn), ")}"));
}

fn c_map_get(mn: i64, kn: i64) -> string {
    var mtd: i64 = expr_type_desc(mn);
    var mt: TD = tds[mtd];
    var valc: string = desc_to_c(mt.val);
    var mstr: string = emit_expr(mn);
    var kstr: string = c_map_keyp(mn, kn);
    return sb_cat6("(*(", valc, "*)t_map_val_ptr(", mstr, ", ", sb_cat2(kstr, "))"));
}

// map 索引写时求 LHS 的 TMap* 基指针：
// 单层 m[k] → m（变量本身即 TMap*）；嵌套 deep[a][x] → deep[a] 求内层 TMap* 值。
// 用于 t_map_put 的第一个实参。
fn c_map_lhs_ptr(nd: i64) -> string {
    var n1: Node = nodes[nd];
    if (n1.kind == "index") {
        var btd: i64 = expr_type_desc(nd);
        if (btd >= 0 && tds[btd].cat == "map") {
            // 嵌套：base 是 m[k] 本身也是 map，求内层 TMap* 值（t_map_val_ptr 返回槽指针，解引用得 TMap*）
            var base: string = emit_expr(n1.na);
            var key: string = c_map_keyp(nd, n1.nb);
            return sb_cat6("(*(TMap**)", "t_map_val_ptr(", base, ", ", key, "))");
        }
    }
    return emit_expr(nd);
}

// map 字面量作为表达式（调用实参 / 返回值 / 嵌套值 / 赋值右值）时，
// 建临时 TMap* 变量并逐项 put，返回该变量名。pad 为缩进（表达式场景通常为 ""）。
var g_map_lit_cnt: i64 = 0;
var g_stmt_pad: string = "";   // 当前语句缩进（map 字面量作表达式时对齐用）

fn c_emit_map_lit(en: i64, mname: string, pad: string, keytd: i64, valtd: i64) -> void {
    var mlkk: i64 = 0;
    if (tds[keytd].cat != "string") { mlkk = 1; }
    var mlkc: string = desc_to_c(keytd);
    var mlvc: string = desc_to_c(valtd);
    spush(sb_cat5(pad, "TMap* ", mname, " = t_map_new(t_arena_current(), ", sb_cat3(i2s(mlkk), ", (int64_t)sizeof(", sb_cat2(mlvc, "));"))));
    var mlkx: string = "";
    if (tds[keytd].cat == "scalar") {
        mlkc = "int64_t";
        mlkx = "(int64_t)";
    }
    var mlvx: string = "";
    if (tds[valtd].cat == "scalar") {
        mlvx = sb_cat3("(", mlvc, ")");
    }
    var mlnode: Node = nodes[en];
    var mlc: i64 = mlnode.la;
    var mlix: i64 = 0;
    while (mlc >= 0) {
        var mlck: Child = kids[mlc];
        var mlen: Node = nodes[mlck.val];
        var mlkn: string = sb_cat4("_ml_", mname, "k", i2s(mlix));
        var mlvn: string = sb_cat4("_ml_", mname, "v", i2s(mlix));
        spush(sb_cat6(pad, mlkc, " ", mlkn, sb_cat3(" = ", mlkx, emit_expr(mlen.na)), ";"));
        spush(sb_cat6(pad, mlvc, " ", mlvn, sb_cat3(" = ", mlvx, emit_expr(mlen.nb)), ";"));
        spush(sb_cat6(pad, "t_map_put(", mname, ", &", mlkn, sb_cat3(", &", mlvn, ");")));
        mlix = mlix + 1;
        mlc = mlck.next;
    }
}

fn emit_expr(e: i64) -> string {
    if (e < 0) {
        return "";
    }
    var n: Node = nodes[e];

    if (n.kind == "int") {
        if (n.ia == 16) {
            return n.sa;
        }
        if (n.ia == 2) {
            // value.replace(/^0b/i, "") 再加 0b 前缀
            var v: string = n.sa;
            var body: string = v;
            if (str_len(v) >= 2) {
                if (v[0] == 48 && (v[1] == 98 || v[1] == 66)) {
                    body = str_slice(v, 2, str_len(v));
                }
            }
            return sb_cat2("0b", body);
        }
        return n.sa;
    }
    if (n.kind == "float") {
        return n.sa;
    }
    if (n.kind == "string") {
        return sb_cat3("TSTR_LIT(\"", esc_c(n.sa), "\")");
    }
    if (n.kind == "typeinfo") {
        return emit_type_info_c(n.sa);
    }
    if (n.kind == "bool") {
        if (n.ba) {
            return "true";
        }
        return "false";
    }
    if (n.kind == "null") {
        return "NULL";
    }
    if (n.kind == "ident") {
        return n.sa;
    }
    if (n.kind == "map_lit") {
        g_map_lit_cnt = g_map_lit_cnt + 1;
        var mname: string = sb_cat2("_tmlit", i2s(g_map_lit_cnt));
        var mti: i64 = infer_expr(e);
        var mt: TI = tis[mti];
        var keytd: i64 = ti_to_td(mt.key);
        var valtd: i64 = ti_to_td(mt.val);
        c_emit_map_lit(e, mname, g_stmt_pad, keytd, valtd);
        return mname;
    }
    if (n.kind == "binary") {
        var op: string = n.sa;
        if (op == "==" || op == "!=") {
            var lt: i64 = expr_type_desc(n.na);
            var rt: i64 = expr_type_desc(n.nb);
            var ltc: TD = tds[lt];
            var rtc: TD = tds[rt];
            if (ltc.cat == "string" || rtc.cat == "string") {
                var cmp: string = sb_cat5("t_str_eq(", emit_expr(n.na), ", ", emit_expr(n.nb), ")");
                if (op == "==") {
                    return cmp;
                }
                return sb_cat3("(!", cmp, ")");
            }
        }
        return sb_cat6("(", emit_expr(n.na), " ", op, " ", sb_cat2(emit_expr(n.nb), ")"));
    }
    if (n.kind == "unary") {
        return sb_cat4("(", n.sa, emit_expr(n.na), ")");
    }
    if (n.kind == "assign") {
        // m[k] = v : map 索引写须走 t_map_put（find-or-insert），不能对读值再存回
        if (n.sa == "=") {
            var lnode: Node = nodes[n.na];
            if (lnode.kind == "index") {
                var lotd: i64 = expr_type_desc(lnode.na);
                if (lotd >= 0 && tds[lotd].cat == "map") {
                    var mptr: string = c_map_lhs_ptr(lnode.na);
                    return sb_cat6("t_map_put(", mptr, ", ", c_map_keyp(lnode.na, lnode.nb), ", ", sb_cat2(c_map_valp(lnode.na, n.nb), ")"));
                }
            }
            // Sym = string : 自动 intern（LHS 存 id）；Sym = Sym（同池）走普通 id 拷贝
            var lhtd: i64 = expr_type_desc(n.na);
            if (lhtd >= 0 && tds[lhtd].cat == "sym") {
                var rhtd: i64 = expr_type_desc(n.nb);
                if (rhtd >= 0 && tds[rhtd].cat == "string") {
                    var stg: TD = tds[lhtd];
                    var tagl: string = sb_cat3("TSTR_LIT(\"", esc_c(stg.name), "\")");
                    var intr: string = sb_cat6("t_sym_intern(", tagl, ", ", emit_expr(n.nb), ", ", sb_cat2(i2s(stg.alen), ")"));
                    return sb_cat5("(", emit_expr(n.na), " = ", intr, ")");
                }
            }
        }
        return sb_cat6("(", emit_expr(n.na), " ", n.sa, " ", sb_cat2(emit_expr(n.nb), ")"));
    }
    if (n.kind == "call") {
        var cal: Node = nodes[n.na];
        if (cal.kind == "ident") {
            var cn: string = cal.sa;
            // 收集参数
            var av: []string;
            var c: i64 = n.la;
            while (c >= 0) {
                var k: Child = kids[c];
                var one_arg: string = emit_expr(k.val);
                append(av, one_arg);
                c = k.next;
            }
            var argc: i64 = slice_len(av) as i64;
            if (cn == "str_len") { return sb_cat3("t_str_len(", av[0], ")"); }
            if (cn == "str_at") { return sb_cat5("t_str_byte_at(", av[0], ", ", av[1], ")"); }
            if (cn == "slice_len") { return sb_cat3("t_slice_len(", av[0], ")"); }
            if (cn == "append") {
                return sb_cat6("t_slice_append_sized(&", av[0], ", &", av[1], ", (int64_t)sizeof(", sb_cat2(av[1], "))"));
            }
            if (cn == "slice_set") {
                return sb_cat6("t_slice_set(", av[0], ", ", av[1], ", &", sb_cat2(av[2], ")"));
            }
            if (cn == "file_read_all") { return sb_cat3("t_file_read_all(t_cstr(", av[0], "))"); }
            if (cn == "file_exists") { return sb_cat3("t_file_exists(t_cstr(", av[0], "))"); }
            if (cn == "path_resolve") { return sb_cat3("t_path_resolve(t_cstr(", av[0], "))"); }
            if (cn == "file_write_all") {
                return sb_cat6("t_file_write_all(t_cstr(", av[0], "), ", av[1], ")", "");
            }
            if (cn == "args") { return "t_args()"; }
            if (cn == "ti_name" || cn == "ti_size" || cn == "ti_kind" || cn == "ti_field_count" || cn == "ti_field" || cn == "fi_name" || cn == "fi_offset" || cn == "fi_type_name" || cn == "fi_type_size" || cn == "fi_is_ptr") {
                return c_emit_accessor_call(cn, av);
            }
            if (cn == "exit") { return sb_cat3("t_exit(", av[0], ")"); }
            if (cn == "sys_run") { return sb_cat3("sys_run(", av[0], ")"); }
            if (cn == "print") { return sb_cat3("t_print(", av[0], ")"); }
            if (cn == "eprint") { return sb_cat3("t_eprint(", av[0], ")"); }
            if (cn == "println") { return sb_cat3("t_println(", av[0], ")"); }
            if (cn == "str_slice") {
                return sb_cat6("t_str_slice(", av[0], ", ", av[1], ", ", sb_cat2(av[2], ")"));
            }
            if (cn == "sb_new") { return "t_sb_new(t_arena_current())"; }
            if (cn == "sb_append_str") { return sb_cat5("t_sb_append_str(", av[0], ", ", av[1], ")"); }
            if (cn == "sb_append_char") { return sb_cat5("t_sb_append_char(", av[0], ", ", av[1], ")"); }
            if (cn == "sb_append_u64") { return sb_cat5("t_sb_append_u64(", av[0], ", ", av[1], ")"); }
            if (cn == "sb_append_i64") { return sb_cat5("t_sb_append_i64(", av[0], ", ", av[1], ")"); }
            if (cn == "sb_to_str") { return sb_cat3("t_sb_to_str(", av[0], ")"); }
            if (cn == "int_to_str") { return sb_cat3("t_int_to_str(", av[0], ")"); }
            if (cn == "sb_clear") { return sb_cat3("t_sb_clear(", av[0], ")"); }
            if (cn == "map_new") {
                var mnw0: i64 = -1;
                if (n.la >= 0) { mnw0 = kids[n.la].val; }
                var mnwtd: i64 = expr_type_desc(mnw0);
                var mnwt: TD = tds[mnwtd];
                var mnwkk: i64 = 0;
                if (tds[mnwt.key].cat != "string") { mnwkk = 1; }
                var mnwvs: string = sb_cat3("sizeof(", desc_to_c(mnwt.val), ")");
                return sb_cat5("t_map_new(t_arena_current(), ", i2s(mnwkk), ", (int64_t)", mnwvs, ")");
            }
            if (cn == "map_set") {
                var ms0: i64 = call_arg_node(e, 0);
                var ms1: i64 = call_arg_node(e, 1);
                var ms2: i64 = call_arg_node(e, 2);
                return sb_cat6("t_map_put(", av[0], ", ", c_map_keyp(ms0, ms1), ", ", sb_cat2(c_map_valp(ms0, ms2), ")"));
            }
            if (cn == "map_has") {
                var mh0: i64 = call_arg_node(e, 0);
                return sb_cat4("t_map_has(", av[0], sb_cat2(", ", c_map_keyp(mh0, call_arg_node(e, 1))), ")");
            }
            if (cn == "map_len") { return sb_cat3("t_map_len(", av[0], ")"); }
            if (cn == "map_del") {
                var md0: i64 = call_arg_node(e, 0);
                return sb_cat4("t_map_del(", av[0], sb_cat2(", ", c_map_keyp(md0, call_arg_node(e, 1))), ")");
            }
            if (cn == "map_get") {
                return c_map_get(call_arg_node(e, 0), call_arg_node(e, 1));
            }
            if (cn == "sym_str") {
                var ssarg: i64 = call_arg_node(e, 0);
                var sstd: i64 = expr_type_desc(ssarg);
                var sstag: string = "";
                if (sstd >= 0 && tds[sstd].cat == "sym") { sstag = tds[sstd].name; }
                var sstaglit: string = sb_cat3("TSTR_LIT(\"", esc_c(sstag), "\")");
                return sb_cat5("t_sym_str(", sstaglit, ", ", av[0], ")");
            }
            if (cn == "sym_release") { return sb_cat3("t_sym_release(", av[0], ")"); }
            if (cn == "sym_release_all") { return "t_sym_release_all()"; }
            // 普通调用
            var sb: StringBuilder = sb_new();
            sb_append_str(sb, cn);
            sb_append_char(sb, 40);
            var i: i64 = 0;
            while (i < argc) {
                if (i > 0) {
                    sb_append_str(sb, ", ");
                }
                sb_append_str(sb, av[i]);
                i = i + 1;
            }
            sb_append_char(sb, 41);
            return sb_to_str(sb);
        }
        // callee 非 ident
        var sb2: StringBuilder = sb_new();
        sb_append_str(sb2, emit_expr(n.na));
        sb_append_char(sb2, 40);
        var c2: i64 = n.la;
        var first: bool = true;
        while (c2 >= 0) {
            var k2: Child = kids[c2];
            if (!first) {
                sb_append_str(sb2, ", ");
            }
            sb_append_str(sb2, emit_expr(k2.val));
            first = false;
            c2 = k2.next;
        }
        sb_append_char(sb2, 41);
        return sb_to_str(sb2);
    }
    if (n.kind == "member") {
        return sb_cat3(emit_expr(n.na), ".", n.sa);
    }
    if (n.kind == "index") {
        var od: i64 = expr_type_desc(n.na);
        var ot: TD = tds[od];
        var obj: string = emit_expr(n.na);
        var idx: string = emit_expr(n.nb);
        if (ot.cat == "string") {
            return sb_cat5("t_str_byte_at(", obj, ", ", idx, ")");
        }
        if (ot.cat == "slice") {
            var ec: string = desc_to_c(ot.elem);
            return sb_cat6("(*(", ec, "*)t_slice_at(", obj, ", ", sb_cat2(idx, "))"));
        }
        if (ot.cat == "map") {
            return c_map_get(n.na, n.nb);
        }
        return sb_cat6("(", obj, "[", idx, "]", ")");
    }
    if (n.kind == "array_lit") {
        var sb3: StringBuilder = sb_new();
        sb_append_char(sb3, 123);
        var c3: i64 = n.la;
        var first3: bool = true;
        while (c3 >= 0) {
            var k3: Child = kids[c3];
            if (!first3) {
                sb_append_str(sb3, ", ");
            }
            sb_append_str(sb3, emit_expr(k3.val));
            first3 = false;
            c3 = k3.next;
        }
        sb_append_char(sb3, 125);
        return sb_to_str(sb3);
    }
    if (n.kind == "struct_lit") {
        var sb4: StringBuilder = sb_new();
        sb_append_char(sb4, 40);
        sb_append_str(sb4, n.sa);
        sb_append_str(sb4, "){");
        var c4: i64 = n.la;
        var first4: bool = true;
        while (c4 >= 0) {
            var k4: Child = kids[c4];
            var fv: Node = nodes[k4.val];
            if (!first4) {
                sb_append_str(sb4, ", ");
            }
            sb_append_char(sb4, 46);
            sb_append_str(sb4, fv.sa);
            sb_append_str(sb4, " = ");
            sb_append_str(sb4, emit_expr(fv.na));
            first4 = false;
            c4 = k4.next;
        }
        sb_append_char(sb4, 125);
        return sb_to_str(sb4);
    }
    if (n.kind == "cast") {
        return sb_cat6("((", emit_ctype(n.nb), ")", emit_expr(n.na), ")", "");
    }
    if (n.kind == "paren") {
        return sb_cat3("(", emit_expr(n.na), ")");
    }
    return "/* unsupported expr */";
}

// 判定表达式节点是否为数组字面量（切片字面量构造用）
fn is_array_lit(e: i64) -> bool {
    if (e < 0) {
        return false;
    }
    var an: Node = nodes[e];
    return an.kind == "array_lit";
}

fn is_map_lit(e: i64) -> bool {
    if (e < 0) {
        return false;
    }
    var mln: Node = nodes[e];
    return mln.kind == "map_lit";
}

// ── emitStmt（复刻 emitter.ts emitStmt；输出到 slines）─────────

fn emit_stmt(sid: i64, indent: i64) -> void {
    var pad: string = mk_pad(indent);
    g_stmt_pad = pad;    // 供 emit_expr 的 map 字面量分支对齐缩进
    var n: Node = nodes[sid];

    if (n.kind == "expr") {
        spush(sb_cat3(pad, emit_expr(n.na), ";"));
        return;
    }
    if (n.kind == "var_decl") {
        if (n.na >= 0) {
            var td: i64 = resolve_type_desc(n.na);
            var t: TD = tds[td];
            if (t.cat == "slice" && n.nb < 0) {
                spush(sb_cat6(pad, "TSlice ", n.sa, " = t_slice_new(sizeof(", desc_to_c(t.elem), "));"));
                return;
            }
            // 切片字面量：`var xs: []T = [a, b, c];` 运行期逐元素构造
            if (t.cat == "slice" && n.nb >= 0 && is_array_lit(n.nb)) {
                var lt: Node = nodes[n.nb];
                var ecs: string = desc_to_c(t.elem);
                spush(sb_cat6(pad, "TSlice ", n.sa, " = t_slice_new(sizeof(", ecs, "));"));
                var cc: i64 = lt.la;
                var ei: i64 = 0;
                while (cc >= 0) {
                    var ck: Child = kids[cc];
                    var tn: string = sb_cat4("_sl_", n.sa, "_", i2s(ei));
                    var ev: string = emit_expr(ck.val);
                    spush(sb_cat6(pad, ecs, " ", tn, sb_cat4(" = (", ecs, ")", ev), ";"));
                    spush(sb_cat6(pad, "t_slice_append(&", n.sa, ", &", tn, ");"));
                    ei = ei + 1;
                    cc = ck.next;
                }
                return;
            }
            // map：`var m: map[K]V;` 建空表；`= [k: v, ...]` 建表后逐项插入；
            // 从变量/表达式赋值（含 map 字面量表达式）则交给下面的通用分支。
            if (t.cat == "map") {
                if (n.nb < 0 || is_map_lit(n.nb)) {
                    if (n.nb < 0) {
                        var mlkk: i64 = 0;
                        if (tds[t.key].cat != "string") { mlkk = 1; }
                        var mlvc: string = desc_to_c(t.val);
                        spush(sb_cat5(pad, "TMap* ", n.sa, " = t_map_new(t_arena_current(), ", sb_cat3(i2s(mlkk), ", (int64_t)sizeof(", sb_cat2(mlvc, "));"))));
                    } else {
                        c_emit_map_lit(n.nb, n.sa, pad, t.key, t.val);
                    }
                    return;
                }
            }
            // Sym：字段仅存 u32/u16 id。无初始化 → 0；`= "str"` → 自动 intern。
            if (t.cat == "sym") {
                var symcty: string = desc_to_c(td);   // "uint32_t" / "uint16_t"
                if (n.nb < 0) {
                    spush(sb_cat5(pad, symcty, " ", n.sa, " = 0;"));
                } else {
                    var symtagl: string = sb_cat3("TSTR_LIT(\"", esc_c(t.name), "\")");
                    var symintr: string = sb_cat6("t_sym_intern(", symtagl, ", ", emit_expr(n.nb), ", ", sb_cat2(i2s(t.alen), ")"));
                    var symhead: string = sb_cat5(pad, symcty, " ", n.sa, " = ");
                    spush(sb_cat2(symhead, sb_cat2(symintr, ";")));
                }
                return;
            }
            if (t.cat == "string" && n.nb < 0) {
                spush(sb_cat4(pad, "TStr ", n.sa, " = {0};"));
                return;
            }
            if (t.cat == "named" && n.nb < 0) {
                var cty: string = desc_to_c(td);
                if (ends_with_star(cty)) {
                    spush(sb_cat6(pad, cty, " ", n.sa, " = NULL;", ""));
                } else {
                    spush(sb_cat6(pad, cty, " ", n.sa, " = {0};", ""));
                }
                return;
            }
        }
        var ty: string = "auto";
        if (n.na >= 0) {
            ty = emit_ctype(n.na);
        }
        var init: string = "";
        if (n.nb >= 0) {
            init = sb_cat2(" = ", emit_expr(n.nb));
        }
        spush(sb_cat6(pad, ty, " ", n.sa, init, ";"));
        return;
    }
    if (n.kind == "for_each") {
        var itd: i64 = expr_type_desc(n.na);
        var it: TD = tds[itd];
        // map 的 for-in：按插入序迭代键
        if (it.cat == "map") {
            var mfkc: string = desc_to_c(it.key);
            var mfat: string = "t_map_key_int_at";
            if (tds[it.key].cat == "string") { mfat = "t_map_key_str_at"; }
            var mfit: string = emit_expr(n.na);
            spush(sb_cat4(pad, "for (int64_t _fe_i = 0; _fe_i < t_map_count(", mfit, "); _fe_i = _fe_i + 1) {"));
            spush(sb_cat6(sb_cat2(pad, "    "), mfkc, " ", n.sa, sb_cat6(" = ", mfat, "(", mfit, ", _fe_i);", ""), ""));
            // 双变量形式 `for (k, v in m)`：v 由插入序下标直接取值
            if (str_len(n.sb) > 0) {
                var mfvc: string = desc_to_c(it.val);
                spush(sb_cat6(sb_cat2(pad, "    "), mfvc, " ", n.sb, sb_cat5(" = *((", mfvc, "*)t_map_val_at(", mfit, ", _fe_i));"), ""));
            }
            var mfb: i64 = n.la;
            while (mfb >= 0) {
                var mfbk: Child = kids[mfb];
                emit_stmt(mfbk.val, indent + 2);
                mfb = mfbk.next;
            }
            spush(sb_cat2(pad, "}"));
            return;
        }
        var elem_c: string = "void*";
        if (it.cat == "slice" && it.elem >= 0) {
            elem_c = desc_to_c(it.elem);
        }
        var iter: string = emit_expr(n.na);
        spush(sb_cat6(pad, "for (int64_t _fe_i = 0; _fe_i < t_slice_len(", iter, "); _fe_i = _fe_i + 1) {", "", ""));
        spush(sb_cat6(sb_cat2(pad, "    "), elem_c, " ", n.sa, sb_cat6(" = *((", elem_c, "*)t_slice_at(", iter, ", _fe_i));", ""), ""));
        var b: i64 = n.la;
        while (b >= 0) {
            var bk: Child = kids[b];
            emit_stmt(bk.val, indent + 2);
            b = bk.next;
        }
        spush(sb_cat2(pad, "}"));
        return;
    }
    if (n.kind == "if") {
        spush(sb_cat4(pad, "if (", emit_expr(n.na), ") {"));
        var tb: i64 = n.la;
        while (tb >= 0) {
            var tk: Child = kids[tb];
            emit_stmt(tk.val, indent + 1);
            tb = tk.next;
        }
        if (n.lb > -2) {
            spush(sb_cat2(pad, "} else {"));
            var eb: i64 = n.lb;
            while (eb >= 0) {
                var ek: Child = kids[eb];
                emit_stmt(ek.val, indent + 1);
                eb = ek.next;
            }
        }
        spush(sb_cat2(pad, "}"));
        return;
    }
    if (n.kind == "while") {
        spush(sb_cat4(pad, "while (", emit_expr(n.na), ") {"));
        var wb: i64 = n.la;
        while (wb >= 0) {
            var wk: Child = kids[wb];
            emit_stmt(wk.val, indent + 1);
            wb = wk.next;
        }
        spush(sb_cat2(pad, "}"));
        return;
    }
    if (n.kind == "for") {
        spush(sb_cat2(pad, "for ("));
        if (n.na >= 0) {
            var ini: Node = nodes[n.na];
            if (ini.kind == "var_decl") {
                var ity: string = "int";
                if (ini.na >= 0) {
                    ity = emit_ctype(ini.na);
                }
                var iin: string = "";
                if (ini.nb >= 0) {
                    iin = sb_cat2(" = ", emit_expr(ini.nb));
                }
                sappend_last(sb_cat4(ity, " ", ini.sa, iin));
            }
            if (ini.kind == "expr") {
                sappend_last(emit_expr(ini.na));
            }
        }
        var cnd: string = "";
        if (n.nb >= 0) {
            cnd = emit_expr(n.nb);
        }
        var upd: string = "";
        if (n.nc >= 0) {
            upd = emit_expr(n.nc);
        }
        sappend_last(sb_cat6("; ", cnd, "; ", upd, ") {", ""));
        var fb: i64 = n.la;
        while (fb >= 0) {
            var fk: Child = kids[fb];
            emit_stmt(fk.val, indent + 1);
            fb = fk.next;
        }
        spush(sb_cat2(pad, "}"));
        return;
    }
    if (n.kind == "return") {
        if (n.na >= 0) {
            spush(sb_cat4(pad, "return ", emit_expr(n.na), ";"));
        } else {
            spush(sb_cat2(pad, "return;"));
        }
        return;
    }
    if (n.kind == "break") {
        spush(sb_cat2(pad, "break;"));
        return;
    }
    if (n.kind == "continue") {
        spush(sb_cat2(pad, "continue;"));
        return;
    }
    if (n.kind == "assignment") {
        // 注：普通 a = b 语句实际是 "assign" 表达式节点（见 emit_expr），"assignment"
        // 节点在此保留为兜底；map 索引写已在 emit_expr 的 "assign" 分支处理。
        spush(sb_cat6(pad, emit_expr(n.na), " ", n.sa, " ", sb_cat2(emit_expr(n.nb), ";")));
        return;
    }
    if (n.kind == "block") {
        spush(sb_cat2(pad, "{"));
        var bb: i64 = n.la;
        while (bb >= 0) {
            var bk2: Child = kids[bb];
            emit_stmt(bk2.val, indent + 1);
            bb = bk2.next;
        }
        spush(sb_cat2(pad, "}"));
        return;
    }
    if (n.kind == "switch") {
        spush(sb_cat4(pad, "switch (", emit_expr(n.na), ") {"));
        var cc: i64 = n.la;
        while (cc >= 0) {
            var ck: Child = kids[cc];
            var cs: Node = nodes[ck.val];
            spush(sb_cat4(pad, "case ", emit_expr(cs.na), ":"));
            var cb: i64 = cs.la;
            while (cb >= 0) {
                var cbk: Child = kids[cb];
                emit_stmt(cbk.val, indent + 2);
                cb = cbk.next;
            }
            spush(sb_cat2(pad, "    break;"));
            cc = ck.next;
        }
        if (n.lb > -2) {
            spush(sb_cat2(pad, "default:"));
            var db: i64 = n.lb;
            while (db >= 0) {
                var dk: Child = kids[db];
                emit_stmt(dk.val, indent + 2);
                db = dk.next;
            }
            spush(sb_cat2(pad, "    break;"));
        }
        spush(sb_cat2(pad, "}"));
        return;
    }
    // defer / comptime_block 等：TS emitStmt 无对应 case，不输出
}

// ═══════════════════════════════════════════════════════════════
// E3: emit_decl / derive / flag 布局 / emit 编排 / 驱动 main
// ═══════════════════════════════════════════════════════════════

// ── JS parseInt 复刻（enum autoValue 用；radix 16 允许 0x 前缀，
//    radix 2 遇 'b' 停在 "0" → 0，复刻 tc0 quirk）────────────────

fn js_parse_int(s: string, radix: i64) -> i64 {
    var i: u64 = 0;
    var n: u64 = str_len(s);
    var neg: bool = false;
    if (i < n) {
        if (s[i] == 43 || s[i] == 45) {
            if (s[i] == 45) {
                neg = true;
            }
            i = i + 1;
        }
    }
    if (radix == 16 && i + 1 < n) {
        if (s[i] == 48 && (s[i + 1] == 120 || s[i + 1] == 88)) {
            i = i + 2;
        }
    }
    var val: i64 = 0;
    while (i < n) {
        var c: u8 = s[i];
        var d: i64 = -1;
        if (c >= 48 && c <= 57) {
            d = (c - 48) as i64;
        }
        if (c >= 97 && c <= 122) {
            d = (c - 87) as i64;
        }
        if (c >= 65 && c <= 90) {
            d = (c - 55) as i64;
        }
        if (d < 0 || d >= radix) {
            break;
        }
        val = val * radix + d;
        i = i + 1;
    }
    if (neg) {
        return 0 - val;
    }
    return val;
}

// ── JS (1 << bw) - 1 复刻（int32 回绕；flag slot maxValue）─────

fn js_max_val(bw: i64) -> i64 {
    var sh: i64 = bw % 32;
    if (sh < 0) {
        sh = sh + 32;
    }
    var v: i64 = 1 << sh;
    if (sh == 31) {
        v = 0 - 2147483648;
    }
    return v - 1;
}

// ── Flag 槽布局池（复刻 bitfield.ts resolve 的布局部分，无诊断；
//    growing pool + base 偏移，同 fr_names 模式）──────────────────

var fl_names: []string;
var fl_starts: []i64;
var fl_lens: []i64;
var fl_ends: []i64;

fn fr_layout(d: i64) -> i64 {
    var base: i64 = slice_len(fl_names) as i64;
    var n: Node = nodes[d];
    var auto_off: i64 = 0;
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var sl: Node = nodes[k.val];
        var start: i64 = auto_off;
        if (sl.bb) {
            start = sl.ib;
        }
        var end: i64 = start + sl.ia;
        append(fl_names, sl.sa);
        append(fl_starts, start);
        append(fl_lens, sl.ia);
        append(fl_ends, end);
        auto_off = end;
        c = k.next;
    }
    return base;
}

// ── derive traits / fields 收集（growing pool + base 偏移）─────

var dt_traits: []string;

fn collect_traits(d: i64) -> i64 {
    var base: i64 = slice_len(dt_traits) as i64;
    var n: Node = nodes[d];
    var ai: i64 = ann_find(n.la, "derive");
    if (ai < 0) {
        return base;
    }
    var an: Node = nodes[ai];
    var c: i64 = an.la;
    while (c >= 0) {
        var k: Child = kids[c];
        var arg: Node = nodes[k.val];
        if (arg.kind == "ident") {
            append(dt_traits, arg.sa);
        }
        if (arg.kind == "list") {
            var c2: i64 = arg.la;
            while (c2 >= 0) {
                var k2: Child = kids[c2];
                var v: Node = nodes[k2.val];
                if (v.kind == "ident") {
                    append(dt_traits, v.sa);
                }
                c2 = k2.next;
            }
        }
        c = k.next;
    }
    return base;
}

var df_names: []string;
var df_anns: []i64;

fn collect_fields(d: i64) -> i64 {
    var base: i64 = slice_len(df_names) as i64;
    var n: Node = nodes[d];
    if (n.kind == "VariantDecl") {
        return base;
    }
    if (n.kind == "StructDecl") {
        var c: i64 = n.lb;
        while (c >= 0) {
            var k: Child = kids[c];
            var f: Node = nodes[k.val];
            if (f.ia < 0) {
                append(df_names, f.sa);
                append(df_anns, f.la);
            }
            c = k.next;
        }
        return base;
    }
    if (n.kind == "EnumDecl" || n.kind == "UnionDecl") {
        var c2: i64 = n.lb;
        while (c2 >= 0) {
            var k2: Child = kids[c2];
            var f2: Node = nodes[k2.val];
            append(df_names, f2.sa);
            append(df_anns, f2.la);
            c2 = k2.next;
        }
    }
    return base;
}

// ── derive 代码生成（复刻 derive.ts；含 [object Object] 与
//    t 语法方法体等 tc0 bug，逐字节一致要求）───────────────────

fn gen_trait(trait: string, name: string, fb: i64, fe: i64) -> string {
    var sb: StringBuilder = sb_new();

    if (trait == "ToString") {
        sb_append_str(sb, "// @derive(ToString) — auto-generated\nto_string fn(self: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ") -> string {\n    return \"");
        sb_append_str(sb, name);
        sb_append_str(sb, " { ");
        var i: i64 = fb;
        while (i < fe) {
            if (i > fb) {
                sb_append_str(sb, ", ");
            }
            sb_append_str(sb, df_names[i]);
            sb_append_str(sb, "=$");
            sb_append_str(sb, df_names[i]);
            i = i + 1;
        }
        sb_append_str(sb, " }\";\n}");
        return sb_to_str(sb);
    }

    if (trait == "FromString") {
        sb_append_str(sb, "// @derive(FromString) — auto-generated\nfrom_string fn(s: string) -> ");
        sb_append_str(sb, name);
        sb_append_str(sb, " {\n    var result: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ";\n    // parse fields: ");
        var i2: i64 = fb;
        while (i2 < fe) {
            if (i2 > fb) {
                sb_append_str(sb, ", ");
            }
            sb_append_str(sb, df_names[i2]);
            i2 = i2 + 1;
        }
        sb_append_str(sb, "\n    return result;\n}");
        return sb_to_str(sb);
    }

    if (trait == "Clone") {
        sb_append_str(sb, "// @derive(Clone) — auto-generated\nclone fn(self: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ") -> ");
        sb_append_str(sb, name);
        sb_append_str(sb, " {\n    return ");
        sb_append_str(sb, name);
        sb_append_str(sb, " { ");
        var i3: i64 = fb;
        while (i3 < fe) {
            if (i3 > fb) {
                sb_append_str(sb, ", ");
            }
            sb_append_str(sb, df_names[i3]);
            sb_append_str(sb, ": self.");
            sb_append_str(sb, df_names[i3]);
            i3 = i3 + 1;
        }
        sb_append_str(sb, " };\n}");
        return sb_to_str(sb);
    }

    if (trait == "Copy") {
        sb_append_str(sb, "// @derive(Copy) — auto-generated\n// ");
        sb_append_str(sb, name);
        sb_append_str(sb, " is marked as Copy (bitwise copy on assignment)");
        return sb_to_str(sb);
    }

    if (trait == "DebugPrint") {
        sb_append_str(sb, "// @derive(DebugPrint) — auto-generated\ndebug_print fn(self: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ") -> string {\n    return \"");
        sb_append_str(sb, name);
        sb_append_str(sb, "(");
        var i4: i64 = fb;
        while (i4 < fe) {
            if (i4 > fb) {
                sb_append_str(sb, ", ");
            }
            sb_append_str(sb, df_names[i4]);
            sb_append_str(sb, ": {self.");
            sb_append_str(sb, df_names[i4]);
            sb_append_str(sb, "}");
            i4 = i4 + 1;
        }
        sb_append_str(sb, ")\";\n}");
        return sb_to_str(sb);
    }

    if (trait == "BinarySerde") {
        sb_append_str(sb, "// @derive(BinarySerde) — auto-generated\nserialize fn(self: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ") -> []u8 {\n");
        // serializeLines: filter 掉 @binary_skip，索引按过滤后数组计
        var cnt: i64 = 0;
        var i5: i64 = fb;
        while (i5 < fe) {
            if (ann_find(df_anns[i5], "binary_skip") < 0) {
                if (cnt > 0) {
                    sb_append_str(sb, "\n");
                }
                sb_append_str(sb, "    // offset ");
                var oa: i64 = ann_find(df_anns[i5], "binary_offset");
                var has_off: bool = false;
                if (oa >= 0) {
                    if (ann_first_arg(oa) >= 0) {
                        has_off = true;
                    }
                }
                if (has_off) {
                    // tc0 bug: 模板串里插入 arg 对象 → "[object Object]"
                    sb_append_str(sb, "[object Object]");
                } else {
                    sb_append_i64(sb, cnt * 4);
                }
                sb_append_str(sb, ": write self.");
                sb_append_str(sb, df_names[i5]);
                cnt = cnt + 1;
            }
            i5 = i5 + 1;
        }
        sb_append_str(sb, "\n    return buffer;\n}\n\ndeserialize fn(data: []u8) -> ");
        sb_append_str(sb, name);
        sb_append_str(sb, " {\n    var result: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ";\n    // read fields from data at specified offsets\n    return result;\n}");
        return sb_to_str(sb);
    }

    if (trait == "Eq" || trait == "PartialEq") {
        sb_append_str(sb, "// @derive(Eq) — auto-generated\neq fn(self: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ", other: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ") -> bool {\n    return ");
        if (fb == fe) {
            sb_append_str(sb, "true");
        } else {
            var i6: i64 = fb;
            while (i6 < fe) {
                if (i6 > fb) {
                    sb_append_str(sb, " && ");
                }
                sb_append_str(sb, "self.");
                sb_append_str(sb, df_names[i6]);
                sb_append_str(sb, " == other.");
                sb_append_str(sb, df_names[i6]);
                i6 = i6 + 1;
            }
        }
        sb_append_str(sb, ";\n}");
        return sb_to_str(sb);
    }

    if (trait == "Hash") {
        sb_append_str(sb, "// @derive(Hash) — auto-generated\nhash fn(self: ");
        sb_append_str(sb, name);
        sb_append_str(sb, ") -> u64 {\n    var hash: u64 = 0;\n");
        var i7: i64 = fb;
        while (i7 < fe) {
            if (i7 > fb) {
                sb_append_str(sb, "\n");
            }
            sb_append_str(sb, "    hash = hash_combine(hash, hash_of(self.");
            sb_append_str(sb, df_names[i7]);
            sb_append_str(sb, "));");
            i7 = i7 + 1;
        }
        sb_append_str(sb, "\n    return hash;\n}");
        return sb_to_str(sb);
    }

    return "";
}

fn process_derive(d: i64) -> void {
    var n: Node = nodes[d];
    var tb: i64 = collect_traits(d);
    var te: i64 = slice_len(dt_traits) as i64;
    if (tb == te) {
        return;
    }
    var fb: i64 = collect_fields(d);
    var fe: i64 = slice_len(df_names) as i64;
    var i: i64 = tb;
    while (i < te) {
        var code: string = gen_trait(dt_traits[i], n.sa, fb, fe);
        if (code != "") {
            spush(code);
            spush("");
        }
        i = i + 1;
    }
}

// ── emitAttributes（复刻 emitter.ts emitAttributes）────────────

fn emit_attributes(head: i64) -> string {
    var sb: StringBuilder = sb_new();
    var cnt: i64 = 0;
    var c: i64 = head;
    while (c >= 0) {
        var k: Child = kids[c];
        var a: Node = nodes[k.val];
        var s: string = "";
        var has: bool = false;
        if (a.sa == "inline") {
            s = "__attribute__((always_inline))";
            has = true;
        }
        if (a.sa == "no_inline") {
            s = "__attribute__((noinline))";
            has = true;
        }
        if (a.sa == "deprecated") {
            s = "__attribute__((deprecated))";
            var arg: i64 = ann_first_arg(k.val);
            if (arg >= 0) {
                var an: Node = nodes[arg];
                if (an.kind == "string") {
                    s = sb_cat3("__attribute__((deprecated(\"", an.sa, "\")))");
                }
            }
            has = true;
        }
        if (a.sa == "must_use") {
            s = "__attribute__((warn_unused_result))";
            has = true;
        }
        if (a.sa == "export_symbol") {
            var arg2: i64 = ann_first_arg(k.val);
            if (arg2 >= 0) {
                var an2: Node = nodes[arg2];
                if (an2.kind == "string") {
                    s = "__attribute__((visibility(\"default\")))";
                    has = true;
                }
            }
        }
        if (has) {
            if (cnt > 0) {
                sb_append_str(sb, " ");
            }
            sb_append_str(sb, s);
            cnt = cnt + 1;
        }
        c = k.next;
    }
    return sb_to_str(sb);
}

// ── 各声明 emitter（复刻 emitter.ts emitDecl 系列）─────────────

fn emit_struct_decl(d: i64) -> void {
    var n: Node = nodes[d];
    var attrs: string = emit_attributes(n.la);

    if (n.ba && n.has_sc) {
        hpush(sb_cat3("// @bitpack(", n.sc, ") struct"));
        if (attrs != "") {
            hpush(attrs);
        }
        hpush(sb_cat3("typedef struct ", n.sa, " {"));
        var c: i64 = n.lb;
        while (c >= 0) {
            var k: Child = kids[c];
            var f: Node = nodes[k.val];
            var fsb: StringBuilder = sb_new();
            sb_append_str(fsb, "    ");
            sb_append_str(fsb, scalar_to_c(n.sc));
            sb_append_str(fsb, " ");
            sb_append_str(fsb, f.sa);
            sb_append_str(fsb, " : ");
            sb_append_i64(fsb, f.ia);
            sb_append_str(fsb, ";");
            hpush(sb_to_str(fsb));
            c = k.next;
        }
        hpush(sb_cat3("} ", n.sa, ";"));
    } else {
        var layout_attr: string = "";
        if (n.sb == "soa") {
            layout_attr = " // #soa layout";
        }
        if (attrs != "") {
            hpush(attrs);
        }
        hpush(sb_cat4("typedef struct ", n.sa, " {", layout_attr));
        var c2: i64 = n.lb;
        while (c2 >= 0) {
            var k2: Child = kids[c2];
            var f2: Node = nodes[k2.val];
            if (f2.ia < 0) {
                var fattrs: string = emit_attributes(f2.la);
                if (fattrs != "") {
                    hpush(sb_cat2("    ", fattrs));
                }
                hpush(sb_cat6("    ", emit_ctype(f2.na), " ", f2.sa, ";", ""));
            }
            c2 = k2.next;
        }
        hpush(sb_cat3("} ", n.sa, ";"));
    }

    process_derive(d);
}

fn emit_enum_decl(d: i64) -> void {
    var n: Node = nodes[d];
    hpush(sb_cat6("typedef ", scalar_to_c(n.sb), " ", n.sa, ";", ""));
    hpush("");
    var auto_val: i64 = 0;
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var v: Node = nodes[k.val];
        if (v.na >= 0) {
            hpush(sb_cat6("#define ", n.sa, "_", v.sa, " ", emit_expr(v.na)));
            var vn: Node = nodes[v.na];
            if (vn.kind == "int") {
                auto_val = js_parse_int(vn.sa, vn.ia) + 1;
            }
        } else {
            hpush(sb_cat6("#define ", n.sa, "_", v.sa, " ", i2s(auto_val)));
            auto_val = auto_val + 1;
        }
        c = k.next;
    }
}

fn emit_flag_decl(d: i64) -> void {
    var n: Node = nodes[d];
    hpush(sb_cat4("// flag[", n.sb, "] ", n.sa));
    hpush(sb_cat6("typedef ", scalar_to_c(n.sb), " ", n.sa, ";", ""));
    hpush("");

    var base: i64 = fr_layout(d);
    var total: i64 = slice_len(fl_names) as i64;
    var i: i64 = base;
    while (i < total) {
        if (fl_lens[i] == 1) {
            var ssb: StringBuilder = sb_new();
            sb_append_str(ssb, "#define ");
            sb_append_str(ssb, n.sa);
            sb_append_str(ssb, "_");
            sb_append_str(ssb, fl_names[i]);
            sb_append_str(ssb, " (1u << ");
            sb_append_i64(ssb, fl_starts[i]);
            sb_append_str(ssb, ")");
            hpush(sb_to_str(ssb));
        } else {
            var csb: StringBuilder = sb_new();
            sb_append_str(csb, "// ");
            sb_append_str(csb, fl_names[i]);
            sb_append_str(csb, ": bits ");
            sb_append_i64(csb, fl_starts[i]);
            sb_append_str(csb, "-");
            sb_append_i64(csb, fl_ends[i] - 1);
            sb_append_str(csb, " (");
            sb_append_i64(csb, fl_lens[i]);
            sb_append_str(csb, " bits, max=");
            sb_append_i64(csb, js_max_val(fl_lens[i]));
            sb_append_str(csb, ")");
            hpush(sb_to_str(csb));
            var hsb: StringBuilder = sb_new();
            sb_append_str(hsb, "#define ");
            sb_append_str(hsb, n.sa);
            sb_append_str(hsb, "_");
            sb_append_str(hsb, fl_names[i]);
            sb_append_str(hsb, "_SHIFT ");
            sb_append_i64(hsb, fl_starts[i]);
            hpush(sb_to_str(hsb));
            var msb: StringBuilder = sb_new();
            sb_append_str(msb, "#define ");
            sb_append_str(msb, n.sa);
            sb_append_str(msb, "_");
            sb_append_str(msb, fl_names[i]);
            sb_append_str(msb, "_MASK (((1u << ");
            sb_append_i64(msb, fl_lens[i]);
            sb_append_str(msb, ") - 1) << ");
            sb_append_i64(msb, fl_starts[i]);
            sb_append_str(msb, ")");
            hpush(sb_to_str(msb));
        }
        i = i + 1;
    }
}

fn emit_flag_set_decl(d: i64) -> void {
    var n: Node = nodes[d];
    hpush(sb_cat3("// flag_set ", n.sa, " (dynamic length bitfield)"));
    hpush(sb_cat3("typedef struct ", n.sa, " {"));
    hpush("    uint8_t* data;");
    hpush("    size_t bit_count;");
    hpush("    size_t byte_count;");
    hpush(sb_cat3("} ", n.sa, ";"));
    hpush("");

    var base: i64 = fr_layout(d);
    var total: i64 = slice_len(fl_names) as i64;
    var i: i64 = base;
    while (i < total) {
        var csb: StringBuilder = sb_new();
        sb_append_str(csb, "// ");
        sb_append_str(csb, fl_names[i]);
        sb_append_str(csb, ": bits ");
        sb_append_i64(csb, fl_starts[i]);
        sb_append_str(csb, "-");
        sb_append_i64(csb, fl_ends[i] - 1);
        sb_append_str(csb, " (");
        sb_append_i64(csb, fl_lens[i]);
        sb_append_str(csb, " bits)");
        hpush(sb_to_str(csb));
        var hsb: StringBuilder = sb_new();
        sb_append_str(hsb, "#define ");
        sb_append_str(hsb, n.sa);
        sb_append_str(hsb, "_");
        sb_append_str(hsb, fl_names[i]);
        sb_append_str(hsb, "_SHIFT ");
        sb_append_i64(hsb, fl_starts[i]);
        hpush(sb_to_str(hsb));
        var msb: StringBuilder = sb_new();
        sb_append_str(msb, "#define ");
        sb_append_str(msb, n.sa);
        sb_append_str(msb, "_");
        sb_append_str(msb, fl_names[i]);
        sb_append_str(msb, "_MASK (((1u << ");
        sb_append_i64(msb, fl_lens[i]);
        sb_append_str(msb, ") - 1) << ");
        sb_append_i64(msb, fl_starts[i]);
        sb_append_str(msb, ")");
        hpush(sb_to_str(msb));
        i = i + 1;
    }
}

fn emit_union_decl(d: i64) -> void {
    var n: Node = nodes[d];
    hpush(sb_cat3("typedef union ", n.sa, " {"));
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var m: Node = nodes[k.val];
        hpush(sb_cat6("    ", emit_ctype(m.na), " ", m.sa, ";", ""));
        c = k.next;
    }
    hpush(sb_cat3("} ", n.sa, ";"));
}

// Variant：tagged union。发射 struct { uint32_t _tag; union { 载荷 _uN; } _u; } 及各 case 的
// static inline 构造器/判别器/取载荷（直接落头文件，函数体用 StringBuilder 拼 tag 整数）。
fn emit_variant_decl(d: i64) -> void {
    var n: Node = nodes[d];
    var hsb: StringBuilder = sb_new();
    sb_append_str(hsb, "// variant ");
    sb_append_str(hsb, n.sa);
    hpush(sb_to_str(hsb));
    hpush(sb_cat3("typedef struct ", n.sa, " {"));
    hpush("    uint32_t _tag;");
    hpush("    union {");
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var vc: Node = nodes[k.val];
        if (vc.na >= 0) {
            var us: StringBuilder = sb_new();
            sb_append_str(us, "        ");
            sb_append_str(us, emit_ctype(vc.na));
            sb_append_str(us, " _u");
            sb_append_i64(us, vc.ia);
            sb_append_str(us, ";");
            hpush(sb_to_str(us));
        }
        c = k.next;
    }
    hpush("    } _u;");
    hpush(sb_cat3("} ", n.sa, ";"));
    hpush("");

    c = n.lb;
    while (c >= 0) {
        var k2: Child = kids[c];
        var vc2: Node = nodes[k2.val];
        var cname: string = vc2.sa;
        // 构造器
        var fsb: StringBuilder = sb_new();
        sb_append_str(fsb, "static inline ");
        sb_append_str(fsb, n.sa);
        sb_append_str(fsb, " ");
        sb_append_str(fsb, n.sa);
        sb_append_str(fsb, "_from_");
        sb_append_str(fsb, cname);
        if (vc2.na >= 0) {
            sb_append_str(fsb, "(");
            sb_append_str(fsb, emit_ctype(vc2.na));
            sb_append_str(fsb, " v) {");
        } else {
            sb_append_str(fsb, "(void) {");
        }
        hpush(sb_to_str(fsb));
        hpush(sb_cat3("    ", n.sa, " _s;"));
        var tsb: StringBuilder = sb_new();
        sb_append_str(tsb, "    _s._tag = ");
        sb_append_i64(tsb, vc2.ia);
        sb_append_str(tsb, ";");
        hpush(sb_to_str(tsb));
        if (vc2.na >= 0) {
            var asb: StringBuilder = sb_new();
            sb_append_str(asb, "    _s._u._u");
            sb_append_i64(asb, vc2.ia);
            sb_append_str(asb, " = v;");
            hpush(sb_to_str(asb));
        }
        hpush("    return _s;");
        hpush("}");
        // 判别器
        var isb: StringBuilder = sb_new();
        sb_append_str(isb, "static inline bool ");
        sb_append_str(isb, n.sa);
        sb_append_str(isb, "_is_");
        sb_append_str(isb, cname);
        sb_append_str(isb, "(");
        sb_append_str(isb, n.sa);
        sb_append_str(isb, " self) {");
        hpush(sb_to_str(isb));
        var isb2: StringBuilder = sb_new();
        sb_append_str(isb2, "    return self._tag == ");
        sb_append_i64(isb2, vc2.ia);
        sb_append_str(isb2, ";");
        hpush(sb_to_str(isb2));
        hpush("}");
        // 取载荷
        if (vc2.na >= 0) {
            var asb2: StringBuilder = sb_new();
            sb_append_str(asb2, "static inline ");
            sb_append_str(asb2, emit_ctype(vc2.na));
            sb_append_str(asb2, " ");
            sb_append_str(asb2, n.sa);
            sb_append_str(asb2, "_as_");
            sb_append_str(asb2, cname);
            sb_append_str(asb2, "(");
            sb_append_str(asb2, n.sa);
            sb_append_str(asb2, " self) {");
            hpush(sb_to_str(asb2));
            var asb3: StringBuilder = sb_new();
            sb_append_str(asb3, "    return self._u._u");
            sb_append_i64(asb3, vc2.ia);
            sb_append_str(asb3, ";");
            hpush(sb_to_str(asb3));
            hpush("}");
        }
        c = k2.next;
    }
    hpush("");
}

fn emit_func_decl(d: i64) -> void {
    var n: Node = nodes[d];
    var emit_name: string = n.sa;
    if (ann_find(n.la, "main") >= 0) {
        emit_name = sb_cat2("t_entry_", n.sa);
        em_main_fn = emit_name;
        em_has_main = true;
    }
    var attrs: string = emit_attributes(n.la);

    var psb: StringBuilder = sb_new();
    var cnt: i64 = 0;
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var p: Node = nodes[k.val];
        if (cnt > 0) {
            sb_append_str(psb, ", ");
        }
        sb_append_str(psb, emit_ctype(p.na));
        sb_append_str(psb, " ");
        sb_append_str(psb, p.sa);
        cnt = cnt + 1;
        c = k.next;
    }
    var param_str: string = "void";
    if (cnt > 0) {
        param_str = sb_to_str(psb);
    }
    var ret: string = emit_ctype(n.na);

    if (n.ba) {
        if (attrs != "") {
            hpush(attrs);
        }
        hpush(sb_cat6(ret, " ", emit_name, "(", param_str, ");"));
        return;
    }

    if (attrs != "") {
        hpush(attrs);
    }
    hpush(sb_cat6(ret, " ", emit_name, "(", param_str, ");"));

    em_cur_fn = n.sa;
    em_in_fn = true;
    spush(sb_cat6(ret, " ", emit_name, "(", param_str, ") {"));
    if (n.lc > -2) {
        var b: i64 = n.lc;
        while (b >= 0) {
            var bk: Child = kids[b];
            emit_stmt(bk.val, 1);
            b = bk.next;
        }
    }
    spush("}");
    em_in_fn = false;
    em_cur_fn = "";
    spush("");
}

fn emit_global_var(d: i64) -> void {
    var n: Node = nodes[d];
    hpush(sb_cat6("extern ", emit_ctype(n.na), " ", n.sa, ";", ""));
    // Sym 全局变量：字段仅存 u32/u16 id。无初始化 → 零值；`= "str"` →
    // 运行期 intern（函数调用），须搬进 t__ginit（C 文件作用域不允许调用）。
    var gtd0: i64 = resolve_type_desc(n.na);
    var gt0: TD = tds[gtd0];
    if (gt0.cat == "sym") {
        var symcty: string = emit_ctype(n.na);
        if (n.nb < 0) {
            spush(sb_cat5(symcty, " ", n.sa, ";", ""));
            return;
        }
        var symtagl: string = sb_cat3("TSTR_LIT(\"", esc_c(gt0.name), "\")");
        var symintr: string = sb_cat6("t_sym_intern(", symtagl, ", ", emit_expr(n.nb), ", ", sb_cat2(i2s(gt0.alen), ")"));
        spush(sb_cat5(symcty, " ", n.sa, ";", ""));
        append(glines, sb_cat4("    ", n.sa, " = ", sb_cat2(symintr, ";")));
        return;
    }
    if (n.nb < 0) {
        spush(sb_cat6(emit_ctype(n.na), " ", n.sa, "", ";", ""));
        return;
    }
    // 先在重定向模式下发射初始化器：若它产生了辅助语句（如 map 字面量的
    // t_map_new/t_map_put），说明不是 C 的编译期常量，须搬进 t__ginit。
    var gbase: i64 = slice_len(glines) as i64;
    g_spush_to_ginit = true;
    g_stmt_pad = "    ";
    var gv: string = emit_expr(n.nb);
    g_spush_to_ginit = false;
    g_stmt_pad = "";
    if ((slice_len(glines) as i64) > gbase) {
        spush(sb_cat6(emit_ctype(n.na), " ", n.sa, "", ";", ""));
        append(glines, sb_cat4("    ", n.sa, " = ", sb_cat2(gv, ";")));
        return;
    }
    spush(sb_cat6(emit_ctype(n.na), " ", n.sa, sb_cat2(" = ", gv), ";", ""));
}

fn emit_global_const(d: i64) -> void {
    var n: Node = nodes[d];
    hpush(sb_cat6("#define ", n.sa, " (", emit_expr(n.nb), ")", ""));
}

fn emit_decl(d: i64) -> void {
    var n: Node = nodes[d];
    if (n.kind == "StructDecl") {
        emit_struct_decl(d);
        return;
    }
    if (n.kind == "EnumDecl") {
        emit_enum_decl(d);
        return;
    }
    if (n.kind == "FlagDecl") {
        emit_flag_decl(d);
        return;
    }
    if (n.kind == "FlagSetDecl") {
        emit_flag_set_decl(d);
        return;
    }
    if (n.kind == "UnionDecl") {
        emit_union_decl(d);
        return;
    }
    if (n.kind == "VariantDecl") {
        emit_variant_decl(d);
        return;
    }
    if (n.kind == "FuncDecl") {
        emit_func_decl(d);
        return;
    }
    if (n.kind == "GlobalVarDecl") {
        emit_global_var(d);
        return;
    }
    if (n.kind == "GlobalConstDecl") {
        emit_global_const(d);
        return;
    }
    if (n.kind == "ImportDecl") {
        hpush(sb_cat3("#include \"", n.sb, "\""));
        return;
    }
    if (n.kind == "TypeAliasDecl") {
        hpush(sb_cat6("typedef ", emit_ctype(n.na), " ", n.sa, ";", ""));
        return;
    }
}

// ── Flag 操作宏（复刻 emitFlagMacros）──────────────────────────

fn emit_flag_macros() -> void {
    hpush("");
    hpush("// ── Flag operations (spec 6.4) ──");
    hpush("// 1-bit: use | & ^ operators, check with (mask & FLAG) != 0");
    hpush("// multi-bit: use flag_set_val/flag_get_val macros");
    hpush("");
    hpush("#define flag_set_val(flags, shift, mask, val) do { (flags) = ((flags) & ~(mask)) | (((val) << (shift)) & (mask)); } while(0)");
    hpush("#define flag_get_val(flags, shift, mask) (((flags) & (mask)) >> (shift))");
    hpush("");
}

// ── emit 编排（复刻 CEmitter.emit）─────────────────────────────

fn emit_unit(mod: string) -> void {
    var guard: string = sb_cat3("TC_", to_upper(mod), "_H");
    hpush(sb_cat2("#ifndef ", guard));
    hpush(sb_cat2("#define ", guard));
    hpush("");
    hpush("#include <stdint.h>");
    hpush("#include <stdbool.h>");
    hpush("#include <stddef.h>");
    hpush("#include \"t_runtime.h\"");
    hpush("");
    // type_info(T) 常量结构（M36）：TTypeInfo/TFieldInfo 由 t_runtime.h 提供，
    // 此处不再重复 typedef（否则与 t_runtime.h 重定义冲突）。

    spush(sb_cat3("#include \"", mod, ".h\""));
    spush("#include <stdio.h>");
    spush("#include <stdlib.h>");
    spush("#include <string.h>");
    spush("#include \"t_runtime.h\"");
    spush("");

    build_type_map();

    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        emit_decl(decl_list[i]);
        i = i + 1;
    }

    // type_info(T) 编译期常量（引用 StructDecl，须在类型定义后输出）
    var tln: i64 = slice_len(ti_lines) as i64;
    if (tln > 0) {
        spush("");
        var ti: i64 = 0;
        while (ti < tln) {
            spush(ti_lines[ti]);
            ti = ti + 1;
        }
    }

    // 全局 var 的运行期初始化器（非编译期常量）汇总为 t__ginit，在 main 开头调用
    var gn: i64 = slice_len(glines) as i64;
    if (gn > 0) {
        spush("");
        spush("static void t__ginit(void) {");
        var gi: i64 = 0;
        while (gi < gn) {
            spush(glines[gi]);
            gi = gi + 1;
        }
        spush("}");
    }

    if (em_has_main) {
        spush("");
        spush("int main(int argc, char** argv) {");
        spush("    t_runtime_init(argc, argv);");
        spush("    t_runtime_set_arena(t_arena_new());");
        if (gn > 0) {
            spush("    t__ginit();");
        }
        spush(sb_cat3("    int32_t _exit_code = ", em_main_fn, "();"));
        spush("    t_runtime_done();");
        spush("    return (int)_exit_code;");
        spush("}");
        spush("");
    }

    emit_flag_macros();

    hpush("");
    hpush(sb_cat2("#endif // ", guard));
}

// ── 输出行拼接（join("\n")，无末尾换行）────────────────────────

fn h_join() -> string {
    var sb: StringBuilder = sb_new();
    var n: i64 = slice_len(hlines) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (i > 0) {
            sb_append_str(sb, "\n");
        }
        sb_append_str(sb, hlines[i]);
        i = i + 1;
    }
    return sb_to_str(sb);
}

fn s_join() -> string {
    var sb: StringBuilder = sb_new();
    var n: i64 = slice_len(slines) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (i > 0) {
            sb_append_str(sb, "\n");
        }
        sb_append_str(sb, slines[i]);
        i = i + 1;
    }
    return sb_to_str(sb);
}

// ═══════════════════════════════════════════════════════════════
// M13: LLVM IR Emitter — .tc 直出 .ll，配合 clang 一步到可执行程序
//
// 值模型：
//   * 标量表达式 → SSA 值（bool 统一 i8，仅分支处转 i1）
//   * 聚合表达式（string/slice/struct/variant/union）→ 指向存储的 ptr
//   * 全部 alloca 集中在函数 entry 块（循环内不增长栈）
//   * 与 C runtime 的交互统一经 t_shim_ll.c 的 tll_* 指针化桥接；
//     模块内 t 函数间聚合按值传递（同模块 lowering 一致，无 ABI 风险）
// ═══════════════════════════════════════════════════════════════

var ll_head: []string;    // 模块头：类型定义 + declare
var ll_glob: []string;    // 字符串常量 + 全局变量定义
var ll_body: []string;    // 函数定义
var ll_fal: []string;     // 当前函数 entry 块 alloca 行
var ll_fb: []string;      // 当前函数体指令行
var ll_tmpc: i64;         // SSA 临时值计数（每函数重置）
var ll_lblc: i64;         // 标签计数（每函数重置）
var ll_scc: i64;          // scratch alloca 计数（每函数重置）
var ll_strc: i64;         // 字符串常量计数（模块级）
var ll_term: bool;        // 当前块是否已被终结指令封口
var ll_cur_blk: string;   // 当前基本块标签（phi 前驱用）
var ll_cur_ret: i64;      // 当前函数返回类型 td
var ll_has_main: bool;
var ll_main_fn: string;
var ll_last_sref: string; // 最近一次字符串常量的 @.sN 引用
var ll_last_slen: i64;

fn llph(s: string) -> void { append(ll_head, s); }
fn llpg(s: string) -> void { append(ll_glob, s); }
fn llpb(s: string) -> void { append(ll_body, s); }
fn llfa(s: string) -> void { append(ll_fal, s); }
fn llfb(s: string) -> void { append(ll_fb, s); }

// ── 具名类型注册表 ─────────────────────────────────────────────

var llt_names: []string;
var llt_kinds: []string;   // struct | enum | flag | variant | union | alias
var llt_unders: []string;  // enum/flag 底层标量名
var llt_atd: []i64;        // alias 目标 td（其余 -1）

var llsf_st: []string;     // struct 字段：名/字段/序号/td
var llsf_fld: []string;
var llsf_idx: []i64;
var llsf_td: []i64;

var llec_e: []string;      // enum 常量：类型名/成员名/值
var llec_m: []string;
var llec_v: []i64;

var llfl_f: []string;      // flag 槽位：类型名/槽名/start/len
var llfl_s: []string;
var llfl_start: []i64;
var llfl_len: []i64;

var llv_v: []string;       // variant case：类型名/case 名/tag/载荷 td(-1 无)
var llv_c: []string;
var llv_tag: []i64;
var llv_ptd: []i64;

var llu_u: []string;       // union 成员：类型名/成员名/td
var llu_m: []string;
var llu_td: []i64;

var llfn_n: []string;      // 函数签名：名/返回 td/参数池起点/参数数/extern
var llfn_r: []i64;
var llfn_ps: []i64;
var llfn_pc: []i64;
var llfn_x: []bool;
var llfp_td: []i64;        // 参数 td 扁平池

var llgv_n: []string;      // 全局 var：名/td/init 节点(-1 无)
var llgv_td: []i64;
var llgv_init: []i64;

var llcn_n: []string;      // 全局 const：名/表达式节点（使用处内联展开）
var llcn_e: []i64;

var lla_n: []string;       // 当前函数已 alloca 的名字（去重）
var llbrk: []string;       // break/continue 目标栈（top = ll_loopd-1）
var llcnt: []string;
var ll_loopd: i64;

fn llt_find(name: string) -> i64 {
    var n: i64 = slice_len(llt_names) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (llt_names[i] == name) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn llsf_find(st: string, f: string) -> i64 {
    var n: i64 = slice_len(llsf_st) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (llsf_st[i] == st && llsf_fld[i] == f) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn llec_find(e: string, m: string) -> i64 {
    var n: i64 = slice_len(llec_e) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (llec_e[i] == e && llec_m[i] == m) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn llfl_find(f: string, s: string) -> i64 {
    var n: i64 = slice_len(llfl_f) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (llfl_f[i] == f && llfl_s[i] == s) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn llfn_find(name: string) -> i64 {
    var n: i64 = slice_len(llfn_n) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (llfn_n[i] == name) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn llgv_find(name: string) -> i64 {
    var n: i64 = slice_len(llgv_n) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (llgv_n[i] == name) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn llcn_find(name: string) -> i64 {
    var n: i64 = slice_len(llcn_n) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (llcn_n[i] == name) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn lla_has(name: string) -> bool {
    var n: i64 = slice_len(lla_n) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (lla_n[i] == name) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// variant 辅助函数名匹配：Name_from_Case / Name_is_Case / Name_as_Case
// 命中后设置 ll_vm_kind ("from"/"is"/"as") 与池下标 ll_vm_i
var ll_vm_kind: string;
var ll_vm_i: i64;

fn llv_match(cn: string) -> bool {
    ll_vm_kind = "";
    ll_vm_i = -1;
    var n: i64 = slice_len(llv_v) as i64;
    var i: i64 = 0;
    while (i < n) {
        var f1: string = sb_cat4(llv_v[i], "_from_", llv_c[i], "");
        if (cn == f1) {
            ll_vm_kind = "from";
            ll_vm_i = i;
            return true;
        }
        var f2: string = sb_cat4(llv_v[i], "_is_", llv_c[i], "");
        if (cn == f2) {
            ll_vm_kind = "is";
            ll_vm_i = i;
            return true;
        }
        var f3: string = sb_cat4(llv_v[i], "_as_", llv_c[i], "");
        if (cn == f3) {
            ll_vm_kind = "as";
            ll_vm_i = i;
            return true;
        }
        i = i + 1;
    }
    return false;
}

// ── 标量 → LLVM 类型 ───────────────────────────────────────────

// >>> GEN:scalar_llmap (generated by tools/totter.tc from out/ebnf.json -- DO NOT EDIT) >>>
fn scalar_to_ll(name: string) -> string {
    if (name == "u8" || name == "i8" || name == "bool") { return "i8"; }
    if (name == "u16" || name == "i16") { return "i16"; }
    if (name == "u32" || name == "i32") { return "i32"; }
    if (name == "f32") { return "float"; }
    if (name == "f64") { return "double"; }
    return "i64";
}

fn ll_bits(name: string) -> i64 {
    if (name == "u8" || name == "i8" || name == "bool") { return 8; }
    if (name == "u16" || name == "i16") { return 16; }
    if (name == "u32" || name == "i32" || name == "f32") { return 32; }
    return 64;
}
// <<< GEN:scalar_llmap <<<

fn ll_signed(name: string) -> bool {
    if (str_len(name) == 0) {
        return false;
    }
    return name[0] == 105 || name[0] == 102;
}

fn ll_isf(name: string) -> bool {
    return name == "f32" || name == "f64";
}

// ── td → LLVM 类型 ─────────────────────────────────────────────

fn ll_named(name: string) -> string {
    if (name == "TSb*") { return "ptr"; }
    var i: i64 = llt_find(name);
    if (i < 0) {
        return "i64";
    }
    var k: string = llt_kinds[i];
    if (k == "struct") { return sb_cat2("%st.", name); }
    if (k == "variant") { return sb_cat2("%vt.", name); }
    if (k == "union") { return sb_cat2("%un.", name); }
    if (k == "enum" || k == "flag") { return scalar_to_ll(llt_unders[i]); }
    if (k == "alias") { return ll_td(llt_atd[i]); }
    return "i64";
}

fn ll_td(td: i64) -> string {
    if (td < 0) {
        return "i64";
    }
    var t: TD = tds[td];
    if (t.cat == "string") { return "%TStr"; }
    if (t.cat == "slice") { return "%TSlice"; }
    if (t.cat == "array") {
        var an: i64 = t.alen;
        if (an < 0) {
            an = 0;
        }
        return sb_cat5("[", i2s(an), " x ", ll_td(t.elem), "]");
    }
    if (t.cat == "map") { return "ptr"; }
    if (t.cat == "sym") {
        if (t.alen == 16) { return "i16"; }
        return "i32";
    }
    if (t.cat == "typeinfo" || t.cat == "fieldinfo") { return "ptr"; }
    if (t.cat == "void") { return "void"; }
    if (t.cat == "scalar") {
        if (t.name == "") {
            return "i64";
        }
        return scalar_to_ll(t.name);
    }
    if (t.cat == "named") {
        if (t.name == "") {
            return "ptr";
        }
        return ll_named(t.name);
    }
    return "i64";
}

// td 是否聚合（值模型走 ptr）
fn ll_isagg(td: i64) -> bool {
    if (td < 0) {
        return false;
    }
    var t: TD = tds[td];
    if (t.cat == "string" || t.cat == "slice" || t.cat == "array") {
        return true;
    }
    if (t.cat == "named") {
        if (t.name == "TSb*") {
            return false;
        }
        var i: i64 = llt_find(t.name);
        if (i < 0) {
            return false;
        }
        var k: string = llt_kinds[i];
        if (k == "struct" || k == "variant" || k == "union") {
            return true;
        }
        if (k == "alias") {
            return ll_isagg(llt_atd[i]);
        }
        return false;
    }
    return false;
}

// td 的标量名（"" = 非标量）；enum/flag/alias 归一到底层标量
fn td_sname(td: i64) -> string {
    if (td < 0) {
        return "i64";
    }
    var t: TD = tds[td];
    if (t.cat == "scalar") {
        if (t.name == "") {
            return "i64";
        }
        return t.name;
    }
    // Sym 底层是无符号 id：Sym16→u16、Sym32→u32（供比较/运算取正确 LLVM 位宽）
    if (t.cat == "sym") {
        if (t.alen == 16) { return "u16"; }
        return "u32";
    }
    if (t.cat == "unknown") {
        return "i64";
    }
    if (t.cat == "named") {
        var i: i64 = llt_find(t.name);
        if (i < 0) {
            return "";
        }
        var k: string = llt_kinds[i];
        if (k == "enum" || k == "flag") {
            return llt_unders[i];
        }
        if (k == "alias") {
            return td_sname(llt_atd[i]);
        }
        return "";
    }
    return "";
}

fn ll_sizeof(ty: string) -> string {
    return sb_cat3("ptrtoint (ptr getelementptr (", ty, ", ptr null, i32 1) to i64)");
}

fn ll_zero(ty: string) -> string {
    if (str_len(ty) > 0) {
        // 37 = '%'（具名聚合），91 = '['（定长数组 [N x T]）
        if (ty[0] == 37 || ty[0] == 91) {
            return "zeroinitializer";
        }
    }
    if (ty == "float" || ty == "double") {
        return "0.0";
    }
    if (ty == "ptr") {
        return "null";
    }
    return "0";
}

// ── 字符串常量 ─────────────────────────────────────────────────

fn esc_ll(s: string) -> string {
    var sb: StringBuilder = sb_new();
    var i: u64 = 0;
    var n: u64 = str_len(s);
    while (i < n) {
        var c: u8 = s[i];
        if (c >= 32 && c <= 126 && c != 34 && c != 92) {
            sb_append_char(sb, c);
        } else {
            sb_append_char(sb, 92);
            sb_append_char(sb, hex_digit(c / 16));
            sb_append_char(sb, hex_digit(c % 16));
        }
        i = i + 1;
    }
    return sb_to_str(sb);
}

// 生成字符串常量对（[N x i8] + %TStr），返回 "@.tsN"（聚合 ptr 值）
fn ll_strlit(s: string) -> string {
    var idx: i64 = ll_strc;
    ll_strc = ll_strc + 1;
    var sn: string = sb_cat2("@.s", i2s(idx));
    var tn: string = sb_cat2("@.ts", i2s(idx));
    var L: i64 = str_len(s) as i64;
    if (L == 0) {
        llpg(sb_cat2(sn, " = private unnamed_addr constant [1 x i8] zeroinitializer"));
    } else {
        var line: StringBuilder = sb_new();
        sb_append_str(line, sn);
        sb_append_str(line, " = private unnamed_addr constant [");
        sb_append_i64(line, L);
        sb_append_str(line, " x i8] c\"");
        sb_append_str(line, esc_ll(s));
        sb_append_str(line, "\"");
        llpg(sb_to_str(line));
    }
    var l2: StringBuilder = sb_new();
    sb_append_str(l2, tn);
    sb_append_str(l2, " = private unnamed_addr constant %TStr { ptr ");
    sb_append_str(l2, sn);
    sb_append_str(l2, ", i64 ");
    sb_append_i64(l2, L);
    sb_append_str(l2, " }");
    llpg(sb_to_str(l2));
    ll_last_sref = sn;
    ll_last_slen = L;
    return tn;
}

// ── 临时值 / 标签 / scratch ────────────────────────────────────

fn ll_tmp() -> string {
    var v: i64 = ll_tmpc;
    ll_tmpc = v + 1;
    return sb_cat2("%t", i2s(v));
}

fn ll_lbl(p: string) -> string {
    var v: i64 = ll_lblc;
    ll_lblc = v + 1;
    return sb_cat2(p, i2s(v));
}

fn ll_label(name: string) -> void {
    llfb(sb_cat2(name, ":"));
    ll_cur_blk = name;
    ll_term = false;
}

fn ll_open() -> void {
    if (ll_term) {
        var L: string = ll_lbl("dead");
        ll_label(L);
    }
}

// 每个调用点一个 scratch alloca（置于 entry，循环安全）
fn ll_scratch(ty: string) -> string {
    var v: i64 = ll_scc;
    ll_scc = v + 1;
    var name: string = sb_cat2("%s", i2s(v));
    llfa(sb_cat4("  ", name, " = alloca ", ty));
    return name;
}

// ── 注册表构建 ─────────────────────────────────────────────────

fn ll_build_reg() -> void {
    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = decl_list[i];
        var dn: Node = nodes[d];
        if (dn.kind == "StructDecl") {
            append(llt_names, dn.sa);
            append(llt_kinds, "struct");
            append(llt_unders, "");
            var neg1: i64 = -1;
            append(llt_atd, neg1);
            var fi: i64 = 0;
            var c: i64 = dn.lb;
            while (c >= 0) {
                var k: Child = kids[c];
                var f: Node = nodes[k.val];
                if (f.ia < 0) {
                    append(llsf_st, dn.sa);
                    append(llsf_fld, f.sa);
                    append(llsf_idx, fi);
                    var ftd: i64 = resolve_type_desc(f.na);
                    append(llsf_td, ftd);
                    fi = fi + 1;
                }
                c = k.next;
            }
        }
        if (dn.kind == "EnumDecl") {
            append(llt_names, dn.sa);
            append(llt_kinds, "enum");
            append(llt_unders, dn.sb);
            var neg2: i64 = -1;
            append(llt_atd, neg2);
            var auto_val: i64 = 0;
            var c2: i64 = dn.lb;
            while (c2 >= 0) {
                var k2: Child = kids[c2];
                var v: Node = nodes[k2.val];
                if (v.na >= 0) {
                    var vn: Node = nodes[v.na];
                    if (vn.kind == "int") {
                        var r: i64 = vn.ia;
                        if (r < 2) {
                            r = 10;
                        }
                        var pv: i64 = js_parse_int(vn.sa, r);
                        append(llec_e, dn.sa);
                        append(llec_m, v.sa);
                        append(llec_v, pv);
                        auto_val = pv + 1;
                    }
                } else {
                    append(llec_e, dn.sa);
                    append(llec_m, v.sa);
                    append(llec_v, auto_val);
                    auto_val = auto_val + 1;
                }
                c2 = k2.next;
            }
        }
        if (dn.kind == "FlagDecl") {
            append(llt_names, dn.sa);
            append(llt_kinds, "flag");
            append(llt_unders, dn.sb);
            var neg3: i64 = -1;
            append(llt_atd, neg3);
            var auto_off: i64 = 0;
            var c3: i64 = dn.lb;
            while (c3 >= 0) {
                var k3: Child = kids[c3];
                var sl: Node = nodes[k3.val];
                var start: i64 = auto_off;
                if (sl.bb) {
                    start = sl.ib;
                }
                append(llfl_f, dn.sa);
                append(llfl_s, sl.sa);
                append(llfl_start, start);
                append(llfl_len, sl.ia);
                auto_off = start + sl.ia;
                c3 = k3.next;
            }
        }
        if (dn.kind == "VariantDecl") {
            append(llt_names, dn.sa);
            append(llt_kinds, "variant");
            append(llt_unders, "");
            var neg4: i64 = -1;
            append(llt_atd, neg4);
            var c4: i64 = dn.lb;
            while (c4 >= 0) {
                var k4: Child = kids[c4];
                var vc: Node = nodes[k4.val];
                append(llv_v, dn.sa);
                append(llv_c, vc.sa);
                append(llv_tag, vc.ia);
                var ptd: i64 = -1;
                if (vc.na >= 0) {
                    ptd = resolve_type_desc(vc.na);
                }
                append(llv_ptd, ptd);
                c4 = k4.next;
            }
        }
        if (dn.kind == "UnionDecl") {
            append(llt_names, dn.sa);
            append(llt_kinds, "union");
            append(llt_unders, "");
            var neg5: i64 = -1;
            append(llt_atd, neg5);
            var c5: i64 = dn.lb;
            while (c5 >= 0) {
                var k5: Child = kids[c5];
                var m: Node = nodes[k5.val];
                append(llu_u, dn.sa);
                append(llu_m, m.sa);
                var mtd: i64 = resolve_type_desc(m.na);
                append(llu_td, mtd);
                c5 = k5.next;
            }
        }
        if (dn.kind == "TypeAliasDecl") {
            append(llt_names, dn.sa);
            append(llt_kinds, "alias");
            append(llt_unders, "");
            var atd: i64 = resolve_type_desc(dn.na);
            append(llt_atd, atd);
        }
        if (dn.kind == "FuncDecl") {
            append(llfn_n, dn.sa);
            var rtd: i64 = resolve_type_desc(dn.na);
            append(llfn_r, rtd);
            var ps: i64 = slice_len(llfp_td) as i64;
            append(llfn_ps, ps);
            var pc: i64 = 0;
            var c6: i64 = dn.lb;
            while (c6 >= 0) {
                var k6: Child = kids[c6];
                var p: Node = nodes[k6.val];
                var ptd2: i64 = resolve_type_desc(p.na);
                append(llfp_td, ptd2);
                pc = pc + 1;
                c6 = k6.next;
            }
            append(llfn_pc, pc);
            append(llfn_x, dn.ba);
        }
        if (dn.kind == "GlobalVarDecl") {
            append(llgv_n, dn.sa);
            var gtd: i64 = resolve_type_desc(dn.na);
            append(llgv_td, gtd);
            append(llgv_init, dn.nb);
        }
        if (dn.kind == "GlobalConstDecl") {
            append(llcn_n, dn.sa);
            append(llcn_e, dn.nb);
        }
        i = i + 1;
    }
}

// ── 表达式类型（expr_type_desc 的 LLVM 补丁包装）───────────────

fn ll_etd(e: i64) -> i64 {
    if (e < 0) {
        return td_mk("unknown");
    }
    var n: Node = nodes[e];
    if (n.kind == "unary") {
        if (n.sa == "!") {
            return td_named_mk("scalar", "bool");
        }
        return ll_etd(n.na);
    }
    if (n.kind == "struct_lit") {
        return td_named_mk("named", n.sa);
    }
    if (n.kind == "member") {
        var ob: Node = nodes[n.na];
        if (ob.kind == "ident") {
            var ti: i64 = llt_find(ob.sa);
            if (ti >= 0) {
                if (llt_kinds[ti] == "enum") {
                    return td_named_mk("scalar", llt_unders[ti]);
                }
            }
        }
        var od: i64 = expr_type_desc(e);
        var ot: TD = tds[od];
        if (ot.cat != "unknown") {
            return od;
        }
        // union 成员
        var obd: i64 = ll_etd(n.na);
        var obt: TD = tds[obd];
        if (obt.cat == "named") {
            var ui: i64 = llt_find(obt.name);
            if (ui >= 0) {
                if (llt_kinds[ui] == "union") {
                    var un: i64 = slice_len(llu_u) as i64;
                    var uj: i64 = 0;
                    while (uj < un) {
                        if (llu_u[uj] == obt.name && llu_m[uj] == n.sa) {
                            return llu_td[uj];
                        }
                        uj = uj + 1;
                    }
                }
            }
        }
        return od;
    }
    if (n.kind == "paren") {
        return ll_etd(n.na);
    }
    if (n.kind == "binary") {
        var bop9: string = n.sa;
        if (bop9 == "==" || bop9 == "!=" || bop9 == "<" || bop9 == ">") {
            return td_named_mk("scalar", "bool");
        }
        if (bop9 == "<=" || bop9 == ">=" || bop9 == "&&" || bop9 == "||") {
            return td_named_mk("scalar", "bool");
        }
        return ll_bin_td(e);
    }
    if (n.kind == "call") {
        var cal: Node = nodes[n.na];
        if (cal.kind == "ident") {
            var cn: string = cal.sa;
            if (cn == "flag_get") {
                return td_named_mk("scalar", "u32");
            }
            if (cn == "sys_run") {
                return td_named_mk("scalar", "i32");
            }
            if (llv_match(cn)) {
                if (ll_vm_kind == "from") {
                    return td_named_mk("named", llv_v[ll_vm_i]);
                }
                if (ll_vm_kind == "is") {
                    return td_named_mk("scalar", "bool");
                }
                return llv_ptd[ll_vm_i];
            }
        }
        return expr_type_desc(e);
    }
    return expr_type_desc(e);
}

// 二元运算的统一操作数类型：字面量让位于有类型的一侧
fn ll_bin_td(e: i64) -> i64 {
    var n: Node = nodes[e];
    var ln: Node = nodes[n.na];
    var rn: Node = nodes[n.nb];
    var llit: bool = ln.kind == "int" || ln.kind == "float";
    var rlit: bool = rn.kind == "int" || rn.kind == "float";
    if (llit && rlit == false) {
        return ll_etd(n.nb);
    }
    return ll_etd(n.na);
}

// ── 数值转换 ───────────────────────────────────────────────────

fn ll_cast_v(v: string, ftd: i64, ttd: i64) -> string {
    var fs: string = td_sname(ftd);
    var ts: string = td_sname(ttd);
    if (fs == "" || ts == "") {
        return v;
    }
    if (str_len(v) == 0) {
        return v;
    }
    if (v[0] != 37) {
        return v;    // 常量文本随目标类型自适应
    }
    var fb2: i64 = ll_bits(fs);
    var tb: i64 = ll_bits(ts);
    var ff: bool = ll_isf(fs);
    var tf: bool = ll_isf(ts);
    var fty: string = scalar_to_ll(fs);
    var tty: string = scalar_to_ll(ts);
    if (ff && tf) {
        if (fb2 == tb) {
            return v;
        }
        var t1: string = ll_tmp();
        if (fb2 < tb) {
            llfb(sb_cat6("  ", t1, " = fpext ", fty, " ", sb_cat4(v, " to ", tty, "")));
        } else {
            llfb(sb_cat6("  ", t1, " = fptrunc ", fty, " ", sb_cat4(v, " to ", tty, "")));
        }
        return t1;
    }
    if (ff && tf == false) {
        var t2: string = ll_tmp();
        if (ll_signed(ts)) {
            llfb(sb_cat6("  ", t2, " = fptosi ", fty, " ", sb_cat4(v, " to ", tty, "")));
        } else {
            llfb(sb_cat6("  ", t2, " = fptoui ", fty, " ", sb_cat4(v, " to ", tty, "")));
        }
        return t2;
    }
    if (ff == false && tf) {
        var t3: string = ll_tmp();
        if (ll_signed(fs)) {
            llfb(sb_cat6("  ", t3, " = sitofp ", fty, " ", sb_cat4(v, " to ", tty, "")));
        } else {
            llfb(sb_cat6("  ", t3, " = uitofp ", fty, " ", sb_cat4(v, " to ", tty, "")));
        }
        return t3;
    }
    if (ts == "bool") {
        if (fs == "bool") {
            return v;
        }
        var t4: string = ll_tmp();
        llfb(sb_cat6("  ", t4, " = icmp ne ", fty, " ", sb_cat3(v, ", ", "0")));
        var t5: string = ll_tmp();
        llfb(sb_cat6("  ", t5, " = zext i1 ", t4, " to i8", ""));
        return t5;
    }
    if (fb2 == tb) {
        return v;
    }
    var t6: string = ll_tmp();
    if (fb2 < tb) {
        if (ll_signed(fs)) {
            llfb(sb_cat6("  ", t6, " = sext ", fty, " ", sb_cat4(v, " to ", tty, "")));
        } else {
            llfb(sb_cat6("  ", t6, " = zext ", fty, " ", sb_cat4(v, " to ", tty, "")));
        }
    } else {
        llfb(sb_cat6("  ", t6, " = trunc ", fty, " ", sb_cat4(v, " to ", tty, "")));
    }
    return t6;
}

// i8 bool 值 → i1（分支条件）
fn ll_to_i1(v: string) -> string {
    if (v == "1") {
        return "true";
    }
    if (v == "0") {
        return "false";
    }
    var t: string = ll_tmp();
    llfb(sb_cat4("  ", t, " = icmp ne i8 ", sb_cat2(v, ", 0")));
    return t;
}

// i1 → i8
fn ll_b8(v1: string) -> string {
    var t: string = ll_tmp();
    llfb(sb_cat4("  ", t, " = zext i1 ", sb_cat2(v1, " to i8")));
    return t;
}

// 从 ptr 装载
fn ll_load(ty: string, p: string) -> string {
    var t: string = ll_tmp();
    llfb(sb_cat6("  ", t, " = load ", ty, ", ptr ", p));
    return t;
}

// 聚合复制：src ptr → dst ptr（load/store 按值搬运）
fn ll_copy(ty: string, src: string, dst: string) -> void {
    var t: string = ll_load(ty, src);
    llfb(sb_cat6("  store ", ty, " ", t, ", ptr ", dst));
}

// ── 左值地址 ───────────────────────────────────────────────────

fn ll_addr(e: i64) -> string {
    var n: Node = nodes[e];
    if (n.kind == "paren") {
        return ll_addr(n.na);
    }
    if (n.kind == "ident") {
        if (em_in_fn) {
            var f: i64 = fs_get(em_cur_fn, n.sa);
            if (f >= 0) {
                return sb_cat2("%v.", n.sa);
            }
        }
        var g: i64 = llgv_find(n.sa);
        if (g >= 0) {
            return sb_cat2("@", n.sa);
        }
        return "null";
    }
    if (n.kind == "member") {
        var obd: i64 = ll_etd(n.na);
        var obt: TD = tds[obd];
        var op: string = emit_lle(n.na);
        if (obt.cat == "named") {
            var ti: i64 = llt_find(obt.name);
            if (ti >= 0) {
                if (llt_kinds[ti] == "struct") {
                    var fi: i64 = llsf_find(obt.name, n.sa);
                    if (fi >= 0) {
                        var t: string = ll_tmp();
                        var line: StringBuilder = sb_new();
                        sb_append_str(line, "  ");
                        sb_append_str(line, t);
                        sb_append_str(line, " = getelementptr inbounds %st.");
                        sb_append_str(line, obt.name);
                        sb_append_str(line, ", ptr ");
                        sb_append_str(line, op);
                        sb_append_str(line, ", i32 0, i32 ");
                        sb_append_i64(line, llsf_idx[fi]);
                        llfb(sb_to_str(line));
                        return t;
                    }
                }
                if (llt_kinds[ti] == "union") {
                    return op;    // 所有成员共址 offset 0
                }
            }
        }
        return "null";
    }
    if (n.kind == "index") {
        var od: i64 = ll_etd(n.na);
        var ot: TD = tds[od];
        if (ot.cat == "slice") {
            var sp: string = emit_lle(n.na);
            var iv: string = emit_lle(n.nb);
            var t2: string = ll_tmp();
            llfb(sb_cat6("  ", t2, " = call ptr @tll_slice_at(ptr ", sp, ", i64 ", sb_cat2(iv, ")")));
            return t2;
        }
        if (ot.cat == "array") {
            var ap: string = ll_addr(n.na);
            var av2: string = ll_widen_idx(emit_lle(n.nb), n.nb);
            var t7: string = ll_tmp();
            var gsb: StringBuilder = sb_new();
            sb_append_str(gsb, "  ");
            sb_append_str(gsb, t7);
            sb_append_str(gsb, " = getelementptr ");
            sb_append_str(gsb, ll_td(od));
            sb_append_str(gsb, ", ptr ");
            sb_append_str(gsb, ap);
            sb_append_str(gsb, ", i64 0, i64 ");
            sb_append_str(gsb, av2);
            llfb(sb_to_str(gsb));
            return t7;
        }
        return "null";
    }
    return "null";
}

// ── 表达式发射 ─────────────────────────────────────────────────

fn emit_lle(e: i64) -> string {
    if (e < 0) {
        return "0";
    }
    var n: Node = nodes[e];

    if (n.kind == "int") {
        var r: i64 = n.ia;
        if (r < 2) {
            r = 10;
        }
        return i2s(js_parse_int(n.sa, r));
    }
    if (n.kind == "float") {
        // 确保带小数点（LLVM 浮点常量语法）
        var has_dot: bool = false;
        var i: u64 = 0;
        var L: u64 = str_len(n.sa);
        while (i < L) {
            if (n.sa[i] == 46 || n.sa[i] == 101 || n.sa[i] == 69) {
                has_dot = true;
            }
            i = i + 1;
        }
        if (has_dot) {
            return n.sa;
        }
        return sb_cat2(n.sa, ".0");
    }
    if (n.kind == "string") {
        return ll_strlit(n.sa);
    }
    if (n.kind == "typeinfo") {
        return emit_type_info_ll(n.sa);
    }
    if (n.kind == "bool") {
        if (n.ba) {
            return "1";
        }
        return "0";
    }
    if (n.kind == "null") {
        return "null";
    }
    if (n.kind == "ident") {
        if (em_in_fn) {
            var f: i64 = fs_get(em_cur_fn, n.sa);
            if (f >= 0) {
                if (ll_isagg(f)) {
                    return sb_cat2("%v.", n.sa);
                }
                return ll_load(ll_td(f), sb_cat2("%v.", n.sa));
            }
        }
        var g: i64 = llgv_find(n.sa);
        if (g >= 0) {
            var gtd: i64 = llgv_td[g];
            if (ll_isagg(gtd)) {
                return sb_cat2("@", n.sa);
            }
            return ll_load(ll_td(gtd), sb_cat2("@", n.sa));
        }
        var ci: i64 = llcn_find(n.sa);
        if (ci >= 0) {
            return emit_lle(llcn_e[ci]);
        }
        return "0";
    }
    // map 字面量作为表达式：就地建表并返回 TMap* 临时量
    if (n.kind == "map_lit") {
        var mlqp: string = ll_tmp();
        var mlqi: i64 = infer_expr(e);
        var mlqt: TI = tis[mlqi];
        ll_build_map_lit(e, mlqp, ti_to_td(mlqt.key), ti_to_td(mlqt.val));
        return mlqp;
    }
    if (n.kind == "paren") {
        return emit_lle(n.na);
    }
    if (n.kind == "binary") {
        return ll_binary(e);
    }
    if (n.kind == "unary") {
        return ll_unary(e);
    }
    if (n.kind == "assign") {
        // m[k] = v : map 索引写须走 tll_map_put（find-or-insert）
        if (n.sa == "=") {
            var ln: Node = nodes[n.na];
            if (ln.kind == "index") {
                var lotd: i64 = ll_etd(ln.na);
                var lott: TD = tds[lotd];
                if (lott.cat == "map") {
                    var mp: string = emit_lle(ln.na);
                    var kp: string = ll_map_keyptr(ln.nb, lott.key);
                    var vp: string = ll_map_argptr(n.nb, lott.val);
                    llfb(sb_cat6("  call void @tll_map_put(ptr ", mp, ", ptr ", kp, ", ptr ", sb_cat2(vp, ")")));
                    return "0";
                }
            }
        }
        // Sym = string : 自动 intern（LHS 存 id）；Sym = Sym（同池）走下面普通 id 拷贝
        if (n.sa == "=") {
            var lsymtd: i64 = ll_etd(n.na);
            if (lsymtd >= 0 && tds[lsymtd].cat == "sym") {
                var rsymtd: i64 = ll_etd(n.nb);
                if (rsymtd >= 0 && tds[rsymtd].cat == "string") {
                    var symv: string = emit_lle(n.nb);                    // ptr → RHS TStr
                    var symtag: string = ll_strlit(tds[lsymtd].name);    // ptr → tag TStr
                    var symbits: string = i2s(tds[lsymtd].alen);
                    var symid: string = ll_tmp();
                    llfb(sb_cat6("  ", symid, " = call i32 @tll_sym_intern(ptr ", symtag, ", ptr ", sb_cat3(symv, ", i64 ", sb_cat2(symbits, ")"))));
                    var symsty: string = ll_td(lsymtd);                  // i32 / i16
                    var symstored: string = symid;
                    if (symsty == "i16") {
                        symstored = ll_tmp();
                        llfb(sb_cat4("  ", symstored, " = trunc i32 ", sb_cat2(symid, " to i16")));
                    }
                    var symad: string = ll_addr(n.na);
                    llfb(sb_cat6("  store ", symsty, " ", symstored, ", ptr ", symad));
                    return symstored;
                }
            }
        }
        var v: string = emit_lle(n.nb);
        var ltd: i64 = ll_etd(n.na);
        var ad: string = ll_addr(n.na);
        if (ll_isagg(ltd)) {
            ll_copy(ll_td(ltd), v, ad);
        } else {
            var cv: string = ll_cast_v(v, ll_etd(n.nb), ltd);
            llfb(sb_cat6("  store ", ll_td(ltd), " ", cv, ", ptr ", ad));
        }
        return v;
    }
    if (n.kind == "call") {
        return ll_call(e);
    }
    if (n.kind == "member") {
        var ob: Node = nodes[n.na];
        if (ob.kind == "ident") {
            var ti: i64 = llt_find(ob.sa);
            if (ti >= 0) {
                if (llt_kinds[ti] == "enum") {
                    var ei: i64 = llec_find(ob.sa, n.sa);
                    if (ei >= 0) {
                        return i2s(llec_v[ei]);
                    }
                    return "0";
                }
            }
        }
        var mtd: i64 = ll_etd(e);
        var p: string = ll_addr(e);
        if (ll_isagg(mtd)) {
            return p;
        }
        return ll_load(ll_td(mtd), p);
    }
    if (n.kind == "index") {
        var od: i64 = ll_etd(n.na);
        var ot: TD = tds[od];
        if (ot.cat == "string") {
            var sp: string = emit_lle(n.na);
            var iv: string = emit_lle(n.nb);
            var iv2: string = ll_widen_idx(iv, n.nb);
            var t: string = ll_tmp();
            llfb(sb_cat6("  ", t, " = call i64 @tll_str_at(ptr ", sp, ", i64 ", sb_cat2(iv2, ")")));
            var t2: string = ll_tmp();
            llfb(sb_cat4("  ", t2, " = trunc i64 ", sb_cat2(t, " to i8")));
            return t2;
        }
        if (ot.cat == "slice") {
            var sp2: string = emit_lle(n.na);
            var iv3: string = emit_lle(n.nb);
            var iv4: string = ll_widen_idx(iv3, n.nb);
            var t3: string = ll_tmp();
            llfb(sb_cat6("  ", t3, " = call ptr @tll_slice_at(ptr ", sp2, ", i64 ", sb_cat2(iv4, ")")));
            if (ot.elem >= 0) {
                if (ll_isagg(ot.elem)) {
                    return t3;
                }
                return ll_load(ll_td(ot.elem), t3);
            }
            return ll_load("i64", t3);
        }
        if (ot.cat == "array") {
            var gp2: string = ll_addr(e);
            if (ot.elem >= 0) {
                if (ll_isagg(ot.elem)) {
                    return gp2;
                }
                return ll_load(ll_td(ot.elem), gp2);
            }
            return ll_load("i64", gp2);
        }
        if (ot.cat == "map") {
            return ll_map_get(n.na, n.nb);
        }
        return "0";
    }
    if (n.kind == "struct_lit") {
        var sty: string = sb_cat2("%st.", n.sa);
        var s: string = ll_scratch(sty);
        llfb(sb_cat4("  store ", sty, " zeroinitializer, ptr ", s));
        var c: i64 = n.la;
        while (c >= 0) {
            var k: Child = kids[c];
            var fv: Node = nodes[k.val];
            var fi2: i64 = llsf_find(n.sa, fv.sa);
            if (fi2 >= 0) {
                var fp: string = ll_tmp();
                var line: StringBuilder = sb_new();
                sb_append_str(line, "  ");
                sb_append_str(line, fp);
                sb_append_str(line, " = getelementptr inbounds ");
                sb_append_str(line, sty);
                sb_append_str(line, ", ptr ");
                sb_append_str(line, s);
                sb_append_str(line, ", i32 0, i32 ");
                sb_append_i64(line, llsf_idx[fi2]);
                llfb(sb_to_str(line));
                var ftd: i64 = llsf_td[fi2];
                var fvv: string = emit_lle(fv.na);
                if (ll_isagg(ftd)) {
                    ll_copy(ll_td(ftd), fvv, fp);
                } else {
                    var cv2: string = ll_cast_v(fvv, ll_etd(fv.na), ftd);
                    llfb(sb_cat6("  store ", ll_td(ftd), " ", cv2, ", ptr ", fp));
                }
            }
            c = k.next;
        }
        return s;
    }
    if (n.kind == "cast") {
        var v2: string = emit_lle(n.na);
        var ttd: i64 = resolve_type_desc(n.nb);
        return ll_cast_v(v2, ll_etd(n.na), ttd);
    }
    llfb("  ; UNSUPPORTED expr");
    return "0";
}

// 索引值统一拓宽为 i64（str_at/slice_at 的下标参数）
fn ll_widen_idx(v: string, e: i64) -> string {
    var td: i64 = ll_etd(e);
    var i64td: i64 = td_named_mk("scalar", "i64");
    return ll_cast_v(v, td, i64td);
}

// ── 二元 / 一元 ────────────────────────────────────────────────

fn ll_binary(e: i64) -> string {
    var n: Node = nodes[e];
    var op: string = n.sa;

    if (op == "&&" || op == "||") {
        var lv: string = emit_lle(n.na);
        var l1: string = ll_to_i1(lv);
        var lend: string = ll_cur_blk;
        var rhsL: string = ll_lbl("sc.r");
        var mrgL: string = ll_lbl("sc.m");
        if (op == "&&") {
            llfb(sb_cat6("  br i1 ", l1, ", label %", rhsL, ", label %", mrgL));
        } else {
            llfb(sb_cat6("  br i1 ", l1, ", label %", mrgL, ", label %", rhsL));
        }
        ll_label(rhsL);
        var rv: string = emit_lle(n.nb);
        var r1: string = ll_to_i1(rv);
        var rend: string = ll_cur_blk;
        llfb(sb_cat3("  br label %", mrgL, ""));
        ll_label(mrgL);
        var sc_const: string = "false";
        if (op == "||") {
            sc_const = "true";
        }
        var t: string = ll_tmp();
        llfb(sb_cat6("  ", t, " = phi i1 [ ", sc_const, ", %", sb_cat6(lend, " ], [ ", r1, ", %", rend, " ]")));
        return ll_b8(t);
    }

    // 字符串相等
    if (op == "==" || op == "!=") {
        var lt: i64 = ll_etd(n.na);
        var rt: i64 = ll_etd(n.nb);
        var ltc: TD = tds[lt];
        var rtc: TD = tds[rt];
        if (ltc.cat == "string" || rtc.cat == "string") {
            var lp: string = emit_lle(n.na);
            var rp: string = emit_lle(n.nb);
            var t0: string = ll_tmp();
            llfb(sb_cat6("  ", t0, " = call i32 @tll_str_eq(ptr ", lp, ", ptr ", sb_cat2(rp, ")")));
            var t1: string = ll_tmp();
            if (op == "==") {
                llfb(sb_cat4("  ", t1, " = icmp ne i32 ", sb_cat2(t0, ", 0")));
            } else {
                llfb(sb_cat4("  ", t1, " = icmp eq i32 ", sb_cat2(t0, ", 0")));
            }
            return ll_b8(t1);
        }
    }

    var utd: i64 = ll_bin_td(e);
    var sn: string = td_sname(utd);
    if (sn == "") {
        sn = "i64";
    }
    var ty: string = scalar_to_ll(sn);
    var isf: bool = ll_isf(sn);
    var sg: bool = ll_signed(sn);
    var a: string = emit_lle(n.na);
    a = ll_cast_v(a, ll_etd(n.na), utd);
    var b: string = emit_lle(n.nb);
    b = ll_cast_v(b, ll_etd(n.nb), utd);

    if (op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=") {
        var cc: string = "";
        if (isf) {
            if (op == "==") { cc = "oeq"; }
            if (op == "!=") { cc = "one"; }
            if (op == "<") { cc = "olt"; }
            if (op == ">") { cc = "ogt"; }
            if (op == "<=") { cc = "ole"; }
            if (op == ">=") { cc = "oge"; }
            var tf: string = ll_tmp();
            llfb(sb_cat6("  ", tf, " = fcmp ", cc, " ", sb_cat6(ty, " ", a, ", ", b, "")));
            return ll_b8(tf);
        }
        if (op == "==") { cc = "eq"; }
        if (op == "!=") { cc = "ne"; }
        if (sg) {
            if (op == "<") { cc = "slt"; }
            if (op == ">") { cc = "sgt"; }
            if (op == "<=") { cc = "sle"; }
            if (op == ">=") { cc = "sge"; }
        } else {
            if (op == "<") { cc = "ult"; }
            if (op == ">") { cc = "ugt"; }
            if (op == "<=") { cc = "ule"; }
            if (op == ">=") { cc = "uge"; }
        }
        var ti2: string = ll_tmp();
        llfb(sb_cat6("  ", ti2, " = icmp ", cc, " ", sb_cat6(ty, " ", a, ", ", b, "")));
        return ll_b8(ti2);
    }

    var ins: string = "";
    if (isf) {
        if (op == "+") { ins = "fadd"; }
        if (op == "-") { ins = "fsub"; }
        if (op == "*") { ins = "fmul"; }
        if (op == "/") { ins = "fdiv"; }
        if (op == "%") { ins = "frem"; }
    } else {
        if (op == "+") { ins = "add"; }
        if (op == "-") { ins = "sub"; }
        if (op == "*") { ins = "mul"; }
        if (op == "/") {
            ins = "udiv";
            if (sg) {
                ins = "sdiv";
            }
        }
        if (op == "%") {
            ins = "urem";
            if (sg) {
                ins = "srem";
            }
        }
        if (op == "<<") { ins = "shl"; }
        if (op == ">>") {
            ins = "lshr";
            if (sg) {
                ins = "ashr";
            }
        }
        if (op == "&") { ins = "and"; }
        if (op == "|") { ins = "or"; }
        if (op == "^") { ins = "xor"; }
    }
    if (ins == "") {
        llfb("  ; UNSUPPORTED binop");
        return "0";
    }
    var t3: string = ll_tmp();
    llfb(sb_cat6("  ", t3, " = ", ins, " ", sb_cat6(ty, " ", a, ", ", b, "")));
    return t3;
}

fn ll_unary(e: i64) -> string {
    var n: Node = nodes[e];
    var op: string = n.sa;
    if (op == "!") {
        var v: string = emit_lle(n.na);
        var t: string = ll_tmp();
        llfb(sb_cat4("  ", t, " = icmp eq i8 ", sb_cat2(v, ", 0")));
        return ll_b8(t);
    }
    var otd: i64 = ll_etd(n.na);
    var sn: string = td_sname(otd);
    if (sn == "") {
        sn = "i64";
    }
    var ty: string = scalar_to_ll(sn);
    var v2: string = emit_lle(n.na);
    if (op == "-") {
        if (str_len(v2) > 0) {
            if (v2[0] != 37) {
                return sb_cat2("-", v2);    // 常量折叠
            }
        }
        if (ll_isf(sn)) {
            var tf: string = ll_tmp();
            llfb(sb_cat6("  ", tf, " = fneg ", ty, " ", v2));
            return tf;
        }
        var t2: string = ll_tmp();
        llfb(sb_cat6("  ", t2, " = sub ", ty, " 0, ", v2));
        return t2;
    }
    if (op == "~") {
        var t3: string = ll_tmp();
        llfb(sb_cat6("  ", t3, " = xor ", ty, " ", sb_cat2(v2, ", -1")));
        return t3;
    }
    return v2;
}

// ── 尺寸计算（union/variant 载荷字节数，保守 8 字节对齐上估）──

fn ll_round8(v: i64) -> i64 {
    return ((v + 7) / 8) * 8;
}

fn ll_size_bytes(td: i64) -> i64 {
    if (td < 0) {
        return 8;
    }
    var t: TD = tds[td];
    if (t.cat == "scalar") {
        if (t.name == "") {
            return 8;
        }
        return ll_bits(t.name) / 8;
    }
    if (t.cat == "string") {
        return 16;
    }
    if (t.cat == "slice") {
        return 32;
    }
    if (t.cat == "map") {
        return 8;
    }
    if (t.cat == "named") {
        if (t.name == "TSb*") {
            return 8;
        }
        var i: i64 = llt_find(t.name);
        if (i < 0) {
            return 8;
        }
        var k: string = llt_kinds[i];
        if (k == "enum" || k == "flag") {
            return ll_bits(llt_unders[i]) / 8;
        }
        if (k == "alias") {
            return ll_size_bytes(llt_atd[i]);
        }
        if (k == "struct") {
            var sum: i64 = 0;
            var n: i64 = slice_len(llsf_st) as i64;
            var j: i64 = 0;
            while (j < n) {
                if (llsf_st[j] == t.name) {
                    sum = sum + ll_round8(ll_size_bytes(llsf_td[j]));
                }
                j = j + 1;
            }
            if (sum == 0) {
                sum = 8;
            }
            return sum;
        }
        if (k == "variant") {
            return 8 + ll_variant_paymax(t.name);
        }
        if (k == "union") {
            return ll_union_max(t.name);
        }
    }
    return 8;
}

fn ll_variant_paymax(name: string) -> i64 {
    var mx: i64 = 8;
    var n: i64 = slice_len(llv_v) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (llv_v[i] == name && llv_ptd[i] >= 0) {
            var s: i64 = ll_round8(ll_size_bytes(llv_ptd[i]));
            if (s > mx) {
                mx = s;
            }
        }
        i = i + 1;
    }
    return mx;
}

fn ll_union_max(name: string) -> i64 {
    var mx: i64 = 8;
    var n: i64 = slice_len(llu_u) as i64;
    var i: i64 = 0;
    while (i < n) {
        if (llu_u[i] == name) {
            var s: i64 = ll_round8(ll_size_bytes(llu_td[i]));
            if (s > mx) {
                mx = s;
            }
        }
        i = i + 1;
    }
    return mx;
}

// iN 类型的常量文本：超出有符号范围时按补码回绕成负十进制
fn ll_iconst(v: i64, bits: i64) -> string {
    if (bits == 8) {
        if (v > 127) {
            return i2s(v - 256);
        }
    }
    if (bits == 16) {
        if (v > 32767) {
            return i2s(v - 65536);
        }
    }
    if (bits == 32) {
        if (v > 2147483647) {
            return i2s(v - 4294967296);
        }
    }
    return i2s(v);
}

// 复合赋值/二元共用的算术指令名
fn ll_arith_ins(op: string, sn: string) -> string {
    var isf: bool = ll_isf(sn);
    var sg: bool = ll_signed(sn);
    if (isf) {
        if (op == "+") { return "fadd"; }
        if (op == "-") { return "fsub"; }
        if (op == "*") { return "fmul"; }
        if (op == "/") { return "fdiv"; }
        if (op == "%") { return "frem"; }
        return "";
    }
    if (op == "+") { return "add"; }
    if (op == "-") { return "sub"; }
    if (op == "*") { return "mul"; }
    if (op == "/") {
        if (sg) {
            return "sdiv";
        }
        return "udiv";
    }
    if (op == "%") {
        if (sg) {
            return "srem";
        }
        return "urem";
    }
    if (op == "<<") { return "shl"; }
    if (op == ">>") {
        if (sg) {
            return "ashr";
        }
        return "lshr";
    }
    if (op == "&") { return "and"; }
    if (op == "|") { return "or"; }
    if (op == "^") { return "xor"; }
    return "";
}

// ── 调用发射 ───────────────────────────────────────────────────

// map 读索引助手（LLVM）：tll_map_val_ptr 返回存储值字节指针，按 V 类型 load。
// map 操作数取指针助手（LLVM）：按 map 声明的 K/V 类型落盘，
// 标量 alloca+store（必要时先转宽），聚合直接取地址。want<0 表示沿用实参自身类型。
// map 键取指针（LLVM 后端）：整型键统一按 i64 存储——runtime 按 int64_t 读键，
// 直接存 i32/u8 会让高位字节是垃圾。string 键是 TStr 聚合，走原路径。
fn ll_map_keyptr(kn: i64, keytd: i64) -> string {
    if (keytd >= 0 && ll_isagg(keytd)) {
        return ll_map_argptr(kn, keytd);
    }
    return ll_map_argptr(kn, td_named_mk("scalar", "i64"));
}

fn ll_map_argptr(an: i64, want: i64) -> string {
    var atd: i64 = ll_etd(an);
    var used: i64 = atd;
    if (want >= 0) {
        used = want;
    }
    if (ll_isagg(used)) {
        return emit_lle(an);
    }
    var aty: string = ll_td(used);
    var av: string = emit_lle(an);
    av = ll_cast_v(av, atd, used);
    var asc: string = ll_scratch(aty);
    llfb(sb_cat6("  store ", aty, " ", av, ", ptr ", asc));
    return asc;
}

fn ll_map_get(mn: i64, kn: i64) -> string {
    var mtd: i64 = ll_etd(mn);
    var mt: TD = tds[mtd];
    var valtd: i64 = mt.val;
    var valty: string = ll_td(valtd);
    var mp: string = emit_lle(mn);
    var kp: string = ll_map_keyptr(kn, mt.key);
    var addr: string = ll_tmp();
    llfb(sb_cat6("  ", addr, " = call ptr @tll_map_val_ptr(ptr ", mp, ", ptr ", sb_cat2(kp, ")")));
    if (ll_isagg(valtd)) {
        return addr;
    }
    var out: string = ll_tmp();
    llfb(sb_cat6("  ", out, " = load ", valty, ", ptr ", addr));
    return out;
}

fn ll_call(e: i64) -> string {
    var n: Node = nodes[e];
    var cal: Node = nodes[n.na];
    if (cal.kind != "ident") {
        llfb("  ; UNSUPPORTED call target");
        return "0";
    }
    var cn: string = cal.sa;
    var ae: []i64;
    var c: i64 = n.la;
    while (c >= 0) {
        var k: Child = kids[c];
        append(ae, k.val);
        c = k.next;
    }
    var argc: i64 = slice_len(ae) as i64;
    var td_i64: i64 = td_named_mk("scalar", "i64");
    var td_i32: i64 = td_named_mk("scalar", "i32");

    if (cn == "print" || cn == "eprint" || cn == "println") {
        var p: string = emit_lle(ae[0]);
        var fnm: string = "@tll_print";
        if (cn == "eprint") {
            fnm = "@tll_eprint";
        }
        if (cn == "println") {
            fnm = "@tll_println";
        }
        llfb(sb_cat4("  call void ", fnm, "(ptr ", sb_cat2(p, ")")));
        return "0";
    }
    if (cn == "str_len" || cn == "slice_len") {
        var p2: string = emit_lle(ae[0]);
        var fn2: string = "@tll_str_len";
        if (cn == "slice_len") {
            fn2 = "@tll_slice_len";
        }
        var t0: string = ll_tmp();
        llfb(sb_cat6("  ", t0, " = call i64 ", fn2, "(ptr ", sb_cat2(p2, ")")));
        return t0;
    }
    if (cn == "str_at") {
        var sp: string = emit_lle(ae[0]);
        var iv: string = emit_lle(ae[1]);
        iv = ll_cast_v(iv, ll_etd(ae[1]), td_i64);
        var t1: string = ll_tmp();
        llfb(sb_cat6("  ", t1, " = call i64 @tll_str_at(ptr ", sp, ", i64 ", sb_cat2(iv, ")")));
        var t2: string = ll_tmp();
        llfb(sb_cat4("  ", t2, " = trunc i64 ", sb_cat2(t1, " to i8")));
        return t2;
    }
    if (cn == "str_slice") {
        var sp2: string = emit_lle(ae[0]);
        var a1: string = emit_lle(ae[1]);
        a1 = ll_cast_v(a1, ll_etd(ae[1]), td_i64);
        var b1: string = emit_lle(ae[2]);
        b1 = ll_cast_v(b1, ll_etd(ae[2]), td_i64);
        var out0: string = ll_scratch("%TStr");
        var lsb: StringBuilder = sb_new();
        sb_append_str(lsb, "  call void @tll_str_slice(ptr ");
        sb_append_str(lsb, sp2);
        sb_append_str(lsb, ", i64 ");
        sb_append_str(lsb, a1);
        sb_append_str(lsb, ", i64 ");
        sb_append_str(lsb, b1);
        sb_append_str(lsb, ", ptr ");
        sb_append_str(lsb, out0);
        sb_append_str(lsb, ")");
        llfb(sb_to_str(lsb));
        return out0;
    }
    if (cn == "append") {
        var std: i64 = ll_etd(ae[0]);
        var st: TD = tds[std];
        var ety: string = "i64";
        var etd: i64 = -1;
        if (st.cat == "slice") {
            etd = st.elem;
        }
        if (etd >= 0) {
            ety = ll_td(etd);
        }
        var sp3: string = emit_lle(ae[0]);
        var ep: string = "";
        var isagg: bool = false;
        if (etd >= 0) {
            isagg = ll_isagg(etd);
        }
        if (isagg) {
            ep = emit_lle(ae[1]);
        } else {
            var v0: string = emit_lle(ae[1]);
            if (etd >= 0) {
                v0 = ll_cast_v(v0, ll_etd(ae[1]), etd);
            }
            var sc0: string = ll_scratch(ety);
            llfb(sb_cat6("  store ", ety, " ", v0, ", ptr ", sc0));
            ep = sc0;
        }
        var asb: StringBuilder = sb_new();
        sb_append_str(asb, "  call void @tll_slice_append(ptr ");
        sb_append_str(asb, sp3);
        sb_append_str(asb, ", ptr ");
        sb_append_str(asb, ep);
        sb_append_str(asb, ", i64 ");
        sb_append_str(asb, ll_sizeof(ety));
        sb_append_str(asb, ")");
        llfb(sb_to_str(asb));
        return "0";
    }
    if (cn == "slice_set") {
        var std2: i64 = ll_etd(ae[0]);
        var st2: TD = tds[std2];
        var etd2: i64 = -1;
        if (st2.cat == "slice") {
            etd2 = st2.elem;
        }
        var ety2: string = "i64";
        if (etd2 >= 0) {
            ety2 = ll_td(etd2);
        }
        var sp4: string = emit_lle(ae[0]);
        var iv2: string = emit_lle(ae[1]);
        iv2 = ll_cast_v(iv2, ll_etd(ae[1]), td_i64);
        var ep2: string = "";
        var isagg2: bool = false;
        if (etd2 >= 0) {
            isagg2 = ll_isagg(etd2);
        }
        if (isagg2) {
            ep2 = emit_lle(ae[2]);
        } else {
            var v1: string = emit_lle(ae[2]);
            if (etd2 >= 0) {
                v1 = ll_cast_v(v1, ll_etd(ae[2]), etd2);
            }
            var sc1: string = ll_scratch(ety2);
            llfb(sb_cat6("  store ", ety2, " ", v1, ", ptr ", sc1));
            ep2 = sc1;
        }
        var ssb: StringBuilder = sb_new();
        sb_append_str(ssb, "  call void @tll_slice_set(ptr ");
        sb_append_str(ssb, sp4);
        sb_append_str(ssb, ", i64 ");
        sb_append_str(ssb, iv2);
        sb_append_str(ssb, ", ptr ");
        sb_append_str(ssb, ep2);
        sb_append_str(ssb, ")");
        llfb(sb_to_str(ssb));
        return "0";
    }
    if (cn == "file_read_all" || cn == "path_resolve") {
        var pp0: string = emit_lle(ae[0]);
        var fn3: string = "@tll_file_read_all";
        if (cn == "path_resolve") {
            fn3 = "@tll_path_resolve";
        }
        var out1: string = ll_scratch("%TStr");
        llfb(sb_cat6("  call void ", fn3, "(ptr ", pp0, ", ptr ", sb_cat2(out1, ")")));
        return out1;
    }
    // type_info accessor 内建（M36）
    if (cn == "ti_name" || cn == "fi_name" || cn == "fi_type_name") {
        var p: string = emit_lle(ae[0]);
        var out: string = ll_scratch("%TStr");
        llfb(sb_cat6("  call void @tll_", cn, "(ptr ", p, ", ptr ", sb_cat2(out, ")")));
        return out;
    }
    if (cn == "ti_size" || cn == "ti_kind" || cn == "ti_field_count" || cn == "fi_offset" || cn == "fi_type_size") {
        var p: string = emit_lle(ae[0]);
        var out: string = ll_tmp();
        llfb(sb_cat6("  ", out, " = call i64 @tll_", cn, "(ptr ", sb_cat2(p, ")")));
        return out;
    }
    if (cn == "ti_field") {
        var p: string = emit_lle(ae[0]);
        var iv: string = emit_lle(ae[1]);
        iv = ll_cast_v(iv, ll_etd(ae[1]), td_i64);
        var out: string = ll_tmp();
        llfb(sb_cat6("  ", out, " = call ptr @tll_ti_field(ptr ", p, ", i64 ", sb_cat2(iv, ")")));
        return out;
    }
    if (cn == "fi_is_ptr") {
        var p: string = emit_lle(ae[0]);
        var out: string = ll_tmp();
        // bool 在 LLVM 后端一律 i8（与 file_write_all 等一致），不能用 i1
        llfb(sb_cat4("  ", out, " = call i8 @tll_fi_is_ptr(ptr ", sb_cat2(p, ")")));
        return out;
    }
    if (cn == "file_write_all") {
        var pa: string = emit_lle(ae[0]);
        var pb: string = emit_lle(ae[1]);
        var t3: string = ll_tmp();
        llfb(sb_cat6("  ", t3, " = call i32 @tll_file_write_all(ptr ", pa, ", ptr ", sb_cat2(pb, ")")));
        var t4: string = ll_tmp();
        llfb(sb_cat4("  ", t4, " = trunc i32 ", sb_cat2(t3, " to i8")));
        return t4;
    }
    if (cn == "file_exists") {
        var pfe: string = emit_lle(ae[0]);
        var t5: string = ll_tmp();
        llfb(sb_cat4("  ", t5, " = call i32 @tll_file_exists(ptr ", sb_cat2(pfe, ")")));
        var t6: string = ll_tmp();
        llfb(sb_cat4("  ", t6, " = trunc i32 ", sb_cat2(t5, " to i8")));
        return t6;
    }
    if (cn == "args") {
        var out2: string = ll_scratch("%TSlice");
        llfb(sb_cat3("  call void @tll_args(ptr ", out2, ")"));
        return out2;
    }
    if (cn == "exit") {
        var cv: string = emit_lle(ae[0]);
        cv = ll_cast_v(cv, ll_etd(ae[0]), td_i32);
        llfb(sb_cat3("  call void @tll_exit(i32 ", cv, ")"));
        return "0";
    }
    if (cn == "sys_run") {
        var cp: string = emit_lle(ae[0]);
        var t5: string = ll_tmp();
        llfb(sb_cat4("  ", t5, " = call i32 @tll_system(ptr ", sb_cat2(cp, ")")));
        return t5;
    }
    if (cn == "sb_new") {
        var t6: string = ll_tmp();
        llfb(sb_cat3("  ", t6, " = call ptr @tll_sb_new()"));
        return t6;
    }
    if (cn == "sb_append_str") {
        var bp: string = emit_lle(ae[0]);
        var sv: string = emit_lle(ae[1]);
        llfb(sb_cat6("  call void @tll_sb_append_str(ptr ", bp, ", ptr ", sv, ")", ""));
        return "0";
    }
    if (cn == "sb_append_char" || cn == "sb_append_u64" || cn == "sb_append_i64") {
        var bp2: string = emit_lle(ae[0]);
        var cv2: string = emit_lle(ae[1]);
        cv2 = ll_cast_v(cv2, ll_etd(ae[1]), td_i64);
        var fn4: string = "@tll_sb_append_char";
        if (cn == "sb_append_u64") {
            fn4 = "@tll_sb_append_u64";
        }
        if (cn == "sb_append_i64") {
            fn4 = "@tll_sb_append_i64";
        }
        llfb(sb_cat6("  call void ", fn4, "(ptr ", bp2, ", i64 ", sb_cat2(cv2, ")")));
        return "0";
    }
    if (cn == "sb_to_str") {
        var bp3: string = emit_lle(ae[0]);
        var out3: string = ll_scratch("%TStr");
        llfb(sb_cat6("  call void @tll_sb_to_str(ptr ", bp3, ", ptr ", out3, ")", ""));
        return out3;
    }
    if (cn == "sb_clear") {
        var bp4: string = emit_lle(ae[0]);
        llfb(sb_cat3("  call void @tll_sb_clear(ptr ", bp4, ")"));
        return "0";
    }
    if (cn == "int_to_str") {
        var iv5: string = emit_lle(ae[0]);
        iv5 = ll_cast_v(iv5, ll_etd(ae[0]), td_i64);
        var out5: string = ll_scratch("%TStr");
        llfb(sb_cat6("  call void @tll_int_to_str(i64 ", iv5, ", ptr ", out5, ")", ""));
        return out5;
    }
    if (cn == "map_new") {
        var mtd2: i64 = ll_etd(ae[0]);
        var mt2: TD = tds[mtd2];
        var kk2: i64 = 0;
        if (tds[mt2.key].cat != "string") { kk2 = 1; }
        var vs2: string = ll_sizeof(ll_td(mt2.val));
        var tnew: string = ll_tmp();
        llfb(sb_cat6("  ", tnew, " = call ptr @tll_map_new(i64 ", i2s(kk2), ", i64 ", sb_cat2(vs2, ")")));
        return tnew;
    }
    if (cn == "map_get") {
        return ll_map_get(ae[0], ae[1]);
    }
    if (cn == "map_set") {
        var mtd3: i64 = ll_etd(ae[0]);
        var mt3: TD = tds[mtd3];
        var mp3: string = emit_lle(ae[0]);
        var kp3: string = ll_map_keyptr(ae[1], mt3.key);
        var vp3: string = ll_map_argptr(ae[2], mt3.val);
        llfb(sb_cat6("  call void @tll_map_put(ptr ", mp3, ", ptr ", kp3, ", ptr ", sb_cat2(vp3, ")")));
        return "0";
    }
    if (cn == "map_has") {
        var mtd4: i64 = ll_etd(ae[0]);
        var mt4: TD = tds[mtd4];
        var mp4: string = emit_lle(ae[0]);
        var kp4: string = ll_map_keyptr(ae[1], mt4.key);
        var t4: string = ll_tmp();
        llfb(sb_cat6("  ", t4, " = call i32 @tll_map_has(ptr ", mp4, ", ptr ", sb_cat2(kp4, ")")));
        var t4b: string = ll_tmp();
        llfb(sb_cat4("  ", t4b, " = trunc i32 ", sb_cat2(t4, " to i8")));
        return t4b;
    }
    if (cn == "map_len") {
        var mp5: string = emit_lle(ae[0]);
        var t5: string = ll_tmp();
        llfb(sb_cat6("  ", t5, " = call i64 @tll_map_len(ptr ", mp5, ")", ""));
        return t5;
    }
    if (cn == "map_del") {
        var mtd6: i64 = ll_etd(ae[0]);
        var mt6: TD = tds[mtd6];
        var mp6: string = emit_lle(ae[0]);
        var kp6: string = ll_map_keyptr(ae[1], mt6.key);
        var t6: string = ll_tmp();
        llfb(sb_cat6("  ", t6, " = call i32 @tll_map_del(ptr ", mp6, ", ptr ", sb_cat2(kp6, ")")));
        var t6b: string = ll_tmp();
        llfb(sb_cat4("  ", t6b, " = trunc i32 ", sb_cat2(t6, " to i8")));
        return t6b;
    }
    // Sym：sym_str(v) 由变量 Sym 类型推出 tag；id 归一到 i32（Sym16 需 zext）
    if (cn == "sym_str") {
        var sstd: i64 = ll_etd(ae[0]);
        var sstag: string = "";
        if (sstd >= 0 && tds[sstd].cat == "sym") { sstag = tds[sstd].name; }
        var sstagp: string = ll_strlit(sstag);
        var ssid: string = emit_lle(ae[0]);
        if (ll_td(sstd) == "i16") {
            var ssz: string = ll_tmp();
            llfb(sb_cat4("  ", ssz, " = zext i16 ", sb_cat2(ssid, " to i32")));
            ssid = ssz;
        }
        var ssout: string = ll_scratch("%TStr");
        llfb(sb_cat6("  call void @tll_sym_str(ptr ", sstagp, ", i32 ", ssid, ", ptr ", sb_cat2(ssout, ")")));
        return ssout;
    }
    if (cn == "sym_release") {
        var srp: string = emit_lle(ae[0]);
        llfb(sb_cat3("  call void @tll_sym_release(ptr ", srp, ")"));
        return "0";
    }
    if (cn == "sym_release_all") {
        llfb("  call void @tll_sym_release_all()");
        return "0";
    }
    if (cn == "flag_get" || cn == "flag_set") {
        var mn: Node = nodes[ae[1]];
        var slot: i64 = -1;
        if (mn.kind == "member") {
            var ob: Node = nodes[mn.na];
            if (ob.kind == "ident") {
                slot = llfl_find(ob.sa, mn.sa);
            }
        }
        if (slot < 0) {
            llfb("  ; UNSUPPORTED flag slot");
            return "0";
        }
        var ftd: i64 = ll_etd(ae[0]);
        var un: string = td_sname(ftd);
        if (un == "") {
            un = "u32";
        }
        var fty: string = scalar_to_ll(un);
        var bits: i64 = ll_bits(un);
        var start: i64 = llfl_start[slot];
        var mval: i64 = js_max_val(llfl_len[slot]);
        var m: i64 = mval * pow2_i64(start);
        if (cn == "flag_get") {
            var fv: string = emit_lle(ae[0]);
            var g1: string = ll_tmp();
            llfb(sb_cat6("  ", g1, " = lshr ", fty, " ", sb_cat4(fv, ", ", i2s(start), "")));
            var g2: string = ll_tmp();
            llfb(sb_cat6("  ", g2, " = and ", fty, " ", sb_cat4(g1, ", ", ll_iconst(mval, bits), "")));
            var utd: i64 = td_named_mk("scalar", un);
            var u32td: i64 = td_named_mk("scalar", "u32");
            return ll_cast_v(g2, utd, u32td);
        }
        var ad0: string = ll_addr(ae[0]);
        var old: string = ll_load(fty, ad0);
        var notm: i64 = 0 - m - 1;
        var s1: string = ll_tmp();
        llfb(sb_cat6("  ", s1, " = and ", fty, " ", sb_cat4(old, ", ", i2s(notm), "")));
        var xv: string = emit_lle(ae[2]);
        var utd2: i64 = td_named_mk("scalar", un);
        xv = ll_cast_v(xv, ll_etd(ae[2]), utd2);
        var s2: string = ll_tmp();
        llfb(sb_cat6("  ", s2, " = shl ", fty, " ", sb_cat4(xv, ", ", i2s(start), "")));
        var s3: string = ll_tmp();
        llfb(sb_cat6("  ", s3, " = and ", fty, " ", sb_cat4(s2, ", ", ll_iconst(m, bits), "")));
        var s4: string = ll_tmp();
        llfb(sb_cat6("  ", s4, " = or ", fty, " ", sb_cat4(s1, ", ", s3, "")));
        llfb(sb_cat6("  store ", fty, " ", s4, ", ptr ", ad0));
        return "0";
    }
    if (cn == "assert_eq" || cn == "assert_true" || cn == "assert_false" || cn == "assert_panic") {
        llfb("  ; assert (test-only, no-op in llvm backend)");
        return "0";
    }
    if (llv_match(cn)) {
        var vi: i64 = ll_vm_i;
        var vty: string = sb_cat2("%vt.", llv_v[vi]);
        if (ll_vm_kind == "from") {
            var scv: string = ll_scratch(vty);
            llfb(sb_cat4("  store ", vty, " zeroinitializer, ptr ", scv));
            var tp: string = ll_tmp();
            llfb(sb_cat6("  ", tp, " = getelementptr inbounds ", vty, ", ptr ", sb_cat2(scv, ", i32 0, i32 0")));
            llfb(sb_cat6("  store i64 ", i2s(llv_tag[vi]), ", ptr ", tp, "", ""));
            if (llv_ptd[vi] >= 0 && argc > 0) {
                var ppp: string = ll_tmp();
                llfb(sb_cat6("  ", ppp, " = getelementptr inbounds ", vty, ", ptr ", sb_cat2(scv, ", i32 0, i32 1")));
                var ptd: i64 = llv_ptd[vi];
                var pty: string = ll_td(ptd);
                if (ll_isagg(ptd)) {
                    var pv: string = emit_lle(ae[0]);
                    ll_copy(pty, pv, ppp);
                } else {
                    var pv2: string = emit_lle(ae[0]);
                    pv2 = ll_cast_v(pv2, ll_etd(ae[0]), ptd);
                    llfb(sb_cat6("  store ", pty, " ", pv2, ", ptr ", ppp));
                }
            }
            return scv;
        }
        var vp: string = emit_lle(ae[0]);
        if (ll_vm_kind == "is") {
            var tp2: string = ll_tmp();
            llfb(sb_cat6("  ", tp2, " = getelementptr inbounds ", vty, ", ptr ", sb_cat2(vp, ", i32 0, i32 0")));
            var tv: string = ll_load("i64", tp2);
            var ic: string = ll_tmp();
            llfb(sb_cat6("  ", ic, " = icmp eq i64 ", tv, ", ", i2s(llv_tag[vi])));
            return ll_b8(ic);
        }
        var pp2: string = ll_tmp();
        llfb(sb_cat6("  ", pp2, " = getelementptr inbounds ", vty, ", ptr ", sb_cat2(vp, ", i32 0, i32 1")));
        var ptd2: i64 = llv_ptd[vi];
        if (ptd2 >= 0) {
            if (ll_isagg(ptd2)) {
                return pp2;
            }
            return ll_load(ll_td(ptd2), pp2);
        }
        return "0";
    }
    // 用户函数：模块内按值传递聚合
    var fi: i64 = llfn_find(cn);
    if (fi >= 0) {
        var rtd: i64 = llfn_r[fi];
        var ps: i64 = llfn_ps[fi];
        var pc: i64 = llfn_pc[fi];
        var csb: StringBuilder = sb_new();
        var i: i64 = 0;
        while (i < argc) {
            if (i > 0) {
                sb_append_str(csb, ", ");
            }
            var ptd3: i64 = -1;
            if (i < pc) {
                ptd3 = llfp_td[ps + i];
            }
            var aty: string = ll_td(ptd3);
            var avv: string = emit_lle(ae[i]);
            if (ptd3 >= 0 && ll_isagg(ptd3)) {
                avv = ll_load(aty, avv);
            } else {
                avv = ll_cast_v(avv, ll_etd(ae[i]), ptd3);
            }
            sb_append_str(csb, aty);
            sb_append_str(csb, " ");
            sb_append_str(csb, avv);
            i = i + 1;
        }
        var rty: string = ll_td(rtd);
        var argstr: string = sb_to_str(csb);
        if (rty == "void") {
            llfb(sb_cat6("  call void @t.", cn, "(", argstr, ")", ""));
            return "0";
        }
        var t7: string = ll_tmp();
        var line: StringBuilder = sb_new();
        sb_append_str(line, "  ");
        sb_append_str(line, t7);
        sb_append_str(line, " = call ");
        sb_append_str(line, rty);
        sb_append_str(line, " @t.");
        sb_append_str(line, cn);
        sb_append_str(line, "(");
        sb_append_str(line, argstr);
        sb_append_str(line, ")");
        llfb(sb_to_str(line));
        if (ll_isagg(rtd)) {
            var sc2: string = ll_scratch(rty);
            llfb(sb_cat6("  store ", rty, " ", t7, ", ptr ", sc2));
            return sc2;
        }
        return t7;
    }
    llfb(sb_cat2("  ; UNSUPPORTED call ", cn));
    return "0";
}

// 2^n（flag 掩码用；n < 63）
fn pow2_i64(n: i64) -> i64 {
    var r: i64 = 1;
    var i: i64 = 0;
    while (i < n) {
        r = r * 2;
        i = i + 1;
    }
    return r;
}

// ── 循环目标栈（brk/cnt 成对维护）──────────────────────────────

fn ll_loop_push2(brk: string, cnt: string) -> void {
    if (ll_loopd < slice_len(llbrk) as i64) {
        slice_set(llbrk, ll_loopd, brk);
        slice_set(llcnt, ll_loopd, cnt);
    } else {
        append(llbrk, brk);
        append(llcnt, cnt);
    }
    ll_loopd = ll_loopd + 1;
}

fn ll_loop_pop() -> void {
    ll_loopd = ll_loopd - 1;
}

// switch case 常量（按位宽回绕）
fn ll_case_const(e: i64, bits: i64) -> string {
    var n: Node = nodes[e];
    if (n.kind == "int") {
        var r: i64 = n.ia;
        if (r < 2) {
            r = 10;
        }
        return ll_iconst(js_parse_int(n.sa, r), bits);
    }
    if (n.kind == "member") {
        var ob: Node = nodes[n.na];
        if (ob.kind == "ident") {
            var ei: i64 = llec_find(ob.sa, n.sa);
            if (ei >= 0) {
                return ll_iconst(llec_v[ei], bits);
            }
        }
    }
    if (n.kind == "unary") {
        if (n.sa == "-") {
            var inn: Node = nodes[n.na];
            if (inn.kind == "int") {
                var r2: i64 = inn.ia;
                if (r2 < 2) {
                    r2 = 10;
                }
                return i2s(0 - js_parse_int(inn.sa, r2));
            }
        }
    }
    return emit_lle(e);
}

// ── 局部变量声明（alloca 进 entry，初始化留当前块）─────────────

// map 字面量构建：在 mdp 中建 TMap* 并逐项 tll_map_put。keytd/valtd 为 TD 索引。
fn ll_build_map_lit(en: i64, mdp: string, keytd: i64, valtd: i64) -> void {
    var mdkk: i64 = 0;
    if (tds[keytd].cat != "string") { mdkk = 1; }
    var mdvty: string = ll_td(valtd);
    llfb(sb_cat5(sb_cat4("  ", mdp, " = call ptr @tll_map_new(i64 ", i2s(mdkk)), ", i64 ", ll_sizeof(mdvty), ")", ""));
    var mdn: Node = nodes[en];
    var mdc: i64 = mdn.la;
    while (mdc >= 0) {
        var mdck: Child = kids[mdc];
        var mden: Node = nodes[mdck.val];
        var mdkp: string = ll_map_keyptr(mden.na, keytd);
        var mdvp: string = ll_map_argptr(mden.nb, valtd);
        llfb(sb_cat5(sb_cat4("  call void @tll_map_put(ptr ", mdp, ", ptr ", mdkp), ", ptr ", mdvp, ")", ""));
        mdc = mdck.next;
    }
}

fn ll_local_decl(name: string, td: i64, init_e: i64) -> void {
    var ty: string = ll_td(td);
    var vn: string = sb_cat2("%v.", name);
    if (lla_has(name) == false) {
        append(lla_n, name);
        llfa(sb_cat4("  ", vn, " = alloca ", ty));
    }
    var t0: TD = tds[td];
    // 定长数组：先整体零初始化，再按 GEP 逐元素 store
    if (t0.cat == "array") {
        llfb(sb_cat6("  store ", ty, " ", ll_zero(ty), ", ptr ", vn));
        if (is_array_lit(init_e)) {
            var aety: string = "i64";
            if (t0.elem >= 0) {
                aety = ll_td(t0.elem);
            }
            var an1: Node = nodes[init_e];
            var cc1: i64 = an1.la;
            var ix1: i64 = 0;
            while (cc1 >= 0) {
                var ck1: Child = kids[cc1];
                var gp1: string = ll_tmp();
                llfb(sb_cat6(sb_cat4("  ", gp1, " = getelementptr ", ty), ", ptr ", vn, ", i64 0, i64 ", i2s(ix1), ""));
                if (ll_isagg(t0.elem)) {
                    ll_copy(aety, emit_lle(ck1.val), gp1);
                } else {
                    var av1: string = emit_lle(ck1.val);
                    if (t0.elem >= 0) {
                        av1 = ll_cast_v(av1, ll_etd(ck1.val), t0.elem);
                    }
                    llfb(sb_cat6("  store ", aety, " ", av1, ", ptr ", gp1));
                }
                ix1 = ix1 + 1;
                cc1 = ck1.next;
            }
        }
        return;
    }
    // map：`var m: map[K]V;` 建空表；`= [k: v, ...]` 建表后逐项插入
    if (t0.cat == "map") {
        if (init_e < 0 || is_map_lit(init_e)) {
            var mdp: string = ll_tmp();
            if (init_e < 0) {
                var mdkk2: i64 = 0;
                if (tds[t0.key].cat != "string") { mdkk2 = 1; }
                llfb(sb_cat5(sb_cat4("  ", mdp, " = call ptr @tll_map_new(i64 ", i2s(mdkk2)), ", i64 ", ll_sizeof(ll_td(t0.val)), ")", ""));
            } else {
                ll_build_map_lit(init_e, mdp, t0.key, t0.val);
            }
            llfb(sb_cat4("  store ptr ", mdp, ", ptr ", vn));
            return;
        }
    }
    // 切片字面量：`var xs: []T = [a, b, c];` → slice_new + 逐元素 append
    if (t0.cat == "slice" && is_array_lit(init_e)) {
        var ety0: string = "i64";
        if (t0.elem >= 0) {
            ety0 = ll_td(t0.elem);
        }
        llfb(sb_cat6("  call void @tll_slice_new(i64 ", ll_sizeof(ety0), ", ptr ", vn, ")", ""));
        var ln0: Node = nodes[init_e];
        var cc0: i64 = ln0.la;
        while (cc0 >= 0) {
            var ck0: Child = kids[cc0];
            var ep0: string = "";
            if (ll_isagg(t0.elem)) {
                ep0 = emit_lle(ck0.val);
            } else {
                var v0: string = emit_lle(ck0.val);
                if (t0.elem >= 0) {
                    v0 = ll_cast_v(v0, ll_etd(ck0.val), t0.elem);
                }
                var sc0: string = ll_scratch(ety0);
                llfb(sb_cat6("  store ", ety0, " ", v0, ", ptr ", sc0));
                ep0 = sc0;
            }
            var asb0: StringBuilder = sb_new();
            sb_append_str(asb0, "  call void @tll_slice_append(ptr ");
            sb_append_str(asb0, vn);
            sb_append_str(asb0, ", ptr ");
            sb_append_str(asb0, ep0);
            sb_append_str(asb0, ", i64 ");
            sb_append_str(asb0, ll_sizeof(ety0));
            sb_append_str(asb0, ")");
            llfb(sb_to_str(asb0));
            cc0 = ck0.next;
        }
        return;
    }
    // Sym = string : 自动 intern（LHS 存 id）。Sym=Sym（同池）/ 无初始化
    // 由下面通用 id 拷贝 / 零值路径处理（td_sname(sym)=="" → ll_cast_v 原样返回）。
    if (t0.cat == "sym" && init_e >= 0) {
        var isymtd: i64 = ll_etd(init_e);
        if (isymtd >= 0 && tds[isymtd].cat == "string") {
            var symtagp: string = ll_strlit(t0.name);
            var symv: string = emit_lle(init_e);
            var symbits: string = i2s(t0.alen);
            var symid: string = ll_tmp();
            llfb(sb_cat6("  ", symid, " = call i32 @tll_sym_intern(ptr ", symtagp, ", ptr ", sb_cat3(symv, ", i64 ", sb_cat2(symbits, ")"))));
            var symstored: string = symid;
            if (ty == "i16") {
                symstored = ll_tmp();
                llfb(sb_cat4("  ", symstored, " = trunc i32 ", sb_cat2(symid, " to i16")));
            }
            llfb(sb_cat6("  store ", ty, " ", symstored, ", ptr ", vn));
            return;
        }
    }
    if (init_e >= 0) {
        var v: string = emit_lle(init_e);
        if (ll_isagg(td)) {
            ll_copy(ty, v, vn);
        } else {
            v = ll_cast_v(v, ll_etd(init_e), td);
            llfb(sb_cat6("  store ", ty, " ", v, ", ptr ", vn));
        }
        return;
    }
    var t: TD = tds[td];
    if (t.cat == "slice") {
        var ety: string = "i64";
        if (t.elem >= 0) {
            ety = ll_td(t.elem);
        }
        llfb(sb_cat6("  call void @tll_slice_new(i64 ", ll_sizeof(ety), ", ptr ", vn, ")", ""));
        return;
    }
    llfb(sb_cat6("  store ", ty, " ", ll_zero(ty), ", ptr ", vn));
}

// ── 语句发射 ───────────────────────────────────────────────────

fn emit_llstmt(sid: i64) -> void {
    if (ll_term) {
        ll_open();
    }
    var n: Node = nodes[sid];

    if (n.kind == "expr") {
        var xx: string = emit_lle(n.na);
        xx = "";
        return;
    }
    if (n.kind == "var_decl") {
        if (n.na >= 0) {
            ll_local_decl(n.sa, resolve_type_desc(n.na), n.nb);
        }
        return;
    }
    if (n.kind == "assignment") {
        var op: string = n.sa;
        var ltd: i64 = ll_etd(n.na);
        var lty: string = ll_td(ltd);
        if (op == "=") {
            // m[k] = v : map 索引写须走 tll_map_put（find-or-insert），不能对读值再存回
            if (n.na >= 0) {
                var ln: Node = nodes[n.na];
                if (ln.kind == "index") {
                    var lotd: i64 = ll_etd(ln.na);
                    var lott: TD = tds[lotd];
                    if (lott.cat == "map") {
                        var mp: string = emit_lle(ln.na);
                        var kp: string = ll_map_keyptr(ln.nb, lott.key);
                        var vp: string = ll_map_argptr(n.nb, lott.val);
                        llfb(sb_cat6("  call void @tll_map_put(ptr ", mp, ", ptr ", kp, ", ptr ", sb_cat2(vp, ")")));
                        return;
                    }
                }
            }
            var v: string = emit_lle(n.nb);
            var ad: string = ll_addr(n.na);
            if (ll_isagg(ltd)) {
                ll_copy(lty, v, ad);
            } else {
                v = ll_cast_v(v, ll_etd(n.nb), ltd);
                llfb(sb_cat6("  store ", lty, " ", v, ", ptr ", ad));
            }
            return;
        }
        // 复合赋值：load-op-store
        var bop: string = str_slice(op, 0, str_len(op) - 1);
        var ad2: string = ll_addr(n.na);
        var old: string = ll_load(lty, ad2);
        var rv: string = emit_lle(n.nb);
        rv = ll_cast_v(rv, ll_etd(n.nb), ltd);
        var sn: string = td_sname(ltd);
        if (sn == "") {
            sn = "i64";
        }
        var ins: string = ll_arith_ins(bop, sn);
        if (ins == "") {
            llfb("  ; UNSUPPORTED compound assign");
            return;
        }
        var t: string = ll_tmp();
        llfb(sb_cat6("  ", t, " = ", ins, " ", sb_cat6(lty, " ", old, ", ", rv, "")));
        llfb(sb_cat6("  store ", lty, " ", t, ", ptr ", ad2));
        return;
    }
    if (n.kind == "if") {
        var cv: string = emit_lle(n.na);
        var c1: string = ll_to_i1(cv);
        var thenL: string = ll_lbl("if.t");
        var endL: string = ll_lbl("if.e");
        var elseL: string = endL;
        var has_else: bool = n.lb > -2;
        if (has_else) {
            elseL = ll_lbl("if.f");
        }
        llfb(sb_cat6("  br i1 ", c1, ", label %", thenL, ", label %", elseL));
        ll_term = true;
        ll_label(thenL);
        var tb: i64 = n.la;
        while (tb >= 0) {
            var tk: Child = kids[tb];
            emit_llstmt(tk.val);
            tb = tk.next;
        }
        if (ll_term == false) {
            llfb(sb_cat2("  br label %", endL));
            ll_term = true;
        }
        if (has_else) {
            ll_label(elseL);
            var eb: i64 = n.lb;
            while (eb >= 0) {
                var ek: Child = kids[eb];
                emit_llstmt(ek.val);
                eb = ek.next;
            }
            if (ll_term == false) {
                llfb(sb_cat2("  br label %", endL));
                ll_term = true;
            }
        }
        ll_label(endL);
        return;
    }
    if (n.kind == "while") {
        var condL: string = ll_lbl("wh.c");
        var bodyL: string = ll_lbl("wh.b");
        var endL2: string = ll_lbl("wh.e");
        llfb(sb_cat2("  br label %", condL));
        ll_label(condL);
        var cv2: string = emit_lle(n.na);
        var c2: string = ll_to_i1(cv2);
        llfb(sb_cat6("  br i1 ", c2, ", label %", bodyL, ", label %", endL2));
        ll_term = true;
        ll_label(bodyL);
        ll_loop_push2(endL2, condL);
        var wb: i64 = n.la;
        while (wb >= 0) {
            var wk: Child = kids[wb];
            emit_llstmt(wk.val);
            wb = wk.next;
        }
        ll_loop_pop();
        if (ll_term == false) {
            llfb(sb_cat2("  br label %", condL));
            ll_term = true;
        }
        ll_label(endL2);
        return;
    }
    if (n.kind == "for") {
        if (n.na >= 0) {
            var ini: Node = nodes[n.na];
            if (ini.kind == "var_decl") {
                if (ini.na >= 0) {
                    ll_local_decl(ini.sa, resolve_type_desc(ini.na), ini.nb);
                }
            }
            if (ini.kind == "expr") {
                var xi: string = emit_lle(ini.na);
                xi = "";
            }
        }
        var condL2: string = ll_lbl("fo.c");
        var bodyL2: string = ll_lbl("fo.b");
        var stepL: string = ll_lbl("fo.s");
        var endL3: string = ll_lbl("fo.e");
        llfb(sb_cat2("  br label %", condL2));
        ll_label(condL2);
        if (n.nb >= 0) {
            var cv3: string = emit_lle(n.nb);
            var c3: string = ll_to_i1(cv3);
            llfb(sb_cat6("  br i1 ", c3, ", label %", bodyL2, ", label %", endL3));
        } else {
            llfb(sb_cat2("  br label %", bodyL2));
        }
        ll_term = true;
        ll_label(bodyL2);
        ll_loop_push2(endL3, stepL);
        var fb2: i64 = n.la;
        while (fb2 >= 0) {
            var fk: Child = kids[fb2];
            emit_llstmt(fk.val);
            fb2 = fk.next;
        }
        ll_loop_pop();
        if (ll_term == false) {
            llfb(sb_cat2("  br label %", stepL));
            ll_term = true;
        }
        ll_label(stepL);
        if (n.nc >= 0) {
            var xu: string = emit_lle(n.nc);
            xu = "";
        }
        llfb(sb_cat2("  br label %", condL2));
        ll_term = true;
        ll_label(endL3);
        return;
    }
    if (n.kind == "for_each") {
        var itd0: i64 = ll_etd(n.na);
        var it0: TD = tds[itd0];
        var etd: i64 = -1;
        if (it0.cat == "slice") {
            etd = it0.elem;
        }
        // map 的 for-in：按插入序迭代键（tll_map_count + tll_map_key_*_at）
        if (it0.cat == "map") {
            var mfkd: i64 = it0.key;
            var mfkty: string = ll_td(mfkd);
            var mfiter: string = emit_lle(n.na);
            var mfcnt: string = ll_tmp();
            llfb(sb_cat4("  ", mfcnt, " = call i64 @tll_map_count(ptr ", sb_cat2(mfiter, ")")));
            var mfidx: string = ll_scratch("i64");
            llfb(sb_cat2("  store i64 0, ptr ", mfidx));
            if (lla_has(n.sa) == false) {
                append(lla_n, n.sa);
                llfa(sb_cat4("  %v.", n.sa, " = alloca ", mfkty));
            }
            var mfvn: string = sb_cat2("%v.", n.sa);
            var mfcL: string = ll_lbl("fm.c");
            var mfbL: string = ll_lbl("fm.b");
            var mfsL: string = ll_lbl("fm.s");
            var mfeL: string = ll_lbl("fm.e");
            llfb(sb_cat2("  br label %", mfcL));
            ll_label(mfcL);
            var mfi: string = ll_load("i64", mfidx);
            var mfcc: string = ll_tmp();
            llfb(sb_cat6("  ", mfcc, " = icmp slt i64 ", mfi, ", ", mfcnt));
            llfb(sb_cat6("  br i1 ", mfcc, ", label %", mfbL, ", label %", mfeL));
            ll_term = true;
            ll_label(mfbL);
            var mfi2: string = ll_load("i64", mfidx);
            if (tds[mfkd].cat == "string") {
                llfb(sb_cat5(sb_cat4("  call void @tll_map_key_str_at(ptr ", mfiter, ", i64 ", mfi2), ", ptr ", mfvn, ")", ""));
            } else {
                var mfkv: string = ll_tmp();
                llfb(sb_cat5(sb_cat4("  ", mfkv, " = call i64 @tll_map_key_int_at(ptr ", mfiter), ", i64 ", mfi2, ")", ""));
                var mfsv: string = mfkv;
                if (mfkty != "i64") {
                    var mftr: string = ll_tmp();
                    llfb(sb_cat6("  ", mftr, " = trunc i64 ", mfkv, " to ", mfkty));
                    mfsv = mftr;
                }
                llfb(sb_cat6("  store ", mfkty, " ", mfsv, ", ptr ", mfvn));
            }
            // 双变量形式 `for (k, v in m)`：v 由插入序下标直接取值
            if (str_len(n.sb) > 0) {
                var mfvd: i64 = it0.val;
                var mfvty: string = ll_td(mfvd);
                var mfvvn: string = sb_cat2("%v.", n.sb);
                if (lla_has(n.sb) == false) {
                    append(lla_n, n.sb);
                    llfa(sb_cat4("  ", mfvvn, " = alloca ", mfvty));
                }
                var mfvp: string = ll_tmp();
                llfb(sb_cat5(sb_cat4("  ", mfvp, " = call ptr @tll_map_val_at(ptr ", mfiter), ", i64 ", mfi2, ")", ""));
                if (ll_isagg(mfvd)) {
                    ll_copy(mfvty, mfvp, mfvvn);
                } else {
                    var mfvv: string = ll_load(mfvty, mfvp);
                    llfb(sb_cat6("  store ", mfvty, " ", mfvv, ", ptr ", mfvvn));
                }
            }
            ll_loop_push2(mfeL, mfsL);
            var mfbb: i64 = n.la;
            while (mfbb >= 0) {
                var mfbk2: Child = kids[mfbb];
                emit_llstmt(mfbk2.val);
                mfbb = mfbk2.next;
            }
            ll_loop_pop();
            if (ll_term == false) {
                llfb(sb_cat2("  br label %", mfsL));
                ll_term = true;
            }
            ll_label(mfsL);
            var mfi3: string = ll_load("i64", mfidx);
            var mfi4: string = ll_tmp();
            llfb(sb_cat4("  ", mfi4, " = add i64 ", sb_cat2(mfi3, ", 1")));
            llfb(sb_cat5("  store i64 ", mfi4, ", ptr ", mfidx, ""));
            llfb(sb_cat2("  br label %", mfcL));
            ll_term = true;
            ll_label(mfeL);
            return;
        }
        var ety: string = "i64";
        if (etd >= 0) {
            ety = ll_td(etd);
        }
        var iter: string = emit_lle(n.na);
        var lenv: string = ll_tmp();
        llfb(sb_cat4("  ", lenv, " = call i64 @tll_slice_len(ptr ", sb_cat2(iter, ")")));
        var idx: string = ll_scratch("i64");
        llfb(sb_cat3("  store i64 0, ptr ", idx, ""));
        if (lla_has(n.sa) == false) {
            append(lla_n, n.sa);
            llfa(sb_cat4("  %v.", n.sa, " = alloca ", ety));
        }
        var condL3: string = ll_lbl("fe.c");
        var bodyL3: string = ll_lbl("fe.b");
        var stepL2: string = ll_lbl("fe.s");
        var endL4: string = ll_lbl("fe.e");
        llfb(sb_cat2("  br label %", condL3));
        ll_label(condL3);
        var iv: string = ll_load("i64", idx);
        var cc: string = ll_tmp();
        llfb(sb_cat6("  ", cc, " = icmp slt i64 ", iv, ", ", lenv));
        llfb(sb_cat6("  br i1 ", cc, ", label %", bodyL3, ", label %", endL4));
        ll_term = true;
        ll_label(bodyL3);
        var iv2: string = ll_load("i64", idx);
        var ep: string = ll_tmp();
        llfb(sb_cat6("  ", ep, " = call ptr @tll_slice_at(ptr ", iter, ", i64 ", sb_cat2(iv2, ")")));
        ll_copy(ety, ep, sb_cat2("%v.", n.sa));
        ll_loop_push2(endL4, stepL2);
        var bb: i64 = n.la;
        while (bb >= 0) {
            var bk: Child = kids[bb];
            emit_llstmt(bk.val);
            bb = bk.next;
        }
        ll_loop_pop();
        if (ll_term == false) {
            llfb(sb_cat2("  br label %", stepL2));
            ll_term = true;
        }
        ll_label(stepL2);
        var iv3: string = ll_load("i64", idx);
        var iv4: string = ll_tmp();
        llfb(sb_cat4("  ", iv4, " = add i64 ", sb_cat2(iv3, ", 1")));
        llfb(sb_cat6("  store i64 ", iv4, ", ptr ", idx, "", ""));
        llfb(sb_cat2("  br label %", condL3));
        ll_term = true;
        ll_label(endL4);
        return;
    }
    if (n.kind == "return") {
        var rty: string = ll_td(ll_cur_ret);
        if (n.na < 0 || rty == "void") {
            llfb("  ret void");
            ll_term = true;
            return;
        }
        var rv2: string = emit_lle(n.na);
        if (ll_isagg(ll_cur_ret)) {
            var rl: string = ll_load(rty, rv2);
            llfb(sb_cat4("  ret ", rty, " ", rl));
        } else {
            rv2 = ll_cast_v(rv2, ll_etd(n.na), ll_cur_ret);
            llfb(sb_cat4("  ret ", rty, " ", rv2));
        }
        ll_term = true;
        return;
    }
    if (n.kind == "break") {
        llfb(sb_cat2("  br label %", llbrk[ll_loopd - 1]));
        ll_term = true;
        return;
    }
    if (n.kind == "continue") {
        llfb(sb_cat2("  br label %", llcnt[ll_loopd - 1]));
        ll_term = true;
        return;
    }
    if (n.kind == "block") {
        var bb2: i64 = n.la;
        while (bb2 >= 0) {
            var bk2: Child = kids[bb2];
            emit_llstmt(bk2.val);
            bb2 = bk2.next;
        }
        return;
    }
    if (n.kind == "switch") {
        var std: i64 = ll_etd(n.na);
        var sn2: string = td_sname(std);
        if (sn2 == "") {
            sn2 = "i64";
        }
        var sty: string = scalar_to_ll(sn2);
        var sbits: i64 = ll_bits(sn2);
        var sv: string = emit_lle(n.na);
        var endL5: string = ll_lbl("sw.e");
        var defL: string = endL5;
        if (n.lb > -2) {
            defL = ll_lbl("sw.d");
        }
        // 先分配 case 标签并生成 switch 头
        var case_ls: []string;
        var case_vs: []string;
        var cc2: i64 = n.la;
        while (cc2 >= 0) {
            var ck: Child = kids[cc2];
            var cs: Node = nodes[ck.val];
            var one_lbl: string = ll_lbl("sw.c");
            append(case_ls, one_lbl);
            var cvv: string = ll_case_const(cs.na, sbits);
            append(case_vs, cvv);
            cc2 = ck.next;
        }
        var hsb: StringBuilder = sb_new();
        sb_append_str(hsb, "  switch ");
        sb_append_str(hsb, sty);
        sb_append_str(hsb, " ");
        sb_append_str(hsb, sv);
        sb_append_str(hsb, ", label %");
        sb_append_str(hsb, defL);
        sb_append_str(hsb, " [");
        var nc: i64 = slice_len(case_ls) as i64;
        var ci: i64 = 0;
        while (ci < nc) {
            sb_append_str(hsb, " ");
            sb_append_str(hsb, sty);
            sb_append_str(hsb, " ");
            sb_append_str(hsb, case_vs[ci]);
            sb_append_str(hsb, ", label %");
            sb_append_str(hsb, case_ls[ci]);
            ci = ci + 1;
        }
        sb_append_str(hsb, " ]");
        llfb(sb_to_str(hsb));
        ll_term = true;
        // 逐 case 发射
        var cc3: i64 = n.la;
        var ci2: i64 = 0;
        while (cc3 >= 0) {
            var ck2: Child = kids[cc3];
            var cs2: Node = nodes[ck2.val];
            ll_label(case_ls[ci2]);
            var cb: i64 = cs2.la;
            while (cb >= 0) {
                var cbk: Child = kids[cb];
                emit_llstmt(cbk.val);
                cb = cbk.next;
            }
            if (ll_term == false) {
                llfb(sb_cat2("  br label %", endL5));
                ll_term = true;
            }
            ci2 = ci2 + 1;
            cc3 = ck2.next;
        }
        if (n.lb > -2) {
            ll_label(defL);
            var db: i64 = n.lb;
            while (db >= 0) {
                var dk: Child = kids[db];
                emit_llstmt(dk.val);
                db = dk.next;
            }
            if (ll_term == false) {
                llfb(sb_cat2("  br label %", endL5));
                ll_term = true;
            }
        }
        ll_label(endL5);
        return;
    }
    // defer / comptime_block：LLVM 后端暂不支持
}

// ── 函数发射 ───────────────────────────────────────────────────

fn ll_reset_fn() -> void {
    var e1: []string;
    ll_fal = e1;
    var e2: []string;
    ll_fb = e2;
    var e3: []string;
    lla_n = e3;
    var e4: []string;
    llbrk = e4;
    var e5: []string;
    llcnt = e5;
    ll_loopd = 0;
    ll_tmpc = 0;
    ll_lblc = 0;
    ll_scc = 0;
    ll_cur_blk = "entry";
    ll_term = false;
}

fn emit_llfunc(d: i64) -> void {
    var n: Node = nodes[d];
    var fi: i64 = llfn_find(n.sa);
    var rtd: i64 = -1;
    if (fi >= 0) {
        rtd = llfn_r[fi];
    }
    var rty: string = ll_td(rtd);

    // 签名
    var psb: StringBuilder = sb_new();
    var cnt: i64 = 0;
    var c: i64 = n.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var p: Node = nodes[k.val];
        if (cnt > 0) {
            sb_append_str(psb, ", ");
        }
        var ptd: i64 = resolve_type_desc(p.na);
        sb_append_str(psb, ll_td(ptd));
        sb_append_str(psb, " %p.");
        sb_append_str(psb, p.sa);
        cnt = cnt + 1;
        c = k.next;
    }
    var params: string = sb_to_str(psb);

    if (n.ba) {
        // extern：绑定 C 符号（无 t. 前缀），参数类型按同规则
        llph(sb_cat6("declare ", rty, " @", n.sa, "(", sb_cat2(params, ")")));
        return;
    }

    if (ann_find(n.la, "main") >= 0) {
        ll_has_main = true;
        ll_main_fn = n.sa;
    }

    ll_reset_fn();
    em_cur_fn = n.sa;
    em_in_fn = true;
    ll_cur_ret = rtd;

    // 参数落地：alloca %v.x + store
    var c2: i64 = n.lb;
    while (c2 >= 0) {
        var k2: Child = kids[c2];
        var p2: Node = nodes[k2.val];
        var ptd2: i64 = resolve_type_desc(p2.na);
        var pty: string = ll_td(ptd2);
        append(lla_n, p2.sa);
        llfa(sb_cat6("  %v.", p2.sa, " = alloca ", pty, "", ""));
        llfb(sb_cat6("  store ", pty, " %p.", p2.sa, ", ptr %v.", p2.sa));
        c2 = k2.next;
    }

    if (n.lc > -2) {
        var b: i64 = n.lc;
        while (b >= 0) {
            var bk: Child = kids[b];
            emit_llstmt(bk.val);
            b = bk.next;
        }
    }
    if (ll_term == false) {
        if (rty == "void") {
            llfb("  ret void");
        } else {
            llfb(sb_cat4("  ret ", rty, " ", ll_zero(rty)));
        }
    }

    // 组装
    llpb(sb_cat6("define ", rty, " @t.", n.sa, "(", sb_cat2(params, ") {")));
    llpb("entry:");
    var na: i64 = slice_len(ll_fal) as i64;
    var i: i64 = 0;
    while (i < na) {
        llpb(ll_fal[i]);
        i = i + 1;
    }
    var nb: i64 = slice_len(ll_fb) as i64;
    var j: i64 = 0;
    while (j < nb) {
        llpb(ll_fb[j]);
        j = j + 1;
    }
    llpb("}");
    llpb("");
    em_in_fn = false;
    em_cur_fn = "";
}

// ── 类型定义 / 全局 / 模块编排 ─────────────────────────────────

fn emit_lltypes() -> void {
    var n: i64 = slice_len(llt_names) as i64;
    var i: i64 = 0;
    while (i < n) {
        var name: string = llt_names[i];
        var k: string = llt_kinds[i];
        if (k == "struct") {
            var sb: StringBuilder = sb_new();
            sb_append_str(sb, "%st.");
            sb_append_str(sb, name);
            sb_append_str(sb, " = type { ");
            var m: i64 = slice_len(llsf_st) as i64;
            var j: i64 = 0;
            var first: bool = true;
            while (j < m) {
                if (llsf_st[j] == name) {
                    if (first == false) {
                        sb_append_str(sb, ", ");
                    }
                    sb_append_str(sb, ll_td(llsf_td[j]));
                    first = false;
                }
                j = j + 1;
            }
            if (first) {
                sb_append_str(sb, "i8");
            }
            sb_append_str(sb, " }");
            llph(sb_to_str(sb));
        }
        if (k == "variant") {
            var sb2: StringBuilder = sb_new();
            sb_append_str(sb2, "%vt.");
            sb_append_str(sb2, name);
            sb_append_str(sb2, " = type { i64, [");
            sb_append_i64(sb2, ll_variant_paymax(name));
            sb_append_str(sb2, " x i8] }");
            llph(sb_to_str(sb2));
        }
        if (k == "union") {
            var sb3: StringBuilder = sb_new();
            sb_append_str(sb3, "%un.");
            sb_append_str(sb3, name);
            sb_append_str(sb3, " = type { [");
            sb_append_i64(sb3, ll_union_max(name));
            sb_append_str(sb3, " x i8] }");
            llph(sb_to_str(sb3));
        }
        i = i + 1;
    }
}

fn emit_lldeclares() -> void {
    llph("declare void @tll_print(ptr)");
    llph("declare void @tll_eprint(ptr)");
    llph("declare void @tll_println(ptr)");
    llph("declare i64 @tll_str_len(ptr)");
    llph("declare i64 @tll_str_at(ptr, i64)");
    llph("declare i32 @tll_str_eq(ptr, ptr)");
    llph("declare void @tll_str_slice(ptr, i64, i64, ptr)");
    llph("declare ptr @tll_sb_new()");
    llph("declare void @tll_sb_append_str(ptr, ptr)");
    llph("declare void @tll_sb_append_char(ptr, i64)");
    llph("declare void @tll_sb_append_u64(ptr, i64)");
    llph("declare void @tll_sb_append_i64(ptr, i64)");
    llph("declare void @tll_sb_to_str(ptr, ptr)");
    llph("declare void @tll_int_to_str(i64, ptr)");
    llph("declare void @tll_sb_clear(ptr)");
    llph("declare void @tll_slice_new(i64, ptr)");
    llph("declare void @tll_slice_append(ptr, ptr, i64)");
    llph("declare ptr @tll_slice_at(ptr, i64)");
    llph("declare void @tll_slice_set(ptr, i64, ptr)");
    llph("declare i64 @tll_slice_len(ptr)");
    llph("declare ptr @tll_map_new(i64, i64)");
    llph("declare void @tll_map_put(ptr, ptr, ptr)");
    llph("declare ptr @tll_map_val_ptr(ptr, ptr)");
    llph("declare i32 @tll_map_has(ptr, ptr)");
    llph("declare i64 @tll_map_len(ptr)");
    llph("declare i32 @tll_map_del(ptr, ptr)");
    llph("declare i64 @tll_map_count(ptr)");
    llph("declare void @tll_map_key_str_at(ptr, i64, ptr)");
    llph("declare i64 @tll_map_key_int_at(ptr, i64)");
    llph("declare ptr @tll_map_val_at(ptr, i64)");
    llph("declare void @tll_file_read_all(ptr, ptr)");
    llph("declare i32 @tll_file_write_all(ptr, ptr)");
    llph("declare i32 @tll_file_exists(ptr)");
    // Sym：字符串驻留符号池（M40）
    llph("declare i32 @tll_sym_intern(ptr, ptr, i64)");
    llph("declare void @tll_sym_str(ptr, i32, ptr)");
    llph("declare void @tll_sym_release(ptr)");
    llph("declare void @tll_sym_release_all()");
    // type_info accessor 内建（M36）
    llph("declare void @tll_ti_name(ptr, ptr)");
    llph("declare i64 @tll_ti_size(ptr)");
    llph("declare i64 @tll_ti_kind(ptr)");
    llph("declare i64 @tll_ti_field_count(ptr)");
    llph("declare ptr @tll_ti_field(ptr, i64)");
    llph("declare void @tll_fi_name(ptr, ptr)");
    llph("declare i64 @tll_fi_offset(ptr)");
    llph("declare void @tll_fi_type_name(ptr, ptr)");
    llph("declare i64 @tll_fi_type_size(ptr)");
    llph("declare i8 @tll_fi_is_ptr(ptr)");
    llph("declare void @tll_path_resolve(ptr, ptr)");
    llph("declare void @tll_args(ptr)");
    llph("declare void @tll_exit(i32)");
    llph("declare i32 @tll_system(ptr)");
    llph("declare void @t_runtime_init(i32, ptr)");
    llph("declare ptr @t_arena_new()");
    llph("declare void @t_runtime_set_arena(ptr)");
    llph("declare void @t_runtime_done()");
    llph("");
}

fn emit_llglobals() -> void {
    var n: i64 = slice_len(llgv_n) as i64;
    var i: i64 = 0;
    while (i < n) {
        var ty: string = ll_td(llgv_td[i]);
        llpg(sb_cat6("@", llgv_n[i], " = global ", ty, " ", ll_zero(ty)));
        i = i + 1;
    }
}

// 全局初始化函数：非常量初始值 + 未初始化 slice 的 elem_size 建立
fn emit_llginit() -> void {
    ll_reset_fn();
    em_in_fn = false;
    em_cur_fn = "";
    ll_cur_ret = -1;
    var n: i64 = slice_len(llgv_n) as i64;
    var i: i64 = 0;
    while (i < n) {
        var td: i64 = llgv_td[i];
        var ty: string = ll_td(td);
        var gp: string = sb_cat2("@", llgv_n[i]);
        var t0: TD = tds[td];
        if (t0.cat == "sym") {
            // Sym 全局变量：运行期 intern 字符串 → id，存进 @g（在 t.__ginit 中执行）
            if (llgv_init[i] >= 0) {
                var symtagp: string = ll_strlit(t0.name);
                var symv: string = emit_lle(llgv_init[i]);
                var symbits: string = i2s(t0.alen);
                var symid: string = ll_tmp();
                llfb(sb_cat6("  ", symid, " = call i32 @tll_sym_intern(ptr ", symtagp, ", ptr ", sb_cat3(symv, ", i64 ", sb_cat2(symbits, ")"))));
                var symstored: string = symid;
                if (ty == "i16") {
                    symstored = ll_tmp();
                    llfb(sb_cat4("  ", symstored, " = trunc i32 ", sb_cat2(symid, " to i16")));
                }
                llfb(sb_cat6("  store ", ty, " ", symstored, ", ptr ", gp));
            } else {
                llfb(sb_cat4("  store ", ty, " 0, ptr ", gp));
            }
        } else if (llgv_init[i] >= 0) {
            var v: string = emit_lle(llgv_init[i]);
            if (ll_isagg(td)) {
                ll_copy(ty, v, gp);
            } else {
                v = ll_cast_v(v, ll_etd(llgv_init[i]), td);
                llfb(sb_cat6("  store ", ty, " ", v, ", ptr ", gp));
            }
        } else {
            var t: TD = tds[td];
            if (t.cat == "slice") {
                var ety: string = "i64";
                if (t.elem >= 0) {
                    ety = ll_td(t.elem);
                }
                llfb(sb_cat6("  call void @tll_slice_new(i64 ", ll_sizeof(ety), ", ptr ", gp, ")", ""));
            }
        }
        i = i + 1;
    }
    llfb("  ret void");
    llpb("define void @t.__ginit() {");
    llpb("entry:");
    var na: i64 = slice_len(ll_fal) as i64;
    var j: i64 = 0;
    while (j < na) {
        llpb(ll_fal[j]);
        j = j + 1;
    }
    var nb: i64 = slice_len(ll_fb) as i64;
    var j2: i64 = 0;
    while (j2 < nb) {
        llpb(ll_fb[j2]);
        j2 = j2 + 1;
    }
    llpb("}");
    llpb("");
}

fn emit_llunit(mod: string) -> void {
    build_type_map();
    ll_build_reg();
    llph(sb_cat2("; ModuleID = ", mod));
    llph("%TStr = type { ptr, i64 }");
    llph("%TSlice = type { ptr, i64, i64, i64 }");
    // type_info(T) 常量结构（M36）
    llph("%TFieldInfo = type { %TStr, i64, %TStr, i64, i8 }");
    llph("%TTypeInfo = type { %TStr, i64, i64, i64, %TSlice }");
    emit_lltypes();
    llph("");
    emit_lldeclares();
    emit_llglobals();
    emit_llginit();

    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var dn: Node = nodes[decl_list[i]];
        if (dn.kind == "FuncDecl") {
            emit_llfunc(decl_list[i]);
        }
        i = i + 1;
    }

    if (ll_has_main) {
        llpb("define i32 @main(i32 %argc, ptr %argv) {");
        llpb("entry:");
        llpb("  call void @t_runtime_init(i32 %argc, ptr %argv)");
        llpb("  %a = call ptr @t_arena_new()");
        llpb("  call void @t_runtime_set_arena(ptr %a)");
        llpb("  call void @t.__ginit()");
        llpb(sb_cat3("  %r = call i32 @t.", ll_main_fn, "()"));
        llpb("  call void @t_runtime_done()");
        llpb("  ret i32 %r");
        llpb("}");
    }
}

fn ll_join() -> string {
    var sb: StringBuilder = sb_new();
    var n1: i64 = slice_len(ll_head) as i64;
    var i: i64 = 0;
    while (i < n1) {
        sb_append_str(sb, ll_head[i]);
        sb_append_str(sb, "\n");
        i = i + 1;
    }
    var n2: i64 = slice_len(ll_glob) as i64;
    var j: i64 = 0;
    while (j < n2) {
        sb_append_str(sb, ll_glob[j]);
        sb_append_str(sb, "\n");
        j = j + 1;
    }
    sb_append_str(sb, "\n");
    var n3: i64 = slice_len(ll_body) as i64;
    var k: i64 = 0;
    while (k < n3) {
        sb_append_str(sb, ll_body[k]);
        sb_append_str(sb, "\n");
        k = k + 1;
    }
    return sb_to_str(sb);
}

// ── 路径工具 ───────────────────────────────────────────────────

fn base_no_tc(path: string) -> string {
    var n: u64 = str_len(path);
    var start: u64 = 0;
    var i: u64 = 0;
    while (i < n) {
        if (path[i] == 47 || path[i] == 92) {
            start = i + 1;
        }
        i = i + 1;
    }
    var end: u64 = n;
    if (n >= start + 3) {
        if (path[n - 3] == 46 && path[n - 2] == 116 && path[n - 1] == 99) {
            end = n - 3;
        }
    }
    return str_slice(path, start, end);
}

// --mode 只接受 dbg|rls（t 默认目录结构：out/dbg 调试、out/rls 发布）
fn valid_mode(m: string) -> bool {
    if (m == "dbg") {
        return true;
    }
    if (m == "rls") {
        return true;
    }
    return false;
}

// 探测路径是否存在（Windows: cmd /c if exist）
fn path_exists(p: string) -> bool {
    var q: string = to_bs(p);
    var rc: i32 = sys_run(sb_cat3("cmd /c if exist \"", q, "\" (exit 0) else (exit 1)"));
    if (rc == 0) {
        return true;
    }
    return false;
}

// 写出文件前确保父目录存在（Windows: cmd /c mkdir，幂等）
fn ensure_parent(p: string) -> void {
    var nn: u64 = str_len(p);
    var cut: u64 = 0;
    var pi: u64 = 0;
    while (pi < nn) {
        if (p[pi] == 47 || p[pi] == 92) { cut = pi; }
        pi = pi + 1;
    }
    if (cut > 0) {
        var d: string = to_bs(str_slice(p, 0, cut));
        sys_run(sb_cat5("cmd /c if not exist \"", d, "\" mkdir \"", d, "\""));
    }
}

fn to_bs(s: string) -> string {
    var sb: StringBuilder = sb_new();
    var i: u64 = 0;
    var n: u64 = str_len(s);
    while (i < n) {
        if (s[i] == 47) {
            sb_append_char(sb, 92);
        } else {
            sb_append_char(sb, s[i]);
        }
        i = i + 1;
    }
    return sb_to_str(sb);
}

// ── lex 子命令（token 池 → JSON，同 tc0 lex --json）────────────

fn run_lex(file: string) -> i32 {
    var src: string = file_read_all(file);
    tokenize(src);
    var out: StringBuilder = sb_new();
    sb_append_char(out, 91);
    var n: i64 = slice_len(toks) as i64;
    var i: i64 = 0;
    while (i < n) {
        var t: Tok = toks[i];
        if (i > 0) {
            sb_append_char(out, 44);
        }
        sb_append_str(out, "{\"type\":\"");
        sb_append_str(out, t.t);
        sb_append_str(out, "\",\"value\":\"");
        json_escape_into(out, t.v);
        sb_append_str(out, "\",\"line\":");
        sb_append_u64(out, t.line);
        sb_append_str(out, ",\"col\":");
        sb_append_u64(out, t.col);
        sb_append_char(out, 125);
        i = i + 1;
    }
    sb_append_char(out, 93);
    print(sb_to_str(out));
    print("\n");
    return 0;
}

// ── 驱动 main：lex / check / compile 派发 ──────────────────────

fn main() -> i32 @main {
    var argv: []string = args();
    init_keywords();
    init_node_kinds();
    init_xid();
    if (slice_len(argv) < 3) {
        eprint("usage: tc <lex|check|compile|emit-ll|build|run> <file.tc> [--example <name>] [--mode dbg|rls] [--output <path>] [--clang <path>] [--runtime <dir>]\n");
        return 2;
    }
    var cmd: string = argv[1];
    var file: string = argv[2];

    if (cmd == "lex") {
        return run_lex(file);
    }

    if (cmd == "check") {
        g_file = path_resolve(file);
        var src: string = file_read_all(file);
        tokenize(src);
        pos = 0;
        init_anndefs();
        parse_unit();
        run_check();
        flag_pass();
        ann_pass();
        print_json();
        if (has_errors()) {
            return 1;
        }
        return 0;
    }

    if (cmd == "compile") {
        var out_dir: string = "";
        var has_out: bool = false;
        var mode: string = "dbg";
        var ai: i64 = 3;
        var an: i64 = slice_len(argv) as i64;
        while (ai < an) {
            if (argv[ai] == "--mode") {
                if (ai + 1 < an) {
                    mode = argv[ai + 1];
                    ai = ai + 2;
                    continue;
                }
            }
            if (argv[ai] == "--output") {
                if (ai + 1 < an) {
                    out_dir = argv[ai + 1];
                    has_out = true;
                    ai = ai + 2;
                    continue;
                }
            }
            ai = ai + 1;
        }
        if (valid_mode(mode) == false) {
            eprint(sb_cat3("error: unknown --mode `", mode, "` (expected dbg|rls)\n"));
            return 2;
        }

        g_file = path_resolve(file);
        var src2: string = file_read_all(file);
        tokenize(src2);
        pos = 0;
        init_anndefs();
        parse_unit();
        run_check();
        flag_pass();
        ann_pass();
        if (has_errors()) {
            return 1;
        }

        var mod: string = base_no_tc(file);
        emit_unit(mod);

        if (has_out == false) {
            // 缺省按 --mode 落入 out/dbg|out/rls
            out_dir = sb_cat3("out/", mode, "");
        }

        var hp: string = sb_cat4(out_dir, "/", mod, ".h");
        var cp: string = sb_cat4(out_dir, "/", mod, ".c");
        ensure_parent(hp);
        file_write_all(hp, h_join());
        file_write_all(cp, s_join());
        print(sb_cat6("Generated: ", to_bs(hp), ", ", to_bs(cp), "\n", ""));
        return 0;
    }

    if (cmd == "emit-ll" || cmd == "build" || cmd == "run") {
        var out_p: string = "";
        var has_outp: bool = false;
        var rt_dir: string = "runtime";
        var clang_p: string = "clang";
        var mode: string = "dbg";
        var src_file: string = "";
        var has_src: bool = false;
        var ex_name: string = "";
        var is_example: bool = false;
        var ai2: i64 = 2;
        var an2: i64 = slice_len(argv) as i64;
        while (ai2 < an2) {
            if (argv[ai2] == "--output") {
                if (ai2 + 1 < an2) {
                    out_p = argv[ai2 + 1];
                    has_outp = true;
                    ai2 = ai2 + 2;
                    continue;
                }
            }
            if (argv[ai2] == "--mode") {
                if (ai2 + 1 < an2) {
                    mode = argv[ai2 + 1];
                    ai2 = ai2 + 2;
                    continue;
                }
            }
            if (argv[ai2] == "--runtime") {
                if (ai2 + 1 < an2) {
                    rt_dir = argv[ai2 + 1];
                    ai2 = ai2 + 2;
                    continue;
                }
            }
            if (argv[ai2] == "--clang") {
                if (ai2 + 1 < an2) {
                    clang_p = argv[ai2 + 1];
                    ai2 = ai2 + 2;
                    continue;
                }
            }
            if (argv[ai2] == "--example") {
                if (ai2 + 1 < an2) {
                    ex_name = argv[ai2 + 1];
                    is_example = true;
                    ai2 = ai2 + 2;
                    continue;
                }
            }
            // 位置参数：第一个非 flag 即源文件
            if (has_src == false) {
                src_file = argv[ai2];
                has_src = true;
            }
            ai2 = ai2 + 1;
        }
        if (valid_mode(mode) == false) {
            eprint(sb_cat3("error: unknown --mode `", mode, "` (expected dbg|rls)\n"));
            return 2;
        }

        // cargo 风格 example：源 = examples/<name>.tc，产物 = out/<mode>/examples/<name>.exe
        if (is_example) {
            var probe: string = sb_cat4("cmd /c if exist \"examples\\", ex_name, ".tc\" (exit 0) else (exit 1)", "");
            var prc: i32 = sys_run(probe);
            if (prc != 0) {
                eprint(sb_cat3("error: no example named `", ex_name, "`\navailable examples:\n"));
                sys_run("cmd /c dir /b examples\\*.tc 2>nul");
                return 2;
            }
            src_file = sb_cat3("examples/", ex_name, ".tc");
            has_src = true;
            if (has_outp == false) {
                var exdir: string = to_bs(sb_cat3("out/", mode, "/examples"));
                sys_run(sb_cat5("cmd /c if not exist \"", exdir, "\" mkdir \"", exdir, "\""));
                out_p = sb_cat4("out/", mode, "/examples/", ex_name);
                has_outp = true;
            }
        }
        if (has_src == false) {
            eprint("usage: tc build|run <file.tc> | --example <name>\n");
            return 2;
        }

        // 缺省 clang：PATH 上没有时探测标准安装路径
        if (clang_p == "clang") {
            var crc: i32 = sys_run("cmd /c if exist \"C:\\Program Files\\LLVM\\bin\\clang.exe\" (exit 0) else (exit 1)");
            if (crc == 0) {
                clang_p = "C:/Program Files/LLVM/bin/clang.exe";
            }
        }

        g_file = path_resolve(src_file);
        var src3: string = file_read_all(src_file);
        tokenize(src3);
        pos = 0;
        init_anndefs();
        parse_unit();
        run_check();
        flag_pass();
        ann_pass();
        if (has_errors()) {
            return 1;
        }

        var mod2: string = base_no_tc(src_file);
        emit_llunit(mod2);

        // 输出目录：--output 指定 exe/目录前缀；缺省按 --mode 落入 out/dbg|out/rls
        if (has_outp == false) {
            out_p = sb_cat4("out/", mode, "/", mod2);
        }

        var llp: string = sb_cat2(out_p, ".ll");
        ensure_parent(llp);
        file_write_all(llp, ll_join());
        print(sb_cat3("Generated: ", to_bs(llp), "\n"));

        if (cmd == "emit-ll") {
            return 0;
        }

        // 无入口时提前报错：否则 lld-link 只会给出
        // "subsystem must be defined" 这类无从下手的链接期诊断。
        if (ll_has_main == false) {
            eprint(sb_cat3("error: no entry point: ", to_bs(src_file), " 缺少 @main 标注的函数（build/run 需要入口；只想产出 IR 请用 emit-ll）\n"));
            return 1;
        }

        // build：调 clang 一步链接 runtime 出 exe
        var exep: string = sb_cat2(out_p, ".exe");
        // 依赖静态库：默认 out/<mode>/deps/t_runtime.lib（tools/build_runtime.mjs 预编译）
        // 缺失时回退直编 <rt_dir> 下的 runtime 源码，保证任意 t 项目开箱即用
        var deps_lib: string = sb_cat3("out/", mode, "/deps/t_runtime.lib");
        var use_lib: bool = path_exists(deps_lib);
        var opt: string = "-O2";
        if (mode == "dbg") { opt = "-O0 -gcodeview"; }
        var csb2: StringBuilder = sb_new();
        sb_append_str(csb2, "\"");
        sb_append_str(csb2, clang_p);
        sb_append_str(csb2, "\" ");
        sb_append_str(csb2, opt);
        sb_append_str(csb2, " -o \"");
        sb_append_str(csb2, exep);
        sb_append_str(csb2, "\" -Wl,-subsystem:console \"");
        sb_append_str(csb2, llp);
        sb_append_str(csb2, "\" ");
        if (use_lib) {
            sb_append_str(csb2, "\"");
            sb_append_str(csb2, deps_lib);
            sb_append_str(csb2, "\"");
        } else {
            sb_append_str(csb2, "\"");
            sb_append_str(csb2, rt_dir);
            sb_append_str(csb2, "/t_runtime.c\" \"");
            sb_append_str(csb2, rt_dir);
            sb_append_str(csb2, "/t_shim_ll.c\" -I \"");
            sb_append_str(csb2, rt_dir);
            sb_append_str(csb2, "\"");
        }
        var rc: i32 = sys_run(sb_to_str(csb2));
        if (rc != 0) {
            eprint("clang link failed\n");
            return 1;
        }
        print(sb_cat3("Built: ", to_bs(exep), "\n"));

        // run：构建成功后立即执行，透传子进程退出码（cargo run 语义）
        if (cmd == "run") {
            var run_cmd: string = sb_cat3("\"", to_bs(exep), "\"");
            var rrc: i32 = sys_run(run_cmd);
            return rrc;
        }
        return 0;
    }

    eprint("unknown command\n");
    return 2;
}

// ── type_info(T) 编译期常量合成（M36）─────────────────────────
// type_info(Point) 在编译期遍历 StructDecl 字段，合成全局常量
// __ti_Point（含字段数组），返回其地址（LLVM: ptr @__ti_Point；C: &__ti_Point）。
// accessor 内建（ti_name/ti_field/fi_*）在运行时读取该常量。

fn c_emit_accessor_call(cn: string, av: []string) -> string {
    var r: string = sb_cat2("t_", cn);
    r = sb_cat2(r, "(");
    var i: i64 = 0;
    var n: i64 = slice_len(av) as i64;
    while (i < n) {
        if (i > 0) { r = sb_cat2(r, ", "); }
        r = sb_cat2(r, av[i]);
        i = i + 1;
    }
    return sb_cat2(r, ")");
}

// 按名查 StructDecl 节点下标。emit 期只能依赖 decl_list —— checker 的
// global_scope/syms 在发射阶段已不保证有效，用 sym_lookup 会取到野下标。
fn ti_struct_decl(tname: string) -> i64 {
    var n: i64 = slice_len(decl_list) as i64;
    var i: i64 = 0;
    while (i < n) {
        var d: i64 = decl_list[i];
        var dn: Node = nodes[d];
        if (dn.kind == "StructDecl" && dn.sa == tname) { return d; }
        i = i + 1;
    }
    return -1;
}

fn emit_type_info_c(tname: string) -> string {
    var gref: string = sb_cat2("&__ti_", tname);
    var di: i64 = 0;
    var dn2: i64 = slice_len(ti_done) as i64;
    while (di < dn2) {
        if (ti_done[di] == tname) { return gref; }
        di = di + 1;
    }
    var d: i64 = ti_struct_decl(tname);
    if (d < 0) {
        diag_new("T_TYPE_MISMATCH", "error", sb_cat2("type_info: '", sb_cat2(tname, "' 不是 struct 类型（当前仅支持 struct）")), "", 1, 1, 1, 10);
        return "0";
    }
    append(ti_done, tname);
    // C 后端：type_info 常量定义在 t_entry_main 之后（emit 期才合成），
    // 但 C 的 static 先用后定义在同 TU 非法；故在 .h 内放前向声明。
    // （Point 等 struct 已落在 .h，故 .c 顶部 include 后即可见。）
    hpush(sb_cat3("static TTypeInfo __ti_", tname, ";"));
    hpush(sb_cat3("static TFieldInfo __ti_", tname, "_f[];"));
    var decl: Node = nodes[d];

    var fsb: StringBuilder = sb_new();
    sb_append_str(fsb, "static TFieldInfo __ti_");
    sb_append_str(fsb, tname);
    sb_append_str(fsb, "_f[] = { ");
    var n: i64 = 0;
    var c: i64 = decl.lb;
    while (c >= 0) {
        var k: Child = kids[c];
        var f: Node = nodes[k.val];
        if (f.ia < 0) {
            if (n > 0) { sb_append_str(fsb, ", "); }
            var ftd: i64 = resolve_type_desc(f.na);
            var cty: string = emit_ctype(f.na);
            var isp: i64 = 0;
            if (is_ref_type(ftd)) { isp = 1; }
            sb_append_str(fsb, sb_cat3("{ TSTR_LIT(\"", esc_c(f.sa), "\"), "));
            sb_append_str(fsb, sb_cat5("offsetof(", tname, ", ", f.sa, "), "));
            sb_append_str(fsb, sb_cat3("TSTR_LIT(\"", esc_c(td_readable(ftd)), "\"), "));
            sb_append_str(fsb, sb_cat3("sizeof(", cty, "), "));
            sb_append_i64(fsb, isp);
            sb_append_str(fsb, " }");
            n = n + 1;
        }
        c = k.next;
    }
    sb_append_str(fsb, " };");

    var tsb: StringBuilder = sb_new();
    sb_append_str(tsb, "static TTypeInfo __ti_");
    sb_append_str(tsb, tname);
    sb_append_str(tsb, sb_cat3(" = { TSTR_LIT(\"", esc_c(tname), "\"), "));
    sb_append_str(tsb, sb_cat3("sizeof(", tname, "), 0, "));
    sb_append_i64(tsb, n);
    sb_append_str(tsb, sb_cat3(", { __ti_", tname, "_f, "));
    sb_append_i64(tsb, n);
    sb_append_str(tsb, ", ");
    sb_append_i64(tsb, n);
    sb_append_str(tsb, ", (int64_t)sizeof(TFieldInfo) } };");
    // 字段数组必须先于 TTypeInfo 输出（后者引用前者）
    append(ti_lines, sb_to_str(fsb));
    append(ti_lines, sb_to_str(tsb));
    return gref;
}

fn emit_type_info_ll(tname: string) -> string {
    var gref: string = sb_cat2("@__ti_", tname);
    var di: i64 = 0;
    var dn2: i64 = slice_len(ti_done) as i64;
    while (di < dn2) {
        if (ti_done[di] == tname) { return gref; }
        di = di + 1;
    }
    // 字段元数据取自 ll_build_reg 建好的注册表（emit 期唯一可靠来源）
    var lti: i64 = llt_find(tname);
    if (lti < 0) {
        diag_new("T_TYPE_MISMATCH", "error", sb_cat2("type_info: '", sb_cat2(tname, "' 不是 struct 类型（当前仅支持 struct）")), "", 1, 1, 1, 10);
        return "null";
    }
    if (llt_kinds[lti] != "struct") {
        diag_new("T_TYPE_MISMATCH", "error", sb_cat2("type_info: '", sb_cat2(tname, "' 不是 struct 类型（当前仅支持 struct）")), "", 1, 1, 1, 10);
        return "null";
    }
    append(ti_done, tname);
    var sty: string = ll_named(tname);

    var m: i64 = slice_len(llsf_st) as i64;
    var n: i64 = 0;
    var j: i64 = 0;
    while (j < m) {
        if (llsf_st[j] == tname) { n = n + 1; }
        j = j + 1;
    }

    var fsb: StringBuilder = sb_new();
    sb_append_str(fsb, gref);
    sb_append_str(fsb, "_f = internal constant [");
    sb_append_i64(fsb, n);
    sb_append_str(fsb, " x %TFieldInfo] [");
    var i: i64 = 0;
    j = 0;
    while (j < m) {
        if (llsf_st[j] == tname) {
            if (i > 0) { sb_append_str(fsb, ", "); }
            var ftd: i64 = llsf_td[j];
            // ll_strlit 发射 @.sN 字面量并回填 ll_last_sref/ll_last_slen；
            // 常量初始化器要的是内联 %TStr 值，不能用它返回的 @.tsN 指针。
            ll_strlit(llsf_fld[j]);
            var fns: string = sb_cat5("%TStr { ptr ", ll_last_sref, ", i64 ", i2s(ll_last_slen), " }");
            ll_strlit(td_readable(ftd));
            var tns: string = sb_cat5("%TStr { ptr ", ll_last_sref, ", i64 ", i2s(ll_last_slen), " }");
            var isp: i64 = 0;
            if (is_ref_type(ftd)) { isp = 1; }
            sb_append_str(fsb, sb_cat3("%TFieldInfo { ", fns, ", i64 ptrtoint (ptr getelementptr ("));
            sb_append_str(fsb, sty);
            sb_append_str(fsb, ", ptr null, i32 0, i32 ");
            sb_append_i64(fsb, llsf_idx[j]);
            sb_append_str(fsb, ") to i64), ");
            sb_append_str(fsb, tns);
            sb_append_str(fsb, ", i64 ");
            sb_append_str(fsb, ll_sizeof(ll_td(ftd)));
            sb_append_str(fsb, ", i8 ");
            sb_append_i64(fsb, isp);
            sb_append_str(fsb, " }");
            i = i + 1;
        }
        j = j + 1;
    }
    sb_append_str(fsb, "]");
    llpg(sb_to_str(fsb));

    ll_strlit(tname);
    var tnm: string = sb_cat5("%TStr { ptr ", ll_last_sref, ", i64 ", i2s(ll_last_slen), " }");
    var tsb: StringBuilder = sb_new();
    sb_append_str(tsb, gref);
    sb_append_str(tsb, " = internal constant %TTypeInfo { ");
    sb_append_str(tsb, tnm);
    sb_append_str(tsb, ", i64 ");
    sb_append_str(tsb, ll_sizeof(sty));
    sb_append_str(tsb, ", i64 0, i64 ");
    sb_append_i64(tsb, n);
    sb_append_str(tsb, sb_cat3(", %TSlice { ptr ", gref, "_f, i64 "));
    sb_append_i64(tsb, n);
    sb_append_str(tsb, ", i64 ");
    sb_append_i64(tsb, n);
    sb_append_str(tsb, ", i64 ");
    sb_append_str(tsb, ll_sizeof("%TFieldInfo"));
    sb_append_str(tsb, " } }");
    llpg(sb_to_str(tsb));
    return gref;
}
