            // `clang link failed`。这里在检查阶段给出清晰的类型错误。
            if (fname == "print" || fname == "println" || fname == "eprint") {
                if (n.la >= 0) {
                    var pan: i64 = kids[n.la].val;
                    var pat: i64 = infer_expr(pan);
                    if (tip_kind(pat) != "String" && tip_kind(pat) != "Unknown") {
                        diag_new("T_TYPE_MISMATCH", "error",
                            sb_cat3(fname, " 的实参必须是字符串（String）；标量请先用 int_to_str / to_string / StringBuilder 拼接。当前收到: ", ti_str(pat)),
                            n_file(e), n_line(e), n_col(e), n_line(e), n_col(e) + 5);
                    }
                }
            }
            return builtin_ret(fname);
        }
        return ti_mk("Unknown");
    }
    if (n.kind == "member") {
        var obt: i64 = infer_expr(n.na);
        var obk: string = tip_kind(obt);
        if (obk == "Struct" || obk == "Named") {
            var si3: i64 = sym_lookup(global_scope, tip_name(obt));
            if (si3 >= 0) {
                var s3: Sym = syms[si3];
                if (s3.decl >= 0) {
                    var sd: Node = nodes[s3.decl];
                    if (sd.kind == "StructDecl") {
                        var c: i64 = sd.lb;
                        while (c >= 0) {
                            var k: Child = kids[c];
                            var f: Node = nodes[k.val];
                            if (f.sa == n.sa) {
                                return resolve_ti(f.na);
                            }
                            c = k.next;
                        }
                    }
                }
            }
        }
        if (obk == "Enum") {
            return obt;
        }
        return ti_mk("Unknown");
    }
    if (n.kind == "index") {
        var obt2: i64 = infer_expr(n.na);
        var obk2: string = tip_kind(obt2);
        if (obk2 == "Array" || obk2 == "Slice") {
            var t2: TI = tis[obt2];
            return t2.elem;
        }
        if (obk2 == "String") {
            return ti_scalar("u8");
        }
        if (obk2 == "Map") {
            var t3: TI = tis[obt2];
            return t3.val;
        }
        return ti_mk("Unknown");
    }
    if (n.kind == "array_lit") {
        var cnt: i64 = list_count(n.la);
        if (cnt > 0) {
            var k2: Child = kids[n.la];
            var et: i64 = infer_expr(k2.val);
            // 数组字面量的整型元素按「默认 int」提升为 i64（与多数语言一致，
            // 避免 [1,2,3] 被推成 []u8）；其余类型（bool/f64/struct…）保持不变。
            if (tip_kind(et) == "Scalar" && is_int_name(tip_name(et)) && tip_name(et) != "i64" && tip_name(et) != "i32") {
                et = ti_scalar("i64");
            }
            var ai: i64 = ti_elem_of("Array", et);
            var at: TI = tis[ai];
