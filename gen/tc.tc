        // 空数组字面量：元素类型未知，配合 can_cast 可赋给任意 []T / [N]T。
        return ti_elem_of("Array", ti_mk("Unknown"));
    }
    if (n.kind == "map_lit") {
        if (n.la >= 0) {
            var k3: Child = kids[n.la];
            var en: Node = nodes[k3.val];
            var kt: i64 = infer_expr(en.na);
            var vt: i64 = infer_expr(en.nb);
            // 与数组字面量同规则：整型键/值按「默认 int」提升为 i64，
            // 避免 [1: 2] 被推成 map[u8]u8。
            if (tip_kind(kt) == "Scalar" && is_int_name(tip_name(kt)) && tip_name(kt) != "i64" && tip_name(kt) != "i32") {
                kt = ti_scalar("i64");
            }
            if (tip_kind(vt) == "Scalar" && is_int_name(tip_name(vt)) && tip_name(vt) != "i64" && tip_name(vt) != "i32") {
                vt = ti_scalar("i64");
            }
            var mi: i64 = ti_mk("Map");
