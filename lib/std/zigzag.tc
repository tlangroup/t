// lib/std/zigzag.tc —— zigzag 编解码（R-004，sint32 / sint64 字段）
//
// 动机：pb3 的 sint32 / sint64 字段用 zigzag 把有符号数映射成无符号，
// 使小的绝对值占用更少字节。公式为 (n << 1) ^ (n >> (bits-1))；
// 解码为 (u >> 1) 再按最低位取负。
//
// 设计：纯 t 实现，仅用位移 / 位与 / 强转，双后端零差异。
// `>>` 在 t 中为算术右移（ashr，语义由语言规定，非实现定义），
// 故有符号 n >> 31 / n >> 63 自然给出符号扩展位，zigzag 正确。
//
// 用法：
//   import(std.zigzag);
//   var enc = zigzag.encode_i32(-3);   // 5
//   var dec = zigzag.decode_i32(enc);  // -3

@module(pub)

// sint32
pub fn encode_i32(n: i32) u32 {
    return ((n << 1) ^ (n >> 31)) as u32;
}
pub fn decode_u32(u: u32) i32 {
    var n: i32 = (u >> 1) as i32;
    if ((u & 1) != 0) { n = -n - 1; }
    return n;
}

// sint64
pub fn encode_i64(n: i64) u64 {
    return ((n << 1) ^ (n >> 63)) as u64;
}
pub fn decode_u64(u: u64) i64 {
    var n: i64 = (u >> 1) as i64;
    if ((u & 1) != 0) { n = -n - 1; }
    return n;
}
