// lib/std/strings.tc —— 字符串工具（纯 t 实现）
//
// 设计约束（同 math.tc / mem.tc）：只依赖语言内建（str_len / str_at / str_slice /
// StringBuilder / append）与运行时，绝不引用 tc 编译器自身符号。因此 std 对 tc
// 无语义依赖，可随任意程序（含 tc 自身后续代际）以源码内联或 .tlib 外链模式使用。
//
// 用法：
//   import(std.strings);
//   var p = strings.index_of("hello", "ll");   // 2
//   println(strings.to_upper("abc"));           // "ABC"
//   var parts = strings.split("a,b,c", ",");    // []string{"a","b","c"}

// ── 子串定位 ───────────────────────────────────────────────────────
@module(pub)

// 子串首次出现位置（无则 -1）。空 needle 视为命中下标 0。
pub fn index_of(haystack: string, needle: string) i64 {
    var hn: u64 = str_len(haystack);
    var nn: u64 = str_len(needle);
    if (nn == 0) { return 0; }
    if (nn > hn) { return -1; }
    var i: u64 = 0;
    while (i + nn <= hn) {
        if (str_slice(haystack, i, i + nn) == needle) { return i as i64; }
        i = i + 1;
    }
    return -1;
}

// 是否包含子串。
pub fn contains(haystack: string, needle: string) bool {
    return index_of(haystack, needle) >= 0;
}

// 统计不重叠的子串出现次数（空 needle 计 0 次）。
pub fn count(haystack: string, needle: string) i64 {
    var hn: u64 = str_len(haystack);
    var nn: u64 = str_len(needle);
    if (nn == 0) { return 0; }
    var c: i64 = 0;
    var i: u64 = 0;
    while (i + nn <= hn) {
        if (str_slice(haystack, i, i + nn) == needle) { c = c + 1; i = i + nn; }
        else { i = i + 1; }
    }
    return c;
}

// 前缀 / 后缀判定。
pub fn starts_with(s: string, prefix: string) bool {
    var n: u64 = str_len(s);
    var pn: u64 = str_len(prefix);
    if (pn > n) { return false; }
    return str_slice(s, 0, pn) == prefix;
}

pub fn ends_with(s: string, suffix: string) bool {
    var n: u64 = str_len(s);
    var sn: u64 = str_len(suffix);
    if (sn > n) { return false; }
    return str_slice(s, n - sn, n) == suffix;
}

// ── 修剪 ───────────────────────────────────────────────────────────
// 仅去 ASCII 空白：空格(32) / 制表(9) / 回车(13) / 换行(10)。
pub fn ltrim(s: string) string {
    var n: u64 = str_len(s);
    var i: u64 = 0;
    while (i < n) {
        var c: i64 = str_at(s, i);
        if (c == 32 or c == 9) { i = i + 1; } else { break; }
    }
    return str_slice(s, i, n);
}

pub fn rtrim(s: string) string {
    var n: u64 = str_len(s);
    while (n > 0) {
        var c: i64 = str_at(s, n - 1);
        if (c == 32 or c == 9 or c == 13 or c == 10) { n = n - 1; } else { break; }
    }
    return str_slice(s, 0, n);
}

pub fn trim(s: string) string {
    return rtrim(ltrim(s));
}

// ── 大小写（仅 ASCII）──────────────────────────────────────────────
pub fn to_upper(s: string) string {
    var n: u64 = str_len(s);
    var sb: StringBuilder = sb_new();
    var i: u64 = 0;
    while (i < n) {
        var c: i64 = str_at(s, i);
        if (c >= 97 and c <= 122) { c = c - 32; }
        sb_append_char(sb, c);
        i = i + 1;
    }
    return sb_to_str(sb);
}

pub fn to_lower(s: string) string {
    var n: u64 = str_len(s);
    var sb: StringBuilder = sb_new();
    var i: u64 = 0;
    while (i < n) {
        var c: i64 = str_at(s, i);
        if (c >= 65 and c <= 90) { c = c + 32; }
        sb_append_char(sb, c);
        i = i + 1;
    }
    return sb_to_str(sb);
}

// ── 替换 / 重复 / 填充 ─────────────────────────────────────────────
// 把所有不重叠的 old 子串换成 rep。空 old 直接原样返回。
pub fn replace(s: string, old_sub: string, rep: string) string {
    var n: u64 = str_len(s);
    var on: u64 = str_len(old_sub);
    if (on == 0) { return s; }
    var sb: StringBuilder = sb_new();
    var i: u64 = 0;
    while (i < n) {
        if (i + on <= n and str_slice(s, i, i + on) == old_sub) {
            sb_append_str(sb, rep);
            i = i + on;
        } else {
            sb_append_char(sb, str_at(s, i));
            i = i + 1;
        }
    }
    return sb_to_str(sb);
}

// 重复 count 次（count <= 0 返回空串）。
pub fn repeat(s: string, count: i64) string {
    var sb: StringBuilder = sb_new();
    var i: i64 = 0;
    while (i < count) {
        sb_append_str(sb, s);
        i = i + 1;
    }
    return sb_to_str(sb);
}

// 左侧填充至 width（已满足则原样返回）。pad 为空时退化为空格填充。
pub fn pad_start(s: string, width: u64, pad: string) string {
    var n: u64 = str_len(s);
    if (n >= width) { return s; }
    var sb: StringBuilder = sb_new();
    var pc: u64 = str_len(pad);
    var k: u64 = 0;
    while (k < width - n) {
        if (pc > 0) { sb_append_char(sb, str_at(pad, k % pc)); }
        else { sb_append_char(sb, 32); }
        k = k + 1;
    }
    sb_append_str(sb, s);
    return sb_to_str(sb);
}

pub fn pad_end(s: string, width: u64, pad: string) string {
    var n: u64 = str_len(s);
    if (n >= width) { return s; }
    var sb: StringBuilder = sb_new();
    sb_append_str(sb, s);
    var pc: u64 = str_len(pad);
    var k: u64 = 0;
    while (k < width - n) {
        if (pc > 0) { sb_append_char(sb, str_at(pad, k % pc)); }
        else { sb_append_char(sb, 32); }
        k = k + 1;
    }
    return sb_to_str(sb);
}

// ── 切分 / 拼接 ────────────────────────────────────────────────────
// 按 sep 切分为多段。sep 为空时退化为逐字符切分。
pub fn split(s: string, sep: string) []string {
    var parts: []string;
    var n: u64 = str_len(s);
    var sn: u64 = str_len(sep);
    if (sn == 0) {
        var i: u64 = 0;
        while (i < n) {
            append(parts, str_slice(s, i, i + 1));
            i = i + 1;
        }
        return parts;
    }
    var start: u64 = 0;
    var i: u64 = 0;
    while (i + sn <= n) {
        if (str_slice(s, i, i + sn) == sep) {
            append(parts, str_slice(s, start, i));
            i = i + sn;
            start = i;
        } else {
            i = i + 1;
        }
    }
    append(parts, str_slice(s, start, n));
    return parts;
}

// 用 sep 把若干段拼接成单一字符串。
pub fn join(parts: []string, sep: string) string {
    var sb: StringBuilder = sb_new();
    var n: u64 = slice_len(parts);
    var i: u64 = 0;
    while (i < n) {
        if (i > 0) { sb_append_str(sb, sep); }
        sb_append_str(sb, parts[i]);
        i = i + 1;
    }
    return sb_to_str(sb);
}
