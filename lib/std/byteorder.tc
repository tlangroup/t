// lib/std/byteorder.tc —— 定宽整数 ↔ 字节序转换（R-003）
//
// 动机：pb3 wire format / TM1 容器头依赖精确位宽与小端编码；同一段数据在
// 32/64 位构建下必须产出字节级一致的流（thyme R-003 验收标准）。
//
// 设计：纯 t 实现，不依赖运行时（仅用位移 / 位与 / 强转），双后端零差异。
// 命名遵循 t 的 snake_case；返回定长数组 [N]u8，调用方自行写入缓冲 / 切片。
// 有符号变体复用无符号的字节布局（字节与符号无关），仅 reinterpret 位模式。
//
// 用法：
//   import(std.byteorder);
//   var b = byteorder.u32_to_le(0x01020304);   // [4,3,2,1]
//   var v = byteorder.u32_from_le(buf, 0);

@module(pub)

// ── u16 ──
pub fn u16_to_le(v: u16) [2]u8 {
    return [(v & 0xFF) as u8, ((v >> 8) & 0xFF) as u8];
}
pub fn u16_to_be(v: u16) [2]u8 {
    return [((v >> 8) & 0xFF) as u8, (v & 0xFF) as u8];
}
pub fn u16_from_le(s: []u8, off: i64) u16 {
    return (s[off] as u16) | ((s[off + 1] as u16) << 8);
}
pub fn u16_from_be(s: []u8, off: i64) u16 {
    return ((s[off] as u16) << 8) | (s[off + 1] as u16);
}

// ── u32 ──
pub fn u32_to_le(v: u32) [4]u8 {
    return [(v & 0xFF) as u8, ((v >> 8) & 0xFF) as u8, ((v >> 16) & 0xFF) as u8, ((v >> 24) & 0xFF) as u8];
}
pub fn u32_to_be(v: u32) [4]u8 {
    return [((v >> 24) & 0xFF) as u8, ((v >> 16) & 0xFF) as u8, ((v >> 8) & 0xFF) as u8, (v & 0xFF) as u8];
}
pub fn u32_from_le(s: []u8, off: i64) u32 {
    return (s[off] as u32) | ((s[off + 1] as u32) << 8) | ((s[off + 2] as u32) << 16) | ((s[off + 3] as u32) << 24);
}
pub fn u32_from_be(s: []u8, off: i64) u32 {
    return ((s[off] as u32) << 24) | ((s[off + 1] as u32) << 16) | ((s[off + 2] as u32) << 8) | (s[off + 3] as u32);
}

// ── u64 ──
pub fn u64_to_le(v: u64) [8]u8 {
    return [(v & 0xFF) as u8, ((v >> 8) & 0xFF) as u8, ((v >> 16) & 0xFF) as u8, ((v >> 24) & 0xFF) as u8,
            ((v >> 32) & 0xFF) as u8, ((v >> 40) & 0xFF) as u8, ((v >> 48) & 0xFF) as u8, ((v >> 56) & 0xFF) as u8];
}
pub fn u64_to_be(v: u64) [8]u8 {
    return [((v >> 56) & 0xFF) as u8, ((v >> 48) & 0xFF) as u8, ((v >> 40) & 0xFF) as u8, ((v >> 32) & 0xFF) as u8,
            ((v >> 24) & 0xFF) as u8, ((v >> 16) & 0xFF) as u8, ((v >> 8) & 0xFF) as u8, (v & 0xFF) as u8];
}
pub fn u64_from_le(s: []u8, off: i64) u64 {
    return (s[off] as u64) | ((s[off + 1] as u64) << 8) | ((s[off + 2] as u64) << 16) | ((s[off + 3] as u64) << 24)
         | ((s[off + 4] as u64) << 32) | ((s[off + 5] as u64) << 40) | ((s[off + 6] as u64) << 48) | ((s[off + 7] as u64) << 56);
}
pub fn u64_from_be(s: []u8, off: i64) u64 {
    return ((s[off] as u64) << 56) | ((s[off + 1] as u64) << 48) | ((s[off + 2] as u64) << 40) | ((s[off + 3] as u64) << 32)
         | ((s[off + 4] as u64) << 24) | ((s[off + 5] as u64) << 16) | ((s[off + 6] as u64) << 8) | (s[off + 7] as u64);
}

// ── 有符号变体（字节布局与对应无符号一致，仅 reinterpret）──
pub fn i16_to_le(v: i16) [2]u8 { return u16_to_le(v as u16); }
pub fn i16_from_le(s: []u8, off: i64) i16 { return u16_from_le(s, off) as i16; }
pub fn i16_to_be(v: i16) [2]u8 { return u16_to_be(v as u16); }
pub fn i16_from_be(s: []u8, off: i64) i16 { return u16_from_be(s, off) as i16; }

pub fn i32_to_le(v: i32) [4]u8 { return u32_to_le(v as u32); }
pub fn i32_from_le(s: []u8, off: i64) i32 { return u32_from_le(s, off) as i32; }
pub fn i32_to_be(v: i32) [4]u8 { return u32_to_be(v as u32); }
pub fn i32_from_be(s: []u8, off: i64) i32 { return u32_from_be(s, off) as i32; }

pub fn i64_to_le(v: i64) [8]u8 { return u64_to_le(v as u64); }
pub fn i64_from_le(s: []u8, off: i64) i64 { return u64_from_le(s, off) as i64; }
pub fn i64_to_be(v: i64) [8]u8 { return u64_to_be(v as u64); }
pub fn i64_from_be(s: []u8, off: i64) i64 { return u64_from_be(s, off) as i64; }
