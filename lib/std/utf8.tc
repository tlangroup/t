// lib/std/utf8.tc —— UTF-8 ↔ 码点（rune）转换（纯 t 实现）
//
// t 的 str_len 返回字节数，运行期原本无法按 Unicode 码点遍历（gap-scan §三「Unicode 半残」）。
// 本模块补齐三个纯 t 函数，仅依赖 str_len / str_at / StringBuilder / append，对 tc 无语义依赖。
//
// 码点（rune）统一用 i64 表示（范围 0..0x10FFFF）。对非法 UTF-8 做 best-effort：
// 遇到非法前导字节或截断序列时，按单字节码点处理（不报错），保证不越界、不崩溃。
//
// 用法：
//   import(std.utf8);
//   var cps: []i64 = utf8.utf8_decode("你好");   // [20320, 22909]
//   var s: string = utf8.utf8_encode(cps);       // "你好"
//   var n: i64 = utf8.rune_count("a你b");         // 3（字节数是 5）

@module(pub)

// 解码 UTF-8 字符串为码点序列（每个码点 = 一个 i64）。
pub fn utf8_decode(s: string) []i64 {
    var out: []i64;
    var n: i64 = str_len(s) as i64;
    var i: i64 = 0;
    while (i < n) {
        var b0: i64 = str_at(s, i);
        if (b0 < 128) {
            append(out, b0);
            i = i + 1;
        } else if ((b0 & 224) == 192) {
            // 2 字节序列
            if (i + 1 < n) {
                var b1: i64 = str_at(s, i + 1);
                var cp: i64 = ((b0 & 31) << 6) | (b1 & 63);
                append(out, cp);
                i = i + 2;
            } else { append(out, b0); i = i + 1; }
        } else if ((b0 & 240) == 224) {
            // 3 字节序列
            if (i + 2 < n) {
                var b1: i64 = str_at(s, i + 1);
                var b2: i64 = str_at(s, i + 2);
                var cp: i64 = ((b0 & 15) << 12) | ((b1 & 63) << 6) | (b2 & 63);
                append(out, cp);
                i = i + 3;
            } else { append(out, b0); i = i + 1; }
        } else if ((b0 & 248) == 240) {
            // 4 字节序列
            if (i + 3 < n) {
                var b1: i64 = str_at(s, i + 1);
                var b2: i64 = str_at(s, i + 2);
                var b3: i64 = str_at(s, i + 3);
                var cp: i64 = ((b0 & 7) << 18) | ((b1 & 63) << 12) | ((b2 & 63) << 6) | (b3 & 63);
                append(out, cp);
                i = i + 4;
            } else { append(out, b0); i = i + 1; }
        } else {
            // 非法前导字节：按单字节码点处理
            append(out, b0);
            i = i + 1;
        }
    }
    return out;
}

// 码点数量（≠ 字节数）。等价于 len(utf8_decode(s))，但 O(n) 单次扫描、不分配堆。
pub fn rune_count(s: string) i64 {
    var n: i64 = str_len(s) as i64;
    var i: i64 = 0;
    var count: i64 = 0;
    while (i < n) {
        var b0: i64 = str_at(s, i);
        if (b0 < 128) { i = i + 1; }
        else if ((b0 & 224) == 192) { i = i + 2; }
        else if ((b0 & 240) == 224) { i = i + 3; }
        else if ((b0 & 248) == 240) { i = i + 4; }
        else { i = i + 1; }
        count = count + 1;
    }
    return count;
}

// 将码点序列编码回 UTF-8 字符串。码点应 ∈ [0, 0x10FFFF]；
// 越界（<0 或 >0x10FFFF）值按低 8 位单字节兜底，保证不崩溃。
pub fn utf8_encode(codepoints: []i64) string {
    var sb: StringBuilder = sb_new();
    var n: i64 = slice_len(codepoints) as i64;
    var i: i64 = 0;
    while (i < n) {
        var cp: i64 = codepoints[i];
        if (cp >= 0 && cp < 128) {
            sb_append_char(sb, cp as u8);
        } else if (cp < 2048) {
            sb_append_char(sb, (192 | (cp >> 6)) as u8);
            sb_append_char(sb, (128 | (cp & 63)) as u8);
        } else if (cp < 65536) {
            sb_append_char(sb, (224 | (cp >> 12)) as u8);
            sb_append_char(sb, (128 | ((cp >> 6) & 63)) as u8);
            sb_append_char(sb, (128 | (cp & 63)) as u8);
        } else if (cp <= 1114111) {
            sb_append_char(sb, (240 | (cp >> 18)) as u8);
            sb_append_char(sb, (128 | ((cp >> 12) & 63)) as u8);
            sb_append_char(sb, (128 | ((cp >> 6) & 63)) as u8);
            sb_append_char(sb, (128 | (cp & 63)) as u8);
        } else {
            // 越界兜底：低 8 位单字节
            sb_append_char(sb, (cp & 255) as u8);
        }
        i = i + 1;
    }
    return sb_to_str(sb);
}
