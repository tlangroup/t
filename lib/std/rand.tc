// lib/std/rand.tc —— 伪随机数生成（纯 t 实现，确定性 LCG）
//
// t 当前无 OS 随机内建（gap-scan §三「随机数」标注为全工程零命中），故本模块用纯算术 LCG
// 生成**确定性**序列：不调用任何运行时熵源，序列完全由种子决定，双后端逐字节可复现
// （也利于 reproducible build 与测试）。
//
// 对 tc 无语义依赖，零改编译器、零自举、零 gate。状态为模块级可变全局（t 无线程，单例足够），
// 对标 C 的 rand()/srand() 用法。
//
// 用法：
//   import(std.rand);
//   rand.srand(42);
//   var a: i64 = rand.rand_i64();        // [0, 2^31)
//   var b: i64 = rand.rand_range(1, 7);  // [1, 7)
//   var f: f64 = rand.rand_float();      // [0, 1)

@module(pub)

// LCG 状态（glibc 风格：state = state * 1103515245 + 12345，取低 31 位）。
// 用 u64 承载，使乘法溢出在 C/LLVM 双后端均按无符号回绕定义行为，保证确定性一致。
var g_rand_state: u64 = 1 as u64;

// 以 seed 重置 PRNG（等价 srand）。
pub fn srand(seed: u64) void {
    g_rand_state = seed;
}

// 返回 [0, 2^31) 的下一个 i64。仅纯算术（无浮点、无 OS 调用），双后端一致。
pub fn rand_i64() i64 {
    g_rand_state = g_rand_state * (1103515245 as u64) + (12345 as u64);
    var r: u64 = g_rand_state & (2147483647 as u64);
    return r as i64;
}

// [lo, hi) 上的均匀 i64（要求 hi > lo）。
pub fn rand_range(lo: i64, hi: i64) i64 {
    var span: i64 = hi - lo;
    var r: i64 = rand_i64();
    return lo + (r % span);
}

// [0, 1) 上的 f64（取 31 位精度映射到 [0, 1)）。
pub fn rand_float() f64 {
    var r: i64 = rand_i64();
    return (r as f64) / 2147483648.0;
}
