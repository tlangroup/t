// lib/std/maputil.tc —— map 工具（纯 t 实现，泛型）
//
// t 内建已提供 map 增删查（map_new / map_set / map_get / map_has / map_del / map_len）
// 与插入序迭代（for (k in m) / for (k,v in m)），但未暴露「取出全部键 / 全部值 / 清空」三件套。
// 本模块用这三个内建 + 迭代补齐，对 tc 无新增语义依赖。
//
// 用法：
//   import(std.maputil);
//   var m: map[string]i64 = ["a": 1, "b": 2];
//   var ks: []string = maputil.keys(string, i64, m);
//   var vs: []i64    = maputil.values(string, i64, m);
//   maputil.clear(string, i64, m);   // 原地清空
//
// 说明：comptime K/V 双类型参数；函数体只调用内建（map_*/append/slice_len），不嵌套任何
// 用户泛型调用，规避「泛型函数体内嵌套泛型调用漏单态化」已知限制。

@module(pub)

// 取出所有键（按插入序）。
pub fn keys(comptime K: type, comptime V: type, m: map[K]V) []K {
    var out: []K;
    for (k in m) {
        append(out, k);
    }
    return out;
}

// 取出所有值（按插入序，与 keys 一一对应）。
pub fn values(comptime K: type, comptime V: type, m: map[K]V) []V {
    var out: []V;
    for (k in m) {
        append(out, m[k]);
    }
    return out;
}

// 原地清空：先快照键到临时切片（避免迭代中删除导致迭代器失效），再逐个 map_del。
pub fn clear(comptime K: type, comptime V: type, m: map[K]V) void {
    var ks: []K;
    for (k in m) {
        append(ks, k);
    }
    var i: u64 = 0;
    var n: u64 = slice_len(ks);
    while (i < n) {
        map_del(m, ks[i]);
        i = i + 1;
    }
}
