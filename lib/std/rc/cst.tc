pub struct KwEntry {
    text: string;
    kind: string;
}

pub var g_kw_count: i64 = 41;
pub var g_kw_text: [41]string = ["fn", "struct", "enum", "flag", "union", "variant", "agent", "var", "const", "let", "comptime", "meta", "type", "if", "else", "match", "when", "for", "while", "break", "continue", "return", "true", "false", "null", "map", "import", "pub", "as", "in", "defer", "void", "unit", "string", "StringBuilder", "auto", "any", "kernel", "overload", "extend", "meta"];
pub var g_kw_kind: [41]string = ["KwFunc", "KwStruct", "KwEnum", "KwFlag", "KwUnion", "KwVariant", "KwAgent", "KwVar", "KwConst", "KwLet", "KwComptime", "KwMeta", "KwType", "KwIf", "KwElse", "KwMatch", "KwWhen", "KwFor", "KwWhile", "KwBreak", "KwContinue", "KwReturn", "KwTrue", "KwFalse", "KwNull", "KwMap", "KwImport", "KwPub", "KwAs", "KwIn", "KwDefer", "KwVoid", "KwUnit", "KwString", "KwStringBuilder", "KwAuto", "KwAny", "KwKernel", "KwOverload", "KwExtend", "KwMeta"];


pub fn init_keywords() void {
    // 静态定长并行数组已编译期初始化（见 g_kw_count / g_kw_text / g_kw_kind），无需运行时 append 填充。

}

pub fn kw_lookup(text: string) string {
    var i: i64 = 0;
    while (i < g_kw_count) {
        if (g_kw_text[i] == text) { return g_kw_kind[i]; }
        i = i + 1;
    }
    return "";
}
