// lib/std/math.tc —— 数值工具（纯 t 实现）
//
// 设计约束（解决「tc 与 std 相互依赖」的核心）：
//   * 本模块只依赖语言内建（字面量 / 算术 / 比较 / `as` 转换 / 浮点）与运行时，
//     绝不引用 tc 编译器自身的任何符号。因此 std 对 tc 没有语义依赖，
//     循环依赖在此被结构性消除——只有「tc 构建 std」这一构建期方向。
//   * 可被 `tc build --lib` 独立编译为 .tlib，供任意程序（含 tc 自身后续代际）链接。
//
// 浮点数学说明：本模块不手写泰勒近似，而是**薄封装编译器底层的数学内建**。
// 底层（编译器 CTFE 层）为这些函数定义了 *编译期可折叠* 的 `@` 前缀内建（如 `@sin`/`@sinf`
// `@cos`/`@cosf`...；由 `math_mbuiltin()` 识别，实参为浮点常量时经 `meta_eval_math` 折叠为
// 字面量，运行期回落 libm / LLVM FPU intrinsic）。本模块统一用 `@` 前缀形式（mbuiltin 节点）做薄封装，
// 使 std.math 的浮点函数在编译期上下文中也能被折叠（而非仅运行期调用）。
//
// 命名：f64 函数与底层 `@sin`/`@cos`/`@sqrt`/`@log`... 同名（sin/cos/sqrt/log...）；
//      f32 函数与底层 `@sinf`/`@cosf`/`@sqrtf`/`@logf`... 同名（sinf/cosf/sqrtf/logf...）。
//      ⚠ `copysign` / `fmin` / `fmax` 不在 `math_mbuiltin()` 表内、无 `@` 内建亦无 f32 变体，
//        保留 `_f` 后缀（copysign_f/fmin_f/fmax_f）做裸 call 透传。
//
// 用法：
//   import(std.math);
//   var m = math.max(i64, 3, 7);          // 泛型有序比较
//   var r = math.sqrt(2.0);               // f64（底层 @sqrt）
//   var rf = math.sqrtf(2.0f32);          // f32（底层 @sqrtf）
//   var g = math.gcd(12, 18);             // 整数

// —— 泛型有序比较（i64 / u64 / f64 等支持 < > 的类型）——
@module(pub)

pub fn min(comptime T: type, a: T, b: T) T {
    if (a < b) { return a; }
    return b;
}

pub fn max(comptime T: type, a: T, b: T) T {
    if (a > b) { return a; }
    return b;
}

// 注意：当前编译器对「泛型函数体内的嵌套泛型调用」不做单态化（clamp 内若调用
// min(T, max(T, ...)) 会漏单态化导致链接失败）。改为内联比较，规避该限制。
pub fn clamp(comptime T: type, x: T, lo: T, hi: T) T {
    if (x < lo) { return lo; }
    if (x > hi) { return hi; }
    return x;
}

// —— 整数（i64 / u64）——
pub fn abs(x: i64) i64 {
    if (x < 0) { return -x; }
    return x;
}

pub fn sign(x: i64) i64 {
    if (x > 0) { return 1; }
    if (x < 0) { return -1; }
    return 0;
}

// 截断除法（向零取整），与 C 整数除法一致
pub fn div_floor(a: i64, b: i64) i64 {
    var q: i64 = a / b;
    if ((a % b != 0) and ((a < 0) != (b < 0))) { q = q - 1; }
    return q;
}

// 向上取整除法（远离零）
pub fn div_ceil(a: i64, b: i64) i64 {
    var q: i64 = a / b;
    if ((a % b != 0) and ((a < 0) == (b < 0))) { q = q + 1; }
    return q;
}

// 欧几里得取模：结果非负，满足 (a/b)*b + mod_e(a,b) == a
pub fn mod_e(a: i64, b: i64) i64 {
    var r: i64 = a % b;
    if (r < 0) {
        if (b < 0) { r = r - b; } else { r = r + b; }
    }
    return r;
}

// 整数以 2 为底的对数（下取整，即最高有效位的位索引）；x 须 >= 1
pub fn ilog2(x: u64) i64 {
    var r: i64 = 0;
    var v: u64 = x;
    while (v > 1) { v = v / 2; r = r + 1; }
    return r;
}

// 2^n（n >= 0）；循环实现，避免对移位运算符的依赖
pub fn pow2_i(n: i64) i64 {
    var r: i64 = 1;
    var i: i64 = 0;
    while (i < n) { r = r * 2; i = i + 1; }
    return r;
}

// 是否为 2 的幂
pub fn is_pow2(x: u64) bool {
    if (x == 0) { return false; }
    return (x & (x - 1)) == 0;
}

// 最大公约数（欧几里得）
pub fn gcd(a: i64, b: i64) i64 {
    var x: i64 = abs(a);
    var y: i64 = abs(b);
    while (y != 0) {
        var t: i64 = x % y;
        x = y;
        y = t;
    }
    return x;
}

// 不小于 x 的 m 的最小倍数（m > 0）
pub fn next_multiple_of(x: i64, m: i64) i64 {
    return div_ceil(x, m) * m;
}

// 整数线性插值：a + (b - a) * t / 100（定点，避免浮点）
pub fn lerp_i(a: i64, b: i64, t: i64) i64 {
    return a + ((b - a) * t) / 100;
}

// —— 浮点（f64）：薄封装底层编译期内建数学（`@` 前缀 mbuiltin 形式）——
// 见文件头注释：底层已为这些函数定义了 *编译期可折叠* 的 `@` 内建（如 `@sin` `@hypot`），
// 实参为浮点常量时由 meta_eval_math 折叠，否则回落 libm / LLVM FPU。对应 f32 变体（@sinf/...）
// 见下方「浮点（f32）」段。
// ⚠ copysign / fmin / fmax 不在 math_mbuiltin 表、无 `@` 内建亦无 f32 变体，保留 _f 后缀做裸 call 透传。
pub const PI: f64 = 3.141592653589793;
pub const E: f64 = 2.718281828459045;
pub const TAU: f64 = 6.283185307179586;
pub const LN2: f64 = 0.6931471805599453;
pub const LN10: f64 = 2.302585092994046;

// 绝对值（浮点）。整数绝对值用 abs(x: i64)
pub fn fabs(x: f64) f64 { return @fabs(x); }

// 取整类
pub fn floor(x: f64) f64 { return @floor(x); }
pub fn ceil(x: f64) f64 { return @ceil(x); }
pub fn round(x: f64) f64 { return @round(x); }
pub fn trunc(x: f64) f64 { return @trunc(x); }

// 基本算术
pub fn sqrt(x: f64) f64 { return @sqrt(x); }              // 平方根
pub fn cbrt(x: f64) f64 { return @cbrt(x); }              // 立方根
pub fn pow(x: f64, y: f64) f64 { return @pow(x, y); }     // x^y（双精度；y 可分数/负）
pub fn pow_i(x: f64, n: i64) f64 {                        // 整数次幂（精确，无浮点误差）
    if (n < 0) { return 1.0 / pow_i(x, -n); }
    var r: f64 = 1.0;
    var i: i64 = 0;
    while (i < n) { r = r * x; i = i + 1; }
    return r;
}
pub fn hypot(x: f64, y: f64) f64 { return @hypot(x, y); } // 欧氏距离 sqrt(x^2+y^2)
pub fn fmod(x: f64, y: f64) f64 { return @fmod(x, y); }   // 浮点取模
pub fn copysign_f(x: f64, y: f64) f64 { return copysign(x, y); } // 取 y 的符号（无 @ 内建）
pub fn fmin_f(x: f64, y: f64) f64 { return fmin(x, y); }   // 较小值（忽略 NaN；无 @ 内建）
pub fn fmax_f(x: f64, y: f64) f64 { return fmax(x, y); }   // 较大值（忽略 NaN；无 @ 内建）

// 指数 / 对数
pub fn exp(x: f64) f64 { return @exp(x); }                // e^x
pub fn exp2(x: f64) f64 { return @exp2(x); }              // 2^x
pub fn expm1(x: f64) f64 { return @expm1(x); }            // e^x - 1（数值更稳）
pub fn log(x: f64) f64 { return @log(x); }                // 自然对数 ln(x)
pub fn log2(x: f64) f64 { return @log2(x); }              // 以 2 为底（整数版见 ilog2(x: u64)）
pub fn log10(x: f64) f64 { return @log10(x); }            // 以 10 为底
pub fn log1p(x: f64) f64 { return @log1p(x); }            // ln(1 + x)（数值更稳）

// 三角 / 反三角
pub fn sin(x: f64) f64 { return @sin(x); }
pub fn cos(x: f64) f64 { return @cos(x); }
pub fn tan(x: f64) f64 { return @tan(x); }
pub fn asin(x: f64) f64 { return @asin(x); }
pub fn acos(x: f64) f64 { return @acos(x); }
pub fn atan(x: f64) f64 { return @atan(x); }
pub fn atan2(y: f64, x: f64) f64 { return @atan2(y, x); } // 四象限

// 双曲
pub fn sinh(x: f64) f64 { return @sinh(x); }
pub fn cosh(x: f64) f64 { return @cosh(x); }
pub fn tanh(x: f64) f64 { return @tanh(x); }

// —— 浮点（f32）：薄封装底层 f32 变体内建（`@` 前缀 mbuiltin 形式，名加 f 后缀）——
// 与 f64 段一一对应：sin→sinf、cos→cosf、sqrt→sqrtf…；实参须为 f32（用 `1.5f32` 或 `as f32`）。
pub fn fabsf(x: f32) f32 { return @fabsf(x); }

pub fn floorf(x: f32) f32 { return @floorf(x); }
pub fn ceilf(x: f32) f32 { return @ceilf(x); }
pub fn roundf(x: f32) f32 { return @roundf(x); }
pub fn truncf(x: f32) f32 { return @truncf(x); }

pub fn sqrtf(x: f32) f32 { return @sqrtf(x); }
pub fn cbrtf(x: f32) f32 { return @cbrtf(x); }
pub fn powf(x: f32, y: f32) f32 { return @powf(x, y); }
pub fn hypotf(x: f32, y: f32) f32 { return @hypotf(x, y); }
pub fn fmodf(x: f32, y: f32) f32 { return @fmodf(x, y); }

pub fn expf(x: f32) f32 { return @expf(x); }
pub fn exp2f(x: f32) f32 { return @exp2f(x); }
pub fn expm1f(x: f32) f32 { return @expm1f(x); }
pub fn logf(x: f32) f32 { return @logf(x); }
pub fn log2f(x: f32) f32 { return @log2f(x); }
pub fn log10f(x: f32) f32 { return @log10f(x); }
pub fn log1pf(x: f32) f32 { return @log1pf(x); }

pub fn sinf(x: f32) f32 { return @sinf(x); }
pub fn cosf(x: f32) f32 { return @cosf(x); }
pub fn tanf(x: f32) f32 { return @tanf(x); }
pub fn asinf(x: f32) f32 { return @asinf(x); }
pub fn acosf(x: f32) f32 { return @acosf(x); }
pub fn atanf(x: f32) f32 { return @atanf(x); }
pub fn atan2f(y: f32, x: f32) f32 { return @atan2f(y, x); }

pub fn sinhf(x: f32) f32 { return @sinhf(x); }
pub fn coshf(x: f32) f32 { return @coshf(x); }
pub fn tanhf(x: f32) f32 { return @tanhf(x); }

// 浮点线性插值：a + (b - a) * t
pub fn lerp_f(a: f64, b: f64, t: f64) f64 {
    return a + (b - a) * t;
}
