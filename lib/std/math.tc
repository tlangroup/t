// lib/std/math.tc —— 数值工具（纯 t 实现）
//
// 设计约束（解决「tc 与 std 相互依赖」的核心）：
//   * 本模块只依赖语言内建（字面量 / 算术 / 比较 / `as` 转换 / 浮点）与运行时，
//     绝不引用 tc 编译器自身的任何符号。因此 std 对 tc 没有语义依赖，
//     循环依赖在此被结构性消除——只有「tc 构建 std」这一构建期方向。
//   * 可被 `tc build --lib` 独立编译为 .tlib，供任意程序（含 tc 自身后续代际）链接。
//
// 用法：
//   import(std.math);
//   var m = math.max(i64, 3, 7);          // 泛型有序比较
//   var r = math.sqrt_f(2.0);             // 浮点
//   var g = math.gcd(12, 18);             // 整数

// —— 泛型有序比较（i64 / u64 / f64 等支持 < > 的类型）——
@module(pub)

pub fn min(comptime T: type, a: T, b: T) T {
    if (a < b) { return a; }
    return b;
}

pub fn max(comptime T: type, a: T, b: T) T {
    if (a > b) { return a; }
    return b;
}

// 注意：当前编译器对「泛型函数体内的嵌套泛型调用」不做单态化（clamp 内若调用
// min(T, max(T, ...)) 会漏单态化导致链接失败）。改为内联比较，规避该限制。
pub fn clamp(comptime T: type, x: T, lo: T, hi: T) T {
    if (x < lo) { return lo; }
    if (x > hi) { return hi; }
    return x;
}

// —— 整数（i64 / u64）——
pub fn abs(x: i64) i64 {
    if (x < 0) { return -x; }
    return x;
}

pub fn sign(x: i64) i64 {
    if (x > 0) { return 1; }
    if (x < 0) { return -1; }
    return 0;
}

// 截断除法（向零取整），与 C 整数除法一致
pub fn div_floor(a: i64, b: i64) i64 {
    var q: i64 = a / b;
    if ((a % b != 0) && ((a < 0) != (b < 0))) { q = q - 1; }
    return q;
}

// 向上取整除法（远离零）
pub fn div_ceil(a: i64, b: i64) i64 {
    var q: i64 = a / b;
    if ((a % b != 0) && ((a < 0) == (b < 0))) { q = q + 1; }
    return q;
}

// 欧几里得取模：结果非负，满足 (a/b)*b + mod_e(a,b) == a
pub fn mod_e(a: i64, b: i64) i64 {
    var r: i64 = a % b;
    if (r < 0) {
        if (b < 0) { r = r - b; } else { r = r + b; }
    }
    return r;
}

// 整数以 2 为底的对数（下取整）；x 须 >= 1
pub fn log2(x: u64) i64 {
    var r: i64 = 0;
    var v: u64 = x;
    while (v > 1) { v = v / 2; r = r + 1; }
    return r;
}

// 2^n（n >= 0）；循环实现，避免对移位运算符的依赖
pub fn pow2_i(n: i64) i64 {
    var r: i64 = 1;
    var i: i64 = 0;
    while (i < n) { r = r * 2; i = i + 1; }
    return r;
}

// 是否为 2 的幂
pub fn is_pow2(x: u64) bool {
    if (x == 0) { return false; }
    return (x & (x - 1)) == 0;
}

// 最大公约数（欧几里得）
pub fn gcd(a: i64, b: i64) i64 {
    var x: i64 = abs(a);
    var y: i64 = abs(b);
    while (y != 0) {
        var t: i64 = x % y;
        x = y;
        y = t;
    }
    return x;
}

// 不小于 x 的 m 的最小倍数（m > 0）
pub fn next_multiple_of(x: i64, m: i64) i64 {
    return div_ceil(x, m) * m;
}

// 整数线性插值：a + (b - a) * t / 100（定点，避免浮点）
pub fn lerp_i(a: i64, b: i64, t: i64) i64 {
    return a + ((b - a) * t) / 100;
}

// —— 浮点（f64）——
pub const PI: f64 = 3.141592653589793;
pub const E: f64 = 2.718281828459045;

pub fn fabs(x: f64) f64 {
    if (x < 0.0) { return -x; }
    return x;
}

pub fn floor_f(x: f64) f64 {
    var fl: f64 = (x as i64) as f64;
    if (fl > x) { fl = fl - 1.0; }
    return fl;
}

pub fn ceil_f(x: f64) f64 {
    var cl: f64 = (x as i64) as f64;
    if (cl < x) { cl = cl + 1.0; }
    return cl;
}

pub fn round_f(x: f64) f64 {
    return floor_f(x + 0.5);
}

pub fn trunc_f(x: f64) f64 {
    return (x as i64) as f64;
}

// 牛顿迭代求平方根（x >= 0；x < 0 返回 0）
pub fn sqrt_f(x: f64) f64 {
    if (x <= 0.0) { return 0.0; }
    var g: f64 = x;
    var i: i64 = 0;
    while (i < 24) {
        g = (g + x / g) / 2.0;
        i = i + 1;
    }
    return g;
}

// 幂：x^n，n 为整数（n < 0 时取倒数）
pub fn pow_f(x: f64, n: i64) f64 {
    if (n < 0) { return 1.0 / pow_f(x, -n); }
    var r: f64 = 1.0;
    var i: i64 = 0;
    while (i < n) { r = r * x; i = i + 1; }
    return r;
}

// 浮点线性插值：a + (b - a) * t
pub fn lerp_f(a: f64, b: f64, t: f64) f64 {
    return a + (b - a) * t;
}

// 正弦（泰勒展开，适用于 |x| 不太大的输入；大输入建议先范围规约）
pub fn sin_f(x: f64) f64 {
    var sum: f64 = x;
    var term: f64 = x;
    var i: i64 = 1;
    while (i < 12) {
        term = -term * x * x / (((2 * i) as f64) * ((2 * i + 1) as f64));
        sum = sum + term;
        i = i + 1;
    }
    return sum;
}

// 余弦（泰勒展开）
pub fn cos_f(x: f64) f64 {
    var sum: f64 = 1.0;
    var term: f64 = 1.0;
    var i: i64 = 1;
    while (i < 12) {
        term = -term * x * x / (((2 * i - 1) as f64) * ((2 * i) as f64));
        sum = sum + term;
        i = i + 1;
    }
    return sum;
}

// 指数 e^x（泰勒展开）
pub fn exp_f(x: f64) f64 {
    var sum: f64 = 1.0;
    var term: f64 = 1.0;
    var i: i64 = 1;
    while (i < 20) {
        term = term * x / (i as f64);
        sum = sum + term;
        i = i + 1;
    }
    return sum;
}

// —— 对数与反三角（纯 t，泰勒 + 区间归约）——
// 自然对数 ln(x)（x > 0；x <= 0 返回 0.0，属教学实现的简化边界）
pub fn log_f(x: f64) f64 {
    if (x <= 0.0) { return 0.0; }
    // 区间归约：把 x 缩放到 [1, 2)，记录缩放次数 n（每次 /2 记 +1）
    var n: f64 = 0.0;
    var xx: f64 = x;
    while (xx > 2.0) { xx = xx / 2.0; n = n + 1.0; }
    while (xx < 1.0) { xx = xx * 2.0; n = n - 1.0; }
    // ln(x) = 2*(y + y^3/3 + y^5/5 + ...)，y = (xx-1)/(xx+1) ∈ [0, 1/3)，收敛快
    var y: f64 = (xx - 1.0) / (xx + 1.0);
    var y2: f64 = y * y;
    var sum: f64 = y;
    var term: f64 = y;
    var i: i64 = 1;
    while (i < 30) {
        term = term * y2;
        sum = sum + term / ((2 * i + 1) as f64);
        i = i + 1;
    }
    return (2.0 * sum) + n * 0.6931471805599453;   // + n*ln(2)
}

// 常用底对数
pub fn log10_f(x: f64) f64 { return log_f(x) / 2.302585092994046; }   // ln(10)
pub fn log2_f(x: f64) f64 { return log_f(x) / 0.6931471805599453; }   // ln(2)

// 反正切 arctan(x)：
//   * |x|>1   用 π/2 - arctan(1/x) 折回 (0,1]
//   * x>tan(π/8) 用半角公式 atan(x)=2*atan(x/(1+√(1+x²))) 折到小角度
//   * 余下 |x|<=tan(π/8)≈0.4142 泰勒收敛极快（30 项误差可忽略）
pub fn atan_f(x: f64) f64 {
    if (x < 0.0) { return -atan_f(-x); }
    if (x > 1.0) { return 1.5707963267948966 - atan_f(1.0 / x); }
    if (x > 0.4142135623730950) {
        var t: f64 = x / (1.0 + sqrt_f(1.0 + x * x));
        return 2.0 * atan_f(t);
    }
    var sum: f64 = x;
    var term: f64 = x;
    var x2: f64 = x * x;
    var i: i64 = 1;
    while (i < 30) {
        term = -term * x2;
        sum = sum + term / ((2 * i + 1) as f64);
        i = i + 1;
    }
    return sum;
}

// 二参数反正切 atan2(y, x)：四象限正确（原点返回 0.0）
pub fn atan2_f(y: f64, x: f64) f64 {
    if (x > 0.0) { return atan_f(y / x); }
    if (x < 0.0) {
        if (y >= 0.0) { return atan_f(y / x) + 1.5707963267948966; }
        return atan_f(y / x) - 1.5707963267948966;
    }
    if (y > 0.0) { return 1.5707963267948966; }
    if (y < 0.0) { return -1.5707963267948966; }
    return 0.0;
}

// 欧氏距离 hypot(x, y) = sqrt(x^2 + y^2)
pub fn hypot_f(x: f64, y: f64) f64 {
    return sqrt_f(x * x + y * y);
}
