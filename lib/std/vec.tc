// lib/std/vec.tc —— 动态向量 Vec<T>（R-008）
//
// 动机：thyme 的字段符号表、加载器 id→实例映射都需要动态数组与稳定顺序。
//
// 设计：t 的切片 `[]T` 原生支持 `append`，即一个稳定顺序、可增长的动态向量，
// 已满足 R-008 对 Vec 的核心要求。本模块在其上提供一组泛型辅助，统一取/存/长接口。
//
// 用法：
//   import(std.vec);
//   var xs: []i64 = [];
//   xs = vec.push(i64, xs, 10);     // append 改写切片头，需回收返回值
//   var n = vec.len(i64, xs);
//   var v = vec.get(i64, xs, 0);
//
// 注：切片元素可写（`xs[i] = x`），故 set 直接下标赋值。pop/截断可用切片重切
// `xs[0..n-1]` 表达。也可直接使用语言内建 `append(xs, x)`（对局部变量原地增长）。

@module(pub)

// 元素个数
pub fn len(comptime T: type, v: []T) i64 {
    return slice_len(v) as i64;
}

// 追加：append 会改写切片头（ptr/len/cap），故返回增长后的切片由调用方回收。
// 也可直接写 `append(xs, x)`（对局部变量原地增长，更简洁）。
pub fn push(comptime T: type, v: []T, x: T) []T {
    append(v, x);
    return v;
}

// 取第 i 个元素
pub fn get(comptime T: type, v: []T, i: i64) T {
    return v[i];
}

// 写第 i 个元素
pub fn set(comptime T: type, v: []T, i: i64, x: T) void {
    v[i] = x;
}

// 末元素（调用方需保证非空）
pub fn last(comptime T: type, v: []T) T {
    return v[slice_len(v) as i64 - 1];
}
