// lib/std/mem.tc —— 内存 / 切片工具（纯 t 实现）
//
// 设计约束（同 math.tc）：只依赖语言内建（slice_len / 切片索引 / 比较 / 循环），
// 绝不引用 tc 编译器自身符号。因此 std 对 tc 无语义依赖。
//
// 说明：t 当前不支持裸指针解引用（`&`/`*` 非表达式运算符），故「标量原地交换」
// 与「按字节 memcpy/memset」需要未来新增内存内建。本模块提供基于切片的通用操作，
// 覆盖绝大多数场景，且可在任意程序中以链接模式使用。
//
// 用法：
//   import(std.mem);
//   var dst: []i64 = ...; var src: []i64 = ...;
//   mem.copy(i64, dst, src);
//   if (mem.equal(i64, dst, src)) { ... }

// 交换切片内第 i、j 个元素（先定义，供 reverse 调用）
export fn swap_in(meta T: type, s: []T, i: i64, j: i64) void {
    var t: T = s[i];
    s[i] = s[j];
    s[j] = t;
}

// 将 src 的前 min(len) 个元素拷贝到 dest，返回拷贝个数
export fn copy(meta T: type, dest: []T, src: []T) u64 {
    var n: u64 = slice_len(src);
    var i: i64 = 0;
    while (i < n as i64) {
        dest[i] = src[i];
        i = i + 1;
    }
    return n;
}

// 逐元素相等（长度不同直接判否）
export fn equal(meta T: type, a: []T, b: []T) bool {
    if (slice_len(a) != slice_len(b)) { return false; }
    var n: u64 = slice_len(a);
    var i: i64 = 0;
    while (i < n as i64) {
        if (a[i] != b[i]) { return false; }
        i = i + 1;
    }
    return true;
}

// 用 v 填充整个切片
export fn fill(meta T: type, s: []T, v: T) void {
    var n: u64 = slice_len(s);
    var i: i64 = 0;
    while (i < n as i64) {
        s[i] = v;
        i = i + 1;
    }
}

// 原地反转切片（内联交换，规避「泛型函数体内嵌套泛型调用」的单态化限制）
export fn reverse(meta T: type, s: []T) void {
    var n: u64 = slice_len(s);
    var i: i64 = 0;
    while (i < (n as i64) / 2) {
        var t: T = s[i];
        s[i] = s[(n as i64) - 1 - i];
        s[(n as i64) - 1 - i] = t;
        i = i + 1;
    }
}

// 返回 v 首次出现的下标；不存在返回 -1
export fn index_of(meta T: type, s: []T, v: T) i64 {
    var n: u64 = slice_len(s);
    var i: i64 = 0;
    while (i < n as i64) {
        if (s[i] == v) { return i; }
        i = i + 1;
    }
    return -1;
}

// 是否包含 v（内联实现，规避「泛型函数体内嵌套泛型调用」的单态化限制）
export fn contains(meta T: type, s: []T, v: T) bool {
    var n: u64 = slice_len(s);
    var i: i64 = 0;
    while (i < n as i64) {
        if (s[i] == v) { return true; }
        i = i + 1;
    }
    return false;
}

// 切片长度
export fn len(meta T: type, s: []T) u64 {
    return slice_len(s);
}
